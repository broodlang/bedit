;; src/ansicolor.blsp — a program's ANSI colours on the buffer its output streams into, over
;; std's streaming decoder (brood ADR-567), and the view's layering of them under a mode's
;; own colouring (`spanpaint/ed-span-layers`). Issue #24: an escape split across two reads used
;; to leak into the text as `1mERROR`.

(defmodule ansicolor-test
  (:use test)
  (:use model)
  (:use-internals view)
  (:use-internals spanpaint)
  (:use editor/buffer))

(defn- decode-all (chunks)
  "`[text spans]` of `chunks` decoded one after another through one decoder, the pieces
joined as a line-buffered consumer joins them."
  (second (fold chunks
            [(ansicolor/decoder) ["" []]]
            (fn (state chunk)
              (let ([decoder joined] state
                    [next-decoder text spans] (ansicolor/decode decoder chunk))
                [next-decoder (ansicolor/continue-partial joined text spans)])))))

(describe "ansicolor/decode"
  (test "the text loses its escapes and its CRLF returns; the colours come as spans"
    (let ([_ text spans] (ansicolor/decode (ansicolor/decoder) "\e[1;31mERROR\e[0m: x\r\n"))
      (assert= text "ERROR: x\n")
      (assert= spans [[0 5 {:bold true :fg 1}]])))
  (test "a lone carriage return stays for the append; a coloured run keeps its place"
    (let ([_ text spans] (ansicolor/decode (ansicolor/decoder) "a\r\e[32mb\rc\e[0m"))
      (assert= text "a\rb\rc")
      (assert= spans [[2 5 {:fg 2}]])
      (assert= (ansicolor/carriage text spans) [true "c" [[0 1 {:fg 2}]]])))
  (test "every cut of a stream decodes to the same text and spans"
    (let (stream "x \e[38;5;208mwarn\e[0m \e]0;t\x07\e[4munder\e[24m done\r\n"
          n (count stream)
          whole (decode-all [stream]))
      (assert= (first whole) "x warn under done\n")
      (doseq (i (range 1 n))
        (assert= [i (decode-all [(string/substring stream 0 i) (string/substring stream i n)])]
          [i whole])))))

(describe "ansicolor/split-lines"
  (test "a span crossing newlines continues on each line it covers"
    (assert= (ansicolor/split-lines "ab\ncd\nef\ng" [[1 7 :x]])
      [[["ab" [[1 2 :x]]] ["cd" [[0 2 :x]]] ["ef" [[0 1 :x]]]] ["g" []]]))
  (test "spans wholly inside lines stay put, made line-relative"
    (assert= (ansicolor/split-lines "ab\ncd\n" [[0 1 :x] [4 5 :y]])
      [[["ab" [[0 1 :x]]] ["cd" [[1 2 :y]]]] ["" []]]))
  (test "a span covering only a newline colours nothing"
    (assert= (ansicolor/split-lines "ab\ncd" [[2 3 :x]]) [[["ab" []]] ["cd" []]])))

(describe "ansicolor/add-faces"
  (test "spans move to the offset the text was appended at, still SGR attributes"
    (let (buf (ansicolor/add-faces (make-buffer "hello world") [[0 5 {:fg 1 :underline true}]] 6))
      (assert= (ansicolor/colour-spans buf) [[6 11 {:fg 1 :underline true}]])))
  (test "a later append's faces follow the earlier ones"
    (let (buf (ansicolor/add-faces (ansicolor/add-faces (make-buffer "ab") [[0 1 {:bold true}]] 0)
                [[0 1 {:italic true}]]
                1))
      (assert= (ansicolor/colour-spans buf) [[0 1 {:bold true}] [1 2 {:italic true}]])))
  (test "no spans leave the buffer as it was"
    (let (buf (make-buffer "x"))
      (is (= buf (ansicolor/add-faces buf [] 0))))))

(describe "the view lays output faces under the mode's colouring"
  (test "where both colour a character the mode's face wins; elsewhere the output's shows"
    (assert= (spanpaint/ed-span-underlay [[2 4 :mode]] [[0 6 :ansi]])
      '([0 2 :ansi] [2 4 :mode] [4 6 :ansi])))
  (test "disjoint spans interleave in order"
    (assert= (spanpaint/ed-span-underlay [[0 1 :a] [5 6 :b]] [[2 3 :x] [7 9 :y]])
      '([0 1 :a] [2 3 :x] [5 6 :b] [7 9 :y])))
  (test "an output span under several mode spans shows in each gap"
    (assert= (spanpaint/ed-span-underlay [[1 2 :a] [3 4 :b]] [[0 5 :x]])
      '([0 1 :x] [1 2 :a] [2 3 :x] [3 4 :b] [4 5 :x])))
  (test "a buffer with output faces hands the painter both layers"
    (let (buf (insert (make-buffer "") "ab" {:ansi [[0 1 {:bold true}]]}))
      (assert= (spanpaint/ed-buffer-spans buf [[1 2 :mode]])
        (spanpaint/ed-span-layers [[1 2 :mode]] [[0 1 {:bold true}]] (theme/ansi-palette)))))
  (test "with a palette, the output's attributes are painted in its colours"
    (let (buf (make-buffer "abc")
          palette {:colors (into [] (seq/repeat 16 "#112233")) :fg "#ffffff" :bg "#000000"}
          by-line (spanpaint/ed-spans-by-line-at (buffer-rope buf)
                    (spanpaint/ed-span-layers nil [[0 2 {:fg 1 :bold true}]] palette)
                    0
                    0))
      (assert= (into [] (get by-line 0)) [[0 2 {:fg "#112233" :bold true}]])
      (assert= (view/ed-face-at (spanpaint/ed-span-layers nil [[0 2 {:fg 9}]] palette) 1)
        {:fg "#112233"})))
  (test "a theme switch repaints the output: another palette, other colours"
    (let (buf (make-buffer "abc")
          spans [[0 2 {:fg 2}]]
          paint (fn (colour)
                  (get (spanpaint/ed-spans-by-line-at (buffer-rope buf)
                         (spanpaint/ed-span-layers nil
                           spans
                           {:colors (into [] (seq/repeat 16 colour))})
                         0
                         0)
                    0)))
      (assert= (into [] (paint "#aaaaaa")) [[0 2 {:fg "#aaaaaa"}]])
      (assert= (into [] (paint "#bbbbbb")) [[0 2 {:fg "#bbbbbb"}]])))
  (test "the face at a position: the mode's first, then the output's"
    (let (layers (spanpaint/ed-span-layers [[1 2 :mode]] [[0 3 :ansi]]))
      (assert= (view/ed-face-at layers 1) :mode)
      (assert= (view/ed-face-at layers 0) :ansi)
      (assert= (view/ed-face-at layers 5) nil)))
  (test "per line, the layers are sliced and merged"
    (let (buf (make-buffer "abc\ndef")
          by-line (spanpaint/ed-spans-by-line-at (buffer-rope buf)
                    (spanpaint/ed-span-layers [[1 2 :mode]] [[0 3 :ansi] [4 6 :ansi]])
                    0
                    1))
      (assert= (into [] (get by-line 0)) [[0 1 :ansi] [1 2 :mode] [2 3 :ansi]])
      (assert= (into [] (get by-line 1)) [[4 6 :ansi]]))))

;; Emacs's comint-carriage-motion: a lone return goes back to the line's start, so a
;; progress counter rewrites its line instead of running its counts together.
(describe "carriage returns in output"
  (test "a lone return keeps what follows it on the line; a CRLF is a line end"
    (assert= (ansicolor/carriage "10%\r20%\r30%\ndone" []) [true "30%\ndone" []])
    (assert= (ansicolor/carriage "a\nb\rc\nd" []) [false "a\nc\nd" []])
    (assert= (ansicolor/carriage "plain\n" [[0 5 :x]]) [false "plain\n" [[0 5 :x]]])
    (assert= (ansicolor/carriage "a\r\nb" []) [false "a\nb" []]))
  (test "the colours follow what is kept"
    (assert= (ansicolor/carriage "ab\rcd\nef" [[0 2 :a] [3 5 :c] [6 8 :e]])
      [true "cd\nef" [[0 2 :c] [3 5 :e]]]))
  (test "a return split from its newline by a read is still a line end"
    (let (decoder (ansicolor/decoder)
          [held first-text _] (ansicolor/decode decoder "ok\r")
          [_ second-text _] (ansicolor/decode held "\nnext"))
      (assert= first-text "ok")
      (assert= second-text "\nnext")))
  (test "a return split from what follows it is still a return"
    (let ([held _ _] (ansicolor/decode (ansicolor/decoder) "10%\r")
          [_ text _] (ansicolor/decode held "20%"))
      (assert= text "\r20%")))
  (test "an append that starts with a return rewrites the line the output is on"
    (let (buf (insert (make-buffer "") "$ make\n10%" {:ansi [[7 10 {:fg 2}]]})
          [after end] (ansicolor/insert-output buf 10 "\r20%" [[1 4 {:fg 3}]]))
      (assert= (buffer-text after) "$ make\n20%")
      (assert= end 10)
      (assert= (ansicolor/colour-spans after) [[7 10 {:fg 3}]])))
  (test "a read-only output buffer is rewritten too and stays read-only"
    (let ([after _] (ansicolor/insert-output (set-read-only (make-buffer "1/3") true) 3 "\r2/3" []))
      (assert= (buffer-text after) "2/3")
      (is (read-only? after)))))

(describe "a decoder that raises does not take its stream worker down"
  ;; a decoder bug met by a program's output used to kill the worker (bshell, compile,
  ;; procstream all decode through here) and leave its buffer running forever. A broken
  ;; std decoder stands in for the bug.
  (test "the chunk's text goes on, its escapes out, and the next chunk decodes afresh"
    (let (broken (assoc (ansicolor/decoder) :ansi 42)
          [after text spans] (ansicolor/decode broken "a\e[1mb\n")
          [_ next-text next-spans] (ansicolor/decode after "\e[1mok"))
      (assert= text "ab\n")
      (assert= spans [])
      (is (:faulted? after))
      (assert= next-text "ok")
      (assert= next-spans [[0 2 {:bold true}]])))
  (test "the fallback takes every kind of escape out whole"
    (let (broken (assoc (ansicolor/decoder) :ansi 42)
          bell (string/int->char 7)
          chunk (str "a\e[38;5;1mb\e]0;title"
                  bell "c\e]8;;http://x\e\\d\e(Be\e7f\ePq#0\e\\g\e[?25"))
      (assert= (second (ansicolor/decode broken chunk)) "abcdefg")))
  (test "the reported hostile colour decodes on a healthy decoder"
    (let ([_ text _] (ansicolor/decode (ansicolor/decoder) "\e[38;5;1:2mx\e[38;2;1:2;3;4my"))
      (assert= text "xy"))))
