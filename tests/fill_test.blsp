;; tests/fill_test.blsp — M-q and auto-fill keep a paragraph's prefixes (Emacs's adaptive fill).
;;
;; The wrapping and the prefix reading are std's (`string/fill`, `string/fill-prefixes`, pinned
;; in brood's strings tests); these pin bedit's POLICY: which lines are the paragraph (the item,
;; the comment, the mode's separate lines), the mode's own prefixes (a Lisp docstring), where
;; point lands, and auto-fill's break.

(defmodule fill-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use fill)
  (:use editor/buffer))

(defn- file-model (text file point)
  ;; a model on a buffer of `text` visiting `file` (its mode from the name), point at `point`
  (let (m (ed-init (make-buffer text file file)))
    (ed-set-buf m (goto-char (ed-current-buf m) point))))
(defn- text-of (m) (buffer-text (cur m)))
(defn- with-fill-column (m column)
  (ed-set-buf m (conventions/with-buffer-setting (cur m) :fill-column column)))
(defn- fill-at (text file point column)
  ;; the text M-q leaves, at `column`
  (text-of (ed-update (with-fill-column (file-model text file point) column) :alt-q 80 24)))

(describe "M-q keeps a hanging indent"
  (test "a list item continues under its text"
    (assert= (fill-at "- one two three four five six" "a.txt" 3 14)
      "- one two\n  three four\n  five six"))
  (test "a numbered item and an Org checkbox hang the same way"
    (assert= (fill-at "1. one two three four" "a.txt" 0 10) "1. one two\n   three\n   four")
    (assert= (fill-at "- [ ] one two three" "a.org" 0 13) "- [ ] one two\n      three"))
  (test "only the item point is in is filled; the list is not run together"
    (assert= (fill-at "- aa bb\n- cc dd ee ff\n- gg" "a.txt" 10 10)
      "- aa bb\n- cc dd ee\n  ff\n- gg"))
  (test "a paragraph keeps its second line's indentation for the rest"
    (assert= (fill-at "Term one two\n    three four five six" "a.txt" 0 16)
      "Term one two\n    three four\n    five six")))

(describe "M-q keeps a comment or quote's prefix"
  (test "a comment above code fills the comment and leaves the code alone"
    (let (text "(defn f ()\n  ;; one two three four five six\n  ;; seven\n  (g))")
      (assert= (fill-at text "a.blsp" 15 23)
        "(defn f ()\n  ;; one two three four\n  ;; five six seven\n  (g))")))
  (test "a `#` comment in Python and a `//` comment in Go"
    (assert= (fill-at "# aa bb cc dd" "a.py" 0 8) "# aa bb\n# cc dd")
    (assert= (fill-at "// aa bb cc dd" "a.go" 0 9) "// aa bb\n// cc dd"))
  (test "a list inside a comment hangs inside it"
    (assert= (fill-at ";; - aa bb cc dd" "a.blsp" 0 11) ";; - aa bb\n;;   cc dd"))
  (test "a Markdown quote keeps its marker, nested too, and stops at the text after it"
    (assert= (fill-at "> aa bb cc dd" "a.md" 0 8) "> aa bb\n> cc dd")
    (assert= (fill-at "> > aa bb cc" "a.md" 0 10) "> > aa bb\n> > cc")
    (assert= (fill-at "> aa bb cc\nplain text" "a.md" 0 8) "> aa bb\n> cc\nplain text")))

(describe "M-q in a mode's own paragraphs"
  (test "an Org heading is never filled into the text under it"
    (assert= (fill-at "* Heading\nbody one two three" "a.org" 12 10)
      "* Heading\nbody one\ntwo three")
    ;; on the heading itself there is nothing to fill
    (assert= (fill-at "* Heading one two three\nbody" "a.org" 2 10) "* Heading one two three\nbody"))
  (test "a Markdown fence and a table row stay as they are"
    (assert= (fill-at "```\naa bb cc dd\n```" "a.md" 0 6) "```\naa bb cc dd\n```")
    (assert= (fill-at "| a | b |\naa bb cc" "a.md" 12 5) "| a | b |\naa bb\ncc"))
  (test "a one-line Brood docstring continues at column 0"
    (assert= (fill-at "(defn f ()\n  \"Aa bb cc dd ee.\"\n  1)" "a.blsp" 14 12)
      "(defn f ()\n  \"Aa bb cc\ndd ee.\"\n  1)"))
  (test "a docstring's paragraph keeps its indentation and stops at the closing quotes"
    ;; Elixir's `@doc` heredoc (its grammar is built in; Python's is a separate download)
    (assert= (fill-at "  @doc \"\"\"\n  Doc.\n\n  aa bb cc dd ee\n  \"\"\"\n  def f, do: 1"
               "a.ex" 20 10)
      "  @doc \"\"\"\n  Doc.\n\n  aa bb cc\n  dd ee\n  \"\"\"\n  def f, do: 1"))
  (test "a Python docstring fills with no grammar installed, its closing quotes left alone"
    ;; the string is found by Python's string syntax (`stringstate`), not by a parse
    (assert= (fill-at "def f():\n    \"\"\"Doc.\n\n    aa bb cc dd ee\n    \"\"\"\n    return 1"
               "a.py" 22 14)
      "def f():\n    \"\"\"Doc.\n\n    aa bb cc\n    dd ee\n    \"\"\"\n    return 1")
    ;; a `#` inside the docstring is text, not a comment
    (assert= (fill-at "x = 1\n'''aa # bb cc dd'''" "a.py" 8 10) "x = 1\n'''aa # bb\ncc dd'''"))
  (test "in code, outside a comment or a string, there is nothing to fill"
    (assert= (fill-at "def f(aa, bb, cc, dd), do: aa" "a.ex" 2 10) "def f(aa, bb, cc, dd), do: aa"))
  (test "point stays on the character it was on"
    (let (m (ed-update (with-fill-column (file-model "- aa bb cc dd" "a.txt" 9) 8) :alt-q 80 24))
      (assert= (text-of m) "- aa bb\n  cc dd")
      ;; point was before `c` of `cc` (offset 8); it is before it still
      (assert= (string/char-at (text-of m) (buffer-point (cur m))) "c"))))

(describe "auto-fill-mode"
  (defn- typed (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
  (defn- auto (text file column)
    ;; a model at the end of `text` with auto-fill on and fill column `column`
    (let (m (file-model text file (count text)))
      (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) column)))

  (test "a space past the fill column breaks the line at the last space within it"
    (assert= (text-of (typed (auto "aa bb cc" "a.txt" 6) [" "])) "aa bb\ncc "))
  (test "a list item's new line hangs under its text"
    (assert= (text-of (typed (auto "- aa bb cc" "a.txt" 8) [" "])) "- aa bb\n  cc "))
  (test "a comment's new line keeps its marker; RET breaks too"
    (assert= (text-of (typed (auto "# aa bb cc" "a.py" 8) [" "])) "# aa bb\n# cc ")
    (assert= (text-of (typed (auto ";; aa bb cc" "a.blsp" 9) [:enter])) ";; aa bb\n;; cc\n"))
  (test "in code only a comment is broken"
    (assert= (text-of (typed (auto "x = aa + bb + cc" "a.py" 8) [" "])) "x = aa + bb + cc "))
  (test "within the column, and with the mode off, nothing breaks"
    (assert= (text-of (typed (auto "aa bb" "a.txt" 20) [" "])) "aa bb ")
    (let (m (file-model "aa bb cc" "a.txt" 8))
      (assert= (text-of (typed (with-fill-column m 6) [" "])) "aa bb cc ")))
  (test "M-x auto-fill-mode toggles it for the buffer, and the setting turns it on per mode"
    (let (m (file-model "x" "a.txt" 1)
          on (cmd-auto-fill-mode m nil))
      (is (not (auto-fill? m (cur m))))
      (is (auto-fill? on (cur on)))
      (is (includes? (:echo on) "enabled"))
      (let (off (cmd-auto-fill-mode on nil)) (is (not (auto-fill? off (cur off)))))
      (is (auto-fill? (assoc m :auto-fill {:text true}) (cur m)))
      (is (not (auto-fill? (assoc m :auto-fill {:default true :text false}) (cur m)))))))

(describe "the markers are the mode's"
  (test "code that starts with `#` in C and Rust is code, not a comment"
    (assert= (fill-at "#include <a.h>\n#include <b.h>\n" "a.c" 3 70)
      "#include <a.h>\n#include <b.h>\n")
    (assert= (fill-at "#[derive(Debug)]\n#[serde(x)]\nstruct S;" "a.rs" 3 70)
      "#[derive(Debug)]\n#[serde(x)]\nstruct S;"))
  (test "a C block comment's ` * ` lines fill as a comment, between its lone opener and closer"
    (assert= (fill-at "/**\n * aa bb cc dd ee ff gg\n * hh\n */" "a.js" 8 12)
      "/**\n * aa bb cc\n * dd ee ff\n * gg hh\n */"))
  (test "a Markdown heading is never filled into the text below it"
    (assert= (fill-at "# Title\nsome text here" "a.md" 10 70) "# Title\nsome text here"))
  (test "auto-fill does not break a C `#define`"
    (let (text "#define LONG_MACRO_NAME some_value + other"
          m (file-model text "a.c" (count text))
          on (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) 30))
      (assert= (text-of (ed-update on " " 80 24)) (str text " ")))))

(describe "a bare marker line separates paragraphs"
  (test "`;;`, `#` and `>` alone on a line"
    (assert= (fill-at ";; aa\n;; bb\n;;\n;; cc\n;; dd" "a.blsp" 3 40) ";; aa bb\n;;\n;; cc\n;; dd")
    (assert= (fill-at "# aa\n# bb\n#\n# cc" "a.py" 2 40) "# aa bb\n#\n# cc")
    (assert= (fill-at "> aa\n> bb\n>\n> cc" "a.md" 2 40) "> aa bb\n>\n> cc")))

(describe "M-q in code fills only a string that can span lines, and only its text"
  (test "a one-line string is left alone, and the code around it"
    (assert= (fill-at "const msg = \"aa bb cc dd ee ff gg hh ii\";" "a.js" 16 20)
      "const msg = \"aa bb cc dd ee ff gg hh ii\";")
    (assert= (fill-at "x = foo('aa bb cc dd ee ff gg hh', y)" "a.py" 12 20)
      "x = foo('aa bb cc dd ee ff gg hh', y)"))
  (test "a triple-quoted string opened mid-line fills from its opener, the code before it kept"
    (assert= (fill-at "x = \"\"\"aa bb cc dd ee\"\"\" + y" "a.py" 9 16)
      "x = \"\"\"aa bb cc\ndd ee\"\"\" + y")))

(describe "point across a refill"
  (test "on the first character of a line it stays on that character"
    (let (m (ed-update (with-fill-column (file-model "aa bb\ncc dd" "a.txt" 6) 40) :alt-q 80 24))
      (assert= (text-of m) "aa bb cc dd")
      (assert= (buffer-point (cur m)) 6)))
  (test "in a commented paragraph whose lines join or split, markers not counted"
    (let (joined (ed-update (with-fill-column (file-model ";; aa bb\n;; dd ee" "a.blsp" 12) 40)
                   :alt-q 80 24)
          split (ed-update (with-fill-column (file-model ";; aa bb dd ee ff gg" "a.blsp" 15) 10)
                  :alt-q 80 24))
      (assert= (text-of joined) ";; aa bb dd ee")
      (assert= (string/char-at (text-of joined) (buffer-point (cur joined))) "d")
      (assert= (buffer-point (cur joined)) 9)
      (assert= (text-of split) ";; aa bb\n;; dd ee\n;; ff gg")
      (assert= (string/char-at (text-of split) (buffer-point (cur split))) "f"))))

(describe "fill counts columns"
  (test "a wide glyph is two columns"
    (assert= (fill-at "日本 日本 日本" "a.txt" 0 10) "日本 日本\n日本")))

(describe "auto-fill's break and the space are one undo"
  (test "one undo takes both back"
    (let (m (file-model "aa bb cc" "a.txt" 8)
          on (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) 6)
          typed (ed-update on " " 80 24)
          undone (ed-update typed :ctrl-/ 80 24))
      (assert= (text-of typed) "aa bb\ncc ")
      (assert= (text-of undone) "aa bb cc"))))

(describe "auto-fill of a comment after code (comment-indent-new-line)"
  (defn- auto-at-end (text file column)
    (let (m (file-model text file (count text)))
      (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) column)))
  (test "Python: the comment goes on at its own column with its marker"
    (assert= (text-of (ed-update (auto-at-end "x = 1  # aa bb cc dd ee" "a.py" 14) " " 80 24))
      "x = 1  # aa bb\n       # cc dd\n       # ee "))
  (test "C: a `//` comment"
    (assert= (text-of (ed-update (auto-at-end "int x = 1;  // aa bb cc dd" "a.c" 20) " " 80 24))
      "int x = 1;  // aa bb\n            // cc dd "))
  (test "Lisp: a `;` comment"
    (assert= (text-of (ed-update (auto-at-end "(foo) ; aa bb cc dd" "a.blsp" 14) " " 80 24))
      "(foo) ; aa bb\n      ; cc dd "))
  (test "the code is never broken: a fill column inside the code breaks nothing"
    (assert= (text-of (ed-update (auto-at-end "x = some_call(a, b)  # cc" "a.py" 10) " " 80 24))
      "x = some_call(a, b)  # cc "))
  (test "a line inside a docstring is text: its `#` is no comment marker to continue"
    (let (filled (text-of (ed-update (auto-at-end "def f():\n    \"\"\"Doc\n    see issue #12 for the many details that matter"
                                       "a.py" 30)
                            " " 80 24)))
      (is (not (includes? filled "# details")))
      (is (string/starts-with? filled
            "def f():\n    \"\"\"Doc\n    see issue #12 for the many\n    details"))))
  (test "a Lisp docstring's `;=>` example is text too"
    (let (filled (text-of (ed-update (auto-at-end "(defn f ()\n  \"Doc\n    (f 1)   ;=> 2 and some more words past it all"
                                       "a.blsp" 30)
                            " " 80 24)))
      (is (not (includes? filled "; more")))
      (is (not (includes? filled "; it")))))
  (test "only a line past the column reads its string state, and the read is kept"
    (let (within (auto-at-end "x = 1  # aa" "a.py" 40)
          [within-after within-fill] (ed-auto-fill within)
          past (auto-at-end "x = 1  # aa bb cc dd ee" "a.py" 14)
          [past-after past-fill] (ed-auto-fill past)
          index (ed-current-index past))
      ;; within the column: nothing lexed, the buffer untouched
      (is (nil? (get (or (:string-caches within-after) {}) (ed-current-index within))))
      (assert= (text-of (ed-set-buf within-after (within-fill (cur within-after)))) "x = 1  # aa")
      ;; past it: the line state was read, and the model keeps the cache it left
      (is (nil? (get (or (:string-caches past) {}) index)))
      (is (not (nil? (get (:string-caches past-after) index))))
      (assert= (buffer-text (past-fill (cur past-after)))
        "x = 1  # aa bb\n       # cc dd\n       # ee"))))

(describe "the reviewer's auto-fill probe, its exact sequence"
  ;; The probe typed a space at the end of "aa bb cc" (fill column 6), then C-/, and printed
  ;; each with `(string/char-at text point)` — which raises when point is at the END of the
  ;; text (point 9 of the 9-character "aa bb\ncc "): `string/substring: range [9, 10) out of
  ;; bounds`. That raise was the probe's failure. The editor's answer is pinned here.
  (test "a space past the column breaks the line; one C-/ takes the break and the space back"
    (let (m (file-model "aa bb cc" "a.txt" 8)
          on (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) 6)
          after (fold [" "] on (fn (acc k) (ed-update acc k 80 24)))
          undone (fold [:ctrl-/] after (fn (acc k) (ed-update acc k 80 24))))
      (assert= [(text-of after) (buffer-point (cur after))] ["aa bb\ncc " 9])
      (assert= [(text-of undone) (buffer-point (cur undone))] ["aa bb cc" 8]))))

(describe "auto-fill breaks until the line fits (do-auto-fill's loop)"
  (defn- spaced (text file column)
    ;; a long line already there — yanked or pasted — then a space typed at its end
    (let (m (file-model text file (count text))
          on (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) column))
      (ed-update on " " 80 24)))
  (test "plain text: three breaks from one space"
    (assert= (text-of (spaced "aa bb cc dd ee ff gg" "a.txt" 6)) "aa bb\ncc dd\nee ff\ngg "))
  (test "a comment line: each new line keeps the marker"
    (assert= (text-of (spaced ";; aa bb cc dd ee ff gg hh" "a.blsp" 8))
      ";; aa bb\n;; cc dd\n;; ee ff\n;; gg hh "))
  (test "a comment after code: it goes on at its column, the code never split"
    (assert= (text-of (spaced "x = 1  # aa bb cc dd ee ff gg hh" "a.py" 14))
      "x = 1  # aa bb\n       # cc dd\n       # ee ff\n       # gg hh "))
  (test "one undo takes every break and the space back, point where it was"
    (let (text "aa bb cc dd ee ff gg"
          typed (spaced text "a.txt" 6)
          undone (ed-update typed :ctrl-/ 80 24))
      (assert= (buffer-point (cur typed)) (count (text-of typed)))
      (assert= [(text-of undone) (buffer-point (cur undone))] [text (count text)]))))

(describe "a C block comment fills from its opener's line"
  (test "M-q on `/* …` takes the lines below it, continuing with ` * `"
    (assert= (fill-at "/* aa bb cc dd\n * ee ff\n */" "a.c" 4 11) "/* aa bb cc\n * dd ee ff\n */")
    (assert= (fill-at "/** aa bb cc dd */" "a.js" 5 11) "/** aa bb\n * cc dd */"))
  (test "and from a ` * ` line below it, the opener's text joins in"
    (assert= (fill-at "/* aa\n * bb cc dd ee\n */" "a.c" 10 11) "/* aa bb cc\n * dd ee\n */")))

(describe "auto-fill's breaks are one pass"
  (test "a 1600-word line is broken whole by one space, every line fitting"
    (let (text (string/join (map (range 1600) (fn (_) "ab")) " ")
          m (file-model text "a.txt" (count text))
          on (with-fill-column (ed-set-buf m (assoc (cur m) :auto-fill true)) 70)
          after (ed-update on " " 80 24)
          lines (string/split (text-of after) "\n"))
      (is (every? lines (fn (line) (<= (string/display-width (string/trim-right line)) 70))))
      (assert= (string/replace (text-of after) "\n" " ") (str text " ")))))

;; Emacs 31's unfill-paragraph: M-q's paragraph joined back into one line
(describe "M-x unfill-paragraph"
  (defn- unfill-at (text file point)
    (text-of (cmd-unfill-paragraph (file-model text file point) nil)))
  (test "a filled paragraph becomes one line, the next paragraph left alone"
    (assert= (unfill-at "one two\nthree four\nfive\n\nnext para" "a.txt" 0)
      "one two three four five\n\nnext para"))
  (test "a list item keeps its marker, a comment its prefix, on the one line"
    (assert= (unfill-at "- one two\n  three four" "a.txt" 0) "- one two three four")
    (let (text "(defn f ()\n  ;; one two three\n  ;; four five\n  (g))")
      (assert= (unfill-at text "a.blsp" 15) "(defn f ()\n  ;; one two three four five\n  (g))")))
  (test "one undo puts the lines back"
    (let (unfilled (cmd-unfill-paragraph (file-model "one two\nthree" "a.txt" 0) nil))
      (assert= (buffer-text (undo (cur unfilled))) "one two\nthree"))))
