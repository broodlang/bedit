;; org-mode's structure editing (src/org-mode.blsp), through its keys: new headings and items
;; (M-RET, C-RET and their TODO forms), promote / demote / move (the M-arrows), the keyword and
;; the priority (the S-arrows), checkboxes and their `[2/3]` cookies (C-c C-c), and the outline
;; motions. The outline facts under them are `org`'s, tested in tests/org_test.blsp.
(defmodule org-mode-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use editor/buffer))

(def outline "* One\nbody of one\n** One.a\nbody of a\n** One.b\nbody of b\n* Two\nbody of two\n")

(defn- org-model (text) (ed-init (make-buffer text "notes.org" "notes.org")))
(defn- text-of (m) (buffer-text (cur m)))
(defn- press (m keys) (fold keys m (fn (acc key) (ed-update acc key 60 20))))
(defn- at (m line column)
  (ed-set-buf m (goto-char (cur m) (+ (text/line->char (buffer-rope (cur m)) line) column))))
(defn- point-of (m) [(buffer-current-line (cur m)) (buffer-column (cur m))])
(defn- org-at (text line column) (at (org-model text) line column))

(describe "M-RET: a new heading or item where point is"
  (test "at the end of a heading, a sibling below it, point after its stars"
    (let (m (press (org-at "** Head\n" 0 7) [:alt-enter]))
      (assert= (text-of m) "** Head\n** \n")
      (assert= (point-of m) [1 3])))
  (test "at the start of a heading, a sibling before it"
    (let (m (press (org-at "** Head\n" 0 0) [:alt-enter]))
      (assert= (text-of m) "** \n** Head\n")
      (assert= (point-of m) [0 3])))
  (test "inside a heading's title, the title after point goes to the new heading"
    (assert= (text-of (press (org-at "* Buy milk\n" 0 6) [:alt-enter])) "* Buy\n* milk\n"))
  (test "on a folded heading, the new sibling goes after what the fold hides"
    (let (m (press (org-at outline 0 0) [:tab :alt-enter]))
      (assert= (text-of m)
        "* One\nbody of one\n** One.a\nbody of a\n** One.b\nbody of b\n* \n* Two\nbody of two\n")
      (assert= (point-of m) [6 2])
      (assert= (folds/folded-lines (cur m)) '(0))))
  (test "in text under a heading, a heading at that heading's level; at the line's start, the line"
    (assert= (text-of (press (org-at "** Plan\nsome text\n" 1 4) [:alt-enter]))
      "** Plan\nsome\n** text\n")
    (assert= (text-of (press (org-at "** Plan\nsome text\n" 1 0) [:alt-enter]))
      "** Plan\n** some text\n"))
  (test "on a list item, the next item: a checkbox carried, a number counted on, the list renumbered"
    (assert= (text-of (press (org-at "- milk\n" 0 6) [:alt-enter])) "- milk\n- \n")
    (assert= (text-of (press (org-at "- [X] milk\n" 0 10) [:alt-enter])) "- [X] milk\n- [ ] \n")
    (assert= (text-of (press (org-at "1. a\n2. b\n" 0 4) [:alt-enter])) "1. a\n2. \n3. b\n"))
  (test "the new item goes after the item's sub-items, and before it from the item's start"
    (let (m (press (org-at "- a\n  - b\n- c\n" 0 3) [:alt-enter]))
      (assert= (text-of m) "- a\n  - b\n- \n- c\n")
      (assert= (point-of m) [2 2]))
    (assert= (text-of (press (org-at "1. a\n2. b\n" 1 0) [:alt-enter])) "1. a\n2. \n3. b\n")))

(describe "C-RET and the TODO forms"
  (test "C-RET: a heading at the entry's level after its whole subtree, wherever point is"
    (let (m (press (org-at outline 3 2) [:ctrl-enter]))
      (assert= (text-of m)
        "* One\nbody of one\n** One.a\nbody of a\n** \n** One.b\nbody of b\n* Two\nbody of two\n")
      (assert= (point-of m) [4 3])))
  (test "C-RET goes after the subtree's text, the blank line before the next heading kept below it"
    (let (m (press (org-at "** A\n*** a1\n*** b\n\n** R\n" 2 5) [:ctrl-enter]))
      (assert= (text-of m) "** A\n*** a1\n*** b\n*** \n\n** R\n")
      (assert= (point-of m) [3 4])))
  (test "a folded heading's M-RET sibling goes before the blank lines after its subtree too"
    (assert= (text-of (press (org-at "* A\nbody\n\n* B\n" 0 0) [:tab :alt-enter]))
      "* A\nbody\n* \n\n* B\n"))
  (test "C-RET on the last heading appends after its body, before the file's final newline"
    (assert= (text-of (press (org-at "* A\ntext\n" 0 1) [:ctrl-enter])) "* A\ntext\n* \n"))
  (test "M-S-RET: a TODO heading, or on an item a checkbox item"
    (assert= (text-of (press (org-at "* Head\n" 0 6) [:alt-shift-enter])) "* Head\n* TODO \n")
    (assert= (text-of (press (org-at "- milk\n" 0 6) [:alt-shift-enter])) "- milk\n- [ ] \n"))
  (test "C-S-RET: a TODO heading after the subtree"
    (assert= (text-of (press (org-at "* A\n** B\n" 0 0) [:ctrl-shift-enter]))
      "* A\n** B\n* TODO \n")))

(describe "promote, demote and move"
  (test "M-<right> / M-<left> change one heading; a top-level heading cannot be promoted"
    (let (m (press (org-at "* Head\n** Sub\n" 0 2) [:alt-right]))
      (assert= (text-of m) "** Head\n** Sub\n")
      (assert= (point-of m) [0 3])
      (assert= (text-of (press m [:alt-left])) "* Head\n** Sub\n"))
    (is (includes? (:echo (press (org-at "* Head\n" 0 0) [:alt-left])) "level 0")))
  (test "M-S-<right> / M-S-<left> take the subtree along"
    (let (m (press (org-at "* A\n** B\ntext\n* C\n" 0 0) [:alt-shift-right]))
      (assert= (text-of m) "** A\n*** B\ntext\n* C\n")
      (assert= (text-of (press m [:alt-shift-left])) "* A\n** B\ntext\n* C\n")))
  (test "M-<right> / M-<left> indent and outdent a list item; M-S- with its sub-items"
    (assert= (text-of (press (org-at "- a\n- b\n" 1 2) [:alt-right])) "- a\n  - b\n")
    (assert= (text-of (press (org-at "- a\n  - b\n" 1 4) [:alt-left])) "- a\n- b\n")
    (assert= (text-of (press (org-at "- a\n- b\n  - c\n" 1 0) [:alt-shift-right]))
      "- a\n  - b\n    - c\n"))
  (test "M-<left> / M-<right> in text move by words, as everywhere"
    (assert= (point-of (press (org-at "some text here\n" 0 14) [:alt-left])) [0 10]))
  (test "M-<up> / M-<down> swap a subtree with its sibling, point moving with it"
    (let (m (press (org-at outline 6 3) [:alt-up]))
      (assert= (text-of m)
        "* Two\nbody of two\n* One\nbody of one\n** One.a\nbody of a\n** One.b\nbody of b\n")
      (assert= (point-of m) [0 3])
      (assert= (text-of (press m [:alt-down])) outline)))
  (test "a subtree moves only among its siblings"
    (is (includes? (:echo (press (org-at outline 2 0) [:alt-up])) "Cannot move"))
    (assert= (text-of (press (org-at outline 2 0) [:alt-down]))
      "* One\nbody of one\n** One.b\nbody of b\n** One.a\nbody of a\n* Two\nbody of two\n"))
  (test "a folded subtree stays folded where it moved to"
    (let (m (press (org-at outline 0 0) [:tab :alt-down]))
      (assert= (folds/folded-lines (cur m)) '(2))
      (assert= (point-of m) [2 0])))
  (test "an item moves with its sub-items, and an ordered list is numbered again"
    (assert= (text-of (press (org-at "- a\n  - a1\n- b\n" 2 0) [:alt-up])) "- b\n- a\n  - a1\n")
    (assert= (text-of (press (org-at "1. a\n2. b\n" 1 0) [:alt-up])) "1. b\n2. a\n"))
  (test "in text, M-<up> / M-<down> drag the line"
    (assert= (text-of (press (org-at "* H\none\ntwo\n" 2 0) [:alt-up])) "* H\ntwo\none\n")))

(describe "the keyword and the priority"
  (test "S-<right> / S-<left> step the TODO keyword either way"
    (assert= (text-of (press (org-at "* Write\n" 0 0) [:shift-right])) "* TODO Write\n")
    (assert= (text-of (press (org-at "* Write\n" 0 0) [:shift-left])) "* DONE Write\n"))
  (test "S-<up> / S-<down> step the priority, after the keyword"
    (assert= (text-of (press (org-at "* TODO Write\n" 0 0) [:shift-up])) "* TODO [#A] Write\n")
    (assert= (text-of (press (org-at "* TODO Write\n" 0 0) [:shift-down])) "* TODO [#C] Write\n"))
  (test "off a heading the S-arrows select, as everywhere"
    (let (m (press (org-at "some text\n" 0 0) [:shift-right :shift-right]))
      (assert= (text-of m) "some text\n")
      (assert= (point-of m) [0 2])
      (is (not (nil? (region/ed-active-region m))))))
  (test "C-c C-t cycles the keyword and refuses off a heading"
    (let (m (press (org-model "* Write it\n") [:ctrl-c :ctrl-t]))
      (assert= (text-of m) "* TODO Write it\n")
      (assert= (text-of (press m [:ctrl-c :ctrl-t])) "* DONE Write it\n"))
    (is (includes? (:echo (press (org-model "text\n") [:ctrl-c :ctrl-t])) "Not on a heading"))))

(describe "C-c C-c: checkboxes and their statistics"
  (test "ticks a checkbox and clears it again, the heading's cookie counting"
    (let (m (press (org-at "* Shop [/]\n- [ ] milk\n- [ ] eggs\n" 1 4) [:ctrl-c :ctrl-c]))
      (assert= (text-of m) "* Shop [1/2]\n- [X] milk\n- [ ] eggs\n")
      (assert= (point-of m) [1 4])
      (assert= (text-of (press m [:ctrl-c :ctrl-c])) "* Shop [0/2]\n- [ ] milk\n- [ ] eggs\n")))
  (test "a parent item's checkbox and percentage follow its sub-items"
    (let (text "- [ ] all [0%]\n  - [ ] a\n  - [ ] b\n"
          half (press (org-at text 1 4) [:ctrl-c :ctrl-c]))
      (assert= (text-of half) "- [-] all [50%]\n  - [X] a\n  - [ ] b\n")
      (assert= (text-of (press (at half 2 4) [:ctrl-c :ctrl-c]))
        "- [X] all [100%]\n  - [X] a\n  - [X] b\n")))
  (test "on a cookie it counts again; elsewhere it says there is nothing to do"
    (assert= (text-of (press (org-at "* Shop [/]\n- [X] milk\n" 0 0) [:ctrl-c :ctrl-c]))
      "* Shop [1/1]\n- [X] milk\n")
    (is (includes? (:echo (press (org-at "text\n" 0 0) [:ctrl-c :ctrl-c])) "Nothing to do"))))

(describe "moving around the outline"
  (test "C-c C-n / C-c C-p move between headings at any level"
    (let (m (press (org-model outline) [:ctrl-c :ctrl-n :ctrl-c :ctrl-n]))
      (assert= (point-of m) [4 0])
      (assert= (point-of (press m [:ctrl-c :ctrl-p])) [2 0])))
  (test "C-c C-f / C-c C-b move among siblings, C-c C-u up to the parent"
    (assert= (point-of (press (org-at outline 1 0) [:ctrl-c :ctrl-f])) [6 0])
    (assert= (point-of (press (org-at outline 5 3) [:ctrl-c :ctrl-b])) [2 0])
    (assert= (point-of (press (org-at outline 5 3) [:ctrl-c :ctrl-u])) [0 0])
    (is (includes? (:echo (press (org-at outline 7 0) [:ctrl-c :ctrl-u])) "top level"))))
