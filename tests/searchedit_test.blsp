;; tests/searchedit_test.blsp — editable search results (Emacs's wgrep) and the project-wide
;; replace over them: the rows' text is editable and nothing else, C-c C-c writes each changed
;; row to its line, C-c C-k puts them back, and a line changed since the search is skipped.

(defmodule searchedit-test
  (:use testkit :only [press cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use editor/buffer)
  (:use-internals searchedit))

(defn- project ()
  ;; a project whose file NAMED foo would be a match in the read-only `file:line:` prefix
  (let (root (temp-dir "bedit-searchedit-"))
    (file/mkdir root)
    (file/spit (path/join root "a.txt") "foo one\nbar\nfoo two\n")
    (file/spit (path/join root "foo.txt") "x foo\n")
    root))

(defn- searched (root pattern)
  ;; *Project Search* for `pattern` over `root` — the search runs inline headless
  (project-search/ed-project-search (assoc (ed-init (make-buffer "")) :project-root root)
    root pattern))

(defn- file-text (m root name)
  ;; the text of `name`'s buffer, or nil when it was never opened
  (let (index (ed-buffer-index-by-file m (path/join root name)))
    (when (int? index) (buffer-text (ed-buf-at m index)))))

(describe "editable search results"
  (test "C-c C-p makes only the rows' text editable"
    (let (root (project)
          editing (press (searched root "foo") [:ctrl-c :ctrl-p])
          buffer (cur editing))
      (is (searchedit/editing? buffer))
      (assert= (count (editable-regions buffer)) 3)
      ;; the header is not editable
      (is (position-read-only? buffer 0))))

  (test "a replace over the rows passes over the file names, and C-c C-c writes the rows"
    (let (root (project)
          replaced (press (searchedit/replace-in-results (searched root "foo") "foo" "baz") ["!"])
          written (press replaced [:ctrl-c :ctrl-c]))
      ;; foo.txt's name is not a row's text: the replace went on past it
      (is (regex/find (buffer-text (cur replaced)) "foo\\.txt:1:x baz"))
      (assert= (file-text written root "a.txt") "baz one\nbar\nbaz two\n")
      (assert= (file-text written root "foo.txt") "x baz\n")
      (is (includes? (:echo written) "3 lines changed in 2 files"))
      ;; back in the results, read-only again
      (assert= (buffer-name (cur written)) "*Project Search*")
      (is (read-only? (cur written)))))

  (test "C-c C-k puts the rows back and stops editing"
    (let (root (project)
          replaced (press (searchedit/replace-in-results (searched root "foo") "foo" "baz") ["!"])
          aborted (press replaced [:ctrl-c :ctrl-k]))
      (refute (regex/find (buffer-text (cur aborted)) "baz"))
      (refute (searchedit/editing? (cur aborted)))))

  (test "a line changed since the search is skipped, not overwritten"
    (let (root (project)
          editing (press (searched root "foo") [:ctrl-c :ctrl-p])
          ;; a.txt's first line changes in its buffer after the search
          opened (pool/ed-find-file editing (path/join root "a.txt"))
          changed (ed-edit opened (fn (b) (insert (goto-char b 0) "!")))
          back (pool/ed-return-to changed "*Project Search*" 0)
          written (press (press back [(keyword "alt-%")])
                    (into (string/->list "foo")
                      (into [:enter] (into (string/->list "baz") [:enter "!" :ctrl-c :ctrl-c])))))
      (assert= (file-text written root "a.txt") "!foo one\nbar\nbaz two\n")
      (is (includes? (:echo written) "1 line skipped")))))

;; *Occur* had no occur-edit-mode: `e` now opens its rows as wgrep opens *Project Search*'s.
(defn- occurred (text needle)
  ;; *Occur* for `needle` over a buffer holding `text`
  (press (ed-init (make-buffer text)) (into [:alt-s "o"] (into (string/->list needle) [:enter]))))

(defn- at-line (m line) (ed-apply m (fn (b) (pool/ed-goto-line b line))))

(describe "occur-edit"
  (test "e makes the matches editable — letters type — and C-c C-c writes them to the buffer"
    (let (shown (occurred "foo one\nbar\nfoo two\n" "foo")
          editing (press shown ["e"])
          typed (press (at-line editing 3) (into [:ctrl-e] ["q" "!"]))
          written (press typed [:ctrl-c :ctrl-c])
          source (ed-buf-at written 0))
      (assert= (buffer-name (cur editing)) "*Occur*")
      (is (searchedit/editing? (cur editing)))
      (assert= (count (editable-regions (cur editing))) 2)
      (is (position-read-only? (cur editing) 0))
      (assert= (buffer-text source) "foo one\nbar\nfoo twoq!\n")
      (is (includes? (:echo written) "1 line changed"))
      (refute (searchedit/editing? (cur written)))
      (is (read-only? (cur written)))))

  (test "C-c C-k puts the rows back"
    (let (shown (occurred "foo one\nbar\n" "foo")
          aborted (press (press (at-line (press shown ["e"]) 2) [:ctrl-e "x"]) [:ctrl-c :ctrl-k]))
      (assert= (buffer-text (cur aborted)) (buffer-text (cur shown)))
      (refute (searchedit/editing? (cur aborted))))))
