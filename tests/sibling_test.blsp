;; M-x find-sibling-file (Emacs 29's): the file that belongs with this one, by rules as data.
(defmodule sibling-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use sibling))

(describe "the sibling rules"
  (test "a C source and its header, both ways"
    (is (includes? (sibling-paths "/p/a.c" *default-rules*) "/p/a.h"))
    (is (includes? (sibling-paths "/p/a.h" *default-rules*) "/p/a.c")))
  (test "a module and its test, both ways"
    (assert= (sibling-paths "/p/src/model.blsp" *default-rules*) ["/p/tests/model_test.blsp"])
    (assert= (sibling-paths "/p/tests/model_test.blsp" *default-rules*) ["/p/src/model.blsp"])
    (is (includes? (sibling-paths "/p/lib/shop/cart.ex" *default-rules*)
          "/p/test/shop/cart_test.exs"))
    (is (includes? (sibling-paths "/p/x_test.go" *default-rules*) "/p/x.go"))
    (is (includes? (sibling-paths "/p/src/a.test.ts" *default-rules*) "/p/src/a.ts")))
  (test "the init file's rules come first"
    (assert= (first (sibling-paths "/p/a.c" (append [["^(.*)\\.c$" "$1.inc"]] *default-rules*)))
      "/p/a.inc")))

(describe "M-x find-sibling-file"
  (defn- project ()
    (let (root (temp-dir "bedit-sibling-"))
      (file/mkdir root)
      (file/mkdir (path/join root "src"))
      (file/mkdir (path/join root "tests"))
      (file/spit (path/join root "src/cart.blsp") "(defmodule cart)\n")
      (file/spit (path/join root "tests/cart_test.blsp") "")
      root))
  (defn- visiting (path) (ed-init (make-buffer (file/slurp path) path path)))
  (test "the one sibling that exists is opened"
    (let (root (project)
          went (cmd-find-sibling-file (visiting (path/join root "src/cart.blsp")) nil))
      (assert= (buffer-file (ed-current-buf went)) (path/join root "tests/cart_test.blsp"))))
  (test "none is said"
    (let (root (project)
          lone (path/join root "src/lone.blsp")
          _ (file/spit lone "")
          said (cmd-find-sibling-file (visiting lone) nil))
      (is (includes? (:echo said) "no sibling of lone.blsp"))))
  (test "several are asked between"
    (let (root (project)
          c (path/join root "a.c")
          _ (file/spit c "")
          _ (file/spit (path/join root "a.h") "")
          _ (file/spit (path/join root "a.hpp") "")
          asked (cmd-find-sibling-file (visiting c) nil))
      (is (:minibuffer asked)))))
