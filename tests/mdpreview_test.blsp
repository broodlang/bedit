;; tests/mdpreview_test.blsp — the markdown preview pane (src/mdpreview.blsp) and the
;; `aside` pane discipline under it (src/aside.blsp).
;;
;; Pure model tests: a `.md` buffer, the command, keys through `ed-update` (so the mode's
;; `:on-move` follow and the `:idle-recompute` beat's `:on-idle` re-render run the way
;; they do live), and assertions on what the preview pane holds and where it is scrolled.

(defmodule mdpreview-test
  (:use testkit :only [press]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use editor/buffer)
  (:use editor/pane) ; pane-count / pane-leaf-paths / pane-payload-at — the layout
  (:use-internals mdpreview)
  (:use-internals aside))

(defn md-of (text)
  (ed-init (make-buffer text "notes.md" "notes.md")))
(defn beat (m) (ed-update m [:timer :idle-recompute] 80 24))
(defn open (m) (press m [:ctrl-c :ctrl-p]))
(defn preview-buf (m)
  (let (i (ed-buffer-index-by-name m mdpreview/*buffer-name*)) (if (nil? i) nil (ed-buf-at m i))))
(defn preview-text (m) (let (b (preview-buf m)) (if (nil? b) nil (buffer-text b))))
(defn preview-pane (m) (aside/pane-of mdpreview/*spec* m))
(defn preview-top (m)
  (let (p (preview-pane m)) (if (nil? p) nil (or (map/get-in p [:payload :top]) 0))))

(def *doc* "# Title\n\nSome **bold** words here.\n\n- one\n- two\n")

(describe "markdown-preview: the pane"
  (test "C-c C-p in a .md buffer opens *Markdown Preview* beside it, rendered, selection kept"
    (let (m (open (md-of *doc*)))
      (assert= (pane-count (:layout m)) 2)
      (assert= (buffer-name (ed-current-buf m)) "notes.md") ; still on the source
      (assert= (preview-text m) "Title\n━━━━━\n\nSome bold words here.\n\n• one\n• two")
      ;; rendered to the pane it opened in (39 columns on an 80-column window), not a guess
      (assert= (map/get-in m [:mdpreview :width]) 37)
      (is (includes? (:echo m) "markdown preview"))))

  (test "the rendered faces travel as data on the buffer, not from a lexer"
    (let (b (preview-buf (open (md-of *doc*)))
          spans (:face-spans b)
          bold (seq/find spans (fn (s) (= (nth s 2) {:bold true}))))
      (is (not (nil? bold)))
      (assert= (string/substring (buffer-text b) (nth bold 0) (nth bold 1)) "bold")))

  (test "the preview buffer is a read-only special buffer without line numbers"
    (let (b (preview-buf (open (md-of *doc*))))
      (is (read-only? b))
      (is (editor/layers/layer-collect b :no-line-numbers))))

  (test "C-c C-p again takes the pane and its buffer down, and says so"
    (let (m (press (open (md-of *doc*)) [:ctrl-c :ctrl-p]))
      (assert= (pane-count (:layout m)) 1)
      (is (nil? (preview-buf m)))
      (assert= (buffer-name (ed-current-buf m)) "notes.md")
      (is (includes? (:echo m) "closed"))))

  (test "M-x markdown-preview is the same command, known before the module ever loaded"
    (is (not (nil? (interactive/command-sym "markdown-preview")))))

  (test "in a buffer that is not markdown, C-c C-p is not bound"
    (let (m (press (ed-init (make-buffer "plain" "notes.txt" "notes.txt")) [:ctrl-c :ctrl-p]))
      (is (nil? (preview-buf m))))))

(describe "markdown-preview: following the text"
  (test "typing does not re-render on the key; the idle beat does"
    (let (m (open (md-of "# A\n\nb"))
          typed (press m ["!"]))
      ; point is at 0: "!# A" — no longer a heading
      (assert= (preview-text typed) "A\n━\n\nb") ; the key left the render alone
      (assert= (preview-text (beat typed)) "!# A\n\nb"))) ; the beat re-rendered
  (test "the beat re-renders only when the text changed"
    (let (m (beat (open (md-of "# A")))
          r1 (map/get-in m [:mdpreview :render])
          m2 (beat (press m [:ctrl-f])))
      (is (= r1 (map/get-in m2 [:mdpreview :render])))
      (is (= (map/get-in m [:mdpreview :rope]) (map/get-in m2 [:mdpreview :rope])))))

  (test "the beat opens nothing: no preview, no render"
    (let (m (beat (press (md-of *doc*) ["x"])))
      (is (nil? (preview-buf m)))
      (is (nil? (map/get-in m [:mdpreview :render])))))

  (test "the cursor's source line keeps its rendered line in view (scrolls when out of view)"
    ;; 60 headings: the preview (a 24-row window, ~22 rows of pane) cannot show them all
    (let (long (string/join (map (range 60) (fn (i) (str "# H" i "\n\ntext " i "\n"))) "")
          m (open (md-of long))
          ;; jump the source cursor to the last line: the preview must scroll to it
          at-end (press m [(keyword "alt->")]))
      (assert= (preview-top m) 0)
      (is (> (preview-top at-end) 0))
      ;; back to the top: scrolls back
      (assert= (preview-top (press at-end [(keyword "alt-<")])) 0)))

  (test "a move that stays in view leaves the preview's scroll alone"
    (let (m (open (md-of *doc*))
          moved (press m [:ctrl-n :ctrl-n]))
      (assert= (preview-top moved) 0)))

  ;; THE bug: the follow used to ride the `:post-key` GUARD facet, which runs on every event
  ;; a mouse gesture included — so each wheel notch over the preview re-asserted the cursor's
  ;; line and snapped the pane back to where it was. A follower rides `:on-move` now (layers
  ;; §7), which the dispatcher runs only when point or the text moved.
  (test "the wheel over the preview scrolls it and it STAYS scrolled: nothing moved the cursor"
    (let (long (string/join (map (range 60) (fn (i) (str "# H" i "\n\ntext " i "\n"))) "")
          m (open (md-of long))
          pane (preview-pane m)
          ;; a cell inside the preview pane (`:rect` is [x y w h]); a legacy notch and a
          ;; kinetic one (with a pixel delta), three of each
          [px py _ _] (:rect pane)
          notch [:mouse :scroll-down :none (+ py 3) (+ px 2) []]
          glide [:mouse :scroll-down :none (+ py 3) (+ px 2) [] 1.0]
          scrolled (press m [notch notch notch])
          glided (press m [glide glide glide]))
      (assert= (preview-top m) 0)
      (is (> (preview-top scrolled) 0))
      (is (> (preview-top glided) 0))
      ;; and a plain key that moves nothing (a prefix's C-g) leaves it there too
      (assert= (preview-top (press scrolled [:ctrl-g])) (preview-top scrolled))
      ;; while a real move of point does follow again: to the end, then back to the top
      ;; (a key that leaves point where it is — `M-<` at the top — is not a move either)
      (assert= (preview-top (press scrolled [(keyword "alt-<")])) (preview-top scrolled))
      (is (> (preview-top (press scrolled [(keyword "alt->")])) (preview-top scrolled)))
      (assert= (preview-top (press scrolled [(keyword "alt->") (keyword "alt-<")])) 0))))

(describe "markdown-preview: level with the source's scroll, and open on its own"
  (def long-doc (string/join (map (range 80) (fn (i) (str "# H" i "\n\ntext " i "\n"))) ""))
  (test "the wheel over the SOURCE scrolls the preview to the same place"
    (let (m (press (open (md-of long-doc)) [:ctrl-f])
          source (seq/find (:panes (panes/ed-layout-now m))
                   (fn (p) (= (map/get-in p [:payload :buffer]) 0)))
          [sx sy _ _] (:rect source)
          notch [:mouse :scroll-down :none (+ sy 3) (+ sx 2) []]
          scrolled (press m [notch notch notch notch])
          top (ed-current-top scrolled))
      (is (> top 0)) ; the source scrolled…
      ;; …and the preview's top is the rendered line of the source's top line
      (assert= (preview-top scrolled)
        (lex-markdown/markdown-rendered-line (map/get-in scrolled [:mdpreview :render]) top))))
  (test "with :markdown-preview on, the idle beat opens it beside a markdown buffer"
    (let (m (beat (press (assoc (md-of *doc*) :markdown-preview-auto true) [:ctrl-f])))
      (assert= (preview-text m) "Title\n━━━━━\n\nSome bold words here.\n\n• one\n• two")
      (assert= (buffer-name (ed-current-buf m)) "notes.md")))
  (test "off by default, and once closed it stays closed until C-c C-p"
    (let (auto (assoc (md-of *doc*) :markdown-preview-auto true)
          opened (beat (press auto [:ctrl-f]))
          closed (press opened [:ctrl-c :ctrl-p])
          later (beat (press closed [:ctrl-f])))
      (is (nil? (preview-buf (beat (press (md-of *doc*) [:ctrl-f])))))
      (is (nil? (preview-buf later)))
      (is (not (nil? (preview-buf (open later))))))))

(describe "markdown-preview: the buffer's life"
  (test "killing the markdown buffer takes the preview with it"
    (let (m (open (md-of *doc*))
          killed (pool/cmd-kill-buffer m :none))
      (is (nil? (preview-buf killed)))))

  (test "a preview taken down with its source does not latch: the next markdown file opens one"
    (let (auto (assoc (md-of *doc*) :markdown-preview-auto true)
          opened (beat (press auto [:ctrl-f]))
          killed (pool/cmd-kill-buffer opened :none)
          other (pool/ed-open-buffer killed (make-buffer "# B\n" "b.md" "b.md"))
          later (beat (press other [:ctrl-f])))
      (is (not (nil? (preview-buf opened))))
      (is (nil? (preview-buf killed)))
      (is (not (aside/closed? mdpreview/*spec* killed)))
      (assert= (buffer-name (ed-current-buf later)) "b.md")
      (is (not (nil? (preview-buf later))))
      ;; shown again, so the reader killing it now is a dismissal that latches
      (let (gone (pool/cmd-kill-buffer (window-commands/cmd-other-pane later :none) :none))
        (is (aside/closed? mdpreview/*spec* gone)))))

  (test "closing the pane latches: the beat will not bring it back, the command will"
    (let (m (beat (open (md-of "# A")))
          ;; the reader kills the preview from its own pane
          gone (pool/cmd-kill-buffer (window-commands/cmd-other-pane m :none) :none)
          typed (beat (press (window-commands/cmd-other-pane gone :none) ["x"])))
      (is (nil? (preview-buf gone)))
      (is (aside/closed? mdpreview/*spec* typed))
      (is (nil? (preview-buf typed)))
      (is (not (nil? (preview-buf (open typed))))))))

;; Live, the idle beat renders in a TASK (`launch`) and `apply-render` folds the answer in;
;; headless there is no loop to answer to, so the beat renders in place. The fold is driven
;; here directly: `in-flight` parks what `launch` would (the slot, and what the render is of
;; under `:pending`), and the result is the render a task would send.
(describe "markdown-preview: the render off the loop"
  (defn in-flight (m text)
    (-> m
      (assoc :mdpreview-proc :in-flight)
      (map/assoc-in [:mdpreview :pending]
        {:rope (buffer-rope (make-buffer text)) :width (map/get-in m [:mdpreview :width])})))
  (defn render-of (m text) (lex-markdown/markdown-render text (map/get-in m [:mdpreview :width])))

  (test "a landed render is shown, its slot and its pending record cleared"
    ;; typed past the last render, and the render in flight is of the text as it is now
    (let (m (press (open (md-of "# A")) ["!"])
          parked (-> m
                   (assoc :mdpreview-proc :in-flight)
                   (map/assoc-in [:mdpreview :pending]
                     {:rope (buffer-rope (ed-current-buf m))
                      :width (map/get-in m [:mdpreview :width])}))
          landed (apply-render parked (render-of m "!# A")))
      (assert= (preview-text m) "A\n━")
      (is (nil? (:mdpreview-proc landed)))
      (is (nil? (map/get-in landed [:mdpreview :pending])))
      (assert= (preview-text landed) "!# A")
      (is (fresh? landed (ed-current-buf landed)))))

  (test "a failed render leaves the last one up"
    (let (m (open (md-of "# A"))
          landed (apply-render (in-flight m "# A") :failed))
      (is (nil? (:mdpreview-proc landed)))
      (assert= (preview-text landed) "A\n━")))

  (test "a render of text that has moved on starts the next one"
    ;; the task rendered the text before the key; the fold sees the buffer moved on and
    ;; renders again (in place, headless) rather than leave it to a beat nobody promised
    (let (m (press (open (md-of "# A\n\nb")) ["!"])
          landed (apply-render (in-flight m "# A\n\nb") (render-of m "# A\n\nb")))
      (assert= (preview-text landed) "!# A\n\nb")
      (is (fresh? landed (ed-current-buf landed)))))

  (test "the beat launches nothing while a render is in flight"
    (let (busy (in-flight (press (open (md-of "# A")) ["!"]) "# A")
          beaten (markdown-on-idle busy))
      (assert= (preview-text beaten) "A\n━")
      (assert= (:mdpreview-proc beaten) :in-flight))))

(describe "aside: the pane discipline on its own"
  (def spec {:key :t :buffer "*T*" :type :markdown-preview})
  (defn shown? (m) (aside/open? spec m))

  (test "refresh without force only touches a pane already up; with force it opens one"
    (let (m (ed-init (make-buffer "x")))
      (is (not (shown? (aside/refresh spec m "hi" false))))
      (let (up (aside/refresh spec m "hi" true))
        (is (shown? up))
        (is (map/get-in up [:t :aside-shown?]))
        (assert= (buffer-text (ed-buf-at up (ed-buffer-index-by-name! up "*T*"))) "hi")
        (assert= (buffer-text (ed-buf-at (aside/refresh spec up "there" false)
                                (ed-buffer-index-by-name! up "*T*")))
          "there"))))

  (test "rendered content carries its spans onto the buffer"
    (let (up (aside/refresh spec
               (ed-init (make-buffer "x"))
               {:text "ab" :spans (list [0 1 {:bold true}])}
               true))
      (assert= (:face-spans (ed-buf-at up (ed-buffer-index-by-name! up "*T*")))
        (list [0 1 {:bold true}]))))

  (test "a pane shown and then gone is closed: latched against force; reopen clears it"
    (let (up (aside/refresh spec (ed-init (make-buffer "x")) "hi" true)
          gone (assoc up
                 :buffers
                   (into [] (seq/filter (:buffers up) (fn (b) (not (= (buffer-name b) "*T*")))))
                 :layout (pane-delete-others (:layout up)))
          latched (aside/refresh spec gone "hi" true))
      (is (aside/closed? spec gone))
      (is (not (shown? latched)))
      (is (map/get-in latched [:t :aside-closed?]))
      (is (shown? (aside/reopen spec latched "back")))
      (is (not (map/get-in (aside/reopen spec latched "back") [:t :aside-closed?])))))

  (test "close takes the pane down, keeps the reader's pane selected, and latches"
    (let (m (ed-init (make-buffer "x"))
          up (ed-update (aside/refresh spec m "hi" true) :ctrl-f 80 24) ; a frame, so the layout is known
          closed (aside/close spec up))
      (assert= (pane-count (:layout up)) 2)
      (assert= (pane-count (:layout closed)) 1)
      (is (not (shown? closed)))
      (assert= (buffer-text (ed-current-buf closed)) "x")
      (is (aside/closed? spec closed))))

  (test "forget is a new page: neither shown nor closed, the client's own state kept"
    (let (m (map/assoc-in (aside/close spec
                            (aside/refresh spec (ed-init (make-buffer "x")) "hi" true))
              [:t :mine]
              1)
          fresh (aside/forget spec m))
      (is (not (map/get-in fresh [:t :aside-closed?])))
      (is (not (map/get-in fresh [:t :aside-shown?])))
      (assert= (map/get-in fresh [:t :mine]) 1)))

  ;; the pieces every client used to write for itself: the toggle key, the follower on a
  ;; clock, the data a pane's buffer carries, and taking the pane with its source
  (test "toggle opens a pane even after it was closed, and closes an open one saying so"
    (let (m (ed-init (make-buffer "x"))
          open (fn (cleared) (aside/refresh spec cleared "hi" true))
          up (aside/toggle spec m open "gone")
          down (aside/toggle spec up open "gone")
          again (aside/toggle spec down open "gone"))
      (is (shown? up))
      (is (not (shown? down)))
      (assert= (:echo down) "gone")
      (is (aside/closed? spec down))
      (is (shown? again))))

  (test "sync re-shows an open pane only when its key moved, and never opens one"
    (let (m (ed-init (make-buffer "x"))
          calls (fn (text) (fn (_) text))
          up (aside/refresh spec m "one" true)
          synced (aside/sync spec up :k1 (calls "two"))
          same (aside/sync spec synced :k1 (calls "three"))
          moved (aside/sync spec same :k2 (calls "four"))
          text-of (fn (mm) (buffer-text (ed-buf-at mm (ed-buffer-index-by-name! mm "*T*")))))
      (assert= (text-of synced) "two")
      (assert= (text-of same) "two")
      (assert= (text-of moved) "four")
      (is (not (shown? (aside/sync spec m :k1 (calls "never")))))))

  (test "content's :fields ride onto the pane's buffer"
    (let (up (aside/refresh spec
               (ed-init (make-buffer "x"))
               {:text "r" :fields {:line-links {0 :a}}}
               true))
      (assert= (:line-links (ed-buf-at up (ed-buffer-index-by-name! up "*T*"))) {0 :a})))

  (test "close-with names the pane for the closing source to take along"
    (assert= (editor/layers/close-requests (aside/close-with {} spec)) (list "*T*"))))
