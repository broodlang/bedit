;; PHP (src/languages/php.blsp): a `deflanguage` over tree-sitter-php. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-php.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-php-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "php, the mode"
  (test "a .php and a .phtml file open in php mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/index.php")) "php")
    (assert= (ed-buf-mode-name (file-buffer "" "/p/view.phtml")) "php"))
  (test "it parses with tree-sitter-php's php grammar, comments with // and formats with php-cs-fixer"
    (assert= (ed-mode-service (file-buffer "" "/p/a.php") :ts-lang) :php)
    (assert= (:url (model/grammar-source :php)) "https://github.com/tree-sitter/tree-sitter-php")
    (assert= (:subdir (model/grammar-source :php)) "php")
    (assert= (ed-mode-service (file-buffer "" "/p/a.php") :comment-syntax) "// ")
    (assert= (ed-mode-service (file-buffer "" "/p/a.php") :format-command)
      ["php-cs-fixer" "fix" "--quiet"]))
  (test "the text outside the PHP is HTML"
    (is (ed-mode-service (file-buffer "" "/p/a.php") :ts-injections))
    (assert= (into [] (map languages/php/php-injections :lang)) [:html]))
  (test "the restart: a column-0 item, the one before a heredoc (which closes on a word it chose, so counts as open)"
    (let (src "<?php\n\nfunction f()\n{\n    return 1;\n}\n")
      (assert= (languages/php/php-restart src (index-of src "    return"))
        (index-of src "function f")))
    (let (src "<?php\n$s = <<<EOT\nfunction x()\nEOT;\nfunction f()\n{\n    return 1;\n}\n")
      (assert= (languages/php/php-restart src (index-of src "    return")) 0))
    (let (src "<?php\nfunction g()\n{\n    $s = <<<EOT\nfunction x()\n    return 1;\n")
      (assert= (languages/php/php-restart src (index-of src "    return"))
        (index-of src "function g"))))
  (test "the restart: a block comment closed above cuts at the item after it"
    (let (src "<?php\n/**\nfunction x()\n */\nfunction f()\n{\n    return 1;\n}\n")
      (assert= (languages/php/php-restart src (index-of src "    return"))
        (index-of src "function f")))))

;; the sample is laid out as its formatter writes it: PSR-12 (php-cs-fixer)

(def php-src
  "<!DOCTYPE html>
<p class=\"lead\">Hello</p>
<?php
// the greeter
declare(strict_types=1);

namespace App\\Greet;

use App\\Base;

/** A greeter. */
#[Service]
final class Greeter extends Base implements Runnable
{
    public const MAX = 0x10;
    private string $name;

    public function __construct(string $name)
    {
        $this->name = $name;
    }

    public function run(): void
    {
        $names = ['a', 'b'];
        foreach ($names as $each) {
            if ($each === '') {
                continue;
            } elseif ($each === 'b') {
                echo strtoupper(\"hi {$each} and $this->name\");
            } else {
                $this->greet($each, 1.5, true);
            }
        }
        switch (count($names)) {
            case 0:
                break;
            default:
                array_map(function ($item) {
                    return $item;
                }, $names);
        }
        $kind = match ($names[0]) {
            'x' => 1,
            default => 2,
        };
        $block = <<<EOT
            heredoc text
            EOT;
        $nothing = null;
        try {
            self::work([1, 2]);
        } catch (RuntimeException $e) {
            throw $e;
        } finally {
            parent::close();
        }
    }

    private static function greet(string $who, float $weight, bool $loud): string
    {
        return 'hello ' . $who;
    }
}

interface Shape
{
    public function area(): float;
}

trait Loud
{
}

enum Color: string
{
    case Red = 'r';
}

function shout(string $text): string
{
    return strtoupper($text);
}
?>
<footer></footer>")

(when (load-test-grammar :php)
  (describe "php, parsed"
    (def php-spans (languages/php/php-fontify php-src))
    (test "comments, keywords, the PHP tags"
      (assert= (face-at php-spans php-src "// the") (face-of :syntax/comment))
      (assert= (face-at php-spans php-src "/** A") (face-of :syntax/comment))
      (assert= (face-at php-spans php-src "final class") (face-of :syntax/keyword))
      (assert= (face-at php-spans php-src "foreach") (face-of :syntax/keyword))
      (assert= (face-at php-spans php-src "<?php") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "?>") (face-of :syntax/special)))
    (test "a class's, an interface's, a trait's and an enum's name, a type and a namespace are specials"
      (assert= (face-at php-spans php-src "Greeter extends") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "Base implements") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "Runnable") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "Shape") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "Loud") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "string $name;") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "RuntimeException") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "App\\Greet") (face-of :syntax/special))
      (assert= (face-at php-spans php-src "Service") (face-of :syntax/special)))
    (test "a function's and a method's name are definitions"
      (assert= (face-at php-spans php-src "__construct") (face-of :syntax/definition))
      (assert= (face-at php-spans php-src "run()") (face-of :syntax/definition))
      (assert= (face-at php-spans php-src "area()") (face-of :syntax/definition))
      (assert= (face-at php-spans php-src "shout(string") (face-of :syntax/definition)))
    (test "a call, a method call and a static call are functions; a variable is plain"
      (assert= (face-at php-spans php-src "strtoupper") (face-of :syntax/function))
      (assert= (face-at php-spans php-src "greet($each") (face-of :syntax/function))
      (assert= (face-at php-spans php-src "work(") (face-of :syntax/function))
      (assert= (face-at php-spans php-src "$names = ") nil))
    (test "literals: strings, a heredoc, numbers, constants, a class constant, an enum case"
      (assert= (face-at php-spans php-src "'a'") (face-of :syntax/string))
      (assert= (face-at php-spans php-src "<<<EOT") (face-of :syntax/string))
      (assert= (face-at php-spans php-src "0x10") (face-of :syntax/number))
      (assert= (face-at php-spans php-src "1.5") (face-of :syntax/number))
      (assert= (face-at php-spans php-src "true") (face-of :syntax/constant))
      (assert= (face-at php-spans php-src "null") (face-of :syntax/constant))
      (assert= (face-at php-spans php-src "MAX") (face-of :syntax/constant))
      (assert= (face-at php-spans php-src "Red") (face-of :syntax/constant)))
    (test "an interpolating string's text is a string and the variables inside it are code"
      (assert= (face-at php-spans php-src "hi {") (face-of :syntax/string))
      (assert= (face-at php-spans php-src "$each} and") nil)
      (assert= (face-at php-spans php-src " and $this") (face-of :syntax/string)))
    (test "it indents every line: PSR-12 braces, a switch's cases, a closure, a match, a heredoc, the HTML"
      (let ([got want] (indents php-src "/p/Greeter.php")) (assert= got want)))
    (test "a class, an interface, a trait, an enum, a method and a function are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/php/php-spec :definitions)))
        (doseq (kind [:class_declaration
                       :interface_declaration :trait_declaration
                       :enum_declaration :method_declaration :function_definition])
          (is (contains? kinds kind)))))))

(when (and (load-test-grammar :php) (load-test-grammar :html))
  (describe "php, with HTML around it"
    (test "the text outside `<?php … ?>` takes HTML's colours"
      (let (spans (languages/php/php-fontify php-src))
        (assert= (face-at spans php-src "p class") (face-of :syntax/keyword))
        (assert= (face-at spans php-src "\"lead\"") (face-of :syntax/string))
        (assert= (face-at spans php-src "footer") (face-of :syntax/keyword))))))
