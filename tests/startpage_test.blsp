;; tests/startpage_test.blsp — the start page bedit opens on with no file: what it lists, that it
;; is read-only with no line numbers, and that its lines and digits open what they name.

(defmodule startpage-test
  (:use test)
  (:use startpage)
  (:use model)
  (:use editor/buffer))

(defn- page (recent projects) (ed-stamp (start-page {} recent projects)))

(describe "the start page"
  (test "lists the recent files numbered and the projects, each line an action"
    (let (buffer (page ["/tmp/one.txt" "/tmp/two.txt"] ["/tmp"])
          text (buffer-text buffer))
      (is (includes? text "Recent files"))
      (is (includes? text "  1  "))
      (is (includes? text "/tmp/two.txt"))
      (is (includes? text "Projects"))
      (assert= (vec (recent-actions buffer)) [[:file "/tmp/one.txt"] [:file "/tmp/two.txt"]])))
  (test "leaves out a section with nothing in it"
    (let (text (buffer-text (page [] [])))
      (is (not (includes? text "Recent files")))
      (is (not (includes? text "Projects")))
      (is (includes? text "Open"))
      (is (includes? text "Learn"))))
  (test "is read-only, with no line numbers, and opens with point on its first action"
    (let (buffer (page [] []))
      (is (read-only? buffer))
      (assert= (action-at buffer (buffer-current-line buffer)) [:command 'commands/cmd-find-file])
      (assert= (:type buffer) :start-page)))
  (test "RET on a recent file opens it, and so does its digit"
    (let (dir (test/scratch-dir)
          path (str dir "/start-page-recent.txt")
          _ (file/spit path "hello")
          m (ed-init (page [path] []))
          line (first (seq/find (into [] (:start-actions (ed-current-buf m)))
                        (fn ([_ action]) (= action [:file path]))))
          on-line (ed-set-buf m (forward-line (goto-char (ed-current-buf m) 0) line))
          followed (cmd-start-page-follow on-line nil)
          by-digit (cmd-start-page-recent m "1"))
      (assert= (buffer-file (ed-current-buf followed)) path)
      (assert= (buffer-file (ed-current-buf by-digit)) path))))

(describe "the start page's colours"
  (test "the name, the headings and each action's key column are coloured by role"
    (let (text (buffer-text (page ["/tmp/one.txt"] ["/tmp"]))
          spans (vec (start-fontify text))
          face-of (fn (fragment)
                    (let (at (index-of text fragment))
                      (when-let (span (seq/find spans
                                        (fn ([start end _]) (and (<= start at) (< at end)))))
                        (nth span 2)))))
      (assert= (face-of "bedit\n") start-face-title)
      (assert= (face-of "an Emacs-style") start-face-dim)
      (assert= (face-of "Recent files") start-face-heading)
      (assert= (face-of "M-x find-file") start-face-key)
      ;; the description after the key, and a project's path, keep the reader's colour
      (is (nil? (face-of "a file")))
      (is (nil? (face-of "/tmp\n"))))))
