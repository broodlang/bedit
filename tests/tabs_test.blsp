;; Tabs on the screen (ADR-342). A tab used to reach the frontend raw and paint as a
;; zero-width cluster: `a\tb` showed as `ab`, a tab-indented line sat flush left, and the
;; caret and the click mapping — which count the same clusters — agreed with each other
;; and with nothing on screen. Now the view expands each chunk of a line at its LINE
;; column (`string/expand-tabs`), the caret's column is measured from the line start
;; (`ed-visual-column-from`), and a click maps back by the same rule (`ed-buf-offset-at`).
(defmodule tabs-test
  (:use model)
  (:use view)
  (:use panes)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))
(defn line-texts (ops)
  "The strings of the `:text` ops, in order."
  (map (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text)))) (fn (op) (nth op 3))))

(describe "a tab is painted as the spaces to its stop"
  (test "a plain (unfontified) line expands at the line's stops"
    (let (buf (make-buffer "a\tb\n\tx\n"))
      (assert= (line-texts (ed-line-ops buf 0 0 0 0 80 '() nil '() 0)) (list "a       b"))
      (assert= (line-texts (ed-line-ops buf 1 0 0 0 80 '() nil '() 0)) (list "        x"))))
  (test "a fontified line's chunks each expand at THEIR column, so the stops stay the line's"
    ;; spans split `ab\tcd` into `ab` / `\tcd`: the tab in the second chunk starts at
    ;; column 2 and must reach column 8, not column 10 (a chunk-relative stop)
    (let (buf (make-buffer "ab\tcd\n")
          ops (ed-line-ops buf 0 0 0 0 80 '() (list [0 2 {:fg "#f00"}]) '() 0)
          texts (line-texts ops))
      (assert= (apply str texts) "ab      cd")
      ;; and the chunks sit where their cells are: the second starts at screen col 2
      (assert= (map (seq/filter ops (fn (op) (= (first op) :text))) (fn (op) (nth op 2)))
        (list 0 2))))
  (test "a tab-expanded line is clipped to the pane width in cells, never wider"
    (let (buf (make-buffer "\t\t\tend\n"))
      (assert= (line-texts (ed-line-ops buf 0 0 0 0 10 '() nil '() 0)) (list "          "))))
  (test "an h-scrolled slice keeps the line's stops"
    ;; scrolled 1 char in: the tab at line column 1 still spans to column 8, i.e. 7 cells
    (let (buf (make-buffer "a\tb\n"))
      (assert= (line-texts (ed-line-ops buf 0 0 0 0 80 '() nil '() 1)) (list "       b")))))

(describe "the caret and a click agree with the painted tabs"
  (test "the caret after a tab sits on the stop"
    (assert= (ed-visual-column-from (cur (cm "a\tb" 2)) 0) 8)
    (assert= (ed-visual-column-from (cur (cm "a\tb" 3)) 0) 9)
    (assert= (ed-visual-column-from (cur (cm "\t\tx" 2)) 0) 16))
  (test "h-scrolled, the caret is the width to point less the width to the scroll edge"
    ;; scrolled 1 char: `\t` spans [1,8) on the line, so `b` (char 2) is at cell 7 of the view
    (assert= (ed-visual-column-from (cur (cm "a\tb" 2)) 1) 7))
  (test "a click inside a tab's span lands on the tab; on the stop, on the next char"
    (let (buf (make-buffer "a\tb\n"))
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 1) 1)
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 5) 1)
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 8) 2)
      ;; h-scrolled 1 char: view cell 6 is line column 7, inside the tab; cell 7 is `b`
      (assert= (ed-buf-offset-at buf 0 1 0 1 0 6) 1)
      (assert= (ed-buf-offset-at buf 0 1 0 1 0 7) 2))))
