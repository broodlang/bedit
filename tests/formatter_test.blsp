;; M-x format-buffer and format-on-save (src/formatter.blsp) — issue F1. A real file, a real
;; subprocess, and a formatter that is a shell one-liner pushed onto the buffer as a mode
;; layer, so nothing here needs mix or black installed.
(defmodule format-test
  (:use test)
  (:use model)
  (:use pool)
  (:use lifecycle)
  (:use commands)
  (:use format) ; *format-on-save* — bound per test
  (:use editor/buffer)
  (:use editor/buffer-file))

(purge-stale-temp "bedit-fmt-")

(def- *upcase* ["sh" "-c" "tr a-z A-Z < \"$0\" > \"$0.t\" && mv \"$0.t\" \"$0\""])
(def- *broken* ["sh" "-c" "echo 'syntax error on line 1' >&2; exit 1"])

(defn- fmt-model (text formatter)
  "A model on a file holding `text` on disk, typed into (so it is modified), whose mode
formats with `formatter` (the file is appended as `$0`)."
  (let (path (str (temp-dir "bedit-fmt-") ".txt")
        _ (file/spit path text)
        m (ed-find-file (ed-init (make-buffer "")) path)
        typed (ed-edit m (fn (b) (insert (end-of-buffer b) "x"))))
    (ed-set-buf typed
      (editor/layers/push-layer (ed-current-buf typed) {:name :test-fmt :format-command formatter}))))

(describe "a formatter declared as alternatives"
  (test "one command is one alternative; nothing declared is none"
    (assert= (formatter/format-alternatives ["gofmt" "-w"]) [["gofmt" "-w"]])
    (assert= (formatter/format-alternatives nil) [])
    (assert= (formatter/format-alternatives []) []))
  (test "the first installed one runs"
    (assert= (formatter/format-command-choice [["bedit-no-such-formatter" "fmt"] ["sh" "-c"]])
      ["sh" "-c"]))
  (test "with none installed, the preferred one — so the run says what is missing"
    (assert= (formatter/format-command-choice [["bedit-no-such-formatter" "fmt"]
                                                ["bedit-no-such-either" "fmt"]])
      ["bedit-no-such-formatter" "fmt"]))
  (test "a buffer whose mode lists alternatives formats with the installed one"
    (let (m (fmt-model "abc" [["bedit-no-such-formatter"] *upcase*])
          formatted (formatter/format-buffer-now m))
      (assert= (buffer-text (ed-current-buf formatted)) "ABCX"))))

(describe "format-buffer"
  (test "formats the file and re-reads it: the buffer is the formatted text, saved"
    (let (m (formatter/format-buffer-now (fmt-model "abc" *upcase*))
          b (ed-current-buf m))
      (assert= (buffer-text b) "ABCX")
      (assert= (file/slurp (or (buffer-file b) (error "the formatted buffer lost its file")))
        "ABCX")
      (refute (buffer-modified? b))
      ;; stamped after the formatter's rewrite: the next save does not cry wolf
      (refute (buffer-file-changed? b))
      (is (includes? (:echo m) "saved and formatted"))))
  (test "a formatter that fails costs a message: the text was still saved, and stamped"
    (let (m (formatter/format-buffer-now (fmt-model "abc" *broken*))
          b (ed-current-buf m))
      (assert= (buffer-text b) "abcx")
      (assert= (file/slurp (or (buffer-file b) (error "the formatted buffer lost its file")))
        "abcx")
      (refute (buffer-modified? b))
      (refute (buffer-file-changed? b))
      (is (includes? (:echo m) "syntax error on line 1")))))

(describe "format-on-save never writes over another writer's change"
  (test "the changed-on-disk question comes before the format"
    (let (m (fmt-model "abc" *upcase*)
          path (or (buffer-file (ed-current-buf m)) (error "the model has no file"))
          ;; someone else wrote the file after we read it
          stale (ed-set-buf m (assoc (ed-current-buf m) :file-mtime 1))
          asked (binding (*format-on-save* true) (cmd-save stale nil)))
      (is (includes? (:echo asked) "has changed since visited or saved"))
      (assert= (file/slurp path) "abc"))))

;; F1's other half: the formatter runs OFF the loop (a task), so its reply can land after
;; you have typed on. `format-land` is that fold, driven directly here — the task itself is
;; the same `format-run` the headless path calls inline.
(describe "a format that lands after you kept typing"
  (test "the buffer unchanged since the save: the formatted file is read back in"
    (let (m (fmt-model "abc" *upcase*)
          saved (file-save/ed-save-buf-at m (ed-current-index m))
          b (ed-current-buf saved)
          file (buffer-file b)
          ran (formatter/format-run (formatter/format-job b))
          landed (formatter/format-land saved (buffer-rope b) file ran))
      (assert= (buffer-text (ed-current-buf landed)) "ABCX")
      (refute (buffer-modified? (ed-current-buf landed)))))
  ;; a formatter that adds lines above point (an import sorted in, a header) used to leave
  ;; point at its old OFFSET — on some other line entirely
  (test "point stays on its logical line when the formatter adds lines above it"
    (let (m (fmt-model "a\nbc"
              ["sh" "-c" "printf 'header\\n' | cat - \"$0\" > \"$0.t\" && mv \"$0.t\" \"$0\""])
          saved (file-save/ed-save-buf-at m (ed-current-index m))
          b (ed-current-buf saved)
          file (buffer-file b)
          ran (formatter/format-run (formatter/format-job b))
          landed (ed-current-buf (formatter/format-land saved (buffer-rope b) file ran)))
      (assert= (buffer-text landed) "header\na\nbcx")
      (assert= (buffer-point landed) (count "header\na\nbcx"))))
  (test "edited since the save: your edits win, and the message says the file was formatted"
    (let (m (fmt-model "abc" *upcase*)
          saved (file-save/ed-save-buf-at m (ed-current-index m))
          b (ed-current-buf saved)
          file (buffer-file b)
          ran (formatter/format-run (formatter/format-job b))
          typed-on (ed-edit saved (fn (buf) (insert (end-of-buffer buf) "yz")))
          landed (formatter/format-land typed-on (buffer-rope b) file ran))
      (assert= (buffer-text (ed-current-buf landed)) "abcxyz")
      (is (includes? (:echo landed) "kept your edits"))))
  (test "a task that errored or timed out says so and frees the slot"
    (let (m (assoc (fmt-model "abc" *upcase*)
              :format-proc :a-handle
              :format-pending {:file "/x" :rope nil})
          folded (formatter/format-apply m nil))
      (is (nil? (:format-proc folded)))
      (is (includes? (:echo folded) "failed or timed out"))))
  (test "C-x C-s while a format is still running is still a save"
    (let (m (assoc (fmt-model "abc" *upcase*) :format-proc :a-handle)
          path (or (buffer-file (ed-current-buf m)) (error "the model has no file"))
          saved (binding (*format-on-save* true) (cmd-save m nil)))
      (assert= (file/slurp path) "abcx")
      (is (includes? (:echo saved) "not formatted")))))
