;; The desktop identity (`assets/`) — three names that must agree or the editor shows
;; up in GNOME as an anonymous window with the generic fallback icon:
;;
;;   the app id the window declares   config/*app-id*        (src/main.blsp's :app-id)
;;   the desktop entry named after it assets/<app-id>.desktop
;;   the icon that entry asks for     Icon= -> assets/<name>.svg
;;
;; Nothing at runtime notices when one drifts from another — the window simply opens
;; with the wrong icon, silently — so the coupling is pinned here. Pure file reads
;; against the repo's own assets; no window, no install.

(defmodule desktop-test
  (:use test)
  (:use config)     ; *app-id* — the identity under test
  (:use projects))  ; project-root — resolve assets/ from the repo, not the cwd

(require 'config)
(require 'projects)

(defn dt--assets ()
  "The repo's `assets/` directory, resolved from the project root so the suite passes
from any working directory."
  (path-join (or (project-root (cwd)) (cwd)) "assets"))

(defn dt--entry-lines ()
  "The installed-as-committed desktop entry, as lines."
  (string-split (slurp (path-join (dt--assets) (str *app-id* ".desktop"))) "\n"))

(defn dt--value (key)
  "The value of desktop-entry `key`, or nil when the key is absent. (Values here never
contain `=`, so splitting on it and taking the second field is enough.)"
  (let (hit (first (filter (fn (l) (starts-with? l (str key "="))) (dt--entry-lines))))
    (if (nil? hit) nil (second (string-split hit "=")))))

(describe "the desktop entry is named after the app id the window declares"
  (test "assets/<app-id>.desktop exists"
    ;; A desktop matches a window to its entry by this filename and nothing else.
    (is (file-exists? (path-join (dt--assets) (str *app-id* ".desktop")))))

  (test "StartupWMClass repeats the same app id"
    ;; The fallback key, for desktops that match on it instead of the Wayland app id.
    (assert= (dt--value "StartupWMClass") *app-id*)))

(describe "the entry's icon resolves to a shipped file"
  (test "Icon= names an SVG that exists in assets/"
    (let (icon (dt--value "Icon"))
      (is (not (nil? icon)))
      (is (file-exists? (path-join (dt--assets) (str icon ".svg"))))))

  (test "the icon is real SVG, not an empty placeholder"
    (let (svg (slurp (path-join (dt--assets) (str (dt--value "Icon") ".svg"))))
      (is (includes? svg "<svg"))
      (is (includes? svg "viewBox")))))  ; scalable — it is installed to hicolor/scalable

(describe "Exec= is what the Makefile rewrites at install time"
  ;; `make install-desktop` rewrites the command to its absolute installed path with
  ;; `sed 's|^Exec=bedit|…'` — a GNOME session's PATH often lacks ~/.local/bin, so the
  ;; bare name would launch nothing. Renaming the committed command would make that
  ;; substitution silently miss, leaving an entry that cannot start the editor.
  (test "the committed Exec line starts with the default command name"
    (is (starts-with? (dt--value "Exec") "bedit")))

  (test "Exec passes the file arguments through"
    ;; `%F` is what makes "Open with bedit" and a drop onto the icon work.
    (is (includes? (dt--value "Exec") "%F"))))
