;; R (src/languages/r.blsp): a `deflanguage` over r-lib/tree-sitter-r. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-r.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-r-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "r, the mode"
  (test "a .R and a .r file, and an Rscript, open in r mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/analysis.R")) "r")
    (assert= (ed-buf-mode-name (file-buffer "" "/p/analysis.r")) "r")
    (assert= (ed-buf-mode-name (file-buffer "#!/usr/bin/env Rscript\nx <- 1\n" "/p/run")) "r"))
  (test "it parses with tree-sitter-r, comments with # and has no formatter command"
    (assert= (ed-mode-service (file-buffer "" "/p/a.R") :ts-lang) :r)
    (assert= (:url (model/grammar-source :r)) "https://github.com/r-lib/tree-sitter-r")
    (assert= (ed-mode-service (file-buffer "" "/p/a.R") :comment-syntax) "# ")
    (is (nil? (get languages/r/r-spec :format))))
  (test "the restart: a column-0 assignment, unless a raw string opened above"
    (let (src "library(x)\n\nf <- function() {\n  1\n}\n")
      (assert= (languages/r/r-restart src (index-of src "  1")) (index-of src "f <-")))
    (let (src "s <- r\"(\nf <- 1\n)\"\nf <- function() {\n  1\n}\n")
      (assert= (languages/r/r-restart src (index-of src "  1"))
        (index-of src "f <- function")))
    (let (src "g <- 1\ns <- r\"(\nf <- 1\n  1\n")
      (assert= (languages/r/r-restart src (index-of src "  1")) (index-of src "s <-"))))
  (test "the restart: a call taking a string ending in r is no raw string"
    (let (src "library(\"dplyr\")\nlibrary(\"tidyr\")\n\nf <- function() {\n  1\n}\n")
      (assert= (languages/r/r-restart src (index-of src "  1")) (index-of src "f <-")))))

;; the sample is laid out as its formatter writes it: styler's tidyverse style

;; Every call broken over lines opens with its `(` at the end of the line. styler also writes
;; `switch(who,` with the rest two columns in, but the indenter lines up content after an open
;; bracket under its first item and has no bracket kind that only ever hangs, so that form is
;; not in the sample: a gap in `editor/treesit/indent-column`, as Kotlin's lambdas show too.
(def r-src
  "#!/usr/bin/env Rscript
# the greeter
library(dplyr)

MAX <- 0x10L
names <- c(\"a\", \"b\")

greet <- function(who, loud = FALSE) {
  if (is.null(who)) {
    return(NULL)
  } else if (loud) {
    print(toupper(paste(\"hi\", who)))
  } else {
    message(sprintf(\"hello %s\", who), 1.5, TRUE)
  }
  for (each in names) {
    next
  }
  while (FALSE) {
    break
  }
  result <- switch(
    who,
    a = 1,
    b = 2
  )
  doubled <- lapply(names, function(item) {
    item
  })
  squared <- \\(x) x^2
  names |>
    toupper()
  stats::median(c(1, 2, NA, Inf))
  invisible(NA_character_)
}

Greeter <- R6::R6Class(
  \"Greeter\",
  public = list(
    name = NULL
  )
)

shout = function(text) toupper(text)")

(when (load-test-grammar :r)
  (describe "r, parsed"
    (def r-spans (languages/r/r-fontify r-src))
    (test "a function body folds; a pipe continued over lines does not (`:folds`)"
      (let (rope (text/string-> "x <- df |>\n  filter(a) |>\n  select(b)\nf <- function(a) {\n  a\n}\n"))
        (assert= (languages/r/r-fold-extent rope 0) nil)
        (assert= (languages/r/r-fold-extent rope 3) 4)))
    (test "comments and keywords, next and break among them"
      (assert= (face-at r-spans r-src "# the") (face-of :syntax/comment))
      (assert= (face-at r-spans r-src "function(who") (face-of :syntax/keyword))
      (assert= (face-at r-spans r-src "else if") (face-of :syntax/keyword))
      (assert= (face-at r-spans r-src "next") (face-of :syntax/keyword))
      (assert= (face-at r-spans r-src "break") (face-of :syntax/keyword)))
    (test "a call and a namespaced call are functions, the namespace a special"
      (assert= (face-at r-spans r-src "library") (face-of :syntax/function))
      (assert= (face-at r-spans r-src "lapply") (face-of :syntax/function))
      (assert= (face-at r-spans r-src "stats") (face-of :syntax/special))
      (assert= (face-at r-spans r-src "median") (face-of :syntax/function)))
    (test "literals: strings, numbers, constants"
      (assert= (face-at r-spans r-src "\"a\"") (face-of :syntax/string))
      (assert= (face-at r-spans r-src "0x10L") (face-of :syntax/number))
      (assert= (face-at r-spans r-src "1.5") (face-of :syntax/number))
      (assert= (face-at r-spans r-src "TRUE") (face-of :syntax/constant))
      (assert= (face-at r-spans r-src "NULL") (face-of :syntax/constant))
      (assert= (face-at r-spans r-src "NA,") (face-of :syntax/constant))
      (assert= (face-at r-spans r-src "Inf") (face-of :syntax/constant)))
    (test "it indents every line: bodies, else if, hanging arguments, a closure argument, a pipe"
      (let ([got want] (indents r-src "/p/greet.R")) (assert= got want)))
    (test "a function is a definition C-M-a stops at"
      (is (contains? (:kinds (get languages/r/r-spec :definitions)) :function_definition)))))
