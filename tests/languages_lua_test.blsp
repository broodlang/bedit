;; Lua (src/languages/lua.blsp): a `deflanguage` over tree-sitter-grammars/tree-sitter-lua. The
;; mode half needs no grammar; the parsed half needs `libtree-sitter-lua.so` (M-x grammar-install)
;; and SKIPS without it.
(defmodule languages-lua-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "lua, the mode"
  (test "a .lua file, and a script run by lua or luajit, open in lua mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/init.lua")) "lua")
    (assert= (ed-buf-mode-name (file-buffer "#!/usr/bin/env luajit\nprint(1)\n" "/p/run")) "lua"))
  (test "it parses with tree-sitter-lua, comments with -- and formats with stylua"
    (assert= (ed-mode-service (file-buffer "" "/p/a.lua") :ts-lang) :lua)
    (assert= (:url (model/grammar-source :lua))
      "https://github.com/tree-sitter-grammars/tree-sitter-lua")
    (assert= (ed-mode-service (file-buffer "" "/p/a.lua") :comment-syntax) "-- ")
    (assert= (ed-mode-service (file-buffer "" "/p/a.lua") :format-command) ["stylua"]))
  (test "the restart: a column-0 item, the one before a long string still open across it"
    (let (src "local M = {}\n\nfunction M.f()\n  return 1\nend\n")
      (assert= (languages/lua/lua-restart src (index-of src "  return"))
        (index-of src "function M")))
    (let (src "local s = [[\nlocal x\n]]\nfunction M.f()\n  return 1\nend\n")
      (assert= (languages/lua/lua-restart src (index-of src "  return"))
        (index-of src "function M")))
    (let (src "local M = {}\nfunction M.g()\n  local s = [==[\nlocal x\n  return 1\n")
      (assert= (languages/lua/lua-restart src (index-of src "  return"))
        (index-of src "function M.g")))))

;; the sample is laid out as its formatter writes it: StyLua at two spaces

(def lua-src
  "#!/usr/bin/env lua
-- the greeter
local M = {}

--[[ a block
comment ]]
local MAX = 0x10

local Greeter = {
  name = \"world\",
  weight = 1.5,
}

function M.greet(who, loud)
  if who == nil then
    return nil
  elseif loud then
    print(string.upper(\"hi \" .. who))
  else
    io.write([[raw
text]])
  end
  for index = 1, MAX do
    M.log(index, true)
  end
  for _, each in ipairs({ \"a\", \"b\" }) do
    while false do
      break
    end
  end
  repeat
    local done = true
  until done
  local callback = function(value)
    return value * 2
  end
  return self:shout(who)
end

function Greeter:shout(text)
  return text:upper()
end

local function helper(...)
  local options = {
    flag = false,
  }
  do
    goto continue
  end
  ::continue::
  return select(\"#\", ...)
end

return M")

(when (load-test-grammar :lua)
  (describe "lua, parsed"
    (def lua-spans (languages/lua/lua-fontify lua-src))
    (test "comments, a shebang, keywords, `end` and self"
      (assert= (face-at lua-spans lua-src "#!/usr") (face-of :syntax/comment))
      (assert= (face-at lua-spans lua-src "-- the") (face-of :syntax/comment))
      (assert= (face-at lua-spans lua-src "--[[ a") (face-of :syntax/comment))
      (assert= (face-at lua-spans lua-src "local function") (face-of :syntax/keyword))
      (assert= (face-at lua-spans lua-src "then") (face-of :syntax/keyword))
      (assert= (face-at lua-spans lua-src "end\n  for") (face-of :syntax/keyword))
      (assert= (face-at lua-spans lua-src "until") (face-of :syntax/keyword))
      (assert= (face-at lua-spans lua-src "break") (face-of :syntax/keyword))
      (assert= (face-at lua-spans lua-src "self:") (face-of :syntax/keyword)))
    (test "a function's name is a definition: plain, a module's field and a method"
      (assert= (face-at lua-spans lua-src "greet(who") (face-of :syntax/definition))
      (assert= (face-at lua-spans lua-src "shout(text") (face-of :syntax/definition))
      (assert= (face-at lua-spans lua-src "helper") (face-of :syntax/definition)))
    (test "a call, a field call and a method call are functions"
      (assert= (face-at lua-spans lua-src "print") (face-of :syntax/function))
      (assert= (face-at lua-spans lua-src "upper(\"hi") (face-of :syntax/function))
      (assert= (face-at lua-spans lua-src "shout(who") (face-of :syntax/function))
      (assert= (face-at lua-spans lua-src "upper()") (face-of :syntax/function)))
    (test "literals: strings, a long string, numbers, constants, varargs"
      (assert= (face-at lua-spans lua-src "\"world\"") (face-of :syntax/string))
      (assert= (face-at lua-spans lua-src "[[raw") (face-of :syntax/string))
      (assert= (face-at lua-spans lua-src "0x10") (face-of :syntax/number))
      (assert= (face-at lua-spans lua-src "1.5") (face-of :syntax/number))
      (assert= (face-at lua-spans lua-src "nil then") (face-of :syntax/constant))
      (assert= (face-at lua-spans lua-src "true)") (face-of :syntax/constant))
      (assert= (face-at lua-spans lua-src "...)") (face-of :syntax/constant)))
    (test "it indents every line: if/elseif/else, loops, repeat, a closure, tables, do"
      (let ([got want] (indents lua-src "/p/greet.lua")) (assert= got want)))
    (test "a function is a definition C-M-a stops at"
      (is (contains? (:kinds (get languages/lua/lua-spec :definitions)) :function_declaration)))))
