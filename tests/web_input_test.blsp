;; Slice 0 — the read-write web mirror's input path. Two halves:
;;   1. web-key->token: a browser KeyboardEvent ({:k :ctrl :alt :shift}) -> the editor's
;;      key token, matching the native GUI frontend's vocabulary (gui.rs translate_key).
;;   2. end-to-end: a translated token, fed to ed-update, dispatches through the keymap
;;      exactly as a locally-typed key would — the whole point of the bare-token design.
;; (The socket half — POST /input `send`ing the token to the editor process — is the
;; kernel mailbox, exercised live by the running server; here we prove the pure pieces.)
(defmodule web-input-test
  (:use model)
  (:use input)
  (:use-internals web)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn tok (k ctrl alt shift) (web-key->token k ctrl alt shift))

(describe "web-key->token — browser key event to the editor's key token"
  (test "a plain printable key is its own 1-char string (self-insert path)"
    (assert= (tok "a" false false false) "a")
    (assert= (tok "A" false false false) "A") ; Shift+a — the shifted glyph, as-is
    (assert= (tok ">" false false false) ">")
    (assert= (tok " " false false false) " ")) ; Space -> a literal space char
  (test "Ctrl chords are case-INsensitive :ctrl- keywords"
    (assert= (tok "x" true false false) :ctrl-x)
    (assert= (tok "X" true false false) :ctrl-x) ; Ctrl+Shift+x still lower-cases
    (assert= (tok "f" true false false) :ctrl-f))
  (test "Alt (Meta) chords are case-SENSITIVE :alt- keywords"
    (assert= (tok "f" false true false) :alt-f)
    (assert= (tok "F" false true true) :alt-F) ; M-F (shift) stays upper — M-F != M-f
    (assert= (tok "f" false true true) :alt-F)) ; Shift is what upper-cases, not the glyph case
  (test "Ctrl+Alt chords are :ctrl-meta- keywords, lower-cased"
    (assert= (tok "f" true true false) :ctrl-meta-f)
    (assert= (tok "F" true true false) :ctrl-meta-f))
  (test "shifted-punctuation chords reach the shifted glyph (Emacs M->, M-{, M-%)"
    (assert= (tok ">" false true true) (keyword "alt->"))
    (assert= (tok "." false true false) (keyword "alt-.")) ; M-. goto-definition
    (assert= (tok "%" false true true) (keyword "alt-%"))) ; M-% query-replace
  (test "Ctrl/Alt space keep the modifier (C-SPC set-mark, M-SPC just-one-space)"
    (assert= (tok " " true false false) (keyword "ctrl- "))
    (assert= (tok " " false true false) (keyword "alt- ")))
  (test "named keys map to their token, Shift encoded like the native frontend"
    (assert= (tok "Enter" false false false) :enter)
    (assert= (tok "Backspace" false false false) :backspace)
    (assert= (tok "Escape" false false false) :escape)
    (assert= (tok "PageUp" false false false) :page-up)
    (assert= (tok "ArrowUp" false false false) :up)
    (assert= (tok "ArrowUp" false false true) :shift-up) ; shift-select
    (assert= (tok "Home" false false true) :shift-home)
    (assert= (tok "Tab" false false false) :tab)
    (assert= (tok "Tab" false false true) :back-tab))
  (test "untranslatable keys are nil (dropped by the caller)"
    (assert= (tok "Shift" false false false) nil) ; a bare modifier
    (assert= (tok "F1" false false false) nil) ; an F-key we don't bind
    (assert= (tok "" false false false) nil)))

;; The bare token, once translated, is dispatched by ed-update through the *same* keymap
;; path as a local key — no special remote handling. These drive real commands via tokens.
(describe "a translated web key dispatches like a local key"
  (test "a printable token self-inserts"
    (assert= (buffer-text (cur (ed-update (m-of "") (tok "a" false false false) 80 24))) "a"))
  (test "the :enter token inserts a newline"
    (assert= (buffer-text (cur (ed-update (m-of "") (tok "Enter" false false false) 80 24))) "\n"))
  (test "the :ctrl-f token moves point forward one char (forward-char)"
    (assert= (buffer-point (cur (ed-update (m-of "hello") (tok "f" true false false) 80 24))) 1))
  (test "a whole word typed as web tokens lands in the buffer"
    (let (toks (map (string/->list "hi") (fn (c) (tok c false false false)))
          m (press (m-of "") toks))
      (assert= (buffer-text (cur m)) "hi"))))

;; The handler's real chain: request body (bytes) -> utf8 decode -> json-parse -> translate
;; -> `send` to the editor process. Passing `(self)` as the editor lands the token in this
;; test process's own mailbox, so we can `receive` and assert it. (Only the socket read that
;; produces `:body` is left out — that's std/http, already covered by its own suite.)
(describe "web--handle-input — POST body to a key token sent to the editor"
  (test "a JSON key event is decoded, translated, and sent as a token; replies 204"
    (let (req {:body (string/->bytes "{\"k\":\"a\",\"ctrl\":false,\"alt\":false,\"shift\":false}")}
          resp (web/web-handle-input (self) req))
      (assert= (:status resp) 204)
      (assert= (receive (x x) (after 500 :nothing)) "a")))
  (test "a Ctrl chord arrives as the :ctrl- keyword token"
    (let (req {:body (string/->bytes "{\"k\":\"f\",\"ctrl\":true,\"alt\":false,\"shift\":false}")})
      (web/web-handle-input (self) req)
      (assert= (receive (x x) (after 500 :nothing)) :ctrl-f)))
  (test "an untranslatable key (F1) sends nothing — the mailbox stays empty"
    (let (req {:body (string/->bytes "{\"k\":\"F1\",\"ctrl\":false,\"alt\":false,\"shift\":false}")})
      (web/web-handle-input (self) req)
      (assert= (receive (x x) (after 100 :nothing)) :nothing)))
  (test "a malformed body is ignored — no token sent, editor undisturbed"
    (let (req {:body (string/->bytes "not json at all")})
      (web/web-handle-input (self) req)
      (assert= (receive (x x) (after 100 :nothing)) :nothing))))
