;; A package's registrations go with it (src/ownership.blsp, `package-ledger/retire-package`).
;; A fake package registers one row of every registry a feature fills at load — and replaces
;; a core row, a core command and a core function besides. Removing it must leave none of
;; its rows, give the core ones back, and leave an editor that still runs; updating it must
;; leave the new version's rows exactly once.

(defmodule plugin-registry-test
  (:use test)
  (:use-internals packages)
  (:use config-paths) ; *config-base* — a scratch config dir, never the user's own packages
  (:use model) ; ed-init
  (:use input :only [ed-update]) ; one event folded, the idle beat fired
  (:use view :only [ed-view]) ; one frame drawn
  (:use editor/buffer)) ; make-buffer

(purge-stale-temp "bedit-plugreg-")

(defn- write-package (dir version body)
  "Package `pkgsreg`@`version` under packages `dir`, its module's body `body`."
  (let (root (path/join dir "pkgsreg"))
    (os/cmd "mkdir" ["-p" (path/join root "src")])
    (file/spit (path/join root "project.blsp")
      (str "(project :name \"pkgsreg\" :version \"" version "\" :enhances {bedit \">= 0.1\"})\n"))
    (file/spit (path/join root "src" "pkgsreg.blsp") (str "(defmodule pkgsreg)\n" body "\n"))))

;; Version 1: one row of each kind, plus a core idle job, a core chip, a core M-x name and a
;; core function replaced.
(def- version-one
  (string/join ["(defn bedit-plugin () {:themes [{:name \"pkgsreg-theme\" :palette {}}]})"
                 "(defn idle-run (m) (assoc m :pkgsreg-idle-ran true))" "(defn idle-stale (m) true)"
                 "(defn on-event (m input textrows cols rows) (assoc m :pkgsreg-event-seen true))"
                 "(defn step (m) m)" "(defn chip (m pane buf) nil)"
                 "(defn running (m) [\"pkgsreg: busy\"])" "(defn timer-spec (m) nil)"
                 "(defn timer-fire (m) m)" "(defn on-down (m pid reason) m)"
                 "(defn keep (m name f) m)" "(defn fold-reply (m value) m)"
                 "(model/register-idle-job :pkgsreg-idle {:order 999 :run 'pkgsreg/idle-run :stale? 'pkgsreg/idle-stale})"
                 "(model/register-idle-job :auto-save {:order 110 :run 'pkgsreg/idle-run})"
                 "(model/register-task-reply :pkgsreg-slot 'pkgsreg/fold-reply nil \"pkgsreg\")"
                 "(model/register-event-handler :pkgsreg-event 'pkgsreg/on-event)"
                 "(model/register-down-handler :pkgsreg-down 'pkgsreg/on-down)"
                 "(model/register-exit-query :pkgsreg-exit 'pkgsreg/running)"
                 "(model/register-timer-client :pkgsreg-timer 'pkgsreg/timer-spec 'pkgsreg/timer-fire)"
                 "(model/register-post-step :pkgsreg-step {:order 999 :run 'pkgsreg/step})"
                 "(model/register-layout-keeper :pkgsreg-keeper 'pkgsreg/keep)"
                 "(statusbar/register-modeline-segment :pkgsreg-chip 99 'pkgsreg/chip)"
                 "(statusbar/register-modeline-segment :apprun 50 'pkgsreg/chip)"
                 "(interactive/defcommand cmd-pkgsreg-hello (m key) \"Hello.\" m)"
                 "(interactive/defcommand cmd-goto-line (m key) \"Shadows the core one.\" m)"
                 "(interactive/register-prefix-consuming 'pkgsreg/cmd-pkgsreg-hello)"
                 "(keymaps/register-profile :pkgsreg-profile (list 'pkgsreg/profile-layer))"
                 "(def pkgsreg-mode-layer {:name 'pkgsreg :keymap {} :file-pattern \"[.]pkgsreg$\"})"
                 "(modes/register-language-mode 'pkgsreg/pkgsreg-mode-layer :pkgsreg)"
                 "(modes/register-interpreter \"pkgsreg-sh\" :pkgsreg)"
                 "(settings/define :bedit/settings :pkgsreg-setting {:default 1 :type 'int :doc \"a package's setting\"})"
                 "(theme/defchrome pkgsreg-face {:fg \"#ffffff\"})"
                 "(grammars/declare-grammar :pkgsreg \"https://example.invalid/grammar\")"
                 "(defn bedit/keyhelp/ed-key-label (k) \"patched\")"]
    "\n"))

;; Version 2: the idle job and the command again, under the same keys; everything else
;; dropped.
(def- version-two
  (string/join ["(defn bedit-plugin () {})"
                 "(defn idle-run (m) (assoc m :pkgsreg-idle-ran 2))"
                 "(model/register-idle-job :pkgsreg-idle {:order 999 :run 'pkgsreg/idle-run})"
                 "(interactive/defcommand cmd-pkgsreg-hello (m key) \"Hello again.\" m)"]
    "\n"))

(defn- run-with (base registry thunk)
  (binding (*config-base* base *registry* registry) (thunk)))

(defn- stub-registry (body)
  ;; the hive offers pkgsreg 2.0.0, whose install writes `body`
  {:enhancers (fn (_app) [])
   :latest-version (fn (_name) "2.0.0")
   :install (fn (name dest-dir)
              (do (write-package dest-dir "2.0.0" body) {:name name :version "2.0.0"}))})

(defn- idle-names () (into #{} (map (ed-idle-jobs) :name)))

(defn- core-rows ()
  ;; the core rows the package replaces, as the registries hold them (a command by its
  ;; symbol: a function value read back from a registry is a copy, never `=` to the first)
  {:auto-save (registry/lookup :model/idle-jobs :auto-save)
   :apprun (registry/lookup :statusbar/segments :apprun)
   :goto-line (registry/lookup :interactive/command-syms "goto-line")
   :key-label (keyhelp/ed-key-label "a")})

(defn- beat (m) (ed-update m [:timer :idle-recompute] 80 24))

;; The package is loaded from its FILES (`apply-plugin!`'s reload path, `reflect/load`), never
;; through `require-one`. An `:isolated` test's restore REPLAYS what a `require-one` load
;; inside it defined and registered (KI-134: a module other processes may be using is kept),
;; but not a removal made after it — so the package's rows, its globals and its replacements
;; of core rows came back after the test and leaked into every later test in the run (an
;; auto-save idle job running the package's function). A file load is rolled back with the
;; rest, so the restore leaves the editor as the test found it.
(defn- plugin-registry-round-trip ()
  (let (base (temp-dir "bedit-plugreg-")
        dir (path/join base "bedit" "packages")
        _ (write-package dir "1.0.0" version-one)
        before (core-rows)
        applied (run-with base (stub-registry "") (fn () (packages/apply-plugin! "pkgsreg" true)))
        package-dir (run-with base (stub-registry "") (fn () (package-store/package-dir "pkgsreg")))
        loaded-model (beat (ed-init (make-buffer "x")))
        while-loaded {:idle (contains? (idle-names) :pkgsreg-idle)
                      :ran (:pkgsreg-idle-ran loaded-model)
                      :event (:pkgsreg-event-seen (ed-update loaded-model [:pkgsreg-event] 80 24))
                      :exit (ed-live-processes loaded-model)
                      :command (includes? (interactive/command-names) "pkgsreg-hello")
                      :theme (includes? (themes/themes-names) "pkgsreg-theme")
                      :type (editor/layers/layers-for-type :pkgsreg)
                      :file-type (editor/layers/buffer-type-for {:file "/tmp/a.pkgsreg"})
                      :setting (settings/spec-of :bedit/settings :pkgsreg-setting)
                      :key-label (keyhelp/ed-key-label "a")
                      :claims (count (ownership/claims-under package-dir))}
        _ (run-with base
            (stub-registry "")
            (fn () (packages/remove! (ed-init (make-buffer "")) "pkgsreg")))
        removed-model (beat (ed-init (make-buffer "x"))))
    (assert= applied true)
    ;; it was all there
    (is (:idle while-loaded))
    (is (:ran while-loaded))
    (is (:event while-loaded))
    (is (includes? (:exit while-loaded) "pkgsreg: busy"))
    (is (:command while-loaded))
    (is (:theme while-loaded))
    (assert= (:type while-loaded) '(pkgsreg/pkgsreg-mode-layer modes/text-mode-layer))
    (assert= (:file-type while-loaded) :pkgsreg)
    (is (map? (:setting while-loaded)))
    (assert= (:key-label while-loaded) "patched")
    (is (> (:claims while-loaded) 15))
    ;; none of it is left
    (assert= (ownership/claims-under package-dir) [])
    (refute (contains? (idle-names) :pkgsreg-idle))
    (assert= (registry/lookup :model/task-replies :pkgsreg-slot) nil)
    (assert= (ed-registered-event-handler :pkgsreg-event) nil)
    (assert= (registry/lookup :model/down-handlers :pkgsreg-down) nil)
    (assert= (registry/lookup :model/exit-queries :pkgsreg-exit) nil)
    (assert= (get (ed-timer-clients) :pkgsreg-timer) nil)
    (assert= (registry/lookup :model/post-steps :pkgsreg-step) nil)
    (assert= (registry/lookup :model/layout-keepers :pkgsreg-keeper) nil)
    (assert= (registry/lookup :statusbar/segments :pkgsreg-chip) nil)
    (refute (includes? (interactive/command-names) "pkgsreg-hello"))
    (refute (interactive/prefix-consuming? 'pkgsreg/cmd-pkgsreg-hello))
    (assert= (registry/lookup :keymaps/profiles :pkgsreg-profile) nil)
    (refute (includes? (themes/themes-names) "pkgsreg-theme"))
    (assert= (editor/layers/layers-for-type :pkgsreg) ())
    (assert= (editor/layers/buffer-type-for {:file "/tmp/a.pkgsreg"}) :fundamental)
    (assert= (get editor/layers/*auto-type-by-interpreter* "pkgsreg-sh") nil)
    (assert= (settings/spec-of :bedit/settings :pkgsreg-setting) nil)
    (assert= (registry/lookup :theme/chrome-faces 'pkgsreg/pkgsreg-face) nil)
    (assert= (model/grammar-source :pkgsreg) nil)
    (refute (bound? 'pkgsreg/idle-run))
    ;; the core rows and the core function it replaced are back, and work
    (assert= (core-rows) before)
    (assert= (keyhelp/ed-key-label "a") "a")
    ;; the editor still runs: an event, the idle beat, a frame
    (refute (:pkgsreg-idle-ran removed-model))
    (refute (:pkgsreg-event-seen (ed-update removed-model [:pkgsreg-event] 80 24)))
    (assert= (ed-live-processes removed-model) [])
    (is (vector? (ed-view (ed-update removed-model "a" 80 24) 80 24)))
    ;; installed again, then updated to version 2
    (write-package dir "1.0.0" version-one)
    (assert= (run-with base
               (stub-registry version-two)
               (fn () (packages/apply-plugin! "pkgsreg" true)))
      true)
    (assert= (keyhelp/ed-key-label "a") "patched")
    (let (done (run-with base
                 (stub-registry version-two)
                 (fn ()
                   (packages/launch-job (ed-init (make-buffer "")) {:kind :update :name "pkgsreg"})))
          model (beat (ed-init (make-buffer "x"))))
      (is (includes? (:echo done) "updated pkgsreg → 2.0.0"))
      ;; exactly the new version's rows: its idle job and its command's two entries
      (assert= (ownership/claims-under package-dir)
        [[:interactive/command-syms "pkgsreg-hello"]
          [:interactive/commands "pkgsreg-hello"]
          [:model/idle-jobs :pkgsreg-idle]])
      (assert= (count (seq/filter (ed-idle-jobs) (fn (job) (= (:name job) :pkgsreg-idle)))) 1)
      (assert= (:pkgsreg-idle-ran model) 2)
      (assert= (count (seq/filter (interactive/command-names) (fn (name) (= name "pkgsreg-hello"))))
        1)
      (refute (includes? (themes/themes-names) "pkgsreg-theme"))
      (assert= (editor/layers/buffer-type-for {:file "/tmp/a.pkgsreg"}) :fundamental)
      (assert= (core-rows) before)
      (run-with base
        (stub-registry "")
        (fn () (packages/remove! (ed-init (make-buffer "")) "pkgsreg")))
      (assert= (ownership/claims-under package-dir) [])
      (refute (includes? (interactive/command-names) "pkgsreg-hello")))))

(describe "a package's registrations go with it"
  :isolated (test "removed: every row goes and every core row it replaced comes back; updated: the new rows once"
    (plugin-registry-round-trip)))

;; ---- the second round: std registries, run-time rows, stacked patches, open buffers -------

(defn- write-files (dir name files)
  "Package `name` 1.0.0 under packages `dir`, its src/ holding `files` (file name -> text)."
  (let (root (path/join dir name))
    (os/cmd "mkdir" ["-p" (path/join root "src")])
    (file/spit (path/join root "project.blsp")
      (str "(project :name \"" name "\" :version \"1.0.0\" :enhances {bedit \">= 0.1\"})\n"))
    (doseq ([file text] files) (file/spit (path/join root "src" file) text))))

(defn- apply-from-files (base name)
  ;; from its files (the reload path): the isolate's restore rolls the load back
  (run-with base (stub-registry "") (fn () (packages/apply-plugin! name true))))

(defn- remove-package (base name)
  (run-with base (stub-registry "") (fn () (packages/remove! (ed-init (make-buffer "")) name))))

(describe "two packages patching the same core function"
  :isolated (test "removing either keeps the live patch right, and the last one gives back the core function"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          patch (fn (name answer)
                  (write-files dir
                    name
                    {(str name ".blsp") (str "(defmodule "
                                          name ")\n(defn bedit-plugin () {})\n(defn answer () \""
                                          answer
                                          "\")\n(defn bedit/keyhelp/ed-key-label (k) (answer))\n")}))
          core (keyhelp/ed-key-label "a"))
      (patch "pkgpatcha" "A")
      (patch "pkgpatchb" "B")
      ;; A then B; A removed first: B's patch stays live, then B's removal is the core again
      (apply-from-files base "pkgpatcha")
      (apply-from-files base "pkgpatchb")
      (assert= (keyhelp/ed-key-label "a") "B")
      (remove-package base "pkgpatcha")
      (assert= (keyhelp/ed-key-label "a") "B")
      (remove-package base "pkgpatchb")
      (assert= (keyhelp/ed-key-label "a") core)
      ;; A then B again; B removed first: A's patch is live again, then the core
      (patch "pkgpatcha" "A")
      (patch "pkgpatchb" "B")
      (apply-from-files base "pkgpatcha")
      (apply-from-files base "pkgpatchb")
      (remove-package base "pkgpatchb")
      (assert= (keyhelp/ed-key-label "a") "A")
      (remove-package base "pkgpatcha")
      (assert= (keyhelp/ed-key-label "a") core)
      (assert= (registry/lookup :packages/redefinitions 'bedit/keyhelp/ed-key-label) nil))))

(describe "a package that writes std's registries directly"
  :isolated (test "its editor/layers rows and its own registry go, and the core row it replaced comes back"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          bash-before (get editor/layers/*auto-type-by-interpreter* "bash")
          _ (write-files dir
              "pkgstd"
              {"pkgstd.blsp" (string/join ["(defmodule pkgstd)"
                                            "(defn bedit-plugin () {})"
                                            "(def pkgstd-layer {:name 'pkgstd :keymap {}})"
                                            "(editor/layers/register-type-layers :pkgstd (list 'pkgstd/pkgstd-layer))"
                                            "(editor/layers/register-file-type \".pkgstd\" :pkgstd)"
                                            "(editor/layers/register-system-layer 'pkgstd/pkgstd-layer)"
                                            "(editor/layers/register-interpreter-type \"bash\" :pkgstd)"
                                            "(registry/put :pkgstd/own :row 1)"]
                               "\n")})
          _ (apply-from-files base "pkgstd")
          loaded {:type (editor/layers/layers-for-type :pkgstd)
                  :file (editor/layers/buffer-type-for {:file "/tmp/a.pkgstd"})
                  :system (includes? editor/layers/*system-layers* 'pkgstd/pkgstd-layer)
                  :bash (get editor/layers/*auto-type-by-interpreter* "bash")
                  :own (registry/lookup :pkgstd/own :row)}
          _ (remove-package base "pkgstd"))
      (assert= loaded
        {:type '(pkgstd/pkgstd-layer) :file :pkgstd :system true :bash :pkgstd :own 1})
      (assert= (editor/layers/layers-for-type :pkgstd) ())
      (assert= (editor/layers/buffer-type-for {:file "/tmp/a.pkgstd"}) :fundamental)
      (refute (includes? editor/layers/*system-layers* 'pkgstd/pkgstd-layer))
      (assert= (get editor/layers/*auto-type-by-interpreter* "bash") bash-before)
      (assert= (registry/lookup :pkgstd/own :row) nil)
      (assert= (registry/written-by #{'pkgstd}) []))))

(describe "rows a package registers as it runs"
  :isolated (test "a command's registration is claimed for the package; one nothing attributes is dropped by what it names"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          _ (write-files dir
              "pkgrun"
              {"pkgrun.blsp" (string/join ["(defmodule pkgrun)"
                                            "(defn bedit-plugin () {})" "(defn late-run (m) m)"
                                            "(defn spec (m) nil)" "(defn fire (m) m)"
                                            "(interactive/defcommand cmd-pkgrun-register (m key) \"Registers a job.\" (do (model/register-idle-job :pkgrun-late {:order 998 :run 'pkgrun/late-run}) m))"
                                            "(defn register-orphan () (model/register-timer-client :pkgrun-orphan 'pkgrun/spec 'pkgrun/fire))"]
                               "\n")})
          _ (apply-from-files base "pkgrun")
          package-dir (run-with base
                        (stub-registry "")
                        (fn () (package-store/package-dir "pkgrun")))
          _ (interactive/run-command (ed-init (make-buffer "")) "pkgrun-register" (fn (m _name) m))
          _ ((reflect/eval 'pkgrun/register-orphan))
          claimed (includes? (ownership/claims-under package-dir) [:model/idle-jobs :pkgrun-late])
          registered [(contains? (idle-names) :pkgrun-late)
                       (not (nil? (get (ed-timer-clients) :pkgrun-orphan)))]
          _ (remove-package base "pkgrun"))
      (is claimed)
      (assert= registered [true true])
      (refute (contains? (idle-names) :pkgrun-late))
      (assert= (get (ed-timer-clients) :pkgrun-orphan) nil))))

(describe "buffers in a removed package's mode"
  :isolated (test "go to fundamental mode, and *Messages* says so"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          _ (write-files dir
              "pkgmode"
              {"pkgmode.blsp" (string/join ["(defmodule pkgmode)"
                                             "(defn bedit-plugin () {})"
                                             "(def pkgmode-layer {:name 'pkgmode :keymap {} :file-pattern \"[.]pkgmode$\"})"
                                             "(modes/register-language-mode 'pkgmode/pkgmode-layer :pkgmode)"]
                                "\n")})
          _ (apply-from-files base "pkgmode")
          model (ed-init (editor/layers/init-buffer-layers (make-buffer "text"
                                                             "a.pkgmode" "/tmp/a.pkgmode")))
          typed (:type (ed-buf-at model 0))
          ;; the bare `remove!`, as code calls it: the reset is in it, not only in the command
          removed (run-with base
                    (stub-registry "")
                    (fn () (first (packages/remove! model "pkgmode"))))
          buf (ed-buf-at removed 0)
          messages (buffer-text (ed-buf-at removed (ed-buffer-index-by-name! removed "*Messages*"))))
      (assert= typed :pkgmode)
      (assert= (:type buf) :fundamental)
      (refute (any? (editor/layers/active-layers buf) (fn (layer) (= (:name layer) 'pkgmode))))
      (is (includes? messages "removed pkgmode: a.pkgmode is in fundamental mode now")))))

(describe "a package file without a defmodule"
  :isolated (test "its root names are first defined by the package, and its std registry writes go with it"
    ;; the rows name nothing of the package: the kernel credits a namespace-less load's
    ;; registry writes to the FILE (brood ADR-582), which is how they are found
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          helpers (path/absolute (path/join dir "pkgloose" "src" "helpers.blsp"))
          bash-before (get editor/layers/*auto-type-by-interpreter* "bash")
          _ (write-files dir
              "pkgloose"
              {"pkgloose.blsp" "(defmodule pkgloose)\n(defn bedit-plugin () {})\n"
               "helpers.blsp" (string/join ["(defn pkgloose-helper () :helped)"
                                             "(registry/put :pkgloose/own :row 42)"
                                             "(editor/layers/register-interpreter-type \"bash\" :pkgloose)"
                                             "(editor/layers/register-system-layer 'modes/text-mode-layer)"
                                             "(editor/face/face-set :pkgloose/face {:fg \"#ffffff\"})"]
                                "\n")})
          _ (apply-from-files base "pkgloose")
          loaded [((reflect/eval 'pkgloose-helper))
                   (registry/lookup :pkgloose/own :row)
                   (get editor/layers/*auto-type-by-interpreter* "bash")
                   (includes? editor/layers/*system-layers* 'modes/text-mode-layer)
                   (not (nil? (get editor/face/*faces* :pkgloose/face)))
                   (count (registry/written-by #{helpers}))]
          _ (remove-package base "pkgloose"))
      (assert= loaded [:helped 42 :pkgloose true true 4])
      (refute (bound? 'pkgloose-helper))
      (assert= (registry/lookup :pkgloose/own :row) nil)
      (assert= (get editor/layers/*auto-type-by-interpreter* "bash") bash-before)
      (refute (includes? editor/layers/*system-layers* 'modes/text-mode-layer))
      (assert= (get editor/face/*faces* :pkgloose/face) nil)
      (assert= (registry/written-by #{helpers}) []))))

(describe "two packages writing the same std entry"
  :isolated (test "removing the lower one keeps the live write; removing the live one gives back the one below, never a removed package's"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          bash-before (get editor/layers/*auto-type-by-interpreter* "bash")
          stack (fn (name)
                  (write-files dir
                    name
                    {(str name ".blsp") (str "(defmodule "
                                          name
                                          ")\n(defn bedit-plugin () {})\n(editor/layers/register-interpreter-type \"bash\" :"
                                          name ")\n")}))
          bash (fn () (get editor/layers/*auto-type-by-interpreter* "bash")))
      (stack "pkgstacka")
      (stack "pkgstackb")
      ;; A then B, A removed first: B's stays, and removing B gives back the core entry
      (apply-from-files base "pkgstacka")
      (apply-from-files base "pkgstackb")
      (assert= (bash) :pkgstackb)
      (remove-package base "pkgstacka")
      (assert= (bash) :pkgstackb)
      (remove-package base "pkgstackb")
      (assert= (bash) bash-before)
      ;; A then B, B removed first: A's comes back, and is A's to take with it
      (stack "pkgstacka")
      (stack "pkgstackb")
      (apply-from-files base "pkgstacka")
      (apply-from-files base "pkgstackb")
      (remove-package base "pkgstackb")
      (assert= (bash) :pkgstacka)
      (remove-package base "pkgstacka")
      (assert= (bash) bash-before)
      (assert= (registry/entries :packages/std-layers) {}))))

(describe "two packages' anonymous file-type predicates"
  :isolated (test "each package takes back its own, though both print as #<fn>"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          predicate (fn (name extension)
                      (write-files dir
                        name
                        {(str name ".blsp") (str "(defmodule "
                                              name
                                              ")\n(defn bedit-plugin () {})\n(editor/layers/register-file-type (fn (file) (string/ends-with? file \""
                                              extension "\")) :pkgpred)\n")}))
          typed (fn (file) (editor/layers/buffer-type-for {:file file})))
      (predicate "pkgpreda" ".pa")
      (predicate "pkgpredb" ".pb")
      (apply-from-files base "pkgpreda")
      (apply-from-files base "pkgpredb")
      (assert= [(typed "/tmp/x.pa") (typed "/tmp/x.pb")] [:pkgpred :pkgpred])
      (remove-package base "pkgpredb")
      (assert= (typed "/tmp/x.pa") :pkgpred)
      (refute (= (typed "/tmp/x.pb") :pkgpred))
      (remove-package base "pkgpreda")
      (refute (= (typed "/tmp/x.pa") :pkgpred)))))

;; brood KI-356: a bare closure a package registers from a process it started — a worker its
;; load spawned, a timer's fire hook and a process THAT starts — names nothing of the package
;; (`#<fn>`), and no load or command was running. The kernel credits such a process's writes
;; to the package (its acting writer, brood ADR-596) and the backstop knows an anonymous `fn`
;; by its module (`reflect/fn-module`), so retirement takes every one back.
(def- closure-package
  (string/join ["(defmodule pkgclosure)"
                 "(defn bedit-plugin () {})" "(defn- work ()" "  (receive ([:go parent]"
                 "            (do (registry/put :pkgclosure/hooks :worker (fn () :worker))"
                 "                (editor/layers/register-file-type (fn (file) (string/ends-with? file \".pkw\")) :pkgclosure-type)"
                 "                (send parent :done)))))" "(def worker (spawn (work)))"
                 "(defn spec (m) nil)" "(defn fire (m)" "  (let (parent (self))"
                 "    (registry/put :pkgclosure/hooks :timer (fn () :timer))"
                 "    (spawn (do (registry/put :pkgclosure/hooks :timer-worker (fn () :timer-worker)) (send parent :timer-done)))"
                 "    (receive (:timer-done m) (after 5000 m))))"
                 "(model/register-timer-client :pkgclosure-timer 'pkgclosure/spec 'pkgclosure/fire)"]
    "\n"))

(describe "bare closures a package registers from its processes and timers"
  :isolated (test "are the package's, and go with it"
    (let (base (temp-dir "bedit-plugreg-")
          dir (path/join base "bedit" "packages")
          _ (write-files dir "pkgclosure" {"pkgclosure.blsp" closure-package})
          _ (apply-from-files base "pkgclosure")
          ;; the worker its load spawned registers now, after the load
          _ (send (reflect/eval 'pkgclosure/worker) [:go (self)])
          _ (receive (:done nil) (after 5000 (error "the package's worker never registered")))
          ;; the timer fires as the loop fires it
          _ (ed-update (ed-init (make-buffer "x")) [:timer :pkgclosure-timer] 80 24)
          loaded {:hooks (into #{} (keys (registry/entries :pkgclosure/hooks)))
                  :file (editor/layers/buffer-type-for {:file "/tmp/a.pkw"})
                  ;; what the kernel credits to the package: the three rows, and the rule
                  :credited (into #{}
                              (seq/keep (registry/written-by #{'pkgclosure})
                                (fn (write)
                                  (cond
                                    (= (first (:path write)) :pkgclosure/hooks)
                                      (second (:path write))
                                    (= (:global write) 'editor/layers/*auto-type-by-file*) :rule
                                    else nil))))}
          _ (remove-package base "pkgclosure"))
      (assert= loaded
        {:hooks #{:worker :timer :timer-worker}
         :file :pkgclosure-type
         :credited #{:worker :timer :timer-worker :rule}})
      (is (empty? (registry/entries :pkgclosure/hooks)))
      (refute (= (editor/layers/buffer-type-for {:file "/tmp/a.pkw"}) :pkgclosure-type))
      (assert= (registry/written-by #{'pkgclosure}) []))))
