;; Editor tests (split from the original monolithic main_test.blsp by concern).
;; Every split file keeps the `main-test` module name, so a helper defined in any
;; file is visible to every test body at run time (test bodies are lazy thunks the
;; runner evaluates only after all files load into the shared image). The common
;; model helpers below are repeated in each file so a standalone `nest check` of a
;; single file still resolves them.
(defmodule minibuffer-commands-test
  (:use testkit :only [press m-of cur type-str after]) ; the shared test helpers (tests/support)
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use clipboard)
  (:use minibuffer)
  (:use input)
  (:use model)
  (:use echoarea)
  (:use view)
  (:use pool)
  (:use-internals lifecycle)
  (:use-internals textops)
  (:use-internals commands)
  (:use-internals search-commands)
  (:use-internals region)
  (:use-internals editing)
  (:use-internals motion)
  (:use kmacro) ; ed-macro-prefix-start
  (:use-internals window-commands)
  (:use-internals lsp-commands) ; imenu and the edit application — split out of commands (X1)
  (:use main)
  (:use editor/buffer)
  (:use test))

;; A model whose current buffer is `text` with point at `p`.
(defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))

;; ---- Emacs editing in the minibuffer (find-file / switch-buffer prompts) -----
(defn mb-input (m) (mb-text (:minibuffer m)))

(describe "editor minibuffer editing"
  (test "C-a moves to start, then a key inserts at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
          ; input "abc", point 3
          ins (ed-update (ed-update m :ctrl-a 80 24) "Z" 80 24))
      ; C-a → 0, insert Z
      (assert= (mb-input ins) "Zabc")))
  (test "C-b then Backspace deletes the char before point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
          ; "abc" point 3
          m2 (ed-update (ed-update m :ctrl-b 80 24) :backspace 80 24))
      ; point 2, del 'b'
      (assert= (mb-input m2) "ac")))
  (test "C-d deletes the char at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
          m2 (ed-update (ed-update m :ctrl-a 80 24) :ctrl-d 80 24))
      ; point 0, del 'a'
      (assert= (mb-input m2) "bc")))
  (test "C-k kills from point to the end"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abcdef")
          m2 (ed-update (ed-update m :ctrl-a 80 24)
               :ctrl-f 80 24) ; point 1
          m3 (ed-update m2 :ctrl-k 80 24))
      ; kill to end
      (assert= (mb-input m3) "a")))
  (test "editing then Enter accepts the corrected text"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Messages*X")
          ; trailing typo
          fixed (ed-update m :backspace 80 24) ; delete X → "*Messages*"
          done (ed-update fixed :enter 80 24))
      (assert= (mb-input fixed) "*Messages*") ; the edit landed
      (assert= (buffer-name (cur done)) "*Messages*"))) ; …and Enter switched
  (test "the minibuffer gained lineedit word-motion (M-b) from the shared core"
    ;; the old hand-rolled minibuffer had no M-f/M-b; reusing lineedit brings it
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "ab cd")
          ; point at end (5)
          moved (ed-update m :alt-b 80 24) ; M-b → start of "cd" (3)
          ins (ed-update moved "Z" 80 24))
      (assert= (mb-input ins) "ab Zcd"))))

;; ---- live completion candidates in switch-buffer -----------------------------
(describe "editor switch-buffer completion"
  (test "shows the OTHER buffers as candidates — the current one is not offered (Emacs)"
    (let (m (press (m-of "x") [:ctrl-x "b"]))
      ; *scratch* is current; *Messages* is the other
      (is (not (includes? (ed-mb-candidates (:minibuffer m)) "*scratch*")))
      (is (includes? (ed-mb-candidates (:minibuffer m)) "*Messages*"))))
  (test "candidates narrow to the typed prefix"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*M"))
      (is (includes? (ed-mb-candidates (:minibuffer m)) "*Messages*"))
      (is (not (includes? (ed-mb-candidates (:minibuffer m)) "*scratch*")))))
  (test "Tab completes the buffer name"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Mess")
          done (ed-update (ed-update m :tab 80 24) :enter 80 24))
      ; Tab → "*Messages*", Enter
      (assert= (buffer-name (cur done)) "*Messages*")))
  (test "find-file lists a directory's entries sorted by name"
    (let (d (temp-dir "bedit-sort-")
          _ (file/mkdir d)
          _ (file/spit (str d "/c.txt") "")
          _ (file/spit (str d "/a.txt") "")
          _ (file/spit (str d "/b.txt") "")
          m0 (press (m-of "x") [:ctrl-x :ctrl-f])
          m (assoc m0
              :minibuffer
                (assoc (:minibuffer m0)
                  :edit (ed-mb-set-text (:edit (:minibuffer m0)) (str d "/"))))
          cands (mb-candidates (:minibuffer m)))
      (assert= cands (list (str d "/a.txt") (str d "/b.txt") (str d "/c.txt")))))
  (test "Tab fills the HOVERED candidate (a directory), not the top item"
    ;; find-file in a temp dir with two subdirs: hover the 2nd, Tab fills it (not aaa/).
    (let (d (temp-dir "bedit-tab-")
          _ (file/mkdir d)
          _ (file/mkdir (str d "/aaa"))
          _ (file/mkdir (str d "/bbb"))
          m0 (press (m-of "x") [:ctrl-x :ctrl-f])
          m (assoc m0
              :minibuffer
                (assoc (:minibuffer m0)
                  :edit (ed-mb-set-text (:edit (:minibuffer m0)) (str d "/"))))
          cands (mb-candidates (:minibuffer m))
          ;; the line names a directory, so the PROMPT is selected (Vertico); C-n steps onto
          ;; the first entry, a second C-n onto the 2nd, then Tab fills it
          hovered (press m [:ctrl-n :ctrl-n :tab]))
      (is (= (count cands) 2))
      (assert= (mb-text (:minibuffer hovered)) (nth cands 1)) ; the hovered dir, not (nth cands 0)
      (is (string/ends-with? (mb-text (:minibuffer hovered)) "/"))))) ; a directory → ready to expand
;; ---- ranking off the loop: a big candidate source is ASKED, not ranked here -----
;; What this replaces: a large source used to be DEBOUNCED onto the idle beat — ranked here,
;; just later — which showed a stale list while you typed and then paid the whole cost in
;; one lump (163 ms on the idle beat, 210 ms on a single ↓, on a 27k-file project). It is a
;; ranking SESSION now (std/fuzzy's `ranker`, ADR-374): the keystroke asks and the answer
;; folds in when it arrives. Tests are headless — there is no loop for a reply to land in —
;; so a session is never started here and the fold is driven directly, which is exactly the
;; seam the live editor uses.
(describe "minibuffer candidates — the ranking session"
  (test "a small rank-source ranks on the keystroke, instantly"
    (let (small (into [] (map (range 50) (fn (i) (str "f" i))))
          mb (ed-name-prompt "Find: " small (fn (mm _t) mm) 20)
          m2 (ed-update (ed-update (assoc (m-of "x") :minibuffer mb) "a" 80 24) "b" 80 24))
      (assert= (map/get-in m2 [:minibuffer :cand-cache :for]) "ab")))
  (test "a session's answer folds into the cache; one from another session is dropped"
    (let (mb (assoc (ed-name-prompt "Find: " ["file1" "file2"] (fn (mm _t) mm) 20)
               :ranker :session-a)
          m0 (assoc (m-of "x") :minibuffer mb)
          landed (ed-apply-ranked m0 :session-a "fi" (list "file1" "file2"))
          stale (ed-apply-ranked m0 :session-b "zz" (list "nonsense")))
      (assert= {:for "fi" :cands (list "file1" "file2")}
        (map/get-in landed [:minibuffer :cand-cache]))
      ;; a reply from a session this prompt does not own must never repopulate it — that is
      ;; what a prompt closing and another opening while an answer is in flight looks like
      (is (nil? (map/get-in stale [:minibuffer :cand-cache])))))
  (test "a prompt with a session shows the last answer rather than ranking inline"
    ;; `mb-candidates` is read by the view every frame and by every selection move; ranking
    ;; there is what cost 210 ms per ↓, so with a session it must return the cache as-is
    (let (mb (assoc (ed-name-prompt "Find: " ["file1" "file2"] (fn (mm _t) mm) 20)
               :ranker :session-a
               :cand-cache {:for "f" :cands (list "file1")}
               :edit (ed-mb-set-text (:edit (ed-name-prompt "Find: " [] (fn (mm _t) mm) 20)) "fi")))
      (assert= (list "file1") (mb-candidates mb))))
  (test "ask, receive, fold — the whole round trip against a real session"
    ;; The only test here that runs the actual mechanism: `rank-async` replies to `(self)`,
    ;; which in a test IS the test process, so the editor's own seams can be driven in order.
    (let (session (fuzzy/ranker ["src/view.blsp" "src/model.blsp" "README.md"])
          mb (assoc (ed-name-prompt "Find: "
                      ["src/view.blsp" "src/model.blsp" "README.md"]
                      (fn (mm _t) mm)
                      20)
               :ranker session)
          m0 (assoc (m-of "x") :minibuffer mb)
          typed (assoc m0
                  :minibuffer (assoc mb :edit (ed-mb-set-text (:edit mb) "view")))
          asked (ed-cache-mb-candidates typed))
      ;; the keystroke ASKED and moved on — no ranking happened on this path
      (assert= "view" (map/get-in asked [:minibuffer :asked]))
      (is (nil? (map/get-in asked [:minibuffer :cand-cache])))
      ;; a timeout becomes a query nobody asked for, so the assertion below names it rather
      ;; than indexing into a keyword
      (let (raw (receive ([:fuzzy-ranked ^session query hits] [query hits]) (after 5000 :timeout))
            [query hits] (if (vector? raw) raw ["<the session never answered>" '()]))
        (do
          (assert= "view" query)
          (let (folded (ed-apply-ranked asked session query hits))
            (assert= (list "src/view.blsp") (mb-candidates (:minibuffer folded))))))
      (fuzzy/ranker-stop session)))
  (test "the idle beat re-asks when an answer never arrived"
    ;; `:asked` is what keeps one keystroke to one question; without clearing it, a reply
    ;; lost to a dead session would leave the list stale until the reader retyped
    (let (session (fuzzy/ranker ["file1"])
          mb (assoc (ed-name-prompt "Find: " ["file1"] (fn (mm _t) mm) 20)
               :ranker session
               :asked "fi"
               :edit (ed-mb-set-text (:edit (ed-name-prompt "Find: " [] (fn (mm _t) mm) 20)) "fi"))
          m0 (assoc (m-of "x") :minibuffer mb))
      (do
        (is (mb-cands-stale? m0))
        ;; nothing would ask again: the stamp says the question is already out
        (assert= m0 (ed-cache-mb-candidates m0))
        ;; the idle beat drops the stamp and asks afresh, so an answer is now coming
        (ed-mb-reask m0)
        (assert= ["fi" (list "file1")]
          (receive ([:fuzzy-ranked ^session query hits] [query hits]) (after 5000 :timeout)))
        (fuzzy/ranker-stop session)))))
;; ---- the new line/word editing commands -------------------------------------
(describe "editor case-region / whitespace / read-only / file commands"
  (test "C-x C-u upper-cases the region"
    (assert= (buffer-text (cur (press (m-of "abcdef")
                                 [(keyword "ctrl- ") :right :right :right :ctrl-x :ctrl-u])))
      "ABCdef"))
  (test "C-x C-l lower-cases the region"
    (assert= (buffer-text (cur (press (m-of "ABCDEF")
                                 [(keyword "ctrl- ") :right :right :right :ctrl-x :ctrl-l])))
      "abcDEF"))
  (test "case-region with no region is a no-op-with-message"
    (let (m (cmd-upcase-region (m-of "abc") nil))
      (assert= (buffer-text (cur m)) "abc")
      (is (includes? (:echo m) "no region"))))
  (test "M-SPC collapses surrounding whitespace to one space"
    (assert= (buffer-text (cur (press (m-of "a   b") [:right :right (keyword "alt- ")]))) "a b"))
  (test "M-\\ deletes all surrounding whitespace"
    (assert= (buffer-text (cur (press (m-of "a   b") [:right :right (keyword "alt-\\")]))) "ab"))
  (test "C-x C-q toggles read-only and then blocks edits"
    (let (ro (press (m-of "x") [:ctrl-x :ctrl-q]))
      (is (read-only? (cur ro)))
      (assert= (buffer-text (cur (ed-update ro "y" 80 24))) "x"))) ; edit refused
  (test "spit saves the buffer to a new path and backs it"
    (let (path (str (temp-dir "bedit-wf-") ".txt")
          prompt (cmd-write-file (m-of "hello") nil)
          done (ed-update (assoc prompt
                            :minibuffer
                              (assoc (:minibuffer prompt)
                                :edit (ed-mb-set-text (:edit (:minibuffer prompt)) path)))
                 :enter 80 24))
      (is (file/exists? path))
      (assert= (file/slurp path) "hello")
      (assert= (buffer-file (cur done)) path)))
  (test "revert-buffer re-reads the file from disk, discarding edits"
    (let (path (str (temp-dir "bedit-rev-") ".txt")
          _ (file/spit path "disk\n")
          edited (ed-update (ed-find-file (m-of "x") path) "Z" 80 24)
          reverted (cmd-revert-buffer edited nil))
      (assert= (buffer-text (cur reverted)) "disk\n")))
  (test "M-t transposes the words around point"
    ;; point between "foo" and "bar" → "bar foo"
    (let (m (cm "foo bar" 3))
      (assert= (buffer-text (cur (ed-update m :alt-t 80 24))) "bar foo")))
  (test "C-x C-t transposes the current line with the previous"
    ;; on line 1 (\"bbb\"), swap with line 0 (\"aaa\") → "bbb\naaa\n": the last line gets a newline, as Emacs gives it
    (let (m (cm "aaa\nbbb" 4))
      (assert= (buffer-text (cur (press m [:ctrl-x :ctrl-t]))) "bbb\naaa\n"))))

(describe "editor occur (M-s o)"
  (test "occur lists matching lines with 1-based source line numbers"
    (let (b (make-buffer "foo\nbar\nfoobar\nbaz")
          ms (search-commands/ed-occur-matches b "foo")
          txt (search-commands/ed-occur-text ms "foo"))
      (assert= (map ms first) (list 0 2)) ; 0-based lines 0 and 2 match
      (is (includes? txt "1: foo"))
      (is (includes? txt "3: foobar"))))
  (test "ed--leading-int parses a result row's source line"
    (assert= (pool/ed-leading-int "12: some text") 12)
    (assert= (pool/ed-leading-int "header line") nil))
  (test "M-s o builds an *Occur* buffer; RET visits the source line in another pane"
    (let (m (m-of "alpha\nbeta\ngamma\nbeta two")
          op (cmd-occur m nil)
          shown (ed-update (assoc op
                             :minibuffer
                               (assoc (:minibuffer op)
                                 :edit (ed-mb-set-text (:edit (:minibuffer op)) "gamma")))
                  :enter 80 24))
      (assert= (buffer-name (cur shown)) "*Occur*")
      ;; the row's location rides on the buffer, naming its source — not on the model
      (assert= (get (:line-links (cur shown)) 1) {:buffer "*scratch*" :line 3})
      ;; put point on the "3: gamma" row, then RET jumps back to the source at line 3
      (let (pos (index-of (buffer-text (cur shown)) "3: gamma" 0)
            on-row (ed-set-buf shown (goto-char (cur shown) pos))
            jumped (cmd-visit-location on-row nil))
        (assert= (buffer-name (cur jumped)) "*scratch*")
        (assert= (buffer-current-line (cur jumped)) 2))))) ; line 3 → 0-based index 2
(defn- macro-out (m)
  ;; what the loop does while a macro runs: fire its ticker until the run ends
  (if (nil? (:macro-run m)) m (macro-out (ed-update m [:timer :macro-continue] 80 24))))
(defn- run (m keys) (macro-out (press m keys)))

(describe "editor keyboard macros (C-x ( / ) / e)"
  (test "record a macro and execute it replays the keys"
    ;; C-x ( type "ab" C-x ) then C-x e → "ab" typed twice = "abab"
    (let (m (run (m-of "") [:ctrl-x "(" "a" "b" :ctrl-x ")" :ctrl-x "e"]))
      (assert= (buffer-text (cur m)) "abab")))
  (test "the macro body excludes the C-x ) that ended it"
    (let (m (press (m-of "") [:ctrl-x "(" "x" :ctrl-x ")"]))
      (assert= (:macro-last m) (list "x"))))
  (test "an empty macro is ignored and the last one kept (Emacs's \"Ignore empty macro\")"
    (let (m (press (m-of "") [:ctrl-x "(" "x" :ctrl-x ")" :ctrl-x "(" :ctrl-x ")"]))
      (assert= (:macro-last m) (list "x"))
      (is (nil? (:macro-recording m)))
      (assert= (:echo m) "Ignore empty macro")))
  (test "C-u 3 on an empty macro runs nothing and keeps the last one"
    (let (m (run (m-of "") [:ctrl-x "(" "x" :ctrl-x ")" :ctrl-x "(" :ctrl-u "3" :ctrl-x ")"]))
      (assert= (:macro-last m) (list "x"))
      (assert= (buffer-text (cur m)) "x")))
  (test "after C-x e, `e` runs it again, and again; another key ends that"
    (let (m (run (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-x "e"])
          again (run m ["e" "e"]))
      (assert= (buffer-text (cur again)) "aaaa")
      (assert= (buffer-text (cur (run again ["x" "e"]))) "aaaaxe")))
  (test "F3 records and F4 ends; F4 then runs it"
    (let (m (press (m-of "") [:f3 "a" "b" :f4]))
      (assert= (:macro-last m) (list "a" "b"))
      (assert= (buffer-text (cur (run m [:f4]))) "abab")
      (assert= (buffer-text (cur (run m [:ctrl-u "2" :f4]))) "ababab")))
  (test "F3 while recording types the counter, each pass the next number"
    (let (m (press (m-of "") [:f3 "x" :f3 :enter :f4]))
      (assert= (buffer-text (cur m)) "x0\n")
      (assert= (buffer-text (cur (run m [:ctrl-u "2" :f4]))) "x0\nx1\nx2\n")))
  (test "C-x e with no macro reports it"
    (is (includes? (get (press (m-of "") [:ctrl-x "e"]) :echo) "no keyboard macro")))
  (test "C-u N C-x e runs the macro N times"
    (let (m (run (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-u "3" :ctrl-x "e"]))
      (assert= (buffer-text (cur m)) "aaaa")))
  (test "a bare C-u C-x e runs it four times"
    (let (m (run (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-u :ctrl-x "e"]))
      (assert= (buffer-text (cur m)) "aaaaa")))
  (test "a run stops at the first key that fails: a search with no next match"
    ;; the macro: search for `x`, leave the search, type `!`. Two x's: the third pass's
    ;; search fails, so its `!` is never typed
    (let (m (press (m-of "x x x") [:ctrl-x "(" :ctrl-s "x" :enter "!" :ctrl-x ")"])
          ran (run (ed-set-buf m (goto-char (cur m) 0)) [:ctrl-u "9" :ctrl-x "e"]))
      (assert= (buffer-text (cur m)) "x! x x")
      (assert= (buffer-text (cur ran)) "x!! x! x!")))
  (test "C-u 0 C-x e runs until a key fails: C-n at the last line"
    (let (m (press (m-of "a\nb\nc\nd") [:ctrl-x "(" :ctrl-a "-" :ctrl-n :ctrl-x ")"])
          ran (run m [:ctrl-u "0" :ctrl-x "e"]))
      (assert= (buffer-text (cur ran)) "-a\n-b\n-c\n-d")
      (assert= (:echo ran) "End of buffer")
      (is (nil? (:macro-executing ran)))))
  (test "a run is sliced: it yields to the loop and its ticker resumes it"
    (binding (*macro-slice-ms* 0)
      (let (m (press (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-u "3" :ctrl-x "e"]))
        ;; a slice of one key: the recorded `a` and the run's first
        (assert= (buffer-text (cur m)) "aa")
        (is (:macro-executing m))
        (is (contains? (:timers m) :macro-continue))
        (let (done (macro-out m))
          (assert= (buffer-text (cur done)) "aaaa")
          (is (nil? (:macro-executing done)))
          (is (not (contains? (:timers done) :macro-continue)))))))
  (test "the run's ticker is a command timer, so no background ceiling cuts a slice short"
    (binding (*macro-slice-ms* 0)
      (let (m (press (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-u "3" :ctrl-x "e"]))
        (assert= (get (:timers m) :macro-continue) {:every 1 :command? true}))))
  (test "a slice that throws ends the run and says so, never to be run again"
    (let (broken (assoc (m-of "")
                   :macro-executing true
                   :macro-run {:keys ["a"] :passes :not-a-count :done 0 :index 1})
          ended (ed-update broken [:timer :macro-continue] 80 24))
      (is (nil? (:macro-run ended)))
      (is (nil? (:macro-executing ended)))
      (is (includes? (:echo ended) "keyboard macro stopped"))))
  (test "C-g ends a run that would never fail, keeping what it did"
    (binding (*macro-slice-ms* 0)
      (let (m (press (m-of "") [:ctrl-x "(" "x" :ctrl-x ")" :ctrl-u "0" :ctrl-x "e"])
            ticked (press m [[:timer :macro-continue] [:timer :macro-continue]])
            quit (press ticked [:ctrl-g]))
        ;; past the recorded `x` and the first slice's: the ticks typed more
        (is (string/starts-with? (buffer-text (cur ticked)) "xxx"))
        (assert= (buffer-text (cur quit)) (buffer-text (cur ticked)))
        (is (nil? (:macro-run quit)))
        (is (nil? (:macro-executing quit)))
        (is (not (contains? (:timers quit) :macro-continue)))
        ;; and the editor takes keys again at once
        (assert= (buffer-text (cur (press quit ["!"]))) (str (buffer-text (cur quit)) "!")))))
  (test "C-g drops what was typed while the run went"
    (binding (*macro-slice-ms* 0)
      (let (m (press (m-of "") [:ctrl-x "(" "x" :ctrl-x ")" :ctrl-u "0" :ctrl-x "e" "z" :ctrl-g]))
        (assert= (buffer-text (cur m)) "xx")
        (is (nil? (:macro-typeahead m))))))
  (test "keys typed during a run wait for it, then fold in order"
    (binding (*macro-slice-ms* 0)
      (let (m (press (m-of "") [:ctrl-x "(" "a" :ctrl-x ")" :ctrl-u "3" :ctrl-x "e" "y" "z"]))
        (assert= (buffer-text (cur m)) "aa")
        (assert= (:macro-typeahead m) ["y" "z"])
        (assert= (buffer-text (cur (macro-out m))) "aaaayz"))))
  (test "a run undoes as one typing run, however it is sliced"
    ;; the recording's own `ab` is a group of its own (C-x ) came between)
    (let (recorded (press (m-of "") [:ctrl-x "(" "a" "b" :ctrl-x ")"])
          whole (press (run recorded [:ctrl-u "2" :ctrl-x "e"]) [:ctrl-/])
          sliced (binding (*macro-slice-ms* 0)
                   (press (run recorded [:ctrl-u "2" :ctrl-x "e"]) [:ctrl-/])))
      (assert= (buffer-text (cur whole)) "ab")
      (assert= (buffer-text (cur sliced)) "ab")))
  (test "a chord bound to nothing stops the macro too"
    (let (m (assoc (press (m-of "") [:ctrl-x "(" "a" :ctrl-x ")"])
              :macro-last ["a" :ctrl-x "4" "z" "b"])
          ran (run m [:ctrl-u "3" :ctrl-x "e"]))
      ;; `C-x 4 z` is bound to nothing: the first pass types `a` (after the one recording
      ;; typed), fails there, and stops — no `b`, no second pass
      (assert= (buffer-text (cur ran)) "aa")))
  (test "the macro excludes the prefix argument typed before C-x ) and the chord"
    (let (m (macro-out (press (m-of "") [:ctrl-x "(" "5" "a" :ctrl-u "2" :ctrl-x ")"])))
      (assert= (vec (:macro-last m)) ["5" "a"])
      ;; C-u 2 C-x ) ends the macro and runs it once more
      (assert= (buffer-text (cur m)) "5a5a")))
  (test "C-x e while recording ends the macro and runs it"
    (let (m (run (m-of "") [:ctrl-x "(" "a" :ctrl-x "e"]))
      (assert= (vec (:macro-last m)) ["a"])
      (is (nil? (:macro-recording m)))
      (assert= (buffer-text (cur m)) "aa")))
  (test "the prefix argument's start is found back from the chord"
    (assert= (ed-macro-prefix-start ["a" "5" :ctrl-u "3"]) 2)
    (assert= (ed-macro-prefix-start ["a" "5"]) 2)
    (assert= (ed-macro-prefix-start [:ctrl-u :ctrl-u]) 0)))

(describe "a motion that cannot move fails"
  (test "C-f at the end and C-b at the start say so"
    (assert= (:echo (press (cm "ab" 2) [:ctrl-f])) "End of buffer")
    (assert= (:echo (press (m-of "ab") [:ctrl-b])) "Beginning of buffer"))
  (test "C-n on the last line and C-p on the first say so, and point stays"
    (let (down (press (m-of "a\nb") [:ctrl-n :ctrl-n]))
      (assert= (:echo down) "End of buffer")
      (assert= (buffer-current-line (cur down)) 1))
    (assert= (:echo (press (m-of "a\nb") [:ctrl-p])) "Beginning of buffer"))
  (test "the failure is the key's own: the next key clears it"
    (let (failed (press (cm "ab" 2) [:ctrl-f]))
      (is (:command-failed failed))
      (is (nil? (:command-failed (press failed [:ctrl-b]))))))
  (test "the failure is only shown, never logged to *Messages*"
    (let (m (press (m-of "ab") [:ctrl-b :ctrl-b :ctrl-b])
          idx (ed-buffer-index-by-name m "*Messages*"))
      (is (or (nil? idx) (not (includes? (buffer-text (ed-buf-at m idx)) "Beginning of buffer")))))))

(describe "editor fill-paragraph"
  ;; the greedy word-wrap itself is `string/fill` (tested in brood's
  ;; string tests); here we test the editor command end-to-end.
  (test "M-q wraps a long paragraph, keeping every word"
    (let (long "one two three four five six seven eight nine ten eleven twelve thirteen fourteen"
          txt (buffer-text (cur (ed-update (cm long 0) :alt-q 80 24))))
      (is (every? (string/split txt "\n") (fn (ln) (<= (string/length ln) 70))))
      (assert= (string/replace txt "\n" " ") long) ; same words, only the line breaks changed
      (is (includes? txt "\n"))))) ; it actually wrapped (>1 line)
(describe "editor zap-to-char / registers"
  (test "M-z kills up to and including the next occurrence of a char"
    ;; "hello world", point 0, zap to 'o' → kills "hello", leaving " world"
    (assert= (buffer-text (cur (press (m-of "hello world") [(keyword "alt-z") "o"]))) " world"))
  (test "M-z reports when the char isn't found"
    (let (m (press (m-of "abc") [(keyword "alt-z") "z"]))
      (assert= (buffer-text (cur m)) "abc")
      (is (includes? (:echo m) "not found"))))
  (test "point-to-register (C-x r SPC) then jump (C-x r j) returns to the saved point"
    (let (m (press (cm "abcdef" 3) [:ctrl-x "r" " " "a" :ctrl-a :ctrl-x "r" "j" "a"]))
      (assert= (buffer-point (cur m)) 3)))
  (test "copy-to-register (C-x r s) then insert (C-x r i) yanks the saved text"
    ;; select "abc" → save to register t → go to end → insert → "abcdefabc"
    (let (m (press (m-of "abcdef")
              [(keyword "ctrl- ")
                :right :right :right :ctrl-x "r" "s" "t" :end :ctrl-x "r" "i" "t"]))
      (assert= (buffer-text (cur m)) "abcdefabc"))))

(describe "editor goto-line / recentf"
  (test "M-g g jumps to a line number"
    (let (m (cmd-goto-line (cm "a\nb\nc\nd" 0) nil)
          done (ed-update (assoc m
                            :minibuffer
                              (assoc (:minibuffer m)
                                :edit (ed-mb-set-text (:edit (:minibuffer m)) "3")))
                 :enter 80 24))
      (assert= (buffer-current-line (cur done)) 2))) ; line 3 → 0-based index 2
  (test "recentf prompt lists the given files and opens the chosen one"
    (let (prompt (commands/ed-recentf-prompt (m-of "x") ["/a/one.txt" "/b/two.txt"]))
      ;; (that a minibuffer is open is what the checker proves of the return; the
      ;; candidate read below fails on nil anyway)
      (is (includes? (ed-mb-candidates (:minibuffer prompt)) "one.txt"))))
  (test "recentf with no files reports it"
    (is (includes? (get (commands/ed-recentf-prompt (m-of "x") []) :echo) "no recent"))))

(describe "editor which-key / describe-key"
  (test "which-key stays hidden until the idle delay, then reveals the continuations"
    ;; C-x alone: pending but not revealed → no panel (a fast chord never flashes it)
    (assert= (ed-which-key-ops (press (m-of "x") [:ctrl-x]) 80 24) [])
    ;; the which-key timer, fired while still pending, reveals it
    (let (m (press (m-of "x") [:ctrl-x [:timer :which-key]])
          ops (ed-which-key-ops m 80 24)
          text-of (fn (ops)
                    (string/join (map (seq/filter ops (fn (op) (= (first op) :text)))
                                   (fn (op) (nth op 3 "")))
                      "\n"))
          txt (text-of ops))
      (is (:which-key m))
      (is (> (count ops) 0))
      (is (includes? txt "start-kbd-macro")) ; C-x ( sorts first
      ;; C-x has more continuations than 80 columns hold: they are paged, the last cell says so
      (is (includes? txt "page 1/"))
      (is (includes? txt "C-h n/p"))
      ;; a window wide enough shows them all, C-x C-f's "find-file" among them
      (let (wide (text-of (ed-which-key-ops m 600 24)))
        (is (includes? wide "find-file"))
        (is (not (includes? wide "page 1/"))))))
  (test "completing the chord clears the which-key reveal"
    (is (nil? (get (press (m-of "x") [:ctrl-x [:timer :which-key] :ctrl-f]) :which-key))))
  (test "C-x is paged at 80 columns: C-h n turns to page 2 and the chord stays pending"
    (let (text-of (fn (m)
                    (string/join (map (seq/filter (ed-which-key-ops m 80 24)
                                        (fn (op) (= (first op) :text)))
                                   (fn (op) (nth op 3 "")))
                      "\n"))
          first-page (press (m-of "x") [:ctrl-x [:timer :which-key]])
          menu (press first-page [:ctrl-h])
          second-page (press menu ["n"]))
      (is (includes? (text-of first-page) "page 1/"))
      (is (:which-key-paging menu))
      (is (includes? (:echo menu) "[n]ext page"))
      (is (map? (:pending second-page)))
      (is (nil? (:which-key-paging second-page)))
      (is (includes? (text-of second-page) "page 2/"))
      (assert= (:echo second-page) "C-x-")
      ;; the page belongs to the chord: C-h p from the first page wraps to the last
      (let (last-page (text-of (press first-page [:ctrl-h "p"]))
            after-label (or (second (string/split (text-of first-page) "page 1/")) "")
            total (first (string/split after-label " ")))
        (is (includes? last-page (str "page " total "/" total))))))
  (test "C-h opens the panel at once, without the idle delay"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-h]))
      (is (:which-key m))
      (is (> (count (ed-which-key-ops m 80 24)) 0))))
  (test "after paging, the next key completes the chord"
    (let (m (press (m-of "abc") [:ctrl-x :ctrl-h "n" "h"]))
      (is (nil? (:pending m)))
      (is (nil? (:which-key m)))
      (is (nil? (:which-key-page m)))
      (assert= (:this-command m) 'region/cmd-mark-whole-buffer)))
  (test "a key outside the paging menu goes to the prefix"
    (is (not (nil? (:minibuffer (press (m-of "x") [:ctrl-x :ctrl-h :ctrl-f]))))))
  (test "u takes the chord's last key back"
    (let (m (press (m-of "x") [:ctrl-x "p" :ctrl-h "u"]))
      (assert= (:chord m) [:ctrl-x])
      (is (map? (get (:pending m) "p"))) ; C-x's own map again
      (assert= (:echo m) "C-x-")))
  (test "u on a one-key chord ends it"
    (is (nil? (:pending (press (m-of "x") [:ctrl-x :ctrl-h "u"])))))
  (test "h lists every binding under the prefix in *Help*"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-h "h"])
          text (buffer-text (cur m)))
      (assert= (buffer-name (cur m)) "*Help*")
      (is (includes? text "Key bindings starting with C-x"))
      (is (includes? text "C-x C-f"))
      (is (includes? text "find-file"))
      (is (includes? text "C-x p f")) ; a sub-prefix's bindings, walked
      (is (nil? (:pending m)))))
  (test "a and C-g abort the chord"
    (is (nil? (:pending (press (m-of "x") [:ctrl-x :ctrl-h "a"]))))
    (is (nil? (:pending (press (m-of "x") [:ctrl-x :ctrl-h :ctrl-g])))))
  (test "a prefix that binds C-h keeps its binding"
    (let (m (press (m-of "x") [:ctrl-h :ctrl-h]))
      (is (nil? (:which-key-paging m)))
      (is (nil? (:pending m)))))
  (test "which-key is empty with no pending prefix"
    (assert= (ed-which-key-ops (m-of "x") 80 24) []))
  (test "C-h k describes the next key's command and docstring"
    (let (m (press (m-of "x") [:ctrl-h "k" :ctrl-e]))
      (is (includes? (:echo m) "end-of-line"))
      (is (nil? (:describe-key m))))) ; describe mode cleared after reporting
  (test "C-h k describes a chord (C-x C-s)"
    (is (includes? (get (press (m-of "x") [:ctrl-h "k" :ctrl-x :ctrl-s]) :echo) "save")))
  (test "C-h k on an unbound key says so"
    (is (includes? (get (press (m-of "x") [:ctrl-h "k" :f12]) :echo) "undefined")))

  ;; ---- Plume: the minibuffer completion UI (one layer, overridable) ---------
  ;; Emacs's vertico + marginalia + the counter, folded into one named `plume` layer:
  ;; the file annotator, the relative-time + size formatters, the N/M counter, and the
  ;; per-category annotator registry — the override seam (redefine `plume/plume-file-
  ;; annotation` or swap a registry entry live, proven manually).
  (test "plume-marks: each term's matches, moved onto the label the row shows"
    ;; the basename label of a path: `ex` (term 0) and `lim` (term 1), shifted past `lib/`
    (assert= [[7 0] [8 0] [0 1] [1 1] [2 1]]
      (plume/plume-marks "ex lim" "lib/limits.ex" "limits.ex"))
    ;; a match in the directory the label does not show is dropped, not misplaced
    (assert= [] (plume/plume-marks "li" "lib/limits.ex" "limits.ex"))
    (assert= [] (plume/plume-marks "zz" "lib/limits.ex" "limits.ex"))
    (assert= [] (plume/plume-marks "lim" "lib/limits.ex" "something-else")))
  (test "plume-marks: a path prompt marks the file name its ranking chose (ADR-497)"
    ;; `li` scores best at the start of `lib/` as a plain string, and in `limits` as a path
    (assert= [] (plume/plume-marks "li" "lib/limits.ex" "limits.ex"))
    (assert= [[0 0] [1 0]] (plume/plume-marks "li" "lib/limits.ex" "limits.ex" {:category :file})))
  (test "plume-marks: an excluding term marks nothing, a literal one its run"
    (assert= [[0 0] [1 0] [2 0]] (plume/plume-marks "lim !test" "limits.ex" "limits.ex"))
    (assert= [[3 0] [4 0] [5 0]] (plume/plume-marks "=its" "limits.ex" "limits.ex"))
    (assert= [] (plume/plume-marks "lim !its" "limits.ex" "limits.ex")))
  (test "plume-clip-marks: shifted past the cut and its …, the cut ones dropped"
    (assert= [[0 0]] (plume/plume-clip-marks "abc" 10 [[0 0]]))
    (assert= [[4 0]] (plume/plume-clip-marks "lib/limits.ex" 6 [[0 1] [11 0]])))
  (test "plume-human-size: bytes, then k/m to one decimal (lowercase units)"
    (assert= (plume/plume-human-size 755) "755")
    (assert= (plume/plume-human-size 1456) "1.4k")
    (assert= (plume/plume-human-size 2600) "2.5k")
    (assert= (plume/plume-human-size (* 12 1024)) "12k")
    (assert= (plume/plume-human-size nil) "?"))
  (test "plume-reltime: a short '… ago' from epoch-ms, blank when nil"
    (assert= (plume/plume-reltime 0 5000) "5s ago")
    (assert= (plume/plume-reltime 0 90000) "1m 30s ago")
    (assert= (plume/plume-reltime 0 6071000) "1h 41m ago") ; matches the screenshot
    (assert= (plume/plume-reltime 0 (* 3 86400000)) "3d ago")
    (assert= (plume/plume-reltime nil 1000) ""))
  (test "plume-count-label: the N/M prompt counter (1-based), blank when empty"
    (assert= (plume/plume-count-label 0 11) "1/11 ")
    (assert= (plume/plume-count-label 3 11) "4/11 ")
    (assert= (plume/plume-count-label 0 0) ""))
  (test "the Plume annotator registry dispatches on the minibuffer :category"
    (is (nil? (plume/plume-annotation {} "x"))) ; no category → none
    (is (nil? (plume/plume-annotation {:category :nope} "x"))) ; unregistered → none
    ;; the default :file annotator's fields: perms, size, relative mtime for a real file
    (let (a (plume/plume-annotation {:category :file} (str (file/cwd) "/project.blsp")))
      (assert= (count a) 3)
      (is (string/starts-with? (first a) "-rw")) ; the permission string
      (is (includes? (last a) "ago")))) ; the relative mtime
  (test "the :command annotator (M-x marginalia): key, contract, doc"
    ;; find-file is bound on the emacs profile and has a docstring; its contract is the one
    ;; every command declares, so that field is blank
    (let (km (editor/layers/scope-keymap (list (ed-current-buf (m-of "x")) (m-of "x")))
          a (plume/plume-annotation {:category :command :anno-keymap km} "find-file")
          ;; the same answer from the PRECOMPUTED table the prompt actually carries — the
          ;; two must agree, since one of them walks the keymap and the other is a lookup
          t (plume/plume-annotation {:category :command :anno-keys (ed-key-table km)} "find-file"))
      (assert= (vec (take a 2)) ["C-x C-f" ""])
      (is (includes? (nth a 2) "file path to open"))
      (assert= a t)
      ;; no keymap and no table on the prompt: the key is simply blank
      (assert= (first (plume/plume-annotation {:category :command} "find-file")) "")
      ;; a name that is no command annotates as nothing
      (assert= (plume/plume-annotation {:category :command} "no-such-command-xyz") [])))
  (test "marginalia line up as columns, the last one cut to the room left"
    (let (rows (plume/plume-columns [["C-x l" "Toggle line numbers"] ["" "Pick a theme"] nil] 20))
      ;; every row the same width, each field under its own column
      (assert= (vec (map rows string/display-width)) [20 20 20])
      (assert= (first rows) "C-x l  Toggle line …")
      (assert= (second rows) "       Pick a theme ")
      (assert= (nth rows 2) (string/pad-right "" 20)))
    (assert= (vec (plume/plume-columns [nil "" []] 40)) ["" "" ""]))
  ;; `ed-key-table` is memoised on the keymap — a rebinding is a new keymap, so it must show
  (test "the inverted key table follows a rebinding"
    (let (km (editor/layers/scope-keymap (list (ed-current-buf (m-of "x")) (m-of "x")))
          before (ed-key-table km)
          rebound (ed-key-table (editor/keymap/keymap-bind km [:f12] 'commands/cmd-memo-probe-xyz)))
      (is (nil? (get before "cmd-memo-probe-xyz")))
      (assert= (get rebound "cmd-memo-probe-xyz") [:f12])))
  ;; a QUALIFIED command with no docstring is just nil — not a retry
  ;; that raises (that raise cost ~9 ms a row in M-x's marginalia, every frame)
  (test "a doc-less qualified command has no doc"
    (is (nil? (ed-doc 'bedit/motion/cmd-beginning-of-line)))
    (is (string? (ed-doc 'bedit/commands/cmd-find-file)))
    (is (string? (ed-doc 'cmd-find-file)))
    ;; a bare name resolves through the M-x registry, whichever module defines it
    (is (string? (ed-doc 'cmd-transpose-chars))))
  (test "the M-x prompt declares the :command category with the keys already inverted"
    ;; `:anno-keys`, not `:anno-keymap`: the marginalia is drawn per visible row per frame,
    ;; and asking the keymap there walked the whole map twice a row (48 ms a keystroke)
    (let (mb (:minibuffer (cmd-execute-extended-command (m-of "x") nil)))
      (assert= (:category mb) :command)
      (is (map? (:anno-keys mb)))
      ;; the SEQUENCE, not its label — labelling every binding cost 6 ms at open to render
      ;; fifteen rows, so the rows label their own
      (assert= [:ctrl-x :ctrl-f] (get (:anno-keys mb) "cmd-find-file"))))
  (test "C-h f describes a command by name from the registry"
    (let (m (help/cmd-describe-function (m-of "x") nil)
          done (ed-update (assoc m
                            :minibuffer
                              (assoc (:minibuffer m)
                                :edit (ed-mb-set-text (:edit (:minibuffer m)) "save")))
                 :enter 80 24))
      ;; the page, not an echo line: *Help* selected, naming the command and its doc
      (assert= (buffer-name (cur done)) "*Help*")
      (is (includes? (buffer-text (cur done)) "save is an interactive command"))
      (is (includes? (buffer-text (cur done)) "file"))))) ; cmd-save's docstring mentions the file
(describe "editor line/word editing"
  (test "M-o opens a line below and moves there"
    (let (m (ed-update (m-of "abc") :alt-o 80 24))
      (assert= (buffer-text (cur m)) "abc\n")
      (assert= (buffer-current-line (cur m)) 1)))
  (test "M-O opens a line above and moves there"
    (let (m (ed-update (m-of "abc") (keyword "alt-O") 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-current-line (cur m)) 0)))
  (test "C-o opens a line, keeping point"
    (let (m (ed-update (m-of "abc") :ctrl-o 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-point (cur m)) 0)))
  (test "C-k kills to end of line (onto the kill ring)"
    (let (m (ed-update (m-of "abc\ndef") :ctrl-k 80 24))
      (assert= (buffer-text (cur m)) "\ndef")
      (assert= (first (:kill-ring m)) "abc")))
  (test "C-k at end of line kills the newline"
    (let (m (ed-update (ed-set-buf (m-of "ab\ncd") (end-of-line (cur (m-of "ab\ncd"))))
              :ctrl-k 80 24))
      (assert= (buffer-text (cur m)) "abcd")))
  (test "M-d kills the word after point"
    (let (m (ed-update (m-of "foo bar") :alt-d 80 24))
      (assert= (buffer-text (cur m)) " bar")
      (assert= (first (:kill-ring m)) "foo")))
  (test "M-DEL kills the word before point"
    (assert= (buffer-text (cur (press (m-of "foo bar") [:end (keyword "alt-backspace")]))) "foo "))
  (test "C-t transposes the two characters around point"
    (let (m (ed-update (ed-set-buf (m-of "ab") (forward-char (make-buffer "ab"))) :ctrl-t 80 24))
      (assert= (buffer-text (cur m)) "ba")))
  (test "M-u / M-l / M-c change word case"
    (assert= (buffer-text (cur (ed-update (m-of "foo bar") :alt-u 80 24))) "FOO bar")
    (assert= (buffer-text (cur (ed-update (m-of "FOO") :alt-l 80 24))) "foo")
    (assert= (buffer-text (cur (ed-update (m-of "foo") :alt-c 80 24))) "Foo"))
  ;; C-x d is dired now (Emacs); duplicate-line stays reachable by name
  (test "duplicate-line duplicates the current line (M-x; C-x d is dired, as in Emacs)"
    (assert= (buffer-text (cur (cmd-duplicate-line (m-of "abc") nil))) "abc\nabc")
    (is (:minibuffer (press (m-of "abc") [:ctrl-x "d"]))))
  ;; M-^ is Emacs `delete-indentation`: it pulls THIS line up onto the one above. This
  ;; test asserted the opposite (Vim's `J`, the next line down) and was left behind when
  ;; the command was corrected — the contract itself is covered in `editing_test`; what
  ;; belongs here is that the KEY reaches it.
  (test "M-^ joins this line onto the one above"
    (let (m (ed-set-buf (m-of "") (goto-char (make-buffer "abc\ndef") 5)))
      ; point on line 2
      (assert= (buffer-text (cur (ed-update m (keyword "alt-^") 80 24))) "abc def")))

  (test "M-^ on the first line has nothing above it — a no-op through the key path too"
    (assert= (buffer-text (cur (ed-update (m-of "abc\ndef") (keyword "alt-^") 80 24)))
      "abc\ndef")))

;; ---- Emacs kill-ring semantics: coalescing + M-y yank-pop -------------------
(describe "editor kill ring (Emacs semantics)"
  (test "consecutive C-k coalesce into one kill-ring entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :ctrl-k]))
      ; kill "abc", then the "\n"
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (:kill-ring m)) "abc\n") ; appended, not two entries
      (assert= (count (:kill-ring m)) 1)))
  (test "a non-kill between kills starts a new entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :right :ctrl-k]))
      ; kill, move, kill
      (assert= (count (:kill-ring m)) 2)))
  (test "M-DEL (backward kill) coalesces by prepending"
    (let (m (press (ed-set-buf (m-of "foo bar") (end-of-buffer (cur (m-of "foo bar"))))
              [(keyword "alt-backspace") (keyword "alt-backspace")]))
      ; kill "bar", then "foo "
      (assert= (first (:kill-ring m)) "foo bar")
      (assert= (buffer-text (cur m)) "")))
  (test "C-y yanks the newest; M-y pops to the next-older kill"
    (let (m0 (assoc (m-of "") :kill-ring (list "newest" "older"))
          yanked (ed-update m0 :ctrl-y 80 24)
          popped (ed-update yanked :alt-y 80 24))
      (assert= (buffer-text (cur yanked)) "newest")
      (assert= (buffer-text (cur popped)) "older")))
  (test "M-y cycles the whole ring and wraps around"
    (let (m (assoc (m-of "") :kill-ring (list "a" "b" "c"))
          y0 (ed-update m :ctrl-y 80 24)
          y1 (ed-update y0 :alt-y 80 24)
          y2 (ed-update y1 :alt-y 80 24)
          y3 (ed-update y2 :alt-y 80 24))
      (assert= (buffer-text (cur y0)) "a")
      (assert= (buffer-text (cur y1)) "b")
      (assert= (buffer-text (cur y2)) "c")
      (assert= (buffer-text (cur y3)) "a"))) ; wrapped
  (test "M-y only works right after a yank"
    (let (no-yank (ed-update (assoc (m-of "") :kill-ring (list "x")) :alt-y 80 24)
          ;; editing between yank and M-y breaks it
          broke (ed-update (ed-update (assoc (m-of "") :kill-ring (list "a" "b")) :ctrl-y 80 24)
                  "z" 80 24))
      (is (includes? (:echo no-yank) "not a yank"))
      (is (includes? (:echo (ed-update broke :alt-y 80 24)) "not a yank"))))
  ;; The OS-clipboard sync is gated on `:os-clipboard` (set only by the live editor), so
  ;; pure model tests never touch the process-global clipboard — proven by the no-op.
  (test "yank does not consult the OS clipboard without :os-clipboard (deterministic)"
    (let (m (assoc (m-of "") :kill-ring (list "ring-top")))
      (assert= (ed-adopt-clipboard m) m) ; identical model — clipboard untouched
      ;; and yank still inserts the ring head, not whatever is on the OS clipboard
      (assert= (buffer-text (cur (ed-update m :ctrl-y 80 24))) "ring-top"))))

;; ---- imenu live preview + cancel-restores-position (M-g i) ------------------
(describe "imenu preview + cancel restore"
  (test "on-preview jumps point to the selected symbol; on-abort restores the origin"
    (let (text "line0\nline1\nline2\nline3\n"
          m0 (cm text 0)
          syms (list {:name "a" :kind 12 :line 0 :char 0}
                 {:name "b" :kind 6 :line 2 :char 1})
          mb (:minibuffer (lsp-commands/ed-imenu-prompt m0 syms))
          lbl-b (lsp-commands/ed-imenu-label {:name "b" :kind 6})
          mp ((:on-preview mb) (cm text 0) lbl-b) ; preview symbol "b"
          ma ((:on-abort mb) mp))
      ; then cancel
      (assert= (buffer-point (cur mp))
        (+ (text/line->char (buffer-rope (cur mp)) 2) 1)) ; jumped to line 2, col 1
      (assert= (buffer-point (cur ma)) 0))) ; abort restored point
  (test "an unknown candidate previews as a no-op (no jump)"
    (let (m0 (cm "abc" 1)
          mb (get (lsp-commands/ed-imenu-prompt m0 (list {:name "a" :kind 12 :line 0 :char 0}))
               :minibuffer)
          mp ((:on-preview mb) m0 "no-such-label  (fn)"))
      (assert= (buffer-point (cur mp)) 1)))
  (test "cancelling the prompt (C-g) returns to the original position"
    (let (text "l0\nl1\nl2\nl3\n"
          m0 (cm text 0)
          syms (list {:name "a" :kind 12 :line 0 :char 0} {:name "b" :kind 6 :line 2 :char 0})
          moved (press (lsp-commands/ed-imenu-prompt m0 syms) [:ctrl-n]) ; preview-jumps
          back (press moved [:ctrl-g]))
      ; abort
      (is (nil? (:minibuffer back)))
      (assert= (buffer-point (cur back)) 0))))

;; ---- LSP edits + jump-marker stack (goto-definition / M-,) ------------------
(describe "lsp edits and marker stack"
  (test "ed--apply-text-edits applies non-overlapping edits (order-independent)"
    (let (e1 {:start-line 0 :start-char 0 :end-line 0 :end-char 1 :text "X"} ; a -> X
          e2 {:start-line 0 :start-char 3 :end-line 0 :end-char 4 :text "Y"})
      ; d -> Y
      ;; edits given in forward order; applied last-position-first internally
      (assert= (buffer-text (lsp-commands/ed-apply-text-edits (make-buffer "abcdef") (list e1 e2)))
        "XbcYef")))
  (test "a multi-char replacement spanning a range"
    (let (e {:start-line 0 :start-char 1 :end-line 0 :end-char 4 :text "Z"})
      ; bcd -> Z
      (assert= (buffer-text (lsp-commands/ed-apply-text-edits (make-buffer "abcdef") (list e)))
        "aZef")))
  (test "M-, with no prior jump reports it and consumes nothing"
    (let (back (cmd-pop-jump (m-of "x") :k))
      (is (includes? (:echo back) "no jump"))
      (is (empty? (or (:jump-markers back) '())))))
  (test "push the jump stack, move away, then M-, returns to the pushed point"
    (let (m0 (ed-apply (m-of "hello world") (fn (b) (goto-char b 6))) ; point at 6
          pushed (ed-push-jump m0)
          moved (ed-apply pushed (fn (b) (goto-char b 0))) ; jump elsewhere
          back (cmd-pop-jump moved :k))
      (assert= (buffer-point (cur back)) 6)
      (is (empty? (or (:jump-markers back) '())))))) ; stack popped
(describe "C-x b — switch-to-buffer the Emacs way: the other buffer is the default"
  (test "RET on an empty prompt goes back to the buffer you were in before; twice flips back"
    (let (m0 (m-of "one")
          m1 (ed-post-step (ed-open-buffer m0 (make-buffer "two" "b2")) "x") ; now in b2
          p (ed-update m1 :ctrl-x 80 24)
          p (ed-update p "b" 80 24)
          back (ed-update p :enter 80 24)
          p2 (ed-update (ed-update (ed-post-step back "x") :ctrl-x 80 24) "b" 80 24)
          again (ed-update p2 :enter 80 24))
      (is (includes? (:text (:edit (:minibuffer p))) "")) ; empty input
      (is (includes? (str (map/get-in p [:minibuffer :edit :prompt])) "default"))
      (assert= (buffer-text (cur back)) "one")
      (assert= (buffer-text (cur again)) "two")))
  (test "the candidates are the other buffers, most recently selected first"
    (let (m0 (m-of "one")
          m1 (ed-post-step (ed-open-buffer m0 (make-buffer "two" "b2")) "x")
          m2 (ed-post-step (ed-open-buffer m1 (make-buffer "three" "b3")) "x")
          names (ed-recent-buffers m2))
      (assert= (first names) "b3")
      (assert= (second names) "b2")
      (assert= (ed-other-buffer m2) "b2"))))

;; ---- M-< / M-> in a candidate list ------------------------------------------
;; They mean "the top" and "the bottom" everywhere else in the editor; in a Vertico prompt
;; they used to fall through to lineedit, which reads them as ordinary text — so a long
;; imenu could only be crossed a row at a time.
(describe "M-< / M-> reach the ends of a candidate list"
  (defn sel-of (m) (:sel (:minibuffer m)))
  (defn imenu-of (text syms) (lsp-commands/ed-imenu-prompt (cm text 0) syms))
  (defn four-syms ()
    (list {:name "a" :kind 12 :line 0 :char 0}
      {:name "b" :kind 12 :line 1 :char 0}
      {:name "c" :kind 12 :line 2 :char 0}
      {:name "d" :kind 12 :line 3 :char 0}))

  (test "M-> selects the last candidate, M-< the first"
    (let (m0 (imenu-of "l0\nl1\nl2\nl3\n" (four-syms))
          n (count (mb-candidates (:minibuffer m0)))
          bottom (press m0 [(keyword "alt->")]))
      (assert= (sel-of bottom) (dec n))
      (assert= (sel-of (press bottom [(keyword "alt-<")])) 0)))

  (test "M-> fires :on-preview, so a previewing prompt follows the highlight"
    ;; the same contract C-n/C-p have — a jump that moved the bar but not the buffer would
    ;; leave imenu previewing a symbol that is no longer selected
    (let (bottom (press (imenu-of "l0\nl1\nl2\nl3\n" (four-syms)) [(keyword "alt->")]))
      (assert= (buffer-current-line (cur bottom)) 3)))

  (test "they are inert on a prompt that takes no selection"
    ;; "Attach to node:" is typed, not picked — there is no list, so the keys must reach
    ;; lineedit and leave the prompt standing rather than indexing into nothing
    (let (m (assoc (m-of "x")
              :minibuffer {:edit (ed-mb-edit "Node: " "") :on-complete (fn (mm _) mm)})
          after (press m [(keyword "alt->")]))
      (is (not (nil? (:minibuffer after))))
      (assert= (mb-text (:minibuffer after)) ""))))

(describe "the list-motion vocabulary"
  (test "each motion key names its motion; any other key names none"
    (assert= (editor/list-motion/motion-of :ctrl-n) :next)
    (assert= (editor/list-motion/motion-of :down) :next)
    (assert= (editor/list-motion/motion-of :ctrl-p) :previous)
    (assert= (editor/list-motion/motion-of :up) :previous)
    (assert= (editor/list-motion/motion-of (keyword "alt-<")) :first)
    (assert= (editor/list-motion/motion-of (keyword "alt->")) :last)
    (is (nil? (editor/list-motion/motion-of "n"))))

  (test "next and previous wrap; first and last are the ends"
    (assert= (editor/list-motion/motion-index 0 3 :next) 1)
    (assert= (editor/list-motion/motion-index 2 3 :next) 0)
    (assert= (editor/list-motion/motion-index 0 3 :previous) 2)
    (assert= (editor/list-motion/motion-index 2 3 :first) 0)
    (assert= (editor/list-motion/motion-index 0 3 :last) 2))

  (test "a selection left past the end of a shrunk list still moves onto it"
    (assert= (editor/list-motion/motion-index 7 3 :next) 2)
    (assert= (editor/list-motion/motion-index 7 3 :previous) 0)))

(describe "post-step hooks"
  (test "a registered hook runs on every event, in its order"
    (register-post-step :test-probe-late {:order 1001 :run 'minibuffer-commands-test/probe-late})
    (register-post-step :test-probe-early {:order 1000 :run 'minibuffer-commands-test/probe-early})
    (let (stepped (ed-run-post-steps (m-of "x")))
      (registry/remove! :model/post-steps :test-probe-late)
      (registry/remove! :model/post-steps :test-probe-early)
      (assert= (:probe-trail stepped) [:early :late])))

  (test "a hook whose module never loaded is skipped"
    (register-post-step :test-unloaded {:order 1002 :run 'no-such-module/refresh})
    (let (m (m-of "x")
          stepped (ed-run-post-steps m))
      (registry/remove! :model/post-steps :test-unloaded)
      (assert= (buffer-text (cur stepped)) "x"))))

(defn probe-early (m) (assoc m :probe-trail (conj (or (:probe-trail m) []) :early)))
(defn probe-late (m) (assoc m :probe-trail (conj (or (:probe-trail m) []) :late)))

;; M-x memoises its sorted candidate list (`ed-mx-command-names`) on values that are the
;; same objects while nothing changes. These pin that it is still exactly the old
;; computation, and that a newly registered command is not hidden by the memo.
(describe "M-x candidates are memoised without going stale"
  ;; Both read the command names they are GIVEN: the next test registers a probe command in
  ;; the global registry, and a test running beside it could read the names before it and
  ;; after it, comparing two different registries rather than the memo against the naive.
  (defn mx-naive (buf names)
    ;; the computation the memo replaced, verbatim
    (let (owned (into #{} (ed-all-layer-commands)))
      (sort (append (seq/reject names (fn (n) (contains? owned n)))
              (apply append (ed-active-mode-commands buf))))))
  (defn mx-names (m &optional (names (interactive/command-names)))
    (ed-mx-command-names names (ed-all-layer-commands) (ed-active-mode-commands (cur m))))

  (test "the memoised list is the unmemoised one, in a plain and in a mode buffer"
    (let (plain (m-of "x")
          brood (ed-init (make-buffer "(def x 1)" "x.blsp" "x.blsp"))
          names (interactive/command-names))
      (assert= (mx-names plain names) (mx-naive (cur plain) names))
      (assert= (mx-names brood names) (mx-naive (cur brood) names))
      ;; asked twice with nothing changed, it answers the very list it stored
      (assert= (mx-names plain names) (mx-names plain names))))

  (test "a command registered after a first M-x appears on the next"
    (let (m (m-of "x"))
      (mx-names m)
      (interactive/register-command 'cmd-mx-memo-probe (fn (mm _key) mm))
      (is (includes? (mx-names m) "mx-memo-probe"))
      (registry/remove! :interactive/commands "mx-memo-probe")
      (registry/remove! :interactive/command-syms "mx-memo-probe")
      (refute (includes? (mx-names m) "mx-memo-probe")))))

;; ---- the ranking a prompt asks for (std/fuzzy, ADR-497) ---------------------
;; What a reader of the Vertico list sees: the prompt's category and history reach the
;; ranking, inline or in a session, and the orderless operators work as typed.

(defn- typed-prompt (mb text)
  "Prompt `mb` with `text` typed into it."
  (assoc mb :edit (ed-mb-set-text (:edit mb) text)))

(defn- name-prompt (names &optional (recent []))
  "A name prompt over `names` with `recent` as its history."
  (ed-name-prompt "Find: " names (fn (mm _t) mm) 20 recent))

(describe "the ranking a prompt asks for"
  (test "`foo somet` finds foo-bar-something.txt among decoys"
    (assert= "foo-bar-something.txt"
      (first (mb-candidates (typed-prompt (name-prompt ["src/foo/some/thing.txt"
                                                         "docs/s-o-m-e-t/foo.md"
                                                         "foo-bar-something.txt"
                                                         "foo/bar/baz/someone_tmp.txt"])
                              "foo somet")))))
  (test "a path prompt ranks the file name above a directory"
    (let (paths ["view/model.blsp" "src/view.blsp"])
      (assert= (list "view/model.blsp" "src/view.blsp")
        (mb-candidates (typed-prompt (name-prompt paths) "view")))
      (assert= (list "src/view.blsp" "view/model.blsp")
        (mb-candidates (typed-prompt (assoc (name-prompt paths) :category :file) "view")))))
  (test "the history a prompt was opened with ranks its entries above equal matches"
    (let (names ["cmd-other" "config"])
      (assert= (list "config" "cmd-other") (mb-candidates (typed-prompt (name-prompt names) "co")))
      (assert= (list "cmd-other" "config")
        (mb-candidates (typed-prompt (name-prompt names ["cmd-other"]) "co")))
      ;; and never lists what does not match
      (assert= (list "config")
        (mb-candidates (typed-prompt (name-prompt names ["cmd-other"]) "cf")))))
  (test "!, =, ^, $ and smart case, as typed"
    (let (names ["src/foo.ex" "src/foo_test.ex" "src/Foo.md" "lib/bar_foo.exs"])
      (assert= (list "src/foo.ex")
        (mb-candidates (typed-prompt (name-prompt names) "foo !test ex$")))
      (assert= (list "src/foo_test.ex") (mb-candidates (typed-prompt (name-prompt names) "=_test")))
      ;; lower case ignores case, so `Foo.md` starts with it too
      (assert= (list "src/Foo.md" "src/foo.ex" "src/foo_test.ex")
        (mb-candidates (typed-prompt (assoc (name-prompt names) :category :file) "^foo")))
      (assert= (list "src/Foo.md") (mb-candidates (typed-prompt (name-prompt names) "Foo")))))
  (test "a session ranks with the prompt's options, as inline ranking does"
    (let (paths ["view/model.blsp" "src/view.blsp" "src/viewer.blsp"]
          mb (typed-prompt (assoc (name-prompt paths ["src/viewer.blsp"]) :category :file) "view")
          session (fuzzy/ranker paths (mb-rank-options mb)))
      (do
        (fuzzy/rank-async session "view" 20)
        (assert= ["view" (mb-candidates mb)]
          (receive ([:fuzzy-ranked ^session query hits] [query hits]) (after 5000 :timeout)))
        (fuzzy/ranker-stop session)))))

;; ---- a standing question survives an async message --------------------------------
;; A task reply, a timer or a language server calling `message` while a y/n question (or a
;; minibuffer prompt, or a query-replace) waits for its answer used to replace it on the echo
;; row: the user was left answering a question they could no longer see. Emacs keeps the
;; question and shows the message after it in brackets until the next key.
(defn messages-log (m)
  (buffer-text (ed-buf-at m (or (ed-buffer-index-by-name m "*Messages*") (error "no *Messages*")))))
(defn asked (m)
  "`m` asking `Delete foo? (y/n) `, the answer recorded as `:answered`."
  (ed-read-char m "Delete foo? (y/n) " (fn (mm key) (assoc mm :answered (ed-yes-key? key)))))

(describe "a y/n question stays visible when a message arrives"
  (test "the prompt stays on the echo row, the message after it in brackets"
    (let (m (message (asked (m-of "x")) "git: pushed main"))
      (assert= (ed-echo-or-eldoc m) "Delete foo? (y/n) [git: pushed main]")
      (is (includes? (messages-log m) "git: pushed main"))))
  (test "a later message replaces the earlier one beside the prompt"
    (let (m (message (message (asked (m-of "x")) "first") "second"))
      (assert= (ed-echo-or-eldoc m) "Delete foo? (y/n) [second]")))
  (test "before any message the prompt shows alone"
    (assert= (ed-echo-or-eldoc (asked (m-of "x"))) "Delete foo? (y/n) "))
  (test "the question still takes its answer, and is gone after it"
    (let (answered (press (message (asked (m-of "x")) "lsp: indexing done") ["y"]))
      (is (:answered answered))
      (is (nil? (:read-char answered)))
      (is (nil? (ed-standing-question answered)))))
  (test "a message once the question is answered shows plainly"
    (let (m (message (press (asked (m-of "x")) ["n"]) "afterwards"))
      (assert= (ed-echo-or-eldoc m) "afterwards")))
  (test "a query-replace's y/n/!/./q prompt stands the same way"
    (let (m (message (query-replace/qr-start (m-of "foo foo") "foo" "bar") "timer fired")
          line (ed-echo-or-eldoc m))
      (is (string/starts-with? line "Query replacing foo with bar: (y/n/!/./q)"))
      (is (string/ends-with? line "[timer fired]"))
      ;; the next answer asks again, the message gone
      (assert= (ed-echo-or-eldoc (query-replace/qr-handle m "n"))
        "Query replacing foo with bar: (y/n/!/./q)"))))

(describe "a minibuffer prompt keeps its line when a message arrives"
  (test "the message shows after the input in brackets, logged too"
    (let (prompted (type-str (press (m-of "x") [:alt-x]) "ver")
          m (message prompted "build finished")
          line (str (ed-echo-line m 80 24)))
      (is (includes? line "ver"))
      (is (includes? line "[build finished]"))
      (is (includes? (messages-log m) "build finished"))))
  (test "the next key clears it, as Emacs's minibuffer message"
    (let (m (type-str (message (press (m-of "x") [:alt-x]) "build finished") "v"))
      (is (nil? (:message (:minibuffer m))))
      (is (not (includes? (str (ed-echo-line m 80 24)) "build finished")))))
  (test "a message said as the prompt closes reaches the echo area"
    (let (closed (ed-minibuffer-closed (message (press (m-of "x") [:alt-x]) "said last")))
      (is (nil? (:minibuffer closed)))
      (assert= (:echo closed) "said last"))))
