;; Bracket matching over a tree-sitter parse (src/tsbrackets.blsp): every `deflanguage` mode's
;; `:bracket-match` and `:bracket-match-tree`. The registration half runs everywhere; each
;; language's matches need its grammar in ~/.config/bedit/grammars and SKIP without it.
(defmodule tsbrackets-test
  (:use test)
  (:use model)
  (:use editor/buffer))

;; loaded here, at file load, so the `when`s below see what is installed
(grammars/load-user-grammars)

(defn- file-buffer (text file) (ed-current-buf (ed-init (make-buffer text file file))))

(defn- both (src lang pos)
  "The match at `pos` from the text and from a held tree of the same text — which must agree."
  (let (tree (editor/treesit/open-tree src lang)
        held (tsbrackets/match-tree tree (text/string-> src) pos))
    (editor/treesit/free-tree tree)
    (assert= held (tsbrackets/match-text src lang pos))
    held))

(describe "every tree-sitter mode matches brackets over its parse"
  (test "each deflanguage layer names both services"
    (doseq (file ["a.rb"
                   "a.ex" "a.py" "a.rs" "a.js" "a.ts" "a.tsx" "a.go" "a.c" "a.tf" "a.hcl" "a.sh"
                   "a.json" "a.toml" "a.yml" "Dockerfile"])
      (let (buf (binding (*grammar-ready?* (fn (_lang) true)) (file-buffer "" file)))
        (is (fn? (ed-mode-service buf :bracket-match)))
        (assert= (ed-mode-service buf :bracket-match-tree) tsbrackets/match-tree))))
  (test "a language with no grammar loaded matches nothing, rather than raising"
    (is (nil? (tsbrackets/match-text "(a)" :no-such-grammar 1)))))

(when (grammars/grammar-loaded? :bash)
  (describe "shell's brackets"
    (def sh-src "f() {\n  echo \"(\" $(date) ${x}\n  case $1 in\n    a) echo ;;\n  esac\n}\n")

    (test "a function's braces, from either end, cursor after or on the bracket"
      (assert= (both sh-src :bash (inc (index-of sh-src "{")))
        [(index-of sh-src "{") (string/last-index-of sh-src "}")])
      (assert= (both sh-src :bash (string/last-index-of sh-src "}"))
        [(index-of sh-src "{") (string/last-index-of sh-src "}")]))
    (test "a pair in the middle of its parent — `f()` — is found by walking the parent"
      (assert= (both sh-src :bash 2) [1 2]))
    (test "a `(` inside a string matches nothing"
      (is (nil? (both sh-src :bash (inc (index-of sh-src "(\""))))))
    (test "`$(` and `${` pair with their closers"
      (let (open (inc (index-of sh-src "$(")))
        (assert= (both sh-src :bash (inc open)) [open (index-of sh-src ") ${")]))
      (let (open (inc (index-of sh-src "${")))
        (assert= (both sh-src :bash (inc open)) [open (index-of sh-src "}\n  case")])))
    ;; the grammar's own use of `)`, in a tree without an error — not a red bracket
    (test "a case arm's `)` opens nothing and is not unmatched"
      (is (nil? (both sh-src :bash (inc (index-of sh-src "a)"))))))))

(when (grammars/grammar-loaded? :javascript)
  (describe "javascript's brackets"
    (test "a call's parens, an array's brackets, a template's `${`"
      (let (src "f(a, [1, `${b}`]);\n")
        (assert= (both src :javascript 2) [1 16])
        (assert= (both src :javascript 6) [5 15])
        (assert= (both src :javascript 12) [11 13])))
    ;; Emacs's order: just outside a pair (a closer left of the cursor, an opener under it)
    ;; before just inside one (an opener left of it)
    (test "the cursor on an inner opener lights the inner pair, not the outer one"
      (assert= (both "f([x]);\n" :javascript 2) [2 4]))
    (test "a closer left of the cursor wins over an opener under it"
      (assert= (both "f(a)(b);\n" :javascript 4) [1 3]))
    ;; a pair in the middle of its parent, 5000 characters apart: the old walk read the text
    ;; between the children and gave up after 4000; the children list has no limit
    (test "a for loop's parens around a long header, from either end"
      (let (src (str "for (" (string/repeat "\n" 5000) "i = 0;;) {}\n")
            open (index-of src "(")
            close (index-of src ")"))
        (assert= (both src :javascript (inc open)) [open close])
        (assert= (both src :javascript close) [open close])))
    (test "a bracket the parse is missing a partner for is unmatched"
      (let (src "if (x) {\n")
        (assert= (both src :javascript 8) [7 :unmatched])))
    (test "a bracket in a comment or a string matches nothing"
      (let (src "// (\nconst s = \"[\";\n")
        (is (nil? (both src :javascript 4)))
        (is (nil? (both src :javascript (inc (index-of src "[")))))))))

(when (grammars/grammar-loaded? :hcl)
  (describe "hcl's brackets"
    ;; the `{` is a wrapper node's (`block_start`) in the middle of the block
    (test "a block's braces, after its type and labels"
      (let (src "resource \"a\" \"b\" {\n  x = [1]\n}\n")
        (assert= (both src :hcl (inc (index-of src "{")))
          [(index-of src "{") (string/last-index-of src "}")])
        (assert= (both src :hcl (inc (index-of src "["))) [(index-of src "[") (index-of src "]")])))
    ;; the closer is found among the block's children, however far its opener
    (test "an empty block's braces 6000 characters apart, from either end"
      (let (src (str "resource \"a\" \"b\" {" (string/repeat "\n" 6000) "}\n")
            open (index-of src "{")
            close (string/last-index-of src "}"))
        (is (> (- close open) 4000))
        (assert= (both src :hcl close) [open close])
        (assert= (both src :hcl (inc open)) [open close])))))

(when (grammars/grammar-loaded? :python)
  (describe "python's brackets"
    (test "a dict, a tuple inside a list, and a paren in a string"
      (let (src "d = {\"(\": [x, (1, 2)]}\n")
        (assert= (both src :python 5) [4 21])
        (assert= (both src :python (inc (index-of src "(1")))
          [(index-of src "(1") (index-of src ")]")])
        (is (nil? (both src :python 6)))))))

(when (grammars/grammar-loaded? :bash)
  (describe "the view paints the pair from the held tree"
    (test "the bracket at point and its partner, over the whole document"
      (let (src (str "f() {\n" (string/repeat "  echo hi\n" 600) "}\n")
            buf (goto-char (file-buffer src "big.sh") 5)
            tree (editor/treesit/open-tree (buffer-rope buf) :bash)
            overrides (spanpaint/ed-bracket-overrides buf tree))
        (editor/treesit/free-tree tree)
        ;; the closer is 6000 characters away: past the window the slice path matches in
        (assert= (map overrides first) (list 4 (string/last-index-of src "}")))))))
