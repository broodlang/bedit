;; Outline folding (src/folds.blsp) and org-mode, its first user (src/org-mode.blsp): a
;; fold is a marker on its heading, the mode says what it covers, and the row table gives
;; the lines it hides no rows — so the view, the cursor and the scroll never see them.
(defmodule folds-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use view)
  (:use panes)
  (:use editor/buffer)
  (:use scroll) ; *line-numbers* — relative numbering, bound per test
  (:use-internals folds)) ; hidden-entry / moved-ranges — the hidden set kept across edits

(def org-src
  "* One\nbody of one\n** One.a\nbody of a\n** One.b\nbody of b\n* Two\nbody of two\n")

(defn org-model (text) (ed-init (make-buffer text "notes.org" "notes.org")))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 60 20))))
(defn at-line (m line)
  (ed-set-buf m (goto-char (cur m) (text/line->char (buffer-rope (cur m)) line))))
(defn shown-lines (m)
  "The buffer lines the pane shows, in order (text rows only)."
  (let (pane (first (:panes (ed-body-layout m 60 20)))
        rows (ed-pane-rows pane (cur m)))
    (seq/distinct (map (seq/filter rows (fn (row) (nil? (nth row 3)))) first))))

(describe "org-mode"
  (test "a .org buffer is in org-mode, wrapped like prose"
    (assert= (ed-buf-mode-name (cur (org-model org-src))) "org")
    (assert= (scroll/ed-long-lines (cur (org-model org-src))) :wrap))
  (test "its fold extent is the subtree: to the line before the next heading at its level"
    (let (rope (buffer-rope (make-buffer org-src)))
      (assert= (org-mode/org-fold-extent rope 0) 5)
      (assert= (org-mode/org-fold-extent rope 2) 3)
      (assert= (org-mode/org-fold-extent rope 1) nil)
      ;; the last heading's subtree runs to the last line; a line past the end folds nothing
      (assert= (org-mode/org-fold-extent rope 6) 8)
      (assert= (org-mode/org-fold-extent rope 40) nil))))

(describe "TAB cycles a heading: folded, children, subtree"
  (test "folded hides the whole subtree, and the view shows the next heading after it"
    (let (m (press (org-model org-src) [:tab]))
      (is (includes? (:echo m) "FOLDED"))
      (assert= (folds/hidden-lines (cur m)) #{1 2 3 4 5})
      (assert= (shown-lines m) '(0 6 7 8))))
  (test "children shows the child headings, each folded"
    (let (m (press (org-model org-src) [:tab :tab]))
      (is (includes? (:echo m) "CHILDREN"))
      (assert= (shown-lines m) '(0 1 2 4 6 7 8))))
  (test "subtree shows everything again"
    (let (m (press (org-model org-src) [:tab :tab :tab]))
      (is (includes? (:echo m) "SUBTREE"))
      (assert= (folds/hidden-lines (cur m)) #{})))
  (test "TAB off a heading still indents"
    (let (m (press (at-line (org-model org-src) 1) [:tab]))
      (is (not (includes? (or (:echo m) "") "FOLDED")))))
  (test "S-TAB folds every heading, and again shows everything"
    (let (m (press (org-model org-src) [:back-tab]))
      (assert= (shown-lines m) '(0 6))
      (assert= (shown-lines (press m [:back-tab])) '(0 1 2 3 4 5 6 7 8)))))

(describe "relative line numbers count the lines on screen"
  (test "the lines a fold hides between a line and point are not counted"
    (binding (*line-numbers* :relative)
      ;; One folded (lines 1-5 hidden), point on Two's body (line 7)
      (let (m (press (org-model org-src) [:tab])
            buf (cur (at-line m 7))
            gw (gutter/line-number-width buf)
            number-of (fn (line)
                        (string/trim (first (second (gutter/line-number-cell buf line gw))))))
        (assert= (folds/hidden-between buf 0 7) 5)
        ;; the heading above the fold is two lines up on screen, not seven
        (assert= (map [0 6 8] number-of) (list "2" "1" "1")))))
  (test "a fold inside a folded subtree is counted once"
    (let (m (press (org-model org-src) [:back-tab]))
      (assert= (folds/hidden-between (cur m) 0 6) 5)
      (assert= (folds/hidden-between (cur m) 6 0) 5)
      (assert= (folds/hidden-between (cur m) 2 4) 1))))

(describe "a fold is invisible to the cursor"
  (test "C-n from a folded heading steps over its body to the next heading"
    (let (m (press (org-model org-src) [:tab :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 6)
      (assert= (buffer-current-line (cur (press m [:ctrl-p]))) 0)))
  (test "a fold follows its heading when text is inserted above it"
    (let (m (press (at-line (org-model org-src) 6) [:tab]))
      (assert= (folds/hidden-lines (cur m)) #{7 8})
      (let (typed (press (ed-set-buf m (goto-char (cur m) 0)) [:enter]))
        (assert= (folds/hidden-lines (cur typed)) #{8 9}))))
  (test "point landing inside a fold some other way opens it"
    (let (m (press (org-model org-src) [:tab])
          jumped (press (ed-set-buf m (goto-char (cur m) (index-of org-src "body of a"))) [:ctrl-f]))
      (assert= (folds/hidden-lines (cur jumped)) #{})))
  (test "the folded heading's row ends in a dim …"
    (let (m (press (org-model org-src) [:tab])
          ops (ed-view m 60 20)
          texts (seq/keep ops (fn (op) (when (and (vector? op) (= (first op) :text)) (nth op 3)))))
      (is (any? texts (fn (text) (includes? text "…")))))))

;; The hidden set is kept with the folds it came from and carried across an edit the splice
;; log places outside every fold — no extent asked again — and asked afresh for any other.
(describe "the hidden set across an edit"
  (defn entry-of (m)
    (let (buf (cur m))
      (folds/hidden-entry buf (model/ed-mode-service buf :fold-extent) (folds/folded-lines buf))))
  (defn fresh-ranges (m)
    (let (buf (cur m))
      (folds/ranges-from (buffer-rope buf)
        (model/ed-mode-service buf :fold-extent)
        (folds/folded-lines buf))))
  (defn type-at (m line text)
    (ed-set-buf m (insert (cur (at-line m line)) text)))
  (test "an edit below every fold reuses the set as it stands"
    (let (m (press (org-model org-src) [:tab])
          entry (entry-of m)
          typed (type-at m 7 "more "))
      (assert= (folds/moved-ranges entry (cur typed) (folds/folded-lines (cur typed)))
        [(:ranges entry) false])
      (assert= (folds/hidden-lines (cur typed)) #{1 2 3 4 5})))
  (test "the answer for the text before the edit is found in this process's memo store"
    (let (m (press (org-model org-src) [:tab])
          entry (entry-of m)
          typed (type-at m 7 "more ")
          buf (cur typed)
          carried (folds/carried-entry buf
                    (model/ed-mode-service buf :fold-extent)
                    (folds/folded-lines buf)))
      (assert= (:ranges carried) (:ranges entry))
      (assert= (:rope carried) (buffer-rope buf))))
  (test "an edit above a fold moves it by the lines added, and agrees with asking afresh"
    (let (m (press (at-line (org-model org-src) 6) [:tab])
          entry (entry-of m)
          typed (ed-set-buf m (insert (goto-char (cur m) 0) "* Zero\nz\n"))
          [ranges shifted?] (folds/moved-ranges entry (cur typed) (folds/folded-lines (cur typed))))
      (is shifted?)
      (assert= ranges (fresh-ranges typed))
      (assert= (folds/hidden-lines (cur typed)) #{9 10})))
  (test "an edit inside a fold, or on the line after it, asks the extents again"
    (let (m (press (at-line (org-model org-src) 2) [:tab])
          entry (entry-of m))
      ;; `** One.a` folds line 3; line 4 is the next heading, which ends it
      (is (nil? (folds/moved-ranges entry
                  (cur (type-at m 3 "x"))
                  (folds/folded-lines (cur (type-at m 3 "x"))))))
      (let (demoted (type-at m 4 "*"))
        (is (nil? (folds/moved-ranges entry (cur demoted) (folds/folded-lines (cur demoted)))))
        ;; `*** One.b` is under One.a now: the fold covers it
        (assert= (folds/hidden-lines (cur demoted)) #{3 4 5})))))
