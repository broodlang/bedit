;; The Elixir playground (`src/elixir-playground.blsp`, `src/elixir-sandbox.blsp`) — the
;; second client of `playground-core`, and the first that evaluates something other than
;; Brood.
;;
;; Everything here runs WITHOUT an Elixir session. The eval path is a round trip to a BEAM
;; node, so the tests drive the two halves it sits between directly: what the launcher
;; decides to send (the form split, `parse-state`, the dependency rule) and what a reply
;; becomes once it lands (`elixir-playground-reply` fed a synthetic reply map, shaped
;; exactly as `elixir/bedit_agent.exs` writes it). That is the seam the Brood playground's
;; own suite uses, and it is why a feature built on a subprocess is testable in
;; milliseconds with no window and no VM.
;;
;; The suites that need to PARSE Elixir are gated on the tree-sitter grammar being
;; installed (`~/.config/bedit/grammars/libtree-sitter-elixir.so`), the same way brood's
;; own treesit suite gates on its grammars: without it the editor cannot colour or indent
;; an `.ex` file either, and a red suite on a machine that simply has not installed a
;; grammar is noise.

(defmodule elixir-playground-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use-internals elixir-playground)
  (:use-internals elixir-sandbox)
  (:use session) ; the shared session events every backend emits
  (:use-internals view)) ; ed-eol-note-face — the VOICE a broken form takes, which is the point

(defn m-of (text) (ed-init (make-buffer text)))

(defn payload-of (line)
  "The base64 field of a request line, decoded. `nth` answers `nil | string` and a nil
would decode as a silent empty payload rather than as a failed assertion, so a line with
no fourth field is an error here — which is what a malformed request is."
  (let (parts (string/split line " "))
    (encoding/base64-decode (or (nth parts 3) (error "request line has no payload: " line)))))

(defn grammar? ()
  ;; check-allow :discarded-catch — the error IS the answer to "is the grammar loaded?"
  (check-allow :discarded-catch (try (do (%tree-sitter-kids "" :elixir 0) true) (catch _ false))))

(def elixir-grammar? (grammar?))

;; ---- the wire, which needs no grammar and no Elixir ---------------------------------

(describe "the Elixir agent's wire"
  (test "a request is the verb, the id, the timeout and the source, base64'd"
    (let (line (elixir-sandbox/encode-request 7 2000 {:verb "EVAL" :src "1 + 1"})
          parts (string/split line " "))
      (assert= (first parts) "EVAL")
      (assert= (second parts) "7")
      (assert= (nth parts 2) "2000")
      (assert= (payload-of line) "1 + 1")))

  ;; The whole reason the payload is encoded: an Elixir program is full of the characters a
  ;; space-separated line is framed with. A heredoc alone would have broken a naive framing
  ;; on the first day.
  (test "source with newlines and quotes survives the framing"
    (let (src "defmodule A do\n  @doc \"\"\"\n  hi \"there\"\n  \"\"\"\nend"
          line (elixir-sandbox/encode-request 1 0 {:verb "EVAL" :src src}))
      (is (not (includes? line "\n")))
      (assert= (payload-of line) src)))

  (test "a reply is one JSON object per line, keyed as keywords"
    (let (reply (elixir-sandbox/decode-reply "{\"id\":3,\"ok\":true,\"value\":\"42\"}"))
      (assert= (get reply :id) 3)
      (assert= (get reply :value) "42")))

  ;; `mix` prints its compilation progress on the same stdout the agent answers on, and so
  ;; does anything the evaluated code spawns. The session drops what does not decode, which
  ;; is what lets the agent share a channel with the build that starts it.
  (test "a line that is not a reply decodes to nil rather than raising"
    (is (nil? (elixir-sandbox/decode-reply "Compiling 41 files (.ex)")))
    (is (nil? (elixir-sandbox/decode-reply "")))
    (is (nil? (elixir-sandbox/decode-reply "[1,2,3]"))))

  (test "the ready banner is the protocol's, so the session recognises it"
    (assert= (get (elixir-sandbox/decode-reply "{\"ready\":true}") :ready) true))

  ;; The banner says whether the project's APPLICATION is running, which is the difference
  ;; between a playground where `Repo` works and one where it raises.
  (test "the banner reports the running application, and nil when there is none"
    (assert= (elixir-sandbox/app-started? {:ready true :app "moneyclub"}) "moneyclub")
    (is (nil? (elixir-sandbox/app-started? {:ready true :app nil})))
    (is (nil? (elixir-sandbox/app-started? {:ready true})))
    (is (nil? (elixir-sandbox/app-started? {:ready true :app ""})))))

(describe "starting the agent when the application will not"
  ;; The case a real Phoenix app hit on the first try: `mix run` STARTS the application,
  ;; and an application is entitled to refuse — a pending migration, a database that is
  ;; down, a startup task that raises. Retried identically it fails identically, three
  ;; times, and the session gives up. So the retry is not identical.
  (test "the first attempt starts the application and a later one does not"
    (let (root (temp-dir "bedit-elixir-"))
      (file/mkdir root)
      (file/spit (path/join (or root "") "mix.exs") "defmodule M.MixProject do\nend\n")
      (let ([prog0 args0] (elixir-sandbox/agent-argv root 0)
            [prog1 args1] (elixir-sandbox/agent-argv root 1))
        (assert= prog0 "mix")
        (is (not (includes? (into [] args0) "--no-start")))
        (assert= prog1 "mix")
        ;; still `mix run`, so the project is compiled and your modules are on the code
        ;; path — only the supervision tree is missing
        (is (includes? (into [] args1) "run"))
        (is (includes? (into [] args1) "--no-start")))))

  (test "outside a mix project there is no application to start, on any attempt"
    (let (root (temp-dir "bedit-elixir-"))
      (file/mkdir root)
      (assert= (first (elixir-sandbox/agent-argv root 0)) "elixir")
      (assert= (first (elixir-sandbox/agent-argv root 2)) "elixir"))))

;; What happens on a machine that does not have Elixir, and on one whose Elixir is older
;; than the agent expects. Both are ordinary situations rather than errors, and the only
;; wrong answer to either is a feature that fails three times and calls itself broken.
(describe "an Elixir that is missing, or older than the agent wants"
  (test "a projectless session needs elixir; a mix project needs mix too"
    ;; separate executables, even though they ship together — and the project paths start
    ;; `mix`, not `elixir`. The guard is asserted AGAINST this machine's PATH rather than
    ;; assumed silent: brood's CI runner has no Elixir at all, and a test that presumes its
    ;; author's machine reads as a brood regression there.
    (let (root (temp-dir "bedit-elixir-"))
      (file/mkdir root)
      (let (missing (elixir-sandbox/missing-tool root))
        (if (elixir-sandbox/elixir-available?)
          (is (nil? missing))
          (is (includes? (or missing "") "`elixir`"))))
      (file/spit (path/join (or root "") "mix.exs") "defmodule M.MixProject do\nend\n")
      (let (missing (elixir-sandbox/missing-tool root))
        (cond
          (not (elixir-sandbox/elixir-available?)) (is (includes? (or missing "") "`elixir`"))
          (not (elixir-sandbox/mix-available?)) (is (includes? (or missing "") "`mix`"))
          else (is (nil? missing))))))

  (test "the version comes from the banner — the one that actually ran"
    ;; not from `elixir --version`: `mix` may resolve to a different install, and an asdf
    ;; or mise shim picks a per-project version no PATH lookup here would see
    (assert= (elixir-sandbox/banner-elixir {:ready true :elixir "1.18.2"}) "1.18.2")
    (assert= (elixir-sandbox/banner-otp {:ready true :otp "27"}) "27")
    (is (nil? (elixir-sandbox/banner-elixir {:ready true})))
    (is (nil? (elixir-sandbox/banner-elixir {:ready true :elixir ""}))))

  (test "below the floor is a sentence, not a failure"
    ;; the agent still evaluates — `install_dbg` is rescue-guarded so an older Elixir loses
    ;; the dbg stream rather than the session
    (is (elixir-sandbox/elixir-too-old? {:elixir "1.12.3"}))
    (is (not (elixir-sandbox/elixir-too-old? {:elixir "1.14.0"})))
    (is (not (elixir-sandbox/elixir-too-old? {:elixir "1.18.2"})))
    ;; 1.9 vs 1.14 — compared numerically, not as text, or every 1.9 would read as newer
    (is (elixir-sandbox/elixir-too-old? {:elixir "1.9.4"}))
    ;; an agent that did not say is not evidence that it is old
    (is (not (elixir-sandbox/elixir-too-old? {:ready true})))
    (is (includes? (elixir-sandbox/version-notice {:elixir "1.12.3"}) "1.12.3"))
    (is (nil? (elixir-sandbox/version-notice {:elixir "1.18.2"}))))

  (test "the playground says so when the session that came up is too old"
    (let (m (model/ed-init (editor/buffer/make-buffer "x"))
          ;; the buffer has to be live for the ready fold to say anything at all
          m1 (commands/ed-show-named m "*Elixir Playground*" "" :elixir-playground)
          m2 (elixir-playground/elixir-playground-ready m1 1 {:ready true :elixir "1.12.3"}))
      (is (includes? (:echo m2) "older than bedit expects")))))

(describe "where the Elixir agent is started"
  (test "a directory with mix.exs is a project; one without is a bare session"
    (let (root (temp-dir "bedit-elixir-"))
      (file/mkdir root)
      (is (not (elixir-sandbox/elixir-project? root)))
      (file/spit (path/join (or root "") "mix.exs") "defmodule M.MixProject do\nend\n")
      (is (elixir-sandbox/elixir-project? root))))

  ;; The boot budget is the backend's, and it has to be: a cold `mix run` in a Phoenix
  ;; project compiles the world before the agent prints its first line, where the Brood
  ;; sandbox's child loads an image in under a second.
  (test "the Elixir session asks for far longer to boot than a Brood one"
    (is (> (get elixir-sandbox/*spec* :boot-timeout-ms) 60000))
    (is (> (get elixir-sandbox/*spec* :boot-timeout-ms) sandbox/*sandbox-boot-timeout-ms*)))

  (test "the agent travels inside the editor, not beside it"
    ;; `include-str` spliced the .exs in at compile time — a release bundle carries module
    ;; source and no asset files, so anything else would ship an editor whose Elixir
    ;; playground could not start.
    (is (includes? elixir-sandbox/*agent-source* "defmodule Bedit.Agent"))
    (is (includes? elixir-sandbox/*agent-source* "Bedit.Agent.main(__ENV__)"))))

;; ---- what one reply becomes ------------------------------------------------------------
;; Shaped exactly as the agent writes them — see `elixir/bedit_agent.exs`.

(defn ok-reply (& overrides)
  (merge {:id 1
          :ok true
          :value "42"
          :type "Integer"
          :output ""
          :ms 0
          :spy []
          :procs {:alive 0}}
    (if (empty? overrides) {} (first overrides))))

(describe "an Elixir reply as a note"
  (test "a value carries the term's type as its hint"
    (let (note (elixir-playground/note-of (ok-reply) nil))
      (assert= (:kind note) :info)
      (is (includes? (:text note) "=> 42"))
      ;; the type is the HINT, not part of the answer: it is anchored at the form while the
      ;; answer sits under it, so a type appearing never moves the value
      (assert= (:hint note) ": Integer")))

  (test "a struct names itself, because `%User{}` says more than `Map`"
    (assert= (:hint (elixir-playground/note-of (ok-reply {:type "MyApp.User"}) nil))
      ": MyApp.User"))

  ;; `2 functions` was a poor version of this. The names and arities tell you whether the
  ;; clause you just typed landed where you meant it, and what you can call next.
  (test "a module answers with its name and what it defined"
    (let (note (elixir-playground/note-of
                 (ok-reply {:value "Fac" :type "Fac · f/1, g/2"})
                 nil))
      (is (includes? (:text note) "=> Fac"))
      (assert= (:hint note) ": Fac · f/1, g/2")))

  ;; The per-function type information Elixir actually has: a captured named function
  ;; carries its module, name and arity, and anything compiled to disk — your project, its
  ;; dependencies, the standard library — carries its declared `@spec` too.
  (test "a captured function shows its signature"
    (assert= (:hint (elixir-playground/note-of
                      (ok-reply {:value "&Enum.map/2"
                                 :type "Enum.map(t(), (element() -> any())) :: list()"})
                      nil))
      ": Enum.map(t(), (element() -> any())) :: list()"))

  (test "what it printed rides the note, which is the half a value alone loses"
    (is (includes? (:text (elixir-playground/note-of (ok-reply {:output "hello\n"}) nil))
          "printed: hello")))

  (test "processes left running are reported, and silence when none were"
    (is (includes? (:text (elixir-playground/note-of (ok-reply {:procs {:alive 2}}) nil))
          "2 processes still running"))
    (is (not (includes? (:text (elixir-playground/note-of (ok-reply) nil)) "still running"))))

  (test "a raise is a failure note carrying the exception banner"
    (let (note (elixir-playground/note-of {:id 1 :ok false :error "** (RuntimeError) boom"} nil))
      (assert= (:kind note) :fail)
      (is (:error? note))
      (is (includes? (:text note) "RuntimeError"))))

  ;; The advice has to name the command that restarts THIS session — `liveeval`'s shared
  ;; timeout note points at the Brood sandbox's key, which does nothing here.
  (test "a timeout points at the command that restarts the Elixir session"
    (let (note (elixir-playground/note-of {:id 1 :ok false :timeout true} nil))
      (assert= (:kind note) :fail)
      (is (includes? (:text note) "timed out"))
      (is (includes? (:text note) "elixir-playground-restart")))))

(describe "an Elixir reply as the pane's report"
  (test "the cascade the agent traced reads as calls in and values out"
    (let (body (elixir-playground/report-text
                 (ok-reply {:value "24"
                            :spy [{:kind "call" :fn "Fac.f" :args "4"}
                                   {:kind "call" :fn "Fac.f" :args "3"}
                                   {:kind "return" :value "6"}
                                   {:kind "return" :value "24"}]})
                 nil))
      (is (includes? body "=> 24"))
      (is (includes? body "Fac.f 4"))
      (is (includes? body "= 24"))))

  (test "the type sits beside the value on the report's first line"
    (let (body (elixir-playground/report-text (ok-reply) nil))
      (is (includes? (first (string/split body "\n")) "=> 42"))
      (is (includes? (first (string/split body "\n")) ": Integer"))))

  ;; "traced nothing" and "nothing happened" look identical, and the difference is worth
  ;; exactly one dim line — `liveeval`'s rule, inherited whole.
  (test "an evaluation that traced nothing says so, once"
    (is (includes? (elixir-playground/report-text (ok-reply) nil) liveeval/*untraced-note*)))

  ;; `dbg/2` writes to stdout, so it arrived inside `printed:` — a pipeline's step-by-step
  ;; trace squeezed onto one line of ghost text beside an `IO.puts` it had nothing to do
  ;; with. It is pane material: one line per step, and it answers a different question from
  ;; the cascade (what you ASKED to see, versus everything that happened).
  (test "dbg output is a section of the pane, not part of the note"
    (let (reply (ok-reply {:value "12" :dbg "[1, 2, 3] #=> [1, 2, 3]\n|> Enum.sum() #=> 6"})
          body (elixir-playground/report-text reply nil))
      (is (includes? body "what dbg showed"))
      (is (includes? body "|> Enum.sum() #=> 6"))
      ;; …and it stays out of the ghost text, which has one line to work with
      (is (not (includes? (:text (elixir-playground/note-of reply nil)) "#=>")))))

  (test "a form that called no dbg gets no dbg section"
    (is (not (includes? (elixir-playground/report-text (ok-reply) nil) "what dbg showed")))
    (is (not (includes? (elixir-playground/report-text (ok-reply {:dbg "   "}) nil) "what dbg"))))

  (test "the value line still leads, with its type, above the dbg block"
    (let (lines (string/split (elixir-playground/report-text (ok-reply {:dbg "x #=> 1"}) nil) "\n"))
      (is (includes? (first lines) "=> 42"))
      (is (includes? (first lines) ": Integer")))))

;; ---- the language services ------------------------------------------------------------

(when elixir-grammar?
  (describe "splitting an Elixir buffer into top-level forms"
    (test "each top-level expression is one form"
      (let (text "x = 1\ny = 2\nx + y\n")
        (assert= (count (elixir-playground/forms-of text)) 3)))

    (test "a whole defmodule is one form, however many defs it holds"
      (let (text "defmodule Fac do\n  def f(0), do: 1\n  def f(n), do: n * f(n - 1)\nend\n"
            forms (elixir-playground/forms-of text))
        (assert= (count forms) 1)
        (assert= (string/substring text (:start (first forms)) (:end (first forms)))
          (string/trimr text))))

    ;; A comment evaluated as a form answers `nil`, and `=> nil` stamped on every prose line
    ;; is both wrong and the most visible thing on screen.
    (test "comments are not forms"
      (assert= (count (elixir-playground/forms-of "# just prose\n# more prose\n")) 0)
      (assert= (count (elixir-playground/forms-of "# a note\n1 + 1\n")) 1)))

  (describe "is this Elixir finished?"
    (test "a complete expression is ready to send"
      (assert= (elixir-playground/parse-state "1 + 1") :ok)
      (assert= (elixir-playground/parse-state "defmodule A do\n  def f, do: 1\nend") :ok))

    ;; The rule the whole feature turns on: a form you are still writing is not a mistake.
    ;; tree-sitter-elixir repairs an unclosed `do` with an ERROR node rather than a MISSING
    ;; `end`, so reading the kind alone would put a red ✗ on every `defmodule` the moment
    ;; its first line was typed.
    (test "a half-typed defmodule is incomplete, not an error"
      (assert= (editor/treesit/parse-tag (elixir-playground/parse-state "defmodule Foo do"))
        :incomplete)
      (assert= (editor/treesit/parse-tag (elixir-playground/parse-state "Enum.map([1], fn x ->"))
        :incomplete)
      (assert= (editor/treesit/parse-tag (elixir-playground/parse-state "x = \"unterminated"))
        :incomplete))

    (test "an error with good code after it is an error"
      (assert= (editor/treesit/parse-tag (elixir-playground/parse-state "1 +* 2")) :err))

    (test "blank text is blank, and nothing is sent for it"
      (assert= (elixir-playground/parse-state "   \n  ") :blank)))

  (describe "what an Elixir form defines and uses"
    (test "a defmodule defines its alias"
      (assert= (:defines (elixir-playground/form-deps "defmodule Fac do\n  def f, do: 1\nend"))
        (list "Fac")))

    (test "a top-level assignment defines its name"
      (assert= (:defines (elixir-playground/form-deps "x = 41")) (list "x")))

    ;; Elixir's `=` is a pattern MATCH, so one form binds several names. A rule that only
    ;; looked for a bare name reported that these bound nothing — and a form below using
    ;; `a` was then never re-run, and sat showing the value from before the edit. Under-
    ;; matching here is the one failure this mechanism exists to prevent.
    (test "a destructuring binding defines every name on its left-hand side"
      (assert= (:defines (elixir-playground/form-deps "{a, b} = {1, 2}")) (list "a" "b"))
      (assert= (:defines (elixir-playground/form-deps "[h | t] = [1, 2]")) (list "h" "t"))
      ;; `%{k: v}` over-defines the key as well, which only costs a re-run — the safe way
      ;; to be wrong
      (is (includes? (:defines (elixir-playground/form-deps "%{k: v} = %{k: 1}")) "v")))

    (test "a comparison is not an assignment"
      (assert= (:defines (elixir-playground/form-deps "x == 41")) '())
      (assert= (:defines (elixir-playground/form-deps "a != b")) '())
      (assert= (:defines (elixir-playground/form-deps "x <= 3")) '())
      (assert= (:defines (elixir-playground/form-deps "x >= 3")) '())
      ;; nor is a regex match, nor a map literal's `=>`
      (assert= (:defines (elixir-playground/form-deps "s =~ ~r/x/")) '())
      (assert= (:defines (elixir-playground/form-deps "%{\"a\" => 1}")) '()))

    (test "a form referencing a module depends on it"
      (is (includes? (:references (elixir-playground/form-deps "Fac.f(5)")) "Fac")))

    ;; Without this, `defmodule Fac` naming `Fac` in its own body would make every module
    ;; depend on itself and re-run the whole tail on any edit to any of them.
    (test "a form does not reference what it defines"
      (let (deps (elixir-playground/form-deps "defmodule Fac do\n  def f, do: Fac\nend"))
        (is (not (includes? (:references deps) "Fac")))))

    ;; The edges a name-based scan structurally cannot see: the affected forms name nothing
    ;; that changed, so re-running one of these has to take the whole tail with it.
    (test "import / alias / require / use change what names mean below them"
      (is (elixir-playground/namespace-form? "import Enum"))
      (is (elixir-playground/namespace-form? "alias MyApp.Accounts"))
      (is (elixir-playground/namespace-form? "require Logger"))
      (is (elixir-playground/namespace-form? "use GenServer"))
      (is (not (elixir-playground/namespace-form? "Enum.map([1], & &1)"))))

    ;; `playground-core/launch-plan` falls back to the suffix rule unless the deps line up
    ;; with the forms one-for-one, so this is the difference between re-running the form you
    ;; touched and re-running everything below it.
    (test "deps line up one-for-one with the forms"
      (let (text "defmodule A do\nend\nx = 1\nA.f(x)\n")
        (assert= (count (elixir-playground/deps-of text))
          (count (elixir-playground/forms-of text))))))

  (describe "the launch plan over Elixir"
    ;; The payoff of the dependency rule: editing a module re-runs what calls it, and
    ;; editing a call re-runs nothing else — where the old suffix rule re-ran the tail.
    (defn plan (before after)
      (let (srcs-of (fn (t)
                      (playground-core/form-srcs-in t (elixir-playground/forms-of t)))
            after-srcs (srcs-of after)
            total (count (elixir-playground/forms-of after))
            evaluated (fold (srcs-of before)
                        {}
                        (fn (acc kv)
                          (let ([i src] kv)
                            (assoc acc
                              i {:src src :deps (elixir-playground/form-deps src)}))))
            realigned (playground-core/realign-evaluated after-srcs evaluated total))
        (playground-core/launch-plan elixir-playground/*spec*
          after-srcs
          realigned
          (elixir-playground/deps-of after)
          total)))

    (test "nothing changed, nothing re-sent"
      (assert= (plan "x = 1\ny = 2\n" "x = 1\ny = 2\n") '()))

    (test "editing a call re-runs that form alone"
      (assert= (plan "defmodule A do\nend\nA.f(1)\n" "defmodule A do\nend\nA.f(2)\n") (list 1)))

    ;; The end-to-end shape of the bug the left-hand-side rule fixes: without it this plan
    ;; was `(0)` and the sum below kept showing the old answer.
    (test "editing a destructuring binding re-runs what uses the names it bound"
      (assert= (plan "{a, b} = {1, 2}\na + b\n" "{a, b} = {10, 20}\na + b\n") (list 0 1)))

    (test "editing a module re-runs what calls it"
      (assert= (plan "defmodule A do\n  def f(x), do: x\nend\nA.f(1)\n"
                 "defmodule A do\n  def f(x), do: x * 2\nend\nA.f(1)\n")
        (list 0 1)))

    (test "an import takes the whole tail with it"
      (assert= (plan "import Enum\nmap([1], & &1)\ncount([1])\n"
                 "import List\nmap([1], & &1)\ncount([1])\n")
        (list 0 1 2)))))

;; ---- the model plumbing, which needs neither grammar nor Elixir ------------------------

(describe "the Elixir playground in the model"
  (test "it is a live-eval client, with its own debounce timer"
    (let (timers (map model/*live-eval-clients* :timer))
      (is (includes? timers :elixir-playground-eval))
      ;; its OWN timer: two playgrounds sharing one would have each other's edits arming
      ;; and re-arming a single debounce
      (assert= (count (into #{} timers)) (count timers))))

  (test "it is registered against the Elixir session, not the Brood one"
    (let (client (seq/find sandbox-events/*clients*
                   (fn (c) (includes? (->string (get c :reply)) "elixir"))))
      (is (not (nil? client)))
      (assert= (get client :session) :elixir-sandbox)))

  (test "its buffer and pane are its own"
    (is (not (= elixir-playground/*buffer-name* playground/*buffer-name*)))
    (is (not (= elixir-playground/*spy-buffer-name* playground/*spy-buffer-name*)))
    (is (not (= (get elixir-playground/*spec* :key) (get playground/*spec* :key)))))

  ;; An Elixir session IS a child process, so there is nothing to fall back to when the
  ;; editor is headless — where Brood can evaluate Brood in its own image.
  (test "it declares no in-image path, and the Brood playground does"
    (is (nil? (get elixir-playground/*spec* :in-image)))
    (is (not (nil? (get playground/*spec* :in-image)))))

  (test "a command that cannot start a session says so instead of opening a dead buffer"
    ;; nothing is asserted about WHICH sentence — only that a refusal is a message and not
    ;; an empty buffer with no results and no explanation
    (let (m (m-of ""))
      (is (string? (:echo (elixir-playground/cmd-elixir-playground m :none))))))

  (test "a reply for an id nobody sent leaves the model alone"
    (let (m (m-of ""))
      (assert= (elixir-playground/elixir-playground-reply m {:id 999 :ok true :value "1"} 1) m))))

;; ---- the live round trip -----------------------------------------------------------------
;; One isolated test through the whole stack: `evalsession` supervising a real `os/spawn`ed
;; BEAM node running the agent, the base64 line protocol in both directions, and the four
;; things the playground actually depends on — a value, a captured print, a session that
;; remembers, and the trace cascade the pane paints.
;;
;; Barriers, never sleeps: every step waits on the event it is expecting. Skipped when there
;; is no `elixir` on PATH, because a suite cannot install one.

(defn ep-await-ready ()
  (receive
    ((record session/session-ready {}) :ready)
    (after 60000 :timed-out)))

(defn ep-await-reply (id)
  (receive
    ((record session/session-reply {:reply r}) :when
      (= (get r :id) id)
      r)
    (after 60000 nil)))

(when (elixir-sandbox/elixir-available?)
  (describe "Elixir session live round-trip"
    :isolated (test "spawn → ready → eval → print → session persists → trace → shutdown"
      (let (_ (proc/register :editor (self))
            ;; projectless: a bare `elixir` session starts in under a second, where a mix
            ;; project would compile first. What is under test is the protocol, not mix.
            _ (elixir-sandbox/elixir-start "/tmp"))
        (assert= (ep-await-ready) :ready)
        ;; a value, its type, and what it printed — the three halves of the note
        (elixir-sandbox/elixir-eval 1 "IO.puts(\"out\"); 40 + 2" 10000)
        (let (r (ep-await-reply 1))
          (assert= (get r :ok) true)
          (assert= (get r :value) "42")
          (assert= (get r :type) "Integer")
          (assert= (get r :output) "out\n"))
        ;; the session remembers: a binding from one request serves the next
        (elixir-sandbox/elixir-eval 2 "ep_live = 21" 10000)
        (ep-await-reply 2)
        (elixir-sandbox/elixir-eval 3 "ep_live * 2" 10000)
        (assert= (get (ep-await-reply 3) :value) "42")
        ;; and a module defined in one request is callable in the next — which only works
        ;; because the agent evaluates against the SCRIPT's env and not its own module's
        (elixir-sandbox/elixir-eval 4
          "defmodule EpFac do\n  def f(0), do: 1\n  def f(n), do: n * f(n - 1)\nend"
          10000)
        (assert= (get (ep-await-reply 4) :value) "EpFac")
        ;; the cascade the pane shows: every call and return, for the modules this session
        ;; defined and nothing else
        ;;
        ;; The count is EXACT on purpose. `f(4)` recurses to `f(0)`, so it is five calls
        ;; and five returns, and asserting "at least eight" is what let a real race hide:
        ;; `:erlang.trace/3` returning only means nothing FURTHER will be traced, and the
        ;; messages already emitted are still in flight — so the collector was regularly
        ;; dumping before the last returns arrived, and the cascade just stopped partway.
        ;; The agent waits on `:erlang.trace_delivered/1` now; this is what holds it to it.
        (elixir-sandbox/elixir-eval 5 "EpFac.f(4)" 10000)
        (let (r (ep-await-reply 5))
          (assert= (get r :value) "24")
          (assert= (count (get r :spy)) 10)
          (assert= (count (seq/filter (get r :spy) (fn (e) (= (get e :kind) "call")))) 5)
          (assert= (count (seq/filter (get r :spy) (fn (e) (= (get e :kind) "return")))) 5)
          ;; and it is the SESSION's module being traced, not the whole VM
          (is (every? (seq/filter (get r :spy) (fn (e) (= (get e :kind) "call")))
                (fn (e) (= (get e :fn) "EpFac.f")))))
        ;; a raise is answered, not fatal: the session is still there afterwards
        (elixir-sandbox/elixir-eval 6 "raise \"boom\"" 10000)
        (let (r (ep-await-reply 6))
          (assert= (get r :ok) false)
          (is (includes? (get r :error) "RuntimeError")))
        (elixir-sandbox/elixir-eval 7 "1 + 1" 10000)
        (assert= (get (ep-await-reply 7) :value) "2")
        ;; an evaluation that will not stop is killed in the child and answered
        (elixir-sandbox/elixir-eval 8 ":timer.sleep(30_000)" 500)
        (is (get (ep-await-reply 8) :timeout))
        ;; and the agent survives being asked to do that
        (elixir-sandbox/elixir-eval 9 "3 + 4" 10000)
        (assert= (get (ep-await-reply 9) :value) "7")
        (elixir-sandbox/elixir-shutdown)))))

;; ---- the agent's own hardening ------------------------------------------------------
;; Each of these was found by feeding the agent things a playground buffer can legitimately
;; contain, and each one was wrong.

(when (elixir-sandbox/elixir-available?)
  (describe "the agent under hostile input"
    :isolated (test "capture, tracing and typing all survive what a buffer can contain"
      (let (_ (proc/register :editor (self))
            _ (elixir-sandbox/elixir-start "/tmp")
            _ (receive
                ((record session/session-ready {}) :ready)
                (after 60000 :timed-out))
            ask (fn (id src)
                  (do
                    (elixir-sandbox/elixir-eval id src 15000)
                    (receive
                      ((record session/session-reply {:reply r}) :when
                        (= (get r :id) id)
                        r)
                      (after 30000 nil)))))
        ;; A forged reply line cannot impersonate the protocol: the capture takes it, so it
        ;; is DATA on the real reply rather than a second reply.
        (let (r (ask 1 "IO.puts(~s|{\"id\":1,\"ok\":true,\"value\":\"FORGED\"}|); :real"))
          (assert= (get r :value) ":real")
          (is (includes? (get r :output) "FORGED")))

        ;; BOTH modules of a two-module form are traced. `Code.eval_string` answers with the
        ;; LAST one, so reading the return value tracked `Bee` and not `Ay` — and the
        ;; cascade showed the inner call while silently omitting the outer, which is worse
        ;; than showing nothing.
        (ask 2 "defmodule TAy do\n  def go, do: TBee.go()\nend\ndefmodule TBee do\n  def go, do: :ok\nend")
        (let (r (ask 3 "TAy.go()")
              called (into #{} (seq/keep (get r :spy) (fn (e) (get e :fn)))))
          (is (contains? called "TAy.go"))
          (is (contains? called "TBee.go")))

        ;; …and nothing ELSE is traced. Diffing loaded modules alone caught every module the
        ;; VM lazily loads — `survivor = :yes` pulls in `List.Chars` — so a one-line form's
        ;; cascade opened with protocol implementations instead of the call you asked about.
        (let (r (ask 4 "survivor = :yes"))
          (is (empty? (get r :spy))))

        ;; A process the code spawns keeps working after its evaluation ends. With a capture
        ;; device closed per evaluation, its next `IO.puts` raised `:terminated` and killed
        ;; it — a plain `spawn` in a buffer died 300ms later for a reason having nothing to
        ;; do with the code.
        (ask 5 "spawn(fn -> :timer.sleep(200); IO.puts(\"late\") end); :spawned")
        (let (r (ask 6 ":timer.sleep(600); :alive"))
          (assert= (get r :value) ":alive")
          (is (includes? (get r :output) "late")))

        ;; Every Elixir string is a binary and not every binary is a string.
        (assert= (get (ask 7 "<<0, 1, 2, 255>>") :type) "Binary")
        (assert= (get (ask 8 "\"hi\"") :type) "String")

        ;; dbg on its own stream, and a signature for a captured function
        (let (r (ask 9 "[1, 2] |> Enum.sum() |> dbg()"))
          (assert= (get r :output) "")
          (is (includes? (get r :dbg) "#=>"))
          ;; the `[file:line: context]` header names the agent's temp script — dropped
          (is (not (includes? (get r :dbg) ".exs"))))
        (is (includes? (get (ask 10 "&Enum.map/2") :type) "Enum.map("))
        (assert= (get (ask 11 "fn a, b -> a + b end") :type) "fn/2")
        (let (r (ask 12 "defmodule TShape do\n  def area(r), do: r\n  defp hush, do: :x\n  def uses, do: hush()\nend")
              defs (get r :defs)
              named (fn (nm) (seq/find defs (fn (d) (= (get d :name) nm)))))
          ;; the module's own hint is now just its NAME — the functions have their own lines
          (assert= (get r :type) "TShape")
          ;; …and one entry each, carrying the LINE it was written on inside the form
          (assert= (get (named "area/1") :line) 2)
          (assert= (get (named "uses/0") :line) 4)
          ;; the compiler's inference, with no @spec written anywhere: this is the payload
          (is (includes? (get (named "area/1") :type) "->"))
          ;; inferred through a private call, so the compiler keeps it `dynamic(…)`
          (is (includes? (get (named "uses/0") :type) ":x"))
          ;; a private function has a line but no inferred signature (the checker chunk
          ;; records exports only) — it still says where it landed
          (is (not (nil? (named "hush/0"))))
          (assert= (get (named "hush/0") :private) true)
          (assert= (get (named "hush/0") :type) nil))

        ;; a declared @spec beats the inference — it is what the author meant
        (let (r (ask 14 "defmodule TSpec do\n  @spec twice(integer()) :: integer()\n  def twice(n), do: n * 2\nend")
              d (first (get r :defs)))
          (is (includes? (get d :type) "integer()"))
          (is (includes? (get d :type) "::")))

        ;; and the session is still the same session after all of it
        (assert= (get (ask 13 "survivor") :value) ":yes")
        (elixir-sandbox/elixir-shutdown)))))

;; ---- the warm TEST node, end to end -----------------------------------------------
;; The Brood half of this has a test that drives a real child through the model; this is
;; the Elixir half, which until now was verified only by hand. Gated on `mix`, and slow by
;; nature (the fixture compiles), so it is one test covering the whole chain: boot, the
;; recompile that keeps it honest, a streamed verdict per test, and the summary.
(def elixir-mix? (not (nil? (os/which "mix"))))

(defn ept-fixture (dir)
  (file/mkdir dir)
  (file/mkdir (path/join dir "lib"))
  (file/mkdir (path/join dir "test"))
  (file/spit (path/join dir "mix.exs")
    (str "defmodule Fix.MixProject do\n"
      "  use Mix.Project\n"
      "  def project, do: [app: :fix, version: \"0.1.0\", elixir: \"~> 1.14\", deps: []]\n"
      "  def application, do: []\n" "end\n"))
  (file/spit (path/join dir "lib/fix.ex") "defmodule Fix do\n  def add(a, b), do: a + b\nend\n")
  (file/spit (path/join dir "test/test_helper.exs") "ExUnit.start()\n")
  (file/spit (path/join dir "test/fix_test.exs")
    (str "defmodule FixTest do\n" "  use ExUnit.Case\n"
      "  test \"adds\" do\n    assert Fix.add(1, 2) == 3\n  end\n"
      "  test \"is wrong\" do\n    assert Fix.add(1, 2) == 4\n  end\n" "end\n")))

(defn ept-await (want deadline)
  "Drain this session's events until `want` says one is the awaited event, answering it."
  (letrec (go (fn ()
                (receive
                  (e (if (want e) e (go)))
                  (after (math/max 0 (- deadline (os/now))) nil))))
    (go)))

(defn ept-reply? (e) (= (get e :__id__) :bedit/session/session-reply))

(when elixir-mix?
  (describe "the warm Elixir test node, end to end"
    :isolated (test "it boots, streams a verdict per test, and recompiles a changed lib"
      (let (dir (str "/tmp/bedit-ex-warm-" (:id (proc/info (self)))))
        (ept-fixture dir)
        (elixir-test/elixir-test-start dir (self))
        ;; the banner is the barrier — a request before it queues behind the compile
        (let (ready (ept-await (fn (e) (= (get e :__id__) :bedit/session/session-ready))
                      (+ (os/now) 240000)))
          (is (not (nil? ready)))
          ;; one verdict per test, streamed as chunks rather than held to the end
          (elixir-test/elixir-test-run 1 ["test/fix_test.exs"])
          (letrec (collect (fn (names summary)
                             (if summary
                               [names summary]
                               (let (e (ept-await ept-reply? (+ (os/now) 120000)))
                                 (if (nil? e)
                                   [names nil]
                                   (let (r (get e :reply))
                                     (cond
                                       (get r :more)
                                         (collect (cons (get (get r :test) :name) names) nil)
                                       (get r :ok) (collect names (get r :summary))
                                       else (collect names nil))))))))
            (let ([names summary] (collect '() nil))
              (assert= (get summary :total) 2)
              (assert= (get summary :failed) 1)
              (is (includes? (into [] names) "adds"))
              ;; a fresh node has nothing to pick up
              (assert= (get summary :reloaded) 0)))
          ;; …and the reason a warm node is not a trap: change lib/ and the verdicts SWAP
          (file/spit (path/join dir "lib/fix.ex")
            "defmodule Fix do\n  def add(a, b), do: a + b + 1\nend\n")
          (elixir-test/elixir-test-run 2 ["test/fix_test.exs"])
          (letrec (final (fn ()
                           (let (e (ept-await ept-reply? (+ (os/now) 120000)))
                             (if (nil? e)
                               nil
                               (let (r (get e :reply)) (if (get r :more) (final) (get r :summary)))))))
            (let (summary (final))
              (assert= (get summary :failed) 1) ; still one, but the OTHER one
              (assert= (get summary :reloaded) 1))))
        (elixir-test/elixir-test-shutdown)))))

;; ---- a defmodule's functions are noted at their own `def`s -------------------------
;; The module hint used to read `: Foo · bar/0, zar/0`: every name piled onto the one line
;; none of them is on, clipped at whatever fitted. Each definition knows its line, so its
;; note goes there — with the type the compiler inferred, which is the thing worth the room.
(describe "per-definition notes"
  (defn defmodule-reply ()
    {:ok true
     :value "Foo"
     :type "Foo"
     :defs [{:name "bar/0" :line 2 :type "integer()"}
            {:name "zar/0" :line 6 :type "binary()"}]})

  (test "one INLAY row per function, above the def it describes"
    ;; the signature takes a row of its own; the module's own type stays at its line, where
    ;; it is short enough to sit
    (let (note (elixir-playground/note-of (defmodule-reply) "")
          rows (:inlays note))
      (assert= (:hint note) ": Foo")
      (assert= (count rows) 2)
      (assert= (:offset (first rows)) 1) ; :line 2 is the second line of the form
      (assert= (:text (first rows)) "bar/0 : integer()")
      (assert= (:offset (nth rows 1)) 5)
      (assert= (:text (nth rows 1)) "zar/0 : binary()")))

  (test "a function the compiler could not type still says where it landed"
    (let (note (elixir-playground/note-of
                 (assoc (defmodule-reply) :defs [{:name "hidden/0" :line 3}])
                 "")
          h (first (:inlays note)))
      (assert= (:text h) "hidden/0")
      (assert= (:offset h) 2)))

  (test "a plain expression keeps the single hint at the form"
    ;; the N=1 shape is the old one and must not have moved
    (let (note (elixir-playground/note-of {:ok true :value "42" :type "Integer"} ""))
      (assert= (:hint note) ": Integer")
      (is (empty? (:hints note)))
      (is (empty? (:inlays note)))))

  (test "a reply with no defs falls back to the listing hint"
    ;; a remote eval, or a runtime whose chunks this build cannot read: the agent keeps
    ;; naming the functions in the type, so they are never simply lost
    (let (note (elixir-playground/note-of
                 {:ok true :value "Foo" :type "Foo · bar/0, zar/0"} ""))
      (assert= (:hint note) ": Foo · bar/0, zar/0")
      (is (empty? (:hints note)))
      (is (empty? (:inlays note))))))

;; ---- dbg's steps land against the steps ---------------------------------------------
(describe "dbg steps inline"
  (def pipeline-src "\"foo bar zar\"\n|> String.split()\n|> Enum.join()\n|> dbg()")
  (def pipeline-dbg
    (str "\"foo bar zar\" #=> \"foo bar zar\"\n"
      "|> String.split() #=> [\"foo\", \"bar\", \"zar\"]\n"
      "|> Enum.join() #=> \"foobarzar\""))

  (test "each step's value is placed at the line that produced it"
    (let (hints (elixir-playground/dbg-hints {:dbg pipeline-dbg} pipeline-src))
      (assert= (map hints :offset) (list 0 1 2))
      (assert= (:text (nth hints 1)) "#=> [\"foo\", \"bar\", \"zar\"]")
      (assert= (:text (nth hints 2)) "#=> \"foobarzar\"")))

  (test "a repeated step pairs with its OWN line, not the first match"
    ;; scanning from the top would stack both values on the first `|> Enum.reverse()`
    ;; and leave the second bare
    (let (src "[1, 2]\n|> Enum.reverse()\n|> Enum.reverse()\n|> dbg()"
          dbg (str "[1, 2] #=> [1, 2]\n"
                "|> Enum.reverse() #=> [2, 1]\n"
                "|> Enum.reverse() #=> [1, 2]")
          hints (elixir-playground/dbg-hints {:dbg dbg} src))
      (assert= (map hints :offset) (list 0 1 2))
      (assert= (:text (nth hints 1)) "#=> [2, 1]")))

  (test "a one-line pipeline places nothing rather than guessing"
    ;; every step's source is INSIDE that line and no line equals any of them; a value
    ;; against the wrong step would be worse than one only in the pane
    (is (empty? (elixir-playground/dbg-hints
                  {:dbg pipeline-dbg}
                  "\"foo bar zar\" |> String.split() |> Enum.join() |> dbg()"))))

  (test "a form with no dbg has no step notes"
    (is (empty? (elixir-playground/dbg-hints {:ok true :value "2"} "1 + 1"))))

  (test "the whole note: the type at the form, a value at each step"
    (let (note (elixir-playground/note-of
                 {:ok true :value "\"foobarzar\"" :type "String" :dbg pipeline-dbg}
                 pipeline-src)
          hints (:hints note))
      (assert= (:text (first hints)) ": String") ; the form's own type, at its first line
      (assert= (:offset (nth hints 2)) 1)
      (assert= (:text (nth hints 2)) "#=> [\"foo\", \"bar\", \"zar\"]")))

  (test "the pane still carries the whole block"
    ;; the inline values are the glance; the block is the record, and stays
    (is (includes? (string/join (elixir-playground/dbg-lines {:dbg pipeline-dbg}) "\n")
          "what dbg showed:"))))

(describe "the pane does not contradict itself"
  (test "a dbg block replaces the 'nothing of yours ran' line, not sits above it"
    ;; `String.split` is not a module this session defined, so the spy traced nothing and
    ;; the note was literally true — and read as a flat denial of the steps printed above it
    (let (text (elixir-playground/report-text
                 {:ok true :value "\"foobarzar\"" :type "String" :dbg pipeline-dbg :spy []}
                 pipeline-src))
      (is (includes? text "what dbg showed:"))
      (is (not (includes? text "nothing of yours ran")))))

  (test "without a dbg block the line stays — it answers a real question"
    ;; "traced nothing" and "nothing happened" look identical, and the difference is worth
    ;; one line
    (let (text (elixir-playground/report-text {:ok true :value "2" :type "Integer" :spy []} "1 + 1"))
      (is (includes? text "nothing of yours ran"))))

  (test "a real cascade always wins over both"
    (let (text (elixir-playground/report-text
                 {:ok true :value "3" :dbg pipeline-dbg
                  :spy [{:kind "call" :module "Foo" :function "bar" :arity 0 :depth 0}]}
                 pipeline-src))
      (is (includes? text "traced call"))
      (is (not (includes? text "nothing of yours ran"))))))

;; ---- a form you are still typing is not a verdict ----------------------------------
(describe "broken forms read as pending, and are counted on the bar"
  (test "a syntax error takes the pending voice, never the failure colour"
    ;; red is for code that RAN and failed. `def foo(x, "foo") do` is unparseable at
    ;; `def foo(`, at `def foo(x,` and at `def foo(x, "foo"` — a verdict at each of those
    ;; is a verdict about typing
    (let (note (liveeval/syntax-error-note "missing ')'"))
      (assert= (:kind note) :broken)
      (assert= (results/note-glyph note) "✗") ; it still says this will not run…
      ;; the same voice as "still evaluating" — dim and italic — and NOT the verdict colour
      (assert= (view/ed-eol-note-face :broken false) (view/ed-eol-note-face :running false))
      (is (not (= (view/ed-eol-note-face :broken false) (view/ed-eol-note-face :fail false))))))

  (test "the margin mark is dimmed too, not red"
    (let (b (results/set-note (make-buffer "x\n") 0 (liveeval/syntax-error-note "boom") 0))
      (assert= (modes/gutter-mark-for b 0) ["✗" modes/gutter-face-test-stale])))

  (test "a RAISE is still red — it ran, and it failed"
    (let (note (elixir-playground/note-of {:ok false :error "** (ArithmeticError)"} ""))
      (assert= (:kind note) :fail)
      ;; …and a raise keeps the colour a verdict is owed
      (is (not (= (view/ed-eol-note-face :fail false) (view/ed-eol-note-face :running false))))))

  (test "the count goes on the mode line instead"
    (let (b (results/set-note (make-buffer "one\ntwo\n") 0 (liveeval/syntax-error-note "boom") 0)
          b2 (results/set-note b 1 (liveeval/running-note) 1))
      (assert= (playground-core/broken-count b2) 2)
      (assert= (playground-core/modeline {} b2) "2 forms not ready")
      (assert= (playground-core/modeline {} (make-buffer "x\n")) ""))))

(describe "a compile failure is not a verdict either"
  ;; Elixir raises CompileError INSTEAD of running your code, so the same rule applies as
  ;; for a syntax error found locally: red is for code that RAN and failed.
  (test "a CompileError is broken, and its banner is dropped"
    ;; `** (CompileError) /tmp/bedit-elixir-agent-5d60b4d9.exs: cannot compile file (errors
    ;; have been logged)` is a path into the agent's own scratch file and a sentence saying
    ;; the real errors went somewhere else — pure noise at full width beside your code
    (let (note (elixir-playground/note-of
                 {:ok false :error "** (CompileError) /tmp/bedit-elixir-agent-5d60b4d9.exs: cannot compile file (errors have been logged)"}
                 ""))
      (assert= (:kind note) :broken)
      (assert= (:text note) "does not compile")
      (is (not (includes? (:text note) "/tmp")))))

  (test "every shape Elixir uses for \"it did not compile\" counts"
    (doseq (name ["CompileError" "SyntaxError" "TokenMissingError" "MismatchedDelimiterError"])
      (is (elixir-playground/compile-failure? (str "** (" name ") boom")))))

  (test "a runtime raise keeps its banner AND its colour"
    (let (note (elixir-playground/note-of
                 {:ok false :error "** (ArithmeticError) bad argument in arithmetic expression"}
                 ""))
      (assert= (:kind note) :fail)
      (is (includes? (:text note) "ArithmeticError"))))

  (test "a timeout is still a verdict — it RAN, and did not stop"
    (let (note (elixir-playground/note-of {:ok false :timeout true} ""))
      (assert= (:kind note) :fail)
      (is (includes? (:text note) "elixir-playground-restart"))))
)
