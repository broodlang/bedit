;; visual-line-mode: a long line shows on as many rows as it needs (src/wrap.blsp — the
;; break rule; panes — the row table every row↔line question reads; view — the rows
;; painted, the cursor and bands on them; model — the scroll clamp counting rows).
(defmodule wrap-test
  (:use testkit :only [press m-of cur]) ; the shared test helpers (tests/support)
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use model)
  (:use input)
  (:use view)
  (:use panes)
  (:use window-commands)
  (:use commands)
  (:use wrap)
  (:use editor/buffer)
  (:use test))

(defn wrapped (text)
  "A model on `text` with visual-line-mode on."
  (cmd-visual-line-mode (m-of text) nil))
(defn line-texts (ops)
  (map (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text)))) (fn (op) (nth op 3))))

(describe "wrap/segments — the break rule"
  (test "a line that fits is one segment; an empty line one empty segment"
    (assert= (segments "fits" 10) [[0 4]])
    (assert= (segments "" 10) [[0 0]])
    (assert= (segments "no width, no wrapping" 0) [[0 21]]))
  (test "breaks fall after the last space that fits, the row keeping the space"
    (assert= (segments "the quick brown fox jumps over the lazy dog" 10)
      [[0 10] [10 20] [20 26] [26 35] [35 43]]))
  (test "a word longer than the row breaks mid-word, never stalling"
    (assert= (segments "abcdefghijklmnop" 5) [[0 5] [5 10] [10 15] [15 16]]))
  (test "widths are display cells: a tab spans to the line's stop, a wide glyph two"
    ;; a + 7-cell tab = 8 and b fits (9), but bcd does not: the row breaks after the tab
    (assert= (segments "a\tbcd" 9) [[0 2] [2 5]])
    (assert= (segments "😀😀😀" 4) [[0 2] [2 3]]))
  (test "CJK text breaks between its characters, never before closing punctuation"
    ;; two cells a character: 日本語の is 8, so a row of 9 takes four and a row of 7 three
    (assert= (segments "日本語のテキスト" 9) [[0 4] [4 8]])
    ;; 「テ fits in 7 cells but 」 may not start a row, so the break comes before テ
    (assert= (segments "日本語の「テ」です" 7) [[0 3] [3 4] [4 7] [7 9]]))
  (test "a hyphen is a break: the word before it keeps the hyphen"
    (assert= (segments "well-known words" 8) [[0 5] [5 11] [11 16]]))
  (test "a long mixed line: the rows tile it, each fits, and each breaks after a space"
    ;; tabs, wide glyphs and long words mixed through a paragraph — every row is measured
    ;; at the column it starts on, the way the view paints it
    (let (line (string/join (map (range 60)
                              (fn (i)
                                (case (math/mod i 4) 0 "word" 1 "\tx" 2 "😀😀" "longerwordthanmost")))
                 " ")
          w 24
          segs (segments line w))
      (assert= (first (first segs)) 0)
      (assert= (second (last segs)) (string/length line))
      (is (every? (seq/zip (seq/drop-last segs 1) (rest segs))
            (fn ([a b]) (= (second a) (first b)))))
      (is (every? segs
            (fn ([from to])
              (<= (string/display-width (string/substring line from to)
                    (string/display-width (string/substring line 0 from)))
                w))))
      (is (every? (seq/drop-last segs 1)
            (fn ([from to]) (string/ends-with? (string/substring line from to) " "))))))
  (test "row-of finds the segment holding a column; the end sits on the last row"
    (let (segs (segments "the quick brown fox" 10))
      (assert= (row-of segs 0) 0)
      (assert= (row-of segs 9) 0)
      (assert= (row-of segs 10) 1)
      (assert= (row-of segs 19) 1)
      (assert= (row-of (list [0 0]) 0) 0)))
  (test "rows-from lays lines out row by row, stopping at the limit"
    (let (buf (make-buffer "short\nthe quick brown fox\nx\n"))
      (assert= (rows-from buf 0 10 10)
        ;; the 4th field is the INLAY text — nil for a row of the buffer's own text
        [[0 0 5 nil] [1 0 10 nil] [1 10 19 nil] [2 0 1 nil] [3 0 0 nil]])
      (assert= (rows-from buf 1 10 2) [[1 0 10 nil] [1 10 19 nil]])
      (assert= (row-count buf 0 3 10) 4))))

(describe "a wrapped pane paints, places the cursor, and maps a click by the same rows"
  (def long-line "the quick brown fox jumps over the lazy dog")
  (test "visual-line-mode toggles per buffer and says so in the echo area"
    (let (m (wrapped "x"))
      (assert= (ed-long-lines (cur m)) :wrap)
      (is (includes? (:echo m) "wrap"))
      (assert= (ed-long-lines (cur (cmd-visual-line-mode m nil))) :scroll)))
  (test "the view paints one row per segment, the gutter number only on the first"
    ;; 28 cols: gutter 4 (the mark column, 2 digits, a space), scrollbar 1 → 23 text cells
    (let (m (wrapped (str long-line "\nnext"))
          ops (ed-view m 28 6)
          texts (line-texts ops))
      (is (any? texts (fn (t) (= t "the quick brown fox "))))
      (is (any? texts (fn (t) (= t "jumps over the lazy dog"))))
      (is (any? texts (fn (t) (= t "next"))))
      ;; line numbers: 1 on the first row, 2 on the third — nothing on the continuation
      (let (rows (seq/filter ops
                   (fn (op)
                     (and (vector? op) (= (first op) :text) (= (string/trim (nth op 3)) "2")))))
        (assert= (nth (first rows) 1) 2))))
  (test "a row the line goes on past ends in ↩, the row continuing it starts with ↪"
    ;; Emacs's fringe arrows: ↩ just past the text (the scrollbar column), ↪ where the number
    ;; would be
    (let (m (wrapped (str long-line "\nnext"))
          ops (ed-view m 30 6)
          at (fn (glyph)
               (map (seq/filter ops
                      (fn (op) (and (vector? op) (= (first op) :text) (includes? (nth op 3) glyph))))
                 (fn (op) [(nth op 1) (nth op 2)]))))
      ;; one wrapped line on rows 0-1: only row 0 continues; `next` on row 2 fits
      (assert= (map (at wrap/continuation-mark) first) (list 0))
      (assert= (map (at wrap/continued-mark) first) (list 1))
      ;; the arrow takes the column PAST the text area, the pane's last
      (let ([_ col] (first (at wrap/continuation-mark))
            text-start (nth (first (at "the quick")) 1))
        (is (> col text-start))
        (assert= col 29))))
  (test "a file buffer whose lines carry change bars still paints ↪ (the bar is one column)"
    ;; the ↪ cell is sized from a gutter cell, whose first chunk in a file buffer can be a
    ;; `[:bar colour]` change bar — measuring it as text raised, and every frame was the
    ;; render-error frame
    (let (buf (editor/buffer/annotate (make-buffer (str long-line "\nnext") "w.txt" "/tmp/w.txt")
                :vcs-line-status {0 :modified})
          m (cmd-visual-line-mode (ed-init buf) nil)
          texts (line-texts (ed-view m 28 6)))
      (is (not (any? texts (fn (t) (includes? t "render error")))))
      (is (any? texts (fn (t) (includes? t wrap/continued-mark))))))
  (test "the cursor sits on the continuation row, at the column within that row"
    (let (m (wrapped long-line)
          m2 (ed-set-buf m (goto-char (cur m) 25)) ; "j" of jumps: row 1, col 5
          ops (ed-view m2 28 6)
          c (seq/find ops (fn (op) (and (vector? op) (= (first op) :cursor)))))
      (assert= (nth c 1) 1) ; row 1
      (assert= (nth c 2) (+ 4 5)))) ; gutter + 5
  (test "a click on a continuation row lands in that row's slice of the line"
    (let (m (wrapped long-line)
          pane (first (:panes (ed-body-layout m 28 6))))
      (assert= (ed-pane-line-at pane (cur m) 1) 0) ; row 1 is still line 0
      (assert= (ed-pane-row-hscroll pane (cur m) 1) 20) ; …its second segment
      (assert= (ed-pane-line-at pane (cur m) 2) nil) ; nothing below the one line
      ;; the press: row 1, screen col 4+5 → offset 25
      (let (m2 (ed-update m [:mouse :press :left 1 9 [] 1] 28 6))
        (assert= (buffer-point (cur m2)) 25))))
  (test "no sideways scroll while wrapping: point at the line's end keeps hscroll 0"
    (let (m (press (wrapped long-line) [:alt->]))
      (assert= (ed-current-hscroll m) 0))))

(describe "the scroll clamp counts rows for a wrapped buffer"
  (test "moving point onto a line whose rows overflow the pane raises the top enough"
    ;; 4 text rows (rows=6: 4 text + mode line + echo); three long lines of 2 rows each
    (let (ll "the quick brown fox jumps over the lazy dog"
          m (wrapped (str ll "\n" ll "\n" ll "\nend"))
          at-end (ed-update m :alt-> 30 6))
      ; M->: end of buffer, then the clamp
      ;; unwrapped arithmetic would leave top at 0 (4 lines fit in 4 rows); wrapped, line
      ;; 3 is row 6 — the top must move so it is on screen
      (is (> (ed-current-top at-end) 0))
      (let (pane (first (:panes (ed-body-layout at-end 30 6)))
            rows (ed-pane-rows pane (cur at-end)))
        (is (any? rows (fn ([line _f _t _inlay]) (= line 3))))))))

;; ---- inlay rows: a screen row that is not buffer text -------------------------------
;; A type signature against an already-indented `def` has a couple of dozen columns to live
;; in, so the half that identifies the function is the half that gets cut. Above the `def`,
;; on a row of its own, it has the whole width — which is where a signature goes in every
;; language that writes one down. The row has to be IN the table: every row↔line question
;; in the editor reads it, and a row drawn "between" two others without being in it is one
;; the cursor walks through and the scroll clamp cannot see.
(describe "inlay rows sit in the row table, above the line they describe"
  ;; the store is keyed by OWNER — `{owner-key -> [{:line :text} …]}` — so one producer
  ;; rebuilding its rows leaves a sibling's alone; `wrap/inlay-lines` flattens it
  (defn inlaid (text rows) (annotate (make-buffer text) :inlay-lines {:owner rows}))

  (test "an inlay row comes before its line's text rows"
    (let (buf (make-buffer "one\ntwo\nthree\n"))
      (assert= (rows-from buf 0 20 10 {1 ["two/0 : integer()"]})
        [[0 0 3 nil] [1 0 nil "two/0 : integer()"] [1 0 3 nil] [2 0 5 nil] [3 0 0 nil]])))

  (test "several inlays on one line keep their order"
    (let (buf (make-buffer "a\nb\n"))
      (assert= (map (rows-from buf 0 20 10 {0 ["first" "second"]}) (fn (r) (nth r 3)))
        (list "first" "second" nil nil nil))))

  (test "no inlays is the table it always was"
    (let (buf (make-buffer "a\nb\n"))
      (assert= (rows-from buf 0 20 10) (rows-from buf 0 20 10 {}))))

  (test "the limit counts inlay rows — a pane shows as many rows as it has"
    (let (buf (make-buffer "a\nb\nc\n"))
      (assert= (count (rows-from buf 0 20 3 {0 ["x" "y"]})) 3)))

  (test "row-count sees them, or the scroll clamp is short by exactly that many"
    (let (buf (make-buffer "a\nb\nc\n"))
      (assert= (row-count buf 0 3 20) 3)
      (assert= (row-count buf 0 3 20 {1 ["sig"]}) 4)
      (assert= (row-count buf 0 3 20 {0 ["a"] 2 ["b" "c"]}) 6)))

  (test "a pane builds a table for inlays even when the buffer does not wrap"
    ;; the two are the same fact: the pane's rows are no longer one per line, from the top
    (let (plain (m-of "a\nb\nc\n")
          with-inlay (ed-set-buf plain
                       (annotate (cur plain) :inlay-lines {:owner [{:line 1 :text "sig"}]}))
          pane (fn (mm) (first (:panes (ed-body-layout mm 40 10)))))
      (is (nil? (ed-pane-rows (pane plain) (cur plain))))
      (is (not (nil? (ed-pane-rows (pane with-inlay) (cur with-inlay)))))))

  (test "an inlay row is NOT one of its line's text rows"
    ;; `ed-rows-line-rows` answers \"which rows does this line's text occupy?\" — a caller
    ;; that got the inlay too would fill a region through a signature, or put the cursor on
    ;; a row that has no columns to be at
    (let (rows (rows-from (make-buffer "a\nb\n") 0 20 10 {1 ["sig"]}))
      (assert= (count (ed-rows-line-rows rows 0 1 0)) 1)
      (assert= (second (first (ed-rows-line-rows rows 0 1 0))) 0)))

  (test "a click on an inlay row lands on the line it describes"
    (let (rows (rows-from (make-buffer "a\nb\n") 0 20 10 {1 ["sig"]}))
      ;; row 1 is the inlay; it belongs to line 1
      (assert= (first (nth rows 1)) 1)
      (assert= (nth (nth rows 1) 3) "sig"))))

(describe "a malformed inlay store costs a row, not the window"
  ;; An annotation is DATA, and this is read while painting a frame. The cost of raising
  ;; here is the whole window — every subsequent frame — for one bad entry.
  (test "entries that are not {:line :text} are skipped"
    (let (buf (annotate (make-buffer "a\nb\n")
                :inlay-lines {:owner ["a bare string" {:line 1 :text "good"} {:no :line}]}))
      (assert= (wrap/inlay-lines buf) {1 ["good"]})))

  (test "a store that is not even a map of lists answers empty"
    (is (empty? (wrap/inlay-lines (annotate (make-buffer "a\n") :inlay-lines {:owner "nope"}))))))

(describe "an inlay row is painted where the table puts it"
  ;; The model tests above say the ROW is in the table. This says the frame actually has
  ;; it, above the line it describes and in the hint voice — the half no row-table
  ;; assertion can reach.
  (defn text-ops (frame)
    (seq/keep frame
      (fn (op) (when (and (vector? op) (= (first op) :text)) [(nth op 1) (nth op 2) (nth op 3)]))))
  (defn at-col (frame col)
    (seq/keep (text-ops frame) (fn ([row c t]) (when (= c col) [row t]))))

  (test "the signature takes the row above its def, and the def moves down one"
    (let (src "defmodule Foo do\n  def bar(x) do\n    x + 1\n  end\nend\n"
          m0 (m-of src)
          buf (eolnotes/set-note (cur m0)
                0
                {:kind :info
                 :text "=> Foo"
                 :hint ": Foo"
                 :inlays [{:line 1 :text "bar/1 : (integer()) -> integer()"}]}
                5
                0)
          frame (ed-view (ed-set-buf m0 buf) 60 12)
          body (at-col frame 4))
      (assert= (nth body 0) [0 "defmodule Foo do"])
      (assert= (nth body 1) [1 "  bar/1 : (integer()) -> integer()"])
      (assert= (nth body 2) [2 "  def bar(x) do"])))

  (test "an inlay row gets no line number — it is not a line of the buffer"
    (let (m0 (m-of "a\nb\nc\n")
          buf (eolnotes/set-note (cur m0)
                0
                {:kind :info :text "x" :inlays [{:line 1 :text "sig"}]}
                2
                0)
          frame (ed-view (ed-set-buf m0 buf) 40 10)
          numbers (map (seq/filter (at-col frame 1) (fn ([_row t]) (includes? t "2"))) first))
      ;; line 2's number is on row 2, not row 1 — the inlay took row 1
      (assert= numbers (list 2))))

  (test "the inlay is painted in the hint voice, never as code"
    (let (m0 (m-of "a\nb\n")
          buf (eolnotes/set-note (cur m0)
                0
                {:kind :info :text "x" :inlays [{:line 1 :text "sig"}]}
                1
                0)
          frame (ed-view (ed-set-buf m0 buf) 40 10)
          op (seq/find frame
               (fn (o) (and (vector? o) (= (first o) :text) (includes? (str (nth o 3 "")) "sig")))))
      (is (:italic (nth op 4 {}))))))

;; issues.md C8: the scroll clamp, the pane's row table and the point-follows-view step
;; each decided for themselves whether a pane's rows were one per line. The last one did
;; not count inlays, so a cursor step after a wheel scroll put point on a line that the
;; inlays above had pushed off the bottom — and the view jumped to find it.
(describe "a cursor step after scrolling away lands on a line that is on screen"
  (defn resumed (inlays)
    "Twenty short lines, point at the end, the view wheeled back to the top, then C-f:
the line point resumes on."
    (let (m (ed-update (m-of (string/join (map (range 20) (fn (i) (str "l" i))) "\n")) :alt-> 30 12)
          with-inlays (ed-set-buf m (annotate (cur m) :inlay-lines {:owner inlays}))
          at-top (ed-set-top with-inlays 0))
      (buffer-current-line (cur (ed-update at-top :ctrl-f 30 12)))))
  (test "three inlay rows at the top leave three fewer lines to resume on"
    (assert= (resumed [{:line 1 :text "a"} {:line 2 :text "b"} {:line 3 :text "c"}])
      (- (resumed []) 3))))

;; ROADMAP I.4: in a wrapped buffer C-n / C-p move by screen row, as Emacs does, and both
;; keep a goal column across a row or line too short to hold it.
(describe "C-n / C-p by screen row (line-move-visual) and the goal column"
  (defn at-cols (m keys cols)
    (fold keys m (fn (acc k) (ed-update acc k cols 12))))
  (def motion-line "the quick brown fox jumps over the lazy dog and keeps on running far away")
  (test "C-n in a wrapped line goes to its next row, at the same column of the row"
    (let (m (at-cols (wrapped (str motion-line "\nnext")) [:ctrl-f :ctrl-f :ctrl-n] 30)
          segs (segments motion-line (:view-cols m)))
      (is (> (count segs) 2))
      (assert= (buffer-current-line (cur m)) 0)
      (let ([second-row-from _] (nth segs 1))
        (assert= (buffer-point (cur m)) (+ second-row-from 2)))))
  (test "C-p from a line's first row lands on the LAST row of the line above"
    (let (m (at-cols (wrapped (str motion-line "\nnext"))
              [:ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-a :ctrl-p]
              30)
          segs (segments motion-line (:view-cols m)))
      (assert= (buffer-current-line (cur m)) 0)
      (assert= (buffer-point (cur m)) (first (last segs)))))
  (test "a buffer that does not wrap still moves by line"
    (let (m (at-cols (m-of (str motion-line "\nnext")) [:ctrl-n] 30))
      (assert= (buffer-current-line (cur m)) 1)))
  (test "a short line in between does not lose the column"
    (let (m (at-cols (m-of "abcdef\nx\nabcdef") [:ctrl-e :ctrl-b :ctrl-b :ctrl-n :ctrl-n] 80))
      (assert= (buffer-current-line (cur m)) 2)
      (assert= (buffer-column (cur m)) 4)))
  (test "and the goal is forgotten once point is moved some other way"
    (let (m (at-cols (m-of "abcdef\nx\nabcdef\nabcdef") [:ctrl-e :ctrl-n :ctrl-a :ctrl-n] 80))
      (assert= (buffer-column (cur m)) 0)))
  (test "C-u 3 C-n keeps the goal through every step"
    (let (m (at-cols (m-of "abcdef\nx\ny\nabcdef") [:ctrl-e :ctrl-u "3" :ctrl-n] 80))
      (assert= (buffer-current-line (cur m)) 3)
      (assert= (buffer-column (cur m)) 6))))

;; ---- long lines: truncated with an ellipsis, per buffer and per line -------------------
;; A *git-status* lists commits and stashes whose subjects run past the pane; wrapped, each
;; took two rows and the list stopped reading as a list. A heading keeps to ONE row ending in
;; `…` while a hunk's code in the same buffer still wraps — the line's KIND decides, which a
;; section buffer marks (`sectionbuf/row-kinds`), and the user's `:long-lines` setting maps.
(describe "long lines truncate to one row with an ellipsis"
  (def commit-row
    "546d08ae 2026.10.21.11 Docs: the help menu lists shortcuts only in chat, and the account dialog is the layout's")
  (def hunk-row "+ the quick brown fox jumps over the lazy dog and keeps on running")

  (defn section-model (&optional (policies {}))
    "A model on a section buffer of one commit heading and one hunk line under it, with the
line kinds a section buffer marks — the shape of *git-status*'s Recent commits."
    (let (rendered (section/section-render (section/section :root
                                             nil
                                             nil
                                             [(section/section :commit "c" commit-row [hunk-row])]))
          text (string/join (:lines rendered) "\n"))
      (ed-init (assoc (make-buffer text) :line-kinds (sectionbuf/row-kinds (:rows rendered))))))

  (defn texts-on-row (ops row)
    "`[x text]` of each text op on screen `row` right of the gutter (4 columns)."
    (vec (map (seq/filter ops
                (fn (op)
                  (and (vector? op) (= (first op) :text) (= (nth op 1) row) (>= (nth op 2) 4))))
           (fn (op) [(nth op 2) (nth op 3)]))))

  (test "one-row: the chars that fit the cells the ellipsis leaves, the clip beside them"
    (assert= (one-row "abcdefgh" 0 5 "…") [0 8 [4 "…"]])
    (assert= (one-row "abc" 0 5 "…") [0 3])
    ;; scrolled sideways to cell 4, the rest fits
    (assert= (one-row "abcdefgh" 4 5 "…") [4 8]))

  (test "a wide glyph at the cut is never halved: it goes whole to the hidden part"
    ;; "ab日本cd" at 4 cells: 3 cells for text — `ab` and half of 日 — so the cut is before 日
    (assert= (one-row "ab日本cd" 0 4 "…") [0 6 [2 "…"]])
    (let (buf (assoc (make-buffer "ab日本cdef") :long-lines :truncate)
          m (ed-init buf)
          ops (ed-view m 9 4))
      ; 9 cols: gutter 4, scrollbar 1 → 4 text cells
      (assert= (texts-on-row ops 0) [[4 "ab"] [7 "…"]])))

  (test "the ellipsis is the setting's"
    (binding (*truncation-ellipsis* "$")
      (let (m (ed-init (assoc (make-buffer "abcdefghijklmnop") :long-lines :truncate))
            row (texts-on-row (ed-view m 9 4) 0))
        (assert= (last row) [7 "$"]))))

  (test "a section heading ends in … on ONE row; the hunk line under it still wraps"
    ;; 28 cols: gutter 4, scrollbar 1 → 23 text cells: 22 of the subject, then `…`
    (let (m (section-model)
          buf (cur m)
          pane (first (:panes (ed-body-layout m 28 8)))
          rows (ed-pane-rows pane buf)
          ops (ed-view m 28 8))
      (assert= (ed-long-lines buf 0) :truncate)
      (assert= (ed-long-lines buf 1) :wrap)
      (assert= (count (seq/filter rows (fn (row) (= (first row) 0)))) 1)
      (is (> (count (seq/filter rows (fn (row) (= (first row) 1)))) 1))
      (assert= (texts-on-row ops 0) [[4 (string/substring commit-row 0 22)] [26 "…"]])
      ;; the hunk's second row continues its text, unmarked
      (is (every? (texts-on-row ops 2) (fn (t) (not (= (second t) "…")))))))

  (test "the row table and the scroll clamp count a truncated line as one row"
    (let (long (string/join (map (range 8) (fn (_) commit-row)) "\n")
          m (ed-init (assoc (make-buffer long) :long-lines :truncate))
          buf (cur m))
      (assert= (row-count buf 0 8 23 (ed-row-extras buf)) 8)
      ;; 6 rows: 4 text rows; M-> to line 7 puts the top at 4, as it would for short lines
      (assert= (ed-current-top (ed-update m :alt-> 30 6)) 4)))

  (test "the mode's setting overrides its facet; the buffer's toggle overrides the setting"
    (let (m (ed-init (make-buffer "# notes\n" "a.md" "a.md"))
          buf (cur m))
      (assert= (ed-long-lines buf) :wrap) ; markdown's facet
      (binding (*long-lines* (merge *long-lines-defaults* {'markdown :truncate}))
        (assert= (ed-long-lines buf) :truncate)
        (assert= (ed-long-lines (assoc buf :long-lines :scroll)) :scroll))))

  (test "code scrolls under a default of :wrap; prose takes the default"
    ;; the `prog` layer under every code mode says :scroll, and a mode's facet beats the
    ;; setting's :default. A .blsp buffer wrapped before
    (binding (*long-lines* (merge *long-lines-defaults* {:default :wrap}))
      (assert= (ed-long-lines (cur (ed-init (make-buffer "(def x 1)\n" "a.blsp" "a.blsp"))))
        :scroll)
      (assert= (ed-long-lines (cur (ed-init (make-buffer "notes\n" "a.txt" "a.txt")))) :wrap)))

  (test "a setting for a layer reaches every mode stacked over it; the mode's own wins"
    (let (code (cur (ed-init (make-buffer "(def x 1)\n" "a.blsp" "a.blsp"))))
      (binding (*long-lines* (merge *long-lines-defaults* {'prog :wrap}))
        (assert= (ed-long-lines code) :wrap))
      (binding (*long-lines* (merge *long-lines-defaults* {'prog :wrap 'brood :truncate}))
        (assert= (ed-long-lines code) :truncate))))

  (test "a wrapping buffer says nothing on its mode line; visual-line-mode turns the config's wrap off"
    (binding (*long-lines* (merge *long-lines-defaults* {:default :wrap}))
      (let (m (ed-init (make-buffer "notes\n" "a.txt" "a.txt"))
            texts (map (seq/filter (ed-view m 80 24)
                         (fn (op) (and (vector? op) (= (first op) :text))))
                    (fn (op) (str (nth op 3 nil)))))
        (assert= (ed-long-lines (cur m)) :wrap)
        (is (not (any? texts (fn (text) (includes? text "Wrap")))))
        (let (off (cmd-visual-line-mode m nil))
          (assert= (ed-long-lines (cur off)) :scroll)
          (assert= (:echo off) "visual-line-mode off: long lines scroll")))))

  (test "a mode's setting reaches every line of it, its kinds included"
    (binding (*long-lines* (merge *long-lines-defaults* {:section-heading :wrap}))
      (assert= (ed-long-lines (cur (section-model)) 0) :wrap)))

  (test "M-x toggle-truncate-lines flips the buffer, and back to what it had"
    (let (m (ed-init (make-buffer "# notes\n" "a.md" "a.md"))
          on (cmd-toggle-truncate-lines m nil)
          off (cmd-toggle-truncate-lines on nil))
      (assert= (ed-long-lines (cur on)) :truncate)
      (is (includes? (:echo on) "…"))
      (assert= (ed-long-lines (cur off)) :wrap)
      ;; a plain buffer scrolls by default: off again is scrolling, not a no-op
      (let (plain (cmd-toggle-truncate-lines (m-of "x") nil))
        (assert= (ed-long-lines (cur plain)) :truncate)
        (assert= (ed-long-lines (cur (cmd-toggle-truncate-lines plain nil))) :scroll))))

  (test "point past the cut shows that line from where point is, and the cursor on it"
    (let (m (ed-init (assoc (make-buffer (str commit-row "\nshort")) :long-lines :truncate))
          at-end (ed-update m :ctrl-e 30 6)
          pane (first (:panes (ed-body-layout at-end 30 6)))
          rows (ed-pane-rows pane (cur at-end))
          ops (ed-view at-end 30 6)
          c (seq/find ops (fn (op) (and (vector? op) (= (first op) :cursor)))))
      (is (> (second (first rows)) 0)) ; line 0 shown from mid-line
      (assert= (nth c 1) 0)
      (is (< (nth c 2) 29)) ; inside the 23 text cells right of the gutter
      ;; the other line is untouched
      (assert= (second (second rows)) 0)))

  (test "a click maps to the column under it; on the ellipsis it goes to the line's end"
    (let (m (ed-init (assoc (make-buffer (str commit-row "\nshort")) :long-lines :truncate))
          ;; row 0, screen col 4+4 → offset 4
          text-click (ed-update m [:mouse :press :left 0 8 [] 1] 28 6)
          ;; row 0, screen col 26 — the `…`
          ellipsis-click (ed-update m [:mouse :press :left 0 26 [] 1] 28 6))
      (assert= (buffer-point (cur text-click)) 4)
      (assert= (buffer-point (cur ellipsis-click)) (string/length commit-row)))))

;; ---- a wrapped pane scrolls by screen ROWS ------------------------------------------
;; A pane's scroll position used to be a LINE, so in a wrapped buffer the view could only
;; move a whole paragraph at once: typing at the bottom of the window held point's row
;; while a one-row line scrolled off the top, then lurched every row on screen up by the
;; height of the next paragraph. Emacs's window-start is a screen line, so it scrolls by
;; rows; the pane now starts on a row of its top line (`:top-row`).
(describe "a wrapped pane scrolls by screen rows"
  (def paragraph (string/join (map (range 0 60) (fn (i) (str "word" i))) " "))
  (def sections
    (string/join (map (range 0 12) (fn (i) (str "## Heading " i "\n\n" paragraph "\n"))) "\n"))
  (defn point-row (m cols rows)
    "Point's text row in the selected pane, as the view lays it out."
    (let (pane (ed-selected-pane (:panes (ed-body-layout m cols rows)))
          buf (ed-buf-at m (get (:payload pane) :buffer)))
      (first (ed-pane-point-row pane buf (ed-pane-vrows pane buf)))))
  (defn typing-rows (m keys cols rows)
    "Point's text row after each key."
    (second (fold keys
              [m []]
              (fn ([acc trail] k)
                (let (next (ed-update acc k cols rows))
                  [next (conj trail (point-row next cols rows))])))))
  (sig end-of-paragraph (map int -> map))
  (defn end-of-paragraph (m n)
    "The model with point at the end of the `n`th paragraph (from 0) of `sections`."
    (ed-set-buf m
      (goto-char (cur m) (+ (* n (+ 14 (string/length paragraph))) 13 (string/length paragraph)))))
  (test "typing at the bottom margin moves point's row by at most one per key"
    (let (m (ed-update (end-of-paragraph (wrapped sections) 4) :tick 80 24)
          keys (map (string/->list (string/join (map (range 0 40) (fn (i) (str " typed" i))) ""))
                 str)
          trail (typing-rows m keys 80 24)
          jumps (map (range 1 (count trail))
                  (fn (i) (math/abs (- (nth trail i) (nth trail (dec i)))))))
      (is (every? trail int?))
      ;; before rows: 5 — the height of the paragraph that scrolled off, less the row it grew
      (is (<= (reduce jumps 0 math/max) 1)))))

(describe "a pane started part-way down a wrapped line"
  (defn mid-paragraph ()
    "Typing at the bottom margin until the pane starts part-way down a paragraph: the model,
on an 80x24 frame."
    (letrec (go (fn (m i)
                  (if (or (> (ed-current-top-row m) 0) (> i 400))
                    m
                    (go (ed-update m " " 80 24) (inc i)))))
      (go (ed-update (end-of-paragraph (wrapped sections) 4) :tick 80 24) 0)))
  (defn selected (m) (ed-selected-pane (:panes (ed-body-layout m 80 24))))
  (test "typing gets the pane there, and its first row continues the top line"
    (let (m (mid-paragraph)
          pane (selected m)
          rows (ed-pane-rows pane (cur m)))
      (is (> (ed-current-top-row m) 0))
      (assert= (first (first rows)) (ed-current-top m))
      ;; the first row is a later segment of the line, not its start
      (is (> (second (first rows)) 0))
      (is (ed-pane-top-continued? pane (cur m)))))
  (test "an unchanged position leaves the model alone"
    (let (m (mid-paragraph))
      (is (= (ed-scroll m 22) m))))
  (test "the first row shows no line number: it continues the line"
    (let (m (mid-paragraph)
          ops (ed-view m 80 24)
          number (str (inc (ed-current-top m))))
      ;; the top line's number is nowhere in the gutter: its first row is off the top
      (is (not (any? (line-texts ops) (fn (t) (= (string/trim t) number)))))))
  (test "a click on the first row lands in that row's slice of the top line"
    (let (m (mid-paragraph)
          pane (selected m)
          buf (cur m)
          from (second (first (ed-pane-rows pane buf)))
          [px py _ _] (:rect pane)
          gutter (panes/ed-pane-gutter-width buf pane)
          clicked (ed-update m [:mouse :press :left py (+ px gutter) [] 1] 80 24)
          bol (text/line->char (buffer-rope buf) (ed-current-top m)))
      (assert= (buffer-point (cur clicked)) (+ bol from))))
  (test "C-v and M-v move by rows and keep point's screen row"
    (let (m (mid-paragraph)
          before (point-row m 80 24)
          down (ed-update m :ctrl-v 80 24)
          back (ed-update down :alt-v 80 24))
      (assert= (point-row down 80 24) before)
      (assert= (point-row back 80 24) before)
      (assert= [(ed-current-top back) (ed-current-top-row back)]
        [(ed-current-top m) (ed-current-top-row m)])))
  (test "C-l puts point's row in the middle, then at the top margin, then the bottom"
    (let (m (mid-paragraph)
          middle (ed-update m :ctrl-l 80 24)
          top (ed-update middle :ctrl-l 80 24)
          bottom (ed-update top :ctrl-l 80 24))
      (assert= (point-row middle 80 24) 11)
      (assert= (point-row top 80 24) (ed-margin 22))
      (assert= (point-row bottom 80 24) (- 22 1 (ed-margin 22)))))
  (test "two panes on one buffer keep their own row"
    (let (m (mid-paragraph)
          other (press m [:ctrl-x "2"])
          paths (editor/pane/pane-leaf-paths (:layout other))
          rows (map paths
                 (fn (path) (get (editor/pane/pane-payload-at (:layout other) path) :top-row))))
      ;; the split copies the selected pane's start; moving one does not move the other
      (let (moved (ed-update other :ctrl-v 80 24)
            after (map paths
                    (fn (path) (get (editor/pane/pane-payload-at (:layout moved) path) :top-row))))
        (assert= (count paths) 2)
        (is (not (= (first after) (second after))))
        ;; the pane C-v did not reach starts where it did
        (is (any? (range 2) (fn (i) (= (nth after i) (nth rows i))))))))
  (test "an edit that shortens the top line clamps the row to what it has"
    (let (m (mid-paragraph)
          top (ed-current-top m)
          rope (buffer-rope (cur m))
          bol (text/line->char rope top)
          ;; the top line cut to a few words: one row left
          shortened (ed-set-buf m
                      (replace-region (cur m)
                        (+ bol 10)
                        (+ bol (string/length (wrap/line-text (cur m) top)))
                        ""))
          pane (selected shortened)
          w (panes/ed-pane-text-cols pane (cur shortened)))
      (assert= (ed-pane-top-row pane (cur shortened) w (ed-row-extras (cur shortened))) 0)
      (assert= (first (first (ed-pane-rows pane (cur shortened)))) top)))
  (test "a narrowed pane scrolls by rows within its restriction"
    (let (m (ed-map-panes (ed-update (end-of-paragraph (wrapped sections) 4) :tick 80 24)
              (fn (w) (assoc w :restrict [0 (- (buffer-length (cur (wrapped sections))) 1)])))
          keys (map (string/->list (string/join (map (range 0 40) (fn (i) (str " typed" i))) ""))
                 str)
          trail (typing-rows m keys 80 24)
          jumps (map (range 1 (count trail))
                  (fn (i) (math/abs (- (nth trail i) (nth trail (dec i)))))))
      (is (every? trail int?))
      (is (<= (reduce jumps 0 math/max) 1)))))

;; A long wrapped line keeps its rows across edits and lays out again only from the edit
;; (`wrap/*line-layouts*`). What it keeps must be exactly what a whole layout gives, so each
;; case edits a fixed fixture step by step and compares the kept answer with `segments` over
;; the line's text — the full computation — after every step.
(describe "a long wrapped line's kept layout"
  (def wrap-spec {:long-lines {:policy :wrap :ellipsis "…"}})
  (defn fixture-line (n)
    "`n` chars mixing words, long words, tabs, wide glyphs and combining marks."
    (let (pieces ["word " "\tx " "😀😀 " "longerwordthanmostrowsare" " é " "日本語 " "a "])
      (string/substring (string/join (map (range n) (fn (i) (nth pieces (math/mod i 7)))) "")
        0 n)))
  (defn edited (buf at remove insert)
    "`buf` with `remove` chars at `at` replaced by `insert`, straight on its rope."
    (let (end (+ at remove))
      ;; the fixtures' offsets are ints; the guard is what tells the checker so
      (if (and (int? at) (int? end))
        (assoc buf :rope (text/insert (text/delete (buffer-rope buf) at end) at insert))
        (error "edited: offsets must be ints: " [at remove]))))
  (defn agrees? (buf line w)
    "Whether the kept layout of `line` at width `w` is the whole layout of its text."
    (= (line-segments buf line w wrap-spec) (segments (line-text buf line) w)))
  (defn walk (buf line w steps)
    "Apply `steps` (`[at remove insert]`, `at` relative to the line's start) in turn; the
index of the first step after which the kept layout disagrees, or nil."
    (second (fold steps
              [buf nil]
              (fn (acc step)
                (let ([b failed] acc
                      [at remove insert] step
                      start (text/line->char (buffer-rope b) line)
                      next (edited b (+ start at) remove insert))
                  (if (or failed (agrees? next line w))
                    [next failed]
                    [next (index-of steps step)]))))))
  (test "typing, deleting and pasting inside the line"
    (let (buf (make-buffer (str "header\n" (fixture-line 9000) "\nfooter\n"))
          w 37)
      (is (agrees? buf 1 w))
      (assert= (walk buf
                 1
                 w
                 [[5000 0 "x"]
                   [5001 0 "y"]
                   [5002 0 " "]
                   [5003 0 "z"]
                   [5003 1 ""]
                   [5002 1 ""]
                   [100 0 "\t"]
                   [101 0 "\t\t"]
                   [100 3 ""]
                   [2000 0 "😀"]
                   [2000 1 " "]
                   [0 0 "lead "]
                   [0 5 ""]
                   [7000 40 ""]
                   [6000 0 (fixture-line 200)]
                   [3000 0 "é̂"]
                   [10 2000 ""]
                   [10 0 (fixture-line 900)]])
        nil)))
  (test "a row starting where an old one did is the old row only a tab stop away from it"
    ;; tabs dense enough that a row's break moves when its start column does: one char typed
    ;; ahead of them shifts every row after it by a cell, which is NOT the old rows shifted
    (let (buf (make-buffer (str (string/repeat "\tab " 1500) "\n"))
          w 9)
      (is (agrees? buf 0 w))
      (assert= (walk buf
                 0
                 w
                 [[0 0 "x"]
                   [3001 0 "q"]
                   [1 0 "yz"]
                   [2002 1 ""]
                   [5 0 "z"]
                   [4500 0 "abc"]
                   [0 3 ""]
                   [3003 0 "!"]
                   [8 0 "12345678"]
                   [1200 0 "u"]])
        nil)))
  (test "an edit at the line's end, and one that empties it"
    (let (buf (make-buffer (str (fixture-line 2000) "\nnext\n"))
          len (string/length (line-text buf 0)))
      (is (agrees? buf 0 29))
      (assert= (walk buf 0 29 [[len 0 " tail"] [(+ len 5) 0 "x"] [0 (+ len 6) ""]]) nil)))
  (test "edits on other lines move the line or leave it as it was"
    (let (buf (make-buffer (str "a\nb\n" (fixture-line 2500) "\nz\n"))
          w 41
          long (fn (b) (agrees? b 2 w)))
      (is (long buf))
      ;; after it, before it (moving it), and a line inserted above it
      (let (after (edited buf (+ (text/line->char (buffer-rope buf) 3) 1) 0 "zz")
            before (edited after 0 0 "aaa")
            shorter (edited before 4 1 ""))
        (is (long after))
        (is (long before))
        (is (long shorter)))
      (let (above (edited buf 0 0 "new line\n"))
        (is (agrees? above 3 w)))))
  (test "a newline typed into the line splits it, and the halves lay out whole"
    (let (buf (make-buffer (str "top\n" (fixture-line 3000) "\n"))
          w 33)
      (is (agrees? buf 1 w))
      (let (split (edited buf (+ 4 3000) 0 "\n"))
        (is (agrees? split 1 w))
        (is (agrees? split 2 w)))))
  (test "a different width is a different layout"
    (let (buf (make-buffer (str (fixture-line 2500) "\n")))
      (is (agrees? buf 0 40))
      (is (agrees? (edited buf 300 0 "q") 0 40))
      (is (agrees? (edited buf 300 0 "q") 0 23)))))

;; A long line is coloured per line, one window of it (`spancache/ed-fontify-clip`): the part the
;; pane shows, not the line from its start to there — so a pane far into a megabyte line
;; pays for what it shows, and the rows of a wrapped line far down it are coloured too.
(describe "a long line is coloured where the pane shows it"
  (defn md-model (text policy point)
    "A markdown buffer of `text` with long-lines `policy`, point at `point`, one turn run."
    (let (m (ed-init (assoc (make-buffer text "x.md" "x.md") :long-lines policy)))
      (ed-update (ed-set-buf m (goto-char (cur m) point)) :tick 80 24)))
  (defn spans-of (m)
    (let (pane (selected m)
          buf (panes/ed-pane-buf m pane))
      (spancache/ed-pane-spans m pane buf (ed-pane-top pane buf) (ed-pane-vrows pane buf))))
  (def deep-line
    (str "**lead** "
      (string/repeat "plain words here " 1200)
      "**bold** "
      (string/repeat "more words " 600)))
  (def bold-at (+ 4 9 (string/length (string/repeat "plain words here " 1200))))
  (defn coloured-near? (spans at)
    (any? spans (fn (span) (and (<= (first span) at) (> (second span) at)))))
  (test "a wrapped pane far down a long line colours the rows it shows"
    (let (m (md-model (str "# x\n" deep-line "\n") :wrap (+ bold-at 2)))
      (is (coloured-near? (spans-of m) (+ bold-at 2)))))
  (test "a pane scrolled far into a long line lexes the window, not the line before it"
    (let (m (md-model (str "# x\n" deep-line "\n") :scroll (+ bold-at 2))
          spans (spans-of m))
      (is (coloured-near? spans (+ bold-at 2)))
      ;; nothing lexed from the line's start: the first span on it begins near the window
      (is (every? spans (fn (span) (or (< (first span) 4) (> (first span) (- bold-at 400)))))))))

;; `wrap/row-cell` and `wrap/row-column`: the ONE conversion between a char column of a row's
;; line and the screen cell it is painted at. Everything that places something at a column
;; (the caret, a fold's ellipsis, a note, a C-n goal) or reads a column off a cell (a click,
;; a drag, a hover) asks these two, so a row's prefix or inline text moves all of them at once.
(describe "the row geometry helper"
  (def row-rope (text/string-> "the quick brown fox jumps\nsecond"))
  (test "a column's cell is its chars from the row's start"
    (assert= (row-cell row-rope [0 0 nil nil] 4) 4)
    (assert= (row-cell row-rope [0 10 20 nil] 14) 4)
    ;; left of the row's first char: its first; past the line's end: its end
    (assert= (row-cell row-rope [0 10 20 nil] 3) 0)
    (assert= (row-cell row-rope [1 0 nil nil] 99) 6))
  (test "a cell's column is its inverse, clamped to the row"
    (assert= (row-column row-rope [0 0 nil nil] 4) 4)
    (assert= (row-column row-rope [0 10 20 nil] 4) 14)
    ;; past a row its line continues past: the char before the next row's first
    (assert= (row-column row-rope [0 10 20 nil] 40) 19)
    ;; past the line's last row: the line's end
    (assert= (row-column row-rope [0 20 25 nil] 40) 25))
  (test "a tab is measured on the LINE's stops, both ways"
    (let (rope (text/string-> "a\tbcdef"))
      (assert= (row-cell rope [0 0 nil nil] 2) 8)
      (assert= (row-column rope [0 0 nil nil] 5) 1)
      (assert= (row-column rope [0 0 nil nil] 8) 2)))
  (test "a click past a CUT row's cut is the line's end; a goal column reads on"
    (let (row [0 0 25 nil [9 "…"]])
      (assert= (row-column row-rope row 12 true) 25)
      (assert= (row-column row-rope row 12) 12)
      (assert= (row-column row-rope row 5 true) 5)))
  (test "a click past a wrapped row's text stays on that row"
    (let (m (wrapped long-line))
      ;; row 0 is `[0 20)`: a click far right of it lands on its last char, not row 1's
      (let (m2 (ed-update m [:mouse :press :left 0 25 [] 1] 28 6))
        (assert= (buffer-point (cur m2)) 19)))))

;; The wrap prefix (Emacs `wrap-prefix`, adaptive-wrap): a wrapped line's continuation rows
;; start under its indentation / fill prefix. It is a field of the row ENTRY, so the painter,
;; the caret, a click, C-n's goal column and the scroll clamp all read it from one place.
(describe "the wrap prefix"
  (def indented "    the quick brown fox jumps over the lazy dog")
  (sig row-start (any -> int))
  (defn row-start (row)
    "A row entry's first char, as an int."
    (let (from (second row)) (if (int? from) from 0)))
  (defn rows-of (m)
    (let (pane (first (:panes (ed-body-layout m 28 6)))) (ed-pane-rows pane (cur m))))
  (test "a continuation row of an indented line starts under its indentation"
    (let (rows (rows-of (wrapped indented)))
      (assert= (row-prefix (first rows)) 0)
      (is (> (count rows) 1))
      (is (every? (rest rows) (fn (row) (or (nil? (first row)) (= (row-prefix row) 4)))))))
  (test "the prefix narrows the continuation rows, so the line takes the rows it needs"
    ;; text width 23: the first row 23 cells, each continuation row 19
    (let (rows (rows-of (wrapped indented)))
      (is (every? (rest rows) (fn (row) (<= (- (nth row 2) (second row)) 19))))
      ;; the row count the scroll clamp walks agrees with the table
      (assert= (wrap/line-rows (cur (wrapped indented))
                 0
                 23
                 (ed-row-extras (cur (wrapped indented))))
        (count rows))))
  (test "a list item's text continues under its text, not its bullet (adaptive)"
    (let (rows (rows-of (wrapped "- the quick brown fox jumps over the lazy dog")))
      (assert= (row-prefix (second rows)) 2)))
  (defn file-rows (text file)
    "The row table of `text` in a buffer visiting `file` (its mode from the name), wrapped,
under an `:adaptive` wrap prefix."
    (binding (*wrap-prefix* :adaptive)
      (let (m (ed-init (make-buffer text file file)))
        ;; Markdown wraps already; visual-line-mode would turn it OFF
        (rows-of (if (= :wrap (ed-long-lines (cur m))) m (cmd-visual-line-mode m nil))))))
  (test "adaptive continues under the MODE's markers: in C a `#include` is code"
    (let (rows (file-rows "#include <a_long_header_name_that_has_to_wrap.h>" "a.c"))
      (is (> (count rows) 1))
      (is (every? rows (fn (row) (= (row-prefix row) 0)))))
    (assert= (row-prefix (second (file-rows "// the quick brown fox jumps over the lazy dog" "a.c")))
      3))
  (test "adaptive in a Lisp hangs under `;;`; in Markdown a `#` heading is no marker, `>` is"
    (assert= (row-prefix (second (file-rows ";; the quick brown fox jumps over the lazy dog"
                                   "a.blsp")))
      3)
    (assert= (row-prefix (second (file-rows "# the quick brown fox jumps over the lazy dog" "a.md")))
      0)
    (assert= (row-prefix (second (file-rows "> the quick brown fox jumps over the lazy dog" "a.md")))
      2))
  (test "a line indented past half the row wraps from the edge"
    (let (rows (rows-of (wrapped (str (string/repeat " " 14) "the quick brown fox jumps over"))))
      (is (every? rows (fn (row) (= (row-prefix row) 0))))))
  (test ":none keeps every row at the edge"
    (binding (*wrap-prefix* :none)
      (let (rows (rows-of (wrapped indented)))
        (is (every? rows (fn (row) (= (row-prefix row) 0)))))))
  (test "the caret on a continuation row sits past the prefix"
    (let (m (wrapped indented)
          row1 (second (rows-of m))
          ;; two chars into the second row
          m2 (ed-set-buf m (goto-char (cur m) (+ (row-start row1) 2)))
          c (seq/find (ed-view m2 28 6) (fn (op) (and (vector? op) (= (first op) :cursor)))))
      (assert= (nth c 1) 1)
      (assert= (nth c 2) (+ 4 4 2)))) ; gutter + prefix + 2
  (test "the continuation row's text is painted past the prefix"
    (let (m (wrapped indented)
          row1 (second (rows-of m))
          word (string/substring indented (row-start row1) (+ (row-start row1) 3))
          op (seq/find (ed-view m 28 6)
               (fn (op)
                 (and (vector? op)
                   (= (first op) :text)
                   (= (nth op 1) 1)
                   (string/starts-with? (nth op 3) word)))))
      (assert= (nth op 2) (+ 4 4))))
  (test "a click on the prefix lands on the row's first char; on the text, on its char"
    (let (m (wrapped indented)
          row1 (second (rows-of m)))
      (assert= (buffer-point (cur (ed-update m [:mouse :press :left 1 5 [] 1] 28 6)))
        (row-start row1))
      (assert= (buffer-point (cur (ed-update m [:mouse :press :left 1 (+ 4 4 2) [] 1] 28 6)))
        (+ (row-start row1) 2))))
  (test "C-n keeps the screen column across the prefix"
    ;; point at cell 10 of row 0 (char 10); row 1 starts 4 cells in, so cell 10 is its 6th char
    (let (m (assoc (ed-set-buf (wrapped indented) (goto-char (cur (wrapped indented)) 10))
              :view-cols 23)
          row1 (second (rows-of m))
          m2 (ed-update m :ctrl-n 28 6))
      (assert= (buffer-point (cur m2)) (+ (row-start row1) 6)))))
