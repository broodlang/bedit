;; A typed path read the way Emacs reads one (src/filename.blsp): `~` shown and understood,
;; `//` and `/~/` restarting the path (its shadow), `$VAR`s, and the path prompt that every
;; file input shares handing its consumer the absolute path that was meant.
(defmodule filename-test
  (:use filename)
  (:use mincomplete)
  (:use pool)
  (:use minibuffer)
  (:use model)
  (:use-internals echoarea)
  (:use-internals view)
  (:use editor/buffer) ; make-buffer
  (:use test))

;; the home as the editor names it (`path/home`: `/` form, USERPROFILE on Windows), and the
;; HOME variable as `$HOME` expands it (on Windows its `\` stay, as typed)
(def- home (path/home))
(def- home-variable (os/env "HOME"))

(describe "filename/shadow-end"
  (test "nothing is shadowed in an ordinary path"
    (assert= (shadow-end "~/src/whk/") 0)
    (assert= (shadow-end "/etc/hosts") 0)
    (assert= (shadow-end "") 0))
  (test "a second slash restarts the path at itself"
    (assert= (shadow-end "~/src//etc/") 6))
  (test "a ~ standing alone after a slash restarts the path at the ~"
    (assert= (shadow-end "/usr/lib/~/") 9)
    (assert= (shadow-end "/usr/lib/~") 9))
  (test "a name that merely starts with ~ is a file name"
    (assert= (shadow-end "/tmp/~bedit-surely-no-such-user") 0))
  (test "a ~user component restarts the path where the brood resolves ~user"
    (when (path/absolute? (path/absolute "~root" "."))
      (assert= (shadow-end "/bedit-none/~root/x") 12)
      (assert= (substitute "/bedit-none/~root/x") "~root/x")))
  (test "a ~ or ~user that is a real entry of the directory before it is a file, not a home"
    (let (d (temp-dir "bedit-fn-tilde-")
          _ (file/mkdir (str d "/~"))
          _ (file/spit (str d "/~/x") "x"))
      (assert= (shadow-end (str d "/~/x")) 0)
      (assert= (expand (str d "/~/x")) (str d "/~/x"))
      (when (path/absolute? (path/absolute "~root" "."))
        (file/mkdir (str d "/~root"))
        (assert= (shadow-end (str d "/~root/")) 0))))
  (test "a relative path decides against its base"
    (let (d (temp-dir "bedit-fn-tilde-rel-")
          _ (file/mkdir (str d "/sub/~")))
      (assert= (shadow-end "sub/~/" d) 0)
      (assert= (shadow-end "nosuch/~/" d) 7)))
  (test "the LAST restart wins"
    (assert= (shadow-end "/a//b/~/c") 6)))

(describe "filename/substitute"
  (test "what follows the last restart, still spelled as typed"
    (assert= (substitute "~/src//etc/hosts") "/etc/hosts")
    (assert= (substitute "/usr/lib/~/notes") "~/notes")
    (assert= (substitute "~/src/whk/") "~/src/whk/"))
  (test "$$ is a literal dollar"
    (assert= (substitute "/tmp/$$x") "/tmp/$x"))
  (test "an unset variable stays as it was typed"
    (assert= (substitute "/tmp/$BEDIT_SURELY_UNSET_VAR/x") "/tmp/$BEDIT_SURELY_UNSET_VAR/x"))
  (test "$HOME and ${HOME} expand, and an absolute value restarts the path"
    (when home-variable
      (assert= (substitute "$HOME/src") (str home-variable "/src"))
      (assert= (substitute "${HOME}/src") (str home-variable "/src"))
      (assert= (substitute "/somewhere/else/$HOME/src") (str home-variable "/src")))))

(describe "filename/expand and filename/as-input"
  (test "expand gives the absolute path, a trailing slash kept"
    (assert= (expand "/srv//etc/") "/etc/")
    (when home (assert= (expand "~/src/") (str home "/src/"))))
  (test "a blank line stays blank, so a prompt can tell nothing was typed"
    (assert= (expand "") "")
    (assert= (expand "  ") "  "))
  (test "as-input shows the home as ~ and quotes what expand would read"
    (assert= (as-input "/srv//a$b/") "/srv/a$$b/")
    (when home (assert= (as-input (str home "/src/whk/")) "~/src/whk/")))
  (test "as-input then expand is the path again"
    (doseq (p ["/etc/hosts" "/tmp/a$b" "/" (str (or home "/root") "/x/")])
      (assert= (expand (as-input p)) p))))

(describe "path completion under ~"
  (test "~/ lists the home, every candidate spelled from ~"
    (when (and home (file/dir? home))
      (assert= (ed-path-candidates "~/")
        (map (ed-path-candidates (str home "/")) path/abbreviate))))
  (test "the live list under ~ floats a recent file given as an absolute path"
    (when (and home (file/dir? home))
      (let (first-entry (first (ed-path-candidates-top (str home "/") [] 1)))
        (when (and first-entry (not (string/ends-with? first-entry "/")))
          (assert= (first (ed-path-candidates-top "~/" [first-entry] 3))
            (path/abbreviate first-entry))))))
  (test "the directory keeps the spelling it was typed in"
    (when (and home-variable (file/dir? home-variable))
      (let (first-entry (first (ed-path-candidates "$HOME/")))
        (when first-entry
          (is (string/starts-with? first-entry "$HOME/"))
          (assert= (expand first-entry)
            (str home-variable (string/substring first-entry 5 (count first-entry))))))))
  (test "a recent file floats under the spelling the directory was typed in"
    (let (d (temp-dir "bedit-fn-recent-")
          _ (file/mkdir d)
          _ (file/spit (str d "/a.txt") "x")
          _ (file/spit (str d "/b.txt") "x"))
      (assert= (ed-path-candidates-top "sub/" [] 3 d) ())
      (assert= (ed-path-candidates-top (str d "//" d "/") [(str d "/b.txt")] 3)
        (list (str d "/b.txt") (str d "/a.txt")))
      (assert= (ed-path-candidates-top "" [(str d "/b.txt")] 3 d) (list "b.txt" "a.txt"))))
  (test "a restarted path completes from where it restarted"
    (let (d (temp-dir "bedit-fn-")
          _ (file/mkdir d)
          _ (file/spit (str d "/only.txt") "x"))
      (assert= (ed-path-candidates (str "/somewhere/else/" d "/on")) (list (str d "/only.txt")))
      (assert= (ed-complete-path (str "/elsewhere/" d "/on")) (str d "/only.txt")))))

(describe "the path prompt reads the Emacs way"
  (test "it is prefilled with the home shown as ~"
    (when home
      (let (mb (ed-path-prompt "Find file: " (str home "/src/") [] (fn (m _p) m)))
        (assert= (mb-text mb) "~/src/"))))
  (test "its consumer receives the absolute path that was meant"
    (let (mb (ed-path-prompt "Find file: " "/tmp/" [] (fn (m p) (assoc m :got p))))
      (assert= (:got ((:on-complete mb) {} "/tmp//etc/hosts")) "/etc/hosts")
      (when home (assert= (:got ((:on-complete mb) {} "~/notes")) (str home "/notes")))))
  (test "the overridden part of the line is painted as a shadow"
    (let (mb (ed-path-prompt "Find file: " "/tmp/" [] (fn (m _p) m))
          typed (assoc mb :edit (ed-mb-set-text (:edit mb) "/tmp//etc/"))
          m (assoc (ed-init (make-buffer "")) :minibuffer typed)
          ops (ed-mb-shadow-ops m 80 24))
      (assert= (count ops) 1)
      (assert= (nth (first ops) 3) "/tmp/")
      (assert= (nth (first ops) 2) (ed-mb-input-col typed))))
  (test "nothing is shadowed in an ordinary path"
    (let (mb (ed-path-prompt "Find file: " "/tmp/" [] (fn (m _p) m))
          m (assoc (ed-init (make-buffer "")) :minibuffer mb))
      (assert= (ed-mb-shadow-ops m 80 24) [])))
  (test "the caret, the text and the shadow measure the input in display CELLS"
    ;; each case: the input, and where the caret goes after it from the input's column
    (let (prompt-with (fn (text)
                        (let (mb (ed-path-prompt "Find file: " "/tmp/" [] (fn (m _p) m)))
                          (assoc mb :edit (ed-mb-set-text (:edit mb) text))))
          ;; the minibuffer's caret: the lowest one on the frame (a pane's sits above it)
          caret-of (fn (m)
                     (reduce (seq/filter (view/ed-view m 80 24)
                               (fn (op) (and (vector? op) (= (first op) :cursor))))
                       nil
                       (fn (best op) (if (or (nil? best) (> (nth op 1) (nth best 1))) op best))))
          ;; `Find file: ./日本` puts the caret after `本`: each glyph two cells
          cases ["./日本" "a\tb" "a\u{200b}b"])
      (fold cases
        nil
        (fn (_ text)
          (let (mb (prompt-with text)
                m (assoc (ed-init (make-buffer "")) :minibuffer mb)
                col (ed-mb-input-col mb)
                caret (cond
                        (= text "./日本") (+ col 2 4)
                        ;; the tab after `a` reaches the next stop of 8
                        (= text "a\tb") (+ (inc col) (- 8 (math/mod (inc col) 8)) 1)
                        ;; `a`, the `<200b>` escape, `b`
                        else (+ col 1 6 1))
                painted (nth (ed-echo-line m 80 24) 3))
            (assert= (mb-point mb) (count text))
            (assert= (nth (caret-of m) 2) caret)
            ;; the echo line painted the whole input in exactly the cells before the caret
            (assert= (string/display-width painted) caret)
            (is (not (includes? painted "\t"))))))))
  (test "a shadow after a wide glyph starts where the input does and spans its cells"
    (let (mb (ed-path-prompt "Find file: " "/tmp/" [] (fn (m _p) m))
          typed (assoc mb :edit (ed-mb-set-text (:edit mb) "/日本//etc/"))
          m (assoc (ed-init (make-buffer "")) :minibuffer typed)
          op (first (ed-mb-shadow-ops m 80 24)))
      (assert= (nth op 2) (ed-mb-input-col typed))
      (assert= (nth op 3) "/日本/")
      (assert= (string/display-width (nth op 3)) 6))))

(describe "path/escape-env with unescape, absolute"
  (test "escape doubles every $ and unescape reads it back"
    (assert= (path/escape-env "/tmp/a$b$c") "/tmp/a$$b$$c")
    (assert= (unescape (path/escape-env "/tmp/a$b$c")) "/tmp/a$b$c"))
  (test "an escaped name expands to itself, not a variable"
    (when home (assert= (expand (path/escape-env "/tmp/$HOME")) "/tmp/$HOME")))
  (test "absolute reads a relative name under the base, and never reads $ or //"
    (assert= (absolute "a" "/srv") "/srv/a")
    (assert= (absolute "/x//$y" "/srv") "/x//$y")
    (when home (assert= (absolute "~/a" "/srv") (str home "/a"))))
  (test "expand reads a relative name under the base"
    (assert= (expand "notes/a.txt" "/srv") "/srv/notes/a.txt")
    (assert= (expand "/etc/hosts" "/srv") "/etc/hosts")))

(describe "candidates are in input spelling"
  (test "a file whose name holds $ is offered escaped, labelled as itself, and read back"
    (let (d (temp-dir "bedit-fn-dollar-")
          _ (file/mkdir d)
          _ (file/spit (str d "/a$HOME.txt") "x")
          cands (ed-path-candidates (str d "/a")))
      (assert= cands (list (str d "/a$$HOME.txt")))
      (assert= (path-label (str d "/a$$HOME.txt")) "a$HOME.txt")
      (assert= (expand (str d "/a$$HOME.txt")) (str d "/a$HOME.txt"))
      (assert= (ed-path-candidates-top (str d "/a") [] 12) cands)))
  (test "a relative name lists and completes under the base"
    (let (d (temp-dir "bedit-fn-rel-")
          _ (file/mkdir (str d "/sub"))
          _ (file/spit (str d "/sub/inner.txt") "x"))
      (assert= (ed-path-candidates "su" d) (list "sub/"))
      (assert= (ed-path-candidates "sub/in" d) (list "sub/inner.txt"))
      (assert= (ed-complete-path "sub/in" d) "sub/inner.txt")
      (assert= (ed-path-candidates-top "sub/" [] 12 d) (list "sub/inner.txt")))))

(describe "every path prompt reads the same way"
  (test "find-file reads a relative name under the directory it opened in"
    (let (mb (ed-path-prompt "Find file: " "/srv/app/" [] (fn (m p) (assoc m :got p))))
      (assert= (:got ((:on-complete mb) {} "lib/x.ex")) "/srv/app/lib/x.ex")))
  (test "a prompt prefilled with a FILE reads relative names beside it"
    (let (mb (ed-path-prompt "Write file: " "/srv/app/mix.exs" [] (fn (m p) (assoc m :got p))))
      (assert= (:got ((:on-complete mb) {} "other.exs")) "/srv/app/other.exs")))
  (test "the root directory is a base too"
    (let (mb (ed-path-prompt "Find file: " "//" [] (fn (m p) (assoc m :got p))))
      (assert= (mb-text mb) "/")
      (assert= (:got ((:on-complete mb) {} "etc")) "/etc")))
  (test "the file marginalia stats the file a ~ candidate names"
    (when (and home (file/dir? home))
      (let (mb (ed-path-prompt "Find file: " (str home "/") [] (fn (m _p) m)))
        (is (not (= (plume/plume-file-annotation "~/" mb) ""))))))
  (test "a list of paths is shown as the line spells them and read back absolute"
    (let (paths (if home [(str home "/src/whk") "/tmp/a$b"] ["/tmp/a$b"])
          mb (ed-path-list-prompt "Recent file: " paths (fn (m p) (assoc m :got p)) "/srv"))
      (when home (is (includes? (:rank-source mb) "~/src/whk")))
      (is (includes? (:rank-source mb) "/tmp/a$$b"))
      ;; an entry chosen from the list, and one typed instead
      (assert= (:got ((:on-complete mb) {} "/tmp/a$$b")) "/tmp/a$b")
      (assert= (:got ((:on-complete mb) {} "notes")) "/srv/notes")
      (assert= (:got ((:on-complete mb) {} "")) "")))
  (test "with no entry matching, a list prompt completes the text as a path from the disk"
    (let (d (temp-dir "bedit-fn-list-")
          _ (file/mkdir d)
          _ (file/spit (str d "/unique-entry") "x")
          mb (ed-path-list-prompt "Switch to project: " ["/srv/alpha"] (fn (m _p) m) d)
          complete (:complete-fn mb))
      (assert= (complete (str d "/uni")) (str d "/unique-entry"))
      (assert= (complete "uni") "unique-entry")))) ; relative: under the base

;; What every prompt for a NEW path shares (`pool`): a blank line names nothing, a directory
;; answered takes the name, a file already there is asked about.
(describe "a prompt for a new path"
  (test "a blank line is said and never handed on"
    (let (mb (ed-path-prompt "Write file: " "/tmp/" [] (fn (m p) (assoc m :got p)) {:new-name true})
          answered ((:on-complete mb) (ed-init (make-buffer "")) "  "))
      (is (nil? (:got answered)))
      (assert= (:echo answered) "(no file name)")))
  (test "a directory takes the name; anything else is the target itself"
    (let (dir (temp-dir "bedit-newpath-"))
      (file/mkdir dir)
      (assert= (pool/ed-into-dir dir "a.txt") (path/join dir "a.txt"))
      (assert= (pool/ed-into-dir (path/join dir "b.txt") "a.txt") (path/join dir "b.txt"))))
  (test "a file already there is asked about; a free path is not"
    (let (dir (temp-dir "bedit-newpath-")
          _ (file/mkdir dir)
          taken (path/join dir "taken.txt")
          _ (file/spit taken "x")
          m (ed-init (make-buffer ""))
          went (fn (mm) (assoc mm :went true)))
      (is (:went (pool/ed-confirm-overwrite m (path/join dir "free.txt") went)))
      (let (asked (pool/ed-confirm-overwrite m taken went))
        (refute (:went asked))
        (is (includes? (:echo asked) "exists; overwrite?"))
        (is (:went ((:then (:read-char asked)) asked "y")))
        (refute (:went ((:then (:read-char asked)) asked "n")))))))
