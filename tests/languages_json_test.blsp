;; JSON (src/languages/json.blsp): a `deflanguage` over tree-sitter-json that keeps its line lexer
;; as the `:fallback` (and past a size), JSON Lines over the same grammar, JSON5 lexed.
;; Two halves: the STAND-IN, its line lexer, tested whatever is installed (`model/*grammar-ready?*`
;; answers "missing"), and the parsed mode, which needs the grammar (`testkit/load-test-grammar`:
;; `$BROOD_TEST_GRAMMARS`, else `~/.config/bedit/grammars`) and SKIPS without it.
(defmodule languages-json-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use testkit :only [cur file-model file-buffer press]))

;; ---- JSON, parsed by tree-sitter-json -----------------------------------------------
(describe "json-mode: its grammar, its lexer past a size, and JSON5 left lexed"
  (test "a .geojson file is JSON, and an .ndjson file JSON Lines"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/map.geojson")) "json")
    (assert= (ed-buf-mode-name (file-buffer "" "/p/events.ndjson")) "jsonl"))
  (test "where tree-sitter-json lives"
    (assert= (:url (model/grammar-source :json))
      "https://github.com/tree-sitter/tree-sitter-json"))
  (test "a JSON file past `json-lexer-above` is the lexer's, grammar or not"
    (let (big (str "[" (string/repeat "1," (math/quot languages/json/json-lexer-above 2)) "1]")
          buf (binding (*grammar-ready?* (fn (_lang) true)) (file-buffer big "dump.json")))
      (assert= (:type buf) :json-lexer)
      (assert= (ed-buf-mode-name buf) "json")
      (assert= (ed-mode-service buf :fontify) languages/lex-configs/json-spans)))
  (test "a small one is parsed when the grammar is ready"
    (assert= (:type (binding (*grammar-ready?* (fn (_lang) true)) (file-buffer "{}" "a.json")))
      :json))
  (test "a JSON5 file stays lexed: tree-sitter-json reads its unquoted keys as errors"
    (let (buf (file-buffer "{a: 1,}" "x.json5"))
      (assert= (ed-buf-mode-name buf) "json5")
      (is (nil? (ed-mode-service buf :ts-lang))))))

;; The sample, tests/corpus/json/tsconfig.json (prettier), is checked by
;; tests/language_corpus_test.blsp — its mode, colours, indentation and restart — beside
;; tests/corpus/json/package.json.
(def json-src (file/slurp "tests/corpus/json/tsconfig.json"))

(describe "json, parsed"
  :skip-unless (testkit/load-test-grammar :json)
  "no json grammar"
  (test "RET after `{` indents the new line, though nothing parses yet"
    (let (text "{\n  \"a\": {"
          m (file-model text "a.json")
          entered (press (ed-set-buf m (goto-char (ed-current-buf m) (count text)))
                    [:enter]))
      (assert= (buffer-text (ed-current-buf entered)) (str text "\n    "))))
  (test "C-M-a lands on the key/value pair point is in"
    (assert= (editor/treesit/point-defun-start json-src :json (index-of json-src "null"))
      (index-of json-src "\"deep\""))))

(describe "json-mode, among the configuration formats"
  (test "M-; knows JSON's comment syntax"
    (assert= (model/ed-mode-service (cur (file-model "{}" "x.json")) :comment-syntax) "// ")))

(describe "json lines, found by review"

  (test "JSON Lines is its own mode, with no formatter to fail every save"
    (let (buf (binding (*grammar-ready?* (fn (_lang) true))
                (file-buffer "{\"a\": 1}\n" "/p/x.jsonl")))
      (assert= (:type buf) :jsonl)
      (is (nil? (ed-mode-service buf :format-command))))
    (let (buf (binding (*grammar-ready?* (fn (_lang) true)) (file-buffer "{}\n" "/p/x.json")))
      (assert= (:type buf) :json)
      (is (not (nil? (ed-mode-service buf :format-command)))))))
