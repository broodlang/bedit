;; Key bindings from init.blsp — `:keys` and `:mode-keys` (src/userkeys.blsp): compiled
;; from the config, bound into the layers dispatch resolves through, run by a real
;; keystroke through `ed-update`, reported by help, and gone again on a reload without them.

(defmodule userkeys-test
  (:use test)
  (:use model)
  (:use input)
  (:use keyhelp) ; ed-keys-label / ed-where-is — what help prints for a key
  (:use userkeys)
  (:use config-paths) ; *config-base* — a scratch config dir for the reload, never the real one
  (:use keymaps) ; profile-keymap — every key the profiles bind
  (:use config) ; *config-base* — a scratch config dir for the reload, never the real one
  (:use editor/buffer)
  (:use editor/keymap) ; key-parse / keymap-bindings
  (:use editor/layers) ; scope-bindings / scope-keymap — help's view of the scope
  (:use tutor-course :only [tutor-keyset]) ; the keys the tutorial names
  (:use-internals bedit/input)) ; ed-ensure-layers / ed-key-binding — the scope as dispatch sees it

(purge-stale-temp "bedit-userkeys-") ; drop fixtures a prior run left in /tmp (at load)

(defn- uk-model (text cfg)
  "An editor on a scratch buffer holding `text`, with the init config `cfg` applied as
startup applies it."
  (config/apply-to-model (ed-init (make-buffer text)) cfg))

(defn- uk-markdown (text cfg)
  "As [[uk-model]], the buffer a Markdown one."
  (config/apply-to-model (ed-init (init-buffer-layers (set-buffer-type (make-buffer text) :markdown)))
    cfg))

(defn- uk-press (m keys) (fold keys m (fn (acc key) (ed-update acc key 80 24))))
(defn- uk-text (m) (buffer-text (ed-current-buf m)))

(describe "the init file's bindings compiled"
  (test "a key description and an M-x name become a sequence and the command's symbol"
    (let (user (ed-user-keys {"C-c f" 'duplicate-line} {}))
      (assert= [] (:warnings user))
      (assert= 1 (count (:global user)))
      (let ([sequence command] (first (:global user)))
        (assert= [:ctrl-c "f"] sequence)
        (assert= "cmd-duplicate-line" (ed-command-tail command)))))

  (test "a string names a command too, and nil unbinds"
    (let (user (ed-user-keys {"C-c f" "duplicate-line" "C-z" nil} {}))
      (assert= [] (:warnings user))
      (assert= [[:ctrl-z] nil] (first (:global user)))))

  (test "a mode is named as its mode line shows it, with or without -mode"
    (let (user (ed-user-keys {}
                 {'markdown-mode {"C-c d" 'duplicate-line} :prog {"C-c e" 'duplicate-line}}))
      (assert= #{"markdown" "prog"} (into #{} (keys (:modes user))))))

  (test "a key that does not read, or a command that is not one, is a warning naming it"
    (let (warnings (ed-user-key-warnings {"C-x foo" 'duplicate-line
                                          "C-c q" 'no-such-command-anywhere}
                     {'markdown {"<nope>" 'duplicate-line}}))
      (assert= 3 (count warnings))
      (is (any? warnings (fn (w) (and (includes? w ":keys \"C-x foo\"") (includes? w "foo")))))
      (is (any? warnings (fn (w) (includes? w "no command named no-such-command-anywhere"))))
      (is (any? warnings (fn (w) (includes? w ":mode-keys markdown \"<nope>\""))))))

  (test "a mode no loaded layer is named warns, and still binds"
    (let (user (ed-user-keys {} {'no-such-mode-here {"C-c d" 'duplicate-line}}))
      (assert= 1 (count (:warnings user)))
      (is (includes? (first (:warnings user)) "not loaded yet?"))
      (assert= ["no-such-mode-here"] (vec (keys (:modes user))))))

  (test "every registered mode, and the profiles' layers, are known by name"
    (let (names (ed-user-mode-names))
      (is (every? ["text" "prog" "markdown" "brood" "special" "emacs" "vim-normal" "vim-insert"]
            (fn (name) (contains? names name))))
      (assert= []
        (ed-user-key-warnings {}
          {'markdown-mode {"C-c d" 'duplicate-line}
           'vim-normal {"g h" 'beginning-of-line}}))))

  (test "an M-x name whose module has not loaded resolves through the deferred registry"
    ;; markdown-preview lives in mdpreview, declared deferred by modes.blsp's keymap
    (let (user (ed-user-keys {"C-c v" 'markdown-preview} {}))
      (assert= [] (:warnings user))
      (assert= "cmd-markdown-preview" (ed-command-tail (second (first (:global user)))))))

  (test "a binding that did not compile is left out, the rest still bind"
    (let (user (ed-user-keys {"C-x foo" 'duplicate-line "C-c f" 'duplicate-line} {}))
      (assert= [[:ctrl-c "f"]] (vec (map (:global user) first))))))

(describe "a package's keys"
  :isolated (test "a package's key runs, under the user's, and goes when the package is released"
    (assert= []
      (ownership/with-claimant "/tests-pkgkeys/pkg/src/pkg.blsp"
        (fn () (register-package-keys "pkg" {"C-c f" 'duplicate-line} {}))))
    (let (ran (uk-press (uk-model "one\n" {}) [:ctrl-c "f"])
          overruled (uk-press (uk-model "one\n" {:keys {"C-c f" nil}}) [:ctrl-c "f"])
          help (ed-where-is-named (scope-keymap (userkeys/ed-scope (uk-model "" {})))
                 'editing/cmd-duplicate-line))
      (ownership/release-under! "/tests-pkgkeys")
      (assert= "one\none\n" (uk-text ran))
      ;; init.blsp's binding of the same key wins
      (assert= "one\n" (uk-text overruled))
      (is (includes? help "C-c f"))
      (assert= "one\n" (uk-text (uk-press (uk-model "one\n" {}) [:ctrl-c "f"])))
      (assert= {:global [] :modes {}} (ed-package-keys))))
  (test "a package key that does not bind is a warning naming the package"
    (let (warnings (register-package-keys "pkg" {"C-c f" 'no-such-command-anywhere} {}))
      (is (string/starts-with? (first warnings) "package pkg: :keys"))
      (assert= {:global [] :modes {}} (ed-package-keys)))))

(describe "a bound key runs through the dispatcher"
  (test "a global binding runs its command"
    (let (m (uk-press (uk-model "one\n" {:keys {"C-c f" 'duplicate-line}}) [:ctrl-c "f"]))
      (assert= "one\none\n" (uk-text m))))

  (test "binding into a prefix keeps the prefix's other keys"
    (let (before (userkeys/ed-key-binding (uk-model "" {}) :ctrl-c)
          after (userkeys/ed-key-binding (uk-model "" {:keys {"C-c f" 'duplicate-line}}) :ctrl-c))
      (is (map? before))
      (is (contains? after "f"))
      (assert= (into #{} (keys before)) (set/disj (into #{} (keys after)) "f"))))

  (test "nil unbinds a key"
    (let (m (uk-press (uk-model "abc" {:keys {"C-e" nil}}) [:ctrl-e]))
      (assert= 0 (buffer-point (ed-current-buf m)))))

  (test "a key can be rebound to another command"
    (let (m (uk-press (uk-model "abc" {:keys {"C-a" 'end-of-line}}) [:ctrl-a]))
      (assert= 3 (buffer-point (ed-current-buf m)))))

  (test "a mode binding runs in that mode's buffers and nowhere else"
    (let (cfg {:mode-keys {'markdown {"C-c d" 'duplicate-line}}})
      (assert= "# a\n# a\n" (uk-text (uk-press (uk-markdown "# a\n" cfg) [:ctrl-c "d"])))
      (assert= "# a\n" (uk-text (uk-press (uk-model "# a\n" cfg) [:ctrl-c "d"])))))

  (test "a global C-c key still works in a mode that binds its own C-c keys"
    ;; markdown binds C-c C-p; layers merge prefixes deeply (brood ADR-535), so the global
    ;; C-c f stands beside it rather than being hidden by markdown's C-c map
    (let (m (uk-markdown "# a\n" {:keys {"C-c f" 'duplicate-line}}))
      (assert= "# a\n# a\n" (uk-text (uk-press m [:ctrl-c "f"])))
      (assert= "cmd-markdown-preview"
        (ed-command-tail (get (userkeys/ed-key-binding m :ctrl-c) :ctrl-p)))))

  (test "M-x reload-config binds what init.blsp now says"
    (let (base (temp-dir "bedit-userkeys-")
          _ (file/mkdir (path/join base "bedit"))
          _ (file/spit (path/join base "bedit" "init.blsp")
              (str "(config :keys {\"C-c f\" duplicate-line \"C-z\" nil}\n"
                "        :mode-keys {markdown-mode {\"C-c d\" duplicate-line}})"))
          reloaded (binding (*config-base* base)
                     (lifecycle/cmd-reload-config (ed-init (make-buffer "one\n")) nil)))
      (assert= "config reloaded" (:echo reloaded))
      (assert= ["markdown"] (vec (keys (:modes (:user-keys reloaded)))))
      (assert= "one\none\n" (uk-text (uk-press reloaded [:ctrl-c "f"])))))

  (test "a reload without the binding takes it away"
    (let (bound (uk-model "one\n" {:keys {"C-c f" 'duplicate-line}})
          reloaded (config/apply-to-model bound {}))
      (assert= "one\n" (uk-text (uk-press reloaded [:ctrl-c "f"]))))))

(describe "help reports a user binding as the dispatcher runs it"
  (test "describe-key's table has it, in force"
    (let (m (input/ed-ensure-layers (uk-model "" {:keys {"C-c f" 'duplicate-line}}))
          entry (seq/find (scope-bindings (userkeys/ed-scope m))
                  (fn (e) (= (:sequence e) [:ctrl-c "f"]))))
      (is (not (nil? entry)))
      (assert= nil (:shadowed-by entry))
      (assert= "cmd-duplicate-line" (ed-command-tail (:command entry)))))

  (test "where-is names the user's key"
    (let (m (input/ed-ensure-layers (uk-model "" {:keys {"C-c f" 'duplicate-line}}))
          keymap (scope-keymap (userkeys/ed-scope m)))
      (assert= "C-c f" (ed-where-is-named keymap 'editing/cmd-duplicate-line)))))

(describe "the init file's bindings are checked with the rest of it"
  (test "init-warnings carries a key that does not read"
    (let (warnings (config/init-warnings {:keys {"C-x foo" 'duplicate-line}}
                     "/nonexistent/init.blsp"))
      (is (any? warnings (fn (w) (includes? w "C-x foo"))))))

  (test "a :keys value of the wrong shape is a settings warning, and binds nothing"
    (is (not (empty? (config/config-warnings {:keys {:ctrl-x 'duplicate-line}}))))
    (is (not (empty? (config/config-warnings {:mode-keys {'markdown ["C-c d"]}}))))
    (assert= []
      (config/config-warnings {:keys {"C-c f" 'duplicate-line "C-z" nil}
                               :mode-keys {'markdown {"C-c d" "duplicate-line"}}})))

  (test "the default init file documents both"
    (is (includes? config/*init-default-source* ":keys"))
    (is (includes? config/*init-default-source* ":mode-keys"))))

(describe "every key the profiles bind reads back from its label"
  ;; key-parse (std) is the inverse of the printer help uses — over bedit's real keymaps,
  ;; so a binding pasted from C-h k into init.blsp is the binding C-h k described.
  (test "emacs and vim"
    (doseq (profile [:emacs :vim])
      (let (wrong (seq/filter (keymap-bindings (profile-keymap profile))
                    (fn ([_ sequence]) (not (= sequence (key-parse (ed-keys-label sequence)))))))
        (assert= [] (vec (map wrong (fn ([_ sequence]) (ed-keys-label sequence)))))))))

(describe "text that names keys names the user's own"
  ;; find-file moved from C-x C-f to <f6>: the welcome scratch and the tutorial say <f6>
  (def- uk-moved {:keys {"C-x C-f" nil "<f6>" 'find-file}})

  (test "the welcome scratch, rendered from the config before there is a model"
    (is (includes? (main/welcome-text :emacs {}) "C-x C-f open"))
    (let (text (main/welcome-text :emacs uk-moved))
      (is (includes? text "<f6> open"))
      (is (not (includes? text "C-x C-f")))))

  (test "the tutorial, rendered from the model's :user-keys"
    (let (moved (config/user-keys {:keys {"M-x" nil "<f9>" 'execute-extended-command}}))
      (assert= "M-x" (:kcmd (tutor-course/tutor-keyset :emacs nil)))
      (assert= "<f9>" (:kcmd (tutor-course/tutor-keyset :emacs moved)))))

  (test "the profile keymap with the user's keys in"
    (assert= "<f6>"
      (ed-where-is (profile-keymap-with :emacs (config/user-keys uk-moved))
        (quote commands/cmd-find-file)))
    (assert= "C-x C-f"
      (ed-where-is (profile-keymap-with :emacs nil) (quote commands/cmd-find-file)))))

(describe "M-x global-set-key / local-set-key bind for the session"
  (defn- uk-set-key (m command-symbol keys command-name)
    ;; run the set-key command, type `keys` into its key read, answer the command prompt
    (let (asked (uk-press (command-symbol m nil) keys)
          prompt (:minibuffer asked))
      ((:on-complete prompt) (dissoc asked :minibuffer) command-name)))

  (test "a key bound globally runs its command, and C-h k and where-is name it"
    (let (m (uk-set-key (input/ed-ensure-layers (uk-model "one\n" {}))
              help/cmd-global-set-key
              [:ctrl-c "z"]
              "duplicate-line"))
      (is (includes? (:echo m) "C-c z runs duplicate-line"))
      (assert= "one\none\n" (uk-text (uk-press m [:ctrl-c "z"])))
      (is (includes? (:echo (uk-press (help/cmd-describe-key m nil) [:ctrl-c "z"]))
            "duplicate-line"))
      (assert= "C-c z"
        (ed-where-is-named (scope-keymap (userkeys/ed-scope m)) 'editing/cmd-duplicate-line))))

  (test "a key already bound is rebound"
    (let (m (uk-set-key (uk-model "abc" {}) help/cmd-global-set-key [:ctrl-a] "end-of-line"))
      (assert= 3 (buffer-point (ed-current-buf (uk-press m [:ctrl-a]))))))

  (test "a command that is none binds nothing and says so"
    (let (m (uk-set-key (uk-model "" {}) help/cmd-global-set-key [:ctrl-c "z"] "no-such-command-x"))
      (is (includes? (:echo m) "not bound"))
      (assert= [] (:global (:session-keys m)))))

  (test "C-g abandons the key read"
    (let (m (uk-press (help/cmd-global-set-key (uk-model "" {}) nil) [:ctrl-g]))
      (assert= nil (:describe-key m))
      (assert= nil (:minibuffer m))))

  (test "local-set-key binds in the buffer's mode and nowhere else"
    (let (m (uk-set-key (uk-markdown "# a\n" {})
              help/cmd-local-set-key
              [:ctrl-c "z"]
              "duplicate-line"))
      (assert= ["markdown"] (vec (keys (:modes (:session-keys m)))))
      (assert= "# a\n# a\n" (uk-text (uk-press m [:ctrl-c "z"])))
      (assert= "# a\n"
        (uk-text (uk-press (config/apply-to-model (ed-init (make-buffer "# a\n")) {}) [:ctrl-c "z"])))))

  (test "a reload keeps a session binding, unless init.blsp now binds the key"
    (let (m (uk-set-key (uk-model "one\n" {})
              help/cmd-global-set-key
              [:ctrl-c "z"]
              "duplicate-line")
          kept (config/apply-to-model m {:keys {"C-c f" 'end-of-line}})
          taken (config/apply-to-model m {:keys {"C-c z" 'end-of-line}}))
      (assert= "one\none\n" (uk-text (uk-press kept [:ctrl-c "z"])))
      (assert= 3 (buffer-point (ed-current-buf (uk-press kept [:ctrl-c "f"]))))
      (assert= 3 (buffer-point (ed-current-buf (uk-press taken [:ctrl-c "z"]))))
      (assert= [] (:global (:session-keys taken))))))
