;; src/startup.blsp — the one startup path the window and `--serve` share. What can be
;; checked without a window: a runtime with none (a daemon) never reaches the GUI backend
;; when it applies its colours, and a model starts with the live flags and init.blsp's
;; settings.

(defmodule startup-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use theme :only [*windowless-runtime*])
  (:use startup))

(describe "a runtime with no window of its own leaves the GUI backend alone"
  (test "gui-only calls nothing while windowless"
    ;; a daemon's palette called `gui/bg`, which starts the GUI backend's event thread, and a
    ;; theme's own fonts went to `gui/font-register`, which raises when that thread cannot
    ;; start: a displayless machine
    (assert= (binding (*windowless-runtime* true)
               (theme/gui-only (fn () (error "reached the window"))))
      nil))

  (test "with a window, gui-only calls through whenever the runtime has a GUI backend"
    (assert= (theme/gui-only (fn () :called)) (if (gui/available?) :called nil)))

  (test "a daemon applies a theme with its own font files without registering them"
    ;; registering a theme's font files reads them and hands them to the GUI backend: here
    ;; they do not exist, so reaching `gui/font-register` raises — and a daemon must not
    (themes/register-theme! {:name "startup-test fonts"
                             :palette theme/*theme-mocha*
                             :font :startup-test
                             :files {:regular "/nonexistent/startup-test.ttf"}})
    (assert= (apply-look {:theme "startup-test fonts"} false) nil)
    (themes/unregister-theme! "startup-test fonts")
    (apply-look {} false))

  (test "a theme name no theme has is a warning, windowless or not, never a raise"
    (is (includes? (apply-look {:theme "no-such-theme"} false) "no-such-theme"))
    (is (includes? (apply-look {:theme "no-such-theme"} true) "no-such-theme"))))

(describe "a font that is not installed is said, not silently replaced"
  (test "the GUI's :not-found names the font asked for and the one standing in"
    (let (warning (font-warning "No Such Mono"
                    {:origin :not-found :name "DejaVu Sans Mono" :requested "No Such Mono"}))
      (is (includes? warning "\"No Such Mono\" is not installed"))
      (is (includes? warning "using DejaVu Sans Mono"))
      (is (includes? warning (installed-fonts-hint (os/type))))))
  (test "the hint names what this OS lists its fonts with — fc-list is Linux's alone"
    (is (includes? (installed-fonts-hint :linux) "fc-list"))
    (is (includes? (installed-fonts-hint :macos) "Font Book"))
    (is (not (includes? (installed-fonts-hint :windows) "fc-list"))))
  (test "a font that resolved, from the system or from files, says nothing"
    (assert= (font-warning "Hack" {:origin :system :name "Hack"}) nil)
    (assert= (font-warning "Mine" {:origin :files :name "Mine"}) nil)
    (assert= (font-warning "Hack" {:origin :bundled :name "DejaVu Sans Mono"}) nil))
  (test "no font engine to ask — no GUI build, or a headless run — says nothing, never raises"
    (assert= (font-warning "Hack" nil) nil)
    (when (or (not (gui/available?)) (gui/headless?))
      (assert= (register-font "No Such Mono") nil))))

(describe "a model starts as the live editor's"
  (test "prepare-model sets the live flags and init.blsp's model settings"
    (let (m (prepare-model (ed-init (make-buffer "")) {:hl-line false :save-place false}))
      (assert= (:recent-files m) true)
      (assert= (:save-place m) false)
      (assert= (:hl-line m) false))))

(describe "a clean start: -Q, -q, --no-packages"
  (test "-Q leaves out the init file and the packages, -q the init file alone"
    (assert= (clean-start ["-Q" "notes.txt"]) {:no-init? true :no-packages? true})
    (assert= (clean-start ["-q"]) {:no-init? true :no-packages? false})
    (assert= (clean-start ["--no-init-file"]) {:no-init? true :no-packages? false})
    (assert= (clean-start ["--no-packages"]) {:no-init? false :no-packages? true})
    (assert= (clean-start ["notes.txt"]) {:no-init? false :no-packages? false}))

  (test "the file after a clean-start flag is still the file opened"
    (assert= (remote/remote-positional ["-Q" "notes.txt"]) "notes.txt")
    (assert= (remote/remote-positional ["-q" "-nw" "notes.txt"]) "notes.txt"))

  (test "a clean start says what it left out; a normal one says nothing"
    (assert= (clean-start-note (clean-start ["-Q"]))
      "a clean start: init.blsp and the installed packages not loaded")
    (assert= (clean-start-note (clean-start ["--no-packages"]))
      "a clean start: the installed packages not loaded")
    (assert= (clean-start-note (clean-start [])) nil))

  (test "-q reads no init file: every setting at its default"
    (assert= (read-init-for {:no-init? true}) {:config {} :note nil}))

  (test "-Q loads no packages and checks no init file"
    (let (me (self))
      (load-packages-later {:font-size "huge"}
        (fn (level line) (send me [:said level line]))
        {:no-init? true :no-packages? true})
      (assert= (receive ([:said _level line] line) (after 1600 :nothing-said)) :nothing-said))))

(describe "what startup found wrong is said in the echo area"
  (test "one line counts the problems and points at *Messages*"
    (assert= (problems-summary 1 0) "init.blsp has a problem — see *Messages*")
    (assert= (problems-summary 2 3)
      "init.blsp has 2 problems and 3 packages did not load — see *Messages*")
    (assert= (problems-summary 0 1) "a package did not load — see *Messages*")
    (assert= (problems-summary 0 0) nil))

  (test "a per-mode key naming no mode is warned of, then summed up"
    (let (me (self))
      (load-packages-later {:show-whitespace {:pyhton true}}
        (fn (level line) (send me [:said level line]))
        {:no-packages? true})
      (let (said (letrec (collect (fn (acc)
                                    (receive
                                      ([:said :summary line] (conj acc [:summary line]))
                                      ([:said level line] (collect (conj acc [level line])))
                                      (after 4000 acc))))
                   (collect [])))
        (is (any? said (fn ([level line]) (and (= level :warn) (includes? line "pyhton")))))
        (assert= (last said) [:summary "init.blsp has a problem — see *Messages*"])))))
