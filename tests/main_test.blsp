;; Tests for the editor. The pane loop (`ui-run`) needs a display, so it's not
;; tested here; we test the pure pieces exactly as they run in the loop:
;; `ed-update` (key + model -> model, via the keymap / minibuffer), the model
;; accessors, `message`, the C-x C-e eval command, the region/undo/buffer commands,
;; and `ed-view` (model -> render frame). These run under plain `nest test` — no GUI
;; build needed (but the eval tests need a `nest` whose prelude has `with-out-str`).
(defmodule main-test
  (:use model)  ; ed-init / ed-scroll / message / current-buffer accessors
  (:use input)  ; ed-update
  (:use view)  ; ed-view
  (:use commands)  ; ed-has-editable? / the editor commands
  (:use mincomplete)  ; ed-complete-name / ed-complete-path (minibuffer completion)
  (:use panes)  ; ed-body-layout / *wheel-lines* (pane geometry, mouse)
  (:use complete)  ; completion-at-point
  (:use web)  ; web-snapshot / web-render-app / web-render-page — the buffer web mirror (C-x w)
  (:use main)  ; start-logging — the supervised logger
  (:use supervisor)  ; stop-supervisor — teardown in the logger-supervision test
  (:use buffer)
  (:use test))

(purge-stale-temp "myedit-")  ; drop fixtures a prior run left in /tmp (at load)

;; A model over a fresh buffer of `text`, the starting point for edits.
(defn m-of (text) (ed-init (make-buffer text)))
;; The current (active) buffer of a model.
(defn cur (m) (ed-current-buf m))
;; The current buffer's text after folding key `k` into a model over `text`.
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
;; Fold a sequence of keys into a model — for chords like [:ctrl-x :ctrl-e].
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
;; Type a string into a model one printable key at a time (for the minibuffer).
(defn type-str (m s) (press m (string->list s)))

(describe "editor edits"
  (test "a printable key inserts at point"
    (assert= (after "ac" "b") "bac"))  ; point starts at 0
  (test "Enter splits the line at point"
    (let (m (ed-update (ed-set-buf (m-of "abcd") (goto-char (cur (m-of "abcd")) 2)) :enter 80 24))
      (assert= (buffer-text (cur m)) "ab\ncd")))
  (test "Backspace deletes the char before point"
    (let (m (ed-update (ed-set-buf (m-of "") (forward-char (make-buffer "abc") 2)) :backspace 80 24))
      (assert= (buffer-text (cur m)) "ac")))
  (test "Delete removes the char after point"
    (assert= (after "abc" :delete) "bc"))
  (test "a tick leaves the buffer unchanged"
    (assert= (after "hello" :tick) "hello"))
  (test "a resize event is a no-op on content (re-render only, echo preserved)"
    (let (m (message (m-of "hello") "note")
          r (ed-update m [:resize 100 30] 80 24))
      (assert= (buffer-text (cur r)) "hello")
      (assert= (get r :echo) "note"))))  ; resize doesn't clear the echo

(describe "editor movement"
  (test "Right then a key inserts one char over"
    (assert= (buffer-text (cur (press (m-of "ac") [:right "b"]))) "abc"))
  (test "C-f then a key inserts one char over (Emacs binding)"
    (assert= (buffer-text (cur (press (m-of "ac") [:ctrl-f "b"]))) "abc"))
  (test "Down (and C-n) move point to the next line"
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :down 80 24))) 1)
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :ctrl-n 80 24))) 1))
  (test "M-f / M-b move by word"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:alt-f]))) 3)  ; end of "foo"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:end :alt-b]))) 4))  ; start of "bar"
  (test "M-> / M-< jump to buffer end / start"
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->")]))) 7)  ; end of buffer
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->") (keyword "alt-<")]))) 0))
  (test "C-v / PageDown scroll forward a screenful, M-v / PageUp back"
    ;; rows=24 -> view-rows=22 -> a page step of 21 lines, over a 31-line buffer
    (let (text (apply str (map (fn (i) (str "L" i "\n")) (range 30)))
          down (ed-update (m-of text) :ctrl-v 80 24)
          back (ed-update down :alt-v 80 24)
          pgdn (ed-update (m-of text) :page-down 80 24))
      (assert= (buffer-current-line (cur down)) 21)
      (assert= (buffer-current-line (cur back)) 0)
      (assert= (buffer-current-line (cur pgdn)) 21))))  ; PageDown == C-v

(describe "key repeat (held-key, off the GUI down/up pair)"
  ;; A model whose frontend reports key releases (`:gui-keys`) — set in reality by the
  ;; first `[:key-up]` the GUI sends; here we pre-set it to exercise repeat directly.
  (defn gui-m (text) (assoc (m-of text) :gui-keys true))
  (test "a key-up marks the frontend release-capable (:gui-keys)"
    (is (get (ed-update (m-of "x") [:key-up "x"] 80 24) :gui-keys)))
  (test "a repeatable key-down moves once, arms held-key, and shortens the tick"
    (let (m (ed-update (gui-m "a\nb\nc\nd") :ctrl-n 80 24))
      (assert= (buffer-current-line (cur m)) 1)         ; the down itself moved once
      (assert= (get m :held-key) :ctrl-n)
      (assert= (get m :tick-ms) *repeat-delay-ms*)))     ; initial delay before repeat
  (test "a tick while held re-issues the key at the faster repeat rate"
    (let (m1 (ed-update (gui-m "a\nb\nc\nd\ne") :ctrl-n 80 24)   ; line 1
          m2 (ed-update m1 :tick 80 24)                          ; line 2
          m3 (ed-update m2 :tick 80 24))                         ; line 3
      (assert= (buffer-current-line (cur m2)) 2)
      (assert= (buffer-current-line (cur m3)) 3)
      (assert= (get m3 :tick-ms) *repeat-rate-ms*)))
  (test "key-up stops the repeat: held-key cleared, idle tick restored, ticks inert"
    (let (m1 (ed-update (gui-m "a\nb\nc") :ctrl-n 80 24)
          m2 (ed-update m1 [:key-up :ctrl-n] 80 24)
          m3 (ed-update m2 :tick 80 24))
      (is (nil? (get m2 :held-key)))
      (assert= (get m2 :tick-ms) *idle-tick-ms*)
      (assert= (buffer-current-line (cur m3)) (buffer-current-line (cur m2)))))
  (test "key-up matches modifier-insensitively (the modifier released before the key)"
    (let (m1 (ed-update (gui-m "a\nb\nc") :ctrl-n 80 24)
          m2 (ed-update m1 [:key-up "n"] 80 24))            ; Ctrl already up, bare n released
      (is (nil? (get m2 :held-key)))))
  (test "a self-inserting key repeats too"
    (let (m (ed-update (gui-m "") "x" 80 24))
      (assert= (get m :held-key) "x")
      (assert= (buffer-text (cur (ed-update m :tick 80 24))) "xx")))
  (test "a prefix key does not arm repeat"
    (is (nil? (get (ed-update (gui-m "x") :ctrl-x 80 24) :held-key))))
  (test "losing focus (:blur) stops the repeat — the missed-key-up safety net"
    (let (m1 (ed-update (gui-m "a\nb\nc") :ctrl-n 80 24)
          m2 (ed-update m1 :blur 80 24)
          m3 (ed-update m2 :tick 80 24))
      (is (nil? (get m2 :held-key)))
      (assert= (get m2 :tick-ms) *idle-tick-ms*)
      (assert= (buffer-current-line (cur m3)) (buffer-current-line (cur m2)))))
  (test "without :gui-keys (terminal) a key never arms repeat, tick stays idle"
    (let (m (ed-update (m-of "a\nb\nc") :ctrl-n 80 24))
      (is (nil? (get m :held-key)))
      (assert= (get m :tick-ms) *idle-tick-ms*)))
  ;; The poll safety: ed--still-held? confirms via gui-held-key the key is still down
  ;; before a repeat tick, so a missed key-up can't run away. Here we can only exercise
  ;; the fallbacks (a real held-key poll needs a live window).
  (test "still-held? is true with no window (terminal/test fallback to events)"
    (is (input/ed--still-held? (m-of "x"))))
  (test "still-held? tolerates a poll error (unknown window) by falling back to true"
    (is (input/ed--still-held? (assoc (m-of "x") :window 999999 :held-key :ctrl-n)))))

(describe "editor quit + save (Emacs C-x chords)"
  (test "Esc does NOT quit — it's keyboard-escape-quit (cancel), an Emacs command"
    (let (m (ed-update (m-of "x") :escape 80 24))
      (is (not (get m :done)))                        ; the editor stays open
      (is (string-contains? (get m :echo) "quit"))))  ; just a cancel/echo, not exit
  (test "C-x C-c quits"
    (is (get (press (m-of "x") [:ctrl-x :ctrl-c]) :done)))
  (test "C-x C-s on a fileless buffer reports it can't save (no crash)"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-s]))
      (is (not (get m :done)))
      (is (string-contains? (get m :echo) "no file")))))

(describe "editor prefix keymap"
  (test "a prefix key (C-x) sets :pending and inserts nothing"
    (let (m (ed-update (m-of "") :ctrl-x 80 24))
      (is (not (nil? (get m :pending))))
      (assert= (buffer-text (cur m)) "")))
  (test "an undefined chord clears the prefix and reports it"
    (let (m (press (m-of "") [:ctrl-x "z"]))
      (is (nil? (get m :pending)))
      (is (string-contains? (get m :echo) "undefined")))))

(describe "editor undo / redo"
  (test "C-/ undoes the last insert"
    (assert= (buffer-text (cur (press (m-of "") ["a" "b" :ctrl-/]))) "a"))
  (test "C-x u also undoes"
    (assert= (buffer-text (cur (press (m-of "") ["a" "b" :ctrl-x "u"]))) "a"))
  (test "M-/ redoes an undone edit"
    (assert= (buffer-text (cur (press (m-of "") ["a" :ctrl-/ :alt-/]))) "a")))

(describe "editor region & kill ring"
  (test "C-SPC + move + C-w kills the region and fills the kill ring"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w]))
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-y yanks the most recently killed text"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w :end :ctrl-y]))
      (assert= (buffer-text (cur m)) "defabc")))
  (test "M-w copies the region without deleting it"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :alt-w]))
      (assert= (buffer-text (cur m)) "abcdef")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-w with no region is a no-op-with-message"
    (let (m (press (m-of "abc") [:ctrl-w]))
      (assert= (buffer-text (cur m)) "abc")
      (is (string-contains? (get m :echo) "no region")))))

(describe "editor multiple buffers"
  (test "a fresh model has the scratch buffer plus *Messages*"
    (let (m (m-of "hi"))
      (assert= (buffer-name (cur m)) "*scratch*")
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))))
  (test "C-x →/← cycle through buffers (wrapping)"
    (let (m1 (press (m-of "hi") [:ctrl-x :right]))
      (assert= (buffer-name (cur m1)) "*Messages*")
      (assert= (buffer-name (cur (press m1 [:ctrl-x :right]))) "*scratch*")))
  (test "switching buffers preserves each buffer's point"
    (let (m (press (m-of "hello") [:right :right])
           ; point 2 in *scratch*
           back
           (press m [:ctrl-x :right :ctrl-x :left]))
      ; to *Messages* and back
      (assert= (buffer-point (cur back)) 2)))
  (test "*Messages* cannot be killed"
    (let (m (press (m-of "x") [:ctrl-x :right :ctrl-x "k"]))
      ; on *Messages*, try kill
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))
      (is (string-contains? (get m :echo) "cannot kill"))))
  (test "killing the last editable buffer leaves a fresh *scratch* and selects it"
    (let (m (press (m-of "x") [:ctrl-x "k"]))
      ; kill the only editable buffer
      (is (ed-has-editable? (get m :buffers)))
      (is (< (ed-current-index m) (count (get m :buffers))))
      (assert= (buffer-name (cur m)) "*scratch*")  ; lands on the new scratch, not *Messages*
      (assert= (buffer-text (cur m)) "")))
  (test "switching buffers clears the stale per-model status"
    ;; edit (status -> "modified"), then switch; the new buffer isn't modified
    (let (m (press (m-of "x") ["z" :ctrl-x :right]))
      (assert= (get m :status) ""))))

(describe "editor minibuffer (switch-buffer & find-file)"
  (test "C-x b switches to a buffer by name via the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b"]))
      ; open the minibuffer
      (is (not (nil? (get m :minibuffer))))
      (let (done (ed-update (type-str m "*Messages*") :enter 80 24))
        (is (nil? (get done :minibuffer)))
        (assert= (buffer-name (cur done)) "*Messages*"))))
  (test "C-g aborts the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b" :ctrl-g]))
      (is (nil? (get m :minibuffer)))
      (assert= (buffer-name (cur m)) "*scratch*")))
  (test "C-x C-f opens an existing file into a new buffer"
    (let (path (str (temp-dir "myedit-") ".txt")
          _ (spit path "from disk\n")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m
               :minibuffer
               (assoc (get m :minibuffer)
                 :edit
                 (ed-mb-set-text (get (get m :minibuffer) :edit) path)))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "from disk\n")
      (assert= (buffer-file (cur done)) path)))
  (test "C-x C-f on a new path starts an empty file-backed buffer"
    (let (path (str (temp-dir "myedit-new-") ".txt")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m
               :minibuffer
               (assoc (get m :minibuffer)
                 :edit
                 (ed-mb-set-text (get (get m :minibuffer) :edit) path)))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "")
      (assert= (buffer-file (cur done)) path))))

(describe "editor completion helpers"
  (test "ed-complete-name returns the sole match"
    (assert= (ed-complete-name "*M" ["*scratch*" "*Messages*"]) "*Messages*"))
  (test "ed-complete-name returns the common prefix of several matches"
    (assert= (ed-complete-name "f" ["foo" "foobar" "fizz"]) "f"))  ; 'foo'/'fizz' share only 'f'
  (test "ed-complete-path completes a unique filename in a directory"
    (let (d (temp-dir "myedit-dir-")
          _ (make-dir d)
          _ (spit (str d "/unique-file.txt") "x"))
      (assert= (ed-complete-path (str d "/uni")) (str d "/unique-file.txt")))))

(describe "editor messages"
  (test "message sets the one-line echo and appends to *Messages*"
    (let (m (message (m-of "x") "hi\nthere")
          msgs (nth (get m :buffers) (ed-buffer-index-by-name m "*Messages*")))
      (assert= (get m :echo) "hi there")  ; newlines flattened for the echo area
      (is (string-contains? (buffer-text msgs) "hi"))))
  (test "message leaves the current buffer's point untouched"
    (let (m (message (press (m-of "hello") [:right :right]) "note"))
      (assert= (buffer-point (cur m)) 2)))
  (test "the *Messages* buffer does not accumulate undo history"
    (let (m (-> (m-of "x") (message "one") (message "two") (message "three"))
          msgs (nth (get m :buffers) (ed-buffer-index-by-name m "*Messages*")))
      (assert= (get msgs :undo) ()))))

;; eval-last-sexp evals the form *before point*, so put point at end of buffer
;; first (as it naturally is after typing the form) before the C-x C-e chord. Eval
;; now runs off the loop via `std/task` (so a long form can't freeze the editor): the
;; command returns an "evaluating…" model and the task delivers `[:task-done <handle>
;; msg]` (or `[:task-timeout <handle>]`) back. `eval-spawn` is just the C-x C-e
;; (returns immediately); `eval-result` receives the task's reply and folds it in;
;; `eval-buf` is the round-trip.
(defn eval-spawn (text)
  (press (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) [:ctrl-x :ctrl-e]))
(defn eval-result (m) (ed-update m (receive (x x)) 80 24))
(defn eval-buf (text) (eval-result (eval-spawn text)))

(describe "editor eval-last-sexp (C-x C-e)"
  (test "evaluates the form before point and shows the value"
    (is (string-contains? (get (eval-buf "(+ 1 2)") :echo) "=> 3")))
  (test "evaluates a multi-line form, not just the current line"
    (is (string-contains? (get (eval-buf "(+ 1\n   2\n   3)") :echo) "=> 6")))
  (test "evaluates the LAST form before point when several precede it"
    (is (string-contains? (get (eval-buf "(+ 1 1)\n(+ 2 2)") :echo) "=> 4")))
  (test "captures printed output into the message area (not the console)"
    (let (m (eval-buf "(println \"foo\")"))
      (is (string-contains? (get m :echo) "foo"))
      (is (string-contains? (get m :echo) "=> nil"))))
  (test "a def persists, so you can define then call across evals"
    ;; define on one model, then call from another — globals persist in the image
    (let (_ (eval-buf "(defn myedit-demo-greet () (println \"hi-from-demo\"))"))
      (is (string-contains? (get (eval-buf "(myedit-demo-greet)") :echo) "hi-from-demo"))))
  (test "an eval error is reported, not raised"
    (let (m (eval-buf "(this-is-not-defined)"))
      (is (not (get m :done)))
      (is (string-contains? (get m :echo) "error"))))
  (test "cmd-eval-buffer evaluates the whole buffer"
    (is (string-contains? (get (eval-result (cmd-eval-buffer (m-of "(+ 4 5)") nil)) :echo) "=> 9")))
  (test "cmd-eval-region evaluates the region between point and mark"
    (let (b (-> (make-buffer "(+ 2 3)") set-mark end-of-buffer)
           ; mark 0, point 7 → region is the whole form
           m
           (ed-set-buf (m-of "") b))
      (is (string-contains? (get (eval-result (cmd-eval-region m nil)) :echo) "=> 5"))))
  (test "eval runs in a separate process — the command returns immediately (no freeze)"
    ;; the C-x C-e command must return *without* running the form, so a slow/looping
    ;; form can't block the ui-run loop; it leaves an 'evaluating…' note and spawns.
    (let (m (eval-spawn "(+ 1 2)"))
      (is (string-contains? (get m :echo) "evaluating"))
      (is (not (get m :done)))
      (is (not (nil? (get m :eval-proc))))))  ; the eval process is tracked for interrupt

  ;; ---- safeguards: C-g interrupt + optional timeout ----
  (test "C-g interrupts a running eval — kills its process and clears :eval-proc"
    ;; eval a form that parks ~100s; C-g must kill it instantly (not wait).
    (let (running (eval-spawn "(receive (after 100000 nil))")
          done (cmd-keyboard-quit running nil))
      (is (string-contains? (get done :echo) "interrupted"))
      (is (nil? (get done :eval-proc)))))
  (test "C-g with no eval in flight is a plain quit"
    (is (string-contains? (get (cmd-keyboard-quit (m-of "x") nil) :echo) "quit")))
  (test "an optional timeout kills a runaway eval and reports it"
    ;; arm a 50ms timeout on a form that would otherwise park ~100s; the watchdog
    ;; fires, kills the eval, and reports the timeout (received via eval-result).
    (let (m (eval-result (ed-eval-async (m-of "x") "(receive (after 100000 nil))" 50)))
      (is (string-contains? (get m :echo) "timed out")))))

;; ---- read-only buffers (the std/buffer flag, enforced editor-wide) ----------
(describe "editor read-only buffers"
  ;; a model whose current buffer is read-only
  (defn ro-model (text) (ed-set-buf (m-of text) (set-read-only (cur (m-of text)) true)))
  (test "a printable key into a read-only buffer is refused and reported"
    (let (m (ed-update (ro-model "abc") "x" 80 24))
      (assert= (buffer-text (cur m)) "abc")  ; unchanged
      (is (string-contains? (get m :echo) "read-only"))))
  (test "Backspace / Delete into a read-only buffer are refused"
    (assert= (buffer-text (cur (ed-update (ro-model "abc") :backspace 80 24))) "abc")
    (assert= (buffer-text (cur (ed-update (ro-model "abc") :delete 80 24))) "abc"))
  (test "movement still works in a read-only buffer (navigable, just not editable)"
    (assert= (buffer-point (cur (press (ro-model "foo bar") [:alt-f]))) 3)  ; end of "foo"
    (assert= (buffer-point (cur (ed-update (ro-model "ab\ncd") :down 80 24))) 3))  ; next line
  (test "the mode line shows an RO marker for a read-only buffer"
    (let (frame (ed-view (ro-model "abc") 80 24))
      (is (string-contains? (pr-str frame) "RO ")))))

;; ---- the *Process List* (M-x list-processes) + the process-menu mode ---------
(describe "editor process list + process-menu mode"
  (test "list-processes opens a read-only *Process List* in process-menu mode"
    (let (m (cmd-list-processes (m-of "x") nil)
          buf (cur m))
      (assert= (buffer-name buf) "*Process List*")
      (is (read-only? buf))                       ; the :activate hook flipped it
      (assert= (ed-buf-mode-name buf) "process-menu")
      (is (string-contains? (buffer-text buf) "ID"))))   ; the header row
  (test "ed--line-id parses a row's id and skips the header"
    (assert= (commands/ed--line-id "7    worker  running  0  42") 7)
    (assert= (commands/ed--line-id "ID   NAME    STATUS") nil)
    (assert= (commands/ed--line-id "") nil))
  (test "ed--pid-for-id resolves a live process's id to its pid (nil when none)"
    (let (pid (spawn (receive (after 100000 nil)))
          id (get (process-info pid) :id))
      (assert= (commands/ed--pid-for-id id) pid)
      (assert= (commands/ed--pid-for-id 999999999) nil)
      (exit pid :kill)))
  (test "kill (d) on a process row kills that process and reports it"
    (let (pid (spawn (receive (after 100000 nil)))
          mref (monitor pid)                          ; to confirm death deterministically
          id (get (process-info pid) :id)
          m (cmd-list-processes (m-of "x") nil)
          buf (cur m)
          ;; put point on the spawned process's row, then press the kill command
          ln (find (fn (l) (= (commands/ed--line-id (buffer-line-at buf l)) id))
               (range (buffer-line-count buf)))
          on-row (ed-set-buf m (goto-char buf (rope-line->char (buffer-rope buf) ln)))
          killed (cmd-process-menu-kill on-row nil))
      (is (not (nil? ln)))                                  ; the row was found
      (is (string-contains? (get killed :echo) (str "killed process " id)))
      ;; the monitor fires only because the process actually died from the kill
      (assert= (receive ([:down ~mref _ _] :killed) (after 2000 :timeout)) :killed)))
  (test "kill off a process row (the header) is a no-op with a message"
    (let (m (cmd-list-processes (m-of "x") nil)   ; point at 0 = the header row
          r (cmd-process-menu-kill m nil))
      (is (string-contains? (get r :echo) "not on a process line"))))
  (test "the list defaults to the tree view; t toggles tree <-> flat"
    (let (m (cmd-list-processes (m-of "x") nil)            ; default :tree
          flat (cmd-process-menu-toggle-tree m nil)
          back (cmd-process-menu-toggle-tree flat nil))
      (assert= (ed-proc-view m) :tree)
      (assert= (ed-proc-view flat) :flat)
      (is (string-contains? (get flat :echo) "flat"))
      (assert= (ed-proc-view back) :tree)
      (is (string-contains? (get back :echo) "tree"))))
  (test "tree and flat views render differently, and ids stay parseable in tree view"
    (let (child (spawn (receive (after 100000 nil)))   ; spawned by the test process → a child
          id (get (process-info child) :id)
          tree (ed-process-list-text :tree)
          flat (ed-process-list-text :flat))
      ;; the view arg has an effect (lineage re-order + indent vs. id sort)
      (is (not (= tree flat)))
      ;; the header is present in both, and the id column stays flush-left in tree view
      (is (string-contains? tree "ID"))
      (is (= (commands/ed--pid-for-id id) child))   ; resolvable → still a real, killable row
      (exit child :kill))))

;; ---- the supervised logger (killing it from the process list restarts it) ----
(describe "editor logger supervision"
  :isolated
  ;; Poll for a :logger pid different from `other` (nil = any) — both the initial
  ;; start (the supervisor inits its child concurrently) and the restart are async.
  (defn await-logger (other tries)
    (let (p (whereis :logger))
      (cond
        (and (not (nil? p)) (not (= p other))) p
        (<= tries 0) nil
        else (do (sleep 5) (await-logger other (dec tries))))))
  (test "hard-killing the logger restarts it under a fresh pid"
    (register :editor (self))            ; start-logging's backend targets :editor
    (let (sup (start-logging)
          p1 (await-logger nil 200))     ; the logger is up
      (is (not (nil? p1)))
      (exit p1 :kill)                    ; hard kill, exactly as the *Process List* d/x/k does
      (let (p2 (await-logger p1 200))    ; <= ~1s for the supervisor to restart it
        (is (not (nil? p2)))             ; it came back…
        (is (not (= p1 p2))))            ; …as a fresh incarnation
      (stop-supervisor sup))))

(describe "editor completion-at-point"
  ;; a model whose current buffer is `text` with point at `p`
  (defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))
  (test "completion-candidates: distinct buffer words by prefix, sorted"
    (assert= (completion-candidates (cm "for foreach for fold" 0) "fo")
      (list "fold" "for" "foreach")))
  (test "Tab with a single candidate inserts it directly (no popup)"
    (let (m (cmd-complete (cm "alpha al" 8) nil))
      (is (nil? (get m :completion)))
      (assert= (buffer-text (cur m)) "alpha alpha")))
  (test "Tab with several candidates opens a popup (fuzzy-ranked, shortest-first on a tie)"
    (let (c (get (cmd-complete (cm "alpha alps al" 13) nil) :completion))
      (is (not (nil? c)))
      (assert= (get c :items) (list "alps" "alpha"))  ; equal score → shorter first
      (assert= (get c :index) 0)))
  (test "Tab with no candidate reports it; an empty prefix is a no-op"
    (is (string-contains? (get (cmd-complete (cm "zzz q" 5) nil) :echo) "no completions"))
    (is (string-contains? (get (cmd-complete (cm "abc" 0) nil) :echo) "nothing to complete")))
  (test "C-n moves the selection and Enter accepts it"
    (let (m (cmd-complete (cm "alpha alps al" 13) nil)
          done (complete-handle (complete-handle m :ctrl-n) :enter))
      ; items are ("alps" "alpha"); C-n → "alpha", accept
      (is (nil? (get done :completion)))
      (assert= (buffer-text (cur done)) "alpha alps alpha")))
  (test "typing a word-char narrows the open popup live (Corfu-style)"
    (let (m (cmd-complete (cm "alpha alps al" 13) nil)  ; popup: alps, alpha
          narrowed (complete-handle m "p"))             ; prefix "alp" — both still match
      (assert= (buffer-text (cur narrowed)) "alpha alps alp")
      (is (not (nil? (get narrowed :completion))))      ; popup stays open
      (assert= (get (get narrowed :completion) :prefix) "alp")
      (assert= (count (get (get narrowed :completion) :items)) 2)))
  (test "a printable key dismisses the popup and inserts (through ed-update)"
    (let (m (ed-update (cm "alpha alps al" 13) :tab 80 24)
           ; Tab opens the popup
           m2
           (ed-update m "x" 80 24))
      ; 'x' dismisses + inserts
      (is (not (nil? (get m :completion))))
      (is (nil? (get m2 :completion)))
      (assert= (buffer-text (cur m2)) "alpha alps alx")))
  (test "complete-popup-ops: empty when closed, draws cells when open"
    (assert= (complete-popup-ops (m-of "x") 80 24) [])
    (let (ops (complete-popup-ops (cmd-complete (cm "alpha alps al" 13) nil) 80 24))
      (is (> (count ops) 0))
      (is (= (first (first ops)) :text))))
  (test "the popup never overruns a short pane (caps to the text area)"
    ;; 10 candidates for prefix \"a\", in a 5-row pane (text area = 3 rows)
    (let (m (cmd-complete (cm "aa ab ac ad ae af ag ah ai aj a" 31) nil)
          ops (complete-popup-ops m 80 5))
      (is (<= (count ops) 3))
      (is (every? (fn (op) (< (nth op 1) 3)) ops)))))  ; every row is inside the text area

(describe "editor scrolling"
  (test "the point line stays inside the viewport after moving past the bottom"
    (let (text "l0\nl1\nl2\nl3\nl4"
          m (ed-scroll (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) 2)
          line (buffer-current-line (cur m))
          top (ed-current-top m))
      (is (>= line top))
      (is (< line (+ top 2))))))

(describe "editor scrolling — margin, recenter, window-line (slick navigation)"
  ;; an N-line buffer (each line is its index); `at` puts point at line `ln`, view at `top`.
  (defn lines-of (n) (join "\n" (map str (range n))))
  (defn nav-at (text ln top) (ed-set-top (ed-set-buf (m-of text) (forward-line (make-buffer text) ln)) top))

  (test "scroll-margin: point within the bottom margin doesn't scroll, one past it does"
    (let (t (lines-of 50))
      ;; viewport 20, margin 4 → last comfortable line is top+20-1-4 = 15
      (assert= (ed-current-top (ed-scroll (nav-at t 15 0) 20)) 0)
      (assert= (ed-current-top (ed-scroll (nav-at t 16 0) 20)) 1)))
  (test "scroll-margin keeps context above point too"
    (assert= (ed-current-top (ed-scroll (nav-at (lines-of 50) 4 10) 20)) 0))
  (test "C-v scrolls the view with the page (preserve screen position); M-v round-trips point"
    (let (t (lines-of 50)
          m1 (ed-update (m-of t) :ctrl-v 80 24)
          m2 (ed-update m1 :alt-v 80 24))
      (is (> (ed-current-top m1) 0))                ; the view followed the page, not just point
      (assert= (buffer-current-line (cur m2)) 0)))  ; C-v then M-v returns to the start
  (test "C-l recenters point to the middle, then top, then bottom (cycling on repeat)"
    (let (t (lines-of 50)                            ; view-rows 22, margin 4
          mid (ed-update (nav-at t 30 0) :ctrl-l 80 24)
          tp  (ed-update mid :ctrl-l 80 24)
          bot (ed-update tp :ctrl-l 80 24))
      (assert= (- 30 (ed-current-top mid)) 11)       ; middle row (22/2)
      (assert= (- 30 (ed-current-top tp)) 4)         ; top + margin
      (assert= (- 30 (ed-current-top bot)) 17)))     ; bottom - margin
  (test "M-r moves point to window top, then middle, then bottom (cycling on repeat)"
    (let (t (lines-of 50)
          a (ed-update (nav-at t 0 10) :alt-r 80 24)
          b (ed-update a :alt-r 80 24)
          c (ed-update b :alt-r 80 24))
      (assert= (buffer-current-line (cur a)) 14)     ; top(10) + margin(4)
      (assert= (buffer-current-line (cur b)) 21)     ; top + rows/2
      (assert= (buffer-current-line (cur c)) 27)))   ; top + rows-1-margin
  (test "M-} / M-{ move by paragraph (blank-line delimited)"
    (let (t "aa\nbb\n\ncc\ndd"
          fwd (ed-update (m-of t) (keyword "alt-}") 80 24)
          back (ed-update fwd (keyword "alt-{") 80 24))
      (is (> (buffer-point (cur fwd)) 0))            ; advanced toward the blank separator
      (assert= (buffer-point (cur back)) 0)))        ; and back to the first paragraph
  (test "scrolling clamps at end-of-file (the last line never scrolls past the bottom)"
    ;; 50 lines, viewport 20, point on the last line → top can't exceed 50-20 = 30
    (assert= (ed-current-top (ed-scroll (nav-at (lines-of 50) 49 0) 20)) 30)))

(describe "editor view chrome — scroll indicator + scrollbar"
  (test "ed-scroll-pct: All / Top / Bot / NN%"
    (assert= (ed-scroll-pct 0 22 10) "All")     ; whole buffer fits
    (assert= (ed-scroll-pct 0 10 100) "Top")
    (assert= (ed-scroll-pct 90 10 100) "Bot")   ; last line visible
    (assert= (ed-scroll-pct 45 10 100) "50%"))
  (test "ed-scrollbar-ops draws one cell per row with a thumb at the top when at top"
    (let (ops (ed-scrollbar-ops (make-buffer (join "\n" (map str (range 100)))) 0 10 79 0))
      (assert= (count ops) 10)
      (is (every? (fn (op) (= (first op) :text)) ops))
      (is (string-contains? (nth (first ops) 3) "█"))     ; thumb block at row 0
      (is (string-contains? (nth (nth ops 9) 3) "│")))))   ; track below it

(describe "editor view"
  (test "the frame draws the first buffer line and places the cursor"
    (let (f (ed-view (m-of "hello\nworld") 80 24))
      (is (> (count (filter (fn (op)
                              (and (= (first op) :text)
                                (string-contains? (nth op 3) "hello")))
                      f))
            0))
      (is (> (count (filter (fn (op) (= (first op) :cursor)) f)) 0))))
  (test "an active region is drawn reverse-video"
    ;; region [0,3) over "abcdef" → a reverse-video op carrying "abc" (the mode
    ;; line is reverse too, so match on the region's text to be specific).
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right])
          f (ed-view m 80 24)
          region-ops (filter (fn (op)
                               (and (= (first op) :text)
                                 (= (nth op 4 nil) {:reverse true})
                                 (string-contains? (nth op 3 "") "abc")))
                       f))
      (is (> (count region-ops) 0))))
  (test "a model :overlay is drawn with its face (the isearch/query-replace highlight)"
    (let (m (assoc (m-of "abcdef") :overlays [{:start 0 :end 3 :face {:bg :yellow :fg :black}}])
          f (ed-view m 80 24)
          hl-ops (filter (fn (op)
                           (and (= (first op) :text)
                             (= (nth op 4 nil) {:bg :yellow :fg :black})
                             (string-contains? (nth op 3 "") "abc")))
                   f))
      (is (> (count hl-ops) 0))))
  (test "an open minibuffer is rendered on the bottom row"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-f])
          f (ed-view m 80 24)
          mb-ops (filter (fn (op)
                           (and (= (first op) :text)
                             (string-contains? (nth op 3 "") "Find file:")))
                   f))
      (is (> (count mb-ops) 0))))
  (test "the mode line is a full-width bar (so it tracks a horizontal resize)"
    ;; the reverse-video op is the mode line (no region here); its text spans the
    ;; whole width at any size — clipped when narrow, space-padded when wide.
    (let (ml-width (fn (cols)
                     (string-length (nth (first (filter (fn (op)
                                                          (and (= (first op) :text)
                                                            (= (nth op 4 nil) {:reverse true})))
                                                  (ed-view (m-of "hi") cols 24)))
                                      3))))
      (assert= (ml-width 80) 80)
      (assert= (ml-width 150) 150))))  ; padded out to the full width

;; brood-mode: a .blsp buffer stacks structural sexp nav (C-M-*) on top of
;; text-mode; the trigger is the mode's :file-pattern regex ("\.blsp$").
(describe "editor brood-mode (.blsp files)"
  (defn blsp-model (text) (ed-init (make-buffer text "x.blsp" "x.blsp")))

  (test "C-M-f navigates structurally over a whole form in a .blsp buffer"
    (assert= (buffer-point (cur (ed-update (blsp-model "(+ 1 2)") :ctrl-meta-f 80 24))) 7))

  (test "C-M-SPC (mark-sexp) marks the next sexp, leaving point — and extends on repeat"
    (let (m1 (cmd-mark-sexp (blsp-cm "(+ 1) (a)" 0) nil)
          m2 (cmd-mark-sexp (assoc m1 :last-command 'commands/cmd-mark-sexp) nil))
      (assert= (buffer-point (cur m1)) 0)    ; point stays put
      (assert= (buffer-mark (cur m1)) 5)     ; mark at end of "(+ 1)"
      (assert= (buffer-mark (cur m2)) 9)))   ; repeat extends over " (a)"

  (test "C-M-d / C-M-u descend into and back out of a list"
    (let (down (ed-update (blsp-model "(a b)") :ctrl-meta-d 80 24))
      ; into the list
      (assert= (buffer-point (cur down)) 1)
      (assert= (buffer-point (cur (ed-update down :ctrl-meta-u 80 24))) 0)))  ; back out

  (test "text-mode bindings still work in a .blsp buffer (brood stacks on text)"
    (assert= (buffer-text (cur (press (blsp-model "ac") [:right "b"]))) "abc"))

  (test "a non-.blsp buffer has no structural nav (C-M-f unbound → no-op)"
    (assert= (buffer-point (cur (ed-update (m-of "(+ 1 2)") :ctrl-meta-f 80 24))) 0))

  (test "the trigger is an anchored regex — x.blsp.txt is NOT brood-mode"
    (let (m (ed-update (ed-init (make-buffer "(+ 1 2)" "x.blsp.txt" "x.blsp.txt"))
              :ctrl-meta-f
              80
              24))
      (assert= (buffer-point (cur m)) 0))))

;; ---- brood-mode REPL-style services (highlight / brackets / eldoc / completion)
;; The view/completion stay language-agnostic: they ask the buffer's mode for
;; :fontify / :bracket-match / :eldoc / :complete-at via `ed-mode-service`, and
;; brood-mode supplies brood implementations over `std/highlight.blsp`. A `.blsp`
;; buffer thus gains the same live feedback the REPL editor has.

;; A model whose current buffer is a brood-mode (.blsp) buffer of `text`, point at `p`.
(defn blsp-cm (text p)
  (let (m (ed-init (make-buffer text "x.blsp" "x.blsp")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))
;; The :text ops of a frame whose drawn string satisfies `pred`.
(defn text-ops-where (f pred)
  (filter (fn (op) (and (= (first op) :text) (pred (nth op 3 "")))) f))

(describe "editor brood-mode: syntax highlighting"
  (test "a .blsp buffer is syntax-coloured — `defn` carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (blsp-cm "(defn f ())" 0) 80 24) (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a plain (non-brood) buffer is NOT coloured — the line is one faceless op"
    (let (ops (text-ops-where (ed-view (m-of "(defn f ())") 80 24)
                (fn (s) (string-contains? s "defn"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nil? (nth op 4 nil))) ops))))
  (test "the active region merges :reverse into the lexer face (still coloured)"
    ;; region [0,4) over "(map f)" covers the call head `map`; its chunk keeps its
    ;; :fg and gains :reverse.
    (let (m (press (blsp-cm "(map f)" 0) [(keyword "ctrl- ") :right :right :right :right])
          merged (filter (fn (op)
                           (and (= (first op) :text)
                             (= (get (nth op 4 {}) :reverse) true)
                             (not (nil? (get (nth op 4 {}) :fg)))))
                   (ed-view m 80 24)))
      (is (> (count merged) 0)))))

;; Highlighting only the visible window (not the whole buffer) is what keeps a large
;; file responsive. These prove the windowed fontify (ed-window-spans) colours the
;; visible lines correctly at deep scroll offsets — i.e. spans land in *absolute*
;; coordinates, not slice-local ones — even past the backscan lead-in.
(describe "editor brood-mode: windowed fontification (large files)"
  ;; N lines of `(defn fK ())`; N exceeds the backscan lead-in so a deep scroll
  ;; exercises the rope-slice window rather than lexing from the top.
  (defn big-blsp (n) (join "\n" (map (fn (i) (str "(defn f" i " ())")) (range n))))

  (test "a token deep past the backscan window is still coloured"
    (let (ops (text-ops-where (ed-view (ed-set-top (blsp-cm (big-blsp 400) 0) 300) 80 24)
                (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (not (nil? (nth op 4 nil)))) ops))))

  (test "the deep token's face matches the same token at the top (absolute offsets correct)"
    (let (txt (big-blsp 400)
          face-at (fn (m) (nth (first (text-ops-where (ed-view m 80 24)
                                        (fn (s) (= s "defn")))) 4 nil))
          top-face (face-at (blsp-cm txt 0))
          deep-face (face-at (ed-set-top (blsp-cm txt 0) 300)))
      (is (not (nil? deep-face)))
      (assert= deep-face top-face)))

  (test "ed-window-spans returns spans in absolute coordinates"
    ;; a window of just line 2 of a 3-line buffer: the call head `c` at offset 9 is
    ;; coloured in absolute (not slice-local) coordinates.
    (let (buf (ed-current-buf (blsp-cm "(a)\n(b)\n(c)" 0))
          spans (ed-window-spans buf
                  (ed-mode-service buf :fontify)
                  (ed-mode-service buf :fontify-restart)
                  2 1))
      (is (includes? spans [9 10 {:fg :cyan}])))))

(describe "editor brood-mode: bracket matching"
  (test "the bracket adjacent to point marks its match (reverse-video pair)"
    ;; point at 1 sits just after the opening paren of "(+ 1 2)"; its match is the
    ;; closing paren — both painted in the reverse-video match face.
    (let (f (ed-view (blsp-cm "(+ 1 2)" 1) 80 24)
          paren-ops (filter (fn (op)
                              (and (= (first op) :text)
                                (= (nth op 3 "") "(")
                                (= (nth op 4 nil) {:reverse true})))
                      f))
      (is (> (count paren-ops) 0))))
  (test "no bracket overrides when point isn't next to a bracket"
    (assert= (ed-bracket-overrides (ed-current-buf (blsp-cm "(+ 1 2)" 3))) '())))

(describe "editor brood-mode: eldoc signature hints"
  (test "eldoc shows the enclosing call's signature when the echo is idle"
    (is (string-contains? (ed-echo-or-eldoc (blsp-cm "(map f)" 4)) "map")))
  (test "an explicit message suppresses eldoc for that frame"
    (assert= (ed-echo-or-eldoc (message (blsp-cm "(map f)" 4) "hello")) "hello"))
  (test "no eldoc in a plain (non-brood) buffer"
    (assert= (ed-echo-or-eldoc (m-of "(map f)")) "")))

(describe "editor brood-mode: symbol completion"
  (test "Tab in a .blsp buffer completes live global symbols, not buffer words"
    ;; "(def" → many globals (defn, defmacro, …); the popup's items include `defn`,
    ;; which is NOT a word present in the buffer (so this proves the global source).
    (let (c (get (cmd-complete (blsp-cm "(def" 4) nil) :completion))
      (is (not (nil? c)))
      (is (includes? (get c :items) "defn"))))
  (test "a plain buffer still completes buffer words (default source unchanged)"
    (let (m (cmd-complete (ed-set-buf (m-of "") (goto-char (make-buffer "alpha al") 8)) nil))
      (assert= (buffer-text (cur m)) "alpha alpha"))))

(describe "editor brood-mode: indentation (matches nest format)"
  ;; brood-indent text bol -> column, computed purely over the CST (std/sexp).
  ;; The canonical Brood style (std/format): bodies indent +2 from the open
  ;; delimiter; maps and let-bindings lists align under the first element.
  (test "top level → column 0"
    (assert= (modes/brood-indent "(a)\n(b)" 4) 0))
  (test "a body form (defn) indents its body +2 from the open paren"
    (assert= (modes/brood-indent "(defn f ()\nx)" 11) 2))
  (test "let body indents +2"
    (assert= (modes/brood-indent "(let (a 1)\nb)" 11) 2))
  (test "a call indents its body +2 (not aligned under the first arg, per the formatter)"
    (assert= (modes/brood-indent "(foo bar\nbaz)" 9) 2))
  (test "a vector indents +2"
    (assert= (modes/brood-indent "[a\nb]" 3) 2))
  (test "a map aligns entries under the first element"
    (assert= (modes/brood-indent "{:a 1\n:b 2}" 6) 1))
  (test "a let-family bindings list aligns pairs under its first element"
    ;; "(let (a 1\nb 2) x)" — the `b` line is inside the bindings list; aligns under `a`
    (assert= (modes/brood-indent "(let (a 1\nb 2) x)" 10) 6))
  (test "an unclosed form at end-of-text still indents the new line (RET case)"
    ;; "(defn f ()\n" — point at EOF (offset 11) inside the unclosed defn → body +2
    (assert= (modes/brood-indent "(defn f ()\n" 11) 2))

  (test "cmd-indent-line reindents a .blsp line to its sexp column, keeping point"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\nx)" 11) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")
      (assert= (buffer-point (cur m)) 13)))  ; point was in the indent → first non-blank
  (test "cmd-indent-line removes over-indentation too"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\n      x)" 17) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))

  (test "RET in brood-mode inserts a newline and indents the new line"
    (let (m (ed-update (blsp-cm "(defn f ()" 10) :enter 80 24))
      (assert= (buffer-text (cur m)) "(defn f ()\n  ")
      (assert= (buffer-point (cur m)) 13)))
  (test "RET in a plain buffer is still a plain newline (no auto-indent)"
    (let (m (ed-update (ed-set-buf (m-of "  ab") (goto-char (make-buffer "  ab") 4)) :enter 80 24))
      (assert= (buffer-text (cur m)) "  ab\n")))

  (test "TAB indents a mis-indented line (no completion popup)"
    (let (m (ed-update (blsp-cm "(defn f ()\nx)" 11) :tab 80 24))
      (is (nil? (get m :completion)))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))
  (test "TAB on an already-indented line, point on a symbol, completes instead"
    ;; line already at col 2, point after "map" → complete (against live globals,
    ;; not buffer words): the popup opens with candidates that all start with "map".
    (let (m (ed-update (blsp-cm "(defn f ()\n  map" 16) :tab 80 24)
          items (get (get m :completion) :items))
      (is (not (nil? (get m :completion))))
      (is (> (count items) 0))
      (is (every? (fn (s) (starts-with? s "map")) items)))))

(describe "editor fallback indentation (no :indent service)"
  (test "cmd-indent-line matches the previous line's indentation in a plain buffer"
    (let (m (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "    foo\nbar") 8)) nil))
      (assert= (buffer-text (cur m)) "    foo\n    bar"))))

;; ---- in-process diagnostics (the :diagnostics service) ----------------------
;; brood-mode calls the advisory type checker directly (same image) via
;; check-string-structured; the warning is cached on edit and rendered inline /
;; in the echo / on the mode line. `(map cons …)` is a reliable warner: cons is
;; 2-ary, map calls it with 1 (ADR-078 callback-arity), flagged on line 1.
(def bad-src "(map cons (list 1 2 3))")

(describe "editor brood-mode: diagnostics service"
  (test "brood-diagnostics returns positioned warnings for a bad form"
    (let (ds (modes/brood-diagnostics bad-src))
      (is (> (count ds) 0))
      (assert= (get (first ds) :line) 1)
      (is (string? (get (first ds) :message)))))
  (test "brood-diagnostics is empty for clean or unparsable source"
    (is (empty? (modes/brood-diagnostics "(def x 1)")))
    (is (empty? (modes/brood-diagnostics "(")))))  ; incomplete input mid-edit

(describe "editor diagnostics cache (recompute only on text change)"
  (test "ed-refresh-diagnostics populates :diagnostics + :diag-text for a brood buffer"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1)))
      (is (> (count (get m :diagnostics)) 0))
      (assert= (get m :diag-text) bad-src)))
  (test "it is a no-op when the text is unchanged (cache hit on :diag-text)"
    ;; seed the cache, then re-run with the text unchanged but a sentinel in place —
    ;; an unchanged sentinel proves it didn't recompute.
    (let (m1 (ed-refresh-diagnostics (blsp-cm bad-src 1))
          m2 (ed-refresh-diagnostics (assoc m1 :diagnostics :sentinel)))
      (assert= (get m2 :diagnostics) :sentinel)))
  (test "a plain (non-brood) buffer has no :diagnostics service → left untouched"
    (is (nil? (get (ed-refresh-diagnostics (m-of "(map cons (list))")) :diagnostics))))
  (test "typing through ed-update surfaces a warning live — empty while incomplete"
    ;; drive the real keystroke path: an unbalanced prefix nags nothing; the
    ;; completed (ill-typed) form yields a cached diagnostic.
    (let (blank (ed-init (make-buffer "" "x.blsp" "x.blsp"))
          type (fn (m s) (fold (fn (acc c) (ed-update acc c 80 24)) m (string->list s))))
      (is (empty? (get (type blank "(map cons (list 1 2 3") :diagnostics)))  ; mid-type
      (is (> (count (get (type blank "(map cons (list 1 2 3))") :diagnostics)) 0)))))  ; complete

(describe "editor diagnostics rendering"
  (test "a diagnostic on the current line shows in the echo area (over eldoc)"
    (is (string-contains? (ed-echo-or-eldoc (ed-refresh-diagnostics (blsp-cm bad-src 1))) "warning")))
  (test "an explicit message still wins over a diagnostic"
    (assert= (ed-echo-or-eldoc (message (ed-refresh-diagnostics (blsp-cm bad-src 1)) "hi")) "hi"))
  (test "ed-diagnostic-overrides underlines each diagnostic token"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1))
          ovs (ed-diagnostic-overrides m (cur m)))
      (is (> (count ovs) 0))
      (assert= (second (first ovs)) {:underline true})))
  (test "ed-view underlines the diagnostic token (point off any bracket)"
    ;; point at 5 (inside `cons`) sits next to no bracket, so the diagnostic
    ;; underline at the call isn't shadowed by bracket-match.
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 5))
          underlined (filter (fn (op) (and (= (first op) :text) (get (nth op 4 {}) :underline)))
                       (ed-view m 80 24)))
      (is (> (count underlined) 0))))
  (test "the mode line shows the diagnostic count"
    (is (string-contains? (mode-line-text (ed-refresh-diagnostics (blsp-cm bad-src 1))) "⚠"))))

;; ---- genericity: the view honours ANY mode's services, not just brood's -----
;; A throwaway "stub" mode proves the editor is a language-agnostic services host:
;; register a layer with its own :fontify / :eldoc and the view uses them. This is
;; the whole point of putting brood-mode in the editor — adding another language is
;; the same registration with different functions.
(defn stub-fontify (text) (list [0 (string-length text) {:fg :magenta}]))
(defn stub-eldoc (text pos) "STUB-HINT")
(defn stub-indent (text bol) 7)
(defn stub-diagnostics (text) (list {:line 1 :col 1 :message "stub-warning"}))
(def stub-layer
  {:name 'stub
   :fontify 'main-test/stub-fontify
   :eldoc 'main-test/stub-eldoc
   :indent 'main-test/stub-indent
   :diagnostics 'main-test/stub-diagnostics})
(defn stub-model (text)
  (ed-set-buf (m-of "") (layers/push-layer (make-buffer text) 'main-test/stub-layer)))

(describe "editor is a language-agnostic mode-services host"
  (test "the view honours any mode's :fontify"
    (let (coloured (filter (fn (op) (and (= (first op) :text) (= (nth op 4 nil) {:fg :magenta})))
                     (ed-view (stub-model "hello") 80 24)))
      (is (> (count coloured) 0))))
  (test "the view honours any mode's :eldoc"
    (assert= (ed-echo-or-eldoc (stub-model "hello")) "STUB-HINT"))
  (test "cmd-indent-line honours any mode's :indent"
    (assert= (buffer-text (cur (cmd-indent-line (stub-model "ab") nil))) "       ab"))
  (test "the editor honours any mode's :diagnostics"
    (let (m (ed-refresh-diagnostics (stub-model "hello")))
      (assert= (count (get m :diagnostics)) 1)
      (is (string-contains? (ed-echo-or-eldoc m) "stub-warning")))))

(describe "editor brood-mode services across processes"
  :isolated
  (test "a brood model renders coloured after a round-trip through a spawned process"
    ;; send the model to a worker, which renders it and sends back the result —
    ;; proving the model (layers carry fn-symbol facets; faces are maps) deep-copies
    ;; intact across per-process heaps.
    (let (me (self)
          m (blsp-cm "(defn f ())" 0)
          _ (spawn (let (ops (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn"))))
                     (send me [:result (count ops) (not (nil? (nth (first ops) 4 nil)))]))))
      (receive ([:result n faced] (is (> n 0)) (is faced)))))

  (test "diagnostics re-check correctly in a spawned process (in-process checker)"
    ;; the worker runs the advisory checker on a deep-copied model and reports the
    ;; warning count — proves check-string-structured works off the main process too.
    (let (me (self)
          m (blsp-cm "(map cons (list 1 2 3))" 1)
          _ (spawn (send me [:n (count (get (ed-refresh-diagnostics m) :diagnostics))])))
      (receive ([:n n] (is (> n 0)))))))

;; ---- the mode in the mode line ----------------------------------------------
(defn mode-line-text (m)
  "The mode-line op's text (the reverse-video bar carrying the buffer name)."
  (nth (first (filter (fn (op)
                        (and (= (first op) :text)
                          (= (nth op 4 nil) {:reverse true})
                          (string-contains? (nth op 3 "") (buffer-name (cur m)))))
                (ed-view m 80 24)))
    3))

(describe "editor mode line shows the active mode"
  (test "a plain buffer shows (text)"
    (is (string-contains? (mode-line-text (m-of "hi")) "(text)")))
  (test "a .blsp buffer shows (brood)"
    (is (string-contains? (mode-line-text (ed-init (make-buffer "(+ 1 2)" "x.blsp" "x.blsp")))
          "(brood)"))))

;; ---- Emacs editing in the minibuffer (find-file / switch-buffer prompts) -----
(defn mb-input (m) (mb-text (get m :minibuffer)))

(describe "editor minibuffer editing"
  (test "C-a moves to start, then a key inserts at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
           ; input "abc", point 3
           ins
           (ed-update (ed-update m :ctrl-a 80 24) "Z" 80 24))
      ; C-a → 0, insert Z
      (assert= (mb-input ins) "Zabc")))
  (test "C-b then Backspace deletes the char before point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
           ; "abc" point 3
           m2
           (ed-update (ed-update m :ctrl-b 80 24) :backspace 80 24))
      ; point 2, del 'b'
      (assert= (mb-input m2) "ac")))
  (test "C-d deletes the char at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
          m2 (ed-update (ed-update m :ctrl-a 80 24) :ctrl-d 80 24))
      ; point 0, del 'a'
      (assert= (mb-input m2) "bc")))
  (test "C-k kills from point to the end"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abcdef")
           m2
           (ed-update (ed-update m :ctrl-a 80 24)
             :ctrl-f
             80
             24)  ; point 1
           m3
           (ed-update m2 :ctrl-k 80 24))
      ; kill to end
      (assert= (mb-input m3) "a")))
  (test "editing then Enter accepts the corrected text"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Messages*X")
           ; trailing typo
           fixed
           (ed-update m :backspace 80 24)  ; delete X → "*Messages*"
           done
           (ed-update fixed :enter 80 24))
      (assert= (mb-input fixed) "*Messages*")  ; the edit landed
      (assert= (buffer-name (cur done)) "*Messages*")))  ; …and Enter switched
  (test "the minibuffer gained lineedit word-motion (M-b) from the shared core"
    ;; the old hand-rolled minibuffer had no M-f/M-b; reusing lineedit brings it
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "ab cd")
           ; point at end (5)
           moved
           (ed-update m :alt-b 80 24)  ; M-b → start of "cd" (3)
           ins
           (ed-update moved "Z" 80 24))
      (assert= (mb-input ins) "ab Zcd"))))

;; ---- live completion candidates in switch-buffer -----------------------------
(describe "editor switch-buffer completion"
  (test "shows the matching buffer names as you type"
    (let (m (press (m-of "x") [:ctrl-x "b"]))
      ; *scratch* + *Messages*
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*scratch*"))
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*Messages*"))))
  (test "candidates narrow to the typed prefix"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*M"))
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*Messages*"))
      (is (not (string-contains? (ed-mb-candidates (get m :minibuffer)) "*scratch*")))))
  (test "Tab completes the buffer name"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Mess")
          done (ed-update (ed-update m :tab 80 24) :enter 80 24))
      ; Tab → "*Messages*", Enter
      (assert= (buffer-name (cur done)) "*Messages*"))))

;; ---- the new line/word editing commands -------------------------------------
(describe "editor line/word editing"
  (test "M-o opens a line below and moves there"
    (let (m (ed-update (m-of "abc") :alt-o 80 24))
      (assert= (buffer-text (cur m)) "abc\n")
      (assert= (buffer-current-line (cur m)) 1)))
  (test "M-O opens a line above and moves there"
    (let (m (ed-update (m-of "abc") (keyword "alt-O") 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-current-line (cur m)) 0)))
  (test "C-o opens a line, keeping point"
    (let (m (ed-update (m-of "abc") :ctrl-o 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-point (cur m)) 0)))
  (test "C-k kills to end of line (onto the kill ring)"
    (let (m (ed-update (m-of "abc\ndef") :ctrl-k 80 24))
      (assert= (buffer-text (cur m)) "\ndef")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-k at end of line kills the newline"
    (let (m (ed-update (ed-set-buf (m-of "ab\ncd") (end-of-line (cur (m-of "ab\ncd"))))
              :ctrl-k
              80
              24))
      (assert= (buffer-text (cur m)) "abcd")))
  (test "M-d kills the word after point"
    (let (m (ed-update (m-of "foo bar") :alt-d 80 24))
      (assert= (buffer-text (cur m)) " bar")
      (assert= (first (get m :kill-ring)) "foo")))
  (test "M-DEL kills the word before point"
    (assert= (buffer-text (cur (press (m-of "foo bar") [:end (keyword "alt-backspace")]))) "foo "))
  (test "C-t transposes the two characters around point"
    (let (m (ed-update (ed-set-buf (m-of "ab") (forward-char (make-buffer "ab"))) :ctrl-t 80 24))
      (assert= (buffer-text (cur m)) "ba")))
  (test "M-u / M-l / M-c change word case"
    (assert= (buffer-text (cur (ed-update (m-of "foo bar") :alt-u 80 24))) "FOO bar")
    (assert= (buffer-text (cur (ed-update (m-of "FOO") :alt-l 80 24))) "foo")
    (assert= (buffer-text (cur (ed-update (m-of "foo") :alt-c 80 24))) "Foo"))
  (test "C-x d duplicates the current line"
    (assert= (buffer-text (cur (press (m-of "abc") [:ctrl-x "d"]))) "abc\nabc"))
  (test "M-^ joins the next line onto this one"
    (assert= (buffer-text (cur (ed-update (m-of "abc\ndef") (keyword "alt-^") 80 24))) "abcdef")))

;; ---- Emacs kill-ring semantics: coalescing + M-y yank-pop -------------------
(describe "editor kill ring (Emacs semantics)"
  (test "consecutive C-k coalesce into one kill-ring entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :ctrl-k]))
      ; kill "abc", then the "\n"
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (get m :kill-ring)) "abc\n")  ; appended, not two entries
      (assert= (count (get m :kill-ring)) 1)))
  (test "a non-kill between kills starts a new entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :right :ctrl-k]))
      ; kill, move, kill
      (assert= (count (get m :kill-ring)) 2)))
  (test "M-DEL (backward kill) coalesces by prepending"
    (let (m (press (ed-set-buf (m-of "foo bar") (end-of-buffer (cur (m-of "foo bar"))))
              [(keyword "alt-backspace") (keyword "alt-backspace")]))
      ; kill "bar", then "foo "
      (assert= (first (get m :kill-ring)) "foo bar")
      (assert= (buffer-text (cur m)) "")))
  (test "C-y yanks the newest; M-y pops to the next-older kill"
    (let (m0 (assoc (m-of "") :kill-ring (list "newest" "older"))
          yanked (ed-update m0 :ctrl-y 80 24)
          popped (ed-update yanked :alt-y 80 24))
      (assert= (buffer-text (cur yanked)) "newest")
      (assert= (buffer-text (cur popped)) "older")))
  (test "M-y cycles the whole ring and wraps around"
    (let (m (assoc (m-of "") :kill-ring (list "a" "b" "c"))
          y0 (ed-update m :ctrl-y 80 24)
          y1 (ed-update y0 :alt-y 80 24)
          y2 (ed-update y1 :alt-y 80 24)
          y3 (ed-update y2 :alt-y 80 24))
      (assert= (buffer-text (cur y0)) "a")
      (assert= (buffer-text (cur y1)) "b")
      (assert= (buffer-text (cur y2)) "c")
      (assert= (buffer-text (cur y3)) "a")))  ; wrapped
  (test "M-y only works right after a yank"
    (let (no-yank (ed-update (assoc (m-of "") :kill-ring (list "x")) :alt-y 80 24)
           ;; editing between yank and M-y breaks it
           broke
           (ed-update (ed-update (assoc (m-of "") :kill-ring (list "a" "b")) :ctrl-y 80 24)
             "z"
             80
             24))
      (is (string-contains? (get no-yank :echo) "not a yank"))
      (is (string-contains? (get (ed-update broke :alt-y 80 24) :echo) "not a yank")))))

;; ---- M-x: run interactive commands by name ----------------------------------
(describe "editor M-x"
  (test "defcommand registered the editing commands (interactive)"
    (is (> (count (interactive/command-names)) 20))
    (is (some? (fn (n) (= n "kill-line")) (interactive/command-names)))
    (is (some? (fn (n) (= n "newline")) (interactive/command-names))))
  (test "M-x runs a command by name"
    (let (m (press (m-of "ab") [:alt-x])
          done (ed-update (type-str m "open-line-below") :enter 80 24))
      (assert= (buffer-text (cur done)) "ab\n")))  ; open-line-below ran
  (test "M-x on an unknown name reports it (no crash)"
    (let (done (ed-update (type-str (press (m-of "x") [:alt-x]) "no-such-command") :enter 80 24))
      (is (not (get done :done)))
      (is (string-contains? (get done :echo) "no command"))))
  (test "M-x completion narrows the candidate list"
    (let (cands (ed-mb-candidates (get (type-str (press (m-of "x") [:alt-x]) "kill-") :minibuffer)))
      (is (string-contains? cands "kill-line"))
      (is (not (string-contains? cands "forward-char"))))))

;; ---- Vertico-style minibuffer: fuzzy vertical list + selection + accept ------
(describe "editor minibuffer completion (Vertico-style)"
  (test "M-x is a selection prompt with fuzzy candidates"
    (let (mb (get (type-str (press (m-of "x") [:alt-x]) "buffer") :minibuffer))
      (is (get mb :accept-selection))
      (is (> (count (mb-candidates mb)) 1))))         ; several *-buffer commands match "buffer"
  (test "C-n moves the candidate selection"
    (let (typed (type-str (press (m-of "x") [:alt-x]) "buffer"))
      (assert= (mb-sel (get (ed-update typed :ctrl-n 80 24) :minibuffer)) 1)))
  (test "fuzzy matches a non-prefix subsequence (sb → switch-buffer)"
    (let (cands (mb-candidates (get (type-str (press (m-of "x") [:alt-x]) "sb") :minibuffer)))
      (is (some? (fn (c) (= c "switch-buffer")) cands))))
  (test "Enter runs the selected (top fuzzy) command"
    (let (done (press (m-of "x") (cons :alt-x (append (string->list "list-proc") [:enter]))))
      (is (string-contains? (buffer-name (cur done)) "*Process List*"))))  ; list-processes ran
  (test "C-x b accepts the selected buffer (fuzzy)"
    (let (done (press (m-of "hi") (append [:ctrl-x "b"] (append (string->list "Messa") [:enter]))))
      (is (string-contains? (buffer-name (cur done)) "*Messages*"))))
  (test "a Vertico prompt renders its candidates as a vertical list"
    (let (ops (ed-mb-candidates-ops (press (m-of "x") [:alt-x]) 80 24))
      (is (> (count ops) 0))
      (is (= (first (first ops)) :text)))))

;; ---- system layers (global) are active but hidden from the mode line --------
(describe "editor system layers"
  (test "the global layer is active (its keys work) but not shown as the mode"
    (let (m (m-of "x"))
      (is (some? (fn (l) (= (get l :name) 'global)) (layers/active-layers (cur m))))
      (assert= (ed-buf-mode-name (cur m)) "text")))  ; global is :system → hidden; text shows
  (test "global bindings still dispatch (e.g. C-k) on a plain buffer"
    (assert= (buffer-text (cur (ed-update (m-of "abc") :ctrl-k 80 24))) "")))  ; kill-line via global

;; ---- panes (splits / other-pane / delete) -------------------------------
(describe "editor panes"
  (test "C-x 2 / C-x 3 split into two panes"
    (assert= (pane/pane-count (get (press (m-of "x") [:ctrl-x "2"]) :layout)) 2)
    (assert= (pane/pane-count (get (press (m-of "x") [:ctrl-x "3"]) :layout)) 2))
  (test "C-x 1 collapses back to one pane"
    (assert= (pane/pane-count (get (press (m-of "x") [:ctrl-x "2" :ctrl-x "1"]) :layout)) 1))
  (test "C-x 0 deletes the selected pane"
    (assert= (pane/pane-count (get (press (m-of "x") [:ctrl-x "2" :ctrl-x "0"]) :layout)) 1))
  (test "C-x o moves selection to the other pane"
    (let (split (press (m-of "x") [:ctrl-x "2"])
          moved (press split [:ctrl-x "o"]))
      (is (not (= (pane/pane-selected-path (get moved :layout))
                 (pane/pane-selected-path (get split :layout)))))))
  (test "M-x runs a pane command by name (split-pane-right)"
    (let (done (ed-update (type-str (press (m-of "x") [:alt-x]) "split-pane-right") :enter 80 24))
      (assert= (pane/pane-count (get done :layout)) 2))))

;; ---- panes: mouse (click-select + divider drag-resize, over :drag events) --
;; On an 80x24 frame the body is [0 0 80 23]; C-x 3 makes left [0 0 40 23] | a
;; divider at col 40 | right [41 0 39 23], the left pane selected.
(describe "editor panes — mouse"
  (defn pane-w0 (m) (nth (get (first (get (ed-body-layout m 80 24) :panes)) :rect) 2))
  (test "a click in the other pane selects it"
    (let (split (press (m-of "x") [:ctrl-x "3"])
          clicked (ed-update split [:mouse :press :left 5 60] 80 24))
      (is (not (= (pane/pane-selected-path (get split :layout))
                 (pane/pane-selected-path (get clicked :layout)))))))
  (test "press on a divider starts a drag; release ends it"
    (let (split (press (m-of "x") [:ctrl-x "3"])
          pressed (ed-update split [:mouse :press :left 5 40] 80 24)
          released (ed-update pressed [:mouse :release :left 5 40] 80 24))
      (is (not (nil? (get pressed :dragging))))
      (is (nil? (get released :dragging)))))
  (test "dragging a divider moves the boundary to the pointer"
    (let (split (press (m-of "x") [:ctrl-x "3"])
          dragged (ed-update (ed-update split [:mouse :press :left 5 40] 80 24)
                    [:mouse :drag :left 5 20]
                    80
                    24))
      (assert= (pane-w0 dragged) 20)))
  (defn pane-scale-at (m sel?)
    ;; the :scale of the (non-)selected pane in `m`'s layout
    (let (p (first (filter (fn (p) (= sel? (= true (get p :selected))))
                     (get (ed-body-layout m 80 24) :panes))))
      (max 1 (or (get (get p :payload) :scale) 1))))
  (defn pane-top-at (m sel?)
    (let (p (first (filter (fn (p) (= sel? (= true (get p :selected))))
                     (get (ed-body-layout m 80 24) :panes))))
      (or (get (get p :payload) :top) 0)))

  (test "Ctrl+wheel zooms the pane UNDER THE POINTER, not the active pane"
    (let (base (m-of "x"))
      ;; a lone pane (which is the hovered one): zoom up, then clamp at 1
      (assert= (pane-scale-at (ed-update base [:mouse :scroll-up nil 5 5 [:ctrl]] 80 24) true) 2)
      (assert= (pane-scale-at (ed-update base [:mouse :scroll-down nil 5 5 [:ctrl]] 80 24) true) 1)
      ;; split (left selected, right at col 60): hovering the RIGHT pane zooms IT,
      ;; while the active (left) pane stays at scale 1.
      (let (split (press (m-of "x") [:ctrl-x "3"])
            zoomed (ed-update split [:mouse :scroll-up nil 5 60 [:ctrl]] 80 24))
        (assert= (pane-scale-at zoomed true) 1)  ; active pane untouched
        (assert= (pane-scale-at zoomed false) 2))))  ; hovered pane zoomed
  (test "a plain wheel scrolls the hovered pane's viewport (:top), leaving point + zoom"
    (let (text (apply str (map (fn (i) (str "L" i "\n")) (range 30)))
          down (ed-update (m-of text) [:mouse :scroll-down nil 5 5 []] 80 24))
      (assert= (ed-current-top down) 3)  ; *wheel-lines* = 3 — the viewport moved
      (assert= (buffer-current-line (cur down)) 0)  ; ...but point did not
      (assert= (pane-scale-at down true) 1)  ; plain wheel doesn't zoom
      ;; scrolling up from the top clamps at 0
      (assert= (ed-current-top (ed-update (m-of text) [:mouse :scroll-up nil 5 5 []] 80 24)) 0)))
  (test "a plain wheel scrolls the pane under the pointer, not the active pane"
    (let (text (apply str (map (fn (i) (str "L" i "\n")) (range 30)))
          split (press (m-of text) [:ctrl-x "3"])
          scrolled (ed-update split [:mouse :scroll-down nil 5 60 []] 80 24))
      ; hover RIGHT
      (assert= (pane-top-at scrolled true) 0)  ; active (left) pane not scrolled
      (assert= (pane-top-at scrolled false) 3)))  ; hovered (right) pane scrolled
  (test "C-x l toggles the per-pane line-number gutter (default on for text-mode)"
    ;; text-mode carries the :gutter-* service, so the gutter is shown by default; C-x l
    ;; flips the *effective* state — first press hides it, the second shows it again.
    (let (off (press (m-of "a\nb\nc") [:ctrl-x "l"]))
      (assert= (get (ed-current-pane off) :line-numbers) false)  ; hidden
      (is (not (= false (get (ed-current-pane (press off [:ctrl-x "l"])) :line-numbers))))  ; shown again
      ;; in a split, the override is pane-local — only the selected pane is touched
      (let (split (press (m-of "a\nb\nc") [:ctrl-x "3"])
            ln-off (press split [:ctrl-x "l"])
            other (first (filter (fn (p) (not (get p :selected)))
                           (get (ed-body-layout ln-off 80 24) :panes))))
        (assert= (get (ed-current-pane ln-off) :line-numbers) false)
        (is (nil? (get (get other :payload) :line-numbers))))))  ; untouched → still default-on
  (test "ed-gutter-width = digit-count + 1 when shown, 0 when hidden"
    ;; a pooled buffer carries the text-mode layer, so the :gutter-width service resolves
    (let (buf (ed-current-buf (m-of "a\nb\nc")))
      (assert= (ed-gutter-width buf true) 2)    ; 3 lines → 1 digit + 1 space
      (assert= (ed-gutter-width buf false) 0)))
  (test "with the gutter shown (default), the view draws right-aligned line numbers at col 0"
    (let (ops (ed-view (m-of "a\nb\nc") 80 24)
          ;; the gutter cell for the top line: a text op at row 0, col 0
          gut (first (filter (fn (op) (and (= (first op) :text) (= (nth op 1) 0) (= (nth op 2) 0)))
                       ops)))
      (is (not (nil? gut)))
      (is (string-contains? (nth gut 3) "1"))))  ; line 1's number
  (test "the view emits a resize cursor-zone over each divider (GUI hover/drag affordance)"
    ;; C-x 3 → a :col-resize zone; C-x 2 → a :row-resize zone. (The terminal ignores
    ;; the op; the GUI shows the resize cursor over it — ADR-080.)
    (let (zone-shape (fn (keys)
                       (let (z (first (filter (fn (op) (= (first op) :cursor-zone))
                                        (ed-view (press (m-of "x") keys) 80 24))))
                         (and z (last z)))))
      (assert= (zone-shape [:ctrl-x "3"]) :col-resize)
      (assert= (zone-shape [:ctrl-x "2"]) :row-resize)
      (is (nil? (zone-shape []))))))  ; a lone pane has no divider, so no zone

;; ---- projects: find-file-in-project (C-x p f) -------------------------------
;; The suite runs *in* the myedit project, so (cwd) is the real repo root — these
;; assertions hold against the actual tree.
(describe "editor projects (find-file-in-project)"
  (test "project-root finds the repo root; project-files lists it recursively"
    (let (root (projects/project-root (cwd)))
      (is (not (nil? root)))
      (is (includes? (projects/project-files root) "src/model.blsp"))
      (is (includes? (projects/project-files root) "tests/main_test.blsp"))
      ;; the walk skips .git, so no path is under it
      (is (empty? (filter (fn (f) (string-contains? f ".git/")) (projects/project-files root))))))
  (test "project-root returns nil above any project"
    (is (nil? (projects/project-root "/"))))
  (test "a .git root (no project.blsp) is recognized; the nearest marker wins"
    (let (d (temp-dir "myedit-git-")
           _
           (make-dir (str d "/.git"))  ; mkdir -p creates d + d/.git
           _
           (make-dir (str d "/sub")))
      (assert= (projects/project-root (str d "/sub")) d)))
  (test "project-matches narrows by relative-path prefix"
    (assert= (projects/project-matches "src/mo" (list "src/model.blsp" "src/modes.blsp" "README"))
      (list "src/model.blsp" "src/modes.blsp")))
  (test "C-x p f opens a file chosen by its project-relative name"
    (let (opened (press (m-of "") [:ctrl-x "p" "f"]))
      (is (not (nil? (get opened :minibuffer))))  ; the chord opened the minibuffer
      (let (done (press (type-str opened "src/model.blsp") [:enter]))
        (is (nil? (get done :minibuffer)))
        (is (string-contains? (buffer-name (cur done)) "src/model.blsp"))
        (is (string-contains? (buffer-text (cur done)) "defmodule model")))))
  (test "C-x p f reports the typed fragment when nothing matches"
    (let (opened (press (m-of "") [:ctrl-x "p" "f"])
          done (press (type-str opened "no/such/file.zzz") [:enter]))
      (is (string-contains? (get done :echo) "no project file matching"))))
  (test "the mode line shows the project name when :project-root is set"
    (is (string-contains? (mode-line-text (assoc (m-of "x") :project-root "/home/u/src/myedit"))
          "[myedit]"))))

;; ---- crash resilience: a thrown error must never take down the editor --------
;; ui-run restores the screen and RE-RAISES a view/update throw, so myedit guards
;; both `ed-update` (commands) and `ed-view` (rendering): the error surfaces in the
;; echo area / a safe frame, and the loop keeps running.
(describe "editor crash resilience"
  (test "a command that throws is caught — the editor survives with the error echoed"
    ;; register a throwing interactive command, run it via M-x, and confirm the model
    ;; comes back (not raised), not quit, with the message in the echo area.
    (interactive/register-command 'cmd-test-boom (fn (m key) (throw "kaboom")))
    (let (opened (press (m-of "x") [:alt-x])
          done (press (type-str opened "test-boom") [:enter]))
      (is (not (get done :done)))  ; the editor did NOT quit
      (is (string-contains? (get done :echo) "kaboom"))))  ; the error surfaced
  (test "a render error yields a safe frame instead of crashing the window"
    ;; an empty model has no :layout, so ed-body-layout throws inside ed-view; the
    ;; guard must return a frame carrying the error, not propagate it.
    (let (f (ed-view {} 80 24))
      (is (> (count (filter (fn (op)
                              (and (= (first op) :text)
                                (string-contains? (nth op 3 "") "render error")))
                      f))
            0)))))

;; ---- Section A additions ----------------------------------------------------
;; Place point at offset `p` in a fresh model over `text` (the common test setup).
(defn at (text p) (ed-set-buf (m-of text) (goto-char (make-buffer text) p)))

(describe "editor kill-whole-line (C-S-backspace)"
  (test "C-S-backspace kills the whole current line, newline included"
    (let (m (ed-update (at "abc\ndef\nghi" 5) (keyword "ctrl-shift-backspace") 80 24))
      (assert= (buffer-text (cur m)) "abc\nghi")
      (assert= (first (get m :kill-ring)) "def\n"))))

(describe "editor find-file live candidates"
  ;; A fixture directory with two files + a subdir; candidates narrow as the
  ;; fragment grows (mirrors how `ed-mb-candidates` renders C-x C-f live).
  (test "ed-path-candidates lists a directory's entries and narrows by fragment"
    (let (d (temp-dir "myedit-ff-")
          _ (make-dir d)
          _ (spit (str d "/alpha.txt") "a")
          _ (spit (str d "/beta.txt") "b")
          all (ed-path-candidates (str d "/"))
          narrowed (ed-path-candidates (str d "/al")))
      (is (includes? all "alpha.txt"))
      (is (includes? all "beta.txt"))
      (assert= narrowed (list "alpha.txt"))))
  (test "ed-path-candidates marks a subdirectory with a trailing slash"
    (let (d (temp-dir "myedit-ff2-")
          _ (make-dir (str d "/sub"))
          cs (ed-path-candidates (str d "/")))
      (is (includes? cs "sub/"))))
  (test "ed-path-candidates tolerates a non-existent directory"
    (assert= (ed-path-candidates "/tmp/myedit-does-not-exist-zzz/") ())))

(describe "editor comment/uncomment (M-;)"
  ;; M-; arrives as the keyword named "alt-;"; brood-mode supplies :comment-syntax.
  (test "M-; comments the current line in brood-mode, preserving indent"
    (let (m (ed-update (blsp-cm "  (foo)\n(bar)" 3) (keyword "alt-;") 80 24))
      (assert= (buffer-text (cur m)) "  ;; (foo)\n(bar)")))
  (test "M-; on an already-commented line uncomments it (round-trips)"
    (let (commented (ed-update (blsp-cm "(foo)" 0) (keyword "alt-;") 80 24)
          back (ed-update commented (keyword "alt-;") 80 24))
      (assert= (buffer-text (cur commented)) ";; (foo)")
      (assert= (buffer-text (cur back)) "(foo)")))
  (test "M-; comments every line spanned by the region"
    (let (b (-> (make-buffer "(a)\n(b)\n(c)" "x.blsp" "x.blsp") (goto-char 0) set-mark (goto-char 7))
          m (ed-update (ed-set-buf (ed-init (make-buffer "" "x.blsp" "x.blsp")) b) (keyword "alt-;") 80 24))
      ;; region covers lines 0–1 (point at start of line 2 doesn't pull line 2 in)
      (assert= (buffer-text (cur m)) ";; (a)\n;; (b)\n(c)")))
  (test "a region of commented lines uncomments only when all are commented"
    (let (b (-> (make-buffer ";; (a)\n(b)" "x.blsp" "x.blsp") (goto-char 0) set-mark (goto-char 9))
          m (ed-update (ed-set-buf (ed-init (make-buffer "" "x.blsp" "x.blsp")) b) (keyword "alt-;") 80 24))
      ;; not all commented → comment the rest
      (assert= (buffer-text (cur m)) ";; ;; (a)\n;; (b)")))
  (test "M-; in plain text-mode reports there's no comment syntax"
    (let (m (ed-update (m-of "hello") (keyword "alt-;") 80 24))
      (assert= (buffer-text (cur m)) "hello")
      (is (string-contains? (get m :echo) "no comment syntax")))))

(describe "editor incremental search (C-s / C-r)"
  ;; point of the current buffer after folding keys
  (test "C-s then typing lands point on the match (point at match end)"
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o"]))
      (is (not (nil? (get m :isearch))))
      (assert= (buffer-point (cur m)) 8)            ; "wo" matched at 6, point at end
      (is (string-contains? (get m :echo) "I-search: wo"))))
  (test "the match is shown via a transient :overlay, not by moving the mark"
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o"]))
      (assert= (get m :overlays) [{:start 6 :end 8 :face isearch/ed-face-isearch}])
      (is (nil? (buffer-mark (cur m))))             ; the user's mark is untouched
      (let (done (press m [:ctrl-g]))
        (is (nil? (get done :overlays))))))          ; cleared on exit
  (test "C-s is incremental — extending the string keeps/advances the match"
    (let (m (press (m-of "foo foobar") [:ctrl-s "f" "o" "o" "b"]))
      (assert= (buffer-point (cur m)) 8)))           ; "foob" only matches at 4
  (test "C-s C-s advances to the next occurrence"
    (let (m (press (m-of "ab ab ab") [:ctrl-s "a" "b" :ctrl-s]))
      (assert= (buffer-point (cur m)) 5)))           ; first at 0 (pt 2), next at 3 (pt 5)
  (test "a failing search keeps point and shows Failing"
    (let (m (press (m-of "hello") [:ctrl-s "x" "y"]))
      (is (nil? (get (get m :isearch) :match)))
      (is (string-contains? (get m :echo) "Failing"))))
  (test "Enter exits leaving point at the match and clears the search"
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o" :enter]))
      (is (nil? (get m :isearch)))
      (assert= (buffer-point (cur m)) 8)
      (is (nil? (buffer-mark (cur m))))))             ; region cleared on exit
  (test "C-g aborts, returning point to where the search began"
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o" :ctrl-g]))
      (is (nil? (get m :isearch)))
      (assert= (buffer-point (cur m)) 0)              ; back to the origin
      (is (string-contains? (get m :echo) "quit"))))
  (test "C-r searches backward, extending the hit in place"
    ;; "ab ab ab": a0 b1 _ a3 b4 _ a6 b7. From end, C-r "a" lands on a6; "b" extends
    ;; that hit to "ab" at 6 (not jumping back to the "ab" at 3).
    (let (m (press (ed-set-buf (m-of "ab ab ab") (goto-char (make-buffer "ab ab ab") 8))
              [:ctrl-r "a" "b"]))
      (assert= (buffer-point (cur m)) 6)))
  (test "forward C-s repeat finds the next NON-overlapping match"
    ;; "aaaa", search "aa": first at 0 (pt 2); C-s advances past it to 2 (pt 4),
    ;; not to the overlapping match at 1.
    (let (m (press (m-of "aaaa") [:ctrl-s "a" "a" :ctrl-s]))
      (assert= (buffer-point (cur m)) 4)))
  (test "a non-control key exits the search and is then dispatched"
    ;; after matching, C-a (beginning-of-line) exits isearch and runs
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o" :ctrl-a]))
      (is (nil? (get m :isearch)))
      (assert= (buffer-point (cur m)) 0)))             ; C-a moved to line start
  (test "exiting pushes the search origin onto the mark ring"
    (let (m (press (m-of "hello world") [:ctrl-s "w" "o" :enter]))
      (assert= (get (cur m) :mark-ring) (list 0)))))   ; origin (0) recorded

;; Begin a query-replace: M-%, type `from`, Enter, type `to`, Enter — landing in the
;; y/n/!/./q loop on the first match (or finished if there is none).
(defn qr-begin (text from to)
  (press (press (press (m-of text) [(keyword "alt-%")]) (string->list from))
    (cons :enter (append (string->list to) [:enter]))))

(describe "editor query-replace (M-%)"
  (test "M-% prompts twice then highlights the first match"
    (let (m (qr-begin "foo foo foo" "foo" "bar"))
      (is (nil? (get m :minibuffer)))                  ; both prompts done
      (is (not (nil? (get m :query-replace))))
      (assert= (get (get m :query-replace) :match) 0)  ; first match highlighted
      (is (string-contains? (get m :echo) "Query replacing foo with bar"))))
  (test "y replaces the current match and advances to the next"
    (let (m (press (qr-begin "foo foo" "foo" "bar") ["y"]))
      (assert= (buffer-text (cur m)) "bar foo")        ; first replaced
      (assert= (get (get m :query-replace) :match) 4)))  ; next match (now at 4)
  (test "n skips without replacing, advancing to the next match"
    (let (m (press (qr-begin "foo foo" "foo" "bar") ["n"]))
      (assert= (buffer-text (cur m)) "foo foo")         ; nothing changed
      (assert= (get (get m :query-replace) :match) 4)))
  (test "! replaces all remaining matches and finishes"
    (let (m (press (qr-begin "foo foo foo" "foo" "bar") ["!"]))
      (assert= (buffer-text (cur m)) "bar bar bar")
      (is (nil? (get m :query-replace)))
      (is (string-contains? (get m :echo) "Replaced 3 occurrences"))))
  (test ". replaces the current match and stops"
    (let (m (press (qr-begin "foo foo foo" "foo" "bar") ["."]))
      (assert= (buffer-text (cur m)) "bar foo foo")
      (is (nil? (get m :query-replace)))))
  (test "q stops the loop, leaving the rest untouched"
    (let (m (press (qr-begin "foo foo" "foo" "bar") ["y" "q"]))
      (assert= (buffer-text (cur m)) "bar foo")         ; one replaced, then stopped
      (is (nil? (get m :query-replace)))))
  (test "finishing reports when there are no matches from point"
    (let (m (qr-begin "hello" "zzz" "x"))
      (is (nil? (get m :query-replace)))
      (is (string-contains? (get m :echo) "Replaced 0 occurrences")))))

(describe "editor prefix arguments (C-u) + mark ring"
  (test "C-u with explicit digits repeats the next command N times"
    (let (m (press (m-of "l0\nl1\nl2\nl3\nl4") [:ctrl-u "3" :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 3)
      (is (nil? (get m :prefix-arg)))))            ; arg consumed
  (test "C-u alone means 4"
    (let (m (press (m-of "0\n1\n2\n3\n4\n5") [:ctrl-u :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 4)))
  (test "current-prefix-arg reads the active numeric arg (nil when none)"
    (is (nil? (interactive/current-prefix-arg (m-of "x"))))
    (assert= (interactive/current-prefix-arg (press (m-of "x") [:ctrl-u "7"])) 7))
  (test "an explicit C-u 0 runs the command zero times"
    (let (m (press (m-of "0\n1\n2") [:ctrl-u "0" :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 0)        ; C-u 0 C-n does not move
      (is (nil? (get m :prefix-arg)))))
  (test "C-u C-u multiplies (16)"
    (let (big (join "\n" (map (fn (i) (str "L" i)) (range 20)))
          m (press (m-of big) [:ctrl-u :ctrl-u :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 16)))
  (test "C-u N then a printable key self-inserts it N times"
    (let (m (press (m-of "") [:ctrl-u "5" "-"]))
      (assert= (buffer-text (cur m)) "-----")))   ; the `-` after digits self-inserts, not negate
  (test "M-- runs the next command's inverse (negative argument, Emacs M--)"
    ;; C-f forward → backward; from col 3 of "abcde" one step back lands on 2
    (let (m (press (at "abcde" 3) [(keyword "alt--") :ctrl-f]))
      (assert= (buffer-point (cur m)) 2)))
  (test "M-- with digits accumulates a negative count (M-- 3 C-f = back 3)"
    (let (m (press (at "abcdefgh" 6) [(keyword "alt--") "3" :ctrl-f]))
      (assert= (buffer-point (cur m)) 3)
      (is (nil? (get m :prefix-arg)))))
  (test "M-- C-b runs forward (inverse of backward-char)"
    (let (m (press (at "abcde" 1) [(keyword "alt--") :ctrl-b]))
      (assert= (buffer-point (cur m)) 2)))
  (test "C-u - negates (a leading `-` after C-u), so C-u - C-n moves up"
    (let (m (press (at "0\n1\n2\n3" 4) [:ctrl-u "-" :ctrl-n]))  ; point on line 2, one line up
      (assert= (buffer-current-line (cur m)) 1)))
  (test "a negative argument on a command with no inverse just repeats |N| times"
    (let (m (press (m-of "") [(keyword "alt--") "3" "z"]))     ; self-insert has no inverse
      (assert= (buffer-text (cur m)) "zzz")))
  (test "digits only accumulate while a prefix arg is active (plain 7 self-inserts)"
    (assert= (after "" "7") "7"))                  ; no C-u: just a normal char
  (test "C-g (keyboard-quit) deactivates the region and clears a pending prefix arg"
    (let (region (press (at "hello" 0) [(keyword "ctrl- ") :right :right])  ; mark at 0, point→2
          quit (ed-update (assoc region :prefix-arg {:count 4 :raw true}) :ctrl-g 80 24))
      (is (not (nil? (buffer-mark (cur region)))))  ; region was active before C-g
      (is (nil? (buffer-mark (cur quit))))           ; mark deactivated
      (is (nil? (get quit :prefix-arg)))))           ; prefix arg cleared
  (test "C-u C-SPC pops the mark ring, returning point to a previous mark"
    (let (marked (ed-update (at "hello world" 5) (keyword "ctrl- ") 80 24)  ; C-SPC: push mark at 5
          moved (press marked [:ctrl-a])                                    ; point → 0
          popped (press moved [:ctrl-u (keyword "ctrl- ")]))                ; C-u C-SPC: pop
      (assert= (buffer-point (cur popped)) 5)
      (is (nil? (get popped :prefix-arg)))))
  (test "C-SPC sets the mark and records it on the ring"
    (let (m (ed-update (at "abcdef" 3) (keyword "ctrl- ") 80 24))
      (assert= (buffer-mark (cur m)) 3)
      (assert= (get (cur m) :mark-ring) (list 3)))))

;; The full text of the *Messages* buffer in model `m`.
(defn messages-text (m)
  (buffer-text (nth (get m :buffers) (ed-buffer-index-by-name m "*Messages*"))))

;; Output redirected to the editor process (std/io `process-port` / std/log
;; `process-backend`) arrives as `[:io-write s]`; `ed-update` folds it into
;; *Messages*. This is the pure half of that path — the message-delivery half is
;; the kernel mailbox, exercised live by the running editor.
(describe "editor output sink (std/io · std/log → *Messages*)"
  (test "[:io-write s] appends to *Messages* and echoes it, trimming the newline"
    (let (m (ed-update (m-of "x") [:io-write "log line\n"] 80 24))
      (is (string-contains? (messages-text m) "log line"))
      (assert= (get m :echo) "log line")))
  (test "[:io-write s] leaves the current buffer untouched"
    (assert= (buffer-text (cur (ed-update (m-of "hello") [:io-write "noise\n"] 80 24))) "hello"))
  (test "two [:io-write]s accumulate as separate lines in *Messages*"
    (let (m (press (m-of "x") [[:io-write "one\n"] [:io-write "two\n"]]))
      (is (string-contains? (messages-text m) "one"))
      (is (string-contains? (messages-text m) "two")))))

;; The buffer web mirror (C-x w). The socket/process half (publisher + serve-loop)
;; runs live; here we test the pure pieces exactly as the server renders them —
;; the snapshot the editor pushes, and the HTML a worker turns it into — plus the
;; command's non-spawning branches (already-serving / not-running).
(describe "web mirror (serve-buffer · src/web.blsp)"
  ;; A model whose point sits on line 1, column 1 of "ab\ncd" (char offset 4 = 'd').
  (defn m-at-cd () (ed-set-buf (m-of "ab\ncd") (goto-char (cur (m-of "ab\ncd")) 4)))
  (test "web-snapshot captures text, name, and 0-based point line:col"
    (let (s (web-snapshot (m-at-cd)))
      (assert= (get s :text) "ab\ncd")
      (assert= (get s :line) 1)
      (assert= (get s :col) 1)
      (is (string-contains? (get s :name) "scratch"))))
  (test "web-snapshot materialises the line-number gutter, web-render-app draws it"
    ;; the scratch buffer is text-mode, which carries the :gutter-* service, so the
    ;; snapshot renders the per-line numbers to plain data and the page shows them
    (let (s (web-snapshot (m-at-cd))
          g (get s :gutter)
          html (web-render-app s))
      (assert= (get g :width) 2)                     ; 2 lines → 1 digit + 1 space
      (assert= (first (nth (get g :cells) 0)) "1 ")  ; row 0's cell: "1" right-aligned + space
      (is (string-contains? html "class=\"gutter\""))  ; non-selectable gutter span
      (is (string-contains? html ">1 </span>"))))      ; line 1's number, in the gutter
  (test "web-render-app embeds the buffer text and the cursor caret"
    (let (html (web-render-app (web-snapshot (m-at-cd))))
      (is (string-contains? html "<pre>"))
      (is (string-contains? html "ab"))  ; the non-cursor line, verbatim
      ;; point is at col 1 of "cd", so the caret splits it: c│d
      (is (string-contains? html "c<span class=\"cursor\"></span>d"))
      (is (string-contains? html "2:1"))))  ; header pos: line shown 1-based, col 0-based
  (test "web-render-page wraps the app region and wires up the SSE EventSource"
    (let (html (web-render-page (web-snapshot (m-at-cd))))
      (is (string-contains? html "<div id=\"app\">"))
      (is (string-contains? html "EventSource('/events')"))
      (is (string-contains? html "<pre>"))           ; the app region is embedded
      (refute (string-contains? html "http-equiv=\"refresh\""))))  ; SSE replaced polling
  (test "web-render-app HTML-escapes buffer content"
    (let (html (web-render-app (web-snapshot (m-of "a<b>&c"))))
      (is (string-contains? html "a&lt;b&gt;&amp;c"))
      (is (not (string-contains? html "<b>")))))
  (test "web-render-app colours syntax spans and shades the active region"
    ;; A hand-built snapshot (plain data, exactly what the publisher pushes): chars
    ;; [0 2) carry a :green lexer face, chars [2 4) sit in the selection. Cursor parked
    ;; on line 1 so the rendered line 0 ("abcd") isn't split by the caret.
    (let (snap {:name "t" :mode "x" :text "abcd\nx" :line 1 :col 0 :lines 2 :status ""
                :spans (list [0 2 {:fg :green}]) :region [2 4]}
          html (web-render-app snap))
      (is (string-contains? html "color:#a6e3a1"))      ; :green -> catppuccin green
      (is (string-contains? html ">ab</span>"))          ; the faced run, coalesced
      (is (string-contains? html "background:#45475a"))  ; region [2 4) shaded
      (is (string-contains? html ">cd</span>"))))
  (test "web-render-app header shows the mode-line status and line count"
    (let (html (web-render-app {:name "t" :mode "x" :text "a\nb\nc" :line 0 :col 0
                                :lines 3 :status "modified" :spans '() :region nil}))
      (is (string-contains? html "modified"))   ; the :status mode-line message
      (is (string-contains? html "3L"))))        ; total line count in the header pos
  (test "serve-buffer on an already-running server reports its URL, doesn't respawn"
    (let (m (assoc (m-of "x") :server {:port 5000 :pub nil :proc nil})
          r (cmd-serve-buffer m nil))
      (is (string-contains? (get r :echo) "http://localhost:5000"))
      (assert= (get (get r :server) :port) 5000)))  ; unchanged — no new server
  (test "stop-serving with nothing running just says so"
    (is (string-contains? (get (cmd-stop-serving (m-of "x") nil) :echo) "no web server"))))

;; ---- log routing: per-buffer logging (one logger, a filtered backend per buffer) --
(describe "editor log routing (pure)"
  (test "ed-append-named appends to a named buffer, creating it, leaving current point"
    (let (m (ed-set-buf (m-of "abc") (goto-char (make-buffer "abc") 2))  ; current point at 2
          m2 (ed-append-named m "*LSP*" "line one")
          m3 (ed-append-named m2 "*LSP*" "line two\n")   ; already newline-terminated
          i (ed-buffer-index-by-name m3 "*LSP*"))
      (is (not (nil? i)))
      (assert= (buffer-text (ed-buf-at m3 i)) "line one\nline two\n")  ; one newline each
      (assert= (buffer-text (cur m3)) "abc")    ; current buffer untouched…
      (assert= (buffer-point (cur m3)) 2)))     ; …point too
  (test "a [:buffer-log name s] event appends to that buffer with no echo"
    (let (m (ed-update (m-of "x") [:buffer-log "*LSP*" "hello lsp\n"] 80 24)
          i (ed-buffer-index-by-name m "*LSP*"))
      (is (not (nil? i)))
      (is (string-contains? (buffer-text (ed-buf-at m i)) "hello lsp"))
      (assert= (get m :echo) "")))   ; routed logs never touch the echo area
  (test "ed-buffer-backend filters partition records by category"
    (let (default-b (ed-buffer-backend "*Messages*" {:filter (fn (r) (nil? (get (get r :meta) :category)))})
          lsp-b (ed-buffer-backend "*LSP*" {:filter (fn (r) (= (get (get r :meta) :category) :lsp))})
          uncat {:level :info :meta {}}
          lsp {:level :info :meta {:category :lsp}})
      (is ((get default-b :filter) uncat))      ; uncategorised → *Messages*
      (refute ((get default-b :filter) lsp))    ; …but not the :lsp record
      (is ((get lsp-b :filter) lsp))            ; :lsp → *LSP*
      (refute ((get lsp-b :filter) uncat)))))

(describe "editor log routing (live)"
  :isolated
  (test "register-log-route adds a category→buffer backend to the logger's set"
    (register-log-route :lsp-test "*LSP-test*")
    (let (bs (ed-log-backends))
      (is (>= (count bs) 2))   ; the default *Messages* backend + our route
      ;; some route backend accepts a :lsp-test record
      (is (some? (fn (b) (let (f (get b :filter)) (and f (f {:level :info :meta {:category :lsp-test}}))))
            (rest bs)))))
  (test "ed-buffer-backend streams a written line to the editor as [:buffer-log …]"
    (register :editor (self))                 ; the backend sink targets :editor
    (let (b (ed-buffer-backend "*LSP*"))
      (io/io-write (get b :sink) "a line\n")   ; what the logger does per record
      (assert= (receive ([:buffer-log nm s] [nm s]) (after 500 :timeout))
        ["*LSP*" "a line\n"]))))
