;; Tests for the editor. The window loop (`ui-run`) needs a display, so it's not
;; tested here; we test the pure pieces exactly as they run in the loop:
;; `ed-update` (key + model -> model, via the keymap / minibuffer), the model
;; accessors, `message`, `eval-last-sexp`, the region/undo/buffer commands, and
;; `ed-view` (model -> render frame). These run under plain `nest test` — no GUI
;; build needed (but the eval tests need a `nest` whose prelude has `with-out-str`).
(defmodule main-test
  (:use model)    ; ed-init / ed-scroll / message / current-buffer accessors
  (:use input)    ; ed-update
  (:use view)     ; ed-view
  (:use commands) ; ed-complete-name / ed-complete-path / ed-has-editable?
  (:use complete) ; completion-at-point
  (:use buffer)
  (:use test))

(purge-stale-temp "myedit-")   ; drop fixtures a prior run left in /tmp (at load)

;; A model over a fresh buffer of `text`, the starting point for edits.
(defn m-of (text) (ed-init (make-buffer text)))
;; The current (active) buffer of a model.
(defn cur (m) (ed-current-buf m))
;; The current buffer's text after folding key `k` into a model over `text`.
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
;; Fold a sequence of keys into a model — for chords like [:ctrl-x :ctrl-e].
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
;; Type a string into a model one printable key at a time (for the minibuffer).
(defn type-str (m s) (press m (string->list s)))

(describe "editor edits"
  (test "a printable key inserts at point"
    (assert= (after "ac" "b") "bac"))  ; point starts at 0
  (test "Enter splits the line at point"
    (let (m (ed-update (ed-set-buf (m-of "abcd") (goto-char (cur (m-of "abcd")) 2)) :enter 80 24))
      (assert= (buffer-text (cur m)) "ab\ncd")))
  (test "Backspace deletes the char before point"
    (let (m (ed-update (ed-set-buf (m-of "") (forward-char (make-buffer "abc") 2)) :backspace 80 24))
      (assert= (buffer-text (cur m)) "ac")))
  (test "Delete removes the char after point"
    (assert= (after "abc" :delete) "bc"))
  (test "a tick leaves the buffer unchanged"
    (assert= (after "hello" :tick) "hello"))
  (test "a resize event is a no-op on content (re-render only, echo preserved)"
    (let (m (message (m-of "hello") "note")
          r (ed-update m [:resize 100 30] 80 24))
      (assert= (buffer-text (cur r)) "hello")
      (assert= (get r :echo) "note"))))     ; resize doesn't clear the echo

(describe "editor movement"
  (test "Right then a key inserts one char over"
    (assert= (buffer-text (cur (press (m-of "ac") [:right "b"]))) "abc"))
  (test "C-f then a key inserts one char over (Emacs binding)"
    (assert= (buffer-text (cur (press (m-of "ac") [:ctrl-f "b"]))) "abc"))
  (test "Down (and C-n) move point to the next line"
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :down 80 24))) 1)
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :ctrl-n 80 24))) 1))
  (test "M-f / M-b move by word"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:alt-f]))) 3)            ; end of "foo"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:end :alt-b]))) 4))      ; start of "bar"
  (test "M-> / M-< jump to buffer end / start"
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->")]))) 7)              ; end of buffer
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->") (keyword "alt-<")]))) 0))
  (test "C-v / PageDown scroll forward a screenful, M-v / PageUp back"
    ;; rows=24 -> view-rows=22 -> a page step of 21 lines, over a 31-line buffer
    (let (text (apply str (map (fn (i) (str "L" i "\n")) (range 30)))
          down (ed-update (m-of text) :ctrl-v 80 24)
          back (ed-update down :alt-v 80 24)
          pgdn (ed-update (m-of text) :page-down 80 24))
      (assert= (buffer-current-line (cur down)) 21)
      (assert= (buffer-current-line (cur back)) 0)
      (assert= (buffer-current-line (cur pgdn)) 21))))    ; PageDown == C-v

(describe "editor quit + save (Emacs C-x chords)"
  (test "Esc quits (it's also the window close button)"
    (is (get (ed-update (m-of "x") :escape 80 24) :done)))
  (test "C-x C-c quits"
    (is (get (press (m-of "x") [:ctrl-x :ctrl-c]) :done)))
  (test "C-x C-s on a fileless buffer reports it can't save (no crash)"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-s]))
      (is (not (get m :done)))
      (is (string-contains? (get m :echo) "no file")))))

(describe "editor prefix keymap"
  (test "a prefix key (C-x) sets :pending and inserts nothing"
    (let (m (ed-update (m-of "") :ctrl-x 80 24))
      (is (not (nil? (get m :pending))))
      (assert= (buffer-text (cur m)) "")))
  (test "an undefined chord clears the prefix and reports it"
    (let (m (press (m-of "") [:ctrl-x "z"]))
      (is (nil? (get m :pending)))
      (is (string-contains? (get m :echo) "undefined")))))

(describe "editor undo / redo"
  (test "C-/ undoes the last insert"
    (assert= (buffer-text (cur (press (m-of "") ["a" "b" :ctrl-/]))) "a"))
  (test "C-x u also undoes"
    (assert= (buffer-text (cur (press (m-of "") ["a" "b" :ctrl-x "u"]))) "a"))
  (test "M-/ redoes an undone edit"
    (assert= (buffer-text (cur (press (m-of "") ["a" :ctrl-/ :alt-/]))) "a")))

(describe "editor region & kill ring"
  (test "C-SPC + move + C-w kills the region and fills the kill ring"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w]))
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-y yanks the most recently killed text"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w :end :ctrl-y]))
      (assert= (buffer-text (cur m)) "defabc")))
  (test "M-w copies the region without deleting it"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :alt-w]))
      (assert= (buffer-text (cur m)) "abcdef")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-w with no region is a no-op-with-message"
    (let (m (press (m-of "abc") [:ctrl-w]))
      (assert= (buffer-text (cur m)) "abc")
      (is (string-contains? (get m :echo) "no region")))))

(describe "editor multiple buffers"
  (test "a fresh model has the scratch buffer plus *Messages*"
    (let (m (m-of "hi"))
      (assert= (buffer-name (cur m)) "*scratch*")
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))))
  (test "C-x →/← cycle through buffers (wrapping)"
    (let (m1 (press (m-of "hi") [:ctrl-x :right]))
      (assert= (buffer-name (cur m1)) "*Messages*")
      (assert= (buffer-name (cur (press m1 [:ctrl-x :right]))) "*scratch*")))
  (test "switching buffers preserves each buffer's point"
    (let (m (press (m-of "hello") [:right :right])                 ; point 2 in *scratch*
          back (press m [:ctrl-x :right :ctrl-x :left]))            ; to *Messages* and back
      (assert= (buffer-point (cur back)) 2)))
  (test "*Messages* cannot be killed"
    (let (m (press (m-of "x") [:ctrl-x :right :ctrl-x "k"]))         ; on *Messages*, try kill
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))
      (is (string-contains? (get m :echo) "cannot kill"))))
  (test "killing the last editable buffer leaves a fresh *scratch* and selects it"
    (let (m (press (m-of "x") [:ctrl-x "k"]))                        ; kill the only editable buffer
      (is (ed-has-editable? (get m :buffers)))
      (is (< (get m :current) (count (get m :buffers))))
      (assert= (buffer-name (cur m)) "*scratch*")                    ; lands on the new scratch, not *Messages*
      (assert= (buffer-text (cur m)) "")))
  (test "switching buffers clears the stale per-model status"
    ;; edit (status -> "modified"), then switch; the new buffer isn't modified
    (let (m (press (m-of "x") ["z" :ctrl-x :right]))
      (assert= (get m :status) ""))))

(describe "editor minibuffer (switch-buffer & find-file)"
  (test "C-x b switches to a buffer by name via the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b"]))                        ; open the minibuffer
      (is (not (nil? (get m :minibuffer))))
      (let (done (ed-update (type-str m "*Messages*") :enter 80 24))
        (is (nil? (get done :minibuffer)))
        (assert= (buffer-name (cur done)) "*Messages*"))))
  (test "C-g aborts the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b" :ctrl-g]))
      (is (nil? (get m :minibuffer)))
      (assert= (buffer-name (cur m)) "*scratch*")))
  (test "C-x C-f opens an existing file into a new buffer"
    (let (path (str (temp-dir "myedit-") ".txt")
          _ (spit path "from disk\n")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m :minibuffer (assoc (get m :minibuffer) :input path))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "from disk\n")
      (assert= (buffer-file (cur done)) path)))
  (test "C-x C-f on a new path starts an empty file-backed buffer"
    (let (path (str (temp-dir "myedit-new-") ".txt")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m :minibuffer (assoc (get m :minibuffer) :input path))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "")
      (assert= (buffer-file (cur done)) path))))

(describe "editor completion helpers"
  (test "ed-complete-name returns the sole match"
    (assert= (ed-complete-name "*M" ["*scratch*" "*Messages*"]) "*Messages*"))
  (test "ed-complete-name returns the common prefix of several matches"
    (assert= (ed-complete-name "f" ["foo" "foobar" "fizz"]) "f"))     ; 'foo'/'fizz' share only 'f'
  (test "ed-complete-path completes a unique filename in a directory"
    (let (d (temp-dir "myedit-dir-")
          _ (make-dir d)
          _ (spit (str d "/unique-file.txt") "x"))
      (assert= (ed-complete-path (str d "/uni")) (str d "/unique-file.txt")))))

(describe "editor messages"
  (test "message sets the one-line echo and appends to *Messages*"
    (let (m (message (m-of "x") "hi\nthere")
          msgs (get (nth (get m :buffers) (ed-buffer-index-by-name m "*Messages*")) :buf))
      (assert= (get m :echo) "hi there")              ; newlines flattened for the echo area
      (is (string-contains? (buffer-text msgs) "hi"))))
  (test "message leaves the current buffer's point untouched"
    (let (m (message (press (m-of "hello") [:right :right]) "note"))
      (assert= (buffer-point (cur m)) 2)))
  (test "the *Messages* buffer does not accumulate undo history"
    (let (m (-> (m-of "x") (message "one") (message "two") (message "three"))
          msgs (get (nth (get m :buffers) (ed-buffer-index-by-name m "*Messages*")) :buf))
      (assert= (get msgs :undo) ()))))

;; eval-last-sexp evals the form *before point*, so put point at end of buffer
;; first (as it naturally is after typing the form) before the C-x C-e chord.
(defn eval-buf (text)
  (press (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) [:ctrl-x :ctrl-e]))

(describe "editor eval-last-sexp (C-x C-e)"
  (test "evaluates the form before point and shows the value"
    (is (string-contains? (get (eval-buf "(+ 1 2)") :echo) "=> 3")))
  (test "evaluates a multi-line form, not just the current line"
    (is (string-contains? (get (eval-buf "(+ 1\n   2\n   3)") :echo) "=> 6")))
  (test "evaluates the LAST form before point when several precede it"
    (is (string-contains? (get (eval-buf "(+ 1 1)\n(+ 2 2)") :echo) "=> 4")))
  (test "captures printed output into the message area (not the console)"
    (let (m (eval-buf "(println \"foo\")"))
      (is (string-contains? (get m :echo) "foo"))
      (is (string-contains? (get m :echo) "=> nil"))))
  (test "a def persists, so you can define then call across evals"
    ;; define on one model, then call from another — globals persist in the image
    (let (_ (eval-buf "(defn myedit-demo-greet () (println \"hi-from-demo\"))"))
      (is (string-contains? (get (eval-buf "(myedit-demo-greet)") :echo) "hi-from-demo"))))
  (test "an eval error is reported, not raised"
    (let (m (eval-buf "(this-is-not-defined)"))
      (is (not (get m :done)))
      (is (string-contains? (get m :echo) "error"))))
  (test "cmd-eval-buffer evaluates the whole buffer"
    (is (string-contains? (get (cmd-eval-buffer (m-of "(+ 4 5)") nil) :echo) "=> 9")))
  (test "cmd-eval-region evaluates the region between point and mark"
    (let (b (-> (make-buffer "(+ 2 3)") set-mark end-of-buffer)   ; mark 0, point 7 → region is the whole form
          m (ed-set-buf (m-of "") b))
      (is (string-contains? (get (cmd-eval-region m nil) :echo) "=> 5")))))

(describe "editor completion-at-point"
  ;; a model whose current buffer is `text` with point at `p`
  (defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))
  (test "completion-candidates: distinct buffer words by prefix, sorted"
    (assert= (completion-candidates (cm "for foreach for fold" 0) "fo") (list "fold" "for" "foreach")))
  (test "Tab with a single candidate inserts it directly (no popup)"
    (let (m (cmd-complete (cm "alpha al" 8) nil))
      (is (nil? (get m :completion)))
      (assert= (buffer-text (cur m)) "alpha alpha")))
  (test "Tab with several candidates opens a popup"
    (let (c (get (cmd-complete (cm "alpha alps al" 13) nil) :completion))
      (is (not (nil? c)))
      (assert= (get c :items) (list "alpha" "alps"))
      (assert= (get c :index) 0)))
  (test "Tab with no candidate reports it; an empty prefix is a no-op"
    (is (string-contains? (get (cmd-complete (cm "zzz q" 5) nil) :echo) "no completions"))
    (is (string-contains? (get (cmd-complete (cm "abc" 0) nil) :echo) "nothing to complete")))
  (test "C-n moves the selection and Enter accepts it"
    (let (m (cmd-complete (cm "alpha alps al" 13) nil)
          done (complete-handle (complete-handle m :ctrl-n) :enter))   ; select "alps", accept
      (is (nil? (get done :completion)))
      (assert= (buffer-text (cur done)) "alpha alps alps")))
  (test "a printable key dismisses the popup and inserts (through ed-update)"
    (let (m (ed-update (cm "alpha alps al" 13) :tab 80 24)   ; Tab opens the popup
          m2 (ed-update m "x" 80 24))                          ; 'x' dismisses + inserts
      (is (not (nil? (get m :completion))))
      (is (nil? (get m2 :completion)))
      (assert= (buffer-text (cur m2)) "alpha alps alx")))
  (test "complete-popup-ops: empty when closed, draws cells when open"
    (assert= (complete-popup-ops (m-of "x") 80 24) [])
    (let (ops (complete-popup-ops (cmd-complete (cm "alpha alps al" 13) nil) 80 24))
      (is (> (count ops) 0))
      (is (= (first (first ops)) :text))))
  (test "the popup never overruns a short window (caps to the text area)"
    ;; 10 candidates for prefix \"a\", in a 5-row window (text area = 3 rows)
    (let (m (cmd-complete (cm "aa ab ac ad ae af ag ah ai aj a" 31) nil)
          ops (complete-popup-ops m 80 5))
      (is (<= (count ops) 3))
      (is (every? (fn (op) (< (nth op 1) 3)) ops)))))   ; every row is inside the text area

(describe "editor scrolling"
  (test "the point line stays inside the viewport after moving past the bottom"
    (let (text "l0\nl1\nl2\nl3\nl4"
          m (ed-scroll (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) 2)
          line (buffer-current-line (cur m))
          top (ed-current-top m))
      (is (>= line top))
      (is (< line (+ top 2))))))

(describe "editor view"
  (test "the frame draws the first buffer line and places the cursor"
    (let (f (ed-view (m-of "hello\nworld") 80 24))
      (is (> (count (filter (fn (op) (and (= (first op) :text)
                                          (string-contains? (nth op 3) "hello")))
                      f))
            0))
      (is (> (count (filter (fn (op) (= (first op) :cursor)) f)) 0))))
  (test "an active region is drawn reverse-video"
    ;; region [0,3) over "abcdef" → a reverse-video op carrying "abc" (the mode
    ;; line is reverse too, so match on the region's text to be specific).
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right])
          f (ed-view m 80 24)
          region-ops (filter (fn (op) (and (= (first op) :text)
                                           (= (nth op 4 nil) {:reverse true})
                                           (string-contains? (nth op 3 "") "abc"))) f))
      (is (> (count region-ops) 0))))
  (test "an open minibuffer is rendered on the bottom row"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-f])
          f (ed-view m 80 24)
          mb-ops (filter (fn (op) (and (= (first op) :text)
                                       (string-contains? (nth op 3 "") "Find file:"))) f))
      (is (> (count mb-ops) 0))))
  (test "the mode line is a full-width bar (so it tracks a horizontal resize)"
    ;; the reverse-video op is the mode line (no region here); its text spans the
    ;; whole width at any size — clipped when narrow, space-padded when wide.
    (let (ml-width (fn (cols)
                     (string-length
                       (nth (first (filter (fn (op) (and (= (first op) :text)
                                                         (= (nth op 4 nil) {:reverse true})))
                                     (ed-view (m-of "hi") cols 24)))
                            3))))
      (assert= (ml-width 80) 80)
      (assert= (ml-width 150) 150))))   ; padded out to the full width

;; brood-mode: a .blsp buffer stacks structural sexp nav (C-M-*) on top of
;; text-mode; the trigger is the mode's :file-pattern regex ("\.blsp$").
(describe "editor brood-mode (.blsp files)"
  (defn blsp-model (text) (ed-init (make-buffer text "x.blsp" "x.blsp")))

  (test "C-M-f navigates structurally over a whole form in a .blsp buffer"
    (assert= (buffer-point (cur (ed-update (blsp-model "(+ 1 2)") :ctrl-meta-f 80 24))) 7))

  (test "C-M-d / C-M-u descend into and back out of a list"
    (let (down (ed-update (blsp-model "(a b)") :ctrl-meta-d 80 24))     ; into the list
      (assert= (buffer-point (cur down)) 1)
      (assert= (buffer-point (cur (ed-update down :ctrl-meta-u 80 24))) 0)))  ; back out

  (test "text-mode bindings still work in a .blsp buffer (brood stacks on text)"
    (assert= (buffer-text (cur (press (blsp-model "ac") [:right "b"]))) "abc"))

  (test "a non-.blsp buffer has no structural nav (C-M-f unbound → no-op)"
    (assert= (buffer-point (cur (ed-update (m-of "(+ 1 2)") :ctrl-meta-f 80 24))) 0))

  (test "the trigger is an anchored regex — x.blsp.txt is NOT brood-mode"
    (let (m (ed-update (ed-init (make-buffer "(+ 1 2)" "x.blsp.txt" "x.blsp.txt")) :ctrl-meta-f 80 24))
      (assert= (buffer-point (cur m)) 0))))

;; ---- the mode in the mode line ----------------------------------------------
(defn mode-line-text (m)
  "The mode-line op's text (the reverse-video bar carrying the buffer name)."
  (nth (first (filter (fn (op) (and (= (first op) :text) (= (nth op 4 nil) {:reverse true})
                                    (string-contains? (nth op 3 "") (buffer-name (cur m)))))
                (ed-view m 80 24)))
       3))

(describe "editor mode line shows the active mode"
  (test "a plain buffer shows (text)"
    (is (string-contains? (mode-line-text (m-of "hi")) "(text)")))
  (test "a .blsp buffer shows (brood)"
    (is (string-contains? (mode-line-text (ed-init (make-buffer "(+ 1 2)" "x.blsp" "x.blsp")))
                          "(brood)"))))

;; ---- Emacs editing in the minibuffer (find-file / switch-buffer prompts) -----
(defn mb-input (m) (get (get m :minibuffer) :input))

(describe "editor minibuffer editing"
  (test "C-a moves to start, then a key inserts at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")    ; input "abc", point 3
          ins (ed-update (ed-update m :ctrl-a 80 24) "Z" 80 24)) ; C-a → 0, insert Z
      (assert= (mb-input ins) "Zabc")))
  (test "C-b then Backspace deletes the char before point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")    ; "abc" point 3
          m2 (ed-update (ed-update m :ctrl-b 80 24) :backspace 80 24))  ; point 2, del 'b'
      (assert= (mb-input m2) "ac")))
  (test "C-d deletes the char at point"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abc")
          m2 (ed-update (ed-update m :ctrl-a 80 24) :ctrl-d 80 24))     ; point 0, del 'a'
      (assert= (mb-input m2) "bc")))
  (test "C-k kills from point to the end"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "abcdef")
          m2 (ed-update (ed-update m :ctrl-a 80 24)
                        :ctrl-f 80 24)                                   ; point 1
          m3 (ed-update m2 :ctrl-k 80 24))                              ; kill to end
      (assert= (mb-input m3) "a")))
  (test "editing then Enter accepts the corrected text"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Messages*X")   ; trailing typo
          fixed (ed-update m :backspace 80 24)                          ; delete X → "*Messages*"
          done (ed-update fixed :enter 80 24))
      (assert= (mb-input fixed) "*Messages*")                           ; the edit landed
      (assert= (buffer-name (cur done)) "*Messages*"))))                ; …and Enter switched

;; ---- live completion candidates in switch-buffer -----------------------------
(describe "editor switch-buffer completion"
  (test "shows the matching buffer names as you type"
    (let (m (press (m-of "x") [:ctrl-x "b"]))                ; *scratch* + *Messages*
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*scratch*"))
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*Messages*"))))
  (test "candidates narrow to the typed prefix"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*M"))
      (is (string-contains? (ed-mb-candidates (get m :minibuffer)) "*Messages*"))
      (is (not (string-contains? (ed-mb-candidates (get m :minibuffer)) "*scratch*")))))
  (test "Tab completes the buffer name"
    (let (m (type-str (press (m-of "x") [:ctrl-x "b"]) "*Mess")
          done (ed-update (ed-update m :tab 80 24) :enter 80 24))   ; Tab → "*Messages*", Enter
      (assert= (buffer-name (cur done)) "*Messages*"))))

;; ---- the new line/word editing commands -------------------------------------
(describe "editor line/word editing"
  (test "M-o opens a line below and moves there"
    (let (m (ed-update (m-of "abc") :alt-o 80 24))
      (assert= (buffer-text (cur m)) "abc\n")
      (assert= (buffer-current-line (cur m)) 1)))
  (test "M-O opens a line above and moves there"
    (let (m (ed-update (m-of "abc") (keyword "alt-O") 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-current-line (cur m)) 0)))
  (test "C-o opens a line, keeping point"
    (let (m (ed-update (m-of "abc") :ctrl-o 80 24))
      (assert= (buffer-text (cur m)) "\nabc")
      (assert= (buffer-point (cur m)) 0)))
  (test "C-k kills to end of line (onto the kill ring)"
    (let (m (ed-update (m-of "abc\ndef") :ctrl-k 80 24))
      (assert= (buffer-text (cur m)) "\ndef")
      (assert= (first (get m :kill-ring)) "abc")))
  (test "C-k at end of line kills the newline"
    (let (m (ed-update (ed-set-buf (m-of "ab\ncd") (end-of-line (cur (m-of "ab\ncd")))) :ctrl-k 80 24))
      (assert= (buffer-text (cur m)) "abcd")))
  (test "M-d kills the word after point"
    (let (m (ed-update (m-of "foo bar") :alt-d 80 24))
      (assert= (buffer-text (cur m)) " bar")
      (assert= (first (get m :kill-ring)) "foo")))
  (test "M-DEL kills the word before point"
    (assert= (buffer-text (cur (press (m-of "foo bar") [:end (keyword "alt-backspace")]))) "foo "))
  (test "C-t transposes the two characters around point"
    (let (m (ed-update (ed-set-buf (m-of "ab") (forward-char (make-buffer "ab"))) :ctrl-t 80 24))
      (assert= (buffer-text (cur m)) "ba")))
  (test "M-u / M-l / M-c change word case"
    (assert= (buffer-text (cur (ed-update (m-of "foo bar") :alt-u 80 24))) "FOO bar")
    (assert= (buffer-text (cur (ed-update (m-of "FOO") :alt-l 80 24))) "foo")
    (assert= (buffer-text (cur (ed-update (m-of "foo") :alt-c 80 24))) "Foo"))
  (test "C-x d duplicates the current line"
    (assert= (buffer-text (cur (press (m-of "abc") [:ctrl-x "d"]))) "abc\nabc"))
  (test "M-^ joins the next line onto this one"
    (assert= (buffer-text (cur (ed-update (m-of "abc\ndef") (keyword "alt-^") 80 24))) "abcdef")))

;; ---- Emacs kill-ring semantics: coalescing + M-y yank-pop -------------------
(describe "editor kill ring (Emacs semantics)"
  (test "consecutive C-k coalesce into one kill-ring entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :ctrl-k]))   ; kill "abc", then the "\n"
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (get m :kill-ring)) "abc\n")          ; appended, not two entries
      (assert= (count (get m :kill-ring)) 1)))
  (test "a non-kill between kills starts a new entry"
    (let (m (press (m-of "abc\ndef") [:ctrl-k :right :ctrl-k]))  ; kill, move, kill
      (assert= (count (get m :kill-ring)) 2)))
  (test "M-DEL (backward kill) coalesces by prepending"
    (let (m (press (ed-set-buf (m-of "foo bar") (end-of-buffer (cur (m-of "foo bar"))))
                   [(keyword "alt-backspace") (keyword "alt-backspace")]))   ; kill "bar", then "foo "
      (assert= (first (get m :kill-ring)) "foo bar")
      (assert= (buffer-text (cur m)) "")))
  (test "C-y yanks the newest; M-y pops to the next-older kill"
    (let (m0 (assoc (m-of "") :kill-ring (list "newest" "older"))
          yanked (ed-update m0 :ctrl-y 80 24)
          popped (ed-update yanked :alt-y 80 24))
      (assert= (buffer-text (cur yanked)) "newest")
      (assert= (buffer-text (cur popped)) "older")))
  (test "M-y cycles the whole ring and wraps around"
    (let (m (assoc (m-of "") :kill-ring (list "a" "b" "c"))
          y0 (ed-update m :ctrl-y 80 24) y1 (ed-update y0 :alt-y 80 24)
          y2 (ed-update y1 :alt-y 80 24) y3 (ed-update y2 :alt-y 80 24))
      (assert= (buffer-text (cur y0)) "a")
      (assert= (buffer-text (cur y1)) "b")
      (assert= (buffer-text (cur y2)) "c")
      (assert= (buffer-text (cur y3)) "a")))   ; wrapped
  (test "M-y only works right after a yank"
    (let (no-yank (ed-update (assoc (m-of "") :kill-ring (list "x")) :alt-y 80 24)
          ;; editing between yank and M-y breaks it
          broke (ed-update (ed-update (assoc (m-of "") :kill-ring (list "a" "b")) :ctrl-y 80 24)
                           "z" 80 24))
      (is (string-contains? (get no-yank :echo) "not a yank"))
      (is (string-contains? (get (ed-update broke :alt-y 80 24) :echo) "not a yank")))))

;; ---- M-x: run interactive commands by name ----------------------------------
(describe "editor M-x"
  (test "defcommand registered the editing commands (interactive)"
    (is (> (count (command/command-names)) 20))
    (is (some? (fn (n) (= n "kill-line")) (command/command-names)))
    (is (some? (fn (n) (= n "newline")) (command/command-names))))
  (test "M-x runs a command by name"
    (let (m (press (m-of "ab") [:alt-x])
          done (ed-update (type-str m "open-line-below") :enter 80 24))
      (assert= (buffer-text (cur done)) "ab\n")))   ; open-line-below ran
  (test "M-x on an unknown name reports it (no crash)"
    (let (done (ed-update (type-str (press (m-of "x") [:alt-x]) "no-such-command") :enter 80 24))
      (is (not (get done :done)))
      (is (string-contains? (get done :echo) "no command"))))
  (test "M-x completion narrows the candidate list"
    (let (cands (ed-mb-candidates (get (type-str (press (m-of "x") [:alt-x]) "kill-") :minibuffer)))
      (is (string-contains? cands "kill-line"))
      (is (not (string-contains? cands "forward-char"))))))

;; ---- system layers (global) are active but hidden from the mode line --------
(describe "editor system layers"
  (test "the global layer is active (its keys work) but not shown as the mode"
    (let (m (m-of "x"))
      (is (some? (fn (l) (= (get l :name) 'global)) (layers/active-layers (cur m))))
      (assert= (ed-mode-name m) "text")))     ; global is :system → hidden; text shows
  (test "global bindings still dispatch (e.g. C-k) on a plain buffer"
    (assert= (buffer-text (cur (ed-update (m-of "abc") :ctrl-k 80 24))) "")))   ; kill-line via global
