(defmodule web-file-gutter-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use model)
  (:use web)
  (:use editor/buffer)
  (:use scroll) ; *line-numbers* — the init file's numbering, bound per test
  (:use test))

;; Regression + resilience: a file buffer's line-number-cell returns a LIST of chunks
;; ([bar face] [num face]) — the diff-hl change bar + the number — not a single [text face].
;; The web gutter renderer assumed the single form and match-errored, so web-render-app threw
;; the moment you switched to a file-backed buffer; the SSE worker caught it and dropped the
;; browser → "stops serving/reporting". Both renderers now share `model/gutter-cell-chunks`.

(describe "gutter-cell-chunks: the one shared decoder for both renderers"
  (test "normalises a single [text face] pair to a one-element chunk list"
    (assert= (gutter-cell-chunks ["   1  " {:fg :grey}]) (list ["   1  " {:fg :grey}])))
  (test "passes a list of chunks through unchanged"
    (let (cell (list ["|" {:fg :green}] ["   1  " {:fg :grey}]))
      (assert= (gutter-cell-chunks cell) cell))))

(describe "web mirror renders every buffer variety without dropping the browser"
  (test "file-backed buffer (diff-hl 2-chunk gutter cell) renders, shows the number"
    (let (m (ed-init (make-buffer "l0\nl1\nl2\nl3\nl4\nl5" "f.blsp" "/tmp/f.blsp"))
          html (web-render-app (web-snapshot m)))
      (is (includes? html "class=\"gutter\""))
      (is (includes? html "> 1 </span>")) ; the number and its blank column still render
      (is (includes? html "l0"))))
  (test "fileless buffer (single [text face] gutter cell) still renders"
    (let (m (ed-init (make-buffer "a\nb" "*scratch*"))
          html (web-render-app (web-snapshot m)))
      (is (includes? html "class=\"gutter\""))
      (is (includes? html "a")))))

;; C-x l flips what the pane SHOWS. It used to flip the override alone, as if every pane were
;; numbered by default — so with the init file's `:line-numbers {:default false …}` the first
;; toggle hid a gutter that was already hidden and only the second showed one.
(describe "C-x l toggles the numbers the pane shows"
  (defn- shown? (m)
    (let (pane (first (:panes (panes/ed-body-layout m 80 24))))
      (panes/ed-gutter-shown? (ed-current-buf m) pane)))
  (defn- toggled (setting times)
    ;; whether *scratch*'s numbers show after `times` toggles under `setting`
    (binding (*line-numbers* setting)
      (shown? (fold (range times)
                (ed-init (make-buffer "a\nb" "*scratch*"))
                (fn (acc _) (panes/ed-toggle-line-numbers acc))))))
  (test "numbered off by default: one toggle shows them, the next hides them"
    (refute (toggled {:default false} 0))
    (is (toggled {:default false} 1))
    (refute (toggled {:default false} 2)))
  (test "numbered on by default: one toggle hides them, the next shows them"
    (is (toggled true 0))
    (refute (toggled true 1))
    (is (toggled true 2))))
