;; Compilation mode (src/compile.blsp): the error-line parser + the async
;; event handlers. The compile worker process and M-x compile command are
;; exercised manually against a live editor; only the pure-Brood pieces live here.

(defmodule compile-test
  (:use test)
  (:use minibuffer)
  (:use model)
  (:use-internals compile)
  (:use editor/buffer))

(defn compile-model ()
  "A bare model with no *compilation* buffer — event handlers create it on first use."
  (ed-init (make-buffer "")))

(def compile-buf-name "*compilation*")

(defn compile-buf-text (m)
  "Text of the *compilation* buffer in `m`, or nil if absent."
  (let (idx (ed-buffer-index-by-name m compile-buf-name))
    (when idx (buffer-text (ed-buf-at m idx)))))

;; ---- error line parser -------------------------------------------------------

(describe "the error pattern table"
  (test "GCC / clang colon format, with and without a column"
    (assert= (results/loc-at-line "src/foo.ex:42: error")
      {:file "src/foo.ex" :line 42 :col 1})
    (assert= (results/loc-at-line "src/foo.ex:42:7: note")
      {:file "src/foo.ex" :line 42 :col 7}))
  (test "Rust --> format: the arrow row wins over the bare colon row"
    (assert= (results/loc-at-line "  --> src/main.rs:10:5")
      {:file "src/main.rs" :line 10 :col 5}))
  (test "Python traceback format is read before anything hunts for colons"
    (assert= (results/loc-at-line "  File \"app.py\", line 12, in foo")
      {:file "app.py" :line 12 :col 1})
    (assert= (results/loc-at-line "  File \"app.py\", line 3, in <module>")
      {:file "app.py" :line 3 :col 1}))
  (test "a File line with an empty path is not a location"
    (is (nil? (results/loc-at-line "  File \"\", line 5"))))
  (test "a line with no location at all is nil"
    (is (nil? (results/loc-at-line "Compiling myproject v0.1.0")))
    (is (nil? (results/loc-at-line "Compiling...")))
    (is (nil? (results/loc-at-line ""))))
  ;; The old parser split on ":" and asked only whether the next field was numeric,
  ;; so any `12:34:56` in a log — a timestamp, a duration — became line 34 of a file
  ;; named "12". The table's file group requires at least one non-digit character.
  (test "a bare timestamp is not a file:line"
    (is (nil? (results/loc-at-line "12:34:56")))
    (is (nil? (results/loc-at-line "  elapsed 00:01:30"))))

  ;; The formats this table exists for: an Elixir project's output, which bedit
  ;; could not have parsed by adding a row before captures existed.
  (test "ExUnit failure locations (file:line, no column)"
    (assert= (results/loc-at-line "     test/ledger_test.exs:12")
      {:file "test/ledger_test.exs" :line 12 :col 1}))
  (test "an ExUnit stacktrace frame"
    (assert= (results/loc-at-line "       (app 0.1.0) lib/ledger.ex:5: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 5 :col 1}))
  (test "a mix compile warning, new-style diagnostic"
    (assert= (results/loc-at-line "    └─ lib/ledger.ex:3:11: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 3 :col 11}))
  (test "a mix compile warning, old-style"
    (assert= (results/loc-at-line "  lib/ledger.ex:3: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 3 :col 1})))

(describe "compile--parse-errors"
  (test "extracts multiple error locations from Rust output"
    (let (text "   --> src/a.rs:1:2\nerror text\n   --> src/b.rs:5:1"
          errs (compile/compile-parse-errors text))
      (assert= (count errs) 2)
      (assert= (:file (first errs)) "src/a.rs")
      (assert= (:file (second errs)) "src/b.rs")))
  (test "returns an empty list when there are no error locations"
    (assert= (compile/compile-parse-errors "Compiling...\nFinished.") '()))
  (test "mixed output: only the error lines are collected, in order"
    (let (errs (compile/compile-parse-errors "Compiling...\nsrc/x.ex:7: error\nFinished."))
      (assert= (count errs) 1)
      (assert= (:line (first errs)) 7))))

;; ---- buffer append and reset -------------------------------------------------

(describe "compile--append"
  (test "creates *compilation* and appends text when the buffer is absent"
    (let (m (compile/compile-append (compile-model) "hello\n"))
      (is (not (nil? (ed-buffer-index-by-name m compile-buf-name))))
      (is (includes? (compile-buf-text m) "hello\n"))))
  (test "appends to an existing *compilation* buffer without adding a separator"
    (let (m1 (compile/compile-append (compile-model) "line1\n")
          m2 (compile/compile-append m1 "line2\n"))
      (is (includes? (compile-buf-text m2) "line1\nline2\n")))))

(describe "compile--reset"
  (test "creates a *compilation* buffer with the command in its header"
    (let (m (compile/compile-reset (compile-model) "make test"))
      (is (includes? (compile-buf-text m) "make test"))))
  (test "re-running reset clears previous output"
    (let (m1 (compile/compile-append (compile-model) "old output\n")
          m2 (compile/compile-reset m1 "make"))
      (is (not (includes? (compile-buf-text m2) "old output"))))))

;; ---- event handlers ----------------------------------------------------------

(describe "ed-ev-compile-output"
  (test "streams a chunk into *compilation*"
    (let (m (compile/ed-ev-compile-output (compile-model)
              (compile/compile-output-event "building...\n" [])
              24
              80
              24))
      (is (includes? (compile-buf-text m) "building...\n"))))
  (test "consecutive chunks accumulate without a separator"
    (let (m1 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "a" [])
               24
               80
               24)
          m2 (compile/ed-ev-compile-output m1 (compile/compile-output-event "b" []) 24 80 24))
      (is (includes? (compile-buf-text m2) "ab")))))

;; ---- ANSI colour, split across reads (issue #24) -------------------------------

(defn- compile-stream-into (m chunks)
  "`m` with `chunks` — one stream's reads, in order — run through the worker's decode step
(`compile-forward`, which sends each decoded chunk here) and folded as the loop folds them."
  (do
    (fold chunks
      (ansicolor/decoder)
      (fn (decoder chunk) (compile/compile-forward (self) decoder chunk)))
    (letrec (drain (fn (model)
                     (receive
                       (event (drain (compile/ed-ev-compile-output model event 24 80 24)))
                       (after 0 model))))
      (drain m))))

(defn- compile-output-spans (m)
  (ansicolor/colour-spans (ed-buf-at m (ed-buffer-index-by-name! m compile-buf-name))))

(describe "compile: a build's ANSI colours"
  (test "an escape split across two reads never leaks into *compilation*"
    (let (m (compile-stream-into (compile-model) ["\e[1" "mERROR\e[0m: x\n"]))
      (assert= (compile-buf-text m) "ERROR: x\n")))
  (test "every cut of a coloured line gives the same text and faces"
    (let (line "\e[1;31merror\e[0m src/a.c:3: \e[32mok\e[0m\r\n"
          whole (compile-stream-into (compile-model) [line])
          n (count line))
      (doseq (i (range 1 n))
        (let (cut (compile-stream-into (compile-model)
                    [(string/substring line 0 i) (string/substring line i n)]))
          (assert= [i (compile-buf-text cut)] [i "error src/a.c:3: ok\n"])
          ;; the faces may arrive as more than one span, but cover the same characters
          (assert= [i (mapcat (compile-output-spans cut) (fn (s) (range (first s) (second s))))]
            [i (mapcat (compile-output-spans whole) (fn (s) (range (first s) (second s))))])))))
  (test "the colours land as SGR attributes after the text already there"
    (let (m0 (compile/compile-append (compile-model) "head\n")
          m (compile-stream-into m0 ["\e[31mred\e[0m\n"])
          [from to face] (first (compile-output-spans m)))
      (assert= [from to] [5 8])
      (assert= face {:fg 1})))
  (test "a fresh compilation starts with no faces"
    (let (m (compile-stream-into (compile-model) ["\e[31mred\e[0m\n"]))
      (is (empty? (compile-output-spans (compile/compile-reset m "make")))))))

(describe "ed-ev-compile-done"
  (test "exit 0 appends 'Compilation finished' and echoes it"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 0) 24 80 24))
      (is (includes? (compile-buf-text m) "Compilation finished"))
      (is (includes? (:echo m) "Compilation finished"))))
  (test "non-zero exit appends an exit-code line"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 2) 24 80 24))
      (is (includes? (compile-buf-text m) "exited with code 2"))))
  (test "stores parsed errors on the model and resets the cursor to -1"
    (let (m0 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "src/x.ex:3: error\n" [])
               24
               80
               24)
          m (compile/ed-ev-compile-done m0 (compile/compile-done-event 1) 24 80 24))
      (assert= (count (:compile-errors m)) 1)
      (assert= (:compile-error-idx m) -1)))
  (test "no errors on a clean build — empty error list, echo says finished"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 0) 24 80 24))
      (assert= (:compile-errors m) '())
      (is (includes? (:echo m) "Compilation finished"))))
  (test "failed build with errors — echo shows the error count"
    (let (m0 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "src/a.ex:1: e\nsrc/b.ex:2: e\n" [])
               24
               80
               24)
          m (compile/ed-ev-compile-done m0 (compile/compile-done-event 1) 24 80 24))
      (is (includes? (:echo m) "2")))))

;; One parser for C-x ` and for RET on a results row (issue G7): the two used to disagree.
(describe "the one location parser"
  (test "a server announcing a URL is not an error location"
    (is (nil? (results/loc-at-line "[info] Running at http://localhost:4000 (http)")))
    (is (nil? (results/loc-at-line "Listening on 0.0.0.0:8080"))))
  (test "a Python traceback row jumps from a results buffer too"
    (assert= (results/loc-at-line "  File \"app.py\", line 12, in foo")
      {:file "app.py" :line 12 :col 1}))
  (test "a bare Makefile is a file; a column comes through"
    (assert= (:file (results/loc-at-line "Makefile:12: *** missing separator")) "Makefile")
    (assert= (:col (results/loc-at-line "src/x.rs:3:9: error")) 9))
  ;; Windows compilers name a file by its drive: the drive's colon is not the separator
  (test "a Windows drive path is one file, with either slash"
    (assert= (results/loc-at-line "C:\\src\\a.c:12:5: error: expected ';'")
      {:file "C:\\src\\a.c" :line 12 :col 5})
    (assert= (results/loc-at-line "D:/work/app/lib/x.ex:7: warning")
      {:file "D:/work/app/lib/x.ex" :line 7 :col 1})
    (assert= (results/loc-at-line "  --> C:\\proj\\src\\main.rs:10:5")
      {:file "C:\\proj\\src\\main.rs" :line 10 :col 5})))

;; `model/defuievent` declares the record AND its `UiEvent` impl. The impl must register
;; under the bare `UiEvent` the dispatcher asks about (`ui-event?`) — a qualified one
;; compiled, and every event it declared silently stopped folding.
(describe "defuievent events reach the loop"
  (test "each declared event is a UiEvent and folds through its named handler"
    (is (ui-event? (compile-output-event "x" [])))
    (is (ui-event? (compile-done-event 0)))
    (is (ui-event? (bshell/bshell-output-event "*shell*" "x" [] nil)))
    (is (ui-event? (bshell/bshell-done-event "*shell*" 0)))
    (is (ui-event? (terminal/term-exit-event "*term*" 0)))
    (let (m (ui-event-fold (compile-output-event "a.c:1: boom\n" []) (compile-model) 20 80 24))
      (is (includes? (editor/buffer/buffer-text (ed-buf-at m
                                                  (ed-buffer-index-by-name! m compile-buf-name)))
            "boom")))))

(describe "a prompt that opens once its candidates are ready (ed-open-when-ready)"
  (test "headless, the slow call runs inline and the prompt opens at once"
    (let (m (offloop/ed-open-when-ready (compile-model)
              "listing tasks"
              (fn () ["deps.get" "test"])
              (fn (m1 tasks) (assoc m1 :opened tasks))))
      (assert= (:opened m) ["deps.get" "test"])))
  (test "the answer opens the prompt it was asked for, and the wait is cleared"
    (let (waiting (assoc (compile-model)
                    :ready-wait :handle
                    :ready-open (fn (m1 tasks) (assoc m1 :opened tasks))
                    :ready-label "listing tasks")
          m (offloop/ed-apply-ready waiting ["test"]))
      (assert= (:opened m) ["test"])
      (is (nil? (:ready-wait m)))
      (is (nil? (:ready-open m)))))
  (test "a call that failed says so under its label and opens nothing"
    (let (waiting (assoc (compile-model)
                    :ready-wait :handle
                    :ready-open (fn (m1 tasks) (assoc m1 :opened tasks))
                    :ready-label "listing mix tasks")
          m (offloop/ed-apply-ready waiting :ready/failed))
      (is (nil? (:opened m)))
      (assert= (:echo m) "listing mix tasks: failed")))
  (test "while it runs, the activity chip names the wait"
    (is (includes? (ed-activity (assoc (compile-model)
                                  :ready-wait :handle
                                  :ready-label "listing mix tasks"))
          "listing mix tasks"))))
