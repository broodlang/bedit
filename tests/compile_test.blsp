;; Compilation mode (src/compile.blsp): the error-line parser + the async
;; event handlers. The compile worker process and M-x compile command are
;; exercised manually against a live editor; only the pure-Brood pieces live here.

(defmodule compile-test (:use test) (:use model) (:use-internals compile) (:use editor/buffer))

(defn compile-model ()
  "A bare model with no *compilation* buffer — event handlers create it on first use."
  (ed-init (make-buffer "")))

(def compile-buf-name "*compilation*")

(defn compile-buf-text (m)
  "Text of the *compilation* buffer in `m`, or nil if absent."
  (let (idx (ed-buffer-index-by-name m compile-buf-name))
    (when idx (buffer-text (nth (:buffers m) idx)))))

;; ---- error line parser -------------------------------------------------------

(describe "compile--parse-error-line: the pattern table"
  (test "GCC / clang colon format, with and without a column"
    (assert= (compile/compile-parse-error-line "src/foo.ex:42: error")
      {:file "src/foo.ex" :line 42 :col 1})
    (assert= (compile/compile-parse-error-line "src/foo.ex:42:7: note")
      {:file "src/foo.ex" :line 42 :col 7}))
  (test "Rust --> format: the arrow row wins over the bare colon row"
    (assert= (compile/compile-parse-error-line "  --> src/main.rs:10:5")
      {:file "src/main.rs" :line 10 :col 5}))
  (test "Python traceback format is read before anything hunts for colons"
    (assert= (compile/compile-parse-error-line "  File \"app.py\", line 12, in foo")
      {:file "app.py" :line 12 :col 1})
    (assert= (compile/compile-parse-error-line "  File \"app.py\", line 3, in <module>")
      {:file "app.py" :line 3 :col 1}))
  (test "a File line with an empty path is not a location"
    (is (nil? (compile/compile-parse-error-line "  File \"\", line 5"))))
  (test "a line with no location at all is nil"
    (is (nil? (compile/compile-parse-error-line "Compiling myproject v0.1.0")))
    (is (nil? (compile/compile-parse-error-line "Compiling...")))
    (is (nil? (compile/compile-parse-error-line ""))))
  ;; The old parser split on ":" and asked only whether the next field was numeric,
  ;; so any `12:34:56` in a log — a timestamp, a duration — became line 34 of a file
  ;; named "12". The table's file group requires at least one non-digit character.
  (test "a bare timestamp is not a file:line"
    (is (nil? (compile/compile-parse-error-line "12:34:56")))
    (is (nil? (compile/compile-parse-error-line "  elapsed 00:01:30"))))

  ;; The formats this table exists for: an Elixir project's output, which bedit
  ;; could not have parsed by adding a row before captures existed.
  (test "ExUnit failure locations (file:line, no column)"
    (assert= (compile/compile-parse-error-line "     test/ledger_test.exs:12")
      {:file "test/ledger_test.exs" :line 12 :col 1}))
  (test "an ExUnit stacktrace frame"
    (assert= (compile/compile-parse-error-line "       (app 0.1.0) lib/ledger.ex:5: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 5 :col 1}))
  (test "a mix compile warning, new-style diagnostic"
    (assert= (compile/compile-parse-error-line "    └─ lib/ledger.ex:3:11: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 3 :col 11}))
  (test "a mix compile warning, old-style"
    (assert= (compile/compile-parse-error-line "  lib/ledger.ex:3: App.Ledger.post/2")
      {:file "lib/ledger.ex" :line 3 :col 1})))

(describe "compile--parse-errors"
  (test "extracts multiple error locations from Rust output"
    (let (text "   --> src/a.rs:1:2\nerror text\n   --> src/b.rs:5:1"
          errs (compile/compile-parse-errors text))
      (assert= (count errs) 2)
      (assert= (:file (first errs)) "src/a.rs")
      (assert= (:file (second errs)) "src/b.rs")))
  (test "returns an empty list when there are no error locations"
    (assert= (compile/compile-parse-errors "Compiling...\nFinished.") '()))
  (test "mixed output: only the error lines are collected, in order"
    (let (errs (compile/compile-parse-errors "Compiling...\nsrc/x.ex:7: error\nFinished."))
      (assert= (count errs) 1)
      (assert= (:line (first errs)) 7))))

;; ---- buffer append and reset -------------------------------------------------

(describe "compile--append"
  (test "creates *compilation* and appends text when the buffer is absent"
    (let (m (compile/compile-append (compile-model) "hello\n"))
      (is (not (nil? (ed-buffer-index-by-name m compile-buf-name))))
      (is (includes? (compile-buf-text m) "hello\n"))))
  (test "appends to an existing *compilation* buffer without adding a separator"
    (let (m1 (compile/compile-append (compile-model) "line1\n")
          m2 (compile/compile-append m1 "line2\n"))
      (is (includes? (compile-buf-text m2) "line1\nline2\n")))))

(describe "compile--reset"
  (test "creates a *compilation* buffer with the command in its header"
    (let (m (compile/compile-reset (compile-model) "make test"))
      (is (includes? (compile-buf-text m) "make test"))))
  (test "re-running reset clears previous output"
    (let (m1 (compile/compile-append (compile-model) "old output\n")
          m2 (compile/compile-reset m1 "make"))
      (is (not (includes? (compile-buf-text m2) "old output"))))))

;; ---- event handlers ----------------------------------------------------------

(describe "ed-ev-compile-output"
  (test "streams a chunk into *compilation*"
    (let (m (compile/ed-ev-compile-output (compile-model)
              (compile/compile-output-event "building...\n")
              24
              80
              24))
      (is (includes? (compile-buf-text m) "building...\n"))))
  (test "consecutive chunks accumulate without a separator"
    (let (m1 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "a")
               24
               80
               24)
          m2 (compile/ed-ev-compile-output m1 (compile/compile-output-event "b") 24 80 24))
      (is (includes? (compile-buf-text m2) "ab")))))

(describe "ed-ev-compile-done"
  (test "exit 0 appends 'Compilation finished' and echoes it"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 0) 24 80 24))
      (is (includes? (compile-buf-text m) "Compilation finished"))
      (is (includes? (:echo m) "Compilation finished"))))
  (test "non-zero exit appends an exit-code line"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 2) 24 80 24))
      (is (includes? (compile-buf-text m) "exited with code 2"))))
  (test "stores parsed errors on the model and resets the cursor to -1"
    (let (m0 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "src/x.ex:3: error\n")
               24
               80
               24)
          m (compile/ed-ev-compile-done m0 (compile/compile-done-event 1) 24 80 24))
      (assert= (count (:compile-errors m)) 1)
      (assert= (:compile-error-idx m) -1)))
  (test "no errors on a clean build — empty error list, echo says finished"
    (let (m (compile/ed-ev-compile-done (compile-model) (compile/compile-done-event 0) 24 80 24))
      (assert= (:compile-errors m) '())
      (is (includes? (:echo m) "Compilation finished"))))
  (test "failed build with errors — echo shows the error count"
    (let (m0 (compile/ed-ev-compile-output (compile-model)
               (compile/compile-output-event "src/a.ex:1: e\nsrc/b.ex:2: e\n")
               24
               80
               24)
          m (compile/ed-ev-compile-done m0 (compile/compile-done-event 1) 24 80 24))
      (is (includes? (:echo m) "2")))))
