;; The screen-row → buffer-line mapping has ONE owner: `panes/ed-pane-line-at` (and its
;; clamped twin). It used to be spelled inline at five sites — `top + (row - py) / s` —
;; and when smooth scrolling let a pane rest between lines, every one of them was wrong
;; by the same half-line while the view was right (a click selected the line above what
;; it clicked on). This test keeps the arithmetic out of every other file, so the next
;; hit-test asks the owner instead of re-deriving the geometry.

(defmodule geometry-lint-test (:use test))

(defn- src-files ()
  (map (seq/filter (file/ls "src") (fn (f) (string/ends-with? f ".blsp")))
    (fn (f) (if (string/starts-with? f "src/") f (path/join "src" f)))))

(describe "the row→line mapping lives in panes.blsp alone"
  (test "no other source file adds a scroll top to a row offset"
    (let (offenders (seq/keep (src-files)
                      (fn (f)
                        (if (= (path/basename f) "panes.blsp")
                          nil
                          (let (src (file/slurp f))
                            ;; the two spellings the inline mapping took: `(+ top (math/quot … row`
                            ;; and `(+ top (- row`
                            (if (or (regex/match? "\\(\\+ top \\(math/quot[^\n]*row" src)
                                  (regex/match? "\\(\\+ top \\(- row" src))
                              (path/basename f)
                              nil))))))
      (assert= (into [] offenders) []))))
