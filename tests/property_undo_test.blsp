;; Undo as a property (brood's `property`, ADR-685): whatever a random run of editing keys does
;; to a buffer — typing, the delete keys, kills and yanks, transposes, case, open-line, a region,
;; the undo-pause boundary between them — undoing until there is nothing left gives back the text
;; it started with, and redoing until there is nothing left gives back the edited text. A
;; failure shrinks to the fewest, simplest keys that still break it.
(defmodule property-undo-test
  (:use testkit :only [press]) ; the shared test helpers (tests/support)
  (:use model) ; ed-init / ed-current-buf
  (:use-internals input) ; ed-update
  (:use editor/buffer)
  (:use test))

(defn- text-of (m) (buffer-text (ed-current-buf m)))

;; The keys a run is made of. A chord (C-x C-t, C-u C-k) is one entry, so a shrunk run never
;; ends inside a prefix.
(def- editing-keys
  [[:enter]
    [:backspace]
    [:delete]
    [:ctrl-d]
    [:ctrl-k]
    [:ctrl-u :ctrl-k]
    [:alt-d]
    [:ctrl-y]
    [:alt-y]
    [:ctrl-w]
    [:alt-w]
    [:ctrl-t]
    [:alt-t]
    [:ctrl-x :ctrl-t]
    [:alt-u]
    [:alt-l]
    [:alt-c]
    [:ctrl-o]
    [(keyword "ctrl- ")]
    [:timer :undo-pause]])

(def- motion-keys [[:left] [:right] [:up] [:down] [:ctrl-a] [:ctrl-e] [:alt-f] [:alt-b]])

;; A typed run: one to three characters, plain and not.
(def- typed-keys
  (property/fmap (property/string-of "ab é😀" {:min 1 :max 3}) (fn (text) (string/->list text))))

(def- key-group
  (property/frequency [[4 typed-keys]
                        [5 (property/elements editing-keys)]
                        [3 (property/elements motion-keys)]]))

;; `[:timer :undo-pause]` is an event, not two keys: keep it whole.
(defn- group-events (group)
  (if (= group [:timer :undo-pause]) [group] group))

(def- runs
  (property/tuple (property/string-of "ab \né" {:max 12})
    (property/fmap (property/vector-of key-group {:max 24})
      (fn (groups) (mapcat groups group-events)))))

;; Press `key` until the echo area says `exhausted` (or `limit` presses, a stuck chain).
(defn- press-until (m key exhausted limit)
  (if (or (<= limit 0) (includes? (or (:echo m) "") exhausted))
    m
    (press-until (ed-update m key 80 24) key exhausted (dec limit))))

(describe "undo as a property"
  (test "undoing every change gives back the original text, redoing every undo the edited one"
    (check-property 30
      runs
      (fn ([original keys])
        (let (edited (press (ed-init (make-buffer original)) keys)
              undone (press-until (press edited [:ctrl-g]) :ctrl-/ "No further undo" 400)
              redone (press-until undone :ctrl-? "No undo to redo" 400))
          (and (= original (text-of undone)) (= (text-of edited) (text-of redone))))))))
