(defmodule testkit
  "What bedit's tests share: a model over a buffer of text, its current buffer, keys pressed
through the real dispatch at a fixed 80×24 frame, text typed, and what the echo area SAYS —
wherever a message shows. Each test module `:use`s the names it calls (`(:use testkit :only
[m-of press])`), so a file that needs a variant (another frame size) keeps its own.

Lives under tests/support, on project.blsp's `:source-paths` so the tests can `:use` it; no
`src/` module names it."
  (:use model) ; ed-init / ed-current-buf
  (:use input :only [ed-update]) ; a key folded as the loop folds it
  (:use editor/buffer :only [make-buffer buffer-text goto-char]))

(defn m-of (text)
  "A model over one buffer holding `text`, point at its start."
  (ed-init (make-buffer text)))

(defn cur (m)
  "The current buffer of `m`."
  (ed-current-buf m))

(defn press (m keys)
  "`m` after each key of `keys` (strings for characters, keywords for the rest:
`[:ctrl-x \"o\"]`) went through the editor's own dispatch, at an 80×24 frame."
  (fold keys m (fn (acc key) (ed-update acc key 80 24))))

(defn type-str (m text)
  "`m` after `text` was typed, a character at a time ([[press]])."
  (press m (string/->list text)))

(defn after (text key)
  "The text of a buffer holding `text` after `key` was pressed in it."
  (buffer-text (cur (ed-update (m-of text) key 80 24))))

(defn said (m)
  "What the echo area shows of `m` as a message: the one kept BESIDE a standing prompt (a
minibuffer read, whose `message` waits there until the next key), else the echo line — so a
test asks one place whether a prompt is open or not."
  (or (map/get-in m [:minibuffer :message]) (:echo m)))

(defdelegate load-test-grammar (lang) corpus) ; a grammar a test run's scratch home lacks

(defn numbered (m)
  "`m` with every pane numbering its lines, as C-x l on each would: a test that reads the
gutter beside a plain or prose buffer, which is not numbered by default
(`display-settings/*line-numbers-defaults*`)."
  (ed-map-panes m (fn (payload) (assoc payload :line-numbers true))))

;; ---- the source tree, for the guards that read it -------------------------------------------

(defn source-files ()
  "Every `.blsp` path under src/, sorted — a context's details included, in their folder
(`src/shells/comint.blsp`). The one walk the source guards share, so none of them goes blind
to a folder."
  (sort (seq/filter (file/walk-files "src") (fn (path) (string/ends-with? path ".blsp")))))

(defn source-module (path)
  "The module the source file `path` holds, by the project's naming: `src/shells/comint.blsp`
is `shells/comint`."
  (let (inside (string/substring path (count "src/") (count path)))
    (string/substring inside 0 (- (count inside) (count ".blsp")))))

;; ---- a language mode's answers, for the language tests ---------------------------------------

(defn file-model (text file)
  "A model over one buffer holding `text`, visiting `file` — typed by `file`'s name, as a visit
types it — point at its start."
  (ed-init (make-buffer text file file)))

(defn file-buffer (text file)
  "The current buffer of a model over a buffer holding `text`, visiting `file` ([[file-model]])."
  (ed-current-buf (file-model text file)))

(defn nav-at (text file pos)
  "A model over one buffer holding `text`, visiting `file` ([[file-model]]), point at `pos`."
  (let (m (file-model text file)
        i (ed-current-index m))
    (assoc m :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) pos)))))

(defn fontified (src file)
  "The spans the mode of `file` colours `src` with."
  ((ed-mode-service (file-buffer src file) :fontify) src))

(defn without-grammars (thunk)
  "`thunk`'s value, run as a runtime with no grammar installed would run it."
  (binding (*grammar-ready?* (fn (_lang) false)) (thunk)))

(defn text-ops-where (frame pred)
  "The `:text` ops of `frame` whose drawn string satisfies `pred`."
  (seq/filter frame (fn (op) (and (= (first op) :text) (pred (nth op 3 ""))))))

(defn face-at (spans src needle)
  "The face of the span in `spans` that starts exactly where `needle` first occurs in `src`,
or nil."
  (let (at (index-of src needle)
        hit (seq/find spans (fn (span) (= (first span) at))))
    (when hit (nth hit 2))))

(defn faced? (spans face-name)
  "Whether any of `spans` is painted in the face named `face-name`."
  (any? spans (fn (span) (= (nth span 2) (editor/face/face face-name)))))

(defdelegate indent-rows (src file &optional skip?) corpus) ; each line's column, and the mode's

(defn indents (src file)
  "`[got want]`: the column the mode of `file` indents every non-blank line of `src` to, and
the column the line already has (a tab reaching the next multiple of 8) — equal when the mode
lays `src` out as it is written ([[indent-rows]])."
  (let (rows (indent-rows src file)) [(into [] (map rows :got)) (into [] (map rows :want))]))

(defn window-and-whole (text file from-line to-line)
  "`[windowed whole]`: the spans over lines `[from-line, to-line)` of a buffer holding `text`, cut to them,
visiting `file`, as the windowed fontify paints them (`spancache/ed-window-spans`, its lead-in
`spancache/ed-fontify-backscan` lines) and as fontifying the whole text does. A file longer than
the lead-in proves what a window far down it learns of the text above."
  (let (buf (file-buffer text file)
        rope (editor/buffer/buffer-rope buf)
        start (text/line->char rope from-line)
        end (text/line->char rope to-line)
        fontify (ed-mode-service buf :fontify)
        inside (fn (spans)
                 (into []
                   (seq/keep spans
                     (fn ([span-start span-end face])
                       (when (and (> span-end start) (< span-start end))
                         [(math/max span-start start) (math/min span-end end) face]))))))
    [(inside (spancache/ed-window-spans buf
               fontify
               (ed-mode-service buf :fontify-restart)
               from-line
               to-line))
      (inside (fontify text))]))
