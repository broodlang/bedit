(defmodule testkit
  "What bedit's tests share: a model over a buffer of text, its current buffer, keys pressed
through the real dispatch at a fixed 80×24 frame, text typed, and what the echo area SAYS —
wherever a message shows. Each test module `:use`s the names it calls (`(:use testkit :only
[m-of press])`), so a file that needs a variant (another frame size) keeps its own.

Lives under tests/support, on project.blsp's `:source-paths` so the tests can `:use` it; no
`src/` module names it."
  (:use model) ; ed-init / ed-current-buf
  (:use input :only [ed-update]) ; a key folded as the loop folds it
  (:use editor/buffer :only [make-buffer buffer-text]))

(defn m-of (text)
  "A model over one buffer holding `text`, point at its start."
  (ed-init (make-buffer text)))

(defn cur (m)
  "The current buffer of `m`."
  (ed-current-buf m))

(defn press (m keys)
  "`m` after each key of `keys` (strings for characters, keywords for the rest:
`[:ctrl-x \"o\"]`) went through the editor's own dispatch, at an 80×24 frame."
  (fold keys m (fn (acc key) (ed-update acc key 80 24))))

(defn type-str (m text)
  "`m` after `text` was typed, a character at a time ([[press]])."
  (press m (string/->list text)))

(defn after (text key)
  "The text of a buffer holding `text` after `key` was pressed in it."
  (buffer-text (cur (ed-update (m-of text) key 80 24))))

(defn said (m)
  "What the echo area shows of `m` as a message: the one kept BESIDE a standing prompt (a
minibuffer read, whose `message` waits there until the next key), else the echo line — so a
test asks one place whether a prompt is open or not."
  (or (map/get-in m [:minibuffer :message]) (:echo m)))
