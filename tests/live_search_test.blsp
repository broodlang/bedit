;; M-s r — the project searched as you type (consult-ripgrep), over the minibuffer's
;; off-loop `:async-source`. Tests are headless, so the source runs inline on each keystroke;
;; the fold a live editor uses when the task lands is driven directly.
(defmodule live-search-test
  (:use testkit :only [press type-str]) ; the shared test helpers (tests/support)
  (:use minibuffer)
  (:use model)
  (:use input)
  (:use pool)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn- live-project ()
  ;; a project with two files, and a model visiting one of them
  (let (root (path/temp "bedit-live-")
        _ (file/mkdir root)
        _ (file/spit (path/join root "project.blsp") "(project :name \"t\")\n")
        _ (file/spit (path/join root "a.txt") "alpha\n")
        _ (file/spit (path/join root "b.txt") "x\ny\nneedle here\n"))
    [root (ed-find-file (ed-init (make-buffer "")) (path/join root "a.txt"))]))

(describe "live project search (M-s r)"
  (test "the rows follow the typed text, and nothing runs below three characters"
    (let ([_root m] (live-project)
          open (press m [:alt-s "r"])
          short (type-str open "ne")
          typed (type-str short "edle"))
      (assert= (mb-candidates (:minibuffer short)) ())
      (assert= (vec (mb-candidates (:minibuffer typed))) ["b.txt:3:needle here"])))
  (test "RET on a row visits its file at its line"
    (let ([root m] (live-project)
          visited (press (type-str (press m [:alt-s "r"]) "needle") [:enter])
          buf (ed-current-buf visited))
      (assert= (:file buf) (path/join root "b.txt"))
      (assert= (buffer-current-line buf) 2)
      (is (nil? (:minibuffer visited)))))
  (test "RET with nothing listed runs the full search into *Project Search*"
    (let ([_root m] (live-project)
          searched (press (type-str (press m [:alt-s "r"]) "zzz-nowhere") [:enter]))
      (assert= (buffer-name (ed-current-buf searched)) "*Project Search*")))
  (test "an answer for text the prompt has moved past is dropped"
    (let ([_root m] (live-project)
          open (type-str (press m [:alt-s "r"]) "needle")
          stale (ed-apply-mb-async open {:for "need" :cands ["old"]})
          fresh (ed-apply-mb-async open {:for "needle" :cands ["new"]}))
      (assert= (vec (mb-candidates (:minibuffer stale))) ["b.txt:3:needle here"])
      (assert= (vec (mb-candidates (:minibuffer fresh))) ["new"])
      (assert= (ed-apply-mb-async (dissoc open :minibuffer) {:for "needle" :cands ["x"]})
        (dissoc open :minibuffer)))))

;; The live search cancels its task on every keystroke and relies on `os/cmd`'s child dying
;; with it (brood ADR-514, in 0.49.1 — bedit's floor). Pinned here, so lowering the floor
;; below it fails a test rather than leaving `rg`s running.
(describe "a live search's process"
  (test "cancelling the task running os/cmd kills the child"
    (let (dir (path/temp "bedit-live-kill-")
          _ (file/mkdir dir)
          pid-file (path/join dir "pid")
          handle (task/task (fn ()
                              (os/cmd "sh"
                                ["-c" (str "echo $$ > " pid-file "; exec sleep 30")]
                                {:cwd dir})))
          ;; polls, bounded: the child writes its pid once it is running, and the kill is
          ;; asynchronous to `task/cancel`
          wait-for (fn (ready?)
                     (letrec (poll (fn (tries)
                                     (cond
                                       (ready?) true
                                       (= tries 0) false
                                       else (receive (after 20 (poll (dec tries)))))))
                       (poll 250)))
          alive? (fn (pid) (= 0 (:exit (os/cmd "kill" ["-0" pid]))))
          _ (wait-for (fn ()
                        (and (file/exists? pid-file) (not (string/blank? (file/slurp pid-file))))))
          pid (string/trim (file/slurp pid-file)))
      (is (alive? pid))
      (task/cancel handle)
      (is (wait-for (fn () (not (alive? pid))))))))

(describe "M-s r and the jump stack"
  (test "M-, after visiting a hit comes back to where the search started"
    (let ([root m] (live-project)
          visited (press (type-str (press m [:alt-s "r"]) "needle") [:enter])
          back (press visited [(keyword "alt-,")]))
      (assert= (:file (ed-current-buf visited)) (path/join root "b.txt"))
      (assert= (:file (ed-current-buf back)) (path/join root "a.txt")))))
