;; CSS (src/languages/css.blsp): a `deflanguage` over tree-sitter-css, and its language-server row
;; (src/lsp/client.blsp).
;; Its sample is the corpus's, tests/corpus/css/; the parsed checks need the grammar
;; (`testkit/load-test-grammar`) and SKIP without it.
(defmodule languages-css-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at]))

(defn- face-of (name) (editor/face/face name))

(describe "css, the mode"
  (test "it parses with tree-sitter-css, which says where it lives"
    (assert= (ed-mode-service (file-buffer "" "/p/a.css") :ts-lang) :css)
    (assert= (:url (model/grammar-source :css)) "https://github.com/tree-sitter/tree-sitter-css"))
  (test "it has only a block comment"
    (is (nil? (ed-mode-service (file-buffer "" "/p/a.css") :comment-syntax)))
    (assert= (ed-mode-service (file-buffer "" "/p/a.css") :comment-block) ["/* " " */"]))
  (test "it formats with prettier"
    (assert= (ed-mode-service (file-buffer "" "/p/a.css") :format-command)
      ["prettier" "--write" "--log-level" "warn"]))
  (test "a stylesheet reaches VS Code's css server, as language id css"
    (assert= (into [] (map (lsp/client/lsp-specs-for "/p/a.css") :name)) ["css"])
    (assert= (lsp/client/lsp-language-id "/p/a.css") "css")))

(describe "css, the fontify restart"
  (test "CSS: the previous column-0 selector or at-rule"
    (let (src "a {\n  color: red;\n}\n\n.b {\n  margin: 0;\n}\n")
      (assert= (languages/css/css-restart src (index-of src "  margin")) (index-of src ".b"))))
  (test "CSS: a block comment closed above cuts after it; one still open cuts before it"
    (let (src "/*\n.x {\n*/\n.b {\n  margin: 0;\n}\n")
      (assert= (languages/css/css-restart src (index-of src "  margin")) (index-of src ".b")))
    (let (src "b {}\na {}\n/*\n.x {\n  margin: 0;\n")
      (assert= (languages/css/css-restart src (index-of src "  margin")) (index-of src "a {}")))))

;; The sample, tests/corpus/css/site.css (prettier), is checked by tests/language_corpus_test.blsp:
;; its mode, colours, indentation and restart.
(def css-src (file/slurp "tests/corpus/css/site.css"))

(test "css — a class selector in column 0 is a function"
  :skip-unless (testkit/load-test-grammar :css)
  "no css grammar"
  (assert= (face-at (languages/css/css-fontify css-src) css-src ".card")
    (face-of :syntax/function)))
