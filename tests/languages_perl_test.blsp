;; Perl (src/languages/perl.blsp): a `deflanguage` over tree-sitter-perl. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-perl.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-perl-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "perl, the mode"
  (test "a .pl and a .t file, and a perl script, open in perl mode"
    (doseq (file ["/p/run.pl" "/p/t/basic.t"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "perl"))
    (assert= (ed-buf-mode-name (file-buffer "#!/usr/bin/perl\nprint 1;\n" "/p/run")) "perl"))
  (test "it parses with tree-sitter-perl, comments with # and formats with perltidy"
    (assert= (ed-mode-service (file-buffer "" "/p/a.pl") :ts-lang) :perl)
    (assert= (:url (model/grammar-source :perl))
      "https://github.com/tree-sitter-perl/tree-sitter-perl")
    (assert= (ed-mode-service (file-buffer "" "/p/a.pl") :comment-syntax) "# ")
    (assert= (ed-mode-service (file-buffer "" "/p/a.pl") :format-command)
      ["perltidy" "-b" "-bext=/"]))
  (test "the restart: a column-0 item, unless a heredoc (open until its chosen word) is above"
    (let (src "package A;\n\nsub f {\n    return 1;\n}\n")
      (assert= (languages/perl/perl-restart src (index-of src "    return"))
        (index-of src "sub f")))
    (let (src "my $s = <<EOT;\nsub x {\nEOT\nsub f {\n    return 1;\n}\n")
      (assert= (languages/perl/perl-restart src (index-of src "    return")) 0)))
  (test "the restart: POD closed by =cut above cuts at the item after it; open POD declines"
    (let (src "1;\n=pod\n\nsub x {\n\n=cut\nsub f {\n    return 1;\n}\n")
      (assert= (languages/perl/perl-restart src (index-of src "    return"))
        (index-of src "sub f")))
    (let (src "=head1 NAME\n\nsub x {\n\n=cut\nsub f {\n    return 1;\n}\n")
      (assert= (languages/perl/perl-restart src (index-of src "    return"))
        (index-of src "sub f")))
    (let (src "use strict;\nsub g {}\n=pod\n\nsub x {\n    return 1;\n")
      (assert= (languages/perl/perl-restart src (index-of src "    return"))
        (index-of src "sub g")))))

;; A heredoc is kept out of the sample, which every runtime must indent as written. Its body is a
;; `heredoc_content` node that begins ON its first line, not on the `<<"EOT"` line, and the
;; indenter keeps a line verbatim only inside a node that began on an EARLIER one, so that first
;; line was indented as code (four here) instead of being left in column 0 — until brood ADR-758,
;; which keeps a content node that opens at its line's start inside a statement an earlier line
;; began. Its faces are checked always, its indentation on a runtime with ADR-758 (below).
(def perl-heredoc-src
  "sub f {\n    my $text = <<\"EOT\";\nheredoc $who text\nEOT\n    return $text;\n}\n")

;; The sample, tests/corpus/perl/Greeter.pm (perltidy's defaults), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart. What stays here is
;; what a caret line cannot say: a keyword in column 0 under a line that opens a block, and the
;; heredoc's own text.
(def perl-src (file/slurp "tests/corpus/perl/Greeter.pm"))

(when (load-test-grammar :perl)
  (describe "perl, parsed"
    (def perl-spans (languages/perl/perl-fontify perl-src))
    (test "a keyword at the margin, and an uncuddled elsif"
      (assert= (face-at perl-spans perl-src "sub new") (face-of :syntax/keyword))
      (assert= (face-at perl-spans perl-src "elsif") (face-of :syntax/keyword)))
    (test "a heredoc is a string, and the variables inside it are code"
      (let (spans (languages/perl/perl-fontify perl-heredoc-src))
        (assert= (face-at spans perl-heredoc-src "<<\"EOT\"") (face-of :syntax/string))
        (assert= (face-at spans perl-heredoc-src "heredoc ") (face-of :syntax/string))
        (assert= (face-at spans perl-heredoc-src "$who text") nil)))
    (test "a sub and a package are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/perl/perl-spec :definitions)))
        (doseq (kind [:subroutine_declaration_statement :package_statement])
          (is (contains? kinds kind)))))))

;; brood ADR-758: a heredoc body's first line is content. Asked of a runtime that has it — the
;; same release taught `language-names` the `:hanging` key, which is what is probed.
(when (and (load-test-grammar :perl)
        (contains? (:kinds (editor/treesit/language-names {:indent {:hanging #{:probe}}})) :probe))
  (describe "perl, a heredoc's body"
    (test "every line of a heredoc keeps its own indentation, its first line too"
      (let ([got want] (indents perl-heredoc-src "/p/heredoc.pl")) (assert= got want)))))
