(defmodule main-test
  (:use completion)
  (:use test))

;; The floating completion / right-click card: a flat cell-quantised `rect` in the terminal
;; (and tests), a rounded sub-cell `frect` card in the GUI (:gui on the model). Same
;; geometry either way, so the click hit-test still lines up.

(defn op-tags (ops) (map first ops))

(describe "completion card renders flat (terminal) vs rounded (GUI)"
  (test "without :gui it's a solid rect card, no frect"
    (let (ops (completion-menu-ops (list "alpha" "beta") 0 0 5 10 6))  ; gui? defaults false
      (is (member? :rect (op-tags ops)))
      (is (not (member? :frect (op-tags ops))))))
  (test "with gui? it's a rounded frect card (surface + a selection pill), no rect"
    (let (ops (completion-menu-ops (list "alpha" "beta") 0 0 5 10 6 true))
      (is (member? :frect (op-tags ops)))
      (is (not (member? :rect (op-tags ops))))
      ;; the card surface + one pill for the selected row = two frects
      (assert= (count (filter (fn (t) (= t :frect)) (op-tags ops))) 2)))
  (test "both paths render every item as a text row"
    (let (flat (completion-menu-ops (list "a" "b" "c") 0 1 5 10 4)
          gui (completion-menu-ops (list "a" "b" "c") 0 1 5 10 4 true))
      (assert= (count (filter (fn (t) (= t :text)) (op-tags flat))) 3)
      (assert= (count (filter (fn (t) (= t :text)) (op-tags gui))) 3))))
