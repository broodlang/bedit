;; The spacing ratchet: a raw number where a SPACING TOKEN belongs.
;;
;; Every space the chrome puts between things comes from one table, `ui-kit/ui-spacing`
;; (rows vertically, cells horizontally, half the only fractional step). A widget style's
;; `:pad` / `:inset` / `:gap` names a step of it, and `ui-space` raises on anything else at
;; run time — but a spacing CONSTANT (`(def *x-inset* 0.16)`) never reaches `ui-space`, and
;; a style that is never rendered by a test would not raise. This counts both by reading
;; the source, as Atlassian's `ensure-design-token-usage` lint does, and the count may only
;; shrink. ZERO since 2026-11-05, when the table landed and every literal moved onto it
;; (the report's item 6): so it is a gate. A new spacing value is a token in the table.
(defmodule spacing-ratchet-test (:use test))

(def- spacing-patterns
  ;; a style key holding a number or a vector of them: `:pad [1 1 1 1]`, `:inset 2`
  ["(^|[^a-z-]):(pad|inset|gap)\\s+(-?[0-9.]|\\[\\s*-?[0-9.])"
    ;; a spacing constant defined as a number: `(def *sb-hover-pad* 0.55)`
    "\\(def-?\\s+\\*[a-z0-9-]*-(pad|inset|vinset|gap)\\*\\s+-?[0-9.]"])

(defn- code-line? (line)
  "Whether `line` is code rather than a whole-line comment."
  (not (string/starts-with? (string/trim line) ";")))

(defn- raw-spacing (file)
  "Every line of source `file` holding a raw number in a spacing position, as `file:line text`."
  (let (lines (string/split (file/slurp file) "\n"))
    (seq/keep (seq/enumerate lines)
      (fn ([index line])
        (when (and (code-line? line)
                (any? spacing-patterns (fn (pattern) (regex/match? line pattern))))
          (str file ":" (inc index) " " (string/trim line)))))))

(defn- source-files ()
  "Every `.blsp` under src/ except the table's own module."
  (map (seq/filter (sort (file/ls "src"))
         (fn (name) (and (string/ends-with? name ".blsp") (not (= name "ui-kit.blsp")))))
    (fn (name) (path/join "src" name))))

(describe "raw spacing numbers only shrink"
  (test "the pattern sees the literals it is for"
    (is (any? spacing-patterns (fn (pattern) (regex/match? "   :pad [1 1 1 1]" pattern))))
    (is (any? spacing-patterns (fn (pattern) (regex/match? "{:inset 2 :gap 3}" pattern))))
    (is (any? spacing-patterns
          (fn (pattern) (regex/match? "(def *sb-hover-vinset* 0.16) ; margin" pattern))))
    (is (not (any? spacing-patterns (fn (pattern) (regex/match? "   :pad :card" pattern)))))
    (is (not (any? spacing-patterns
               (fn (pattern) (regex/match? "(def *plume-inset* (ui-space-cells :flush))" pattern))))))

  (test "no raw number sits where a spacing token belongs"
    ;; the ceiling is 0; printed through `assert=` against the offending lines so a failure
    ;; names them
    (let (found (into [] (mapcat (source-files) raw-spacing)))
      (assert= [] found))))
