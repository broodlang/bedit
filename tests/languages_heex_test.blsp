;; HEEx (src/languages/heex.blsp): a `deflanguage` over tree-sitter-heex, for Phoenix templates.
;; Elixir's `~H` sigil coloured as HEEx is tests/languages_elixir_test.blsp's.
;; The parsed half needs the grammar (`testkit/load-test-grammar`: `$BROOD_TEST_GRAMMARS`, which CI
;; fills, else the user's `~/.config/bedit/grammars`) and SKIPS without it.
(defmodule languages-heex-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model file-buffer]))

(describe "a .heex file is heex-mode"
  (test "the grammar's source, a well-formed table"
    (assert= (:url (grammarfallback/grammar-source :heex))
      "https://github.com/phoenixframework/tree-sitter-heex")
    (is (empty? (editor/treesit/face-table-problems languages/heex/heex-face-table)))))

(describe "heex-mode, by name"
  (test ".eex and .leex templates are heex"
    (assert= (ed-buf-mode-name (cur (file-model "" "/p/index.html.eex"))) "heex")
    (assert= (ed-buf-mode-name (cur (file-model "" "/p/page.html.leex"))) "heex")))

(describe "heex, found by review"

  (when (testkit/load-test-grammar :heex)
    (test "HEEx: a closing tag backs out to its opening tag's column"
      (let (src "<div>\n  <p>hi</p>\n</div>\n"
            indent (ed-mode-service (file-buffer src "/p/x.heex") :indent))
        (assert= (indent src (index-of src "</div>")) 0)))))
