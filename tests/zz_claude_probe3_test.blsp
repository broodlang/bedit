(defmodule zz-claude-probe3-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use-internals tutor)
  (:use bedit/tutor-lessons)
  (:use bedit/results))

(defn- tut-buf (m) (ed-current-buf m))

(describe "probe: which boxes raise without the flag"
  (test "list them"
    (let (bad (mapcat (range (count tutor-lessons)) (fn (i)
                (let (m (ed-tutor-launch (tutor/tutor-show (ed-init (make-buffer "")) i))
                      notes (or (eol-notes (tut-buf m)) {})
                      pgs (tutor/tutor-playgrounds m))
                  (mapcat (range (count pgs)) (fn (r)
                    (let (note (get notes r) pg (nth pgs r {}))
                      (if (and (:error? note) (not (:starts-with-error? pg)))
                        (list {:lesson i :box r :text (:text note)})
                        '()))))))))
      (assert= bad '()))))
