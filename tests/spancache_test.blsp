;; tests/spancache_test.blsp — the char ranges a per-window highlight reads
;; (`spancache/ed-visible-windows`): whole lines merged into one range, or a long line's
;; window only.
(defmodule spancache-test
  (:use test))

(def- rope (text/string-> "a\nbb\nccc\n"))

(describe "the visible windows"
  (test "with no clip, the lines shown are one range from the first's start to the last's end"
    (assert= (vec (spancache/ed-visible-windows rope 1 1 nil)) [[2 9]])
    (assert= (vec (spancache/ed-visible-windows rope 0 10 nil)) [[0 9]]))
  (test "past the end, the last line"
    (assert= (vec (spancache/ed-visible-windows rope 10 5 nil)) [[9 9]]))
  (test "no clip reads as a clip that keeps every line whole"
    ;; the fast path and the per-line walk agree
    (doseq (top (range 0 5))
      (doseq (rows (range 0 5))
        (assert= (vec (spancache/ed-visible-windows rope top rows nil))
          (vec (spancache/ed-visible-windows rope top rows [0 nil {}]))))))
  (test "a clipped line is read over its window only"
    (assert= (vec (spancache/ed-visible-windows rope 2 0 [1 2 {}])) [[6 7]])))

;; A slice band (a fontify with no tree and no line lexer: a text buffer given a lexer's spans) that an edit
;; outside it leaves alone is kept — and re-stamped with the rope it now serves, so the next frame
;; is a plain hit rather than a re-slice and a recount of the text above.
(describe "a slice band an edit below it leaves alone"
  (test "the frame after the edit keeps the band and stamps it with the new rope"
    (let (text (string/join (map (range 400) (fn (i) (str "x" i " = " i))) "\n")
          typed (testkit/file-model text "/p/band.txt")
          sliced (model/ed-set-buf typed
                   (editor/layers/push-layer (model/ed-current-buf typed)
                     {:name :test-slice :fontify 'languages/lex-configs/json-spans}))
          m (spancache/ed-refresh-spans sliced 80 24)
          [path entry] (first (:span-cache m))
          buf (model/ed-current-buf m)
          edited (editor/buffer/insert-program-output buf
                   (editor/buffer/buffer-length buf)
                   "\ny = 1")
          after (spancache/ed-refresh-spans (model/ed-set-buf m edited) 80 24)
          kept (get (:span-cache after) path))
      (is (not (:tree? entry)))
      (is (not (:line? entry)))
      (assert= (:spans kept) (:spans entry))
      (is (= (:rope kept) (editor/buffer/buffer-rope edited))))))

;; A band is reused while its rope is the same — but colours are faces, resolved as a band is
;; lexed, so a theme applied over a buffer already coloured (the init file's `:theme` at startup,
;; `M-x theme-select`) would leave it in the old theme's colours until an edit. The
;; theme's generation (`theme/generation`) makes such a band stale.
(defn- text-face (m word)
  ;; the face the frame paints `word` in
  (let (flat (fn (ops) (into [] (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text)))))))
    (get (seq/find (flat (view/ed-view m 80 10)) (fn (op) (includes? (nth op 3) word))) 4)))

(describe "a theme applied over a coloured buffer"
  (test "recolours it at the next update, though its text did not change"
    (let (m (input/ed-update (testkit/file-model "(defn f () 1)\n" "/p/a.blsp")
              [:resize 80 10]
              80
              10)
          before (text-face m "defn"))
      (theme/apply-syntax-theme! {:syntax/special {:fg "#123456"}})
      (let (after (text-face (input/ed-update m [:resize 80 10] 80 10) "defn"))
        (theme/apply-syntax-theme!)
        (is (not (= before {:fg "#123456"})))
        (assert= after {:fg "#123456"})))))

;; Markdown colours by the theme: its faces are registry faces over the `:syntax/*` ones, and its
;; line cache rebuilds on the theme's generation like every other lexer's — so a light theme's
;; list bullet is its keyword colour, not an ANSI yellow on white.
(describe "a theme applied over a markdown buffer"
  :isolated (test "paints its list bullets in the theme's keyword colour, at the next update"
    (let (m (input/ed-update (testkit/file-model "# Notes\n\n- one\n- two\n" "/p/a.md")
              [:resize 80 10]
              80
              10))
      (theme/theme-apply! themes/*latte*)
      (let (bullet (text-face (input/ed-update m [:resize 80 10] 80 10) "-")
            keyword (editor/face/face :syntax/keyword))
        (theme/theme-apply! theme/*theme-mocha*)
        (assert= (:fg bullet) (:fg keyword))
        (assert= (:fg keyword) (:yellow themes/*latte*))))))
