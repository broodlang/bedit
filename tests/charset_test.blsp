;; A file not in UTF-8: read as what it is, edited, written back in it — and a binary still
;; opens as hex. Two other small promises live here too: a symlink's two names are one buffer,
;; and a buffer given up takes its sidecar with it.
(defmodule charset-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use charset)
  (:use model)
  (:use input)
  (:use pool)
  (:use sidecar)
  (:use autorevert)
  (:use filecoding :only []) ; the mixed line endings visit step
  (:use commands)
  (:use editor/buffer)
  (:use test))

(purge-stale-temp "bedit-charset-")

(defn- fixture (name octets)
  (let (dir (temp-dir "bedit-charset-")
        _ (file/mkdir dir)
        path (path/join dir name))
    (do (file/spit-bytes path octets) path)))

(defn- opened (path) (ed-find-file (ed-init (make-buffer "")) path))

(defn- saved (m path)
  (file-save/ed-save-buf-at m (or (ed-buffer-index-by-file m path) (error "not open: " path))))

(describe "charset — decoding and encoding"
  (test "every byte survives the single-byte codings"
    (let (every-byte (into [] (range 0 256)))
      (doseq (coding [:latin-1 :latin-9 :windows-1252])
        (let (text (or (decode every-byte coding) (error "no text in " coding))
              encoded (encode text coding))
          (assert= (if (failure? encoded) (error-message encoded) (vec encoded)) every-byte)))))
  (test "UTF-16 takes a character past the BMP through a surrogate pair"
    (let (text "a😀")
      (assert= (decode (encode text :utf-16-le) :utf-16-le) text)
      (assert= (decode (encode text :utf-16-be) :utf-16-be) text)))
  (test "invalid UTF-16 is not text"
    (is (nil? (decode [0 216] :utf-16-le)))
    (is (nil? (decode [105] :utf-16-le))))
  (test "a character the coding lacks is a failure saying where"
    (let (result (encode "ab€" :latin-1))
      (is (failure? result))
      (assert= (:at (fields result)) 2))))

(describe "charset — what a file's bytes are"
  (test "a declared charset is believed first"
    (assert= (:coding (detect (bytes 104 105) "latin1")) :latin-1))
  (test "a byte-order mark names UTF-16"
    (assert= (detect (bytes 255 254 105 0)) {:text "\u{feff}i" :coding :utf-16-le})
    (assert= (:coding (detect (bytes 254 255 0 105))) :utf-16-be))
  (test "UTF-32's mark is not UTF-16's"
    (is (nil? (detect (bytes 255 254 0 0 105 0 0 0)))))
  (test "text that is not UTF-8 reads as windows-1252, a binary as nothing"
    (assert= (detect (bytes 99 97 102 233)) {:text "café" :coding :windows-1252})
    (is (nil? (detect (bytes 233 1 2 3))))
    (is (nil? (detect (bytes 233 0)))))
  (test "an empty file is an empty text"
    (assert= (detect (bytes)) {:text ""})))

(describe "charset — a file in another coding, visited"
  (test "opens as text, says so, and an unchanged save gives the same bytes back"
    (let (original (bytes 99 97 102 233 10)
          path (fixture "notes.txt" original)
          m (opened path))
      (assert= (buffer-text (cur m)) "café\n")
      (assert= (:coding (cur m)) :windows-1252)
      (is (includes? (:echo m) "windows-1252"))

      (saved m path)
      (assert= (file/slurp-bytes path) original)))
  (test "an edit is written in the coding"
    (let (path (fixture "notes.txt" (bytes 233 10))
          m (ed-update (opened path) "x" 80 24))
      (saved m path)
      (assert= (file/slurp-bytes path) (bytes 120 233 10))))
  (test "a CRLF UTF-16 file with its mark comes back byte for byte"
    (let (original (bytes 255 254 105 0 13 0 10 0)
          path (fixture "win.txt" original)
          m (opened path))
      (assert= (buffer-text (cur m)) "i\n")
      (saved m path)
      (assert= (file/slurp-bytes path) original)))
  (test "a character the coding lacks refuses the save and leaves the file"
    (let (path (fixture "notes.txt" (bytes 233 10))
          m (ed-update (ed-find-file (ed-init (make-buffer "")) path) "x" 80 24)
          edited (ed-edit m (fn (b) (insert b "€€ ☃"))))
      (let (after (saved edited path))
        (is (includes? (:echo after) "no form in windows-1252"))
        (is (buffer-modified? (cur after)))
        (assert= (file/slurp-bytes path) (bytes 233 10)))))
  (test "a revert reads the coding it was read in"
    (let (path (fixture "notes.txt" (bytes 233 10))
          m (opened path)
          _ (file/spit-bytes path (bytes 232 10))
          reverted (ed-revert-at m (ed-current-index m)))
      (assert= (buffer-text (cur reverted)) "è\n")))
  ;; Emacs bug#82053: a revert added carriage returns to a CRLF file
  (test "a revert keeps a CRLF file CRLF, in UTF-8 and in a legacy coding, with no stray \\r"
    (doseq (octets [(bytes 97 13 10 98 13 10) (bytes 233 13 10 98 13 10)])
      (let (path (fixture "crlf.txt" octets)
            m (opened path)
            _ (file/spit-bytes path (bytes/concat octets (bytes 99 13 10)))
            reverted (cur (ed-revert-at m (ed-current-index m))))
        (assert= (:eol reverted) :crlf)
        (refute (includes? (buffer-text reverted) "\r"))
        (assert= (count (string/split (buffer-text reverted) "\n")) 4)
        (let (_ (saved (ed-init reverted) path))
          (assert= (file/slurp-bytes path) (bytes/concat octets (bytes 99 13 10)))))))
  (test ".editorconfig's charset decides how the file reads"
    (let (dir (temp-dir "bedit-charset-")
          _ (file/mkdir dir)
          path (path/join dir "a.txt"))
      (file/spit (path/join dir ".editorconfig") "root = true\n[*]\ncharset = latin1\n")
      (file/spit-bytes path (bytes 128 10))
      (assert= (:coding (cur (opened path))) :latin-1)))
  (test "a new file takes .editorconfig's charset"
    (let (dir (temp-dir "bedit-charset-")
          _ (file/mkdir dir)
          path (path/join dir "new.txt"))
      (file/spit (path/join dir ".editorconfig") "root = true\n[*]\ncharset = latin1\n")
      (assert= (:coding (cur (opened path))) :latin-1))))

(defn- typed (m keys)
  (fold keys m (fn (model key) (ed-update model key 80 24))))

(describe "charset — a person's say"
  (test "C-x RET r reads the file again as what you name"
    (let (path (fixture "notes.txt" (bytes 128 10))
          m (typed (opened path)
              (append [:ctrl-x :enter "r"] (string/->list "ISO-8859-15") [:enter])))
      (assert= (:coding (cur m)) :latin-9)
      (assert= (string/->codepoints (buffer-text (cur m))) [128 10])))
  (test "C-x RET f changes what the next save writes"
    (let (path (fixture "notes.txt" (bytes 233 10))
          m (typed (opened path)
              (append [:ctrl-x :enter "f"] (string/->list "UTF-8") [:enter])))
      (is (nil? (:coding (cur m))))
      (is (buffer-modified? (cur m)))
      (saved m path)
      (assert= (file/slurp path) "é\n"))))

(describe "one file, one buffer"
  ;; a Unix fact: `ln -s` may copy on Windows
  (when (not (= (os/type) :windows))
    (test "a symlink's name finds the buffer its target is open in"
      (let (path (fixture "notes.txt" (bytes 104 10))
            link (str path ".link"))
        (os/cmd "ln" ["-s" path link])
        (let (m (ed-find-file (opened path) link))
          (assert= (buffer-file (cur m)) path)
          (assert= (count (seq/filter (:buffers m) buffer-file)) 1)
          (is (includes? (:echo m) "are the same file")))))
    (test "and the other way round"
      (let (path (fixture "notes.txt" (bytes 104 10))
            link (str path ".link"))
        (os/cmd "ln" ["-s" path link])
        (let (m (ed-find-file (opened link) path))
          (assert= (buffer-file (cur m)) link)
          (assert= (count (seq/filter (:buffers m) buffer-file)) 1))))))

(describe "a buffer given up takes its sidecar with it"
  (test "kill anyway removes the auto-save file; no keeps both"
    (let (path (fixture "notes.txt" (bytes 104 10))
          sidecar (ed-auto-save-path path)
          m (ed-update (opened path) "x" 80 24)
          _ (file/spit-private sidecar "xh\n")
          asked (cmd-kill-buffer m nil)
          kept (ed-update asked "n" 80 24))
      (is (file/exists? sidecar))
      (is (ed-buffer-index-by-file kept path))
      (let (killed (ed-update (cmd-kill-buffer kept nil) "y" 80 24))
        (refute (file/exists? sidecar))
        (is (nil? (ed-buffer-index-by-file killed path)))))))

(describe "charset — the guess and its correction"
  (test "a byte windows-1252 leaves undefined makes a file binary, and C-x RET r reads it anyway"
    (let (path (fixture "odd.dat" (bytes 104 105 129 10))
          m (opened path))
      (assert= (editor/layers/buffer-type-for (cur m)) :hexl)
      (let (read (typed m (append [:ctrl-x :enter "r"] (string/->list "ISO-8859-1") [:enter])))
        (assert= (:coding (cur read)) :latin-1)
        (assert= (string/->codepoints (buffer-text (cur read))) [104 105 129 10])
        (refute (= (editor/layers/buffer-type-for (cur read)) :hexl))
        (assert= (count (seq/filter (:buffers read) buffer-file)) 1)
        (saved read path)
        (assert= (file/slurp-bytes path) (bytes 104 105 129 10)))))
  (test "UTF-8 named for a binary that is none says when it is not"
    (let (path (fixture "odd.dat" (bytes 104 105 129 10))
          read (typed (opened path) (append [:ctrl-x :enter "r"] (string/->list "UTF-8") [:enter])))
      (is (includes? (:echo read) "is not UTF-8")))))

(describe "charset — what a program sees"
  (test "a file's own bytes read through a program equal its text's tool view"
    (let (octets (bytes 99 97 102 233 10)
          text (or (decode octets :latin-1) ""))
      (assert= (tool-view text :latin-1 :lf false) (string/bytes-> octets :lossy))))
  (test "a character the coding cannot write leaves the text as it is"
    (assert= (tool-view "€" :latin-1 :lf false) "€"))
  (test "the gutter marks only the line that changed in a Latin-1 file"
    (let (dir (temp-dir "bedit-charset-")
          _ (file/mkdir dir)
          path (path/join dir "a.txt"))
      (os/cmd "git" ["init" "-q" dir])
      (file/spit-bytes path (bytes 99 97 102 233 10 111 108 100 10))
      (os/cmd "git" ["-C" dir "add" "a.txt"])
      (os/cmd "git" ["-C" dir "-c" "user.name=t" "-c" "user.email=t@t" "commit" "-q" "-m" "x"])
      (assert= (:status (diffhl/diffhl-compute path "café\nnew\n" nil [:latin-1 :lf false]))
        {1 :modified}))))

(describe "charset — a file edited as root"
  (test "file-content is what a sudo write is handed: bytes in the buffer's coding"
    (assert= (charset/file-content (with-coding (make-buffer "é\n") :latin-1)) (bytes 233 10)))
  (test "and a failure when the coding cannot write the text"
    (is (failure? (charset/file-content (with-coding (make-buffer "€") :latin-1))))))

(describe "charset — overruling the guess the other way"
  (test "a short run of high bytes that spells nothing is no text"
    (is (nil? (detect (bytes 200 201 202 203 204 99))))
    (assert= (:coding (detect (bytes 99 97 102 233 10))) :windows-1252))
  (test "C-x RET r takes a text to the hex view, and back"
    (let (path (fixture "notes.txt" (bytes 99 97 102 233 10))
          hex (typed (opened path)
                (append [:ctrl-x :enter "r"] (string/->list "hex view") [:enter])))
      (assert= (editor/layers/buffer-type-for (cur hex)) :hexl)
      (assert= (count (seq/filter (:buffers hex) buffer-file)) 1)
      (let (text (typed hex (append [:ctrl-x :enter "r"] (string/->list "ISO-8859-1") [:enter])))
        (assert= (buffer-text (cur text)) "café\n"))))
  (test "a modified buffer keeps its text rather than go to hex"
    (let (path (fixture "notes.txt" (bytes 99 97 102 233 10))
          edited (ed-update (opened path) "x" 80 24)
          asked (typed edited (append [:ctrl-x :enter "r"] (string/->list "hex view") [:enter])))
      (is (includes? (:echo asked) "unsaved changes"))
      (is (buffer-modified? (cur asked))))))

(defn- text-in (text coding)
  (let (encoded (encode text coding))
    (if (failure? encoded) (error (error-message encoded)) (apply bytes encoded))))

(describe "charset — a script is recognised"
  (test "Russian in windows-1251, and in KOI8-R"
    (let (text "Это обычный русский текст, в нём нет ничего особенного.\n")
      (assert= (:coding (detect (text-in text :windows-1251))) :windows-1251)
      (assert= (:coding (detect (text-in text :koi8-r))) :koi8-r)))
  (test "Greek, Hebrew and Arabic"
    (assert= (:coding (detect (text-in "Αυτό είναι ένα απλό ελληνικό κείμενο για δοκιμή.\n"
                                :windows-1253)))
      :windows-1253)
    (assert= (:coding (detect (text-in "זהו טקסט פשוט בעברית שנועד לבדיקה של הזיהוי.\n"
                                :windows-1255)))
      :windows-1255)
    (assert= (:coding (detect (text-in "هذا نص بسيط باللغة العربية من أجل الاختبار.\n"
                                :windows-1256)))
      :windows-1256))
  (test "code with a little Russian in its comments"
    (let (text (str "(defn add (a b)\n  ;; складывает два числа и возвращает результат\n  (+ a b))\n"))
      (assert= (:coding (detect (text-in text :windows-1251))) :windows-1251)))
  (test "French and German stay Latin: their accents stand alone"
    (assert= (:coding (detect (text-in "Le café est très bon à la maison, déjà prêt, où êtes-vous ?\n"
                                :windows-1252)))
      :windows-1252)
    (assert= (:coding (detect (text-in "Die Straße führt über schöne Brücken, für Müller und Bäcker.\n"
                                :windows-1252)))
      :windows-1252))
  (test "every byte survives every single-byte coding"
    (doseq (coding [:iso-8859-2
                     :windows-1250 :windows-1251 :koi8-r :koi8-u :iso-8859-5 :windows-1253
                     :iso-8859-7 :windows-1254 :windows-1255 :windows-1256])
      (let (every-byte (into [] (range 0 256))
            text (or (decode every-byte coding) "")
            encoded (encode text coding))
        (assert= (if (failure? encoded) (error-message encoded) (vec encoded)) every-byte))))
  (test "mail reads these charsets too"
    (assert= (mail-message/decode-charset [207 240 232 226 229 242] "windows-1251") "Привет")))

(describe "charset — the default, for what bytes cannot tell"
  (test ":file-coding decides how Polish reads"
    (do
      (binding (*default-coding* :windows-1250)
        (assert= (:coding (detect (bytes 122 97 191 243 108 102))) :windows-1250))
      (assert= (:coding (detect (bytes 122 97 191 243 108 102))) :windows-1252)))
  (test "only a single-byte coding can be the default"
    (is (single-byte-coding? "cp1250"))
    (refute (single-byte-coding? "utf-16le"))
    (refute (single-byte-coding? "nonsense"))))

;; A file mixing CRLF and LF reads as LF with its CRs kept (every byte back on a save); the visit
;; says so, and M-x convert-line-endings puts it right as one undoable edit.
(describe "a file that mixes line endings"
  (test "the visit says how many lines end in CRLF"
    (let (path (fixture "mixed.txt" (string/->bytes "a\r\nb\nc\r\n"))
          m (opened path))
      (is (includes? (:echo m) "mixed line endings: 2 CRLF"))))
  (test "a file all one way says nothing of it"
    (let (m (opened (fixture "dos.txt" (string/->bytes "a\r\nb\r\n"))))
      (refute (includes? (or (:echo m) "") "mixed line endings"))))
  (test "converting makes every line one way, as one undoable edit"
    (let (buffer (editor/buffer/make-buffer "a\r\nb\nc\r\n")
          to-lf (filecoding/converted-eol buffer :lf)
          to-crlf (filecoding/converted-eol buffer :crlf))
      (assert= (buffer-text to-lf) "a\nb\nc\n")
      (is (nil? (:eol to-lf)))
      (is (buffer-modified? to-lf))
      (assert= (buffer-text (undo to-lf)) "a\r\nb\nc\r\n")
      (assert= (buffer-text to-crlf) "a\nb\nc\n")
      (assert= (:eol to-crlf) :crlf)))
  (test "a file written after converting has every line ending chosen"
    (let (path (fixture "mixed2.txt" (string/->bytes "a\r\nb\n"))
          m (opened path)
          converted (ed-set-buf m (filecoding/converted-eol (cur m) :crlf)))
      (saved converted path)
      (assert= (file/slurp path) "a\r\nb\r\n"))))
