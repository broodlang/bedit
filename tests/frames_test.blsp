;; Frames (src/frames.blsp, docs/frames-plan.md): two models — the primary and a frame —
;; one buffer registry, no window. Both models fold in THIS process, so every push and
;; registry notification lands in one mailbox and is fed to both (`ft-feed`); a real frame
;; is its own process, but the folds are the same. Barriers, not sleeps: a registry call
;; and a `buffer-query` are synchronous round-trips, so everything they caused is queued
;; by the time they answer.
(defmodule frames-test
  (:use frames)
  (:use hosted)
  (:use model)
  (:use input)
  (:use pool)
  (:use lifecycle)
  (:use commands) ; ed-open-buffer / cmd-kill-buffer / cmd-quit
  (:use editor/buffer)
  (:use editor/buffer-file)
  (:use editor/buffer-server)
  (:use editor/buffer-registry)
  (:use test))

(defn ft-text (m) (buffer-text (ed-current-buf m)))
(defn ft-press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn ft-names (m) (map (:buffers m) buffer-name))

(defn- ft-queued (acc)
  "Every push / registry notification already in the mailbox, oldest first."
  (receive
    ([:buffer-updated p v view o] (ft-queued (cons [:buffer-updated p v view o] acc)))
    ([:registry-added k n p meta] (ft-queued (cons [:registry-added k n p meta] acc)))
    ([:registry-renamed o k n meta] (ft-queued (cons [:registry-renamed o k n meta] acc)))
    ([:registry-removed k why] (ft-queued (cons [:registry-removed k why] acc)))
    (after 0 (reverse acc))))

(def *other* (spawn (fn () (receive (_ nil)))))
;; A real frame is its own process, so its links carry its own pid as `:me` and a push
;; tagged by the primary is foreign to it. Both models fold HERE, in one process, so the
;; frame's links are re-identified as `*other*` — else it would take the primary's pushes
;; for its own echoes (`link-fold`'s echo suppression) and never apply them.
(defn ft-as-other (m)
  (assoc m
    :hosted
      (fold (%map-pairs (or (:hosted m) {}))
        {}
        (fn (acc [i l]) (assoc acc i (assoc l :me *other*))))))

(defn ft-feed (models)
  "Fold everything queued into each of `models` (`[primary frame]`), after a barrier on
every process the models are linked to."
  (doseq (m models)
    (doseq (kv (%map-pairs (or (:hosted m) {})))
      ;; a process a kill or a crash just ended answers nothing — barrier on the live ones
      (when (proc/info (:proc (second kv))) (buffer-query (:proc (second kv)) buffer-text))))
  (let (models [(first models) (ft-as-other (second models))])
    (fold (ft-queued '())
      models
      (fn ([a b] msg) [(ed-update a msg 80 24) (ft-as-other (ed-update b msg 80 24))]))))

(defn ft-primary (reg text file)
  "A primary on `text`/`file`, hosting through `reg`, after one event (the flip hosted it)."
  (ft-press (assoc (ed-init (make-buffer text file file)) :host-buffers? true :buffer-reg reg)
    [:right]))

(describe "frames — a second model over the same buffer processes"
  :isolated (test "a frame seeds from the registry: every buffer, linked, the current one shown"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "hello" "a.txt")
          b (frames-seed-model reg "a.txt" {:gui true})
          [a2 b2] (ft-feed [a b]))
      ;; every buffer of the primary (the frame keeps its own *scratch* until one is shared)
      (is (every? (ft-names a2) (fn (n) (includes? (ft-names b2) n))))
      (is (:frame? b2))
      (is (:gui b2))
      (assert= (buffer-name (ed-current-buf b2)) "a.txt")
      (assert= (ft-text b2) "hello") ; the seed push filled the copy
      ;; the same process on both sides
      (assert= (map/get-in b2 [:hosted (ed-buffer-index-by-name b2 "a.txt") :proc])
        (map/get-in a2 [:hosted 0 :proc]))
      (registry-stop reg)))
  :isolated (test "an edit in one frame lands in the other through the buffer process"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "hello" "a.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "a.txt" {})])
          a2 (ft-press a1 ["!"]) ; point at 1 after :right
          [a3 b3] (ft-feed [a2 b1]))
      (assert= (ft-text a3) "h!ello")
      (assert= (ft-text b3) "h!ello")
      ;; and back the other way
      (let (b4 (ft-press (ed-set-buf b3 (goto-char (ed-current-buf b3) 0)) ["?"])
            [a5 b5] (ft-feed [a3 b4]))
        (assert= (ft-text b5) "?h!ello")
        (assert= (ft-text a5) "?h!ello"))
      (registry-stop reg)))
  :isolated (test "a buffer opened in one frame appears in the other; a kill removes it everywhere"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "hello" "a.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "a.txt" {})])
          a2 (ft-press (ed-open-buffer a1 (make-buffer "ccc" "c.txt" "c.txt")) [:right])
          [a3 b3] (ft-feed [a2 b1]))
      (is (includes? (ft-names b3) "c.txt"))
      (assert= (buffer-name (ed-current-buf b3)) "a.txt") ; b's pane did not move
      (assert= (buffer-text (ed-buf-at b3
                              (or (ed-buffer-index-by-name b3 "c.txt") (error "c.txt not in B"))))
        "ccc")
      ;; kill it in A (A is on c.txt): gone from the registry and from B
      (let (a4 (cmd-kill-buffer a3 nil)
            [a5 b5] (ft-feed [a4 b3]))
        (is (not (includes? (ft-names a5) "c.txt")))
        (is (not (includes? (ft-names b5) "c.txt")))
        (is (not (includes? (map (registry-entries reg) :name) "c.txt")))
        ;; B's surviving links still point at their slots
        (assert= (buffer-query (map/get-in b5 [:hosted (ed-buffer-index-by-name b5 "a.txt") :proc])
                   buffer-text)
          "hello"))
      (registry-stop reg)))
  :isolated (test "a died buffer process is re-shared by the first frame to notice; the other relinks"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "hello" "a.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "a.txt" {})])
          old (map/get-in a1 [:hosted 0 :proc])
          _ (exit old :kill)
          down (receive ([:down r p rsn] (if (= p old) [:down r p rsn] nil)) (after 2000 :none)))
      (is (vector? down))
      ;; A folds its [:down]: rehost through the registry → a fresh process under the name
      (let (a2 (ed-update a1 down 80 24)
            fresh (map/get-in a2 [:hosted 0 :proc]))
        (is (not (= fresh old)))
        (assert= (buffer-query fresh buffer-text) "hello")
        ;; B gets the registry's :removed :died and :added — and relinks to the fresh one
        (let ([_a3 b3] (ft-feed [a2 b1]))
          (assert= (map/get-in b3 [:hosted (ed-buffer-index-by-name b3 "a.txt") :proc]) fresh)))
      (registry-stop reg)))
  :isolated (test "a frame's quit is a frame quit; the primary's takes the frames with it"
    (let (reg (registry-start)
          a (ft-primary reg "x" "a.txt")
          b (frames-seed-model reg "a.txt" {})
          bq (cmd-quit b nil))
      (is (:done bq))
      (is (not (:done a)))
      ;; delete-frame on the primary with no frames is quit; with a frame recorded it refuses
      (is (:done (cmd-delete-frame a nil)))
      (let (fake (spawn (fn () (receive (_ nil))))
            a2 (assoc a :frames [fake]))
        (is (not (:done (cmd-delete-frame a2 nil))))
        (is (includes? (:echo (cmd-delete-frame a2 nil)) "other frame"))
        ;; the primary's quit closes them
        (let (mref (monitor fake)
              done (cmd-quit a2 nil))
          (is (:done done))
          (assert= (receive ([:down ^mref _ _] :closed) (after 2000 :alive)) :closed)))
      (registry-stop reg))))

;; A document is its FILE (std `registry-key`), not its display name: the registry used
;; to share by name, so a second `README.md` from another project was handed the first
;; one's process and its edits landed in the other file.
(describe "frames — two files with one display name stay two documents"
  :isolated (test "same name, different files: two processes, each keeps its own text"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-press (assoc (ed-init (make-buffer "project a" "README.md" "/tmp/fa/README.md"))
                        :host-buffers? true
                        :buffer-reg reg)
              [:right])
          a1 (ft-press (ed-open-buffer a (make-buffer "project b" "README.md" "/tmp/fb/README.md"))
               [:right])
          procs (map (range (count (:buffers a1))) (fn (i) (map/get-in a1 [:hosted i :proc]))))
      (assert= (count (seq/distinct procs)) (count procs)) ; one process per slot, none shared
      (assert= (count (registry-entries reg)) (count (:buffers a1)))
      (let (ib (or (hosted-index-by-key a1 "/tmp/fb/README.md") (error "b not hosted")))
        (assert= (buffer-query (map/get-in a1 [:hosted ib :proc]) buffer-text) "project b"))
      (registry-stop reg)))
  :isolated (test "a rekey renames the other frame's copy, same process"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "hello" "/tmp/fr/a.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "/tmp/fr/a.txt" {})])
          proc (map/get-in a1 [:hosted 0 :proc])
          _ (registry-rekey reg "/tmp/fr/a.txt" "b.txt" {:file "/tmp/fr/b.txt"})
          [_a2 b2] (ft-feed [a1 b1]))
      (let (ib (or (hosted-index-by-key b2 "/tmp/fr/b.txt") (error "B did not follow the rename")))
        (assert= (buffer-name (ed-buf-at b2 ib)) "b.txt")
        (assert= (map/get-in b2 [:hosted ib :proc]) proc))
      (is (nil? (hosted-index-by-key b2 "/tmp/fr/a.txt")))
      (registry-stop reg))))

(defn- ft-lines (from to)
  ;; `line-<from>\n` … `line-<to - 1>\n`
  (string/join (map (range from to) (fn (n) (str "line-" n "\n"))) ""))

(describe "frames — a head cut in one frame keeps the other's windows on what they showed"
  :isolated (test "the other frame's point, mark and scroll move with the text"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg (ft-lines 0 40) "log.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "log.txt" {})])
          ;; B reads in the scrollback: point on line 25, the window from line 20
          rope (buffer-rope (ed-current-buf b1))
          at (+ (text/line->char rope 25) 3)
          b2 (ed-set-top (ed-set-buf b1
                           (assoc (goto-char (ed-current-buf b1) at)
                             :mark (text/line->char rope 22)))
               20)
          ;; A cuts its first ten lines, as a stream at its cap does, and propagates
          cut (text/line->char (buffer-rope (ed-current-buf a1)) 10)
          a2 (hosted-step a1 (ed-cut-head-at a1 (ed-current-index a1) cut) nil)
          [_a3 b3] (ft-feed [a2 b2])
          b-buf (ed-current-buf b3))
      (assert= (ft-text b3) (ft-lines 10 40))
      ;; the same character under point, the same lines in the window
      (assert= (buffer-point b-buf) (- at cut))
      (assert= (text/slice (buffer-rope b-buf) (buffer-point b-buf) (+ (buffer-point b-buf) 4))
        "e-25")
      (assert= (buffer-mark b-buf) (text/line->char (buffer-rope b-buf) 12))
      (assert= (:top (ed-current-pane b3)) 10)
      (registry-stop reg)))
  :isolated (test "a shell's input boundary in the other frame moves with the text"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg (str (ft-lines 0 20) "$ ") "sh.txt")
          [a1 b1] (ft-feed [a (frames-seed-model reg "sh.txt" {})])
          index (ed-current-index b1)
          length (buffer-length (ed-current-buf b1))
          b2 (ed-set-buf-at b1 index (assoc (ed-buf-at b1 index) :input-start length))
          cut (text/line->char (buffer-rope (ed-current-buf a1)) 5)
          a2 (hosted-step a1 (ed-cut-head-at a1 (ed-current-index a1) cut) nil)
          [_a3 b3] (ft-feed [a2 b2]))
      (assert= (:input-start (ed-buf-at b3 index)) (- length cut))
      (registry-stop reg))))

;; A program's colours are the text's properties (brood ADR-579), so they travel with the
;; splice that appends their text: the other frame — read-only for its user, as an output
;; buffer is — shows them on the same characters, and a frame that opens afterwards is
;; seeded with them.
(describe "frames — output colours reach every frame showing the buffer"
  :isolated (test "an append coloured in one frame is coloured in the other, and in a later one"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "$ make\n" "build.log")
          [a1 b1] (ft-feed [a (frames-seed-model reg "build.log" {})])
          ;; B's copy is read-only for its user, as *compilation* is
          b2 (ed-set-buf b1 (set-read-only (ed-current-buf b1) true))
          index (ed-current-index a1)
          a2 (hosted-step a1
               (ed-set-buf-at a1
                 index
                 (ed-append-end (ed-buf-at a1 index) "ERROR here\n" {:ansi [[0 5 {:fg 1}]]}))
               nil)
          [a3 b3] (ft-feed [a2 b2])
          b-buf (ed-current-buf b3))
      (assert= (buffer-text b-buf) "$ make\nERROR here\n")
      (assert= (ansicolor/colour-spans b-buf) [[7 12 {:fg 1}]])
      (is (read-only? b-buf))
      ;; B's user types before the colours: they stay on ERROR in both frames
      (let (b4 (ft-press (ed-set-buf b3 (goto-char (set-read-only b-buf false) 0)) [">" ">" " "])
            [a5 b5] (ft-feed [a3 b4]))
        (assert= (ansicolor/colour-spans (ed-current-buf b5)) [[10 15 {:fg 1}]])
        (assert= (ansicolor/colour-spans (ed-current-buf a5)) [[10 15 {:fg 1}]])
        ;; a frame opened now is seeded with the colours where they are
        (let ([_ c] (ft-feed [a5 (frames-seed-model reg "build.log" {})]))
          (assert= (ft-text c) ">> $ make\nERROR here\n")
          (assert= (ansicolor/colour-spans (ed-current-buf c)) [[10 15 {:fg 1}]])))
      (registry-stop reg)))
  :isolated (test "a log coloured before it was shared keeps its colours in a new frame"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          coloured (insert (make-buffer "" "run.log" "run.log") "ok\n" {:ansi [[0 2 {:fg 2}]]})
          a (ft-press (assoc (ed-init coloured) :host-buffers? true :buffer-reg reg) [:right])
          [_ b] (ft-feed [a (frames-seed-model reg "run.log" {})]))
      (assert= (ft-text b) "ok\n")
      (assert= (ansicolor/colour-spans (ed-current-buf b)) [[0 2 {:fg 2}]])
      (registry-stop reg))))

;; A password typed ahead (brood ADR-581): the type-ahead reached the other frame a key at a
;; time, each a step in ITS history. When the prompt arrives, ONE event appends the output at
;; the process mark and redacts the type-ahead into the masked read (bshell's and the
;; terminal's password watch) — the other frame must redact too, not apply a plain delete
;; and keep the per-key steps.
(defn- ft-held-texts (buf)
  "Every text `buf` keeps besides its own: its splice log's ropes, runs and replacements, and
its undo snapshots."
  (append (mapcat (or (get buf :splices) ())
            (fn (entry)
              (let ([before after _ _ replacement mids _] entry)
                (append (seq/keep [before after] (fn (rope) (when rope (text/->string rope))))
                  [replacement]
                  (map mids (fn (mid) (text/->string (first mid))))))))
    (map (or (get buf :undo) ()) (fn (snapshot) (text/->string (get snapshot :rope))))))

(defn- ft-holds? (buf secret) (any? (ft-held-texts buf) (fn (text) (includes? text secret))))

(describe "frames — a redaction reaches the other frame as one"
  :isolated (test "output and the redaction in one event leave the other frame no trace"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "$ sudo x\n" "shell.log")
          [a1 b1] (ft-feed [a (frames-seed-model reg "shell.log" {})])
          index (ed-current-index a1)
          ;; the type-ahead, a key at a time, at the end
          a2 (ft-press (ed-set-buf a1 (end-of-buffer (ed-current-buf a1))) ["h" "u" "n"])
          [a3 b3] (ft-feed [a2 b1]))
      (assert= (ft-text b3) "$ sudo x\nhun")
      (is (ft-holds? (ed-current-buf b3) "hun"))
      ;; ONE event: the prompt arrives at the process mark, the read takes the type-ahead
      (let (prompted (redact-region (replace-region (ed-buf-at a3 index) 9 9 "pw: ") 13 16)
            a4 (hosted-step a3 (ed-set-buf-at a3 index prompted) nil)
            [a5 b5] (ft-feed [a4 b3])
            b-buf (ed-current-buf b5))
        (assert= (ft-text a5) "$ sudo x\npw: ")
        (assert= (buffer-text b-buf) "$ sudo x\npw: ")
        (is (not (ft-holds? b-buf "hun")))
        (is (not (ft-holds? (ed-current-buf b5) "hu")))
        ;; B got the changed range redacted, then the prompt: undo takes the prompt back,
        ;; and nothing before the redaction
        (assert= (buffer-text (undo b-buf)) "$ sudo x\n")
        (assert= (buffer-query (map/get-in a5 [:hosted index :proc]) buffer-text) "$ sudo x\npw: "))
      (registry-stop reg))))

;; A property change crosses as one (brood ADR-579): the other frame's text, point and
;; windows stay where they were.
(describe "frames — a property change leaves the other frame where it was"
  :isolated (test "colours laid on text already there reach the other frame without moving it"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-primary reg "ERROR here\n" "build.log")
          [a1 b1] (ft-feed [a (frames-seed-model reg "build.log" {})])
          b2 (ed-set-buf b1 (goto-char (ed-current-buf b1) 3))
          index (ed-current-index a1)
          a2 (hosted-step a1
               (ed-set-buf-at a1 index (ansicolor/add-faces (ed-buf-at a1 index) [[0 5 {:fg 1}]] 0))
               nil)
          [a3 b3] (ft-feed [a2 b2])
          b-buf (ed-current-buf b3))
      (assert= (buffer-text b-buf) "ERROR here\n")
      (assert= (ansicolor/colour-spans b-buf) [[0 5 {:fg 1}]])
      (assert= (buffer-point b-buf) 3)
      (assert= (ansicolor/colour-spans (ed-current-buf a3)) [[0 5 {:fg 1}]])
      (registry-stop reg))))

;; How the file is written is the document's, not a frame's: a revert in one frame that
;; found the byte-order mark and the CRLF line endings gone must not leave another frame to
;; write them back on its next save.
(describe "frames — a file's coding changed in one frame reaches the other"
  :isolated (test "a revert that dropped the BOM and CRLF drops them in the other frame too"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          opened (assoc (make-buffer "a\nb\n" "crlf.txt" "crlf.txt") :bom true :eol :crlf)
          a (ft-press (assoc (ed-init opened) :host-buffers? true :buffer-reg reg) [:right])
          [a1 b1] (ft-feed [a (frames-seed-model reg "crlf.txt" {})])
          index (ed-current-index a1)
          b-index (or (ed-buffer-index-by-name b1 "crlf.txt")
                    (error "the frame never adopted crlf.txt"))
          _ (assert= [(buffer-bom? (ed-buf-at b1 b-index)) (buffer-eol (ed-buf-at b1 b-index))]
              [true :crlf])
          ;; the auto-revert's result: the same text, now read without either
          reverted (dissoc (ed-buf-at a1 index) :bom :eol)
          a2 (hosted-step a1 (ed-set-buf-at a1 index reverted) nil)
          [a3 b3] (ft-feed [a2 b1])
          b-buf (ed-buf-at b3 b-index))
      (assert= [(buffer-bom? b-buf) (buffer-eol b-buf)] [false :lf])
      (assert= [(buffer-bom? (ed-buf-at a3 index)) (buffer-eol (ed-buf-at a3 index))] [false :lf])
      (registry-stop reg))))

;; C-x 5 u (Emacs 29's undelete-frame): a frame that closes leaves its panes by buffer NAME
;; with the primary, which opens the newest again on the same buffers, laid out as it was.
(describe "frames — a deleted frame undeleted"
  (test "a closing frame's record names each pane's buffer, its scroll and point kept"
    (let (m (ed-open-buffer (ed-init (make-buffer "one" "a.txt" "/tmp/fu/a.txt"))
              (make-buffer "two" "b.txt" "/tmp/fu/b.txt"))
          split (assoc m
                  :layout (editor/pane/pane-split (:layout m) :col {:buffer 0 :top 3 :point 1}))
          record (frames-closed-record split)
          payloads (map (editor/pane/pane-leaf-paths (:layout record))
                     (fn (path) (editor/pane/pane-payload-at (:layout record) path))))
      (assert= (vec (map payloads :buffer-name)) ["b.txt" "a.txt"])
      (assert= (:top (second payloads)) 3)
      (refute (any? payloads :buffer))))

  (test "the primary keeps the newest first, capped, and hands back the newest"
    (let (m (fold (range 20)
              (ed-init (make-buffer ""))
              (fn (acc n) (frames-remember-deleted acc {:show (str n)})))
          [taken record] (frames-take-deleted m))
      (assert= (count (:deleted-frames m)) *deleted-frames-max*)
      (assert= (:show record) "19")
      (assert= (:show (first (:deleted-frames taken))) "18")
      (assert= (second (frames-take-deleted (ed-init (make-buffer "")))) nil)))

  (test "the layout comes back on the same buffers; a pane on a buffer gone takes another"
    (let (m (ed-open-buffer (ed-init (make-buffer "one" "a.txt" "/tmp/fu/a.txt"))
              (make-buffer "two" "b.txt" "/tmp/fu/b.txt"))
          layout (editor/pane/pane-split (editor/pane/pane-single {:buffer-name "a.txt" :top 2})
                   :col {:buffer-name "gone.txt" :top 5 :point 9})
          restored (frames-restore-layout m layout 1)
          payloads (map (editor/pane/pane-leaf-paths (:layout restored))
                     (fn (path) (editor/pane/pane-payload-at (:layout restored) path))))
      (assert= (vec (map payloads :buffer)) [(ed-buffer-index-by-name m "a.txt") 1])
      (assert= (vec (map payloads :top)) [2 0])
      (assert= (:point (second payloads)) nil)))

  (test "it opens on the selected buffer, else one of its panes', else the current one"
    (let (m (ed-open-buffer (ed-init (make-buffer "one" "a.txt" "/tmp/fu/a.txt"))
              (make-buffer "two" "b.txt" "/tmp/fu/b.txt"))
          layout (editor/pane/pane-split (editor/pane/pane-single {:buffer-name "gone.txt"})
                   :col {:buffer-name "a.txt"}))
      (assert= (frames-undelete-show m {:show "b.txt" :layout layout}) "b.txt")
      (assert= (frames-undelete-show m {:show "gone.txt" :layout layout}) "a.txt")
      (assert= (frames-undelete-show m
                 {:show "gone.txt" :layout (editor/pane/pane-single {:buffer-name "x"})})
        "b.txt")))

  :isolated (test "a frame seeded with a deleted frame's layout shows it again"
    (let (reg (registry-start)
          _ (registry-watch reg (self))
          a (ft-press (ed-open-buffer (ft-primary reg "one" "a.txt")
                        (make-buffer "two" "b.txt" "b.txt"))
              [:right])
          _ (ft-feed [a (frames-seed-model reg "a.txt" {})])
          layout (editor/pane/pane-split (editor/pane/pane-single {:buffer-name "a.txt" :top 0})
                   :col {:buffer-name "b.txt" :top 0})
          frame (frames-seed-model reg "b.txt" {} layout)
          names (map (editor/pane/pane-leaf-paths (:layout frame))
                  (fn (path)
                    (buffer-name (ed-buf-at frame
                                   (:buffer (editor/pane/pane-payload-at (:layout frame) path)))))))
      (assert= (vec names) ["a.txt" "b.txt"])
      ;; the pane selected when it closed is selected again
      (assert= (buffer-name (ed-current-buf frame)) "a.txt")
      (registry-stop reg)))

  (test "with nothing deleted, C-x 5 u says so"
    (let (m (assoc (ed-init (make-buffer "")) :buffer-reg (self)))
      (is (includes? (:echo (cmd-undelete-frame m nil)) "no deleted frame"))))

  (test "a frame's C-x 5 0 still ends its loop"
    (is (:done (cmd-delete-frame (assoc (ed-init (make-buffer "")) :frame? true) nil)))))

(describe "C-z: suspend in a terminal, undo in a window"
  (test "in a window C-z undoes, and C-z C-z keeps undoing rather than redoing"
    (let (typed (fn (m)
                  (testkit/type-str (testkit/press (testkit/type-str m "a") [:ctrl-a]) "b"))
          m (testkit/press (typed (assoc (testkit/m-of "") :window 1)) [:ctrl-z])
          once (buffer-text (testkit/cur m))
          twice (buffer-text (testkit/cur (testkit/press m [:ctrl-z]))))
      (assert= [once twice] ["a" ""])))
  (test "C-z then C-/ is one run of undos, as C-/ C-/ is"
    (let (typed (testkit/type-str (testkit/press (testkit/type-str (assoc (testkit/m-of "")
                                                                     :window 1)
                                                   "a")
                                    [:ctrl-a])
                  "b")
          m (testkit/press typed [:ctrl-z (keyword "ctrl-/")]))
      (assert= (buffer-text (testkit/cur m)) ""))))
