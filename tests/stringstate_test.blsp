;; tests/stringstate_test.blsp — where strings, comments and brackets stand (`stringstate`,
;; Emacs's syntax-ppss): the line lexer a mode's string syntax becomes, the state each line
;; starts in kept in the model's `:string-caches` and moved by edits, the state at point, the
;; held parse asked first, and bracket balance read forward from point.

(defmodule stringstate-test
  (:use test)
  (:use model)
  (:use stringstate)
  (:use stringlex)
  (:use stringwarm)
  (:use editor/buffer))

(def- python
  (lexer-data {:strings [{:open "\"\"\"" :multiline true}
                          {:open "'''" :multiline true}
                          {:open "\""}
                          {:open "'"}]
               :comments ["#"]}
    [["(" ")"] ["[" "]"] ["{" "}"]]))

(defn- lexed (data line &optional (state [nil ""])) (lex-line data line state))

(defn- file-model (text file point)
  (let (m (ed-init (make-buffer text file file)))
    (ed-set-buf m (goto-char (ed-current-buf m) point))))

(defn- point-info (text file point) (second (ed-point-state (file-model text file point))))

(describe "the line lexer"
  (test "a lexer's tokens: a `#` in a string is no comment, a quote in a comment opens nothing"
    (assert= (:tokens (lexed python "a = \"x # y\" # it's"))
      [[4 11 [:string "\"" true]] [12 18 :comment]]))
  (test "a triple quote carries into the next line; a one-line string ends at its line"
    (assert= (:end (lexed python "x = \"\"\"doc")) [[:string "\"\"\"" true false] ""])
    (assert= (:end (lexed python "y = 'open")) [nil ""])
    (assert= (:open (lexed python "y = 'open")) [[:string "'" false false] ""]))
  (test "a line that starts inside a string closes it"
    (assert= (:tokens (lexed python "more\"\"\" + 1" [[:string "\"\"\"" true false] ""]))
      [[0 7 [:string "\"\"\"" true]]]))
  (test "brackets: the stack carried, the fewest open, the first closer that closes nothing"
    (let (line (lexed python "f(a, [b") opened (:end line))
      (assert= opened [nil "(["])
      (assert= (:low (lexed python "])) x" opened)) 0)
      (assert= (:excess (lexed python "])) x" opened)) [2 ")"])))
  (test "a bracket in a string or a comment is not counted"
    (assert= (:end (lexed python "s = '(' # (")) [nil ""]))
  (test "an escaped quote does not close; a raw string has no escapes"
    (assert= (:end (lexed python "x = \"a\\\"b")) [nil ""])
    (assert= (:open (lexed python "x = \"a\\\"b")) [[:string "\"" false false] ""])
    (let (go (lexer-data {:strings [{:open "`" :multiline true :raw true}]} []))
      (assert= (:end (lexed go "`a\\` x")) [nil ""])))
  (test "a block comment spans lines"
    (let (c (lexer-data {:strings [{:open "\""}] :block-comments [["/*" "*/"]]} []))
      (assert= (:end (lexed c "a /* b \" c")) [[:block "*/"] ""])
      (assert= (:open (lexed c "d */ \"e" [[:block "*/"] ""])) [[:string "\"" false false] ""])))
  (test "the shell's `#` is a comment only at a word's start"
    (let (shell (lexer-data {:strings [{:open "\"" :multiline true}]
                             :comments ["#"]
                             :comment-word-start true}
                  [["(" ")"] ["{" "}"]]))
      (assert= (:tokens (lexed shell "echo ${#x} $# \"a\" # c"))
        [[14 17 [:string "\"" true]] [18 21 :comment]])
      (assert= (:end (lexed shell "n=${#x}")) [nil ""])))
  (test "Rust: `'x'` is a character, `'a` a lifetime, `'\"'` no string"
    (let (rust (lexer-data {:strings [{:open "\"" :multiline true}]
                            :char-literal "'"
                            :comments ["//"]}
                 [["(" ")"] ["<" ">"]]))
      (assert= (:tokens (lexed rust "let c = '\"';")) [[8 11 :char]])
      (assert= (:end (lexed rust "let c = '\"';")) [nil ""])
      (assert= (:tokens (lexed rust "fn f<'a>(x: &'a str) -> char { '\\'' }")) [[31 35 :char]])
      (assert= (:end (lexed rust "fn f<'a>(x: &'a str)")) [nil ""]))))

(describe "the state each line starts in, cached per buffer"
  (test "a line's state is the lex from the top, and the cache is kept on the model"
    (let (m (file-model "x = \"\"\"doc\nmore\n\"\"\"\ny = (1,\n  2)" "a.py" 0)
          [m2 state] (ed-line-state m (ed-current-index m) (ed-current-buf m) 1))
      (assert= state [:string "\"\"\"" true false])
      (is (map? (get (:string-caches m2) (ed-current-index m2))))
      (assert= (second (ed-line-state m2 (ed-current-index m2) (ed-current-buf m2) 4)) nil)
      ;; the whole state carries the brackets open at the line's start too
      (assert= (second (ed-line-start m2 (ed-current-index m2) (ed-current-buf m2) 4)) [nil "("])))
  (test "a line beginning a top-level form starts with no bracket open"
    (let (m (file-model "x = f(\ndef g():\n    y = [1,\n    2]" "a.py" 0)
          idx (ed-current-index m)
          buf (ed-current-buf m))
      (assert= (second (ed-line-start m idx buf 1)) [nil ""])
      (assert= (second (ed-line-start m idx buf 3)) [nil "["])))
  (test "the cache's line lexer counts brackets as `lex-line` does"
    (let (shell (lexer-data {:strings [{:open "\"" :multiline true}]
                             :comments ["#"]
                             :comment-word-start true}
                  [["(" ")"] ["{" "}"]])
          c (lexer-data {:strings [{:open "\""}] :block-comments [["/*" "*/"]]}
              [["(" ")"] ["{" "}"]])
          cases [[python "  f(a, [b, '(' # ) [" [nil ""]]
                  [python "  ]) x = (\"\"\"a(" [nil "(["]]
                  [python "  )\"\"\" + g(" [[:string "\"\"\"" true false] "{"]]
                  [shell "  x=$(# (" [nil ""]]
                  [shell "  echo ${#x} ( \"(\" # )" [nil "{"]]
                  [c "  f(/* ( */ a, \"{\" /* (" [nil ""]]
                  [c "  ) */ { ) )" [[:block "*/"] "("]]])
      (fold cases
        nil
        (fn (_ [data line state])
          (assert= (state-after data line state) (:end (lexed data line state)))))))
  (test "an edit moves it: the lines below the edit are not trusted"
    (let (m (file-model "a\nb\nc\nd" "a.py" 0)
          [m2 _] (ed-line-state m (ed-current-index m) (ed-current-buf m) 3)
          edited (ed-set-buf m2 (insert (goto-char (ed-current-buf m2) 0) "\"\"\""))
          [_ state] (ed-line-state edited (ed-current-index edited) (ed-current-buf edited) 3))
      (assert= state [:string "\"\"\"" true false])))
  (test "a killed buffer's cache goes with it"
    (let (m (assoc (file-model "a" "a.py" 0) :string-caches {0 {:x 1} 1 {:y 2} 2 {:z 3}}))
      (assert= (:string-caches (ed-drop-slot m 1)) {0 {:x 1} 1 {:z 3}}))))

(describe "the state at point"
  (test "in a string — opened lines above — in a comment, in code"
    (assert= (:inside (point-info "x = \"\"\"doc\nmore" "a.py" 13)) [:string "\"\"\"" true false])
    (assert= (:kind (:token (point-info "x = 1 # c" "a.py" 8))) :comment)
    (assert= (:inside (point-info "x = 'a' + 1" "a.py" 9)) nil)
    (assert= (:stack (point-info "f(a, [b" "a.py" 7)) "([")
    ;; counted from where the top-level form begins (`def` at column 0), lines above point too
    (assert= (:stack (point-info "x = 1\ndef f():\n    x = (1,\n         2" "a.py" 37)) "("))
  (test "a string's token in buffer offsets, closed or not"
    (let (token (:token (point-info "x = 'abc' + 1" "a.py" 6)))
      (assert= [(:start token) (:end token) (:open token) (:closed? token)] [4 9 "'" true])))
  (test "the string M-q fills, followed across lines"
    (let (m (file-model "x = 1\n'''aa\nbb\ncc''' + 2" "a.py" 13))
      (assert= (second (ed-string-extent m)) [6 20])))
  (test "the brackets open at point come from the warmed cache, however far up they opened"
    ;; a bracket opened 2,500 lines up, with no top-level form between: the old count walked up
    ;; at most 2,000 lines from point on every key and lost it; the cache carries it down
    (let (lines (append ["x = f("] (map (range 2500) (fn (i) (str "    a" i ","))) ["    b"])
          text (string/join lines "\n")
          m (file-model text "deep.py" (count text))
          idx (ed-current-index m)
          buf (ed-current-buf m)
          [m1 _] (ed-line-state m idx buf 0)
          entry (get (:string-caches m1) idx)
          warmed (warm-cache (:cache entry) (:lexer entry) (buffer-rope buf))
          m2 (ed-apply-string-warm (assoc m1
                                     :string-warm-proc :running
                                     :string-warm-index idx
                                     :string-warm-rope (buffer-rope buf)
                                     :string-warm-stamp (:stamp entry))
               {:cache warmed}))
      (assert= (:stack (second (ed-point-state m2))) "(")))
  (test "the held parse answers first, when the buffer keeps one"
    ;; Elixir's grammar is built in: the tree a refresh keeps for the buffer
    (let (m (file-model "x = \"abc\"\ny = 1" "a.ex" 6)
          held (syntaxtree/ed-sync-syntax-trees m [(ed-current-index m)])
          info (second (ed-point-state held)))
      (is (:tree? info))
      (assert= (:inside info) [:string "\"" false false])
      (assert= [(:start (:token info)) (:end (:token info))] [4 9]))))

(describe "balance, read forward from point"
  (test "a closer that closes nothing after point waits for an opener"
    (let (m (file-model " x)" "a.py" 0))
      (is (closer-waits? (ed-current-buf m) (second (ed-point-state m)) ["(" ")"])))
    (let (m (file-model "(a) x" "a.py" 4))
      (is (not (closer-waits? (ed-current-buf m) (second (ed-point-state m)) ["(" ")"])))))
  (test "stepping over a closer balances only when what stays open closes later"
    (let (unbalanced (file-model "((a)" "a.py" 3)
          balanced (file-model "((a)\n)" "a.py" 3))
      (is (not (closer-balances? (ed-current-buf unbalanced) (second (ed-point-state unbalanced)) 4)))
      (is (closer-balances? (ed-current-buf balanced) (second (ed-point-state balanced)) 4)))))

(describe "the cache warmed off the loop"
  (test "a long buffer with no cache is stale; a warm's cache becomes its own, and then it is not"
    (let (text (string/join (map (range 1200) (fn (i) (if (= i 600) "x = '''" "y = 1"))) "\n")
          m (file-model text "a.py" 0)
          idx (ed-current-index m)
          buf (ed-current-buf m)
          rope (buffer-rope buf)
          _ (is (ed-string-warm-stale? m))
          [m2 _] (ed-line-state m idx buf 0)
          entry (get (:string-caches m2) idx)
          warmed (warm-cache (:cache entry) (:lexer entry) rope)
          in-flight (assoc m2
                      :string-warm-proc :running
                      :string-warm-index idx
                      :string-warm-rope rope
                      :string-warm-stamp (:stamp entry))
          applied (ed-apply-string-warm in-flight {:cache warmed}))
      (is (nil? (:rope warmed))) ; what crossed the message carried no rope
      (is (nil? (:string-warm-proc applied)))
      (is (not (ed-string-warm-stale? applied)))
      (assert= (second (ed-line-state applied idx buf 1100)) [:string "'''" true false])))
  (test "a failed warm is not retried on the same text; a short buffer is never warmed"
    (let (m (file-model (string/join (map (range 1200) (fn (_) "y")) "\n") "a.py" 0)
          failed (ed-apply-string-warm (assoc m
                                         :string-warm-proc :running
                                         :string-warm-index 0
                                         :string-warm-rope (buffer-rope (ed-current-buf m)))
                   :failed))
      (is (not (ed-string-warm-stale? failed))))
    (is (not (ed-string-warm-stale? (file-model "x = 1" "a.py" 0))))))

(describe "the background build, end to end"
  (defn- live (thunk)
    ;; run `thunk` as the live loop would: a loop bound to this process, so work goes to tasks
    ;; whose replies come HERE
    (binding (editor/ui/*loop* (self)) (thunk)))

  :isolated (test "visiting a large buffer starts the build; its reply installs the cache; a key is then O(line)"
    (let (lines (map (range 3000) (fn (i) (if (= i 1500) "x = '''" "y = (1, 'a')")))
          text (str (string/join lines "\n") "\n'''")
          opened (file-model text "big.py" 0)
          ;; any event: its post-step sees a large buffer with no cache and starts the build
          started (live (fn () (input/ed-update opened :right 80 24)))
          handle (:string-warm-proc started)
          _ (is (not (nil? handle)))
          event (receive
                  ([:task-done ^handle value] [:task-done handle value])
                  ([:task-error ^handle reason] [:task-error handle reason])
                  (after 30000 (error "no reply from the string-cache build")))
          folded (live (fn () (input/ed-update started event 80 24)))
          idx (ed-current-index folded)
          entry (get (:string-caches folded) idx)
          buf (ed-current-buf folded))
      (assert= (first event) :task-done)
      (is (nil? (:string-warm-proc folded)))
      (is (= (:rope (:cache entry)) (buffer-rope buf)))
      ;; the cache reaches the last line: a question there lexes a few lines, not 3000
      (let ([_ known? state] (editor/line-cache/line-cache-state-within (:cache entry)
                               (:lexer entry)
                               (buffer-rope buf)
                               2999
                               40))
        (is known?)
        (assert= state [[:string "'''" true false] ""])))))

(describe "a key the cache does not reach yet"
  (test "guesses from the nearest top-level form, within bounds, and asks for the build"
    (let (lines (map (range 3000) (fn (i) (if (= i 2990) "def f():" "    pass")))
          text (str (string/join lines "\n") "\n    x = '''doc\n    more")
          m (file-model text "big.py" (count text))
          [m2 state] (ed-line-state m (ed-current-index m) (ed-current-buf m) 3001))
      (assert= state [:string "'''" true false])
      (is (:guessed (get (:string-caches m2) (ed-current-index m2))))
      (is (ed-string-warm-urgent? m2)))))

(describe "the background build and the pool"
  (test "a kill clears a build in flight for that buffer and moves the others down"
    (let (m (assoc (file-model "a" "a.py" 0) :string-warm-index 2 :string-warm-proc :running))
      (assert= (:string-warm-index (ed-drop-slot m 2)) nil)
      (assert= (:string-warm-index (ed-drop-slot m 0)) 1)
      (assert= (:string-warm-index (ed-drop-slot m 3)) 2)))
  (test "a guess asks for the build in a file of any size"
    (let (lines (map (range 400) (fn (i) (if (= i 390) "def f():" "    pass")))
          text (str (string/join lines "\n") "\n    x = '''doc\n    more")
          m (file-model text "mid.py" (count text))
          [m2 state] (ed-line-state m (ed-current-index m) (ed-current-buf m) 401))
      (assert= state [:string "'''" true false])
      (is (ed-string-warm-urgent? m2))))
  (test "where the cache's walk reached, the state is lexed on from it — a docstring's column-0 line is not code"
    (let (lines (append ["x = 1" "s = '''"]
                  (map (range 300) (fn (i) (str "body " i)))
                  ["'''" "y = 2"])
          text (string/join lines "\n")
          m (file-model text "doc.py" 0)
          [_ state] (ed-line-state m (ed-current-index m) (ed-current-buf m) 250))
      (assert= state [:string "'''" true false]))))
