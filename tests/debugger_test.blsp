;; Tests for src/debugger.blsp — the editor as the debugger endpoint.
;; Pure model folds + the collector's wire-protocol translation; no window needed.
;; The collector is spawned with THIS test process as the "editor", so forwarded
;; UiEvent records land in our own mailbox — the same push path the loop gets.
(defmodule debugger-test
  (:use test)
  (:use modes) ; gutter-mark-for + the gutter faces
  (:use model) ; ed-init / message / ed-buf-at / ui-event-fold (UiEvent)
  (:use editor/buffer)
  (:use debugger)
  (:use-internals debugger) ; the editor's own breakpoint wrapper (`--` names)
  (:use debug)) ; start/step the std side where a real park is wanted
(defn dbt-model () (ed-init (make-buffer "x")))

;; A tiny wait: receive one UiEvent record (they're maps, so a catch-all pattern
;; with a guard keeps the filterable clauses unharmed elsewhere).
(defn dbt-next-event (ms)
  (receive (e :when (record? e) e) (after ms :timeout)))

(describe "debugger collector — wire protocol -> UiEvent records"
  (test "a [:break pid snap] forwards immediately as a debug-break-event"
    (let (c (debugger-collector-start (self)))
      (send c [:break (self) {:label "bp" :vals {:n 6} :span nil}])
      (let (e (dbt-next-event 1000))
        (is (record? e))
        (assert= (self) (debug-break-event-pid e))
        (assert= "bp" (:label (debug-break-event-snapshot e))))
      (send c [:stop])))
  (test "trace entries batch into ONE debug-trace-event, oldest first"
    (let (c (debugger-collector-start (self)))
      (send c [:trace {:spy :call :fn 'f :args (list 1)} (self)])
      (send c [:trace {:spy :return :fn 'f :value 2} (self)])
      (let (e (dbt-next-event 1000))
        (is (record? e))
        (let (batch (debug-trace-event-batch e))
          (assert= 2 (count batch))
          (assert= :call (:spy (:entry (first batch))))
          (assert= :return (:spy (:entry (second batch))))))
      ;; one flush, not one event per entry
      (assert= :timeout (dbt-next-event 100))
      (send c [:stop])))
  (test "a break flushes pending traces first — *Spy* order is preserved"
    (let (c (debugger-collector-start (self)))
      (send c [:trace {:spy :node :form '(+ 1 2) :value 3 :depth 0} (self)])
      (send c [:break (self) {:label "bp" :vals {} :span nil}])
      (let (first-event (dbt-next-event 1000)
            second-event (dbt-next-event 1000))
        (is (not (nil? (debug-trace-event-batch first-event)))) ; the trace batch…
        (is (not (nil? (debug-break-event-snapshot second-event))))) ; …then the break
      (send c [:stop]))))

(describe "debugger — model folds"
  (test "a debug-break-event records the snapshot pid-keyed and echoes"
    (let (m (assoc (dbt-model) :debug {:collector :fake :paused {} :order '()})
          e (debug-break-event (self) {:label "square" :vals {:args (list 6)} :span nil})
          m2 (ui-event-fold e m 24 80 24))
      (assert= {:label "square" :vals {:args (list 6)} :span nil}
        (get-in m2 [:debug :paused (self)]))
      (is (includes? (:echo m2) "paused at square"))))
  (test "a debug-trace-event appends rendered lines to *Spy* with no echo"
    (let (m (dbt-model)
          e (debug-trace-event (list {:pid (self) :entry {:spy :call :fn 'f :args (list 1 2)}}
                                 {:pid (self) :entry {:spy :return :fn 'f :value 3}}))
          m2 (ui-event-fold e m 24 80 24)
          i (ed-buffer-index-by-name! m2 "*Spy*"))
      (let (text (buffer-text (ed-buf-at m2 i)))
        (is (includes? text "call (f (1 2))"))
        (is (includes? text "f => 3")))
      (assert= "" (:echo m2))
      ;; the SECOND batch lands after *Spy* was stamped :spy-log (read-only report) —
      ;; regression for the 'buffer is read-only' break
      (let (m3 (ui-event-fold (debug-trace-event (list {:pid (self)
                                                        :entry {:spy :return :fn 'g :value 9}}))
                 m2 24 80 24)
            b (ed-buf-at m3 (ed-buffer-index-by-name! m3 "*Spy*")))
        (is (includes? (buffer-text b) "g => 9"))
        (is (editor/buffer/read-only? b))))))

(describe "debugger — rendering (pure)"
  (test "trace lines render each entry kind"
    (assert= true
      (includes? (debugger-trace-line {:pid (self) :entry {:spy :enter :form '(+ 1 2)}})
        "spy (+ 1 2)"))
    (assert= true
      (includes? (debugger-trace-line {:pid (self) :entry {:spy :span-enter :label "req"}})
        "span \"req\""))
    ;; the shared body renderer is what *Run*/*Tests* consume too
    (assert= "call (f (1 2))" (debugger-spy-body "call" nil nil "f" "(1 2)")))
  (test "the *Debug* text lists rows, breakpoints and traced fns separately"
    (let (text (debugger-buffer-text {} '() (list 'my/bp) (list 'my/tr)))
      (is (includes? text "(no parked processes)"))
      (is (includes? text "breakpoints: my/bp"))
      (is (includes? text "my/tr"))))
  (test "eval-in-scope resolves the captured names (pid-keyed eval-at)"
    (assert= 36 (debugger-eval-in "(* n n)" {:n 6}))
    (assert= (list 6) (debugger-eval-in "args" {:args (list 6)}))))

(describe "debugger — end to end: break-fn parks a worker into the editor's queue"
  :isolated (test "a break-fn'd function parks its caller; resume releases it"
    (let (me (self)
          c (debugger-collector-start me))
      ;; a session, hand-wired to the collector (what cmd-debug-session does)
      (%set-trace-context {:debugger c :span nil})
      (def *spy-sink* (debug/debugger-sink))
      (reflect/eval '(defn dbt-target (n) (* n n)))
      (debug/break-fn 'dbt-target)
      ;; the worker inherits the context (own) across spawn and parks at the call
      ;; `dbt-target` is defined by the `reflect/eval` two lines up, so the checker cannot see it —
      ;; and that invisibility is precisely what this harness exercises (a breakpoint on a
      ;; function defined at run time). `check-allow :unbound` keeps `nest check` clean
      ;; without changing behaviour, the same opt-out brood uses in eval_forward_ref.blsp.
      (check-allow :unbound (spawn (send me [:result (dbt-target 7)])))
      (let (e (dbt-next-event 2000))
        (is (record? e))
        (let (pid (debug-break-event-pid e)
              snap (debug-break-event-snapshot e))
          (assert= "dbt-target" (:label snap))
          (assert= (list 7) (:args (:vals snap)))
          ;; eval in its captured scope, then release it
          (assert= (list 7) (debugger-eval-in "args" (:vals snap)))
          (send pid [:resume])))
      (assert= 49 (receive ([:result r] r) (after 2000 :timeout)))
      ;; unwind: restore the image-wide seams for the rest of the suite
      (debug/untrace-fn 'dbt-target)
      (%set-trace-context nil)
      (def *spy-sink* nil)
      (send c [:stop]))))

(describe "debugger — the editor's OWN breakpoint wrapper (not std's break-fn)"
  :isolated
  ;; `debugger--install-breakpoint` rebinds the function to a wrapper that parks every
  ;; caller EXCEPT the editor process. The parking call is `debug/break`, a MACRO — it was
  ;; `apply`ed, which raises at runtime, so a breakpoint hit by any worker threw instead
  ;; of parking. `nest check` had been reporting it ("apply: argument 1 expects fn |
  ;; native, got macro") the whole time.
  (test "REGRESSION: a non-editor caller parks (and does not raise) at the breakpoint"
    (let (me (self)
          c (debugger-collector-start me))
      (%set-trace-context {:debugger c :span nil})
      (def *spy-sink* (debug/debugger-sink))
      (reflect/eval '(defn dbt-bp-target (n) (+ n 1)))
      (debugger/debugger-install-breakpoint 'dbt-bp-target)
      ;; likewise defined by `reflect/eval` above — invisible to the checker by design
      (check-allow :unbound (spawn (send me [:result (dbt-bp-target 41)])))
      (let (e (dbt-next-event 2000))
        (is (record? e)) ; it parked, rather than raising
        (let (snap (debug-break-event-snapshot e))
          (assert= "dbt-bp-target" (:label snap))
          (assert= (list 41) (:args (:vals snap))))
        (send (debug-break-event-pid e) [:resume]))
      (assert= 42 (receive ([:result r] r) (after 2000 :timeout))) ; and delegated
      (debugger/debugger-uninstall-breakpoint 'dbt-bp-target)
      (%set-trace-context nil)
      (def *spy-sink* nil)
      (send c [:stop])))

  ;; issue P5's other half: the wrapper spared only the process registered `:editor`, so a
  ;; breakpoint on a function a SECOND frame's loop calls parked that loop — and a loop is
  ;; the only thing that could have resumed it. Any process inside a `ui-run` is spared.
  (test "a loop process — any window's, not only the first — runs through a breakpoint"
    (let (me (self))
      (reflect/eval '(defn dbt-bp-loop (n) (* n 2)))
      (debugger/debugger-install-breakpoint 'dbt-bp-loop)
      (check-allow :unbound
        (spawn (binding (*ui-loop* (self)) (send me [:result (dbt-bp-loop 21)]))))
      (assert= 42 (receive ([:result r] r) (after 2000 :parked)))
      (debugger/debugger-uninstall-breakpoint 'dbt-bp-loop)))

  ;; issue P5: the breakpoint remembered the pre-breakpoint function and put it back on
  ;; removal — over whatever had been defined since, so C-x C-e on a fix and then clearing
  ;; the breakpoint silently reverted the fix
  (test "removing a breakpoint keeps a definition made after it was set"
    (do
      (reflect/eval '(defn dbt-bp-edit (n) :old))
      (debugger/debugger-install-breakpoint 'dbt-bp-edit)
      (reflect/eval '(defn dbt-bp-edit (n) :new))
      (debugger/debugger-uninstall-breakpoint 'dbt-bp-edit)
      (assert= :new (reflect/eval '(dbt-bp-edit 1)))
      (is (not (includes? (debugger/debugger-breakpoints) 'dbt-bp-edit)))))

  (test "removing an untouched breakpoint restores the original"
    (let (_ (reflect/eval '(defn dbt-bp-plain (n) (* n 3)))
          orig (reflect/eval 'dbt-bp-plain))
      (debugger/debugger-install-breakpoint 'dbt-bp-plain)
      (is (not (= orig (reflect/eval 'dbt-bp-plain)))) ; the wrapper is in place
      (debugger/debugger-uninstall-breakpoint 'dbt-bp-plain)
      (is (= orig (reflect/eval 'dbt-bp-plain)))))

  (test "the editor's own loop is never parked by its own breakpoint"
    ;; the reason this wrapper exists instead of std's `break-fn`: parking the ui-run loop
    ;; would freeze the only sender of [:resume]. A loop is what `*ui-loop*` names.
    (let (me (self)
          c (debugger-collector-start me))
      (%set-trace-context {:debugger c :span nil})
      (reflect/eval '(defn dbt-bp-self (n) (* n 2)))
      (debugger/debugger-install-breakpoint 'dbt-bp-self)
      ;; through `reflect/eval`, like the target above: the defn is installed at runtime, so a
      ;; direct call would be an unbound name to the checker
      (assert= 20 (binding (*ui-loop* (self)) (reflect/eval '(dbt-bp-self 10)))) ; no park
      (debugger/debugger-uninstall-breakpoint 'dbt-bp-self)
      (%set-trace-context nil)
      (send c [:stop]))))

(describe "debugger — margin breakpoints (pure)"
  (test "a definition line yields its name; other lines don't"
    (assert= "ed-foo" (debugger-defn-name "(defn ed-foo (m key)"))
    (assert= "cmd-bar" (debugger-defn-name "(defcommand cmd-bar"))
    (is (nil? (debugger-defn-name "  (defn indented-not-top-level (x)")))
    (is (nil? (debugger-defn-name "(defmodule input"))))
  (test "the buffer's module qualifies the clicked name"
    (assert= "input" (debugger-buffer-module "(defmodule input\n  \"doc\")\n(defn f (x) x)"))
    (is (nil? (debugger-buffer-module "(defn bare (x) x)"))))
  (test "a click anywhere in a body resolves upward to the enclosing definition"
    (let (b (make-buffer "(defmodule m \"d\")\n(defn f (x)\n  (body-line x)\n  (more x))\n"))
      (assert= 1 (debugger-defn-line-at b 3)) ; deep in the body -> the head
      (assert= 1 (debugger-defn-line-at b 1)) ; the head itself
      (is (nil? (debugger-defn-line-at b 0))))) ; above the first defn
  (test "test scaffolding is skipped: a click inside a test resolves past it"
    (let (b (make-buffer (str "(defmodule x-test (:use test))\n"
                           "(defn helper (x) x)\n" "(describe \"g\"\n" "  (test \"a\"\n"
                           "    (is true)))\n")))
      ;; anywhere inside the describe/test block -> the defn above, never a test run
      (assert= 1 (debugger-defn-line-at b 4))
      (assert= 1 (debugger-defn-line-at b 2))
      (is (nil? (debugger-defn-line-at b 0)))))
  (test "a gutter click above everything just says so"
    (let (m2 (brood-gutter-click (dbt-model) 0))
      (is (includes? (:echo m2) "no definition"))))
  (test "a NOT-loaded project fn becomes a pending run breakpoint (no doomed load)"
    ;; a buffer whose module/fn isn't bound in the editor image → a run break
    (let (b (make-buffer
              "(defmodule hatch/errors (:use test))
(defn error-meta (code) code)"
              "errors.blsp")
          m (ed-set-buf (dbt-model) b)
          m2 (brood-gutter-click m 1))
      ; click the (defn error-meta) line
      (is (includes? (:echo m2) "run the project")) ; honest message, not a load error
      (is (includes? (debugger-run-breaks m2) 'hatch/errors/error-meta)) ; recorded
      ;; clicking again removes it
      (is (empty? (debugger-run-breaks (brood-gutter-click m2 1)))))))

(describe "debugger — gutter marks (modes/gutter-mark-for)"
  ;; every margin source is a buffer ANNOTATION now (std `annotate` stamps the rope +
  ;; line count it describes), so these go through that API rather than hand-building
  ;; the fields — and staleness is a real edit, not a `:modified` flag.
  (test "a breakpoint line marks ● while positionally current, and blanks when lines shift"
    (let (b (editor/buffer/annotate (make-buffer "(defn f (x) x)\nrest")
              :debug-break-lines {0 true}))
      (assert= "●" (first (modes/gutter-mark-for b 0)))
      (is (nil? (modes/gutter-mark-for b 1)))
      ;; an inserted line shifts the mapping — blank the marks rather than misplace them
      (is (nil? (modes/gutter-mark-for (insert (goto-char b 0) "\n") 0)))))

  (test "test verdicts mark ✓/✗, dimming once the text differs from the run"
    (let (b (editor/buffer/annotate (make-buffer "(test)\n(test)") :test-marks {0 true 1 false}))
      (assert= "✓" (first (modes/gutter-mark-for b 0)))
      (assert= "✗" (first (modes/gutter-mark-for b 1)))
      (assert= modes/gutter-face-test-pass (second (modes/gutter-mark-for b 0)))
      ;; an edit that keeps the line count dims the verdict (it predates your change)
      (let (edited (insert (end-of-line (goto-char b 0)) "!"))
        (assert= modes/gutter-face-test-stale (second (modes/gutter-mark-for edited 0))))))

  ;; The mark is drawn IN the gutter→text margin (`gutter-annotate` shaves it off the
  ;; number chunk so the numbers never move), which is why that margin is two columns
  ;; and not one: at one the mark lands flush against the last digit — `9✓` — and at two it
  ;; lands flush against the TEXT, so `defmodule` read as `✗defmodule`. Three gives the
  ;; glyph a blank on each side. Pinned here because the width is a constant someone will
  ;; reasonably want to tighten again.
  (test "a marked line keeps a space between its number and the mark, at any digit count"
    (let (buf (editor/buffer/annotate (make-buffer (string/join (map (range 0 120)
                                                                  (fn (i) (str "line " i)))
                                                     "\n"))
                :test-marks {1 true 100 true})
          gw (+ modes/line-number-right-margin
               (math/max modes/line-number-min-digits
                 (string/length (str (editor/buffer/buffer-line-count buf)))))
          cell-of (fn (line) (modes/line-number-cell buf line gw))
          number-of (fn (line) (first (first (cell-of line))))
          mark-of (fn (line) (first (second (cell-of line)))))
      ;; two digits and three, each in a gw-wide field: the number chunk still ends in a
      ;; blank column, the mark follows it, and a blank follows the MARK — so the glyph
      ;; reads as a mark about the line and not as its first character
      (assert= "  2 " (number-of 1))
      (assert= "✓" (mark-of 1))
      (assert= "101 " (number-of 100))
      (assert= "✓" (mark-of 100))
      (assert= " " (first (nth (cell-of 1) 2)))
      ;; an unmarked line is the plain right-aligned number, margin intact
      (assert= "  1   " (first (cell-of 0)))))

  (test "an end-of-line note marks its kind (·/✓/✗/⋯), ⋯ never dimmed"
    (let (b (editor/buffer/annotate (make-buffer "a\nb")
              :eol-notes {:box0 {:line 0 :kind :pass :text "✓ 42"}
               :box1 {:line 1 :kind :running :text "⋯ evaluating…"}}))
      (assert= "✓" (first (modes/gutter-mark-for b 0)))
      (assert= "⋯" (first (modes/gutter-mark-for b 1)))))

  (test "gutter-annotate puts the mark in the MIDDLE gap column"
    (let (b (editor/buffer/annotate (make-buffer "x") :debug-break-lines {0 true})
          out (modes/gutter-annotate b 0 ["12  " {:fg "#fff"}]))
      ;; number, mark, blank — the blank after is what stops `●x` reading as one token
      (assert= 3 (count out))
      (assert= "12" (first (first out)))
      (assert= "●" (first (second out)))
      (assert= " " (first (nth out 2))))
    ;; unmarked lines pass the cell through untouched
    (assert= ["12 " nil] (modes/gutter-annotate (make-buffer "x") 0 ["12 " nil]))))
