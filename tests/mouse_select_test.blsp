;; A double click selects what is under it: the word, a run of spaces, one delimiter — and at a
;; line's end nothing, never the next line's word (Emacs bug#81769).
(defmodule mouse-select-test
  (:use test)
  (:use editor/buffer)
  (:use mouse :only [ed-select-word]))

(defn- selected (text at)
  ;; `[mark point]` after a double click at `at` in `text`
  (let (buf (ed-select-word (goto-char (make-buffer text) at)))
    [(:mark buf) (buffer-point buf)]))

(describe "a double click selects what is under it"
  (test "a word, from anywhere in it"
    (assert= (selected "foo bar" 0) [0 3])
    (assert= (selected "foo bar" 5) [4 7]))
  (test "a run of spaces, on its line"
    (assert= (selected "foo   bar" 4) [3 6]))
  (test "trailing spaces stay on their line"
    (assert= (selected "foo   \nbar" 4) [3 6]))
  (test "at a line's end, nothing: point stays and no mark is set"
    (assert= (selected "foo\nbar" 3) [nil 3])
    (assert= (selected "foo" 3) [nil 3]))
  (test "a delimiter alone"
    (assert= (selected "f(x)" 1) [1 2])))
