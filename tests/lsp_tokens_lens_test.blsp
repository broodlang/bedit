;; LSP semantic tokens (src/lsp-semantic.blsp) and code lenses (src/lsp-lens.blsp): the pure
;; halves — the integer array, deltas, the legend and faces, spans carried through edits, lens
;; parsing and placement — and a round trip through a stand-in connection that answers each
;; request with the kind's own shaping of a canned server result, as a real connection does.

(defmodule lsp-tokens-lens-test
  (:use test)
  (:use-internals lsp-semantic)
  (:use-internals lsp-lens)
  (:use lsp-requests)
  (:use lsp-servers) ; ed-lsp-attach — a server filed without spawning one
  (:use model) ; ed-init / ed-set-buf / ed-current-buf
  (:use editor/buffer)) ; make-buffer / insert / goto-char

;; ---- the integer array --------------------------------------------------------------
(describe "lsp semantic tokens: decoding"
  (test "relative lines and columns become absolute"
    (assert= (decode-tokens [0 4 3 1 0 1 2 5 0 2 0 6 1 2 0])
      [[0 4 3 1 0] [1 2 5 0 2] [1 8 1 2 0]]))
  (test "a partial trailing group and an empty array decode to what is whole"
    (assert= (decode-tokens [0 1 2 0 0 3 4]) [[0 1 2 0 0]])
    (assert= (decode-tokens []) [])
    (assert= (decode-tokens nil) []))
  (test "a delta's edits splice the previous array, in start order"
    (assert= (apply-delta [1 2 3 4 5] [{:start 1 :deleteCount 2 :data [9]}]) [1 9 4 5])
    (assert= (apply-delta [1 2 3 4 5]
               [{:start 4 :deleteCount 1} {:start 0 :deleteCount 0 :data [7 7]}])
      [7 7 1 2 3 4])
    (assert= (apply-delta [1 2] [{:start 2 :deleteCount 0 :data [3 4 5]}]) [1 2 3 4 5])
    (assert= (apply-delta [1 2] []) [1 2]))
  (test "a modifier bit set reads through the legend"
    (assert= (modifier-names 5 ["declaration" "definition" "readonly"]) #{"declaration" "readonly"})
    (assert= (modifier-names 0 ["declaration"]) #{})
    ;; a bit past the legend names nothing
    (assert= (modifier-names 8 ["declaration"]) #{})))

(describe "lsp semantic tokens: faces"
  (test "a token type maps to the editor's syntax face"
    (assert= (token-face "function" #{}) :syntax/function)
    (assert= (token-face "method" #{}) :syntax/function)
    (assert= (token-face "macro" #{}) :syntax/function)
    (assert= (token-face "parameter" #{}) :syntax/variable)
    (assert= (token-face "variable" #{}) :syntax/variable)
    (assert= (token-face "type" #{}) :syntax/special)
    (assert= (token-face "namespace" #{}) :syntax/special)
    (assert= (token-face "keyword" #{}) :syntax/keyword)
    (assert= (token-face "enumMember" #{}) :syntax/constant))
  (test "a definition and a readonly variable take their own face"
    (assert= (token-face "function" #{"declaration"}) :syntax/definition)
    (assert= (token-face "struct" #{"definition"}) :syntax/definition)
    (assert= (token-face "variable" #{"readonly"}) :syntax/constant)
    ;; a parameter is not a definition of a function, whatever its modifiers
    (assert= (token-face "parameter" #{"declaration"}) :syntax/variable))
  (test "the lexical kinds and unknown types are left to the mode"
    (is (nil? (token-face "string" #{})))
    (is (nil? (token-face "comment" #{})))
    (is (nil? (token-face "number" #{})))
    (is (nil? (token-face "somethingNew" #{})))
    (is (nil? (token-face nil #{}))))
  (test "the client advertises the types and modifiers it maps"
    (assert= (:tokenTypes client-capabilities) *token-types*)
    (is (includes? *token-types* "parameter"))
    (assert= (map/get-in client-capabilities [:requests :full :delta]) true)))

(def- legend
  {:tokenTypes ["function" "variable" "string"] :tokenModifiers ["declaration" "readonly"]})

(describe "lsp semantic tokens: spans of the text"
  (test "tokens become char spans, a faceless one left out"
    (let (rope (text/string-> "fn main() {\n  let x = \"s\";\n}\n"))
      (assert= (token-spans (decode-tokens [0 3 4 0 1 1 6 1 1 0 0 4 3 2 0]) legend rope)
        [[3 7 :syntax/definition] [18 19 :syntax/variable]])))
  (test "a column past an emoji is read in UTF-16 units"
    ;; `😀` is two units: `x` starts at unit 3, char 2
    (let (rope (text/string-> "a😀x"))
      (assert= (token-spans [[0 3 1 1 0]] legend rope) [[2 3 :syntax/variable]])))
  (test "a token past the text or past its line's end is cut or dropped"
    (let (rope (text/string-> "ab\ncd"))
      (assert= (token-spans [[0 1 9 1 0] [5 0 1 1 0]] legend rope) [[1 2 :syntax/variable]]))))

;; ---- carrying spans through edits --------------------------------------------------
(describe "lsp semantic tokens: spans follow the text"
  (test "an insertion before a span moves it; inside a name it stretches"
    (assert= (shift-spans [[0 3 :a] [4 7 :b] [8 9 :c]] [5 5 "xy"]) [[0 3 :a] [4 9 :b] [10 11 :c]])
    (assert= (shift-spans [[4 7 :b]] [0 0 "zz"]) [[6 9 :b]])
    ;; typed right at the end of a name: the name does not grow
    (assert= (shift-spans [[4 7 :b]] [7 7 "q"]) [[4 7 :b]])
    ;; right at its start: it moves
    (assert= (shift-spans [[4 7 :b]] [4 4 "q"]) [[5 8 :b]]))
  (test "a space typed inside a name, or an edit across it, drops it"
    (assert= (shift-spans [[4 7 :b] [9 10 :c]] [5 5 " "]) [[10 11 :c]])
    (assert= (shift-spans [[0 3 :a] [4 7 :b]] [2 5 "zz"]) []))
  (test "a deletion takes what it covers and leaves a name's tail"
    (assert= (shift-spans [[0 3 :a] [4 7 :b]] [2 5 ""]) [[2 4 :b]])
    (assert= (shift-spans [[0 3 :a] [4 7 :b]] [0 3 ""]) [[1 4 :b]]))
  (test "spans are carried from the buffer they were computed on to the buffer now"
    (let (seen (make-buffer "let x = 1")
          now (insert (goto-char seen 0) "// ")
          gone (make-buffer "other"))
      (assert= (carry-spans [[4 5 :v]] seen now) [[7 8 :v]])
      (assert= (carry-spans [[4 5 :v]] seen seen) [[4 5 :v]])
      ;; a buffer the log cannot reach: nil, for the caller to drop them
      (is (nil? (carry-spans [[4 5 :v]] seen gone))))))

(describe "lsp semantic tokens: painted over the mode's colours"
  (test "the semantic layer wins where it colours, the mode shows elsewhere"
    (let (buf (assoc (make-buffer "foo bar") :semantic-spans [[4 7 :syntax/variable]])
          spans (spanpaint/ed-buffer-spans buf [[0 3 :syntax/keyword] [4 7 :syntax/special]]))
      (assert= (view/ed-face-at spans 1) :syntax/keyword)
      (assert= (view/ed-face-at spans 5) :syntax/variable)
      (assert= (into [] (get (spanpaint/ed-spans-by-line-at (buffer-rope buf) spans 0 0) 0))
        [[0 3 :syntax/keyword] [4 7 :syntax/variable]])))
  (test "a buffer with no semantic spans paints exactly the mode's"
    (let (buf (make-buffer "foo"))
      (assert= (spanpaint/ed-buffer-spans buf [[0 3 :syntax/keyword]]) [[0 3 :syntax/keyword]]))))

;; ---- code lenses: parsing and placement ----------------------------------------------
(describe "lsp code lens: parsing and placement"
  (test "a lens reads its start, title and command; an unresolved one has none"
    (let (lenses (parse-lenses [{:range {:start {:line 2 :character 4}}
                                 :command {:title "3 references" :command "refs" :arguments [1]}}
                                 {:range {:start {:line 5 :character 0}} :data {:id 9}}]))
      (assert= (count lenses) 2)
      (assert= (map/select-keys (first lenses) [:line :units :title :command :arguments])
        {:line 2 :units 4 :title "3 references" :command "refs" :arguments [1]})
      (is (nil? (:command (second lenses))))
      (assert= (:raw (second lenses)) {:range {:start {:line 5 :character 0}} :data {:id 9}})
      (is (shown? (first lenses)))
      (refute (shown? (second lenses)))))
  (test "a null answer is no lenses"
    (assert= (parse-lenses nil) [])
    (assert= (parse-lenses {:not "a list"}) []))
  (test "a lens is anchored at its offset; one past the text is dropped"
    (let (rope (text/string-> "a\n  fn x\n"))
      (assert= (map (anchor-lenses (parse-lenses [{:range {:start {:line 1 :character 2}}}
                                                   {:range {:start {:line 9 :character 0}}}])
                      rope)
                 :offset)
        '(4))))
  (test "one row above each line, titles joined, indented as the line"
    (let (rope (text/string-> "a\n  fn x\nb\n"))
      (assert= (lens-rows [{:offset 4 :title "Run"}
                            {:offset 5 :title "Debug"}
                            {:offset 9 :title "1 ref"}
                            {:offset 0 :title nil}]
                 rope)
        [{:line 1 :text "  Run | Debug"} {:line 2 :text "1 ref"}])))
  (test "lens anchors follow edits; the lenses on a line are found by them"
    (let (seen (make-buffer "a\nfn x\n")
          now (insert (goto-char seen 0) "z\n")
          carried (carry-lenses [{:offset 2 :title "Run" :command "run"}] seen now))
      (assert= (map carried :offset) '(4))
      (assert= (lens-rows carried (buffer-rope now)) [{:line 2 :text "Run"}])
      (assert= (count (lenses-on-line carried (buffer-rope now) 2)) 1)
      (assert= (count (lenses-on-line carried (buffer-rope now) 1)) 0))))

;; ---- the wire: what goes out, what comes back ------------------------------------------
(describe "lsp semantic tokens and code lens: on the wire"
  (test "each kind names its method and builds its params"
    (assert= (lsp-request-method (lsp-semantic-tokens)) "textDocument/semanticTokens/full")
    (assert= (lsp-request-method (lsp-semantic-tokens-delta))
      "textDocument/semanticTokens/full/delta")
    (assert= (lsp-request-params (lsp-semantic-tokens-delta)
               {:uri "file:///a.rs" :previous-result-id "4"})
      {:textDocument {:uri "file:///a.rs"} :previousResultId "4"})
    (assert= (lsp-request-method (lsp-code-lens)) "textDocument/codeLens")
    (assert= (lsp-request-params (lsp-code-lens-resolve) {:lens {:data 1}}) {:data 1}))
  (test "a server's response is shaped for the waiter by the connection"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 3
                 :pending {2 [:me :corr (lsp-semantic-tokens)]}
                 :opened {}
                 :version 1}
          response (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                :id 2
                                                :result {:resultId "7" :data [0 1 2 0 0]}}))
          [_ replies] (lsp-protocol/lsp-ingest state response))
      (assert= replies
        (list [:me [:lsp-semantic-tokens :corr {:result-id "7" :data [0 1 2 0 0] :edits nil}]]))))
  (test "the request asks for no text: the document is synced before it"
    (let ([_ frames] (lsp-protocol/lsp-issue {:proc :fake
                                              :buf ""
                                              :next-id 1
                                              :pending {}
                                              :opened {}
                                              :version 1}
                       :corr :me
                       (lsp-code-lens)
                       {:uri "file:///a.rs" :lang "rust"}))
      (assert= (count frames) 1)
      (is (includes? (first frames) "textDocument/codeLens")))))

;; ---- a round trip through a stand-in connection ----------------------------------------
(defn- stand-in (results)
  "A connection answering each ask with the next of `results` (raw server results), shaped by
the asked kind's own `lsp-request-shape`, and telling the test what it was asked. Syncs are
taken and ignored."
  (let (test-pid (self))
    (spawn (fn ()
             (letrec (go (fn (left)
                           (receive
                             ([:ask kind corr reply-to request] (do
                                                                  (send test-pid
                                                                    [:asked [kind request]])
                                                                  (let ([tag value] (lsp-request-shape kind
                                                                                      (first left)))
                                                                    (send reply-to [tag corr value]))
                                                                  (go (rest left))))
                             ([:sync _uri _lang _sync] (go left))
                             (after 3000 :done))))
               (go results))))))

(defn- asked ()
  (receive ([:asked question] question) (after 2000 nil)))

(defn- deliver (m)
  "`m` after the next reply lands, folded as the loop folds it."
  (receive
    ((and reply [_tag _corr _value]) (lsp-commands/ed-ev-lsp-reply m reply nil 80 24))
    (after 2000 m)))

(defn- serving (m conn caps)
  (let (file (buffer-file (ed-current-buf m)))
    (ed-lsp-attach m
      {:spec "rust-analyzer" :roots [(path/dirname (or file "/tmp/x"))] :conn conn :caps caps})))

(describe "lsp semantic tokens: a round trip"
  (test "asked when the text moved, folded onto the buffer, carried, then asked as a delta"
    (let (conn (stand-in [{:resultId "1" :data [0 3 4 0 1 0 9 1 1 0]}
                           {:resultId "2"
                            :edits [{:start 1 :deleteCount 1 :data [5]}
                                     {:start 6 :deleteCount 1 :data [12]}]}])
          caps {:semanticTokensProvider {:legend {:tokenTypes ["function" "variable"]
                                                  :tokenModifiers ["declaration"]}
                                         :full {:delta true}}}
          m (serving (ed-init (make-buffer "fn main() { x; y }" "s.rs" "/tmp/sem.rs")) conn caps)
          _ (is (ed-semantic-due? m))
          asking (ed-semantic-request m)
          _ (refute (ed-semantic-due? asking))
          [kind _] (asked)
          _ (assert= kind (lsp-semantic-tokens))
          landed (deliver asking))
      (assert= (:semantic-spans (ed-current-buf landed))
        [[3 7 :syntax/definition] [12 13 :syntax/variable]])
      ;; typed at the start: the post-step carries the spans with the text
      (let (typed (semantic-follow (ed-set-buf landed
                                     (insert (goto-char (ed-current-buf landed) 0) "  "))))
        (assert= (:semantic-spans (ed-current-buf typed))
          [[5 9 :syntax/definition] [14 15 :syntax/variable]])
        (is (ed-semantic-due? typed))
        ;; the second ask is a delta against the first answer
        (let (again (ed-semantic-request typed)
              [kind request] (asked)
              _ (assert= kind (lsp-semantic-tokens-delta))
              _ (assert= (:previous-result-id request) "1")
              updated (deliver again))
          (assert= (map/get-in updated [:lsp-semantic "/tmp/sem.rs" :data]) [0 5 4 0 1 0 12 1 1 0])
          (assert= (:semantic-spans (ed-current-buf updated))
            [[5 9 :syntax/definition] [17 18 :syntax/variable]])))))
  (test "a server that offers none is never asked, and the mode toggles it off"
    (let (m (serving (ed-init (make-buffer "x" "s.rs" "/tmp/sem2.rs")) (self) {}))
      (refute (ed-semantic-due? m))
      (let (off (cmd-lsp-semantic-tokens-mode (assoc m :lsp-semantic-tokens true) nil))
        (refute (semantic-on? off))
        (assert= (:lsp-semantic off) {})))))

(describe "lsp code lens: a round trip"
  (test "lenses are asked, resolved, shown above their line, and run"
    (let (conn (stand-in [[{:range {:start {:line 1 :character 2}} :data {:id 1}}]
                           {:range {:start {:line 1 :character 2}}
                            :command {:title "Run test" :command "run.test" :arguments [7]}}
                           nil])
          caps {:codeLensProvider {:resolveProvider true}
                :executeCommandProvider {:commands ["run.test"]}}
          m (assoc (serving (ed-init (make-buffer "a\n  fn t() {}\n" "s.rs" "/tmp/lens.rs"))
                     conn caps)
              :lsp-code-lens true)
          _ (is (ed-lens-due? m))
          asking (ed-lens-request m)
          [kind _] (asked)
          _ (assert= kind (lsp-code-lens))
          listed (deliver asking)
          ;; unresolved: no row yet, and the resolve is out
          _ (assert= (wrap/inlay-lines (ed-current-buf listed)) {})
          [resolve-kind resolve-request] (asked)
          _ (assert= resolve-kind (lsp-code-lens-resolve))
          _ (assert= (:lens resolve-request) {:range {:start {:line 1 :character 2}} :data {:id 1}})
          resolved (deliver listed))
      (assert= (wrap/inlay-lines (ed-current-buf resolved)) {1 ["  Run test"]})
      ;; typing a line above carries the row down with its line
      (let (typed (lens-follow (ed-set-buf resolved
                                 (insert (goto-char (ed-current-buf resolved) 0) "new\n"))))
        (assert= (wrap/inlay-lines (ed-current-buf typed)) {2 ["  Run test"]})
        ;; point on the lens's line: M-x lsp-code-lens-run sends its command
        (let (on-line (ed-set-buf typed (goto-char (ed-current-buf typed) 8))
              _ (cmd-lsp-code-lens-run on-line nil)
              [run-kind run-request] (asked))
          (assert= run-kind (lsp-execute-command))
          (assert= run-request {:command "run.test" :arguments [7]})
          ;; its answer (`null`) taken, so nothing is left in this process's mailbox
          (deliver on-line)))))
  (test "off by default, and the run command says so"
    (let (m (serving (ed-init (make-buffer "x" "s.rs" "/tmp/lens2.rs"))
              (self)
              {:codeLensProvider {}}))
      (refute (lens-on? m))
      (refute (ed-lens-due? m))
      (is (includes? (:echo (cmd-lsp-code-lens-run m nil)) "off"))))
  (test "no lens on point's line is said"
    (let (m (assoc (ed-init (make-buffer "x" "s.rs" "/tmp/lens3.rs")) :lsp-code-lens true))
      (is (includes? (:echo (cmd-lsp-code-lens-run m nil)) "no code lens")))))

;; ---- running a lens: server commands, client commands, the mouse ---------------------
(defn- asked-within (ms)
  (receive ([:asked question] question) (after ms nil)))

(defn- lensed (conn caps text path raw)
  "A model showing `text` as file `path`, served by `conn` with `caps`, holding the lenses of
the raw server answer `raw` as if it had just landed."
  (let (m (assoc (serving (ed-init (make-buffer text "s.rs" path)) conn caps) :lsp-code-lens true))
    (ed-lens-fold {:path path :seen (ed-current-buf m) :conn conn} m (parse-lenses raw))))

(defn- lens (line title command & arguments)
  {:range {:start {:line line :character 0}}
   :command {:title title :command command :arguments (into [] arguments)}})

(describe "lsp code lens: what a lens runs"
  (test "a rust-analyzer runnable becomes its cargo command, in its folder"
    (assert= (runnable-command {:kind "cargo"
                                :args {:cargoArgs ["run"
                                                    "--package" "lens-fixture" "--bin"
                                                    "lens-fixture"]
                                       :executableArgs []
                                       :cwd "/p/crate"
                                       :workspaceRoot "/p"}})
      ["cargo run --package lens-fixture --bin lens-fixture" "/p/crate"])
    (assert= (runnable-command {:kind "cargo"
                                :args {:cargoArgs ["test" "--package" "x"]
                                       :executableArgs ["tests::adds" "--exact" "--show-output"]
                                       :workspaceRoot "/p"
                                       :environment {:RUST_BACKTRACE "short"}
                                       :overrideCargo "my cargo"}})
      ["RUST_BACKTRACE=short 'my cargo' test --package x -- tests::adds --exact --show-output" "/p"])
    (assert= (runnable-command {:kind "shell" :args {:program "make" :args ["check"] :cwd "/p"}})
      ["make check" "/p"])
    (is (nil? (runnable-command {:kind "debugger"})))
    (is (nil? (runnable-command nil))))
  (test "a server command goes back to the server; a command it does not list is not sent"
    (let (conn (stand-in [nil])
          m (lensed conn
              {:executeCommandProvider {:commands ["run.test"]}}
              "fn t() {}\n"
              "/tmp/lens-run.rs"
              [(lens 0 "Run test" "run.test" 7) (lens 0 "Vendor" "vendor.thing")])
          [run vendor] (map/get-in m [:lsp-lenses "/tmp/lens-run.rs" :lenses]))
      ;; two lenses on the line: M-x lsp-code-lens-run offers a picker
      (is (:minibuffer (cmd-lsp-code-lens-run (ed-set-buf m (goto-char (ed-current-buf m) 0)) nil)))
      (let (ran (ed-lens-run m run)
            [kind request] (asked))
        (assert= kind (lsp-execute-command))
        (assert= request {:command "run.test" :arguments [7]})
        (deliver ran))
      (is (includes? (:echo (ed-lens-run m vendor))
            "vendor.thing is a client command bedit does not run"))
      (is (nil? (asked-within 200)))))
  (test "rust-analyzer's client commands: showReferences jumps, debug is said, a bad runnable said"
    (let (uri (lsp-protocol/lsp-path->uri "/tmp/lens-refs.rs")
          m (lensed (self)
              {}
              "struct S;\n\nimpl S {}\n"
              "/tmp/lens-refs.rs"
              [(lens 0
                 "1 implementation"
                 "rust-analyzer.showReferences"
                 uri
                 {:line 0 :character 7}
                 [{:uri uri :range {:start {:line 2 :character 5} :end {:line 2 :character 6}}}])
                (lens 0 "Debug" "rust-analyzer.debugSingle" {:kind "cargo"})
                (lens 0 "Run" "rust-analyzer.runSingle" {:kind "unknown"})])
          [references debug run] (map/get-in m [:lsp-lenses "/tmp/lens-refs.rs" :lenses])
          jumped (ed-lens-run m references))
      (assert= (buffer-current-line (ed-current-buf jumped)) 2)
      (is (includes? (:echo (ed-lens-run m debug)) "no debugger"))
      (is (includes? (:echo (ed-lens-run m run)) "nothing bedit knows how to run"))))
  (test "the lens under a cell of its row"
    (let (rope (text/string-> "  fn x\n")
          lenses [{:offset 2 :title "Run"} {:offset 2 :title "Debug"}])
      ;; `  Run | Debug`: the indentation and `Run |` are Run's, the rest Debug's
      (assert= (:title (lens-at-cell lenses rope 0 0)) "Run")
      (assert= (:title (lens-at-cell lenses rope 0 4)) "Run")
      (assert= (:title (lens-at-cell lenses rope 0 8)) "Debug")
      (assert= (:title (lens-at-cell lenses rope 0 40)) "Debug")
      (is (nil? (lens-at-cell lenses rope 1 0)))))
  (test "a click on a lens row runs that lens, a click on the text below it moves point"
    (let (conn (stand-in [nil])
          m (lensed conn
              {:executeCommandProvider {:commands ["run.main" "debug.main"]}}
              "x\nfn main() {}\n"
              "/tmp/lens-click.rs"
              [(lens 1 "Run" "run.main") (lens 1 "Debug" "debug.main")])
          layout (panes/ed-body-layout m 80 24)
          pane (seq/find (:panes layout) (fn (pane) (:selected pane)))
          buffer (ed-current-buf m))
      (is (not (nil? pane)))
      (when pane
        (let ([x y _w _h] (:rect pane)
              found (seq/find (range y (+ y 10))
                      (fn (row) (= (first (or (panes/ed-pane-inlay-row pane buffer row) [])) 1)))
              row (if (int? found) found -1)
              text-x (+ x (panes/ed-pane-gutter-width buffer pane)))
          (is (int? found))
          (assert= (panes/ed-pane-inlay-row pane buffer row) [1 "Run | Debug"])
          ;; on `Debug`
          (let (clicked (mouse/ed-mouse m [:mouse :press :left row (+ text-x 7) [] 1] 80 24)
                [kind request] (asked))
            (assert= kind (lsp-execute-command))
            (assert= (:command request) "debug.main")
            (deliver clicked))
          ;; the row below is the line's text: point moves there, nothing is run
          (let (moved (mouse/ed-mouse m [:mouse :press :left (inc row) (+ text-x 3) [] 1] 80 24))
            (assert= (buffer-point (ed-current-buf moved)) 5)
            (is (nil? (asked-within 200)))))))))

;; ---- a server asking the client to ask again ----------------------------------------
(describe "lsp: refresh requests"
  (test "the client says it takes them, and the client commands it runs"
    (let (caps (:capabilities (lsp/lsp-init-params "file:///p")))
      (assert= (map/get-in caps [:workspace :semanticTokens :refreshSupport]) true)
      (assert= (map/get-in caps [:workspace :inlayHint :refreshSupport]) true)
      (assert= (map/get-in caps [:workspace :codeLens :refreshSupport]) true)
      (is (includes? (map/get-in caps [:experimental :commands :commands])
            "rust-analyzer.runSingle"))
      (is (includes? (map/get-in caps [:experimental :commands :commands])
            "rust-analyzer.showReferences"))))
  (test "a refresh is answered null and handed on; a registration only answered"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          frames (str (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                   :id 5
                                                   :method "workspace/semanticTokens/refresh"}))
                   (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                :id 6
                                                :method "workspace/codeLens/refresh"}))
                   (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                :id 7
                                                :method "client/registerCapability"
                                                :params {:registrations []}})))
          [after replies] (lsp-protocol/lsp-ingest state frames))
      (is (empty? replies))
      (assert= (count (:outbox after)) 3)
      (is (includes? (first (:outbox after)) "\"id\":5"))
      (is (includes? (first (:outbox after)) "\"result\":null"))
      (assert= (:refreshes after) [:lsp-refresh-semantic-tokens :lsp-refresh-code-lens])))
  (test "semantic tokens: every buffer of that server on screen asked again, as a delta"
    (let (conn (stand-in [{:resultId "1" :data [0 3 4 0 1]}
                           {:resultId "2" :edits [{:start 4 :deleteCount 1 :data [0]}]}])
          caps {:semanticTokensProvider {:legend {:tokenTypes ["function"]
                                                  :tokenModifiers ["declaration"]}
                                         :full {:delta true}}}
          m (serving (ed-init (make-buffer "fn main() {}" "s.rs" "/tmp/sem-refresh.rs")) conn caps)
          asking (ed-semantic-request m)
          _ (asked)
          landed (deliver asking)
          _ (refute (ed-semantic-due? landed))
          refreshed (ed-ev-semantic-refresh landed [:lsp-refresh-semantic-tokens conn] nil 80 24)
          [kind request] (asked))
      ;; against the last answer, which the server keeps: it sends what changed
      (assert= kind (lsp-semantic-tokens-delta))
      (assert= (:previous-result-id request) "1")
      (assert= (:semantic-spans (ed-current-buf (deliver refreshed))) [[3 7 :syntax/function]])))
  (test "a server's `content modified` asks again, for what the idle beat asks by itself"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 9
                 :pending {3 [:me :lens (lsp-code-lens)]
                           4 [:me :definition (lsp-requests/lsp-definition)]}
                 :opened {}
                 :version 1}
          modified (fn (id)
                     (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                  :id id
                                                  :error {:code -32801 :message "content modified"}})))
          [_ replies] (lsp-protocol/lsp-ingest state (str (modified 3) (modified 4))))
      (is (includes? replies [:me [:lsp-code-lens :lens :lsp-retry]]))
      ;; a lookup the reader asked for gets its empty answer, said in its own voice
      (let (definition (seq/find replies (fn (reply) (= :lsp-definition (first (second reply))))))
        (is (not (nil? definition)))
        (refute (= :lsp-retry (nth (second definition) 2))))))
  (test "a retried code-lens answer makes the file due again"
    (let (conn (stand-in [nil])
          m (assoc (serving (ed-init (make-buffer "fn main() {}" "s.rs" "/tmp/lens-retry.rs"))
                     conn
                     {:codeLensProvider {}})
              :lsp-code-lens true)
          asking (ed-lens-request m)
          [kind _] (asked)
          _ (refute (ed-lens-due? asking))
          token (map/get-in asking [:lsp-lenses "/tmp/lens-retry.rs" :asked])
          retried (lsp-request-fold (merge kind {:path "/tmp/lens-retry.rs" :token token})
                    asking :lsp-retry))
      (is (ed-lens-due? retried))
      (deliver asking)))
  (test "semantic tokens: one ask at a time; a refresh meanwhile is asked once it lands"
    (let (conn (stand-in [{:resultId "1" :data [0 3 4 0 1]}])
          caps {:semanticTokensProvider {:legend {:tokenTypes ["function"]} :full {:delta true}}}
          m (serving (ed-init (make-buffer "fn main() {}" "s.rs" "/tmp/sem-flight.rs")) conn caps)
          asking (ed-semantic-request m)
          _ (asked)
          ;; typed while it is out: not due until the answer lands
          typed (semantic-follow (ed-set-buf asking
                                   (insert (goto-char (ed-current-buf asking) 0) " ")))
          _ (refute (ed-semantic-due? typed))
          refreshed (ed-ev-semantic-refresh typed [:lsp-refresh-semantic-tokens conn] nil 80 24)
          _ (is (nil? (asked-within 200)))
          landed (deliver refreshed))
      (is (ed-semantic-due? landed))))
  (test "semantic tokens: a refresh from another server asks nothing"
    (let (conn (stand-in [])
          caps {:semanticTokensProvider {:legend {:tokenTypes ["function"]} :full true}}
          m (serving (ed-init (make-buffer "fn main() {}" "s.rs" "/tmp/sem-other.rs")) conn caps))
      (ed-ev-semantic-refresh m [:lsp-refresh-semantic-tokens (self)] nil 80 24)
      (is (nil? (asked-within 200)))))
  (test "code lenses: asked again"
    (let (conn (stand-in [[(lens 0 "Run" "run")]])
          m (assoc (serving (ed-init (make-buffer "fn main() {}" "s.rs" "/tmp/lens-refresh.rs"))
                     conn
                     {:codeLensProvider {}})
              :lsp-code-lens true)
          refreshed (ed-ev-lens-refresh m [:lsp-refresh-code-lens conn] nil 80 24)
          [kind _] (asked))
      (assert= kind (lsp-code-lens))
      (assert= (wrap/inlay-lines (ed-current-buf (deliver refreshed))) {0 ["Run"]})))
  (test "inlay hints: the lines on screen asked again, the range ending inside the text"
    (let (conn (stand-in [[{:position {:line 0 :character 5} :label ": i32"}]])
          m (assoc (serving (ed-init (make-buffer "let x = 1;\n  y" "s.rs" "/tmp/inlay-refresh.rs"))
                     conn
                     {:inlayHintProvider true})
              :lsp-inlay-hints true)
          refreshed (lsp-commands/ed-ev-inlay-refresh m [:lsp-refresh-inlay-hints conn] nil 80 24)
          [kind request] (asked))
      (assert= kind (lsp-inlay-hints))
      (assert= (:lines request) [0 1])
      (assert= (:end-units request) 3)
      (assert= (map/get-in (lsp-request-params kind request) [:range :end]) {:line 1 :character 3})
      (assert= (map (inlinetext/annotations (ed-current-buf (deliver refreshed)))
                 (fn (hint) [(:at hint) (:text hint)]))
        '([5 ": i32"])))))

(describe "lsp inlay hints: the range and the buffer"
  (test "the range is cut to the text"
    (assert= (lsp-commands/inlay-range (text/string-> "ab\ncd") [0 48])
      {:lines [0 1] :end-units 2})
    (assert= (lsp-commands/inlay-range (text/string-> "a\nb\nc\n") [0 1])
      {:lines [0 1] :end-units nil})
    ;; a UTF-16 length past an emoji
    (assert= (:end-units (lsp-commands/inlay-range (text/string-> "a😀") [0 9])) 3))
  (test "an answer lands on the buffer of its file, current or not"
    (let (m (assoc (ed-init (make-buffer "a" "a.rs" "/tmp/inlay-a.rs")) :lsp-inlay-hints true)
          other (make-buffer "f(1)" "b.rs" "/tmp/inlay-b.rs")
          two (assoc m :buffers (conj (:buffers m) other))
          index (ed-buffer-index-by-file two "/tmp/inlay-b.rs")
          landed (lsp-commands/ed-apply-inlay-hints two
                   ["/tmp/inlay-b.rs" (buffer-rope other) [0 1]]
                   [{:line 0 :units 2 :text "x: "}]))
      (assert= (map (inlinetext/annotations (ed-buf-at landed (or index -1))) :text) '("x: "))
      ;; the current buffer untouched
      (assert= (inlinetext/annotations (ed-current-buf landed)) [])))
  (test "an older answer landing after a newer one is dropped, not painted over it"
    (let (conn (stand-in [[{:position {:line 0 :character 1} :label "old"}]
                           [{:position {:line 0 :character 2} :label "new"}]])
          m (assoc (serving (ed-init (make-buffer "f(1)" "s.rs" "/tmp/inlay-order.rs"))
                     conn
                     {:inlayHintProvider true})
              :lsp-inlay-hints true)
          twice (lsp-commands/ed-inlay-request-at (lsp-commands/ed-inlay-request-at m 0 conn [0 1])
                  0
                  conn
                  [0 1])
          _ (asked)
          _ (asked)
          first-reply (receive ((and reply [:lsp-inlay-hints _ _]) reply) (after 2000 nil))
          second-reply (receive ((and reply [:lsp-inlay-hints _ _]) reply) (after 2000 nil))
          ;; the newer lands first, then the older
          landed (lsp-commands/ed-ev-lsp-reply (lsp-commands/ed-ev-lsp-reply twice
                                                 second-reply nil 80 24)
                   first-reply nil 80 24))
      (assert= (map (inlinetext/annotations (ed-current-buf landed)) :text) '("new"))))
  (test "the buffers a server shows"
    (let (m (serving (ed-init (make-buffer "x" "s.rs" "/tmp/shown.rs")) (self) {}))
      (assert= (ed-lsp-shown m (self)) [[0 0]])
      (assert= (ed-lsp-shown m :someone-else) []))))
