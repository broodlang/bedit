# The project's conventions.
# ^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
root = true
# ^^ keyword

[*]
# ^ definition
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true

[*.{go,mk}]
indent_style = tab

; a semicolon comment
# ^^^^^^^^^^^^^^^^^^^ comment
[Makefile]
indent_style = tab
