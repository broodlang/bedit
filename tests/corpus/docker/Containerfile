# syntax=docker/dockerfile:1
# ^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
ARG VERSION=1.2
FROM rust:${VERSION} AS build
# ^^ keyword         ^^ keyword
#    ^^^^ function      ^^^^^ function
#        ^^^^^^^^^^^ special
WORKDIR /src
ENV PATH="/x:$PATH" \
    MODE=release
    # ^^ special
COPY --from=deps /a /b
#    ^^^^^^^^^^^ special
RUN apt-get update \
    && apt-get install -y curl \
    && rm -rf /var/lib/apt/lists/*
    #  ^^ function
RUN <<EOT
  echo kept as written
EOT
EXPOSE 8080/tcp
#      ^^^^^^^^ number
CMD ["app", "--port", "8080"]
#           ^^^^^^^^ string
