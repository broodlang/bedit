;; gitignore/dot.gitignore — the faces its mode paints. Rewrite with (corpus/write-golden ["gitignore"]) and review the diff.
1:0 "# Build output" comment
3:7 "/" definition|function
4:0 "*" keyword|symbol
6:0 "!" constant|special
9:0 "# Dependencies" comment
10:0 "**" keyword|symbol
11:4 "?" keyword|symbol
11:6 "[ch]" keyword|symbol
12:4 "\\#" string
14:5 "*" keyword|symbol
