;; env/dot.env — the faces its mode paints. Rewrite with (corpus/write-golden ["env"]) and review the diff.
1:0 "# Local settings, never committed." comment
3:0 "DATABASE_URL" definition|function
5:0 "export" keyword|symbol
5:7 "SECRET_KEY" definition|function
5:18 "'not-a-secret'" string
7:0 "PORT" definition|function
8:0 "DEBUG" definition|function
9:0 "GREETING" definition|function
9:9 "\"hello ${USER}\"" string
11:0 "EMPTY" definition|function
