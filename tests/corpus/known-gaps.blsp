;; The corpus's known gaps (src/corpus.blsp, "the known gaps: a ratchet"): the lines a
;; line check finds wrong that the language's indenter or restart cannot get right yet, each
;; with why. A check fails on a line NOT listed here, and on a listed line that now passes — so
;; fixing a gap means deleting its lines, and the list only shrinks. Lines count from 1, as the
;; check's messages say them. `{:off why}` turns a check off for a sample it cannot apply to.
;;
;; The typing check builds the buffer a line at a time with nothing after point, so the block a
;; line opens is still unclosed when the next is typed (as with electric pairs off, or a line
;; pasted into the middle of a file). The std tree-sitter indenter reads what is still open off
;; that broken parse's tokens (brood ADR-762: the delimiters, and a language's keyword `:pairs`).
;; What is left: a `case`/`default:` label, reindented as its `:` is typed (`:electric-indent`),
;; lands where the half-typed parse puts an unclosed `switch`'s label (never column 0 while a bracket
;; is open: `indent/ed-electric-reindent`), and the line below follows
;; it; and a line whose own first characters decide its indentation (`.trimIndent()` continuing a
;; chain, a closing tag) is decided by text RET cannot see yet.
{"c/wordcount.c" {:typing {:why "the line below a `case`/`default:` label in an unclosed `switch` stays at the label's column: the half-typed parse puts no block under it"
                           :lines [20 23]}}
 "cpp/shapes.cpp" {:typing {:why "a `case`/`default:` label typed into an unclosed `switch` is reindented (`:electric-indent`) where the half-typed parse puts it, and the line below follows it, an access label too"
                            :lines [12 19 28]}}
 "csharp/Greeter.cs" {:typing {:why "a `case`/`default:` label typed into an unclosed `switch` is reindented (`:electric-indent`) where the half-typed parse puts it, and the line below follows it"
                               :lines [27 29 30]}}
 "go/server.go" {:typing {:why "the line below a `case`/`default:` label in an unclosed `switch` stays at the label's column: the half-typed parse puts no block under it"
                          :lines [22 25]}}
 "heex/page.html.heex" {:typing {:why "a tag opened below an unclosed one: the grammar's recovery keeps no element"
                                 :lines [12 14 16 17 20]}}
 "html/index.html" {:typing {:why "an attribute continued below an unclosed `<img`" :lines [20]}}
 "java/Greeter.java" {:typing {:why "a `case`/`default:` label typed into an unclosed `switch` is reindented (`:electric-indent`) where the half-typed parse puts it, and the line below follows it"
                               :lines [41 42 43]}}
 "javascript/cart.js" {:typing {:why "a `case`/`default:` label typed into an unclosed `switch` is reindented (`:electric-indent`) where the half-typed parse puts it, and the line below follows it"
                                :lines [18 20 21]}}
 "kotlin/Greeter.kt" {:typing {:why "a chain continued on the next line (`.trimIndent()`) and the lines below a value continued after `=`"
                               :lines [73 85 87]}}
 "markdown/notes.md" {:restart {:why "a lead-in cut inside a fence: the restart counts fence lines from the cut, so the closing `~~~` reads as an opener and the window below paints as code"
                                :lines [28]}}
 "python/worker.py" {:reindent {:off "Python's indentation is its syntax: with it stripped nothing can say where a block ends"}
                     :typing {:off "Python's indentation is its syntax: RET cannot know that the next line leaves the block"}}
 "ruby/worker.rb" {:reindent {:why "an `if`'s `else` in a method that also has a `rescue` clause holds as written but re-indents a level deep from scratch"
                              :lines [45]}}
 "scala/Greeter.scala" {:reindent {:off "Scala 3's optional braces make indentation syntax: with it stripped the parse changes"}
                        :typing {:off "Scala 3's optional braces make indentation syntax: RET cannot know that the next line leaves the block"}}
 "shell/deploy.sh" {:typing {:why "unclosed `case` arms while typing: `;;` and a pattern are no electric word"
                             :lines [33 35 36]}}
 "shell/release.sh" {:typing {:why "unclosed `case` arms while typing, and a line below a comment that ends a pipe's continuation takes the comment's column"
                              :lines [42 54 56 57]}}
 "tsx/Counter.tsx" {:typing {:why "unclosed JSX elements while typing" :lines [12]}}}
