;; The corpus's known gaps (tests/support/corpus.blsp, "the known gaps: a ratchet"): the lines a
;; line check finds wrong that the language's indenter or restart cannot get right yet, each
;; with why. A check fails on a line NOT listed here, and on a listed line that now passes — so
;; fixing a gap means deleting its lines, and the list only shrinks. Lines count from 1, as the
;; check's messages say them. `{:off why}` turns a check off for a sample it cannot apply to.
;;
;; The typing check builds the buffer a line at a time with nothing after point, so the block a
;; line opens is still unclosed when the next is typed (as with electric pairs off, or a line
;; pasted into the middle of a file): most of its gaps are the std tree-sitter indenter
;; (`editor/treesit/indent-column`) on that broken parse — RET after an unclosed `{`, `(` or `[`
;; lands a level short; a `case`/`default:` label, which no `:electric-indent` names, stays at
;; the level RET gave it; and a continuation line (a value after `=`) is decided by text RET
;; cannot see yet.
{"c/wordcount.c" {:typing {:lines [6 14 20 22 23]
                           :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "cpp/shapes.cpp" {:typing {:lines [12 18 19 25 26 28]
                            :why "unclosed blocks while typing; an access label and `case` are no electric word"}}
 "csharp/Greeter.cs" {:typing {:lines [27 29 30 31]
                               :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "docker/Containerfile" {:typing {:lines [16]
                                  :why "a `\\` continuation typed below another: the second continued line goes a level deeper"}}
 "css/site.css" {:typing {:lines [21]
                          :why "a value continued on the next line inside an unclosed rule"}}
 "elixir/greeter.ex" {:typing {:lines [20 21 22 28 31 33 34 35 39]
                               :why "unclosed `do` blocks and `->` clauses while typing"}}
 "go/server.go" {:typing {:lines [5 22 24 25 32 33 39]
                          :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "heex/page.html.heex" {:indent {:lines [13 15 16 17 18 19]
                                 :why "the content of an `<%= if … do %>` … `<% end %>` block is not indented"}
                        :reindent {:lines [13 15 16 17 18 19] :why "as :indent"}
                        :typing {:lines [10 12 13 14 15 16 17 18 19 20 22]
                                 :why "unclosed tags while typing, and the `do` blocks as :indent"}}
 "html/index.html" {:typing {:lines [8 9 11 12 14 15 16 17 19 20 22]
                             :why "unclosed elements while typing"}}
 "java/Greeter.java" {:typing {:lines [41 42 43 46 55]
                               :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "javascript/cart.js" {:typing {:lines [9 13 17 18 20 21 22 29 30]
                                :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "julia/shapes.jl" {:typing {:lines [43 46 50 61 64 72 75 77 91] :why "unclosed blocks while typing"}}
 "kotlin/Greeter.kt" {:typing {:lines [66 73 82 85 87 93 101]
                               :why "unclosed blocks while typing; a `when` and a chain continued on the next line"}}
 "lisp/words.lisp" {:indent {:lines [34 35]
                             :why "a backquoted form's body indents from the form around the backquote: std `sexp/enclosing` does not descend through a reader-macro wrapper"}
                    :reindent {:lines [34 35] :why "as :indent"}
                    :typing {:lines [34 35] :why "as :indent"}}
 "lua/greeter.lua" {:typing {:lines [25 29 32 37 42 43 46 49 50 70]
                             :why "unclosed `function`/`if` blocks and tables while typing"}}
 "php/Greeter.php" {:typing {:lines [56 57 58 61 69]
                             :why "unclosed blocks while typing; `case`/`default:` are no electric word"}}
 "python/worker.py" {:reindent {:off "Python's indentation is its syntax: with it stripped nothing can say where a block ends"}
                     :typing {:off "Python's indentation is its syntax: RET cannot know that the next line leaves the block"}}
 "r/summary.R" {:typing {:lines [34 45 52 54] :why "unclosed blocks and calls while typing"}}
 "ruby/worker.rb" {:indent {:lines [50]
                            :why "a `rescue` clause in a `def` body indents its statements a level too deep"}
                   :reindent {:lines [45 50]
                              :why "as :indent, and the `else` of an `if` in such a method"}
                   :typing {:lines [27 30 35 37 40 41 42 45 46 47 51 54 57 58]
                            :why "unclosed `do`/`def`/`if` blocks while typing"}}
 "rust/counter.rs" {:typing {:lines [16 19 28 31 32 34 42 46 49 56]
                             :why "unclosed blocks while typing; a `match` arm's body"}}
 "scala/Greeter.scala" {:reindent {:off "Scala 3's optional braces make indentation syntax: with it stripped the parse changes"}
                        :typing {:off "Scala 3's optional braces make indentation syntax: RET cannot know that the next line leaves the block"}}
 "shell/deploy.sh" {:typing {:lines [33 35 36 38]
                             :why "unclosed `case` arms while typing: `;;` and a pattern are no electric word"}}
 "shell/release.sh" {:typing {:lines [24 36 38 42 54 56 57 59 68]
                              :why "`then` on its own line, `\\` continuations and a pipe continued, unclosed blocks while typing"}}
 "tsx/Counter.tsx" {:typing {:lines [12 13] :why "unclosed JSX elements while typing"}}
 "typescript/store.ts" {:typing {:lines [18 35 36 45 51 58] :why "unclosed blocks while typing"}}}
