<%!-- the page header --%>
<%!-- ^^^^^^^^^^^^^^^^^^^^ comment --%>
<header class="top">
  <%!-- ^^^^^ special --%>
  <%!--       ^^^^^ string --%>
  <h1><%= @title %></h1>
  <.link navigate={~p"/"} class="home">Home</.link>
   <%!-- <- function --%>
  <%!--  ^^^^^^^^ special --%>
</header>
<main>
  <%= if @items == [] do %>
    <p>Nothing yet.</p>
  <% else %>
    <ul>
      <li :for={item <- @items} id={"item-#{item.id}"}>
        {item.name}
      </li>
    </ul>
  <% end %>
  <%= case @status do %>
    <% :ok -> %>
      <p>
        All is well, and
        else nothing to say.
      </p>
    <% _ -> %>
      <p>Trouble.</p>
  <% end %>
  <.button phx-click="refresh" disabled={false}>Refresh</.button>
</main>
