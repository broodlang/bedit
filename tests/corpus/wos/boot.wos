;; Print a greeting on the serial port, then stop.
;; ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
(program boot
  ;; ^^^ special
  (const port 1016)
  ;; ^^^ special
  ;;          ^^^^ number
  (var i 0)
  ;; ^ special
  (data greeting (asciz "hello"))
  ;;                    ^^^^^^^ string
  (loop
    (when-zero (load8 (addr greeting i))
      ;; ^^^^^ special
      (break))
    (out8 port (load8 (addr greeting i)))
    (set i (+ i 1)))
  (halt))
  ;; ^^ special
