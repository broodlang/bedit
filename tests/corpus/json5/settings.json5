// Editor settings, JSON5 style.
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ comment
{
  theme: 'dark',
  fontSize: 14,
  //        ^^ number
  ratio: 1.5,
  hex: 0x1F,
  //   ^ number
  wrap: true,
  //    ^^^^ constant
  ruler: null,
  //     ^^^^ constant
  /* a block comment */
  plugins: ['lint', 'format',],
  nested: {
    depth: 2,
  },
}
