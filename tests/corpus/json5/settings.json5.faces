;; json5/settings.json5 — the faces its mode paints. Rewrite with `nest run tools/corpus-golden.blsp -- json5` and review the diff.
1:0 "// Editor settings, JSON5 style." comment
4:2 "theme:" keyword|symbol
4:9 "'dark'" string
7:2 "fontSize:" keyword|symbol
7:12 "14" number
9:2 "ratio:" keyword|symbol
9:9 "1.5" number
10:2 "hex:" keyword|symbol
10:7 "0x1F" number
12:2 "wrap:" keyword|symbol
12:8 "true" constant|special
14:2 "ruler:" keyword|symbol
14:9 "null" constant|special
16:2 "/* a block comment */" comment
18:2 "plugins:" keyword|symbol
18:12 "'lint'" string
18:20 "'format'" string
19:2 "nested:" keyword|symbol
20:4 "depth:" keyword|symbol
20:11 "2" number
