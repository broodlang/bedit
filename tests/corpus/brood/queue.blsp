;; A first-in, first-out queue over two lists: values are pushed on the back and popped from
;; the front, the back reversed onto the front when the front runs out.

(def empty-queue {:front '() :back '()})
;;^^ special
;;   ^^^^^^^^^^^ definition
;;                ^^^^^^ keyword

(def default-limit 64)
;;                 ^^ number

(defn push (queue value)
  "`queue` with `value` at its back."
  (assoc queue :back (cons value (:back queue))))

(defn pop (queue)
  "`[value queue']`: the front of `queue` and the rest of it, or nil when it is empty."
  (let (front (:front queue))
    (cond
      (not (empty? front)) [(first front) (assoc queue :front (rest front))]
      (empty? (:back queue)) nil
      else (pop {:front (reverse (:back queue)) :back '()}))))

(defn drain (queue)
  ;; every value in `queue`, front first
  (letrec (walk (fn (rest-queue acc)
                  (let (popped (pop rest-queue))
                    (if (nil? popped)
                      (reverse acc)
                      (walk (second popped) (cons (first popped) acc))))))
    (walk queue '())))
;;   ^^^^ function
;;        ^^^^^ plain

(drain (push (push empty-queue 1) "two"))
;;            ^^^^ function
;;                             ^ number
;;                                ^^^^^ string
