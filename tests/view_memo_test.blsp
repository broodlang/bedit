;; Tests for the per-line render memo (ADR-336 applied to `ed-visible-lines`).
;;
;; The regression these pin: every visible row is a memoised fragment whose deps name what
;; its ops read. Handing each row the WHOLE pane's bracket/diagnostic override list made
;; `overrides` a dep that changed whenever any of them did — and the bracket half changes
;; on every cursor move — so one `C-n` invalidated all forty-nine rows and the memo cost
;; more than it saved (`view` 2.92 ms all-hit, 6.53 ms after a motion, 5.62 ms with no memo
;; at all; `tools/profile-turn.blsp`). Grouped per line, a row's dep is only what lands on
;; that row.
(defmodule view-memo-test
  (:use model)
  (:use view)
  (:use editor/buffer)
  (:use-internals input) ; ed-ensure-layers — a buffer needs its mode layers to paint
  (:use isearch :only [])
  (:use spell :only [])
  (:use whitespace :only [])
  (:use test))
;; `editor/ui/*memo*` (the previous turn's fragment table) is earmuffed, so it is ambient rather
;; than namespaced — `view`'s own `(:use editor/ui)` is what puts it in the image.

(defn vm-rope (text) (buffer-rope (make-buffer text)))

(defn vm-markers (buf overrides prev)
  "The `[:ui/memo key deps ops reused?]` markers `ed-visible-lines` emits for the first 3 rows of
`buf`, rendered with the previous turn's memo table `prev` in scope."
  (binding (editor/ui/*memo* prev)
    (panebody/ed-visible-lines buf 0 3 0 0 40 '() nil overrides 0 true nil)))

(defn vm-table (markers)
  "The markers as the table the next turn reads — `{key -> [deps ops]}`."
  (fold markers {} (fn (acc mk) (assoc acc (nth mk 1) [(nth mk 2) (nth mk 3)]))))

(defn vm-deps (markers key) (first (get (vm-table markers) key)))

(describe "ed-overrides-by-line"
  (test "groups flat [pos face] overrides by the line each position falls on"
    (let (rope (vm-rope "abc\ndef\nghi") ; lines start at 0, 4, 8
          by-line (spanpaint/ed-overrides-by-line rope
                    (list [1 {:bold true}] [5 {:bold true}] [6 {:bold true}])))
      (assert= (list 1) (map (get by-line 0) first))
      (assert= (list 5 6) (map (get by-line 1) first))
      (is (nil? (get by-line 2)))))
  (test "an empty override list groups to an empty map"
    (assert= {} (spanpaint/ed-overrides-by-line (vm-rope "abc") '())))
  (test "a line's entries keep their input order — the tiler merges later-wins"
    ;; the bracket face is appended before the diagnostic one, so a diagnostic underline
    ;; on the same character must still come second
    (let (rope (vm-rope "abc")
          by-line (spanpaint/ed-overrides-by-line rope
                    (list [1 {:bg "#bracket"}] [1 {:underline true}])))
      (assert= (list {:bg "#bracket"} {:underline true}) (map (get by-line 0) second)))))

(describe "ed-visible-lines — the per-line memo"
  (test "a row with no overrides keeps its deps when an override moves to another line"
    (let (buf (make-buffer "aaa\nbbb\nccc")
          face {:bg "#f00"}
          ;; the same override on line 1, then on line 2 — a bracket pair moving under the
          ;; cursor, which is what a plain motion does
          before (vm-markers buf {1 (list [4 face])} {})
          after (vm-markers buf {2 (list [8 face])} (vm-table before)))
      ;; the untouched row: same deps, so the memo hits and its ops are reused
      (assert= (vm-deps before [:line 0 0]) (vm-deps after [:line 0 0]))
      ;; the two rows the override left and arrived on: deps differ, so they re-render
      (is (not (= (vm-deps before [:line 0 1]) (vm-deps after [:line 0 1]))))
      (is (not (= (vm-deps before [:line 0 2]) (vm-deps after [:line 0 2]))))))
  (test "a row's deps carry only its own overrides, never the whole pane's"
    ;; rebased to the row's first character (offset 4 is line 1's first): a row's deps are
    ;; its content, so the same override on a line that moved still compares equal
    (let (buf (make-buffer "aaa\nbbb\nccc")
          face {:bg "#f00"}
          markers (vm-markers buf {1 (list [4 face])} {}))
      (is (not (includes? (vm-deps markers [:line 0 0]) (list [0 face]))))
      (is (includes? (vm-deps markers [:line 0 1]) (list [0 face])))))
  (test "a row whose text and faces are unchanged keeps its deps when an edit shifts it"
    ;; typing on line 0 moves every later line's offsets; the rows below must still hit
    (let (before-buf (make-buffer "aaa\nbbb\nccc")
          after-buf (make-buffer "aaaX\nbbb\nccc")
          before (vm-markers before-buf {} {})
          after (vm-markers after-buf {} (vm-table before)))
      (is (not (= (vm-deps before [:line 0 0]) (vm-deps after [:line 0 0]))))
      (assert= (vm-deps before [:line 0 1]) (vm-deps after [:line 0 1]))
      (assert= (vm-deps before [:line 0 2]) (vm-deps after [:line 0 2]))))

  (test "an empty override list on a line leaves that row with none"
    (let (buf (make-buffer "aaa\nbbb")
          markers (vm-markers buf {} {}))
      (is (not (nil? (vm-deps markers [:line 0 0])))))))

;; ---- a stale override must never kill the frame ----------------------------
;; Reported from the Elixir playground while adding a function:
;;   render error: %rope-char->line: index 179 out of bounds (valid 0..=178)
;; `ed-overrides-by-line` resolved every override's position with `text/char->line`, which
;; RAISES out of range. Overrides come from state that can lag the text by a keystroke — a
;; diagnostic computed against the previous version, a note anchored before an edit
;; shortened the buffer — so out-of-range is a normal transient, not an invariant breach.
;; Raising there replaced the whole editor with one red line.

(describe "overrides that fell off the end cost an underline, not the frame"
  (test "a position past the end of the rope is dropped"
    (let (rope (buffer-rope (make-buffer "abc")))
      (assert= (spanpaint/ed-overrides-by-line rope [[99 {:fg "#fff"}]]) {})))
  (test "a position exactly at the end is dropped — there is no character there"
    (let (rope (buffer-rope (make-buffer "abc")))
      (assert= (spanpaint/ed-overrides-by-line rope [[3 {:fg "#fff"}]]) {})))
  (test "a negative position is dropped"
    (let (rope (buffer-rope (make-buffer "abc")))
      (assert= (spanpaint/ed-overrides-by-line rope [[-1 {:fg "#fff"}]]) {})))
  (test "the in-range overrides around a stale one still land"
    (let (rope (buffer-rope (make-buffer "ab\ncd"))
          by-line (spanpaint/ed-overrides-by-line rope
                    [[0 {:fg "#1"}] [999 {:fg "#2"}] [3 {:fg "#3"}]]))
      (assert= (count (get by-line 0)) 1)
      (assert= (count (get by-line 1)) 1)))
  (test "order within a line is preserved, so later overrides still win"
    (let (rope (buffer-rope (make-buffer "abc"))
          row (get (spanpaint/ed-overrides-by-line rope [[0 {:fg "#1"}] [0 {:fg "#2"}]]) 0))
      (assert= (map row second) (list {:fg "#1"} {:fg "#2"})))))

;; ---- the span band, sliced per line -----------------------------------------------
;; A terminal buffer's history is one band of forty thousand faces, and the pane shows
;; its last thirty lines: reaching the first visible span must not mean walking past
;; every one before it, every frame.

(describe "spanpaint/ed-spans-by-line"
  (test "groups a band's spans by the line each covers, over the viewport only"
    (let (buf (editor/buffer/make-buffer "aa\nbb\ncc\ndd" "x")
          spans [[0 2 {:fg :red}] [3 5 {:fg :green}] [6 8 {:fg :blue}] [9 11 {:fg :cyan}]]
          by-line (spanpaint/ed-spans-by-line buf spans 2 3))
      (assert= (sort (keys by-line)) (list 2 3))
      (assert= (get by-line 2) (list [6 8 {:fg :blue}]))))
  (test "a span straddling two lines appears on both"
    (let (buf (editor/buffer/make-buffer "aa\nbb" "x")
          by-line (spanpaint/ed-spans-by-line buf [[1 4 {:fg :red}]] 0 1))
      (assert= (get by-line 0) (list [1 4 {:fg :red}]))
      (assert= (get by-line 1) (list [1 4 {:fg :red}]))))
  (test "a viewport deep in a long band starts at its own first span"
    ;; 10 000 one-char lines, each faced; the pane shows lines 9 990–9 999
    (let (text (string/join (map (range 10000) (fn (_i) "x")) "\n")
          buf (editor/buffer/make-buffer text "x")
          spans (into [] (map (range 10000) (fn (i) [(* 2 i) (inc (* 2 i)) {:fg :red}])))
          by-line (spanpaint/ed-spans-by-line buf spans 9990 9999))
      (assert= (count by-line) 10)
      (assert= (get by-line 9990) (list [19980 19981 {:fg :red}]))))
  (test "span sources are sliced apart and joined per line, the earlier source first"
    (let (buf (editor/buffer/make-buffer "aa\nbbbb\ncc" "x")
          history [[0 2 {:fg :red}] [3 4 {:fg :red}]]
          screen [[5 7 {:fg :blue}] [8 10 {:fg :green}]]
          by-line (spanpaint/ed-spans-by-line buf (spanpaint/ed-span-sources [history screen]) 0 2))
      (assert= (get by-line 0) (list [0 2 {:fg :red}]))
      (assert= (get by-line 1) (list [3 4 {:fg :red}] [5 7 {:fg :blue}]))
      (assert= (get by-line 2) (list [8 10 {:fg :green}]))
      ;; the same answer as the one joined band
      (assert= by-line (spanpaint/ed-spans-by-line buf (into history screen) 0 2)))))

;; ---- the pane and body fragments around the rows ------------------------------------
;; Each pane's non-blinking layers are one memoised fragment, its text body another inside
;; it, the rows inside that (`ed-pane-layers`, `ed-pane-text-ops`). Two things must hold:
;; a fragment reused whole still hands its INNER fragments to the next turn (or the turn
;; after a hit would find no rows and repaint them all), and no transition paints a stale
;; frame — the frame drawn with the previous turn's table equals the one drawn fresh. A dep
;; left out of either fragment fails the second.

(def- vm-cols 100)
(def- vm-rows 24)

(defn- vm-text ()
  (string/join
    (map (range 60)
      (fn (i)
        (cond
          (= 0 (math/mod i 3)) (str "(defn f-" i " (x) (+ x " i "))")
          ;; long enough to wrap, and to scroll sideways
          (= 4 i) (str "  ;; " (string/repeat "wide " 40))
          else (str "  ;; line " i))))
    "\n"))

(defn- vm-model ()
  "A brood-mode model — syntax spans, the bracket pair and diagnostic underlines all paint."
  (input/ed-ensure-layers (ed-init (editor/layers/set-buffer-type (make-buffer (vm-text)
                                                                    "memo.blsp")
                                     :brood))))

(defn- vm-press (m keys) (fold keys m (fn (acc k) (input/ed-update acc k vm-cols vm-rows))))

(defn- vm-harvest (m table)
  "`[frame next-table]` for `m` drawn with the previous turn's `table` in scope."
  (editor/ui/ui-harvest (binding (editor/ui/*memo* table) (ed-view m vm-cols vm-rows))))

(defn- vm-steady-table (m)
  "The table after two turns on `m` — the second all hits, so its entries are what a HIT
handed on."
  (second (vm-harvest m (second (vm-harvest m {})))))

(defn- vm-stale? (before after)
  "Whether `after`, drawn with `before`'s steady table, differs from `after` drawn fresh."
  (not (= (first (vm-harvest after (vm-steady-table before))) (ed-view after vm-cols vm-rows))))

(defn- vm-stale-without? (source before after)
  "Whether the transition goes stale with `source`'s `:deps` taken away: that the row's deps are
what stops it, and so that a test passing with them proves something. It takes the row off the
shared registry while it draws, so its callers' group is `:isolated`: run alongside, it changed
every other test's pane key (a source's `:deps` vanishing mid-draw) and theirs changed its."
  (let (row (registry/lookup :model/highlight-sources source))
    (do
      (registry/put :model/highlight-sources source (dissoc row :deps))
      (let (stale (vm-stale? before after))
        (registry/put :model/highlight-sources source row)
        stale))))

(describe "the pane and body fragments"
  (test "a turn where every fragment hits hands the rows inside them to the next table"
    (let (m (vm-model)
          table (vm-steady-table m)
          kinds (into #{} (map (keys table) first)))
      (is (contains? kinds :pane))
      (is (contains? kinds :body))
      (is (contains? kinds :line))))
  (test "an open M-x list is one fragment, handed on by a turn that hits"
    (is (contains? (vm-steady-table (vm-press (vm-model) [:alt-x "k" "i"])) [:plume])))
  (test "an all-hit turn paints the frame a fresh render does"
    (let (m (vm-model))
      (assert= (first (vm-harvest m (vm-steady-table m))) (ed-view m vm-cols vm-rows))))
  (test "no transition paints a stale frame"
    (let (m (vm-model)
          marked (vm-press m [(keyword "ctrl- ") :ctrl-n :ctrl-n])
          split (vm-press m [:ctrl-x "3"])
          mid (vm-press m [:ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n])
          plain (input/ed-ensure-layers (ed-init (make-buffer (vm-text) "memo.txt")))
          ;; M-x open: Plume's list is one memoised fragment
          prompt (vm-press m [:alt-x "k" "i"])
          transitions [["C-n" m (vm-press m [:ctrl-n])]
                        ["C-v" m (vm-press m [:ctrl-v])]
                        ["typing" m (vm-press m [:ctrl-n :ctrl-e "x" "("])]
                        ["region grows" marked (vm-press marked [:ctrl-n :ctrl-f])]
                        ["region cancelled" marked (vm-press marked [:ctrl-g])]
                        ["spinner tick" m (vm-press m [[:timer :spinner]])]
                        ["isearch" m (vm-press m [:ctrl-s "f" "-"])]
                        ["split" m split]
                        ["type beside an idle pane" split (vm-press split ["z"])]
                        ["switch panes" split (vm-press split [:ctrl-x "o"])]
                        ["wrap on"
                          m
                          (ed-set-buf-at m
                            (ed-current-index m)
                            (assoc (ed-current-buf m) :long-lines :wrap))]
                        ["terminal" m (dissoc m :gui)]
                        ;; one dep alone: the viewport, the side scroll, the spans (a buffer-only
                        ;; write: `ed-set-buf` would also move the pane's cached point)
                        ["top only" mid (dissoc (ed-set-top mid 2) :_lc)]
                        ["typing without a mode" plain (vm-press plain [:ctrl-e "x"])]
                        ["hscroll only" m (dissoc (scroll/ed-set-hscroll m 4) :_lc)]
                        ["spans only"
                          m
                          (ed-set-buf-at m
                            (ed-current-index m)
                            (assoc (ed-current-buf m) :face-spans [[0 40 {:fg "#ff0000"}]]))]
                        ["diagnostics arrive"
                          m
                          (diagstore/ed-set-diagnostics m
                            [{:line 3 :col 2 :message "boom"}]
                            (buffer-rope (ed-current-buf m))
                            "elsewhere")]
                        ["overlay"
                          m
                          (assoc m :overlays [{:start 10 :end 30 :face {:bg "#123456"}}])]
                        ;; a history of faces kept apart from the screen's (a terminal's)
                        ["history spans"
                          m
                          (ed-set-buf-at m
                            (ed-current-index m)
                            (assoc (ed-current-buf m)
                              :history-spans [[0 10 {:fg "#00ff00"}]]
                              :face-spans [[12 20 {:fg "#ff0000"}]]))]
                        ["plume: open" m prompt]
                        ["plume: narrow" prompt (vm-press prompt ["l"])]
                        ["plume: select" prompt (vm-press prompt [:down])]
                        ["plume: spinner tick" prompt (vm-press prompt [[:timer :spinner]])]])
      ;; the names of the stale ones, so a failure says which transition it was
      (assert= []
        (into []
          (seq/keep transitions (fn ([name before after]) (when (vm-stale? before after) name))))))))

(describe "the pane and body fragments across a resize"
  (test "a narrower window drawn with the wider one's table paints the fresh frame"
    ;; the pane keeps its origin and loses columns: only the WIDTH tells the fragments apart
    (let (m (vm-model)
          table (vm-steady-table m)
          narrow (- vm-cols 30))
      (assert= (ed-view m narrow vm-rows)
        (first (editor/ui/ui-harvest (binding (editor/ui/*memo* table)
                                       (ed-view (dissoc m :_lc) narrow vm-rows))))))))

(describe "the pane fragment's model-side deps, each moved alone"
  (test "no change to what a pane reads from the model paints a stale frame"
    (let (m (vm-press (vm-model) [:ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n]))
      (let (pane (first (:panes (panes/ed-body-layout m vm-cols vm-rows)))
            path (:path pane)
            id (map/get-in pane [:payload :buffer])
            rope (buffer-rope (ed-current-buf m))
            ;; findings named for ANOTHER buffer leave this one un-annotated, so only the
            ;; model's `:diag-rope` / `:diag-by-line` move
            diagnosed (diagstore/ed-set-diagnostics m
                        [{:line 8 :col 2 :message "boom"}]
                        rope
                        "elsewhere")
            shared (map/assoc-in m
                     [:hosted id]
                     {:cursors {:p1 120} :names {:p1 "ann"} :tag-ttl {:p1 3}})
            spans (map/get-in m [:span-cache path])
            gutter (map/get-in m [:gutter-cache path])
            transitions [["diagnostics" m diagnosed]
                          ["diag-rope only" diagnosed (assoc diagnosed :diag-rope nil)]
                          ["diag-by-line only" (assoc diagnosed :diag-by-line {}) diagnosed]
                          ["hl-line" m (assoc m :hl-line (not (:hl-line m)))]
                          ["link hover" m (assoc m :link-hover {:buffer id :line 8})]
                          ["remote caret" m shared]
                          ["remote caret, gui" shared (assoc shared :gui true)]
                          ["span-cache entry"
                            m
                            (map/assoc-in m
                              [:span-cache path]
                              (assoc spans :spans [[0 400 {:fg "#ff0000"}]]))]
                          ["gutter-cache entry"
                            m
                            (map/assoc-in m
                              [:gutter-cache path]
                              (assoc gutter :cells (into [] (reverse (:cells gutter)))))]])
        (assert= []
          (into []
            (seq/keep transitions (fn ([name before after]) (when (vm-stale? before after) name)))))))))

;; A highlight source's inputs off the buffer are in the pane's memo through its `:deps`: a
;; source that left one out would paint the last frame's ranges until the buffer changed.
(describe "a highlight source's input repaints the pane"
  :isolated (test "turning :show-whitespace on repaints the same text"
    (let (m (input/ed-ensure-layers (ed-init (make-buffer "tab\there   \nline\n" "n.txt" "n.txt"))))
      (is (vm-stale-without? :whitespace m (assoc m :show-whitespace true)))
      (is (not (vm-stale? m (assoc m :show-whitespace true))))))

  :isolated (test "turning :nobreak-char-display off repaints the same text"
    (let (m (input/ed-ensure-layers (ed-init (make-buffer "a\u{a0}b\n" "n.txt" "n.txt"))))
      (is (vm-stale-without? :glyphless m (assoc m :nobreak-char-display false)))
      (is (not (vm-stale? m (assoc m :nobreak-char-display false))))))

  (test "turning :fill-column-indicator on repaints the same text (a pane layer's :deps)"
    (let (m (input/ed-ensure-layers (ed-init (make-buffer "short\nline\n" "n.txt" "n.txt"))))
      (is (not (vm-stale? m (assoc m :fill-column-indicator true))))))

  (test "turning the spell check on repaints the verdicts the buffer already has"
    (let (plain (input/ed-ensure-layers (ed-init (make-buffer "teh word\n" "n.txt" "n.txt")))
          checked (ed-set-buf plain
                    (editor/buffer/annotate (ed-current-buf plain)
                      :spell {:top 0
                       :rows 24
                       :errors {0 [[0 3 "teh"]]}
                       :rope (buffer-rope (ed-current-buf plain))})))
      (is (vm-stale-without? :spell checked (assoc checked :spell-check? true)))
      (is (not (vm-stale? checked (assoc checked :spell-check? true))))))

  (test "a search's other matches repaint when the search starts and when it ends"
    (let (m (input/ed-ensure-layers (ed-init (make-buffer "zork zork\n" "n.txt" "n.txt")))
          lazy {:pattern "zork" :fold? false}
          searching (assoc m :isearch {:query "zork"} :isearch-lazy lazy))
      (is (vm-stale-without? :isearch m searching))
      (is (not (vm-stale? m searching)))
      (is (not (vm-stale? searching (assoc searching :isearch nil)))))))

;; A spell check landing underlines a word or two. It used to flip every bare row of the
;; pane from the plain painter to the tiler (tiled-or-plain was the PANE's call): a blank
;; line lost its op and every row's memo missed, once per check.
(describe "a spell result repaints only the rows it underlines"
  (test "rows whose spans did not change keep their fragment, deps and ops alike"
    (let (text "one line\n\nteh word here\n\nanother line\nlast"
          plain (assoc (input/ed-ensure-layers (ed-init (make-buffer text "n.md" "n.md")))
                  :spell-check? true)
          checked (ed-set-buf plain
                    (editor/buffer/annotate (ed-current-buf plain)
                      :spell {:top 0
                       :rows 24
                       :errors {2 [[0 3 "teh"]]}
                       :rope (buffer-rope (ed-current-buf plain))}))
          before (vm-steady-table plain)
          after (second (vm-harvest checked before))
          rows-of (fn (table) (into {} (seq/filter (seq table) (fn ([k _]) (= (first k) :line)))))
          was (rows-of before)
          now (rows-of after)
          changed (sort (seq/keep (keys now)
                          (fn (k) (when (not (= (get was k) (get now k))) (nth k 2))))))
      ;; the underlined word's row, and nothing else (the buffer's first line is row 0)
      (assert= changed (list 2))
      ;; and the frame is what a fresh render paints
      (assert= (first (vm-harvest checked before)) (ed-view checked vm-cols vm-rows)))))
