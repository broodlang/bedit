;; Java (src/languages/java.blsp): a `deflanguage` over tree-sitter-java. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-java.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-java-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "java, the mode"
  (test "a .java file opens in java mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/Greeter.java")) "java"))
  (test "it parses with tree-sitter-java, comments with // and formats with google-java-format"
    (assert= (ed-mode-service (file-buffer "" "/p/A.java") :ts-lang) :java)
    (assert= (:url (model/grammar-source :java)) "https://github.com/tree-sitter/tree-sitter-java")
    (assert= (ed-mode-service (file-buffer "" "/p/A.java") :comment-syntax) "// ")
    (assert= (ed-mode-service (file-buffer "" "/p/A.java") :format-command)
      ["google-java-format" "--aosp" "--replace"]))
  (test "the restart: a column-0 item, the one before a text block still open across it"
    (let (src "package app;\n\npublic class A {\n    int x;\n}\n")
      (assert= (languages/java/java-restart src (index-of src "    int"))
        (index-of src "public class")))
    (let (src "String s = \"\"\"\nclass B {\n\"\"\";\nclass A {\n    int x;\n}\n")
      (assert= (languages/java/java-restart src (index-of src "    int")) (index-of src "class A")))
    (let (src "package app;\n\nclass A {\n    String s = \"\"\"\nclass B {\n    int x;\n")
      (assert= (languages/java/java-restart src (index-of src "    int")) (index-of src "class A")))))

;; the sample is laid out as its formatter writes it: google-java-format --aosp

(def java-src
  "// the greeter
package app.greet;

import java.util.List;

/** A greeter. */
@Service
public class Greeter<T> extends Base implements Runnable {
    private static final int MAX = 0x10;
    private final String name;

    public Greeter(String name) {
        this.name = name;
    }

    @Override
    public void run() {
        List<String> names = List.of(\"a\", \"b\");
        for (String each : names) {
            if (each.isEmpty()) {
                continue;
            } else {
                System.out.println(greet(each, 1.5, true));
            }
        }
        switch (names.size()) {
            case 0:
                break;
            default:
                names.forEach(item -> {
                    log(item);
                });
        }
        String message = STR.\"hi \\{name.trim()} done\";
        String block = \"\"\"
            text block
            \"\"\";
        Object nothing = null;
        char letter = 'c';
        try {
            work(new int[] {1, 2});
        } catch (RuntimeException e) {
            throw e;
        } finally {
            super.close();
        }
    }

    int kind(String name) {
        return switch (name) {
            case \"x\" -> 1;
            default -> {
                yield 2;
            }
        };
    }

    private String greet(String who, double weight, boolean loud) {
        return \"hello \" + who;
    }
}

interface Shape {
    double area();
}

enum Color {
    RED,
    GREEN;

    Color next() {
        return GREEN;
    }
}

record Point(int x, int y) {}
")

(when (load-test-grammar :java)
  (describe "java, parsed"
    (def java-spans (languages/java/java-fontify java-src))
    (test "comments, keywords, this and super"
      (assert= (face-at java-spans java-src "// the") (face-of :syntax/comment))
      (assert= (face-at java-spans java-src "/** A") (face-of :syntax/comment))
      (assert= (face-at java-spans java-src "public class") (face-of :syntax/keyword))
      (assert= (face-at java-spans java-src "this.name") (face-of :syntax/keyword))
      (assert= (face-at java-spans java-src "super.close") (face-of :syntax/keyword)))
    (test "a type's name, a primitive, a generic and an annotation are specials"
      (assert= (face-at java-spans java-src "Greeter<T>") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "Base") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "int MAX") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "@Override") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "Shape") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "Point") (face-of :syntax/special)))
    (test "a method's and a constructor's name are definitions"
      (assert= (face-at java-spans java-src "run()") (face-of :syntax/definition))
      (assert= (face-at java-spans java-src "Greeter(String") (face-of :syntax/definition))
      (assert= (face-at java-spans java-src "area()") (face-of :syntax/definition)))
    (test "a call and a method call are functions"
      (assert= (face-at java-spans java-src "greet(each") (face-of :syntax/function))
      (assert= (face-at java-spans java-src "println") (face-of :syntax/function))
      (assert= (face-at java-spans java-src "isEmpty") (face-of :syntax/function)))
    (test "literals: strings, a text block, a char, numbers, constants"
      (assert= (face-at java-spans java-src "\"a\"") (face-of :syntax/string))
      (assert= (face-at java-spans java-src "\"\"\"") (face-of :syntax/string))
      (assert= (face-at java-spans java-src "'c'") (face-of :syntax/string))
      (assert= (face-at java-spans java-src "0x10") (face-of :syntax/number))
      (assert= (face-at java-spans java-src "1.5") (face-of :syntax/number))
      (assert= (face-at java-spans java-src "true") (face-of :syntax/constant))
      (assert= (face-at java-spans java-src "null") (face-of :syntax/constant))
      (assert= (face-at java-spans java-src "RED") (face-of :syntax/constant)))
    (test "a string template's text is a string and the code inside it is code"
      (assert= (face-at java-spans java-src "hi ") (face-of :syntax/string))
      (assert= (face-at java-spans java-src "\\{name") (face-of :syntax/special))
      (assert= (face-at java-spans java-src "name.trim") nil)
      (assert= (face-at java-spans java-src "trim()") (face-of :syntax/function)))
    (test "it indents every line: bodies, a switch's cases, a lambda, a switch expression"
      (let ([got want] (indents java-src "/p/Greeter.java")) (assert= got want)))
    (test "a class, an interface, an enum, a record and a method are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/java/java-spec :definitions)))
        (doseq (kind [:class_declaration
                       :interface_declaration :enum_declaration
                       :record_declaration :method_declaration])
          (is (contains? kinds kind)))))))
