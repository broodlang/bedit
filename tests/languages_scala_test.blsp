;; Scala (src/languages/scala.blsp): a `deflanguage` over tree-sitter-scala. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-scala.so` (M-x grammar-install) and SKIPS
;; without it.
(defmodule languages-scala-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "scala, the mode"
  (test "a .scala, a .sc and a .sbt file open in scala mode"
    (doseq (file ["/p/Greeter.scala" "/p/script.sc" "/p/build.sbt"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "scala")))
  (test "it parses with tree-sitter-scala, comments with // and formats with scalafmt"
    (assert= (ed-mode-service (file-buffer "" "/p/a.scala") :ts-lang) :scala)
    (assert= (:url (model/grammar-source :scala))
      "https://github.com/tree-sitter/tree-sitter-scala")
    (assert= (ed-mode-service (file-buffer "" "/p/a.scala") :comment-syntax) "// ")
    (assert= (ed-mode-service (file-buffer "" "/p/a.scala") :format-command) ["scalafmt"]))
  (test "the restart: a column-0 item, the one before a triple-quoted string still open across it"
    (let (src "package app\n\nobject A {\n  val x = 1\n}\n")
      (assert= (languages/scala/scala-restart src (index-of src "  val")) (index-of src "object A")))
    (let (src "val s = \"\"\"\nobject B {\n\"\"\"\nobject A {\n  val x = 1\n}\n")
      (assert= (languages/scala/scala-restart src (index-of src "  val")) (index-of src "object A")))
    (let (src "package app\n\nobject A {\n  val s = \"\"\"\nobject B {\n  val x = 1\n")
      (assert= (languages/scala/scala-restart src (index-of src "  val")) (index-of src "object A")))))

;; the sample is laid out as its formatter writes it: scalafmt's defaults

(def scala-src
  "// the greeter
package app.greet

import scala.util.{Failure, Success}

/** A greeter. */
@deprecated(\"old\", \"1.0\")
case class Point(x: Int, y: Int = 0)

sealed trait Shape {
  def area: Double
}

object Registry {
  final val Max = 0x10L
  private var names: List[String] = Nil
}

enum Color(val rgb: Int) {
  case Red extends Color(0xff0000)
  case Green extends Color(0x00ff00)
}

class Greeter[T](name: String) extends Base with Runnable {
  override def run(): Unit = {
    val names = List(\"a\", \"b\")
    for (each <- names) {
      if (each.isEmpty) {
        println(\"empty\")
      } else {
        println(greet(each, 1.5, true))
      }
    }
    val kind = names.size match {
      case 0 => \"none\"
      case 1 =>
        \"one\"
      case _ => \"many\"
    }
    names.foreach { item => log(item) }
    val message = s\"hi $name and ${name.length} done\"
    val block =
      \"\"\"raw
        |text\"\"\".stripMargin
    val nothing: String = null
    val letter = 'c'
    try {
      work(Array(1, 2))
    } catch {
      case e: RuntimeException => throw e
    }
  }

  private def greet(
      who: String,
      weight: Double,
      loud: Boolean
  ): String =
    \"hello \" + who
}

def shout(text: String): String = text.toUpperCase

class Braceless(name: String):
  def greet(): String =
    val count = 1
    s\"hi $name\"

  def describe(x: Int): String =
    x match
      case 1 => \"one\"
      case _ =>
        \"many\"
")

(when (load-test-grammar :scala)
  (describe "scala, parsed"
    (def scala-spans (languages/scala/scala-fontify scala-src))
    (test "comments, keywords and super"
      (assert= (face-at scala-spans scala-src "// the") (face-of :syntax/comment))
      (assert= (face-at scala-spans scala-src "/** A") (face-of :syntax/comment))
      (assert= (face-at scala-spans scala-src "case class") (face-of :syntax/keyword))
      (assert= (face-at scala-spans scala-src "sealed trait") (face-of :syntax/keyword))
      (assert= (face-at scala-spans scala-src "match {") (face-of :syntax/keyword)))
    (test "a type's, a trait's and an object's name and an annotation are specials"
      (assert= (face-at scala-spans scala-src "Point") (face-of :syntax/special))
      (assert= (face-at scala-spans scala-src "Shape") (face-of :syntax/special))
      (assert= (face-at scala-spans scala-src "Registry") (face-of :syntax/special))
      (assert= (face-at scala-spans scala-src "@deprecated") (face-of :syntax/special))
      (assert= (face-at scala-spans scala-src "Unit") (face-of :syntax/special)))
    (test "a def's name is a definition"
      (assert= (face-at scala-spans scala-src "run()") (face-of :syntax/definition))
      (assert= (face-at scala-spans scala-src "area:") (face-of :syntax/definition))
      (assert= (face-at scala-spans scala-src "shout(") (face-of :syntax/definition)))
    (test "a call, a method call and an interpolator are functions"
      (assert= (face-at scala-spans scala-src "println") (face-of :syntax/function))
      (assert= (face-at scala-spans scala-src "foreach") (face-of :syntax/function))
      (assert= (face-at scala-spans scala-src "s\"hi") (face-of :syntax/function)))
    (test "literals: strings, a char, numbers, constants, an enum case"
      (assert= (face-at scala-spans scala-src "\"a\"") (face-of :syntax/string))
      (assert= (face-at scala-spans scala-src "\"\"\"raw") (face-of :syntax/string))
      (assert= (face-at scala-spans scala-src "'c'") (face-of :syntax/string))
      (assert= (face-at scala-spans scala-src "0x10L") (face-of :syntax/number))
      (assert= (face-at scala-spans scala-src "1.5") (face-of :syntax/number))
      (assert= (face-at scala-spans scala-src "true") (face-of :syntax/constant))
      (assert= (face-at scala-spans scala-src "null") (face-of :syntax/constant))
      (assert= (face-at scala-spans scala-src "Red") (face-of :syntax/constant)))
    (test "a string template's text is a string and the code inside it is code"
      (assert= (face-at scala-spans scala-src "\"hi $") (face-of :syntax/string))
      (assert= (face-at scala-spans scala-src "name and") nil)
      (assert= (face-at scala-spans scala-src "name.length") nil))
    (test "it indents every line: braces, a match, a definition's parameters, braceless bodies"
      (let ([got want] (indents scala-src "/p/Greeter.scala")) (assert= got want)))
    (test "a class, an object, a trait, an enum and a def are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/scala/scala-spec :definitions)))
        (doseq (kind [:class_definition
                       :object_definition :trait_definition :enum_definition :function_definition])
          (is (contains? kinds kind)))))))

(def- scala-lambda-src
  "object A {\n  def f(xs: List[Int]) = {\n    xs.map { item =>\n      item + 1\n    }\n  }\n}\n")

(when (and (load-test-grammar :scala)
        (contains? (:kinds (editor/treesit/language-names {:indent {:hanging #{:probe}}})) :probe))
  (describe "scala, a lambda's body"
    (test "a `{ item =>` lambda's body goes one level in, its closing brace back out"
      (let ([got want] (indents scala-lambda-src "/p/Lambda.scala")) (assert= got want)))))
