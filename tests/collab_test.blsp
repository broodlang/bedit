;; collab — a pooled buffer backed by a shared buffer PROCESS (independent cursors, shared edits).
;; The pure `collab-splice` diff needs no process; the round-trip tests play BOTH clients in one
;; test process (local pids send/receive exactly as a node link would) — an edit through one
;; client's `collab-edit` is serialized by the process and folded back into every client's model
;; via `ed-apply-buffer-update`, each keeping its own pane cursor. No node, no window.
(defmodule collab-test
  (:use collab)
  (:use model)
  (:use editor/buffer)
  (:use test))

;; Seed a model's selected-pane cursor to `pt` (window-local) so cursor-independence is testable.
(defn ct-at (m pt)
  (ed-set-buf m (goto-char (ed-current-buf m) pt)))

(defn ct-text (m) (buffer-text (ed-current-buf m)))
(defn ct-point (m) (get (ed-current-pane m) :point))

;; Wait for the next `[:buffer-updated proc v view]` push and return `[v text]` (or :none).
;; The presence projection pushes `[text markers names]`; a bare string is the legacy shape.
(defn ct-view-text (view)
  (cond (map? view) (get view :splice) (vector? view) (nth view 0) :else view))
(defn ct-await (proc)
  (receive ([:buffer-updated ~proc v view _] [v (ct-view-text view)]) (after 2000 :none)))

;; The raw triple [v view origin] — for tests that fold the real push shapes.
(defn ct-await* (proc)
  (receive ([:buffer-updated ~proc v view o] [v view o]) (after 2000 :none)))

;; Drain until quiet: the seed push AND the join announce (`collab-share-slot` plants a
;; cursor marker + name right after subscribing), so a test sees only its own edits after.
(defn ct-drain-seed (proc)
  (receive ([:buffer-updated ~proc _ _ _] (ct-drain-seed proc)) (after 300 nil)))

(describe "collab-splice — the single positional splice diff (pure)"
  (test "equal strings splice to a no-op"
    (is (collab-splice-noop? (collab-splice "hello" "hello"))))
  (test "an append is the tail splice"
    (assert= (collab-splice "hello" "helloXYZ") [5 5 "XYZ"]))
  (test "an insertion in the middle is the minimal span"
    (assert= (collab-splice "abc" "axbc") [1 1 "x"]))
  (test "a deletion in the middle collapses the changed span"
    (assert= (collab-splice "hello world" "hell world") [4 5 ""]))
  (test "a mixed replace keeps only the differing span"
    (assert= (collab-splice "hello world" "held world") [3 5 "d"]))
  (test "a replacement is delete+insert in one span"
    (assert= (collab-splice "cat" "cot") [1 2 "o"]))
  (test "prefix and suffix never overlap (shrink to one char)"
    (assert= (collab-splice "aa" "a") [1 2 ""])
    (assert= (collab-splice "a" "aa") [1 1 "a"]))
  (test "a splice, applied with replace-region, reproduces the target"
    (let ([lo hi repl] (collab-splice "hello world" "held world"))
      (assert= (buffer-text (replace-region (make-buffer "hello world") lo hi repl)) "held world"))))

(describe "collab — shared buffer process, independent cursors" :isolated

  (test "an edit through collab-edit is serialized by the process and folded into every client, each keeping its own point"
    (let (proc (spawn-buffer (make-buffer "hello" "shared.txt"))
          ;; client A subscribes (this test process) and sits at point 5; client B is another
          ;; view of the same slot at point 0 (link only — one subscription feeds both here).
          mA (ct-at (collab-share-slot (ed-init (make-buffer "hello" "shared.txt")) 0 proc) 5)
          mB (ct-at (assoc-in (ed-init (make-buffer "hello" "shared.txt")) [:shared 0] {:proc proc :version -1}) 0))
      (ct-drain-seed proc)
      ;; A appends "XYZ" at its point (5, end of "hello") — the wire carries the DELTA
      (let (mA2 (collab-edit mA (fn (b) (insert (goto-char b 5) "XYZ"))))
        (let ([v view o] (ct-await* proc))
          (assert= (get view :splice) [5 5 "XYZ"])   ; not the document
          (assert= (buffer-query proc buffer-text) "helloXYZ")
          ;; the push folds into BOTH clients' models — B applies the splice; A's own
          ;; echo is suppressed (already applied locally by collab-edit)
          (let (mAf (ed-apply-buffer-update mA2 proc v view o)
                mBf (ed-apply-buffer-update mB proc v view o))
            (assert= (ct-text mAf) "helloXYZ")
            (assert= (ct-text mBf) "helloXYZ")
            ;; A's in-flight count drained by its own echo
            (assert= (get-in mAf [:shared 0 :pending]) 0)
            ;; cursors stayed independent: B's is still at 0, A moved with its own insert
            (assert= (ct-point mBf) 0)
            (is (> (ct-point mAf) 0)))))
      (stop-buffer proc)))

  (test "a pure-movement command sends no edit (the splice is a no-op)"
    (let (proc (spawn-buffer (make-buffer "hello" "m.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello" "m.txt")) 0 proc))
      (ct-drain-seed proc)
      (collab-edit m (fn (b) (goto-char b 2)))   ; move only — no text change
      (assert= (ct-await proc) :none)            ; nothing pushed
      (stop-buffer proc)))

  (test "two participants' edits both survive when each round-trips before the next (v1 serialized)"
    (let (proc (spawn-buffer (make-buffer "hello" "rt.txt"))
          mA (collab-share-slot (ed-init (make-buffer "hello" "rt.txt")) 0 proc)
          mB (assoc-in (ed-init (make-buffer "hello" "rt.txt")) [:shared 0] {:proc proc :version -1}))
      (ct-drain-seed proc)
      ;; A prepends "A" → "Ahello"; the delta push updates B's copy
      (collab-edit mA (fn (b) (insert (goto-char b 0) "A")))
      (let ([v1 view1 o1] (ct-await* proc)
            mB1 (ed-apply-buffer-update mB proc v1 view1 o1))
        (assert= (ct-text mB1) "Ahello")
        ;; B, now on the updated text, appends "Z" → "AhelloZ"
        (collab-edit mB1 (fn (b) (insert (end-of-buffer b) "Z")))
        (let ([_ view2 _] (ct-await* proc))
          (assert= (get view2 :splice) [6 6 "Z"])
          (assert= (buffer-query proc buffer-text) "AhelloZ")))
      (stop-buffer proc)))

  (test "ed-apply-buffer-update ignores a stale/duplicate version"
    (let (proc (spawn-buffer (make-buffer "x" "s.txt"))
          m (collab-share-slot (ed-init (make-buffer "x" "s.txt")) 0 proc))
      (ct-drain-seed proc)
      (let (m5 (ed-apply-buffer-update m proc 5 "five")
            m3 (ed-apply-buffer-update m5 proc 3 "three"))   ; 3 <= 5 → ignored
        (assert= (ct-text m5) "five")
        (assert= (ct-text m3) "five"))
      (stop-buffer proc)))

  (test "collab-propagate pushes an ordinary command's text change to the process (command-agnostic)"
    (let (proc (spawn-buffer (make-buffer "hello" "p.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello" "p.txt")) 0 proc))
      (ct-drain-seed proc)
      ;; a plain command edited the pooled buffer via ed-set-buf, unaware of sharing
      (let (after (ed-set-buf m (insert (end-of-buffer (ed-current-buf m)) "!")))
        (let (after2 (collab-propagate m after))
          (assert= (get-in after2 [:shared 0 :pending]) 1))   ; one splice in flight
        (let ([_ view _] (ct-await* proc))
          (assert= (get view :splice) [5 5 "!"]))             ; the delta, not the doc
        (assert= (buffer-query proc buffer-text) "hello!"))
      (stop-buffer proc)))

  (test "collab-propagate sends nothing when no shared slot's text changed"
    (let (proc (spawn-buffer (make-buffer "hello" "p2.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello" "p2.txt")) 0 proc))
      (ct-drain-seed proc)
      (let (after (ed-set-buf m (goto-char (ed-current-buf m) 2)))   ; move only
        (collab-propagate m after)
        (assert= (ct-await proc) :none))
      (stop-buffer proc)))

  (test "collab-unshare stops the slot tracking further edits"
    (let (proc (spawn-buffer (make-buffer "hi" "u.txt"))
          m (collab-share-slot (ed-init (make-buffer "hi" "u.txt")) 0 proc))
      (ct-drain-seed proc)
      (let (m2 (collab-unshare m 0))
        (is (not (collab-shared? m2)))
        (ct-drain-seed proc)                     ; the presence-withdraw push + settle
        (buffer-edit proc (fn (b) (insert (end-of-buffer b) "!")))
        (assert= (ct-await proc) :none))         ; no more pushes to us
      (stop-buffer proc)))

  (test "presence: joining announces a pid-keyed cursor marker and the participant name"
    (let (proc (spawn-buffer (make-buffer "hello" "pr.txt"))
          m (collab-share-slot (assoc (ed-init (make-buffer "hello" "pr.txt")) :participant "alice") 0 proc))
      (ct-drain-seed proc)
      ;; our announce landed in the process: our cursor marker (keyed by OUR pid) + name
      (let (me (get-in m [:shared 0 :me])
            marks (buffer-query proc buffer-markers)
            names (buffer-query proc (fn (b) (get b :participants {}))))
        (assert= (get marks me) 0)
        (assert= (get names me) "alice"))
      (stop-buffer proc)))

  (test "presence: collab-sync-point moves our marker only when point moved"
    (let (proc (spawn-buffer (make-buffer "hello" "sp.txt"))
          m (ct-at (collab-share-slot (ed-init (make-buffer "hello" "sp.txt")) 0 proc) 3))
      (ct-drain-seed proc)
      (let (m2 (collab-sync-point m)
            me (get-in m2 [:shared 0 :me]))
        (receive (after 200 nil))                ; let the marker edit land
        (assert= (buffer-query proc (fn (b) (buffer-marker b me))) 3)
        (ct-drain-seed proc)                     ; consume the marker push
        ;; unmoved point → no further edit, nothing pushed
        (collab-sync-point m2)
        (assert= (ct-await proc) :none))
      (stop-buffer proc)))

  (test "presence: a push's cursors/names land on the slot, own pid excluded; churn echoes"
    (let (proc (spawn-buffer (make-buffer "doc" "pc.txt"))
          m (collab-share-slot (ed-init (make-buffer "doc" "pc.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          ;; the seed applies silently (finding people already here isn't churn) …
          m0 (ed-apply-buffer-update m proc 0 ["doc" {me 0} {me "guest"}])
          ;; … then a v1 push brings a remote participant :bob at offset 2
          m1 (ed-apply-buffer-update m0 proc 1 ["doc" {me 0 :bob 2} {me "guest" :bob "bob"}]))
      (assert= (get-in m1 [:shared 0 :cursors]) {:bob 2})
      (assert= (get-in m1 [:shared 0 :names :bob]) "bob")
      (assert= (get m1 :echo) "bob joined")
      ;; bob's marker vanishes (death/detach cleanup) → a leave echo
      (let (m2 (ed-apply-buffer-update m1 proc 2 ["doc" {me 0} {me "guest" :bob "bob"}]))
        (assert= (get-in m2 [:shared 0 :cursors]) {})
        (assert= (get m2 :echo) "bob left"))
      (stop-buffer proc)))

  (test "echo suppression: an own-origin push never rebuilds content (local text stays ahead)"
    (let (proc (spawn-buffer (make-buffer "ab" "es.txt"))
          m (collab-share-slot (ed-init (make-buffer "ab" "es.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          m0 (ed-apply-buffer-update m proc 0 ["ab" {me 0} {me "guest"}])
          ;; locally we typed on: "abXY" — two keystrokes ahead of the round-trip
          m1 (ed-set-buf m0 (insert (end-of-buffer (ed-current-buf m0)) "XY"))
          ;; the first keystroke's echo returns (origin = me, text "abX" — OLDER than local)
          m2 (ed-apply-buffer-update m1 proc 1 ["abX" {me 0} {me "guest"}] me))
      ;; no clobber of the newer local text; the version still advances
      (assert= (ct-text m2) "abXY")
      (assert= (get-in m2 [:shared 0 :version]) 1)
      ;; a FOREIGN-origin push still rebuilds (reconvergence stays intact)
      (let (m3 (ed-apply-buffer-update m2 proc 2 ["abXY!" {me 0} {me "guest"}] :someone-else))
        (assert= (ct-text m3) "abXY!"))
      ;; and the wire really carries our origin: a collab-edit's push is tagged with me
      (ct-drain-seed proc)
      (collab-edit (ct-at m0 2) (fn (b) (insert (goto-char b 2) "z")))
      (assert= (receive ([:buffer-updated ~proc _ _ o] o) (after 2000 :none)) me)
      (stop-buffer proc)))

  (test "follow: pushes move the follower's point; an own move or the leader leaving breaks it"
    (let (proc (spawn-buffer (make-buffer "hello world" "f.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello world" "f.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          m0 (ed-apply-buffer-update m proc 0 ["hello world" {me 0} {me "guest"}])
          m1 (ed-apply-buffer-update m0 proc 1 ["hello world" {me 0 :zoe 4} {me "guest" :zoe "zoe"}])
          m2 (collab-follow m1 :zoe "zoe")
          ;; zoe moves to 7 → the handler's jump puts our point there, view clamped
          m3 (collab-follow-jump
               (ed-apply-buffer-update m2 proc 2 ["hello world" {me 0 :zoe 7} {me "guest" :zoe "zoe"}])
               20))
      (assert= (buffer-point (ed-current-buf m3)) 7)
      ;; a real key that moves point takes the wheel back
      (let (m4 (ed-set-buf m3 (goto-char (ed-current-buf m3) 1))
            m5 (collab-follow-step m3 m4 :left))
        (is (nil? (get m5 :follow)))
        (assert= (get m5 :echo) "stopped following zoe"))
      ;; a push that doesn't move point (zoe still at 7) breaks nothing
      (let (m4b (collab-follow-step m3 m3 [:buffer-updated proc 9 "x"]))
        (is (not (nil? (get m4b :follow)))))
      ;; zoe leaving unfollows, with the reason in the echo
      (let (m6 (ed-apply-buffer-update m3 proc 3 ["hello world" {me 0} {me "guest" :zoe "zoe"}]))
        (is (nil? (get m6 :follow)))
        (assert= (get m6 :echo) "zoe left — stopped following"))
      (stop-buffer proc)))

  (test "selections: an active region syncs the [me :mark] anchor; dropping it deletes it"
    (let (proc (spawn-buffer (make-buffer "hello world" "sel.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello world" "sel.txt")) 0 proc)
          me (get-in m [:shared 0 :me]))
      (ct-drain-seed proc)
      ;; region 2..6 active locally (mark 2, point 6) → the sync ships cursor AND anchor
      (let (m1 (ed-set-buf m (assoc (goto-char (ed-current-buf m) 6) :mark 2))
            m2 (collab-sync-point m1))
        (receive (after 200 nil))
        (assert= (buffer-query proc (fn (b) (buffer-marker b [me :mark]))) 2)
        (assert= (buffer-query proc (fn (b) (buffer-marker b me))) 6)
        ;; dropping the region deletes the anchor (cursor marker stays)
        (let (m3 (ed-set-buf m2 (assoc (ed-current-buf m2) :mark nil))
              _ (collab-sync-point m3))
          (receive (after 200 nil))
          (is (nil? (buffer-query proc (fn (b) (buffer-marker b [me :mark])))))))
      (stop-buffer proc)))

  (test "selections: a push's [pid :mark] anchors land as :marks (own excluded)"
    (let (proc (spawn-buffer (make-buffer "hello world" "sm.txt"))
          m (collab-share-slot (ed-init (make-buffer "hello world" "sm.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          raw (assoc {me 0 :zoe 9} [:zoe :mark] 4)
          mf (ed-apply-buffer-update m proc 5 ["hello world" raw {me "guest" :zoe "zoe"}]))
      (assert= (get-in mf [:shared 0 :marks :zoe]) 4)
      (assert= (get-in mf [:shared 0 :cursors :zoe]) 9)   ; vector keys never leak into cursors
      (stop-buffer proc)))

  (test "registry: one buffer process per file, whoever asks first wins the content"
    (let (reg (collab-registry-start)
          a (collab-registry-share reg "/tmp/cl-reg.txt" "hi" "f.txt")
          b (collab-registry-share reg "/tmp/cl-reg.txt" "STALE" "f.txt")
          c (collab-registry-share reg "/tmp/cl-reg2.txt" "yo" "g.txt"))
      (is (= a b))
      (is (not (= a c)))
      (assert= (buffer-query b buffer-text) "hi")
      (stop-buffer a)
      (stop-buffer c)))

  (test "autoshare: visiting a file buffer in a registry session links its slot"
    (let (reg (collab-registry-start)
          m (assoc (ed-init (make-buffer "hello" "n.txt" "/tmp/cl-auto.txt")) :collab-reg reg)
          m1 (collab-autoshare m))
      (is (collab-shared? m1 0))
      ;; idempotent — a second pass changes nothing
      (is (= (get-in m1 [:shared 0 :proc]) (get-in (collab-autoshare m1) [:shared 0 :proc])))
      ;; a scratch (fileless) buffer is never shared
      (is (nil? (get-in (collab-autoshare (assoc (ed-init (make-buffer "s")) :collab-reg reg))
                  [:shared 0])))
      (ct-drain-seed (get-in m1 [:shared 0 :proc]))
      (stop-buffer (get-in m1 [:shared 0 :proc]))))

  (test "presence migrates: switching buffers withdraws the markers from the buffer left"
    (let (procA (spawn-buffer (make-buffer "aaa" "a.txt"))
          procB (spawn-buffer (make-buffer "bbb" "b.txt"))
          m0 (collab-share-slot (ed-init (make-buffer "aaa" "a.txt")) 0 procA)
          me (get-in m0 [:shared 0 :me])
          ;; a second pool buffer, shared with B, then sync while A is current
          m1 (collab-share-slot (ed-append-named m0 "b.txt" "bbb") 1 procB)
          m2 (collab-sync-point m1))
      (receive (after 250 nil))
      (is (not (nil? (buffer-query procA (fn (b) (buffer-marker b me))))))
      ;; switch to buffer 1 and sync → presence leaves A, lands on B
      (let (_ (collab-sync-point (ed-show-index m2 1)))
        (receive (after 250 nil))
        (is (nil? (buffer-query procA (fn (b) (buffer-marker b me)))))
        (is (not (nil? (buffer-query procB (fn (b) (buffer-marker b me)))))))
      (stop-buffer procA)
      (stop-buffer procB)))

  (test "share-follow crosses buffers; share-mirror adopts the leader's viewport"
    ;; pure model state: zoe is IN the b.txt slot (cursor there, none in slot 0)
    (let (m0 (ed-append-named (ed-init (make-buffer "aaa" "a.txt"))
               "b.txt" "line0\nline1\nline2\nline3\nline4\nline5\nline6")
          bi (ed-buffer-index-by-name m0 "b.txt")
          m (assoc m0 :shared {0 {:proc :pa :version 1 :me :self :cursors {}}
                               bi {:proc :pb :version 1 :me :self
                                   :cursors {:zoe 14} :tops {:zoe 12}
                                   :names {:zoe "zoe"}}})
          mf (collab-follow m :zoe "zoe")
          mj (collab-follow-jump mf 3))
      (assert= (ed-current-index mj) bi)                         ; switched buffers with her
      (assert= (buffer-point (ed-current-buf mj)) 14)            ; and sits on her caret
      ;; mirror mode also adopts her top (offset 12 = line 2)
      (let (mm (collab-follow-jump (collab-follow m :zoe "zoe" :mirror) 3))
        (assert= (ed-current-top mm) 2))))

  (test "name tags: a moved caret re-arms the tag ttl; the blink beat decays it"
    (let (proc (spawn-buffer (make-buffer "doc" "tt.txt"))
          m (collab-share-slot (ed-init (make-buffer "doc" "tt.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          m0 (ed-apply-buffer-update m proc 0 ["doc" {me 0} {me "guest"}])
          m1 (ed-apply-buffer-update m0 proc 1 ["doc" {me 0 :zoe 1} {me "guest" :zoe "zoe"}]))
      (is (> (get-in m1 [:shared 0 :tag-ttl :zoe]) 0))
      ;; an unmoved caret in the next push does NOT re-arm; decay ticks it away
      (let (m2 (ed-apply-buffer-update m1 proc 2 ["doc" {me 0 :zoe 1} {me "guest" :zoe "zoe"}])
            m3 (fold (fn (acc _) (collab-decay-tags acc)) m2 (range 0 9)))
        (is (nil? (get-in m3 [:shared 0 :tag-ttl :zoe]))))
      (stop-buffer proc)))

  (test "presence: a cursor-only push leaves the buffer VALUE untouched (no rebuild)"
    (let (proc (spawn-buffer (make-buffer "doc" "nv.txt"))
          m (collab-share-slot (ed-init (make-buffer "doc" "nv.txt")) 0 proc)
          me (get-in m [:shared 0 :me])
          m1 (ed-apply-buffer-update m proc 1 ["doc" {me 0} {me "guest"}])
          buf1 (ed-buf-at m1 0)
          m2 (ed-apply-buffer-update m1 proc 2 ["doc" {me 0 :zoe 1} {me "guest" :zoe "zoe"}]))
      ;; same rope handle — the cursor-only push rebuilt nothing (undo state survives)
      (is (= (get buf1 :rope) (get (ed-buf-at m2 0) :rope)))
      (assert= (get-in m2 [:shared 0 :cursors]) {:zoe 1})
      (stop-buffer proc))))
