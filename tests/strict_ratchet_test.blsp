;; The `nest check --strict` ratchet. Plain `nest check` is the gate (zero, and `make check`
;; enforces it); `--strict` is advisory and this file is the only thing that watches it.
;;
;; A RATCHET, not a target. Strict reads every merely-wider bound by inclusion (`number`
;; where `int` is declared, `nil | int` from `nth`) and the residue is real debt, but a hard
;; gate at zero cannot land in one session and no gate at all is what let 461 findings pile
;; up unwatched before the 2026-09-11 sweep took them to the number below. So: the ceiling
;; may be LOWERED whenever a declaration closes a finding, and may never rise. A new function
;; that adds one means declaring its contract (a `sig`, a `deftype` for its shape), or the
;; ceiling stops you.
;;
;; The count is against the INSTALLED nest the suite runs under. A brood change that makes
;; the checker sharper can raise it legitimately — that is a signal, not noise: fix what it
;; found or raise the ceiling in the same commit with the reason.
(defmodule strict-ratchet-test (:use test))

(defn- strict-findings ()
  "Every `--strict` finding in this project, one string per line, from a fresh check."
  (let (r (%os-cmd "nest" ["check" "--strict"]))
    (filter (string/split (str (:stdout r) "\n" (:stderr r)) "\n")
      (fn (line) (includes? line "warning:")))))
(sig strict-findings (-> seqable))

(describe "nest check --strict only shrinks"
  (test "the strict finding count never exceeds the ceiling"
    ;; Compared through `math/max` so the failure PRINTS the number that broke it — the
    ;; ceiling against the count is the whole diagnosis. (Same shape as brood's own
    ;; documentation ratchet in tests/audit_test.blsp.)
    (let (findings (strict-findings))
      (assert= 263 (math/max 263 (count findings))))))
