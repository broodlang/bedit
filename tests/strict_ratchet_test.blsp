;; The `nest check --strict` ratchet. Plain `nest check` is the gate (zero, and `make check`
;; enforces it); `--strict` is advisory and this file is the only thing that watches it.
;;
;; At ZERO since 2026-09-12, so this is a hard gate rather than a ratchet: strict reads
;; every merely-wider bound by inclusion (`number` where `int` is declared, `nil | int` from
;; `nth`), and 461 such findings had piled up unwatched before the 2026-09-11/12 sweep took
;; them down — mostly through the checker itself (consistent subtyping, `deftype`, the
;; element rules for `map`/`filter`/`seq/find`/`seq/remove`, a field read over a maybe-record)
;; and the rest through declared shapes and honest nil handling. A new function that adds a
;; finding declares its contract (a `sig`, a `deftype` for its shape) or handles the `nil`
;; it was handed, or this stops you.
;;
;; The count is against the INSTALLED nest the suite runs under. A brood change that makes
;; the checker sharper can raise it legitimately — that is a signal, not noise: fix what it
;; found or raise the ceiling in the same commit with the reason.
(defmodule strict-ratchet-test (:use test))

(defn- strict-findings ()
  "Every `--strict` finding in this project, one string per line, from a fresh check."
  (let (r (%os-cmd "nest" ["check" "--strict"]))
    (seq/filter (string/split (str (:stdout r) "\n" (:stderr r)) "\n")
      (fn (line) (includes? line "warning:")))))
(sig strict-findings (-> seqable))

(describe "nest check --strict only shrinks"
  (test "the strict finding count never exceeds the ceiling"
    ;; Compared through `math/max` so the failure PRINTS the number that broke it — the
    ;; ceiling against the count is the whole diagnosis. (Same shape as brood's own
    ;; documentation ratchet in tests/audit_test.blsp.)
    ;; CEILING 58 since 2026-09-15: the nest built from brood main (ADR-350's intervals, the
    ;; caller-derived parameter types) reads 58 findings that 0.27.2's checker did not — int
    ;; arithmetic answering `number` (`(+ y k)` into an `int` parameter, 15), `nil | x` where
    ;; the context has ruled nil out (`(nth bols 2)`, a `proc/whereis` just registered, 25),
    ;; and `count` answering `ordered` into `string/pad-left`. Each is the checker's
    ;; precision, not a defect this code has; the sweep that declares them is its own commit,
    ;; and the number is here so it can only shrink from now.
    ;; CEILING 48 since 2026-09-16: brood `de575508` — `apply` binds a callee's type variable
    ;; (KI-140, the four `pad-left` findings) and a `let`-bound lambda's parameters are
    ;; derived from its callers, a `sig` over the required positions seeding a `defn` with
    ;; undeclared `&optional`s (ADR-355, `ed-visible-lines`'s `row-op`). No bedit change.
    ;; BACK TO ZERO 2026-09-16, against brood main past v0.29.2: three checker rules (`get-in`
    ;; over a literal path reads the declared shape, `%map-pairs` walks a `map<K, V>` as its
    ;; entries, a site inside a `let`-bound lambda hands the derived type) plus the leaves
    ;; here — the diagnostic and hosted-slot shapes on the model, the row-table tuples, the
    ;; screen-column ints — and honest nil handling in the tests (`(or (seq/find …) (error …))`).
    (let (findings (strict-findings))
      (assert= 0 (math/max 0 (count findings))))))
