;; LSP client (src/lsp.blsp) — the pure protocol + connection logic, tested without a
;; live server: frame encode/decode across chunk boundaries, completion-result shapes,
;; and request/response correlation. The live proc round-trip is covered by the kernel
;; proc tests (../brood tests/proc_test.blsp); enabling a real server (e.g.
;; rust-analyzer) is a manual smoke step, not part of this deterministic suite.

(defmodule lsp-test (:use test) (:use lsp) (:use json))

(describe "lsp: framing"
  (test "lsp--frame prefixes a Content-Length header and a blank line"
    (let (f (lsp/lsp--frame "{}"))
      (assert= f "Content-Length: 2\r\n\r\n{}")))
  (test "lsp-request round-trips through lsp-decode"
    (let (frame (lsp-request 1 "textDocument/completion" {:k "v"})
          [msgs rem] (lsp-decode frame)
          msg (first msgs))
      (assert= rem "")
      (assert= (count msgs) 1)
      (assert= (get msg :id) 1)
      (assert= (get msg :method) "textDocument/completion")
      (assert= (get (get msg :params) :k) "v"))))

(describe "lsp: decoding a chunked stream"
  (test "two concatenated frames decode to two messages, no leftover"
    (let (f (lsp-request 1 "a" {})
          [msgs rem] (lsp-decode (str f f)))
      (assert= (count msgs) 2)
      (assert= rem "")))
  (test "an incomplete frame is buffered whole (returned as remaining)"
    (let (f (lsp-request 1 "a" {})
          partial (substring f 0 (- (string-length f) 3))
          [msgs rem] (lsp-decode partial))
      (assert= (count msgs) 0)
      (assert= rem partial)))
  (test "a header with no body yet buffers (no message)"
    (let ([msgs rem] (lsp-decode "Content-Length: 99\r\n\r\n{}"))
      (assert= (count msgs) 0)))
  (test "a multi-byte UTF-8 body frames by bytes, not chars (the rust-analyzer bug)"
    ;; café→𝄞 is more bytes than chars; a char-based length would never see the frame
    ;; as complete. lsp--frame must Content-Length it in bytes and lsp-decode slice by bytes.
    (let (body "{\"v\":\"café→𝄞\"}"
          frame (lsp/lsp--frame body)
          [msgs rem] (lsp-decode frame))
      (assert= rem "")
      (assert= (count msgs) 1)
      (assert= (get (first msgs) :v) "café→𝄞"))))

(describe "lsp: completion-result shapes"
  (test "a CompletionItem[] vector yields its labels"
    (assert= (lsp-completion-labels [{:label "foo"} {:label "bar"}]) (list "foo" "bar")))
  (test "a {:items …} object yields its items' labels"
    (assert= (lsp-completion-labels {:isIncomplete false :items [{:label "baz"}]}) (list "baz")))
  (test "nil yields no labels"
    (assert= (lsp-completion-labels nil) '())))

(describe "lsp: request/response correlation (pure)"
  (test "a completion request records pending and syncs the document first"
    (let (state {:proc :fake :buf "" :next-id 1 :pending {} :opened {} :version 5}
          [st2 frames] (lsp/lsp--request-complete state :corr-a :pid "file:///a.rb" "ruby" "code" 0 2))
      (assert= (count frames) 2)
      (is (string-contains? (first frames) "didOpen"))      ; first sight → didOpen
      (is (string-contains? (first frames) "ruby"))         ; tagged with the languageId
      (is (string-contains? (second frames) "textDocument/completion"))
      (assert= (get (get st2 :pending) 1) [:pid :corr-a])
      (is (get (get st2 :opened) "file:///a.rb"))
      ;; a second request to the same uri syncs with didChange, not didOpen
      (let ([st3 frames2] (lsp/lsp--request-complete st2 :corr-b :pid "file:///a.rb" "ruby" "x" 1 0))
        (is (string-contains? (first frames2) "didChange")))))
  (test "a matching response routes labels to the waiter and clears pending"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {7 [:my-pid :corr-1]} :opened {} :version 1}
          resp (lsp/lsp--frame (json-encode {:jsonrpc "2.0" :id 7 :result {:items [{:label "foo"} {:label "bar"}]}}))
          [st2 replies] (lsp/lsp--ingest state resp))
      (assert= replies (list [:my-pid [:lsp-completion :corr-1 (list "foo" "bar")]]))
      (is (nil? (get (get st2 :pending) 7)))))
  (test "a response split across two chunks reassembles, then routes"
    (let (f (lsp/lsp--frame (json-encode {:jsonrpc "2.0" :id 7 :result {:items []}}))
          mid (quot (string-length f) 2)
          state {:proc :fake :buf "" :next-id 8 :pending {7 [:my-pid :corr-1]} :opened {} :version 1}
          [s1 r1] (lsp/lsp--ingest state (substring f 0 mid))
          [s2 r2] (lsp/lsp--ingest s1 (substring f mid (string-length f))))
      (is (empty? r1))                          ; first half: nothing complete
      (assert= (get s1 :buf) (substring f 0 mid))  ; buffered intact
      (assert= (count r2) 1)                    ; second half completes the frame
      (is (nil? (get (get s2 :pending) 7))))))   ; and clears the pending entry
