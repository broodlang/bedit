;; help_test.blsp — the C-h map: describe-bindings, describe-mode, where-is, apropos,
;; lossage. Pure model/text tests — no window.
;;
;; The one these exist for is SHADOWING. bedit composes a buffer's mode layers over the
;; model's profile layers, and the merge is shallow, so a mode that binds one key under a
;; prefix takes the whole prefix with it. Help that reported per-leaf shadowing would list
;; bindings that dispatch can never reach — and be believed. Every binding report here is
;; asserted against what the dispatcher's own lookup (`userkeys/ed-key-binding`) resolves.
(defmodule help-test
  (:use test)
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use minibuffer)
  (:use model)
  (:use help)
  (:use editor/buffer)
  (:use editor/layers)
  (:use-internals bedit/help) ; help-key-index — the inversion the perf shape test asserts
  (:use-internals bedit/input)) ; ed-ensure-layers / ed-key-binding — the test asserts help
; against the DISPATCHER's own lookup, which is the whole point of it

(defn- ht-model ()
  "A fresh editor model with layers installed, as the dispatcher would see it."
  (input/ed-ensure-layers (ed-init (make-buffer ""))))

(defn- ht-entries (m)
  "`scope-bindings` over the model's real scope — buffer layers over model layers."
  (scope-bindings (list (ed-current-buf m) m)))

(defn- ht-entries-of (m)
  "`scope-bindings` over the scope dispatch actually resolves through (`userkeys/ed-scope`),
the user's own keys included."
  (scope-bindings (userkeys/ed-scope m)))

(defn- ht-dispatched (m sequence)
  "What the dispatcher reaches for key `sequence`: its first key through the layers
(`ed-key-binding`), the rest down the prefix map that key entered."
  (let (head (userkeys/ed-key-binding m (first sequence))
        more (rest sequence))
    (if (empty? more) head (map/get-in head (vec more)))))

(defn- ht-find (entries sequence)
  (seq/find entries (fn (e) (= (get e :sequence) sequence))))

;; ---- what help reports is what dispatch does --------------------------------

(describe "the binding report agrees with the dispatcher"
  (test "every binding help calls in force resolves through the active keymap"
    (let (m (ht-model)
          live (seq/filter (ht-entries m) (fn (e) (nil? (get e :shadowed-by))))
          ;; the property: follow each in-force sequence through the composed keymap and
          ;; arrive at the same command. A disagreement here is help lying about a key.
          wrong (seq/filter live
                  (fn (e)
                    (not (= (ht-dispatched m (get e :sequence)) (get e :command))))))
      (assert= (map wrong (fn (e) (ed-keys-label (get e :sequence)))) '())))
  (test "and nothing it calls shadowed resolves to that command"
    (let (m (ht-model)
          dead (seq/filter (ht-entries m) (fn (e) (get e :shadowed-by)))
          reachable (seq/filter dead
                      (fn (e) (= (ht-dispatched m (get e :sequence)) (get e :command)))))
      (assert= (map reachable (fn (e) (ed-keys-label (get e :sequence)))) '())))
  (test "a real binding is found, with the layer that owns it"
    ;; C-x C-f is the emacs profile's, and nothing in a scratch buffer shadows it
    (let (e (ht-find (ht-entries (ht-model)) [:ctrl-x :ctrl-f]))
      (assert= [(get e :command) (get e :shadowed-by)] ['commands/cmd-find-file nil])))

  (test "the merged keymap help tables read answers every bound sequence as dispatch does"
    ;; `scope-keymap` over the real scope is what M-x's key column (:anno-keys) and the
    ;; profile keymap read; every sequence any layer binds must mean there what it means to
    ;; the dispatcher — in a scratch buffer and in a Markdown one, whose mode binds C-c keys
    ;; over the profile's, with a user's own C-c key bound in too (brood ADR-535)
    (doseq (m [(ht-model)
                (input/ed-ensure-layers (config/apply-to-model (ed-init (init-buffer-layers (set-buffer-type (make-buffer "")
                                                                                              :markdown)))
                                          {:keys {"C-c f" 'duplicate-line}}))])
      (let (keymap (scope-keymap (userkeys/ed-scope m))
            wrong (seq/filter (ht-entries-of m)
                    (fn (e)
                      (not (= (ht-dispatched m (get e :sequence))
                             (map/get-in keymap (get e :sequence)))))))
        (assert= (vec (map wrong (fn (e) (ed-keys-label (get e :sequence))))) [])))))

;; ---- the *Bindings* text ----------------------------------------------------

(describe "describe-bindings"
  (test "the report names each layer and counts its bindings"
    (let (text (help-bindings-text [{:sequence [:ctrl-x "s"]
                                     :command 'lifecycle/cmd-save
                                     :layer 'emacs
                                     :shadowed-by nil}]))
      (assert= (includes? text "emacs layer  (1 binding)") true)
      (assert= (includes? text "C-x s") true)
      (assert= (includes? text "save") true)))
  (test "a shadowed binding is listed AND says who shadowed it"
    ;; listed, not filtered: a binding that silently vanished is the hardest thing to
    ;; debug about a layered keymap, and this line is the answer
    (let (text (help-bindings-text [{:sequence [:ctrl-x "k"]
                                     :command 'pool/cmd-kill-buffer
                                     :layer 'emacs
                                     :shadowed-by 'dired}]))
      (assert= (includes? text "C-x k") true)
      (assert= (includes? text "(shadowed by dired)") true)))
  (test "layers keep precedence order, highest first"
    (let (text (help-bindings-text [{:sequence ["a"]
                                     :command 'commands/cmd-one
                                     :layer 'high
                                     :shadowed-by nil}
                                     {:sequence ["b"]
                                      :command 'commands/cmd-two
                                      :layer 'low
                                      :shadowed-by nil}]))
      (assert= (< (index-of text "high layer") (index-of text "low layer")) true)))
  (test "the command runs on a real model and produces the buffer"
    (let (m (help/cmd-describe-bindings (ht-model) nil))
      (assert= (:name (ed-current-buf m)) "*Bindings*")
      (assert= (includes? (buffer-text (ed-current-buf m)) "emacs layer") true))))

;; ---- describe-mode ----------------------------------------------------------

(describe "describe-mode"
  (test "a layer's :doc is its description"
    (let (text (help-mode-text [{:name 'special :doc "A generated, read-only buffer."}] []))
      (assert= (includes? text "special — A generated, read-only buffer.") true)))
  (test "a layer with no :doc falls back to what it binds, not to a blank"
    (let (text (help-mode-text [{:name 'bare :keymap {"a" 'commands/cmd-one}}] []))
      (assert= (includes? text "bare — 1 binding") true)))
  (test "only the bindings actually in force are listed under a layer"
    (let (text (help-mode-text [{:name 'mode :doc "d"}]
                 [{:sequence ["a"] :command 'commands/cmd-live :layer 'mode :shadowed-by nil}
                   {:sequence ["b"]
                    :command 'commands/cmd-dead
                    :layer 'mode
                    :shadowed-by 'above}]))
      (assert= (includes? text "live") true)
      (assert= (includes? text "dead") false)))
  (test "the command runs and names the buffer's layers"
    (let (m (help/cmd-describe-mode (ht-model) nil))
      (assert= (:name (ed-current-buf m)) "*Modes*"))))

;; ---- apropos ----------------------------------------------------------------

(describe "apropos-command"
  (test "matches a substring of the command name, case-insensitively"
    (assert= (count (help-apropos-rows ["find-file" "save-buffer"] [] "FIND")) 1))
  (test "a row carries the key when the command is bound"
    (let (rows (help-apropos-rows ["find-file"]
                 [{:sequence [:ctrl-x :ctrl-f]
                   :command (interactive/command-sym "find-file")
                   :layer (quote emacs)
                   :shadowed-by nil}]
                 "find-file"))
      (assert= (includes? (first rows) "C-x C-f") true)))
  (test "a shadowed binding is NOT offered as the way to run it"
    ;; compared against the unshadowed row rather than searched for the key text:
    ;; `cmd-find-file`'s own docstring says "(C-x C-f)", so a substring test here passes
    ;; whatever the code does — which is how a green test comes to assert nothing
    (let (entry {:sequence [:ctrl-x :ctrl-f]
                 :command (interactive/command-sym "find-file")
                 :layer 'emacs}
          live (first (help-apropos-rows ["find-file"] [(assoc entry :shadowed-by nil)] "find-file"))
          dead (first (help-apropos-rows ["find-file"]
                        [(assoc entry :shadowed-by 'dired)]
                        "find-file")))
      (assert= (> (count live) (count dead)) true)))
  (test "no match is no rows, not an empty report"
    (assert= (count (help-apropos-rows ["find-file"] [] "zzz")) 0)))

;; ---- lossage ----------------------------------------------------------------

(describe "view-lossage"
  (test "keys are recorded in press order"
    (let (m (fold [:ctrl-a "x" :ctrl-e] (ht-model) (fn (acc k) (lossage/lossage-record acc k))))
      (assert= (:lossage m) [:ctrl-a "x" :ctrl-e])))
  (test "the ring is bounded, keeping the most recent"
    ;; `lossage-record` is on the dispatch path, so it trims in blocks rather than on every
    ;; key past the cap — the raw ring runs up to max+slack and `lossage-keys` takes the
    ;; tail. What must hold is that it is BOUNDED and that the newest key survives.
    (let (m (fold (range (* lossage/*lossage-max* 4))
              (ht-model)
              (fn (acc n) (lossage/lossage-record acc (str n))))
          newest (str (dec (* lossage/*lossage-max* 4))))
      (assert= (> (count (:lossage m)) (+ lossage/*lossage-max* lossage/*lossage-slack*)) false)
      (assert= (last (:lossage m)) newest)
      ;; what C-h l shows is exactly the cap, newest last
      (assert= (count (lossage/lossage-keys m)) lossage/*lossage-max*)
      (assert= (last (lossage/lossage-keys m)) newest)))
  (test "the ring is not trimmed on every keystroke past the cap"
    ;; the trim is the expensive half; paying it per key forever is what the slack avoids
    (let (m (fold (range (+ lossage/*lossage-max* 3))
              (ht-model)
              (fn (acc n) (lossage/lossage-record acc (str n)))))
      (assert= (count (:lossage m)) (+ lossage/*lossage-max* 3))))
  (test "dispatching a key records it — including one no keymap binds"
    ;; the whole point of C-h l: a key that did nothing is still in the list, which is
    ;; the only place the evidence exists
    (let (m (input/ed-dispatch (ht-model) :f13))
      (assert= (last (:lossage m)) :f13)))
  (test "an empty ring says so rather than showing an empty buffer"
    (let (m (help/cmd-view-lossage (ht-model) nil))
      (assert= (includes? (buffer-text (ed-current-buf m)) "No keys recorded") true))))

;; ---- describe-key names the layer ------------------------------------------

(describe "describe-key"
  (test "a bound key reports the layer it came from"
    (assert= (binding-layer (ht-model) [:ctrl-x :ctrl-f]) 'emacs))
  (test "an unbound key has no layer rather than a wrong one"
    (assert= (binding-layer (ht-model) [:f13]) nil))
  (test "C-h k says the layer in its echo line"
    (let (asked (input/ed-route-transient (input/ed-route-transient (ht-model) :ctrl-h) "k")
          told (input/ed-route-transient asked :ctrl-a))
      (assert= (includes? (:echo told) "(emacs layer)") true))))

;; ---- the report is cheap enough to run on a keypress -----------------------
;; Not timing (a test that asserts wall time is a flaky test) — asserting the SHAPE that
;; made it slow. `C-h a` rescanned every binding per matched row: 296 rows x 223 bindings,
;; which measured 629 ms of frozen loop. `help-key-index` inverts the list once.

(describe "the help reports do not rescan per row"
  (test "an empty apropos pattern matches nothing rather than every command"
    ;; every row costs a reflect/eval for its docstring, so "all of them" was ~700ms
    (assert= (count (help-apropos-rows (interactive/command-names) [] "")) 0)
    (assert= (count (help-apropos-rows (interactive/command-names) [] "   ")) 0))
  (test "the key index inverts the binding list once, keyed by M-x name"
    (let (m (ht-model)
          index (help/help-key-index (ht-entries m)))
      (assert= (get index "find-file") '("C-x C-f"))
      ;; keyed on the M-x name, never the symbol tail — the bug that made every
      ;; command report as unbound
      (assert= (get index "cmd-find-file") nil)))
  (test "a shadowed binding is absent from the index, not merely sorted last"
    (assert= (get (help/help-key-index [{:sequence [:ctrl-x "k"]
                                         :command 'pool/cmd-kill-buffer
                                         :layer 'emacs
                                         :shadowed-by 'dired}])
               "kill-buffer")
      nil))
  (test "lossage keeps the LAST partial row — the keys you came to read"
    ;; `partition` would drop it; `chunk-every` keeps it
    (let (text (lossage-text (into [] (map (range 25) (fn (n) (str n))))))
      (assert= (includes? text "24") true)
      (assert= (count (string/split text "\n")) 3))))

;; ---- describe-function (C-h f) ------------------------------------------------
;; The page, not the docstring's first line: every paragraph of the doc, the keys in force,
;; the parameters, the signature and where it lives.

(defn- ht-accept (m text)
  "`m`'s open minibuffer with `text` typed and RET pressed, through the dispatcher."
  (input/ed-update
    (assoc m
      :minibuffer
        (assoc (:minibuffer m)
          :edit (ed-mb-set-text (:edit (:minibuffer m)) text)
          ;; the typed text, not the top candidate (the prompt row)
          :sel -1))
    :enter 80
    24))

(describe "describe-function finds a typed name without reloading its module"
  ;; `keyhelp/ed-first-line` is `bedit/keyhelp/ed-first-line` here; resolving it once
  ;; required `'keyhelp` by that spelling and loaded the module a second time, redefining
  ;; every function in it (brood ADR-560)
  (test "the module is not run again"
    (let (before (%global-generation 'bedit/keyhelp/ed-first-line)
          found (help/help-function-symbol "keyhelp/ed-first-line"))
      (assert= found 'keyhelp/ed-first-line)
      (assert= (%global-generation 'bedit/keyhelp/ed-first-line) before))))

(describe "describe-function shows the whole page"
  (test "a command: its M-x name, module, keys, arguments, signature and every paragraph"
    (let (m (ht-model)
          sym (interactive/command-sym "find-file")
          text (help/describe-function-text m "find-file" sym)
          doc (ed-doc sym))
      (is (string/starts-with? text "find-file is an interactive command."))
      (is (includes? text "Keys       C-x C-f"))
      (is (includes? text "Module     "))
      (is (includes? text "Arguments  (m key)"))
      (is (includes? text "Signature  "))
      ;; the WHOLE docstring — its last line is on the page, not only its first
      (is (includes? doc "\n"))
      (is (includes? text (last (string/split (string/trim doc) "\n"))))))
  (test "a command on no key says how to run it"
    (let (m (ht-model)
          text (help/describe-function-text m
                 "package-update-prompt"
                 (interactive/command-sym "package-update-prompt")))
      (is (includes? text "Keys       none — M-x package-update-prompt"))))
  (test "a plain function: module, defining file and line, and no key row"
    (let (text (help/describe-function-text (ht-model)
                 "keyhelp/ed-first-line" 'keyhelp/ed-first-line))
      (is (string/starts-with? text "keyhelp/ed-first-line is a function."))
      (is (includes? text "Module     keyhelp"))
      (is (includes? text "src/keyhelp.blsp:"))
      (is (includes? text "Arguments  (s)"))
      (refute (includes? text "Keys "))
      (is (includes? text "The first line of string"))))
  (test "a `\\[command]` hole in the doc shows the live key"
    (is (includes? (help/describe-function-text (ht-model)
                     "help/cmd-describe-key" 'help/cmd-describe-key)
          "describe-key")))
  (test "C-h f opens *Help*; any qualified global may be typed; a name that is nothing says so"
    (let (opened (help/cmd-describe-function (ht-model) nil)
          typed (ht-accept opened "keyhelp/ed-first-line")
          missing (ht-accept (help/cmd-describe-function (ht-model) nil) "no-such/function-xyz"))
      (assert= (:name (ed-current-buf typed)) "*Help*")
      (is (includes? (buffer-text (ed-current-buf typed)) "keyhelp/ed-first-line is a function"))
      (assert= (:echo missing) "no function: no-such/function-xyz"))))

;; ---- describe-setting (C-h v) -------------------------------------------------

(defn- ht-spec (name) (settings/spec-of config/*settings* name))

(describe "describe-setting: an init.blsp setting's page"
  (test "unset: the default applies, and says so"
    (let (text (help/describe-setting-text (ht-model) (ht-spec :hl-line) {} {}))
      (is (string/starts-with? text ":hl-line is an init.blsp setting."))
      (is (includes? text "Type       bool"))
      (is (includes? text "Default    true"))
      (is (includes? text "Value      true"))
      (is (includes? text "Set by     the default (init.blsp does not set it)"))
      (is (includes? text "highlight the current line"))))
  (test "set in init.blsp: the value and where it came from"
    (let (text (help/describe-setting-text (ht-model)
                 (ht-spec :hl-line)
                 {:hl-line false}
                 {:hl-line false}))
      (is (includes? text "Value      false"))
      (is (includes? text "Set by     init.blsp ("))))
  (test "a value its type rejects: the default applies, and the page says why"
    (let (text (help/describe-setting-text (ht-model)
                 (ht-spec :hl-line)
                 {:hl-line "yes"}
                 {:hl-line "yes"}))
      (is (includes? text "Value      true"))
      (is (includes? text "init.blsp's \"yes\" is rejected: it wants bool"))))
  (test "a per-mode map lists each mode's value"
    (let (cfg {:line-numbers {:default false :prog :relative}}
          text (help/describe-setting-text (ht-model) (ht-spec :line-numbers) cfg cfg))
      (is (includes? text "Per mode"))
      (is (includes? text ":default  false"))
      (is (includes? text ":prog     :relative"))))
  (test "a value a command changed this session is shown beside the file's"
    (let (m (assoc (ht-model) :hl-line false)
          text (help/describe-setting-text m (ht-spec :hl-line) {} {}))
      (is (includes? text "Live       false   (changed in this session)"))))
  (test "init.blsp edited since it was loaded: the page says reload-config applies it"
    (let (text (help/describe-setting-text (ht-model) (ht-spec :hl-line) {} {:hl-line false}))
      (is (includes? text "init.blsp now says false — M-x reload-config applies it"))))
  (test "every declared setting is a candidate, a package's included"
    (let (names (help/setting-names))
      (is (includes? names "hl-line"))
      (is (includes? names "line-numbers"))))
  (test "C-h v opens *Help* for the setting typed, with or without its colon"
    (let (m (help/cmd-describe-setting (ht-model) nil)
          done (ht-accept m ":hl-line")
          missing (ht-accept (help/cmd-describe-setting (ht-model) nil) "no-such-setting"))
      (assert= (:name (ed-current-buf done)) "*Help*")
      (is (includes? (buffer-text (ed-current-buf done)) ":hl-line is an init.blsp setting"))
      (assert= (:echo missing) "no setting: no-such-setting"))))
