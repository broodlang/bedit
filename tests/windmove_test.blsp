;; tests/windmove_test.blsp — moving panes around: windmove (select in a direction),
;; buffer-move (swap with the neighbour and follow), rotate / transpose / flip / flop.
;;
;; The mechanism is std's `editor/pane` (pinned in brood's tests/pane_test.blsp); these pin
;; bedit's POLICY: the keys, that a swap follows the buffer, the echo at an edge, and that
;; the directional commands read the layout the last frame painted (`ed-layout-now`).

(defmodule windmove-test
  (:use test)
  (:use model)
  (:use input)
  (:use commands)
  (:use editor/buffer)
  (:use editor/pane)) ; pane-count / pane-selected-path / pane-payload-at
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn cur-name (m) (buffer-name (ed-current-buf m)))
(defn shown (m)
  ;; the buffer NAME in every pane, in traversal order
  (map (pane-leaf-paths (:layout m))
    (fn (p) (buffer-name (ed-buf-at m (:buffer (pane-payload-at (:layout m) p)))))))

(defn two-side-by-side ()
  ;; "left" selected on the left, "right" on the right — via C-x 3 and a switch, then one
  ;; frame so the layout is laid out
  (let (m (ed-init (make-buffer "l" "left"))
        m1 (assoc m :buffers (into (:buffers m) [(ed-stamp (make-buffer "r" "right"))]))
        split (press m1 [:ctrl-x "3"])
        ;; the new (right) pane shows the same buffer; point it at "right" then come back
        idx (ed-buffer-index-by-name! m1 "right")
        pointed (assoc split
                  :layout (pane-update-path (:layout split) '(:b) (fn (w) (assoc w :buffer idx)))))
    (press pointed [:ctrl-x "o" :ctrl-x "o"]))) ; two frames, back on the left
(describe "windmove: select the pane in a direction"
  (test "M-<right> selects the pane to the right; M-<left> comes back"
    (let (m (two-side-by-side))
      (assert= (cur-name m) "left")
      (assert= (cur-name (press m [:alt-right])) "right")
      (assert= (cur-name (press m [:alt-right :alt-left])) "left")))

  (test "at the edge it says so and stays"
    (let (m (press (two-side-by-side) [:alt-left]))
      (assert= (cur-name m) "left")
      (is (includes? (:echo m) "no window left"))))

  (test "up and down cross a stacked split"
    (let (m (press (ed-init (make-buffer "x" "only")) [:ctrl-x "2" :ctrl-x "o" :ctrl-x "o"]))
      (assert= (pane-selected-path (:layout m)) '(:a))
      (assert= (pane-selected-path (:layout (press m [:alt-down]))) '(:b))
      (assert= (pane-selected-path (:layout (press m [:alt-down :alt-up]))) '(:a)))))

(describe "buffer-move: C-S-<arrow> moves this window and follows it"
  (test "C-S-<right> swaps the two buffers and selection follows yours"
    (let (m (two-side-by-side)
          moved (press m [:ctrl-shift-right]))
      (assert= (shown m) (list "left" "right"))
      (assert= (shown moved) (list "right" "left"))
      (assert= (cur-name moved) "left") ; still on your buffer…
      (assert= (pane-selected-path (:layout moved)) '(:b)))) ; …one pane over
  (test "moving back restores the arrangement"
    (let (m (press (two-side-by-side) [:ctrl-shift-right :ctrl-shift-left]))
      (assert= (shown m) (list "left" "right"))
      (assert= (cur-name m) "left")
      (assert= (pane-selected-path (:layout m)) '(:a))))

  (test "at the edge nothing moves and the echo says which way"
    (let (m (press (two-side-by-side) [:ctrl-shift-up]))
      (assert= (shown m) (list "left" "right"))
      (is (includes? (:echo m) "no window up"))))

  (test "M-x swap-pane-right is the same command"
    (assert= (shown (commands/cmd-swap-pane-right (two-side-by-side) :none)) (list "right" "left"))))

(describe "rotate / transpose / flip / flop"
  (test "rotate-windows turns the buffers through the panes; a negative argument turns back"
    (let (m (two-side-by-side))
      (assert= (shown (commands/cmd-rotate-panes m :none)) (list "right" "left"))
      (assert= (cur-name (commands/cmd-rotate-panes m :none)) "right") ; selection stayed put
      (assert= (shown (commands/cmd-rotate-panes-backward m :none)) (list "right" "left"))))

  (test "transpose-windows turns a side-by-side split into a stacked one"
    (let (m (two-side-by-side)
          t (commands/cmd-transpose-panes m :none))
      (assert= (:dir (:layout m)) :col)
      (assert= (:dir (:layout t)) :row)
      (assert= (shown t) (list "left" "right"))))

  (test "flop-windows mirrors left-right; flip-windows leaves a side-by-side split alone"
    (let (m (two-side-by-side))
      (assert= (shown (commands/cmd-flop-panes m :none)) (list "right" "left"))
      (assert= (shown (commands/cmd-flip-panes m :none)) (list "left" "right")))))

(describe "the modified named keys reach their Emacs motions"
  (test "C-<right>/C-<left> are word motions, C-<backspace> kills the word before"
    (let (m (ed-init (make-buffer "alpha beta" "w")))
      (assert= (buffer-point (ed-current-buf (press m [:ctrl-right]))) 5)
      (assert= (buffer-point (ed-current-buf (press m [:ctrl-right :ctrl-right :ctrl-left]))) 6)
      (assert= (buffer-text (ed-current-buf (press m [:ctrl-right :ctrl-backspace]))) " beta"))))
