;; Tests for src/ui-kit.blsp — the widget kit. Pure `(area ctx) -> {:ops :zones}`, so it's
;; all assertable with no window: the zones a widget returns ARE its hit-test (via zone-at).
(defmodule ui-kit-test
  (:use test)
  (:use ui-kit)
  (:use editor/display) ; zone-at — proving the returned zones hit-test
  (:use-internals echoarea)
  (:use-internals view) ; ed-menu-widget (ed-menu-hit is hittest/) — the context-menu card geometry
  (:use minibuffer)
  (:use model)
  (:use commands))

(def ui-theme
  {:surface "#111111"
   :on-surface "#eeeeee"
   :muted "#888888"
   :selection "#0000ff"
   :on-selection "#000000"
   :border "#333333"})
(defn ui-context (gui?) {:gui? gui? :theme ui-theme})
(defn row-of (it i sel?) it) ; the items are already row maps ({:label :key :enabled :sep})
(describe "ui-kit — style resolves semantic roles"
  (test "fg/bg roles and bold map through the theme"
    (assert= {:fg "#eeeeee"} (ui-face ui-theme {:fg :on-surface}))
    (assert= {:fg "#000000" :bold true} (ui-face ui-theme {:fg :on-selection :bold true}))
    (assert= {} (ui-face ui-theme {}))))

(describe "ui-kit — list layout"
  (test "measure counts item + divider rows and sizes to the widest label+key"
    (let (items [{:label "Copy" :key "M-w" :enabled true}
                  {:label "Select All" :key "C-x h" :enabled true :sep true}]
          m (ui-list-measure items row-of 0))
      (assert= (:h m) 3) ; 2 items + 1 divider drawn above Select All
      (is (>= (:w m) (+ 3 (count "Select All") (count "C-x h"))))))
  (test "the list emits a zone per ENABLED item — none for disabled or dividers"
    (let (items [{:label "Copy" :key "M-w" :enabled true}
                  {:label "Cut" :key "C-w" :enabled false} ; disabled -> no zone
                  {:label "Select All" :key "C-x h" :enabled true :sep true}]
          widget (ui-list {:items items
                           :selected 0
                           :row row-of
                           :tag :menu-run
                           :style {:fg :on-surface :bg :surface}})
          res (widget [0 0 20 4] (ui-context false)))
      (assert= (count (:zones res)) 2) ; Copy + Select All; Cut (disabled) + divider none
      ;; the zones ARE the hit-test: a click on Copy's row resolves to its item index
      (assert= (:id (zone-at (:zones res) 1 0)) [:menu-run 0])
      ;; nothing under the disabled Cut row (screen row 1)
      (is (nil? (zone-at (:zones res) 1 1)))))
  (test "the selected row paints a highlight; every row paints its label"
    (let (widget (ui-list {:items [{:label "A" :enabled true} {:label "B" :enabled true}]
                           :selected 1
                           :row row-of
                           :tag :t
                           :style {:fg :on-surface :bg :surface}})
          res (widget [0 0 12 2] (ui-context false))
          texts (seq/filter (:ops res) (fn (op) (= (first op) :text))))
      (is (>= (count texts) 2)))) ; at least the two labels
  ;; The label and the key sit the SAME distance inside the row. Invisible until a row is
  ;; selected, and then it is the only thing you can see: the highlight is a pill, and the
  ;; text used to touch its right edge while floating a cell off its left.
  (test "a row's label and key are inset from its edges by the same amount"
    (let (row-ops (fn (style)
                    (ui-row-ops 0
                      0
                      20
                      {:label "Copy" :key "M-w" :enabled true}
                      false
                      ui-theme
                      style
                      false))
          text-at (fn (ops s)
                    (:col (first (seq/keep ops
                                   (fn (op)
                                     (when (and (= (first op) :text) (= (nth op 3 "") s))
                                       {:col (nth op 2)}))))))
          tight (row-ops {})
          roomy (row-ops {:inset :three}))
      ;; default: one cell in on the left, and the key ends one cell short of the right
      (assert= (text-at tight "Copy") 1)
      (assert= (+ (text-at tight "M-w") (count "M-w")) 19)
      ;; a roomier inset moves BOTH, by the same amount
      (assert= (text-at roomy "Copy") 3)
      (assert= (+ (text-at roomy "M-w") (count "M-w")) 17)))

  ;; Measured without the style, a roomier inset simply ate into the gap and the key column
  ;; crept left until it touched the label.
  (test "measuring reserves the inset and gap the rows will actually use"
    (let (items [{:label "Select All" :key "C-x h" :enabled true}]
          tight (ui-list-measure items row-of 0)
          roomy (ui-list-measure items row-of 0 {:inset :two :gap :three}))
      (assert= (:w tight) (+ 1 1 1 (count "Select All") (count "C-x h")))
      (assert= (:w roomy) (+ 2 2 3 (count "Select All") (count "C-x h")))))

  ;; A divider is a rule, not writing. Full width in the text colour it was the loudest
  ;; thing in the card — heavier than the labels it was separating.
  (test "a divider is inset to the text margin and drawn in the border colour"
    (let (widget (ui-list {:items [{:label "A" :enabled true}
                                    {:label "B" :enabled true :sep true}]
                           :selected nil
                           :row row-of
                           :tag :t
                           :style {:fg :on-surface :bg :surface :inset :two}})
          res (widget [0 0 20 3] (ui-context false))
          rule (first (seq/filter (:ops res)
                        (fn (op) (and (= (first op) :text) (includes? (nth op 3 "") "─"))))))
      (is (not (nil? rule)))
      (assert= (nth rule 2) 2) ; starts at the inset, not at col+1
      (assert= (count (nth rule 3)) 16) ; and stops the same distance short
      (assert= (:fg (nth rule 4)) (:border ui-theme)))))
(describe "ui-kit — panel wraps a body"
  (test "a panel draws a surface under the body and passes the body's zones through"
    (let (body (ui-list {:items [{:label "A" :enabled true}]
                         :selected nil
                         :row row-of
                         :tag :t
                         :style {:bg :surface}})
          res (ui-panel [0 0 12 1] (ui-context false) {:bg :surface :pad :popup} body))
      (is (> (count (:ops res)) 1)) ; surface + the body's label
      (assert= (count (:zones res)) 1)))) ; the body's one zone survives
;; A floating card (the completion popup / context menu): a flat cell-quantised `rect`
;; card in the terminal (and tests), a rounded sub-cell `frect` card in the GUI (:gui? on
;; the ctx). Same geometry either way, so the click zones still line up. (This coverage
;; moved here from the old completion_card_test when the popup migrated onto `ui-list`.)
(def card-style {:fg :on-surface :bg :surface :pad :popup :radius 0.5})
(defn card-rows (sel)
  (ui-list {:items [{:label "alpha" :enabled true} {:label "beta" :enabled true}]
            :selected sel
            :row row-of
            :tag :pick
            :style card-style}))
(defn op-tags (res) (map (:ops res) first))

(describe "ui-kit — a card lowers flat (terminal) vs rounded (GUI)"
  (test "without :gui? it's a solid rect card, no frect"
    (let (tags (op-tags (ui-panel [0 0 9 2] (ui-context false) card-style (card-rows 0))))
      (is (includes? tags :rect))
      (is (not (includes? tags :frect)))))
  (test "with :gui? it's a rounded frect card (surface + a selection pill), no rect"
    (let (tags (op-tags (ui-panel [0 0 9 2] (ui-context true) card-style (card-rows 0))))
      (is (includes? tags :frect))
      (is (not (includes? tags :rect)))
      ;; the card surface + one pill for the selected row = two frects
      (assert= (count (seq/filter tags (fn (t) (= t :frect)))) 2)))
  (test "both paths render every item as a text row"
    (let (flat (op-tags (ui-panel [0 0 9 3]
                          (ui-context false)
                          card-style
                          (ui-list {:items [{:label "a" :enabled true}
                                             {:label "b" :enabled true}
                                             {:label "c" :enabled true}]
                                    :selected 1
                                    :row row-of
                                    :tag :pick
                                    :style card-style})))
          gui (op-tags (ui-panel [0 0 9 3]
                         (ui-context true)
                         card-style
                         (ui-list {:items [{:label "a" :enabled true}
                                            {:label "b" :enabled true}
                                            {:label "c" :enabled true}]
                                   :selected 1
                                   :row row-of
                                   :tag :pick
                                   :style card-style}))))
      (assert= (count (seq/filter flat (fn (t) (= t :text)))) 3)
      (assert= (count (seq/filter gui (fn (t) (= t :text)))) 3))))

;; ---- the context menu card: padding vs the selection pill ------------------------
;; The card is rounded and the selected row is a full-width pill, so with no vertical
;; padding the highlight ran into the corner/hairline and the first + last items
;; looked clipped. The card must reserve a row above and below its content, and the
;; CLICK zones must move with it (one widget drives both, so they can't disagree).

(describe "context menu card geometry"
  (defn menu-model ()
    (let (m (model/ed-init (editor/buffer/make-buffer "abc\ndef")))
      (menu/ed-open-menu m 3 4)))

  (test "the card reserves a padding row above and below the item rows"
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          [_x y _cw ch] (:area w)
          rows (seq/keep (:ops w) (fn (op) (when (= (first op) :text) (nth op 1)))))
      ;; no text on the card's first or last row
      (is (> (first (sort rows)) y))
      (is (< (last (sort rows)) (+ y ch -1)))))

  ;; What the card actually looks like, asserted rather than eyeballed: every label starts
  ;; on the same column, every shortcut ENDS on the same column, and both sit the same
  ;; distance inside the card. A context menu is a handful of short rows with a shortcut
  ;; column — it can afford the room, and without it `Select All` and `C-x h` read as one
  ;; run-on string.
  (test "the menu's labels and shortcuts each form a column, inset alike"
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          [x _y cw _ch] (:area w)
          ;; the card's own inset: its `:menu` pad (1 cell) plus `:menu-row-inset` (2)
          edge (+ x 1 2)
          texts (seq/filter (:ops w)
                  (fn (op) (and (= (first op) :text) (not (includes? (nth op 3 "") "─")))))
          ;; labels start at the inset; shortcuts are right-ALIGNED, so they start wherever
          ;; their own length puts them and it is their END that forms the column
          labels (seq/filter texts (fn (op) (= (nth op 2) edge)))
          keys (seq/filter texts (fn (op) (> (nth op 2) edge)))
          key-ends (seq/distinct (map keys (fn (op) (+ (nth op 2) (count (nth op 3)))))))
      ;; every item contributed a label at the one column
      (is (>= (count labels) 4))
      ;; and every shortcut ends the same distance short of the other edge — one column,
      ;; whatever the shortcut's length
      (is (>= (count keys) 4))
      (assert= (count key-ends) 1)
      (assert= (first key-ends) (- (+ x cw) 1 2))))

  (test "a click on an enabled row still hits that row (zones follow the padding)"
    ;; "Select All" is the always-enabled item; a DISABLED row has no zone by design,
    ;; so it reads :inside (the menu stays open) — that's tested separately below.
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          sel-row (first (seq/keep (:ops w)
                           (fn (op)
                             (when (and (= (first op) :text) (= (nth op 3) "Select All"))
                               (nth op 1)))))
          hit (hittest/ed-menu-hit m 100 30 (+ 2 (nth (:area w) 0)) sel-row))
      (assert= [:run 3] hit)))

  (test "a click on a DISABLED row keeps the menu open rather than running anything"
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          copy-row (first (seq/keep (:ops w)
                            (fn (op)
                              (when (and (= (first op) :text) (= (nth op 3) "Copy"))
                                (nth op 1))))))
      (assert= :inside (hittest/ed-menu-hit m 100 30 (+ 2 (nth (:area w) 0)) copy-row))))

  (test "a click on the padding row stays inside the menu (doesn't dismiss it)"
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          [x y _cw _ch] (:area w))
      (assert= :inside (hittest/ed-menu-hit m 100 30 (+ x 2) y))))

  (test "a click outside the card dismisses (nil)"
    (let (m (menu-model)
          w (overlayview/ed-menu-widget m 100 30)
          [x y cw ch] (:area w))
      (assert= nil (hittest/ed-menu-hit m 100 30 (+ x cw 3) (+ y ch 3))))))

;; Widths in display CELLS, not characters (issues C6/C9).
(describe "ui-kit measures in cells"
  (test "ui-clip cuts a wide label at a cell boundary, ellipsis included"
    (assert= (ui-clip "日本語テキスト" 5) "日本…")
    (assert= (string/display-width (ui-clip "日本語テキスト" 5)) 5))
  (test "a row's label stops short of its key column"
    ;; ops are [:text row col text face]: the label's last cell must come before the key's
    (let ([label-op key-op] (into []
                              (ui-row-ops 0
                                0
                                12
                                {:label "a-very-long-label" :key "C-x" :enabled true}
                                false
                                nil
                                {}
                                false))
          label-end (+ (nth label-op 2) (string/display-width (nth label-op 3))))
      (is (< label-end (nth key-op 2))))))

(describe "which-key grid with wide glyphs"
  ;; Columns are measured in display cells; padding by CHARACTER count left a column after a
  ;; wide-glyph entry starting short — every later column drifted left by one cell per glyph.
  (test "the second column starts at the same screen column on every row"
    (let (rows (into [] (echoarea/ed-which-key-columns ["日本 x" "ab" "c" "d"] 2 80))
          column-of (fn (i text)
                      (let (row (str (nth rows i "")))
                        (string/display-width (string/substring row
                                                0
                                                (math/max 0 (index-of row text)))))))
      (assert= 2 (count rows))
      (assert= (column-of 0 "c") (column-of 1 "d")))))

;; A fuzzy query's matched characters, one colour per term (std/fuzzy's `:terms`, brood
;; ADR-429): the label is painted in RUNS laid side by side, never a glyph over a glyph.
(def ui-match-theme (merge ui-theme {:match-0 "#ff0000" :match-1 "#00ff00"}))
(defn label-runs (ops) (into [] (map ops (fn (op) [(nth op 2) (nth op 3) (nth op 4)]))))

(describe "ui-label-ops — matched characters by term"
  (test "no marks is one op, exactly as before"
    (assert= [[:text 0 1 "limits.ex" {:fg "#eeeeee"}]]
      (ui-label-ops 0 1 "limits.ex" "limits.ex" {:fg "#eeeeee"} [] ui-match-theme false)))
  (test "each term's characters in its own role, bold; the rest in the label's face"
    (assert= [[1 "lim" {:fg "#00ff00" :bold true}]
               [4 "its." {:fg "#eeeeee"}]
               [8 "ex" {:fg "#ff0000" :bold true}]]
      (label-runs (ui-label-ops 0
                    1
                    "limits.ex"
                    "limits.ex"
                    {:fg "#eeeeee"}
                    [[7 0] [8 0] [0 1] [1 1] [2 1]]
                    ui-match-theme
                    false))))
  (test "a selected row shows a match by weight, in the pill's own text colour"
    (assert= [[1 "lim" {:fg "#000000" :bold true}] [4 "its.ex" {:fg "#000000"}]]
      (label-runs (ui-label-ops 0
                    1
                    "limits.ex"
                    "limits.ex"
                    {:fg "#000000"}
                    [[0 0] [1 0] [2 0]]
                    ui-match-theme
                    true))))
  (test "a mark the clip cut off is not drawn — nor is the ellipsis marked"
    (assert= [[1 "lim" {:fg "#ff0000" :bold true}] [4 "it…" {:fg "#eeeeee"}]]
      (label-runs (ui-label-ops 0
                    1
                    "limits.ex"
                    "limit…"
                    {:fg "#eeeeee"}
                    [[0 0] [1 0] [2 0] [7 0] [8 0]]
                    ui-match-theme
                    false)))))

(describe "Plume rows carry what a fuzzy query matched"
  (test "a fuzzy-ranked prompt's rows carry marks; an empty query's carry none"
    (let (mb {:rank-source ["lib/limits.ex"] :edit (ed-mb-edit "Find: " "lim ex")}
          rows (echoarea/ed-plume-rows mb ["lib/limits.ex"] 80 60)
          plain (echoarea/ed-plume-rows (assoc mb :edit (ed-mb-edit "Find: " ""))
                  ["lib/limits.ex"]
                  80
                  60))
      (assert= [[4 0] [5 0] [6 0] [11 1] [12 1]] (:marks (first rows)))
      (assert= [] (:marks (first plain)))))
  (test "a prompt with its own candidates is left plain — its text is not a fuzzy query"
    (let (mb {:candidates-fn (fn (_t) ["a"]) :edit (ed-mb-edit "Path: " "a")})
      (assert= [] (:marks (first (echoarea/ed-plume-rows mb ["a"] 80 60)))))))

;; ---- the spacing table: token names only ----------------------------------------
;; One table of named steps (rows vertically, cells horizontally, half the only fraction);
;; a widget's `:pad` / `:inset` / `:gap` names a step and cannot hold a raw number.

(describe "ui-kit — spacing comes from the one table"
  (test "a token resolves through its alias to rows or cells"
    (assert= 1 (ui-space :row-inset))
    (assert= 3 (ui-space :menu-key-gap))
    (assert= 0.5 (ui-space :hover-pad))
    (assert= [1 2 1 2] (ui-space-box :card))
    (assert= [0 1 0 1] (ui-space-box :popup))
    (assert= [1 1 1 1] (ui-space-box :one)))

  (test "a card's padding looks equal: 1 row above and below to 2 cells at the sides"
    (let ([top right bottom left] (ui-space-box :card))
      (assert= right (* 2 top))
      (assert= left (* 2 bottom))))

  (test "the table's lengths are 0, a hairline, a half and whole steps — nothing else"
    (let (lengths (seq/filter (vals ui-spacing) number?))
      (is (every? lengths
            (fn (length) (or (int? length) (= length 0.5) (= length (ui-space :hairline))))))))

  (test "a raw number in a spacing position raises"
    (assert-error (ui-space 2))
    (assert-error (ui-space 0.55))
    (assert-error (ui-space :no-such-step))
    (assert-error (ui-row-inset {:inset 2}))
    (assert-error (ui-row-gap {:gap 3}))
    (assert-error (ui-pad [0 0 10 10] [1 1 1 1])))

  (test "text moves by whole rows and cells: a fractional step cannot place it"
    (assert-error (ui-space-cells :half))
    (assert-error (ui-pad [0 0 10 10] :half))
    (assert-error (ui-row-inset {:inset :hairline})))

  (test "a padded card grows by exactly what the padding takes back"
    (let ([w h] (ui-pad-size :card)
          inner (ui-pad [3 4 (+ 10 w) (+ 5 h)] :card))
      (assert= [5 5 10 5] inner))))

(describe "context menu card padding, against its token"
  (test "the pill sits 1 row and 1 cell inside the card, the text 2 more cells in"
    (let (m (assoc (menu/ed-open-menu (model/ed-init (editor/buffer/make-buffer "abc\ndef")) 3 4)
              :gui true)
          w (overlayview/ed-menu-widget m 100 30)
          [x y cw ch] (:area w)
          [top right bottom left] (ui-space-box :menu)
          inset (ui-space-cells :menu-row-inset)
          ;; the GUI pill is the one frect after the card's surface (and its hairline)
          pill (last (seq/filter (:ops w) (fn (op) (= (first op) :frect))))
          sel-row (nth pill 2)
          texts (seq/filter (:ops w) (fn (op) (= (first op) :text)))
          first-row (reduce (map texts (fn (op) (nth op 1))) math/min)
          last-row (reduce (map texts (fn (op) (nth op 1))) math/max))
      ;; vertical: one row between the border and the first and last item rows
      (assert= (+ y top) first-row)
      (assert= (- (+ y ch) bottom 1) last-row)
      ;; horizontal: the pill spans the card less its 1-cell padding each side (card-pill
      ;; draws a fixed sub-cell inset inside its row, std's)
      (is (>= (nth pill 1) (+ x left)))
      (is (< (nth pill 1) (+ x left 1)))
      (is (<= (+ (nth pill 1) (nth pill 3)) (- (+ x cw) right)))
      (is (> (+ (nth pill 1) (nth pill 3)) (- (+ x cw) right 1)))
      ;; the label sits the row inset inside the pill: 3 cells from the border in all
      (is (number? sel-row))
      (assert= (+ x left inset) (reduce (map texts (fn (op) (nth op 2))) math/min))
      (assert= 3 (+ left inset)))))

;; ---- one placement rule for every floating card --------------------------------------
;; A transient sat with its bottom edge ON the mode line (2026-11-05 screenshot), a context
;; menu opened near the bottom covered the mode line and the echo area, and one opened under
;; a header line covered the header. Every floating card is now placed by `ui-place`: it keeps
;; `:card-gap` from the chrome around the stage it floats over and from the window's edges.

(defn- gap-rows () (first (ui-space-box :card-gap)))
(defn- gap-cells () (nth (ui-space-box :card-gap) 3))

(defn- card-model (&optional (header-line false))
  (assoc (model/ed-init (editor/buffer/make-buffer "abc\ndef")) :header-line header-line :gui true))

(defn- modeline-row (m rows)
  "The bottom mode line's row: the last body row, above the echo area."
  (dec (- rows (minibuffer/ed-echo-rows m rows))))

(def- test-menu
  {:name 'placement-menu
   :title "Push"
   :groups [{:title "Arguments"
             :suffixes [{:key "-f"
                         :kind :switch
                         :arg "--force-with-lease"
                         :label "Force with lease"}]}
             {:title "Push to"
              :suffixes [{:key "p"
                          :kind :command
                          :command 'motion/cmd-forward-char
                          :label "origin"}]}]})

(describe "ui-place — the one placement rule"
  (test "a card wanting the stage's bottom edge keeps the gap above it"
    (let ([col row _w h] (ui-place [0 18 10 4] [0 0 80 22] 80 24))
      (assert= 22 (+ row h (gap-rows)))
      (assert= (gap-cells) col)))
  (test "a card wanting the stage's top edge keeps the gap below it"
    (let ([_ row _ _] (ui-place [5 1 10 4] [0 1 80 20] 80 24))
      (assert= (+ 1 (gap-rows)) row)))
  (test "a card at the right edge keeps the gap from the window edge"
    (let ([col _ w _] (ui-place [75 5 10 4] [0 0 80 22] 80 24))
      (assert= (- 80 (gap-cells)) (+ col w))))
  (test "a card with room is left where it wants to be"
    (assert= [10 5 10 4] (ui-place [10 5 10 4] [0 0 80 22] 80 24)))
  (test "without room for the gap the card keeps to the stage, never over the chrome"
    (let ([_ row _ h] (ui-place [0 0 10 21] [0 1 80 21] 80 24))
      (is (>= row 1))
      (is (<= (+ row h) 22))))
  (test "a card taller than the stage keeps to the screen"
    (let ([_ row _ h] (ui-place [0 10 10 23] [0 1 80 21] 80 24))
      (assert= [1 23] [row h])))
  (test "a tooltip goes above its anchor, and below it when the room above is short"
    (let ([_ above-row _ h] (ui-tooltip-area 10 5 ["one" "two"] [0 0 80 22] 80 24)
          [_ below-row _ _] (ui-tooltip-area 2 5 ["one" "two"] [0 1 80 21] 80 24))
      (assert= 10 (+ above-row h))
      (assert= 3 below-row))))

(describe "every floating card keeps the gap from the chrome"
  (test "the transient at the bottom keeps the gap above the mode line"
    (let (m (transient/ed-transient-open (card-model) test-menu)
          [_ row _ h] (:area (overlayview/ed-transient-widget m 100 30)))
      (assert= (modeline-row m 30) (+ row h (gap-rows)))))
  (test "the transient keeps the gap above the mode line with a header line on too"
    (let (m (transient/ed-transient-open (card-model true) test-menu)
          [col row _ h] (:area (overlayview/ed-transient-widget m 100 30)))
      (assert= (modeline-row m 30) (+ row h (gap-rows)))
      (assert= (gap-cells) col)))
  (test "a context menu opened at the bottom keeps the gap above the mode line"
    (let (m (menu/ed-open-menu (card-model) 27 6)
          [_ row _ h] (:area (overlayview/ed-menu-widget m 100 30)))
      (assert= (modeline-row m 30) (+ row h (gap-rows)))))
  (test "a context menu opened near the top keeps the gap below the header line"
    ;; the header line is row 0; the first text row is 1
    (let (m (menu/ed-open-menu (card-model true) 0 6)
          [_ row _ _] (:area (overlayview/ed-menu-widget m 100 30)))
      (assert= (+ 1 (gap-rows)) row)))
  (test "a context menu in a split's upper pane keeps off THAT pane's mode line"
    (let (m (window-commands/cmd-split-pane-below (card-model) nil)
          upper (first (seq/sort-by (:panes (panes/ed-body-layout m 100 30))
                         (fn (pane) (second (:rect pane)))))
          [_ y _ h] (:rect upper)
          bar (+ y (dec h))
          opened (menu/ed-open-menu m (dec bar) 6)
          [_ row _ card-h] (:area (overlayview/ed-menu-widget opened 100 30)))
      (assert= bar (+ row card-h (gap-rows)))))
  (test "a mode line tooltip keeps the gap above the bar it describes"
    (let (lines ["branch: main" "clean"]
          stage [0 0 80 23]
          ops (statusbar/statusbar-tooltip-ops (list (statusbar/seg :b "main" {:tooltip lines}))
                :b {}
                10
                23
                80
                24
                false
                stage)
          rows-used (map (seq/filter ops (fn (op) (= (first op) :text))) (fn (op) (nth op 1))))
      (assert= (- 23 (gap-rows)) (inc (reduce rows-used math/max))))))
