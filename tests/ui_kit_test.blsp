;; Tests for src/ui-kit.blsp — the widget kit. Pure `(area ctx) -> {:ops :zones}`, so it's
;; all assertable with no window: the zones a widget returns ARE its hit-test (via zone-at).
(defmodule ui-kit-test
  (:use test)
  (:use ui-kit)
  (:use editor/display) ; zone-at — proving the returned zones hit-test
  (:use-internals view) ; ed-menu-widget / ed-menu-hit — the context-menu card geometry
  (:use model)
  (:use commands))

(def ui-theme
  {:surface "#111111"
   :on-surface "#eeeeee"
   :muted "#888888"
   :selection "#0000ff"
   :on-selection "#000000"
   :border "#333333"})
(defn ui-context (gui?) {:gui? gui? :theme ui-theme})
(defn row-of (it i sel?) it) ; the items are already row maps ({:label :key :enabled :sep})
(describe "ui-kit — style resolves semantic roles"
  (test "fg/bg roles and bold map through the theme"
    (assert= {:fg "#eeeeee"} (ui-face ui-theme {:fg :on-surface}))
    (assert= {:fg "#000000" :bold true} (ui-face ui-theme {:fg :on-selection :bold true}))
    (assert= {} (ui-face ui-theme {}))))

(describe "ui-kit — list layout"
  (test "measure counts item + divider rows and sizes to the widest label+key"
    (let (items [{:label "Copy" :key "M-w" :enabled true}
                  {:label "Select All" :key "C-x h" :enabled true :sep true}]
          m (ui-list-measure items row-of 0))
      (assert= (:h m) 3) ; 2 items + 1 divider drawn above Select All
      (is (>= (:w m) (+ 3 (string-length "Select All") (string-length "C-x h"))))))
  (test "the list emits a zone per ENABLED item — none for disabled or dividers"
    (let (items [{:label "Copy" :key "M-w" :enabled true}
                  {:label "Cut" :key "C-w" :enabled false} ; disabled -> no zone
                  {:label "Select All" :key "C-x h" :enabled true :sep true}]
          widget (ui-list {:items items
                           :selected 0
                           :row row-of
                           :tag :menu-run
                           :style {:fg :on-surface :bg :surface}})
          res (widget [0 0 20 4] (ui-context false)))
      (assert= (count (:zones res)) 2) ; Copy + Select All; Cut (disabled) + divider none
      ;; the zones ARE the hit-test: a click on Copy's row resolves to its item index
      (assert= (:id (zone-at (:zones res) 1 0)) [:menu-run 0])
      ;; nothing under the disabled Cut row (screen row 1)
      (is (nil? (zone-at (:zones res) 1 1)))))
  (test "the selected row paints a highlight; every row paints its label"
    (let (widget (ui-list {:items [{:label "A" :enabled true} {:label "B" :enabled true}]
                           :selected 1
                           :row row-of
                           :tag :t
                           :style {:fg :on-surface :bg :surface}})
          res (widget [0 0 12 2] (ui-context false))
          texts (filter (fn (op) (= (first op) :text)) (:ops res)))
      (is (>= (count texts) 2))))) ; at least the two labels
(describe "ui-kit — panel wraps a body"
  (test "a panel draws a surface under the body and passes the body's zones through"
    (let (body (ui-list {:items [{:label "A" :enabled true}]
                         :selected nil
                         :row row-of
                         :tag :t
                         :style {:bg :surface}})
          res (ui-panel [0 0 12 1] (ui-context false) {:bg :surface :pad [0 1 0 1]} body))
      (is (> (count (:ops res)) 1)) ; surface + the body's label
      (assert= (count (:zones res)) 1)))) ; the body's one zone survives
;; A floating card (the completion popup / context menu): a flat cell-quantised `rect`
;; card in the terminal (and tests), a rounded sub-cell `frect` card in the GUI (:gui? on
;; the ctx). Same geometry either way, so the click zones still line up. (This coverage
;; moved here from the old completion_card_test when the popup migrated onto `ui-list`.)
(def card-style {:fg :on-surface :bg :surface :pad [0 1 0 1] :radius 0.5})
(defn card-rows (sel)
  (ui-list {:items [{:label "alpha" :enabled true} {:label "beta" :enabled true}]
            :selected sel
            :row row-of
            :tag :pick
            :style card-style}))
(defn op-tags (res) (map first (:ops res)))

(describe "ui-kit — a card lowers flat (terminal) vs rounded (GUI)"
  (test "without :gui? it's a solid rect card, no frect"
    (let (tags (op-tags (ui-panel [0 0 9 2] (ui-context false) card-style (card-rows 0))))
      (is (member? :rect tags))
      (is (not (member? :frect tags)))))
  (test "with :gui? it's a rounded frect card (surface + a selection pill), no rect"
    (let (tags (op-tags (ui-panel [0 0 9 2] (ui-context true) card-style (card-rows 0))))
      (is (member? :frect tags))
      (is (not (member? :rect tags)))
      ;; the card surface + one pill for the selected row = two frects
      (assert= (count (filter (fn (t) (= t :frect)) tags)) 2)))
  (test "both paths render every item as a text row"
    (let (flat (op-tags (ui-panel [0 0 9 3]
                          (ui-context false)
                          card-style
                          (ui-list {:items [{:label "a" :enabled true}
                                             {:label "b" :enabled true}
                                             {:label "c" :enabled true}]
                                    :selected 1
                                    :row row-of
                                    :tag :pick
                                    :style card-style})))
          gui (op-tags (ui-panel [0 0 9 3]
                         (ui-context true)
                         card-style
                         (ui-list {:items [{:label "a" :enabled true}
                                            {:label "b" :enabled true}
                                            {:label "c" :enabled true}]
                                   :selected 1
                                   :row row-of
                                   :tag :pick
                                   :style card-style}))))
      (assert= (count (filter (fn (t) (= t :text)) flat)) 3)
      (assert= (count (filter (fn (t) (= t :text)) gui)) 3))))

;; ---- the context menu card: padding vs the selection pill ------------------------
;; The card is rounded and the selected row is a full-width pill, so with no vertical
;; padding the highlight ran into the corner/hairline and the first + last items
;; looked clipped. The card must reserve a row above and below its content, and the
;; CLICK zones must move with it (one widget drives both, so they can't disagree).

(describe "context menu card geometry"
  (defn menu-model ()
    (let (m (model/ed-init (editor/buffer/make-buffer "abc\ndef")))
      (commands/ed-open-menu m 3 4)))

  (test "the card reserves a padding row above and below the item rows"
    (let (m (menu-model)
          w (view/ed-menu-widget m 100 30)
          [x y cw ch] (:area w)
          rows (keep (fn (op) (when (= (first op) :text) (nth op 1))) (:ops w)))
      ;; no text on the card's first or last row
      (is (> (first (sort rows)) y))
      (is (< (last (sort rows)) (+ y ch -1)))))

  (test "a click on an enabled row still hits that row (zones follow the padding)"
    ;; "Select All" is the always-enabled item; a DISABLED row has no zone by design,
    ;; so it reads :inside (the menu stays open) — that's tested separately below.
    (let (m (menu-model)
          w (view/ed-menu-widget m 100 30)
          sel-row (first (keep (fn (op)
                                 (when (and (= (first op) :text)
                                         (= (nth op 3) "Select All"))
                                   (nth op 1)))
                           (:ops w)))
          hit (view/ed-menu-hit m 100 30 (+ 2 (nth (:area w) 0)) sel-row))
      (assert= [:run 3] hit)))

  (test "a click on a DISABLED row keeps the menu open rather than running anything"
    (let (m (menu-model)
          w (view/ed-menu-widget m 100 30)
          copy-row (first (keep (fn (op)
                                  (when (and (= (first op) :text)
                                          (= (nth op 3) "Copy"))
                                    (nth op 1)))
                            (:ops w))))
      (assert= :inside (view/ed-menu-hit m 100 30 (+ 2 (nth (:area w) 0)) copy-row))))

  (test "a click on the padding row stays inside the menu (doesn't dismiss it)"
    (let (m (menu-model)
          w (view/ed-menu-widget m 100 30)
          [x y cw ch] (:area w))
      (assert= :inside (view/ed-menu-hit m 100 30 (+ x 2) y))))

  (test "a click outside the card dismisses (nil)"
    (let (m (menu-model)
          w (view/ed-menu-widget m 100 30)
          [x y cw ch] (:area w))
      (assert= nil (view/ed-menu-hit m 100 30 (+ x cw 3) (+ y ch 3))))))
