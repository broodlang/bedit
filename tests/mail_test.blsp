;; mail: mbox-mode, eml-mode and the decoded *Message* view (src/mail.blsp).

(defmodule mail-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use model)
  (:use pool)
  (:use main)
  (:use editor/buffer)
  (:use test))

;; A model whose current buffer is `text` opened under `file` (name = file), point 0.
(defn- file-cm (text file) (ed-init (make-buffer text file file)))

;; ---- mbox-mode ---------------------------------------------------------------------
(def mbox-src
  "From alice@example.com Mon Oct 12 10:00:00 2026\nFrom: Alice <alice@example.com>\nSubject: Lunch?\nReceived: from a\n  by b\n\nNote: this is the body.\n> quoted\n-- \nAlice\n\nFrom bob@example.com Mon Oct 12 11:00:00 2026\nSubject: Re: Lunch?\n\nYes.\n")

(describe "mbox-mode"
  (test "a .mbox buffer is in mbox-mode, and so is a file named mbox"
    (assert= (ed-buf-mode-name (cur (file-cm mbox-src "inbox.mbox"))) "mbox")
    (assert= (ed-buf-mode-name (cur (file-cm mbox-src "mbox"))) "mbox"))

  (test "the separator, header names, the subject, quotes and the signature are faced"
    (let (spans (mail/mbox-spans mbox-src)
          face-at (fn (needle)
                    (let (at (index-of mbox-src needle))
                      (nth (seq/find spans (fn (s) (and (<= (first s) at) (< at (second s))))) 2)))
          face (fn (f) (editor/face/face f)))
      (assert= (face-at "From alice") (face :syntax/function))
      (assert= (face-at "From: Alice") (face :syntax/keyword))
      (assert= (face-at "Lunch?") (face :syntax/doc))
      (assert= (face-at "> quoted") (face :syntax/comment))
      (assert= (face-at "Alice\n\nFrom bob") (face :syntax/comment))
      (assert= (face-at "From bob") (face :syntax/function))))

  (test "a body line that looks like a header is not one, and a folded header is left alone"
    (let (spans (mail/mbox-spans mbox-src)
          plain? (fn (needle)
                   (let (at (index-of mbox-src needle))
                     (nil? (seq/find spans (fn (s) (and (<= (first s) at) (< at (second s)))))))))
      (is (plain? "Note: this"))
      (is (plain? "  by b"))))

  (test "the fontify restart is the message boundary"
    (assert= (mail/mbox-fontify-restart mbox-src (index-of mbox-src "> quoted")) 0)
    (assert= (mail/mbox-fontify-restart mbox-src (index-of mbox-src "Yes."))
      (index-of mbox-src "From bob"))
    (assert= (mail/mbox-fontify-restart mbox-src (index-of mbox-src "From bob"))
      (index-of mbox-src "From bob")))

  (test "C-c C-n / C-c C-p step between messages"
    (let (m (file-cm mbox-src "inbox.mbox")
          next (mail/cmd-mbox-next-message m nil)
          past (mail/cmd-mbox-next-message next nil)
          back (mail/cmd-mbox-previous-message next nil))
      (assert= (editor/buffer/buffer-point (cur next)) (index-of mbox-src "From bob"))
      (assert= (editor/buffer/buffer-point (cur past)) (index-of mbox-src "From bob"))
      (assert= (:echo past) "No next message")
      (assert= (editor/buffer/buffer-point (cur back)) 0)))

  (test "C-c C-p from inside a message, or just past its start, lands on that start"
    (let (m (file-cm mbox-src "inbox.mbox")
          bob (index-of mbox-src "From bob")
          from (fn (point)
                 (editor/buffer/buffer-point (cur (mail/cmd-mbox-previous-message (ed-set-buf m
                                                                                    (editor/buffer/goto-char (cur m)
                                                                                      point))
                                                    nil)))))
      (assert= (from (index-of mbox-src "Yes.")) bob)
      (assert= (from (inc bob)) bob)
      (assert= (from bob) 0)
      (assert= (from 1) 0)
      (assert= (:echo (mail/cmd-mbox-previous-message m nil)) "No previous message"))))

;; ---- eml-mode ----------------------------------------------------------------------
(def eml-src
  "Subject: =?utf-8?Q?caf=C3=A9?=\nFrom: René <r@example.org>\n\nNote: the body.\n> quoted\n")

(describe "eml-mode"
  (test "an .eml buffer is in eml-mode"
    (assert= (ed-buf-mode-name (cur (file-cm eml-src "note.eml"))) "eml"))
  (test "it starts in the headers, with no From line to open them"
    (let (spans (mail/eml-spans eml-src)
          face-at (fn (needle)
                    (let (at (index-of eml-src needle))
                      (nth (seq/find spans (fn (s) (and (<= (first s) at) (< at (second s)))))
                        2 nil))))
      (assert= (face-at "Subject:") (editor/face/face :syntax/keyword))
      (assert= (face-at "=?utf-8") (editor/face/face :syntax/doc))
      (assert= (face-at "Note: the") nil)
      (assert= (face-at "> quoted") (editor/face/face :syntax/comment))))

  ;; eml is a LINE LEXER (no restart could be right below its headers): the pane keeps each
  ;; line's state, and an edit re-lexes the lines it touched. Its lines must colour exactly
  ;; as the whole-message `:fontify` does — and so must mbox's.
  (test "eml and mbox are line lexers that agree with their whole-text colouring"
    (let (agree (fn (mode-file src whole)
                  (let (m (file-cm src mode-file)
                        builder (linecache/buffer-line-lexer (cur m))
                        rope (text/string-> src)
                        [_ spans] (editor/line-cache/line-cache-update (editor/line-cache/line-cache)
                                    ((reflect/eval builder))
                                    rope
                                    0
                                    (text/line-count rope)))
                    (assert= (seq/filter (into [] spans) (fn (s) (< (first s) (second s))))
                      (seq/filter (into [] (whole src)) (fn (s) (< (first s) (second s))))))))
      (agree "note.eml" eml-src mail/eml-spans)
      (agree "inbox.mbox" mbox-src mail/mbox-spans)))
  (test "a body line below an edit in the headers keeps its body colouring"
    ;; the state a line starts in comes from the line above, not a restart guess: a body
    ;; `Note:` line is never a header, however far it is from the top
    (let (src (str "Subject: hi\n\n" (string/join (map (range 300) (fn (i) (str "Note: " i))) "\n"))
          rope (text/string-> src)
          lexer (mail/eml-line-lexer)
          [cache _] (editor/line-cache/line-cache-update (editor/line-cache/line-cache)
                      lexer rope 0 5)
          edited (text/string-> (str "X-New: 1\n" src))
          [_ spans] (editor/line-cache/line-cache-update cache lexer edited 280 290))
      (is (empty? (seq/filter (into [] spans) (fn (s) (< (first s) (second s)))))))))

;; ---- the decoded view ----------------------------------------------------------------
(def multipart-src
  (string/join ["Subject: =?utf-8?B?SMOpbGxv?="
                 "From: =?iso-8859-1?Q?Ren=E9?= <r@example.org>" "To: a@example.org,"
                 "  b@example.org" "X-Mailer: not shown" "Content-Type: multipart/mixed; boundary=b"
                 "" "--b" "Content-Type: text/plain; charset=utf-8"
                 "Content-Transfer-Encoding: quoted-printable" "" "Caf=C3=A9." "> quoted" "--b"
                 "Content-Type: application/pdf"
                 "Content-Disposition: attachment; filename=report.pdf"
                 "Content-Transfer-Encoding: base64" "" "JVBERi0xLjQK" "--b--" ""]
    "\n"))

(describe "mail-render"
  (test "the shown headers decoded, the text body, then the attachments"
    (assert= (:text (mail/mail-render (mail-message/parse multipart-src)))
      (string/join ["From:     René <r@example.org>"
                     "To:       a@example.org, b@example.org" "Subject:  Héllo" "" "Café."
                     "> quoted" "" "[report.pdf]  application/pdf, 9 B" ""]
        "\n")))
  (test "header names, the subject, quotes and attachments are faced"
    (let (shown (mail/mail-render (mail-message/parse multipart-src))
          text (:text shown)
          face-at (fn (needle)
                    (let (at (index-of text needle))
                      (nth (seq/find (:spans shown)
                             (fn (s) (and (<= (first s) at) (< at (second s)))))
                        2 nil))))
      (assert= (face-at "From:") (editor/face/face :syntax/keyword))
      (assert= (face-at "Héllo") (editor/face/face :syntax/doc))
      (assert= (face-at "René") nil)
      (assert= (face-at "> quoted") (editor/face/face :syntax/comment))
      (assert= (face-at "[report.pdf]") (editor/face/face :syntax/function))))
  (test "an attachment is found by its line"
    (let (shown (mail/mail-render (mail-message/parse multipart-src)))
      (assert= (map (vec (:attachments shown))
                 (fn ([line part]) [line (mail-message/filename part)]))
        '([7 "report.pdf"])))))

(describe "C-c C-v"
  (test "in an .eml, shows the whole message decoded in *Message*"
    (let (m (mail/cmd-mail-view (file-cm multipart-src "note.eml") nil))
      (assert= (buffer-name (cur m)) "*Message*")
      (is (string/starts-with? (buffer-text (cur m)) "From:     René"))
      (assert= (keys (:mail-attachments m)) '(7))))
  (test "in an mbox, shows the message at point, its >From lines unquoted"
    (let (src (str "From a@example.org Mon Oct 12 10:00:00 2026\nSubject: one\n\nfirst\n"
                "From b@example.org Mon Oct 12 11:00:00 2026\nSubject: two\n\n>From the start\n")
          m (file-cm src "inbox.mbox")
          at-second (ed-set-buf m (goto-char (cur m) (index-of src "two")))
          first-view (buffer-text (cur (mail/cmd-mail-view m nil)))
          second-view (buffer-text (cur (mail/cmd-mail-view at-second nil))))
      (assert= first-view "Subject:  one\n\nfirst\n")
      (assert= second-view "Subject:  two\n\nFrom the start\n")))
  (test "RET off an attachment line says so"
    (let (m (mail/cmd-mail-view (file-cm multipart-src "note.eml") nil))
      (assert= (:echo (mail/cmd-mail-save-attachment m nil)) "No attachment on this line"))))
