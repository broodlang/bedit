;; diff-hl change gutter (src/diffhl.blsp): the pure HEAD-vs-buffer line diff → per-line
;; status map, and the gutter glyph/face. The HEAD blob fetch (a git subprocess) and the
;; live gutter rendering are exercised by hand against a real repo, not here.

(defmodule diffhl-test (:use test) (:use-internals diffhl))

(describe "diffhl: per-line status map"
  (test "identical text → no changes"
    (assert= (diffhl/diffhl-status-map "a\nb\nc" "a\nb\nc") {}))
  (test "an inserted line is :added"
    (assert= (diffhl/diffhl-status-map "a\nb" "a\nx\nb") {1 :added}))
  (test "a replaced line is :modified"
    (assert= (diffhl/diffhl-status-map "a\nOLD\nc" "a\nNEW\nc") {1 :modified}))
  (test "a removed line marks the following line :deleted"
    (assert= (diffhl/diffhl-status-map "a\nGONE\nc" "a\nc") {1 :deleted}))
  (test "an append at end of file is :added"
    (assert= (diffhl/diffhl-status-map "a" "a\nb") {1 :added}))
  (test "a trailing newline difference is not a change"
    (assert= (diffhl/diffhl-status-map "a\nb\n" "a\nb") {})
    (assert= (diffhl/diffhl-status-map "a\nb" "a\nb\n") {}))
  (test "two added lines in a row are both :added"
    (assert= (diffhl/diffhl-status-map "a\nb" "a\nx\ny\nb") {1 :added 2 :added}))
  (test "replacing two lines marks both :modified"
    (assert= (diffhl/diffhl-status-map "a\nO1\nO2\nd" "a\nN1\nN2\nd") {1 :modified 2 :modified}))
  (test "a rope is diffed as its text"
    (assert= (diffhl/diffhl-status-map "a\nb\n" (text/string-> "a\nx\nb\n")) {1 :added}))
  ;; deliberately :added, all of them: the git subprocess this replaced saw the empty base
  ;; as one empty line and called the first new line :modified (brood ADR-468)
  (test "every line against an empty base is :added"
    (assert= (diffhl/diffhl-status-map "" "a\nb\n") {0 :added 1 :added}))
  (test "a line added in a run of equal lines is marked where it was typed"
    (assert= (diffhl/diffhl-status-map "f(\n  a\n)\n\ng(\n  b\n)\n"
               "f(\n  a\n)\n\ng(\n  c\n)\n\ng(\n  b\n)\n")
      {4 :added 5 :added 6 :added 7 :added})))

(describe "diffhl: gutter bar + face"
  (test "the bar chunk reflects the status"
    (assert= (diffhl/bar-chunk :added) [:bar (:fg diffhl/face-diff-added)])
    (assert= (diffhl/bar-chunk :modified) [:bar (:fg diffhl/face-diff-modified)])
    (assert= (diffhl/bar-chunk :deleted) ["▁" diffhl/face-diff-deleted])
    (assert= (diffhl/bar-chunk nil) [" " nil]))
  (test "an unchanged line has no bar face; changed lines are coloured"
    (is (nil? (diffhl/bar-face nil)))
    (assert= (diffhl/bar-face :added) diffhl/face-diff-added)
    (assert= (diffhl/bar-face :modified) diffhl/face-diff-modified)
    (assert= (diffhl/bar-face :deleted) diffhl/face-diff-deleted)))

(describe "diffhl: moving between the changes"
  (test "a change starts where a marked line follows an unmarked one, or one of another kind"
    (assert= (diffhl/diffhl-hunk-starts {2 :added 3 :added 4 :modified 7 :modified 9 :deleted})
      (list 2 4 7 9))
    (assert= (diffhl/diffhl-hunk-starts {}) '())
    (assert= (diffhl/diffhl-hunk-starts nil) '())))

;; ---- the base text, remembered while HEAD stands ----------------------------------

(defn- dh-git (dir args) (os/cmd "git" args {:cwd dir}))

(defn- dh-repo (name)
  "A repo with one commit holding `a.txt`."
  (let (dir (path/temp (str "bedit-diffhl-test-" name "-")))
    (os/cmd "rm" ["-rf" dir] {:cwd "/"})
    (file/mkdir dir)
    (dh-git dir ["init" "-q" "-b" "main"])
    (dh-git dir ["config" "user.email" "t@example.com"])
    (dh-git dir ["config" "user.name" "Test"])
    (dh-git dir ["config" "commit.gpgsign" "false"])
    (file/spit (path/join dir "a.txt") "one\ntwo\n")
    (dh-git dir ["add" "-A"])
    (dh-git dir ["commit" "-qm" "base"])
    dir))

(describe "diffhl: the base text is read again only when HEAD moves"
  (test "a file's base identity holds until a commit moves the branch"
    (let (dir (dh-repo "identity")
          path (path/join dir "a.txt")
          before (diffhl/diffhl-base-identity path))
      (is (not (nil? before)))
      ;; an edit to the working file is not a new base
      (file/spit path "one\ntwo\nthree\n")
      (assert= (diffhl/diffhl-base-identity path) before)
      (dh-git dir ["commit" "-qam" "more"])
      (is (not (= (diffhl/diffhl-base-identity path) before)))
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})))
  (test "a remembered base is reused while its identity holds, read afresh once it moves"
    (let (dir (dh-repo "reuse")
          path (path/join dir "a.txt")
          ;; a base text the checkout never had: only the memo could answer it
          planted {:identity (diffhl/diffhl-base-identity path) :text "planted\n"})
      (assert= (:text (diffhl/diffhl-base path planted)) "planted\n")
      (assert= (:status (diffhl/diffhl-compute path "planted\nx\n" planted)) {1 :added})
      (file/spit path "changed\n")
      (dh-git dir ["commit" "-qam" "moved"])
      (assert= (:text (diffhl/diffhl-base path planted)) "changed\n")
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})))
  (test "a branch switch is a new base"
    (let (dir (dh-repo "branch")
          path (path/join dir "a.txt")
          _ (dh-git dir ["branch" "other"])
          on-main (diffhl/diffhl-base-identity path))
      (dh-git dir ["checkout" "-q" "other"])
      (is (not (= (diffhl/diffhl-base-identity path) on-main)))
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})))
  (test "outside a checkout there is no identity, so nothing is remembered"
    (let (dir (path/temp "bedit-diffhl-test-plain-"))
      (file/mkdir dir)
      (file/spit (path/join dir "a.txt") "x\n")
      (is (nil? (diffhl/diffhl-base-identity (path/join dir "a.txt"))))
      (assert= (diffhl/diffhl-compute (path/join dir "a.txt") "x\n" nil)
        {:status {} :base {:identity nil :text nil}})
      (os/cmd "rm" ["-rf" dir] {:cwd "/"}))))
