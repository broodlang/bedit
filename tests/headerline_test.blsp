;; The header line above each pane (src/headerline.blsp): Emacs's breadcrumb-mode — the file
;; by its project and path, then where point is inside it. The layout gives it the pane's top
;; row (`panes/ed-header-layout`), so the text and the mouse move down with it.
(defmodule headerline-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use panes)
  (:use headerline)
  (:use theme)) ; the palette the header is drawn from

(defn- texts (ops row)
  (map (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text) (= (nth op 1) row))))
    (fn (op) (nth op 3))))

(describe "where the buffer is"
  (test "a file inside a project: the project's name, then the path under it"
    (let (root (temp-dir "bedit-header-")
          _ (file/mkdir root)
          _ (file/spit (path/join root "project.blsp") "(project :name \"p\")")
          _ (file/mkdir (path/join root "src"))
          file (path/join root "src" "a.blsp"))
      (assert= (location (make-buffer "x" "a.blsp" file))
        (str (path/basename root) "/src/a.blsp"))))
  (test "a buffer without a file: its name"
    (assert= (location (make-buffer "x" "*scratch*")) "*scratch*")))

(describe "where point is"
  (test "an Org buffer's crumbs are the headings point is under"
    (let (text "* Plan\n** Week one\nnotes\n** Week two\ndetail"
          buf (goto-char (make-buffer text "p.org" "/tmp/p.org") (count text))
          m (ed-init buf))
      (assert= (crumbs (ed-current-buf m)) (list "Plan" "Week two"))))
  (test "a mode without crumbs has none"
    (assert= (crumbs (make-buffer "x" "*scratch*")) '())))

(describe "the header row"
  (test "off, the pane starts at the top; on, it starts a row lower under its header"
    (let (m (ed-init (make-buffer "first\nsecond" "*scratch*"))
          off (first (:panes (ed-body-layout m 40 10)))
          on (first (:panes (ed-body-layout (assoc m :header-line true) 40 10))))
      (assert= (second (:rect off)) 0)
      (assert= (second (:rect on)) 1)
      (assert= (:header-row on) 0)
      (assert= (nth (:rect on) 3) (dec (nth (:rect off) 3)))))
  (test "a mode whose first line says where it is (dired's `/dir:`) has no header line"
    (let (dir (temp-dir "bedit-header-dired-")
          _ (file/mkdir dir)
          m (dired/ed-show-dired (assoc (ed-init (make-buffer "x" "*scratch*")) :header-line true)
              dir)
          pane (first (:panes (ed-body-layout m 40 10)))
          ops (view/ed-view m 40 10))
      (is (nil? (:header-row pane)))
      (assert= (second (:rect pane)) 0)
      (is (any? (texts ops 0) (fn (text) (string/starts-with? text "/tmp/bedit-header-dired-"))))))
  (test "the view paints the location on row 0 and the text from row 1"
    (let (m (assoc (ed-init (make-buffer "first\nsecond" "*scratch*")) :header-line true)
          ops (view/ed-view m 40 10))
      (is (any? (texts ops 0) (fn (t) (= t "*scratch*"))))
      (is (any? (texts ops 1) (fn (t) (includes? t "first"))))))
  (test "a click lands on the line under it, the header row taken into account"
    (let (m (assoc (ed-init (make-buffer "first\nsecond" "*scratch*")) :header-line true)
          clicked (input/ed-update m [:mouse :press :left 2 6] 40 10))
      (assert= (buffer-current-line (ed-current-buf clicked)) 1))))

(describe "what floats beside point, under a header"
  (test "the completion popup opens below the cursor's row and past the gutter"
    ;; header row 0, lines 0-1 on rows 1-2, the cursor's line 2 on row 3: the card from row 4,
    ;; and at the cursor's column past the 4-column gutter
    (let (m (assoc (ed-init (make-buffer "hello\nhexagon\nhe" "*scratch*")) :header-line true)
          m (ed-set-buf m (goto-char (ed-current-buf m) 16))
          popup (complete-at-point/cmd-complete m nil)
          labels (seq/filter (view/ed-view popup 40 10)
                   (fn (op)
                     (and (vector? op)
                       (= (first op) :text)
                       (includes? (nth op 3) "hello")
                       (> (nth op 1) 3)))))
      (is (not (nil? (:completion popup))))
      (is (not (empty? labels)))
      (is (every? labels (fn (op) (>= (nth op 1) 4))))
      (is (every? labels (fn (op) (>= (nth op 2) 4)))))))

(describe "the header stands apart from the text under it"
  (test "its row is painted on its own surface, not the buffer's"
    (let (ops (header-ops (make-buffer "x" "*scratch*") 0 0 40)
          background (seq/find ops (fn (op) (and (vector? op) (= (first op) :rect))))
          face (last background))
      (is (not (nil? (:bg face))))
      (assert= (:bg face) *mantle*)
      (is (not (= (:bg face) *base*))))))
(describe "the header's text is inset from the pane's edges, as the mode line's is"
  ;; flush, its first glyph sat on the window's left edge (clipped there) and hard against
  ;; the divider in a right-hand pane
  (test "one cell in from the left, wherever the pane starts"
    (let (left (header-ops (make-buffer "x" "*scratch*") 0 0 40)
          right (header-ops (make-buffer "x" "*scratch*") 41 0 40)
          first-text (fn (ops) (seq/find ops (fn (op) (and (vector? op) (= (first op) :text))))))
      (assert= (nth (first-text left) 2) 1)
      (assert= (nth (first-text right) 2) 42)))
  (test "and cut a cell before the right edge"
    (let (ops (header-ops (make-buffer "x" "a-name-longer-than-the-pane") 0 0 10)
          shown (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text)))))
      (assert= (string/join (map shown (fn (op) (nth op 3))) "") "a-name-l")
      ;; the background still spans the whole row
      (assert= (nth (seq/find ops (fn (op) (and (vector? op) (= (first op) :rect)))) 3) 10))))

(describe "the header is subtle: chrome, not content"
  (test "nothing in it is bold, and nothing is as bright as the code's text"
    (let (faces [face-header-line face-header-crumb face-header-separator])
      (is (not (any? faces :bold)))
      (is (not (any? faces (fn (face) (= (:fg face) *text*))))))))
