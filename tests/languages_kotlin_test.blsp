;; Kotlin (src/languages/kotlin.blsp): a `deflanguage` over fwcd/tree-sitter-kotlin. The mode half
;; needs no grammar; the parsed half needs `libtree-sitter-kotlin.so` (M-x grammar-install) and
;; SKIPS without it.
(defmodule languages-kotlin-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer indents load-test-grammar]))

(describe "kotlin, the mode"
  (test "a .kts file opens in kotlin mode too"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/build.gradle.kts")) "kotlin"))
  (test "it parses with tree-sitter-kotlin, comments with // and formats with ktfmt or ktlint"
    (assert= (ed-mode-service (file-buffer "" "/p/a.kt") :ts-lang) :kotlin)
    (assert= (:url (grammarfallback/grammar-source :kotlin))
      "https://github.com/fwcd/tree-sitter-kotlin")
    (assert= (ed-mode-service (file-buffer "" "/p/a.kt") :comment-syntax) "// ")
    (assert= (get languages/kotlin/kotlin-spec :format)
      [["ktfmt" "--kotlinlang-style"] ["ktlint" "-F"]]))
  (test "the restart: a column-0 item, the one before a raw string still open across it"
    (let (src "package app\n\nfun f() {\n    g()\n}\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))
    (let (src "val s = \"\"\"\nfun x() {\n\"\"\"\nfun f() {\n    g()\n}\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))
    (let (src "package app\n\nfun f() {\n    val s = \"\"\"\nfun x() {\n    g()\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))))

;; The sample (tests/corpus/kotlin/Greeter.kt, laid out as ktfmt --kotlinlang-style writes it) is
;; checked by tests/language_corpus_test.blsp: its mode, its colours (caret assertions and a
;; golden listing), its indentation and its restart.

(describe "kotlin, its definitions"
  (test "a class, an object and a function are definitions C-M-a stops at"
    (let (kinds (:kinds (get languages/kotlin/kotlin-spec :definitions)))
      (doseq (kind [:class_declaration :object_declaration :function_declaration])
        (is (contains? kinds kind))))))

;; A lambda with its parameters on the `{` line hangs (brood ADR-758's `:hanging`).
(def- kotlin-lambda-src
  "fun main() {\n    names.forEach { item ->\n        println(item)\n    }\n    call(a,\n         b)\n}\n")

(describe "kotlin, a lambda's body"
  :skip-unless (load-test-grammar :kotlin)
  "no kotlin grammar"
  (test "a `{ item ->` lambda's body goes one level in, a call's arguments still align"
    (let ([got want] (indents kotlin-lambda-src "/p/Lambda.kt")) (assert= got want))))
