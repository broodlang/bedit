;; Kotlin (src/languages/kotlin.blsp): a `deflanguage` over fwcd/tree-sitter-kotlin. The mode half
;; needs no grammar; the parsed half needs `libtree-sitter-kotlin.so` (M-x grammar-install) and
;; SKIPS without it.
(defmodule languages-kotlin-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "kotlin, the mode"
  (test "a .kt and a .kts file open in kotlin mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/Greeter.kt")) "kotlin")
    (assert= (ed-buf-mode-name (file-buffer "" "/p/build.gradle.kts")) "kotlin"))
  (test "it parses with tree-sitter-kotlin, comments with // and formats with ktfmt or ktlint"
    (assert= (ed-mode-service (file-buffer "" "/p/a.kt") :ts-lang) :kotlin)
    (assert= (:url (model/grammar-source :kotlin)) "https://github.com/fwcd/tree-sitter-kotlin")
    (assert= (ed-mode-service (file-buffer "" "/p/a.kt") :comment-syntax) "// ")
    (assert= (get languages/kotlin/kotlin-spec :format)
      [["ktfmt" "--kotlinlang-style"] ["ktlint" "-F"]]))
  (test "the restart: a column-0 item, the one before a raw string still open across it"
    (let (src "package app\n\nfun f() {\n    g()\n}\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))
    (let (src "val s = \"\"\"\nfun x() {\n\"\"\"\nfun f() {\n    g()\n}\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))
    (let (src "package app\n\nfun f() {\n    val s = \"\"\"\nfun x() {\n    g()\n")
      (assert= (languages/kotlin/kotlin-restart src (index-of src "    g()"))
        (index-of src "fun f")))))

;; the sample is laid out as its formatter writes it: ktfmt --kotlinlang-style

(def kotlin-src
  "// the greeter
package app.greet

import kotlin.math.max

/** A greeter. */
@JvmInline
value class Name(val value: String)

data class Point(val x: Int, val y: Int = 0)

sealed interface Shape {
    fun area(): Double
}

enum class Color(val rgb: Int) {
    RED(0xFF0000),
    GREEN(0x00FF00);

    fun next(): Color = GREEN
}

object Registry {
    private const val MAX = 10L
    val names = mutableListOf<String>()
}

class Greeter<T : Any>(private val name: String) : Base(), Runnable {
    companion object {
        fun create(): Greeter<String> = Greeter(\"x\")
    }

    init {
        require(name.isNotEmpty())
    }

    override fun run() {
        val names = listOf(\"a\", \"b\")
        for (each in names) {
            if (each.isEmpty()) {
                continue
            } else {
                println(greet(each, 1.5, true))
            }
        }
        val kind =
            when (names.size) {
                0 -> \"none\"
                1 -> {
                    \"one\"
                }
                else -> \"many\"
            }
        names.forEach {
            log(it)
        }
        val message = \"hi $name and ${name.length} done\"
        val block =
            \"\"\"
            raw ${kind}
            \"\"\"
                .trimIndent()
        val nothing: String? = null
        val letter = 'c'
        try {
            work(arrayOf(1, 2))
        } catch (e: RuntimeException) {
            throw e
        } finally {
            super.toString()
        }
    }

    private fun greet(
        who: String,
        weight: Double,
        loud: Boolean,
    ): String {
        return \"hello \" + who
    }
}

fun String.shout(): String = uppercase()
")

(when (load-test-grammar :kotlin)
  (describe "kotlin, parsed"
    (def kotlin-spans (languages/kotlin/kotlin-fontify kotlin-src))
    (test "comments and keywords; a soft keyword used as a name is not one"
      (assert= (face-at kotlin-spans kotlin-src "// the") (face-of :syntax/comment))
      (assert= (face-at kotlin-spans kotlin-src "/** A") (face-of :syntax/comment))
      (assert= (face-at kotlin-spans kotlin-src "data class") (face-of :syntax/keyword))
      (assert= (face-at kotlin-spans kotlin-src "companion") (face-of :syntax/keyword))
      (assert= (face-at kotlin-spans kotlin-src "value: String") (face-of :syntax/variable)))
    (test "a type's name and an annotation are specials"
      (assert= (face-at kotlin-spans kotlin-src "Point") (face-of :syntax/special))
      (assert= (face-at kotlin-spans kotlin-src "Registry") (face-of :syntax/special))
      (assert= (face-at kotlin-spans kotlin-src "@JvmInline") (face-of :syntax/special))
      (assert= (face-at kotlin-spans kotlin-src "Runnable") (face-of :syntax/special)))
    (test "a function's name is a definition, an extension's too"
      (assert= (face-at kotlin-spans kotlin-src "run()") (face-of :syntax/definition))
      (assert= (face-at kotlin-spans kotlin-src "area()") (face-of :syntax/definition))
      (assert= (face-at kotlin-spans kotlin-src "shout()") (face-of :syntax/definition)))
    (test "a call, a method call and a trailing-lambda call are functions"
      (assert= (face-at kotlin-spans kotlin-src "listOf") (face-of :syntax/function))
      (assert= (face-at kotlin-spans kotlin-src "isEmpty") (face-of :syntax/function))
      (assert= (face-at kotlin-spans kotlin-src "forEach") (face-of :syntax/function))
      (assert= (face-at kotlin-spans kotlin-src "trimIndent") (face-of :syntax/function)))
    (test "literals: strings, a char, numbers, constants, an enum entry"
      (assert= (face-at kotlin-spans kotlin-src "\"a\"") (face-of :syntax/string))
      (assert= (face-at kotlin-spans kotlin-src "'c'") (face-of :syntax/string))
      (assert= (face-at kotlin-spans kotlin-src "10L") (face-of :syntax/number))
      (assert= (face-at kotlin-spans kotlin-src "0xFF0000") (face-of :syntax/number))
      (assert= (face-at kotlin-spans kotlin-src "1.5") (face-of :syntax/number))
      (assert= (face-at kotlin-spans kotlin-src "true") (face-of :syntax/constant))
      (assert= (face-at kotlin-spans kotlin-src "null") (face-of :syntax/constant))
      (assert= (face-at kotlin-spans kotlin-src "RED") (face-of :syntax/constant)))
    (test "a string template's text is a string and the code inside it is code"
      (assert= (face-at kotlin-spans kotlin-src "\"hi $") (face-of :syntax/string))
      (assert= (face-at kotlin-spans kotlin-src "name and") nil)
      (assert= (face-at kotlin-spans kotlin-src " and ${") (face-of :syntax/string)))
    (test "it indents every line: bodies, a when, a broken property, a chain, a try"
      (let ([got want] (indents kotlin-src "/p/Greeter.kt")) (assert= got want)))
    (test "a class, an object and a function are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/kotlin/kotlin-spec :definitions)))
        (doseq (kind [:class_declaration :object_declaration :function_declaration])
          (is (contains? kinds kind)))))))

;; A lambda with its parameters on the `{` line hangs (brood ADR-758's `:hanging`). Asked only of
;; a runtime that knows the key — one whose `language-names` reports a `:hanging` kind.
(def- kotlin-lambda-src
  "fun main() {\n    names.forEach { item ->\n        println(item)\n    }\n    call(a,\n         b)\n}\n")

(when (and (load-test-grammar :kotlin)
        (contains? (:kinds (editor/treesit/language-names {:indent {:hanging #{:probe}}})) :probe))
  (describe "kotlin, a lambda's body"
    (test "a `{ item ->` lambda's body goes one level in, a call's arguments still align"
      (let ([got want] (indents kotlin-lambda-src "/p/Lambda.kt")) (assert= got want)))))
