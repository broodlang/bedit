;; Completion-at-point (src/complete-at-point.blsp): the Emacs `completion-at-point`
;; contract — one boundary rule across sources, unique → insert, common-prefix
;; expansion before any popup, alphabetical candidates.

(defmodule complete-test
  (:use test)
  (:use eldoc) ; ed-refresh-preview
  (:use model)
  (:use editor/buffer)
  (:use editor/highlight)
  (:use complete-at-point)
  (:use-internals complete-at-point)) ; complete-word-before-point, qualified

(defn- blsp-model (text)
  "A brood-mode model whose point is at the END of `text`."
  (ed-init (goto-char (make-buffer text "x.blsp" "x.blsp") (string/length text))))

(defn- text-of (m) (buffer-text (ed-current-buf m)))

(describe "completion: one word-boundary rule for every source"
  (test "reader-macro prefixes are not part of the symbol"
    (assert= (symbol-prefix-at "'foo" 4) [1 "foo"])
    (assert= (symbol-prefix-at "`(defn" 6) [2 "defn"])
    (assert= (symbol-prefix-at "~@xs" 4) [2 "xs"])
    (assert= (symbol-prefix-at "^pat" 4) [1 "pat"]))
  (test "a qualified name is one symbol for completion (math/fl completes as a unit)"
    (assert= (symbol-prefix-at "(math/fl" 8) [1 "math/fl"]))
  (test "the buffer-word scan and the mode source agree on where the prefix starts"
    (let (m (blsp-model "(defn quoted-thing (x) x) 'quoted-th"))
      ;; the mode source fixes the region at the symbol after the quote; the buffer-word
      ;; source must agree, or its candidate (the only one) is dropped and Tab does nothing
      (assert= (text-of (cmd-complete m :tab)) "(defn quoted-thing (x) x) 'quoted-thing"))))

(describe "completion: Tab behaves like Emacs completion-at-point"
  (test "a function just written in the buffer (not yet evaluated) completes"
    (let (m (blsp-model "(defn my-brand-new-helper (x) x)\n(my-brand-ne"))
      (assert= (text-of (cmd-complete m :tab))
        "(defn my-brand-new-helper (x) x)\n(my-brand-new-helper")))
  (test "a unique candidate is inserted, no popup"
    (let (m2 (cmd-complete (blsp-model "(def solitary-name 1) solit") :tab))
      (assert= (text-of m2) "(def solitary-name 1) solitary-name")
      (is (nil? (:completion m2)))))
  (test "several candidates: the longest common prefix is inserted first, no popup"
    (let (m2 (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) al") :tab))
      (assert= (text-of m2) "(def alpha-one 1) (def alpha-two 2) alpha-")
      (is (nil? (:completion m2)))))
  (test "when nothing more can be expanded, the popup lists the candidates alphabetically"
    (let (m2 (cmd-complete (blsp-model "(def alpha-two 2) (def alpha-one 1) alpha-") :tab))
      (assert= (text-of m2) "(def alpha-two 2) (def alpha-one 1) alpha-")
      (assert= (:items (:completion m2)) (list "alpha-one" "alpha-two"))
      (assert= (:index (:completion m2)) 0)))
  (test "a loaded global completes through the mode source"
    (let (m2 (cmd-complete (blsp-model "(string/starts-wi") :tab))
      (assert= (text-of m2) "(string/starts-with?")))
  (test "no candidates echoes a note and leaves the text alone"
    (let (m2 (cmd-complete (blsp-model "zzqq-nothing-like-this") :tab))
      (assert= (text-of m2) "zzqq-nothing-like-this")
      (is (nil? (:completion m2)))))
  (test "an empty prefix is a no-op"
    (let (m2 (cmd-complete (blsp-model "(foo ") :tab))
      (assert= (text-of m2) "(foo ")
      (is (nil? (:completion m2))))))

(describe "completion: the popup narrows and accepts"
  (test "typing into the popup narrows it; Enter accepts the selection"
    (let (m1 (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) alpha-") :tab)
          m2 (complete-handle m1 "t")
          m3 (complete-handle m2 :enter))
      (assert= (:items (:completion m2)) (list "alpha-two"))
      (assert= (text-of m3) "(def alpha-one 1) (def alpha-two 2) alpha-two")
      (is (nil? (:completion m3))))))

;; ---- the inline preview (Emacs 30's `completion-preview-mode`) ----------------------
;; The top candidate's remainder, shown after point in a dim face as you type. Everything
;; below is the rules that keep it a suggestion rather than a distraction.
(describe "the inline completion preview"
  (defn- pv (text)
    "The preview for a buffer whose point is at the end of `text`."
    (completion-preview (complete-index-refresh (ed-init (goto-char (make-buffer text)
                                                           (string/length text))))))

  (test "the remainder of the top candidate, not the whole word"
    ;; what is painted sits AFTER the cursor, so it must not repeat what is already typed
    (let (p (pv "alphabetical algorithm\nalp"))
      (assert= (:text p) "habetical")
      (assert= (:prefix p) "alp")))

  (test "sorted order, so the suggestion does not change under your hands"
    ;; `alp` matches both; a preview that re-ranked as you typed would show a different
    ;; word each keystroke, and the one thing it has to be is predictable enough to accept
    ;; without reading twice
    (assert= (preview-candidate (list "zeta" "alpha" "alphabet") "alph") "alpha"))

  (test "a candidate that only equals the prefix is no suggestion at all"
    (is (nil? (preview-candidate (list "alp") "alp")))
    (is (nil? (preview-candidate '() "alp"))))

  ;; Emacs' `completion-preview-minimum-symbol-length`: below three characters almost
  ;; anything matches, so the suggestion is noise flickering under your hands.
  (test "a short prefix suggests nothing"
    (is (nil? (pv "alphabetical\nal")))
    (is (nil? (pv "alphabetical\na")))
    (is (not (nil? (pv "alphabetical\nalp")))))

  ;; The one concession to the renderer: text drawn mid-line would sit ON the characters
  ;; after point rather than pushing them along, and a preview that obscures your own code
  ;; is worse than none.
  (test "nothing mid-line — only where there is room after the cursor"
    (let (m (ed-init (goto-char (make-buffer "alphabetical\nalp tail") 16)))
      (is (nil? (completion-preview m)))))

  ;; nothing typed there could accept it — and in a char-mode terminal point is the
  ;; program's cursor, so a suggestion after it is the editor guessing at the program
  (test "nothing in a read-only buffer"
    (let (b (set-read-only (goto-char (make-buffer "alphabetical\nalp") 16) true))
      (is (nil? (completion-preview (complete-index-refresh (ed-init b)))))))

  ;; a line-mode terminal or a shell is narrowed to its input, not read-only
  (test "but one in an input region at the end of a narrowed buffer"
    (let (b (goto-char (narrow-to (make-buffer "alphabetical\nalp") [[13 16]]) 16))
      (assert= (:text (completion-preview (complete-index-refresh (ed-init b)))) "habetical")))

  (test "nothing when there is no word before point"
    (is (nil? (pv "alphabetical\n")))
    (is (nil? (pv ""))))

  ;; The preview asks only the instant sources. Tab is a request you pressed and can wait
  ;; for; the preview recomputes every time typing settles, so a source that blocks for a
  ;; second would block the editor loop for a second, repeatedly.
  (test "the preview's sources never include a server"
    (is (not (includes? *preview-sources* 'lsp/lsp-complete-source)))
    (is (includes? *preview-sources* 'complete-at-point/complete-source-index-words)))

  ;; M-n / M-p — Emacs' `completion-preview-next-candidate`. The first suggestion is a
  ;; guess; cycling is how you say "nearly, the one after it" without abandoning what you
  ;; have typed to open a popup and read a list.
  (test "M-n walks to the next candidate, M-p back"
    (let (m (ed-init (goto-char (make-buffer "alpha alphabet alphabetical\nalp") 31))
          m1 (assoc m :completion-preview (completion-preview (complete-index-refresh m)))
          m2 (preview-handle m1 :meta-n)
          m3 (preview-handle m2 :meta-p))
      (assert= (:text (:completion-preview m1)) "ha")
      (assert= (:text (:completion-preview m2)) "habet")
      (assert= (:text (:completion-preview m3)) "ha")))

  (test "cycling wraps — a ring, not a key that stops working"
    (let (pv {:prefix "alp" :items ["alpha" "alphabet"]}
          last (preview-at pv 1)
          wrapped (preview-at pv 2)
          back (preview-at pv -1))
      (assert= (:text last) "habet")
      (assert= (:index wrapped) 0)
      (assert= (:index back) 1)))

  (test "accepting takes the candidate you cycled to, not the first"
    (let (m (ed-init (goto-char (make-buffer "alpha alphabet alphabetical\nalp") 31))
          m1 (assoc m :completion-preview (completion-preview (complete-index-refresh m)))
          m2 (preview-handle (preview-handle m1 :meta-n) :meta-n)
          m3 (cmd-complete m2 :tab))
      (assert= (buffer-text (ed-current-buf m3)) "alpha alphabet alphabetical\nalphabetical")))

  (test "the idle beat leaves a cycled preview where you put it"
    ;; recomputing a preview the text has not changed under would walk it back to the first
    ;; candidate while your hands were off the keys
    (let (m (ed-init (goto-char (make-buffer "alpha alphabet alphabetical\nalp") 31))
          m1 (ed-refresh-preview m)
          m2 (preview-handle m1 :meta-n)
          m3 (ed-refresh-preview m2))
      (assert= (:text (:completion-preview m2)) "habet")
      (assert= (:text (:completion-preview m3)) "habet")))

  (test "a preview consumes M-n / M-p and nothing else"
    ;; every other key falls through untouched: a preview sits beside what you are doing,
    ;; it is not a mode you have to leave
    (is (preview-control-key? :meta-n))
    (is (preview-control-key? :meta-p))
    (is (not (preview-control-key? :tab)))
    (is (not (preview-control-key? :escape)))
    (is (not (preview-control-key? "a"))))

  (test "cycling an empty or absent preview is a no-op, not a crash"
    (let (m (ed-init (make-buffer "x")))
      (assert= (:completion-preview (preview-cycle m 1)) nil)
      (assert= (:completion-preview (preview-cycle (assoc m :completion-preview {:items []}) 1))
        {:items []})))

  (test "accepting inserts the remainder and clears the preview"
    (let (m (ed-init (goto-char (make-buffer "alphabetical\nalp") 16))
          m1 (assoc m :completion-preview {:start 13 :prefix "alp" :text "habetical"})
          m2 (preview-accept m1))
      (assert= (buffer-text (ed-current-buf m2)) "alphabetical\nalphabetical")
      (is (nil? (:completion-preview m2)))))

  (test "Tab takes the preview rather than asking the sources again"
    ;; the suggestion is already on screen under the cursor, so the key that means "yes,
    ;; that one" should be the key your hand is on
    (let (m (ed-init (goto-char (make-buffer "alphabetical\nalp") 16))
          m1 (assoc m :completion-preview {:start 13 :prefix "alp" :text "habetical"})
          m2 (cmd-complete m1 :tab))
      (assert= (buffer-text (ed-current-buf m2)) "alphabetical\nalphabetical")
      ;; and no popup was opened on the way
      (is (nil? (:completion m2)))))

  (test "with no preview showing, Tab is the completion it always was"
    (let (m (ed-init (goto-char (make-buffer "alphabetical\nalp") 16))
          m2 (cmd-complete m :tab))
      (assert= (buffer-text (ed-current-buf m2)) "alphabetical\nalphabetical"))))

(describe "completion: M-< / M-> reach the ends of the popup"
  ;; the same two keys the minibuffer's candidate list and the context menu take, meaning
  ;; the same two ends — a popup was the last select you could only step through
  (test "M-> selects the last item and M-< the first"
    (let (m1 (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) (def alpha-three 3) alpha-")
               :tab)
          n (count (:items (:completion m1)))
          bottom (complete-handle m1 (keyword "alt->")))
      (is (> n 1)) ; a list of one would pass either way
      (assert= (:index (:completion bottom)) (dec n))
      (assert= (:index (:completion (complete-handle bottom (keyword "alt-<")))) 0)))

  (test "the popup consumes them rather than dismissing itself"
    ;; `complete-control-key?` gates what the popup sees at all: a key missing from it
    ;; closes the popup and is processed as an ordinary editing key
    (is (complete-control-key? (keyword "alt-<")))
    (is (complete-control-key? (keyword "alt->")))))

(describe "the popup closes when it stops describing where you are"
  ;; It outlived every path that was not a key. A key the popup does not own already
  ;; dismisses it (`overlay-exit`); a MOUSE click never reaches the overlays at all —
  ;; `ed-mouse` folds it directly — so clicking away left the list on screen, anchored to a
  ;; line you had left and drawn over code it had nothing to do with.
  (test "moving point away makes it stale, and staying put does not"
    (let (m (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) alpha-") :tab))
      (is (not (nil? (:completion m))))
      (is (not (complete-at-point/popup-stale? m))) ; where it was opened
      (let (moved (ed-set-buf m (goto-char (ed-current-buf m) 0)))
        (is (complete-at-point/popup-stale? moved))
        (is (nil? (:completion (complete-at-point/close-stale-popup moved)))))))

  (test "a click elsewhere closes it — the case that was broken"
    (let (m (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) alpha-") :tab)
          ;; what a click does: it moves point, and nothing else
          clicked (ed-set-buf m (goto-char (ed-current-buf m) 3)))
      (is (nil? (:completion (complete-at-point/close-stale-popup clicked))))))

  (test "narrowing keeps it open — the popup follows what you type"
    (let (m (cmd-complete (blsp-model "(def alpha-one 1) (def alpha-two 2) alpha-") :tab)
          typed (complete-handle m "t"))
      (is (not (nil? (:completion typed))))
      (is (not (complete-at-point/popup-stale? typed)))
      (is (not (nil? (:completion (complete-at-point/close-stale-popup typed)))))))

  (test "a closed popup is never stale — there is nothing to close"
    (is (not (complete-at-point/popup-stale? (blsp-model "x"))))))

;; issues.md X5: the buffer-words source reads the LINE up to point rather than the whole
;; buffer on every keystroke, so the start it answers is an offset into the line plus where
;; the line begins — worth pinning on a line that is not the first.
(describe "the buffer-words source on a later line"
  (test "its start is a buffer offset, and its prefix the word before point"
    (let (text "alphabetical algorithm\nsecond alp"
          m (ed-init (goto-char (make-buffer text) (string/length text)))
          [start prefix items] (complete-source-buffer-words m))
      (assert= start 30)
      (assert= prefix "alp")
      (assert= items (list "alphabetical")))))

;; The buffer-words source searches the rope for the prefix rather than listing every word
;; (a 44k-line buffer took seconds to list), so it reads word boundaries from a character
;; SET handed to the native scanners. These pin that set to `symbol-char?`, the one rule.
(describe "the buffer-words source's prefix search"
  (test "the delimiter set is exactly the complement of symbol-char?"
    (let (chars (append (map (range 0 256) string/int->char) ["é" "λ" " " "→"]))
      (doseq (c chars)
        (assert= (includes? *complete-word-delimiters* c) (not (symbol-char? c))))))
  (test "only a prefix that STARTS a word counts, read through to the word's end"
    (let (m (ed-init (make-buffer "xalpha (alpha-one) 'alpha-two,alphabet\"alp\" alpha")))
      (assert= (completion-candidates m "alp")
        (list "alpha" "alpha-one" "alpha-two" "alphabet"))))
  (test "the word at point counts too, as it did when every word was listed"
    (let (m (ed-init (goto-char (make-buffer "alphabet alp") 3)))
      (assert= (completion-candidates m "alp") (list "alphabet")))))

;; The mode source hands its `:complete-at` service the current line up to point instead of
;; the whole buffer (flattening a 44k-line rope per Tab and per idle preview), so the start
;; it answers is shifted back from a line offset — pinned on a line that is not the first.
(describe "the mode source on a later line"
  (test "its start is a buffer offset, and its candidates the live globals"
    (let (text "(def alpha 1)\n  (string/starts-wi"
          m (blsp-model text)
          [start prefix items] (complete-source-mode m))
      (assert= start 17)
      (assert= prefix "string/starts-wi")
      (assert= items (list "string/starts-with?")))))

;; ---- a cached source narrows by filtering, not by asking again ---------------------
;; A source whose answer carries `{:cache true}` (the LSP source, when the server's list was
;; complete) is asked ONCE when the popup opens; narrowing keys filter what it said, and it
;; is asked again only when the prefix stops extending the one it answered. Each call of the
;; stand-in below leaves a message, so the tests count the asks.

(defn ct-cached-source (m)
  ;; always the same four items, whatever the prefix — so a re-ask is visible as items that
  ;; a filter would have dropped
  (let (buf (ed-current-buf m)
        [start prefix] (symbol-prefix-at (buffer-text buf) (buffer-point buf)))
    (send (self) [:ct-asked prefix])
    [start prefix ["zebra" "zeta-alpha" "zeta-beta" "zeta-bravo"] {:cache true}]))

(defn ct-prepare (m) (do (send (self) [:ct-prepared]) m))

(defn- ct-drain (acc)
  ;; the messages the stand-ins left, oldest first
  (receive
    ([:ct-asked prefix] (ct-drain (conj acc prefix)))
    ([:ct-prepared] (ct-drain (conj acc :prepared)))
    (after 0 acc)))

(defn- ct-model (text) (ed-init (goto-char (make-buffer text) (string/length text))))

(describe "completion: a cached source is asked once per prefix it covers"
  (test "narrowing filters the cached answer; leaving its prefix asks again"
    (binding (*completion-sources* (list 'complete-test/ct-cached-source)
              *completion-prepare* (list 'complete-test/ct-prepare))
      (ct-drain [])
      (let (opened (cmd-complete (ct-model "x zeta") :tab)
            opened-asks (ct-drain [])
            narrowed (complete-handle (complete-handle opened "-") "b")
            narrowed-asks (ct-drain [])
            ;; back at the asked prefix: still covered, still filtered
            back (complete-handle (complete-handle narrowed :backspace) :backspace)
            back-asks (ct-drain [])
            ;; one more: `zet` no longer extends `zeta`, so the source is asked again
            past (complete-handle back :backspace)
            past-asks (ct-drain []))
        (assert= (:items (:completion opened)) (list "zebra" "zeta-alpha" "zeta-beta" "zeta-bravo"))
        (assert= opened-asks [:prepared "zeta"]) ; prepared, then asked, once
        (assert= (:items (:completion narrowed)) (list "zeta-beta" "zeta-bravo"))
        (assert= narrowed-asks []) ; filtered: neither prepared nor asked
        (assert= (:items (:completion back)) (list "zeta-alpha" "zeta-beta" "zeta-bravo"))
        (assert= back-asks [])
        (assert= past-asks [:prepared "zet"])
        (assert= (:items (:completion past)) (list "zebra" "zeta-alpha" "zeta-beta" "zeta-bravo"))))))

;; brood-mode's service binary-searches a memoised sorted name vector instead of filtering
;; and sorting every global per call (~13 ms a Tab). Pinned against that computation.
(describe "brood-mode's global-name completion"
  (test "answers exactly the sorted globals starting with the prefix"
    (doseq (prefix ["a" "def" "string/st" "*" "->" "zzz-no-such"])
      (assert= (into [] (nth (brood-mode/brood-complete-at prefix (string/length prefix)) 2))
        (into []
          (sort (seq/filter (map (reflect/global-names) str)
                  (fn (s) (string/starts-with? s prefix)))))))))

;; The idle preview reads a word index of the buffer (`:word-index`) instead of searching
;; the rope on the loop. It is built once per text, moved along by the splice log as you
;; type, and must always agree with an index built afresh from the text it claims to be.
(defn- wi-model (text) (ed-init (goto-char (make-buffer text) (string/length text))))
(defn- wi-edit (m f) (ed-set-buf m (f (ed-current-buf m))))
(defn- wi-fresh (m) (complete-index-buckets (buffer-text (ed-current-buf m))))

(describe "completion: the buffer's word index"
  (test "the word regex cuts at exactly the delimiter set"
    (let (chars (map (range 33 127) string/int->char))
      (doseq (c chars)
        (assert= (complete-at-point/complete-text-words (str "a" c "b"))
          (if (includes? *complete-word-delimiters* c) (list "a" "b") (list (str "a" c "b")))))))
  (test "built once per text: a second refresh keeps the same index"
    (let (m (complete-index-refresh (wi-model "define defn defmacro\ndef"))
          again (complete-index-refresh m))
      (is (= (:rope (:word-index m)) (buffer-rope (ed-current-buf m))))
      (is (= (:word-index again) (:word-index m)))))
  (test "a short word before point builds nothing"
    (is (nil? (:word-index (complete-index-refresh (wi-model "define\nde"))))))
  (test "typing moves the index along the splice log, agreeing with a fresh build"
    (let (m (complete-index-refresh (wi-model "define defn defmacro\ndef"))
          ;; a word only the old index holds proves the new one was moved, not rebuilt
          planted (assoc-in m [:word-index :buckets "z"] {"zplanted" 1})
          typed (complete-index-refresh (wi-edit planted (fn (b) (insert b "nx")))))
      (assert= (get-in typed [:word-index :buckets "z"]) {"zplanted" 1})
      (assert= (dissoc (get-in typed [:word-index :buckets]) "z") (wi-fresh typed))
      (assert= (:rope (:word-index typed)) (buffer-rope (ed-current-buf typed)))))
  (test "an edit elsewhere that splits and joins words is counted exactly"
    (let (m (complete-index-refresh (wi-model "alpha beta gamma\nalp"))
          ;; join `alpha beta` into `alphabeta`, then type on at point
          joined (wi-edit m (fn (b) (goto-char (delete-char (goto-char b 5)) 20)))
          moved (complete-index-refresh (wi-edit joined (fn (b) (insert b "h")))))
      (assert= (get-in moved [:word-index :buckets]) (wi-fresh moved))
      (is (includes? (complete-index-words (:word-index moved) "alph") "alphabeta"))))
  (test "a deleted word leaves the index"
    (let (m (complete-index-refresh (wi-model "zebra\nzeb"))
          gone (complete-index-refresh (wi-edit m
                                         (fn (b)
                                           (insert (goto-char (replace-region b 0 6 "") 3) "z")))))
      (assert= (complete-index-words (:word-index gone) "zeb") (list "zebz"))))
  (test "another buffer's text is a rebuild, never a move"
    (let (m (complete-index-refresh (wi-model "alphabet\nalp"))
          other (ed-set-buf m (goto-char (make-buffer "omega\nome") 9))
          rebuilt (complete-index-refresh other))
      (assert= (get-in rebuilt [:word-index :buckets]) (wi-fresh rebuilt))))
  (test "the preview's source reads the index and nothing else"
    (let (m (wi-model "alphabet alpine\nalp"))
      (is (nil? (complete-source-index-words m)))
      (assert= (nth (complete-source-index-words (complete-index-refresh m)) 2)
        (list "alphabet" "alpine"))))
  (test "a finished build folds onto the rope it was read from and re-arms the preview"
    (let (m (wi-model "alphabet\nalp")
          rope (buffer-rope (ed-current-buf m))
          folded (complete-apply-word-index (assoc m
                                              :word-index-proc :handle
                                              :word-index-building rope
                                              :completion-preview-at [0 rope])
                   (complete-index-buckets "alphabet alp")))
      (is (= (:rope (:word-index folded)) rope))
      (is (nil? (:word-index-proc folded)))
      (is (nil? (:completion-preview-at folded)))))
  (test "the preview's refresh leaves the index on the model"
    (let (m (ed-refresh-preview (wi-model "alpha alphabet\nalp")))
      (is (not (nil? (:word-index m))))
      (assert= (:text (:completion-preview m)) "ha"))))

;; One Tab goes to the end of the next SEGMENT, not the whole word: a module path is typed a
;; segment at a time, and `XB.Tool.call` is wrong the moment the reader wanted `XB.Tool.other`.
(defn- ex-model (text)
  "An Elixir-mode model whose point is at the END of `text`."
  (ed-init (goto-char (make-buffer text "x.ex" "x.ex") (string/length text))))

(describe "completion: Tab completes to the next segment"
  (test "a unique dotted candidate stops at the next dot, and the next Tab takes the rest"
    (let (m (ex-model "XB.Tool.call()\nXB.T")
          once (cmd-complete m :tab)
          twice (cmd-complete once :tab))
      (assert= (text-of once) "XB.Tool.call()\nXB.Tool")
      (assert= (text-of twice) "XB.Tool.call()\nXB.Tool.call")))
  (test "a common prefix past a segment end stops there too"
    (let (m (ex-model "XB.Tool.call() XB.Tool.cast()\nXB.T"))
      (assert= (text-of (cmd-complete m :tab)) "XB.Tool.call() XB.Tool.cast()\nXB.Tool")))
  (test "a word with no separator after the prefix is still completed whole"
    (let (m (ex-model "handle_event()\nhandle_e"))
      (assert= (text-of (cmd-complete m :tab)) "handle_event()\nhandle_event")))
  (test "the inline preview's Tab takes one segment as well"
    (let (m (assoc (ex-model "XB.Tool.call()\nXB.T")
              :completion-preview
                {:start 15 :prefix "XB.T" :items ["XB.Tool.call"] :index 0 :text "ool.call"}))
      (assert= (text-of (preview-accept m)) "XB.Tool.call()\nXB.Tool")))
  (test "the step rule: separators at the boundary are stepped over, a run of them as one"
    (assert= (complete-step "XB.Tool" "XB.Tool.call") "XB.Tool.call")
    (assert= (complete-step "std" "std::fs::read") "std::fs")
    (assert= (complete-step "math/fl" "math/floor") "math/floor")
    (assert= (complete-step "ed" "editor/buffer/insert") "editor")
    (assert= (complete-step ":f" ":foo-bar") ":foo-bar")))

(describe "completion: segments are a code thing"
  (test "in prose (text-mode) Tab completes a dotted word whole"
    (let (m (ed-init (goto-char (make-buffer "see XB.Tool.call here\nXB.T" "notes.txt" "notes.txt")
                       26)))
      (assert= (text-of (cmd-complete m :tab)) "see XB.Tool.call here\nXB.Tool.call")))
  (test "a candidate that does not extend the prefix (a server's fuzzy match) is taken whole"
    (assert= (complete-step "tc" "XB.Tool.call") "XB.Tool.call")))

;; ---- Tab with point inside a word: the text after point merges, never doubles -----------
(defn- ex-model-at (text)
  "An Elixir-mode model of `text` without its `|`, point where the `|` was."
  (let (at (index-of text "|"))
    (ed-init (goto-char (make-buffer (string/replace text "|" "") "x.ex" "x.ex") at))))

(describe "completion: Tab inside a word"
  (test "a segment step meets the rest of the word: nothing doubled"
    (assert= (text-of (cmd-complete (ex-model-at "XB.Tool.cast()\nXB.T|ool.call") :tab))
      "XB.Tool.cast()\nXB.Tool.call"))
  (test "a completion the whole word is a prefix of replaces the word"
    (assert= (text-of (cmd-complete (ex-model-at "handle_event()\nhandle_e|ve x") :tab))
      "handle_event()\nhandle_event x"))
  (test "a completion that does not meet the rest keeps it"
    (assert= (text-of (complete-at-point/complete-apply (ex-model-at "ca|zz") 0 "cat")) "catzz"))
  (test "the merge rule: how much of the text after point a completion takes"
    (assert= (complete-absorbed "XB.T" "ol" "XB.Tool" #{"."}) 2)
    (assert= (complete-absorbed "XB.T" "ool.call" "XB.Tool" #{"."}) 3)
    (assert= (complete-absorbed "argu" "ment" "argument_value" #{"."}) 4)
    (assert= (complete-absorbed "ca" "zz" "cat" #{"."}) 0)
    (assert= (complete-absorbed "XB.T" "" "XB.Tool" #{"."}) 0)))
