;; A save and a large read OFF the loop: the buffer is marked saved only once its write has
;; landed, and as of the text written; a failed write keeps it modified and says why; a save
;; asked for while one is out waits its turn; C-x C-c waits for the writes; a large file shows
;; `Loading…` until its text lands. Each test that wants to see a task in flight binds the
;; module's switch and folds the reply itself, as the loop would.
(defmodule file-save-test
  (:use test)
  (:use model)
  (:use input) ; ed-update — a typed key
  (:use pool) ; ed-visit-file / *read-off-loop* / ed-apply-read
  (:use file-save) ; ed-save-buf-at / *write-off-loop* / *write-file* / ed-apply-save
  (:use lifecycle :only []) ; cmd-save / cmd-quit
  (:use backup :only []) ; backup-path
  (:use main :only []) ; the released image: every row loaded
  (:use editor/buffer))

(purge-stale-temp "bedit-file-save-")

(defn- fixture-file (text)
  "A fresh file holding `text` in its own temp directory; its path."
  (let (dir (temp-dir "bedit-file-save-")
        _ (file/mkdir dir)
        path (path/join dir "notes.txt"))
    (do (file/spit path text) path)))

(defn- visited (text)
  "`[model path]`: a file holding `text`, visited."
  (let (path (fixture-file text)) [(ed-find-file (ed-init (make-buffer "")) path) path]))

(defn- type-key (m key) (ed-update m key 80 24))

(defn- landed-save (m)
  "`m` with the write that is out awaited and its reply folded, as the loop folds it."
  (ed-apply-save m (task/await (:save-proc m) 5000)))

(defn- landed-read (m)
  (ed-apply-read m (task/await (:read-proc m) 5000)))

(describe "a save is written off the loop"
  (test "the buffer stays modified until the write lands, then is saved"
    (let ([m path] (visited "old\n")
          saving (binding (*write-off-loop* true) (lifecycle/cmd-save (type-key m "x") nil)))
      (is (:save-proc saving))
      (is (string/starts-with? (:echo saving) "Saving "))
      (is (buffer-modified? (ed-current-buf saving)))
      (let (saved (landed-save saving))
        (assert= (file/slurp path) "xold\n")
        (refute (buffer-modified? (ed-current-buf saved)))
        (refute (:save-proc saved))
        (assert= (:echo saved) (str "saved " path))
        ;; restamped with the write's own time, so the next save asks nothing
        (refute (editor/buffer-file/buffer-file-changed? (ed-current-buf saved))))))

  (test "a write that fails keeps the buffer modified and says why"
    (let ([m path] (visited "old\n")
          failed (binding (*write-file* (fn (_file _content) (error "disk full")))
                   (lifecycle/cmd-save (type-key m "x") nil)))
      (assert= (file/slurp path) "old\n")
      (is (buffer-modified? (ed-current-buf failed)))
      (is (includes? (:echo failed) "disk full"))
      (is (includes? (:echo failed) "still modified"))))

  (test "an edit made while the write is out leaves the buffer modified"
    (let ([m path] (visited "old\n")
          saving (binding (*write-off-loop* true) (lifecycle/cmd-save (type-key m "x") nil))
          edited (type-key saving "y")
          landed (landed-save edited))
      (assert= (file/slurp path) "xold\n")
      (assert= (buffer-text (ed-current-buf landed)) "xyold\n")
      (is (buffer-modified? (ed-current-buf landed)))
      (is (includes? (:echo landed) "still modified"))))

  (test "a second save while one is out waits its turn, then writes the newer text"
    (binding (*write-off-loop* true)
      (let ([m path] (visited "old\n")
            first-out (lifecycle/cmd-save (type-key m "x") nil)
            handle (:save-proc first-out)
            second-asked (lifecycle/cmd-save (type-key first-out "y") nil))
        ;; the same write is out; the second waits rather than racing it
        (assert= (:save-proc second-asked) handle)
        (assert= (count (:save-waiting second-asked)) 1)
        ;; the disk is read between the first write landing and its reply being folded:
        ;; folding it is what launches the waiting save, so a read after the fold raced
        ;; the second write and, on a loaded run, saw its "xyold"
        (let (reply (task/await handle 5000)
              on-disk (file/slurp path)
              first-landed (ed-apply-save second-asked reply))
          (assert= on-disk "xold\n")
          ;; the waiting save launched when the first landed
          (is (:save-proc first-landed))
          (refute (= (:save-proc first-landed) handle))
          (let (second-landed (landed-save first-landed))
            (assert= (file/slurp path) "xyold\n")
            (refute (buffer-modified? (ed-current-buf second-landed)))
            (refute (:save-waiting second-landed)))))))

  (test "C-x C-c waits for the write in flight, then quits"
    (let ([m path] (visited "old\n")
          saving (binding (*write-off-loop* true) (lifecycle/cmd-save (type-key m "x") nil))
          quitting (lifecycle/cmd-quit saving nil))
      ;; not asked about (its save is out), and not quit before the write lands
      (refute (:read-char quitting))
      (refute (:done quitting))
      (let (landed (landed-save quitting))
        (assert= (file/slurp path) "xold\n")
        (is (:done landed)))))

  (test "C-g while the quit waits cancels the quit, not the write"
    (let ([m path] (visited "old\n")
          saving (binding (*write-off-loop* true) (lifecycle/cmd-save (type-key m "x") nil))
          stopped (commands/cmd-keyboard-quit (lifecycle/cmd-quit saving nil) nil))
      (is (:save-proc stopped))
      (let (landed (landed-save stopped))
        (assert= (file/slurp path) "xold\n")
        (refute (buffer-modified? (ed-current-buf landed)))
        (refute (:done landed)))))

  (test "C-x C-c whose write fails asks before exiting with the buffer modified"
    (let ([m path] (visited "old\n")
          saving (binding (*write-off-loop* true
                           *write-file* (fn (_file _content) (error "disk full")))
                   (lifecycle/cmd-save (type-key m "x") nil))
          landed (landed-save (lifecycle/cmd-quit saving nil)))
      (assert= (file/slurp path) "old\n")
      (refute (:done landed))
      (is (includes? (:echo landed) "Modified buffers exist")))))

(defn- write-to (m path)
  "C-x C-w answered with `path` — the prompt's answer handed over whole, as RET would (typing it
a key at a time ranks the candidates of every directory on the way, a second of the run)."
  (let (asked (lifecycle/cmd-write-file m nil)
        answer (or (:on-complete (:minibuffer asked)) (error "C-x C-w asked nothing")))
    (answer (dissoc asked :minibuffer) path)))

(describe "C-x C-w writes off the loop"
  (test "the buffer takes the new path only once the write lands"
    (let ([m path] (visited "old\n")
          target (path/join (path/dirname path) "copy.txt")
          writing (binding (*write-off-loop* true) (write-to (type-key m "x") target)))
      (is (:save-proc writing))
      (is (string/starts-with? (:echo writing) "Writing "))
      ;; still the old file's while the write is out
      (assert= (buffer-file (ed-current-buf writing)) path)
      (is (includes? (first (ed-save-live writing)) "writing "))
      (let (landed (landed-save writing))
        (assert= (file/slurp target) "xold\n")
        (assert= (file/slurp path) "old\n")
        (assert= (buffer-file (ed-current-buf landed)) target)
        (assert= (buffer-name (ed-current-buf landed)) "copy.txt")
        (refute (buffer-modified? (ed-current-buf landed)))
        (refute (editor/buffer-file/buffer-file-changed? (ed-current-buf landed))))))

  (test "a buffer with no file is written and visits the new one"
    (let (dir (path/dirname (fixture-file ""))
          target (path/join dir "fresh.txt")
          m (type-key (ed-init (make-buffer "" "*scratch*")) "z")
          landed (landed-save (binding (*write-off-loop* true) (write-to m target))))
      (assert= (file/slurp target) "z")
      (assert= (buffer-file (ed-current-buf landed)) target)))

  (test "a write that fails leaves the buffer visiting its old file, and says why"
    (let ([m path] (visited "old\n")
          target (path/join (path/dirname path) "copy.txt")
          failed (landed-save (binding (*write-off-loop* true
                                        *write-file* (fn (_file _content) (error "disk full")))
                                (write-to (type-key m "x") target))))
      (refute (file/exists? target))
      (assert= (buffer-file (ed-current-buf failed)) path)
      (assert= (buffer-name (ed-current-buf failed)) "notes.txt")
      (is (buffer-modified? (ed-current-buf failed)))
      (is (includes? (:echo failed) "write failed: disk full"))
      (is (includes? (:echo failed) (str "still visits " path)))))

  (test "a write asked for while a save is out waits its turn"
    (binding (*write-off-loop* true)
      (let ([m path] (visited "old\n")
            target (path/join (path/dirname path) "copy.txt")
            saving (lifecycle/cmd-save (type-key m "x") nil)
            queued (write-to saving target)
            saved (landed-save queued))
        (assert= (count (:save-waiting queued)) 1)
        (assert= (buffer-file (ed-current-buf saved)) path)
        (let (written (landed-save saved))
          (assert= (file/slurp target) "xold\n")
          (assert= (buffer-file (ed-current-buf written)) target))))))

(describe "a large file is read off the loop"
  (test "Loading… shows at once, read-only, and the file takes its place"
    (let (path (fixture-file "a large file\n")
          m (ed-init (make-buffer ""))
          loading (binding (*read-off-loop* true *read-off-loop-bytes* 4) (ed-visit-file m path)))
      (assert= (buffer-text (ed-current-buf loading)) "Loading…\n")
      (is (read-only? (ed-current-buf loading)))
      (is (nil? (ed-buffer-index-by-file loading path)))
      (let (landed (landed-read loading))
        (assert= (buffer-text (ed-current-buf landed)) "a large file\n")
        (assert= (buffer-file (ed-current-buf landed)) path)
        (is (nil? (ed-loading-index landed path)))
        (assert= (count (:buffers landed)) (inc (count (:buffers m))))
        (is (includes? (:echo landed) "opened")))))

  (test "a read landing while you are elsewhere leaves you there"
    (let (path (fixture-file "big\n")
          m (ed-init (make-buffer ""))
          loading (binding (*read-off-loop* true *read-off-loop-bytes* 1) (ed-visit-file m path))
          elsewhere (ed-select loading 0)
          landed (landed-read elsewhere))
      (assert= (ed-current-index landed) 0)
      (is (int? (ed-buffer-index-by-file landed path)))
      (is (nil? (ed-loading-index landed path)))))

  (test "killing the Loading… buffer cancels the read"
    (let (path (fixture-file "big\n")
          loading (binding (*read-off-loop* true *read-off-loop-bytes* 1)
                    (ed-visit-file (ed-init (make-buffer "")) path))
          killed (ed-kill-buffer-at loading
                   (or (ed-loading-index loading path) (error "no Loading… buffer"))))
      (refute (:read-proc killed))
      (is (nil? (ed-buffer-index-by-file killed path)))))

  (test "a small file opens at once"
    (let (path (fixture-file "small\n")
          opened (binding (*read-off-loop* true) (ed-visit-file (ed-init (make-buffer "")) path)))
      (refute (:read-proc opened))
      (assert= (buffer-text (ed-current-buf opened)) "small\n"))))

(describe "a jump to a large file waits for its read, then goes to the line"
  (test "next-error's pop: Loading… shown in the other pane at once, point on the line once it lands"
    (let (path (fixture-file "one\ntwo\nthree\n")
          m (ed-init (make-buffer "results" "*compilation*"))
          after-step (fn (shown) (assoc shown :after-ran true))
          popped (binding (*read-off-loop* true *read-off-loop-bytes* 4)
                   (ed-pop-to-file m path 3 after-step)))
      (is (:read-proc popped))
      (assert= (buffer-text (ed-current-buf popped)) "Loading…\n")
      (refute (:after-ran popped))
      ;; the results buffer stays shown beside it
      (assert= (count (editor/pane/pane-leaf-paths (:layout popped))) 2)
      (let (landed (landed-read popped)
            buffer (ed-current-buf landed))
        (assert= (buffer-file buffer) path)
        (assert= (buffer-current-line buffer) 2)
        (is (:after-ran landed))
        (is (nil? (ed-loading-index landed path))))))

  (test "an open-and-act (an LSP location, a compile error) acts on the file once it lands"
    (let (path (fixture-file "one\ntwo\nthree\n")
          m (ed-init (make-buffer ""))
          step (fn (buffer) (goto-char buffer 5))
          opening (binding (*read-off-loop* true *read-off-loop-bytes* 4)
                    (ed-find-file-then m path step))
          landed (landed-read opening))
      (assert= (buffer-point (ed-current-buf opening)) 0)
      (assert= (buffer-file (ed-current-buf landed)) path)
      (assert= (buffer-point (ed-current-buf landed)) 5)))

  (test "a small file is opened and acted on at once"
    (let (path (fixture-file "one\ntwo\n")
          opened (binding (*read-off-loop* true)
                   (ed-find-file-then (ed-init (make-buffer ""))
                     path
                     (fn (buffer) (goto-char buffer 4)))))
      (refute (:read-proc opened))
      (assert= (buffer-point (ed-current-buf opened)) 4))))

;; C-x C-w replaced a file already there without a word, and Enter took the first entry the
;; prompt listed: `notes` typed beside `notes-old.md` wrote over notes-old.md. Emacs's
;; write-file reads the line as typed and asks "File exists; overwrite?".
(describe "C-x C-w never replaces a file unasked"
  (test "the prompt is a new name's: Enter takes the line, not the first entry listed"
    (let ([m _] (visited "old\n")
          asked (lifecycle/cmd-write-file m nil))
      (assert= (minibuffer/mb-sel (:minibuffer asked)) -1)))
  (test "an existing file is asked about; n leaves it, y writes over it"
    (let ([m path] (visited "old\n")
          target (path/join (path/dirname path) "other.txt")
          _ (file/spit target "keep\n")
          asked (binding (*write-off-loop* true) (write-to (type-key m "x") target)))
      (is (includes? (:echo asked) "exists; overwrite?"))
      (refute (:save-proc asked))
      (let (declined (type-key asked "n"))
        (assert= (file/slurp target) "keep\n")
        (assert= (buffer-file (ed-current-buf declined)) path))
      (let (landed (landed-save (binding (*write-off-loop* true) (type-key asked "y"))))
        (assert= (file/slurp target) "xold\n")
        (assert= (buffer-file (ed-current-buf landed)) target))))
  (test "the buffer's own file is written without a question"
    (let ([m path] (visited "old\n")
          landed (landed-save (binding (*write-off-loop* true) (write-to (type-key m "x") path))))
      (assert= (file/slurp path) "xold\n")
      (refute (buffer-modified? (ed-current-buf landed)))))
  (test "a directory takes the file under its name"
    (let ([m path] (visited "old\n")
          dir (path/join (path/dirname path) "into")
          _ (file/mkdir dir)
          landed (landed-save (binding (*write-off-loop* true) (write-to m dir))))
      (assert= (file/slurp (path/join dir "notes.txt")) "old\n")
      (assert= (buffer-file (ed-current-buf landed)) (path/join dir "notes.txt")))))

;; A save that replaced the wrong text could not be undone without version control: the sidecar
;; keeps what was typed, nothing kept what was on disk. Emacs's make-backup-files.
(describe "the first save over a file backs it up"
  (test "the file as it was is copied to state/backups, owner-only, once a session"
    (let ([m path] (visited "old\n")
          on (assoc m :make-backup-files true)
          backup (backup/backup-path path)
          first-save (landed-save (binding (*write-off-loop* true)
                                    (lifecycle/cmd-save (type-key on "x") nil))))
      (assert= (file/slurp backup) "old\n")
      (assert= (file/slurp path) "xold\n")
      (assert= (math/mod (:mode (file/stat backup)) 512) 384)
      ;; the second save keeps the first backup: it is the file as the session found it
      (landed-save (binding (*write-off-loop* true)
                     (lifecycle/cmd-save (type-key first-save "y") nil)))
      (assert= (file/slurp backup) "old\n")
      (assert= (file/slurp path) "xyold\n")))
  (test "off, nothing is backed up"
    (let ([m path] (visited "old\n"))
      (landed-save (binding (*write-off-loop* true) (lifecycle/cmd-save (type-key m "x") nil)))
      (refute (file/exists? (backup/backup-path path)))))
  (test "a backup's name is the whole path, so two notes.txt never share one"
    (assert= (backup/backup-name "/a/notes.txt") "%2Fa%2Fnotes.txt~")
    (refute (= (backup/backup-name "/a/notes.txt") (backup/backup-name "/b/notes.txt")))))
