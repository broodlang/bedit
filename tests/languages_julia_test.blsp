;; Julia (src/languages/julia.blsp): a `deflanguage` over tree-sitter-julia. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-julia.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-julia-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "julia, the mode"
  (test "a .jl file, and a julia script, open in julia mode"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/Greet.jl")) "julia")
    (assert= (ed-buf-mode-name (file-buffer "#!/usr/bin/env julia\nx = 1\n" "/p/run")) "julia"))
  (test "it parses with tree-sitter-julia, comments with # and has no formatter command"
    (assert= (ed-mode-service (file-buffer "" "/p/a.jl") :ts-lang) :julia)
    (assert= (:url (model/grammar-source :julia))
      "https://github.com/tree-sitter/tree-sitter-julia")
    (assert= (ed-mode-service (file-buffer "" "/p/a.jl") :comment-syntax) "# ")
    (is (nil? (get languages/julia/julia-spec :format))))
  (test "the restart: a column-0 item, unless a triple-quoted string opened above"
    (let (src "module A\n\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "s = \"\"\"\nfunction x()\n\"\"\"\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "#=\nfunction x()\n=#\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "module A\nfunction g()\n    s = \"\"\"\nfunction x()\n    1\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function g")))))

;; the sample is laid out as its formatter writes it: JuliaFormatter's defaults

(def julia-src
  "#!/usr/bin/env julia
# the greeter
module Greet

using LinearAlgebra
import Base: show

export greet

#= a block
comment =#
const MAX = 0x10

abstract type Shape end

struct Point{T<:Real} <: Shape
    x::T
    y::T
end

mutable struct Greeter
    name::String
end

\"\"\"
    greet(who)

Say hello.
\"\"\"
function greet(who::String, loud::Bool=false)
    if isempty(who)
        return nothing
    elseif loud
        println(uppercase(\"hi $who and $(length(who))\"))
    else
        Base.print(stdout, 'c', 1.5, true)
    end
    for each in [\"a\", \"b\"]
        continue
    end
    while false
        break
    end
    result = let value = 1
        value * 2
    end
    doubled = map(x -> x * 2, [1, 2])
    total = sum(1:10) do index
        index^2
    end
    try
        work(:symbol)
    catch err
        rethrow(err)
    finally
        cleanup()
    end
    @assert MAX > 0
    return Point(1.0, 2.0)
end

area(point::Point) = point.x * point.y

macro twice(expr)
    quote
        $(esc(expr))
        $(esc(expr))
    end
end

end # module")

(when (load-test-grammar :julia)
  (describe "julia, parsed"
    (def julia-spans (languages/julia/julia-fontify julia-src))
    (test "comments, keywords and `end`"
      (assert= (face-at julia-spans julia-src "# the") (face-of :syntax/comment))
      (assert= (face-at julia-spans julia-src "#= a") (face-of :syntax/comment))
      (assert= (face-at julia-spans julia-src "module") (face-of :syntax/keyword))
      (assert= (face-at julia-spans julia-src "mutable struct") (face-of :syntax/keyword))
      (assert= (face-at julia-spans julia-src "do index") (face-of :syntax/keyword))
      (assert= (face-at julia-spans julia-src "end\n\nmutable") (face-of :syntax/keyword))
      (assert= (face-at julia-spans julia-src "continue") (face-of :syntax/keyword)))
    (test "a module's, a struct's and a type's name, an annotation's type and a macro are specials"
      (assert= (face-at julia-spans julia-src "Greet\n") (face-of :syntax/special))
      (assert= (face-at julia-spans julia-src "Shape end") (face-of :syntax/special))
      (assert= (face-at julia-spans julia-src "Point{") (face-of :syntax/special))
      (assert= (face-at julia-spans julia-src "Greeter\n") (face-of :syntax/special))
      (assert= (face-at julia-spans julia-src "String,") (face-of :syntax/special))
      (assert= (face-at julia-spans julia-src "@assert") (face-of :syntax/special)))
    (test "a function's, a one-line function's and a macro's name are definitions"
      (assert= (face-at julia-spans julia-src "greet(who::") (face-of :syntax/definition))
      (assert= (face-at julia-spans julia-src "area(") (face-of :syntax/definition))
      (assert= (face-at julia-spans julia-src "twice(") (face-of :syntax/definition)))
    (test "a call and a qualified call are functions"
      (assert= (face-at julia-spans julia-src "println") (face-of :syntax/function))
      (assert= (face-at julia-spans julia-src "print(stdout") (face-of :syntax/function))
      (assert= (face-at julia-spans julia-src "Point(1.0") (face-of :syntax/function)))
    (test "literals: strings, a docstring, a char, numbers, constants, a symbol"
      (assert= (face-at julia-spans julia-src "\"a\"") (face-of :syntax/string))
      (assert= (face-at julia-spans julia-src "\"\"\"\n    greet") (face-of :syntax/string))
      (assert= (face-at julia-spans julia-src "'c'") (face-of :syntax/string))
      (assert= (face-at julia-spans julia-src "0x10") (face-of :syntax/number))
      (assert= (face-at julia-spans julia-src "1.5") (face-of :syntax/number))
      (assert= (face-at julia-spans julia-src "true") (face-of :syntax/constant))
      (assert= (face-at julia-spans julia-src "nothing") (face-of :syntax/constant))
      (assert= (face-at julia-spans julia-src ":symbol") (face-of :syntax/constant)))
    (test "a string's text is a string and the code interpolated into it is code"
      (assert= (face-at julia-spans julia-src "\"hi $") (face-of :syntax/string))
      (assert= (face-at julia-spans julia-src "who and") nil)
      (assert= (face-at julia-spans julia-src "length(who))") (face-of :syntax/function)))
    (test "it indents every line: an unindented module body, if/elseif/else, loops, let, do, try, quote"
      (let ([got want] (indents julia-src "/p/Greet.jl")) (assert= got want)))
    (test "a function, a macro, a struct, an abstract type and a module are definitions C-M-a stops at"
      (let (kinds (:kinds (get languages/julia/julia-spec :definitions)))
        (doseq (kind [:function_definition
                       :macro_definition :struct_definition :abstract_definition :module_definition])
          (is (contains? kinds kind)))))))
