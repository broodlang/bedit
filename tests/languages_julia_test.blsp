;; Julia (src/languages/julia.blsp): a `deflanguage` over tree-sitter-julia. The mode half needs no
;; grammar; the parsed half needs `libtree-sitter-julia.so` (M-x grammar-install) and SKIPS without it.
(defmodule languages-julia-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at load-test-grammar window-and-whole]))

(defn- face-of (name) (editor/face/face name))

(describe "julia, the mode"
  (test "a julia script opens in julia mode by its #! line"
    (assert= (ed-buf-mode-name (file-buffer "#!/usr/bin/env julia\nx = 1\n" "/p/run")) "julia"))
  (test "it parses with tree-sitter-julia, comments with # and has no formatter command"
    (assert= (ed-mode-service (file-buffer "" "/p/a.jl") :ts-lang) :julia)
    (assert= (:url (grammarfallback/grammar-source :julia))
      "https://github.com/tree-sitter/tree-sitter-julia")
    (assert= (ed-mode-service (file-buffer "" "/p/a.jl") :comment-syntax) "# ")
    (is (nil? (get languages/julia/julia-spec :format))))
  (test "the restart: a column-0 item, unless a triple-quoted string opened above"
    (let (src "module A\n\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "s = \"\"\"\nfunction x()\n\"\"\"\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "#=\nfunction x()\n=#\nfunction f()\n    1\nend\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function f")))
    (let (src "module A\nfunction g()\n    s = \"\"\"\nfunction x()\n    1\n")
      (assert= (languages/julia/julia-restart src (index-of src "    1"))
        (index-of src "function g")))))

;; The sample, tests/corpus/julia/shapes.jl (JuliaFormatter's defaults), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart. What stays here is
;; what a caret line cannot reach: the openers of a block comment and a docstring, whose lines end
;; inside them.
(def julia-src (file/slurp "tests/corpus/julia/shapes.jl"))

(describe "julia, parsed"
  :skip-unless (load-test-grammar :julia)
  "no julia grammar"
  (defn- julia-spans () (languages/julia/julia-fontify julia-src))
  (test "a block comment and a docstring, from their openers"
    (assert= (face-at (julia-spans) julia-src "#= a") (face-of :syntax/comment))
    (assert= (face-at (julia-spans) julia-src "\"\"\"\n    greet") (face-of :syntax/string)))
  (test "a function, a macro, a struct, an abstract type and a module are definitions C-M-a stops at"
    (let (kinds (:kinds (get languages/julia/julia-spec :definitions)))
      (doseq (kind [:function_definition
                     :macro_definition :struct_definition :abstract_definition :module_definition])
        (is (contains? kinds kind))))))

;; A docstring longer than the windowed fontify's lead-in (`spancache/ed-fontify-backscan`), its
;; prose at column 0 and holding `# Examples` and `@ref` lines the restart takes for items: a window
;; whose lead-in begins inside it must still know it is inside, or it cuts in the prose and paints
;; the code below as a string.
(describe "julia, a window below a docstring longer than its lead-in"
  :skip-unless (load-test-grammar :julia)
  "no julia grammar"
  (defn- long-julia ()
    (str "module Shapes\n\n\"\"\"\n    area(shape)\n\n"
      (string/join (map (range 260)
                     (fn (i)
                       (case (math/mod i 20)
                         0 "# Examples"
                         1 "```jldoctest"
                         2 (str "julia> area(" i ")")
                         3 "```"
                         4 (str "@ref area" i)
                         (str "Compute the area, part " i "."))))
        "\n")
      "\n\"\"\"\n"
      (string/join (map (range 150)
                     (fn (i)
                       (str "function area" i "(shape)\n    return shape * " i "  # double\nend\n")))
        "\n")
      "end\n"))
  (test "the docstring's end and the code below it paint as a parse from the top does"
    (let ([windowed whole] (window-and-whole (long-julia) "/p/shapes.jl" 255 285))
      (is (not (empty? windowed)))
      (assert= windowed whole)))
  (test "the docstring's own lines, far into it, are still the docstring"
    (let ([windowed whole] (window-and-whole (long-julia) "/p/shapes.jl" 220 240))
      (is (not (empty? windowed)))
      (assert= windowed whole))))
