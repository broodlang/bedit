;; EVERY prompt for a file or folder is `pool/ed-path-prompt` (or `ed-path-list-prompt` for a
;; fixed set of paths), never a bare minibuffer line: dired's R / C / + were bare lines until
;; 2026-11-11 — no listing, no Tab, `~` not read, C-w not walking up — and nothing noticed. This
;; guard reads src/ for a bare line (`ed-mb-edit`) whose prompt text asks for a file, a directory
;; or a path. A prompt that asks for one belongs on the path prompt; a prompt whose words only
;; look like it (it picks among names that are not paths) goes in `*not-a-path*` with why.
;;
;; It reads the LITERAL prompt texts: a prompt built from a variable is not seen, so a helper
;; that wraps `ed-mb-edit` for paths is exactly what the path prompt exists to replace.

(defmodule path-prompt-guard-test
  (:use test))

(def *path-words* "(?i)\\b(file|files|directory|folder|path|patch|attachment|image)\\b")

(def *not-a-path*
  ;; prompt text → why a bare line is right for it
  {"Find file in project: " "a fuzzy pick among the project's files (project-commands), not a path"})

(defn- bare-prompts (file)
  ;; `[[file prompt] …]`: each literal prompt text `file` hands `ed-mb-edit`
  (map (regex/find-all (file/slurp file) "\\(ed-mb-edit (?:\\(str )?\"([^\"]*)\"")
    (fn (found) [file (:text (first (:groups found)))])))

(describe "every prompt for a file or folder is the path prompt"
  (test "src/ is where this looks"
    ;; with a wrong working directory the walk finds nothing and the guard passes vacuously
    (is (> (count (file/list-files "src")) 100)))
  (test "no bare minibuffer line asks for a file, a directory or a path"
    (let (offenders (seq/filter (mapcat (seq/filter (map (file/list-files "src")
                                                      (fn (name) (path/join "src" name)))
                                          (fn (path) (string/ends-with? path ".blsp")))
                                  bare-prompts)
                      (fn ([_ prompt])
                        (and (regex/match? prompt *path-words*)
                          (not (contains? *not-a-path* prompt))))))
      (assert= (vec offenders) []))))
