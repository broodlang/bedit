;; tests/xrefgrep_test.blsp — M-. and M-? with no language server: a search of the project for
;; the word at point, a definition line jumped to when it is the only one.

(defmodule xrefgrep-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use xrefgrep))

(defn- project ()
  (let (root (temp-dir "bedit-xrefgrep-"))
    (file/mkdir root)
    (file/spit (path/join root "lib.txt") "intro\ndef launch(x)\n  x\nend\n")
    (file/spit (path/join root "use.txt") "launch(1)\nlaunch(2)\n")
    root))

(defn- at-use (root)
  ;; use.txt open, point on its first `launch`, the project its root
  (let (m (pool/ed-find-file (assoc (ed-init (make-buffer "")) :project-root root)
            (path/join root "use.txt")))
    (ed-set-buf m (goto-char (ed-current-buf m) 2))))

(describe "a lookup without a server"
  (test "the definition pattern finds a defining line, not a use"
    (is (regex/find "def launch(x)" (definition-pattern "launch")))
    (refute (regex/find "launch(1)" (definition-pattern "launch"))))
  (test "M-. with one defining line goes there"
    (let (root (project)
          jumped (lsp-commands/cmd-goto-definition (at-use root) nil))
      (assert= (buffer-file (ed-current-buf jumped)) (path/join root "lib.txt"))
      (assert= (buffer-current-line (ed-current-buf jumped)) 1)
      (is (includes? (:echo jumped) "by search"))))
  (test "M-? lists every use"
    (let (root (project)
          listed (lsp-commands/cmd-find-references (at-use root) nil))
      (assert= (buffer-name (ed-current-buf listed)) "*Project Search*")
      (is (includes? (buffer-text (ed-current-buf listed)) "3 matches")))))
