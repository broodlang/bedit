;; diff-hl change gutter (src/gitdiff.blsp): the pure HEAD-vs-buffer line diff → per-line
;; status map, and the gutter glyph/face. The HEAD blob fetch (a git subprocess) and the
;; live gutter rendering are exercised by hand against a real repo, not here.

(defmodule gitdiff-test (:use test) (:use-internals gitdiff))

(describe "gitdiff: per-line status map"
  (test "identical text → no changes"
    (assert= (gitdiff/gitdiff--status-map "a\nb\nc" "a\nb\nc") {}))
  (test "an inserted line is :added"
    (assert= (gitdiff/gitdiff--status-map "a\nb" "a\nx\nb") {1 :added}))
  (test "a replaced line is :modified"
    (assert= (gitdiff/gitdiff--status-map "a\nOLD\nc" "a\nNEW\nc") {1 :modified}))
  (test "a removed line marks the following line :deleted"
    (assert= (gitdiff/gitdiff--status-map "a\nGONE\nc" "a\nc") {1 :deleted}))
  (test "an append at end of file is :added"
    (assert= (gitdiff/gitdiff--status-map "a" "a\nb") {1 :added}))
  (test "a trailing newline difference is not a change"
    (assert= (gitdiff/gitdiff--status-map "a\nb\n" "a\nb") {})
    (assert= (gitdiff/gitdiff--status-map "a\nb" "a\nb\n") {}))
  (test "two added lines in a row are both :added"
    (assert= (gitdiff/gitdiff--status-map "a\nb" "a\nx\ny\nb") {1 :added 2 :added}))
  (test "replacing two lines marks both :modified"
    (assert= (gitdiff/gitdiff--status-map "a\nO1\nO2\nd" "a\nN1\nN2\nd") {1 :modified 2 :modified})))

(describe "gitdiff: gutter glyph + face"
  (test "the bar glyph reflects the status"
    (assert= (gitdiff/bar-glyph :added) "▌")
    (assert= (gitdiff/bar-glyph :modified) "▌")
    (assert= (gitdiff/bar-glyph :deleted) "▁")
    (assert= (gitdiff/bar-glyph nil) " "))
  (test "an unchanged line has no bar face; changed lines are coloured"
    (is (nil? (gitdiff/bar-face nil)))
    (assert= (gitdiff/bar-face :added) gitdiff/face-diff-added)
    (assert= (gitdiff/bar-face :modified) gitdiff/face-diff-modified)
    (assert= (gitdiff/bar-face :deleted) gitdiff/face-diff-deleted)))
