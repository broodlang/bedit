;; Editor tests (split from the original monolithic main_test.blsp by concern).
;; Every split file keeps the `main-test` module name, so a helper defined in any
;; file is visible to every test body at run time (test bodies are lazy thunks the
;; runner evaluates only after all files load into the shared image). The common
;; model helpers below are repeated in each file so a standalone `nest check` of a
;; single file still resolves them.
(defmodule buffers-eval-test
  (:use testkit :only [press m-of cur type-str after]) ; the shared test helpers (tests/support)
  (:use autosave) ; auto-save
  (:use sidecar) ; sidecar paths
  (:use autorevert) ; auto-revert
  (:use minibuffer)
  (:use model)
  (:use input)
  (:use pool)
  (:use lifecycle)
  (:use commands)
  (:use eval-commands) ; ed-eval-async / cmd-eval-region / cmd-eval-buffer — the C-x C-e family
  (:use mincomplete)
  (:use main)
  (:use editor/buffer)
  (:use editor/buffer-file)
  (:use test))

(describe "editor multiple buffers"
  (test "a fresh model has the scratch buffer plus *Messages*"
    (let (m (m-of "hi"))
      (assert= (buffer-name (cur m)) "*scratch*")
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))))
  (test "C-x →/← cycle through buffers (wrapping)"
    (let (m1 (press (m-of "hi") [:ctrl-x :right]))
      (assert= (buffer-name (cur m1)) "*Messages*")
      (assert= (buffer-name (cur (press m1 [:ctrl-x :right]))) "*scratch*")))
  (test "switching buffers preserves each buffer's point"
    (let (m (press (m-of "hello") [:right :right])
          ; point 2 in *scratch*
          back (press m [:ctrl-x :right :ctrl-x :left]))
      ; to *Messages* and back
      (assert= (buffer-point (cur back)) 2)))
  (test "*Messages* cannot be killed"
    (let (m (press (m-of "x") [:ctrl-x :right :ctrl-x "k"]))
      ; on *Messages*, try kill
      (is (not (nil? (ed-buffer-index-by-name m "*Messages*"))))
      (is (includes? (:echo m) "cannot kill"))))
  (test "killing the last editable buffer leaves a fresh *scratch* and selects it"
    (let (m (press (m-of "x") [:ctrl-x "k"]))
      ; kill the only editable buffer
      (is (ed-has-editable? (:buffers m)))
      (is (< (ed-current-index m) (count (:buffers m))))
      (assert= (buffer-name (cur m)) "*scratch*") ; lands on the new scratch, not *Messages*
      (assert= (buffer-text (cur m)) "")))
  (test "killing a buffer goes back to the one selected before it, as Emacs does"
    ;; a, b, c opened in that order; visited c, then a, then b. Killing b shows a, not c,
    ;; which is the buffer that shifted into b's slot.
    (let (visit (fn (m name)
                  (ed-note-buffer-recency (ed-select m (or (ed-buffer-index-by-name m name) 0))))
          opened (fold ["a" "b" "c"]
                   (m-of "x")
                   (fn (m name) (ed-open-buffer m (make-buffer "" name))))
          m (fold ["c" "a" "b"] opened visit)
          killed (press m [:ctrl-x "k"]))
      (is (nil? (ed-buffer-index-by-name killed "b")))
      (assert= (buffer-name (cur killed)) "a")))
  (test "switching buffers clears the stale per-model status"
    ;; edit (status -> "modified"), then switch; the new buffer isn't modified
    (let (m (press (m-of "x") ["z" :ctrl-x :right]))
      (assert= (:status m) ""))))

(describe "editor minibuffer (switch-buffer & find-file)"
  (test "C-x b switches to a buffer by name via the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b"]))
      ; open the minibuffer
      (is (not (nil? (:minibuffer m))))
      (let (done (ed-update (type-str m "*Messages*") :enter 80 24))
        (is (nil? (:minibuffer done)))
        (assert= (buffer-name (cur done)) "*Messages*"))))
  (test "C-g aborts the minibuffer"
    (let (m (press (m-of "x") [:ctrl-x "b" :ctrl-g]))
      (is (nil? (:minibuffer m)))
      (assert= (buffer-name (cur m)) "*scratch*")))
  (test "C-x C-f opens an existing file into a new buffer"
    (let (path (str (temp-dir "bedit-") ".txt")
          _ (file/spit path "from disk\n")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m
               :minibuffer
                 (assoc (:minibuffer m)
                   :edit (ed-mb-set-text (:edit (:minibuffer m)) path)))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "from disk\n")
      (assert= (buffer-file (cur done)) path)))
  (test "C-x C-f on a new path starts an empty file-backed buffer"
    (let (path (str (temp-dir "bedit-new-") ".txt")
          m (press (m-of "x") [:ctrl-x :ctrl-f])
          m2 (assoc m
               :minibuffer
                 (assoc (:minibuffer m)
                   :edit (ed-mb-set-text (:edit (:minibuffer m)) path)))
          done (ed-update m2 :enter 80 24))
      (assert= (buffer-text (cur done)) "")
      (assert= (buffer-file (cur done)) path)))
  (test "C-x C-f prefills the cwd path (so deleting back traverses up, no ../)"
    ;; shown as the line spells it — the home as `~` (filename/as-input)
    (let (m (press (m-of "x") [:ctrl-x :ctrl-f]))
      (assert= (mb-text (:minibuffer m)) (filename/as-input (str (file/cwd) "/")))))
  (test "find-file shows a candidate's basename as its label, keeping the full-path value"
    ;; path-label is the :label-fn — the Vertico list shows `src/` / `foo.txt`, not the
    ;; absolute path, while the candidate value (what accept opens) stays full.
    (assert= (mincomplete/path-label "/home/u/proj/src/") "src/")
    (assert= (mincomplete/path-label "/home/u/proj/commands.blsp") "commands.blsp"))
  (test "find-file resolves a relative path to absolute on open"
    ;; the suite runs in the repo root, so project.blsp exists relative to (file/cwd)
    (let (done (pool/ed-find-file (m-of "x") "project.blsp"))
      (assert= (buffer-file (cur done)) (path/join (file/cwd) "project.blsp"))))
  ;; Emacs (and Vertico, `vertico-preselect 'directory`): Enter on a directory opens it in
  ;; dired; Tab is what descends. The bug: `notes/` Enter opened the first FILE inside, because
  ;; the highlighted first entry won over the directory typed on the line.
  (test "C-x C-f Enter on a directory opens dired — typed bare, with its slash, or Tab-filled"
    (let (d (temp-dir "bedit-dir-")
          _ (file/mkdir (str d "/notes"))
          _ (file/spit (str d "/notes/a.txt") "a\n")
          _ (file/spit (str d "/notes.md") "n\n")
          m0 (ed-init (make-buffer "" (str d "/x.txt") (str d "/x.txt")))
          opened (fn (keys) (cur (press m0 (append [:ctrl-x :ctrl-f] keys [:enter])))))
      (doseq (keys [(string/->list "notes")
                     (string/->list "notes/")
                     (append (string/->list "notes") [:tab])])
        (let (b (opened keys))
          (assert= (:type b) :dired)
          (assert= (buffer-name b) (str d "/notes"))))
      ;; Enter straight away on the prefilled directory is dired on it
      (assert= (:type (opened [])) :dired)))
  (test "C-x C-f inside a directory: C-n picks an entry, and Enter opens that"
    (let (d (temp-dir "bedit-dir-")
          _ (file/mkdir (str d "/notes"))
          _ (file/spit (str d "/notes/a.txt") "a\n")
          m0 (ed-init (make-buffer "" (str d "/x.txt") (str d "/x.txt")))
          m (press m0 (append [:ctrl-x :ctrl-f] (string/->list "notes/"))))
      ;; the prompt itself is selected: the counter says so, as Vertico's does
      (assert= (mb-sel (:minibuffer m)) -1)
      (assert= (buffer-file (cur (press m [:ctrl-n :enter]))) (str d "/notes/a.txt"))))
  ;; Emacs's future history: M-n in C-x C-f puts the file named at point on the line, then
  ;; this buffer's own file
  (test "C-x C-f M-n offers the file at point, then the buffer's file, then says the end"
    (let (d (temp-dir "bedit-dir-")
          _ (file/mkdir d)
          _ (file/spit (str d "/notes.md") "n\n")
          own (str d "/x.txt")
          m0 (ed-init (goto-char (make-buffer "see notes.md here" own own) 6))
          line (fn (m) (mb-text (:minibuffer m)))
          once (press m0 [:ctrl-x :ctrl-f :alt-n])
          twice (press once [:alt-n])
          past (press twice [:alt-n]))
      (assert= (line once) (filename/as-input (str d "/notes.md")))
      (assert= (line twice) (filename/as-input own))
      (assert= (:message (:minibuffer past)) "End of defaults")
      (assert= (buffer-file (cur (press once [:enter]))) (str d "/notes.md"))))
  (test "C-x 4 f on a directory opens dired in the other pane"
    (let (d (temp-dir "bedit-dir-")
          _ (file/mkdir (str d "/notes"))
          m (window-commands/ed-find-file-other-window (m-of "x") (str d "/notes")))
      (assert= (:type (cur m)) :dired)
      (assert= (editor/pane/pane-count (:layout m)) 2))))
(describe "editor open-file naming (project-relative vs basename)"
  ;; A project file's buffer reads as its project-relative path; a file outside any
  ;; project is just its basename — consistent whether opened via C-x C-f, project
  ;; find-file, or the CLI. `:file` always keeps the full path (save / dedup).
  (test "file-display-name is project-relative inside the project, basename outside"
    (assert= (projects/file-display-name "/proj/src/view.blsp" "/proj") "src/view.blsp")
    (assert= (projects/file-display-name "/elsewhere/notes.txt" "/proj") "notes.txt")
    (assert= (projects/file-display-name "/elsewhere/notes.txt" nil) "notes.txt"))
  (test "ed-find-file names a project file by its project-relative path"
    (let (done (ed-find-file (assoc (m-of "x") :project-root "/proj") "/proj/src/x.blsp"))
      (assert= (buffer-name (cur done)) "src/x.blsp")
      (assert= (buffer-file (cur done)) "/proj/src/x.blsp"))) ; full path kept for saving
  (test "ed-find-file names a non-project file by its basename"
    (let (done (ed-find-file (assoc (m-of "x") :project-root "/proj") "/elsewhere/y.txt"))
      (assert= (buffer-name (cur done)) "y.txt")))
  (test "reopening the same file switches to it (dedup by :file, not display name)"
    (let (m1 (ed-find-file (assoc (m-of "x") :project-root "/proj") "/proj/a.txt")
          n (count (:buffers m1))
          m2 (ed-find-file m1 "/proj/a.txt"))
      (assert= (count (:buffers m2)) n) ; no duplicate buffer
      (assert= (buffer-file (cur m2)) "/proj/a.txt"))))

(describe "editor completion helpers"
  (test "ed-complete-name returns the sole match"
    (assert= (ed-complete-name "*M" ["*scratch*" "*Messages*"]) "*Messages*"))
  (test "ed-complete-name returns the common prefix of several matches"
    (assert= (ed-complete-name "f" ["foo" "foobar" "fizz"]) "f")) ; 'foo'/'fizz' share only 'f'
  (test "ed-complete-path completes a unique filename in a directory"
    (let (d (temp-dir "bedit-dir-")
          _ (file/mkdir d)
          _ (file/spit (str d "/unique-file.txt") "x"))
      (assert= (ed-complete-path (str d "/uni")) (str d "/unique-file.txt"))))
  ;; the shared Tab core behind find-file *and* project find-file
  (test "complete-prefix returns the sole candidate whole"
    (assert= (mincomplete/complete-prefix "sr" ["src/"]) "src/"))
  (test "complete-prefix returns the common prefix of several candidates"
    (assert= (mincomplete/complete-prefix "co" ["src/commands.blsp" "src/complete.blsp"])
      "src/com") ; shared up to 'src/com' ('m' vs 'p' diverge)
    (assert= (mincomplete/complete-prefix "x" []) "x")) ; no candidates → unchanged
  (test "ed-sort-candidates orders by name when nothing is recent"
    (assert= (mincomplete/ed-sort-candidates ["/d/src/" "/d/aaa.txt" "/d/m.txt"] [])
      (list "/d/aaa.txt" "/d/m.txt" "/d/src/"))) ; aaa, m, src by name
  (test "ed-sort-candidates floats recent files to the top (MRU), then by name"
    (assert= (mincomplete/ed-sort-candidates ["/d/a.txt" "/d/b.txt" "/d/c.txt" "/d/sub/"]
               ["/d/c.txt" "/d/a.txt"])
      ; recency: c then a
      (list "/d/c.txt" "/d/a.txt" "/d/b.txt" "/d/sub/")))) ; c,a recent; b,sub by name
(describe "editor messages"
  (test "message sets the one-line echo and appends to *Messages*"
    (let (m (message (m-of "x") "hi\nthere")
          msgs (nth (:buffers m) (ed-buffer-index-by-name! m "*Messages*")))
      (assert= (:echo m) "hi there") ; newlines flattened for the echo area
      (is (includes? (buffer-text msgs) "hi"))))
  (test "message leaves the current buffer's point untouched"
    (let (m (message (press (m-of "hello") [:right :right]) "note"))
      (assert= (buffer-point (cur m)) 2)))
  (test "the *Messages* buffer does not accumulate undo history"
    (let (m (-> (m-of "x") (message "one") (message "two") (message "three"))
          msgs (nth (:buffers m) (ed-buffer-index-by-name! m "*Messages*")))
      (assert= (:undo msgs) ()))))

;; eval-last-sexp evals the form *before point*, so put point at end of buffer
;; first (as it naturally is after typing the form) before the C-x C-e chord. Eval
;; now runs off the loop via `std/task` (so a long form can't freeze the editor): the
;; command returns an "evaluating…" model and the task delivers `[:task-done <handle>
;; msg]` (or `[:task-timeout <handle>]`) back. `eval-spawn` is just the C-x C-e
;; (returns immediately); `eval-result` receives the task's reply and folds it in;
;; `eval-buf` is the round-trip.
(defn eval-spawn (text)
  (press (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) [:ctrl-x :ctrl-e]))
(defn eval-result (m) (ed-update m (receive (x x)) 80 24))
(defn eval-buf (text) (eval-result (eval-spawn text)))

(describe "editor eval-last-sexp (C-x C-e)"
  (test "evaluates the form before point and shows the value"
    (is (includes? (get (eval-buf "(+ 1 2)") :echo) "=> 3")))
  (test "evaluates a multi-line form, not just the current line"
    (is (includes? (get (eval-buf "(+ 1\n   2\n   3)") :echo) "=> 6")))
  (test "evaluates the LAST form before point when several precede it"
    (is (includes? (get (eval-buf "(+ 1 1)\n(+ 2 2)") :echo) "=> 4")))
  (test "captures printed output into the message area (not the console)"
    (let (m (eval-buf "(io/puts \"foo\")"))
      (is (includes? (:echo m) "foo"))
      (is (includes? (:echo m) "=> nil"))))
  (test "a def persists, so you can define then call across evals"
    ;; define on one model, then call from another — globals persist in the image
    (let (_ (eval-buf "(defn bedit-demo-greet () (io/puts \"hi-from-demo\"))"))
      (is (includes? (get (eval-buf "(bedit-demo-greet)") :echo) "hi-from-demo"))))
  (test "an eval error is reported, not raised"
    (let (m (eval-buf "(this-is-not-defined)"))
      (is (not (:done m)))
      (is (includes? (:echo m) "error"))))
  (test "cmd-eval-buffer evaluates the whole buffer"
    (is (includes? (get (eval-result (cmd-eval-buffer (m-of "(+ 4 5)") nil)) :echo) "=> 9")))
  (test "cmd-eval-region evaluates the region between point and mark"
    (let (b (-> (make-buffer "(+ 2 3)") set-mark end-of-buffer)
          ; mark 0, point 7 → region is the whole form
          m (ed-set-buf (m-of "") b))
      (is (includes? (get (eval-result (cmd-eval-region m nil)) :echo) "=> 5"))))
  (test "eval runs in a separate process — the command returns immediately (no freeze)"
    ;; the C-x C-e command must return *without* running the form, so a slow/looping
    ;; form can't block the ui-run loop; it leaves an 'evaluating…' note and spawns.
    (let (m (eval-spawn "(+ 1 2)"))
      (is (includes? (:echo m) "evaluating"))
      (is (not (:done m)))
      (is (not (nil? (:eval-proc m)))))) ; the eval process is tracked for interrupt
  ;; ---- safeguards: C-g interrupt + optional timeout ----
  (test "C-g interrupts a running eval — kills its process and clears :eval-proc"
    ;; eval a form that parks ~100s; C-g must kill it instantly (not wait).
    (let (running (eval-spawn "(receive (after 100000 nil))")
          done (cmd-keyboard-quit running nil))
      (is (includes? (:echo done) "interrupted"))
      (is (nil? (:eval-proc done)))))
  (test "C-g with no eval in flight is a plain quit"
    (is (includes? (get (cmd-keyboard-quit (m-of "x") nil) :echo) "quit")))
  (test "an optional timeout kills a runaway eval and reports it"
    ;; arm a 50ms timeout on a form that would otherwise park ~100s; the watchdog
    ;; fires, kills the eval, and reports the timeout (received via eval-result).
    (let (m (eval-result (ed-eval-async (m-of "x") "(receive (after 100000 nil))" 50)))
      (is (includes? (:echo m) "timed out")))))

;; Quitting with unsaved work asks first — Emacs `save-buffers-kill-terminal`. C-x C-c
;; (and the window's X button, which reaches `ed-update` as `:close`) used to set `:done`
;; outright, dropping every unsaved edit on the floor.
(describe "quit asks about unsaved file buffers"
  (defn file-model (text)
    "A model on a file-backed buffer holding `text` on disk, then edited (so it is modified)."
    (let (path (str (temp-dir "bedit-quit-") ".txt")
          _ (file/spit path text)
          m (ed-find-file (m-of "x") path))
      (type-str m "!")))
  (test "a clean model quits at once"
    (let (m (ed-update (m-of "hi") :close 80 24))
      (is (:done (press (m-of "hi") [:ctrl-x :ctrl-c])))
      (is (:done m))))
  (test "a modified scratch buffer has no file to save, so it is not asked about"
    (is (:done (press (type-str (m-of "hi") "x") [:ctrl-x :ctrl-c]))))
  (test "y saves the file and quits; the echo shows what was asked"
    (let (m (press (file-model "on disk\n") [:ctrl-x :ctrl-c])
          path (or (buffer-file (cur m)) (error "the file model has no file")))
      (is (not (:done m)))
      (is (string/starts-with? (:echo m) (str "Save file " path "?")))
      (let (done (ed-update m "y" 80 24))
        (is (:done done))
        (assert= (file/slurp path) "!on disk\n"))))
  (test "n skips the save, then the exit-anyway question guards the loss"
    (let (m (ed-update (press (file-model "on disk\n") [:ctrl-x :ctrl-c]) "n" 80 24)
          path (or (buffer-file (cur m)) (error "the file model has no file")))
      (is (not (:done m)))
      (is (string/starts-with? (:echo m) "Modified buffers exist; exit anyway?"))
      (assert= (file/slurp path) "on disk\n")
      (is (not (:done (ed-update m "n" 80 24)))) ; n: stay
      (is (:done (ed-update m "y" 80 24))))) ; y: go, unsaved
  (test "C-g at a prompt cancels the quit"
    (let (m (ed-update (press (file-model "on disk\n") [:ctrl-x :ctrl-c]) :ctrl-g 80 24))
      (is (not (:done m)))
      (is (buffer-modified? (cur m)))))
  (test "the window's X button (:close) takes the same road as C-x C-c"
    (let (m (ed-update (file-model "on disk\n") :close 80 24))
      (is (not (:done m)))
      (is (string/starts-with? (:echo m) "Save file"))
      (is (:done (ed-update m "y" 80 24)))))
  (test "! saves every remaining buffer without asking again"
    (let (m1 (file-model "one\n")
          path2 (str (temp-dir "bedit-quit2-") ".txt")
          _ (file/spit path2 "two\n")
          m2 (type-str (ed-find-file m1 path2) "!")
          asked (press m2 [:ctrl-x :ctrl-c])
          done (ed-update asked "!" 80 24))
      (is (:done done))
      (assert= (file/slurp path2) "!two\n")
      (is (every? (:buffers done) (fn (b) (or (nil? (buffer-file b)) (not (buffer-modified? b))))))))
  (test "a running compile is asked about by name: n stays, y quits"
    (let (m (press (assoc (m-of "hi") :compile-running "make -j8") [:ctrl-x :ctrl-c]))
      (is (not (:done m)))
      (assert= (:echo m) "Still running: *compilation*: make -j8. Kill and exit anyway? (y or n)")
      (let (stayed (ed-update m "n" 80 24))
        (is (not (:done stayed)))
        (assert= (:echo stayed) "quit canceled"))
      (is (:done (ed-update m "y" 80 24)))
      (is (not (:done (ed-update m :ctrl-g 80 24))))))
  (test "the window's X button asks about it too"
    (let (m (ed-update (assoc (m-of "hi") :compile-running "make") :close 80 24))
      (is (not (:done m)))
      (is (string/starts-with? (:echo m) "Still running"))))
  (test "unsaved buffers first, then what is running — exit-anyway does not skip it"
    (let (m (assoc (file-model "on disk\n") :compile-running "make")
          asked (press m [:ctrl-x :ctrl-c])
          unsaved (ed-update asked "n" 80 24)
          running (ed-update unsaved "y" 80 24))
      (is (string/starts-with? (:echo unsaved) "Modified buffers exist"))
      (is (not (:done running)))
      (is (string/starts-with? (:echo running) "Still running: *compilation*: make."))
      (is (:done (ed-update running "y" 80 24)))))
  (test "! saves everything and still asks about what is running"
    (let (asked (press (assoc (file-model "on disk\n") :compile-running "make") [:ctrl-x :ctrl-c])
          saved (ed-update asked "!" 80 24))
      (is (not (:done saved)))
      (is (string/starts-with? (:echo saved) "Still running"))))
  (test "a frame's C-x C-c closes the frame: nothing is killed, nothing is asked"
    (is (:done (press (assoc (m-of "hi") :frame? true :compile-running "make") [:ctrl-x :ctrl-c]))))
  (test "several are named, the first two and how many more"
    (assert= (ed-live-processes-prompt ["a: x" "b: y" "c: z"])
      "Still running — a: x; b: y; and 1 more. Kill and exit anyway? (y or n)")
    (assert= (ed-live-processes-prompt ["a: x" "b: y"])
      "Still running — a: x; b: y. Kill and exit anyway? (y or n)")))

(describe "C-x C-c: each feature says what it has running, until it stops"
  (test "a compile, from its start until its exit folds in"
    (let (started (assoc (m-of "") :compile-running "make"))
      (assert= (compile/compile-live (m-of "")) [])
      (assert= (compile/compile-live started) ["*compilation*: make"])
      (assert= (compile/compile-live (compile/ed-ev-compile-done started
                                       (compile/compile-done-event 0)
                                       20
                                       80
                                       24))
        [])
      (assert= (compile/compile-live (compile/ed-ev-compile-done started
                                       (compile/compile-done-event 2)
                                       20
                                       80
                                       24))
        [])))
  (test "the app, while :apprun holds a run"
    (assert= (apprun/apprun-live (m-of "")) [])
    (assert= (apprun/apprun-live (assoc (m-of "") :apprun {:root "/src/shop" :gen 1}))
      ["*Run*: the app in shop"]))
  (test "an M-! command while its task runs"
    (assert= (shell-command/ed-shell-live (m-of "")) [])
    (assert= (shell-command/ed-shell-live (assoc (m-of "") :shell-proc :job :shell-cmd "sleep 9"))
      ["shell command: sleep 9"]))
  (test "a terminal whose program has not exited"
    (let (term (assoc (make-buffer "" "*claude: shop*")
                 :type :term
                 :term-proc (self)
                 :term-label "claude")
          m (assoc (m-of "") :buffers [(make-buffer "") term]))
      (assert= (terminal/term-live m) ["*claude: shop*: claude"])
      (assert= (terminal/term-live (assoc m :buffers [(assoc term :term-exited true)])) [])))
  (test "a shell with a command in flight, not an idle one"
    (let (shell (assoc (make-buffer "" "*bshell: shop*")
                  :type :bshell
                  :input-running true
                  :bshell-command "make test")
          m (assoc (m-of "") :buffers [shell]))
      (assert= (bshell/bshell-live m) ["*bshell: shop*: make test"])
      (assert= (bshell/bshell-live (assoc m :buffers [(assoc shell :input-running false)])) [])))
  (test "a push in flight, and a queued working-tree command"
    (assert= (vcsproc/vcs-live (m-of "")) [])
    (assert= (vcsproc/vcs-live (assoc (m-of "")
                                 :vcs-op {:verb "push" :root "/src/shop"}
                                 :vcs-op-proc :job))
      ["vc: push in shop"])
    (assert= (vcsproc/vcs-live (assoc (m-of "") :vcs-queue-proc :job))
      ["vc: a working-tree command"]))
  (test "a test run, until its runner exits — the current run's, not a superseded one's"
    (let (m (assoc (m-of "") :testrun {:gen 3 :label "shop_test" :running? true}))
      (assert= (testrun-cold/testrun-live m) ["*Tests*: shop_test"])
      (assert= (testrun-cold/testrun-live (ui-event-fold (testrun-cold/test-done-event 0 2)
                                            m 20 80 24))
        ["*Tests*: shop_test"])
      (assert= (testrun-cold/testrun-live (ui-event-fold (testrun-cold/test-done-event 0 3)
                                            m 20 80 24))
        [])
      (assert= (testrun-cold/testrun-live (ui-event-fold (testrun-cold/test-done-event nil 3)
                                            m 20 80 24))
        [])))
  (test "a warm test run, until its last reply, or its session goes away"
    (let (m (assoc (m-of "")
              :testrun {:gen 1 :label "t" :running? true :warm-id 7 :warm-session :brood-test}))
      (assert= (testrun-cold/testrun-live (testrun-warm/testrun-warm-reply m
                                            {:id 7 :more true :test {}}
                                            80
                                            24))
        ["*Tests*: t"])
      (assert= (testrun-cold/testrun-live (testrun-warm/testrun-warm-reply m
                                            {:id 7 :stopped true}
                                            80
                                            24))
        [])
      (assert= (testrun-cold/testrun-live (testrun-warm/testrun-warm-reply m
                                            {:id 7 :error "boom"}
                                            80
                                            24))
        [])
      (assert= (testrun-cold/testrun-live (testrun-warm/warm-down-of :brood-test m)) [])
      (assert= (testrun-cold/testrun-live (testrun-warm/warm-down-of :elixir-test m))
        ["*Tests*: t"])))
  (test "every registered feature is asked, sorted"
    (let (m (assoc (m-of "") :compile-running "make" :apprun {:root "/a/shop" :gen 1}))
      ;; touching each module registers its row, as loading it in the editor does
      (compile/compile-live m)
      (apprun/apprun-live m)
      (assert= (ed-live-processes m) ["*Run*: the app in shop" "*compilation*: make"]))))

(describe "kill-buffer asks about unsaved file changes"
  (test "a modified file buffer is kept on n and killed on y"
    (let (path (str (temp-dir "bedit-kill-") ".txt")
          _ (file/spit path "keep me\n")
          m (type-str (ed-find-file (m-of "x") path) "!")
          asked (press m [:ctrl-x "k"]))
      (is (string/starts-with? (:echo asked) "Buffer "))
      (assert= (buffer-file (cur (ed-update asked "n" 80 24))) path)
      (is (not (= (buffer-file (cur (ed-update asked "y" 80 24))) path)))))
  (test "a clean buffer is killed without a question"
    (let (path (str (temp-dir "bedit-kill2-") ".txt")
          _ (file/spit path "clean\n")
          m (ed-find-file (m-of "x") path))
      (is (not (= (buffer-file (cur (press m [:ctrl-x "k"]))) path))))))

;; Files that change under the editor (another writer: a formatter, `git checkout`).
;; `std/editor/buffer` stamps the file's mtime at the read and the save
;; (`buffer-file-changed?`); the idle beat reverts a clean buffer and warns on a dirty
;; one, and a save onto a changed file asks first.
(describe "a file changed on disk"
  (defn on-disk (text)
    (let (path (str (temp-dir "bedit-disk-") ".txt"))
      (do (file/spit path text) [path (ed-find-file (m-of "x") path)])))
  (defn changed-behind (m)
    "`m` with its current buffer stamped as if the file had been written since."
    (ed-set-buf m (assoc (cur m) :file-mtime (dec (:file-mtime (cur m))))))
  (test "a clean buffer is reverted on the idle beat, point kept, mode kept"
    (let ([path m0] (on-disk "old text\n")
          m1 (press m0 [:ctrl-f :ctrl-f]) ; point at 2
          _ (file/spit path "new text on disk\n")
          m2 (ed-revert-changed-files (changed-behind m1)))
      (assert= (buffer-text (cur m2)) "new text on disk\n")
      (assert= (buffer-point (cur m2)) 2)
      (assert= (:layers (cur m2)) (:layers (cur m1)))
      (is (includes? (:echo m2) "reverted"))
      ;; agreed again: a second beat does nothing
      (assert= (cur (ed-revert-changed-files m2)) (cur m2))))
  ;; another writer added lines ABOVE point (a formatter, a merge): the character offset
  ;; now lands mid-way through some other line; the line diff says where point's line went
  (test "a revert keeps point on the same logical line and column"
    (let ([path m0] (on-disk "a\nb\ntarget\n")
          m1 (press m0 [:ctrl-n :ctrl-n :ctrl-f :ctrl-f :ctrl-f]) ; line 2, column 3
          _ (file/spit path "new one\nnew two\na\nb\ntarget\n")
          m2 (ed-revert-changed-files (changed-behind m1)))
      (assert= (buffer-current-line (cur m2)) 4)
      (assert= (buffer-point (cur m2)) (+ (count "new one\nnew two\na\nb\n") 3))))
  (test "an auto-revert is one undoable edit: C-/ brings back the text it replaced"
    (let ([path m0] (on-disk "old text\n")
          m1 (type-str m0 "!")
          m2 (press m1 [:ctrl-x :ctrl-s]) ; saved "!old text\n"
          _ (file/spit path "new text on disk\n")
          reverted (ed-revert-changed-files (changed-behind m2))
          undone (editing/cmd-undo reverted nil))
      (assert= (buffer-text (cur reverted)) "new text on disk\n")
      (assert= (buffer-text (cur undone)) "!old text\n")
      ;; the text it gave back is not what is on disk: modified, so a save is asked for
      (is (buffer-modified? (cur undone)))
      ;; and the typing before the save is still in the history behind it: the same run
      (assert= (buffer-text (cur (press reverted [:ctrl-/ :ctrl-/]))) "old text\n")))
  (test "M-x revert-buffer discards unsaved edits as one undoable edit"
    (let ([_path m0] (on-disk "on disk\n")
          m1 (type-str m0 "unsaved ")
          reverted (cmd-revert-buffer m1 nil)
          undone (editing/cmd-undo reverted nil))
      (assert= (buffer-text (cur reverted)) "on disk\n")
      (is (not (buffer-modified? (cur reverted))))
      (is (includes? (:echo reverted) "reverted"))
      (assert= (buffer-text (cur undone)) "unsaved on disk\n")
      (is (buffer-modified? (cur undone)))))
  (test "a revert clamps a point past the new end"
    (let ([path m0] (on-disk "a long line of text\n")
          m1 (press m0 [:alt->]) ; end of buffer
          _ (file/spit path "ab\n")
          m2 (ed-revert-changed-files (changed-behind m1)))
      (assert= (buffer-point (cur m2)) 3)))
  (test "a modified buffer is kept and warned about once per on-disk version"
    (let ([path m0] (on-disk "old text\n")
          m1 (type-str m0 "!")
          _ (file/spit path "new text on disk\n")
          m2 (ed-revert-changed-files (changed-behind m1)))
      (assert= (buffer-text (cur m2)) "!old text\n")
      (is (includes? (:echo m2) "changed on disk"))
      ;; the next beat is quiet about the same version
      (assert= (:echo (message (ed-revert-changed-files m2) "quiet")) "quiet")))
  (test "saving onto a changed file asks; n keeps the disk version, y overwrites"
    (let ([path m0] (on-disk "old text\n")
          m1 (changed-behind (type-str m0 "!"))
          _ (file/spit path "theirs\n")
          asked (press m1 [:ctrl-x :ctrl-s]))
      (is (includes? (:echo asked) "Save anyway?"))
      (assert= (file/slurp path) "theirs\n")
      (ed-update asked "n" 80 24)
      (assert= (file/slurp path) "theirs\n")
      (let (saved (ed-update asked "y" 80 24))
        (assert= (file/slurp path) "!old text\n")
        (is (not (buffer-modified? (cur saved))))
        ;; the save re-stamped: the file and the buffer agree, no revert follows
        (is (not (buffer-file-changed? (cur saved))))))))

;; A beat asks the disk about the buffers on screen; the rest take turns, a few per
;; `*auto-revert-interval-ms*`, never more than `*auto-revert-max-per-beat*` in all.
(describe "auto-revert asks the disk about a bounded few per beat"
  (defn many-files (n)
    "A model with `n` file buffers opened in turn, the last one shown, and their paths."
    (let (stem (temp-dir "bedit-many-")
          paths (map (range n) (fn (i) (str stem "-f" i ".txt"))))
      (doseq (p paths) (file/spit p "text\n"))
      [paths (fold paths (m-of "x") (fn (acc p) (ed-find-file acc p)))]))
  (test "the shown buffer every beat, the rest at most N in turn, each round past the last"
    (let ([_paths m] (many-files 20)
          shown (ed-current-index m)
          [first-round m1] (ed-auto-revert-candidates m 100000)
          [quiet _] (ed-auto-revert-candidates m1 101000)
          [second-round _] (ed-auto-revert-candidates m1 105000))
      (assert= (count first-round) *auto-revert-max-per-beat*)
      (assert= (first first-round) shown)
      ;; inside the interval only the screen is asked about
      (assert= quiet (list shown))
      (assert= (count second-round) *auto-revert-max-per-beat*)
      (assert= (first second-round) shown)
      ;; the second round takes the buffers after the first's, none twice
      (is (empty? (set/intersection (set/set (rest first-round)) (set/set (rest second-round)))))
      (is (every? (append first-round second-round) (fn (i) (buffer-file (ed-buf-at m i)))))))
  (test "a buried buffer changed on disk is still reverted, on its turn"
    (let ([paths m] (many-files 3)
          buried (ed-buffer-index-by-name! m (path/basename (first paths)))
          _ (file/spit (first paths) "theirs\n")
          stamped (assoc m
                    :buffers
                      (assoc (:buffers m)
                        buried
                          (let (b (ed-buf-at m buried))
                            (assoc b :file-mtime (dec (:file-mtime b))))))
          reverted (ed-revert-changed-files stamped))
      (assert= (buffer-text (ed-buf-at reverted buried)) "theirs\n"))))

(describe "auto-save (#file# sidecars) — only what changed, written off the loop"
  ;; a model whose current buffer is a modified file buffer at `path`
  (defn modified-at (path)
    (let (m (ed-init (find-file-buffer path)))
      (ed-update m "!" 80 24)))
  (test "a modified file buffer is due; written, its rope is remembered and not due again"
    (let (path (str (temp-dir "bedit-as-") ".txt")
          _ (file/spit path "text\n")
          m (modified-at path)
          rope (buffer-rope (cur m))
          due (ed-auto-save-due m))
      (assert= (:due due) {path rope})
      (ed-auto-save-write (:due due))
      (assert= (file/slurp (ed-auto-save-path path)) "!text\n")
      (let (saved (ed-auto-save! m))
        (assert= (:auto-saved saved) {path rope})
        ;; nothing typed since: the next round has nothing to write
        (assert= (:due (ed-auto-save-due saved)) {})
        ;; one more key and it is due again
        (assert= (keys (:due (ed-auto-save-due (ed-update saved "?" 80 24)))) (list path)))
      (ed-remove-auto-save path)))
  (test "an unmodified buffer is never due, and drops out of what was written"
    (let (path (str (temp-dir "bedit-as2-") ".txt")
          _ (file/spit path "text\n")
          m (ed-init (find-file-buffer path))
          stale (assoc m :auto-saved {path :an-old-rope}))
      (assert= (ed-auto-save-due stale) {:due {} :all {} :sudo {}}))))

;; ui-run's watchdog (brood ADR-490) hands a slow turn back as an event; it is logged, never
;; echoed, so the next stall names its cause without interrupting the reader.
(describe "a slow turn the watchdog reports"
  (test "lands in *Messages* naming the phase, the time and what was folding, and leaves the echo alone"
    (let (m (message (ed-init (editor/buffer/make-buffer "x")) "reading")
          m2 (ed-update m [:ui-slow {:phase "update" :tag [:timer :idle] :ms 73}] 80 24)
          log (editor/buffer/buffer-text (ed-buf-at m2 (ed-buffer-index-by-name! m2 "*Messages*"))))
      (is (includes? log "slow update 73ms on [:timer :idle]"))
      (assert= (:echo m2) "reading")))
  (test "the model carries the hook, so the live loop routes reports here"
    (is (fn? (:on-slow (ed-init (editor/buffer/make-buffer "x")))))))

;; An interrupted turn (brood ADR-491): a command the reader stopped with C-g echoes `Quit`;
;; a background event the loop's ceiling stopped is only logged.
(describe "an interrupted turn the watchdog reports"
  (test "a command stopped by C-g echoes Quit and is logged"
    (let (m (ed-update (ed-init (editor/buffer/make-buffer "x"))
              [:ui-slow {:phase "update" :tag "x" :ms 412 :interrupted true :input true}]
              80
              24))
      (assert= (:echo m) "Quit")
      (is (includes? (editor/buffer/buffer-text (ed-buf-at m
                                                  (ed-buffer-index-by-name! m "*Messages*")))
            "interrupted update 412ms on \"x\""))))
  (test "a background event stopped by the ceiling is logged, not echoed"
    (let (m (ed-update (message (ed-init (editor/buffer/make-buffer "x")) "reading")
              [:ui-slow
                {:phase "update" :tag :lsp-diagnostics :ms 2000 :interrupted true :input false}]
              80
              24))
      (assert= (:echo m) "reading")
      (is (includes? (editor/buffer/buffer-text (ed-buf-at m
                                                  (ed-buffer-index-by-name! m "*Messages*")))
            "interrupted update 2000ms on :lsp-diagnostics")))))

(describe "the watchdog does not feed itself"
  (test "a slow turn spent logging a slow turn is not reported again"
    (ed-report-slow {:phase "update" :tag :ui-slow :ms 80 :input false})
    (assert= (receive ([:ui-slow r] r) (after 0 :none)) :none))
  (test "any other slow turn is"
    (ed-report-slow {:phase "update" :tag :lsp-notices :ms 80 :input false})
    (assert= (:tag (receive ([:ui-slow r] r) (after 1000 :none))) :lsp-notices)))
