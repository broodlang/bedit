;; so-long (src/solong.blsp): a file with a line over `:so-long-threshold` opens truncated
;; with its per-line services off, says so, and M-x so-long-mode toggles it.
(defmodule solong-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use solong)
  (:use scroll) ; ed-long-lines — the policy so-long sets is the ordinary one
  (:use model)
  (:use pool)
  (:use view) ; ed-bracket-overrides — show-paren, which so-long turns off
  (:use editor/buffer)
  (:use test))

(purge-stale-temp "bedit-solong-")

(defn- fixture-file (name text)
  "A fresh file `name` holding `text` in its own temp directory; its path."
  (let (dir (temp-dir "bedit-solong-")
        _ (file/mkdir dir)
        path (path/join dir name))
    (do (file/spit path text) path)))

(defn- line-of (n) (string/repeat "x" n))

(describe "so-long: finding a line over the threshold"
  (test "a file of short lines has none; a line one past the threshold is found"
    (is (nil? (long-line (text/from-string "a\nbb\nccc\n") 3)))
    (is (nil? (long-line (text/from-string (str "a\n" (line-of 100) "\nb")) 100)))
    (assert= (long-line (text/from-string (str "a\n" (line-of 101) "\nb")) 100) [1 101]))
  (test "the line is found wherever it is: among many short lines, last, or the whole file"
    (let (short (string/join (map (range 400) (fn (i) (str "line " i))) "\n"))
      (assert= (long-line (text/from-string (str short "\n" (line-of 50) "\n" short)) 40)
        [400 50])
      (assert= (long-line (text/from-string (str short "\n" (line-of 50))) 40) [400 50])
      (assert= (long-line (text/from-string (line-of 5000)) 10) [0 5000])))
  (test "the first of several long lines, and no threshold finds nothing"
    (assert= (long-line (text/from-string (str "a\n" (line-of 30) "\n" (line-of 90))) 20) [1 30])
    (is (nil? (long-line (text/from-string (line-of 50)) false)))
    (is (nil? (long-line (text/from-string (line-of 50)) 0)))))

(describe "so-long: a file opened with a long line"
  (test "opens truncated and says why; a short file does not"
    (let (m (ed-find-file (ed-init (make-buffer ""))
              (fixture-file "min.js" (str "a\n" (line-of 12000) "\n")))
          buf (cur m))
      (is (so-long? buf))
      (assert= (ed-long-lines buf 1) :truncate)
      (is (includes? (:echo m) "so-long: line 2 is 12000 characters")))
    (let (m (ed-find-file (ed-init (make-buffer "")) (fixture-file "notes.txt" "short\n")))
      (is (not (so-long? (cur m))))
      (is (not (includes? (:echo m) "so-long")))))
  (test "the threshold is the setting's: false never, a lower one sooner"
    (let (path (fixture-file "big.json" (str (line-of 12000) "\n"))
          off (ed-find-file (assoc (ed-init (make-buffer "")) :so-long-threshold false) path)
          low (ed-find-file (assoc (ed-init (make-buffer "")) :so-long-threshold 50)
                (fixture-file "mid.txt" (str (line-of 60) "\n"))))
      (is (not (so-long? (cur off))))
      (is (so-long? (cur low)))))
  (test "show-paren, eldoc and the rest leave a so-long buffer alone"
    ;; a brood-mode buffer, whose show-paren matches the pair at point — until so-long
    (let (buf (goto-char (ed-current-buf (ed-init (make-buffer (str "(" (line-of 20) ")")
                                                    "x.blsp" "x.blsp")))
                0)
          long (so-long-on buf [0 22]))
      (is (not (empty? (spanpaint/ed-bracket-overrides buf))))
      (is (= (spanpaint/ed-bracket-overrides long) '()))
      (is (not (eldoc/ed-eldoc-stale? (ed-set-buf (ed-init (make-buffer "")) long)))))))

(describe "so-long: M-x so-long-mode"
  (test "off puts back the policy the buffer had, on takes it again"
    (let (m (ed-find-file (ed-init (make-buffer ""))
              (fixture-file "log.txt" (str (line-of 11000) "\n")))
          off (cmd-so-long-mode m nil)
          on (cmd-so-long-mode off nil))
      (is (not (so-long? (cur off))))
      (assert= (ed-long-lines (cur off) 0) :scroll)
      (is (includes? (:echo off) "so-long-mode off"))
      (is (so-long? (cur on)))
      (assert= (ed-long-lines (cur on) 0) :truncate)))
  (test "a buffer's own long-lines toggle survives a round trip"
    (let (wrapped (assoc (make-buffer "text") :long-lines :wrap)
          round (so-long-off (so-long-on wrapped nil)))
      (assert= (:long-lines (so-long-on wrapped nil)) :truncate)
      (assert= (:long-lines round) :wrap)
      (is (not (so-long? round))))))

(describe "so-long: every path that brings a file into the pool"
  (test "a jump to a location (next-error, goto-definition) opens the file in the cheap state"
    (let (path (fixture-file "bundle.min.js" (str "a\n" (line-of 12000) "\n"))
          m (ed-pop-to-file (ed-init (make-buffer "*compilation*")) path 2))
      (assert= (:file (cur m)) path)
      (is (so-long? (cur m)))
      (assert= (ed-long-lines (cur m) 1) :truncate)
      (is (includes? (:echo m) "so-long: line 2"))))
  (test "a jump to a short file says nothing of so-long"
    (let (m (ed-pop-to-file (ed-init (make-buffer "*compilation*"))
              (fixture-file "short.js" "a\nb\n")
              1))
      (is (not (so-long? (cur m))))))
  (test "the launch path says what it found once there is a model (so-long-note)"
    (let ([buf note] (so-long-visit (make-buffer (str "x\n" (line-of 50))) 40))
      (assert= (so-long-note buf) note)
      (is (includes? note "line 2 is 50 characters"))
      (is (nil? (so-long-note (so-long-on (make-buffer "") nil))))
      (is (nil? (so-long-note (make-buffer "short"))))))
  (test "another frame's copy carries the state over from the registry's meta"
    (let ([buf _] (so-long-visit (make-buffer (str (line-of 50) "\n") "big.txt" "/tmp/big.txt") 40)
          meta (hosted/hosted-meta buf)
          copy (so-long-carried (make-buffer "" "big.txt" "/tmp/big.txt") (:so-long meta)))
      (is (so-long? copy))
      (assert= (:long-lines copy) :truncate)
      (is (not (so-long? (so-long-carried (make-buffer "") nil))))))
  (test "a served or shared session's file is checked too"
    (is (so-long? (so-long-checked (make-buffer (line-of 20000)))))
    (is (not (so-long? (so-long-checked (make-buffer "short")))))))
