;; The window's type setup and the named presets over it — `src/appearance.blsp`. Pure
;; model tests: `apply!`'s window calls are `gui-only`, so headless they are no-ops and what
;; is left is exactly the state the model records.
;;
;; The behaviour under test is a complaint, twice: Ctrl+wheel zoom was "VERY sensitive"
;; (a `:scale` level was a whole multiple, and one notch is a kinetic burst of events), and
;; then, as a step on the WINDOW's font, it was janky however it was paced. Stepping a
;; BUFFER's size a pixel at a time, once a notch's worth of delta has accumulated, and
;; painting that buffer in a cell region, is what makes it incremental and smooth.

(defmodule appearance-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use appearance))

;; `:gui` as `main` sets it under a window: a zoom is a GUI thing (a terminal cell has one size)
(defn m0 () (assoc (ed-init (make-buffer "hello")) :gui true))

(describe "the window's type setup"
  (test "a fresh model reports the default, and apply! records what it set"
    (assert= (:height (current (m0))) 15)
    (let (m (apply! (m0) {:family :hack :height 22 :line-height 1.5}))
      (assert= (:height (current m)) 22)
      (assert= (:line-height (current m)) 1.5)))
  (test "a size outside the readable range is clamped, not applied"
    (assert= (:height (current (apply! (m0) {:height 900}))) *max-height*)
    (assert= (:height (current (apply! (m0) {:height 1}))) *min-height*))
  (test "apply! keeps the fields it was not given"
    (let (m (apply! (apply! (m0) {:family :hack :height 20 :line-height 1.3}) {:height 21}))
      (assert= (:line-height (current m)) 1.3))))

;; ---- what a NOTCH is, and why the unit is the whole point --------------------
;; A wheel notch is not one event. The runtime gives it an impulse and a kinetic ticker
;; delivers a decaying stream of events whose deltas sum to ~3 lines (brood's
;; `a_single_notch_glides_about_three_lines`). These helpers deliver a notch the way the
;; runtime does — as that stream — so the tests measure what a hand on the wheel gets.

(defn notch-stream (dir)
  ;; A decaying impulse summing to EXACTLY `*zoom-step-lines*`, like the runtime's glide
  ;; (0.45 per tick decaying at 0.85 — brood's `WHEEL_IMPULSE`/`WHEEL_DECAY`). Normalised by
  ;; its own sum, so "one notch is one pixel" is an exact claim and fifteen notches are
  ;; fifteen pixels rather than fifteen-ish.
  (let (raw (fold (range 20) [] (fn (acc i) (conj acc (* 0.45 (math/pow 0.85 i)))))
        total (math/sum raw))
    (map raw (fn (v) (* dir (* *zoom-step-lines* (/ v total)))))))

(defn pane0 (m) (first (:panes (panes/ed-body-layout m 80 24))))
(defn notches (m dir n)
  ;; `n` physical notches, each as its own kinetic stream, over the pointer's pane
  (fold (range n)
    m
    (fn (acc _) (fold (notch-stream dir) acc (fn (a dy) (zoom-step a (pane0 a) dy))))))
(defn px-of (m) (zoom-px m (pane0 m)))

(describe "Ctrl+wheel steps the pane's size incrementally"
  ;; The complaint, twice over: one notch must be ONE pixel. At a divisor of 1.0 a notch
  ;; stepped three (its glide sums to ~3 lines), which read as "too sensitive", and the
  ;; accumulated target then lurched a whole spin's worth per throttle tick.
  (test "one physical notch is one pixel"
    (assert= (px-of (notches (m0) 1 1)) 16)
    (assert= (px-of (notches (m0) -1 1)) 14))
  (test "three notches are three pixels — the response is linear in the hand"
    (assert= (px-of (notches (m0) 1 3)) 18))
  (test "a fraction of a notch does not step at all"
    (let (m (fold (take (notch-stream 1) 4) (m0) (fn (a dy) (zoom-step a (pane0 a) dy))))
      (assert= (px-of m) 15)
      (is (nil? (zoom-of (pane0 m)))))) ; and an unzoomed pane carries no zoom
  (test "and its leftover is kept, so the rest of the notch still gets there"
    (assert= (px-of (notches (m0) 1 1)) 16))
  (test "shrinking needs the same push as growing (no floor asymmetry)"
    (let (half (fold (take (notch-stream -1) 6) (m0) (fn (a dy) (zoom-step a (pane0 a) dy))))
      (assert= (px-of half) 15))
    (assert= (px-of (notches (m0) -1 1)) 14))
  (test "zoom stops at the readable bounds"
    (assert= (px-of (notches (m0) 1 200)) *max-height*)
    (assert= (px-of (notches (m0) -1 200)) *min-height*))
  (test "the size shows in the echo area and NOT in *Messages*"
    ;; a zoom from 15 to 30 used to append fifteen lines to the buffer
    ;; a fresh model always has *Messages* in the pool (`ed-init` seeds it), so this indexes
    ;; rather than guarding — the checker is right that the guard could never fire
    (defn msg-lines (mm)
      (buffer-line-count (nth (:buffers mm)
                           (seq/index-where (:buffers mm) (fn (b) (= (buffer-name b) "*Messages*"))))))
    (let (before (msg-lines (m0))
          m (notches (m0) 1 15)
          after (msg-lines m))
      (assert= (px-of m) 30)
      (is (includes? (:echo m) "30 px"))
      (assert= after before))))

;; ---- the zoom is the PANE's, and the window's font never moves ----------------------
;; This is the model that made the jank go away. A zoom used to change the window's font:
;; the grid shrank, every pane was re-laid, the status bar jumped, and pacing it was a
;; fight with the wheel's kinetic stream. A size that belongs to one pane changes that
;; pane's ops and nothing else — not the window, and not the other pane on the same
;; buffer (a split copies the buffer; zooming one side must not zoom the other, which is
;; what "all the buffers zoom" looked like when the size lived on the buffer).
(describe "a zoom belongs to the pane"
  (test "the window's size is untouched by any number of notches"
    (assert= (:height (current (notches (m0) 1 10))) 15))
  (test "it is recorded on the pane with its cell ratio — measured against the window"
    (let (z (zoom-of (pane0 (notches (m0) 1 3))))
      (assert= (:px z) 18)
      ;; headless there is no window to measure, so the ratio is the size ratio
      (assert= (:ratio z) [(/ 18 15) (/ 18 15)])))
  (test "back at the window's size the pane is simply unzoomed, not zoomed to 1"
    (is (nil? (zoom-of (pane0 (notches (notches (m0) 1 2) -1 2))))))
  (test "the buffer itself carries nothing — a zoom is not a property of the text"
    (let (m (notches (m0) 1 4))
      (is (every? (:buffers m) (fn (b) (nil? (:zoom b)))))))
  (test "a split shows the same buffer twice: zooming one side leaves the other alone"
    (let (split (input/ed-update (input/ed-update (m0) :ctrl-x 80 24) "3" 80 24)
          panes (fn (m) (:panes (panes/ed-body-layout m 80 24)))
          right (second (panes split))
          zoomed (fold (notch-stream 1) split (fn (a dy) (zoom-step a right dy)))
          [l r] (into [] (panes zoomed)))
      (assert= (get-in l [:payload :buffer]) (get-in r [:payload :buffer])) ; same buffer
      (assert= (zoom-px zoomed r) 16)
      (assert= (zoom-px zoomed l) 15)
      (is (nil? (zoom-of l)))))
  (test "the keyboard steps the current pane the same pixel: C-x C-= / C-x C-- / C-x C-0"
    (let (up (zoom-adjust (zoom-adjust (m0) 1) 1)
          down (zoom-adjust up -1)
          reset (zoom-reset up))
      (assert= (px-of up) 17)
      (assert= (px-of down) 16)
      (assert= (px-of reset) 15)
      (is (nil? (zoom-of (pane0 reset))))))
  (test "a preset changes the window under a zoomed pane: its px stays, its ratio moves"
    (let (m (preset-apply (notches (m0) 1 3) "Pairing"))
      ; the window to 19 px
      (assert= (px-of m) 18)
      (assert= (:ratio (zoom-of (pane0 m))) [(/ 18 19) (/ 18 19)])))
  (test "and a pane the preset lands exactly on is unzoomed by it"
    (let (m (preset-apply (notches (m0) 1 4) "Pairing"))
      ; zoomed to 19, window to 19
      (is (nil? (zoom-of (pane0 m)))))))

;; ---- through the event path: the wheel over a pane, the frame it paints ----------------
(describe "Ctrl+wheel through ed-update zooms the pane under the pointer"
  (defn wheel (m dir col)
    (fold (notch-stream dir)
      m
      (fn (a dy) (input/ed-update a [:mouse :scroll-up nil 5 col [:ctrl] dy] 80 24))))
  (test "six notches in a row each move one pixel — no timer to re-arm, nothing to pace"
    (let (sizes (second (fold (range 6)
                          [(m0) []]
                          (fn ([m acc] _)
                            (let (m1 (wheel m 1 5)) [m1 (conj acc (px-of m1))])))))
      (assert= sizes [16 17 18 19 20 21])))
  (test "Shift makes no difference: there is one zoom"
    (let (m (fold (notch-stream 1)
              (m0)
              (fn (a dy) (input/ed-update a [:mouse :scroll-up nil 5 5 [:ctrl :shift] dy] 80 24))))
      (assert= (px-of m) 16)))
  (test "a notch off every pane does nothing"
    (let (m (wheel (m0) 1 400))
      (assert= (px-of m) 15)))
  (test "a zoomed pane is painted inside a cell-region at its size; unzoomed, flat"
    (let (flat (view/ed-view (m0) 80 24)
          zoomed (view/ed-view (notches (m0) 1 3) 80 24)
          region (seq/find (rest zoomed) (fn (op) (= (first op) :cell-region))))
      (is (nil? (seq/find (rest flat) (fn (op) (= (first op) :cell-region)))))
      (is (not (nil? region)))
      ;; [:cell-region x y w h px ops]: the pane's rect less the scrollbar column and the
      ;; mode line row, at the pane's size, with the text inside laid out from 0,0
      (assert= (into [] (take (rest region) 5)) [0 0 79 22 18])
      (is (any? (nth region 6) (fn (op) (and (= (first op) :text) (includes? (nth op 3) "hello"))))))))

(describe "presets"
  (test "the built-ins are there and apply live"
    (is (includes? (names) "Presenting"))
    (let (m (preset-apply (m0) "Presenting"))
      (assert= (:height (current m)) 26)))
  (test "an unknown name reports rather than changing anything"
    (let (m (preset-apply (apply! (m0) {:height 17}) "nope"))
      (assert= (:height (current m)) 17)
      (is (includes? (:echo m) "no such preset"))))
  (test "by-name reads the registry, and every built-in is a complete setup"
    (doseq (n (names))
      (let (p (by-name n))
        (is (not (nil? (:family p))))
        (is (int? (:height p)))
        (is (not (nil? (:line-height p))))))))

;; The save/list/delete cycle on a TEMP file — the `-in` / `-to!` forms exist for exactly
;; this, so a test never writes the developer's real presets (the split `projects.blsp` uses
;; for every persisted cache here).
(purge-stale-temp "bedit-preset-")
(defn tmp-presets () (str (temp-dir "bedit-preset-") "/presets.blsp"))

(describe "saving and managing presets"
  (test "saving records what the window is showing, and it reads back"
    (let (f (tmp-presets)
          m (apply! (m0) {:family :hack :height 31 :line-height 1.6})
          _ (preset-save-to! f m "Call")
          p (seq/find (all-in f) (fn (p) (= (:name p) "Call"))))
      (assert= (:height p) 31)
      (assert= (:line-height p) 1.6)))
  (test "a saved preset shadows a built-in of the same name — one entry, not two"
    (let (f (tmp-presets)
          m (apply! (m0) {:height 40})
          _ (preset-save-to! f m "Presenting")
          named (seq/filter (all-in f) (fn (p) (= (:name p) "Presenting"))))
      (assert= (count named) 1)
      (assert= (:height (first named)) 40)))
  (test "deleting a shadowing preset brings the built-in back"
    (let (f (tmp-presets)
          m (apply! (m0) {:height 40})
          _ (preset-save-to! f m "Presenting")
          _ (preset-delete-from! f m "Presenting")
          p (seq/find (all-in f) (fn (p) (= (:name p) "Presenting"))))
      (assert= (:height p) 26))) ; the built-in, not the saved 40
  (test "deleting something never saved reports rather than pretending"
    (let (f (tmp-presets)
          m (preset-delete-from! f (m0) "Nope"))
      (is (includes? (:echo m) "no saved preset"))))
  (test "a save replaces rather than accumulating under one name"
    (let (f (tmp-presets)
          _ (preset-save-to! f (apply! (m0) {:height 20}) "Call")
          _ (preset-save-to! f (apply! (m0) {:height 28}) "Call")
          mine (saved-in f))
      (assert= (count mine) 1)
      (assert= (:height (first mine)) 28)))
  (test "an unreadable presets file costs the presets, not the editor"
    (let (f (tmp-presets)
          _ (file/mkdir (path/dirname f))
          _ (file/spit f "{{{ not a literal")
          ok (all-in f))
      (assert= (count (saved-in f)) 0)
      (is (includes? (map ok (fn (p) (:name p))) "Default")))))

;; A terminal cell has one size, and the frontend-agnostic path (a `*term-display*` harness,
;; an `--attach` client) skips a `cell-region` — so a zoom there would blank the pane.
(describe "a zoom is a GUI thing"
  (test "without a window it is refused, and says why"
    (let (m (zoom-adjust (ed-init (make-buffer "hello")) 1))
      (assert= (zoom-px m (pane0 m)) 15)
      (is (includes? (:echo m) "zoom needs the window")))))

;; The way back to 100% without remembering a key: a zoomed pane's mode line carries a chip
;; with its size, and one click on it is `text-scale-reset` — for THAT pane, so on a split the
;; chip on the unselected side resets that side (and selects it, as any click there would).
(describe "the zoom chip on the mode line"
  (defn segs (m pane) (view/ed-statusbar-segments m pane (panes/ed-pane-buf m pane)))
  (defn chip (m pane) (seq/find (segs m pane) (fn (s) (= (:id s) :zoom))))
  (test "an unzoomed pane has no chip; a zoomed one names its size and is clickable"
    (is (nil? (chip (m0) (pane0 (m0)))))
    (let (m (notches (m0) 1 5)
          c (chip m (pane0 m)))
      (assert= (:text c) "⌕ 20px")
      (assert= (:on-click c) 'appearance/cmd-text-scale-reset)))
  (test "clicking the chip puts the pane back at the window's size, and the chip goes"
    (let (m (notches (m0) 1 5)
          [x y w h] (:rect (pane0 m))
          laid (statusbar/statusbar-layout (segs m (pane0 m)) x (+ y (dec h)) w {} nil true)
          z (seq/find (:zones laid) (fn (z) (= (:id z) :zoom)))
          after (view/ed-modeline-click m 80 24 (first (:rect z)) (second (:rect z))))
      (is (not (nil? z)))
      (assert= (px-of after) 15)
      (is (nil? (chip after (pane0 after))))))
  (test "on a split, the chip on the UNSELECTED side resets that side — and selects it"
    (let (split (input/ed-update (input/ed-update (m0) :ctrl-x 80 24) "3" 80 24)
          panes (fn (m) (:panes (panes/ed-body-layout m 80 24)))
          right (second (panes split))
          zoomed (fold (range 5)
                   split
                   (fn (a _) (fold (notch-stream 1) a (fn (b dy) (zoom-step b right dy)))))
          r (second (panes zoomed))
          [x y w h] (:rect r)
          laid (statusbar/statusbar-layout (segs zoomed r) x (+ y (dec h)) w {} nil true)
          z (seq/find (:zones laid) (fn (z) (= (:id z) :zoom)))
          after (view/ed-modeline-click zoomed 80 24 (first (:rect z)) (second (:rect z)))
          [l2 r2] (into [] (panes after)))
      (assert= (zoom-px zoomed r) 20)
      (is (not (nil? z)))
      (is (nil? (zoom-of r2)))
      (is (:selected r2))
      (is (nil? (zoom-of l2))))))

;; theme-apply! re-derives every chrome face from the new palette with its own copy of the
;; formulas, and the copies had drifted (issue C3): `:bold` gone from eight faces, so even
;; re-selecting the default theme changed how brackets, menus and dired looked. Applying
;; the default palette must reproduce the load-time faces EXACTLY — which is also a
;; no-op, so this is safe beside tests that paint.
(defn- chrome-faces-now ()
  ;; every face `defchrome` registered — the registry theme-apply! re-runs, so a face added
  ;; later is covered without editing this
  (into {} (map theme/*chrome-faces* (fn (entry) [(first entry) (reflect/eval (first entry))]))))

(describe "theme-apply! and the load-time faces agree"
  (test "applying the default palette changes no chrome face"
    (let (before (chrome-faces-now))
      (theme/theme-apply! theme/*theme-mocha*)
      (assert= (chrome-faces-now) before)))
  ;; …and applies at all: another palette re-derives every face from ITS colours, the alias
  ;; included. Restored after, because the faces are globals other tests paint with.
  :isolated (test "another palette re-derives every face, an alias with what it names"
    (let (_ (theme/theme-apply! themes/*tokyo*)
          modeline theme/face-modeline
          divider theme/face-divider
          border theme/face-border
          _ (theme/theme-apply! theme/*theme-mocha*))
      (assert= modeline {:fg (:text themes/*tokyo*) :bg (:surface0 themes/*tokyo*)})
      (assert= divider border)
      (assert= border {:bg (:surface1 themes/*tokyo*)}))))
