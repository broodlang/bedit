;; The window's type setup and the named presets over it — `src/appearance.blsp`. Pure
;; model tests: `apply!`'s window calls are `gui-only`, so headless they are no-ops and what
;; is left is exactly the state the model records.
;;
;; The behaviour under test is a complaint: Ctrl+wheel zoom was "VERY sensitive". Two causes,
;; both pinned below. A `:scale` level is a whole multiple, so the smallest step was +100%;
;; and the runtime turns one notch into a kinetic burst of events, so a single notch crossed
;; the entire range. Stepping the font SIZE, and only once a notch's worth of delta has
;; accumulated, is what makes it incremental.

(defmodule appearance-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use appearance))

(defn m0 () (ed-init (make-buffer "hello")))
(defn pane-scale-of (m)
  (let (p (first (:panes (panes/ed-body-layout m 80 24))))
    (math/max 1 (or (:scale (:payload p)) 1))))

(describe "the window's type setup"
  (test "a fresh model reports the default, and apply! records what it set"
    (assert= (:height (current (m0))) 15)
    (let (m (apply! (m0) {:family :hack :height 22 :line-height 1.5}))
      (assert= (:height (current m)) 22)
      (assert= (:line-height (current m)) 1.5)))
  (test "a size outside the readable range is clamped, not applied"
    (assert= (:height (current (apply! (m0) {:height 900}))) *max-height*)
    (assert= (:height (current (apply! (m0) {:height 1}))) *min-height*))
  (test "apply! keeps the fields it was not given"
    (let (m (apply! (apply! (m0) {:family :hack :height 20 :line-height 1.3}) {:height 21}))
      (assert= (:line-height (current m)) 1.3))))

;; ---- what a NOTCH is, and why the unit is the whole point --------------------
;; A wheel notch is not one event. The runtime gives it an impulse and a kinetic ticker
;; delivers a decaying stream of events whose deltas sum to ~3 lines (brood's
;; `a_single_notch_glides_about_three_lines`). These helpers deliver a notch the way the
;; runtime does — as that stream — so the tests measure what a hand on the wheel gets.

(defn notch-stream (dir)
  ;; A decaying impulse summing to EXACTLY `*zoom-step-lines*`, like the runtime's glide
  ;; (0.45 per tick decaying at 0.85 — brood's `WHEEL_IMPULSE`/`WHEEL_DECAY`). Normalised by
  ;; its own sum, so "one notch is one pixel" is an exact claim and fifteen notches are
  ;; fifteen pixels rather than fifteen-ish.
  (let (raw (fold (range 20) [] (fn (acc i) (conj acc (* 0.45 (math/pow 0.85 i)))))
        total (math/sum raw))
    (map raw (fn (v) (* dir (* *zoom-step-lines* (/ v total)))))))

(defn notches (m dir n)
  ;; `n` physical notches, each as its own kinetic stream
  (fold (range n) m (fn (acc _) (fold (notch-stream dir) acc (fn (a dy) (zoom-step a dy))))))

(describe "Ctrl+wheel steps the size incrementally"
  (defn stepped (m) (or (:zoom-to m) (:height (current m))))
  (defn applied (m) (:height (current (zoom-flush m))))

  ;; The complaint, twice over: one notch must be ONE pixel. At a divisor of 1.0 a notch
  ;; stepped three (its glide sums to ~3 lines), which read as "too sensitive", and the
  ;; accumulated target then lurched a whole spin's worth per throttle tick.
  (test "one physical notch is one pixel"
    (assert= (applied (notches (m0) 1 1)) 16)
    (assert= (applied (notches (m0) -1 1)) 14))
  (test "three notches are three pixels — the response is linear in the hand"
    (assert= (applied (notches (m0) 1 3)) 18))
  (test "a fraction of a notch does not step at all"
    (let (m (fold (take (notch-stream 1) 4) (m0) (fn (a dy) (zoom-step a dy))))
      (assert= (stepped m) 15)))
  (test "and its leftover is kept, so the rest of the notch still gets there"
    (assert= (applied (notches (m0) 1 1)) 16))
  (test "shrinking needs the same push as growing (no floor asymmetry)"
    (let (half (fold (take (notch-stream -1) 6) (m0) (fn (a dy) (zoom-step a dy))))
      (assert= (stepped half) 15))
    (assert= (applied (notches (m0) -1 1)) 14))
  (test "zoom stops at the readable bounds"
    (assert= (applied (notches (m0) 1 200)) *max-height*)
    (assert= (applied (notches (m0) -1 200)) *min-height*)))

;; ---- the resize has to be smooth, which is a statement about how OFTEN it happens ----
;; Applying the size per wheel event was janky: every `gui/font` clears the glyph cache and
;; re-rasters the window, and the grid's row count changes under the mode line each time —
;; so the status bar jumped and flickered. The step is bookkeeping now; the window is
;; written on a throttle.

(describe "a zoom in flight: the first step lands, the rest are paced"
  ;; A leading edge, not a plain throttle: waiting the whole interval before ANYTHING moves
  ;; reads as slow, and applying every event re-rasters the window dozens of times a second.
  ;; So the first step of a gesture goes straight to the window and starts a cooldown; steps
  ;; during that cooldown accumulate, and the `:zoom-apply` tick applies them.
  (test "the first notch moves the window immediately"
    (let (m (notches (m0) 1 1))
      (assert= (:height (current m)) 16) ; applied, not merely recorded
      (is (nil? (:zoom-to m)))
      (is (:zoom-cooling m)))) ; …and the pacing has started
  (test "notches during the cooldown accumulate instead of re-rastering"
    (let (m (notches (notches (m0) 1 1) 1 3)) ; one immediate, three more inside the cooldown
      (assert= (:height (current m)) 16) ; the window has not moved again
      (assert= (:zoom-to m) 19) ; but the target has
      (is (zoom-pending? m))))
  (test "the tick applies what accumulated, and keeps pacing"
    (let (m (zoom-flush (notches (notches (m0) 1 1) 1 3)))
      (assert= (:height (current m)) 19)
      (is (nil? (:zoom-to m)))
      (is (:zoom-cooling m))))
  (test "a tick with nothing waiting ends the cooldown, so the next gesture is immediate"
    (let (settled (zoom-flush (zoom-flush (notches (m0) 1 1))))
      (is (nil? (:zoom-cooling settled)))
      (is (not (zoom-active? settled)))
      (assert= (:height (current (notches settled 1 1))) 17))) ; immediate again
  (test "the size shows in the echo area and NOT in *Messages*"
    ;; a zoom from 15 to 30 used to append fifteen lines to the buffer
    ;; a fresh model always has *Messages* in the pool (`ed-init` seeds it), so this indexes
    ;; rather than guarding — the checker is right that the guard could never fire
    (defn msg-lines (mm)
      (buffer-line-count (nth (:buffers mm)
                           (seq/index-where (:buffers mm) (fn (b) (= (buffer-name b) "*Messages*"))))))
    (let (before (msg-lines (m0))
          m (fold (range 15) (m0) (fn (acc _) (zoom-flush (notches acc 1 1))))
          after (msg-lines m))
      (assert= (:height (current m)) 30)
      (is (includes? (:echo m) "30 px"))
      (assert= after before)))
  (test "nothing pending means no timer work"
    (is (not (zoom-active? (m0))))
    (assert= (:height (current (zoom-flush (m0)))) 15)))

;; ---- the timer has to RE-arm, which is the bug every test above missed ---------------
;; Every assertion above calls `zoom-flush` by hand, so all of them passed while the live
;; editor zoomed exactly once and then stopped. `ed-sync-timers` drops each managed one-shot
;; and re-adds it while its work is pending — the drop is what re-arms it — and `:zoom-apply`
;; was missing from that list, so the loop saw an entry it had already fired and never fired
;; it again. These drive the wheel through `ed-update` and let the TIMER do the applying.

(defn one-notch (m dir)
  ;; a notch through the real event path, then the timer fire the loop would do
  (let (after (fold (notch-stream dir)
                m
                (fn (a dy) (input/ed-update a [:mouse :scroll-up nil 5 5 [:ctrl] dy] 80 24))))
    (if (get (:timers after) :zoom-apply)
      (input/ed-update after [:timer :zoom-apply] 80 24)
      after)))

(describe "the zoom timer re-arms for every notch"
  (test "six notches in a row each move one pixel"
    (let (sizes (second (fold (range 6)
                          [(m0) []]
                          (fn ([m acc] _)
                            (let (m1 (one-notch m 1)) [m1 (conj acc (:height (current m1)))])))))
      (assert= sizes [16 17 18 19 20 21])))
  (test "and the timer is armed while pending, gone once it has applied"
    (let (mid (fold (notch-stream 1)
                (m0)
                (fn (a dy) (input/ed-update a [:mouse :scroll-up nil 5 5 [:ctrl] dy] 80 24)))
          done (input/ed-update mid [:timer :zoom-apply] 80 24))
      (is (not (nil? (get (:timers mid) :zoom-apply)))) ; armed: work outstanding
      (is (nil? (get (:timers done) :zoom-apply)))))) ; dropped: so the next notch re-arms it


(describe "presets"
  (test "the built-ins are there and apply live"
    (is (includes? (names) "Presenting"))
    (let (m (preset-apply (m0) "Presenting"))
      (assert= (:height (current m)) 26)))
  (test "an unknown name reports rather than changing anything"
    (let (m (preset-apply (apply! (m0) {:height 17}) "nope"))
      (assert= (:height (current m)) 17)
      (is (includes? (:echo m) "no such preset"))))
  (test "by-name reads the registry, and every built-in is a complete setup"
    (doseq (n (names))
      (let (p (by-name n))
        (is (not (nil? (:family p))))
        (is (int? (:height p)))
        (is (not (nil? (:line-height p))))))))

;; The save/list/delete cycle on a TEMP file — the `-in` / `-to!` forms exist for exactly
;; this, so a test never writes the developer's real presets (the split `projects.blsp` uses
;; for every persisted cache here).
(purge-stale-temp "bedit-preset-")
(defn tmp-presets () (str (temp-dir "bedit-preset-") "/presets.blsp"))

(describe "saving and managing presets"
  (test "saving records what the window is showing, and it reads back"
    (let (f (tmp-presets)
          m (apply! (m0) {:family :hack :height 31 :line-height 1.6})
          _ (preset-save-to! f m "Call")
          p (seq/find (all-in f) (fn (p) (= (:name p) "Call"))))
      (assert= (:height p) 31)
      (assert= (:line-height p) 1.6)))
  (test "a saved preset shadows a built-in of the same name — one entry, not two"
    (let (f (tmp-presets)
          m (apply! (m0) {:height 40})
          _ (preset-save-to! f m "Presenting")
          named (seq/filter (all-in f) (fn (p) (= (:name p) "Presenting"))))
      (assert= (count named) 1)
      (assert= (:height (first named)) 40)))
  (test "deleting a shadowing preset brings the built-in back"
    (let (f (tmp-presets)
          m (apply! (m0) {:height 40})
          _ (preset-save-to! f m "Presenting")
          _ (preset-delete-from! f m "Presenting")
          p (seq/find (all-in f) (fn (p) (= (:name p) "Presenting"))))
      (assert= (:height p) 26))) ; the built-in, not the saved 40
  (test "deleting something never saved reports rather than pretending"
    (let (f (tmp-presets)
          m (preset-delete-from! f (m0) "Nope"))
      (is (includes? (:echo m) "no saved preset"))))
  (test "a save replaces rather than accumulating under one name"
    (let (f (tmp-presets)
          _ (preset-save-to! f (apply! (m0) {:height 20}) "Call")
          _ (preset-save-to! f (apply! (m0) {:height 28}) "Call")
          mine (saved-in f))
      (assert= (count mine) 1)
      (assert= (:height (first mine)) 28)))
  (test "an unreadable presets file costs the presets, not the editor"
    (let (f (tmp-presets)
          _ (file/mkdir (path/dirname f))
          _ (file/spit f "{{{ not a literal")
          ok (all-in f))
      (assert= (count (saved-in f)) 0)
      (is (includes? (map ok (fn (p) (:name p))) "Default")))))

;; The zoom must survive the grid shrinking under it. Growing the font means fewer cells, so
;; the pointer's last reported CELL (the runtime keeps it until the mouse moves) can fall
;; outside the new grid — and the wheel branch used to sit behind the hovered-pane guard, so
;; every remaining event of the glide was dropped. It moved for a split second and stopped.
(describe "the font zoom does not need a pane under the pointer"
  (test "a notch with the pointer outside the grid still zooms"
    (let (outside (fold (notch-stream 1)
                    (m0)
                    (fn (a dy) (input/ed-update a [:mouse :scroll-up nil 400 400 [:ctrl] dy] 80 24))))
      ;; the first step of a gesture applies straight away, so read the size, not the target
      (assert= (:height (current outside)) 16)))
  (test "but the per-pane block zoom still requires one (Ctrl+Shift)"
    (let (outside (input/ed-update (m0) [:mouse :scroll-up nil 400 400 [:ctrl :shift]] 80 24))
      (assert= (pane-scale-of outside) 1))))
