(defmodule statusbar-test
  (:use statusbar)
  (:use editor/display) ; zone-at, over the zones the layout returns
  (:use theme) ; face-modeline-hover, asserted in the hover cases
  (:use test))

(def BASE {:fg "#cdd6f4" :bg "#313244"})

(defn op-tags (ops) (map first ops))
(defn texts (ops) (filter (fn (o) (= (first o) :text)) ops))

(describe "seg / coerce-seg — the segment model"
  (test "seg fills defaults, keeping the given fields"
    (assert= (seg :pos "1:0")
      {:id :pos :text "1:0" :sep "" :face nil :on-click nil :tooltip nil :cursor nil})
    (assert= (seg :branch "main" {:sep "  " :on-click 'cmd-git-status :tooltip "repo"})
      {:id :branch
       :text "main"
       :sep "  "
       :face nil
       :on-click 'cmd-git-status
       :tooltip "repo"
       :cursor nil}))

  (test "coerce-seg lifts a bare string into a segment; a map passes through"
    (assert= (coerce-seg "hi" 3) (seg :seg/3 "hi" {:sep "  —  "}))
    (let (s (seg :x "y")) (assert= (coerce-seg s 0) s)))

  (test "seg-interactive? is true with a click or a tooltip, else false"
    (is (seg-interactive? (seg :a "a" {:on-click 'c})))
    (is (seg-interactive? (seg :a "a" {:tooltip "t"})))
    (is (not (seg-interactive? (seg :a "a"))))))

(describe "seg-tooltip-lines — string / vector / fn"
  (test "a string is one line; a vector is used as-is; nil is nil"
    (assert= (seg-tooltip-lines (seg :a "a" {:tooltip "one"}) {}) ["one"])
    (assert= (seg-tooltip-lines (seg :a "a" {:tooltip ["l1" "l2"]}) {}) ["l1" "l2"])
    (assert= (seg-tooltip-lines (seg :a "a") {}) nil))
  (test "a fn tooltip is called with the model"
    (assert= (seg-tooltip-lines (seg :a "a" {:tooltip (fn (m) [(:who m)])}) {:who "bob"})
      ["bob"])))

(describe "statusbar-layout — ops + zones"
  (let (segs (list (seg :name "scratch")
               (seg :branch "main" {:sep "  " :on-click 'cmd-git-status :tooltip "repo"})))

    (test "prepends a full-width bar fill, then text ops for sep + label per segment"
      (let (out (statusbar-layout segs 0 5 40 BASE nil))
        (assert= (first (:ops out)) [:rect 5 0 40 1 BASE]) ; the bar fill
        ; :name has no sep (1 op); :branch has sep "  " + label (2 ops) = 3 total
        (assert= (count (texts (:ops out))) 3)))

    (test "segments are placed at sep-offset columns (text inherits the bar's fg+bg)"
      (let (out (statusbar-layout segs 0 5 40 BASE nil)
            ts (texts (:ops out)))
        (assert= (nth ts 0) [:text 5 0 "scratch" BASE]) ; name at col 0 (no sep)
        (assert= (nth ts 1) [:text 5 7 "  " BASE]) ; branch sep at col 7, in bar face
        (assert= (nth ts 2) [:text 5 9 "main" BASE]))) ; branch label after "scratch"(7)+sep(2)
    (test "only interactive segments get a zone, spanning their text cells"
      (let (out (statusbar-layout segs 0 5 40 BASE nil))
        (assert= (:zones out) (list (zone [9 5 4 1] :branch nil)))
        ;; hit-testing the produced zones finds the branch under its glyphs, nil elsewhere
        (assert= (get (zone-at (:zones out) 10 5) :id) :branch)
        (assert= (zone-at (:zones out) 3 5) nil))) ; over "scratch" — not a zone
    (test "hovering an interactive segment adds a flat highlight band (terminal)"
      (let (out (statusbar-layout segs 0 5 40 BASE :branch)
            ts (texts (:ops out)))
        ;; the branch text keeps its fg but takes the hover bg (band), not the bar bg
        ;; ts[0]=scratch, ts[1]=sep "  " (bar face, not hovered), ts[2]="main" (hover face)
        (assert= (nth ts 2) [:text 5 9 "main" (merge BASE face-modeline-hover)])))

    (test "hovering in the GUI draws a bordered, inset block behind fg-only text (Emacs mouse-face + edge)"
      (let (out (statusbar-layout segs 0 5 40 BASE :branch true)
            fr (filter (fn (o) (= (first o) :frect)) (:ops out)))
        ;; two frects: the border (hover-border face) behind the fill (hover face)
        (assert= (count fr) 2)
        (assert= (nth (nth fr 0) 5) face-modeline-hover-border) ; [:frect x y w h face ..] → face
        (assert= (nth (nth fr 1) 5) face-modeline-hover)
        ;; the hovered text is fg-only so the block behind it shows
        ;; ts[0]=scratch, ts[1]=sep "  " (bar face), ts[2]="main" (fg-only, hovered)
        (assert= (nth (texts (:ops out)) 2) [:text 5 9 "main" (dissoc BASE :bg)])))

    (test "a non-interactive segment never highlights, even if named as hovered"
      (let (out (statusbar-layout segs 0 5 40 BASE :name))
        (is (not (includes? (op-tags (:ops out)) :frect)))
        (assert= (nth (texts (:ops out)) 0) [:text 5 0 "scratch" BASE])))

    (test "text past the bar's right edge is clipped, never wrapped"
      (let (out (statusbar-layout (list (seg :n "abcdefghij")) 0 5 4 BASE nil))
        (assert= (nth (texts (:ops out)) 0) [:text 5 0 "abcd" BASE])))))

(describe "statusbar-tooltip-ops — the hover hint card"
  (let (segs (list (seg :branch "main" {:tooltip ["branch: main" "clean"]})
               (seg :name "scratch")))
    (test "nil when nothing is hovered or the hovered segment has no tooltip"
      (assert= (statusbar-tooltip-ops segs nil {} 10 23 80 24 false) nil)
      (assert= (statusbar-tooltip-ops segs :name {} 10 23 80 24 false) nil))
    (test "a card of the tooltip lines, floated above the bar row"
      (let (ops (statusbar-tooltip-ops segs :branch {} 10 23 80 24 false))
        (is (not (nil? ops)))
        ;; two lines → the card sits two rows above row 23 (21,22), a rect + two text rows
        (is (includes? (op-tags ops) :rect))
        (assert= (count (texts ops)) 2)))))
