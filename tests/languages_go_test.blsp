;; Go (src/languages/go.blsp): a `deflanguage` over tree-sitter-go, gofmt's tabs.
;; The mode half needs no grammar; the parsed half needs the grammar (`testkit/load-test-grammar`)
;; and SKIPS without it.
(defmodule languages-go-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use testkit :only [cur file-model press faced? indents]))

(describe "go, the mode"
  (test "a .go file opens in go mode, formatted by gofmt"
    (let (buf (cur (file-model "" "main.go")))
      (assert= (ed-buf-mode-name buf) "go")
      (assert= (first (model/ed-mode-service buf :format-command)) "gofmt")))
  (test "it declares where its grammar lives, for M-x grammar-install"
    (assert= (:url (model/grammar-source :go)) "https://github.com/tree-sitter/tree-sitter-go")))

(describe "go's fontify restart"

  (test "go's raw string: closed above cuts after it, open across declines"
    (let (src "var s = `\nfunc x() {}\n`\n\nfunc b() {\n\treturn\n}\n")
      (assert= (languages/go/go-restart src (index-of src "\treturn")) (index-of src "func b")))
    (let (src "\tx := `\nfunc x() {}\n\treturn\n")
      (assert= (languages/go/go-restart src (index-of src "\treturn")) 0))))

;; Go indents with tabs: the indenter answers a column, and the mode writes it as tabs
(describe "go, indented with tabs"

  (test "RET inside a Go function indents the new line with a tab"
    (let (m (file-model "func main() {\n}\n" "main.go")
          at-brace (ed-set-buf m (goto-char (cur m) (index-of "func main() {\n}\n" "\n")))
          entered (press at-brace [:enter]))
      (is (string/starts-with? (buffer-text (cur entered)) "func main() {\n"))
      (when (testkit/load-test-grammar :go)
        (assert= (buffer-text (cur entered)) "func main() {\n\t\n}\n"))))
  (test "a column past the tabs is a tab, then spaces"
    (assert= (indent/ed-indentation (cur (file-model "" "main.go")) 12) "\t    ")))

;; gofmt-clean
(def go-src
  "package main\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n)\n\n// Point is a point.\ntype Point struct {\n\tX int\n\tY float64\n}\n\nfunc (p Point) Describe(name string) string {\n\tswitch name {\n\tcase \"x\":\n\t\treturn fmt.Sprintf(\"%d\", p.X)\n\tdefault:\n\t\treturn strings.Repeat(`raw`, 3)\n\t}\n}\n\nfunc main() {\n\tpoints := []Point{\n\t\t{X: 1, Y: 2.5},\n\t}\n\tfor _, p := range points {\n\t\tif p.X > 0 {\n\t\t\tfmt.Println(p.Describe(\"x\"), nil)\n\t\t}\n\t}\n}\n")

(when (testkit/load-test-grammar :go)
  (describe "go, parsed"
    (test "it colours — a comment, a string, a number, a type"
      (let (spans (languages/go/go-fontify go-src))
        (is (faced? spans :syntax/comment))
        (is (faced? spans :syntax/string))
        (is (faced? spans :syntax/number))
        (is (faced? spans :syntax/special))))
    (test "it indents every line where gofmt put it — `case` at the switch's level"
      (let ([got want] (indents go-src "main.go"))
        (assert= got want)))
    (test "C-M-a inside a method lands on its func"
      (assert= (editor/treesit/point-defun-start go-src :go (index-of go-src "switch name"))
        (index-of go-src "func (p Point)")))))
