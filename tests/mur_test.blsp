;; mur, first class: a mur working copy is a project, its change is on the mode line,
;; C-x g opens *mur-status*, and the forge's open changes are a buffer. CI has no `mur`
;; client, so what mur answers comes from fixtures shaped like `mur status --json` (mur's
;; own tests pin that shape); what runs mur is checked for saying so when it is absent.
(defmodule mur-test
  (:use murcore)
  (:use murbar)
  (:use-internals murstatus)
  (:use murforge)
  (:use murhistory) ; the time machine's side
  (:use section)
  (:use projects) ; *project-markers* / *project-ignore-dirs* / project-root
  (:use model)
  (:use editor/buffer) ; make-buffer / buffer-text
  (:use test))

(def- fresh-dir (fn (prefix) (let (dir (temp-dir prefix)) (do (file/mkdir dir) dir))))

(def STATUS
  ;; `mur status --json` for a change with one saved version, two files changed since, and
  ;; another change open in the same working copy
  {:change "0ec8927f51595d56ebc1dceee9ba7d85"
   :title "feat(tooling): work from a mur working copy"
   :url "https://mur.fly.dev/broodlang/brood/changes/0ec8927f51595d56ebc1dceee9ba7d85"
   :project "broodlang/brood"
   :state "saved"
   :against "save"
   :onto nil
   :base "c0cce9c02f03714d09ef17dcc2fc88e8e0fd817dfa868f44eea51bfa3988aa84"
   :versions 1
   :unsent 1
   :clashes []
   :files [{:path "src/a.blsp" :status "modified"} {:path "notes.md" :status "added"}]
   :unclaimed ["scratch.txt"]
   :edited_for_others 0
   :pending_trunk_move false
   :blocked nil
   :here [{:number 1
           :change "0ec8927f51595d56ebc1dceee9ba7d85"
           :title "feat(tooling): work from a mur working copy"
           :yours true
           :others []
           :claimed 2}
           {:number 2
            :change "77aa00bb11cc22dd33ee44ff55667788"
            :title "docs: the API"
            :yours false
            :others ["agent docs"]
            :claimed 1}]})

(def DIFF
  (string/join ["--- src/a.blsp"
                 "+++ src/a.blsp" "@@ -1,3 +1,3 @@" " (defn a ()" "-  1)" "+  2)" " ; end"
                 "--- notes.md" "+++ notes.md" "@@ -0,0 +1 @@" "+hello"]
    "\n"))

(describe "mur on the mode line"
  (test "the summary is what the status says, counted"
    (let (s (mur-summary-of STATUS))
      (assert= (:label s) "feat(tooling): work from a mur working copy")
      (assert= [(:changed s) (:clashes s) (:unsent s) (:unclaimed s) (:others s)] [2 0 1 1 1])))
  (test "a change not yet said is labelled by its ID"
    (assert= (:label (mur-summary-of (assoc STATUS :title nil))) "0ec8927f5159"))
  (test "the segments: the change, the dot, then only the counts there are"
    (let (segs (vcscore/vcs-chip-segments (mur-chip (mur-summary-of STATUS))))
      (assert= (map segs :id) (list :vcs-label :vcs-dot :mur-changed :mur-unsent :mur-unclaimed))
      (is (string/starts-with? (:text (first segs)) "◆ feat(tooling)"))
      (assert= (:text (nth segs 2)) "~2")
      (assert= (:on-click (first segs)) 'vcscore/cmd-vcs-status)))
  (test "a clash turns the dot red and shows its count"
    (let (s (mur-summary-of (assoc STATUS :clashes [{:path "a" :line 3 :whole false}]))
          segs (vcscore/vcs-chip-segments (mur-chip s)))
      (assert= (:face (nth segs 1)) mur-face-clash)
      (is (any? segs (fn (seg) (= (:text seg) "!1"))))))
  (test "a long title is cut on the bar, whole in the tooltip"
    (let (long (string/repeat "x" 80)
          seg (first (vcscore/vcs-chip-segments (mur-chip (mur-summary-of (assoc STATUS :title long))))))
      (is (< (string/length (:text seg)) 50))
      (is (includes? (str (:tooltip seg)) long))))
  (test "no summary, no segments"
    (assert= (vcscore/vcs-chip-segments (mur-chip nil)) '())))

(describe "*mur-status*: the tree"
  (test "a diff splits per file, each parsed into its hunks"
    (let (split (mur-split-diff DIFF))
      (assert= (:lines (first (:hunks (get split "notes.md")))) ["+hello"])
      (assert= (count (:lines (first (:hunks (get split "src/a.blsp"))))) 4)))
  (test "a diff line knows the file line it is"
    (let (hunk {:hunk (first (:hunks (get (mur-split-diff DIFF) "src/a.blsp")))})
      ;; ` (defn a ()` `-  1)` `+  2)`: the added line is line 2 of the new file
      (assert= (vcsproc/vcs-hunk-line {:heading? false :line 2} hunk) 2)
      (assert= (vcsproc/vcs-hunk-line {:heading? true} hunk) 1)))
  (test "a path that starts with a or b is kept whole — mur prints no prefix to strip"
    (is (contains? (mur-split-diff "--- a/x.txt\n+++ a/x.txt\n@@ -1 +1 @@\n-x\n+y") "a/x.txt")))
  (test "it lists the change, the files with their diffs folded, the unclaimed edit and the other change"
    (let (r (section-render (mur-status-tree {:root "/w" :status STATUS :diff DIFF :log []}))
          text (section-text r))
      (is (includes? text "Change:   0ec8927f5159  feat(tooling)"))
      (is (includes? text "1 not on the forge yet"))
      (is (includes? text "Changed since the last save (2)"))
      (is (includes? text "modified   src/a.blsp"))
      ;; folded until TAB
      (is (not (includes? text "+  2)")))
      (is (includes? text "Edited here, claimed by no change (1)"))
      (is (includes? text "Changes here (2)"))
      (is (includes? text "agent docs"))))
  (test "with only your own change here, the section is left out"
    (let (text (section-text (section-render (mur-status-tree {:root "/w"
                                                               :status (assoc STATUS
                                                                         :here
                                                                           [(first (:here STATUS))])
                                                               :diff ""
                                                               :log nil}))))
      (is (not (includes? text "Changes here")))))
  (test "clashes come first, each at its line"
    (let (text (section-text (section-render (mur-status-tree {:root "/w"
                                                               :status (assoc STATUS
                                                                         :clashes
                                                                           [{:path "src/a.blsp"
                                                                             :line 12
                                                                             :whole false}
                                                                             {:path "img.png"
                                                                              :line 0
                                                                              :whole true}])
                                                               :diff ""
                                                               :log nil}))))
      (is (includes? text "Clashes to settle (2)"))
      (is (includes? text "src/a.blsp:12"))
      (is (includes? text "img.png  (the whole file)"))))
  (test "a working copy mur cannot read says why, rather than showing an empty change"
    (let (text (section-text (section-render (mur-status-tree {:root "/w"
                                                               :status nil
                                                               :error "mur: not a working copy"}))))
      (is (includes? text "mur cannot read this working copy"))
      (is (includes? text "not a working copy")))))

(describe "*mur-status*: the faces"
  (test "a header line: its label dim, the change ID in the ID face"
    (let (spans (mur-status-faces {:type :head :heading? false} "Change:   0ec8927f5159  a title"))
      (is (includes? spans [0 9 mur-face-label]))
      (is (includes? spans [10 22 mur-face-id]))))
  (test "a diff line in a file is coloured as a diff"
    (assert= (into [] (mur-status-faces {:type :file :heading? false} "+  2)"))
      [[0 5 vcsproc/vcs-face-add]]))
  (test "an added file's status word is green"
    (assert= (into []
               (mur-status-faces {:type :file :heading? true :value {:status "added"}}
                 "added      notes.md"))
      [[0 10 vcsproc/vcs-face-add]])))

(describe "the forge's open changes"
  (test "each is a row, yours marked"
    (let (text (section-text (section-render (mur-open-changes-tree [{:change "0ec8927f51595d56"
                                                                      :yours true
                                                                      :author "Ann"
                                                                      :title "One"}
                                                                      {:change "77aa00bb11cc22dd"
                                                                       :yours false
                                                                       :author "Bo"
                                                                       :title "Two"}]))))
      (is (includes? text "* 0ec8927f5159  Ann"))
      (is (includes? text "  77aa00bb11cc  Bo"))))
  (test "none says so"
    (is (includes? (section-text (section-render (mur-open-changes-tree []))) "No open changes"))))

(describe "a mur working copy is a project"
  (test ".mur marks a project root (mur's vcs row), and the file walk never descends into it"
    (is (includes? *project-ignore-dirs* ".mur"))
    (let (dir (fresh-dir "bedit-mur-project-"))
      (file/mkdir (path/join dir ".mur"))
      (file/mkdir (path/join dir "src"))
      (assert= (project-root (path/join dir "src")) dir))))

(describe "*mur-status*: collecting"
  (test "the working copy's collection asks this machine only; trunk's log is asked apart"
    (let (dir (fresh-dir "bedit-mur-collect-")
          program (path/join dir "mur"))
      (file/spit program
        (str "#!/bin/sh\necho \"$1\" >> \""
          (path/join dir "asked")
          "\"\ncase \"$1\" in\n  status) echo '{\"change\":\"abc\"}' ;;\n  *) ;;\nesac\n"))
      (os/cmd "chmod" ["+x" program] {:cwd "/"})
      (binding (*mur-program* program)
        (let (collected (mur-collect-status dir))
          (assert= (:change (:status collected)) "abc")
          (assert= (into [] (string/split (string/trim (file/slurp (path/join dir "asked"))) "\n"))
            ["status" "diff"]))))))

(describe "without the mur client"
  (test "running mur says it is not installed, as a failed command"
    (when (nil? (murcore/mur-program))
      (let (r (mur-mur "/" ["status"]))
        (assert= (:exit r) 127)
        (is (includes? (:stderr r) "mur is not installed")))))
  (test "C-x g in a working copy opens *mur-status*, saying what is wrong"
    (when (nil? (murcore/mur-program))
      (let (dir (fresh-dir "bedit-mur-status-"))
        (file/mkdir (path/join dir ".mur"))
        (let (m (vcscore/cmd-vcs-status (model/ed-init (make-buffer "x"
                                                         "a.txt"
                                                         (path/join dir "a.txt")))
                  nil)
              shown (buffer-text (ed-current-buf m)))
          (assert= (buffer-name (ed-current-buf m)) (str "*mur-status: " (path/basename dir) "*"))
          (is (includes? shown "mur cannot read this working copy"))
          (is (includes? shown "mur is not installed"))))))
  (test "a report runs mur in the working copy it names, whatever buffer it is asked from"
    (when (nil? (murcore/mur-program))
      (let (dir (fresh-dir "bedit-mur-report-"))
        (file/mkdir (path/join dir ".mur"))
        (let (m (mur-show-text (model/ed-init (make-buffer "x"))
                  dir
                  "show"
                  ["show" "abc"]
                  "*mur-show*")
              said (:echo m))
          (is (not (includes? said "not in a mur working copy")))
          (is (includes? said "mur is not installed"))))))
  (test "the change gutter of a file in a working copy is empty, not an error"
    (when (nil? (murcore/mur-program))
      (let (dir (fresh-dir "bedit-mur-gutter-"))
        (file/mkdir (path/join dir ".mur"))
        (file/spit (path/join dir "a.txt") "one\n")
        (assert= (diffhl/diffhl-status (path/join dir "a.txt") "one\ntwo\n") {})))))

(def- version-entry
  ;; `mur versions --json PATH`, one entry
  {:version 3
   :snapshot "bbbb000011112222333344445555666677778888999900001111222233334444"
   :time 1000
   :author "Ann"
   :title "Two"
   :message "Two\n\nWhy it is two.\n"
   :change "0ec8927f51595d56ebc1dceee9ba7d85"
   :sent true})
(def- trunk-entry
  ;; `mur log --json PATH`, one entry
  {:snapshot "aaaa000011112222333344445555666677778888999900001111222233334444"
   :time 0
   :author "Bob"
   :title "Add f"
   :message "Add f"
   :change "11112222333344445555666677778888"
   :base true})

(describe "the time machine's mur side"
  (test "the change's versions come first, and are the branch scope"
    (let (h (mur-history-of [version-entry] [trunk-entry] "f.txt" nil 3600000))
      (assert= (into [] (map (:revisions h) :short)) ["bbbb00001111" "aaaa00001111"])
      (assert= (:branch h) {:base "trunk" :hashes #{(:snapshot version-entry)}})
      (assert= (:body (first (:revisions h))) "Why it is two.")
      (assert= (:age (first (:revisions h))) "59 minutes ago")
      (assert= (:note (first (:revisions h))) "Change: v3 of this change, not landed")
      (assert= (:note (second (:revisions h))) "Trunk:  landed as change 111122223333")
      (assert= (:path (second (:revisions h))) "f.txt")))
  (test "a version entered from is found by the start of its ID"
    (assert= (:start (mur-history-of [version-entry] [trunk-entry] "f.txt" "aaaa0000" 0))
      (:snapshot trunk-entry)))
  (test "mur show's header and message are not the diff"
    (assert= (mur-show-diff "snapshot x\nauthor a\n\n    --- not a diff\n\n--- f\n+++ f\n@@ -1 +1 @@\n-a\n+b")
      "--- f\n+++ f\n@@ -1 +1 @@\n-a\n+b")
    (assert= (mur-show-diff "snapshot x\n\n    nothing\n") "")))

;; ---- one *mur-status* per working copy -------------------------------------------------
;; A stand-in `mur` answers from files in the working copy it runs in (`.mur/status.json`,
;; `.mur/log.json`), so two working copies answer differently and a test can change what one
;; says between two keys.

(defn- mt-program ()
  "The stand-in `mur`: `status` and `log` read the working copy's own answers, the rest say
nothing."
  (let (dir (fresh-dir "bedit-mur-program-")
        program (path/join dir "mur"))
    (do
      (file/spit program
        "#!/bin/sh\ncase \"$1\" in\n  status) cat .mur/status.json ;;\n  log) cat .mur/log.json ;;\n  *) ;;\nesac\n")
      (os/cmd "chmod" ["+x" program] {:cwd "/"})
      program)))

(defn- mt-says (dir title)
  "Working copy `dir`'s `mur status --json` from now on: STATUS, its change titled `title`."
  (file/spit (path/join dir ".mur" "status.json")
    (json/encode (assoc STATUS :title title :here []))))

(defn- mt-working-copy (prefix title trunk)
  "A working copy whose change is titled `title` and whose trunk's one snapshot is `trunk`."
  (let (dir (fresh-dir prefix))
    (do
      (file/mkdir (path/join dir ".mur"))
      (file/spit (path/join dir "a.txt") "a\n")
      (mt-says dir title)
      (file/spit (path/join dir ".mur" "log.json") (json/encode [(assoc trunk-entry :title trunk)]))
      dir)))

(defn- mt-visit (m dir) (pool/ed-find-file m (path/join dir "a.txt")))

(defn- mt-status-buffers (m)
  "`{root text}` for every *mur-status* in the pool."
  (into {}
    (map (vcsproc/vcs-status-indices m :mur-status)
      (fn (i)
        (let (b (ed-buf-at m i)) [(map/get-in b [:section-ctx :root]) (buffer-text b)])))))

(defn- mt-live (thunk)
  "Run `thunk` as the live loop would: its mur off the loop, the replies to this process, and
every blocking call on this process refused."
  (let (previous (proc/flag :responsive :refuse))
    (try (binding (editor/ui/*loop* (self)) (thunk)) (finally (proc/flag :responsive previous)))))

(defn- mt-settle (m)
  "Deliver every reply the model waits on through the loop's own update, until nothing is in
flight — each reply a barrier, never a sleep."
  (let (slot (seq/find (keys (ed-task-reply-table)) (fn (s) (not (nil? (get m s))))))
    (if (nil? slot)
      m
      (let (handle (get m slot)
            event (receive
                    ([:task-done ^handle value] [:task-done handle value])
                    ([:task-error ^handle reason] [:task-error handle reason])
                    ([:task-timeout ^handle] [:task-timeout handle])
                    (after 30000 (error "mt-settle: no reply for " slot))))
        (mt-settle (mt-live (fn () (input/ed-update m event 80 24))))))))

(describe "*mur-status*: one per working copy"
  (test "C-x g in a second working copy opens its own status beside the first's"
    (binding (*mur-program* (mt-program))
      (let (a (mt-working-copy "bedit-mur-per-a-" "work in A" "trunk of A")
            b (mt-working-copy "bedit-mur-per-b-" "work in B" "trunk of B")
            in-a (murstatus/cmd-mur-status (mt-visit (model/ed-init (make-buffer "")) a) nil)
            m (murstatus/cmd-mur-status (mt-visit in-a b) nil)
            shown (mt-status-buffers m))
        (assert= (count shown) 2)
        (is (includes? (get shown a) "work in A"))
        (is (includes? (get shown a) "trunk of A"))
        (is (not (includes? (get shown a) "work in B")))
        (is (includes? (get shown b) "work in B"))
        (is (includes? (get shown b) "trunk of B"))
        (assert= (buffer-name (ed-current-buf m)) (str "*mur-status: " (path/basename b) "*"))
        ;; C-x g back in A goes to A's buffer, not a third
        (let (again (murstatus/cmd-mur-status (mt-visit m a) nil))
          (assert= (count (mt-status-buffers again)) 2)
          (assert= (map/get-in (ed-current-buf again) [:section-ctx :root]) a)))))
  (test "g in one working copy's status reads it again and leaves the other's alone"
    (binding (*mur-program* (mt-program))
      (let (a (mt-working-copy "bedit-mur-refresh-a-" "work in A" "trunk of A")
            b (mt-working-copy "bedit-mur-refresh-b-" "work in B" "trunk of B")
            in-a (murstatus/cmd-mur-status (mt-visit (model/ed-init (make-buffer "")) a) nil)
            in-b (murstatus/cmd-mur-status (mt-visit in-a b) nil)
            _ (mt-says a "A moved on")
            _ (mt-says b "B moved on")
            ;; in B's status: B is read again, A is not
            refreshed (murstatus/cmd-mur-refresh in-b nil)
            shown (mt-status-buffers refreshed))
        (is (includes? (get shown b) "B moved on"))
        (is (includes? (get shown a) "work in A"))
        (is (not (includes? (get shown a) "A moved on"))))))
  (test "a working copy spelled with a trailing slash is the same status"
    (binding (*mur-program* (mt-program))
      (let (a (mt-working-copy "bedit-mur-spelled-" "work in A" "trunk of A")
            in-a (murstatus/cmd-mur-status (mt-visit (model/ed-init (make-buffer "")) a) nil)
            m (murstatus/mur-show-status in-a (str a "/") nil :here))
        (assert= (count (mt-status-buffers m)) 1)
        (assert= (map/get-in (ed-current-buf m) [:section-ctx :root]) a))))
  (test "trunk's log lands in the status of the working copy it was asked for"
    (binding (*mur-program* (mt-program))
      (let (a (mt-working-copy "bedit-mur-log-a-" "work in A" "trunk of A")
            b (mt-working-copy "bedit-mur-log-b-" "work in B" "trunk of B")
            in-a (murstatus/cmd-mur-status (mt-visit (model/ed-init (make-buffer "")) a) nil)
            in-b (murstatus/cmd-mur-status (mt-visit in-a b) nil)
            ;; A's log is out; B's status, landing meanwhile, waits for it rather than replacing it
            out (assoc in-b :mur-log-proc :a-handle :mur-log-root a)
            asked (murstatus/mur-launch-log out b)
            ;; asked again for A, spelled another way: the ask out covers it
            same (murstatus/mur-launch-log out (str a "/"))
            ;; A's answer lands while B is the reader's
            landed (murstatus/mur-apply-log asked [(assoc trunk-entry :title "newer trunk")])
            shown (mt-status-buffers landed))
        (do
          (assert= [(:mur-log-root asked) (:mur-log-next asked)] [a b])
          (is (nil? (:mur-log-next same)))
          (is (includes? (get shown a) "newer trunk"))
          (is (not (includes? (get shown b) "newer trunk")))
          (is (includes? (get shown b) "trunk of B"))
          ;; then B's is asked for
          (assert= (:mur-log-root landed) b)
          (is (nil? (:mur-log-next landed)))
          (is (not (nil? (:mur-log-proc landed))))
          (task/cancel (:mur-log-proc landed))))))
  (test "C-x g in A, then in B before A's lands: B waits, and both land"
    ;; whatever mur answers here — a task does not see this process's bindings, so the
    ;; collection runs the mur on PATH, or says there is none — each copy's status lands
    (let (a (mt-working-copy "bedit-mur-live-a-" "work in A" "trunk of A")
          b (mt-working-copy "bedit-mur-live-b-" "work in B" "trunk of B")
          in-a (mt-live (fn ()
                          (murstatus/cmd-mur-status (mt-visit (model/ed-init (make-buffer "")) a)
                            nil)))
          in-b (mt-live (fn () (murstatus/cmd-mur-status (mt-visit in-a b) nil)))
          done (mt-settle in-b)
          shown (mt-status-buffers done))
      (is (not (nil? (get (:mur-status-waiting in-b) (vcsproc/vcs-root-key b)))))
      (assert= (:mur-status-root in-b) a)
      (assert= (into #{} (keys shown)) #{a b})
      (is (not (any? (vals shown) (fn (text) (string/starts-with? text "Loading")))))
      (assert= (map/get-in (ed-current-buf done) [:section-ctx :root]) b)
      (is (empty? (:mur-status-waiting done {}))))))
