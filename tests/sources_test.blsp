;; A source table (`src/sources.blsp`): the one mechanism every kind of view source — highlight,
;; override and line-note sources, pane layers, frame overlays, row extras, echo sources, text
;; faces, margin marks — registers, ranks and is read through.

(defmodule sources-test
  (:use test))

(defn shout (text) (string/upper text))
(defn whisper (_text) "")
(defn deps-of (m _pane _buf) (:seen m))

(defn with-table (table rows thunk)
  "`(thunk)` with `rows` (`{name row}`) registered in `table`, a table of one test's own, taken
back after."
  (doseq ([name row] (vec rows)) (sources/register table name row))
  (let (answer (thunk))
    (doseq (name (keys rows)) (registry/remove table name))
    answer))

(describe "a source table"
  (test "rows come back lowest rank first, each carrying its name"
    (with-table :sources-test/table-1
      {:late {:rank 20 :run 'sources-test/shout} :early {:rank 10 :run 'sources-test/whisper}}
      (fn ()
        (assert= (map (sources/rows :sources-test/table-1) :name) '(:early :late)))))
  (test "registering a name again replaces its row"
    (with-table :sources-test/table-2
      {:a {:rank 1 :run 'sources-test/shout}}
      (fn ()
        (sources/register :sources-test/table-2 :a {:rank 1 :run 'sources-test/whisper})
        (assert= (map (sources/rows :sources-test/table-2) :run) '(sources-test/whisper)))))
  (test "run calls every row in rank order, a row whose symbol is unbound answering the fallback"
    (with-table :sources-test/table-3
      {:a {:rank 1 :run 'sources-test/shout}
       :gone {:rank 2 :run 'sources-test/no-such-function}
       :b {:rank 3 :run 'sources-test/whisper}}
      (fn ()
        (assert= (sources/run :sources-test/table-3
                   "test sources"
                   (fn (row) (reflect/call-if-bound (:run row) :missing "hi")))
          '("HI" :missing "")))))
  (test "first-answer skips the rows with nothing to say and asks none after the one that has"
    (with-table :sources-test/table-4
      {:quiet {:rank 1 :run 'sources-test/whisper}
       :loud {:rank 2 :run 'sources-test/shout}
       :never {:rank 3 :run 'sources-test/no-such-function}}
      (fn ()
        (let ([value row] (sources/first-answer :sources-test/table-4
                            (fn (row) ((reflect/eval (:run row)) "hi"))))
          (assert= value "HI")
          (assert= (:name row) :loud)))))
  (test "first-answer is nil when every row is blank"
    (with-table :sources-test/table-5
      {:quiet {:rank 1 :run 'sources-test/whisper}}
      (fn () (is (nil? (sources/first-answer :sources-test/table-5 (fn (_row) [])))))))
  (test "deps reads each row's :deps that names one (and that keep? keeps), by name"
    (with-table :sources-test/table-6
      {:reads {:rank 1 :slot :a :deps 'sources-test/deps-of}
       :other-slot {:rank 2 :slot :b :deps 'sources-test/deps-of}
       :reads-nothing {:rank 3 :slot :a}}
      (fn ()
        (assert= (sources/deps :sources-test/table-6 {:seen 7} nil nil)
          '([:reads 7] [:other-slot 7]))
        (assert= (sources/deps :sources-test/table-6
                   {:seen 7}
                   nil
                   nil
                   (fn (row) (= (:slot row) :a)))
          '([:reads 7]))))))

(describe "a blank answer"
  (test "nil, false, an empty string and an empty collection say nothing; anything else does"
    (is (every? [nil false "" [] '() {}] sources/blank?))
    (is (not (any? ["x" [[0 1 :a]] 0 :k] sources/blank?)))))
