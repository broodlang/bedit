;; The user init file — `src/config.blsp` (~/.config/bedit/init.blsp). We test
;; the pure read/ensure pieces on a *temp* path (never the real ~/.config): that a
;; `(config …)` form reads into a map, that a missing / malformed file degrades to
;; `{}` without throwing, and that `ensure-init!` writes a parseable default once and
;; doesn't clobber an existing file.

(defmodule config-test
  (:use test)
  (:use scroll) ; *long-lines* / *truncation-ellipsis* — what :long-lines sets
  (:use config-paths)
  (:use-internals config))

(purge-stale-temp "bedit-cfg-") ; drop fixtures a prior run left in /tmp (at load)
;; A fresh, unique init-file path under a not-yet-created temp dir.
(defn tmp-init () (str (temp-dir "bedit-cfg-") "/init.blsp"))
;; Write `src` to a fresh init-file path (creating its dir) and return the path.
(defn with-init (src)
  (let (f (tmp-init) _ (file/mkdir (path/dirname f)) _ (file/spit f src)) f))

(describe "config--read — the init file as a map"
  (test "reads a (config …) form into a map"
    (assert= (get (config/config-read (with-init "(config :fullscreen true)")) :fullscreen) true))

  (test "{} for a missing file"
    (assert= (config/config-read (tmp-init)) {}))

  (test "{} for a file that isn't a (config …) form"
    (assert= (config/config-read (with-init "(something :else 1)")) {}))

  (test "{} for unparseable garbage (never throws)"
    (assert= (config/config-read (with-init "(config :x")) {})))

(describe "an init file that does not read is said, never silently {}"
  (test "a clean file, a missing one and a comment-only one say nothing"
    (assert= [] (init-read-warnings (with-init "(config :hl-line false)")))
    (assert= [] (init-read-warnings (tmp-init)))
    (assert= [] (init-read-warnings (with-init ";; nothing yet\n"))))
  (test "an unclosed form names its line, and that the defaults are in force"
    (assert= ["init.blsp:2:1: unclosed list (opened here) — the file does not read, so none of it applies"]
      (init-read-warnings (with-init ";; mine\n(config :hl-line false\n"))))
  (test "a stray paren after the form: the form still applies, and the paren is said"
    (let (file (with-init "(config :hl-line false))\n"))
      (assert= false (:hl-line (config/config-read file)))
      (assert= ["init.blsp:1:24: unexpected ')' — after the (config …) form, which still applies"]
        (init-read-warnings file))))
  (test "init-warnings: what did not read first, then the values the settings reject"
    (let (file (with-init "(config :cursor :blockk :hl-line)"))
      (assert= ["init.blsp: :hl-line has no value, so it is ignored"
                 "init.blsp: :cursor is :blockk — want :block / :bar / :hollow"]
        (init-warnings (config/config-read file) file)))))

(describe "a key set twice in init.blsp is said, with its lines"
  (test "twice: both lines, and that the last wins (as the read keeps it)"
    (let (text ";; mine\n(config\n :font \"Hack\"\n :hl-line true\n :font \"Iosevka\")\n")
      (assert= ["init.blsp: :font is set twice (lines 3 and 5); the last one is used"]
        (duplicate-key-warnings text))
      (assert= "Iosevka" (:font (config/config-read (with-init text))))))
  (test "three times, and two keys, each in the order it first appears"
    (assert= ["init.blsp: :a is set 3 times (lines 1, 2 and 4); the last one is used"
               "init.blsp: :b is set twice (lines 3 and 4); the last one is used"]
      (duplicate-key-warnings "(config :a 1\n:a 2\n:b 3\n:a 4 :b 5)")))
  (test "a key repeated inside a VALUE (a nested map, a comment) is not a duplicate"
    (is (empty? (duplicate-key-warnings "(config\n ;; :font \"x\"\n :font \"Hack\"\n :faces {:a {:fg 1}}\n :mode-keys {:a 1})"))))
  (test "a clean file, a broken one and one with no (config …) say nothing here"
    (is (empty? (duplicate-key-warnings "(config :hl-line false :cursor :bar)")))
    (is (empty? (duplicate-key-warnings "(config :x")))
    (is (empty? (duplicate-key-warnings "(other :a 1 :a 2)"))))
  (test "init-warnings carries it, so startup's *Messages* and reload-config say it"
    (let (file (with-init "(config\n :hl-line true\n :hl-line false)"))
      (assert= ["init.blsp: :hl-line is set twice (lines 2 and 3); the last one is used"]
        (init-warnings (config/config-read file) file)))))

(describe "*window-options* — what every bedit window opens with"
  (test "the desktop's key repeat, since bedit has none of its own (brood ADR-441)"
    (assert= (:key-repeat *window-options*) :os)
    (assert= (:app-id *window-options*) *app-id*)))

(describe "window-mode — the Emacs-style :fullscreen value"
  (test ":maximized → :maximized"
    (assert= (config/window-mode {:fullscreen :maximized}) :maximized))
  (test "true → :maximized (keeps the title bar)"
    (assert= (config/window-mode {:fullscreen true}) :maximized))
  (test ":fullboth → :fullscreen"
    (assert= (config/window-mode {:fullscreen :fullboth}) :fullscreen))
  (test ":fullscreen → :fullscreen"
    (assert= (config/window-mode {:fullscreen :fullscreen}) :fullscreen))
  (test "false → nil (a normal window)"
    (is (nil? (config/window-mode {:fullscreen false}))))
  (test "absent → nil"
    (is (nil? (config/window-mode {}))))
  (test "the rest of the config may hold any value: a number beside :fullscreen is no error"
    ;; the argument is the WHOLE config; its sig once said every value was a keyword or a
    ;; bool, and `:line-height 1.3` in init.blsp killed the editor before its window opened
    (assert= :maximized
      (config/window-mode {:fullscreen :maximized
                           :line-height 1.3
                           :large-file-warning-threshold 1000}))
    (is (nil? (config/window-mode {:line-height 1.3})))))

(describe "a per-mode map's keys name modes"
  (test "a key that names no mode is said, once per entry"
    (assert= (per-mode-key-warnings {:show-whitespace {:pyhton true :default false}}
               #{"python" "prog" "text"})
      [":show-whitespace: no mode is called pyhton (init.blsp); the entry is never used"]))

  (test "a mode's keyword or bare symbol, :default, and a line kind under :long-lines pass"
    (assert= (per-mode-key-warnings {:line-numbers {:prog :relative 'python false :default true}
                                     :long-lines {:section-heading :wrap 'markdown :wrap}
                                     :fill-column 80}
               #{"python" "prog" "markdown"})
      []))

  (test "a line kind is a :long-lines key only"
    (assert= (count (per-mode-key-warnings {:auto-fill {:section-body true}} #{"text"})) 1))

  (test "the modes the editor registers are the names a map may use"
    (let (names (modes/mode-names))
      (is (contains? names "text"))
      (is (contains? names "prog")))))

(describe "config-warnings — advisory feedback for the data init file"
  (test "no warning for a recognised :fullscreen value"
    (is (empty? (config-warnings {:fullscreen :maximized})))
    (is (empty? (config-warnings {:fullscreen false})))
    (is (empty? (config-warnings {})))) ; absent key → windowed, fine
  (test "an unknown :fullscreen value warns, naming the offender"
    (let (ws (config-warnings {:fullscreen :maximised}))
      ; typo
      (assert= (count ws) 1)
      (is (includes? (first ws) ":maximised"))))

  (test "no warning for a recognised :cursor value; an unknown one warns"
    (is (empty? (config-warnings {:cursor :block})))
    (is (empty? (config-warnings {:cursor :bar})))
    (is (empty? (config-warnings {}))) ; absent → defaults to :block
    (let (ws (config-warnings {:cursor :blockk}))
      ; typo
      (assert= (count ws) 1)
      (is (includes? (first ws) ":blockk"))))

  (test ":text-aa accepts the window's modes; anything else warns by name"
    (is (empty? (config-warnings {:text-aa :auto})))
    (is (empty? (config-warnings {:text-aa :subpixel})))
    (is (empty? (config-warnings {:text-aa :gray})))
    (let (ws (config-warnings {:text-aa :lcd}))
      (assert= (count ws) 1)
      (is (includes? (first ws) ":lcd"))))

  (test ":reduce-motion is :auto, true or false, and seeds the model's switch"
    (is (empty? (config-warnings {:reduce-motion :auto})))
    (is (empty? (config-warnings {:reduce-motion true})))
    (assert= (count (config-warnings {:reduce-motion :yes})) 1)
    (assert= (setting {} :reduce-motion) :auto)
    (assert= (:reduce-motion (apply-to-model {} {:reduce-motion true})) true)
    (is (model/ed-reduce-motion? (apply-to-model {} {:reduce-motion true})))
    ;; :auto, the default, follows what the desktop said at startup
    (is (not (model/ed-reduce-motion? (apply-to-model {} {}))))
    (is (model/ed-reduce-motion? (apply-to-model {:os-reduce-motion true} {}))))

  (test "the desktop is asked only when :reduce-motion follows it"
    (assert= (startup/desktop-reduce-motion {:reduce-motion true}) nil)
    (assert= (startup/desktop-reduce-motion {:reduce-motion false}) nil))

  (test ":line-height accepts a number in the window's range; a typo or an absurd value warns"
    (is (empty? (config-warnings {:line-height 1.25})))
    (is (empty? (config-warnings {:line-height 2})))
    (assert= (count (config-warnings {:line-height 14})) 1) ; px, not a multiple
    (assert= (count (config-warnings {:line-height "1.4"})) 1)))

(describe "window-options — what a window opens with, the keyboard's Option key among it"
  (test "left Option is Meta by default, the right one composing (brood ADR-541)"
    (assert= (:option-meta (window-options {})) :left)
    (assert= (:key-repeat (window-options {})) :os)
    (assert= (:app-id (window-options {})) "bedit"))
  (test "the init file picks which Option key is Meta"
    (assert= (:option-meta (window-options {:option-meta :both})) :both)
    (assert= (:option-meta (window-options {:option-meta :none})) :none)
    (is (empty? (config-warnings {:option-meta :right}))))
  (test "a value the window does not know warns, and the window keeps the default"
    (assert= (count (config-warnings {:option-meta :meta})) 1)
    (assert= (:option-meta (window-options {:option-meta :meta})) :left))
  (test "the default init file documents it"
    (is (includes? *init-default-source* ":option-meta"))))

(describe "window-settings — the init file's window-side keys as gui/* calls"
  (test "absent keys ask for the window's defaults (so a reload after deleting a key restores them)"
    (assert= (window-settings {})
      [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.4] [:ligatures false]]))
  (test "under :desktop (the default) the desktop's rendering is the window's, at GTK's sRGB weight"
    (assert= (window-settings {} {:antialias :gray :rgba :rgb})
      [[:text-aa :gray] [:line-height 1.25] [:text-contrast 1.0] [:ligatures false]])
    (assert= (first (window-settings {} {:antialias :subpixel :rgba :bgr})) [:text-aa :bgr])
    ;; a contrast named in init.blsp wins; an anti-aliasing named ignores the desktop
    (assert= (nth (window-settings {:text-contrast 1.6} {:antialias :gray}) 2) [:text-contrast 1.6])
    (assert= (window-settings {:text-aa :subpixel} {:antialias :gray})
      [[:text-aa :subpixel] [:line-height 1.25] [:text-contrast 1.4] [:ligatures false]]))
  (test "each recognised key maps to its call, in a fixed order"
    (assert= (window-settings {:text-aa :gray :line-height 1.3 :text-contrast 1.0})
      [[:text-aa :gray] [:line-height 1.3] [:text-contrast 1.0] [:ligatures false]]))
  (test "an invalid value falls back to the default (config-warnings reports it) rather than applied"
    (assert= (window-settings {:text-aa :lcd :line-height 1.3})
      [[:text-aa :auto] [:line-height 1.3] [:text-contrast 1.4] [:ligatures false]])
    (assert= (window-settings {:line-height 14 :text-contrast 9})
      [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.4] [:ligatures false]]))

  (test ":ligatures is a bool, off by default as brood's gui/ligatures, and a window call"
    (assert= (last (window-settings {:ligatures true})) [:ligatures true])
    (assert= (last (window-settings {:ligatures "yes"})) [:ligatures false])
    (assert= (count (config-warnings {:ligatures "yes"})) 1)
    (assert= (:ligatures (apply-to-model {} {:ligatures true})) true)
    ;; no window here (a headless test run): applying it is a no-op, never an error
    (assert= (apply-window! {:ligatures true} nil) nil))
  (test "a theme's font keeps init.blsp's ligatures unless the theme names its own"
    (is (themes/font-ligatures {:ligatures true} {:font :mono}))
    (is (not (themes/font-ligatures {} {:font :mono})))
    (is (not (themes/font-ligatures {:ligatures true} {:font :mono :ligatures false}))))

  (test ":text-contrast accepts the window's 0.5..3.0; outside it warns and the default applies"
    (is (empty? (config-warnings {:text-contrast 1.0})))
    (is (empty? (config-warnings {:text-contrast 1.8})))
    (assert= (count (config-warnings {:text-contrast 9})) 1)
    (assert= (count (config-warnings {:text-contrast "1.4"})) 1)
    (assert= (window-settings {:text-contrast 1.8})
      [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.8] [:ligatures false]])))

(describe "apply-to-model — config → model fields (defaults + overrides)"
  (test "absent keys default: hl-line on, cursor :block"
    (let (m (apply-to-model {} {}))
      (assert= (:hl-line m) true)
      (assert= (:cursor-style m) :block)))
  (test "init values override the defaults"
    (let (m (apply-to-model {} {:hl-line false :cursor :bar}))
      (assert= (:hl-line m) false)
      (assert= (:cursor-style m) :bar))))

(describe "the settings registry — one declaration per key"
  (test "an undeclared key warns, so a typo'd key is no longer silently ignored"
    (let (ws (config-warnings {:hl-lin false}))
      (assert= (count ws) 1)
      (is (includes? (first ws) ":hl-lin"))))
  (test "every key the editor reads is declared"
    (doseq (k [:fullscreen
                :hl-line :cursor :text-aa :line-height :text-contrast :electric-pair
                :scroll-output :version-format :share-name :welcome])
      (is (map? (settings/spec-of *settings* k)))))
  (test "the default file names every setting, and reads back as the defaults it sets"
    ;; bedit's OWN settings — the ones src/config.blsp declares — not the registry's whole
    ;; contents, which also holds what an installed package declared (a test that applied
    ;; one before this file ran)
    (let (own (seq/keep (reflect/read-all (file/slurp "src/config.blsp"))
                (fn (form)
                  (when (and (list? form)
                          (= (first form) 'settings/define)
                          (= (second form) '*settings*))
                    (nth form 2)))))
      (is (> (count own) 20))
      (doseq (name own)
        (is (includes? *init-default-source* (pr-str name)))))
    (assert= {:fullscreen false :hl-line true :cursor :block :electric-pair true}
      (settings/read-form *init-default-source* 'config)))
  (test "an invalid value is never applied: the model gets the default"
    (assert= :block (:cursor-style (apply-to-model {} {:cursor :blockk})))
    (assert= true (:hl-line (apply-to-model {} {:hl-line "no"}))))
  (test "setting answers the default for an absent or invalid value"
    (assert= 1.25 (setting {} :line-height))
    (assert= 1.25 (setting {:line-height 14} :line-height))
    (assert= 1.4 (setting {:line-height 1.4} :line-height))
    (is (nil? (setting {} :share-name))))
  (test "share-name seeds the participant only when set"
    (assert= "ada" (:participant (apply-to-model {} {:share-name "ada"})))
    (assert= "me" (:participant (apply-to-model {:participant "me"} {})))))

(describe "ensure-init! — the first-launch default"
  (test "writes the documented default when absent, and it parses back"
    (let (f (tmp-init) _ (ensure-init! f))
      (is (file/exists? f))
      (assert= (:fullscreen (config/config-read f)) false))) ; default is :fullscreen false
  (test "is idempotent — doesn't clobber an existing init file"
    (let (f (with-init "(config :fullscreen true)") _ (ensure-init! f))
      (assert= (:fullscreen (config/config-read f)) true))))

(describe ":long-lines / :truncation-ellipsis — how a line too long for its window shows"
  (test "a map of :default, line kinds and mode names to the three policies is clean"
    (is (empty? (config/config-warnings {:long-lines {:default :truncate
                                                      :section-heading :wrap
                                                      'markdown :scroll}}))))
  (test "a policy that is not one of the three warns, as does a value that is not a map"
    (is (not (empty? (config/config-warnings {:long-lines {'markdown :fold}}))))
    (is (not (empty? (config/config-warnings {:long-lines :truncate})))))
  (test "the default file documents both, commented out"
    (is (includes? config/*init-default-source* ";; :long-lines"))
    (is (includes? config/*init-default-source* ";; :truncation-ellipsis")))
  (test "applying the config sets the policies the row table reads, over the defaults"
    (config/apply-to-model {} {:long-lines {'markdown :truncate} :truncation-ellipsis "$"})
    (let (applied *long-lines*
          ellipsis *truncation-ellipsis*)
      ;; back to the defaults before asserting, so a failure leaves no setting behind
      (config/apply-to-model {} {})
      (assert= (get applied 'markdown) :truncate)
      (assert= (:section-heading applied) :truncate)
      (assert= ellipsis "$")
      (assert= *long-lines* *long-lines-defaults*))))

(describe "a test run never reaches the user's own config"
  ;; every file the editor keeps is under `config-dir`, which follows `$XDG_CONFIG_HOME`; the
  ;; test runner points that at the run's scratch home (brood ADR-602), and the persisting
  ;; writers refuse the real base it kept aside. A C-c t run from inside the editor is armed
  ;; the same way (brood ADR-608). A run with `--real-home` has no scratch home, and the
  ;; first case has nothing to check; the guard's case uses a stand-in base either way.
  (test "the config dir is in the run's scratch home"
    (when-let (scratch (test/scratch-dir))
      (is (string/starts-with? (config-dir) scratch))
      (assert= (projects/editor-state-dir) (path/join (config-dir) "state"))))
  (test "a bound *config-base* still wins"
    (assert= (binding (*config-base* "/tmp/elsewhere") (config-dir)) "/tmp/elsewhere/bedit"))
  (test "a write under the user's real config is refused"
    ;; against a STAND-IN for the real base, made here: a guard that regressed writes into
    ;; the stand-in, never into the user's config. The probes are spelled by hand, not with
    ;; the guard's own `path/join`, and one with a doubled slash and a `.` — the guard
    ;; compares normalized paths.
    (let (stand-in (temp-dir "bedit-cfg-real-")
          probe (str stand-in "/bedit/state/bedit-test-probe.blsp")
          init-probe (str stand-in "//bedit/./bedit-test-probe-init.blsp")
          beside (str stand-in "/bedit-other/state/x.blsp"))
      (file/mkdir stand-in)
      (binding (*user-config-base* stand-in)
        (is (test-forbidden-path? probe))
        (is (test-forbidden-path? init-probe))
        (is (test-forbidden-path? (str stand-in "/bedit")))
        (projects/persist-write! probe ["must not land"])
        (refute (file/exists? probe))
        (ensure-init! init-probe)
        (refute (file/exists? init-probe))
        ;; a directory beside it is not it, and is written
        (refute (test-forbidden-path? beside))
        (projects/persist-write! beside ["lands"])
        (is (file/exists? beside)))))
  (test "a path beside it, or in the scratch home, is not mistaken for it"
    (let (real-base (os/env "BROOD_USER_CONFIG_HOME"))
      (when real-base
        (refute (test-forbidden-path? (path/join real-base "bedit-other" "x"))))
      (refute (test-forbidden-path? (path/join (config-dir) "state" "x.blsp"))))))
