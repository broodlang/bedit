;; Every language, checked from its corpus: each file under tests/corpus/<mode>/ gets the checks
;; of `corpus` (src/corpus.blsp) as tests of its own, named by the file and the check —
;; its mode, its caret assertions and golden face listing, its indentation three ways (as
;; written, re-indented from scratch, typed line by line), its fontify restart and a run of random
;; edits — and every registered language is checked against the others. A language is tested by
;; dropping a sample in its directory; docs/packages.md "Testing a language".
;;
;; This file is the whole of it: `corpus/define-tests` is the one entry point, and a language
;; package's corpus test is this same line over its own tests/corpus/.
;;
;; A sample whose grammar the runtime lacks (`corpus/load-test-grammar`: `$BROOD_TEST_GRAMMARS`,
;; which CI fills, else the user's) registers its checks SKIPPED (`:skip-unless`, brood ADR-757),
;; so the run says so and why.
(defmodule language-corpus-test
  (:use test))

(corpus/define-tests)
