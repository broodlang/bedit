;; Every language, checked from its corpus: each file under tests/corpus/<mode>/ gets the checks
;; of `corpus` (tests/support/corpus.blsp) as tests of its own, named by the file and the check —
;; its mode, its caret assertions and golden face listing, its indentation three ways (as
;; written, re-indented from scratch, typed line by line), its fontify restart and a run of random
;; edits — and every registered language is checked against the others. A language is tested by
;; dropping a sample in its directory; docs/packages.md "Testing a language".
;;
;; A sample whose grammar the runtime lacks (`testkit/load-test-grammar`: `$BROOD_TEST_GRAMMARS`,
;; which CI fills, else the user's) registers its checks SKIPPED (`:skip-unless`, brood ADR-757),
;; so the run says so and why.
(defmodule language-corpus-test
  (:use test))

(corpus/load-grammars)

(defn- checks (sample)
  ;; `[name applies? thunk]` for every check of `sample`; the indent ones only for a mode that
  ;; indents from the code, and not where the known gaps turn them off
  (let (indented (corpus/indented? sample)
        painting (fn () (corpus/painted sample)))
    [["mode" true (fn () (corpus/mode-problems sample))]
      ["faces: every caret assertion holds" true (fn () (corpus/face-problems sample (painting)))]
      ["faces: the golden listing is what the mode paints"
        true
        (fn () (corpus/golden-problems sample (painting)))]
      ["indent: every line as written"
        (and indented (corpus/applies? sample :indent))
        (fn () (corpus/indent-problems sample))]
      ["indent: re-indented from scratch"
        (and indented (corpus/applies? sample :reindent))
        (fn () (corpus/reindent-problems sample))]
      ["indent: typed line by line"
        (and indented (corpus/applies? sample :typing))
        (fn () (corpus/typing-problems sample))]
      ["restart: a window from the restart paints as the whole text does"
        (corpus/applies? sample :restart)
        (fn () (corpus/restart-problems sample))]
      ["robustness: random edits raise nothing, spans stay in order"
        true
        (fn () (corpus/robustness-problems sample))]]))

(doseq (entry (corpus/corpus-files))
  (let (sample (corpus/sample entry)
        ready (corpus/ready? sample))
    (describe (str "corpus " (:id sample))
      (doseq ([name applies thunk] (checks sample))
        (when applies
          (test name
            :skip-unless ready
            (str "no " (->string (corpus/grammar sample)) " grammar")
            (assert= (thunk) [])))))))

(describe "the languages, against each other"
  (test "no two languages answer to the same name"
    (assert= (corpus/name-problems) []))
  (test "no two languages claim the same #! program"
    (assert= (corpus/interpreter-problems) []))
  (test "every corpus file is claimed by its own language's file pattern alone"
    (assert= (corpus/pattern-problems) []))
  (test "every registered spec passes its macro's key check"
    (assert= (corpus/spec-problems) []))
  (test "every language server row says its name, commands and root markers"
    (assert= (corpus/lsp-problems) []))
  (test "every registered language has a corpus sample"
    (assert= (corpus/uncovered-languages) [])))
