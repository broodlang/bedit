;; CLAUDE.md's Layout section is the map of the editor: one entry per src/ module, saying what
;; it is and what it owns. It is written by hand, so a new module could arrive without one and
;; the map would drift (ten modules had none on 2026-11-11). Every src/*.blsp has a line that
;; starts with its path — or is covered by a pattern line, as `src/lex-*.blsp` covers the
;; lexical highlighters.

(defmodule layout-doc-test
  (:use test))

(defn- entry-paths ()
  ;; the paths CLAUDE.md's Layout lines start with: `src/x.blsp` and patterns like `src/lex-*.blsp`
  (seq/keep (string/split (file/slurp "CLAUDE.md") "\n")
    (fn (line)
      (when (string/starts-with? line "src/")
        (first (string/split line " "))))))

(defn- covered? (path entries)
  ;; whether `path` has an entry of its own, or matches a pattern entry
  (any? entries
    (fn (entry)
      (if (includes? entry "*")
        (regex/matches? path (str "^" (string/replace (regex/escape entry) "\\*" "[^/]*") "$"))
        (= entry path)))))

(describe "CLAUDE.md maps every module"
  (test "it reads the map (a moved file would make this vacuous)"
    (is (> (count (entry-paths)) 100)))
  (test "every src/ module has a Layout entry"
    (let (entries (entry-paths)
          modules (map (seq/filter (file/list-files "src")
                         (fn (name) (string/ends-with? name ".blsp")))
                    (fn (name) (str "src/" name))))
      (assert= (vec (seq/reject modules (fn (path) (covered? path entries)))) []))))
