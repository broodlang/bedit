;; tests/desktopprefs_test.blsp — the window follows the desktop: its light or dark setting picks
;; the theme when init.blsp names no :theme, its text rendering is the window's under :text-aa
;; :desktop, and its caret blink is the caret's while :blink-cursor-blinks is unset.

(defmodule desktopprefs-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use desktopprefs))

(describe "which theme the desktop picks"
  (test "light and dark name the init file's :theme-light and :theme-dark"
    (assert= (themes/system-theme-name {} :light) "Catppuccin Latte (light)")
    (assert= (themes/system-theme-name {} :dark) "Catppuccin Mocha")
    (assert= (themes/system-theme-name {:theme-light "Nord"} :light) "Nord"))
  (test "a desktop that says nothing, or a :theme named, picks nothing"
    (assert= (themes/system-theme-name {} nil) nil)
    (assert= (themes/system-theme-name {:theme "Nord"} :light) nil)))

(defn- following (scheme)
  ;; a window following the desktop, whose last answer said `scheme`
  (assoc (ed-init (make-buffer ""))
    :theme-follows-system true
    :gui true
    :theme-light "Catppuccin Latte (light)"
    :theme-dark "Catppuccin Mocha"
    :desktop-prefs (if (nil? scheme) {} {:color-scheme scheme})))

(describe "following a change of scheme"
  (test "the first answer is only kept: startup already themed by it"
    (let (m (preferences-arrived (following nil) {:color-scheme :light}))
      (assert= (:desktop-prefs m) {:color-scheme :light})
      (assert= (:echo m) (:echo (following nil)))))
  ;; switches the process-wide palette: alone, so no test drawing beside it sees the light theme
  :isolated (test "a change re-themes, an unchanged answer does nothing"
    (let (same (preferences-arrived (following :dark) {:color-scheme :dark})
          changed (preferences-arrived (following :dark) {:color-scheme :light}))
      (assert= same (following :dark))
      (assert= (:color-scheme (:desktop-prefs changed)) :light)
      (is (includes? (:echo changed) "Latte"))
      ;; the palette is process-wide: put the default back for the tests after this one
      (themes/theme-activate! "Catppuccin Mocha")))
  (test "a :theme named keeps it whatever the desktop says"
    (let (named (assoc (following :dark) :theme-follows-system false))
      (assert= (:echo (preferences-arrived named {:color-scheme :light})) (:echo named))))
  (test "the timer runs while the window follows anything of the desktop"
    (is (check-timer (following nil)))
    (is (check-timer (assoc (following nil) :theme-follows-system false)))
    (is (nil? (check-timer (assoc (following nil)
                             :theme-follows-system false
                             :blink-cursor-blinks 10
                             :init-config {:text-aa :gray}))))
    (is (nil? (check-timer (dissoc (following nil) :gui))))))

(describe "the desktop's answer"
  (test "a test never asks the desktop: startup's answer is empty"
    (assert= (startup-answer) {}))
  (test "an answer files the caret blink and reduced motion; a failed or empty read changes nothing"
    (let (preferences {:color-scheme :dark
                       :reduce-motion? true
                       :cursor-blink {:blink? true :interval-ms 600 :timeout-ms 10000}}
          asking (assoc (following :dark) :desktop-job :handle)
          m (preferences-arrived asking preferences))
      ;; the job's slot is freed, so the next check asks again
      (is (nil? (:desktop-job m)))
      (assert= (:desktop-prefs m) preferences)
      (is (:os-reduce-motion m))
      (assert= (preferences-arrived asking nil) (following :dark))
      (assert= (preferences-arrived asking {}) (following :dark))
      (is (:desktop-job (check m)))
      ;; the check's task answers this process: taken, so nothing is left for the next test
      (receive ([:task-done _ _] nil) (after 2000 nil)))))

(defn- blinking (blink)
  ;; a model whose desktop answered caret blink `blink`
  (assoc (ed-init (make-buffer "")) :desktop-prefs {:cursor-blink blink}))

(describe "the caret blinks as the desktop's apps do"
  (test "the desktop's phase and timeout while init.blsp counts no blinks"
    (let (m (blinking {:blink? true :interval-ms 600 :timeout-ms 10000}))
      (assert= (ed-blink-interval m) 600)
      ;; ten seconds of 1.2 s cycles: eight whole blinks, then steady
      (assert= (ed-blink-count m) 8)
      (is (ed-caret-blinks? m))))
  (test "a desktop that says not to blink holds the caret steady"
    (refute (ed-caret-blinks? (blinking {:blink? false}))))
  (test "init.blsp's count wins, at the editor's own interval"
    (let (m (assoc (blinking {:blink? false :interval-ms 600 :timeout-ms 10000})
              :blink-cursor-blinks 3))
      (is (ed-caret-blinks? m))
      (assert= (ed-blink-count m) 3)
      (assert= (ed-blink-interval m) *blink-ms*)))
  (test "a desktop that says nothing blinks Emacs's way"
    (let (m (ed-init (make-buffer "")))
      (is (ed-caret-blinks? m))
      (assert= (ed-blink-count m) *blink-cursor-blinks*)
      (assert= (ed-blink-interval m) *blink-ms*))))
