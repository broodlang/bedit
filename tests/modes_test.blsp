;; Editor tests (split from the original monolithic main_test.blsp by concern).
;; Every split file keeps the `main-test` module name, so a helper defined in any
;; file is visible to every test body at run time (test bodies are lazy thunks the
;; runner evaluates only after all files load into the shared image). The common
;; model helpers below are repeated in each file so a standalone `nest check` of a
;; single file still resolves them.
(defmodule modes-test
  (:use model)
  (:use-internals input)
  (:use view)
  (:use commands)
  (:use-internals panes)
  (:use complete-at-point)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(defn type-str (m s) (press m (string/->list s)))

;; brood-mode: a .blsp buffer stacks structural sexp nav (C-M-*) on top of
;; text-mode; the trigger is the mode's :file-pattern regex ("\.blsp$").
(describe "editor brood-mode (.blsp files)"
  (defn blsp-model (text) (ed-init (make-buffer text "x.blsp" "x.blsp")))

  (test "C-M-f navigates structurally over a whole form in a .blsp buffer"
    (assert= (buffer-point (cur (ed-update (blsp-model "(+ 1 2)") :ctrl-meta-f 80 24))) 7))

  (test "C-M-- C-M-f runs backward-sexp (negative arg via the C-M-- chord)"
    ;; From end of "(+ 1 2) (a)" the negative arg flips C-M-f to its inverse (backward),
    ;; landing at the start of the last form "(a)" (8).
    (let (m-end (ed-init (goto-char (make-buffer "(+ 1 2) (a)" "x.blsp" "x.blsp") 11)))
      (assert= (buffer-point (cur (press m-end [(keyword "ctrl-meta--") :ctrl-meta-f]))) 8)))

  (test "C-M-SPC (mark-sexp) marks the next sexp, leaving point — and extends on repeat"
    (let (m1 (cmd-mark-sexp (blsp-cm "(+ 1) (a)" 0) nil)
          m2 (cmd-mark-sexp (assoc m1 :last-command 'commands/cmd-mark-sexp) nil))
      (assert= (buffer-point (cur m1)) 0) ; point stays put
      (assert= (buffer-mark (cur m1)) 5) ; mark at end of "(+ 1)"
      (assert= (buffer-mark (cur m2)) 9))) ; repeat extends over " (a)"
  (test "C-M-d / C-M-u descend into and back out of a list"
    (let (down (ed-update (blsp-model "(a b)") :ctrl-meta-d 80 24))
      ; into the list
      (assert= (buffer-point (cur down)) 1)
      (assert= (buffer-point (cur (ed-update down :ctrl-meta-u 80 24))) 0))) ; back out
  (test "text-mode bindings still work in a .blsp buffer (brood stacks on text)"
    (assert= (buffer-text (cur (press (blsp-model "ac") [:right "b"]))) "abc"))

  (test "a non-.blsp buffer has no structural nav (C-M-f unbound → no-op)"
    (assert= (buffer-point (cur (ed-update (m-of "(+ 1 2)") :ctrl-meta-f 80 24))) 0))

  (test "the trigger is an anchored regex — x.blsp.txt is NOT brood-mode"
    (let (m (ed-update (ed-init (make-buffer "(+ 1 2)" "x.blsp.txt" "x.blsp.txt"))
              :ctrl-meta-f 80 24))
      (assert= (buffer-point (cur m)) 0))))

;; paredit-style structural editing (brood-mode): the C-)/C-}/M-r/C-M-s/C-k chords
;; over `std/sexp`'s pure edits. `blsp-cm` makes a .blsp model with point at `p`.
(describe "editor brood-mode structural editing (paredit)"
  (defn edit (text p key) (buffer-text (cur (ed-update (blsp-cm text p) key 80 24))))

  (test "C-) slurps the next form in; C-} barfs the last out (inverses)"
    (assert= (edit "(foo) bar" 2 (keyword "ctrl-)")) "(foo bar)")
    (assert= (edit "(foo bar)" 2 (keyword "ctrl-}")) "(foo) bar"))
  (test "M-r raises the form at point, replacing the enclosing list"
    (assert= (edit "(a (b c) d)" 6 :alt-r) "(a c d)")) ; point on c
  (test "C-M-s splices the enclosing list's contents up a level"
    (assert= (edit "(a (b) c)" 4 :ctrl-meta-s) "(a b c)"))
  (test "C-k is structure-aware in brood-mode — won't kill past the close"
    (assert= (edit "(foo) bar" 1 :ctrl-k) "() bar"))
  (test "C-k stays plain kill-line in a non-.blsp buffer (breaks parens)"
    (let (m (ed-init (goto-char (make-buffer "(foo) bar") 1)))
      (assert= (buffer-text (cur (ed-update m :ctrl-k 80 24))) "("))))

;; The rest of Emacs' sexp/list family, on the shared `prog-mode-layer` (so a
;; tree-sitter mode inherits the same keys): the LIST motions that step over atom
;; siblings, end-of-defun, the structural kills, transpose and whole-form reindent.
(describe "editor structural navigation — the list / defun / kill family"
  (defn pt-at (text p key) (buffer-point (cur (ed-update (blsp-cm text p) key 80 24))))
  (defn txt-at (text p key) (buffer-text (cur (ed-update (blsp-cm text p) key 80 24))))

  (test "C-M-n / C-M-p move over whole LISTS, stepping past the atom siblings"
    ;; "(defn f (x) 1)" — the outer list's children are `defn` [1,5), `f` [6,7),
    ;; `(x)` [8,11) and `1` [12,13). C-M-f would stop at each; C-M-n stops only at `(x)`.
    (assert= (pt-at "(defn f (x) 1)" 1 :ctrl-meta-n) 11)
    (assert= (pt-at "(defn f (x) 1)" 11 :ctrl-meta-p) 8)
    ; no further list → no-op
    (assert= (pt-at "(defn f (x) 1)" 11 :ctrl-meta-n) 11))
  (test "C-M-e ends the enclosing defun — the mirror of C-M-a"
    (assert= (pt-at "(defn f (x)\n  (+ x 1))" 15 :ctrl-meta-e) 22)
    (assert= (pt-at "(defn f (x)\n  (+ x 1))" 15 :ctrl-meta-a) 0))
  (test "up-list leaves the enclosing list FORWARD (C-M-u's mirror; M-x only, as in Emacs)"
    ;; "(a (b) c)" — point 4 is inside `(b)` [3,6), so up-list lands just past its `)`
    (assert= (buffer-point (cur (cmd-up-list (blsp-cm "(a (b) c)" 4) nil))) 6)
    (assert= (buffer-point (cur (cmd-backward-up-list (blsp-cm "(a (b) c)" 4) nil))) 3))
  (test "C-M-k kills the whole sexp after point — across lines, unlike paredit's C-k"
    (assert= (txt-at "(a\n b) c" 0 :ctrl-meta-k) " c")
    ; paredit C-k stops at the line end and keeps the parens balanced
    (assert= (txt-at "(a\n b) c" 1 :ctrl-k) "(\n b) c"))
  (test "C-M-DEL kills the sexp BEFORE point"
    (assert= (txt-at "(a) (b)" 3 (keyword "ctrl-meta-backspace")) " (b)"))
  (test "C-M-t transposes the sexps either side of point"
    (assert= (txt-at "(a b)" 2 :ctrl-meta-t) "(b a)")
    ; whole lists move as units
    (assert= (txt-at "((a b) (c d))" 6 :ctrl-meta-t) "((c d) (a b))"))
  (test "C-M-q reindents every line of the form after point"
    ;; the body line starts at column 0; the brood indenter puts it at the body indent
    (let (out (txt-at "(defn f ()\n1)" 0 :ctrl-meta-q))
      (is (includes? out "\n  1)"))))
  (test "the new motions are no-ops in a plain (non-prog) buffer — the keys are mode-local"
    (assert= (buffer-point (cur (ed-update (m-of "(a (b) c)") :ctrl-meta-n 80 24))) 0)
    (assert= (buffer-point (cur (ed-update (m-of "(a (b) c)") :ctrl-meta-e 80 24))) 0)))

;; ---- brood-mode REPL-style services (highlight / brackets / eldoc / completion)
;; The view/completion stay language-agnostic: they ask the buffer's mode for
;; :fontify / :bracket-match / :eldoc / :complete-at via `ed-mode-service`, and
;; brood-mode supplies brood implementations over `std/highlight.blsp`. A `.blsp`
;; buffer thus gains the same live feedback the REPL editor has.

;; A model whose current buffer is a brood-mode (.blsp) buffer of `text`, point at `p`.
(defn blsp-cm (text p)
  (let (m (ed-init (make-buffer text "x.blsp" "x.blsp")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))
;; A model whose current buffer is a markdown-mode (.md) buffer of `text`, point at `p`.
(defn md-cm (text p)
  (let (m (ed-init (make-buffer text "x.md" "x.md")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))
;; The :text ops of a frame whose drawn string satisfies `pred`.
(defn text-ops-where (f pred)
  (filter (fn (op) (and (= (first op) :text) (pred (nth op 3 "")))) f))

(describe "editor markdown-mode: a second language mode"
  ;; The editor is language-agnostic: a `.md` buffer gets markdown-mode purely by the
  ;; layer registration in `modes`, with `std/editor/markdown`'s `markdown-spans` as its
  ;; `:fontify` service — no view/dispatch change. Proves the toolkit hosts a second
  ;; language the same way it hosts brood.
  (test "a .md buffer is in markdown-mode"
    (assert= (ed-buf-mode-name (cur (md-cm "# Title" 0))) "markdown"))
  (test "a .md heading is syntax-coloured — its text carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (md-cm "# Title" 0) 80 24)
                (fn (s) (includes? s "Title"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "the same text in a plain (non-md) buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "# Title") 80 24)
                (fn (s) (includes? s "Title"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nil? (nth op 4 nil))) ops)))))

;; A model whose current buffer is `text` opened under `file` (name = file), point 0.
(defn file-cm (text file)
  (ed-init (make-buffer text file file)))

(describe "editor env-mode / docker-mode: more language modes"
  ;; Two more fontify-only modes, registered the same way as markdown-mode — a `.env`
  ;; file and a Dockerfile get syntax colouring purely by their layer registration,
  ;; with std/editor/dotenv + std/editor/dockerfile supplying the :fontify span fns.
  (test "a .env buffer is in env-mode and its key is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "FOO=bar" ".env"))) "env")
    (let (ops (text-ops-where (ed-view (file-cm "FOO=bar" ".env") 80 24)
                (fn (s) (includes? s "FOO"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .env.local variant is also env-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "K=1" ".env.local"))) "env"))
  (test "a Dockerfile buffer is in docker-mode and FROM is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "FROM alpine" "Dockerfile"))) "docker")
    (let (ops (text-ops-where (ed-view (file-cm "FROM alpine" "Dockerfile") 80 24)
                (fn (s) (includes? s "FROM"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a *.dockerfile name is also docker-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "RUN x" "build.dockerfile"))) "docker"))
  (test "the same .env text in a plain buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "FOO=bar") 80 24) (fn (s) (includes? s "FOO"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nil? (nth op 4 nil))) ops)))))

(describe "editor ruby-mode / elixir-mode: tree-sitter language modes"
  ;; The proof of ROADMAP §C: a `.rb`/`.ex` buffer gets a non-Brood parser
  ;; (tree-sitter, via `std/editor/treesit`) yet plugs into the SAME mode-services
  ;; host — `:fontify` colours it and the `C-M-*` structural commands navigate it,
  ;; with no view/dispatch change. Modes are pure data (a face table + `:ts-lang`).
  (test "a .rb buffer is in ruby-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "def f\nend\n" "x.rb"))) "ruby"))
  (test "a Ruby keyword (def) is syntax-coloured — its chunk carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (file-cm "def f\nend\n" "x.rb") 80 24) (fn (s) (= s "def"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .ex buffer is in elixir-mode and a string literal is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "x = \"hi\"\n" "x.ex"))) "elixir")
    (let (ops (text-ops-where (ed-view (file-cm "x = \"hi\"\n" "x.ex") 80 24)
                (fn (s) (includes? s "hi"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .exs script is also elixir-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "IO.puts(1)\n" "run.exs"))) "elixir"))
  (test "the same Ruby text in a plain buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "def f") 80 24) (fn (s) (includes? s "def"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nil? (nth op 4 nil))) ops))))
  ;; structural navigation over the tree-sitter tree (same C-M-f command, dispatched
  ;; on the buffer's :ts-lang): from col 0 it moves over the first top-level form.
  (test "C-M-f navigates structurally in a .rb buffer (tree-sitter motion)"
    (let (m (ed-update (file-cm "def f\nend\nx = 1\n" "x.rb") :ctrl-meta-f 80 24))
      (is (> (buffer-point (cur m)) 0))))
  (test "C-M-f is a no-op in a plain buffer (no :ts-lang and not brood-mode)"
    (assert= (buffer-point (cur (ed-update (m-of "def f\nend") :ctrl-meta-f 80 24))) 0)))

(describe "editor wide glyphs: the cursor column counts display cells"
  ;; The GUI renderer draws an emoji / CJK char two cells wide; the cursor must keep
  ;; pace, so its column is the display-width of the line up to point, not the char
  ;; count. (`ed-visual-column` vs `buffer-column`.)
  (test "a wide glyph before point advances the cursor two columns"
    (let (b (goto-char (make-buffer "a😀b") 2))
      ; point after the emoji (char offset 2)
      (assert= (buffer-column b) 2) ; two characters precede point
      (assert= (ed-visual-column b) 3))) ; but they occupy three cells (1 + 2)
  (test "with no wide glyph the visual column equals the char column"
    (let (b (goto-char (make-buffer "abc") 2))
      (assert= (ed-visual-column b) (buffer-column b)))))

(describe "editor brood-mode: syntax highlighting"
  (test "a .blsp buffer is syntax-coloured — `defn` carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (blsp-cm "(defn f ())" 0) 80 24) (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a plain (non-brood) buffer is NOT coloured — the line is one faceless op"
    (let (ops (text-ops-where (ed-view (m-of "(defn f ())") 80 24)
                (fn (s) (includes? s "defn"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nil? (nth op 4 nil))) ops))))
  (test "the active region merges the selection tint into the lexer face (still coloured)"
    ;; region [0,4) over "(map f)" covers the call head `map`; its chunk keeps its
    ;; :fg and gains the region's :bg tint (so syntax colour stays visible).
    (let (m (press (blsp-cm "(map f)" 0) [(keyword "ctrl- ") :right :right :right :right])
          merged (filter (fn (op)
                           (and (= (first op) :text)
                             (= (:bg (nth op 4 {})) (:bg theme/face-region))
                             (:fg (nth op 4 {}))))
                   (ed-view m 80 24)))
      (is (> (count merged) 0)))))

;; Highlighting only the visible window (not the whole buffer) is what keeps a large
;; file responsive. These prove the windowed fontify (ed-window-spans) colours the
;; visible lines correctly at deep scroll offsets — i.e. spans land in *absolute*
;; coordinates, not slice-local ones — even past the backscan lead-in.
(describe "editor brood-mode: windowed fontification (large files)"
  ;; N lines of `(defn fK ())`; N exceeds the backscan lead-in so a deep scroll
  ;; exercises the rope-slice window rather than lexing from the top.
  (defn big-blsp (n) (string/join "\n" (map (fn (i) (str "(defn f" i " ())")) (range n))))

  (test "a token deep past the backscan window is still coloured"
    (let (ops (text-ops-where (ed-view (ed-set-top (blsp-cm (big-blsp 400) 0) 300) 80 24)
                (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (every? (fn (op) (nth op 4 nil)) ops))))

  (test "the deep token's face matches the same token at the top (absolute offsets correct)"
    (let (txt (big-blsp 400)
          face-at (fn (m)
                    (nth (first (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn")))) 4 nil))
          top-face (face-at (blsp-cm txt 0))
          deep-face (face-at (ed-set-top (blsp-cm txt 0) 300)))
      (is (not (nil? deep-face)))
      (assert= deep-face top-face)))

  (test "a stale scroll offset past EOF is clamped, not fed to the rope (no render crash)"
    ;; a pane scrolled deep then pointed at a short fontified buffer (e.g. after a
    ;; C-x k kill remaps it to a shorter buffer) keeps its old :top. Rendering must
    ;; clamp that into the buffer rather than ask the rope for a line past EOF — which
    ;; threw `rope-line->char: line N out of bounds` straight out of the renderer.
    (let (f (ed-view (ed-set-top (blsp-cm "(a)\n(b)\n(c)" 0) 9) 80 24))
      ;; top is clamped to the last line, so the buffer renders (its tail line's `c`
      ;; glyph is drawn — fontify splits the line into coloured chunks) rather than the
      ;; caught-error fallback frame (which has only its one error-message text op)
      (is (= 0 (count (text-ops-where f (fn (s) (includes? s "render error"))))))
      (is (> (count (text-ops-where f (fn (s) (includes? s "c")))) 0))))

  (test "ed-window-spans returns spans in absolute coordinates"
    ;; a window of just line 2 (lines [2, 3)) of a 3-line buffer: the call head `c` at
    ;; offset 9 is coloured in absolute (not slice-local) coordinates.
    (let (buf (ed-current-buf (blsp-cm "(a)\n(b)\n(c)" 0))
          spans (ed-window-spans buf
                  (ed-mode-service buf :fontify)
                  (ed-mode-service buf :fontify-restart)
                  2
                  3))
      (is (includes? spans [9 10 {:fg :cyan}])))))

;; The span cache (panes/ed-refresh-spans) is what makes motion feel slick: the pure
;; `view` re-lexes nothing on plain cursor movement / selection / mouse, reusing the
;; band cached on the model. A recompute happens only when the rope changes (an edit)
;; or the viewport scrolls outside the margin-widened band.
(describe "editor brood-mode: fontify span cache"
  ;; the span cache is keyed by PANE PATH now (several panes on one buffer cache their own
  ;; band), so read the selected pane's entry rather than a buffer index.
  (defn cache-entry (m)
    (get (:span-cache m) (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))))
  (defn rs (b) (ed-mode-service b :fontify-restart)) ; the brood-mode :fontify-restart
  (test "ed-refresh-spans caches a band covering the viewport"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (not (nil? e)))
      (is (panes/ed-band-covers? e (ed-current-buf m) 0 23 (rs (ed-current-buf m))))))

  (test "a scroll within the margin reuses the cached band (cache hit)"
    ;; margin is 32 lines; scrolling 20 lines keeps the viewport inside the band.
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (panes/ed-band-covers? e (ed-current-buf m) 20 23 (rs (ed-current-buf m))))))

  (test "a scroll past the margin no longer covers (forces a recompute)"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (not (panes/ed-band-covers? e (ed-current-buf m) 100 23 (rs (ed-current-buf m)))))))

  (test "an edit WITHIN the band (new fontify input) invalidates it"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m)
          edited (insert (ed-current-buf m) "x"))
      ; inserts at point (line 0, in the band)
      (is (not (panes/ed-band-covers? e edited 0 23 (rs edited))))))

  (test "an append BELOW the band keeps it covered (the streaming-output fast path)"
    ;; a results/output buffer grows below a stationary viewport: the rope changes but
    ;; THIS band's fontify input doesn't, so its spans stay valid — no re-fontify per line.
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m)
          buf (ed-current-buf m)
          ;; append past the band's end (bhi) — point/viewport stay at the top
          appended (insert (goto-char buf (buffer-length buf)) "\n(newline far below)")
          rope-changed (not (= (buffer-rope appended) (buffer-rope buf))))
      (is rope-changed) ; the rope really changed
      (is (panes/ed-band-covers? e appended 0 23 (rs appended))))) ; …yet the band still covers
  (test "the cached spans match a direct windowed lex of the same range"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 50) 80 24)
          buf (ed-current-buf m)
          e (cache-entry m)
          direct (ed-window-spans buf
                   (ed-mode-service buf :fontify)
                   (ed-mode-service buf :fontify-restart)
                   (:blo e)
                   (:bhi e)))
      (assert= (:spans e) direct))))

(describe "editor brood-mode: bracket matching"
  (test "the bracket adjacent to point marks its match (match-face pair)"
    ;; point at 1 sits just after the opening paren of "(+ 1 2)"; its match is the
    ;; closing paren — both painted in the bracket-match face.
    (let (f (ed-view (blsp-cm "(+ 1 2)" 1) 80 24)
          paren-ops (filter (fn (op)
                              (and (= (first op) :text)
                                (= (nth op 3 "") "(")
                                (= (nth op 4 nil) theme/face-bracket-match)))
                      f))
      (is (> (count paren-ops) 0))))
  (test "no bracket overrides when point isn't next to a bracket"
    (assert= (ed-bracket-overrides (ed-current-buf (blsp-cm "(+ 1 2)" 3))) '())))

(describe "editor brood-mode: eldoc signature hints"
  (test "eldoc shows the enclosing call's signature when the echo is idle"
    ;; eldoc is now a cached model field (ed-post-step), so seed the cache first
    (is (includes? (ed-echo-or-eldoc (ed-cache-eldoc (blsp-cm "(map f)" 4))) "map")))
  (test "an explicit message suppresses eldoc for that frame"
    (assert= (ed-echo-or-eldoc (message (blsp-cm "(map f)" 4) "hello")) "hello"))
  (test "no eldoc in a plain (non-brood) buffer"
    (assert= (ed-echo-or-eldoc (m-of "(map f)")) "")))

(describe "editor brood-mode: symbol completion"
  (test "Tab in a .blsp buffer completes live global symbols, not buffer words"
    ;; "(def" → many globals (defn, defmacro, …); the popup's items include `defn`,
    ;; which is NOT a word present in the buffer (so this proves the global source).
    (let (c (get (cmd-complete (blsp-cm "(def" 4) nil) :completion))
      (is (not (nil? c)))
      (is (includes? (:items c) "defn"))))
  (test "a plain buffer still completes buffer words (default source unchanged)"
    (let (m (cmd-complete (ed-set-buf (m-of "") (goto-char (make-buffer "alpha al") 8)) nil))
      (assert= (buffer-text (cur m)) "alpha alpha")))
  (test "Tab merges mode globals with buffer words (multi-source)"
    ;; prefix "def": brood-mode contributes live globals (`defn`, not a word in the
    ;; buffer) and the buffer-word source contributes `defjjj` (a word, not a global).
    ;; The popup shows BOTH — proof the sources merge, rather than one winning.
    (let (c (get (cmd-complete (blsp-cm "defjjj (def" 11) nil) :completion))
      (is (not (nil? c)))
      (is (includes? (:items c) "defn"))
      (is (includes? (:items c) "defjjj"))))
  (test "the open popup renders as a ui-kit card (flat rect terminal, rounded frect GUI)"
    ;; end-to-end: complete-popup-ops runs the whole widget path (ui-ctx → ui-panel →
    ;; ui-list) — a flat rect card in the terminal, a rounded frect card when :gui.
    (let (m (cmd-complete (blsp-cm "(def" 4) nil)
          flat (map first (complete-popup-ops (assoc m :gui false) 80 24))
          gui (map first (complete-popup-ops (assoc m :gui true) 80 24)))
      (is (member? :rect flat)) ; flat card surface + selection bar
      (is (not (member? :frect flat)))
      (is (> (count (filter (fn (t) (= t :text)) flat)) 0)) ; candidate rows
      (is (member? :frect gui)) ; rounded card + pill
      (is (not (member? :rect gui))))))

(describe "editor brood-mode: indentation (matches nest format)"
  ;; brood-indent text bol -> column, computed purely over the CST (std/sexp).
  ;; The canonical Brood style (std/format): bodies indent +2 from the open
  ;; delimiter; maps and let-bindings lists align under the first element.
  (test "top level → column 0"
    (assert= (modes/brood-indent "(a)\n(b)" 4) 0))
  (test "a body form (defn) indents its body +2 from the open paren"
    (assert= (modes/brood-indent "(defn f ()\nx)" 11) 2))
  (test "let body indents +2"
    (assert= (modes/brood-indent "(let (a 1)\nb)" 11) 2))
  (test "a call indents its body +2 (not aligned under the first arg, per the formatter)"
    (assert= (modes/brood-indent "(foo bar\nbaz)" 9) 2))
  (test "a vector indents +2"
    (assert= (modes/brood-indent "[a\nb]" 3) 2))
  (test "a map aligns entries under the first element"
    (assert= (modes/brood-indent "{:a 1\n:b 2}" 6) 1))
  (test "a let-family bindings list aligns pairs under its first element"
    ;; "(let (a 1\nb 2) x)" — the `b` line is inside the bindings list; aligns under `a`
    (assert= (modes/brood-indent "(let (a 1\nb 2) x)" 10) 6))
  (test "an unclosed form at end-of-text still indents the new line (RET case)"
    ;; "(defn f ()\n" — point at EOF (offset 11) inside the unclosed defn → body +2
    (assert= (modes/brood-indent "(defn f ()\n" 11) 2))

  (test "cmd-indent-line reindents a .blsp line to its sexp column, keeping point"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\nx)" 11) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")
      (assert= (buffer-point (cur m)) 13))) ; point was in the indent → first non-blank
  (test "cmd-indent-line removes over-indentation too"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\n      x)" 17) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))

  (test "RET in brood-mode inserts a newline and indents the new line"
    (let (m (ed-update (blsp-cm "(defn f ()" 10) :enter 80 24))
      (assert= (buffer-text (cur m)) "(defn f ()\n  ")
      (assert= (buffer-point (cur m)) 13)))
  (test "RET in a plain buffer is still a plain newline (no auto-indent)"
    (let (m (ed-update (ed-set-buf (m-of "  ab") (goto-char (make-buffer "  ab") 4)) :enter 80 24))
      (assert= (buffer-text (cur m)) "  ab\n")))

  (test "TAB indents a mis-indented line (no completion popup)"
    (let (m (ed-update (blsp-cm "(defn f ()\nx)" 11) :tab 80 24))
      (is (nil? (:completion m)))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))
  (test "TAB on an already-indented line, point on a symbol, completes instead"
    ;; line already at col 2, point after "map" → complete (against live globals,
    ;; not buffer words): the popup opens with candidates that all start with "map".
    (let (m (ed-update (blsp-cm "(defn f ()\n  map" 16) :tab 80 24)
          items (:items (:completion m)))
      (is (not (nil? (:completion m))))
      (is (> (count items) 0))
      (is (every? (fn (s) (string/starts-with? s "map")) items)))))

(describe "editor fallback indentation (no :indent service)"
  (test "cmd-indent-line matches the previous line's indentation in a plain buffer"
    (let (m (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "    foo\nbar") 8)) nil))
      (assert= (buffer-text (cur m)) "    foo\n    bar"))))

;; ---- in-process diagnostics (the :diagnostics service) ----------------------
;; brood-mode calls the advisory type checker directly (same image) via
;; check-string-structured; the warning is cached on edit and rendered inline /
;; in the echo / on the mode line. `(map cons …)` is a reliable warner: cons is
;; 2-ary, map calls it with 1 (ADR-078 callback-arity), flagged on line 1.
(def bad-src "(map cons (list 1 2 3))")

(describe "editor brood-mode: diagnostics service"
  (test "brood-diagnostics returns positioned warnings for a bad form"
    (let (ds (modes/brood-diagnostics bad-src))
      (is (> (count ds) 0))
      (assert= (:line (first ds)) 1)
      (is (string? (:message (first ds))))))
  (test "brood-diagnostics is empty for clean or unparsable source"
    (is (empty? (modes/brood-diagnostics "(def x 1)")))
    (is (empty? (modes/brood-diagnostics "("))))) ; incomplete input mid-edit
(describe "editor diagnostics cache (recompute only on rope change)"
  (test "ed-refresh-diagnostics populates :diagnostics + :diag-rope for a brood buffer"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1)))
      (is (> (count (:diagnostics m)) 0))
      (assert= (:diag-rope m) (buffer-rope (cur m)))))
  (test "it is a no-op when the rope is unchanged (cache hit on :diag-rope)"
    ;; seed the cache, then re-run with the buffer unchanged but a sentinel in place —
    ;; an unchanged sentinel proves it didn't recompute (the rope handle still matches).
    (let (m1 (ed-refresh-diagnostics (blsp-cm bad-src 1))
          m2 (ed-refresh-diagnostics (assoc m1 :diagnostics :sentinel)))
      (assert= (:diagnostics m2) :sentinel)))
  (test "a plain (non-brood) buffer has no :diagnostics service → left untouched"
    (is (nil? (get (ed-refresh-diagnostics (m-of "(map cons (list))")) :diagnostics))))
  ;; async path: with no live :editor process (as in tests) ed-launch-diag runs the
  ;; check synchronously; ed-apply-diag folds a spawned check's reply back in.
  (test "ed-launch-diag falls back to a synchronous check when headless"
    (let (m (ed-launch-diag (blsp-cm bad-src 1)))
      (is (> (count (:diagnostics m)) 0))
      (is (nil? (:diag-proc m)))))
  (test "ed-apply-diag stores the reply against the checked rope and clears the handle"
    (let (m (assoc (blsp-cm bad-src 1) :diag-proc :h :diag-checking :the-rope)
          m2 (ed-apply-diag m [{:line 2 :col 1 :message "w"}]))
      (assert= (count (:diagnostics m2)) 1)
      (assert= (:diag-rope m2) :the-rope)
      (is (nil? (:diag-proc m2)))))
  (test "a task reply whose handle is in flight for diagnostics updates the cache"
    (let (m (assoc (blsp-cm bad-src 1) :diag-proc :h :diag-checking :the-rope)
          m2 (input/ed-ev-task-reply m [:task-done :h [{:line 1 :col 1 :message "x"}]] 24 80 24))
      (assert= (count (:diagnostics m2)) 1)
      (is (nil? (:diag-proc m2)))))
  (test "a stale task reply (handle matches no in-flight job) is dropped"
    (let (m (assoc (blsp-cm bad-src 1) :diagnostics :keep)
          m2 (input/ed-ev-task-reply m [:task-done :gone ()] 24 80 24))
      (assert= (:diagnostics m2) :keep)))
  (test "typing defers the check (debounced); the idle tick runs it"
    ;; drive the real keystroke path: typing no longer type-checks per key — the check
    ;; is deferred (Emacs flymake-on-idle). `ed-run-diag` is what the debounce `:tick`
    ;; runs once typing settles; an unbalanced prefix nags nothing, the complete form does.
    (let (blank (ed-init (make-buffer "" "x.blsp" "x.blsp"))
          type (fn (m s) (fold (fn (acc c) (ed-update acc c 80 24)) m (string/->list s))))
      ;; right after typing the full ill-typed form the check hasn't run yet (deferred)
      (is (empty? (or (get (type blank "(map cons (list 1 2 3))") :diagnostics) '())))
      ;; the debounce tick (ed-run-diag) runs it: incomplete → none, complete → a warning
      (is (empty? (get (ed-run-diag (type blank "(map cons (list 1 2 3")) :diagnostics)))
      (is (> (count (get (ed-run-diag (type blank "(map cons (list 1 2 3))")) :diagnostics)) 0))))

  ;; eldoc rides the same off-loop task pattern as diagnostics (§E.2): launch on the
  ;; idle beat (async when a live :editor exists, sync headless), fold on [:task-done].
  (test "ed-launch-eldoc falls back to a synchronous cache when headless"
    (let (m (ed-launch-eldoc (blsp-cm "(map cons 1)" 5)))
      (assert= (:eldoc-point m) 5) ; computed AT point (hint may be nil/some)
      (is (nil? (:eldoc-proc m)))))
  (test "ed-apply-eldoc stores the hint against the point it was computed at"
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope (buffer-rope (cur m0))})
          m2 (ed-apply-eldoc m "plus hint"))
      (assert= (:eldoc m2) "plus hint")
      (assert= (:eldoc-point m2) 3)
      (is (nil? (:eldoc-proc m2)))))
  (test "an eldoc reply landing after the buffer changed is dropped, not mis-cached"
    ;; the hint was computed for another buffer/rope — caching it would show buffer
    ;; A's signature while visiting buffer B
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope :some-other-rope})
          m2 (ed-apply-eldoc m "stale hint"))
      (is (nil? (:eldoc m2)))
      (is (nil? (:eldoc-proc m2))))) ; the in-flight handle still clears
  (test "a task reply whose handle is in flight for eldoc folds via the router"
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope (buffer-rope (cur m0))})
          m2 (input/ed-ev-task-reply m [:task-done :h "hint"] 24 80 24))
      (assert= (:eldoc m2) "hint")
      (is (nil? (:eldoc-proc m2))))))

(describe "editor diagnostics rendering"
  (test "a diagnostic on the current line shows in the echo area (over eldoc)"
    (is (includes? (ed-echo-or-eldoc (ed-refresh-diagnostics (blsp-cm bad-src 1))) "warning")))
  (test "an explicit message still wins over a diagnostic"
    (assert= (ed-echo-or-eldoc (message (ed-refresh-diagnostics (blsp-cm bad-src 1)) "hi")) "hi"))
  (test "ed-diagnostic-overrides underlines each diagnostic token"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1))
          ovs (ed-diagnostic-overrides m (cur m)))
      (is (> (count ovs) 0))
      (assert= (second (first ovs)) {:underline true})))
  (test "ed-view underlines the diagnostic token (point off any bracket)"
    ;; point at 5 (inside `cons`) sits next to no bracket, so the diagnostic
    ;; underline at the call isn't shadowed by bracket-match.
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 5))
          underlined (filter (fn (op) (and (= (first op) :text) (:underline (nth op 4 {}))))
                       (ed-view m 80 24)))
      (is (> (count underlined) 0))))
  (test "the mode line shows the diagnostic count"
    (is (includes? (mode-line-text (ed-refresh-diagnostics (blsp-cm bad-src 1))) "⚠"))))

;; ---- genericity: the view honours ANY mode's services, not just brood's -----
;; A throwaway "stub" mode proves the editor is a language-agnostic services host:
;; register a layer with its own :fontify / :eldoc and the view uses them. This is
;; the whole point of putting brood-mode in the editor — adding another language is
;; the same registration with different functions.
(defn stub-fontify (text) (list [0 (string/length text) {:fg :magenta}]))
(defn stub-eldoc (text pos) "STUB-HINT")
(defn stub-indent (text bol) 7)
(defn stub-diagnostics (text) (list {:line 1 :col 1 :message "stub-warning"}))
(def stub-layer
  {:name 'stub
   :fontify 'modes-test/stub-fontify
   :eldoc 'modes-test/stub-eldoc
   :indent 'modes-test/stub-indent
   :diagnostics 'modes-test/stub-diagnostics})
(defn stub-model (text)
  (ed-set-buf (m-of "") (editor/layers/push-layer (make-buffer text) 'modes-test/stub-layer)))

(describe "editor is a language-agnostic mode-services host"
  (test "the view honours any mode's :fontify"
    (let (coloured (filter (fn (op) (and (= (first op) :text) (= (nth op 4 nil) {:fg :magenta})))
                     (ed-view (stub-model "hello") 80 24)))
      (is (> (count coloured) 0))))
  (test "the view honours any mode's :eldoc"
    ;; eldoc is cached on the model by ed-post-step; seed it, then the view paints it
    (assert= (ed-echo-or-eldoc (ed-cache-eldoc (stub-model "hello"))) "STUB-HINT"))
  (test "cmd-indent-line honours any mode's :indent"
    (assert= (buffer-text (cur (cmd-indent-line (stub-model "ab") nil))) "       ab"))
  (test "the editor honours any mode's :diagnostics"
    (let (m (ed-refresh-diagnostics (stub-model "hello")))
      (assert= (count (:diagnostics m)) 1)
      (is (includes? (ed-echo-or-eldoc m) "stub-warning")))))

(describe "editor brood-mode services across processes"
  :isolated
  (test "a brood model renders coloured after a round-trip through a spawned process"
    ;; send the model to a worker, which renders it and sends back the result —
    ;; proving the model (layers carry fn-symbol facets; faces are maps) deep-copies
    ;; intact across per-process heaps.
    (let (me (self)
          m (blsp-cm "(defn f ())" 0)
          _ (spawn (let (ops (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn"))))
                     (send me [:result (count ops) (nth (first ops) 4 nil)]))))
      (receive ([:result n faced] (is (> n 0)) (is faced)))))

  (test "diagnostics re-check correctly in a spawned process (in-process checker)"
    ;; the worker runs the advisory checker on a deep-copied model and reports the
    ;; warning count — proves check-string-structured works off the main process too.
    (let (me (self)
          m (blsp-cm "(map cons (list 1 2 3))" 1)
          _ (spawn (send me [:n (count (:diagnostics (ed-refresh-diagnostics m)))])))
      (receive ([:n n] (is (> n 0)))))))

;; ---- the mode in the mode line ----------------------------------------------
(defn mode-line-text (m)
  "The selected pane's mode-line text: the bar is now a `face-modeline` **fill rect** plus one
`text` op per status-bar segment, so join every text op on the bar's row to recover the line."
  (let (ops (ed-view m 80 24)
        barrow (nth (find (fn (op)
                            (and (= (first op) :rect) (= (nth op 5 nil) theme/face-modeline)))
                      ops)
                 1))
    (string/join ""
      (map (fn (op) (nth op 3))
        (filter (fn (op) (and (= (first op) :text) (= (nth op 1) barrow))) ops)))))

(describe "editor mode line shows the active mode"
  (test "a plain buffer shows (text)"
    (is (includes? (mode-line-text (m-of "hi")) "(text)")))
  (test "a .blsp buffer shows (brood)"
    (is (includes? (mode-line-text (ed-init (make-buffer "(+ 1 2)" "x.blsp" "x.blsp")))
          "(brood)"))))

;; ---- special-mode: the shared read-only + no-gutter base for generated buffers -
(describe "editor special-mode base (read-only listings hide the line-number gutter)"
  (defn typed (type) (cur (ed-show-named (m-of "") "*x*" "one\ntwo" type)))
  (test "every special buffer type hides the gutter (no toggle needed)"
    (is (not (ed-gutter-shown? (typed :git-status) {})))
    (is (not (ed-gutter-shown? (typed :git-diff) {})))
    (is (not (ed-gutter-shown? (typed :git-log) {})))
    (is (not (ed-gutter-shown? (typed :dired) {})))
    (is (not (ed-gutter-shown? (typed :occur) {})))
    (is (not (ed-gutter-shown? (typed :process-menu) {}))))
  (test "special-mode's :activate hook makes the buffer read-only"
    (is (read-only? (typed :git-status)))
    (is (read-only? (typed :process-menu))))
  (test "a plain text buffer still shows the gutter (special-mode changes nothing global)"
    (is (ed-gutter-shown? (cur (m-of "hi")) {})))
  (test "C-x l still forces the gutter on for a special buffer (explicit pane override wins)"
    (is (ed-gutter-shown? (typed :git-status) {:payload {:line-numbers true}})))
  (test "*git-commit* is editable yet still hides the gutter (its own :no-line-numbers)"
    (is (not (ed-gutter-shown? (typed :git-commit) {})))
    (refute (read-only? (typed :git-commit)))))

(describe "welcome-mode (the startup scratch's clickable tutorial link)"
  (test "the link line resolves a :line-loc (pointer/hover affordance); others don't"
    (let (b (editor/layers/set-buffer-type (make-buffer "hello\n\n➜ New? Click here: the interactive Brood tutorial · C-h t\n")
              :welcome))
      (is (nil? (modes/welcome-line-loc b 0)))
      (is (not (nil? (modes/welcome-line-loc b 2))))))
  (test "clicking the link line opens the tutorial; clicking elsewhere is inert"
    (let (raw (editor/layers/set-buffer-type (make-buffer "hello\n\n➜ the interactive Brood tutorial · C-h t\n")
                :welcome)
          m (model/ed-init raw)
          off-link (model/ed-set-buf m (editor/buffer/goto-char (model/ed-current-buf m) 2))
          on-link (model/ed-set-buf m (editor/buffer/goto-char (model/ed-current-buf m) 10)))
      (assert= (commands/cmd-welcome-tutorial off-link :mouse) off-link)
      (is (not (nil? (model/ed-buffer-index-by-name (commands/cmd-welcome-tutorial on-link :mouse)
                       "*Tutorial*"))))))
  (test "the link line gets the link face"
    (let (spans (modes/welcome-fontify "plain\n➜ the interactive Brood tutorial\n"))
      (assert= (count spans) 1))))
