;; Editor tests (split from the original monolithic main_test.blsp by concern).
;; Every split file keeps the `main-test` module name, so a helper defined in any
;; file is visible to every test body at run time (test bodies are lazy thunks the
;; runner evaluates only after all files load into the shared image). The common
;; model helpers below are repeated in each file so a standalone `nest check` of a
;; single file still resolves them.
(defmodule modes-test
  (:use diagcheck) ; ed-refresh-diagnostics / ed-launch-diag / ed-apply-diag / ed-run-diag
  (:use eldoc) ; ed-cache-eldoc / ed-launch-eldoc / ed-apply-eldoc
  (:use model)
  (:use-internals input)
  (:use-internals view) ; ed-diag-notes — the per-viewport read the index exists for
  (:use pool)
  (:use commands)
  (:use-internals panes)
  (:use complete-at-point)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn type-str (m s) (press m (string/->list s)))

;; brood-mode: a .blsp buffer stacks structural sexp nav (C-M-*) on top of
;; text-mode; the trigger is the mode's :file-pattern regex ("\.blsp$").
(describe "editor brood-mode (.blsp files)"
  (defn blsp-model (text) (ed-init (make-buffer text "x.blsp" "x.blsp")))

  (test "C-M-f navigates structurally over a whole form in a .blsp buffer"
    (assert= (buffer-point (cur (ed-update (blsp-model "(+ 1 2)") :ctrl-meta-f 80 24))) 7))

  (test "C-M-- C-M-f runs backward-sexp (negative arg via the C-M-- chord)"
    ;; From end of "(+ 1 2) (a)" the negative arg flips C-M-f to its inverse (backward),
    ;; landing at the start of the last form "(a)" (8).
    (let (m-end (ed-init (goto-char (make-buffer "(+ 1 2) (a)" "x.blsp" "x.blsp") 11)))
      (assert= (buffer-point (cur (press m-end [(keyword "ctrl-meta--") :ctrl-meta-f]))) 8)))

  (test "C-M-SPC (mark-sexp) marks the next sexp, leaving point — and extends on repeat"
    (let (m1 (cmd-mark-sexp (blsp-cm "(+ 1) (a)" 0) nil)
          m2 (cmd-mark-sexp (assoc m1 :last-command 'commands/cmd-mark-sexp) nil))
      (assert= (buffer-point (cur m1)) 0) ; point stays put
      (assert= (buffer-mark (cur m1)) 5) ; mark at end of "(+ 1)"
      (assert= (buffer-mark (cur m2)) 9))) ; repeat extends over " (a)"
  (test "C-M-d / C-M-u descend into and back out of a list"
    (let (down (ed-update (blsp-model "(a b)") :ctrl-meta-d 80 24))
      ; into the list
      (assert= (buffer-point (cur down)) 1)
      (assert= (buffer-point (cur (ed-update down :ctrl-meta-u 80 24))) 0))) ; back out
  (test "text-mode bindings still work in a .blsp buffer (brood stacks on text)"
    (assert= (buffer-text (cur (press (blsp-model "ac") [:right "b"]))) "abc"))

  (test "a non-.blsp buffer has no structural nav (C-M-f unbound → no-op)"
    (assert= (buffer-point (cur (ed-update (m-of "(+ 1 2)") :ctrl-meta-f 80 24))) 0))

  (test "the trigger is an anchored regex — x.blsp.txt is NOT brood-mode"
    (let (m (ed-update (ed-init (make-buffer "(+ 1 2)" "x.blsp.txt" "x.blsp.txt"))
              :ctrl-meta-f 80 24))
      (assert= (buffer-point (cur m)) 0))))

;; paredit-style structural editing (brood-mode): the C-)/C-}/M-r/C-M-s/C-k chords
;; over `std/sexp`'s pure edits. `blsp-cm` makes a .blsp model with point at `p`.
(describe "editor brood-mode structural editing (paredit)"
  (defn edit (text p key) (buffer-text (cur (ed-update (blsp-cm text p) key 80 24))))

  (test "C-) slurps the next form in; C-} barfs the last out (inverses)"
    (assert= (edit "(foo) bar" 2 (keyword "ctrl-)")) "(foo bar)")
    (assert= (edit "(foo bar)" 2 (keyword "ctrl-}")) "(foo) bar"))
  (test "M-r raises the form at point, replacing the enclosing list"
    (assert= (edit "(a (b c) d)" 6 :alt-r) "(a c d)")) ; point on c
  (test "C-M-s splices the enclosing list's contents up a level"
    (assert= (edit "(a (b) c)" 4 :ctrl-meta-s) "(a b c)"))
  (test "C-k is structure-aware in brood-mode — won't kill past the close"
    (assert= (edit "(foo) bar" 1 :ctrl-k) "() bar"))
  (test "C-k stays plain kill-line in a non-.blsp buffer (breaks parens)"
    (let (m (ed-init (goto-char (make-buffer "(foo) bar") 1)))
      (assert= (buffer-text (cur (ed-update m :ctrl-k 80 24))) "("))))

;; The rest of Emacs' sexp/list family, on the shared `prog-mode-layer` (so a
;; tree-sitter mode inherits the same keys): the LIST motions that step over atom
;; siblings, end-of-defun, the structural kills, transpose and whole-form reindent.
(describe "editor structural navigation — the list / defun / kill family"
  (defn pt-at (text p key) (buffer-point (cur (ed-update (blsp-cm text p) key 80 24))))
  (defn txt-at (text p key) (buffer-text (cur (ed-update (blsp-cm text p) key 80 24))))

  (test "C-M-n / C-M-p move over whole LISTS, stepping past the atom siblings"
    ;; "(defn f (x) 1)" — the outer list's children are `defn` [1,5), `f` [6,7),
    ;; `(x)` [8,11) and `1` [12,13). C-M-f would stop at each; C-M-n stops only at `(x)`.
    (assert= (pt-at "(defn f (x) 1)" 1 :ctrl-meta-n) 11)
    (assert= (pt-at "(defn f (x) 1)" 11 :ctrl-meta-p) 8)
    ; no further list → no-op
    (assert= (pt-at "(defn f (x) 1)" 11 :ctrl-meta-n) 11))
  (test "C-M-e ends the enclosing defun — the mirror of C-M-a"
    (assert= (pt-at "(defn f (x)\n  (+ x 1))" 15 :ctrl-meta-e) 22)
    (assert= (pt-at "(defn f (x)\n  (+ x 1))" 15 :ctrl-meta-a) 0))
  (test "up-list leaves the enclosing list FORWARD (C-M-u's mirror; M-x only, as in Emacs)"
    ;; "(a (b) c)" — point 4 is inside `(b)` [3,6), so up-list lands just past its `)`
    (assert= (buffer-point (cur (cmd-up-list (blsp-cm "(a (b) c)" 4) nil))) 6)
    (assert= (buffer-point (cur (cmd-backward-up-list (blsp-cm "(a (b) c)" 4) nil))) 3))
  (test "C-M-k kills the whole sexp after point — across lines, unlike paredit's C-k"
    (assert= (txt-at "(a\n b) c" 0 :ctrl-meta-k) " c")
    ; paredit C-k stops at the line end and keeps the parens balanced
    (assert= (txt-at "(a\n b) c" 1 :ctrl-k) "(\n b) c"))
  (test "C-M-DEL kills the sexp BEFORE point"
    (assert= (txt-at "(a) (b)" 3 (keyword "ctrl-meta-backspace")) " (b)"))
  (test "C-M-t transposes the sexps either side of point"
    (assert= (txt-at "(a b)" 2 :ctrl-meta-t) "(b a)")
    ; whole lists move as units
    (assert= (txt-at "((a b) (c d))" 6 :ctrl-meta-t) "((c d) (a b))"))
  (test "C-M-q reindents every line of the form after point"
    ;; the body line starts at column 0; the brood indenter puts it at the body indent
    (let (out (txt-at "(defn f ()\n1)" 0 :ctrl-meta-q))
      (is (includes? out "\n  1)"))))
  (test "the new motions are no-ops in a plain (non-prog) buffer — the keys are mode-local"
    (assert= (buffer-point (cur (ed-update (m-of "(a (b) c)") :ctrl-meta-n 80 24))) 0)
    (assert= (buffer-point (cur (ed-update (m-of "(a (b) c)") :ctrl-meta-e 80 24))) 0)))

;; ---- brood-mode REPL-style services (highlight / brackets / eldoc / completion)
;; The view/completion stay language-agnostic: they ask the buffer's mode for
;; :fontify / :bracket-match / :eldoc / :complete-at via `ed-mode-service`, and
;; brood-mode supplies brood implementations over `std/highlight.blsp`. A `.blsp`
;; buffer thus gains the same live feedback the REPL editor has.

;; A model whose current buffer is a brood-mode (.blsp) buffer of `text`, point at `p`.
(defn blsp-cm (text p)
  (let (m (ed-init (make-buffer text "x.blsp" "x.blsp")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))
;; A model whose current buffer is a markdown-mode (.md) buffer of `text`, point at `p`.
(defn md-cm (text p)
  (let (m (ed-init (make-buffer text "x.md" "x.md")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))
;; The :text ops of a frame whose drawn string satisfies `pred`.
(defn text-ops-where (f pred)
  (seq/filter f (fn (op) (and (= (first op) :text) (pred (nth op 3 ""))))))

(describe "editor markdown-mode: a second language mode"
  ;; The editor is language-agnostic: a `.md` buffer gets markdown-mode purely by the
  ;; layer registration in `modes`, with `lex-markdown`'s `markdown-spans` as its
  ;; `:fontify` service — no view/dispatch change. Proves the toolkit hosts a second
  ;; language the same way it hosts brood.
  (test "a .md buffer is in markdown-mode"
    (assert= (ed-buf-mode-name (cur (md-cm "# Title" 0))) "markdown"))
  (test "a .md heading is syntax-coloured — its text carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (md-cm "# Title" 0) 80 24)
                (fn (s) (includes? s "Title"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "the same text in a plain (non-md) buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "# Title") 80 24)
                (fn (s) (includes? s "Title"))))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (nil? (nth op 4 nil)))))))

  ;; The restart is what keeps typing in a long document from re-lexing the 200-line
  ;; lead-in above the band on every key: the band's own first line, unless a fence above
  ;; it is still open.
  (test "the restart is the line itself, or the fence still open above it"
    (let (src "prose\n```\ncode\n```\nmore\n```\nopen\n")
      (assert= (lex-markdown/markdown-fontify-restart src 0) 0)
      (assert= (lex-markdown/markdown-fontify-restart src (index-of src "code")) 6)
      (assert= (lex-markdown/markdown-fontify-restart src (index-of src "more"))
        (index-of src "more"))
      (assert= (lex-markdown/markdown-fontify-restart src (index-of src "open"))
        (index-of src "```\nopen"))
      (is (not (nil? (ed-mode-service (cur (md-cm "x" 0)) :fontify-restart))))))

  (test "a windowed band colours as the whole document does, a fence open far above it"
    ;; prose, then a fence opening 40 lines up whose code runs through the band, then prose
    (let (text (str (string/join (map (range 20) (fn (i) (str "**p" i "**"))) "\n")
                 "\n```\n"
                 (string/join (map (range 120) (fn (i) (str "code *" i "*"))) "\n")
                 "\n```\n*after*\n")
          buf (cur (md-cm text 0))
          start (text/line->char (buffer-rope buf) 60)
          end (text/line->char (buffer-rope buf) 80)
          inside (fn (spans)
                   (seq/filter (into [] spans)
                     (fn (s) (and (>= (first s) start) (< (first s) end)))))
          windowed (ed-window-spans buf
                     (ed-mode-service buf :fontify)
                     (ed-mode-service buf :fontify-restart)
                     60
                     80))
      (is (not (empty? (inside windowed))))
      (assert= (inside windowed) (inside (lex-markdown/markdown-spans text)))))

  (test "an edit inside a cached band re-lexes it to what a fresh lex of its lines gives"
    (let (text (string/join (map (range 200) (fn (i) (str "line *" i "* `x`"))) "\n")
          m (ed-refresh-spans (md-cm text 0) 80 24)
          pane-path (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))
          before (get (:span-cache m) pane-path)
          edited (ed-refresh-spans (ed-set-buf m (insert (cur m) "**b** ")) 80 24)
          after (get (:span-cache edited) pane-path)
          buf (cur edited))
      (is (not (= (:spans before) (:spans after))))
      (assert= (:rope after) (buffer-rope buf))
      (assert= (:spans after)
        (ed-window-spans buf
          (ed-mode-service buf :fontify)
          (ed-mode-service buf :fontify-restart)
          (:blo after)
          (:bhi after))))))

;; A model whose current buffer is `text` opened under `file` (name = file), point 0.
(defn file-cm (text file)
  (ed-init (make-buffer text file file)))

;; A lexer mode with a `:line-lexer` colours its band from the lines it kept (`linecache`,
;; brood ADR-471) rather than from a lead-in above the band. Whatever was kept, the band must
;; be what a lex of the WHOLE document gives for its lines — at any depth, after any edit.
(describe "line-lexer modes: a band from the line cache is a whole-document lex"
  (sig lc-model (string string int -> any))
  (defn lc-model (text file top)
    ;; `text` opened as `file`, scrolled to line `top` with point a few lines below it
    (let (m (ed-init (make-buffer text file file))
          buf (ed-current-buf m))
      (ed-set-top (ed-set-buf m (goto-char buf (text/line->char (buffer-rope buf) (+ top 5)))) top)))

  (defn lc-at-line (m line)
    ;; point moved to the start of `line`, the scroll left where it was
    (ed-set-buf m (goto-char (cur m) (text/line->char (buffer-rope (cur m)) line))))

  (defn lc-entry (m)
    (get (:span-cache m) (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))))

  (defn lc-in (spans rope blo bhi)
    ;; the spans starting on lines [blo, bhi), as a vector; a zero-width one (an empty line
    ;; inside a fence) paints nothing, and the whole-document lex leaves out the last one
    (let (lo (text/line->char rope blo)
          hi (if (>= bhi (text/line-count rope)) (text/length rope) (text/line->char rope bhi)))
      (into []
        (seq/filter (into [] spans)
          (fn (span) (let ([s e _] span) (and (< s e) (>= s lo) (< s hi))))))))

  (defn lc-check (m whole)
    ;; refresh the bands, assert the selected pane's is a line band equal to `whole` (the
    ;; mode's whole-document lexer) over its lines; answer the refreshed model
    (let (refreshed (ed-refresh-spans m 80 24)
          entry (lc-entry refreshed)
          buf (cur refreshed)
          rope (buffer-rope buf)
          band (lc-in (:spans entry) rope (:blo entry) (:bhi entry)))
      (is (:line? entry))
      (assert= (:rope entry) rope)
      (assert= band (lc-in (whole (buffer-text buf)) rope (:blo entry) (:bhi entry)))
      refreshed))

  (def lc-markdown
    (str (string/join (map (range 20) (fn (i) (str "**p" i "** `c`"))) "\n")
      "\n```\n"
      (string/join (map (range 120) (fn (i) (str "code *" i "*"))) "\n")
      "\n```\n"
      (string/join (map (range 60) (fn (i) (str "# h" i "\n- *after* " i))) "\n")
      "\n"))

  (test "markdown: a fence opened far above the band colours it as code"
    (let (m (lc-check (lc-model lc-markdown "x.md" 80) lex-markdown/markdown-spans))
      (is (> (count (:spans (lc-entry m))) 0))))

  (test "markdown: an edit inside the fence, a line inserted and a line deleted"
    (let (m (lc-check (lc-model lc-markdown "x.md" 60) lex-markdown/markdown-spans)
          typed (lc-check (press m ["*" "x" "*"]) lex-markdown/markdown-spans)
          split (lc-check (press typed [:enter :enter]) lex-markdown/markdown-spans)
          joined (lc-check (press split [:backspace :backspace :backspace])
                   lex-markdown/markdown-spans))
      (is (not (= (buffer-text (cur joined)) lc-markdown)))))

  (test "markdown: a fence opened ABOVE the band recolours it, and closing it again restores it"
    (let (m (lc-check (lc-model lc-markdown "x.md" 150) lex-markdown/markdown-spans)
          opened (lc-check (ed-set-buf m (insert (cur (lc-at-line m 3)) "```\n"))
                   lex-markdown/markdown-spans)
          closed (lc-check (ed-set-buf opened (delete-char (cur (lc-at-line opened 3)) 4))
                   lex-markdown/markdown-spans))
      ;; the fence a hundred lines down now OPENS one, and the band below it is code
      (is (not (= (:spans (lc-entry opened)) (:spans (lc-entry m)))))
      (assert= (buffer-text (cur closed)) lc-markdown)
      (assert= (:spans (lc-entry closed)) (:spans (lc-entry m)))))

  (test "markdown: an edit below the band rebuilds it — a fence coloured as its language runs past it"
    ;; the old entry is tagged: a band re-lexed is a fresh entry without the tag. A line
    ;; lexer alone would keep it (nothing below a line reaches it), but markdown's
    ;; `:line-band-pass` colours a whole fence, and a fence may end below the band
    (let (m (lc-check (lc-model lc-markdown "x.md" 10) lex-markdown/markdown-spans)
          path (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))
          tagged (map/assoc-in m [:span-cache path :kept] true)
          below (ed-refresh-spans (ed-set-buf tagged
                                    (insert (cur (lc-at-line tagged 230)) "*more*"))
                  80 24)
          after (lc-entry below))
      (is (not (:kept after)))
      (assert= (:rope after) (buffer-rope (cur below)))
      (lc-check below lex-markdown/markdown-spans)
      ;; …and an edit INSIDE it does not
      (is (not (:kept (lc-entry (lc-check (press (lc-at-line below 15) ["x"])
                                  lex-markdown/markdown-spans)))))))

  ;; Whether an edit is below the band is read from the buffer's splice log, not by comparing
  ;; the two ropes: `aaaa` -> `aaaaa` typed at 0 is a change AT 0, which only the log knows
  ;; (a comparison finds the first difference at 4). The comparison is the fallback for a
  ;; change the log cannot account for.
  (test "what an edit changed comes from the splice log, a comparison only without one"
    (let (buf (make-buffer "aaaa\nbbbb")
          old (buffer-rope buf)
          typed (insert buf "a")
          replaced (assoc buf :rope (text/from-string "aaaa\nbbbc")))
      (assert= (ed-edit-range typed old) [0 0 1])
      (is (nil? (ed-edit-range buf old)))
      (assert= (ed-edit-range replaced old) [8 9 9])))
  (test "the splice cover spans every splice, in the coordinates of each side"
    (assert= (ed-splices-cover [[2 4 "xyz"]]) [2 4 5])
    (assert= (ed-splices-cover [[2 4 "xyz"] [0 0 "a"]]) [0 4 6])
    (assert= (ed-splices-cover [[0 0 "ab"] [10 12 ""]]) [0 10 10])
    (is (nil? (ed-splices-cover []))))

  (def lc-org
    (str "#+TITLE: Notes\n* TODO first :work:\n"
      "#+BEGIN_SRC sh\n"
      (string/join (map (range 100) (fn (i) (str "echo " i " # *not* org"))) "\n")
      "\n#+END_SRC\n"
      (string/join (map (range 50) (fn (i) (str "** DONE h" i "\n- [X] *item* " i))) "\n")
      "\n"))

  (test "org: a #+BEGIN_ block opened far above the band, edited inside and removed"
    (let (m (lc-check (lc-model lc-org "notes.org" 60) org/org-spans)
          typed (lc-check (press m ["*" "b" "*" :enter]) org/org-spans)
          ;; the `#+BEGIN_SRC` line itself is line 2: drop it, and the block's lines are org
          unblocked (lc-check (ed-set-buf typed (delete-char (cur (lc-at-line typed 2)) 15))
                      org/org-spans))
      (is (not (includes? (buffer-text (cur unblocked)) "BEGIN_SRC")))))

  ;; JSON is lexed as the stand-in for its parsed mode, and past `languages/json-lexer-above`
  (test "json: a stateless line lexer, edited and with lines inserted"
    (let (text (str "{\n"
                 (string/join (map (range 150) (fn (i) (str "  \"k" i "\": [" i ", true, \"s\"],")))
                   "\n")
                 "\n}\n")
          m (lc-check (binding (*grammar-ready?* (fn (lang) false)) (lc-model text "x.json" 70))
              lex-configs/json-spans)
          typed (lc-check (press m ["\"" "z" "\"" ":" " " "1" :enter]) lex-configs/json-spans))
      (is (contains? (:line-caches typed) 0))))

  ;; The commit message's subject is the first line that is neither `#` commentary nor
  ;; blank: its line lexer carries "seen the subject yet?" down, so emptying the subject
  ;; makes the NEXT text line the subject, and the band below still knows it is body.
  (def lc-commit
    (str "# a hook's note\n\nfeat(x): subject\n\n"
      (string/join (map (range 100) (fn (i) (str "body " i " fix: not a prefix"))) "\n")
      "\n"
      (string/join (map (range 40) (fn (i) (str "# git commentary " i))) "\n")
      "\n"))

  (test "gitcommit: the subject above the band, emptied and retyped"
    (let (m (lc-check (lc-model lc-commit "COMMIT_EDITMSG" 0) lex-configs/gitcommit-spans)
          spans (:spans (lc-entry m))
          doc (editor/face/face :syntax/doc)
          deep (lc-check (lc-model lc-commit "COMMIT_EDITMSG" 90) lex-configs/gitcommit-spans)
          subject-start (text/line->char (buffer-rope (cur m)) 2)
          emptied (lc-check (ed-set-buf m (delete-char (cur (lc-at-line m 2)) 16))
                    lex-configs/gitcommit-spans)
          retyped (lc-check (press emptied ["f" "i" "x" ":" " " "y"]) lex-configs/gitcommit-spans))
      (is (:line? (lc-entry m)))
      ;; `feat(x):` is the keyword, the rest of the subject is `:doc`, and only the subject
      (is (any? spans (fn (span) (= span [(+ subject-start 8) (+ subject-start 16) doc]))))
      (assert= (count (seq/filter (into [] spans) (fn (span) (= (nth span 2) doc)))) 1)
      ;; with line 2 empty, `body 0` (line 4) is the subject now
      (is (any? (:spans (lc-entry emptied))
            (fn (span)
              (and (= (nth span 2) doc)
                (= (first span) (text/line->char (buffer-rope (cur emptied)) 4))))))
      (is (> (count (:spans (lc-entry deep))) 0))
      (is (contains? (:line-caches retyped) 0))))

  (test "a killed buffer's line cache goes, and the ones above it shift down"
    (let (m {:line-caches {0 :a 1 :b 2 :c}})
      (assert= (:line-caches (linecache/ed-drop-line-cache-slot m 1)) {0 :a 1 :c})
      (assert= (linecache/sweep-line-caches {0 :a 3 :d} 2) {0 :a}))))

(describe "editor env-mode / docker-mode: more language modes"
  ;; Two more fontify-only modes, registered the same way as markdown-mode — a `.env`
  ;; file and a Dockerfile get syntax colouring purely by their layer registration,
  ;; with lex-dotenv + lex-dockerfile supplying the :fontify span fns.
  (test "a .env buffer is in env-mode and its key is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "FOO=bar" ".env"))) "env")
    (let (ops (text-ops-where (ed-view (file-cm "FOO=bar" ".env") 80 24)
                (fn (s) (includes? s "FOO"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .env.local variant is also env-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "K=1" ".env.local"))) "env"))
  (test "a Dockerfile buffer is in docker-mode and FROM is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "FROM alpine" "Dockerfile"))) "docker")
    (let (ops (text-ops-where (ed-view (file-cm "FROM alpine" "Dockerfile") 80 24)
                (fn (s) (includes? s "FROM"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a *.dockerfile name is also docker-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "RUN x" "build.dockerfile"))) "docker"))
  (test "the same .env text in a plain buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "FOO=bar") 80 24) (fn (s) (includes? s "FOO"))))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (nil? (nth op 4 nil))))))))

(describe "editor ruby-mode / elixir-mode: tree-sitter language modes"
  ;; The proof of ROADMAP §C: a `.rb`/`.ex` buffer gets a non-Brood parser
  ;; (tree-sitter, via `std/editor/treesit`) yet plugs into the SAME mode-services
  ;; host — `:fontify` colours it and the `C-M-*` structural commands navigate it,
  ;; with no view/dispatch change. Modes are pure data (a face table + `:ts-lang`).
  (test "a .rb buffer is in ruby-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "def f\nend\n" "x.rb"))) "ruby"))
  (test "a Ruby keyword (def) is syntax-coloured — its chunk carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (file-cm "def f\nend\n" "x.rb") 80 24) (fn (s) (= s "def"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .ex buffer is in elixir-mode and a string literal is coloured"
    (assert= (ed-buf-mode-name (cur (file-cm "x = \"hi\"\n" "x.ex"))) "elixir")
    (let (ops (text-ops-where (ed-view (file-cm "x = \"hi\"\n" "x.ex") 80 24)
                (fn (s) (includes? s "hi"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a .exs script is also elixir-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "IO.puts(1)\n" "run.exs"))) "elixir"))
  (test "the same Ruby text in a plain buffer is NOT coloured"
    (let (ops (text-ops-where (ed-view (m-of "def f") 80 24) (fn (s) (includes? s "def"))))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (nil? (nth op 4 nil)))))))
  ;; structural navigation over the tree-sitter tree (same C-M-f command, dispatched
  ;; on the buffer's :ts-lang): from col 0 it moves over the first top-level form.
  (test "C-M-f navigates structurally in a .rb buffer (tree-sitter motion)"
    (let (m (ed-update (file-cm "def f\nend\nx = 1\n" "x.rb") :ctrl-meta-f 80 24))
      (is (> (buffer-point (cur m)) 0))))
  (test "C-M-f is a no-op in a plain buffer (no :ts-lang and not brood-mode)"
    (assert= (buffer-point (cur (ed-update (m-of "def f\nend") :ctrl-meta-f 80 24))) 0)))

;; ---- the windowed-fontify restart (elixir only, and why) ---------------------
;; Without a `:fontify-restart` a tree-sitter mode re-parses the whole windowed lead-in on
;; every keystroke — 245 lines for a 44-row viewport, five times what is on screen, 18 ms of
;; a 25 ms keystroke on a 10k-line file. Elixir cuts that at the previous column-0 line,
;; which is only safe where a heredoc is not open: measured against a WHOLE-FILE parse
;; (the only honest baseline — comparing against the windowed status quo made a broken
;; alternative look merely different), the restart is right everywhere the lead-in is.
;; Asks the MODE for its `:fontify-restart` rather than naming the function: which
;; function provides it is the language's business (Elixir gets a generated one from its
;; heredoc markers, Ruby writes its own), and a test that names the function breaks when
;; that changes — as it did the moment `deflanguage` started generating them.
(defn elixir-restart-svc (src pos)
  ((model/ed-mode-service (cur (file-cm "x = 1\n" "x.ex")) :fontify-restart) src pos))

(describe "elixir-mode's fontify restart"
  (test "cuts the lead-in at the previous top-level form"
    (let (src "defmodule A do\n  def a, do: 1\nend\ndefmodule B do\n  def b, do: 2\nend\n"
          pos (index-of src "defmodule B"))
      (assert= (elixir-restart-svc src pos) pos)))

  ;; the case that makes the naive version wrong: prose inside @moduledoc that looks like
  ;; code. Restarting there colours the prose as Elixir; the guard declines instead.
  (test "declines inside an open heredoc, keeping the full window"
    (let (src "defmodule A do\n  @moduledoc \"\"\"\ndef looks_like_code(x) do\nstill prose\n"
          pos (index-of src "still prose"))
      (assert= (elixir-restart-svc src pos) 0)))

  (test "accepts again below a closed heredoc"
    (let (src "defmodule A do\n  @moduledoc \"\"\"\nprose\n  \"\"\"\nend\ndefmodule B do\n"
          pos (index-of src "defmodule B"))
      (assert= (elixir-restart-svc src pos) pos)))

  (test "both tree-sitter modes have one"
    (is (not (nil? (model/ed-mode-service (cur (file-cm "def f\nend\n" "x.rb")) :fontify-restart))))
    (is (not (nil? (model/ed-mode-service (cur (file-cm "x = 1\n" "x.ex")) :fontify-restart))))))

;; Ruby cannot count paired markers the way Elixir can — `<<~EOS` ends at a line holding
;; whatever identifier the opener named, so there is nothing to pair. It asks a weaker
;; question with a safe answer instead: is ANY heredoc opener or `=begin` above the
;; candidate? If so it declines and keeps the full lead-in, which is what it did before.
(describe "ruby-mode's fontify restart"
  (test "cuts at the previous top-level form"
    (let (src "class A\n  def a; 1; end\nend\nclass B\n  def b; 2; end\nend\n"
          pos (index-of src "class B"))
      (assert= (languages/ruby-fontify-restart src pos) pos)))

  (test "declines below a heredoc opener, in all its spellings"
    (fold ["<<~SQL" "<<-SQL" "<<SQL" "<<'SQL'" "<<\"SQL\""]
      nil
      (fn (_ opener)
        (let (src (str "x = " opener "\nSELECT 1\nSQL\nclass B\n")
              pos (index-of src "class B"))
          (do (assert= (languages/ruby-fontify-restart src pos) 0) nil)))))

  ;; `<<` is also Array#<< and left-shift; matching it bare would decline everywhere and
  ;; buy nothing, so an append must NOT look like a heredoc.
  (test "an ordinary append is not mistaken for a heredoc"
    (let (src "class A\n  xs << y\n  xs <<z\nend\nclass B\n"
          pos (index-of src "class B"))
      (assert= (languages/ruby-fontify-restart src pos) pos)))

  (test "declines below a =begin block comment"
    (let (src "=begin\nclass NotReal\n=end\nclass B\n"
          pos (index-of src "class B"))
      (assert= (languages/ruby-fontify-restart src pos) 0))))

;; ---- indentation in the tree-sitter modes -----------------------------------
;; The `:indent` service reaches these through the same seam brood-mode uses, so `TAB` and
;; the newline-and-indent commands work in a `.ex`/`.rb` buffer with no dispatch change. The
;; assertion worth making about an indenter is that it agrees with hand-written code: every
;; line of a real-looking module, re-indented from scratch, lands where it already is.
(describe "elixir-mode / ruby-mode indentation"
  ;; Returns `[want …]` and `[got …]` over the non-blank lines, so a mismatch names the line
  ;; and the column rather than answering false.
  (defn indent-cols (m text)
    (let (buf (cur m)
          svc (model/ed-mode-service buf :indent)
          lines (string/split text "\n")
          rows (seq/filter (range (count lines))
                 (fn (i) (not (= (string/trim (nth lines i "")) ""))))
          bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1)))))
      [(into []
         (map rows
           (fn (i)
             (let (l (nth lines i "")) (- (string/length l) (string/length (string/triml l)))))))
        (into [] (map rows (fn (i) (svc text (bol-of i)))))]))

  (test "a .ex buffer has an indent service, and it agrees with real Elixir"
    (let (text "defmodule App.Worker do\n  use GenServer\n\n  def handle_call({:add, n}, _from, state) do\n    case state do\n      %{count: c} ->\n        {:reply, c + n, state}\n\n      _ ->\n        {:noreply, state}\n    end\n  end\nend\n"
          m (file-cm text "worker.ex"))
      (refute (nil? (model/ed-mode-service (cur m) :indent)))
      (let ([want got] (indent-cols m text))
        (is (> (count want) 8)) ; the sample is worth asserting about
        (assert= got want))))

  (test "a .rb buffer likewise, and its blocks begin somewhere else entirely"
    (let (text "class Worker\n  def call(n)\n    if n > 0\n      n + 1\n    else\n      0\n    end\n  end\nend\n"
          m (file-cm text "worker.rb"))
      (refute (nil? (model/ed-mode-service (cur m) :indent)))
      (let ([want got] (indent-cols m text))
        (is (> (count want) 8))
        (assert= got want))))

  ;; the service must answer a column for anything, including text mid-typing
  (test "half-written source still yields a column rather than raising"
    (let (m (file-cm "defmodule A do\n  def f(\n" "x.ex"))
      (is (int? (commands/ed-indent-target (cur m)))))))

;; ---- python-mode: a language nothing was built with -------------------------
;; The proof that a language is a data entry and not a build. Brood ships no Python grammar;
;; bedit loads `~/.config/bedit/grammars/libtree-sitter-python.so` at startup, and the mode
;; below is three definitions in `src/modes.blsp`. These tests need that grammar installed,
;; so they SKIP without it rather than fail — the same shape brood's own grammar tests use.
(def py-grammar? (file/exists? (grammars/ts-grammar-path :python)))

(describe "python-mode registers whether or not a grammar is installed"
  (test "a .py buffer is in python-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "x = 1\n" "a.py"))) "python"))
  (test "its grammar path is under the user's config, not the install"
    (is (includes? (grammars/ts-grammar-path :python) "grammars/libtree-sitter-python.so"))))

(when py-grammar?
  (describe "python, parsed by a grammar loaded at runtime"
    ;; The load happens on the STARTUP path (`main`), never at module load time — a grammar
    ;; registers in the runtime, and an image restores a module's bindings without replaying
    ;; the side effects that produced them. So a test has to ask for it, exactly as startup
    ;; does; that this line is necessary IS the property.
    (def py-loaded (grammars/load-user-grammars))

    (test "the loader finds the grammar in the user's directory"
      (is (includes? py-loaded :python)))
    (def py-src
      "class Worker:\n    def __init__(self, n):\n        self.n = n  # a note\n\n    def run(self, xs):\n        total = 0\n        for x in xs:\n            if x > 0:\n                total += x\n            else:\n                total -= 1\n        return \"done\"\n")

    (test "it colours — a comment and a string are faced"
      (let (spans (languages/python-fontify py-src))
        (is (> (count spans) 3))
        (is (seq/find spans (fn (s) (= (nth s 2) (editor/face/face :syntax/comment)))))
        (is (seq/find spans (fn (s) (= (nth s 2) (editor/face/face :syntax/string)))))))

    ;; Python needs no dedent set: every level is the same `:block`, and `else:` sits in the
    ;; `if`'s own chain rather than inside the arm above it.
    (test "it indents — every line lands where hand-written Python already has it"
      (let (buf (cur (file-cm py-src "w.py"))
            svc (model/ed-mode-service buf :indent)
            lines (string/split py-src "\n")
            rows (seq/filter (range (count lines))
                   (fn (i) (not (= (string/trim (nth lines i "")) ""))))
            bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1))))
            want (into []
                   (map rows
                     (fn (i)
                       (let (l (nth lines i ""))
                         (- (string/length l) (string/length (string/triml l)))))))
            got (into [] (map rows (fn (i) (svc py-src (bol-of i))))))
        (is (> (count want) 8))
        (assert= got want)))))

;; ---- rust-mode: Python's case again ---------------------------------------------
;; `libtree-sitter-rust.so` in the user's grammar directory; SKIPS without it.
(def rs-grammar? (file/exists? (grammars/ts-grammar-path :rust)))

(describe "rust-mode registers whether or not a grammar is installed"
  (test "a .rs buffer is in rust-mode"
    (assert= (ed-buf-mode-name (cur (file-cm "fn main() {}\n" "main.rs"))) "rust"))
  (test "it formats with rustfmt"
    (assert= (first (model/ed-mode-service (cur (file-cm "" "main.rs")) :format-command)) "rustfmt")))

(describe "rust's fontify restart"
  (test "the previous column-0 item line"
    (let (src "fn a() {\n    1\n}\n\nfn b() {\n    2\n}\n")
      (assert= (languages/rust-restart src (index-of src "    2"))
        (index-of src "fn b"))))
  (test "a column-0 line inside a multi-line string is passed over for the item above it"
    (let (src "const USAGE: &str = \"usage:\nbedit FILE\n\";\n")
      (assert= (languages/rust-restart src (index-of src "\";")) 0)
      (assert= (languages/rust-restart src (index-of src "bedit")) 0)))
  (test "a raw string opened above declines the cut"
    (let (src "const A: &str = r#\"\nfn x() {}\n\"#;\n\nfn b() {\n    2\n}\n")
      (assert= (languages/rust-restart src (index-of src "    2")) 0)))
  (test "a block comment opened above declines the cut"
    (let (src "/*\nfn x() {}\n*/\nfn b() {\n    2\n}\n")
      (assert= (languages/rust-restart src (index-of src "    2")) 0)))
  (test "an identifier ending in r before a string is not a raw string"
    (let (src "fn a() { bar(\"x\") }\n\nfn b() {\n    2\n}\n")
      (assert= (languages/rust-restart src (index-of src "    2"))
        (index-of src "fn b")))))

(when rs-grammar?
  (describe "rust, parsed by a grammar loaded at runtime"
    (def rs-loaded (grammars/load-user-grammars))

    (test "the loader finds the grammar in the user's directory"
      (is (includes? rs-loaded :rust)))

    ;; rustfmt-clean (`rustfmt --edition 2024 --check`)
    (def rs-src
      "use std::collections::{HashMap, HashSet};\n\n// A counter.\n#[derive(Debug)]\npub struct Counter<'a> {\n    name: &'a str,\n    seen: HashMap<String, usize>,\n}\n\nimpl<'a> Counter<'a> {\n    pub fn new(name: &'a str) -> Self {\n        Self {\n            name,\n            seen: HashMap::new(),\n        }\n    }\n\n    /// Count each word.\n    pub fn add(&mut self, words: &[&str]) -> usize {\n        let mut total = 0;\n        for word in words {\n            match word.len() {\n                0 => continue,\n                n if n > 10 => {\n                    total += 2;\n                }\n                _ => total += 1,\n            }\n            *self.seen.entry(word.to_string()).or_insert(0) += 1;\n        }\n        if total > 0 {\n            println!(\"{}: {}\", self.name, total);\n        } else {\n            eprintln!(\"nothing\");\n        }\n        words.iter().for_each(|word| {\n            let _ = HashSet::<&str>::from([*word]);\n        });\n        total\n    }\n}\n\nenum Shape {\n    Circle(f64),\n    Rect { w: f64, h: f64 },\n}\n")

    (test "it colours — a comment, a string, a number and a keyword are faced"
      (let (spans (languages/rust-fontify rs-src)
            faced? (fn (f) (seq/find spans (fn (s) (= (nth s 2) (editor/face/face f))))))
        (is (faced? :syntax/comment))
        (is (faced? :syntax/string))
        (is (faced? :syntax/number))
        (is (faced? :syntax/keyword))))

    (test "it indents — every line lands where rustfmt put it"
      (let (buf (cur (file-cm rs-src "c.rs"))
            svc (model/ed-mode-service buf :indent)
            lines (string/split rs-src "\n")
            rows (seq/filter (range (count lines))
                   (fn (i) (not (= (string/trim (nth lines i "")) ""))))
            bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1))))
            want (into []
                   (map rows
                     (fn (i)
                       (let (l (nth lines i ""))
                         (- (string/length l) (string/length (string/triml l)))))))
            got (into [] (map rows (fn (i) (svc rs-src (bol-of i))))))
        (is (> (count want) 30))
        (assert= got want)))

    ;; the `:definitions` it declares: a `fn` in an `impl` is a definition of its own, so
    ;; C-M-a stops there rather than at the edge of the whole `impl`
    (test "C-M-a inside a method lands on its fn, not the impl"
      (let (inside (index-of rs-src "let mut total"))
        (assert= (editor/treesit/point-defun-start rs-src :rust inside)
          (index-of rs-src "pub fn add"))
        (assert= (editor/treesit/point-defun-start rs-src :rust (index-of rs-src "Circle"))
          (index-of rs-src "enum Shape"))))))

(when py-grammar?
  (test "python declares its definitions: C-M-a inside a method lands on its def"
    (let (src "class W:\n    def run(self):\n        return 1\n")
      (assert= (editor/treesit/point-defun-start src :python (index-of src "return"))
        (index-of src "def run")))))

;; ---- the brace languages: JavaScript, TypeScript, TSX, Go, C -----------------------
;; Each mode registers whatever grammars are installed; the parsed half SKIPS a language
;; whose `libtree-sitter-<lang>.so` is not in the user's grammar directory.
;; loaded here, at file load, so the `when`s below see what is installed
(grammars/load-user-grammars)
(purge-stale-temp "bedit-grammar-")

(describe "the brace languages register whether or not a grammar is installed"
  (test "each extension opens in its mode, with its formatter"
    (doseq (case [["app.js" "javascript" "prettier"]
                   ["app.mjs" "javascript" "prettier"]
                   ["app.ts" "typescript" "prettier"]
                   ["app.tsx" "tsx" "prettier"]
                   ["main.go" "go" "gofmt"]
                   ["main.c" "c" "clang-format"]
                   ["main.h" "c" "clang-format"]])
      (let ([file mode formatter] case
            buf (cur (file-cm "" file)))
        (assert= (ed-buf-mode-name buf) mode)
        (assert= (first (model/ed-mode-service buf :format-command)) formatter))))
  (test "each declares where its grammar lives, for M-x grammar-install"
    (assert= (grammars/grammar-source :go) "https://github.com/tree-sitter/tree-sitter-go")
    (assert= (grammars/grammar-source :tsx)
      {:url "https://github.com/tree-sitter/tree-sitter-typescript" :subdir "tsx"})))

(describe "the shared column-0 restart"
  (test "the previous column-0 line that starts an item"
    (let (src "function a() {\n  1;\n}\n\nfunction b() {\n  2;\n}\n")
      (assert= (languages/javascript-restart src (index-of src "  2")) (index-of src "function b"))))
  (test "a template string or block comment opened above declines the cut"
    (let (src "const s = `\nfunction x() {}\n`;\nfunction b() {\n  2;\n}\n")
      (assert= (languages/javascript-restart src (index-of src "  2")) 0))
    (let (src "/*\nint x;\n*/\nint b(void) {\n    return 2;\n}\n")
      (assert= (languages/c-restart src (index-of src "    return")) 0)))
  (test "go's raw string opened above declines the cut too"
    (let (src "var s = `\nfunc x() {}\n`\n\nfunc b() {\n\treturn\n}\n")
      (assert= (languages/go-restart src (index-of src "\treturn")) 0))))

;; Go indents with tabs: the indenter answers a column, and the mode writes it as tabs
(describe "a mode that indents with tabs writes tabs"
  (test "RET inside a Go function indents the new line with a tab"
    (let (m (file-cm "func main() {\n}\n" "main.go")
          at-brace (ed-set-buf m (goto-char (cur m) (index-of "func main() {\n}\n" "\n")))
          entered (press at-brace [:enter]))
      (is (string/starts-with? (buffer-text (cur entered)) "func main() {\n"))
      (when (grammars/grammar-loaded? :go)
        (assert= (buffer-text (cur entered)) "func main() {\n\t\n}\n"))))
  (test "a mode without the facet keeps spaces"
    (assert= (commands/ed-indentation (cur (file-cm "" "app.js")) 4) "    ")
    (assert= (commands/ed-indentation (cur (file-cm "" "main.go")) 12) "\t    ")))

(describe "grammar-install, without the network"
  (test "a language with no declared source is told how to build one"
    (let (m (grammars/grammar-install-start (m-of "") :no-such-language))
      (is (includes? (:echo m) "no known source"))))
  (test "a source with no parser.c reports why, and loads nothing"
    (let (empty-dir (temp-dir "bedit-grammar-")
          _ (file/mkdir empty-dir)
          _ (grammars/declare-grammar :bedit-test-language empty-dir)
          m (grammars/grammar-install-start (m-of "") :bedit-test-language))
      (is (includes? (:echo m) "has no src/parser.c"))
      (is (not (grammars/grammar-loaded? :bedit-test-language)))))
  (test "a file whose language has no grammar loaded says how to get one"
    (assert= (grammars/missing-note (make-buffer "" "x.txt" "x.txt")) "")
    (when (not (grammars/grammar-loaded? :go))
      (is (includes? (grammars/missing-note (cur (file-cm "" "main.go"))) "M-x grammar-install")))))

(defn indent-width (line)
  "The columns `line`'s leading whitespace spans, a tab reaching the next multiple of 8."
  (fold (string/split (string/substring line
                        0
                        (- (string/length line) (string/length (string/triml line))))
          "")
    0
    (fn (column c) (if (= c "\t") (* 8 (inc (math/quot column 8))) (inc column)))))

(defn indents-as-written (src file)
  "`[want got]`: each non-blank line's indentation in `src` beside the mode's answer for it."
  (let (buf (cur (file-cm src file))
        svc (model/ed-mode-service buf :indent)
        lines (string/split src "\n")
        rows (seq/filter (range (count lines)) (fn (i) (not (= (string/trim (nth lines i "")) ""))))
        bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1)))))
    [(into [] (map rows (fn (i) (indent-width (nth lines i "")))))
      (into [] (map rows (fn (i) (svc src (bol-of i)))))]))

(defn faced? (spans f)
  (seq/find spans (fn (s) (= (nth s 2) (editor/face/face f)))))

;; prettier-clean
(def js-src
  "import { a, b } from \"./x.js\";\n\n// Greets.\nexport function greet(name, options = {}) {\n  const parts = [\n    \"hello\",\n    `dear ${name}`,\n  ];\n  if (options.loud) {\n    return parts.join(\" \").toUpperCase();\n  }\n  switch (name) {\n    case \"x\":\n      return null;\n    default:\n      break;\n  }\n  return this.format(parts, 42, true);\n}\n\nclass Greeter {\n  greet() {\n    return greet(\"world\");\n  }\n}\n")

(when (grammars/grammar-loaded? :javascript)
  (describe "javascript, parsed"
    (test "it colours — a comment, a string, a number, a keyword"
      (let (spans (languages/javascript-fontify js-src))
        (is (faced? spans :syntax/comment))
        (is (faced? spans :syntax/string))
        (is (faced? spans :syntax/number))
        (is (faced? spans :syntax/keyword))))
    (test "it indents every line where prettier put it"
      (let ([want got] (indents-as-written js-src "app.js"))
        (assert= got want)))
    (test "C-M-a inside a method lands on the method"
      (assert= (editor/treesit/point-defun-start js-src
                 :javascript (index-of js-src "return greet"))
        (index-of js-src "greet() {")))))

(def tsx-src
  "interface Props {\n  title: string;\n}\n\nexport function App(props: Props) {\n  return (\n    <div className=\"app\">\n      <span>{props.title}</span>\n    </div>\n  );\n}\n")

(when (grammars/grammar-loaded? :tsx)
  (describe "tsx, parsed"
    (test "types colour, and a JSX closing tag leaves its element"
      (is (faced? (languages/tsx-fontify tsx-src) :syntax/special))
      (let ([want got] (indents-as-written tsx-src "app.tsx"))
        (assert= got want)))))

;; gofmt-clean
(def go-src
  "package main\n\nimport (\n\t\"fmt\"\n\t\"strings\"\n)\n\n// Point is a point.\ntype Point struct {\n\tX int\n\tY float64\n}\n\nfunc (p Point) Describe(name string) string {\n\tswitch name {\n\tcase \"x\":\n\t\treturn fmt.Sprintf(\"%d\", p.X)\n\tdefault:\n\t\treturn strings.Repeat(`raw`, 3)\n\t}\n}\n\nfunc main() {\n\tpoints := []Point{\n\t\t{X: 1, Y: 2.5},\n\t}\n\tfor _, p := range points {\n\t\tif p.X > 0 {\n\t\t\tfmt.Println(p.Describe(\"x\"), nil)\n\t\t}\n\t}\n}\n")

(when (grammars/grammar-loaded? :go)
  (describe "go, parsed"
    (test "it colours — a comment, a string, a number, a type"
      (let (spans (languages/go-fontify go-src))
        (is (faced? spans :syntax/comment))
        (is (faced? spans :syntax/string))
        (is (faced? spans :syntax/number))
        (is (faced? spans :syntax/special))))
    (test "it indents every line where gofmt put it — `case` at the switch's level"
      (let ([want got] (indents-as-written go-src "main.go"))
        (assert= got want)))
    (test "C-M-a inside a method lands on its func"
      (assert= (editor/treesit/point-defun-start go-src :go (index-of go-src "switch name"))
        (index-of go-src "func (p Point)")))))

(def c-src
  "#include <stdio.h>\n\nstruct point {\n    int x;\n    double y;\n};\n\nstatic int area(const struct point *p, int scale) {\n    int values[] = {\n        1,\n        2,\n    };\n    switch (scale) {\n    case 1:\n        return p->x;\n    default:\n        break;\n    }\n    if (p == NULL) {\n        printf(\"none %c\\n\", 'x');\n    }\n    return values[0] * 3;\n}\n")

(when (grammars/grammar-loaded? :c)
  (describe "c, parsed"
    (test "it colours — a string, a number, a type"
      (let (spans (languages/c-fontify c-src))
        (is (faced? spans :syntax/string))
        (is (faced? spans :syntax/number))
        (is (faced? spans :syntax/special))))
    (test "#include is a keyword, though the grammar leaves it anonymous"
      (assert= (first (languages/c-fontify c-src)) [0 8 (editor/face/face :syntax/keyword)]))
    (test "it indents every line, `case` at the switch's level"
      (let ([want got] (indents-as-written c-src "main.c"))
        (assert= got want)))
    (test "C-M-a inside a function lands on it"
      (assert= (editor/treesit/point-defun-start c-src :c (index-of c-src "switch (scale)"))
        (index-of c-src "static int area")))))

;; ---- a name coloured by where it sits (brood ADR-486) -------------------------------
;; A call's function is an `identifier` like any other; the face tables pick it out by the
;; field it fills. Each case: the source, the call's name, a definition's name, and an
;; argument that must stay uncoloured. A language whose grammar is not installed is skipped.
(defn- face-at-text (spans src needle)
  (let (at (index-of src needle)
        hit (seq/find spans (fn (span) (= (first span) at))))
    (when hit (nth hit 2))))

(def- named-function-cases
  [[:ruby "x.rb" "def main(x)\n  foo(x)\n  s.bar\nend\n" "foo(" "main(" "x)\n  s"]
    [:elixir "x.ex" "def main(x) do\n  foo(x)\nend\n" "foo(" "main(" "x) do"]
    [:python "a.py" "def main(x):\n    return foo(x)\n" "foo(" "main(" "x):"]
    [:rust "a.rs" "fn main() {\n    let y = foo(x);\n}\n" "foo(" "main(" "x);"]
    [:go "a.go" "package m\n\nfunc main() {\n\ty := foo(x)\n}\n" "foo(" "main(" "x)\n"]
    [:javascript "a.js" "function main() {\n  return foo(x);\n}\n" "foo(" "main(" "x);"]
    [:typescript "a.ts" "function main(): number {\n  return foo(x);\n}\n" "foo(" "main(" "x);"]
    [:tsx "a.tsx" "function main() {\n  return foo(x);\n}\n" "foo(" "main(" "x);"]
    [:c "a.c" "int main(void) {\n    return foo(x);\n}\n" "foo(" "main(" "x);"]])

(describe "a called function and a defined one are coloured as functions"
  (doseq (case named-function-cases)
    (let ([lang file src call definition argument] case)
      (when (grammars/grammar-loaded? lang)
        (test (str (pr-str lang) " — the call's name and the definition's, not the argument")
          (let (spans ((model/ed-mode-service (cur (file-cm src file)) :fontify) src))
            (assert= (face-at-text spans src call) (editor/face/face :syntax/function))
            (assert= (face-at-text spans src definition) (editor/face/face :syntax/function))
            (is (nil? (face-at-text spans src argument)))))))))

;; ---- a method call, told from a field read by its grandparent (brood ADR-487) ------------
;; Each case: the source, a method call's name that must be a function, and a plain field
;; read's that must stay uncoloured — the same node kind under the same parent, only the
;; call above it differs.
(def- method-call-cases
  [[:python "a.py" "def main(s, p):\n    return s.bar(p.x)\n" "bar(" "x)\n"]
    [:rust "a.rs" "fn main() {\n    let y = s.bar(p.x);\n    Vec::new();\n}\n" "bar(" "x);"]
    [:go "a.go" "package m\n\nfunc main() {\n\ty := s.Bar(p.X)\n}\n" "Bar(" "X)\n"]
    [:javascript "a.js" "function main() {\n  return s.bar(p.x);\n}\n" "bar(" "x);"]
    [:typescript "a.ts" "function main(): number {\n  return s.bar(p.x);\n}\n" "bar(" "x);"]
    [:c "a.c" "int main(void) {\n    return s.bar(p.x);\n}\n" "bar(" "x);"]])

(describe "a method call's name is a function, a field read's is not"
  (doseq (case method-call-cases)
    (let ([lang file src method field] case)
      (when (grammars/grammar-loaded? lang)
        (test (str (pr-str lang) " — the method, not the field")
          (let (spans ((model/ed-mode-service (cur (file-cm src file)) :fontify) src))
            (assert= (face-at-text spans src method) (editor/face/face :syntax/function))
            (is (nil? (face-at-text spans src field)))))))))

(when (grammars/grammar-loaded? :rust)
  (test "rust — a path call's name is a function"
    (let (src "fn main() {\n    Vec::new();\n}\n"
          spans ((model/ed-mode-service (cur (file-cm src "a.rs")) :fontify) src))
      (assert= (face-at-text spans src "new(") (editor/face/face :syntax/function)))))

(describe "elixir's def / if / case are keywords, though the grammar parses them as calls"
  (let (src "defmodule M do\n  def main(x) do\n    if x, do: foo(x)\n  end\nend\n"
        spans ((model/ed-mode-service (cur (file-cm src "x.ex")) :fontify) src)
        keyword (editor/face/face :syntax/keyword))
    (test "the macros take the keyword colour"
      (assert= (face-at-text spans src "defmodule") keyword)
      (assert= (face-at-text spans src "def main") keyword)
      (assert= (face-at-text spans src "if x") keyword))
    (test "a call and a definition's name stay functions"
      (assert= (face-at-text spans src "foo(") (editor/face/face :syntax/function))
      (assert= (face-at-text spans src "main(") (editor/face/face :syntax/function)))))

;; ---- the line-lexer modes, declared by `deflexer` ---------------------------------
(describe "a deflexer mode's layer is the spec's facts in the editor's keys"
  (test "M-; knows the comment token — shell-mode once wrote `:comment` and got none"
    (doseq (case [["run.sh" "# "]
                   [".env" "# "]
                   ["Dockerfile" "# "]
                   ["a.json" "// "]
                   ["COMMIT_EDITMSG" nil]])
      (let ([file token] case)
        (assert= (model/ed-mode-service (cur (file-cm "x\n" file)) :comment-syntax) token))))
  (test "the lexer stem names both the whole-text fontify and the line lexer"
    (let (layer languages/ini-mode-layer)
      (assert= (:fontify layer) 'lex-configs/ini-spans)
      (assert= (:line-lexer layer) 'lex-configs/ini-line-lexer)
      (assert= (:fontify-restart layer) 'editor/highlight/line-restart)))
  (test "a spec with no lexer is refused at load, naming the mode"
    (is (includes? (error-of (languages/lexer-layer 'bad {:pattern "\\.bad$"})) "deflexer bad"))))

(describe "a language's face table is checked when it registers"
  (let (refs {:fontify 'f :indent 'i :restart 'r :faces 'faces})
    (test "every shipped table is well formed"
      (doseq (table [languages/ruby-face-table
                      languages/elixir-face-table languages/python-face-table
                      languages/rust-face-table languages/js-face-table languages/ts-face-table
                      languages/go-face-table languages/c-face-table languages/hcl-face-table])
        (is (empty? (editor/treesit/face-table-problems table)))))
    (test "a misspelt selector fails the registration, naming the entry"
      (let (raised (error-of (languages/language-layer 'bad
                               {:lang :bad :faces {{:feild :name} :syntax/function}}
                               refs)))
        (is (includes? raised "deflanguage bad: malformed face table"))
        (is (includes? raised ":feild"))))
    (test "a well-formed table registers"
      (is (map? (languages/language-layer 'good
                  {:lang :good :faces {{:field :function :kind :identifier} :syntax/function}}
                  refs))))
    (test "malformed injections fail the registration, as a face table does"
      (let (raised (error-of (languages/language-layer 'bad
                               {:lang :bad
                                :faces {:string :syntax/string}
                                :injections [{:content :heredoc :lang :bash :lang-from :x}]}
                               refs)))
        (is (includes? raised "deflanguage bad: malformed injections"))))
    (test "injections naming a language not registered yet still register"
      (let (layer (languages/language-layer 'good
                    {:lang :good
                     :faces {:string :syntax/string}
                     :injections [{:content :heredoc :lang :not-registered-yet}]}
                    (assoc refs :injections 'inj)))
        (assert= (:ts-injections layer) 'inj)))
    (test "a language with no injections names no injection service"
      (is (nil? (:ts-injections (languages/language-layer 'good
                                  {:lang :good :faces {:string :syntax/string}}
                                  (assoc refs :injections 'inj))))))))

;; ---- injections: an embedded language's faces are its own mode's (brood ADR-489) ------
(describe "an injection spec is built from the registered languages"
  (let (tables {:bash {:string :syntax/string} :json {:pair :syntax/special}}
        faces-of (fn (lang) (get tables lang)))
    (test "each named language gets its table; one with none is left out"
      (assert= (languages/injection-spec [{:content :heredoc
                                           :lang-from :id
                                           :aliases {"SH" :bash "JS" :json "RB" :ruby}}]
                 faces-of)
        {:rules [{:content :heredoc :lang-from :id :aliases {"SH" :bash "JS" :json}}]
         :faces tables}))
    (test "a rule fixed to a language with no table is dropped, and none left is nil"
      (is (nil? (languages/injection-spec [{:content :heredoc :lang :ruby}] faces-of))))
    (test "a registered language's table is its own spec's"
      (assert= (languages/language-faces :bash) (:faces languages/shell-spec))
      (is (nil? (languages/language-faces :no-such-language))))))

;; ---- the keys that use the indent service ------------------------------------
;; A mode having an `:indent` service is not the same as the keys reaching it. RET's
;; auto-indent binding sat on `brood-keymap` from when `.blsp` was the only mode that could
;; indent, and stayed there after the tree-sitter modes gained one — so RET in a `.ex` buffer
;; was still the plain newline and every continuation line landed in column 0. It lives on
;; the shared `prog-structural-keymap` now, which is where "same key, different parser"
;; belongs.
(describe "RET and TAB reach a tree-sitter mode's indenter"
  (defn ex-at (text pos)
    (let (m (ed-init (make-buffer text "a.ex" "a.ex"))
          i (model/ed-current-index m))
      (assoc m :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) pos)))))

  (test "RET opens the next line at the enclosing block's column"
    (let (src "defmodule A do\n  def run do\n    :ok\n  end\nend\n"
          after (buffer-text (cur (ed-update (ex-at src (+ (index-of src "    :ok") 7))
                                    :enter 80 24))))
      (assert= (nth (string/split after "\n") 3 "") "    ")))

  (test "TAB pulls a flush-left line back to its column"
    (let (src "defmodule A do\n  def run do\n:ok\n  end\nend\n"
          after (buffer-text (cur (ed-update (ex-at src (index-of src ":ok")) :tab 80 24))))
      (assert= (nth (string/split after "\n") 2 "") "    :ok")))

  ;; and `.blsp` keeps the behaviour it had, now by inheriting rather than by its own binding
  (test "brood-mode still auto-indents on RET"
    (let (src "(defn a ()\n  (+ 1 2)"
          m (ed-init (make-buffer src "a.blsp" "a.blsp"))
          i (model/ed-current-index m)
          m (assoc m
              :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) (string/length src))))
          after (buffer-text (cur (ed-update m :enter 80 24))))
      (assert= (last (string/split after "\n")) "  "))))

;; ---- the whole file, from flush left -----------------------------------------
;; The tests above indent lines of a file that is ALREADY indented, which is the easy half:
;; the indenter slices the enclosing top-level form by the column-0 convention, and in an
;; indented file that convention is true. In a flush-left file it degenerates — every line
;; starts at column 0, so the slice is the previous line — and the failure is not an error
;; but a wrong answer, because `def run do / :ok / end` parses perfectly on its own and
;; reports one enclosing block where the file has two. That is the state you are in when you
;; paste unindented code or type a module from scratch, so it gets a whole realistic module
;; rather than a snippet: nested do-blocks, `with`/else, a `case` with arrows, a pipeline,
;; a heredoc @moduledoc and a comment.
(describe "elixir-mode re-indents a whole module, from any starting indentation"
  (def ex-module
    "defmodule App.Ledger do\n  @moduledoc \"\"\"\n  Posts entries.\n  \"\"\"\n\n  use GenServer\n  require Logger\n\n  # the public face\n  def post(account, amount) when is_integer(amount) do\n    with {:ok, acct} <- fetch(account) do\n      GenServer.call(__MODULE__, {:post, acct, amount})\n    else\n      {:error, reason} ->\n        {:error, reason}\n    end\n  end\n\n  @impl true\n  def handle_call({:post, acct, amount}, _from, state) do\n    case Map.fetch(state, acct.id) do\n      {:ok, balance} ->\n        {:reply, {:ok, balance + amount}, state}\n\n      :error ->\n        {:reply, {:error, :no_account}, state}\n    end\n  end\n\n  defp validate(acct, amount) do\n    acct.limits\n    |> Enum.filter(fn l -> l.active end)\n    |> Enum.all?(fn l -> amount <= l.max end)\n  end\nend\n")

  ;; Re-indent every line top down, feeding each answer back in — what holding TAB down the
  ;; buffer does, and the reason a wrong early line would cascade into every line below it.
  (defn reindent (svc text)
    (fold (range (count (string/split text "\n")))
      text
      (fn (acc i)
        (let (ls (into [] (string/split acc "\n")) ; `assoc` wants a vector; split gives a list
              l (nth ls i ""))
          (if (= (string/trim l) "")
            acc
            (let (bol (fold (range i) 0 (fn (a k) (+ a (string/length (nth ls k "")) 1)))
                  col (svc acc bol))
              (string/join (assoc ls
                             i
                               (str (string/join (map (range col) (fn (_) " ")) "")
                                 (string/triml l)))
                "\n")))))))

  (def ex-svc (model/ed-mode-service (cur (file-cm ex-module "ledger.ex")) :indent))

  (test "re-indenting the file it already agrees with changes nothing"
    (assert= (reindent ex-svc ex-module) ex-module))

  (test "re-indenting it from FLUSH LEFT reproduces the original exactly"
    (let (flat (string/join (map (string/split ex-module "\n") string/triml) "\n"))
      (refute (= flat ex-module)) ; the input really is flat
      (assert= (reindent ex-svc flat) ex-module)))

  (test "and from over-indented, which is the other direction of the same mistake"
    (let (deep (string/join (map (string/split ex-module "\n")
                              (fn (l) (if (= (string/trim l) "") l (str "        " l))))
                 "\n"))
      (assert= (reindent ex-svc deep) ex-module)))

  ;; The ceiling, asserted rather than left to be discovered. `indent-column` is structural:
  ;; a line's column is how many block nodes enclose it, which is the shape every
  ;; block-structured language shares. A CONTINUATION line — the second clause of a `with`,
  ;; a wrapped argument list — is not a new block, and real Elixir aligns it under the
  ;; column its opener happens to sit at. That needs the opener's column, i.e. the
  ;; bracket-alignment rule `indent-column`'s own docstring rules out. So the indenter puts
  ;; such a line at its block level, which is stable and wrong by the formatter's lights.
  ;; Recorded here so the boundary is a decision and not a surprise.
  (test "a continuation line lands at block level — no alignment to an open bracket"
    (let (src "defmodule A do\n  def f do\n    with {:ok, a} <- one(),\n         {:ok, b} <- two(a) do\n      {a, b}\n    end\n  end\nend\n"
          bol (inc (index-of src "\n         {:ok, b}")))
      (assert= (ex-svc src bol) 4)))) ; Elixir's formatter would say 9
(describe "editor wide glyphs: the cursor column counts display cells"
  ;; The GUI renderer draws an emoji / CJK char two cells wide; the cursor must keep
  ;; pace, so its column is the display-width of the line up to point, not the char
  ;; count. (`ed-visual-column` vs `buffer-column`.)
  (test "a wide glyph before point advances the cursor two columns"
    (let (b (goto-char (make-buffer "a😀b") 2))
      ; point after the emoji (char offset 2)
      (assert= (buffer-column b) 2) ; two characters precede point
      (assert= (ed-visual-column b) 3))) ; but they occupy three cells (1 + 2)
  (test "with no wide glyph the visual column equals the char column"
    (let (b (goto-char (make-buffer "abc") 2))
      (assert= (ed-visual-column b) (buffer-column b)))))

(describe "editor brood-mode: syntax highlighting"
  (test "a .blsp buffer is syntax-coloured — `defn` carries a (non-nil) face"
    (let (ops (text-ops-where (ed-view (blsp-cm "(defn f ())" 0) 80 24) (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (not (nil? (nth (first ops) 4 nil))))))
  (test "a plain (non-brood) buffer is NOT coloured — the line is one faceless op"
    (let (ops (text-ops-where (ed-view (m-of "(defn f ())") 80 24)
                (fn (s) (includes? s "defn"))))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (nil? (nth op 4 nil)))))))
  (test "the active region merges the selection tint into the lexer face (still coloured)"
    ;; region [0,4) over "(map f)" covers the call head `map`; its chunk keeps its
    ;; :fg and gains the region's :bg tint (so syntax colour stays visible).
    (let (m (press (blsp-cm "(map f)" 0) [(keyword "ctrl- ") :right :right :right :right])
          merged (seq/filter (ed-view m 80 24)
                   (fn (op)
                     (and (= (first op) :text)
                       (= (:bg (nth op 4 {})) (:bg theme/face-region))
                       (:fg (nth op 4 {}))))))
      (is (> (count merged) 0)))))

;; Highlighting only the visible window (not the whole buffer) is what keeps a large
;; file responsive. These prove the windowed fontify (ed-window-spans) colours the
;; visible lines correctly at deep scroll offsets — i.e. spans land in *absolute*
;; coordinates, not slice-local ones — even past the backscan lead-in.
(describe "editor brood-mode: windowed fontification (large files)"
  ;; N lines of `(defn fK ())`; N exceeds the backscan lead-in so a deep scroll
  ;; exercises the text/slice window rather than lexing from the top.
  (defn big-blsp (n) (string/join (map (range n) (fn (i) (str "(defn f" i " ())"))) "\n"))

  (test "a token deep past the backscan window is still coloured"
    (let (ops (text-ops-where (ed-view (ed-set-top (blsp-cm (big-blsp 400) 0) 300) 80 24)
                (fn (s) (= s "defn"))))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (nth op 4 nil))))))

  (test "the deep token's face matches the same token at the top (absolute offsets correct)"
    (let (txt (big-blsp 400)
          face-at (fn (m)
                    (nth (first (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn")))) 4 nil))
          top-face (face-at (blsp-cm txt 0))
          deep-face (face-at (ed-set-top (blsp-cm txt 0) 300)))
      (is (not (nil? deep-face)))
      (assert= deep-face top-face)))

  (test "a docstring longer than the backscan does not turn the code below it into string"
    ;; the reported bug: the window's 200-line lead-in began INSIDE the docstring, so its
    ;; closing `"` read as an opening one and everything after it coloured as a string
    (let (doc (string/join (map (range 250) (fn (i) (str "doc " i))) "\n")
          txt (str "(defn a ()\n  \"" doc "\"\n  (b))\n" (big-blsp 100))
          face-at (fn (m)
                    (nth (first (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn")))) 4 nil))
          top-face (face-at (blsp-cm (big-blsp 3) 0))
          deep-face (face-at (ed-set-top (blsp-cm txt 0) 300)))
      (assert= deep-face top-face)))

  (test "a stale scroll offset past EOF is clamped, not fed to the rope (no render crash)"
    ;; a pane scrolled deep then pointed at a short fontified buffer (e.g. after a
    ;; C-x k kill remaps it to a shorter buffer) keeps its old :top. Rendering must
    ;; clamp that into the buffer rather than ask the rope for a line past EOF — which
    ;; threw `text/line->char: line N out of bounds` straight out of the renderer.
    (let (f (ed-view (ed-set-top (blsp-cm "(a)\n(b)\n(c)" 0) 9) 80 24))
      ;; top is clamped to the last line, so the buffer renders (its tail line's `c`
      ;; glyph is drawn — fontify splits the line into coloured chunks) rather than the
      ;; caught-error fallback frame (which has only its one error-message text op)
      (is (= 0 (count (text-ops-where f (fn (s) (includes? s "render error"))))))
      (is (> (count (text-ops-where f (fn (s) (includes? s "c")))) 0))))

  (test "ed-window-spans returns spans in absolute coordinates"
    ;; a window of just line 2 (lines [2, 3)) of a 3-line buffer: the call head `c` at
    ;; offset 9 is coloured in absolute (not slice-local) coordinates.
    (let (buf (ed-current-buf (blsp-cm "(a)\n(b)\n(c)" 0))
          spans (ed-window-spans buf
                  (ed-mode-service buf :fontify)
                  (ed-mode-service buf :fontify-restart)
                  2
                  3))
      (is (includes? spans [9 10 {:fg :cyan}])))))

;; The span cache (panes/ed-refresh-spans) is what makes motion feel slick: the pure
;; `view` re-lexes nothing on plain cursor movement / selection / mouse, reusing the
;; band cached on the model. A recompute happens only when the rope changes (an edit)
;; or the viewport scrolls outside the margin-widened band.
(describe "editor brood-mode: fontify span cache"
  ;; the span cache is keyed by PANE PATH now (several panes on one buffer cache their own
  ;; band), so read the selected pane's entry rather than a buffer index.
  (defn cache-entry (m)
    (get (:span-cache m) (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))))
  (defn rs (b) (ed-mode-service b :fontify-restart)) ; the brood-mode :fontify-restart
  (test "ed-refresh-spans caches a band covering the viewport"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (not (nil? e)))
      (is (panes/ed-band-covers? e (ed-current-buf m) 0 23 (rs (ed-current-buf m))))))

  (test "a scroll within the margin reuses the cached band (cache hit)"
    ;; margin is 32 lines; scrolling 20 lines keeps the viewport inside the band.
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (panes/ed-band-covers? e (ed-current-buf m) 20 23 (rs (ed-current-buf m))))))

  (test "a scroll past the margin no longer covers (forces a recompute)"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m))
      (is (not (panes/ed-band-covers? e (ed-current-buf m) 100 23 (rs (ed-current-buf m)))))))

  (test "an edit WITHIN the band (new fontify input) invalidates it"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m)
          edited (insert (ed-current-buf m) "x"))
      ; inserts at point (line 0, in the band)
      (is (not (panes/ed-band-covers? e edited 0 23 (rs edited))))))

  (test "an append BELOW the band keeps it covered (the streaming-output fast path)"
    ;; a results/output buffer grows below a stationary viewport: the rope changes but
    ;; no line in THIS band does — brood-mode colours from the line cache (brood ADR-510),
    ;; whose lexer reads lines in order — so its spans stay valid, no re-fontify per line.
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 0) 80 24)
          e (cache-entry m)
          buf (ed-current-buf m)
          ;; append past the band's end (bhi) — point/viewport stay at the top
          appended (insert (goto-char buf (buffer-length buf)) "\n(newline far below)")
          rope-changed (not (= (buffer-rope appended) (buffer-rope buf))))
      (is rope-changed) ; the rope really changed
      (is (:line? e))
      (is (panes/ed-line-band-survives? e appended 0 23)))) ; …yet the band still serves
  (test "the cached spans match a direct windowed lex of the same range"
    (let (m (ed-refresh-spans (blsp-cm (big-blsp 400) 50) 80 24)
          buf (ed-current-buf m)
          e (cache-entry m)
          direct (ed-window-spans buf
                   (ed-mode-service buf :fontify)
                   (ed-mode-service buf :fontify-restart)
                   (:blo e)
                   (:bhi e)))
      (assert= (:spans e) direct))))

(describe "editor brood-mode: bracket matching"
  (test "the pair splits by adjacency: the end at point underlined, its partner blocked"
    ;; point at 1 sits just after the opening paren of "(+ 1 2)": that `(` is the end
    ;; AT point (underline accent — the cursor already marks it), and the closing
    ;; paren is the partner (the solid block face). The split is the point: the solid
    ;; block always means "the OTHER end", so a glance answers which end you are at.
    (let (f (ed-view (blsp-cm "(+ 1 2)" 1) 80 24)
          here-ops (seq/filter f
                     (fn (op)
                       (and (= (first op) :text)
                         (= (nth op 3 "") "(")
                         (= (nth op 4 nil) theme/face-bracket-here))))
          far-ops (seq/filter f
                    (fn (op)
                      (and (= (first op) :text)
                        (= (nth op 3 "") ")")
                        (= (nth op 4 nil) theme/face-bracket-match)))))
      (is (> (count here-ops) 0))
      (is (> (count far-ops) 0))))
  (test "no bracket overrides when point isn't next to a bracket"
    (assert= (ed-bracket-overrides (ed-current-buf (blsp-cm "(+ 1 2)" 3))) '())))

(describe "editor brood-mode: eldoc signature hints"
  (test "eldoc shows the enclosing call's signature when the echo is idle"
    ;; eldoc is now a cached model field (ed-post-step), so seed the cache first
    (is (includes? (ed-echo-or-eldoc (ed-cache-eldoc (blsp-cm "(map f)" 4))) "map")))
  (test "an explicit message suppresses eldoc for that frame"
    (assert= (ed-echo-or-eldoc (message (blsp-cm "(map f)" 4) "hello")) "hello"))
  (test "no eldoc in a plain (non-brood) buffer"
    (assert= (ed-echo-or-eldoc (m-of "(map f)")) "")))

(describe "editor brood-mode: symbol completion"
  (test "Tab in a .blsp buffer completes live global symbols, not buffer words"
    ;; "(def" → many globals (defn, defmacro, …); the popup's items include `defn`,
    ;; which is NOT a word present in the buffer (so this proves the global source).
    (let (c (get (cmd-complete (blsp-cm "(def" 4) nil) :completion))
      (is (not (nil? c)))
      (is (includes? (:items c) "defn"))))
  (test "a plain buffer still completes buffer words (default source unchanged)"
    (let (m (cmd-complete (ed-set-buf (m-of "") (goto-char (make-buffer "alpha al") 8)) nil))
      (assert= (buffer-text (cur m)) "alpha alpha")))
  (test "Tab merges mode globals with buffer words (multi-source)"
    ;; prefix "def": brood-mode contributes live globals (`defn`, not a word in the
    ;; buffer) and the buffer-word source contributes `defjjj` (a word, not a global).
    ;; The popup shows BOTH — proof the sources merge, rather than one winning.
    (let (c (get (cmd-complete (blsp-cm "defjjj (def" 11) nil) :completion))
      (is (not (nil? c)))
      (is (includes? (:items c) "defn"))
      (is (includes? (:items c) "defjjj"))))
  (test "the open popup renders as a ui-kit card (flat rect terminal, rounded frect GUI)"
    ;; end-to-end: complete-popup-ops runs the whole widget path (ui-ctx → ui-panel →
    ;; ui-list) — a flat rect card in the terminal, a rounded frect card when :gui.
    (let (m (cmd-complete (blsp-cm "(def" 4) nil)
          flat (map (complete-popup-ops (assoc m :gui false) 80 24) first)
          gui (map (complete-popup-ops (assoc m :gui true) 80 24) first))
      (is (includes? flat :rect)) ; flat card surface + selection bar
      (is (not (includes? flat :frect)))
      (is (> (count (seq/filter flat (fn (t) (= t :text)))) 0)) ; candidate rows
      (is (includes? gui :frect)) ; rounded card + pill
      (is (not (includes? gui :rect))))))

(describe "editor brood-mode: indentation (matches nest format)"
  ;; brood-indent text bol -> column, computed purely over the CST (std/sexp).
  ;; The canonical Brood style (std/format): bodies indent +2 from the open
  ;; delimiter; maps and let-bindings lists align under the first element.
  (test "top level → column 0"
    (assert= (brood-mode/brood-indent "(a)\n(b)" 4) 0))
  (test "a body form (defn) indents its body +2 from the open paren"
    (assert= (brood-mode/brood-indent "(defn f ()\nx)" 11) 2))
  (test "let body indents +2"
    (assert= (brood-mode/brood-indent "(let (a 1)\nb)" 11) 2))
  (test "a call indents its body +2 (not aligned under the first arg, per the formatter)"
    (assert= (brood-mode/brood-indent "(foo bar\nbaz)" 9) 2))
  (test "a vector indents +2"
    (assert= (brood-mode/brood-indent "[a\nb]" 3) 2))
  (test "a map aligns entries under the first element"
    (assert= (brood-mode/brood-indent "{:a 1\n:b 2}" 6) 1))
  (test "a let-family bindings list aligns pairs under its first element"
    ;; "(let (a 1\nb 2) x)" — the `b` line is inside the bindings list; aligns under `a`
    (assert= (brood-mode/brood-indent "(let (a 1\nb 2) x)" 10) 6))
  (test "an unclosed form at end-of-text still indents the new line (RET case)"
    ;; "(defn f ()\n" — point at EOF (offset 11) inside the unclosed defn → body +2
    (assert= (brood-mode/brood-indent "(defn f ()\n" 11) 2))

  (test "cmd-indent-line reindents a .blsp line to its sexp column, keeping point"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\nx)" 11) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")
      (assert= (buffer-point (cur m)) 13))) ; point was in the indent → first non-blank
  (test "cmd-indent-line removes over-indentation too"
    (let (m (cmd-indent-line (blsp-cm "(defn f ()\n      x)" 17) nil))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))

  (test "RET in brood-mode inserts a newline and indents the new line"
    (let (m (ed-update (blsp-cm "(defn f ()" 10) :enter 80 24))
      (assert= (buffer-text (cur m)) "(defn f ()\n  ")
      (assert= (buffer-point (cur m)) 13)))
  (test "RET in a plain buffer is still a plain newline (no auto-indent)"
    (let (m (ed-update (ed-set-buf (m-of "  ab") (goto-char (make-buffer "  ab") 4)) :enter 80 24))
      (assert= (buffer-text (cur m)) "  ab\n")))

  (test "TAB indents a mis-indented line (no completion popup)"
    (let (m (ed-update (blsp-cm "(defn f ()\nx)" 11) :tab 80 24))
      (is (nil? (:completion m)))
      (assert= (buffer-text (cur m)) "(defn f ()\n  x)")))
  (test "TAB on an already-indented line, point on a symbol, completes instead"
    ;; line already at col 2, point after "map" → complete (against live globals,
    ;; not buffer words): the popup opens with candidates that all start with "map".
    (let (m (ed-update (blsp-cm "(defn f ()\n  map" 16) :tab 80 24)
          items (:items (:completion m)))
      (is (not (nil? (:completion m))))
      (is (> (count items) 0))
      (is (every? items (fn (s) (string/starts-with? s "map")))))))

(describe "editor fallback indentation (no :indent service)"
  (test "cmd-indent-line matches the previous line's indentation in a plain buffer"
    (let (m (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "    foo\nbar") 8)) nil))
      (assert= (buffer-text (cur m)) "    foo\n    bar")))
  ;; the fallback reads the rope line by line (no whole-buffer string): these pin the walk
  ;; it replaced — blank and whitespace-only lines are skipped, a tab counts as one column
  (test "the fallback skips blank and whitespace-only lines back to the last real one"
    (let (m (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "  foo\n\n   \nbar") 11))
              nil))
      (assert= (buffer-text (cur m)) "  foo\n\n   \n  bar")))
  (test "the fallback counts a leading tab as one column, and is 0 on the first line"
    (let (tabbed (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "\tfoo\nbar") 5))
                   nil)
          first (cmd-indent-line (ed-set-buf (m-of "") (goto-char (make-buffer "   foo") 3)) nil))
      (assert= (buffer-text (cur tabbed)) "\tfoo\n bar")
      (assert= (buffer-text (cur first)) "foo"))))

;; ---- in-process diagnostics (the :diagnostics service) ----------------------
;; brood-mode calls the advisory type checker directly (same image) via
;; check-string-structured; the warning is cached on edit and rendered inline /
;; in the echo / on the mode line. `(map … cons)` is a reliable warner: cons is
;; 2-ary, map calls it with 1 (ADR-078 callback-arity), flagged on line 1.
(def bad-src "(map (list 1 2 3) cons)")

(describe "editor brood-mode: diagnostics service"
  (test "brood-diagnostics returns positioned warnings for a bad form"
    (let (ds (brood-mode/brood-diagnostics bad-src))
      (is (> (count ds) 0))
      (assert= (:line (first ds)) 1)
      (is (string? (:message (first ds))))))
  (test "brood-diagnostics is empty for clean or unparsable source"
    (is (empty? (brood-mode/brood-diagnostics "(def x 1)")))
    (is (empty? (brood-mode/brood-diagnostics "("))))) ; incomplete input mid-edit
(describe "editor diagnostics cache (recompute only on rope change)"
  (test "ed-refresh-diagnostics populates :diagnostics + :diag-rope for a brood buffer"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1)))
      (is (> (count (:diagnostics m)) 0))
      (assert= (:diag-rope m) (buffer-rope (cur m)))))
  (test "it is a no-op when the rope is unchanged (cache hit on :diag-rope)"
    ;; seed the cache, then re-run with the buffer unchanged but a sentinel in place —
    ;; an unchanged sentinel proves it didn't recompute (the rope handle still matches).
    ;; The sentinel is a diagnostic the checker would never produce, so the model stays
    ;; well-typed (`:diagnostics` is a list of records).
    (let (sentinel (list {:line 999999 :col 1 :message "sentinel"})
          m1 (ed-refresh-diagnostics (blsp-cm bad-src 1))
          m2 (ed-refresh-diagnostics (assoc m1 :diagnostics sentinel)))
      (assert= (:diagnostics m2) sentinel)))
  (test "a plain (non-brood) buffer has no :diagnostics service → left untouched"
    (is (nil? (get (ed-refresh-diagnostics (m-of "(map (list) cons)")) :diagnostics))))
  ;; async path: with no live :editor process (as in tests) ed-launch-diag runs the
  ;; check synchronously; ed-apply-diag folds a spawned check's reply back in.
  (test "ed-launch-diag falls back to a synchronous check when headless"
    (let (m (ed-launch-diag (blsp-cm bad-src 1)))
      (is (> (count (:diagnostics m)) 0))
      (is (nil? (:diag-proc m)))))
  (test "ed-apply-diag stores the reply against the checked rope and clears the handle"
    (let (m (assoc (blsp-cm bad-src 1) :diag-proc :h :diag-checking :the-rope)
          m2 (ed-apply-diag m [{:line 2 :col 1 :message "w"}]))
      (assert= (count (:diagnostics m2)) 1)
      (assert= (:diag-rope m2) :the-rope)
      (is (nil? (:diag-proc m2)))))
  (test "a task reply whose handle is in flight for diagnostics updates the cache"
    (let (m (assoc (blsp-cm bad-src 1) :diag-proc :h :diag-checking :the-rope)
          m2 (input/ed-ev-task-reply m [:task-done :h [{:line 1 :col 1 :message "x"}]] 24 80 24))
      (assert= (count (:diagnostics m2)) 1)
      (is (nil? (:diag-proc m2)))))
  (test "a stale task reply (handle matches no in-flight job) is dropped"
    (let (m (assoc (blsp-cm bad-src 1) :diagnostics :keep)
          m2 (input/ed-ev-task-reply m [:task-done :gone ()] 24 80 24))
      (assert= (:diagnostics m2) :keep)))
  (test "typing defers the check (debounced); the idle tick runs it"
    ;; drive the real keystroke path: typing no longer type-checks per key — the check
    ;; is deferred (Emacs flymake-on-idle). `ed-run-diag` is what the debounce `:tick`
    ;; runs once typing settles; an unbalanced prefix nags nothing, the complete form does.
    (let (blank (ed-init (make-buffer "" "x.blsp" "x.blsp"))
          type (fn (m s) (fold (string/->list s) m (fn (acc c) (ed-update acc c 80 24)))))
      ;; right after typing the full ill-typed form the check hasn't run yet (deferred)
      (is (empty? (or (get (type blank "(map (list 1 2 3) cons)") :diagnostics) '())))
      ;; the debounce tick (ed-run-diag) runs it: incomplete → none, complete → a warning
      ;; (pairing off: with it on, the openers would have typed their closers and the
      ;; prefix would be complete)
      (is (empty? (get (ed-run-diag (type (assoc blank :electric-pair? false)
                                      "(map cons (list 1 2 3"))
                    :diagnostics)))
      (is (> (count (get (ed-run-diag (type blank "(map (list 1 2 3) cons)")) :diagnostics)) 0))))

  ;; eldoc rides the same off-loop task pattern as diagnostics (§E.2): launch on the
  ;; idle beat (async when a live :editor exists, sync headless), fold on [:task-done].
  (test "ed-launch-eldoc falls back to a synchronous cache when headless"
    (let (m (ed-launch-eldoc (blsp-cm "(map 1 cons)" 5)))
      (assert= (:eldoc-point m) 5) ; computed AT point (hint may be nil/some)
      (is (nil? (:eldoc-proc m)))))
  (test "brood eldoc reads only the top-level form around point, to the end of point's line"
    (let (rope (text/from-string "(defn a (x) x)\n(map f\n  xs)\n(b)"))
      ;; point after `(map ` on line 2: the form starts at 15, the line ends at 22
      (assert= (brood-mode/brood-eldoc-region rope 20) [15 22])
      ;; the hint from the slice is the hint from the whole text
      (assert= (eldoc-hint brood-mode/brood-eldoc brood-mode/brood-eldoc-region rope 20)
        (brood-mode/brood-eldoc (text/->string rope) 20))
      (is (includes? (eldoc-hint brood-mode/brood-eldoc brood-mode/brood-eldoc-region rope 20)
            "map"))))
  (test "a string holding an open paren does not start the eldoc region"
    (let (rope (text/from-string "(a \"(\" (map f"))
      (assert= (first (brood-mode/brood-eldoc-region rope 13)) 0)))
  (test "a mode with no eldoc region gets the whole text"
    (let (rope (text/from-string "abc"))
      (assert= (eldoc-hint (fn (text pos) [text pos]) nil rope 2) ["abc" 2])))
  (test "ed-apply-eldoc stores the hint against the point it was computed at"
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope (buffer-rope (cur m0))})
          m2 (ed-apply-eldoc m "plus hint"))
      (assert= (:eldoc m2) "plus hint")
      (assert= (:eldoc-point m2) 3)
      (is (nil? (:eldoc-proc m2)))))
  (test "an eldoc reply landing after the buffer changed is dropped, not mis-cached"
    ;; the hint was computed for another buffer/rope — caching it would show buffer
    ;; A's signature while visiting buffer B
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope :some-other-rope})
          m2 (ed-apply-eldoc m "stale hint"))
      (is (nil? (:eldoc m2)))
      (is (nil? (:eldoc-proc m2))))) ; the in-flight handle still clears
  (test "a task reply whose handle is in flight for eldoc folds via the router"
    (let (m0 (blsp-cm "(+ 1 2)" 3)
          m (assoc m0
              :eldoc-proc :h
              :eldoc-checking {:pt 3 :rope (buffer-rope (cur m0))})
          m2 (input/ed-ev-task-reply m [:task-done :h "hint"] 24 80 24))
      (assert= (:eldoc m2) "hint")
      (is (nil? (:eldoc-proc m2))))))

(describe "diagnostics are indexed by line when they land, and read per visible line"
  ;; The view used to walk every cached diagnostic on every frame — 2,547 checker findings
  ;; on a 282k-line file made a cursor blink cost 135 ms where the same frame without them
  ;; cost 2.6. Now the one setter builds `{line -> (diags)}` once and every reader asks
  ;; only about the lines on screen.
  (test "the setter builds the index; both check paths go through it"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1))
          idx (:diag-by-line m))
      (is (map? idx))
      (assert= (count (get idx 0)) (count (:diagnostics m))) ; every finding is on line 1
      (assert= (:diag-by-line (ed-apply-diag (assoc m :diag-checking (buffer-rope (cur m)))
                                (list {:line 3 :col 2 :message "x"}
                                  {:line 3 :col 5 :message "y"}
                                  {:col 1})))
        {2 (list {:line 3 :col 2 :message "x"} {:line 3 :col 5 :message "y"})})))
  (test "the overrides and the notes read only the viewport's lines"
    (let (m (ed-set-diagnostics (blsp-cm "a\nb\nc\nd\n" 0)
              (list {:line 1 :col 1 :message "one"} {:line 4 :col 1 :message "four"})
              (buffer-rope (cur (blsp-cm "a\nb\nc\nd\n" 0))))
          buf (cur m))
      (assert= (map (ed-diagnostic-overrides m buf 0 4) first) (list 0 6))
      (assert= (map (ed-diagnostic-overrides m buf 1 2) first) (list)) ; lines 2–3: none
      (assert= (map (ed-diagnostic-overrides m buf 3 10) first) (list 6)) ; past EOF clipped
      (is (nil? (get (view/ed-diag-notes (assoc m :diag-rope (buffer-rope buf)) buf 1 2) 0)))
      (assert= (sort (keys (view/ed-diag-notes (assoc m :diag-rope (buffer-rope buf)) buf 0 4)))
        (list 0 3))))
  (test "no ⚠ note on a form whose run already failed — its error says it"
    ;; the playground's `(defn )`: the checker's `does not compile: defn: …` beside the
    ;; runtime's `✗ defn: …` under it was the same error twice
    (let (m (ed-set-diagnostics (blsp-cm "a\nb\nc\nd\n" 0)
              (list {:line 1 :col 1 :message "one"} {:line 4 :col 1 :message "four"})
              (buffer-rope (cur (blsp-cm "a\nb\nc\nd\n" 0))))
          failed (results/set-note (cur m) :form {:kind :fail :error? true :text "boom"} 1 0)
          passed (results/set-note (cur m) :form {:kind :info :text "=> 1"} 1 0)
          m (assoc m :diag-rope (buffer-rope (cur m))))
      (assert= (sort (keys (view/ed-diag-notes m failed 0 4))) (list 3))
      (assert= (sort (keys (view/ed-diag-notes m passed 0 4))) (list 0 3)))))

(describe "editor diagnostics rendering"
  (test "a diagnostic on the current line shows in the echo area (over eldoc)"
    (is (includes? (ed-echo-or-eldoc (ed-refresh-diagnostics (blsp-cm bad-src 1))) "warning")))
  (test "an explicit message still wins over a diagnostic"
    (assert= (ed-echo-or-eldoc (message (ed-refresh-diagnostics (blsp-cm bad-src 1)) "hi")) "hi"))
  (test "ed-diagnostic-overrides underlines each diagnostic token"
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 1))
          ovs (ed-diagnostic-overrides m (cur m) 0 100))
      (is (> (count ovs) 0))
      (assert= (second (first ovs)) view/ed-face-diagnostic)))
  (test "ed-view underlines the diagnostic token (point off any bracket)"
    ;; point at 5 (inside `cons`) sits next to no bracket, so the diagnostic
    ;; underline at the call isn't shadowed by bracket-match.
    (let (m (ed-refresh-diagnostics (blsp-cm bad-src 5))
          underlined (seq/filter (ed-view m 80 24)
                       (fn (op) (and (= (first op) :text) (:underline (nth op 4 {}))))))
      (is (> (count underlined) 0))))
  (test "the mode line shows the diagnostic count"
    (is (includes? (mode-line-text (ed-refresh-diagnostics (blsp-cm bad-src 1))) "⚠"))))

;; ---- genericity: the view honours ANY mode's services, not just brood's -----
;; A throwaway "stub" mode proves the editor is a language-agnostic services host:
;; register a layer with its own :fontify / :eldoc and the view uses them. This is
;; the whole point of putting brood-mode in the editor — adding another language is
;; the same registration with different functions.
(defn stub-fontify (text) (list [0 (string/length text) {:fg :magenta}]))
(defn stub-eldoc (text pos) "STUB-HINT")
(defn stub-indent (text bol) 7)
(defn stub-diagnostics (text) (list {:line 1 :col 1 :message "stub-warning"}))
(def stub-layer
  {:name 'stub
   :fontify 'modes-test/stub-fontify
   :eldoc 'modes-test/stub-eldoc
   :indent 'modes-test/stub-indent
   :diagnostics 'modes-test/stub-diagnostics})
(defn stub-model (text)
  (ed-set-buf (m-of "") (editor/layers/push-layer (make-buffer text) 'modes-test/stub-layer)))

(describe "editor is a language-agnostic mode-services host"
  (test "the view honours any mode's :fontify"
    (let (coloured (seq/filter (ed-view (stub-model "hello") 80 24)
                     (fn (op) (and (= (first op) :text) (= (nth op 4 nil) {:fg :magenta})))))
      (is (> (count coloured) 0))))
  (test "the view honours any mode's :eldoc"
    ;; eldoc is cached on the model by ed-post-step; seed it, then the view paints it
    (assert= (ed-echo-or-eldoc (ed-cache-eldoc (stub-model "hello"))) "STUB-HINT"))
  (test "cmd-indent-line honours any mode's :indent"
    (assert= (buffer-text (cur (cmd-indent-line (stub-model "ab") nil))) "       ab"))
  (test "the editor honours any mode's :diagnostics"
    (let (m (ed-refresh-diagnostics (stub-model "hello")))
      (assert= (count (:diagnostics m)) 1)
      (is (includes? (ed-echo-or-eldoc m) "stub-warning")))))

(describe "editor brood-mode services across processes"
  :isolated (test "a brood model renders coloured after a round-trip through a spawned process"
    ;; send the model to a worker, which renders it and sends back the result —
    ;; proving the model (layers carry fn-symbol facets; faces are maps) deep-copies
    ;; intact across per-process heaps.
    (let (me (self)
          m (blsp-cm "(defn f ())" 0)
          _ (spawn (let (ops (text-ops-where (ed-view m 80 24) (fn (s) (= s "defn"))))
                     (send me [:result (count ops) (nth (first ops) 4 nil)]))))
      (receive ([:result n faced] (is (> n 0)) (is faced)))))

  (test "diagnostics re-check correctly in a spawned process (in-process checker)"
    ;; the worker runs the advisory checker on a deep-copied model and reports the
    ;; warning count — proves check-string-structured works off the main process too.
    (let (me (self)
          m (blsp-cm "(map (list 1 2 3) cons)" 1)
          _ (spawn (send me [:n (count (:diagnostics (ed-refresh-diagnostics m)))])))
      (receive ([:n n] (is (> n 0)))))))

;; ---- the mode in the mode line ----------------------------------------------
(defn mode-line-text (m)
  "The selected pane's mode-line text: the bar is now a `face-modeline` **fill rect** plus one
`text` op per status-bar segment, so join every text op on the bar's row to recover the line."
  (let (ops (ed-view m 80 24)
        barrow (nth (seq/find ops
                      (fn (op)
                        (and (= (first op) :rect) (= (nth op 5 nil) theme/face-modeline))))
                 1))
    (string/join (map (seq/filter ops (fn (op) (and (= (first op) :text) (= (nth op 1) barrow))))
                   (fn (op) (nth op 3)))
      "")))

(describe "editor mode line shows the active mode"
  (test "a plain buffer shows (text)"
    (is (includes? (mode-line-text (m-of "hi")) "(text)")))
  (test "a .blsp buffer shows (brood)"
    (is (includes? (mode-line-text (ed-init (make-buffer "(+ 1 2)" "x.blsp" "x.blsp"))) "(brood)"))))

;; ---- special-mode: the shared read-only + no-gutter base for generated buffers -
(describe "editor special-mode base (read-only listings hide the line-number gutter)"
  (defn typed (type) (cur (ed-show-named (m-of "") "*x*" "one\ntwo" type)))
  (test "every special buffer type hides the gutter (no toggle needed)"
    (is (not (ed-gutter-shown? (typed :git-status) {})))
    (is (not (ed-gutter-shown? (typed :git-diff) {})))
    (is (not (ed-gutter-shown? (typed :git-log) {})))
    (is (not (ed-gutter-shown? (typed :dired) {})))
    (is (not (ed-gutter-shown? (typed :occur) {})))
    (is (not (ed-gutter-shown? (typed :process-menu) {}))))
  (test "special-mode's :activate hook makes the buffer read-only"
    (is (read-only? (typed :git-status)))
    (is (read-only? (typed :process-menu))))
  (test "a plain text buffer still shows the gutter (special-mode changes nothing global)"
    (is (ed-gutter-shown? (cur (m-of "hi")) {})))
  (test "C-x l still forces the gutter on for a special buffer (explicit pane override wins)"
    (is (ed-gutter-shown? (typed :git-status) {:payload {:line-numbers true}})))
  (test "*git-commit* is editable yet still hides the gutter (its own :no-line-numbers)"
    (is (not (ed-gutter-shown? (typed :git-commit) {})))
    (refute (read-only? (typed :git-commit)))))

(describe "welcome-mode (the startup scratch's clickable link lines)"
  (test "each link line resolves a :line-loc (pointer/hover affordance); others don't"
    (let (b (editor/layers/set-buffer-type (make-buffer "hello\n\n➜ New? Click here: the interactive bedit tutorial · C-h t\n➜ Just the language? the Brood playground · C-c p p\n")
              :welcome))
      (is (nil? (modes/welcome-line-loc b 0)))
      (is (not (nil? (modes/welcome-line-loc b 2))))
      (is (not (nil? (modes/welcome-line-loc b 3))))))
  (test "welcome-link-at names each line's command"
    (assert= (second (modes/welcome-link-at "➜ the interactive bedit tutorial · C-h t"))
      'tutor/cmd-tutorial)
    (assert= (second (modes/welcome-link-at "➜ the Brood playground · C-c p p"))
      'playground/cmd-brood-playground)
    (is (nil? (modes/welcome-link-at "plain prose"))))
  (test "clicking the tutorial link opens the tutorial; clicking elsewhere is inert"
    (let (raw (editor/layers/set-buffer-type (make-buffer "hello\n\n➜ the interactive bedit tutorial · C-h t\n")
                :welcome)
          m (model/ed-init raw)
          off-link (model/ed-set-buf m (editor/buffer/goto-char (model/ed-current-buf m) 2))
          on-link (model/ed-set-buf m (editor/buffer/goto-char (model/ed-current-buf m) 10)))
      (assert= (commands/cmd-welcome-link off-link :mouse) off-link)
      (is (not (nil? (model/ed-buffer-index-by-name (commands/cmd-welcome-link on-link :mouse)
                       "*Tutorial*"))))))
  (test "each link line gets the link face"
    (let (spans (modes/welcome-fontify "plain\n➜ the interactive bedit tutorial\n➜ the Brood playground\n"))
      (assert= (count spans) 2))))

;; ---- the whole of a real module, against `mix format` ------------------------
;; The sample below is a real Elixir module that `mix format` leaves untouched — so its
;; own indentation IS Elixir's answer, and every line can be checked against it. Written
;; this way because a hand-picked snippet is a weak gate: the previous sample here
;; round-tripped perfectly while the indenter was wrong on six lines, for the simple
;; reason that it happened to contain no multi-line list and no `fn` clause.
;;
;; What that found, and what each line here now guards:
;;   * a multi-line list/map/tuple did not indent its contents at all
;;   * an `fn` clause inside a call lost a level — the `Enum.reduce(xs, %{}, fn … end)`
;;     shape, which Elixir is full of
;;   * `end)` did not dedent, because the token scan split on whitespace and `end)`
;;     is not `end`

(def ex-real-module
  (string/join ["defmodule App.Ledger do"
                 "  @moduledoc \"\"\"" "  Posts entries." "  \"\"\"" "" "  use GenServer"
                 "  require Logger" "" "  @type entry :: %{id: integer(), amount: integer()}" ""
                 "  def start_link(opts) do"
                 "    GenServer.start_link(__MODULE__, opts, name: __MODULE__)" "  end" ""
                 "  @impl true" "  def init(opts) do"
                 "    {:ok, %{entries: [], limit: Keyword.get(opts, :limit, 100)}}" "  end" ""
                 "  def post(account, amount) when is_integer(amount) and amount > 0 do"
                 "    case Map.fetch(accounts(), account) do" "      {:ok, acct} ->" "        acct"
                 "        |> Map.update(:balance, amount, &(&1 + amount))"
                 "        |> tap(fn a -> Logger.info(\"balance #{a.balance}\") end)" ""
                 "      :error ->" "        {:error, :no_account}" "    end" "  end" ""
                 "  defp accounts do" "    for {k, v} <- load(), into: %{} do" "      {k, v}"
                 "    end" "  end" "" "  defp load do" "    [" "      {:a, 1}," "      {:b, 2}"
                 "    ]" "  end" "" "  def run(list) do" "    Enum.reduce(list, %{}, fn"
                 "      {k, v}, acc when is_atom(k) ->" "        Map.put(acc, k, v)" ""
                 "      _, acc ->" "        acc" "    end)" "  end" "" "  if Mix.env() == :test do"
                 "    def debug, do: :on" "  end" "end" ""]
    "\n"))

(describe "elixir indents a real module exactly as mix format does"
  (defn ex-indent-mismatches (text file)
    "`[line :want w :got g trimmed]` for every line the indenter disagrees with, so a
failure names the line rather than answering false."
    (let (svc (model/ed-mode-service (cur (file-cm text file)) :indent)
          lines (into [] (string/split text "\n"))
          bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1)))))
      (into []
        (seq/keep (range (count lines))
          (fn (i)
            (let (l (nth lines i ""))
              (when (not (= (string/trim l) ""))
                (let (want (- (string/length l) (string/length (string/triml l)))
                      got (svc text (bol-of i)))
                  (when (not (= want got)) [(inc i) :want want :got got (string/trim l)])))))))))

  (test "every line of it"
    (assert= (ex-indent-mismatches ex-real-module "real.ex") []))

  ;; and from flush left, which is the state you are in pasting code or typing a module
  (test "and re-indenting it from flush left reproduces it"
    (let (flat (string/join (map (string/split ex-real-module "\n") string/triml) "\n"))
      (refute (= flat ex-real-module))
      (assert= (reindent (model/ed-mode-service (cur (file-cm ex-real-module "real.ex")) :indent)
                 flat)
        ex-real-module))))

;; ---- every structural key, in every language ---------------------------------
;; The bug this exists for has now happened three times, always the same way: a command
;; written to be mode-POLYMORPHIC (it dispatches on the buffer's `:ts-lang` and works
;; over a tree-sitter tree) gets bound on `brood-keymap`, where no `.ex` buffer can reach
;; it. RET was one. `C-M-SPC` (mark-sexp) was another — its own docstring said "in a
;; tree-sitter mode it marks a tree-sitter node" while sitting somewhere no such mode
;; could see. Each was found by someone pressing the key.
;;
;; So this asserts the property rather than the instances: for EVERY key that
;; `prog-structural-keymap` binds, every tree-sitter mode resolves it to the same command
;; — and the polymorphic ones actually do something to a real buffer of that language.

(def prog-keys-expected
  ;; the keys `prog-structural-keymap` binds, spelled as the keymap spells them
  [[:enter 'commands/cmd-newline-and-indent]
    [:ctrl-meta-f 'commands/cmd-forward-sexp]
    [:ctrl-meta-b 'commands/cmd-backward-sexp]
    [:ctrl-meta-n 'commands/cmd-forward-list]
    [:ctrl-meta-p 'commands/cmd-backward-list]
    [:ctrl-meta-u 'commands/cmd-backward-up-list]
    [:ctrl-meta-d 'commands/cmd-down-list]
    [:ctrl-meta-a 'commands/cmd-beginning-of-defun]
    [:ctrl-meta-e 'commands/cmd-end-of-defun]
    [:ctrl-meta-k 'commands/cmd-kill-sexp]
    [:ctrl-meta-q 'commands/cmd-indent-sexp]
    [(keyword "ctrl-meta- ") 'commands/cmd-mark-sexp]
    [(keyword "ctrl-meta-@") 'commands/cmd-mark-sexp]])

;; one small, valid buffer per tree-sitter language
(def prog-mode-samples
  [["a.ex" "defmodule A do\n  def one(x) do\n    x + 1\n  end\nend\n" "elixir"]
    ["a.rb" "class A\n  def one(x)\n    x + 1\n  end\nend\n" "ruby"]
    ["a.blsp" "(defn one (x)\n  (+ x 1))\n" "brood"]])

;; Resolving is not working — pressing the key is. These press each one on a real buffer
;; of each language and assert the buffer moved or changed, which is what "does not work
;; in elixir" means when someone reports it.

(describe "the structural keys DO something in each language"
  (defn prog-at (file text needle)
    (let (m (ed-init (make-buffer text file file))
          i (model/ed-current-index m)
          pos (index-of text needle))
      (assoc m :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) pos)))))

  (test "C-M-f moves point forward in every language"
    (is (every? prog-mode-samples
          (fn (s)
            (let (m (prog-at (nth s 0) (nth s 1) "one")
                  before (buffer-point (cur m))
                  after (buffer-point (cur (ed-update m :ctrl-meta-f 80 24))))
              (> after before))))))

  (test "C-M-SPC marks a region in every language — the reported failure"
    (is
      (every? prog-mode-samples
        (fn (s)
          (let (m (prog-at (nth s 0) (nth s 1) "one")
                b (cur (ed-update m (keyword "ctrl-meta- ") 80 24)))
            ;; a mark was set, past point, so a region is active and non-empty
            (let (mk (:mark b)) (and (int? mk) (> mk (buffer-point b)))))))))

  (test "C-M-d descends in every language"
    (is
      (every? prog-mode-samples
        (fn (s)
          (let (m (prog-at (nth s 0) (nth s 1) (nth s 1)) ; point 0
                before (buffer-point (cur m))
                after (buffer-point (cur (ed-update m :ctrl-meta-d 80 24))))
            (> after before))))))

  (test "C-M-e ends the defun in every language"
    (is (every? prog-mode-samples
          (fn (s)
            (let (m (prog-at (nth s 0) (nth s 1) "x + 1")
                  before (buffer-point (cur m))
                  after (buffer-point (cur (ed-update m :ctrl-meta-e 80 24))))
              (>= after before)))))))

;; ---- a bulk reindent leaves blank lines alone --------------------------------
;; Reindenting used to put the block's indentation on every BLANK line too, which is
;; invisible on screen and a line in the diff: reindenting a `mix.exs` rewrote all three
;; of its blank lines and nothing else, so the change was impossible to see and
;; impossible to miss in review.
;;
;; The column for a blank line is not wrong — RET wants exactly that, since the line is
;; empty precisely because you are about to type there. It is the CALLER that differs, so
;; the rule lives with the bulk reindent rather than with the indenter.
(describe "reindenting does not write whitespace onto blank lines"
  (def rb-mixfile
    (string/join ["defmodule Benefits.MixProject do"
                   "  use Mix.Project" "" "  def project do" "    [" "      app: :benefits,"
                   "      version: \"0.1.0\"" "    ]" "  end" "" "  def cli do" "    ["
                   "      preferred_envs: [precommit: :test]" "    ]" "  end" "end"]
      "\n"))

  (test "reindenting every line of a canonical mix.exs changes nothing at all"
    (let (buf (cur (file-cm rb-mixfile "mix.exs"))
          out (fold (range (buffer-line-count buf)) buf commands/ed-reindent-line-at))
      (assert= (buffer-text out) rb-mixfile)))

  (test "and the blank lines are still empty, not two spaces wide"
    (let (buf (cur (file-cm rb-mixfile "mix.exs"))
          out (fold (range (buffer-line-count buf)) buf commands/ed-reindent-line-at)
          blanks (seq/filter (string/split (buffer-text out) "\n") (fn (l) (= (string/trim l) ""))))
      (is (> (count blanks) 0))
      (is (every? blanks (fn (l) (= l ""))))))

  ;; the other half of the rule: RET still indents the empty line it just made
  (test "but RET still puts you at the right column on the new line"
    (let (src "defmodule A do\n  def f do\n    :ok"
          m (ed-init (make-buffer src "a.ex" "a.ex"))
          i (model/ed-current-index m)
          m1 (assoc m
               :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) (string/length src))))
          after (buffer-text (cur (ed-update m1 :enter 80 24))))
      (assert= (last (string/split after "\n")) "    "))))

;; ---- navigation across comments and ghost text -------------------------------
;; Two things sit on the screen that are NOT the program, and a structural motion has to
;; treat them differently:
;;
;;   a COMMENT is in the buffer but is not a form — Emacs gives comments whitespace
;;   syntax so `forward-sexp` steps over them, while a tree-sitter tree makes them
;;   ordinary named nodes, so `C-M-f` from a comment used to land at the comment's end
;;   and `C-M-b` from a definition used to land ON the comment above it;
;;
;;   GHOST TEXT (a `:eol-notes` annotation — a playground result, a type hint) is on the
;;   screen but not in the buffer at all, so it must not move point, motion or the
;;   cursor's column by one character.

(def nav-commented
  (string/join ["defmodule A do"
                 "  # a leading comment" "  def one(x) do" "    x + 1  # trailing" "  end" "end"]
    "\n"))

(defn nav-at (text file pos)
  (let (m (ed-init (make-buffer text file file))
        i (model/ed-current-index m))
    (assoc m :buffers (assoc (:buffers m) i (goto-char (ed-buf-at m i) pos)))))

(defn nav-press (text file pos k)
  (buffer-point (cur (ed-update (nav-at text file pos) k 80 24))))

(describe "structural motion steps over comments, not into them"
  (test "C-M-f from a comment moves over the FORM after it, not to the comment's end"
    (let (at-comment (index-of nav-commented "# a leading")
          after (nav-press nav-commented "a.ex" at-comment :ctrl-meta-f)
          end-of-comment (index-of nav-commented "\n  def one"))
      ;; it must get past the whole `def one … end`, so well beyond the comment
      (is (> after (index-of nav-commented "  end")))
      (refute (= after end-of-comment))))

  (test "C-M-b from a definition does not stop on the comment above it"
    (let (at-def (index-of nav-commented "def one")
          before (nav-press nav-commented "a.ex" at-def :ctrl-meta-b)
          at-comment (index-of nav-commented "# a leading"))
      (refute (= before at-comment))))

  (test "a trailing comment does not become the next form"
    (let (at-expr (index-of nav-commented "x + 1")
          after (nav-press nav-commented "a.ex" at-expr :ctrl-meta-f))
      ;; over `x + 1`, not stopping at the `# trailing` that follows it on the line
      (is (>= after (+ at-expr 5)))
      (refute (= after (+ (index-of nav-commented "# trailing") (string/length "# trailing"))))))

  ;; and the comment is still COLOURED as a comment — skipping it for motion must not
  ;; make it invisible to fontify, which is a different service entirely
  (test "comments are still fontified"
    (let (spans (languages/elixir-fontify nav-commented)
          comment-face (editor/face/face :syntax/comment))
      (is (>= (count (seq/filter spans (fn (s) (= (nth s 2) comment-face)))) 2)))))

(describe "ghost text is on the screen, not in the buffer"
  (def nav-plain "defmodule A do\n  def one(x) do\n    x + 1\n  end\nend\n")

  (defn nav-with-note (m)
    (let (i (model/ed-current-index m))
      (assoc m
        :buffers
          (assoc (:buffers m)
            i (results/set-note (ed-buf-at m i) 0 {:text " => 6" :kind :info} 2)))))

  (test "a note changes nothing about point, motion, column or text"
    (let (pos (index-of nav-plain "x + 1")
          plain (nav-at nav-plain "a.ex" pos)
          noted (nav-with-note plain)
          fwd (fn (m) (buffer-point (cur (ed-update m :ctrl-meta-f 80 24))))
          col (fn (m) (view/ed-visual-column (cur m))))
      (assert= (buffer-point (cur noted)) (buffer-point (cur plain)))
      (assert= (fwd noted) (fwd plain))
      (assert= (col noted) (col plain))
      (assert= (buffer-text (cur noted)) (buffer-text (cur plain)))))

  ;; …while still being drawn: an invariant that held by accident would be worth nothing.
  ;; It WAS vacuous: the note here was stored bare, without the `:line` `set-note` stamps,
  ;; so the frame threw and rendered as `render error` — which differs from the plain frame
  ;; too. So: the note's own text is painted, and nothing failed.
  (test "but it IS drawn, so the test above is not vacuous"
    (let (pos (index-of nav-plain "x + 1")
          plain (nav-at nav-plain "a.ex" pos)
          noted (nav-with-note plain)
          painted (str (ed-view noted 80 24)))
      (is (includes? painted "=> 6"))
      (refute (includes? painted "render error"))))

  ;; and a note stored WITHOUT a line — any producer that skips `set-note` — costs that note,
  ;; not the frame: one bad note used to blank the editor behind `render error`
  (test "a note with no line is skipped, not a render error"
    (let (plain (nav-at nav-plain "a.ex" 0)
          i (model/ed-current-index plain)
          bare (assoc plain
                 :buffers
                   (assoc (:buffers plain)
                     i (editor/buffer/annotate (ed-buf-at plain i) :eol-notes {2 {:text " => 6"}})))
          painted (str (ed-view bare 80 24)))
      (refute (includes? painted "render error"))
      (is (includes? painted "defmodule")))))

;; ---- elisp-mode: a Lisp needs no grammar ------------------------------------
;; The point of this mode is partly that it is almost free. `brood-mode` was never
;; tree-sitter-backed — structural motion is `std/sexp`, which is delimiter matching and
;; knows no dialect, and `editor/highlight` is a generic Lisp lexer with exactly one
;; dialect-specific decision (is this head a special form?). So a second Lisp is that set,
;; a file pattern, and an indent rule. `deflisp` is that declaration; these tests are
;; whether the claim holds on a real `init.el`.

(def el-init
  (string/join [";;; init.el --- my config  -*- lexical-binding: t; -*-"
                 "" "(require 'package)" "" "(defvar my/font \"Iosevka\""
                 "  \"Preferred font family.\")" "" "(defun my/setup-ui ()"
                 "  \"Configure the frame.\"" "  (let ((height 140))"
                 "    (set-face-attribute 'default nil" "                        :family my/font"
                 "                        :height height)" "    (when (display-graphic-p)"
                 "      (tool-bar-mode -1))))" "" "(use-package magit"
                 "  :bind ((\"C-x g\" . magit-status))" "  :config"
                 "  (setq magit-diff-refine-hunk 'all))" ""
                 "(add-hook 'after-init-hook #'my/setup-ui)"]
    "\n"))

(describe "elisp-mode"
  (test "an .el file gets it"
    (assert= (ed-buf-mode-name (cur (file-cm el-init "init.el"))) "elisp"))

  (test "it colours comments, strings and special-form heads"
    (let (faces (into #{} (map (lisp-modes/elisp-fontify el-init) (fn (s) (nth s 2)))))
      (is (contains? faces (editor/face/face :syntax/comment)))
      (is (contains? faces (editor/face/face :syntax/string)))
      ;; `defun`/`let`/`when` paint as keywords — the elisp set, not Brood's
      (is (contains? faces (editor/face/face :syntax/special)))))

  ;; the whole claim: the structural keys work without elisp being mentioned anywhere
  ;; near them, because `ed-structural` picks the sexp backend by the ABSENCE of :ts-lang
  (test "C-M-f steps over a whole top-level form"
    (let (p (index-of el-init "(defun my/setup-ui")
          m (nav-at el-init "init.el" p)
          after (buffer-point (cur (ed-update m :ctrl-meta-f 80 24))))
      (is (> after (index-of el-init "(tool-bar-mode")))
      (is (< after (index-of el-init "(use-package")))))

  (test "C-M-SPC marks one"
    (let (m (nav-at el-init "init.el" (index-of el-init "(require"))
          b (cur (ed-update m (keyword "ctrl-meta- ") 80 24)))
      (is (not (nil? (:mark b))))
      (is (> (or (:mark b) 0) (buffer-point b)))))

  ;; Emacs' rule, which differs from Brood's in the one place a config is full of: a
  ;; special form's body indents +2, a plain CALL's arguments align under the first
  ;; argument. `set-face-attribute` below is the call; `when` is the special form.
  (test "it indents a real init.el exactly as Emacs does"
    (let (svc (model/ed-mode-service (cur (file-cm el-init "init.el")) :indent)
          lines (into [] (string/split el-init "\n"))
          bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1))))
          bad (seq/keep (range (count lines))
                (fn (i)
                  (let (l (nth lines i ""))
                    (when (not (= (string/trim l) ""))
                      (let (want (- (string/length l) (string/length (string/triml l)))
                            got (svc el-init (bol-of i)))
                        (when (not (= want got)) [(inc i) :want want :got got (string/trim l)])))))))
      (assert= (into [] bad) [])))

  (test "and the two rules really are different — the call aligns, the special form does not"
    (let (svc (model/ed-mode-service (cur (file-cm el-init "init.el")) :indent)
          lines (into [] (string/split el-init "\n"))
          bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1))))
          line-with (fn (needle)
                      (or (seq/find (range (count lines))
                            (fn (i) (includes? (nth lines i "") needle)))
                        (error "init.el has no line with " needle)))
          call-arg (line-with ":family")
          body (line-with "(tool-bar-mode"))
      ;; aligned under `'default`, far right — not a multiple of 2 from the open paren
      (assert= (svc el-init (bol-of call-arg)) 24)
      ;; a `when` body, two in from its open paren
      (assert= (svc el-init (bol-of body)) 6))))

(describe "shell-mode — by extension, by name, and by the #! line"
  (test "a .sh file and a dotfile are shell; a bare name is not"
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/p/build.sh"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/home/u/.bashrc"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/p/run"))
      :fundamental))
  (test "an extensionless script with a bash shebang is shell (interpreter-mode-alist)"
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env bash\nset -euo pipefail\n"
                                                     "run")
                                              :file "/p/run"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/bin/sh\necho hi\n" "run")
                                              :file "/p/run"))
      :shell)
    ;; the filename rule wins over the shebang, and a non-shell shebang stays fundamental
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env bash\n" "n.md")
                                              :file "/p/n.md"))
      :markdown)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env perl\n" "t")
                                              :file "/p/t"))
      :fundamental))
  ;; the line lexer is shell's stand-in while bash's grammar is missing
  ;; (tests/lexed_languages_test.blsp); here it is asked for, whatever is installed
  (test "the shell layer fontifies through the shared spans shape"
    (let (m (binding (*grammar-ready?* (fn (lang) false))
              (ed-open-buffer (m-of "") (make-buffer "echo \"$HOME\" # hi" "/p/s.sh" "/p/s.sh")))
          fontify (ed-mode-service (ed-current-buf m) :fontify))
      (is (fn? fontify))
      (assert= (map (fontify "echo \"$HOME\" # hi") (fn ([s e _]) [s e]))
        (list [0 4] [5 12] [13 17])))))

(describe "brood-indent — a labelled body (an asm listing) indents like nest format"
  ;; labels at the body column (+2 from the open), instructions +2 beyond them, and
  ;; the rule holds for an instruction BEFORE the first label — the whole form decides
  (test "labels at +2, instructions at +4, including one before the first label"
    (let (src "(def image\n  (aarch64/asm\n(mov x0 uart)\nnext:\n(ldrb w2 x1)\ndone:\n(b done)))"
          bol-of (fn (line)
                   (nth (fold (string/split src "\n")
                          [0 (list)]
                          (fn ([off acc] l) [(+ off (string/length l) 1) (cons off acc)]))
                     1))
          bols (reverse (bol-of 0))
          bol (fn (line) (or (nth bols line) (error "no line " line))))
      (assert= (brood-mode/brood-indent src (bol 2)) 6) ; (mov …) — before any label
      (assert= (brood-mode/brood-indent src (bol 3)) 4) ; next:
      (assert= (brood-mode/brood-indent src (bol 4)) 6) ; (ldrb …)
      (assert= (brood-mode/brood-indent src (bol 5)) 4) ; done:
      (assert= (brood-mode/brood-indent src (bol 6)) 6))) ; (b done)
  (test "a body without a label keeps the plain +2 rule, and a keyword is not a label"
    (assert= (brood-mode/brood-indent "(f :a\n(g))" 6) 2)
    (assert= (brood-mode/brood-indent "(f\n:next\n(g))" 3) 2)))

;; wos-mode (.wos): the language mode with a DIFFERENT keyword set over the same
;; reader. wos (the OS in ../../wos) is read by Brood's reader but its heads are
;; `var`/`loop`/`out8`, not `defn`/`let`/`when` — so the claim under test is that
;; the structural half carries over untouched while the semantic half does not.
(def wos-kernel
  (string/join ["(program"
                 "  (var cursor (addr message))" "  (loop" "    (var byte (load8 cursor))"
                 "    (when-zero byte (break))" "    (out8 uart byte)"
                 "    (set cursor (add cursor (const 1))))" "  (halt))"]
    "\n"))

(describe "wos-mode (.wos files)"
  (test "a .wos file gets it, and a .blsp file still gets brood"
    (assert= (ed-buf-mode-name (cur (file-cm wos-kernel "hello.wos"))) "wos")
    (assert= (ed-buf-mode-name (cur (file-cm "(defn f () 1)" "hello.blsp"))) "brood"))

  (test "the trigger is anchored — hello.wos.txt is not wos-mode"
    (assert= (ed-buf-mode-name (cur (file-cm wos-kernel "hello.wos.txt"))) "text"))

  ;; The whole of the change: one lexer, two keyword sets. `loop` is a wos statement
  ;; and colours as a keyword there; in a .blsp buffer it is an ordinary call, since
  ;; Brood has no `loop` (trap #2 — you iterate by recursion).
  (test "wos heads colour as keywords, and Brood's fontify does not colour them"
    (let (head-face (fn (fontify src head)
                      (let (at (index-of src head)
                            span (seq/find (fontify src) (fn (s) (= (first s) at))))
                        (when span (nth span 2))))
          special (editor/face/face :syntax/special))
      (assert= (head-face lisp-modes/wos-fontify wos-kernel "loop") special)
      (is (not (= (head-face editor/highlight/highlight-spans wos-kernel "loop") special)))))

  (test "Brood's own special forms do NOT colour as keywords in a .wos buffer"
    (let (src "(defn f () 1)"
          span (seq/find (lisp-modes/wos-fontify src) (fn (s) (= (first s) 1))))
      (is (not (= (when span (nth span 2)) (editor/face/face :syntax/special))))))

  ;; Structural navigation, bracket matching and indent are brood-mode's, and they
  ;; are about s-expressions rather than about Brood — so they carry over as they are.
  (test "C-M-f steps over a whole form"
    (let (m (nav-at wos-kernel "hello.wos" (index-of wos-kernel "(var cursor")))
      (assert= (buffer-point (cur (ed-update m :ctrl-meta-f 80 24)))
        (+ (index-of wos-kernel "(var cursor")
          (count (string/->list "(var cursor (addr message))"))))))

  (test "C-M-SPC marks one"
    (let (m (nav-at wos-kernel "hello.wos" (index-of wos-kernel "(loop"))
          b (cur (ed-update m (keyword "ctrl-meta- ") 80 24)))
      (is (> (or (:mark b) 0) (buffer-point b)))))

  ;; Deliberately absent, and asserted absent: `out8` is not a Brood function, so an
  ;; eldoc hint or a completion list over Brood's globals would answer confidently
  ;; about the wrong language. A mode that says nothing beats one that lies.
  (test "it offers no Brood language services"
    (let (b (cur (file-cm wos-kernel "hello.wos")))
      (is (nil? (model/ed-mode-service b :eldoc)))
      (is (nil? (model/ed-mode-service b :complete-at)))
      (is (nil? (model/ed-mode-service b :diagnostics)))
      ;; …while the structural ones are all there
      (is (not (nil? (model/ed-mode-service b :fontify))))
      (is (not (nil? (model/ed-mode-service b :indent))))
      (is (not (nil? (model/ed-mode-service b :bracket-match)))))))

;; ---- the :on-move facet (layers §7): followers see a MOVE, never an event ----------
;; A `:post-key` guard runs on every event — a mouse gesture can edit, so it must. A pane
;; that follows the cursor used to ride that facet and re-asserted its position on events
;; that moved nothing: the wheel over the markdown preview snapped the preview straight
;; back. The dispatcher now runs `:on-move` only when point or the text changed, so no
;; follower has to remember where it was. These pin the gate itself, with a counting layer.
(defn move-probe (m) (update m :moves (fn (n) (inc (or n 0)))))
(def move-layer {:name 'move-probe :on-move 'modes-test/move-probe})
(defn move-model (text)
  (ed-set-buf (m-of "") (editor/layers/push-layer (make-buffer text) 'modes-test/move-layer)))
(defn moves (m) (or (:moves m) 0))

(describe "the :on-move facet fires on a move of point or text, not on every event"
  (test "a cursor motion and an edit each count once; a self-insert is one move"
    (let (m (move-model "abc\ndef")
          moved (press m [:ctrl-f])
          typed (press moved ["x"]))
      (assert= (moves m) 0)
      (assert= (moves moved) 1)
      (assert= (moves typed) 2)))
  (test "an event that moves nothing is not a move: a wheel notch, C-g, M-< at the top"
    (let (m (move-model (string/join (map (range 80) (fn (i) (str "line " i))) "\n"))
          ;; point mid-screen, so the notches scroll without carrying it along
          mid (ed-set-buf m (goto-char (ed-current-buf m) 60))
          wheeled (press mid
                    [[:mouse :scroll-down :none 5 10 []] [:mouse :scroll-down :none 5 10 [] 1.0]])
          quit (press m [:ctrl-g])
          stayed (press m [(keyword "alt-<")]))
      (assert= (moves wheeled) 0)
      (assert= (moves quit) 0)
      (assert= (moves stayed) 0)))
  (test "a wheel notch that carries point along IS a move — a follower should follow it"
    (let (m (move-model (string/join (map (range 80) (fn (i) (str "line " i))) "\n"))
          wheeled (press m [[:mouse :scroll-down :none 5 10 []]]))
      (assert= (moves wheeled) 1)))
  (test "a click that moves point is a move; the pane's scroll alone is not"
    (let (m (move-model "abc\ndef\nghi")
          clicked (press m [[:mouse :press :left 1 5 []]]))
      (assert= (moves clicked) 1))))

;; ---- lisp-mode: Common Lisp, the same argument as elisp ----------------------------
(def cl-src
  (string/join ["(defpackage :greet"
                 "  (:use :cl))" "(in-package :greet)" ""
                 ";; a function with a docstring and a loop"
                 "(defun greet (names &key (greeting \"Hello\"))" "  \"Greet each of NAMES.\""
                 "  (dolist (name names)" "    (format t \"~a, ~a!~%\" greeting name)))" ""
                 "(defclass person ()" "  ((name :initarg :name :accessor person-name)))" ""
                 "(make-instance 'person" "               :name \"Ada\")"]
    "\n"))

(describe "lisp-mode"
  (test ".lisp / .cl / .asd files get it"
    (assert= (ed-buf-mode-name (cur (file-cm cl-src "greet.lisp"))) "lisp")
    (assert= (ed-buf-mode-name (cur (file-cm cl-src "greet.cl"))) "lisp")
    (assert= (ed-buf-mode-name (cur (file-cm cl-src "greet.asd"))) "lisp"))
  (test "it colours comments, strings and the Common Lisp heads"
    (let (spans (lisp-modes/lisp-fontify cl-src)
          faces (into #{} (map spans (fn (s) (nth s 2))))
          at (fn (word)
               (let (p (index-of cl-src word))
                 (seq/find spans (fn ([s e f]) (and (<= s p) (< p e)))))))
      (is (contains? faces (editor/face/face :syntax/comment)))
      (is (contains? faces (editor/face/face :syntax/string)))
      ;; `defpackage` / `dolist` are Common Lisp's, not Brood's or elisp's
      (assert= (nth (at "defpackage") 2) (editor/face/face :syntax/special))
      (assert= (nth (at "dolist") 2) (editor/face/face :syntax/special))))
  (test "it indents like Emacs's lisp-mode: a special form's body +2, a call's args aligned"
    (let (svc (model/ed-mode-service (cur (file-cm cl-src "greet.lisp")) :indent)
          lines (into [] (string/split cl-src "\n"))
          bol-of (fn (i) (fold (range i) 0 (fn (a k) (+ a (string/length (nth lines k "")) 1))))
          bad (seq/keep (range (count lines))
                (fn (i)
                  (let (l (nth lines i ""))
                    (when (not (= (string/trim l) ""))
                      (let (want (- (string/length l) (string/length (string/triml l)))
                            got (svc cl-src (bol-of i)))
                        (when (not (= want got)) [(inc i) :want want :got got (string/trim l)])))))))
      (assert= (into [] bad) [])))
  (test "C-M-f steps over a whole top-level form"
    (let (p (index-of cl-src "(defun greet")
          m (nav-at cl-src "greet.lisp" p)
          after (buffer-point (cur (ed-update m :ctrl-meta-f 80 24))))
      (is (> after (index-of cl-src "greeting name)))")))
      (is (< after (index-of cl-src "(defclass"))))))

;; ---- the other Lisps and the configuration formats --------------------------------
(describe "clojure / scheme / fennel modes"
  (test "the file patterns route, and each dialect's heads paint as specials"
    (assert= (ed-buf-mode-name (cur (file-cm "(ns x)" "core.cljs"))) "clojure")
    (assert= (ed-buf-mode-name (cur (file-cm "{}" "deps.edn"))) "clojure")
    (assert= (ed-buf-mode-name (cur (file-cm "(define x 1)" "main.rkt"))) "scheme")
    (assert= (ed-buf-mode-name (cur (file-cm "(fn f [] 1)" "init.fnl"))) "fennel")
    (let (special (editor/face/face :syntax/special)
          head-face (fn (spans src word)
                      (let (p (index-of src word))
                        (nth (seq/find spans (fn ([s e f]) (and (<= s p) (< p e)))) 2))))
      (assert= (head-face (lisp-modes/clojure-fontify "(defn f [x] (->> x))")
                 "(defn f [x] (->> x))" "defn")
        special)
      (assert= (head-face (lisp-modes/clojure-fontify "(defn f [x] (->> x))")
                 "(defn f [x] (->> x))" "->>")
        special)
      (assert= (head-face (lisp-modes/scheme-fontify "(define-syntax m)")
                 "(define-syntax m)" "define-syntax")
        special)
      (assert= (head-face (lisp-modes/fennel-fontify "(icollect [_ v (ipairs t)] v)")
                 "(icollect [_ v (ipairs t)] v)" "icollect")
        special)))
  (test "Scheme indents like lisp-mode: a define's body +2, a call's arguments aligned"
    (let (src "(define (f x)\n  (+ x\n     1))"
          svc (model/ed-mode-service (cur (file-cm src "a.scm")) :indent))
      (assert= (svc src (inc (index-of src "\n"))) 2)
      (assert= (svc src (inc (string/last-index-of src "\n"))) 5))))

(describe "the configuration-format modes"
  (test "each format routes by extension or by its extensionless name"
    (assert= (ed-buf-mode-name (cur (file-cm "{}" "package.json"))) "json")
    (assert= (ed-buf-mode-name (cur (file-cm "a: 1" "ci.yml"))) "yaml")
    (assert= (ed-buf-mode-name (cur (file-cm "a = 1" "Cargo.toml"))) "toml")
    (assert= (ed-buf-mode-name (cur (file-cm "a = 1" "Cargo.lock"))) "toml")
    (assert= (ed-buf-mode-name (cur (file-cm "all:" "Makefile"))) "makefile")
    (assert= (ed-buf-mode-name (cur (file-cm "[core]" ".gitconfig"))) "ini")
    (assert= (ed-buf-mode-name (cur (file-cm "root = true" ".editorconfig"))) "ini")
    (assert= (ed-buf-mode-name (cur (file-cm "fix: x" "COMMIT_EDITMSG"))) "gitcommit"))
  (test "the mode's :fontify is the std table's, and M-; knows the comment syntax"
    (let (m (file-cm "name: bedit # x" "a.yaml")
          spans ((model/ed-mode-service (cur m) :fontify) "name: bedit # x"))
      (is (any? spans (fn ([s e f]) (= f (editor/face/face :syntax/comment)))))
      (assert= (model/ed-mode-service (cur m) :comment-syntax) "# "))
    (assert= (model/ed-mode-service (cur (file-cm "{}" "x.json")) :comment-syntax) "// ")))

;; ---- the line-oriented modes cut the lead-in entirely ------------------------------
;; A lexer whose tokens never cross a line (shell, the configs, env, docker) can restart at
;; ANY line start, so its `:fontify-restart` is std's `editor/highlight/line-restart` — the
;; viewport's own first line — and the 200-line backscan above it is never lexed. Without
;; one, `.bashrc`'s every keystroke re-lexed the whole windowed lead-in (ADR-352 in brood).
;; Shell and the formats with a grammar are lexed only as the stand-in for their parsed mode,
;; so they are asked for here as a runtime without the grammar would type them.
(describe "line-oriented modes' fontify restart"
  (test "shell, env, docker and the six configuration formats restart at the viewport line"
    (doseq (name [".bashrc"
                   ".env" "Dockerfile" "x.json" "x.yaml" "x.toml" "Makefile" "x.ini"
                   "COMMIT_EDITMSG"])
      (let (restart (binding (*grammar-ready?* (fn (lang) false))
                      (model/ed-mode-service (cur (file-cm "a\nb\nc\n" name)) :fontify-restart)))
        (is (not (nil? restart)))
        (assert= (restart "a\nb\nc\n" 4) 4)))))

;; ---- a mode service that throws must not swallow the event -------------------------
;; The loop tail refreshes the span cache after every event. A `:fontify-restart` naming
;; an unbound function threw there, the dispatch guard kept the PRE-event model, and every
;; input — the window's close request included — vanished (2026-09-15). The refresh is
;; guarded on its own now: the error is echoed, the command's model stands.
(describe "a throwing fontify service does not veto the event"
  (def broken-layer
    {:name 'broken :fontify 'lex-shell/shell-spans :fontify-restart 'no/such-restart})
  (defn broken-fontify-model ()
    (ed-set-buf (m-of "")
      (editor/layers/push-layer (make-buffer "echo hi\n" "s.txt" "s.txt") 'modes-test/broken-layer)))
  (test "the close request still quits, and the failure is reported"
    (let (m (ed-update (assoc (broken-fontify-model) :close-is-input? true) :close 80 24))
      (is (:done m))))
  (test "a keystroke still lands, with the error in the echo area"
    (let (m (ed-update (broken-fontify-model) "x" 80 24))
      (assert= (buffer-text (cur m)) "xecho hi\n")
      (is (includes? (str (:echo m)) "fontify error")))))

;; ---- how much room a ghost note gets --------------------------------------------
;; A result or a type is a GLANCE and stays capped, so the right of the screen keeps its
;; shape. A raise is the ANSWER, and the cap took exactly the half worth having:
;; `** (FunctionClauseError) no function clause matching in String.upcase/1` cut at 64
;; columns keeps the words every raise shares and drops the function that raised.
(describe "an error note is not clipped to the glance budget"
  (defn avail-for (kind room) (view/ed-eol-note-avail {:kind kind :text "x"} room))

  (test "a failure takes the whole row; a result and a type stay capped"
    (assert= (avail-for :fail 200) 200)
    (assert= (avail-for :info 200) view/*eol-note-max-cols*)
    (assert= (avail-for :hint 200) view/*eol-note-max-cols*)
    (assert= (avail-for :warn 200) view/*eol-note-max-cols*))

  (test "the row is still the limit — a failure cannot paint past the pane"
    (assert= (avail-for :fail 12) 12))

  (test "the long ExUnit-style banner now reaches its useful half"
    (let (msg "** (FunctionClauseError) no function clause matching in String.upcase/1"
          note {:kind :fail :text msg})
      ;; capped, the visible text stopped before the function name; uncapped it arrives
      (is (> (string/length msg) view/*eol-note-max-cols*))
      (is (includes? (ui-kit/ui-clip msg (view/ed-eol-note-avail note 120)) "String.upcase/1"))
      (is (not (includes? (ui-kit/ui-clip msg view/*eol-note-max-cols*) "String.upcase/1"))))))

;; The bracket pair is memoised (view `ed-bracket-overrides-at`) — and its faces are part of
;; the key. They were not: the cache keyed on rope and point alone, so after a theme switch
;; the pair kept the OLD theme's colours until point moved.
(describe "the bracket pair repaints on a theme switch"
  :isolated (test "the same buffer and point, a new theme: the new theme's faces"
    (let (buf (ed-current-buf (blsp-cm "(+ 1 2)" 1))
          mocha (ed-bracket-overrides buf)
          _ (theme/theme-apply! themes/*tokyo*)
          tokyo-match theme/face-bracket-match
          tokyo (ed-bracket-overrides buf)
          _ (theme/theme-apply! theme/*theme-mocha*))
      (is (not (= mocha tokyo)))
      (is (includes? (map tokyo second) tokyo-match)))))

;; A special buffer's `:commands` (what M-x offers only there, and subtracts from every
;; other buffer) is DERIVED from its keymap now (`modes/layer-commands`). These are the
;; lists the layers used to spell out by hand — derivation must name exactly the same set.
(describe "special buffer types: M-x names come from the keymap"
  (test "each derived list is the hand-written one it replaced"
    (let (same? (fn (layer names) (= (sort (:commands layer)) (sort names))))
      (is (same? beam/beam-menu-layer ["beam-refresh" "beam-auto-refresh" "beam-kill"]))
      (is (same? beam/beam-read-layer ["beam-refresh" "beam-auto-refresh"]))
      (is (same? beam/beam-spy-layer ["beam-untrace"]))
      (is (same? beam/beam-debug-layer ["beam-resume" "beam-refresh"]))
      (is (same? debugger/debug-menu-mode-layer
            ["debug-resume" "debug-resume-all" "debug-eval" "debug-refresh"]))
      (is (same? apprun/run-log-mode-layer ["run-stop"]))
      (is (same? testrun/test-menu-mode-layer ["test-rerun"]))
      (is (same? modes/process-menu-mode-layer
            ["process-menu-kill" "process-menu-refresh" "process-menu-toggle-tree"]))
      (is (same? modes/buffer-menu-mode-layer ["buffer-menu-select" "buffer-menu-refresh"]))
      (is (same? packages/packages-mode-layer
            ["package-install" "package-remove" "package-update" "package-refresh" "package-quit"]))
      (is (same? dired/dired-mode-layer
            ["dired-open"
              "dired-up" "dired-refresh" "dired-quit" "dired-create-dir" "dired-rename" "dired-copy"
              "dired-delete" "dired-flag" "dired-do-flagged-delete" "dired-mark" "dired-unmark"
              "dired-unmark-all" "dired-toggle-marks" "dired-next-line" "dired-previous-line"
              "dired-sort-toggle-or-edit"]))))
  (test ":extra claims an unbound name, :except leaves a bound one global"
    (let (keymap {"g" 'beam/cmd-beam-refresh "n" 'commands/cmd-next-line})
      (assert= (vec (modes/layer-commands keymap)) ["beam-refresh" "next-line"])
      (assert= (vec (modes/layer-commands keymap {:except ["next-line"] :extra ["diagnostics"]}))
        ["beam-refresh" "diagnostics"])))
  (test "a special type stacks its layers over special-mode over text-mode"
    (assert= (vec (editor/layers/layers-for-type :run-log))
      ['apprun/run-log-mode-layer
        'results/location-jump-layer 'modes/special-mode-layer 'modes/text-mode-layer])))

(describe "fontify-lines threads each line's offset"
  (test "spans per line, in order, at the line's offset in the slice"
    (assert= (vec (modes/fontify-lines "ab\ncd\n\nefg"
                    (fn (line offset)
                      (if (= line "") '() [[offset (inc offset) :a] [(inc offset) (+ offset 2) :b]]))))
      [[0 1 :a] [1 2 :b] [3 4 :a] [4 5 :b] [7 8 :a] [8 9 :b]]))
  (test "fontify-line-faces is the one-face-per-line case of it"
    (assert= (vec (modes/fontify-line-faces "x\nyy\nz" (fn (line) (when (= line "yy") :face))))
      [[2 4 :face]])))

;; A large tree-sitter buffer's tree trails the text while it is reparsed off the loop
;; (`syntaxtree`); its band is carried across the edits by moving each span with its text.
(describe "a band carried across edits while its tree is behind"
  (test "a span after an edit moves, one an insertion lands in grows, one a deletion takes goes"
    (let (spans [[0 3 :keyword] [4 7 :name] [10 12 :string]])
      (assert= (ed-shift-spans spans [[1 1 "ab"]]) [[0 5 :keyword] [6 9 :name] [12 14 :string]])
      (assert= (ed-shift-spans spans [[3 8 ""]]) [[0 3 :keyword] [5 7 :string]])
      (assert= (ed-shift-spans spans [[5 6 "xyz"]]) [[0 3 :keyword] [4 9 :name] [12 14 :string]])
      ;; several splices, each against the text the one before it left; typed at a span's
      ;; start, the text goes before it
      (assert= (ed-shift-spans spans [[0 0 "x"] [1 1 "y"]])
        [[2 5 :keyword] [6 9 :name] [12 14 :string]])
      (assert= (ed-shift-spans spans []) spans))))

;; The `:indent` contract hands every indenter the buffer's ROPE (brood ADR-488): RET in a
;; large .blsp or .el file copies the enclosing form out, never the buffer. The column must be
;; the string's at every line — over docstrings with column-0 brackets, comments, a labelled
;; body, an unclosed form, multi-byte text — and on a rope that went through edits.
(def- rope-indent-fixture
  (str "(defn f (x)\n  \"Doc with a\n(column-0 bracket) and a ; semicolon\"\n"
    "  (let (a 1\n        b 2)\n    ; (comment) [x\n    {:k \"é\"\n     :j 2}\n"
    "    (asm\n      top:\n        (mov a b)\n      next:\n        (jmp top))))\n"
    "(defun g (y)\n  (when y\n    (message \"(%s\" y)\n    (list y\n          y)))\n"
    "(unclosed (form\n  here"))

(defn- rope-indent-lines (text)
  ;; the start offset of every line of `text`
  (fold (string/->list text)
    [[0] 0]
    (fn (acc c)
      (let ([starts i] acc)
        [(if (= c "\n") (conj starts (inc i)) starts) (inc i)]))))

(describe "Lisp indenters over a rope: the string's column at every line"
  (test "brood-indent, elisp-indent and lisp-indent agree on a rope from a string and from edits"
    (let (text rope-indent-fixture
          from-string (text/from-string text)
          middle (math/quot (string/length text) 2)
          ;; the same text, reached by deleting a stretch and typing it back
          edited (text/insert (text/delete from-string middle (+ middle 9))
                   middle
                   (string/substring text middle (+ middle 9)))
          starts (first (rope-indent-lines text))
          indenters [brood-mode/brood-indent lisp-modes/elisp-indent lisp-modes/lisp-indent]
          wrong (for (bol starts
                       indent
                       indenters
                       rope
                       [from-string edited]
                       :when (not (= (indent text bol) (indent rope bol))))
                  [bol indent]))
      (assert= (text/->string edited) text)
      (assert= [] (vec wrong))))
  (test "the line geometry reads a rope as it reads the string"
    (let (text "ab\ncd\u{c}(e)\n\nf"
          rope (text/from-string text))
      (assert= (map (range 0 (inc (string/length text))) (fn (i) (ed-line-start-offset text i)))
        (map (range 0 (inc (string/length text))) (fn (i) (ed-line-start-offset rope i))))
      (assert= (map (range 0 (inc (string/length text))) (fn (i) (ed-line-end-offset text i)))
        (map (range 0 (inc (string/length text))) (fn (i) (ed-line-end-offset rope i))))))
  (test "the eldoc region starts at the form around point, read off the rope"
    (let (rope (text/from-string "(a)\n(map f\n x)"))
      (assert= [4 11] (brood-mode/brood-eldoc-region rope 9))
      ;; point just before a form's `(` is not inside it
      (assert= 0 (first (brood-mode/brood-eldoc-region rope 4)))
      (assert= 0 (first (brood-mode/brood-eldoc-region rope 0))))))

;; ---- a markdown fence coloured as its language (brood ADR-489) ----------------------
(describe "a markdown fence's info string names its language"
  (test "the first word, lowercased, through the alias table"
    (assert= (lex-markdown/fence-language "sh") :bash)
    (assert= (lex-markdown/fence-language "Python {.x}") :python)
    (assert= (lex-markdown/fence-language "yml") :yaml)
    (assert= (lex-markdown/fence-language "terraform") :hcl)
    (assert= (lex-markdown/fence-language "blsp") :brood)
    (is (nil? (lex-markdown/fence-language "")))
    (is (nil? (lex-markdown/fence-language "cobol"))))
  (test "an unknown language, or none, keeps the one code colour"
    (let (src "```cobol\nMOVE 1 TO X.\n```\n```\nplain\n```\n")
      (assert= (into [] (modes/markdown-fontify src))
        (into [] (lex-markdown/markdown-spans src)))
      (is (every? (modes/markdown-fontify src) (fn (span) (= (nth span 2) {:fg :green}))))))
  (test "a Brood fence is coloured by Brood's own highlighter"
    (let (src "```blsp\n(defn f (x) \"s\")\n```\n"
          spans (modes/markdown-fontify src))
      (assert= (editor/highlight/face-at spans (index-of src "\"s\""))
        (editor/highlight/face-at (editor/highlight/highlight-spans "\"s\"") 0))))
  (test "a language without a grammar keeps the code colour"
    (let (src "```py\nx = 1\n```\n")
      (assert= (into [] (lex-markdown/markdown-spans src (fn (lang) nil)))
        (into [] (lex-markdown/markdown-spans src))))))

(when (grammars/grammar-loaded? :python)
  (describe "a python fence is python"
    (def fence-src
      (str "# Notes\n\n```python\ndef f():\n    return \"\"\"one\ntwo\"\"\"\n```\n\n*after*\n"))
    (test "the body takes python's faces, a string across lines included"
      (let (spans (modes/markdown-fontify fence-src))
        (assert= (editor/highlight/face-at spans (index-of fence-src "def"))
          (editor/face/face :syntax/keyword))
        ;; `two` is inside a string opened on the line above: the fence is one document
        (assert= (editor/highlight/face-at spans (index-of fence-src "two"))
          (editor/face/face :syntax/string))
        ;; the fence lines and the prose around it are markdown's
        (assert= (editor/highlight/face-at spans (index-of fence-src "```python")) {:fg :green})
        (is (not (nil? (editor/highlight/face-at spans (index-of fence-src "*after*")))))))
    (test "a band from the line cache colours a fence it cuts through as the whole document"
      (let (text (str (string/join (map (range 20) (fn (i) (str "**p" i "**"))) "\n")
                   "\n```py\n"
                   (string/join (map (range 120) (fn (i) (str "x" i " = \"s" i "\""))) "\n")
                   "\n```\n*after*\n"))
        (lc-check (lc-model text "x.md" 60) modes/markdown-fontify)
        (lc-check (lc-model text "x.md" 120) modes/markdown-fontify)))
    (test "an edit inside the fence recolours it"
      (let (text (str "```py\n"
                   (string/join (map (range 40) (fn (i) (str "y" i " = " i))) "\n")
                   "\n```\n")
            m (lc-check (lc-model text "x.md" 0) modes/markdown-fontify))
        (lc-check (press (lc-at-line m 3) ["\""]) modes/markdown-fontify)))))

;; ---- Elixir's ~H sigil is HEEx (brood ADR-489) -------------------------------------
(def heex-src
  "defmodule W do\n  def r(assigns) do\n    ~H\"\"\"\n    <p class=\"a\">{@x}</p>\n    \"\"\"\n  end\n\n  def s, do: ~s(<p>)\nend\n")

(describe "a .heex file is heex-mode"
  (test "the extension, the grammar's source, a well-formed table"
    (assert= (:type (cur (file-cm "" "page.html.heex"))) :heex)
    (assert= (grammars/grammar-source :heex) "https://github.com/phoenixframework/tree-sitter-heex")
    (is (empty? (editor/treesit/face-table-problems languages/heex-face-table)))))

(when (grammars/grammar-loaded? :heex)
  (describe "an Elixir ~H sigil is coloured as HEEx"
    (test "the tag, the attribute and its string take heex-mode's faces"
      (let (spans (languages/elixir-fontify heex-src))
        (assert= (editor/highlight/face-at spans (index-of heex-src "p class"))
          (editor/face/face :syntax/keyword))
        (assert= (editor/highlight/face-at spans (index-of heex-src "class"))
          (editor/face/face :syntax/special))
        (assert= (editor/highlight/face-at spans (index-of heex-src "{@x}"))
          (editor/face/face :syntax/special))
        ;; another sigil keeps Elixir's own colour
        (assert= (editor/highlight/face-at spans (index-of heex-src "<p>)"))
          (editor/highlight/face-at (languages/elixir-fontify "~s(<p>)") 3))))))

(describe "an Elixir ~H sigil without the heex grammar keeps Elixir's colours"
  (test "an injection naming a language the runtime cannot parse changes nothing"
    (let (spec (languages/injection-spec [{:content {:kind :quoted_content :parent :sigil}
                                           :lang-from :sigil_name
                                           :aliases {"H" :no-such-grammar}}]
                 (fn (lang) languages/heex-face-table)))
      (assert= (editor/treesit/fontify heex-src :elixir languages/elixir-face-table true spec)
        (editor/treesit/fontify heex-src :elixir languages/elixir-face-table)))))
