;; Tests for src/apprun.blsp — run the project with debug taps.
(defmodule apprun-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use-internals apprun))

(defn art-model () (ed-init (make-buffer "x")))

(describe "apprun — stdout line decoding (pure)"
  (test "spy and stats events classify; app output passes through"
    (assert= :spy (first (apprun/apprun-decode-line "{\"event\":\"spy\",\"kind\":\"call\"}")))
    (assert= :stats (first (apprun/apprun-decode-line "{\"event\":\"stats\",\"procs\":3}")))
    (assert= [:output "hello app"] (apprun/apprun-decode-line "hello app"))
    (assert= [:drop] (apprun/apprun-decode-line "  "))))

(describe "apprun — the generated heartbeat"
  (test "the stats emitter runs: it reports the processes it counted"
    ;; its body evaluated as the run's script would, `started` bound — an unbound name in
    ;; it (a bare `keep`) killed the heartbeat on its first beat, so no stats ever arrived
    (let (form (seq/find (apprun/apprun-script-forms '())
                 (fn (candidate) (and (list? candidate) (= (second candidate) 'apprun-emit-stats))))
          body (nth form 3)
          printed (with-out-str (reflect/eval (list 'let '(started (os/now)) body)))
          decoded (json/decode (string/trim printed))
          stats (if (map? decoded) decoded {}))
      (assert= "stats" (get stats :event))
      (is (> (get stats :procs 0) 0)))))

(describe "apprun — heartbeats are chip-only"
  (test "a heartbeat never touches *Run*; the model tracks current + peak"
    (let (m0 (assoc (art-model) :apprun {:root "/x" :gen 1})
          m1 (ui-event-fold (apprun-stats-event {:procs 3 :memory 1024 :uptime-ms 5000} 1)
               m0 24 80 24)
          m2 (ui-event-fold (apprun-stats-event {:procs 9 :memory 4096 :uptime-ms 10000} 1)
               m1 24 80 24)
          m3 (ui-event-fold (apprun-stats-event {:procs 2 :memory 512 :uptime-ms 15000} 1)
               m2 24 80 24))
      (is (nil? (ed-buffer-index-by-name m3 "*Run*"))) ; no stats lines, ever
      (assert= 2 (map/get-in m3 [:apprun :stats :procs])) ; current
      (assert= 9 (map/get-in m3 [:apprun :peak :procs])) ; peak survives the dip
      (assert= 4096 (map/get-in m3 [:apprun :peak :memory]))
      ;; a stray heartbeat after the app exited (no :apprun) is dropped
      (is (nil? (:apprun (ui-event-fold (apprun-stats-event {:procs 1} 1) (art-model) 24 80 24))))
      ;; a straggler from a SUPERSEDED run (wrong gen) is dropped
      (assert= 2
        (map/get-in (ui-event-fold (apprun-stats-event {:procs 99} 0) m3 24 80 24)
          [:apprun :stats :procs])))))

(describe "apprun — model folds"
  (test "app output, spy traffic and heartbeats append to *Run*; exit echoes"
    (let (m0 (assoc (art-model) :apprun {:root "/x" :gen 1})
          m1 (ui-event-fold (apprun-output-event "booting" [] 1) m0 24 80 24)
          m2 (ui-event-fold (apprun-spy-event {:kind "call" :fn "f" :args "(1)"} 1) m1 24 80 24)
          m3 (ui-event-fold (apprun-stats-event {:procs 3 :memory 1024 :uptime-ms 5000} 1)
               m2 24 80 24)
          m4 (ui-event-fold (apprun-done-event 0 1) m3 24 80 24)
          text (buffer-text (ed-buf-at m4 (ed-buffer-index-by-name! m4 "*Run*"))))
      (is (includes? text "booting"))
      (is (includes? text "~ call (f (1))"))
      (is (not (includes? text "procs"))) ; stats never reach the buffer
      (is (includes? text "[app exited 0]"))
      (is (includes? (:echo m4) "app exited 0"))
      ;; the stats chip lives while the app runs and is dropped on exit
      (assert= {:procs 3 :memory 1024 :uptime-ms 5000} (map/get-in m3 [:apprun :stats]))
      (is (nil? (:apprun m4))))))

;; ---- end to end: the wrapper script boots a fixture app's entry point ------------
;; Each fixture project is a fresh `temp-dir`: a name built from the test's local pid was the
;; same in two runs at once, and the second run's `file/spit` landed in the first's project.
(purge-stale-temp "bedit-art-")

(describe "apprun — end to end (fixture project, real subprocess)"
  :isolated (test "the wrapper streams app output AND its spy traffic as events"
    (let (dir (temp-dir "bedit-art-fixture-"))
      (file/mkdir dir)
      (file/mkdir (str dir "/src"))
      (file/spit (str dir "/project.blsp") "(project :name \"art-fixture\" :version \"0.0.1\")")
      (file/spit (str dir "/src/main.blsp")
        (str "(defmodule main \"d\")\n"
          "(defn main (& args)\n" "  (do (io/puts \"app says hi\")\n"
          "    (debug/spy (+ 20 22))))\n"))
      (file/spit (str dir "/runner.blsp") (apprun/apprun-script-source '()))
      (let (p (os/spawn "nest" ["run" (str dir "/runner.blsp")] {:cwd dir})
            out (letrec (drain (fn (acc)
                                 (receive
                                   ([:proc _pp data] (drain (str acc data)))
                                   ([:proc-err _pp _data] (drain acc))
                                   ([:proc-closed _pp _code]
                                     (do
                                       (check-allow :discarded-catch
                                         (try (os/close p) (catch _e :close-failed)))
                                       acc))
                                   (after 30000 acc))))
                  (drain ""))
            decoded (map (string/split out "\n") apprun/apprun-decode-line)
            outputs (seq/keep decoded (fn (kv) (when (= (first kv) :output) (second kv))))
            spies (seq/keep decoded (fn (kv) (when (= (first kv) :spy) (second kv)))))
        (is (any? outputs (fn (line) (includes? line "app says hi"))))
        ;; the spy tap streamed the app's (spy (+ 20 22)) — its exit carries 42
        (is (any? spies (fn (e) (and (= (get e :kind) "exit") (= (get e :value) "42")))))))))

(describe "apprun — a run breakpoint traces the fn's calls into the run"
  :isolated (test "a breakpointed project fn streams a spy :call event when the app runs it"
    (let (dir (temp-dir "bedit-art-brk-"))
      (file/mkdir dir)
      (file/mkdir (str dir "/src"))
      (file/spit (str dir "/project.blsp") "(project :name \"brk\" :version \"0.0.1\")")
      ;; main calls greet, which we breakpoint
      (file/spit (str dir "/src/main.blsp")
        (str "(defmodule main \"d\")\n"
          "(defn greet (who) (str \"hi \" who))\n"
          "(defn main (& args) (io/puts (greet \"world\")))\n"))
      ;; a run breakpoint on main/greet (qualified symbol)
      (file/spit (str dir "/runner.blsp") (apprun/apprun-script-source (list 'main/greet)))
      (let (p (os/spawn "nest" ["run" (str dir "/runner.blsp")] {:cwd dir})
            out (letrec (drain (fn (acc)
                                 (receive
                                   ([:proc _pp data] (drain (str acc data)))
                                   ([:proc-err _pp _data] (drain acc))
                                   ([:proc-closed _pp _code]
                                     (do
                                       (check-allow :discarded-catch
                                         (try (os/close p) (catch _e :close-failed)))
                                       acc))
                                   (after 30000 acc))))
                  (drain ""))
            events (seq/keep (string/split out "\n")
                     (fn (line)
                       (let (kv (apprun/apprun-decode-line line))
                         (when (= (first kv) :spy) (second kv)))))
            calls (seq/filter events (fn (e) (= (get e :kind) "call"))))
        (is (any? (string/split out "\n") (fn (line) (includes? line "hi world")))) ; the app ran
        (is (any? calls (fn (e) (includes? (str (get e :fn)) "greet")))))))) ; greet was traced

(describe "apprun — the app's ANSI colours in *Run* (issue #24)"
  (test "a line's colour spans become faces where the line lands"
    (let (m0 (assoc (art-model) :apprun {:root "/x" :gen 1})
          m1 (ui-event-fold (apprun-output-event "booting" [] 1) m0 24 80 24)
          before (buffer-length (ed-buf-at m1 (ed-buffer-index-by-name! m1 "*Run*")))
          m2 (ui-event-fold (apprun-output-event "SLOW query" [[0 4 {:fg 3 :bold true}]] 1)
               m1 24 80 24)
          run (ed-buf-at m2 (ed-buffer-index-by-name! m2 "*Run*"))
          [from to face] (first (processes/ansicolor/colour-spans run)))
      (assert= (string/substring (buffer-text run) from to) "SLOW")
      (assert= [from to] [before (+ before 4)])
      (assert= face {:fg 3 :bold true})))
  (test "a stdout line is dispatched with its spans"
    (let (event (apprun/apprun-dispatch-line "plain output" [[0 5 {:italic true}]] 2))
      (assert= [(apprun-output-event-text event) (apprun-output-event-spans event)]
        ["plain output" [[0 5 {:italic true}]]]))))
