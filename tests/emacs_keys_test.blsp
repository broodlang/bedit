;; Emacs's everyday keys as an Emacs hand presses them: C-x k asks which buffer, C-x z
;; repeats what was typed, C-x 4 0 waits for its question, a user binding never silently eats a
;; command, C-h k opens *Help*, the prefix digits, Emacs's names on M-x, and the commands
;; Emacs has that bedit lacked. Through the real dispatch (`testkit/press`).

(defmodule emacs-keys-test
  (:use test)
  (:use testkit :only [m-of cur press type-str said])
  (:use minibuffer :only [mb-text ed-mb-set-text])
  (:use model)
  (:use pool :only [ed-open-buffer])
  (:use editor/buffer)
  (:use editor/pane :only [pane-count]))

(defn- ek-lines (n) (string/join (map (range n) str) "\n"))

(defn- ek-type (m text) (type-str m text))

(defn- ek-help (m) (if (= (buffer-name (cur m)) "*Help*") (buffer-text (cur m)) ""))

;; ---- C-x k, C-x 4 0, C-x 0 ---------------------------------------------------------------

(describe "C-x k asks which buffer"
  (test "the prompt names the current buffer as the default; RET kills it and types nothing"
    (let (m (ed-open-buffer (m-of "first") (make-buffer "second" "second")))
      (let (asked (press m [:ctrl-x "k"])
            killed (press asked [:enter]))
        (is (includes? (:prompt (:edit (:minibuffer asked))) "Kill buffer (default second)"))
        (assert= (ed-buffer-index-by-name killed "second") nil)
        (refute (includes? (buffer-text (cur killed)) "\n")))))
  (test "a name kills that buffer, not the current one"
    (let (m (ed-open-buffer (m-of "first") (make-buffer "second" "second"))
          done (press (ek-type (press m [:ctrl-x "k"]) "*scratch*") [:enter]))
      (assert= (ed-buffer-index-by-name done "*scratch*") nil)
      (assert= (buffer-name (cur done)) "second")))
  (test "M-x kill-current-buffer kills at once"
    (let (m (ed-open-buffer (m-of "first") (make-buffer "second" "second"))
          done (pool/cmd-kill-current-buffer m nil))
      (assert= (ed-buffer-index-by-name done "second") nil))))

(describe "C-x 4 0 and C-x 0"
  (test "a modified file buffer: y takes the buffer AND its pane, n leaves both"
    (let (dir (temp-dir "bedit-k40-")
          _ (file/mkdir dir)
          path (path/join dir "a.txt")
          _ (file/spit path "a\n")
          opened (press (pool/ed-find-file (m-of "") path) [:ctrl-x "2" "x"])
          asked (press opened [:ctrl-x "4" "0"])
          yes (press asked ["y"])
          no (press asked ["n"]))
      (is (:read-char asked))
      (assert= (pane-count (:layout asked)) 2)
      (assert= (ed-buffer-index-by-name yes "a.txt") nil)
      (assert= (pane-count (:layout yes)) 1)
      (is (ed-buffer-index-by-name no "a.txt"))
      (assert= (pane-count (:layout no)) 2)))
  (test "C-x 0 in the only window says why it does nothing"
    (assert= (:echo (press (m-of "x") [:ctrl-x "0"]))
      "Attempt to delete minibuffer or sole ordinary window")))

;; ---- C-x z ---------------------------------------------------------------------------------

(describe "C-x z repeats the last command"
  (test "a C-x z z types two more a's"
    (assert= (buffer-text (cur (press (m-of "") ["a" :ctrl-x "z" "z"]))) "aaa"))
  (test "C-f C-x z z moves three characters and types nothing"
    (let (done (press (m-of "hello") [:ctrl-f :ctrl-x "z" "z"]))
      (assert= (buffer-text (cur done)) "hello")
      (assert= (buffer-point (cur done)) 3))))

;; ---- init.blsp bindings under a command key ------------------------------------------------

(describe "a user binding under a key that runs a command"
  (test "is refused with Emacs's warning, and the command keeps its key"
    (let (compiled (userkeys/ed-user-keys {"C-x C-f C-a" 'kill-line "C-c z" 'kill-line} {}))
      (assert= (vec (map (:global compiled) first)) [[:ctrl-c "z"]])
      (is (any? (:warnings compiled)
            (fn (warning)
              (includes? warning "C-x C-f C-a starts with non-prefix key C-x C-f"))))))
  (test "under one of its own bindings too"
    (let (compiled (userkeys/ed-user-keys {"C-c a" 'kill-line "C-c a b" 'kill-line} {}))
      (assert= (vec (map (:global compiled) first)) [[:ctrl-c "a"]])
      (assert= (count (:warnings compiled)) 1))))

;; ---- C-h k / C-h c and the help map --------------------------------------------------------

(describe "C-h k opens *Help*"
  (test "a typed character runs self-insert"
    (is (string/starts-with? (ek-help (press (m-of "") [:ctrl-h "k" "a"]))
          "a runs the command self-insert")))
  (test "a key from init.blsp names init.blsp"
    (let (m (assoc (m-of "") :user-keys (userkeys/ed-user-keys {"C-c z" 'kill-line} {})))
      (is (string/starts-with? (ek-help (press m [:ctrl-h "k" :ctrl-c "z"]))
            "C-c z runs the command kill-line (bound in init.blsp)"))))
  (test "a command's page is C-h f's, its whole docstring included"
    (let (text (ek-help (press (m-of "") [:ctrl-h "k" :ctrl-x :ctrl-f])))
      (is (includes? text "find-file is an interactive command"))
      (is (includes? text "C-x C-f"))))
  (test "C-h c says it in one line; <f1> is C-h"
    (assert= (:echo (press (m-of "") [:ctrl-h "c" :ctrl-x :ctrl-f]))
      "C-x C-f runs the command find-file (emacs layer)")
    (is (string/starts-with? (ek-help (press (m-of "") [:f1 "k" "a"])) "a runs the command")))
  (test "C-h x describes a command, C-h o a function or a setting, C-h e shows *Messages*"
    (is (includes? (ek-help (press (ek-type (press (m-of "") [:ctrl-h "x"]) "find-file") [:enter]))
          "find-file is an interactive command"))
    (is (includes? (ek-help (press (ek-type (press (m-of "") [:ctrl-h "o"]) ":hl-line") [:enter]))
          ":hl-line is an init.blsp setting"))
    (is (includes? (ek-help (press (ek-type (press (m-of "") [:ctrl-h "o"]) "map") [:enter]))
          "map is a function"))
    (assert= (buffer-name (cur (press (m-of "") [:ctrl-h "e"]))) "*Messages*")))

;; ---- the untested help commands ------------------------------------------------------------

(describe "the rest of the help map"
  (test "where-is names a command's keys"
    (is (includes? (said (press (ek-type (press (m-of "") [:ctrl-h "w"]) "find-file") [:enter]))
          "C-x C-f")))
  (test "apropos-command lists the commands matching a pattern"
    (let (done (press (ek-type (press (m-of "") [:ctrl-h "a"]) "kill-line") [:enter]))
      (is (includes? (buffer-text (cur done)) "kill-line"))))
  (test "help-for-help lists the help keys"
    (let (done (press (m-of "") [:ctrl-h "?"]))
      (is (includes? (buffer-text (cur done)) "describe-key")))))

;; ---- prefix arguments ----------------------------------------------------------------------

(describe "M-<digit>, C-<digit> and ESC <digit>"
  (test "M-4 M-2 M-g g goes to line 42"
    (assert= (buffer-current-line (cur (press (m-of (ek-lines 60)) [:alt-4 :alt-2 :alt-g "g"]))) 41))
  (test "ESC 5 C-f moves five characters; C-3 1 C-f thirty-one, to the end"
    (assert= (buffer-point (cur (press (m-of "abcdefgh") [:escape "5" :ctrl-f]))) 5)
    (assert= (buffer-point (cur (press (m-of "abcdefgh") [:ctrl-3 "1" :ctrl-f]))) 8))
  (test "M-- M-3 C-f moves back three"
    (let (m (ed-apply (m-of "abcdefgh") (fn (b) (goto-char b 6))))
      (assert= (buffer-point (cur (press m [(keyword "alt--") :alt-3 :ctrl-f]))) 3))))

;; ---- Emacs's names on M-x ------------------------------------------------------------------

(describe "Emacs's command names"
  (test "every alias stands for a command that exists"
    (is (empty? (seq/filter (keys keymaps/*emacs-command-aliases*)
                  (fn (alias) (nil? (interactive/command-sym alias)))))))
  (test "M-x split-window-right runs split-pane-right, and M-x offers the name"
    (let (done (press (ek-type (press (m-of "x") [:alt-x]) "split-window-right") [:enter]))
      (assert= (pane-count (:layout done)) 2)
      (is (includes? (interactive/command-names) "save-buffer"))))
  (test "Vim's :w saves rather than running a fuzzy match"
    (let (opened (commands/ed-mx-prompt (m-of "x") ":" vim/*ex-commands*))
      (assert= (:answered (press (ek-type (assoc-in-prompt opened) "w") [:enter])) "save"))))

(defn- assoc-in-prompt (m)
  ;; the ex prompt with its answer recorded instead of run
  (map/assoc-in m
    [:minibuffer :on-complete]
    (fn (mm text) (assoc mm :answered (get vim/*ex-commands* text text)))))

(describe "M-x in *scratch*"
  (test "offers eval-last-sexp, eval-region and eval-buffer"
    (let (cands (minibuffer/mb-candidates (:minibuffer (ek-type (press (m-of "") [:alt-x]) "eval-"))))
      (is (includes? cands "eval-last-sexp"))
      (is (includes? cands "eval-region"))
      (is (includes? cands "eval-buffer")))))

;; ---- the everyday commands that were missing ------------------------------------------------

(describe "commands Emacs has"
  (test "M-: evaluates an expression, off the loop as C-x C-e does"
    (let (done (press (ek-type (press (m-of "") [(keyword "alt-:")]) "(+ 1 2)") [:enter]))
      (is (:eval-proc done))
      (assert= (said done) "evaluating…")))
  (test "C-j inserts a newline"
    (assert= (buffer-text (cur (press (m-of "ab") [:ctrl-f :ctrl-j]))) "a\nb"))
  (test "C-x TAB with a prefix moves the region's lines; the arrows after it move them again"
    (let (m (press (m-of "a\nb\n") [:ctrl-x "h"])
          moved (press m [:ctrl-u "2" :ctrl-x :tab])
          arrowed (press m [:ctrl-x :tab :right :right :right]))
      (assert= (buffer-text (cur moved)) "  a\n  b\n")
      (assert= (buffer-text (cur arrowed)) "   a\n   b\n")))
  (test "C-x C-v replaces this buffer with another file"
    (let (dir (temp-dir "bedit-cxcv-")
          _ (file/mkdir dir)
          _ (file/spit (path/join dir "one.txt") "one\n")
          _ (file/spit (path/join dir "two.txt") "two\n")
          m (pool/ed-find-file (m-of "") (path/join dir "one.txt"))
          asked (press m [:ctrl-x :ctrl-v])
          done (press (assoc asked
                        :minibuffer
                          (assoc (:minibuffer asked)
                            :edit
                              (ed-mb-set-text (:edit (:minibuffer asked)) (path/join dir "two.txt"))))
                 [:enter]))
      (is (string/ends-with? (mb-text (:minibuffer asked)) "one.txt"))
      (assert= (buffer-name (cur done)) "two.txt")
      (assert= (ed-buffer-index-by-name done "one.txt") nil)))
  (test "C-x 8 RET inserts a character by its code point"
    (assert= (buffer-text (cur (press (ek-type (press (m-of "") [:ctrl-x "8" :enter]) "3bb")
                                 [:enter])))
      "λ")
    (is (includes? (said (press (ek-type (press (m-of "") [:ctrl-x "8" :enter]) "lambda") [:enter]))
          "Invalid character")))
  (test "M-x rename-buffer renames, and refuses a name in use"
    (let (renamed (press (ek-type (press (m-of "x") [:alt-x]) "rename-buffer") [:enter])
          set (press (assoc renamed
                       :minibuffer
                         (assoc (:minibuffer renamed)
                           :edit (ed-mb-set-text (:edit (:minibuffer renamed)) "notes")))
                [:enter])
          clash (press (assoc renamed
                         :minibuffer
                           (assoc (:minibuffer renamed)
                             :edit (ed-mb-set-text (:edit (:minibuffer renamed)) "*Messages*")))
                  [:enter]))
      (assert= (buffer-name (cur set)) "notes")
      (is (includes? (said clash) "is in use"))))
  (test "C-x ^ / C-x } grow the window, C-x + evens them out"
    (let (split (press (m-of (ek-lines 10)) [:ctrl-x "2"])
          taller (press split [:ctrl-x "^" "^"])
          wider (press (m-of "x") [:ctrl-x "3" :ctrl-x "}"])
          even (press taller [:ctrl-x "+"]))
      (is (> (:ratio (:layout taller)) 0.5))
      (is (> (:ratio (:layout wider)) 0.5))
      (assert= (:ratio (:layout even)) 1/2)
      (is (includes? (:echo (press (m-of "x") [:ctrl-x "^"])) "No window"))))
  (test "C-M-v scrolls the other window and stays in this one"
    (let (m (press (m-of (ek-lines 200)) [:ctrl-x "2"])
          here (editor/pane/pane-selected-path (:layout m))
          done (press m [:ctrl-meta-v]))
      (assert= (editor/pane/pane-selected-path (:layout done)) here)
      (assert= (:echo (press (m-of "x") [:ctrl-meta-v])) "There is no other window")))
  (test "C-x 4 C-o shows a buffer beside this one without selecting it"
    (let (m (ed-open-buffer (m-of "first") (make-buffer "second" "second"))
          done (press (ek-type (press m [:ctrl-x "4" :ctrl-o]) "*scratch*") [:enter]))
      (assert= (pane-count (:layout done)) 2)
      (assert= (buffer-name (cur done)) "second")))
  (test "M-g M-n and C-x C-k C-k are bound"
    (assert= (userkeys/ed-key-binding (m-of "") :alt-g) (userkeys/ed-key-binding (m-of "") :alt-g))
    (assert= (get (userkeys/ed-key-binding (m-of "") :alt-g) :alt-n) 'compile/cmd-next-error)
    (assert= (get-in-keymap [:ctrl-x :ctrl-k :ctrl-k]) 'kmacro/cmd-kmacro-end-or-call-macro)))

(defn- get-in-keymap (keys)
  (fold keys keymaps/emacs-keymap (fn (acc key) (when (map? acc) (get acc key)))))

;; ---- C-x ESC ESC and C-x i, untested until now --------------------------------------------

(describe "repeat-complex-command and insert-file"
  (test "C-x ESC ESC with no history says so"
    (assert= (:echo (press (m-of "") [:ctrl-x :escape :escape])) "No repeatable command"))
  (test "C-x ESC ESC re-runs a command from M-x's history"
    (let (m (assoc (m-of "ab") :recent-files true)
          _ (projects/remember-command! "open-line-below")
          done (press m [:ctrl-x :escape :escape :enter]))
      (is (includes? (buffer-text (cur done)) "\n"))))
  (test "C-x i inserts a file at point, point before it"
    (let (dir (temp-dir "bedit-cxi-")
          _ (file/mkdir dir)
          path (path/join dir "in.txt")
          _ (file/spit path "inside\n")
          asked (press (m-of "ab") [:ctrl-f :ctrl-x "i"])
          done (press (assoc asked
                        :minibuffer
                          (assoc (:minibuffer asked)
                            :edit (ed-mb-set-text (:edit (:minibuffer asked)) path)))
                 [:enter]))
      (assert= (buffer-text (cur done)) "ainside\nb")
      (assert= (buffer-point (cur done)) 1))))
