;; The project shell (`C-x p e`) — `src/bshell.blsp`. A bshell is **per project**: each gets
;; its own `*bshell: <root>*` buffer carrying its own state (`:bshell-proc`/`-running`/
;; `-input-start`/history) on the buffer, plus the generic `:dir` (= its project root). These
;; cover the GUI-free pieces: ANSI colour, the input-region/prompt bookkeeping, RET, history,
;; fontify, completion. The shell process is a thin IO shell around `proc-spawn` (the `:cwd`
;; path is in brood's proc_test.blsp), so it isn't re-tested here.

(defmodule bshell-test
  (:use test)
  (:use model)
  (:use pool)
  (:use commands)
  (:use-internals bshell)
  (:use-internals comint)
  (:use input)
  (:use editor/buffer)
  (:use bshell :only [*bshell-history-file* *bshell-line-max*]))

;; The per-project buffer name for /tmp (what `C-x p e` would create there).
(def bshell-name (bshell/bshell-buffer-name "/tmp"))

;; A model whose current buffer is a /tmp bshell — all state ON the buffer, no live process.
(defn bshell-model ()
  (let (prompt (bshell/bshell-prompt "/tmp")
        raw (end-of-buffer (insert (make-buffer "" bshell-name) prompt))
        buf (assoc (editor/layers/set-buffer-type raw :bshell)
              :dir "/tmp"
              :bshell-proc nil
              :input-running false
              :input-start (count prompt)
              :input-history []
              :input-history-index nil
              :input-draft nil))
    (ed-open-buffer (ed-init (make-buffer "")) buf)))

(defn bshell-buf (m) (nth (:buffers m) (ed-buffer-index-by-name! m bshell-name)))
(defn bshell-text (m) (buffer-text (bshell-buf m)))
(defn bshell-istart (m) (:input-start (bshell-buf m)))
(defn bshell-running (m) (:input-running (bshell-buf m)))
(defn bshell-input (m)
  (let (t (bshell-text m)) (string/substring t (bshell-istart m) (count t))))
(defn set-field (m k v) (ed-set-buf m (assoc (ed-current-buf m) k v))) ; set a field on the current buffer
(defn with-mark (m position) (ed-set-buf m (comint/with-process-mark (ed-current-buf m) position))) ; the process mark on the current buffer
(defn bshell-point (m) (buffer-point (ed-current-buf m)))
(defn type-into (m s) (fold (string/->list s) m (fn (acc k) (ed-update acc k 80 24))))
(defn at-point (m p) (ed-set-buf m (goto-char (ed-current-buf m) p)))

;; RET remembers the line in the shell's history FILE. This suite once ran it against the
;; user's real ~/.config/bedit/state/bshell-history.blsp and overwrote it; every RET here
;; goes through `send-line`, which names a scratch file of the test's own.
(def scratch-history (str (path/temp "bedit-bshell-history-") ".blsp"))
(defn send-line (m key)
  (binding (*bshell-history-file* scratch-history) (cmd-bshell-send m key)))

;; A model 'in' /tmp (no project marker there) so `ed-project-root` resolves to /tmp.
(defn tmp-project-model ()
  (assoc (ed-set-buf (ed-init (make-buffer "")) (make-buffer "" "scratch" "/tmp/scratch"))
    :project-root "/tmp"))

;; ---- ANSI stripping (std/ansi.blsp) ----------------------------------------

(describe "ansi/strip-ansi"
  (test "drops SGR colour sequences"
    (assert= (ansi/strip "\e[31mred\e[0m") "red"))
  (test "drops a cursor-op sequence mid-string"
    (assert= (ansi/strip "a\e[2Kb") "ab"))
  (test "drops carriage returns, keeps newlines"
    (assert= (ansi/strip "a\r\nb\r") "a\nb"))
  (test "passes plain text through unchanged"
    (assert= (ansi/strip "hello world") "hello world")))

;; ---- the async output/done handlers (per buffer, by name) -------------------

(describe "ed-ev-bshell-output"
  (test "appends the chunk verbatim (no forced newline)"
    (let (m (bshell/ed-ev-bshell-output (bshell-model)
              (bshell/bshell-output-event bshell-name "hi" [] nil)
              24
              80
              24))
      (is (string/ends-with? (bshell-text m) "tmp $ hi"))))
  (test "consecutive chunks concatenate without a line break between them"
    (let (m1 (bshell/ed-ev-bshell-output (bshell-model)
               (bshell/bshell-output-event bshell-name "ab" [] nil)
               24
               80
               24)
          m2 (bshell/ed-ev-bshell-output m1
               (bshell/bshell-output-event bshell-name "cd" [] nil)
               24
               80
               24))
      (is (string/ends-with? (bshell-text m2) "abcd")))))

;; ---- ANSI colour, split across reads (issue #24) -------------------------------

(defn- bshell-stream-into (m chunks)
  "`m` with `chunks` — the command's stdout reads, in order — run through the worker's
decode step (`bshell-forward`, its decoder in the worker state, the events sent here) and
folded as the loop folds them."
  (do
    (fold chunks
      {:buffer bshell-name :reply (self) :decoder (ansicolor/decoder)}
      (fn (state chunk) (bshell/bshell-forward state chunk)))
    (letrec (drain (fn (model)
                     (receive
                       (event (drain (bshell/ed-ev-bshell-output model event 24 80 24)))
                       (after 0 model))))
      (drain m))))

(describe "bshell: a command's ANSI colours"
  (test "an escape split across two reads never leaks into the shell buffer"
    (let (m (bshell-stream-into (bshell-model) ["\e[01;3" "4mdir\e[0m  file\n"]))
      (is (string/ends-with? (bshell-text m) "tmp $ dir  file\n"))))
  (test "the colours land as faces on the output, after the prompt"
    (let (m0 (bshell-model)
          start (count (bshell-text m0))
          m (bshell-stream-into m0 ["\e[01;3" "4mdir\e[0m  file\n"])
          spans (ansicolor/colour-spans (ed-buf-at m (ed-buffer-index-by-name! m bshell-name))))
      (assert= (into [] (map spans (fn (s) [(first s) (second s)]))) [[start (+ start 3)]])
      (is (:bold (nth (first spans) 2)))
      (assert= (:fg (nth (first spans) 2)) 4))))

(describe "bshell: input typed ahead while a command runs"
  ;; the output lands at the process mark (comint's), before what was typed ahead — so no
  ;; later edit of that input can shift the output's colour spans off their text
  (test "output goes before it, coloured where it lands; the new prompt keeps it as input"
    (let (running (with-mark (set-field (bshell-model) :input-running true)
                    (count (bshell-text (bshell-model))))
          mark (count (bshell-text running))
          typed (type-into running "next")
          m1 (bshell-stream-into typed ["\e[31mre" "d\e[0m\n"])
          spans (ansicolor/colour-spans (bshell-buf m1))
          m2 (bshell/ed-ev-bshell-done m1 (bshell/bshell-done-event bshell-name 0) 24 80 24))
      (is (string/ends-with? (bshell-text m1) "tmp $ red\nnext"))
      (assert= (into [] (map spans (fn (s) [(first s) (second s)]))) [[mark (+ mark 3)]])
      (assert= (string/substring (bshell-text m1) mark (+ mark 3)) "red")
      ;; the command ends: the prompt follows its output, and `next` waits after it
      (is (string/ends-with? (bshell-text m2) "red\n/tmp $ next"))
      (assert= (bshell-input m2) "next")
      (refute (bshell-running m2)))))

(describe "bshell: undo takes back what you typed, never a command's output"
  (test "output that streamed in while you typed ahead stays through C-/"
    (let (running (with-mark (set-field (bshell-model) :input-running true)
                    (count (bshell-text (bshell-model))))
          typed (type-into running "next")
          streamed (bshell-stream-into typed ["10%\r" "100%\n"])
          undone (ed-update streamed :ctrl-/ 80 24))
      (is (string/ends-with? (bshell-text streamed) "100%\nnext"))
      ;; your typing goes; the command's output — its progress line rewritten — stays
      (is (includes? (bshell-text undone) "100%\n"))
      (refute (includes? (bshell-text undone) "10%\r"))
      (refute (string/ends-with? (bshell-text undone) "next")))))

(defn- sent-and-running (line)
  "A shell that has just sent `line` (RET), its run message taken back off this mailbox."
  (let (m (send-line (type-into (set-field (bshell-model) :bshell-proc (self)) line) nil))
    (receive ([:bshell-run _] m) (after 1000 m))))

(describe "bshell: the process mark is a marker every edit carries"
  :isolated ; RET sends the run to this test's mailbox
  (test "C-a then typing while a command runs never splits the next chunk mid-word"
    ;; the mark used to be a plain offset: text typed before it left it behind, and the
    ;; next chunk landed inside the typing (`/tmp $ XYls\nontwo\ne\n`)
    (let (m1 (bshell-stream-into (sent-and-running "ls") ["one\n"])
          typed (type-into (ed-update m1 :ctrl-a 80 24) "XY")
          m2 (bshell-stream-into typed ["two\n"]))
      (assert= (bshell-text m2) "/tmp $ ls\none\ntwo\nXY")))
  (test "text inserted before the mark carries it along"
    (let (m1 (bshell-stream-into (sent-and-running "ls") ["one\n"])
          b (ed-current-buf m1)
          mark (comint/process-mark-at b)
          edited (insert (goto-char b 0) "AB"))
      (assert= mark (count "/tmp $ ls\none\n"))
      (assert= (comint/process-mark-at edited) (+ (count "/tmp $ ls\none\n") 2))))
  (test "while a command runs, the input region starts at the mark, not the old prompt"
    (let (m1 (bshell-stream-into (sent-and-running "ls") ["one\n"]))
      (assert= (first (comint/input-region (bshell-buf m1))) (count "/tmp $ ls\none\n"))))
  (test "the mark goes when the command ends"
    (let (m1 (bshell/ed-ev-bshell-done (sent-and-running "ls")
               (bshell/bshell-done-event bshell-name 0)
               24
               80
               24))
      (is (nil? (comint/process-mark-at (ed-current-buf m1)))))))

(defn- longest-line (text)
  (reduce (string/split text "\n") 0 (fn (longest line) (math/max longest (count line)))))

(describe "bshell: output with no newline stays bounded"
  ;; every chunk used to run the password regex over the whole current line, so a command
  ;; writing one long line cost O(n²); the line now ends at `*bshell-line-max*`, and the
  ;; password watch reads only a line short enough to be a prompt
  :isolated (test "a long single line is ended at the line limit, its text all kept"
    (let (chunk (string/join (seq/repeat 1000 "x") "")
          m (bshell-stream-into (sent-and-running "dump") (into [] (seq/repeat 70 chunk)))
          output (string/substring (bshell-text m) (count "/tmp $ dump\n")))
      (is (<= (longest-line output) (+ *bshell-line-max* 1000)))
      (assert= (count (string/replace output "\n" "")) 70000)
      (assert= (bshell-point m) (count (bshell-text m)))))
  (test "a line longer than any prompt is not read as one"
    (let (m (bshell-stream-into (sent-and-running "dump")
              [(str (string/join (seq/repeat 300 "y") "") " password: ")]))
      (assert= (bshell/last-line (bshell-buf m)) "")
      (refute (:bshell-secret (bshell-buf m)))))
  (test "a real prompt after the long output is still seen"
    (let (m (bshell-stream-into (sent-and-running "sudo -S x")
              [(string/join (seq/repeat 3000 "z") "") "\n[sudo] password for me: "]))
      (assert= (bshell/last-line (bshell-buf m)) "[sudo] password for me: ")
      (is (:bshell-secret (bshell-buf m)))))
  (test "a command whose terminal reads a password is asked, whatever its prompt says"
    (let (running (sent-and-running "vault login")
          event (fn (secret) (bshell/bshell-output-event bshell-name "Token (hidden): " [] secret))
          told (bshell/ed-ev-bshell-output running (event true) 24 80 24)
          guessed (bshell/ed-ev-bshell-output running (event nil) 24 80 24))
      (is (:bshell-secret (bshell-buf told)))
      (refute (:bshell-secret (bshell-buf guessed))))))

(describe "bshell: only a pane at the process mark follows the output"
  :isolated (test "a reader up in the running command's own output stays where they are"
    (let (m1 (bshell-stream-into (sent-and-running "make") ["error: one\nline2\n"])
          at (index-of (bshell-text m1) "error")
          reading (at-point m1 at)
          m2 (bshell-stream-into reading ["more\n" "and more\n"]))
      (assert= (bshell-point m2) at)))
  (test "a pane at the end follows it"
    (let (m1 (bshell-stream-into (sent-and-running "make") ["one\n" "two\n"]))
      (assert= (bshell-point m1) (count (bshell-text m1)))))
  (test "a pane in the input typed ahead keeps its place in that input"
    (let (m1 (bshell-stream-into (sent-and-running "make") ["one\n"])
          typed (at-point (type-into m1 "abc")
                  (- (count (bshell-text (type-into m1 "abc"))) 1))
          m2 (bshell-stream-into typed ["two\n"]))
      (assert= (bshell-text m2) "/tmp $ make\none\ntwo\nabc")
      (assert= (bshell-point m2) (- (count (bshell-text m2)) 1)))))

(describe "ed-ev-bshell-done"
  (test "a clean exit (0) is silent — no [exit] line, but a fresh prompt and idle shell"
    (let (m0 (set-field (bshell-model) :input-running true)
          m (bshell/ed-ev-bshell-done m0 (bshell/bshell-done-event bshell-name 0) 24 80 24))
      (is (not (includes? (bshell-text m) "[exit")))
      (is (string/ends-with? (bshell-text m) "tmp $ ")) ; the fresh prompt
      (assert= (bshell-running m) false)))
  (test "a non-zero exit shows [exit N]"
    (let (m (bshell/ed-ev-bshell-done (bshell-model)
              (bshell/bshell-done-event bshell-name 2)
              24
              80
              24))
      (is (includes? (bshell-text m) "[exit 2]"))))
  (test "a signal-killed child (nil code) reads as [exit killed]"
    (let (m (bshell/ed-ev-bshell-done (bshell-model)
              (bshell/bshell-done-event bshell-name nil)
              24
              80
              24))
      (is (includes? (bshell-text m) "[exit killed]"))))
  (test "input-start is reset to the new buffer end (after the fresh prompt)"
    (let (m (bshell/ed-ev-bshell-done (bshell-model)
              (bshell/bshell-done-event bshell-name 1)
              24
              80
              24))
      (assert= (bshell-istart m) (count (bshell-text m))))))

;; ---- Brood-form detection (shell command vs REPL form) ----------------------

(describe "bshell--brood-form?"
  (test "a line starting with ( is evaluated as Brood"
    (is (bshell/bshell-brood-form? "(+ 1 2)")))
  (test "leading whitespace before ( is ignored"
    (is (bshell/bshell-brood-form? "   (io/puts 1)")))
  (test "a shell command line is not a Brood form"
    (is (not (bshell/bshell-brood-form? "nest test"))))
  (test "a bare word is not a Brood form"
    (is (not (bshell/bshell-brood-form? "ls")))))

;; ---- fontify: prompt detected from the buffer text (per buffer, no global) ---

(describe "bshell-fontify"
  (test "spans the prompt prefix (detected from the first line) and an [exit N] line"
    (let (spans (bshell/bshell-fontify "/tmp $ ls\nfile\n[exit 2]\n"))
      ;; the prompt is the first line up to " $ " → "/tmp $ " (offsets [0, 7))
      (assert= (first (first spans)) 0)
      (assert= (second (first spans)) 7)
      (is (>= (count spans) 2))))
  (test "a prompt after a cd, in another directory, is coloured too"
    (let (spans (bshell/bshell-fontify "/tmp $ cd /usr\n/usr $ ls\n"))
      (assert= (take (map spans (fn (span) [(first span) (second span)])) 2) (list [0 7] [15 22])))))

;; ---- cd: the shell's own -------------------------------------------------------

(describe "bshell: clear empties the buffer to a fresh prompt"
  (test "only a line that is just clear is the shell's"
    (is (bshell-clear-line? " clear "))
    (refute (bshell-clear-line? "clear && make"))
    (refute (bshell-clear-line? "clearly")))
  (test "RET on clear leaves only a prompt, the input after it; the command is remembered"
    (let (m (bshell-stream-into (sent-and-running "ls") ["one\ntwo\n"])
          done (bshell/ed-ev-bshell-done m (bshell/bshell-done-event bshell-name 0) 24 80 24)
          cleared (send-line (type-into done "clear") nil)
          prompt (bshell/bshell-prompt "/tmp"))
      (assert= (bshell-text cleared) prompt)
      (assert= (bshell-istart cleared) (count prompt))
      (assert= (bshell-point cleared) (count prompt))
      (assert= (last (:input-history (bshell-buf cleared))) "clear")))
  (test "C-c M-o clears too, but not under a running command"
    (let (running (sent-and-running "sleep 9")
          prompt (bshell/bshell-prompt "/tmp"))
      (assert= (:echo (cmd-bshell-clear running nil)) "a command is running — C-c C-c first")
      (assert= (bshell-text (cmd-bshell-clear (bshell-model) nil)) prompt))))

(describe "bshell: cd changes where the next command runs"
  (test "a line that is only a cd is the shell's; one with more runs in sh -c"
    (assert= (bshell-cd-argument "cd /usr") "/usr")
    (assert= (bshell-cd-argument "  cd  ") "")
    (assert= (bshell-cd-argument "cd -") "-")
    (assert= (bshell-cd-argument "cd /usr && ls") nil)
    (assert= (bshell-cd-argument "cdrom") nil))

  (test "the target: relative to the shell's directory, home, the previous one"
    (assert= (bshell-cd-target "/" "/tmp" nil) ["/" nil])
    (assert= (bshell-cd-target ".." "/tmp" nil) ["/" nil])
    (assert= (bshell-cd-target "-" "/tmp" "/") ["/" nil])
    (assert= (bshell-cd-target "-" "/tmp" nil) [nil "cd: no previous directory"])
    (assert= (bshell-cd-target "no-such-dir-here" "/tmp" nil)
      [nil "cd: no such directory: no-such-dir-here"]))

  (test "RET on cd moves the buffer's directory, tells the worker and prompts there"
    (let (m (send-line (type-into (set-field (bshell-model) :bshell-proc (self)) "cd /") nil))
      (assert= (receive ([:bshell-cd dir] dir) (after 1000 :not-told)) "/")
      (assert= (:dir (bshell-buf m)) "/")
      (assert= (:bshell-previous-dir (bshell-buf m)) "/tmp")
      (is (string/ends-with? (bshell-text m) "\n/ $ "))
      (assert= (bshell-istart m) (count (bshell-text m)))
      (is (not (bshell-running m)))
      ;; and the input after the new prompt is what the Brood services read
      (assert= (bshell/bshell-input-span (str (bshell-text m) "(+ 1 2)"))
        [(count (bshell-text m)) "(+ 1 2)"])))

  (test "a cd that cannot go says why and keeps the directory"
    (let (m (send-line (type-into (set-field (bshell-model) :bshell-proc (self))
                         "cd nowhere-at-all")
              nil))
      (assert= (:dir (bshell-buf m)) "/tmp")
      (is (includes? (bshell-text m) "cd: no such directory: nowhere-at-all\n/tmp $ ")))))

;; ---- input-region boundary (can't edit/move left of the prompt) -------------

(describe "bshell input-region boundary"
  (test "backward-char is a no-op exactly at the input start (won't enter the prompt)"
    (let (m (bshell-model))
      ; point sits at the input start (just the prompt so far)
      (assert= (bshell-point (cmd-comint-backward-char m nil)) (bshell-istart m))))
  (test "backward-char still moves within typed input"
    (let (m (type-into (bshell-model) "ab"))
      (assert= (bshell-point (cmd-comint-backward-char m nil)) (dec (bshell-point m)))))
  (test "backspace at the input start leaves the prompt intact"
    (let (m (bshell-model))
      (assert= (bshell-text (cmd-comint-delete-backward m nil)) (bshell-text m))))
  (test "backspace deletes a typed char within the input"
    (let (m (type-into (bshell-model) "x"))
      (assert= (bshell-text (cmd-comint-delete-backward m nil)) (bshell-text (bshell-model)))))
  (test "C-a jumps to the input start, not into the prompt"
    (let (m (type-into (bshell-model) "abc"))
      (assert= (bshell-point (cmd-comint-beginning-of-input m nil)) (bshell-istart m)))))

(describe "enforce-input-boundary (the post-keystroke safety net)"
  (test "pulls point out of the prompt region to the input start (e.g. Down landed there)"
    (let (m0 (bshell-model)
          m (at-point m0 3))
      ; point inside the "/tmp $ " prompt
      (assert= (bshell-point (enforce-input-boundary m)) (bshell-istart m0))))
  (test "leaves point alone when it's already in the input"
    (let (m (bshell-model))
      ; point at the input start
      (assert= (bshell-point (enforce-input-boundary m)) (bshell-point m))))
  (test "leaves point alone in the output above the input line (output stays navigable)"
    (let (raw (end-of-buffer (insert (make-buffer "" bshell-name) "out\n/tmp $ "))
          buf (assoc (editor/layers/set-buffer-type raw :bshell) :dir "/tmp" :input-start 11)
          m0 (ed-open-buffer (ed-init (make-buffer "")) buf)
          m (at-point m0 1))
      ; inside "out" (output, above the input line)
      (assert= (bshell-point (enforce-input-boundary m)) 1)))
  (test "a no-op in a non-bshell buffer"
    (let (m (at-point (ed-init (make-buffer "hello")) 2))
      (assert= (bshell-point (enforce-input-boundary m)) 2)))
  (test "rides the layer :post-key facet: a key dispatched through ed-update is guarded"
    ;; Down from the output line keeps the column and lands inside the prompt; the
    ;; guard — collected via `input/ed--post-key-guards` from the layer's `:post-key`
    ;; facet, no longer hardcoded in dispatch — must pull point to the input start.
    (let (raw (end-of-buffer (insert (make-buffer "" bshell-name) "out\n/tmp $ "))
          buf (assoc (editor/layers/set-buffer-type raw :bshell) :dir "/tmp" :input-start 11)
          m0 (ed-open-buffer (ed-init (make-buffer "")) buf)
          m (ed-update (at-point m0 1) :down 80 24))
      (assert= (bshell-point m) 11))))

;; ---- command history (↑/↓ recall, per buffer) -------------------------------

(describe "bshell command history"
  (test "↑ recalls the newest command, then older ones"
    (let (m0 (set-field (bshell-model) :input-history ["ls" "pwd"])
          m1 (cmd-comint-previous-history m0 nil)
          m2 (cmd-comint-previous-history m1 nil))
      (assert= (bshell-input m1) "pwd")
      (assert= (bshell-input m2) "ls")))
  (test "↓ walks back toward the newest, then restores the live draft"
    (let (m0 (set-field (bshell-model) :input-history ["ls" "pwd"])
          up2 (cmd-comint-previous-history (cmd-comint-previous-history m0 nil) nil) ; → "ls"
          dn1 (cmd-comint-next-history up2 nil) ; → "pwd"
          dn2 (cmd-comint-next-history dn1 nil))
      ; → live draft ("")
      (assert= (bshell-input dn1) "pwd")
      (assert= (bshell-input dn2) "")))
  (test "↑ with no history is a no-op"
    (let (m (bshell-model))
      (assert= (bshell-input (cmd-comint-previous-history m nil)) "")))
  (test "↑ with :input-start past the end of the buffer recalls at the end, not off it"
    ;; a kill that reached above the input start leaves the field past the rope's end
    (let (m0 (set-field (set-field (bshell-model) :input-history ["ls"]) :input-start 999)
          m1 (cmd-comint-previous-history m0 nil))
      (assert= (bshell-text m1) (str (bshell/bshell-prompt "/tmp") "ls"))
      (assert= (:input-draft (bshell-buf m1)) "")))
  (test "submitting a command records it in this buffer's history"
    (let (typed (type-into (set-field (bshell-model) :bshell-proc (self)) "echo hi")
          m (send-line typed nil))
      (is (includes? (:input-history (bshell-buf m)) "echo hi")))))

;; ---- completion: filenames for a command, Brood globals for a form ----------

(describe "bshell-complete-source"
  (test "completes a filename under the shell's directory for a shell command"
    (let (m (type-into (set-field (bshell-model) :dir ".") "sr")
          [_start prefix items] (bshell/bshell-complete-source m))
      (assert= prefix "sr")
      (is (includes? items "src/")))) ; the project's src/ directory, dir-suffixed
  (test "completes Brood globals for a (-form line (the REPL)"
    (let (m (type-into (bshell-model) "(ca")
          [_start _prefix items] (bshell/bshell-complete-source m))
      ;; Assert the BEHAVIOUR (prefix completion of Brood globals), not one name: pinning
      ;; a specific global has broken this test three times as the stdlib moved under it —
      ;; ADR-154 trimmed `car`/`cdr`, ADR-230 moved `capitalize` to `string/capitalize`, and
      ;; the os/ namespace move took `canonicalize` to `os/canonicalize`. Each time the test
      ;; failed for a rename it was never meant to be guarding.
      (is (not (empty? items)))
      (is (every? items (fn (i) (string/starts-with? i "ca"))))))
  (test "is inert outside a bshell buffer"
    (is (nil? (bshell/bshell-complete-source (ed-init (make-buffer "x")))))))

;; ---- RET: cmd-bshell-send ---------------------------------------------------

(describe "cmd-bshell-send"
  :isolated ; sends to a process (here, the test itself, via :bshell-proc = self)
  (test "slices the input line and sends it to the shell process, marking :running"
    (let (typed (type-into (set-field (bshell-model) :bshell-proc (self)) "pwd")
          m (send-line typed nil))
      (let (got (receive ([:bshell-run line] line) (after 2000 :timeout)))
        (assert= got "pwd"))
      (is (string/ends-with? (bshell-text m) "tmp $ pwd\n"))
      (assert= (bshell-running m) true)))

  (test "an empty input line just emits a fresh prompt — nothing is sent, not running"
    (let (m (send-line (set-field (bshell-model) :bshell-proc (self)) nil))
      (assert= (bshell-running m) false)
      (assert= (bshell-istart m) (count (bshell-text m)))
      (is (nil? (receive ([:bshell-run line] line) (after 200 nil))))))

  (test "RET is ignored while a command is already running"
    (let (m0 (set-field (bshell-model) :input-running true)
          m (send-line m0 nil))
      (assert= m m0))))

;; ---- multi-line input (an incomplete Brood form keeps editing) --------------

(describe "bshell--complete-input?"
  (test "a complete Brood form is ready to submit"
    (is (bshell/bshell-complete-input? "(+ 1 2)")))
  (test "an unclosed Brood form is not (RET should add a line)"
    (is (not (bshell/bshell-complete-input? "(+ 1 2"))))
  (test "an unterminated string is not complete"
    (is (not (bshell/bshell-complete-input? "(io/puts \"hi"))))
  (test "a shell command is always ready"
    (is (bshell/bshell-complete-input? "nest test")))
  (test "a complete-but-malformed form still submits (reflect/eval reports it)"
    (is (bshell/bshell-complete-input? "(1 2 3)"))))

(describe "cmd-bshell-send multi-line"
  :isolated (test "an incomplete form inserts a newline instead of submitting (stays not-running)"
    ;; typed without electric pairs, which would close the form as it is typed
    (let (typed (type-into (assoc (set-field (bshell-model) :bshell-proc (self))
                             :electric-pair? false)
                  "(+ 1")
          m (send-line typed nil))
      (is (string/ends-with? (bshell-text m) "(+ 1\n"))
      (assert= (bshell-running m) false))))

;; ---- persistent history (serialize/parse, the pure core) --------------------

(describe "bshell history persistence"
  (test "trim keeps the whole history when under the cap (oldest first)"
    (assert= (bshell/bshell-history-trim ["ls" "pwd" "echo hi"]) ["ls" "pwd" "echo hi"]))
  (test "trim drops the oldest entries beyond the cap, keeping the most-recent tail"
    (let (big (into [] (map (range 0 5000) str)) ; well past any sane cap
          kept (bshell/bshell-history-trim big)
          n (count kept))
      (is (< n 5000)) ; something was dropped
      (assert= kept (into [] (drop big (- 5000 n)))))) ; what's kept is the newest tail
  (test "save then load round-trips through the shared persist layer (atomic)"
    (let (f (str (path/temp "bedit-bshell-hist-test-") ".blsp"))
      (projects/persist-write! f ["a" "b"])
      (assert= (projects/persist-read f) ["a" "b"])))
  (test "loading a missing file yields an empty history (never errors)"
    (is (vector? (bshell/bshell-load-history))))
  (test "RET writes the history to the file the test named, nowhere else"
    (let (file (str (path/temp "bedit-bshell-own-history-") ".blsp"))
      (binding (*bshell-history-file* file)
        (cmd-bshell-send (type-into (set-field (bshell-model) :bshell-proc (self)) "echo mine") nil))
      (receive ([:bshell-run _] nil) (after 1000 nil))
      (assert= (projects/persist-read file) ["echo mine"])))
  (test "under the test runner the default history is in the run's scratch config, not $HOME's"
    (let (path (bshell/bshell-history-path))
      (when-let (scratch (test/scratch-dir)) (is (string/starts-with? path scratch)))
      (refute (config-paths/test-forbidden-path? path)))))

;; ---- per-project: each project gets its own shell buffer --------------------

(describe "cmd-project-bshell (per project)"
  :isolated ; starts real (idle) shell processes
  (test "opens a per-project *bshell: <root>* buffer with its prompt + buffer-local state"
    (let (m (cmd-project-bshell (tmp-project-model) nil)
          buf (nth (:buffers m) (ed-buffer-index-by-name! m bshell-name)))
      (is (not (nil? (ed-buffer-index-by-name m bshell-name))))
      (is (not (nil? (:bshell-proc buf))))
      (assert= (:input-running buf) false)
      (assert= (:dir buf) "/tmp") ; root is the generic per-buffer :dir
      (is (string/ends-with? (buffer-text buf) "$ "))
      (bshell-shutdown (:bshell-proc buf))))

  (test "C-x p e again — from the shell or from a file — returns to the same shell"
    (let (m1 (cmd-project-bshell (tmp-project-model) nil)
          from-shell (cmd-project-bshell m1 nil)
          from-file (cmd-project-bshell (ed-select from-shell 0) nil)
          shells (fn (m) (count (seq/filter (:buffers m) (fn (b) (= (:type b) :bshell))))))
      (assert= (shells from-shell) 1)
      (assert= (shells from-file) 1)
      (assert= (buffer-name (ed-current-buf from-file)) bshell-name)
      (bshell-shutdown (get (nth (:buffers from-file)
                              (ed-buffer-index-by-name! from-file bshell-name))
                         :bshell-proc))))

  (test "C-u C-x p e opens another shell beside the first; C-x p e still returns to the first"
    (let (m1 (cmd-project-bshell (tmp-project-model) nil)
          second (cmd-project-bshell (assoc m1 :prefix-arg {:count 4}) nil)
          third (cmd-project-bshell (assoc second :prefix-arg {:count 4}) nil)
          plain (cmd-project-bshell (dissoc third :prefix-arg) nil)
          shells (map (seq/filter (:buffers third) (fn (b) (= (:type b) :bshell))) buffer-name))
      (assert= (vec shells) [bshell-name (str bshell-name "<2>") (str bshell-name "<3>")])
      (assert= (buffer-name (ed-current-buf third)) (str bshell-name "<3>"))
      (assert= (buffer-name (ed-current-buf plain)) bshell-name)
      (doseq (name shells)
        (bshell-shutdown (get (nth (:buffers third) (ed-buffer-index-by-name! third name))
                           :bshell-proc)))))

  (test "a different project opens a DISTINCT buffer (not the last project's shell)"
    (let (m1 (cmd-project-bshell (tmp-project-model) nil)
          ;; now 'in' a different project: open (not replace) a file buffer there, so /tmp's
          ;; shell stays in the pool; its :dir (= /var/tmp) drives ed-project-root
          m2model (assoc (ed-open-buffer m1 (make-buffer "" "x" "/var/tmp/x"))
                    :project-root "/var/tmp")
          m2 (cmd-project-bshell m2model nil)
          na (bshell/bshell-buffer-name "/tmp")
          nb (bshell/bshell-buffer-name "/var/tmp"))
      (is (not (= na nb))) ; distinct per-project names
      (is (not (nil? (ed-buffer-index-by-name m2 na)))) ; /tmp's shell still there
      (is (not (nil? (ed-buffer-index-by-name m2 nb)))) ; /var/tmp got its own
      (bshell-shutdown (get (nth (:buffers m2) (ed-buffer-index-by-name! m2 na)) :bshell-proc))
      (bshell-shutdown (get (nth (:buffers m2) (ed-buffer-index-by-name! m2 nb)) :bshell-proc)))))

;; ---- the pane's cursor follows what the shell writes ------------------------
;; Point is PER PANE (window-point, model.blsp): the pool buffer's own point is only a
;; saved default, so a write that moves the pooled point moves no cursor anyone can see.
;; The bug: type a command, RET, and the cursor stayed on the line you typed while the
;; output and the next prompt appeared below it — every write went to the pool slot only.

(describe "bshell writes carry the pane's cursor"
  (test "RET, output, exit: the cursor is at the end of the fresh prompt"
    ;; typing first: `ed-set-buf` caches the pane point, which is exactly what left it stale
    (let (m0 (ed-update (set-field (bshell-model) :bshell-proc (self)) "l" 80 24)
          m1 (ed-update m0 "s" 80 24)
          m2 (send-line m1 :enter)
          m3 (bshell/ed-ev-bshell-output m2
               (bshell/bshell-output-event bshell-name "a.txt\n" [] nil)
               24
               80
               24)
          m4 (bshell/ed-ev-bshell-done m3 (bshell/bshell-done-event bshell-name 0) 24 80 24))
      (is (string/ends-with? (bshell-text m4) "a.txt\n/tmp $ "))
      (assert= (bshell-point m4) (count (bshell-text m4)))))
  (test "a pane reading the scrollback is left where it was"
    (let (m0 (ed-update (bshell-model) "x" 80 24)
          m1 (at-point m0 0) ; up in the output (the prompt line's start)
          m2 (bshell/ed-ev-bshell-output m1
               (bshell/bshell-output-event bshell-name "more\n" [] nil)
               24
               80
               24))
      (assert= (bshell-point m2) 0))))

;; The REPL half of this file moved to a terminal buffer (terminal.blsp, `C-x p r`), where
;; tests/repl_test.blsp covers it against a real interpreter; what is left here is the
;; line shell: bedit draws the prompt, a line runs as `sh -c`, a `(`-form evaluates.

;; ---- C-c C-c: interrupt the running command (issues.md P9) --------------------

(describe "cmd-bshell-interrupt"
  ;; a real shell worker, answering this test (`editor/ui/*loop*`) rather than `:editor`
  :isolated (test "interrupts a running command and everything it started"
    (let (worker (binding (editor/ui/*loop* (self))
                   (bshell/bshell-connect bshell-name (path/temp-root)))
          next-event (fn () (receive (e :when (record? e) e) (after 5000 :timeout))))
      ;; the line runs through the platform's shell: cmd.exe on Windows, where `ping` is the
      ;; wait every install has
      (send worker
        [:bshell-run
          (if (= (os/type) :windows)
            "echo ready& ping -n 30 127.0.0.1 >nul& echo after"
            "echo ready; sleep 30; echo after")])
      (assert= (string/trim-right (or (:text (next-event)) "")) "ready")
      (let (m (cmd-bshell-interrupt (set-field (set-field (bshell-model) :bshell-proc worker)
                                      :input-running true)
                nil))
        (assert= (:echo m) "interrupted"))
      ;; `sleep` holds the pipe: only a signal to the whole group ends the command at once
      (let (done (next-event))
        ;; the done event (it has a `:code`; an output event has `:text`), not the 5 s timeout
        (is (contains? done :code)))
      (bshell/bshell-shutdown worker)))
  (test "says so when nothing is running, and sends nothing"
    (let (m (cmd-bshell-interrupt (set-field (bshell-model) :bshell-proc (self)) nil))
      (assert= (:echo m) "no command running")
      (is (nil? (receive ([:bshell-interrupt] :sent) (after 100 nil)))))))
