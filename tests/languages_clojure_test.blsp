;; Clojure (src/languages/clojure.blsp): a `deflisp` over src/languages/lisps.blsp — its file
;; patterns and the Clojure heads it paints as special forms.
(defmodule languages-clojure-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model face-at]))

(describe "clojure-mode"
  (test "the file patterns route, and Clojure's heads paint as specials"
    (assert= (ed-buf-mode-name (cur (file-model "(ns x)" "core.cljs"))) "clojure")
    (assert= (ed-buf-mode-name (cur (file-model "{}" "deps.edn"))) "clojure")
    (let (src "(defn f [x] (->> x))"
          spans (languages/clojure/clojure-fontify src)
          special (editor/face/face :syntax/special))
      (assert= (face-at spans src "defn") special)
      (assert= (face-at spans src "->>") special))))
