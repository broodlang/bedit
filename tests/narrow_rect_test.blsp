;; tests/narrow_rect_test.blsp — per-pane narrowing (C-x n) and rectangles (C-x r).
;;
;; Narrowing is a PANE focus, not a buffer mode: `:restrict` on the pane confines the view
;; and point to a region, and another pane on the same buffer stays wide. Rectangles are
;; the column-block commands over `editor/buffer`'s pure ops, with a rectangle kill ring on
;; the model. Both are driven through `ed-update` so the point-clamp and scroll clamp run
;; exactly as they do live; the render slice + mode-line indicator are read off `ed-view`.

(defmodule narrow-rect-test
  (:use test)
  (:use model)
  (:use input)
  (:use commands)
  (:use view) ; ed-view — read the painted frame (render slice + mode-line indicator)
  (:use panes) ; ed-body-layout — inspect a non-selected pane's payload
  (:use editor/buffer))

(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn twenty-lines ()
  ;; a 20-line buffer in an 80x12 pane, one frame in so the layout exists
  (let (txt (string/join (map (range 20) (fn (i) (str "line" i))) "\n"))
    (ed-update (ed-init (make-buffer txt "x.txt" "x.txt")) [:resize 80 12] 80 12)))
(defn line-start (m l) (text/line->char (buffer-rope (cur m)) l))
(defn painted-lines (m)
  (seq/keep (ed-view m 80 12)
    (fn (op)
      (if (and (= (first op) :text) (string/starts-with? (nth op 3 "") "line")) (nth op 3) nil))))

(describe "narrowing: a per-pane focus"
  (defn narrowed-5-9 ()
    ;; mark at line5 start, point at line9 start → region covers lines 5..9
    (let (m (twenty-lines)
          b (assoc (goto-char (cur m) (line-start m 9)) :mark (line-start m 5)))
      (commands/cmd-narrow-to-region (ed-set-buf m b) nil)))

  (test "C-x n n sets the pane's restriction, drops the mark, points at the top"
    (let (m (narrowed-5-9))
      (is (not (nil? (ed-selected-restrict m))))
      (is (nil? (buffer-mark (cur m))))
      (assert= (buffer-current-line (cur m)) 5)
      (is (includes? (:echo m) "Narrowed"))))

  (test "the pane renders only the narrowed lines"
    (assert= (painted-lines (ed-update (narrowed-5-9) [:resize 80 12] 80 12))
      (list "line5" "line6" "line7" "line8" "line9")))

  (test "point is confined to the region — motion stops at either edge"
    (let (m (ed-update (narrowed-5-9) [:resize 80 12] 80 12)
          up (press m [:ctrl-p :ctrl-p :ctrl-p :ctrl-p :ctrl-p :ctrl-p :ctrl-p :ctrl-p])
          dn (press m [:ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n :ctrl-n]))
      (assert= (buffer-current-line (cur up)) 5) ; can't rise above the region
      (assert= (buffer-current-line (cur dn)) 9))) ; …or fall below it
  (test "the mode line says ⊸ Narrowed while focused, and stops when widened"
    (let (m (ed-update (narrowed-5-9) [:resize 80 12] 80 12))
      (is (any? (ed-view m 80 12)
            (fn (op) (and (= (first op) :text) (includes? (nth op 3 "") "Narrowed")))))
      (let (w (ed-update (commands/cmd-widen m nil) [:resize 80 12] 80 12))
        (is (nil? (ed-selected-restrict w)))
        (is (not (any? (ed-view w 80 12)
                   (fn (op) (and (= (first op) :text) (includes? (nth op 3 "") "Narrowed")))))))))

  (test "C-x n d narrows to the defun around point (brood-mode)"
    (let (m (ed-update (ed-init (make-buffer "(defn a () 1)\n(defn b () 2)\n(defn c () 3)"
                                  "x.blsp" "x.blsp"))
              [:resize 80 12]
              80
              12)
          at-b (ed-set-buf m (goto-char (cur m) 16)) ; inside (defn b …)
          n (commands/cmd-narrow-to-defun at-b nil))
      ;; defun-start 14, forward 27 → the middle form's char span (its own line)
      (assert= (ed-selected-restrict n) [14 27])
      (assert= (buffer-current-line (cur n)) 1)
      ;; the frame paints the digit unique to line 1 and neither of the others (brood-mode
      ;; fontifies each line into many face fragments, so we test by unique content, not by
      ;; one op holding the whole line)
      (let (nums (seq/keep (ed-view (ed-update n [:resize 80 12] 80 12) 80 12)
                   (fn (op)
                     (if (and (= (first op) :text) (includes? "123" (nth op 3 ""))) (nth op 3) nil)))
            joined (string/join nums ""))
        (is (includes? joined "2"))
        (is (not (includes? joined "1")))
        (is (not (includes? joined "3"))))))

  (test "editing inside a narrowing grows it (outward gravity) — new text stays in view"
    (let (m (ed-update (narrowed-5-9) [:resize 80 12] 80 12)
          ;; go to end of the region (line9) and type — the region's hi must grow with it
          at-end (press m [(keyword "alt->")]) ; M-> clamps to the region's last position
          typed (press at-end (string/->list "XYZ")))
      (let ([lo hi] (ed-selected-restrict typed))
        (assert= hi (+ (second (ed-selected-restrict m)) 3)) ; hi grew by the 3 chars
        ;; the typed text is inside the region and still painted
        (is (any? (ed-view (ed-update typed [:resize 80 12] 80 12) 80 12)
              (fn (op) (and (= (first op) :text) (includes? (nth op 3 "") "XYZ"))))))))

  (test "widen on a wide pane says so, and changes nothing"
    (let (m (twenty-lines))
      (is (includes? (:echo (commands/cmd-widen m nil)) "not narrowed"))))

  (test "narrowing is PER PANE — a split shows the same buffer wide beside the focus"
    ;; C-x 3 splits; narrow the selected (left) pane; the other pane keeps the full view
    (let (m (narrowed-5-9)
          split (ed-update m [:resize 80 12] 80 12)
          two (press split [:ctrl-x "3"]) ; split right; both show the buffer
          other (press two [:ctrl-x "o"]) ; move to the right pane
          wide (ed-update other [:resize 80 12] 80 12))
      ;; the right pane was made by the split from the (narrowed) left, so it inherits the
      ;; restriction — widen it and it shows all; the left stays narrowed. The property we
      ;; pin is that widening ONE pane leaves the other's restriction intact.
      (let (widened-right (commands/cmd-widen wide nil))
        (is (nil? (ed-selected-restrict widened-right))) ; right pane wide now
        (is (not (nil? (get-in (first (:panes (ed-body-layout widened-right 80 12)))
                         [:payload :restrict])))))))) ; left pane still narrowed
(describe "rectangles (C-x r k/y/d/o/c/t)"
  (defn rectm (text p mk)
    (let (m (ed-init (make-buffer text))) (ed-set-buf m (assoc (goto-char (cur m) p) :mark mk))))
  (defn lines-of (m) (string/split (buffer-text (cur m)) "\n"))
  ;; "abcde\nfghij\nklmno": point line0 col1 (=1), mark line2 col3 (=15) → cols [1,3)
  (def grid "abcde\nfghij\nklmno")

  (test "C-x r k kills the block and saves it; C-x r y yanks it back"
    (let (k (commands/cmd-kill-rectangle (rectm grid 1 15) nil))
      (assert= (lines-of k) (list "ade" "fij" "kno"))
      (assert= (:rectangle-kill k) (list "bc" "gh" "lm"))
      (let (y (commands/cmd-yank-rectangle (ed-set-buf k (goto-char (cur k) 0)) nil))
        (assert= (lines-of y) (list "bcade" "ghfij" "lmkno")))))

  (test "C-x r d / o / c act in place"
    (assert= (lines-of (commands/cmd-delete-rectangle (rectm grid 1 15) nil))
      (list "ade" "fij" "kno"))
    (assert= (lines-of (commands/cmd-open-rectangle (rectm grid 1 15) nil))
      (list "a  bcde" "f  ghij" "k  lmno"))
    (assert= (lines-of (commands/cmd-clear-rectangle (rectm grid 1 15) nil))
      (list "a  de" "f  ij" "k  no")))

  (test "a rectangle command with no mark says there is no region"
    (is (includes? (:echo (commands/cmd-kill-rectangle (ed-init (make-buffer grid)) nil))
          "no region"))
    (is (includes? (:echo (commands/cmd-delete-rectangle (ed-init (make-buffer grid)) nil))
          "no region")))

  (test "yank with an empty rectangle kill ring says so"
    (is (includes? (:echo (commands/cmd-yank-rectangle (ed-init (make-buffer grid)) nil)) "empty"))))
