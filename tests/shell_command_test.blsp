;; M-! / M-| and C-g: the command runs off the loop, and C-g stops it — the task AND the OS
;; command it is waiting on (brood ADR-514), not only the slot.
;;
;; Coverage:
;;   - C-g on a running M-! frees its slot, says it stopped, and the shell's process is gone
;;   - a command that finishes is folded as before

(defmodule shell-command-test
  (:use test)
  (:use model)
  (:use input) ; ed-update — a reply through the loop's own update
  (:use pool) ; ed-open-buffer / ed-select
  (:use-internals shell-command) ; ed-shell-show — how a result is shown
  (:use editor/buffer))

(defn- sc-live (thunk)
  "Run `thunk` as the live loop would: the task's reply comes to this process."
  (binding (editor/ui/*loop* (self)) (thunk)))

(defn- sc-await (ready? what)
  "Wait for `ready?` to hold — a state of the OS another process changes, so there is no
message to receive — trying every 20 ms for up to ten seconds."
  (letrec (try-again (fn (left)
                       (cond
                         (ready?) true
                         (<= left 0) (error "sc-await: never " what)
                         else (receive (after 20 (try-again (dec left)))))))
    (try-again 500)))

(defn- sc-alive? (pid)
  "Whether OS process `pid` is still running."
  (= 0 (:exit (os/cmd "kill" ["-0" pid]))))

(describe "M-! and C-g"
  (test "C-g stops a running shell command on Windows — what cmd started too — and frees the slot"
    ;; cmd.exe is the shell there (os/shell): the line starts a grandchild that writes a
    ;; marker after two seconds; C-g at once must stop it, so the marker never appears
    (when (= (os/type) :windows)
      (let (dir (path/temp "bedit-shell-command-test-")
            _ (file/mkdir dir)
            marker (string/replace (path/join dir "marker") "/" "\\")
            m (ed-init (make-buffer ""))
            running (sc-live (fn ()
                               (shell-command/ed-shell-launch m
                                 (str "cmd /d /c \"ping -n 3 127.0.0.1 >nul & echo done> "
                                   marker "\"")
                                 nil
                                 (fn (mm _r) (message mm "finished")))))
            _ (receive (after 500 nil))
            quit (sc-live (fn () (commands/cmd-keyboard-quit running nil))))
        (is (nil? (:shell-proc quit)))
        (is (string/ends-with? (:echo quit) "stopped"))
        (receive (after 4000 nil))
        (is (not (file/exists? marker))))))
  (test "C-g stops a running shell command — its process too — and frees the slot"
    ;; sh syntax, and kill -0: not Windows's — the case above is
    (when (not (= (os/type) :windows))
      (let (dir (path/temp "bedit-shell-command-test-")
            _ (file/mkdir dir)
            pid-file (path/join dir "pid")
            m (ed-init (make-buffer ""))
            running (sc-live (fn ()
                               (shell-command/ed-shell-launch m
                                 (str "echo $$ > " (os/shell-quote pid-file) "; exec sleep 60")
                                 nil
                                 (fn (mm _r) (message mm "finished")))))
            _ (sc-await (fn ()
                          (and (file/exists? pid-file)
                            (not (= "" (string/trim (file/slurp pid-file))))))
                "wrote its pid")
            pid (string/trim (file/slurp pid-file))
            alive-before? (sc-alive? pid)
            quit (sc-live (fn () (commands/cmd-keyboard-quit running nil))))
        (is alive-before?)
        ;; C-g says what it stopped, after its own word — a hook's message is not overwritten
        (is (nil? (:shell-proc quit)))
        (is (string/starts-with? (:echo quit) "quit — echo $$ > "))
        (is (string/ends-with? (:echo quit) "exec sleep 60 stopped"))
        ;; the command itself, not just the task, is gone
        (sc-await (fn () (not (sc-alive? pid))) "was killed"))))
  (test "a command that finishes is folded through its continuation"
    (let (m (ed-init (make-buffer ""))
          running (sc-live (fn ()
                             (shell-command/ed-shell-launch m
                               "echo hi"
                               nil
                               (fn (mm r) (message mm (str "said " (string/trim (:stdout r))))))))
          handle (:shell-proc running)
          event (receive
                  ([:task-done ^handle value] [:task-done handle value])
                  (after 20000 (error "the shell command never answered")))
          landed (sc-live (fn () (ed-update running event 80 24))))
      (assert= (:echo landed) "said hi")
      (is (nil? (:shell-proc landed))))))

(describe "M-! output's ANSI escapes (issue #24)"
  (test "one coloured line reaches the echo area with no escape in it"
    (let (m (shell-command/ed-shell-show (ed-init (make-buffer ""))
              "ls"
              {:exit 0 :stdout "\e[01;34mdir\e[0m\r\n" :stderr ""}))
      (assert= (:echo m) "dir")))
  (test "several lines go to *Shell Command Output* with their colours as faces"
    (let (m (shell-command/ed-shell-show (ed-init (make-buffer ""))
              "ls"
              {:exit 0 :stdout "\e[01;34mdir\e[0m\nfile\n" :stderr "\e]0;title\x07warn\n"})
          buf (ed-buf-at m (ed-buffer-index-by-name! m "*Shell Command Output*")))
      (assert= (buffer-text buf) "dir\nfile\nwarn\n")
      (assert= (into []
                 (map (processes/ansicolor/colour-spans buf) (fn (s) [(first s) (second s)])))
        [[0 3]])
      (is (:bold (nth (first (processes/ansicolor/colour-spans buf)) 2))))))

(defn- sc-region-model (text lo hi)
  ;; a model on `a.txt` holding `text`, its region lo..hi; a second buffer `b.txt` beside it
  (let (a (goto-char (set-mark (goto-char (make-buffer text "a.txt") lo)) hi)
        m (ed-open-buffer (ed-init (make-buffer "other" "b.txt")) a))
    m))

(defn- sc-text (m name) (buffer-text (ed-buf-at m (ed-buffer-index-by-name! m name))))

(describe "C-u M-| lands in the buffer it was run from"
  (test "the region is replaced in its own buffer though another is current now"
    (let (m (sc-region-model "b\na\n" 0 4)
          target {:name "a.txt" :lo 0 :hi 4 :input "b\na\n"}
          elsewhere (ed-select m (ed-buffer-index-by-name! m "b.txt"))
          done (shell-command/shell-region-result elsewhere
                 "sort"
                 {:exit 0 :stdout "a\nb\n"}
                 target
                 true))
      (assert= (sc-text done "a.txt") "a\nb\n")
      (assert= (sc-text done "b.txt") "other")))
  (test "a region edited while the command ran is left alone, and said"
    (let (m (sc-region-model "b\na\n" 0 4)
          target {:name "a.txt" :lo 0 :hi 4 :input "b\na\n"}
          edited (ed-update-named m "a.txt" (fn (buffer) (insert (goto-char buffer 0) "x")))
          done (shell-command/shell-region-result edited
                 "sort"
                 {:exit 0 :stdout "a\nb\n"}
                 target
                 true))
      (assert= (sc-text done "a.txt") "xb\na\n")
      (is (includes? (:echo done) "changed"))))
  (test "a buffer killed while the command ran: the output is shown instead"
    (let (m (ed-init (make-buffer "other" "b.txt"))
          target {:name "a.txt" :lo 0 :hi 4 :input "b\na\n"}
          done (shell-command/shell-region-result m "sort" {:exit 0 :stdout "a\nb\n"} target true))
      (assert= (sc-text done "b.txt") "other")
      (is (includes? (:echo done) "a.txt is gone")))))
