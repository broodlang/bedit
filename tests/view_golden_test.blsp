;; tests/view_golden_test.blsp — the frames the view paints, op for op, for a fixed set of
;; editor states: the guard a refactor of the view runs under. A step that moves code between
;; modules must leave every frame here the same; one that changes what is painted on purpose
;; re-blesses the frames it meant to change (`BLESS=1 nest test tests/view_golden_test.blsp`)
;; and the diff of tests/golden/view/ shows what moved.
;;
;; Each scenario is a model built with the editor's own keys (`testkit/press`, at the 80×24 the
;; frame is painted at), harvested as the window receives it (`editor/ui/ui-harvest`: memo
;; markers and `[:translate]` resolved), one op per line.

(defmodule view-golden-test
  (:use test)
  (:use model)
  (:use view)
  (:use main :only []) ; every override, highlight and note source the editor registers
  (:use editor/buffer))

(def- cols 80)
(def- rows 24)

(def- brood-source
  "(defmodule demo\n  \"A module to look at.\")\n\n(defn greet (name)\n  ;; say hello\n  (str \"hello, \" name \"!\"))\n\n(defn sum (xs)\n  (fold xs 0 (fn (acc x) (+ acc x))))\n\n(def answer 42)\n")

(def- long-line
  (str "a line long enough to wrap past the right edge of an eighty column frame, "
    "and then some more words so that it wraps a second time as well, which is the case "
    "the row table exists for.\nshort\n"))

(defn- brood-model (text)
  ;; one pane on a Brood buffer — coloured by its CST, which needs no grammar
  (ed-init (editor/layers/set-buffer-type (make-buffer text "demo.blsp") :brood)))

(defn- terminal (m) (dissoc (assoc m :terminal true) :gui))

(defn- gui (m) (assoc m :gui true))

(def- scenarios
  ;; name → the model painted
  [["plain" (fn () (gui (brood-model brood-source)))]
    ["plain-terminal" (fn () (terminal (brood-model brood-source)))]
    ["region"
      (fn ()
        (gui (testkit/press (brood-model brood-source)
               [:ctrl-n :ctrl-space :ctrl-n :ctrl-n :ctrl-e])))]
    ["split-right" (fn () (gui (testkit/press (brood-model brood-source) [:ctrl-x "3"])))]
    ["split-below-terminal"
      (fn () (terminal (testkit/press (brood-model brood-source) [:ctrl-x "2"])))]
    ["wrapped"
      (fn ()
        (gui (testkit/press (ed-init (make-buffer long-line "notes.txt"))
               [:alt-x "v" "i" "s" "u" "a" "l" "-" "l" "i" "n" "e" "-" "m" "o" "d" "e" :enter])))]
    ["isearch" (fn () (gui (testkit/press (brood-model brood-source) [:ctrl-s "x" "s"])))]
    ["narrowed"
      (fn ()
        (gui (testkit/press (brood-model brood-source)
               [:ctrl-n :ctrl-n :ctrl-n :ctrl-space :ctrl-n :ctrl-n :ctrl-x "n" "n"])))]
    ["minibuffer" (fn () (gui (testkit/press (brood-model brood-source) [:alt-x "g" "r" "e"])))]
    ["long-lines"
      (fn ()
        (gui (testkit/press (brood-model (str "(def short 1)\n(def a-long-one \""
                                           long-line "\")\n(def b 2)\n"))
               [:ctrl-n])))]
    ["long-lines-scrolled-terminal"
      (fn ()
        (terminal (testkit/press (brood-model (str "(def short 1)\n(def a-long-one \""
                                                long-line "\")\n(def b 2)\n"))
                    [:ctrl-n :ctrl-e])))]
    ["scrolled"
      (fn ()
        (gui (testkit/press (brood-model (string/join (map (range 120)
                                                        (fn (i) (str "(def line-" i " " i ")")))
                                           "\n"))
               [:ctrl-v :ctrl-v :ctrl-n :ctrl-n])))]])

(defn- op-list? (value)
  ;; a nested op list — what `[:above-seam ops]`, `[:scroll-region dy ops]` and the like hold
  (and (or (vector? value) (list? value))
    (not (empty? value))
    (every? value (fn (op) (and (vector? op) (keyword? (first op)))))))

(defn- op-lines (op indent)
  ;; `op` as lines: an op holding ops prints its head, then each of them a step further in,
  ;; so a golden diff shows the one op that moved rather than one long line
  (let (children (seq/filter op op-list?)
        head (into [] (seq/reject op op-list?)))
    (if (empty? children)
      (list (str indent (pr-str op)))
      (cons (str indent (pr-str head))
        (mapcat children (fn (ops) (mapcat ops (fn (child) (op-lines child (str indent "  "))))))))))

(defn- frame-lines (m)
  ;; the frame as the window receives it, one op per line
  (let (frame (first (editor/ui/ui-harvest (binding (editor/ui/*memo* {}) (ed-view m cols rows)))))
    (string/join (mapcat frame (fn (op) (op-lines op ""))) "\n")))

(defn- golden-path (name) (str "tests/golden/view/" name ".txt"))

(describe "the view's frames, op for op"
  (doseq (scenario scenarios)
    (let ([name build] scenario)
      (test name
        (let (painted (frame-lines (build))
              path (golden-path name))
          (if (= (os/env "BLESS") "1")
            (do (file/spit path (str painted "\n")) (is true))
            (do
              (is (file/exists? path))
              (assert= painted (string/trim-right (file/slurp path))))))))))
