;; src/org — Org highlighting and the outline, tested where they live.
(defmodule org-test (:use test) (:use org) (:use editor/face))

(defn spans-of (src)
  "Each span of `src` as `[text face]`, for reading what was coloured."
  (map (org-spans src) (fn (span) [(string/substring src (nth span 0) (nth span 1)) (nth span 2)])))

(defn face-of (src needle)
  "The face of the span whose text is `needle`, or nil when nothing coloured it."
  (second (seq/find (spans-of src) (fn (pair) (= (first pair) needle)))))

(describe "org-spans: headings"
  (test "stars, keyword, priority, title and tags each take their own span"
    (let (src "* TODO [#A] Write it :work:code:")
      (assert= (map (spans-of src) first) '("*" "TODO" " [#A]" " Write it " ":work:code:"))))
  (test "TODO takes the error face and DONE the string face, both bold"
    (assert= (face-of "* TODO a" "TODO") (merge (face :syntax/error) {:bold true}))
    (assert= (face-of "* DONE a" "DONE") (merge (face :syntax/string) {:bold true})))
  (test "levels cycle through four faces, as Org's org-level-N do"
    (assert= (face-of "* a" "*") (merge (face :syntax/function) {:bold true}))
    (assert= (face-of "** a" "**") (merge (face :syntax/keyword) {:bold true}))
    (assert= (face-of "* a" "*") (face-of "***** a" "*****")))
  (test "a starred word that is not followed by a space is not a heading"
    (assert= (face-of "*bold* text" "*bold*") {:bold true})))

(describe "org-spans: lines"
  (test "a #+KEYWORD: line, a comment, a drawer and a list bullet"
    (assert= (map (spans-of "#+TITLE: Notes") first) '("#+TITLE:" " Notes"))
    (assert= (face-of "# a comment" "# a comment") (face :syntax/comment))
    (assert= (map (spans-of ":PROPERTIES:") first) '(":PROPERTIES:"))
    (assert= (map (spans-of "- [X] done") first) '("-" "[X]")))
  (test "inside a #+BEGIN_ block nothing is a heading, and the block ends at #+END_"
    (let (src "#+BEGIN_SRC elixir\n* not a heading\n#+END_SRC\n* heading")
      (assert= (face-of src "* not a heading") (face :syntax/string))
      (assert= (map (spans-of "#+begin_quote\nx\n#+end_quote\n* h") first)
        '("#+begin_quote" "x" "#+end_quote" "*" "h")))))

(describe "org-spans: inline markup"
  (test "the six emphasis markers, a link and a timestamp"
    (let (src "*b* /i/ _u_ =v= ~c~ +s+ [[https://orgmode.org][Org]] <2026-10-18 Sun>")
      (assert= (map (spans-of src) first)
        '("*b*" "/i/" "_u_" "=v=" "~c~" "+s+" "[[https://orgmode.org][Org]]" "<2026-10-18 Sun>"))))
  (test "a marker inside a word is not emphasis — the path in a URL stays plain"
    (assert= (spans-of "see http://a/b/c and snake_case_name") '())))

(describe "the outline"
  (test "heading-level counts stars a space follows"
    (assert= (heading-level "*** x") 3)
    (assert= (heading-level "*") nil)
    (assert= (heading-level "text") nil))
  (test "subtree-end stops before the next heading at the same level or above"
    (let (lines ["* a" "text" "** b" "more" "* c" "tail"])
      (assert= (subtree-end lines 0) 3)
      (assert= (subtree-end lines 2) 3)
      (assert= (subtree-end lines 4) 5)
      (assert= (subtree-end lines 1) 1)))
  (test "subtree-end-by reads lines one at a time and agrees with subtree-end"
    (let (lines ["* a" "text" "** b" "more" "* c" "tail"]
          line-at (fn (i) (nth lines i)))
      (assert= (map (range 6) (fn (i) (subtree-end-by line-at 6 i)))
        (map (range 6) (fn (i) (subtree-end lines i))))
      (assert= (subtree-end-by line-at 6 9) 9)))
  (test "cycle-todo steps none → TODO → DONE → none, keeping the title"
    (assert= (cycle-todo "** Write it") "** TODO Write it")
    (assert= (cycle-todo "** TODO Write it") "** DONE Write it")
    (assert= (cycle-todo "** DONE Write it") "** Write it")
    (assert= (cycle-todo "** NEXT Write it") "** DONE Write it")
    (assert= (cycle-todo "not a heading") "not a heading")))

(describe "a heading's parts, and the structure of plain lists"
  (test "a heading round-trips through its parts; the keyword and cookie are optional"
    (each ["* a" "** TODO [#B] Write it :work:" "*** DONE b" "* [#A] c"]
      (fn (line)
        (assert= (heading-line (or (heading-parts line) (error (str "not a heading: " line)))) line)))
    (assert= (heading-parts "text") nil))
  (test "the priority steps past the ends to none, and a heading with none starts at the end"
    (assert= (step-priority "* [#C] a" -1) "* a")
    (assert= (step-priority "* [#B] a" 1) "* [#A] a")
    (assert= (step-priority "* a" -1) "* [#C] a"))
  (test "a list item: bullets, numbers, a lower-case checkbox, and `*` only when indented"
    (assert= (:bullet (list-item "+ a")) "+")
    (assert= (:bullet (list-item "12) a")) "12)")
    (assert= (:checkbox (list-item "- [x] a")) "X")
    (assert= (:bullet (list-item "  * a")) "*")
    (assert= (list-item "* a") nil)
    (assert= (list-item "-a") nil))
  (test "an item ends before a blank line it does not go on after, and at a heading"
    (let (lines ["- a" "  more" "" "- b" "* H"]
          line-at (fn (i) (nth lines i)))
      (assert= (item-end-by line-at 5 0) 1)
      (assert= (item-sibling-by line-at 5 0 1) 3)
      (assert= (item-sibling-by line-at 5 3 1) nil)))
  (test "a heading's checkboxes are its entry's top-level items; deeper ones are their parents'"
    (let (lines ["* H [/]" "- [X] a" "  - [ ] a1" "- [ ] b" "* Next" "- [X] c"]
          line-at (fn (i) (nth lines i)))
      (assert= (checkboxes-under-by line-at 6 0) [1 2])
      (assert= (checkboxes-under-by line-at 6 1) [0 1])))
  (test "both cookies on one line are counted"
    (assert= (with-statistics "* a [/] [%]" 1 4) "* a [1/4] [25%]")
    (is (statistics? "x [3/4]"))
    (is (not (statistics? "x [#A]")))))

;; The windowed lead-in is cut at the band's own line unless a #+BEGIN_ block above it is
;; still open — the one state org-spans carries between lines.
(describe "org-fontify-restart"
  (test "the line itself outside a block, the block's opening line inside one"
    (let (src "* h\n#+begin_src\ncode\n#+END_SRC\nafter\n#+BEGIN_QUOTE\nquoted\n")
      (assert= (org-fontify-restart src 0) 0)
      (assert= (org-fontify-restart src (index-of src "code")) 4)
      (assert= (org-fontify-restart src (index-of src "after")) (index-of src "after"))
      (assert= (org-fontify-restart src (index-of src "quoted")) (index-of src "#+BEGIN_QUOTE"))))
  (test "a lex from the restart colours the line as a lex from the top does"
    (let (src "intro\n#+BEGIN_SRC\na\nb\nc\n#+END_SRC\n"
          pos (index-of src "c\n")
          restart (org-fontify-restart src pos)
          from-top (seq/find (org-spans src) (fn (span) (= (first span) pos)))
          windowed (seq/find (org-spans (string/substring src restart (string/length src)))
                     (fn (span) (= (+ restart (first span)) pos))))
      (is (not (nil? from-top)))
      (assert= (nth windowed 2) (nth from-top 2)))))
