;; JavaScript (src/languages/javascript.blsp): a `deflanguage` over tree-sitter-javascript, whose spec
;; TypeScript extends.
;; The mode half needs no grammar; the parsed half needs the grammar (`testkit/load-test-grammar`)
;; and SKIPS without it.
(defmodule languages-javascript-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model]))

(describe "javascript, the mode"
  (test "an .mjs file opens in javascript mode, formatted by prettier"
    (doseq (file ["app.mjs"])
      (let (buf (cur (file-model "" file)))
        (assert= (ed-buf-mode-name buf) "javascript")
        (assert= (first (model/ed-mode-service buf :format-command)) "prettier"))))
  (test "a node, nodejs, deno or bun script is javascript"
    (doseq (program ["node" "nodejs" "deno" "bun"])
      (assert= (ed-buf-mode-name (cur (file-model (str "#!/usr/bin/env " program "\nf()\n")
                                        "/p/run")))
        "javascript")))
  (test "it indents with spaces"
    (assert= (indent/ed-indentation (cur (file-model "" "app.js")) 4) "    ")))

(describe "javascript's fontify restart"
  (test "the previous column-0 line that starts an item"
    (let (src "function a() {\n  1;\n}\n\nfunction b() {\n  2;\n}\n")
      (assert= (languages/javascript/javascript-restart src (index-of src "  2"))
        (index-of src "function b"))))
  (test "a template string closed above cuts at the item after it"
    (let (src "const s = `\nfunction x() {}\n`;\nfunction b() {\n  2;\n}\n")
      (assert= (languages/javascript/javascript-restart src (index-of src "  2"))
        (index-of src "function b"))))
  (test "one still open across the candidate line cuts at the item line before its opener"
    (let (src "function a() {}\nfunction b() {\n  return `\nfunction x() {}\n  2;\n")
      (assert= (languages/javascript/javascript-restart src (index-of src "  2"))
        (index-of src "function b")))))

;; The sample, tests/corpus/javascript/cart.js (prettier), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart.
(def js-src (file/slurp "tests/corpus/javascript/cart.js"))

(test "javascript — C-M-a inside a method lands on the method"
  :skip-unless (testkit/load-test-grammar :javascript)
  "no javascript grammar"
  (assert= (languages/defun-start js-src :javascript (index-of js-src "return greet"))
    (index-of js-src "greet() {")))
