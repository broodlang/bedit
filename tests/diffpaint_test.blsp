;; src/diffpaint — a hunk painted as Magit and delta paint one: its code in its language's
;; colours, the words a changed line changed. Pure data in, spans and ranges out.

(defmodule diffpaint-test (:use test) (:use diffpaint))

(describe "diffpaint: the words that changed"
  (test "a changed word on a line, on both sides, past the sign"
    (assert= {0 [[9 10]] 1 [[9 10]]} (hunk-refine ["-let x = 1" "+let x = 2"])))
  (test "a block of removed lines against the added lines after it, by line"
    (let (refined (hunk-refine [" keep" "-alpha beta" "-gamma delta" "+alpha BETA" "+gamma delta"]))
      (assert= [[7 11]] (get refined 1))
      (assert= [[7 11]] (get refined 3))
      (is (not (contains? refined 2)))
      (is (not (contains? refined 4)))))
  (test "touching changed tokens are one range"
    (assert= [[1 6]] (get (hunk-refine ["-foo(a) + b" "+bar.x(a) + b"]) 1 [[1 4]])))
  (test "a line rewritten wholesale is left alone"
    (assert= {} (hunk-refine ["-the quick brown fox" "+completely other words here"])))
  (test "an added line with nothing removed before it has nothing to refine"
    (assert= {} (hunk-refine [" a" "+b" " c"]))))

(describe "diffpaint: the code's own colours"
  (test "each side is fontified as one snippet and cut back into lines, past the sign"
    (let (fontify (fn (src)
                    ;; colour every `x`
                    (seq/keep (range (count src))
                      (fn (i) (when (= (string/char-at src i) "x") [i (inc i) :keyword]))))
          syntax (hunk-syntax fontify [" ax" "-xb" "+cx"]))
      (assert= [[2 3 :keyword]] (into [] (nth syntax 0)))
      (assert= [[1 2 :keyword]] (into [] (nth syntax 1)))
      (assert= [[2 3 :keyword]] (into [] (nth syntax 2)))))
  (test "a span across lines is split at the newline"
    (let (syntax (hunk-syntax (fn (_src) [[1 5 :string]]) ["+ab" "+cd"]))
      (assert= [[2 3 :string]] (into [] (nth syntax 0)))
      (assert= [[1 3 :string]] (into [] (nth syntax 1)))))
  (test "no language, or a fontify that fails, paints nothing of its own"
    (is (nil? (hunk-syntax nil ["+a"])))
    (assert= [[]]
      (into [] (map (hunk-syntax (fn (_src) (error "boom")) ["+a"]) (fn (l) (into [] l)))))))

(describe "diffpaint: a background under ranges of a line's spans"
  (test "a range splits the spans it crosses and keeps their colour"
    (assert= [[0 2 {:fg "#f00"}] [2 4 {:fg "#f00" :bg "#000"}] [4 6 {:bg "#000"}]]
      (overlay [[0 4 {:fg "#f00"}]] [[2 6]] {:bg "#000"})))
  (test "no ranges, the spans as they were"
    (assert= [[0 1 :keyword]] (overlay [[0 1 :keyword]] [] {:bg "#000"}))))

(describe "theme: a tint from the palette"
  (test "a blend of two colours by weight"
    (assert= "#808080" (theme/mix "#ffffff" "#000000" 0.5))
    (assert= "#1e1e2e" (theme/mix "#a6e3a1" "#1e1e2e" 0))))

(describe "diffpaint: what is too big to paint"
  (test "a file past the cap keeps the plain colours"
    (is (paint? {:hunks [{:lines ["+a" "-b"]}]}))
    (is (not (paint? {:hunks [{:lines (into [] (map (range 3001) (fn (_i) "+x")))}]})))))

(describe "diffpaint: what one buffer paints"
  (test "files are painted in order until the buffer's budget runs out"
    (let (file (fn (n) {:hunks [{:lines (into [] (map (range n) (fn (_i) "+x")))}]})
          big *paint-file-cap*
          fits (math/quot *paint-buffer-cap* big))
      ;; as many whole files as the budget holds, then only what still fits
      (assert= (inc fits)
        (count (paint-keys (conj (into [] (map (range (inc fits)) (fn (i) [i (file big)])))
                             [:small (file 10)]))))
      (is (contains? (paint-keys (conj (into [] (map (range (inc fits)) (fn (i) [i (file big)])))
                                   [:small (file 10)]))
            :small))))
  (test "a file too big to paint costs the budget nothing"
    (assert= #{:small}
      (paint-keys [[:huge
                     {:hunks [{:lines (into [] (map (range (inc *paint-file-cap*)) (fn (_i) "+x")))}]}]
                    [:small {:hunks [{:lines ["+y"]}]}]])))
  (test "a hunk's paint is its syntax and its refinement, the same answer when asked again"
    (let (lines ["-let x = 1" "+let x = 2"]
          paint (hunk-paint "notes.txt" lines))
      (assert= (hunk-refine lines) (:refine paint))
      (assert= paint (hunk-paint "notes.txt" lines)))))
