;; The interactive bedit tutorial (`src/tutor.blsp`) — pure model tests: the box
;; parser and skeleton, the lesson render + re-stash across navigation, the
;; read-only prose (protected spans) through real `ed-update` dispatch, the parse gate
;; (E0002 = mid-typing = silence), the eval triple's headless sync fallback
;; (verdicts land as notes without a sandbox), stale-reply dropping, and the
;; playground commands (TAB / reset). No window, no subprocess — the sandboxed
;; path is covered by tests/sandbox_test.blsp.

(defmodule tutor-test
  (:use test)
  (:use model)
  (:use commands)
  (:use input)
  (:use editor/buffer)
  (:use-internals tutor)
  (:use-internals view) ; ed--tutor-note-ops — the ghost-text ops
  (:use-internals modes) ; mark--note-glyph — the gutter glyph mapping
  (:use tutor-lessons))

;; A model showing the tutorial at lesson 0, headless (no :editor process, so
;; cmd-tutorial starts no sandbox and evals fall back to in-image eval-capturing).
;; The shared fixture for CODE-box behaviour (evaluation, verdicts, warnings, the
;; incomplete-form voice). It deliberately does NOT open on lesson 1: the Navigation
;; section teaches movement on prose boxes, which are never evaluated, so a test about
;; results needs a lesson that ships Brood. `cmd-tutorial` itself (the entry point) is
;; covered separately by the navigation tests.
(defn tut-model ()
  (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving by structure")))
(defn tut-model-at-open () (tutor/cmd-tutorial (ed-init (make-buffer "")) nil))
(defn tut-buf (m) (ed-current-buf m))
(defn tut-text (m) (buffer-text (tut-buf m)))
(defn tut-regions (m) (tutor-regions (tut-text m)))
(defn tut-notes (m) (or (results/eol-notes (tut-buf m)) {}))
(defn tut-note-texts (m) (sort (map (tut-notes m) (fn (kv) (let ([_ n] kv) (:text n))))))
(defn key-into (m k) (ed-update m k 80 24))
;; look lessons up by TITLE, never by index — the course gets reordered, and an
;; index-keyed test just breaks somewhere unrelated when it does
(defn lesson-idx (title)
  (seq/find (range (count tutor-lessons)) (fn (i) (= (:title (nth tutor-lessons i)) title))))
(defn nav-count () (count (tutor/tutor-group-indices [:navigation nil])))

;; Move point into box `i` and let the tutor's own `:post-key` hook run — the real path
;; a motion takes (M-n, an arrow), which is what makes the *Workings* pane follow.
(defn tut-goto-box (m i)
  (let (r (nth (tut-regions m) i)
        moved (ed-edit m (fn (b) (goto-char b (+ (:start r) 2)))))
    (tutor/tutor-post-key m moved "M-n")))

;; The *Workings* text, or nil when the pane is closed.
(defn tut-workings (m)
  (let (wi (ed-buffer-index-by-name m "*Workings*"))
    (when wi (buffer-text (ed-buf-at m wi)))))

;; Put a cascade in the pane for box `i`, the way a sandbox reply does. Every pane test
;; goes through here rather than through a real trace: the headless evaluator deliberately
;; instruments NOTHING (tracing rebinds globals, and the globals here are shared by every
;; test process in the run), so a cascade in a test is a synthetic reply by construction.
;; What the reader actually sees is covered end to end by the pty drive.
(defn tut-cascade-reply (fname)
  {:ok true
   :value "6"
   :spy (list {:kind "call" :fn fname :args "(3)"} {:kind "return" :fn fname :value "6"})})

;; the same shape with no cascade — a box that ran and traced nothing
(defn tut-quiet-reply () {:ok true :value "6" :spy ()})

(defn tut-with-cascade (m i fname)
  (tutor-workings/show m i (tutor/tutor-box-at-point m) (tut-cascade-reply fname)))

;; a lesson rendered with point parked in box 0 (what `tutor--show` does)
(defn tut-page (title) (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx title)))

;; The index of the first box whose source mentions `needle` — tests say WHICH box they
;; mean by what is in it, so a reordered lesson doesn't silently test the wrong box.
(defn tut-box-with (m needle)
  (let (text (tut-text m)
        rs (tut-regions m))
    (seq/find (range (count rs))
      (fn (i)
        (includes? (string/substring text (:start (nth rs i)) (:end (nth rs i))) needle)))))

;; ---- the box parser -----------------------------------------------------------

(describe "tutor-regions (the one reader of the box syntax)"
  (test "no boxes, no regions"
    (assert= (tutor-regions "just prose\nno boxes here") ())
    (assert= (tutor-regions "") ()))

  (test "one box: content strictly between the delimiter lines, half-open"
    (let (text "prose\n╭─ Try ──\n(+ 1 2)\n╰────\ntail"
          r (first (tutor-regions text)))
      (assert= (string/substring text (:start r) (:end r)) "(+ 1 2)")
      (assert= (:open-line r) 1)
      (assert= (:close-line r) 3)))

  (test "several boxes, in order; multi-line content"
    (let (text "╭─ a ──\n(defn f (x)\n  x)\n╰──\n\n╭─ b ──\n(f 1)\n╰──"
          rs (tutor-regions text))
      (assert= (count rs) 2)
      (assert= (string/substring text (:start (first rs)) (:end (first rs))) "(defn f (x)\n  x)")
      (assert= (string/substring text (:start (second rs)) (:end (second rs))) "(f 1)")))

  (test "an empty box is empty, not inverted"
    (let (text "╭─ a ──\n╰──"
          r (first (tutor-regions text)))
      (assert= (:start r) (:end r))))

  (test "an unclosed box yields no region"
    (assert= (tutor-regions "╭─ a ──\n(+ 1 2)") ())))

(describe "tutor-skeleton (the prose-integrity query)"
  (test "box content never reaches the skeleton"
    (let (a "p\n╭─ t ──\n(+ 1 2)\n╰──\nq"
          b "p\n╭─ t ──\n(completely different)\n╰──\nq")
      (assert= (tutor-skeleton a) (tutor-skeleton b))))
  (test "prose, delimiters and box COUNT all do"
    (let (a "p\n╭─ t ──\nx\n╰──\nq")
      (is (not (= (tutor-skeleton a) (tutor-skeleton (string/replace a "p\n" "P\n")))))
      (is (not (= (tutor-skeleton a) (tutor-skeleton (string/replace a "╰──" "╰─x"))))))))

;; ---- render + open + navigation -------------------------------------------------

(describe "the *Tutorial* buffer"
  (test "cmd-tutorial opens lesson 1, typed :tutor, point in the first box"
    (let (m (tut-model-at-open)
          b (tut-buf m))
      (assert= (buffer-name b) "*Tutorial*")
      (is (includes? (tut-text m) (str "Brood Tutorial · Navigation — 1/" (nav-count))))
      ;; the prose/borders are frozen at the edit primitive: the complement of the boxes
      ;; is stamped as the buffer's read-only spans (ADR-219)
      (is (not (empty? (read-only-spans b))))
      ;; point parks in the first box, past its margin
      (assert= (buffer-point b) (+ (:start (first (tut-regions m))) 2))))

  (test "re-invoking cmd-tutorial resumes — playground edits survive"
    (let (m (tut-model)
          edited (ed-edit m (fn (b) (insert b "(noted)")))
          again (tutor/cmd-tutorial edited nil))
      (is (includes? (tut-text again) "(noted)"))))

  (test "C-c C-n advances within the section; C-c C-p returns"
    (let (m (tut-model-at-open)
          m2 (tutor/cmd-tutorial-next m nil))
      (is (includes? (tut-text m2) (str "Navigation — 2/" (nav-count))))
      ;; the fresh render re-stamped the read-only spans to match the new page's boxes
      (assert= (read-only-spans (tut-buf m2))
        (editor/formbuf/protected-spans (tut-text m2) (tutor-regions (tut-text m2))))
      (is (includes? (tut-text (tutor/cmd-tutorial-prev m2 nil))
            (str "Navigation — 1/" (nav-count))))))

  (test "every lesson renders under BOTH profiles, parses back box-for-box"
    (dolist (prof (list :emacs :vim))
      (dotimes (i (count tutor-lessons))
        (let (text (tutor-lesson-text i prof))
          (assert= (count (tutor-regions text))
            (count (:playgrounds (nth tutor-lessons i))))
          ;; no unrendered {{hole}} survives a render
          (is (not (includes? text "{{"))))))))

;; ---- read-only prose: protected spans through real dispatch ----------------------

(describe "editing inside vs outside a box"
  (test "typing INSIDE a box is an ordinary edit"
    (let (m (tut-model)
          m2 (key-into m "1"))
      (is (not (= (tut-text m2) (tut-text m))))))

  (test "typing in the prose is undone whole — text and point"
    (let (m (ed-apply (tut-model) (fn (b) (goto-char b 0)))
          m2 (key-into m "x"))
      (assert= (tut-text m2) (tut-text m))
      (assert= (buffer-point (tut-buf m2)) 0)))

  (test "backspacing a box delimiter from inside the box is undone"
    ;; point at a box's first char: backspace would eat the ╭ line's newline
    (let (m0 (tut-model)
          r (first (tut-regions m0))
          m (ed-apply m0 (fn (b) (goto-char b (:start r))))
          m2 (key-into m :backspace))
      (assert= (tut-text m2) (tut-text m))))

  ;; The original bug: holding backspace to clear a box sailed past the box start and ate
  ;; the ╭ border and the prose, because the HELD-key repeat path (`[:timer :key-repeat]` →
  ;; `ed-repeat-key-step`) never ran the reactive `:post-key` guard. Protection now lives at
  ;; the edit primitive (the box regions' complement is read-only — ADR-219), so `delete`
  ;; itself refuses the border char on every path; the repeat is no different from a tap.
  (test "REGRESSION: a HELD backspace repeat can't eat the box border"
    (let (m0 (tut-model)
          r (first (tut-regions m0))
          held (assoc (ed-apply m0 (fn (b) (goto-char b (:start r)))) :held-key :backspace)
          fired (ed-update held [:timer :key-repeat] 80 24))
      (assert= (tut-text fired) (tut-text held))))

  (test "REGRESSION: sustained held backspace against the border never damages the skeleton"
    (let (m0 (tut-model)
          r (first (tut-regions m0))
          held (assoc (ed-apply m0 (fn (b) (goto-char b (:start r)))) :held-key :backspace)
          ;; five repeat beats, as if the key stayed down at the boundary
          fired (fold (range 5) held (fn (m _) (ed-update m [:timer :key-repeat] 80 24))))
      (assert= (tutor-skeleton (tut-text fired)) (tutor-skeleton (tut-text held)))))

  ;; The FULL held-key lifecycle through real dispatch — a frontend that reports releases
  ;; (`:gui-keys`) so repeat engages. Covers everything the model can: a real press ARMS the
  ;; repeat (`ed-arm-repeat`/`ed-repeatable?`), the timer FIRES it, key-up STOPS it — with the
  ;; box border intact throughout. The one link a process test can't reach is the native
  ;; window poll `gui/held-key` (`ed-still-held?`), which needs a real window; here it falls
  ;; back to true, so the release path (`:key-up`) is what stops the loop, exactly as it does
  ;; on a real frontend when a key-up arrives.
  (test "held-key repeat lifecycle at a box edge: arm → fire → stop, guarded throughout"
    (let (m0 (assoc (tut-model) :gui-keys true)
          r (first (tut-regions m0))
          skel (tutor-skeleton (tut-text m0))
          ;; point at the box's first char; a REAL backspace press — refused (border), but it
          ;; arms hold-repeat because this frontend can later stop it
          pressed (ed-update (ed-apply m0 (fn (b) (goto-char b (:start r)))) :backspace 80 24))
      (assert= (:held-key pressed) :backspace) ; armed
      (assert= (tutor-skeleton (tut-text pressed)) skel) ; border untouched (refused)
      (let (repeated (fold (range 6) pressed (fn (m _) (ed-update m [:timer :key-repeat] 80 24))))
        (assert= (tutor-skeleton (tut-text repeated)) skel) ; still intact after the repeats
        (let (released (ed-update repeated [:key-up :backspace] 80 24))
          (is (nil? (:held-key released))))))) ; the release stops the repeat
  (test "the same held key INSIDE the box still edits (repeat is not blanket-suppressed)"
    ;; arm backspace in the middle of box content and confirm the timer deletes a char — the
    ;; guard refuses only at the protected edge, not everywhere
    (let (m0 (assoc (ed-tutor-launch (tut-model)) :gui-keys true)
          r (first (tut-regions m0))
          ;; put point a few chars into the box (past the margin + one code char)
          inside (ed-update (ed-apply m0 (fn (b) (goto-char b (+ (:start r) 4)))) :backspace 80 24)
          before-len (string/length (tut-text inside))
          repeated (ed-update inside [:timer :key-repeat] 80 24))
      (is (< (string/length (tut-text repeated)) before-len)))))

;; ---- the parse gate ---------------------------------------------------------------

(describe "tutor--parse-state (the on-type gate)"
  (test "blank says nothing" (assert= (liveeval/parse-state "  \n") :blank))
  (test "mid-typing (reader E0002) reports WHAT it is waiting for"
    ;; it used to return a bare :incomplete and the box showed nothing — a half-typed
    ;; form is not a mistake, but it isn't nothing either
    (let (s (liveeval/parse-state "(defn f (x)"))
      (assert= (first s) :incomplete)
      (is (includes? (second s) "unclosed list"))))
  (test "a real syntax error reports without a round-trip"
    (let (s (liveeval/parse-state "(+ 1 2))"))
      (assert= (first s) :err)))
  (test "a complete form is ready" (assert= (liveeval/parse-state "(+ 1 2)") :ok)))

;; ---- eval-on-type, headless sync fallback -----------------------------------------

(describe "ed-tutor-launch (headless: in-image fallback)"
  (test "stale until launched, then quiet until the text moves"
    (let (m (tut-model))
      (is (ed-tutor-stale? m))
      (let (m2 (ed-tutor-launch m))
        (is (not (ed-tutor-stale? m2)))
        (is (ed-tutor-stale? (ed-edit m2 (fn (b) (insert b " "))))))))

  (test "a code lesson's templates: the try-box reports a value, the exercise misses with its hint"
    (let (m (ed-tutor-launch (tut-model))
          notes (tut-note-texts m))
      (assert= (count notes) 2)
      (is (seq/find notes (fn (t) (string/starts-with? t "=> ")))) ; the try-box reports a value
      (is (seq/find notes
            (fn (t) (and (includes? t "✗ expected 42, got 41") (includes? t "hint:")))))))

  (test "fixing the exercise turns the note into a ✓"
    (let (m (tut-model)
          r (second (tut-regions m))
          fixed (ed-edit m
                  (fn (b)
                    (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                      "(* 6 7)")))
          m2 (ed-tutor-launch fixed)
          notes (tut-note-texts m2))
      (is (seq/find notes (fn (t) (= t "✓ 42"))))))

  (test "an incomplete box keeps its previous note, re-anchored (silence while mid-form)"
    (let (m (ed-tutor-launch (tut-model))
          r (second (tut-regions m))
          ;; truncate the exercise to an open paren — mid-typing
          broken (ed-edit m
                   (fn (b)
                     (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                       "(+ 40")))
          m2 (ed-tutor-launch broken))
      ;; the old ✗ is REPLACED by what the reader wants: carrying it left a verdict
      ;; standing beside text that can no longer produce it
      (is (not (seq/find (tut-note-texts m2) (fn (t) (includes? t "✗ expected 42")))))
      (is (seq/find (tut-note-texts m2) (fn (t) (includes? t "⋯ unclosed list"))))))

  (test "REGRESSION: an edit that shifts lines strands no phantom note (region-keyed rebuild)"
    (let (m (ed-tutor-launch (tut-model))
          lines-before (sort (map (tut-notes m) (fn (kv) (:line (second kv)))))
          ;; grow box 1 by a line: newline inside it shifts everything below down
          grown (ed-edit m (fn (b) (insert (goto-char b (:start (first (tut-regions m)))) "\n")))
          m2 (ed-tutor-launch grown)
          notes (tut-notes m2)
          lines-after (sort (map notes (fn (kv) (:line (second kv))))))
      (assert= (count notes) 2) ; one per box, structurally
      ;; both anchors moved down one line — and NOTHING remains at the old lines
      (assert= lines-after (map lines-before inc))))

  ;; The playground's lesson, applied back to the feature it came from: `results/eol-notes`
  ;; hides the whole set the moment the line count changes, so Enter used to blank every
  ;; verdict on the page until the debounce landed a quarter-second later.
  (test "Enter keeps every verdict on screen — the edit re-anchors, the debounce evaluates"
    (let (m (ed-tutor-launch (tut-model))
          before (tut-note-texts m)
          ;; a newline typed INSIDE the first box — the prose around it is protected, so an
          ;; edit anywhere else is refused and would prove nothing
          r (first (tut-regions m))
          typed (ed-edit m (fn (b) (insert (goto-char b (:start r)) "\n")))
          after (model/ed-post-step typed :none))
      (is (not (empty? before))) ; the fixture is worth something
      (is (not (= (tut-text typed) (tut-text m)))) ; …and the edit really landed
      (is (not (nil? (results/eol-notes (tut-buf after))))) ; renderable, not merely stored
      ;; the box's own verdict goes (its text changed, so it is no longer that answer's);
      ;; every OTHER box keeps its result, where the extra line put it
      (is (not (empty? (tut-note-texts after))))))

  (test "a note dims out via the rope stamp (staleness is detectable)"
    (let (m (ed-tutor-launch (tut-model))
          b (tut-buf m))
      (is (not (results/eol-notes-stale? b)))
      (let (m2 (ed-edit m (fn (bb) (insert bb "1"))))
        (is (results/eol-notes-stale? (tut-buf m2)))))))

;; ---- reply application (the async half, folded purely) ----------------------------

(defn tut-box-src (m i)
  (let (r (nth (tut-regions m) i)) (string/substring (tut-text m) (:start r) (:end r))))

;; The state a reply arrives into: box `i`'s request in flight, keyed by the source it was
;; sent for — `tutor-apply-reply` accepts on that, not on the rope of the whole page.
(defn tut-pending (m i id)
  (update m :tutor merge {:pending {id {:region i :src (tut-box-src m i)}}}))

(describe "tutor-apply-reply"
  (test "an unknown id is dropped"
    (let (m (tut-model))
      (assert= (tut-notes (tutor/tutor-apply-reply m {:id 999 :ok true :value "1"})) {})))

  (test "a reply whose box was edited since the send is dropped (and unpended)"
    (let (m (tut-model)
          pended (tut-pending m 0 7)
          r (first (tut-regions pended))
          moved (ed-edit pended (fn (b) (insert (goto-char b (:start r)) "x")))
          m2 (tutor/tutor-apply-reply moved {:id 7 :ok true :value "3"}))
      (assert= (tut-notes m2) {})
      (assert= (get-in m2 [:tutor :pending]) {})))

  ;; Why the test is the BOX and not the page: two boxes' answers are independent, and
  ;; dropping this one because you kept typing somewhere else is how fast typing lost
  ;; results — the launch had already recorded the send, so nothing re-sent them and the
  ;; box sat on its running indicator until its own text changed.
  (test "a reply still lands when the typing was in a DIFFERENT box"
    (let (m (tut-model)
          pended (tut-pending m 0 7)
          r (second (tut-regions pended))
          moved (ed-edit pended (fn (b) (insert (goto-char b (:start r)) "x")))
          m2 (tutor/tutor-apply-reply moved {:id 7 :ok true :value "3" :output ""}))
      (is (seq/find (tut-note-texts m2) (fn (t) (= t "=> 3"))))
      ;; …and only now is the box on the books as evaluated
      (assert= (get-in (tut-buf m2) [:tutor-srcs 0]) (tut-box-src m 0))))

  (test "a current reply lands as the box's note"
    (let (m (tut-model)
          pended (tut-pending m 0 7)
          m2 (tutor/tutor-apply-reply pended {:id 7 :ok true :value "3" :output ""}))
      (is (seq/find (tut-note-texts m2) (fn (t) (= t "=> 3"))))))

  (test "a timeout reply is a ✗ that names the restart key"
    (let (m (tut-model)
          pended (tut-pending m 0 7)
          m2 (tutor/tutor-apply-reply pended {:id 7 :ok false :timeout true}))
      (is (seq/find (tut-note-texts m2) (fn (t) (includes? t "timed out")))))))

;; ---- playground commands ------------------------------------------------------------

(describe "playground commands"
  (test "M-n hops to the next box and wraps"
    (let (m (tut-model)
          rs (tut-regions m)
          m2 (key-into m :alt-n))
      (assert= (buffer-point (tut-buf m2)) (+ (:start (second rs)) 2))
      (assert= (buffer-point (tut-buf (key-into m2 :alt-n))) (+ (:start (first rs)) 2))))

  (test "C-c C-r restores the box at point to its template"
    (let (m (tut-model)
          r (first (tut-regions m))
          template (string/substring (tut-text m) (:start r) (:end r))
          mangled (ed-edit m
                    (fn (b)
                      (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                        "(garbage)")))
          m2 (tutor/cmd-tutorial-reset-playground mangled nil)
          r2 (first (tut-regions m2)))
      (assert= (string/substring (tut-text m2) (:start r2) (:end r2)) template)))

  (test "C-c C-r outside any box explains itself"
    (let (m (ed-apply (tut-model) (fn (b) (goto-char b 0)))
          m2 (tutor/cmd-tutorial-reset-playground m nil))
      (assert= (tut-text m2) (tut-text m)))))

;; ---- feedback rendering (gutter mark / ghost text / echo / modeline chip) ---------

(describe "feedback rendering"
  (test "the gutter marks a box's verdict line — dimming once the text moves"
    (let (m (ed-tutor-launch (tut-model))
          b (tut-buf m)
          fail-line (first (sort (seq/keep (tut-notes m)
                                   (fn (kv)
                                     (when (= (:kind (second kv)) :fail)
                                       (:line (second kv))))))))
      (assert= (modes/gutter-mark-for b fail-line) ["✗" modes/gutter-face-test-fail])
      ;; an edit dims the mark (rope stamp), an inserted line blanks it (count). Both edits
      ;; land in box 1 (where point is parked) — the prose is read-only now, so the shift
      ;; has to come from inside a box, which also proves an in-box newline still flows.
      (let (dimmed (tut-buf (ed-edit m (fn (bb) (insert bb "1")))))
        (assert= (modes/gutter-mark-for dimmed fail-line) ["✗" modes/gutter-face-test-stale]))
      (let (shifted (tut-buf (ed-edit m (fn (bb) (insert bb "\n")))))
        (assert= (modes/gutter-mark-for shifted fail-line) nil))))

  (test "ghost text ops paint the note past the line's end"
    (let (m (ed-tutor-launch (tut-model))
          b (tut-buf m)
          ops (view/ed-eol-note-ops b 0 200 0 0 120 4 1 0))
      (assert= (count ops) 2) ; one per noted box
      (is (includes? (pr-str ops) "expected 42"))))

  (test "no notes, no ops — an ordinary buffer costs a field lookup"
    (assert= (view/ed-eol-note-ops (make-buffer "plain") 0 24 0 0 80 4 1 0) ()))

  (test "the echo line shows the full note at point, silenced when stale"
    (let (m (ed-tutor-launch (tut-model))
          note-line (first (sort (map (tut-notes m) (fn (kv) (:line (second kv))))))
          at (ed-apply m (fn (b) (commands/ed-goto-line b (inc note-line)))))
      (is (string? (view/ed-eol-note-on-line (tut-buf at))))
      (let (edited (ed-edit at (fn (b) (insert b "1"))))
        (assert= (view/ed-eol-note-on-line (tut-buf edited)) nil))))

  (test "the modeline chip counts the lesson and the exercises passed"
    (let (m (ed-tutor-launch (tut-model-at-open)))
      (assert= (tutor/tutor-modeline m (tut-buf m)) (str "Navigation 1/" (nav-count) " · ✓ 0/1"))
      (let (r (second (tut-regions m))
            ;; lesson 1's exercise is prose: solving it is typing the right words
            fixed (ed-edit m
                    (fn (b)
                      (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                        "  my keys are emacs")))
            m2 (ed-tutor-launch fixed))
        (assert= (tutor/tutor-modeline m2 (tut-buf m2))
          (str "Navigation 1/" (nav-count) " · ✓ 1/1")))))

  (test "the whole view renders a tutorial frame without throwing"
    (let (m (ed-tutor-launch (tut-model))
          f (view/ed-view m 100 30))
      (is (not (includes? (pr-str f) "render error"))))))

;; ---- review-fix regressions + the new keys -----------------------------------------

(describe "prose protection lives at the edit primitive (ADR-219)"
  (test "typing in the prose is refused; text untouched, movement never blocked"
    (let (m (ed-apply (tut-model) (fn (b) (goto-char b 0)))
          typed (key-into m "x"))
      (assert= (tut-text typed) (tut-text m)) ; the insert was refused at the mutator
      (is (> (buffer-point (tut-buf (key-into typed :right))) 0)))) ; the arrow still moves
  (test "refusal is per-edit — no state to brick; a box edit still lands after prose keys"
    ;; the reactive guard once had a was-intact-before rule to avoid bricking; the primitive
    ;; needs none — each edit is refused (or allowed) on its own, the buffer never gets stuck
    (let (m (ed-apply (tut-model) (fn (b) (goto-char b 0)))
          hammered (key-into (key-into (key-into m "x") :backspace) "y")
          r (first (tut-regions hammered))
          edited (key-into (ed-apply hammered (fn (b) (goto-char b (+ (:start r) 2)))) "Z"))
      (assert= (tutor-skeleton (tut-text hammered)) (tutor-skeleton (tut-text m))) ; prose intact
      (is (includes? (tut-text edited) "Z"))))) ; and the box edits normally
(describe "box navigation and TAB"
  (test "M-n hops to the next box; M-p and S-TAB hop back"
    (let (m (tut-model)
          rs (tut-regions m)
          m2 (key-into m :alt-n))
      (assert= (buffer-point (tut-buf m2)) (+ (:start (second rs)) 2))
      (assert= (buffer-point (tut-buf (key-into m2 :alt-p))) (+ (:start (first rs)) 2))
      (assert= (buffer-point (tut-buf (key-into m2 :back-tab))) (+ (:start (first rs)) 2))))

  (test "TAB in the prose is a no-op with a pointer, never an edit or a hop"
    (let (m (ed-apply (tut-model) (fn (b) (goto-char b 0)))
          m2 (key-into m :tab))
      (assert= (tut-text m2) (tut-text m))
      (assert= (buffer-point (tut-buf m2)) 0)))

  (test "TAB on an out-of-indent box line indents it (like every .blsp buffer)"
    ;; make box 2's form span two lines with the closer at column 0 — TAB should
    ;; pull the second line to its sexp indentation, not leave the box
    (let (m (tut-model)
          r (second (tut-regions m))
          split (ed-edit m
                  (fn (b)
                    (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                      "(+ 40\n1)")))
          rs (tutor-regions (tut-text split))
          r2 (second rs)
          ;; point on the second line of the box (the "1)" line)
          at (ed-apply split (fn (b) (goto-char b (- (:end r2) 1))))
          m2 (key-into at :tab))
      (is (not (= (tut-text m2) (tut-text at)))) ; the line moved
      (is (includes? (tut-text m2) "(+ 40\n  1)")))) ; to sexp indentation
  (test "TAB never navigates from inside a box (deterministic)"
    ;; on a correctly-indented box line TAB completes/indents — point must NOT
    ;; leave the box (the old adaptive TAB hopped here)
    (let (m (tut-model)
          m2 (key-into m :tab))
      (is (not (nil? (tutor/tutor-region-at (tut-regions m2) (buffer-point (tut-buf m2))))))))

  (test "RET inside a box auto-indents the new line (relative to the margined form)"
    ;; a CODE box: RET continues the form at the column the indenter would choose
    (let (m (tut-model)
          r (second (tut-regions m)) ; the bridge lesson's exercise: a `let`
          at (ed-apply m (fn (b) (goto-char b (+ (:start r) 13))))
          m2 (key-into at :enter)
          text (tut-text m2)
          ;; the line RET created starts at the indenter's column, not at column 0
          fresh (nth (string/split (string/substring text (:start r) (+ (:start r) 60)) "\n") 1 ""))
      (is (> (- (string/length fresh) (string/length (string/triml fresh))) 2))))

  (test "RET in a PROSE box keeps the margin instead of inventing Lisp columns"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          r (first (tut-regions m))
          at (ed-apply m (fn (b) (goto-char b (+ (:start r) 8))))
          m2 (key-into at :enter)
          text (tut-text m2)
          fresh (nth (string/split (string/substring text (:start r) (+ (:start r) 80)) "\n") 1 ""))
      (assert= (- (string/length fresh) (string/length (string/triml fresh)))
        (string/length tutor/*tutor-box-margin*))))

  (test "M-p from the first box wraps to the last"
    (let (m (tut-model)
          rs (tut-regions m)
          m2 (key-into m :alt-p))
      (assert= (buffer-point (tut-buf m2)) (+ (:start (last rs)) 2)))))

(describe "the workings pane (it follows the selected box)"
  ;; A synthetic reply, so these tests are about the PANE and not about the tracer: which
  ;; functions get instrumented is the sandbox's business, and in this shared test image
  ;; it depends on what earlier tests defined (the headless path evals in-image). The live
  ;; cascade is checked end-to-end by the pty drive instead.
  (test "a reply with a cascade for the box you are in opens *Workings* aside"
    (let (m (tut-with-cascade (tut-page "Functions") 0 "fac")
          wtext (tut-workings m))
      (is (not (nil? wtext)))
      (is (includes? wtext "The workings"))
      (is (includes? wtext "fac 3"))
      (is (includes? wtext "= 6"))))

  (test "a reply for a box you are NOT in updates its cache silently, pane untouched"
    ;; a background re-eval must not yank the view off the box you are reading
    (let (m (tut-with-cascade (tut-page "Functions") 1 "fac"))
      (assert= (tut-workings m) nil) ; no pane appeared
      (is (not (nil? (tutor-workings/cascade m 1)))) ; but it is cached
      ;; …and moving into that box shows it, without any re-evaluation
      (is (includes? (tut-workings (tut-goto-box m 1)) "fac 3"))))

  (test "a reply with no cascade does not open the pane, but is remembered as ran"
    (let (m (let (m (tut-page "Functions"))
              (tutor-workings/show m 0 (tutor/tutor-box-at-point m) (tut-quiet-reply))))
      (assert= (tut-workings m) nil)
      ;; remembered, and remembered as NOT worth a split — the two halves are separate
      ;; questions: what the pane shows, and what earns it the page
      (assert= (:traced? (get-in m [:tutor :workings 0])) false)
      (assert= (tutor-workings/cascade m 0) nil)
      ;; once the pane IS open, it still says what the box answered — and why there is no
      ;; cascade under it, which is not the same as nothing having happened
      (let (open-pane (tutor/cmd-tutorial-workings m nil))
        (is (includes? (tut-workings open-pane) "=> 6"))
        (is (includes? (tut-workings open-pane) "nothing of yours ran")))))

  (test "a LAUNCH opens the pane for a lesson that has workings, showing the box at point"
    ;; the launch-side entry point (`ed-tutor-launch` ends in a refresh): a page where some
    ;; box has a cascade is worth the split even when the box you are in has none. The
    ;; second launch changes nothing, so `tutor--forget-workings` keeps the cache — which is
    ;; how a seeded cascade survives into the launch under test.
    (let (page (tut-page "Functions")
          settled (ed-tutor-launch page) ; boxes evaluated, no pane
          _ (assert= (tut-workings settled) nil)
          seeded (assoc-in settled
                   [:tutor :workings 1]
                   {:traced? true :body "every traced call:\n\n  fac 3\n  = 6"})
          relaunched (ed-tutor-launch seeded))
      ; nothing changed → cache kept
      (is (not (nil? (tut-workings relaunched))))
      (is (includes? (tut-workings relaunched) "The workings"))
      ;; and it shows the box at POINT (box 0), not the box that has the cascade
      (assert= (tut-workings relaunched) (tutor-workings/body relaunched 0))))

  (test "the pane shows the box the cursor is in — whichever box that is"
    ;; the invariant, asserted against the model's own record
    (let (m (tut-with-cascade (tut-page "Functions")
              0 "fac")
          boxes (count (tut-regions m)))
      (assert= (map (range boxes)
                 (fn (i)
                   (let (after (tut-goto-box m i))
                     (= (tut-workings after) (tutor-workings/body after i)))))
        (map (range boxes) (fn (_) true)))))

  (test "…and it names the box, so a cascade is never mistaken for another box's"
    ;; a box with no cascade of its own must say whose pane this is
    (let (m (tut-with-cascade (tut-page "Functions")
              0 "fac")
          bodies (map (range (count (tut-regions m))) (fn (i) (tutor-workings/body m i)))
          ;; every body is either a cascade (headed by the shared title) or names its box
          ok (map (range (count bodies))
               (fn (i)
                 (let (b (nth bodies i))
                   (or (includes? b "every traced call")
                     (includes? b (str "box " (inc i))))))))
      (assert= ok (map bodies (fn (_) true)))))

  (test "moving to another box re-renders the pane WITHOUT re-evaluating anything"
    ;; the cache is what makes following the cursor free: no sandbox round trip, so the
    ;; pane keeps up with a motion
    (let (m (tut-with-cascade (tut-page "Functions")
              0 "fac")
          before (sandbox/sandbox-next-id m)
          moved (tut-goto-box m 1))
      (assert= (sandbox/sandbox-next-id moved) before) ; nothing was sent
      (is (not (nil? (tut-workings moved))))))

  ;; `tutor--workings-body` is the whole vocabulary of the pane, so it is worth pinning
  ;; directly — three cache states, three different things to say. No sandbox involved.
  (test "the body says which of the three states a box is in"
    (let (m (assoc-in (ed-init (make-buffer ""))
              [:tutor :workings]
              {0 {:traced? true :body "every traced call and return:\n\n  fac 3\n  = 6"}
               1 {:traced? false :body "=> 6\n\nnothing of yours ran"}}))
      (is (includes? (tutor-workings/body m 0) "fac 3")) ; has a cascade
      (is (includes? (tutor-workings/body m 1) "box 2")) ; ran, traced nothing
      (is (includes? (tutor-workings/body m 1) "nothing of yours ran"))
      (is (includes? (tutor-workings/body m 7) "box 8")) ; never ran
      (is (includes? (tutor-workings/body m 7) "has not run yet"))
      ;; and in prose, where there is no box at all
      (is (includes? (tutor-workings/body m nil) "put the cursor in"))))

  (test "a lesson where nothing traces opens no pane at all"
    ;; having something to show is what earns a split — a page of prose and motion
    ;; practice must not halve itself
    (let (m (ed-tutor-launch (tut-model)))
      (assert= (ed-buffer-index-by-name m "*Workings*") nil)))

  (test "a box traces what it defines and what it calls, so every box has workings"
    ;; the lesson no longer has to name anything: the box's own source says what is
    ;; interesting in it — the function it defines, and the ones it calls (the case that
    ;; matters, where the function came from a box further up)
    (let (names (tutor/tutor-trace-names {} "(defn double (x) (* x 2))\n(double 21)\n"))
      (is (includes? names "double")) ; defined here
      (refute (includes? names "defn")))) ; syntax, not a function
  (test "a box that only DEFINES is still traced — the call may come later"
    ;; the definition is offered on its own account, not because the box also calls it:
    ;; the next box's `(helper 2)` runs in the same session, and the trace is already on
    (let (names (tutor/tutor-trace-names {} "(defn helper (x) (inc x))\n"))
      (is (includes? names "helper"))))

  (test "a call of a function defined in an EARLIER box is traced"
    (let (names (tutor/tutor-trace-names {} "(triple 14)\n"))
      (is (includes? names "triple"))))

  (test "special forms are dropped, and the lesson's own :trace still rides along"
    (let (names (tutor/tutor-trace-names {:trace ["from-lesson"]} "(if true (fac 3) nil)\n"))
      (is (includes? names "from-lesson"))
      (is (includes? names "fac"))
      (refute (includes? names "if"))))

  (test "a name is offered once, however often the box mentions it"
    ;; the sandbox installs each trace once; a duplicate would be noise in the request
    (let (names (tutor/tutor-trace-names {:trace ["fac"]} "(fac (fac 2))\n"))
      (assert= (count (filter names (fn (s) (= s "fac")))) 1)))

  (test "the walk is structural: quoted data and let bindings offer names too"
    ;; documented, not accidental — over-naming is free (the tracer skips what it cannot
    ;; wrap) and resolving what is really a call would mean knowing the sandbox's globals
    (is (includes? (tutor/tutor-trace-names {} "'(secret-fn 1)") "secret-fn"))
    (is (includes? (tutor/tutor-trace-names {} "(let (helper 1) helper)") "helper"))
    ;; …and a form with no heads at all offers nothing
    (assert= (tutor/tutor-trace-names {} "[a b]") []))

  (test "a box that does not parse yet offers nothing, and does not raise"
    ;; mid-typing: `(fac ` has no verdict either, so there is nothing to trace
    (assert= (tutor/tutor-trace-names {} "(fac ") []))

  (test "the workings lines nest calls and returns"
    (assert= (tutor-workings/lines (list {:kind "call" :fn "fac" :args "(2)"}
                                     {:kind "call" :fn "fac" :args "(1)"}
                                     {:kind "return" :fn "fac" :value "1"}
                                     {:kind "return" :fn "fac" :value "2"}))
      (list "fac 2" "  fac 1" "  = 1" "= 2")))

  (test "a short cascade claims to be every call, and says nothing about a budget"
    (let (body (tutor-workings/text {:spy (list {:kind "call" :fn "fac" :args "(1)"}
                                            {:kind "return" :fn "fac" :value "1"})}))
      (is (includes? body "every traced call and return"))
      (refute (includes? body "trace budget"))))

  (test "a cascade that FILLED the budget says so instead of claiming to be complete"
    ;; the tail-loop case: the sandbox stops the trace at `*spy-entry-cap*` and the code
    ;; runs on untraced, so a pane promising \"every call\" would be lying — in the one
    ;; lesson whose subject is that a tail loop can run forever
    (let (entries (map (range eval-server/*spy-entry-cap*)
                    (fn (i) {:kind "call" :fn "countdown" :args (str "(" i ")")}))
          body (tutor-workings/text {:spy entries}))
      (is (tutor-workings/budget-spent? entries))
      (is (includes? body (str "the first " eval-server/*spy-entry-cap* " traced calls")))
      (is (includes? body "the code carried on untraced"))
      (refute (includes? body "every traced call and return")))))

(describe "per-box cursor memory"
  (test "each box remembers its own point across hops"
    (let (m (tut-model)
          rs (tut-regions m)
          ;; move 5 chars into box 1, hop to box 2, then hop back
          in1 (ed-apply m (fn (b) (goto-char b (+ (:start (first rs)) 5))))
          at2 (key-into in1 :alt-n)
          back (key-into at2 :alt-p))
      ;; box 2: first visit lands past its margin
      (assert= (buffer-point (tut-buf at2)) (+ (:start (second rs)) 2))
      (assert= (buffer-point (tut-buf back)) (+ (:start (first rs)) 5)))) ; box 1 remembered
  (test "a remembered offset clamps to the box's current size"
    (let (m (tut-model)
          rs (tut-regions m)
          ;; park DEEP in box 1, hop away (stores the deep offset), shrink box 1,
          ;; park in box 2 WITHOUT a hop (no memory update), then hop back: the
          ;; stored deep offset must clamp inside the now-tiny box
          deep (ed-apply m (fn (b) (goto-char b (:end (first rs)))))
          away (key-into deep :alt-n)
          shrunk (ed-edit away
                   (fn (b)
                     (insert (delete-region (assoc (goto-char b (:start (first rs)))
                                              :mark (:end (first rs))))
                       "(x)")))
          rs2 (tut-regions shrunk)
          in2 (ed-apply shrunk (fn (b) (goto-char b (:start (second rs2)))))
          back (key-into in2 :alt-p))
      (is (<= (buffer-point (tut-buf back)) (:end (first rs2))))
      (is (>= (buffer-point (tut-buf back)) (:start (first rs2)))))))

(describe "profile-dynamic lessons"
  (test "the same lesson teaches each profile its own keys"
    ;; lesson 2 (Moving around) names the motion keys; lesson 1 is the keys CHOICE
    (let (emacs-text (tutor-lesson-text (lesson-idx "Moving around") :emacs)
          vim-text (tutor-lesson-text (lesson-idx "Moving around") :vim))
      (is (includes? emacs-text "C-f / C-b"))
      (is (includes? vim-text "h / l"))
      (is (includes? vim-text "INSERT mode"))
      (is (not (includes? emacs-text "INSERT mode")))))

  (test "the keys CHOICE is the tutorial's first lesson, not a prompt"
    (let (text (tutor-lesson-text 0 :emacs))
      (is (includes? text "Choose your keys"))
      (is (includes? text "M-x vim-mode")) ; rendered for the active profile
      (is (includes? (tutor-lesson-text 0 :vim) ": vim-mode"))))

  (test "switching profiles re-renders the open lesson in place, keeping box edits"
    (let (m (tut-model-at-open)
          r (first (tut-regions m))
          ;; the user's code in box 1 must survive the switch
          edited (ed-edit m
                   (fn (b)
                     (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                       "  (my-marker)")))
          switched (commands/cmd-vim-mode edited nil)
          ;; the next dispatched key trips the guard's profile check
          m2 (key-into switched :down))
      (is (includes? (tut-text m2) ": vim-mode")) ; vim's prompt key, rendered live
      (is (includes? (tut-text m2) "(my-marker)")) ; the box edit survived
      ;; the re-render re-stamped the read-only spans to match the reflowed page
      (assert= (read-only-spans (tut-buf m2))
        (editor/formbuf/protected-spans (tut-text m2) (tutor-regions (tut-text m2))))))

  (test "verdict hints render for the active profile"
    ;; lesson 4 (Editing)'s exercise hint is a template; under vim it should
    ;; speak dd/o — exercise the sync-fallback path end to end
    (let (m (ed-tutor-launch (assoc (tutor/tutor-show (ed-init (make-buffer ""))
                                      (lesson-idx "Editing"))
                               :profile :vim))
          fail-notes (seq/keep (tut-notes m)
                       (fn (kv) (when (= (:kind (second kv)) :fail) (:text (second kv))))))
      ;; the claim is that the HINT speaks vim, not the exact wording of one hint
      (is (seq/find fail-notes (fn (t) (includes? t "dd"))))
      (is (not (seq/find fail-notes (fn (t) (includes? t "C-k"))))))))

;; ---- sections + the contents hub ------------------------------------------------

(describe "sections"
  (test "every lesson belongs to a registered section, and sections are contiguous"
    (dotimes (i (count tutor-lessons))
      (let ([sid sub] (tutor/tutor-group-of i))
        (is (not (nil? sid)))
        (is (seq/find tutor-sections (fn (s) (= (:id s) sid))))))
    ;; contiguity: every GROUP's indices are consecutive
    (doseq (e (tutor/tutor-groups))
      (when (:group e)
        (let (idxs (tutor/tutor-group-indices (:group e)))
          (is (not (empty? idxs)))
          (assert= idxs (range (first idxs) (+ (first idxs) (count idxs))))))))

  (test "the heading names the section and the position WITHIN it"
    (assert= (tutor/tutor-group-position 0) [1 (nav-count)]) ; Navigation 1/3
    (assert= (tutor/tutor-group-position 2) [3 (nav-count)]) ; Navigation 3/3
    (is (includes? (tutor-lesson-text 0 :emacs) (str "Navigation — 1/" (nav-count))))
    (is (includes? (tutor-lesson-text (lesson-idx "Editing") :emacs)
          (str "Editing — 1/" (count (tutor/tutor-group-indices [:editing nil]))))))

  (test "the first lesson opens in Navigation, not on the hub"
    (let (m (tut-model-at-open))
      (is (not (tutor/tutor-contents? m)))
      (assert= (first (tutor/tutor-group-of (get-in m [:tutor :lesson] 0))) :navigation))))

;; Lesson PROSE is never executed, so it rots silently. The code boxes have a test that runs
;; them ("a box only raises if the lesson SAYS it should"); the sentences around them had
;; nothing, and drifted: the strings lesson taught `upper`, `string-length`, `substring` and
;; `name` — none of which exist any more (they are `string/upper`, `string/length`,
;; `string/substring`, `->string`) — while its own code box three lines below already used
;; the right ones. A tutorial that teaches names the language does not have is worse than no
;; tutorial, and only this notices.
(def tutor-prose-non-names
  ;; Backticked things that are deliberately not globals: prose punctuation and typography.
  ["--"])

(defn tutor-backticked (s)
  "Every `backticked` span in `s` — the odd-indexed pieces of a split on the tick."
  (let (parts (string/split (or s "") "`"))
    (seq/keep (range (count parts)) (fn (i) (when (= 1 (math/mod i 2)) (nth parts i nil))))))

(defn tutor-lesson-prose (lesson)
  "Every human-facing string of `lesson` — body lines, box titles and hints."
  (append (or (:body lesson) [])
    (map (or (:playgrounds lesson) []) :hint)
    (map (or (:playgrounds lesson) []) :title)
    [(:title lesson)]))

(defn tutor-name-like? (w)
  "Does `w` read as a bare identifier the reader would type, rather than punctuation, a
keyword, a literal or a fragment of code?"
  (and (string? w)
    (> (string/length w) 1)
    (not (includes? w " "))
    (not (includes? w "("))
    (not (includes? w ")"))
    (not (includes? w "\""))
    (not (string/starts-with? w ":"))
    (not (includes? tutor-prose-non-names w))
    (regex/matches? "[a-zA-Z][a-zA-Z0-9/*!?<>=+-]*" w)))

(describe "the lessons teach names that exist"
  (test "every backticked identifier in lesson prose is bound (or is a special form)"
    (let (specials (map (reflect/special-forms) ->string)
          missing (seq/distinct (fold tutor-lessons
                                  []
                                  (fn (acc lesson)
                                    (append acc
                                      (filter (fold (tutor-lesson-prose lesson)
                                                []
                                                (fn (a line) (append a (tutor-backticked line))))
                                        (fn (w)
                                          (and (tutor-name-like? w)
                                            (not (bound? (symbol w)))
                                            (not (includes? specials w))))))))))
      (assert= (sort missing) '()))))

;; The edit boundary, stated as the property rather than as a handful of sampled positions.
;; Boundaries here were repeatedly wrong in ways individual cases kept missing, because the
;; old mechanism stored the COMPLEMENT of the boxes: an insert lands *between* two characters,
;; so at every edge "is this frozen?" had no answer from the frozen ranges alone, and the
;; predicate carried three special cases guessing one. The buffer is narrowed to its boxes
;; now, so there is one answer at every position — and this asserts it at ALL of them.
(describe "the edit boundary is exact"
  (test "on a real lesson page, editable agrees with in-a-box at every position"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) 0)
          b (ed-current-buf m)
          text (buffer-text b)
          regions (tutor/tutor-regions text)
          in-box? (fn (p) (any? regions (fn (r) (and (>= p (:start r)) (<= p (:end r))))))
          disagreements (filter (range (inc (buffer-length b)))
                          (fn (p)
                            (let (allowed (= :inserted
                                            (check-allow :discarded-catch
                                              (try
                                                (do (insert (goto-char b p) "x") :inserted)
                                                (catch e :refused)))))
                              (not (= allowed (in-box? p)))))))
      (is (> (count regions) 0)) ; the page really has boxes to be wrong about
      (assert= (count disagreements) 0)))

  ;; The hub has no boxes, so it narrows to NOTHING — and narrowed-to-nothing must not
  ;; collapse into not-narrowed. It did once: the regions came from `map` over an empty
  ;; sequence, and `'()` IS nil in Brood, so the whole hub silently became editable.
  (test "the hub narrows to nothing, and nothing on it is editable"
    (let (b (ed-current-buf (tutor/tutor-show-contents (ed-init (make-buffer "")))))
      (assert= (editor/buffer/editable-regions b) [])
      (is (not (any? (range (inc (buffer-length b)))
                 (fn (p)
                   (= :inserted
                     (check-allow :discarded-catch
                       (try (do (insert (goto-char b p) "x") :inserted) (catch e :refused)))))))))))

(describe "the contents hub"
  (test "finishing a section CONTINUES into the next one, saying so in passing"
    ;; Emacs Info's `n` follows the whole manual in order; being stopped every few
    ;; lessons to pick from a menu interrupts the one thing a tutorial is for
    (let (m (tut-model)
          last-nav (tutor/tutor-show m (last (tutor/tutor-group-indices [:navigation nil])))
          after (tutor/cmd-tutorial-next last-nav nil))
      (is (not (tutor/tutor-contents? after)))
      (assert= (first (tutor/tutor-group-of (get-in after [:tutor :lesson] 0))) :editing)
      ;; the reward still lands — in the echo line, which does not interrupt
      (is (includes? (:echo after) "Navigation complete"))))

  (test "…and at the very end there is nowhere to go"
    (let (m (tutor/tutor-show (tut-model) (dec (count tutor-lessons)))
          after (tutor/cmd-tutorial-next m nil))
      (assert= (get-in after [:tutor :lesson]) (dec (count tutor-lessons)))
      (is (includes? (:echo after) "end of the course"))))

  (test "the hub lists every entry with its lesson count, and the .blsp one by name"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil))
      (doseq (e (tutor/tutor-groups))
        (is (includes? (tut-text hub) (:title e))))
      (is (includes? (tut-text hub) "The Brood language (.blsp)")) ; the section header
      (is (includes? (tut-text hub) "Values & expressions")) ; its subsections
      (is (includes? (tut-text hub) "Processes"))
      (is (includes? (tut-text hub) "(3 lessons)"))))

  (test "a hub line resolves to its section (the link affordance) — prose lines don't"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          b (tut-buf hub)
          hits (seq/keep (range (buffer-line-count b))
                 (fn (i) (tutor/tutor-contents-section-at b i))))
      ;; each entry is two lines tall (title + blurb) and both resolve, so landing
      ;; anywhere in an entry works
      ;; two lines per clickable entry (▸ title + blurb); headers name no group
      (assert= (count hits) (* 2 (count (filter (tutor/tutor-groups) :group))))
      (assert= (first hits) [:navigation nil])
      (is (includes? hits [:language :functions]))))

  (test "a blurb line resolves to its section, so RET works anywhere in the entry"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          b (tut-buf hub)
          title-line (seq/find (range (buffer-line-count b))
                       (fn (i)
                         (= (tutor/tutor-contents-title-at b i) [:language :functions])))
          on-blurb (ed-apply hub (fn (bb) (commands/ed-goto-line bb (+ 2 title-line))))
          entered (key-into on-blurb :enter))
      (assert= (first (tutor/tutor-group-of (get-in entered [:tutor :lesson] 0))) :language)))

  (test "RET on a non-section line says what to do instead of silently doing nothing"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          on-header (ed-apply hub (fn (bb) (commands/ed-goto-line bb 1)))
          after (key-into on-header :enter))
      (is (tutor/tutor-contents? after)) ; still on the hub
      (is (includes? (:echo after) "▸ entry"))))

  (test "RET on a hub line enters that section's FIRST lesson"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          b (tut-buf hub)
          ;; find the .blsp section's line and put point there
          line (seq/find (range (buffer-line-count b))
                 (fn (i) (= (tutor/tutor-contents-section-at b i) [:language :basics])))
          on-it (ed-apply hub (fn (bb) (commands/ed-goto-line bb (inc line))))
          entered (key-into on-it :enter))
      (is (not (tutor/tutor-contents? entered)))
      (assert= (first (tutor/tutor-group-of (get-in entered [:tutor :lesson] 0))) :language)
      ;; derived, not hardcoded: the course grows, and "1/N" is not the claim here
      (is (includes? (tut-text entered)
            (str "Values & expressions — 1/"
              (count (tutor/tutor-group-indices [:language :basics])))))))

  (test "the hub is read-only: typing on it is vetoed like prose"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          typed (key-into hub "x"))
      (assert= (tut-text typed) (tut-text hub))))

  (test "C-c C-t reaches the hub from any lesson; C-c C-u goes UP to it"
    (let (m (tutor/tutor-show (tut-model) (lesson-idx "Everything is an expression")))
      (is (tutor/tutor-contents? (key-into (key-into m :ctrl-c) :ctrl-t)))
      (is (tutor/tutor-contents? (key-into (key-into m :ctrl-c) :ctrl-u)))))

  (test "C-c C-u lands on the entry for the group you were in"
    ;; Info's `u` puts you on the menu item you came from, not at the top of the list
    (let (m (tutor/tutor-show (tut-model) (lesson-idx "Everything is an expression"))
          group (tutor/tutor-group-of (get-in m [:tutor :lesson] 0))
          up (tutor/cmd-tutorial-up m nil)
          buf (tut-buf up))
      (assert= (tutor/tutor-contents-section-at buf (buffer-current-line buf)) group)))

  (test "C-c C-p crosses a section boundary backwards, rather than sidestepping to the hub"
    (let (first-of-section (tutor/tutor-show (tut-model)
                             (first (tutor/tutor-group-indices [:language :basics])))
          back (tutor/cmd-tutorial-prev first-of-section nil))
      (is (not (tutor/tutor-contents? back)))
      (assert= (get-in back [:tutor :lesson])
        (dec (first (tutor/tutor-group-indices [:language :basics]))))))

  (test "the modeline names the hub, and a lesson names its section"
    (let (hub (tutor/cmd-tutorial-contents (tut-model-at-open) nil)
          lesson (tut-model-at-open))
      (is (includes? (tutor/tutor-modeline hub (tut-buf hub)) "Tutorial contents"))
      (is (includes? (tutor/tutor-modeline lesson (tut-buf lesson))
            (str "Navigation 1/" (nav-count))))))

  (test "solved exercises persist on the model, so hub progress survives leaving"
    ;; Navigation's exercises are prose now — solving one is typing the right words,
    ;; and it counts towards the hub's progress exactly as an evaluated ✓ does
    (let (m (tut-model-at-open)
          r (second (tut-regions m))
          fixed (ed-edit m
                  (fn (b)
                    (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                      "  my keys are emacs")))
          evaled (ed-tutor-launch fixed)
          hub (tutor/cmd-tutorial-contents evaled nil))
      ;; the pass is remembered on the model…
      (is (not (empty? (get-in evaled [:tutor :passed]))))
      ;; …and shows as progress on the hub (1 of Navigation's exercises)
      (assert= (first (tutor/tutor-group-passed hub [:navigation nil])) 1))))

(describe "the command-prompt key is derived (vim has no M-x)"
  (test "emacs renders M-x, vim renders : — from the real bindings"
    (assert= (:kcmd (tutor/tutor-keyset :emacs)) "M-x")
    (assert= (:kcmd (tutor/tutor-keyset :vim)) ":"))
  (test "the keys lesson tells each profile the truth about its prompt key"
    (let (e (tutor-lesson-text (lesson-idx "Choose your keys") :emacs)
          v (tutor-lesson-text (lesson-idx "Choose your keys") :vim))
      (is (includes? e "M-x vim-mode"))
      (is (includes? v ": vim-mode"))
      (is (not (includes? v "M-x vim-mode"))))))

(describe "review regressions"
  (test "the hub STAYS the hub across a profile switch (RET must keep working)"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          switched (key-into (keymaps/ed-set-profile hub :vim) :down)
          b (tut-buf switched))
      (is (:tutor-contents? b)) ; the flag survived
      (is (includes? (tut-text switched) "contents")) ; and so did the page
      ;; …so RET still enters a section rather than being vetoed as prose
      (let (line (seq/find (range (buffer-line-count b))
                   (fn (i)
                     (= (first (or (tutor/tutor-contents-section-at b i) [])) :language)))
            entered (key-into (ed-apply switched (fn (bb) (commands/ed-goto-line bb (inc line))))
                      :enter))
        (assert= (first (tutor/tutor-group-of (get-in entered [:tutor :lesson] 0))) :language))))

  (test "the modeline service does NOT derive the key vocabulary (it runs every frame)"
    ;; a cheap proxy for the perf fix: 200 modeline calls must stay well under the
    ;; cost of 200 keyset derivations (which was ~4ms EACH)
    (let (m (tut-model)
          b (tut-buf m)
          t0 (os/now)
          _ (dotimes (i 200) (tutor/tutor-modeline m b))
          elapsed (- (os/now) t0))
      (is (< elapsed 200))))) ; i.e. < 1ms per frame
;; ---- subsections + the new content ----------------------------------------------

(describe "subsections"
  (test "the .blsp section is split into ordered subsections, all populated"
    (let (lang (tutor/tutor-section :language)
          subs (:subsections lang))
      (assert= (map subs :id) (list :basics :functions :matching :shapes :macros :names :processes))
      (doseq (x subs)
        (is (not (empty? (tutor/tutor-group-indices [:language (:id x)])))))))

  (test "a lesson in a subsection numbers within it, and the heading shows the crumb"
    (let (fn-idx (first (tutor/tutor-group-indices [:language :functions]))
          n (count (tutor/tutor-group-indices [:language :functions])))
      (assert= (tutor/tutor-group-position fn-idx) [1 n])
      (is (includes? (tutor-lesson-text fn-idx :emacs)
            (str "Brood Tutorial · The Brood language (.blsp) › Functions & data — 1/" n)))))

  (test "finishing a SUBSECTION continues into the next one"
    (let (idxs (tutor/tutor-group-indices [:language :basics])
          last-basics (tutor/tutor-show (tut-model) (last idxs))
          after (tutor/cmd-tutorial-next last-basics nil))
      (is (not (tutor/tutor-contents? after)))
      (assert= (tutor/tutor-group-of (get-in after [:tutor :lesson] 0)) [:language :functions])
      (is (includes? (:echo after) "Values & expressions complete"))))

  (test "the hub nests subsections under their section header"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          text (tut-text hub)
          ;; the section header names the topic and is NOT a ▸ entry
          header-line (seq/find (range (buffer-line-count (tut-buf hub)))
                        (fn (i)
                          (includes? (buffer-line-at (tut-buf hub) i)
                            "The Brood language (.blsp)"))))
      (is (nil? (tutor/tutor-contents-title-at (tut-buf hub) header-line)))
      ;; its subsections are indented ▸ entries that DO resolve
      (is (includes? text "    ▸ Functions & data"))
      (is (includes? text "  ▸ Navigation"))))

  (test "every group is reachable from the hub"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          b (tut-buf hub)
          reachable (into #{}
                      (seq/keep (range (buffer-line-count b))
                        (fn (i) (tutor/tutor-contents-section-at b i)))))
      (doseq (e (tutor/tutor-groups))
        (when (:group e) (is (contains? reachable (:group e))))))))

(describe "the new lessons all evaluate"
  ;; every shipped box must at least PARSE and run; each exercise must be solvable
  ;; (its hint is the fix, so the shipped code is expected to miss — but never to
  ;; error), and every :expect must be reachable.
  (test "every playground parses AFTER rendering, under both profiles"
    ;; lesson code is a template ({{motion-keys}} …), so it is the RENDERED text that
    ;; must parse — and it must parse for either keybinding profile
    (dolist (prof (list :emacs :vim))
      (let (keyset (tutor/tutor-keyset prof))
        (dotimes (i (count tutor-lessons))
          (doseq (pg (tutor/tutor-rendered-playgrounds (nth tutor-lessons i) keyset))
            ;; prose boxes are not Brood — they are exempt by construction, not by luck
            ;; (English mostly happens to read as a list of symbols, which would let a
            ;; broken code box hide here if we did not filter on the kind)
            (when (not (= (:kind pg) :text))
              (assert= (liveeval/parse-state (:code pg)) :ok)))))))

  (test "a box only raises if the lesson SAYS it should"
    ;; A miss is fine and a deliberate crash is fine -- an accidental one is not.
    ;; This used to grep the note for "unbound" and "✗ error", which let
    ;; `(defmacro unless …)` ship: "`unless` is a reserved name" matches neither, so
    ;; the lesson's headline box had never once run. `:error?` is the real property,
    ;; and a box that means to fail declares `:starts-with-error?`.
    (dotimes (i (count tutor-lessons))
      (let (m (ed-tutor-launch (tutor/tutor-show (ed-init (make-buffer "")) i))
            notes (or (results/eol-notes (tut-buf m)) {})
            pgs (tutor/tutor-playgrounds m))
        (dotimes (r (count pgs))
          (let (note (get notes r)
                pg (nth pgs r {}))
            (when (:error? note)
              (is (:starts-with-error? pg))))))))

  (test "the processes subsection has more than one lesson now"
    (is (> (count (tutor/tutor-group-indices [:language :processes])) 1)))

  (test "pattern matching, errors and the editor finale are in the course"
    (let (titles (map tutor-lessons :title))
      (is (includes? titles "Matching on shape"))
      (is (includes? titles "Destructuring"))
      (is (includes? titles "When things go wrong"))
      (is (includes? titles "A process that remembers"))
      (is (includes? titles "When a process dies"))
      (is (includes? titles "The editor is a Brood program"))
      (is (includes? titles "Redefining a command, live")))))

;; ---- selective re-evaluation: from the edited box DOWNWARD ------------------------

(describe "which boxes re-evaluate"
  (defn set-box (m i src)
    (let (r (nth (tut-regions m) i))
      (ed-edit m
        (fn (b)
          (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
            src)))))

  (test "the first launch evaluates every box (the session has to be seeded)"
    (let (m (ed-tutor-launch (tut-model)))
      (assert= (count (tut-notes m)) 2)
      ;; and each box's evaluated source is remembered
      (assert= (count (:tutor-srcs (tut-buf m))) 2)))

  (test "editing a box re-evaluates it — and its verdict changes"
    (let (m (ed-tutor-launch (tut-model))
          fixed (ed-tutor-launch (set-box m 1 "  (+ 40 2)")))
      (is (seq/find (tut-note-texts fixed) (fn (t) (= t "✓ 42"))))))

  (test "a box ABOVE the edit is not re-sent, but keeps its note (re-anchored)"
    (let (m (ed-tutor-launch (tut-model))
          before (:text (get (tut-notes m) 0))
          ;; edit box 1 (below box 0) and grow it by a line so anchors must move
          m2 (ed-tutor-launch (set-box m 1 "  (+ 40\n     2)"))
          note0 (get (tut-notes m2) 0))
      (assert= (:text note0) before) ; the same verdict
      (assert= (:line note0) (:line (get (tut-notes m) 0))) ; box 0 didn't move
      ;; box 0's source stamp is unchanged, box 1's is the new text
      (assert= (get (:tutor-srcs (tut-buf m2)) 0) (get (:tutor-srcs (tut-buf m)) 0))
      (is (includes? (get (:tutor-srcs (tut-buf m2)) 1) "(+ 40"))))

  (test "editing an EARLIER box re-evaluates the later ones too (they may depend on it)"
    ;; a two-box lesson where box 2 calls what box 1 defines: change the definition
    ;; and the dependent box's result must follow
    (let (m (ed-tutor-launch (tut-page "Functions")) ; Functions
          call-note (fn (mm) (:text (get (tut-notes mm) 1)))
          before (call-note m)
          m2 (ed-tutor-launch (set-box m 0 "  (defn double (x) (* 10 x))")))
      (assert= before "=> 42") ; (double 21) with *2
      (assert= (call-note m2) "=> 210"))) ; …and with *10, refreshed
  (test "a launch with nothing changed sends nothing and keeps every note"
    (let (m (ed-tutor-launch (tut-model))
          again (ed-tutor-launch m))
      (assert= (tut-note-texts again) (tut-note-texts m))
      (assert= (get-in again [:tutor :pending]) {}) ; nothing in flight
      (assert= (sandbox/sandbox-next-id again) (sandbox/sandbox-next-id m))))

  (test "mid-typing replaces the previous note with the reader's reason, and never clears"
    (let (m (ed-tutor-launch (tut-model))
          typing (ed-tutor-launch (set-box m 1 "  (+ 40"))
          note (get (tut-notes typing) 1))
      (is (not (nil? note))) ; still something on the line
      (assert= (:kind note) :incomplete)
      (is (includes? (:text note) "unclosed list"))
      (is (not (includes? (:text note) "expected 42"))))) ; the old verdict is gone
  (test "boxes ABOVE the edit keep their verdicts while one below is mid-typed"
    ;; only the edited box loses its result — the carry path is untouched by this change
    (let (m (ed-tutor-launch (tut-model))
          before (:text (get (tut-notes m) 0))
          typing (ed-tutor-launch (set-box m 1 "  (+ 40")))
      (assert= (:text (get (tut-notes typing) 0)) before))))

;; ---- running indicator + process/timing visibility --------------------------------

(describe "the running indicator"
  (test "a box sent to the sandbox shows as in-flight, not as a stale verdict"
    ;; the async path needs a live :editor, so drive tutor--set-note the way launch does
    (let (m (ed-tutor-launch (tut-model))
          running (tutor/tutor-set-note m 0 {:kind :running :text "⋯ evaluating…"})
          b (tut-buf running))
      (assert= (:kind (get (results/eol-notes b) 0)) :running)
      ;; the gutter shows ⋯ and does NOT pretend it's a pass/fail
      (let (line (:line (get (results/eol-notes b) 0)))
        (assert= (first (modes/gutter-mark-for b line)) "⋯"))
      ;; the ghost text renders it dim + italic (pending, not a result)
      (let (face (view/ed-eol-note-face :running false))
        (is (:italic face)))))

  (test "the modeline counts boxes in flight"
    (let (m (tut-model)
          pending (update m :tutor merge {:pending {1 {:region 0} 2 {:region 1}}}))
      (is (includes? (tutor/tutor-modeline pending (tut-buf pending)) "⋯ 2 evaluating"))
      (is (not (includes? (tutor/tutor-modeline m (tut-buf m)) "evaluating"))))))

(describe "process + timing visibility in a verdict"
  (test "a result that left a process running says so"
    (let (note (tutor/tutor-verdict {} {:ok true :value ":spawned" :procs {:alive 1}}))
      (is (includes? (:text note) "⚙ 1 process still running"))))

  (test "several surviving processes pluralise"
    (let (note (tutor/tutor-verdict {} {:ok true :value ":x" :procs {:alive 3}}))
      (is (includes? (:text note) "⚙ 3 processes still running"))))

  (test "a clean evaluation says nothing about processes"
    (let (note (tutor/tutor-verdict {} {:ok true :value "42" :procs {:alive 0}}))
      (assert= (:text note) "=> 42")))

  (test "a slow result carries its duration; a fast one doesn't"
    (is (includes? (:text (tutor/tutor-verdict {} {:ok true :value "42" :ms 900})) "(900ms)"))
    (is (not (includes? (:text (tutor/tutor-verdict {} {:ok true :value "42" :ms 3})) "ms)"))))

  (test "a passing exercise still reads as a pass with the extras appended"
    (let (note (tutor/tutor-verdict {:expect {:value "42"}}
                 {:ok true :value "42" :ms 800 :procs {:alive 1}}))
      (assert= (:kind note) :pass)
      (is (string/starts-with? (:text note) "✓ 42"))
      (is (includes? (:text note) "800ms"))
      (is (includes? (:text note) "⚙ 1 process")))))

;; ---- REGRESSION: a sandbox restart must actually re-evaluate ----------------------

(describe "sandbox restart"
  (test "ready clears BOTH eval stashes, so the whole lesson re-runs on a fresh session"
    ;; the child image is empty after a restart; leaving `:tutor-srcs` behind made
    ;; `tutor--first-changed` say "nothing changed", so no box was re-sent and the
    ;; next keystroke hit `unbound symbol` for a def that was never replayed
    (let (m (ed-tutor-launch (tut-model))
          b (tut-buf m))
      (is (> (count (or (:tutor-srcs b) {})) 0)) ; stamped by the launch
      (let (ready (tutor/tutor-sandbox-ready m 2)
            rb (tut-buf ready))
        (assert= (or (:tutor-srcs rb) {}) {}) ; …cleared on ready
        (assert= (:tutor-eval-rope rb) nil)
        ;; and the very next launch starts from box 0 again
        (let (regions (tut-regions ready)
              srcs (tutor/tutor-region-srcs (tut-text ready) regions))
          (assert= (tutor/tutor-first-changed srcs (or (:tutor-srcs rb) {}) (count regions)) 0)))))

  (test "ready also drops stale in-flight ids (their replies belong to the dead session)"
    (let (m (update (tut-model) :tutor merge {:pending {7 {:region 0}}})
          ready (tutor/tutor-sandbox-ready m 3))
      (assert= (get-in ready [:tutor :pending]) {})
      (assert= (get-in ready [:tutor :sandbox-gen]) 3))))

(describe "results that are on the buffer but not on the screen"
  ;; A reply stamps its note against the text of the moment it LANDS. Type a newline, get a
  ;; result, delete the newline again and the page is back at exactly what the launch parsed
  ;; — while its notes describe a line count that is gone, so `results/eol-notes` hands the
  ;; renderer nothing. The rope comparison alone called that "nothing to do", and every
  ;; verdict on the page stayed invisible until the next real edit.
  (test "a page whose notes were stranded re-arms the debounce, and the launch restores them"
    (let (m (ed-tutor-launch (tut-model))
          rope0 (buffer-rope (tut-buf m))
          pended (tut-pending m 0 7)
          r (second (tut-regions pended))
          ;; Enter in a LATER box: box 0's request is untouched, the page's lines are not
          typed (ed-edit pended (fn (b) (insert (goto-char b (:start r)) "\n")))
          landed (tutor/tutor-apply-reply typed {:id 7 :ok true :value "3" :output ""})
          ;; …and the newline taken back again
          back (ed-edit landed (fn (b) (assoc b :rope rope0))))
      (is (= (buffer-rope (tut-buf back)) (:tutor-eval-rope (tut-buf back)))) ; the old guard: "nothing to do"
      (is (nil? (results/eol-notes (tut-buf back)))) ; …yet the reader sees nothing
      (is (ed-tutor-stale? back)) ; so the debounce must re-arm
      (is (seq/find (tut-note-texts (ed-tutor-launch back)) (fn (t) (= t "=> 3")))))))

(describe "the running indicator's lifecycle"
  (test "a box above the edit keeps its in-flight id, so its ⋯ can still resolve"
    ;; carrying the note but dropping the pending entry stranded `⋯ evaluating…`
    ;; permanently: the reply arrived and was discarded as unknown
    (let (m (ed-tutor-launch (tut-model))
          box0 (let (r (first (tut-regions m)))
                 (string/substring (tut-text m) (:start r) (:end r)))
          ;; pretend box 0 is in flight, then edit box 1 (below it) and re-launch
          pending (update m :tutor merge {:pending {99 {:region 0 :src box0}}})
          r (second (tut-regions pending))
          edited (ed-edit pending
                   (fn (b)
                     (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                       "  (+ 40 2)")))
          m2 (ed-tutor-launch edited))
      (assert= (:region (get-in m2 [:tutor :pending 99])) 0))))

(describe "shipped examples are indented the way the editor indents"
  ;; A lesson that ships code TAB would reformat teaches the wrong shape and looks
  ;; broken next to the indenter. Every box line must already sit at the column
  ;; `tutor-indent` (brood-mode's indenter, floored at the box margin) would give it.
  (test "every box line of every lesson matches tutor-indent, under both profiles"
    (dolist (prof (list :emacs :vim))
      (dotimes (i (count tutor-lessons))
        (let (text (tutor-lesson-text i prof))
          (doseq (r (filter (tutor-regions text) (fn (r) (= (:kind r) :code))))
            (let (lines (string/split (string/substring text (:start r) (:end r)) "\n"))
              (dotimes (n (count lines))
                (when (> n 0)
                  (let (bol (+ (:start r)
                              (fold (range n)
                                0
                                (fn (acc j) (+ acc 1 (string/length (nth lines j))))))
                        line (nth lines n)
                        have (- (string/length line) (string/length (string/triml line))))
                    ;; a blank line inside a box has nothing to indent
                    (when (not (= (string/trim line) ""))
                      (assert= have (tutor/tutor-indent text bol)))))))))))))

;; ---- the checker's warnings, where the mistake IS --------------------------------
;; A runtime error can only surface where the code RAN: `(defn f (x) (* 2 x "d"))` stays
;; silent until something calls f. The advisory checker knows at the definition, so the
;; tutorial asks it and shows the answer on the defining line.

(describe "type warnings"
  (defn broken-fn-model ()
    (let (m (tut-page "Functions")
          r (first (tut-regions m)))
      (ed-tutor-launch (ed-edit m
                         (fn (b)
                           (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                             "  (defn dbl (x) (* 2 x \"d\"))"))))))

  (test "the warning lands on the DEFN's line, not on the call that crashes"
    (let (m (broken-fn-model)
          notes (tut-notes m)
          defn-line (:line (get notes 0)))
      (is (includes? (:warn (get notes 0)) "⚠"))
      (is (includes? (:warn (get notes 0)) "expects number"))
      ;; …and the runtime failure is still reported, on its own (later) line
      (let (fails (seq/keep notes
                    (fn (kv)
                      (when (and (= (:kind (second kv)) :fail) (> (:line (second kv)) defn-line))
                        (:text (second kv))))))
        (is (not (empty? fails))))))

  (test "a warning rides ALONGSIDE a result on the same line, as a field"
    ;; a field, not appended text — see the idempotence test below
    (let (note (get (tut-notes (broken-fn-model)) 0))
      (is (includes? (:text note) "=> dbl")) ; the result survives untouched
      (is (includes? (:warn note) "⚠")) ; the warning rides along
      ;; and the renderers show ⚠ for such a note
      (is (:italic (view/ed-eol-note-face :running false)))))

  (test "REGRESSION: re-checking never duplicates the warning"
    ;; appending the warning to the note's text was not idempotent — every debounce beat
    ;; added another identical ⚠ to the line (three, four, … on screen)
    (let (once (broken-fn-model)
          twice (ed-tutor-launch once)
          thrice (ed-tutor-launch twice)
          warn (:warn (get (tut-notes thrice) 0)))
      (is (not (nil? warn)))
      ;; exactly one ⚠ in it, however many times the checker ran
      (assert= 1 (count (filter (string/->list warn) (fn (c) (= c "⚠")))))
      ;; …and the composed line the view paints has exactly one too
      (let (b (tut-buf thrice)
            ops (view/ed-eol-note-ops b 0 400 0 0 200 4 1 0)
            painted (apply str (seq/keep ops (fn (op) (when (= (first op) :text) (nth op 3))))))
        (assert= 1 (count (filter (string/->list painted) (fn (c) (= c "⚠"))))))))

  (test "the gutter marks it ⚠ in the warning colour"
    (let (m (broken-fn-model)
          b (tut-buf m)
          line (:line (get (tut-notes m) 0)))
      (assert= ["⚠" modes/gutter-face-warn] (modes/gutter-mark-for b line))))

  (test "clean code gets no warnings at all"
    (let (m (ed-tutor-launch (tut-model)))
      (is (empty? (seq/keep (tut-notes m) (fn (kv) (when (= (:kind (second kv)) :warn) kv)))))))

  (test "warnings are recomputed, not accumulated (fixing the code clears them)"
    (let (m (broken-fn-model)
          r (first (tut-regions m))
          fixed (ed-tutor-launch (ed-edit m
                                   (fn (b)
                                     (insert (delete-region (assoc (goto-char b (:start r))
                                                              :mark (:end r)))
                                       "  (defn dbl (x) (* 2 x))")))))
      (is (empty? (seq/keep (tut-notes fixed) (fn (kv) (when (= (:kind (second kv)) :warn) kv))))))))

(describe "type warnings — session context"
  (test "REGRESSION: a box using an EARLIER box's definition is not 'unbound'"
    ;; the checker runs over the boxes joined in order — the same session the sandbox
    ;; builds — because checking each box alone reported `unbound symbol: double` on
    ;; box 2 of the Functions lesson, which is correct code
    (let (m (ed-tutor-launch (tut-page "Functions")))
      (is (empty? (seq/keep (tut-notes m) (fn (kv) (:warn (second kv))))))
      (is (empty? (seq/keep (tut-notes m) (fn (kv) (when (= (:kind (second kv)) :warn) kv)))))))

  (test "…but a typo in code that never RUNS is caught only by the checker"
    ;; this is the checker's unique value: the defn succeeds, so no runtime error can
    ;; exist yet, and without the advisory the mistake would stay invisible until called
    (let (m (tut-page "Functions")
          r (first (tut-regions m))
          typo (ed-tutor-launch (ed-edit m
                                  (fn (b)
                                    (insert (delete-region (assoc (goto-char b (:start r))
                                                             :mark (:end r)))
                                      "  (defn dbl (x) (doubel x))"))))
          note (get (tut-notes typo) 0))
      (is (includes? (:text note) "=> dbl")) ; the defn itself worked
      (is (includes? (:warn note) "unbound symbol: doubel")))))

(describe "an advisory only speaks when it adds something"
  (defn box1-as (m src)
    (let (r (first (tut-regions m)))
      (ed-tutor-launch (ed-edit m
                         (fn (b)
                           (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                             src))))))

  (test "REGRESSION: no ⚠ beside a runtime error that already says the same thing"
    ;; `✗ unbound symbol: asfd` next to `⚠ unbound symbol: asfd` was pure noise
    (let (m (box1-as (tut-model) "  (str \"my keys: \" \"emacs\" asfd)")
          note (get (tut-notes m) 0))
      (is (includes? (:text note) "✗"))
      (is (includes? (:text note) "unbound symbol: asfd"))
      (assert= (:warn note) nil) ; the advisory stays quiet
      ;; and the painted line carries the error once, with no ⚠ anywhere
      (let (painted (apply str
                      (seq/keep (view/ed-eol-note-ops (tut-buf m) 0 400 0 0 200 4 1 0)
                        (fn (op) (when (= (first op) :text) (nth op 3))))))
        (is (includes? painted "unbound symbol: asfd"))
        (is (not (includes? painted "⚠"))))))

  (test "…but it DOES speak on a line that succeeded (the latent bug)"
    (let (m (tut-page "Functions")
          broken (box1-as m "  (defn dbl (x) (* 2 x \"d\"))")
          note (get (tut-notes broken) 0))
      (is (includes? (:text note) "=> dbl")) ; the defn itself worked
      (is (includes? (:warn note) "⚠")))) ; …and the advisory explains why the call won't
  (test "…and on a line that merely gave the WRONG ANSWER (it may explain it)"
    ;; an unmet :expect is not a runtime error, so the advisory is still welcome there
    (let (m (box1-as (tut-model) "  (+ 40 undefined-thing)")
          note (get (tut-notes m) 0))
      ;; that one IS a runtime error, so no ⚠ — assert the classification instead
      (is (:error? note))))

  (test "a timeout is classified as an error too (no advisory piling on)"
    (let (note (tutor/tutor-verdict {} {:ok false :timeout true}))
      (is (:error? note))
      (is (includes? (:text note) "timed out")))
    ;; an expectation miss is NOT an error
    (let (note (tutor/tutor-verdict {:expect {:value "42"}} {:ok true :value "17"}))
      (assert= (:error? note) nil))))

(describe "the runtime outranks the checker"
  (test "a checker warning that merely re-words the runtime's is dropped"
    ;; same fault, different glyph — and the checker's longer wording still counts
    (let (note {:line 4 :text "✗ unbound symbol: asfd"}
          same {:line 4 :text "⚠ unbound symbol: asfd"}
          longer {:line 4 :text "⚠ unbound symbol: asfd (did you mean asdf?)"})
      (is (tutor/tutor-warning-echoes? note same))
      (is (tutor/tutor-warning-echoes? note longer))))

  (test "…but one that says something NEW survives, even on a line that has a note"
    (let (note {:line 4 :text "=> dbl"}
          w {:line 4 :text "⚠ *: argument 3 expects number, got \"d\""})
      (is (not (tutor/tutor-warning-echoes? note w)))
      (let (merged (tutor/tutor-merge-warning {[:res 4] note} w))
        (is (includes? (:warn (get merged [:res 4])) "expects number")))))

  (test "an echo is dropped even when the note is NOT classified as an error"
    ;; the rule is \"the runtime already said it\", not \"the runtime crashed\"
    (let (note {:line 4 :text "⋯ unbound symbol: zzz"} ; no :error? flag
          merged (tutor/tutor-merge-warning {[:res 4] note} {:line 4 :text "⚠ unbound symbol: zzz"}))
      (assert= (:warn (get merged [:res 4])) nil)
      (assert= 1 (count merged)))) ; and no standalone one either
  (test "a warning on a line with no note at all still stands alone"
    (let (merged (tutor/tutor-merge-warning {} {:line 9 :text "⚠ unused binding: x"}))
      (assert= 1 (count merged))
      (is (includes? (:text (get merged [:warn 9])) "unused binding"))))

  (test "an empty message never counts as an echo"
    (is (not (tutor/tutor-warning-echoes? {:text "✗"} {:text "⚠ real problem"})))
    (is (not (tutor/tutor-warning-echoes? {:text nil} {:text "⚠ real problem"})))))

(describe "a half-typed box says what the reader is waiting for"
  (defn box-src (m src)
    (let (r (first (tut-regions m)))
      (ed-tutor-launch (ed-edit m
                         (fn (b)
                           (insert (delete-region (assoc (goto-char b (:start r)) :mark (:end r)))
                             src))))))
  (defn note1 (m) (get (tut-notes m) 0))

  (test "REGRESSION: deleting a quote replaces the old result, never keeps it looking current"
    ;; `(str "my keys: " "emacs` used to keep a confident `=> "my keys: emacs"` beside
    ;; text that can no longer produce it
    (let (ok (box-src (tut-model) "  (str \"my keys: \" \"emacs\")")
          broken (box-src ok "  (str \"my keys: \" \"emacs"))
      (is (includes? (:text (note1 ok)) "=> \"my keys: emacs\""))
      (assert= (:kind (note1 broken)) :incomplete)
      (is (includes? (:text (note1 broken)) "unterminated string"))
      (is (not (includes? (:text (note1 broken)) "my keys: emacs"))))) ; the stale value is gone
  (test "the reader's reason is specific, per delimiter"
    (let (m (tut-model))
      (is (includes? (:text (note1 (box-src m "  (+ 1 2"))) "unclosed list"))
      (is (includes? (:text (note1 (box-src m "  [1 2"))) "unclosed vector"))))

  (test "an unbalanced close is a real error, not a pending state"
    ;; no amount of further typing makes `(+ 1 2))` valid, so it earns the ✗
    (let (note (note1 (box-src (tut-model) "  (+ 1 2))")))
      (assert= (:kind note) :fail)
      (is (includes? (:text note) "unexpected ')'"))))

  (test "it renders in the pending voice — dim and italic, never a verdict colour"
    (let (face (view/ed-eol-note-face :incomplete false))
      (assert= face (view/ed-eol-note-face :running false)) ; same as work in flight
      (is (:italic face))
      (assert= (:fg face) *overlay0*)))

  (test "…and its gutter glyph is ⋯ in the dim face, not ✓/✗"
    (let ([glyph face] (modes/mark-note-glyph {:kind :incomplete :text "⋯ unclosed list"} false))
      (assert= glyph "⋯")
      (assert= face modes/gutter-face-test-stale)))

  (test "a blank box still says nothing at all"
    ;; nothing typed yet is not a state worth narrating
    (assert= (liveeval/parse-state "   \n  ") :blank)))

(describe "prose boxes: navigation practises on text, not code"
  (defn text-of (m) (buffer-text (tut-buf m)))
  (defn kinds (m)
    (map (tutor-regions (text-of m)) :kind))

  (test "the whole Navigation section ships prose boxes only"
    ;; code arrives deliberately, at the bridge lesson — not while you are learning C-n
    (dolist (i (tutor/tutor-group-indices [:navigation nil]))
      (doseq (pg (or (:playgrounds (nth tutor-lessons i)) []))
        (assert= (:kind pg) :text))))

  (test "…and the bridge lesson is where code starts"
    (let (i (lesson-idx "Moving by structure")
          pgs (:playgrounds (nth tutor-lessons i)))
      (assert= (:section (nth tutor-lessons i)) :editing)
      (is (not (seq/find pgs (fn (pg) (= (:kind pg) :text)))))
      (is (seq/find pgs (fn (pg) (get-in pg [:expect :value]))))))

  (test "the kind is legible from the buffer text alone (the rule character)"
    ;; :fontify and the region parser get no lesson data, so it has to ride on the text
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around")))
      (assert= (kinds m) (list :text :text))
      (is (includes? (text-of m) "╭┄")))
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving by structure")))
      (assert= (kinds m) (list :code :code))
      (is (includes? (text-of m) "╭─"))))

  (test "a prose box is never evaluated and never type-checked"
    (let (m (ed-tutor-launch (tutor/tutor-show (ed-init (make-buffer ""))
                               (lesson-idx "Moving around")))
          notes (results/eol-notes-any (tut-buf m)))
      ;; the practice box has nothing to say; the exercise says ✗ until you fix the typo
      (assert= (:kind (get notes 0)) nil) ; no note at all on practice
      (assert= (:kind (get notes 1)) :fail)
      (is (not (includes? (:text (get notes 1)) "=>"))) ; no result
      (is (nil? (:warn (get notes 1)))))) ; no advisory over English
  (test "a prose exercise grades on the text, forgiving spacing but not words"
    (let (pg {:expect {:text "the quick brown fox"}})
      (assert= (:kind (tutor/tutor-text-verdict pg "  the   quick brown fox  ")) :pass)
      (assert= (:kind (tutor/tutor-text-verdict pg "the quick brown fxo")) :fail)
      ;; a removed line is a real difference, not whitespace
      (assert= (:kind (tutor/tutor-text-verdict {:expect {:text "a\nb"}} "a\n\nb")) :fail)))

  (test "a practice prose box (no :expect) says nothing at all"
    (assert= (tutor/tutor-text-verdict {} "anything at all here") nil))

  (test "TAB in a prose box indents flat to the margin, not to Lisp columns"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          text (text-of m)
          region (first (tutor-regions text))
          margin (string/length tutor/*tutor-box-margin*))
      ;; every line of the prose box wants exactly the margin
      (assert= (tutor/tutor-indent text (:start region)) margin)))

  (test "the fontifier leaves prose alone"
    ;; the Brood highlighter paints `:` and `\"` faces on ordinary words otherwise
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          text (text-of m)
          region (first (tutor-regions text))
          spans (filter (tutor/tutor-fontify text)
                  (fn (s) (let ([a b f] s) (and (>= a (:start region)) (< a (:end region)))))))
      (assert= spans '()))))

(describe "every exercise ships UNSOLVED — and its shipped answer solves it"
  :isolated
  ;; An exercise whose template already satisfies its own :expect greets the reader with a
  ;; ✓ they did not earn, and the lesson teaches nothing. Its `:answer` must do the
  ;; opposite: an answer that does not solve the exercise leaves the reader unable to tell
  ;; whether they misunderstood or the lesson is wrong.
  ;;
  ;; `:isolated`, and that is load-bearing rather than tidiness. These checks EVALUATE
  ;; lesson code in this image, and some of that cannot be undone: lesson "One name, many
  ;; shapes" asks the reader to `impl` an ability for their own record, and an ability impl
  ;; lives in an image-global registry with no way to unregister it. So once the ANSWER has
  ;; run, that lesson's template — `(area (Rect 6 7))`, deliberately shipped with no impl —
  ;; starts passing on the leaked impl. That is why this suite was green in file order and
  ;; failed on the SECOND iteration of `--repeat-until-failure` at every seed: the flake
  ;; was real, and it was in the tests, not the tutorial. The isolated phase runs each unit
  ;; against the clean post-load baseline and rolls back what it defines, which is exactly
  ;; the "fresh session" a reader gets — and what this property is about.
  ;;
  ;; Both halves check in session order, because a box may depend on the boxes above it.
  (test "no template passes on its own, and every answer does"
    ;; every template, first — before any answer has been evaluated in this image
    (dotimes (i (count tutor-lessons))
      (let (m (ed-tutor-launch (tutor/tutor-show (ed-init (make-buffer "")) i))
            notes (or (results/eol-notes (tut-buf m)) {})
            pgs (tutor/tutor-playgrounds m))
        (dotimes (r (count pgs))
          (let (pg (nth pgs r {})
                note (get notes r))
            ;; `:already-passes?` marks the deliberate read-and-see boxes — an
            ;; expectation that is already met because the POINT is to read why
            (when (and (:expect pg) (not (:already-passes? pg)))
              (is (not (= (:kind note) :pass))))))))
    ;; …then every shipped answer, in the same order
    (dotimes (i (count tutor-lessons))
      (let (m (tutor/tutor-show (ed-init (make-buffer "")) i)
            regions (tut-regions m)
            pgs (tutor/tutor-playgrounds m))
        (dotimes (r (count pgs))
          (let (pg (nth pgs r {}))
            (when (:answer pg)
              (let (region (nth regions r nil)
                    solved (ed-tutor-launch (ed-edit m
                                              (fn (b)
                                                (insert (delete-region (assoc (goto-char b
                                                                                (:start region))
                                                                         :mark (:end region)))
                                                  (tutor/tutor-margined (:answer pg))))))
                    note (get (or (results/eol-notes (tut-buf solved)) {}) r))
                ;; Name the lesson, the box and the note. The assertion below sits inside
                ;; a double `dotimes`, so on its own it reports only `:fail` vs `:pass` —
                ;; and finding WHICH of ~35 lessons' boxes broke then costs a bisect. This
                ;; is what turned "a note came back :fail" into "lesson 32 box 2 says
                ;; `first: … got keyword (:noproc)`", i.e. straight to brood ADR-309.
                (when (not (= (:kind note) :pass))
                  (io/puts (str "\n  lesson=" i " box=" r " note=" (pr-str note))))
                (assert= (:kind note) :pass)))))))))

(describe "TAB never completes inside a prose box"
  (defn tab-at (lesson needle offset)
    ;; TAB with point `offset` chars into `needle`, wherever that text sits
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx lesson))
          text (buffer-text (tut-buf m))
          at (+ (index-of text needle) offset)
          parked (ed-apply m (fn (b) (goto-char b at))))
      [parked (key-into parked :tab)]))

  (test "REGRESSION: TAB mid-word in prose opens no popup and types nothing"
    ;; `cmd-indent-or-complete` finishes the symbol at point, and in an English box
    ;; every word is a symbol to that code — so TAB used to complete "No" into some
    ;; other word from the buffer, silently editing the text an exercise is checked on
    (let ([before after] (tab-at "Moving around" "Nothing" 2))
      (assert= (:completion after) nil)
      (assert= (buffer-text (tut-buf after)) (buffer-text (tut-buf before)))))

  (test "…and a second TAB cannot accept a candidate either"
    (let ([_ after] (tab-at "Moving around" "Nothing" 2)
          twice (key-into after :tab))
      (assert= (:completion twice) nil)
      (is (includes? (buffer-text (tut-buf twice)) "Nothing in this box"))))

  (test "a CODE box still completes — the point is prose, not TAB"
    (let ([_ after] (tab-at "Moving by structure" "(list (list" 3))
      (is (not (nil? (:completion after))))))

  (test "TAB in prose still indents to the margin"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          text (buffer-text (tut-buf m))
          r (first (tut-regions m))
          ;; break the indentation of the box's second line, then TAB it back
          bol (+ (:start r) (index-of (string/substring text (:start r) (:end r)) "\n") 1)
          messed (ed-edit m (fn (b) (insert (goto-char b bol) "   ")))
          fixed (key-into (ed-apply messed (fn (b) (goto-char b (+ bol 4)))) :tab)
          line (buffer-line-at (tut-buf fixed) (buffer-current-line (tut-buf fixed))))
      (assert= (- (string/length line) (string/length (string/triml line)))
        (string/length tutor/*tutor-box-margin*)))))

(describe "prose exercises: the hint must describe the actual edit"
  (defn lines (a b)
    ;; the 0-based line numbers on which two texts differ
    (let (as (string/split a "\n") bs (string/split b "\n"))
      (seq/keep (range (math/max (count as) (count bs)))
        (fn (i) (when (not (= (nth as i "") (nth bs i ""))) i)))))
  (defn prose-exercises ()
    (mapcat tutor-lessons
      (fn (l)
        (seq/keep (or (:playgrounds l) [])
          (fn (pg0)
            (let (pg (first (tutor/tutor-rendered-playgrounds {:playgrounds [pg0]}
                              (tutor/tutor-keyset :emacs))))
              (when (and (= (:kind pg) :text) (get-in pg [:expect :text]))
                [(:title l) pg])))))))

  (test "REGRESSION: 'down a line' hints point at a line that actually differs"
    ;; the typo exercise said "C-n down a line" while the typo sat on line ONE, so
    ;; following the hint took you to the wrong line entirely
    (dolist (entry (prose-exercises))
      (let ([lesson pg] entry
            changed (lines (:code pg) (get-in pg [:expect :text])))
        (when (includes? (or (:hint pg) "") "down a line")
          ;; the hint moves you off line 0, so the edit had better not be there
          (is (not (includes? changed 0)))))))

  (test "every prose exercise really does need an edit, on a line that exists"
    (dolist (entry (prose-exercises))
      (let ([lesson pg] entry
            changed (lines (:code pg) (get-in pg [:expect :text])))
        (is (not (empty? changed)))
        (is (< (first changed) (count (string/split (get-in pg [:expect :text]) "\n")))))))

  (test "no hint still describes the code exercise it replaced"
    ;; `:kill-hint` outlived its box and went on saying "retype it with * 2" beside
    ;; a prose box with no code in it at all
    (dolist (entry (prose-exercises))
      (let ([lesson pg] entry
            hint (or (:hint pg) ""))
        (is (not (includes? hint "* 2")))
        (is (not (includes? hint "target")))))))

(describe "a prose note is anchored without parsing the prose"
  (test "a bracket typed into a prose box does not move its note"
    ;; the anchor used to run English through the s-expression reader; an unclosed
    ;; bracket changed what the 'last form' was, and the note jumped line
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          text (buffer-text (tut-buf m))
          rope (buffer-rope (tut-buf m))
          r (first (tut-regions m))
          before (tutor/tutor-note-anchor rope text r)
          ;; type an unbalanced "(" into the middle of the prose
          typed (ed-edit m (fn (b) (insert (goto-char b (+ (:start r) 5)) "(")))
          text2 (buffer-text (tut-buf typed))
          rope2 (buffer-rope (tut-buf typed))
          r2 (first (tutor-regions text2)))
      (assert= (tutor/tutor-note-anchor rope2 text2 r2) before)
      ;; and it is the box's last line, which is where a prose verdict belongs
      (assert= before (results/line-of rope (dec (:end r)))))))

(describe "C-x C-e inside a box (the :eval-scope service)"
  (defn scope-src (m)
    ;; what cmd-eval-last-sexp would hand the evaluator, for point where it is
    (let (b (tut-buf m)
          [text point] (commands/ed-eval-scope b))
      (eval-command/last-sexp-source text point)))

  (test "REGRESSION: a form in a code box evaluates instead of 'no complete form'"
    ;; `last-sexp-source` reads from position 0 of whatever text it gets, so the whole
    ;; buffer meant it hit the page's prose and gave up while point sat on a good form
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving by structure"))
          r (first (tut-regions m))
          at-end (ed-apply m (fn (b) (goto-char b (:end r)))))
      (is (not (nil? (scope-src at-end))))
      (is (includes? (scope-src at-end) "whole"))))

  (test "it reads only THIS box — a later box's form is not what you get"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving by structure"))
          regions (tut-regions m)
          in-first (ed-apply m (fn (b) (goto-char b (:end (first regions))))))
      (is (includes? (scope-src in-first) "whole")) ; box 1's form
      (is (not (includes? (scope-src in-first) "needle"))))) ; not box 2's
  (test "a prose box offers no scope — there is nothing in it to evaluate"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving around"))
          r (first (tut-regions m))
          inside (ed-apply m (fn (b) (goto-char b (:end r)))))
      (assert= (tutor/tutor-eval-scope (tut-buf inside)) nil)))

  (test "outside any box the scope is the whole buffer, as everywhere else"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Moving by structure"))
          at-top (ed-apply m (fn (b) (goto-char b 0)))
          [text point] (commands/ed-eval-scope (tut-buf at-top)))
      (assert= text (buffer-text (tut-buf at-top)))
      (assert= point 0)))

  (test "an ordinary buffer is unaffected — no service, no scoping"
    (let (b (goto-char (make-buffer "(+ 1 2)\n(* 6 7)" "x.blsp") 15)
          [text point] (commands/ed-eval-scope b))
      (assert= text "(+ 1 2)\n(* 6 7)")
      (assert= point 15)
      (is (includes? (eval-command/last-sexp-source text point) "*")))))

(describe "Info-style navigation: a thread you can always leave and rejoin"
  (test "C-c C-l retraces your actual path, where C-c C-p walks the sequence"
    ;; the difference Info draws between `l` (last visited) and `p` (previous node):
    ;; a jump made from the hub comes back to the hub, which sequential p never would
    ;; the real path: open the hub, put point on an entry, RET into it
    (let (m (tutor/tutor-show (tut-model) (lesson-idx "Values"))
          hub (tutor/cmd-tutorial-contents m nil)
          buf (tut-buf hub)
          line (seq/find (range (buffer-line-count buf))
                 (fn (i) (= (tutor/tutor-contents-section-at buf i) [:language :processes])))
          on-it (ed-apply hub (fn (b) (commands/ed-goto-line b (inc line))))
          jumped (tutor/cmd-tutorial-enter-section on-it nil)
          back (tutor/cmd-tutorial-last jumped nil))
      (assert= (tutor/tutor-group-of (get-in jumped [:tutor :lesson] 0)) [:language :processes])
      (is (tutor/tutor-contents? back)) ; l → the hub we came via
      (let (seq-back (tutor/cmd-tutorial-prev jumped nil))
        (is (not (tutor/tutor-contents? seq-back))) ; p → the lesson before it
        (assert= (get-in seq-back [:tutor :lesson])
          (dec (get-in jumped [:tutor :lesson] 0))))))

  (test "C-c C-l with no history falls back to the previous lesson"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Values"))
          back (tutor/cmd-tutorial-last m nil))
      (assert= (get-in back [:tutor :lesson]) (dec (lesson-idx "Values")))))

  (test "the contents page is the top — C-c C-u says so rather than doing something odd"
    (let (hub (tutor/cmd-tutorial-contents (tut-model) nil)
          up (tutor/cmd-tutorial-up hub nil))
      (is (tutor/tutor-contents? up))
      (is (includes? (:echo up) "top level"))))

  (test "n then p returns you to the same lesson, across a boundary"
    (let (last-nav (tutor/tutor-show (tut-model)
                     (last (tutor/tutor-group-indices [:navigation nil])))
          there (tutor/cmd-tutorial-next last-nav nil)
          back (tutor/cmd-tutorial-prev there nil))
      (assert= (get-in back [:tutor :lesson]) (get-in last-nav [:tutor :lesson]))))

  (test "the footer names the hierarchy keys it actually has"
    (let (text (tutor-lesson-text (lesson-idx "Values") :emacs))
      (is (includes? text "C-c C-u up"))
      (is (includes? text "C-c C-l back"))))

  (test "REGRESSION: every key the prose can name is a key that actually works"
    ;; `tutor--own-key-specs` is only the *vocabulary* — the render asks the keymap
    ;; where each command is bound. So a command listed there but never bound renders as
    ;; a blank hole in the prose AND cannot be typed: exactly what happened when
    ;; C-c C-w was added to the specs and not to `tutor-keymap`. One test for the class.
    (let (unbound (filter tutor/tutor-own-key-specs
                    (fn (kv)
                      (empty? (editor/keymap/keymap-where-is tutor/tutor-keymap (first (second kv)))))))
      (assert= (into [] (map unbound first)) [])))

  (test "the workings key names the command it runs"
    ;; the concrete case of the rule above — and what the lesson's `{{workings}}` hole
    ;; renders from
    (assert= (editor/keymap/keymap-where-is tutor/tutor-keymap 'tutor/cmd-tutorial-workings)
      '([:ctrl-c :ctrl-w])))

  (test "…and the lesson that teaches the pane prints that key, not a hole"
    ;; the end of the chain: prose names the COMMAND, the render asks the keymap, and the
    ;; reader sees a key they can press
    (let (text (tutor-lesson-text (lesson-idx "Watching it run") :emacs))
      (is (includes? text "C-c C-w"))
      (refute (includes? text "{{")))))

(describe "every box runs in the REAL sandbox, not just in-image"
  ;; The headless test path evaluates boxes in THIS process, where every editor module
  ;; is loaded. The real sandbox is a bare, projectless std image (`nest run` in /tmp),
  ;; so a box naming an editor module works perfectly here and fails for the reader.
  ;; That gap shipped a finale whose boxes read `(bound? 'commands/cmd-forward-char)`
  ;; => false and `unbound symbol: tutor-lessons/tutor-lessons`, while the suite was
  ;; green. Nothing but a name check can see it from in here.
  (test "no box reaches for a module the sandbox cannot load"
    (let (editor-modules ["commands/"
                           "model/" "tutor/" "tutor-lessons/" "interactive/" "modes/" "view/"
                           "input/" "keymaps/" "sandbox/" "results/"]
          keyset (tutor/tutor-keyset :emacs))
      (dotimes (i (count tutor-lessons))
        (doseq (pg (tutor/tutor-rendered-playgrounds (nth tutor-lessons i) keyset))
          (when (not (= (:kind pg) :text))
            (dolist (module editor-modules)
              (is (not (includes? (:code pg) module)))))))))

  (test "…and a box reaches a std editor module by its qualified name (auto-required, ADR-229)"
    ;; the session persists, but a reader can jump straight to any lesson. The `require`
    ;; FORM was removed (ADR-229): a qualified `editor/buffer/…` reference loads the module
    ;; on demand, so no box announces one explicitly — and none should use the dead form.
    (let (keyset (tutor/tutor-keyset :emacs))
      (dotimes (i (count tutor-lessons))
        (doseq (pg (tutor/tutor-rendered-playgrounds (nth tutor-lessons i) keyset))
          (when (not (= (:kind pg) :text))
            (is (not (includes? (:code pg) "(require ")))))))))

(describe "a form is explained where the reader first meets it"
  ;; An audit found `def` used and never explained at all, `if` likewise, and
  ;; `defn`/`fn`/`let` each first EXPLAINED in a lesson later than the one that first
  ;; used them. A reader meeting a form for the first time should have just been told
  ;; what it is.
  (defn first-box-use (needle)
    (let (keyset (tutor/tutor-keyset :emacs))
      (seq/find (range (count tutor-lessons))
        (fn (i)
          (seq/find (tutor/tutor-rendered-playgrounds (nth tutor-lessons i) keyset)
            (fn (pg) (and (not (= (:kind pg) :text)) (includes? (:code pg) needle))))))))
  (defn first-body-mention (needle)
    (seq/find (range (count tutor-lessons))
      (fn (i)
        (seq/find (or (:body (nth tutor-lessons i)) []) (fn (line) (includes? line needle))))))

  (test "REGRESSION: def, defn, fn, let and if are introduced no later than first use"
    (dolist (form (list "(def " "(defn " "(fn " "(let " "(if "))
      (let (used (first-box-use form)
            told (first-body-mention form))
        (is (not (nil? told))) ; explained SOMEWHERE
        (when (and used told) (is (<= told used)))))) ; …and not after the fact
  (test "def vs defn is spelled out, since that is the question readers ask"
    (let (bodies (mapcat tutor-lessons (fn (l) (or (:body l) [])))
          all (string/join bodies " "))
      (is (includes? all "(def double (fn (x)")) ; the long way…
      (is (includes? all "(defn double (x)"))))) ; …and the same thing said once
(describe "a warning that cannot be placed is not placed"
  (test "REGRESSION: a line-less diagnostic does not land on box 1"
    ;; `check-string-structured` returns some diagnostics with :line nil; defaulting
    ;; those to 1 painted them on the first box's first line, so a warning about `fac`
    ;; appeared on a `countdown` defined four lines earlier
    (let (text "  (a)\n  (b)"
          spans (tutor/tutor-box-spans (buffer-rope (make-buffer text))
                  text
                  (list {:start 0 :end 5 :open-line 0 :kind :code})))
      ;; the guard is upstream of merge: a line outside every span maps to nowhere,
      ;; and a nil :line never reaches the mapper at all
      (is (nil? (tutor/tutor-warning-line spans 999)))))

  (test "a placed warning still lands, so the guard did not silence everything"
    (let (m (ed-tutor-launch (tut-page "Functions"))
          r (first (tut-regions m))
          broken (ed-tutor-launch (ed-edit m
                                    (fn (b)
                                      (insert (delete-region (assoc (goto-char b (:start r))
                                                               :mark (:end r)))
                                        "  (defn dbl (x) (* 2 x \"d\"))"))))
          note (get (tut-notes broken) 0))
      (is (includes? (:warn note) "⚠")))))

(describe "the *Workings* pane belongs to one box"
  (test "REGRESSION: working in one box never leaves another box's cascade on screen"
    ;; the pane is a view of ONE box's execution; it went on showing box 1's call tree
    ;; while you worked in box 2, with nothing to say the trace was not yours
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          wtext (tut-workings (tut-goto-box m 1)))
      (is (not (nil? wtext))) ; the pane is open, showing box 2
      (is (includes? wtext "box 2"))
      (is (not (includes? wtext "sum-doubles"))))) ; …not box 1's cascade
  (test "the box you edited keeps its own cascade after the re-run"
    ;; re-evaluating a box replaces its workings rather than dropping them: the pane is
    ;; current for the box you are working in, which is the whole point of watching it
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          after (tut-goto-box m 0))
      (assert= (tut-workings after) (tutor-workings/body after 0))
      (is (includes? (tut-workings after) "sum-doubles"))))

  (test "closing the pane is respected — a motion does not force it back"
    ;; …but C-c C-w does. A closed pane that reopened itself on the next keystroke would
    ;; be unclosable
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          killed (let (k (cmd-kill-buffer (ed-select m (ed-buffer-index-by-name m "*Workings*"))
                           nil))
                   (ed-select k (ed-buffer-index-by-name k "*Tutorial*")))
          moved (tut-goto-box killed 1))
      ; a box with no cascade
      (assert= (tut-workings moved) nil)
      ;; and back on the box that HAS one, a motion still does not reopen it…
      (assert= (tut-workings (tut-goto-box killed 0)) nil)
      ;; …only the command does
      (is (not (nil? (tut-workings (tutor/cmd-tutorial-workings (tut-goto-box killed 0) nil)))))))

  (test "REGRESSION: a reply after closing the pane does not drag it back either"
    ;; the pane opens on a reply for the box you are in — but not once you have closed it,
    ;; or C-x 0 would be undone by the next thing you type
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          killed (let (k (cmd-kill-buffer (ed-select m (ed-buffer-index-by-name m "*Workings*"))
                           nil))
                   (ed-select k (ed-buffer-index-by-name k "*Tutorial*")))
          ;; a fresh reply for the box at point — exactly what opened it the first time
          replied (tut-with-cascade (tut-goto-box killed 0) 0 "sum-doubles"))
      (assert= (tut-workings replied) nil)
      ;; the cascade is still cached, so C-c C-w brings back the current thing
      (is (not (nil? (tutor-workings/cascade replied 0))))))

  (test "killing the tutorial takes its *Workings* pane with it"
    ;; the pane is a view of the tutorial's boxes and says nothing without them, so leaving
    ;; it behind left a corpse on screen. The tutor's `:on-close` hook NAMES it
    ;; (`layers/request-close`) and `cmd-kill-buffer` performs the close — a hook is handed
    ;; only its own buffer, and it is the editor that knows the buffer pool.
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          _ (is (not (nil? (ed-buffer-index-by-name m "*Workings*")))) ; both are open
          killed (cmd-kill-buffer (ed-select m (ed-buffer-index-by-name m "*Tutorial*")) nil))
      (assert= (ed-buffer-index-by-name killed "*Tutorial*") nil)
      (assert= (ed-buffer-index-by-name killed "*Workings*") nil)
      ;; …and the pool is still usable: something editable is selected
      (is (not (nil? (ed-current-buf killed))))
      ;; REGRESSION: the echo names what you killed. Each companion kill echoes its own
      ;; name as it goes, and the last one used to win — so killing *Tutorial* reported
      ;; "killed *Workings*", a buffer the reader never mentioned.
      (is (includes? (:echo killed) "killed *Tutorial*"))
      (is (includes? (:echo killed) "*Workings*")))) ; …and says what went with it
  (test "killing the *Workings* pane leaves the tutorial alone"
    ;; the relationship is one-way: the pane owns nothing
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          killed (cmd-kill-buffer (ed-select m (ed-buffer-index-by-name m "*Workings*")) nil))
      (assert= (ed-buffer-index-by-name killed "*Workings*") nil)
      (is (not (nil? (ed-buffer-index-by-name killed "*Tutorial*"))))))

  (test "REGRESSION: a new lesson never shows the previous lesson's cascade"
    ;; the cache is keyed by box index WITHIN the page, so box 1 of the lesson you left is
    ;; not box 1 of this one. It used to survive the page change, and a motion landed on it
    ;; before the new page's own replies did.
    (let (m (tut-with-cascade (tut-page "Watching it run")
              0 "sum-doubles")
          ;; rendering another page must drop the cache, BEFORE any launch refills it
          next-page (tutor/tutor-show m (lesson-idx "Moving by structure")))
      (assert= (get-in next-page [:tutor :workings]) {})
      (assert= (get-in next-page [:tutor :workings-region]) nil)
      ;; The pane itself is an ordinary buffer and survives the page change — that is
      ;; fine, and better than flickering shut. What must not survive is its CONTENT: a
      ;; motion on the new page shows the new box's state, not the old box's call tree.
      (let (wtext (tut-workings (tut-goto-box next-page 0)))
        (is (includes? wtext "has not run yet"))
        (is (not (includes? wtext "sum-doubles")))))))

(describe "progress survives the session"
  :isolated
  ;; `:isolated` because one test here REGISTERS `:editor` (to prove the persistence gate no
  ;; longer cares about it). That name is process-global and ten editor modules read it as
  ;; "there is a live editor" — including the tutorial's own eval-path choice — so while it is
  ;; registered, a tutor test running in PARALLEL would take the live/async path and find no
  ;; verdicts. The registry releases the name when the registrant dies, so the window is
  ;; exactly the overlap; the isolated phase removes the overlap. Four other suites that
  ;; register `:editor` already follow this rule.
  (test "the file lives beside init.blsp and is data, not code"
    (is (includes? (tutor/tutor-progress-file) "bedit"))
    (is (string/ends-with? (tutor/tutor-progress-file) "tutor-progress.blsp")))

  (test "a round trip through the file restores the solved set"
    ;; write and read through a temp path so the suite never touches a real home
    (let (path (path/temp "tutor-progress-test-")
          solved [[3 1] [7 0]]
          _ (file/spit path (pr-str {:passed solved}))
          text (file/slurp path)
          back (into #{} (:passed (first (reflect/read-all text)))))
      (assert= back (into #{} solved))
      (file/rm path)))

  ;; These drive the REAL read/write against a temp path. The previous version asserted
  ;; `(not (file/exists? (tutor--progress-file)))` — a claim about the developer's own home
  ;; directory, which is false the moment they use the tutorial, and which sent a whole
  ;; debugging session chasing a "mystery write" that was just their own saved progress.
  (test "REGRESSION: a test model neither reads nor writes progress"
    (let (path (path/temp "tutor-progress-guard-")
          m (ed-init (make-buffer ""))
          saved (tutor/tutor-save-progress (assoc-in m [:tutor :passed] #{[1 1]}) path))
      (refute (tutor/tutor-persist? m))
      (assert= (get-in saved [:tutor :passed]) #{[1 1]}) ; returns the model untouched
      (is (not (file/exists? path))) ; …and wrote nothing
      (assert= (tutor/tutor-load-progress m path) #{}))) ; …and reads nothing
  (test "REGRESSION: a REGISTERED :editor does not make a test model persist"
    ;; the gate used to be `(whereis :editor)` — process-global, and a full `nest test`
    ;; run is ONE image: the first suite to register `:editor` for its own reasons left it
    ;; registered, and from then on every tutor test that solved an answer rewrote the
    ;; developer's real progress file with the suite's solves. The gate is a MODEL flag
    ;; now (`:recent-files`, as recentf/bookmarks use), which a test model cannot have.
    (let (path (path/temp "tutor-progress-registered-")
          _ (proc/register :editor (self))
          m (ed-init (make-buffer "")))
      (refute (tutor/tutor-persist? m))
      (tutor/tutor-save-progress (assoc-in m [:tutor :passed] #{[1 1]}) path)
      (is (not (file/exists? path)))))

  (test "an existing map-format file still reads — no migration on the shared layer"
    ;; the format did not change when the write moved onto `projects/persist-write!`, so a
    ;; reader's existing progress keeps working. Worth pinning: losing it silently would be
    ;; indistinguishable from "you never solved anything".
    (let (path (path/temp "tutor-progress-legacy-")
          _ (file/spit path
              (str ";; bedit — tutorial progress. Data, not code: safe to delete.\n"
                "{:passed [[6 1] [2 1]]}\n"))
          m (assoc (ed-init (make-buffer "")) :recent-files true))
      (assert= (tutor/tutor-load-progress m path) #{[6 1] [2 1]})
      (file/rm path)))

  (test "the write is ATOMIC, and keeps the header a person reads"
    ;; a plain `spit` can leave a truncated file if the editor dies mid-write; the next read
    ;; would take that as "nothing solved" and then overwrite it
    (let (path (path/temp "tutor-progress-atomic-")
          m (assoc (ed-init (make-buffer "")) :recent-files true)
          _ (tutor/tutor-save-progress (assoc-in m [:tutor :passed] #{[1 1]}) path)
          text (file/slurp path))
      (is (includes? text ";; bedit")) ; says what it is, and that it is safe to delete
      (is (not (file/exists? (str path ".tmp")))) ; the temp file was renamed away
      (assert= (tutor/tutor-load-progress m path) #{[1 1]})
      (file/rm path)))

  (test "a TRUNCATED progress file reads as nothing solved instead of throwing"
    ;; progress is a nicety: a half-written file must never stop the tutorial opening
    (let (path (path/temp "tutor-progress-corrupt-")
          _ (file/spit path "{:passed [[1 ")
          m (assoc (ed-init (make-buffer "")) :recent-files true))
      (assert= (tutor/tutor-load-progress m path) #{})
      (file/rm path)))

  (test "the live editor's model DOES persist, and round-trips"
    ;; the other half: the gate must not be so tight that nothing ever saves — this is the
    ;; between-sessions promise, in one assertion
    (let (path (path/temp "tutor-progress-live-")
          m (assoc (ed-init (make-buffer "")) :recent-files true) ; the flag `main` sets
          _ (tutor/tutor-save-progress (assoc-in m [:tutor :passed] #{[3 1] [0 1]}) path))
      (is (tutor/tutor-persist? m))
      (is (file/exists? path))
      (assert= (tutor/tutor-load-progress m path) #{[3 1] [0 1]})
      ;; a FRESH model (a new session) reads the same set back
      (assert= (tutor/tutor-load-progress (assoc (ed-init (make-buffer "")) :recent-files true)
                 path)
        #{[3 1] [0 1]})
      (file/rm path)))

  (test "opening the tutorial keeps progress already made this session"
    ;; reopening mid-session must not forget the exercise you solved five minutes ago
    (let (m (assoc-in (ed-init (make-buffer "")) [:tutor :passed] #{[2 0]})
          opened (tutor/cmd-tutorial m nil))
      (is (includes? (get-in opened [:tutor :passed]) [2 0])))))

(describe "C-c C-a writes a worked answer"
  ;; the COMMAND's behaviour. That every shipped `:answer` actually satisfies its
  ;; expectation is checked with the templates, in one order-independent test — see
  ;; "every exercise ships UNSOLVED — and its shipped answer solves it".
  (test "the command replaces the box, so the answer evaluates like your own attempt"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Your own shapes"))
          r (second (tut-regions m))
          at (ed-apply m (fn (b) (goto-char b (+ (:start r) 2))))
          shown (tutor/cmd-tutorial-show-answer at nil)
          box (let (t (buffer-text (tut-buf shown))
                    r2 (second (tutor-regions t)))
                (string/substring t (:start r2) (:end r2))))
      (is (includes? box "update"))
      (is (includes? (:echo shown) "idiomatic"))))

  (test "a box with no worked answer says so instead of doing nothing"
    (let (m (tutor/tutor-show (ed-init (make-buffer "")) (lesson-idx "Values"))
          r (first (tut-regions m))
          at (ed-apply m (fn (b) (goto-char b (+ (:start r) 2))))
          shown (tutor/cmd-tutorial-show-answer at nil))
      (is (includes? (:echo shown) "no worked answer")))))

(describe "a lesson never reaches for what the course has not taught"
  ;; An audit of every call head in every code box, in course order, against what any
  ;; earlier lesson had shown or named. It found three: the Numbers lesson (three pages
  ;; in) built a bignum with `fold` and `range`, both of which belong to a later
  ;; subsection; the modules box called `require` while the body only described
  ;; `defmodule`/`:use`; and the editing section's bridge used `count`.
  (defn call-heads (code)
    (seq/keep (string/split (string/replace (string/replace code "\n" " ") ")" " ") " ")
      (fn (w)
        (let (t (string/trim w))
          (when (and (string/starts-with? t "(") (> (string/length t) 1))
            (first (string/split (string/substring t 1 (string/length t)) " ")))))))

  (test "REGRESSION: fold, range and count are not used before their lesson"
    (let (keyset (tutor/tutor-keyset :emacs)
          ;; where each is taught
          taught {"fold" (lesson-idx "map, filter, fold")
                  "range" (lesson-idx "map, filter, fold")
                  "count" (lesson-idx "Lists and vectors")})
      (dotimes (i (count tutor-lessons))
        (doseq (pg (tutor/tutor-rendered-playgrounds (nth tutor-lessons i) keyset))
          (when (not (= (:kind pg) :text))
            (dolist (head (call-heads (:code pg)))
              (let (first-taught (get taught head))
                (when first-taught (is (>= i first-taught))))))))))

  (test "the modules lesson explains loading a module by its qualified name (ADR-229 — no `require` form)"
    (let (body (string/join (:body (nth tutor-lessons (lesson-idx "Modules and privacy"))) " "))
      (is (includes? body "qualified"))
      (is (not (includes? body "(require"))))))
