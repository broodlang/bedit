;; git porcelain (src/git.blsp): the pure `git status --porcelain` parse + the
;; status-buffer render (text + the per-line :rows the row commands read), plus
;; hunk parsing and patch construction. Git subprocess actions are exercised by
;; hand against a real repo, not here.

(defmodule git-test (:use test) (:use git))

(describe "git: porcelain parse (-z, NUL-separated)"
  (test "staged / unstaged / untracked classification"
    (let (es (git/git--entries "M  staged.rb\u{0} M unstaged.rb\u{0}?? new.rb\u{0}MM both.rb"))
      (assert= (count es) 4)
      (is (git/git--staged? (first es)))            ; "M " → staged
      (is (not (git/git--unstaged? (first es))))
      (is (git/git--unstaged? (nth es 1)))          ; " M" → unstaged
      (is (git/git--untracked? (nth es 2)))         ; "??" → untracked
      (is (git/git--staged? (nth es 3)))            ; "MM" → both
      (is (git/git--unstaged? (nth es 3)))))
  (test "a rename keeps the new path and consumes the source token, then resyncs"
    (let (es (git/git--entries "R  new name.rb\u{0}old name.rb\u{0} M after.rb"))
      (assert= (count es) 2)                          ; the source path is not its own entry
      (assert= (get (first es) :path) "new name.rb")
      (assert= (get (nth es 1) :path) "after.rb")))   ; parsing realigns after the rename source
  (test "a path with spaces is kept whole (no -z quoting)"
    (assert= (get (first (git/git--entries " M a file with spaces.rb")) :path)
      "a file with spaces.rb"))
  (test "a too-short token is skipped"
    (assert= (git/git--entries "\u{0}  \u{0}M  a") (list {:x "M" :y " " :path "a"}))))

(describe "git: status render"
  (test "sections appear with their files; rows align to file lines"
    (let (r (git/git--render "main"
              (git/git--entries "M  s.rb\u{0} M u.rb\u{0}?? n.rb"))
          rows (get r :rows)
          lines (string-split (get r :text) "\n"))
      ;; header line 0, blank line 1
      (assert= (first lines) "Head: main")
      (is (nil? (nth rows 0)))
      ;; each section header shows the file count; its row is {:section-header section}
      (is (includes? (get r :text) "Staged changes (1):"))
      (is (includes? (get r :text) "Unstaged changes (1):"))
      (is (includes? (get r :text) "Untracked files (1):"))
      ;; section header rows are non-nil with :section-header set
      (is (not (nil? (find (fn (r) (= (get r :section-header) :staged)) rows))))
      ;; file lines use readable labels, not raw XY codes
      (is (includes? (get r :text) "modified"))
      (is (includes? (get r :text) "untracked"))
      ;; exactly three file rows (one per file), each carrying its path
      (let (file-rows (filter git/git--file-row? rows))
        (assert= (count file-rows) 3)
        (assert= (sort (map (fn (x) (get x :path)) file-rows)) (list "n.rb" "s.rb" "u.rb")))
      ;; the staged row is flagged staged?, the untracked row untracked?
      (let (byp (fold (fn (a x) (if (git/git--file-row? x) (assoc a (get x :path) x) a)) {} rows))
        (is (get (get byp "s.rb") :staged?))
        (is (not (get (get byp "u.rb") :staged?)))
        (is (get (get byp "n.rb") :untracked?)))))
  (test "unstaged renders above staged; untracked renders above unstaged"
    (let (text (get (git/git--render "main" (git/git--entries "M  s.rb\u{0} M u.rb\u{0}?? n.rb")) :text))
      (is (< (string-index-of text "Untracked files")
            (string-index-of text "Unstaged changes")))
      (is (< (string-index-of text "Unstaged changes")
            (string-index-of text "Staged changes")))))
  (test "row-section / section-lines classify rows by section and keep buffer-line indices"
    (let (rows (get (git/git--render "main" (git/git--entries "M  s.rb\u{0} M u.rb\u{0}?? n.rb")) :rows)
          byp (fold (fn (a x) (if (git/git--file-row? x) (assoc a (get x :path) x) a)) {} rows))
      ;; section-header rows return nil from git--row-section
      (is (nil? (git/git--row-section {:section-header :staged})))
      ;; one file row per section, classified by row-section
      (assert= (git/git--row-section (get byp "u.rb")) :unstaged)
      (assert= (git/git--row-section (get byp "s.rb")) :staged)
      (assert= (git/git--row-section (get byp "n.rb")) :untracked)
      (is (nil? (git/git--row-section nil)))
      ;; section-lines returns the (single) buffer line index of each section's file
      (assert= (count (git/git--section-lines rows :unstaged)) 1)
      (assert= (count (git/git--section-lines rows :staged)) 1)
      (assert= (count (git/git--section-lines rows :untracked)) 1)
      ;; order: untracked → unstaged → staged
      (is (< (first (git/git--section-lines rows :untracked))
            (first (git/git--section-lines rows :unstaged))))
      (is (< (first (git/git--section-lines rows :unstaged))
            (first (git/git--section-lines rows :staged))))
      ;; the indices really point back at the right rows
      (is (= (get (nth rows (first (git/git--section-lines rows :staged))) :path) "s.rb"))))
  (test "a clean tree renders the clean message and no rows"
    (let (r (git/git--render "main" '()))
      (is (includes? (get r :text) "working tree clean"))
      (is (empty? (filter git/git--file-row? (get r :rows))))))
  (test "an expanded file shows its diff inline with an actionable hunk row"
    (let (parsed {:headers [] :hunks [{:header "@@ -1 +1 @@" :lines ["-old" "+new"]}]}
          es (git/git--entries " M f.txt")
          r (git/git--render "main" es (list "f.txt") {"f.txt" {:unstaged parsed}})
          rows (get r :rows))
      (is (includes? (get r :text) "    @@ -1 +1 @@"))  ; indented hunk header
      (is (includes? (get r :text) "    +new"))          ; indented body line
      ;; section-header + file row + @@ hunk row are non-nil; -old/+new body lines are nil
      (let (non-nil (remove nil? rows))
        (assert= (count non-nil) 3)
        (is (get (first non-nil) :section-header))  ; first non-nil is the section header
        (is (git/git--file-row? (second non-nil)))  ; second is the file row
        (is (get (last non-nil) :hunk?)))           ; last is the hunk row
      ;; the hunk row carries :hunk? true and a :hunk-patch
      (let (hunk-row (last (remove nil? rows)))
        (is (get hunk-row :hunk?))
        (is (not (nil? (get hunk-row :hunk-patch)))))))
  (test "a both-staged-and-unstaged file shows each section's own diff under its row"
    (let (staged-parsed   {:headers [] :hunks [{:header "@@ -1 +1 @@" :lines ["+staged-side"]}]}
          unstaged-parsed {:headers [] :hunks [{:header "@@ -1 +1 @@" :lines ["+unstaged-side"]}]}
          text (get (git/git--render "main" (git/git--entries "MM f.txt") (list "f.txt")
                      {"f.txt" {:staged staged-parsed :unstaged unstaged-parsed}}) :text))
      (is (includes? text "    +unstaged-side"))   ; under the unstaged row → working-tree diff
      (is (includes? text "    +staged-side"))))   ; under the staged row → --cached diff
  (test "without expansion the diff is not shown"
    (let (r (git/git--render "main" (git/git--entries " M f.txt")))
      (is (not (includes? (get r :text) "@@"))))))

(describe "git: hunk parsing and patch construction"
  (test "parse-hunks: splits diff into file headers and individual hunks"
    (let (diff "diff --git a/f.rb b/f.rb\nindex abc..def 100644\n--- a/f.rb\n+++ b/f.rb\n@@ -1,3 +1,4 @@\n context\n+addition\n context\n@@ -10,3 +11,4 @@\n more\n+another\n"
          parsed (git/git--parse-hunks diff))
      (assert= (count (get parsed :headers)) 4)   ; diff --git, index, ---, +++
      (assert= (count (get parsed :hunks)) 2)
      (assert= (get (first (get parsed :hunks)) :header) "@@ -1,3 +1,4 @@")
      (assert= (get (second (get parsed :hunks)) :header) "@@ -10,3 +11,4 @@")
      (assert= (count (get (first (get parsed :hunks)) :lines)) 3)))  ; " context" "+addition" " context"

  (test "parse-hunks: empty or nil input gives zero hunks"
    (assert= (get (git/git--parse-hunks "") :hunks) [])
    (assert= (get (git/git--parse-hunks nil) :hunks) []))

  (test "parse-hunks: a diff with no file headers (e.g. --no-index) is still valid"
    (let (diff "@@ -0,0 +1 @@\n+new file\n"
          parsed (git/git--parse-hunks diff))
      (assert= (count (get parsed :headers)) 0)
      (assert= (count (get parsed :hunks)) 1)
      (assert= (get (first (get parsed :hunks)) :header) "@@ -0,0 +1 @@")))

  (test "hunk-patch: produces a patch containing the file headers and just the one hunk"
    (let (parsed {:headers ["diff --git a/f b/f" "--- a/f" "+++ b/f"]
                  :hunks [{:header "@@ -1,1 +1,2 @@" :lines [" ctx" "+new"]}
                          {:header "@@ -5,1 +6,2 @@" :lines [" ctx2" "+new2"]}]}
          patch (git/git--hunk-patch parsed (first (get parsed :hunks))))
      (is (includes? patch "diff --git a/f b/f"))
      (is (includes? patch "@@ -1,1 +1,2 @@"))
      (is (includes? patch "+new"))
      (is (not (includes? patch "@@ -5,1 +6,2 @@")))   ; second hunk excluded
      (is (not (includes? patch "+new2")))
      (is (ends-with? patch "\n")))))               ; git apply rejects a patch with no trailing newline

(describe "git: syntax highlighting (fontify)"
  (test "diff fontify colours @@ / - / + lines and leaves context uncoloured"
    (let (spans (git/git-diff-fontify "@@ -1 +1 @@\n-old\n+new\n ctx"))
      (assert= (count spans) 3)                                  ; context line gets no span
      (assert= (map (fn (s) (nth s 2)) spans)
        (list git/git-face-hunk git/git-face-del git/git-face-add))
      (assert= (first spans) [0 11 git/git-face-hunk])))     ; whole-line span at the right offset
  (test "+++/--- file headers are file-coloured, not add/del"
    (assert= (map (fn (s) (nth s 2)) (git/git-diff-fontify "+++ b/f\n--- a/f"))
      (list git/git-face-file git/git-face-file)))
  (test "status fontify highlights section headers + inline diff, not file rows"
    ;; section header ends with ":" (the count format "Staged changes (1):") so it's detected
    ;; file rows ("  modified   f") have 2-space indent — not 4 spaces — so they aren't coloured
    (assert= (map (fn (s) (nth s 2))
                (git/git-status-fontify "Head: main\n\nStaged changes (1):\n  modified   f\n    +x"))
      (list git/git-face-section git/git-face-section git/git-face-add)))
  (test "log fontify colours just the leading commit hash"
    (let (spans (git/git-log-fontify "abc1234 a message\ndef5678 another"))
      (assert= (count spans) 2)
      (assert= (first spans) [0 7 git/git-face-hash]))))

(describe "git: status-bar segments (branch + working-tree indicator)"
  (def CLEAN {:root "/home/u/myedit" :branch "main" :upstream "origin/main"
              :ahead "0" :behind "0" :staged 0 :unstaged 0 :untracked 0})
  (def DIRTY (assoc CLEAN :staged 2 :unstaged 1 :untracked 3))

  (test "no summary → no segments"
    (assert= (git/git-statusbar-segments nil) '()))

  (test "a clean tree is just the branch + a green state dot (no count segments)"
    (let (segs (git/git-statusbar-segments CLEAN)
          ids (map (fn (s) (get s :id)) segs))
      (assert= ids (list :git-branch :git-dot))
      (is (string-contains? (get (first segs) :text) "main"))
      (assert= (get (nth segs 1) :face) git/git-face-clean)))

  (test "counts appear only when non-zero, colour-coded, in +~? order"
    (let (segs (git/git-statusbar-segments DIRTY)
          by (fn (id) (find (fn (s) (= (get s :id) id)) segs)))
      (assert= (map (fn (s) (get s :id)) segs)
        (list :git-branch :git-dot :git-staged :git-unstaged :git-untracked))
      (assert= (get (by :git-staged) :text) "+2")
      (assert= (get (by :git-staged) :face) git/git-face-staged)
      (assert= (get (by :git-unstaged) :text) "~1")
      (assert= (get (by :git-untracked) :text) "?3")))

  (test "the state dot is yellow when there are unstaged changes, green when only staged"
    (assert= (get (nth (git/git-statusbar-segments (assoc CLEAN :unstaged 1)) 1) :face) git/git-face-unstaged)
    (assert= (get (nth (git/git-statusbar-segments (assoc CLEAN :staged 1)) 1) :face) git/git-face-clean))

  (test "branch + dot segments are clickable to *git-status* and carry a hover tooltip"
    (let (segs (git/git-statusbar-segments DIRTY)
          branch (first segs) dot (nth segs 1))
      (assert= (get branch :on-click) 'git/cmd-git-status)
      (assert= (get dot :on-click) 'git/cmd-git-status)
      (is (string-contains? (str (statusbar/seg-tooltip-lines branch {})) "Branch: main"))
      (is (string-contains? (str (statusbar/seg-tooltip-lines dot {})) "Unstaged:  1"))))

  (test "a clean working tree tooltip reads 'clean'"
    (is (string-contains? (str (git/git--tree-tooltip CLEAN)) "clean"))))
