;; git porcelain (src/git.blsp): the pure `git status --porcelain` parse + the
;; status-buffer render (text + the per-line :rows the row commands read). The git
;; subprocess actions are exercised by hand against a real repo, not here.

(defmodule git-test (:use test) (:use git))

(describe "git: porcelain parse"
  (test "staged / unstaged / untracked classification"
    (let (es (git/git--entries "M  staged.rb\n M unstaged.rb\n?? new.rb\nMM both.rb"))
      (assert= (count es) 4)
      (is (git/git--staged? (first es)))            ; "M " → staged
      (is (not (git/git--unstaged? (first es))))
      (is (git/git--unstaged? (nth es 1)))          ; " M" → unstaged
      (is (git/git--untracked? (nth es 2)))         ; "??" → untracked
      (is (git/git--staged? (nth es 3)))            ; "MM" → both
      (is (git/git--unstaged? (nth es 3)))))
  (test "a rename keeps the new path"
    (assert= (get (git/git--parse-entry "R  old.rb -> new.rb") :path) "new.rb"))
  (test "a too-short / blank line is skipped"
    (assert= (git/git--entries "\n  \nM  a") (list {:x "M" :y " " :path "a"}))))

(describe "git: status render"
  (test "sections appear with their files; rows align to file lines"
    (let (r (git/git--render "main"
              (git/git--entries "M  s.rb\n M u.rb\n?? n.rb"))
          rows (get r :rows)
          lines (string-split (get r :text) "\n"))
      ;; header line 0, blank line 1
      (assert= (first lines) "Head: main")
      (is (nil? (nth rows 0)))
      ;; each section header has a nil row; each file line has a row with its path
      (is (includes? (get r :text) "Staged changes:"))
      (is (includes? (get r :text) "Unstaged changes:"))
      (is (includes? (get r :text) "Untracked files:"))
      ;; exactly three actionable rows (one per file), each carrying its path
      (let (file-rows (filter (fn (x) (not (nil? x))) rows))
        (assert= (count file-rows) 3)
        (assert= (sort (map (fn (x) (get x :path)) file-rows)) (list "n.rb" "s.rb" "u.rb")))
      ;; the staged row is flagged staged?, the untracked row untracked?
      (let (byp (fold (fn (a x) (if (nil? x) a (assoc a (get x :path) x))) {} rows))
        (is (get (get byp "s.rb") :staged?))
        (is (not (get (get byp "u.rb") :staged?)))
        (is (get (get byp "n.rb") :untracked?)))))
  (test "a clean tree renders the clean message and no rows"
    (let (r (git/git--render "main" '()))
      (is (includes? (get r :text) "working tree clean"))
      (is (empty? (filter (fn (x) (not (nil? x))) (get r :rows))))))
  (test "an expanded file shows its diff inline, indented, as non-actionable rows"
    (let (es (git/git--entries " M f.txt")
          r (git/git--render "main" es (list "f.txt") {"f.txt" "@@ -1 +1 @@\n-old\n+new"})
          rows (get r :rows))
      (is (includes? (get r :text) "    @@ -1 +1 @@"))     ; indented hunk header
      (is (includes? (get r :text) "    +new"))            ; indented added line
      (assert= (count (filter (fn (x) (not (nil? x))) rows)) 1)))  ; only the file row is actionable
  (test "without expansion the diff is not shown"
    (let (r (git/git--render "main" (git/git--entries " M f.txt")))
      (is (not (includes? (get r :text) "@@"))))))

(describe "git: syntax highlighting (fontify)"
  (test "diff fontify colours @@ / - / + lines and leaves context uncoloured"
    (let (spans (git/git-diff-fontify "@@ -1 +1 @@\n-old\n+new\n ctx"))
      (assert= (count spans) 3)                                  ; context line gets no span
      (assert= (map (fn (s) (nth s 2)) spans)
        (list git/git-face-hunk git/git-face-del git/git-face-add))
      (assert= (first spans) [0 11 git/git-face-hunk])))     ; whole-line span at the right offset
  (test "+++/--- file headers are file-coloured, not add/del"
    (assert= (map (fn (s) (nth s 2)) (git/git-diff-fontify "+++ b/f\n--- a/f"))
      (list git/git-face-file git/git-face-file)))
  (test "status fontify highlights section headers + inline diff, not file rows"
    (assert= (map (fn (s) (nth s 2)) (git/git-status-fontify "Head: main\n\nStaged changes:\n  M  f\n    +x"))
      (list git/git-face-section git/git-face-section git/git-face-add)))
  (test "log fontify colours just the leading commit hash"
    (let (spans (git/git-log-fontify "abc1234 a message\ndef5678 another"))
      (assert= (count spans) 2)
      (assert= (first spans) [0 7 git/git-face-hash]))))
