;; git porcelain (src/git*.blsp): the pure `git status --porcelain` parse + the
;; status-buffer render (text + the per-line :rows the row commands read), plus
;; hunk parsing and patch construction. Git subprocess actions are exercised by
;; hand against a real repo, not here.

(defmodule git-test
  (:use test)
  (:use section)
  (:use-internals git)
  (:use-internals gitcommit)
  (:use-internals gitrefs)
  (:use-internals gitsequence)
  (:use-internals gitremote)
  (:use-internals gitstatus)
  (:use-internals gitstage)
  (:use-internals gitfetch)
  (:use-internals gitpick)
  (:use-internals gitsection)
  (:use-internals gitbar)
  (:use-internals gitcore)
  (:use-internals gitview)
  (:use-internals smerge)
  (:use-internals sectionbuf))

(describe "git: porcelain parse (-z, NUL-separated)"
  (test "staged / unstaged / untracked classification"
    (let (es (gitcore/git-entries "M  staged.rb\u{0} M unstaged.rb\u{0}?? new.rb\u{0}MM both.rb"))
      (assert= (count es) 4)
      (is (gitcore/git-staged? (first es))) ; "M " → staged
      (is (not (gitcore/git-unstaged? (first es))))
      (is (gitcore/git-unstaged? (nth es 1))) ; " M" → unstaged
      (is (gitcore/git-untracked? (nth es 2))) ; "??" → untracked
      (is (gitcore/git-staged? (nth es 3))) ; "MM" → both
      (is (gitcore/git-unstaged? (nth es 3)))))
  (test "a rename keeps the new path and consumes the source token, then resyncs"
    (let (es (gitcore/git-entries "R  new name.rb\u{0}old name.rb\u{0} M after.rb"))
      (assert= (count es) 2) ; the source path is not its own entry
      (assert= (:path (first es)) "new name.rb")
      (assert= (:path (nth es 1)) "after.rb"))) ; parsing realigns after the rename source
  (test "a path with spaces is kept whole (no -z quoting)"
    (assert= (get (first (gitcore/git-entries " M a file with spaces.rb")) :path)
      "a file with spaces.rb"))
  (test "a too-short token is skipped"
    (assert= (gitcore/git-entries "\u{0}  \u{0}M  a") (list {:x "M" :y " " :path "a"}))))

;; ---- the status buffer is a section tree ----------------------------------------
;; `git-status-tree` is pure: a collection in, a tree out. `gt-render` flattens it the way
;; the buffer does (`section`), so these assert on the lines a reader sees and
;; the rows the commands read.

(defn gt-render (collected &optional (vis {}))
  "The status tree for `collected`, rendered: `{:lines :rows :text}`."
  (let (r (section-render (gitstatus/git-status-tree collected) vis))
    (assoc r :text (string/join (:lines r) "\n"))))

(defn gt-status (entries &optional (more {}))
  "A collection with `entries` (porcelain text) on branch main, plus `more`."
  (merge {:branch "main" :entries (gitcore/git-entries entries) :head {}} more))

(defn gt-rows-of (r type)
  "The heading rows of `type` in rendering `r`."
  (seq/filter (:rows r) (fn (x) (and x (:heading? x) (= (:type x) type)))))

(describe "git: status render"
  (test "sections appear with their counts; each file is a heading carrying its path"
    (let (r (gt-render (gt-status "M  s.rb\u{0} M u.rb\u{0}?? n.rb")))
      (assert= (first (:lines r)) "Head:   main")
      (is (includes? (:lines r) "Staged changes (1)"))
      (is (includes? (:lines r) "Unstaged changes (1)"))
      (is (includes? (:lines r) "Untracked files (1)"))
      (let (files (gt-rows-of r :file))
        (assert= (sort (map files (fn (x) (:path (:value x))))) (list "n.rb" "s.rb" "u.rb"))
        (assert= (:section (:value (seq/find files (fn (x) (= (:path (:value x)) "s.rb")))))
          :staged))))
  (test "Magit's density: a file line is its state word and the path, nothing indented"
    (let (r (gt-render (gt-status " M src/u.rb\u{0}?? n.rb")))
      (is (includes? (:lines r) "modified   src/u.rb"))
      ;; an untracked file is just its path — the section says what it is
      (is (includes? (:lines r) "n.rb"))))
  (test "one blank line between top-level sections, and no blank line anywhere else"
    (let (lines (:lines (gt-render (gt-status "M  s.rb\u{0} M u.rb"))))
      (assert= lines
        ["Head:   main"
          "" "Unstaged changes (1)" "modified   u.rb" "" "Staged changes (1)" "modified   s.rb" ""])))
  (test "unstaged renders above staged; untracked renders above unstaged"
    (let (text (:text (gt-render (gt-status "M  s.rb\u{0} M u.rb\u{0}?? n.rb"))))
      (is (< (index-of text "Untracked files") (index-of text "Unstaged changes")))
      (is (< (index-of text "Unstaged changes") (index-of text "Staged changes")))))
  (test "a rename shows where it came from, and both halves travel with the row"
    (let (r (gt-render (gt-status (str "R  new.txt" (string/int->char 0) "old.txt")))
          f (:value (first (gt-rows-of r :file))))
      (is (includes? (:lines r) "renamed    old.txt -> new.txt"))
      (assert= (:orig-path f) "old.txt")))
  (test "a long conflict label still leaves two spaces before the path"
    (is (includes? (:lines (gt-render (gt-status "UD d.txt"))) "deleted by them  d.txt")))
  (test "files start folded and say they have not been fetched"
    (let (r (gt-render (gt-status " M f.txt"))
          f (first (gt-rows-of r :file)))
      (is (not (includes? (:text r) "@@")))
      (is (:lazy? (:value f)))))
  (test "an opened file shows its hunks, each a section with its lines under it"
    (let (file (first (diff/parse-unified "--- a/f.txt\n+++ b/f.txt\n@@ -1 +1 @@\n-old\n+new\n"))
          r (gt-render (gt-status " M f.txt" {:diffs {:unstaged {"f.txt" file}}})
              {[[:status nil] [:unstaged nil] [:file "f.txt"]] :show})
          hunk (first (gt-rows-of r :hunk)))
      (is (includes? (:lines r) "@@ -1 +1 @@"))
      (is (includes? (:lines r) "+new"))
      (assert= (:path (:value hunk)) "f.txt")
      (assert= (:section (:value hunk)) :unstaged)
      ;; a body line knows its hunk and its index in it — what line-level staging reads
      (let (body (seq/find (:rows r) (fn (x) (and x (not (:heading? x)) (= (:type x) :hunk)))))
        (assert= (:line body) 0))))
  (test "a both-staged-and-unstaged file shows each list's own diff"
    (let (staged (first (diff/parse-unified "--- a/f\n+++ b/f\n@@ -1 +1 @@\n+staged-side\n")))
      (let (unstaged (first (diff/parse-unified "--- a/f\n+++ b/f\n@@ -1 +1 @@\n+unstaged-side\n"))
            text (:text (gt-render (gt-status "MM f"
                                     {:diffs {:staged {"f" staged} :unstaged {"f" unstaged}}})
                          {[[:status nil] [:staged nil] [:file "f"]] :show
                           [[:status nil] [:unstaged nil] [:file "f"]] :show})))
        (is (includes? text "+unstaged-side"))
        (is (includes? text "+staged-side")))))
  (test "recent commits are commit sections with their refs"
    (let (r (gt-render (gt-status ""
                         {:recent (list {:hash "abc1234" :refs "HEAD -> main" :subject "first"}
                                    {:hash "def5678" :refs "" :subject "second"})})))
      (is (includes? (:lines r) "Recent commits"))
      (is (includes? (:lines r) "abc1234 main first"))
      (is (includes? (:lines r) "def5678 second"))
      (assert= (:hash (:value (first (gt-rows-of r :commit)))) "abc1234")))
  (test "upstream sections name the upstream"
    (let (r (gt-render (gt-status ""
                         {:head {:upstream "origin/main"}
                          :unpushed (list {:hash "aaa1111" :subject "mine"})})))
      (is (includes? (:lines r) "Merge:  origin/main"))
      (is (includes? (:lines r) "Unpushed to origin/main (1)"))))
  (test "a tag behind HEAD is in the header, with the distance"
    (is (includes? (:lines (gt-render (gt-status "" {:head {:tag {:name "v1.0" :distance 3}}})))
          "Tag:    v1.0  (3)")))
  (test "a clean tree lists no files"
    (is (empty? (gt-rows-of (gt-render (gt-status "")) :file)))))

(describe "git: faces come from what a line IS"
  (test "a list heading: the name, then the count dim"
    (assert= (gitsection/git-section-faces {:type :staged :heading? true} "Staged changes (1)")
      (list [0 14 gitcore/git-face-section] [15 18 vcsproc/vcs-face-meta])))
  (test "a file heading colours its state word"
    (assert= (gitsection/git-section-faces {:type :file :heading? true :value {:section :unstaged}}
               "modified   f")
      (list [0 8 gitcore/git-face-unstaged])))
  (test "a hunk's body is coloured by its first character, context left alone"
    (assert= (gitsection/git-section-faces {:type :hunk :heading? false} "+new")
      (list [0 4 vcsproc/vcs-face-add]))
    (assert= (gitsection/git-section-faces {:type :hunk :heading? false} "-old")
      (list [0 4 vcsproc/vcs-face-del]))
    (assert= (gitsection/git-section-faces {:type :hunk :heading? false} " ctx") '()))
  (test "a commit subject that starts with - is not a removed line"
    (assert= (gitsection/git-section-faces {:type :commit
                                            :heading? true
                                            :value {:hash "abc1234" :refs ""}}
               "abc1234 - fix")
      (list [0 7 gitcore/git-face-hash])))
  (test "the Head: branch is local blue, Merge: remote green"
    (assert= (gitsection/git-section-faces {:type :branch
                                            :heading? true
                                            :value {:name "main" :local? true}}
               "Head:   main  subj")
      (list [0 5 vcsproc/vcs-face-meta] [8 12 gitcore/git-face-branch-local]))
    (assert= (map (gitsection/git-section-faces {:type :branch
                                                 :heading? true
                                                 :value {:name "origin/main"}}
                    "Merge:  origin/main")
               (fn (s) (nth s 2)))
      (list vcsproc/vcs-face-meta gitcore/git-face-branch-remote)))
  (test "the raw-text diff fontify (for `!` output) still colours by the text"
    (let (spans (vcsproc/vcs-diff-fontify "@@ -1 +1 @@\n-old\n+new\n ctx"))
      (assert= (map spans (fn (s) (nth s 2)))
        (list vcsproc/vcs-face-hunk vcsproc/vcs-face-del vcsproc/vcs-face-add)))))

(describe "git: log parsing"
  (test "parse-log: hash, refs, subject, author and age, NUL-separated"
    (let (z (string/int->char 0)
          cs (gitsection/git-parse-log (str "abc1234"
                                         z "HEAD -> main" z "a - message" z "Ann" z "2 days ago\n")))
      (assert= (first cs)
        {:hash "abc1234"
         :graph ""
         :refs "HEAD -> main"
         :subject "a - message"
         :author "Ann"
         :date "2 days ago"})))
  (test "a --graph log keeps the drawing, and a graph-only line has no hash"
    (let (z (string/int->char 0)
          cs (gitsection/git-parse-log (str "* abc1234" z "" z "s" z "A" z "now\n|\\\n")))
      (assert= (:graph (first cs)) "* ")
      (assert= (:hash (first cs)) "abc1234")
      (is (nil? (:hash (second cs))))))
  (test "commit-message: comment lines are dropped and the rest trimmed"
    (assert= (gitcommit/git-commit-message "feat: a thing\n\nbody line\n# a comment\n#another\n")
      "feat: a thing\n\nbody line")
    (assert= (gitcommit/git-commit-message "  # indented comments count too\nreal\n") "real")
    (assert= (gitcommit/git-commit-message "# only comments\n") "")))

(describe "git: status-bar segments (branch + working-tree indicator)"
  (def CLEAN
    {:root "/home/u/bedit"
     :branch "main"
     :upstream "origin/main"
     :ahead "0"
     :behind "0"
     :staged 0
     :unstaged 0
     :untracked 0})
  (def DIRTY (assoc CLEAN :staged 2 :unstaged 1 :untracked 3))

  (test "no summary → no segments"
    (assert= (vcscore/vcs-chip-segments (gitbar/git-chip nil)) '()))

  (test "a fileless buffer shows no git segments, even created inside a repo"
    ;; *scratch* / *Playground* only INHERIT a :dir from where they were made; a buffer that
    ;; cannot be saved has no working-tree relationship to indicate. This test file itself
    ;; lives in a repo, so the cwd fallback would have resolved a root.
    (let (m (vcscore/vcs-cache-summary (model/ed-init (editor/buffer/make-buffer "(+ 1 2)"
                                                        "*Playground*"))))
      (assert= (:vcs-summary m) nil)
      (assert= (or (:vcs-segments m) '()) '())))

  (test "a clean tree is just the branch + a green state dot (no count segments)"
    (let (segs (vcscore/vcs-chip-segments (gitbar/git-chip CLEAN))
          ids (map segs :id))
      (assert= ids (list :vcs-label :vcs-dot))
      (is (includes? (:text (first segs)) "main"))
      (assert= (:face (nth segs 1)) gitcore/git-face-clean)))

  (test "counts appear only when non-zero, colour-coded, in +~? order"
    (let (segs (vcscore/vcs-chip-segments (gitbar/git-chip DIRTY))
          by (fn (id) (seq/find segs (fn (s) (= (:id s) id)))))
      (assert= (map segs :id)
        (list :vcs-label :vcs-dot :git-staged :git-unstaged :git-untracked))
      (assert= (:text (by :git-staged)) "+2")
      (assert= (:face (by :git-staged)) gitcore/git-face-staged)
      (assert= (:text (by :git-unstaged)) "~1")
      (assert= (:text (by :git-untracked)) "?3")))

  (test "the state dot is yellow when there are unstaged changes, green when only staged"
    (assert= (get (nth (vcscore/vcs-chip-segments (gitbar/git-chip (assoc CLEAN :unstaged 1))) 1)
               :face)
      gitcore/git-face-unstaged)
    (assert= (get (nth (vcscore/vcs-chip-segments (gitbar/git-chip (assoc CLEAN :staged 1))) 1)
               :face)
      gitcore/git-face-clean))

  (test "branch + dot segments are clickable to *git-status* and carry a hover tooltip"
    (let (segs (vcscore/vcs-chip-segments (gitbar/git-chip DIRTY))
          branch (first segs)
          dot (nth segs 1))
      (assert= (:on-click branch) 'vcscore/cmd-vcs-status)
      (assert= (:on-click dot) 'vcscore/cmd-vcs-status)
      (is (includes? (str (statusbar/seg-tooltip-lines branch {})) "Branch: main"))
      (is (includes? (str (statusbar/seg-tooltip-lines dot {})) "Unstaged:  1"))))

  (test "a clean working tree tooltip reads 'clean'"
    (is (includes? (str (gitbar/git-tree-tooltip CLEAN)) "clean"))))

;; ---- git never blocks the loop ---------------------------------------------
;; The bug: `F` (pull) is a NETWORK round trip and it ran on the dispatch path, so the
;; window stopped repainting until the remote answered. Nothing that can outlast a frame
;; may run there — the language's answer to blocking work is a process, and these assert
;; that git uses one.

(describe "C-x g selects the status buffer at once"
  ;; The bug: with *git-status* already in the pool, C-x g only RECORDED that it should pop,
  ;; and the pop happened when the off-loop collection landed — if the reader was elsewhere
  ;; by then, never. Their next keys (`l l` for the log) went into the file they were in.
  (test "an existing status buffer beside the file is selected before the refresh lands"
    (let (me (self)
          m0 (model/ed-init (editor/buffer/make-buffer "defmodule" "mix.exs" "mix.exs"))
          shown (model/ed-update-named (pool/ed-display-buffer m0
                                         "*git-status: old*"
                                         "old status\n"
                                         :git-status {:action :display})
                  "*git-status: old*"
                  (fn (b) (assoc b :section-ctx {:root "."})))
          m (binding (editor/ui/*loop* me) (git-show-status shown "." nil :pop)))
      (assert= (:name (model/ed-current-buf shown)) "mix.exs")
      (assert= (:name (model/ed-current-buf m)) "*git-status: old*")
      ;; the refresh, when it lands, stays where the reader now is
      (assert= (:git-status-action m) :here)))
  (test "a status buffer in no pane is shown and selected too"
    (let (me (self)
          m0 (model/ed-init (editor/buffer/make-buffer "defmodule" "mix.exs" "mix.exs"))
          pooled (model/ed-update-named (pool/ed-upsert-named m0
                                          "*git-status: old*" "old status\n" :git-status)
                   "*git-status: old*"
                   (fn (b) (assoc b :section-ctx {:root "."})))
          m (binding (editor/ui/*loop* me) (git-show-status pooled "." nil :pop)))
      (assert= (:name (model/ed-current-buf m)) "*git-status: old*"))))

(describe "git operations that can outlast a frame run off the loop"
  (test "a launch parks a handle and returns immediately, without running git"
    ;; `ed-headless?` is true under test (no loop), so force the async path by binding
    ;; `editor/ui/*loop*` — this is the shape the real loop takes
    (let (me (self)
          m (binding (editor/ui/*loop* me)
              (gitcore/git-launch-op (assoc (model/ed-init (editor/buffer/make-buffer ""))
                                       :git-root ".")
                "pull"
                ["--version"])))
      (assert= (gitcore/git-op-running m) "pull")
      (is (not (nil? (:vcs-op-proc m))))))
  (test "a second launch while one is in flight is refused, not queued"
    (let (m (assoc (model/ed-init (editor/buffer/make-buffer ""))
              :git-root "."
              :vcs-op {:verb "pull"}
              :vcs-op-proc :fake)
          m2 (gitcore/git-launch-op m "push" ["push"]))
      (is (includes? (:echo m2) "already running"))
      ;; the in-flight handle is untouched — the refusal must not clobber the slot
      (assert= (:vcs-op-proc m2) :fake)))
  (test "the fold reports the result and frees the slot"
    (let (m (assoc (model/ed-init (editor/buffer/make-buffer ""))
              :vcs-op {:verb "pull" :root "."}
              :vcs-op-proc :fake)
          done (vcsproc/vcs-apply-op m {:exit 0 :stdout "Already up to date." :stderr ""}))
      (assert= (:vcs-op-proc done) nil)
      (assert= (:vcs-op done) nil)
      (is (includes? (:echo done) "Already up to date"))))
  (test "a timed-out task is reported as a failure, not as a silent success"
    ;; nil is what a :task-error / :task-timeout folds in; a bare exit-code check would
    ;; read that as a success with empty output
    (let (m (assoc (model/ed-init (editor/buffer/make-buffer ""))
              :vcs-op {:verb "pull"}
              :vcs-op-proc :fake))
      (is (includes? (:echo (vcsproc/vcs-apply-op m nil)) "pull failed"))))
  (test "headless still runs git synchronously, so tests and --headless are unchanged"
    (let (m (gitcore/git-launch-op (model/ed-init (editor/buffer/make-buffer "")) "v" ["--version"]))
      (assert= (gitcore/git-op-running m) nil)
      (is (includes? (:echo m) "v")))))

;; ---- the upstream watch ------------------------------------------------------

(describe "the background fetch tells you when the remote moved"
  (test "a remote that gained commits is news"
    (is (includes? (gitfetch/git-upstream-news {:behind "0"} {:upstream "origin/main" :behind "3"})
          "3 new commits")))
  (test "one commit is singular"
    (is (includes? (gitfetch/git-upstream-news {:behind "0"} {:upstream "origin/main" :behind "1"})
          "1 new commit")))
  (test "the SAME commits are not news again"
    ;; announcing the same three every three minutes is how a notification becomes noise
    (assert= (gitfetch/git-upstream-news {:behind "3"} {:upstream "origin/main" :behind "3"}) nil))
  (test "a branch level with its upstream says nothing"
    (assert= (gitfetch/git-upstream-news {:behind "0"} {:upstream "origin/main" :behind "0"}) nil))
  (test "pulling (behind goes down) is not news either"
    (assert= (gitfetch/git-upstream-news {:behind "3"} {:upstream "origin/main" :behind "0"}) nil))
  (test "a further advance names the new ones and the running total"
    (let (s (gitfetch/git-upstream-news {:behind "2"} {:upstream "origin/main" :behind "5"}))
      (is (includes? s "3 new commits"))
      (is (includes? s "(5 behind)"))))
  (test "the fold drops an answer about a repo the reader has left"
    (let (after (gitfetch/git-apply-fetch {:git-root "/elsewhere"}
                  {:root "/old" :upstream "origin/main" :behind "9"}))
      (assert= (:git-upstream-seen after) nil)))
  (test "the watch never fetches headless"
    (assert= (:git-fetch-proc (gitfetch/git-launch-fetch {:git-root "."})) nil)))

;; ---- ahead/behind on the mode line -------------------------------------------

(describe "the mode line shows what the fetch found"
  (test "behind shows a down arrow"
    (assert= (:text (gitbar/git-sync-mark {:behind "2" :ahead "0"})) "↓2"))
  (test "ahead shows an up arrow"
    (assert= (:text (gitbar/git-sync-mark {:behind "0" :ahead "1"})) "↑1"))
  (test "both, behind first — what you can do about it comes first"
    (assert= (:text (gitbar/git-sync-mark {:behind "2" :ahead "1"})) "↓2 ↑1"))
  (test "level with the upstream shows nothing at all"
    (assert= (gitbar/git-sync-mark {:behind "0" :ahead "0"}) nil))
  (test "no upstream shows nothing rather than a zero"
    (assert= (gitbar/git-sync-mark {}) nil)))

;; ---- the process log (`$`, Magit's process buffer) ---------------------------
;; What git actually ran: every command threaded through the model, its exit code, how
;; long it took and its whole output — where the echo area could only show one line.

(defn gp-model ()
  (assoc (model/ed-init (editor/buffer/make-buffer "")) :git-root "."))

(defn gp-entry (m i) (nth (vcsproc/vcs-journal m) i))

(describe "git: the process log records what ran"
  (test "a synchronous command lands as an entry, with its exit code and output"
    (let ([m r] (gitcore/git-run (gp-model) ["--version"])
          e (gp-entry m 0))
      (assert= (:exit r) 0)
      (assert= (:args e) ["--version"])
      (assert= (:exit e) 0)
      (is (includes? (:output e) "git version"))
      (is (not (:running? e)))
      ;; a duration, which Magit's process buffer does not keep
      (is (int? (:ms e)))))
  (test "a failure keeps the whole output, not the one line the echo area shows"
    (let ([m _r] (gitcore/git-run (gp-model) ["frobnicate"])
          e (gp-entry m 0))
      (is (not (= (:exit e) 0)))
      (is (not (= (:output e) "")))))
  (test "entries accumulate oldest-first and are capped"
    (let (add (fn (mm i)
                (first (vcsproc/vcs-journal-add mm {:args [(str i)] :running? false :exit 0})))
          many (fold (range (+ vcsproc/*vcs-journal-max* 3)) (gp-model) add)
          entries (vcsproc/vcs-journal many))
      (assert= (count entries) vcsproc/*vcs-journal-max*)
      ;; the oldest went; the newest is last
      (assert= (:args (first entries)) ["3"])
      (assert= (:args (last entries)) [(str (+ vcsproc/*vcs-journal-max* 2))])))
  (test "a running entry is never trimmed away — its output has not arrived yet"
    (let (add (fn (mm i)
                (first (vcsproc/vcs-journal-add mm {:args [(str i)] :running? false :exit 0})))
          running (first (vcsproc/vcs-journal-add (gp-model) {:args ["pull"] :running? true}))
          many (fold (range (+ vcsproc/*vcs-journal-max* 3)) running add))
      (is (any? (vcsproc/vcs-journal many) :running?)))))

(describe "git: an in-flight command reads as `run`"
  :isolated (test "a launch records the entry before the command has answered"
    (let (me (self)
          ;; inside a loop, so the op goes off it (`ed-headless?` asks `editor/ui/*loop*`)
          m (binding (editor/ui/*loop* me) (gitcore/git-launch-op (gp-model) "pull" ["--version"]))
          e (last (vcsproc/vcs-journal m)))
      (is (:running? e))
      (assert= (:args e) ["--version"])
      (is (includes? (vcsproc/vcs-journal-heading e) "run "))))
  :isolated (test "the fold completes that entry with the exit code, the output and the duration"
    (let (me (self)
          ;; inside a loop, so the op goes off it (`ed-headless?` asks `editor/ui/*loop*`)
          m (binding (editor/ui/*loop* me) (gitcore/git-launch-op (gp-model) "pull" ["--version"]))
          done (vcsproc/vcs-apply-op m {:exit 0 :stdout "Already up to date." :stderr ""})
          e (last (vcsproc/vcs-journal done)))
      (is (not (:running? e)))
      (assert= (:exit e) 0)
      (is (includes? (:output e) "Already up to date"))))
  :isolated (test "a timed-out op completes its entry too, rather than leaving it running forever"
    (let (me (self)
          ;; inside a loop, so the op goes off it (`ed-headless?` asks `editor/ui/*loop*`)
          m (binding (editor/ui/*loop* me) (gitcore/git-launch-op (gp-model) "pull" ["--version"]))
          done (vcsproc/vcs-apply-op m nil)
          e (last (vcsproc/vcs-journal done)))
      (is (not (:running? e)))
      (is (includes? (:output e) "timed out")))))

(describe "git: how the log reads"
  (test "the heading is Magit's: the exit code in three columns, then the command"
    (assert= (vcsproc/vcs-journal-heading {:exit 0
                                           :args ["-C" "/r" "-c" "core.quotePath=false" "add" "-u"]
                                           :ms 12})
      "  0 git add -u  (12ms)")
    (assert= (vcsproc/vcs-journal-heading {:exit 128 :args ["pull"] :ms 2400})
      "128 git pull  (2.4s)")
    (assert= (vcsproc/vcs-journal-heading {:running? true :args ["push"]}) "run git push"))
  (test "bedit's own global arguments are elided — nobody typed them"
    (is (not (includes? (vcsproc/vcs-journal-heading {:exit 0 :args ["-C" "/r" "status"] :ms 1})
               "-C"))))
  (test "a credential in a remote URL is redacted: a process log gets pasted into bug reports"
    (let (h (vcsproc/vcs-journal-heading {:exit 0
                                          :ms 1
                                          :args ["push" "https://me:ghp_secret@github.com/x/y"]}))
      (is (includes? h "me:***@github.com"))
      (is (not (includes? h "ghp_secret")))))
  (test "a token sent as the username is redacted too; an ssh account name is not"
    (let (h (vcsproc/vcs-journal-heading {:exit 0
                                          :ms 1
                                          :args ["push" "https://ghp_tok3n@github.com/x/y"]})
          ssh (vcsproc/vcs-journal-heading {:exit 0
                                            :ms 1
                                            :args ["fetch" "ssh://git@github.com/x/y"]}))
      (is (includes? h "https://***@github.com"))
      (is (not (includes? h "ghp_tok3n")))
      (is (includes? ssh "git@github.com"))))
  (test "`\\r` progress is applied, not left as forty redrawn lines"
    ;; git push writes "Writing objects: 1%\rWriting objects: 100%\r" — Magit hand-rolls
    ;; this in its process filter; bedit has a real terminal (brood ADR-384)
    (let (e (vcsproc/vcs-entry-output {:exit 0
                                       :stdout "Writing objects:  1%\rWriting objects: 100%, done.\n"
                                       :stderr ""}))
      (is (includes? e "100%, done."))
      (is (not (includes? e "1%")))))
  (test "colours and an OSC title or hyperlink leave no text behind (issue #24)"
    (assert= (vcsproc/vcs-entry-output {:exit 0
                                        :stdout "\e]0;git push\x07\e[32mok\e[0m \e]8;;https://x\e\\link\e]8;;\e\\\n"
                                        :stderr ""})
      "ok link"))
  (test "the text renders one block per entry, the output indented under its heading"
    (let (m (first (vcsproc/vcs-journal-add (gp-model)
                     {:args ["add" "-u"] :exit 0 :ms 3 :output "one\ntwo" :running? false}))
          text (vcsproc/vcs-journal-text m))
      (assert= text "  0 git add -u  (3ms)\n    one\n    two"))
    (assert= (vcsproc/vcs-journal-text (gp-model)) "(no version control commands yet)"))
  (test "a heading is coloured by its exit code, the output under it is not"
    (let (spans (vcsproc/vcs-process-fontify "  0 git add\n    ok\n128 git pull\nrun git push"))
      (assert= (count spans) 3)
      (assert= (nth (first spans) 2) vcsproc/vcs-face-add)
      (assert= (nth (second spans) 2) vcsproc/vcs-face-del)
      (assert= (nth (nth spans 2) 2) vcsproc/vcs-face-hunk)))
  (test "an output line that reads like a heading is still output"
    ;; the whole reason output is indented one column further than the widest heading
    ;; prefix: `0 files changed` under a command must not be read as a command that exited 0
    (let (spans (vcsproc/vcs-process-fontify "  0 git apply\n    0 files changed"))
      (assert= (count spans) 1)))
  (test "a timed-out entry says `?`, not four blank columns"
    ;; its `:exit` is present and nil, so a `get` default would never be reached
    (assert= (vcsproc/vcs-journal-heading {:exit nil :args ["pull"] :ms 120000})
      "  ? git pull  (2m 00s)")))

(describe "git: a failure says where the rest of the output is"
  :isolated (test "the echo area appends the hint; the whole output is in the log"
    ;; Magit appends the same hint for the same reason: one line reaches the echo area,
    ;; and nobody guesses that a key shows the rest
    (let (me (self)
          [m r] (gitcore/git-run (gp-model) ["frobnicate"])
          reported (binding (editor/ui/*loop* me) (vcsproc/vcs-report-cmd m "bogus" r)))
      (is (includes? (:echo reported) "$ for the full output"))
      (is (includes? (:output (gp-entry reported 0)) "not a git command"))))
  (test "a one-line SUCCESS gets no hint — there is nothing to go and read"
    (let ([m r] (gitcore/git-run (gp-model) ["--version"]))
      (is (not (includes? (:echo (vcsproc/vcs-report-cmd m "version" r)) "$ for")))))
  (test "a pull that moved many refs reports ONE line, not every ref folded onto the row"
    ;; the bug: stderr was preferred and folded whole, so the echo area read
    ;; `pull: From github.com:… 663abe2..d21c527 master -> origin/master   9607ba4..…` and ran
    ;; off the screen
    (let (me (self)
          r {:exit 0
             :stdout "Updating 663abe2..d21c527\nFast-forward\n lib/a.ex | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\n"
             :stderr (str "From github.com:org/repo\n"
                       "   663abe2..d21c527  master     -> origin/master\n"
                       "   9607ba4..d685f33  deps-update -> origin/deps-update\n")}
          echo (:echo (binding (editor/ui/*loop* me) (vcsproc/vcs-report-cmd (gp-model) "pull" r))))
      (assert= echo "pull: 1 file changed, 1 insertion(+), 1 deletion(-) ($ for the full output)")))
  (test "a push, which says everything on stderr, reports its last line"
    (assert= (first (vcsproc/vcs-summary {:exit 0
                                          :stdout ""
                                          :stderr "To github.com:org/repo\n   abc..def  main -> main\n"}))
      "abc..def  main -> main"))
  (test "a failure reports its fatal: line, not the hints before it"
    (assert= (first (vcsproc/vcs-summary {:exit 128
                                          :stdout ""
                                          :stderr "hint: one\nhint: two\nfatal: not possible to fast-forward\n"}))
      "fatal: not possible to fast-forward"))
  (test "NUL from a -z command is shown, never written into the rope"
    (let (out (vcsproc/vcs-entry-output {:exit 0
                                         :stdout (str " M a.txt" (string/int->char 0) " M b.txt")
                                         :stderr ""}))
      (is (includes? out "^@"))
      (is (not (includes? out (string/int->char 0)))))))

(describe "git: the buffer is a view of the journal, not a copy"
  (test "a command while *vcs-process* is open re-renders it in place"
    (let (opened (vcsproc/cmd-vcs-process (gp-model) nil)
          [m _] (gitcore/git-run opened ["--version"])
          shown (model/ed-buf-at m (model/ed-buffer-index-by-name! m "*vcs-process*")))
      ;; no `g` needed: the entry is there the moment it ran
      (is (includes? (editor/buffer/buffer-text shown) "git --version"))))
  (test "a command with the buffer CLOSED leaves the pool alone"
    (let ([m _] (gitcore/git-run (gp-model) ["--version"]))
      (is (nil? (model/ed-buffer-index-by-name m "*vcs-process*")))))
  :isolated (test "an op that lands stops reading `run` without a refresh"
    (let (me (self)
          opened (vcsproc/cmd-vcs-process (gp-model) nil)
          started (binding (editor/ui/*loop* me)
                    (gitcore/git-launch-op opened "pull" ["--version"]))
          mid (editor/buffer/buffer-text (model/ed-buf-at started
                                           (model/ed-buffer-index-by-name! started "*vcs-process*")))
          done (vcsproc/vcs-apply-op started {:exit 0 :stdout "Already up to date." :stderr ""})
          after (editor/buffer/buffer-text (model/ed-buf-at done
                                             (model/ed-buffer-index-by-name! done "*vcs-process*"))))
      (is (includes? mid "run git --version"))
      (is (not (includes? after "run git --version")))
      (is (includes? after "Already up to date")))))

(describe "git: `$` is reachable the way a key and a name should be"
  (test "M-x vcs-process works from ANY buffer — the layer must not claim it"
    ;; a layer's `:commands` are subtracted from the global M-x set, so claiming
    ;; "vcs-process" for the *vcs-process* layer would offer it only where you already are
    (let (owned (into #{} (model/ed-all-layer-commands)))
      (is (not (contains? owned "vcs-process")))
      ;; clearing the log, on the other hand, means nothing outside that buffer
      (is (contains? owned "vcs-process-clear"))))
  (test "and it is offered before anything has loaded git — `$` is in a MODE keymap, and
only the profile keymaps are harvested for M-x"
    (is (not (nil? (interactive/command-sym "vcs-process")))))
  (test "`$` is bound in every git buffer, so it is where a Magit user reaches for it"
    (let (key-of (fn (km) (get km "$")))
      (assert= (key-of gitstatus/git-status-keymap) 'vcsproc/cmd-vcs-process)
      (assert= (key-of gitcore/git-report-keymap) 'vcsproc/cmd-vcs-process)
      (assert= (key-of vcsproc/vcs-process-keymap) 'vcsproc/cmd-vcs-process))))

;; ---- the sequencer: what operation is this repo part-way through? ------------
;; The one piece of the new porcelain that touches the filesystem, and the one that fails
;; SILENTLY if it is wrong: a `git-sequencer` that always answered nil would leave
;; continue / abort / skip permanently reporting "nothing in progress", with nothing on
;; screen to say why. So this builds a real repo in a temp dir and puts it into each state.
;;
;; Real git, deliberately. The detection is a claim about what git leaves in `.git` — a
;; fixture asserting that `MERGE_HEAD` means a merge would only be testing that this file
;; agrees with itself.

(defn gt-git (dir args) (os/cmd "git" args {:cwd dir}))

(defn gt-repo (name)
  "A throwaway repo in a temp dir with two diverged branches whose single file conflicts."
  (let (dir (path/temp (str "bedit-git-test-" name "-")))
    (do
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})
      (file/mkdir dir)
      (gt-git dir ["init" "-q"])
      (gt-git dir ["config" "user.email" "t@example.com"])
      (gt-git dir ["config" "user.name" "Test"])
      (gt-git dir ["config" "commit.gpgsign" "false"])
      (file/spit (path/join dir "f.txt") "base\n")
      (gt-git dir ["add" "f.txt"])
      (gt-git dir ["commit" "-qm" "base"])
      (gt-git dir ["branch" "-M" "main"])
      (gt-git dir ["checkout" "-q" "-b" "other"])
      (file/spit (path/join dir "f.txt") "theirs\n")
      (gt-git dir ["commit" "-qam" "theirs"])
      (gt-git dir ["checkout" "-q" "main"])
      (file/spit (path/join dir "f.txt") "ours\n")
      (gt-git dir ["commit" "-qam" "ours"])
      dir)))

(describe "git: the sequencer knows what is in progress"
  (test "a clean repo is in the middle of nothing"
    (assert= (gitcore/git-sequencer (gt-repo "clean")) nil))
  (test "a conflicted merge reads as a merge"
    (let (dir (gt-repo "merge"))
      (do
        (gt-git dir ["merge" "other"]) ; conflicts on f.txt
        (assert= (gitcore/git-sequencer dir) {:kind :merge :verb "merge"}))))
  (test "…and aborting it puts the repo back to nothing in progress"
    (let (dir (gt-repo "merge-abort"))
      (do
        (gt-git dir ["merge" "other"])
        (gt-git dir ["merge" "--abort"])
        (assert= (gitcore/git-sequencer dir) nil))))
  (test "a stopped rebase reads as a rebase, not a merge"
    ;; the distinction that matters: both leave a conflicted tree, and `git merge
    ;; --continue` is not what finishes a rebase
    (let (dir (gt-repo "rebase"))
      (do
        (gt-git dir ["rebase" "other"])
        (assert= (gitcore/git-sequencer dir) {:kind :rebase :verb "rebase"}))))
  (test "a stopped am reads as an am, which `am --continue` finishes, not a rebase"
    (let (dir (gt-repo "am")
          patch (path/join dir "theirs.patch"))
      (do
        (file/spit patch (:stdout (gt-git dir ["format-patch" "-1" "--stdout" "other"])))
        (gt-git dir ["am" patch]) ; conflicts on f.txt
        (assert= (gitcore/git-sequencer dir) {:kind :am :verb "am"}))))
  (test "a stopped cherry-pick reads as a cherry-pick"
    (let (dir (gt-repo "pick"))
      (do
        (gt-git dir ["cherry-pick" "other"])
        (assert= (gitcore/git-sequencer dir) {:kind :cherry-pick :verb "cherry-pick"}))))
  (test "it reads the real git dir, so it works in a WORKTREE"
    ;; a worktree's `.git` is a FILE holding a gitdir: pointer, and looking for markers at
    ;; `<root>/.git/MERGE_HEAD` finds nothing there — every one of these features would be
    ;; dead in the place a rebase is most likely to be happening
    (let (dir (gt-repo "worktree")
          wt (path/join dir "wt"))
      (do
        (gt-git dir ["worktree" "add" "-q" "-b" "wtbranch" wt "other"])
        (assert= (file/dir? (path/join wt ".git")) false) ; it is a file
        (gt-git wt ["merge" "main"])
        (assert= (gitcore/git-sequencer wt) {:kind :merge :verb "merge"})))))

(describe "git: conflicts get their own section, once"
  (test "UU is a conflict, not staged-and-unstaged"
    (let (e (first (gitcore/git-entries "UU f.txt")))
      (is (gitcore/git-conflicted? e))))
  (test "both-added and both-deleted are conflicts too"
    (is (gitcore/git-conflicted? (first (gitcore/git-entries "AA f.txt"))))
    (is (gitcore/git-conflicted? (first (gitcore/git-entries "DD f.txt")))))
  (test "an ordinary staged+unstaged file is NOT a conflict"
    (is (not (gitcore/git-conflicted? (first (gitcore/git-entries "MM f.txt"))))))
  (test "a conflicted file appears in Unmerged paths and nowhere else"
    (let (text (:text (gt-render (gt-status "UU c.txt\u{0}M  s.txt"))))
      (is (includes? text "Unmerged paths (1)"))
      (is (includes? text "Staged changes (1)"))
      ;; the conflicted path must not ALSO be listed under staged/unstaged — before this it
      ;; was in both, and `s` on it staged a file full of <<<<<<< markers
      (assert= (count (seq/filter (string/split text "\n") (fn (l) (includes? l "c.txt")))) 1)))
  (test "the section comes first — you cannot get on without dealing with it"
    (let (text (:text (gt-render (gt-status "UU c.txt\u{0}?? n.txt"))))
      (is (< (index-of text "Unmerged paths") (index-of text "Untracked files")))))
  (test "the label says HOW it conflicted, which is what decides the resolution"
    (let (text (:text (gt-render (gt-status "UU b.txt\u{0}UD d.txt"))))
      (is (includes? text "both modified"))
      (is (includes? text "deleted by them"))))
  (test "its file is in the unmerged list, so k knows to offer ours / theirs"
    (let (f (first (gt-rows-of (gt-render (gt-status "UU c.txt")) :file)))
      (assert= (:section (:value f)) :unmerged))))

(describe "git: the status buffer says what is in progress"
  (test "nothing in progress adds no line"
    (is (not (includes? (:text (gt-render (gt-status ""))) "in progress"))))
  (test "a rebase in progress is announced ABOVE Head:"
    (let (lines (:lines (gt-render (gt-status ""
                                     {:head {:sequencer {:kind :rebase :verb "rebase"}}}))))
      (is (includes? (first lines) "rebase"))
      (is (includes? (first lines) "in progress"))
      (is (string/starts-with? (nth lines 1) "Head:"))))
  (test "…and it names the keys that get you out"
    (let (text (:text (gt-render (gt-status "" {:head {:sequencer {:kind :merge :verb "merge"}}}))))
      (is (includes? text "continue"))
      (is (includes? text "abort")))))

(describe "git: stashes are visible in the status buffer"
  (test "a stash list becomes commit-shaped rows"
    (let (dir (gt-repo "stash"))
      (do
        (file/spit (path/join dir "f.txt") "work in progress\n")
        (gt-git dir ["stash" "push" "-qm" "wip thing"])
        (let (stashes (gitcore/git-stashes dir))
          (assert= (count stashes) 1)
          (assert= (:hash (first stashes)) "stash@{0}")
          (is (includes? (:subject (first stashes)) "wip thing"))))))
  (test "a repo with no stashes has none, rather than one blank row"
    (assert= (gitcore/git-stashes (gt-repo "no-stash")) '()))
  (test "they render as their own section, each stash acting on its ref"
    (let (r (gt-render (gt-status "" {:stashes (list {:hash "stash@{0}" :subject "wip"})}))
          text (:text r))
      (assert= (:ref (:value (first (gt-rows-of r :stash)))) "stash@{0}")
      (is (includes? text "Stashes (1)"))
      (is (includes? text "wip"))))
  (test "no section at all when there are none"
    (is (not (includes? (:text (gt-render (gt-status ""))) "Stashes")))))

;; ---- interactive rebase: the plan, and that git actually follows it ---------
;; The claim this rests on is unusual enough to be worth proving with a real repo: that
;; `sequence.editor=cp <file>` makes git adopt a todo we composed, without opening any
;; editor. If that is wrong, `r i` silently picks everything — an `--interactive` that is
;; not interactive, which is exactly what it did before.

(defn gt-linear (name)
  "A repo with three commits on top of a base, oldest first: one, two, three."
  (let (dir (gt-repo name))
    (do
      (gt-git dir ["tag" "linearbase"]) ; a REF to rebase onto — "base" was only a message
      (doseq (n ["one" "two" "three"])
        (file/spit (path/join dir (str n ".txt")) (str n "\n"))
        (gt-git dir ["add" "-A"])
        (gt-git dir ["commit" "-qm" n]))
      dir)))

(defn gt-subjects (dir range)
  (seq/reject (string/split (string/trim (:stdout (gt-git dir ["log" "--format=%s" range]) ""))
                "\n")
    empty?)) ; newest first
(describe "git: the interactive-rebase plan"
  (test "the todo is OLDEST first — the order a rebase applies, not the order a log reads"
    (let (text (gitsequence/git-rebase-todo-text (list {:hash "ccc" :subject "third"}
                                                   {:hash "bbb" :subject "second"}
                                                   {:hash "aaa" :subject "first"}))
          lines (gitsequence/git-rebase-todo-lines text))
      (assert= (first lines) "pick aaa first")
      (assert= (nth lines 2) "pick ccc third")))
  (test "the help block is comments, and never reaches git"
    (let (text (gitsequence/git-rebase-todo-text (list {:hash "aaa" :subject "x"})))
      (is (includes? text "# "))
      (assert= (count (gitsequence/git-rebase-todo-lines text)) 1)))
  (test "every verb the buffer documents is one git accepts"
    ;; a typo here would be found by git refusing the whole todo, mid-rebase
    (doseq (row gitsequence/git-rebase-actions)
      (is (includes? ["pick" "reword" "edit" "squash" "fixup" "drop"] (first row))))))

(describe "git: an interactive rebase really follows the plan"
  (test "dropping a commit removes it, and nothing opens an editor"
    (let (dir (gt-linear "irebase-drop")
          todo (path/join dir ".git" "plan")
          hashes (map (gitsection/git-log-commits dir ["linearbase..HEAD"]) :hash))
      ; newest first
      (do
        ;; keep one and three, drop two — written oldest-first, as the todo is
        (file/spit todo
          (str "pick "
            (nth hashes 2)
            " one\n"
            "drop "
            (nth hashes 1)
            " two\n"
            "pick "
            (first hashes)
            " three\n"))
        (let (r (gt-git dir
                  ["-c"
                    (str "sequence.editor=cp " todo)
                    "-c"
                    "core.editor=true"
                    "rebase"
                    "-i"
                    "linearbase"]))
          (assert= (:exit r) 0)
          (assert= (gt-subjects dir "linearbase..HEAD") (list "three" "one"))))))
  (test "reordering the plan reorders the history"
    (let (dir (gt-linear "irebase-order")
          todo (path/join dir ".git" "plan")
          hashes (map (gitsection/git-log-commits dir ["linearbase..HEAD"]) :hash))
      (do
        (file/spit todo
          (str "pick "
            (nth hashes 1)
            " two\n"
            "pick "
            (nth hashes 2)
            " one\n"
            "pick "
            (first hashes)
            " three\n"))
        (let (r (gt-git dir
                  ["-c"
                    (str "sequence.editor=cp " todo)
                    "-c"
                    "core.editor=true"
                    "rebase"
                    "-i"
                    "linearbase"]))
          (assert= (:exit r) 0)
          (assert= (gt-subjects dir "linearbase..HEAD") (list "three" "one" "two"))))))
  (test "fixup melds a commit into the one before it, keeping the earlier message"
    (let (dir (gt-linear "irebase-fixup")
          todo (path/join dir ".git" "plan")
          hashes (map (gitsection/git-log-commits dir ["linearbase..HEAD"]) :hash))
      (do
        (file/spit todo
          (str "pick "
            (nth hashes 2)
            " one\n"
            "fixup "
            (nth hashes 1)
            " two\n"
            "pick "
            (first hashes)
            " three\n"))
        (let (r (gt-git dir
                  ["-c"
                    (str "sequence.editor=cp " todo)
                    "-c"
                    "core.editor=true"
                    "rebase"
                    "-i"
                    "linearbase"]))
          (assert= (:exit r) 0)
          ;; two is gone as a commit, but its file is in one's tree
          (assert= (gt-subjects dir "linearbase..HEAD") (list "three" "one"))
          (is (file/exists? (path/join dir "two.txt"))))))))

(describe "git: the sequencer's exception — bisect spells its steps differently"
  (test "a rebase uses --abort"
    (assert= (gitsequence/git-sequence-argv {:kind :rebase :verb "rebase"} "abort")
      ["rebase" "--abort"]))
  (test "a merge uses --continue"
    (assert= (gitsequence/git-sequence-argv {:kind :merge :verb "merge"} "continue")
      ["merge" "--continue"]))
  (test "a bisect stops with `bisect reset`, not `bisect --abort`, which is an error"
    (assert= (gitsequence/git-sequence-argv {:kind :bisect :verb "bisect"} "abort")
      ["bisect" "reset"]))
  (test "a bisect skips with `bisect skip`"
    (assert= (gitsequence/git-sequence-argv {:kind :bisect :verb "bisect"} "skip")
      ["bisect" "skip"]))
  (test "and has nothing to continue — you answer good or bad instead"
    (assert= (gitsequence/git-sequence-argv {:kind :bisect :verb "bisect"} "continue") nil))
  (test "a real bisect is detected as one"
    (let (dir (gt-linear "bisect"))
      (do
        (gt-git dir ["bisect" "start" "HEAD" "linearbase"])
        (assert= (:kind (gitcore/git-sequencer dir)) :bisect)
        (gt-git dir ["bisect" "reset"])
        (assert= (gitcore/git-sequencer dir) nil)))))

;; ---- the porcelain's edges (issues G1/G2/G3/G6) ------------------------------------

(defn- gt-fresh (name)
  "An empty repo (no commits) in a temp dir."
  (let (dir (path/temp (str "bedit-git-edge-" name "-")))
    (do
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})
      (file/mkdir dir)
      (gt-git dir ["init" "-q" "-b" "trunk"])
      (gt-git dir ["config" "user.email" "t@example.com"])
      (gt-git dir ["config" "user.name" "Test"])
      (gt-git dir ["config" "commit.gpgsign" "false"])
      dir)))

(describe "git: hunks, renames, the unborn branch"
  (test "a context line that starts with @@ after its indent does not start a hunk"
    (let (diff "diff --git a/c.rb b/c.rb\n--- a/c.rb\n+++ b/c.rb\n@@ -1,3 +1,3 @@\n class C\n-  x = 1\n+  x = 2\n   @@count = 0\n"
          parsed (first (diff/parse-unified diff)))
      (assert= (count (:hunks parsed)) 1)))
  (test "a rename keeps its source path"
    (let (es (gitcore/git-entries (str "R  new.txt"
                                    (string/int->char 0)
                                    "old.txt"
                                    (string/int->char 0))))
      (assert= (count es) 1)
      (assert= (:path (first es)) "new.txt")
      (assert= (:orig-path (first es)) "old.txt")))
  (test "before the first commit: the branch has its name, and unstage works"
    (let (dir (gt-fresh "unborn"))
      (file/spit (path/join dir "a.txt") "a\n")
      (gt-git dir ["add" "a.txt"])
      (assert= (gitcore/git-branch dir) "trunk")
      (is (not (gitcore/git-born? dir)))
      (assert= (:exit (gt-git dir (gitcore/git-unstage-args dir ["a.txt"]))) 0)
      (assert= (string/trim (:stdout (gt-git dir ["status" "--porcelain"]))) "?? a.txt")))
  (test "unstaging a staged rename takes both halves out of the index"
    (let (dir (gt-fresh "rename"))
      (file/spit (path/join dir "old.txt") "x\n")
      (gt-git dir ["add" "old.txt"])
      (gt-git dir ["commit" "-qm" "one"])
      (gt-git dir ["mv" "old.txt" "new.txt"])
      (assert= (:exit (gt-git dir (gitcore/git-unstage-args dir ["new.txt" "old.txt"]))) 0)
      ;; nothing staged any more: the delete of old.txt went with the add of new.txt
      (assert= (string/trim (:stdout (gt-git dir ["diff" "--cached" "--name-only"]))) ""))))

(describe "git: what the editor reads by itself never writes the index"
  ;; a file whose mtime moved but whose text did not is what makes `git status` / `git
  ;; diff` refresh the index and write it back under index.lock — the moment the user's
  ;; own `git commit` collides with it. The mode line asks on the idle beat, the status
  ;; buffer refreshes after the background fetch, a view refreshes on `g`.
  (test "the mode-line summary, the status collection and a view's diff leave .git/index alone"
    (let (dir (gt-fresh "locks")
          index-sum (fn () (:stdout (os/cmd "cksum" [(path/join dir ".git/index")])))
          stat-only (fn (year)
                      ;; a time early in `year` (365-day years), by brood's file/set-mtime — no `touch`
                      (file/set-mtime (path/join dir "same.txt") (* (- year 1970) 31536000000))))
      (file/spit (path/join dir "same.txt") "same\n")
      (file/spit (path/join dir "edited.txt") "before\n")
      (gt-git dir ["add" "."])
      (gt-git dir ["commit" "-qm" "one"])
      (file/spit (path/join dir "edited.txt") "after\n")
      (stat-only 2001)
      (let (before (index-sum)
            summary (git-summary dir)
            collected (git-collect-status {:root dir
                                           :open [[:unstaged "edited.txt"] [:unstaged "same.txt"]]})
            viewed (gitview/gv-git dir ["diff" "--no-color" "--no-ext-diff"]))
        (assert= (index-sum) before)
        ;; and every answer is the true one: only the edited file differs
        (assert= (:unstaged summary) 1)
        (assert= (vec (keys (map/get-in collected [:diffs :unstaged]))) ["edited.txt"])
        (is (includes? (:stdout viewed) "+after"))
        (refute (includes? (:stdout viewed) "same.txt")))
      ;; the fixture can see a write: a plain `git diff` does write it
      (stat-only 2002)
      (let (before (index-sum))
        (gt-git dir ["diff"])
        (refute (= (index-sum) before))))))

(describe "project files: -z and deleted files (issue G6)"
  (test "a non-ASCII name is listed as it is; a deleted tracked file is not listed"
    (let (dir (gt-fresh "ls"))
      (file/spit (path/join dir "café.md") "x\n")
      (file/spit (path/join dir "gone.txt") "x\n")
      (gt-git dir ["add" "."])
      (gt-git dir ["commit" "-qm" "one"])
      (file/rm (path/join dir "gone.txt"))
      (let (files (projects/project-files dir))
        (is (includes? files "café.md"))
        (is (not (includes? files "gone.txt")))))))

(describe "git: discarding a staged change (issue G2)"
  (test "a staged hunk goes from the index and the work tree at once"
    (let (dir (gt-fresh "discard"))
      (file/spit (path/join dir "f.txt") "one\n")
      (gt-git dir ["add" "f.txt"])
      (gt-git dir ["commit" "-qm" "one"])
      (file/spit (path/join dir "f.txt") "two\n")
      (gt-git dir ["add" "f.txt"])
      (let (patch (:stdout (gt-git dir ["diff" "--cached"]))
            r (gitcore/git-apply-hunk dir patch :index true))
        (assert= (:exit r) 0)
        (assert= (file/slurp (path/join dir "f.txt")) "one\n")
        (assert= (string/trim (:stdout (gt-git dir ["status" "--porcelain"]))) "")))))

(describe "git: the views' trees are pure"
  (test "refs: local branches starred, a group per remote in name order, then tags"
    (let (ref (fn (full name hash upstream head? subject)
                {:full full :name name :hash hash :upstream upstream :head? head? :subject subject})
          refs [(ref "refs/remotes/upstream/main" "upstream/main" "c3" "" false "theirs")
                 (ref "refs/heads/main" "main" "a1" "origin/main" true "work")
                 (ref "refs/tags/v1" "v1" "a1" "" false "work")
                 (ref "refs/remotes/origin/a-long-branch"
                   "origin/a-long-branch" "b2" "" false "wip")
                 (ref "refs/heads/side" "side" "b2" "" false "wip")]
          r (section-render (gitview/gv-refs-tree refs) {}))
      (assert= (:lines r)
        ["Branches (2)"
          "* main                 a1 [origin/main] work" "  side                 b2 wip" ""
          "Remote origin (1)" "  origin/a-long-branch b2 wip" "" "Remote upstream (1)"
          "  upstream/main        c3 theirs" "" "Tags (1)" "  v1                   a1 work" ""])
      (assert= (map (seq/filter (:rows r) (fn (x) (and x (= (:type x) :ref))))
                 (fn (x) (:kind (:value x))))
        (list :local :local :remote :remote :tag))))
  (test "refs: no refs at all is an empty tree, not empty groups"
    (assert= (:lines (section-render (gitview/gv-refs-tree []) {})) [])))

(describe "git: the log, as Magit's"
  ;; The log used to bake author and age into the line at a GUESSED pane width, so a long
  ;; subject pushed them off the edge, and printed git's raw `(HEAD -> master, tag: …,
  ;; origin/HEAD)` in one colour. Magit's: labels each in its own face, who-and-when in a
  ;; right margin at the window's edge, the graph drawn.
  (test "a commit line is graph, hash, labels and subject; a bare graph line is plain text"
    (let (commits [{:graph "* "
                    :hash "abc1234"
                    :refs "HEAD -> refs/heads/main"
                    :subject "fix"
                    :author "Ann"
                    :date "2 days ago"}
                    {:graph "|\\"}
                    {:graph "| * "
                     :hash "def5678"
                     :refs ""
                     :subject "a subject"
                     :author "Bo"
                     :date "1 year ago"}]
          r (section-render (gitview/gv-log-tree commits "Commits in main") {}))
      (assert= (:lines r) ["Commits in main" "* abc1234 main fix" "|\\" "| * def5678 a subject"])))
  (test "labels drop HEAD ->, tag: and a remote's HEAD, and say what each ref is"
    (let (labels (git-ref-labels (str "HEAD -> refs/heads/master, tag: refs/tags/2026.10.23.1, "
                                   "refs/remotes/origin/master, refs/remotes/origin/HEAD, "
                                   "refs/heads/feat/x")))
      (assert= (map labels first) (list "master" "2026.10.23.1" "origin/master" "feat/x"))
      (assert= (map labels second)
        (list git-face-branch-current git-face-tag git-face-branch-remote git-face-branch-local))))
  (test "each label is coloured on its own, after the hash"
    (let (value {:hash "abc1234" :refs "HEAD -> refs/heads/main, refs/remotes/origin/main"}
          line "abc1234 main origin/main fix")
      (assert= (git-section-faces {:type :commit :heading? true :value value} line)
        (list [0 7 git-face-hash] [8 12 git-face-branch-current] [13 24 git-face-branch-remote]))))
  (test "the log menu starts with --graph on, as Magit's does"
    (let (m (transient/ed-transient-open (model/ed-init (editor/buffer/make-buffer ""))
              git/git-log-transient))
      (is (map/get-in m [:transient :args "--graph"]))))
  (test "the margin is the author padded to a column, then the age without `ago`"
    (let (margin (git-section-margin {:type :commit
                                      :heading? true
                                      :value {:author "An Author With A Long Name"
                                              :date "3 weeks ago"}}))
      (assert= (map margin first) (list "An Author With A … " "3 weeks")))
    (is (nil? (git-section-margin {:type :log :heading? false :value nil}))))
  (test "a log buffer keeps the margin beside its text, and the view paints it at the edge"
    (let (root (gt-linear "logmargin")
          m (gitview/git-show-log (model/ed-init (editor/buffer/make-buffer "")) root [] "git log")
          buf (model/ed-current-buf m)
          margin (:right-margin buf)
          ops (view/ed-view m 100 20)
          author-ops (seq/filter ops
                       (fn (op) (and (= (first op) :text) (= (nth op 4 nil) git-face-author)))))
      (is (not (nil? margin)))
      ;; the heading is line 0; the first commit, line 1, has its margin
      (is (contains? (:lines margin) 1))
      (is (not (empty? author-ops)))
      ;; the author is painted right of every line's text, in the pane's last columns
      (is (every? author-ops (fn (op) (> (nth op 2) 60))))))
  (test "ends in a newline, so the bottom is column 0 and never scrolls sideways"
    (let (root (gt-linear "logbottom")
          m (gitview/git-show-log (model/ed-init (editor/buffer/make-buffer "")) root [] "git log")
          bottom (model/ed-apply m editor/buffer/end-of-buffer)
          buf (model/ed-current-buf bottom))
      (is (string/ends-with? (editor/buffer/buffer-text buf) "\n"))
      (assert= 0 (editor/buffer/buffer-column buf)))))

(describe "git: the upstream segment's tooltip"
  (test "says what there is to pull and to push, in that order"
    (assert= (:tooltip (gitbar/git-sync-mark {:behind "2" :ahead "1"})) "2 to pull, 1 to push")
    (assert= (:tooltip (gitbar/git-sync-mark {:behind "0" :ahead "1"})) "1 to push")
    (assert= (:tooltip (gitbar/git-sync-mark {:behind "3" :ahead "0"})) "3 to pull")
    (is (nil? (gitbar/git-sync-mark {:behind "0" :ahead "0"})))))

(describe "git: a file's state word"
  (test "by its list and its status letters, Magit's words, the raw letters otherwise"
    (let (label (fn (xy section)
                  (gitsection/git-entry-label {:x (string/substring xy 0 1)
                                               :y (string/substring xy 1 2)}
                    section)))
      (assert= (map ["UU" "AA" "DD" "AU" "UA" "DU" "UD" "XY"] (fn (xy) (label xy :unmerged)))
        (list "both modified"
          "both added" "both deleted" "added by us" "added by them" "deleted by us"
          "deleted by them" "unmerged"))
      (assert= (label "??" :untracked) "untracked")
      (assert= (map ["M " "A " "D " "R " "C " "T " "X "] (fn (xy) (label xy :staged)))
        (list "modified" "new file" "deleted" "renamed" "copied" "typechange" "X "))
      (assert= (map [" M" " D" " T" " U" " X"] (fn (xy) (label xy :unstaged)))
        (list "modified" "deleted" "typechange" "conflict" " X")))))

(describe "git: a diff, as Magit and delta paint one"
  (test "an added line tinted across the pane, its code coloured, the changed word stronger"
    (let (dir (gt-repo "diffpaint")
          _ (do
              (file/spit (path/join dir "code.blsp") "(defn area (w h) (* w h))\n")
              (gt-git dir ["add" "-A"])
              (gt-git dir ["commit" "-qm" "area"])
              (file/spit (path/join dir "code.blsp") "(defn area (w h) (+ w h))\n")
              (gt-git dir ["commit" "-qam" "plus"]))
          m (gitview/git-show-revision (model/ed-init (editor/buffer/make-buffer ""))
              dir "HEAD" :here)
          buf (model/ed-current-buf m)
          lines (string/split (editor/buffer/buffer-text buf) "\n")
          added (index-of lines "+(defn area (w h) (+ w h))")
          removed (index-of lines "-(defn area (w h) (* w h))")
          heading (seq/index-where lines (fn (l) (string/starts-with? l "@@")))
          bands (:line-bands buf)
          bol (fn (i) (fold (take lines i) 0 (fn (n l) (+ n (string/length l) 1))))
          spans-on (fn (i)
                     (seq/filter (:face-spans buf)
                       (fn (span)
                         (and (>= (first span) (bol i))
                           (< (first span) (+ (bol i) (string/length (nth lines i ""))))))))
          ops (view/ed-view m 100 20))
      (is (>= added 0))
      (assert= vcsproc/vcs-face-add-band (get bands added))
      (assert= vcsproc/vcs-face-del-band (get bands removed))
      (assert= vcsproc/vcs-face-hunk-band (get bands heading))
      ;; the sign green, then more than one colour: the code's own
      (assert= [(bol added) (inc (bol added)) vcsproc/vcs-face-add] (first (spans-on added)))
      (is (> (count (seq/distinct (map (spans-on added) (fn (span) (nth span 2))))) 2))
      ;; the `+` that replaced the `*`, under the stronger tint
      (is (any? (spans-on added)
            (fn (span)
              (and (= (first span) (+ (bol added) 19))
                (= (:bg (nth span 2)) (:bg vcsproc/vcs-face-add-refine))))))
      ;; and the view paints the tint as a band across the text, not just behind the text
      (is (any? ops
            (fn (op)
              (and (= (first op) :rect) (= (last op) vcsproc/vcs-face-add-band) (> (nth op 3) 50))))))))

;; TAB redraws ONE section: its lines are spliced into the buffer, and whatever came after is
;; moved, not redrawn. The claim is that the splice leaves the buffer exactly as a whole
;; render of the same tree would — text, rows, extents, spans, bands and links alike.
(defn- gt-same-as-whole (m)
  "Whether the current section buffer reads exactly as a fresh whole render of its tree."
  (let (b (model/ed-current-buf m)
        whole (model/ed-current-buf (sectionbuf/sb-show m
                                      (editor/buffer/buffer-name b)
                                      (:section-tree b)
                                      (:type b)
                                      {:vis (:section-vis b)}))
        same (fn (k) (= (get b k) (get whole k))))
    (and (= (editor/buffer/buffer-text b) (editor/buffer/buffer-text whole))
      (vector? (:line-kinds b))
      (same :section-rows)
      (same :line-kinds) ; what a long line does (wrap/truncate) follows the splice too
      (same :section-extents)
      (same :face-spans)
      (same :line-bands)
      (same :line-links))))

(defn- gt-status-repo (name)
  "*git-status* over a repo with two modified files, `a.txt` above `b.txt`."
  (let (dir (path/temp (str "bedit-git-test-" name "-")))
    (do
      (os/cmd "rm" ["-rf" dir] {:cwd "/"})
      (file/mkdir dir)
      (gt-git dir ["init" "-q" "-b" "main"])
      (gt-git dir ["config" "user.email" "t@example.com"])
      (gt-git dir ["config" "user.name" "Test"])
      (gt-git dir ["config" "commit.gpgsign" "false"])
      (file/spit (path/join dir "a.txt") "one\ntwo\n")
      (file/spit (path/join dir "b.txt") "three\n")
      (gt-git dir ["add" "-A"])
      (gt-git dir ["commit" "-qm" "base"])
      (file/spit (path/join dir "a.txt") "ONE\ntwo\n")
      (file/spit (path/join dir "b.txt") "THREE\n")
      (gitstatus/git-show-status (model/ed-init (editor/buffer/make-buffer "")) dir nil :here))))

(defn- gt-tab-on (m path)
  "TAB on the unstaged file `path`."
  (let (rows (sectionbuf/sb-rows m)
        i (seq/index-where rows
            (fn (r) (and r (:heading? r) (= (:type r) :file) (= (:path (:value r)) path)))))
    (sectionbuf/sb-toggle (model/ed-apply m (fn (b) (pool/ed-goto-line b (inc i)))))))

(describe "git: TAB redraws one section, in place"
  (test "opening a file fetches that file alone and splices its hunks under it"
    (let (m (gt-tab-on (gt-status-repo "splice-open") "a.txt")
          b (model/ed-current-buf m)
          text (editor/buffer/buffer-text b)
          file-b (section-at (:section-tree b)
                   [[:status nil] [:unstaged nil] [:file "b.txt"]]))
      (is (includes? text "+ONE"))
      ;; the other file was not fetched: one `git diff -- a.txt`, not a whole refresh
      (is (not (includes? text "+THREE")))
      (is (:lazy? (:value file-b)))
      (is (gt-same-as-whole m))))
  (test "the file below keeps its link, moved down by the lines spliced in above it"
    (let (m (gt-tab-on (gt-status-repo "splice-links") "a.txt")
          rows (sectionbuf/sb-rows m)
          i (seq/index-where rows
              (fn (r) (and r (:heading? r) (= (:path (:value r)) "b.txt")))))
      (assert= "b.txt" (path/basename (:file (get (:line-links (model/ed-current-buf m)) i))))))
  (test "folding and opening again redraws from the tree, as a whole render would"
    (let (opened (gt-tab-on (gt-status-repo "splice-fold") "a.txt")
          folded (gt-tab-on opened "a.txt")
          again (gt-tab-on folded "a.txt"))
      (is (not (includes? (editor/buffer/buffer-text (model/ed-current-buf folded)) "+ONE")))
      (is (gt-same-as-whole folded))
      (is (gt-same-as-whole again))
      (assert= (editor/buffer/buffer-text (model/ed-current-buf opened))
        (editor/buffer/buffer-text (model/ed-current-buf again)))))
  (test "a fold paints from the buffer's cache: an unfold calls no faces service"
    (let (opened (gt-tab-on (gt-status-repo "splice-cache") "a.txt")
          folded (gt-tab-on opened "a.txt")
          cache (:section-paint (model/ed-current-buf folded)))
      ;; every line the open file showed is still in the cache once it is folded
      (is (every? (seq/reject (sectionbuf/sb-rows opened) nil?)
            (fn (row) (contains? cache (sectionbuf/paint-key row))))))))

(describe "git: what k runs to throw a change away"
  (test "a staged rename restores its old path and drops the new, in one restore"
    ;; `checkout HEAD -- NEW` fails: NEW is not in HEAD
    (assert= (gitstage/git-discard-file-args {:section :staged
                                              :x "R"
                                              :path "new.txt"
                                              :orig-path "old.txt"})
      ["restore" "--source=HEAD" "--staged" "--worktree" "--" "old.txt" "new.txt"]))
  (test "a staged new file is removed, any other staged change checked out from HEAD"
    (assert= (gitstage/git-discard-file-args {:section :staged :x "A" :path "n.txt"})
      ["rm" "-f" "--" "n.txt"])
    (assert= (gitstage/git-discard-file-args {:section :staged :x "M" :path "m.txt"})
      ["checkout" "HEAD" "--" "m.txt"])))
