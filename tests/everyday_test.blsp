;; The everyday Emacs tail that was missing: C-x C-b, M-/, M-! / M-|, C-x C-o,
;; sort-lines, delete-trailing-whitespace, M-=, C-x i.
(defmodule everyday-test
  (:use model)
  (:use input)
  (:use commands)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn type-str (m s) (press m (string/->list s)))
(defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))
(defn submit (m text)
  "Type `text` into the open minibuffer and press RET."
  (ed-update (assoc m
               :minibuffer
                 (assoc (:minibuffer m) :edit (ed-mb-set-text (:edit (:minibuffer m)) text)))
    :enter 80 24))

(describe "C-x C-b — the buffer list"
  (test "lists every buffer with its flags, and RET visits the one on the row"
    (let (m (type-str (m-of "hello") "!") ; *scratch*, modified
          listed (press m [:ctrl-x :ctrl-b])
          text (buffer-text (cur listed)))
      (assert= (buffer-name (cur listed)) "*Buffer List*")
      (is (includes? text "*scratch*"))
      (is (includes? text "*Messages*"))
      (is (includes? text "  *  *scratch*")) ; the modified flag
      ;; RET on the *Messages* row switches to it
      (let (row (or (seq/find (range (buffer-line-count (cur listed)))
                      (fn (l) (includes? (buffer-line-at (cur listed) l) "*Messages*")))
                  (error "no *Messages* row"))
            on-row (ed-set-buf listed
                     (goto-char (cur listed) (text/line->char (buffer-rope (cur listed)) row))))
        (assert= (buffer-name (cur (ed-update on-row :enter 80 24))) "*Messages*")))))

(describe "M-/ — dabbrev-expand"
  (test "expands to the nearest preceding word with the prefix; again cycles; then wraps"
    (let (m (cm "foobar fooquux foo" 18)
          e1 (ed-update m :alt-/ 80 24)
          e2 (ed-update e1 :alt-/ 80 24)
          e3 (ed-update e2 :alt-/ 80 24))
      (assert= (buffer-text (cur e1)) "foobar fooquux fooquux")
      (assert= (buffer-text (cur e2)) "foobar fooquux foobar")
      (assert= (buffer-text (cur e3)) "foobar fooquux foo") ; back to the prefix
      (is (includes? (:echo e3) "no further"))))
  (test "words after point count too, after the ones before; no match says so"
    (assert= (buffer-text (cur (ed-update (cm "ab abc" 2) :alt-/ 80 24))) "abc abc")
    (is (includes? (:echo (ed-update (cm "xyz q" 5) :alt-/ 80 24)) "no expansion"))))

(describe "M-! and M-| — shell commands"
  (test "M-! shows a one-line result in the echo area"
    (let (asked (press (m-of "") [:alt-!])
          done (submit asked "echo hi-there"))
      (assert= (:echo done) "hi-there")))
  (test "M-! puts a multi-line result in *Shell Command Output*"
    (let (done (submit (press (m-of "") [:alt-!]) "printf 'a\\nb\\n'"))
      (is (not (nil? (ed-buffer-index-by-name done "*Shell Command Output*"))))))
  (test "M-| pipes the region through the command; C-u M-| replaces it"
    (let (m (ed-set-buf (m-of "") (assoc (make-buffer "c\nb\na\n") :point 0 :mark 6))
          shown (submit (press m [:alt-|]) "sort")
          replaced (submit (press m [:ctrl-u :alt-|]) "sort"))
      (assert= (buffer-text (cur shown)) "c\nb\na\n") ; shown, not touched
      (assert= (buffer-text (cur replaced)) "a\nb\nc\n"))))

(describe "line utilities"
  (test "C-x C-o: a run of blank lines keeps one; an isolated one goes; after text they all go"
    (assert= (buffer-text (cur (press (cm "a\n\n\n\nb" 3) [:ctrl-x :ctrl-o]))) "a\n\nb")
    (assert= (buffer-text (cur (press (cm "a\n\nb" 2) [:ctrl-x :ctrl-o]))) "a\nb")
    (assert= (buffer-text (cur (press (cm "a\n\n\nb" 0) [:ctrl-x :ctrl-o]))) "a\nb"))
  (test "sort-lines sorts the region's lines, or the whole buffer"
    (assert= (buffer-text (cur (cmd-sort-lines (cm "c\nb\na" 0) nil))) "a\nb\nc")
    (let (m (ed-set-buf (m-of "") (assoc (make-buffer "z\nc\nb\na\n") :point 2 :mark 8)))
      (assert= (buffer-text (cur (cmd-sort-lines m nil))) "z\na\nb\nc\n")))
  (test "delete-trailing-whitespace strips spaces and tabs at line ends"
    (assert= (buffer-text (cur (cmd-delete-trailing-whitespace (cm "a  \nb\t\nc" 0) nil)))
      "a\nb\nc")
    (is (includes? (:echo (cmd-delete-trailing-whitespace (cm "clean\n" 0) nil)) "no trailing")))
  (test "M-= counts lines, words and characters of the buffer or the region"
    (assert= (:echo (press (cm "one two\nthree" 0) [:alt-=]))
      "Buffer has 2 lines, 3 words, and 13 characters")
    (let (m (ed-set-buf (m-of "") (assoc (make-buffer "one two\nthree") :point 0 :mark 7)))
      (is (string/starts-with? (:echo (press m [:alt-=])) "Region has 1 lines, 2 words"))))
  (test "C-x i inserts a file at point, leaving it as the region"
    (let (path (str (temp-dir "bedit-ins-") ".txt")
          _ (file/spit path "INSERTED")
          done (submit (press (cm "ab" 1) [:ctrl-x "i"]) path))
      (assert= (buffer-text (cur done)) "aINSERTEDb")
      (assert= (buffer-point (cur done)) 1)
      (assert= (buffer-mark (cur done)) 9))))
