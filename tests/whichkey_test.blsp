;; tests/whichkey_test.blsp — what the which-key panel lists for a pending prefix: a prefix key
;; as the `+name` its map was described with, and the keys under the headings their bindings
;; gave them (std's `keymap-describe` and `keymap-bind`'s group, brood ADR-745), laid out so a
;; heading never ends a column.

(defmodule whichkey-test
  (:use test)
  (:use whichkey)
  (:use editor/keymap :only [keymap-describe keymap-entries])
  (:use keyhelp :only [ed-cmd-label ed-key-groups])
  (:use keymaps :only [profile-keymap]))

(defn- cx-keymap () (get (profile-keymap :emacs) :ctrl-x))

(describe "the which-key panel's cells"
  (test "a prefix key shows its described +name, an undescribed one +prefix"
    (assert= (ed-cmd-label (get (cx-keymap) "p")) "+project")
    (assert= (ed-cmd-label (keymap-describe {"f" 'x/cmd-y} [] {:name "project"})) "+project")
    (assert= (ed-cmd-label {"f" 'x/cmd-y}) "+prefix")
    (assert= (ed-cmd-label 'commands/cmd-find-file) "find-file"))

  (test "C-x's keys come under the headings its bindings name, in order, the rest last"
    (let (headings (map (ed-key-groups (cx-keymap)) :title))
      (assert= (vec (take headings 3)) ["files" "buffers" "windows"])
      (is (not (includes? headings nil)))))

  (test "a key appears once, under its group"
    (let (groups (ed-key-groups (cx-keymap))
          labels (mapcat groups (fn (group) (map (:rows group) :key))))
      (assert= (count labels) (count (seq/distinct labels)))
      (assert= (count labels) (count (keymap-entries (cx-keymap))))
      (is (includes? (map (:rows (first groups)) :key) "C-f"))))

  (test "an undescribed prefix lists its keys flat and sorted, with no heading"
    (assert= (panel-groups {"b" 'x/cmd-b "a" 'x/cmd-a} 10)
      [{:title nil
        :rows [{:key "a" :text "a" :binding 'x/cmd-a :sequence ["a"]}
                {:key "b" :text "b" :binding 'x/cmd-b :sequence ["b"]}]}]))

  (test "a heading never sits alone at the bottom of a column, and leads its group"
    (let (rows 6
          panel {:groups (panel-groups (cx-keymap) rows) :layout :flow}
          columns (panel/panel-columns panel rows))
      (assert= (first (first columns)) [:heading "files"])
      (doseq (column columns)
        (is (not (= (first (last column)) :heading))))))

  (test "a panel too short for headings lists the keys flat"
    (let (groups (panel-groups (cx-keymap) 3))
      (assert= (count groups) 1)
      (is (nil? (:title (first groups)))))))

;; ---- C-x C-h: describe-prefix-bindings, grouped as the panel groups ------------------------

(defn- lines-of (text) (string/split text "\n"))

(defn- binding-lines (text)
  ;; the listing's key rows: every line that is not a title, a heading or blank
  (seq/reject (lines-of text)
    (fn (line)
      (or (= line "")
        (string/starts-with? line "Key bindings starting with")
        (string/starts-with? line "── ")))))

(defn- leaf-count (keymap)
  (count (editor/keymap/keymap-bindings keymap)))

(describe "C-x C-h lists the prefix's bindings under its group headings"
  (test "the headings come in the keymap's order, as the panel shows them"
    (let (text (prefix-bindings-text (cx-keymap) [:ctrl-x])
          headings (map (seq/filter (lines-of text) (fn (line) (string/starts-with? line "── ")))
                     (fn (line) (string/substring line 3 (count line))))
          panel (map (ed-key-groups (cx-keymap)) :title))
      (assert= (vec (take headings (count panel))) (vec panel))
      (is (< (index-of text "── files") (index-of text "── buffers") (index-of text "── windows")))))

  (test "a sub-prefix is listed as +name, its keys in a section of their own after"
    (let (text (prefix-bindings-text (cx-keymap) [:ctrl-x]))
      (is (any? (lines-of text)
            (fn (line)
              (and (string/starts-with? line "C-x p ") (string/ends-with? line "   +project")))))
      (is (includes? text "Key bindings starting with C-x p (+project):"))
      (is (< (index-of text "+project") (index-of text "Key bindings starting with C-x p")))))

  (test "every binding is listed once, the prefixes as +name rows"
    (let (rows (binding-lines (prefix-bindings-text (cx-keymap) [:ctrl-x]))
          keys (map rows (fn (line) (first (string/split line "   "))))
          prefixes (seq/filter rows (fn (line) (includes? line "   +"))))
      (assert= (count keys) (count (seq/distinct keys)))
      (assert= (- (count rows) (count prefixes)) (leaf-count (cx-keymap)))))

  (test "an ungrouped prefix lists its keys flat, under the title"
    (assert= (prefix-bindings-text {"b" 'x/cmd-b "a" 'x/cmd-a} [:ctrl-q])
      "Key bindings starting with C-q:\n\nC-q a   a\nC-q b   b\n")))
