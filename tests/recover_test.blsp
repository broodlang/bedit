;; Not losing work: the auto-save sidecars written private, offered back on a visit and
;; recovered by command (`recover`), the loop that dies saved and restarted (`lifeline`),
;; and a CRLF file written back with its own line endings.
(defmodule recover-test
  (:use testkit :only [cur]) ; the shared test helpers (tests/support)
  (:use autosave) ; the auto-save round and its timer
  (:use sidecar) ; sidecar paths, the recovery note
  (:use recover) ; recover-this-file / recover-session
  (:use lifeline) ; emergency-save! / supervise
  (:use model)
  (:use input)
  (:use pool)
  (:use-internals main) ; display-hangup — the save a lost display or a hang-up makes
  (:use editor/buffer)
  (:use editor/buffer-file)
  (:use editor/buffer-server)
  (:use editor/buffer-registry)
  (:use test))

(purge-stale-temp "bedit-recover-")

(defn- fixture-file (text)
  "A fresh file holding `text` in its own temp directory; its path."
  (let (dir (temp-dir "bedit-recover-")
        _ (file/mkdir dir)
        path (path/join dir "notes.txt"))
    (do (file/spit path text) path)))

(defn- mode-bits (path) (math/mod (:mode (file/stat path)) 512))

(defn- share-edited (registry name text meta)
  "A buffer process in `registry` for `name` / `meta` whose text was TYPED — `text` inserted
into an empty buffer, so it is modified, as an edit in the editor leaves it. Its pid, once
the edit has landed (`buffer-sync` is the barrier)."
  (let (proc (registry-share registry name "" meta))
    (do
      (buffer-edit proc (fn (b) (insert b text)))
      (buffer-sync proc buffer-text 2000)
      proc)))

;; 0600. Windows has no mode bits (`file/stat`'s `:mode` is 0 there): brood's
;; `file/spit-private` gives the sidecar a protected DACL of one entry, the current user's
;; (KI-365, fixed) — read back with `icacls`: one entry, that user's, none inherited.
(defn- windows-owner-only? (path)
  (let (listing (os/cmd-out (os/cmd "icacls" [(string/replace path "/" "\\")]))
        entries (seq/filter (string/split listing "\n") (fn (line) (includes? line ":(")))
        entry (string/lower (or (first entries) "")))
    (and (= (count entries) 1)
      (includes? entry (string/lower (or (os/user-name) "?")))
      (not (includes? entry "(i)")))))

(defn- owner-only? (path)
  (if (= (os/type) :windows) (windows-owner-only? path) (= (mode-bits path) 384)))

(describe "auto-save sidecars are private, and say when they are worth recovering"
  (test "a sidecar is written owner-only, whatever the umask gives a plain write"
    (let (path (fixture-file "secret\n")
          m (ed-update (ed-init (find-file-buffer path)) "x" 80 24))
      (ed-auto-save-write (:due (ed-auto-save-due m)))
      (is (owner-only? (ed-auto-save-path path)))
      (assert= (file/slurp (ed-auto-save-path path)) "xsecret\n")))
  (test "a sidecar newer than its file is noted on a visit; one older than it is not"
    (let (path (fixture-file "v1\n")
          sidecar (ed-auto-save-path path))
      (assert= (ed-recovery-note path) nil)
      (file/spit sidecar "unsaved\n")
      ;; the file older than its sidecar: the session that wrote the sidecar never saved
      ;; (brood's `file/set-mtime`: no `touch`, which a Windows desktop does not have)
      (file/set-mtime path 1577836800000)
      (is (includes? (ed-recovery-note path) "M-x recover-this-file"))
      (is (includes? (:echo (ed-find-file (ed-init (make-buffer "")) path)) "recover-this-file"))
      ;; saved since: the sidecar is stale
      (file/set-mtime sidecar 1546300800000)
      (assert= (ed-recovery-note path) nil)))
  (test "the auto-save timer is armed while something is unwritten, and not after the round"
    (let (path (fixture-file "t\n")
          m (ed-update (ed-init (find-file-buffer path)) "x" 80 24))
      (is (int? (:after (ed-auto-save-timer m))))
      (assert= (ed-auto-save-timer (ed-auto-save! (assoc m :auto-saved-at 0))) nil)
      (assert= (ed-auto-save-timer (ed-init (find-file-buffer path))) nil)
      (ed-remove-auto-save path))))

(describe "M-x recover-this-file"
  (test "asks, then puts the sidecar's text back as one undoable edit"
    (let (path (fixture-file "on disk\n")
          _ (file/spit (ed-auto-save-path path) "recovered text\n")
          m (ed-init (find-file-buffer path))
          asked (cmd-recover-this-file m nil)
          done (ed-update asked "y" 80 24))
      (is (includes? (:echo asked) "Recover notes.txt"))
      (assert= (buffer-text (cur done)) "recovered text\n")
      (is (buffer-modified? (cur done)))
      (assert= (buffer-text (undo (cur done))) "on disk\n")))
  (test "n leaves the buffer alone; no sidecar says so"
    (let (path (fixture-file "on disk\n")
          m (ed-init (find-file-buffer path)))
      (is (includes? (:echo (cmd-recover-this-file m nil)) "no auto-save data"))
      (file/spit (ed-auto-save-path path) "other\n")
      (assert= (buffer-text (cur (ed-update (cmd-recover-this-file m nil) "n" 80 24))) "on disk\n")))
  (test "recover-session offers the open files with newer auto-save data"
    (let (path (fixture-file "on disk\n")
          _ (file/spit (ed-auto-save-path path) "newer\n")
          _ (file/set-mtime path 1577836800000)
          m (ed-init (find-file-buffer path)))
      (is (includes? (ed-recoverable-files m) path)))))

(describe "a loop that dies is saved and restarted"
  (test "emergency-save! writes a sidecar for each buffer process whose text the file lacks"
    (let (changed (fixture-file "old\n")
          same (fixture-file "same\n")
          registry (registry-start)
          _ (share-edited registry "changed" "new\n" {:file changed})
          _ (share-edited registry "same" "same\n" {:file same})
          _ (registry-share registry "*scratch*" "no file" {})
          saved (emergency-save! registry))
      (assert= saved [changed])
      (assert= (file/slurp (ed-auto-save-path changed)) "new\n")
      (is (owner-only? (ed-auto-save-path changed)))
      (refute (file/exists? (ed-auto-save-path same)))
      (registry-stop registry)))
  ;; brood ADR-631: a window whose compositor or X server dies is sent [:hangup :display-lost],
  ;; and the loop's :on-hangup is the terminal's
  (test "a lost display saves every unsaved buffer as a hang-up does, and says so"
    (let (changed (fixture-file "old\n")
          registry (registry-start)
          _ (share-edited registry "changed" "new\n" {:file changed}))
      (main/display-hangup {:buffer-reg registry} :display-lost nil)
      (assert= (file/slurp (ed-auto-save-path changed)) "new\n")
      (registry-stop registry))
    (assert= (main/hangup-note :display-lost ["/a" "/b"])
      "bedit: lost its display; auto-saved 2 unsaved file(s)")
    (assert= (main/hangup-note :hup []) "bedit: hung up; auto-saved 0 unsaved file(s)"))
  (test "a CRLF file's buffer process is compared with the file's decoded text"
    (let (path (fixture-file "a\r\nb\r\n")
          registry (registry-start)
          _ (registry-share registry "crlf" "a\nb\n" {:file path :eol :crlf}))
      (assert= (emergency-save! registry) [])
      (registry-stop registry)))
  (test "an unmodified buffer never gets a sidecar — a root file it cannot read included"
    (let (base (temp-dir "bedit-recover-base-")
          path (fixture-file "root:secret-hash:19000::::::\n")
          registry (registry-start))
      (binding (*config-base* base)
        (do
          ;; looked at through sudo, never edited; the user cannot read the file itself
          (registry-share registry
            "shadow"
            "root:secret-hash:19000::::::\n"
            {:file path :sudo true})
          ;; no chmod on Windows: there the file stays readable, and still gets no sidecar
          (when (not (= (os/type) :windows)) (os/cmd "chmod" ["000" path]))
          (let (saved (emergency-save! registry))
            (do
              (when (not (= (os/type) :windows)) (os/cmd "chmod" ["600" path]))
              (assert= saved [])
              (refute (file/exists? (ed-auto-save-path path true)))))
          (registry-stop registry)
          (file/rmdir base)))))
  (test "supervise restarts a loop that raised, after saving, and returns when one quits"
    (let (path (fixture-file "old\n")
          registry (registry-start)
          _ (share-edited registry "notes.txt" "unsaved\n" {:file path})
          test-process (self)
          outcome (supervise (fn (supervisor)
                               (do
                                 (announce! supervisor nil registry {:gui true})
                                 (error "the loop broke")))
                    (fn (_supervisor state)
                      ;; the restarted loop sees what the dead one announced, then quits
                      (send test-process [:restarted (:live state)]))
                    ;; called in the supervising process — this one
                    (fn (death) (send test-process [:death death])))
          death (receive ([:death d] d) (after 2000 {})))
      (assert= outcome :quit)
      (assert= (receive ([:restarted live] live) (after 2000 :never)) {:gui true})
      (assert= (:saved death) [path])
      (is (:restarting? death))
      (assert= (file/slurp (ed-auto-save-path path)) "unsaved\n")
      (registry-stop registry)))
  (test "told to end, supervise saves, ends a stuck loop and gives the signal back"
    (let (path (fixture-file "old\n")
          registry (registry-start)
          _ (share-edited registry "notes.txt" "unsaved\n" {:file path})
          test-process (self)
          _worker (spawn
                    (fn ()
                      (send test-process
                        [:outcome
                          (supervise
                            (fn (supervisor)
                              (do
                                (announce! supervisor nil registry {})
                                (send test-process [:loop (self) supervisor])
                                ;; a loop stuck in a turn never reads its mail
                                (receive (:never-sent nil))))
                            (fn (_supervisor _state) (error "a signal must not restart"))
                            (fn (death) (send test-process [:death death])))])))
          [loop-process supervisor] (receive ([:loop pid owner] [pid owner]) (after 2000 [nil nil]))
          probe (monitor loop-process))
      (do
        (send supervisor [:signal :term])
        (assert= (receive ([:outcome outcome] outcome) (after 4000 :never)) [:signal :term])
        (assert= (receive ([:down ^probe _ _] :ended) (after 2000 :alive)) :ended)
        (let (death (receive ([:death d] d) (after 2000 {})))
          (assert= (:signal death) :term)
          (assert= (:saved death) [path])
          (refute (:restarting? death)))
        (assert= (file/slurp (ed-auto-save-path path)) "unsaved\n")
        (registry-stop registry))))
  (test "a signal's exit status is the one a shell reports"
    (assert= (signal-exit-code :term) 143)
    (assert= (signal-exit-code :hup) 129)
    (assert= (signal-exit-code :int) 130))
  ;; Isolated: the keeper registers the runtime-wide name `:lifeline-keeper`, and so does
  ;; remote_test's; run together, each test's registries reached the other's keeper.
  :isolated (test "a daemon's keeper saves every live session and forgets a finished one"
    (let (first-path (fixture-file "old\n")
          second-path (fixture-file "old\n")
          first-registry (registry-start)
          second-registry (registry-start)
          finished (registry-start)
          _ (share-edited first-registry "a.txt" "one\n" {:file first-path})
          _ (share-edited second-registry "b.txt" "two\n" {:file second-path})
          test-process (self)
          keeper (start-keeper (fn (sig saved) (send test-process [:kept sig saved]))))
      (do
        (keep-registry first-registry)
        (keep-registry second-registry)
        (keep-registry second-registry)
        (keep-registry finished)
        (registry-stop finished)
        (send keeper [:signal :hup])
        (let ([sig saved] (receive ([:kept s paths] [s paths]) (after 6000 [nil nil])))
          (assert= sig :hup)
          (assert= (sort saved) (sort [first-path second-path])))
        (assert= (file/slurp (ed-auto-save-path second-path)) "two\n")
        (registry-stop first-registry)
        (registry-stop second-registry))))
  (test "outside a daemon a registry has no keeper to go to"
    (assert= (keep-registry (self)) nil))
  (test "a loop that keeps dying is let go"
    (let (registry (registry-start)
          outcome (supervise (fn (supervisor)
                               (do (announce! supervisor nil registry {}) (error "boom")))
                    (fn (_supervisor _state) (error "boom again"))))
      (assert= outcome :died)
      (registry-stop registry)))
  (test "restart-allowed? counts only the deaths inside the window"
    (is (restart-allowed? [] 0))
    (refute (restart-allowed? [1 2 3] 10))
    (is (restart-allowed? [1 2] 10))))

(describe "a save keeps the file it wrote"
  ;; a Unix fact: Windows has no mode bits, and `ln -s` there may copy
  (when (not (= (os/type) :windows))
    (test "its mode, and a symlink as a symlink"
      (let (path (fixture-file "old\n")
            link (str path ".link"))
        (os/cmd "chmod" ["751" path])
        (os/cmd "ln" ["-s" path link])
        (let (m (ed-find-file (ed-init (make-buffer "")) link))
          (file-save/ed-save-buf-at (ed-update m "x" 80 24)
            (or (ed-buffer-index-by-file m link) (error "the visited link is not in the pool"))))
        (is (:symlink? (file/stat link)))
        (assert= (file/slurp path) "xold\n")
        (assert= (mode-bits path) 489)))))

(describe "a CRLF file keeps its line endings"
  (test "visited, edited and saved, it is written with CRLF again"
    (let (path (fixture-file "one\r\ntwo\r\n")
          m (ed-find-file (ed-init (make-buffer "")) path))
      (assert= (buffer-text (cur m)) "one\ntwo\n")
      (assert= (buffer-eol (cur m)) :crlf)
      (file-save/ed-save-buf-at (ed-update m "x" 80 24)
        (or (ed-buffer-index-by-file m path) (error "the visited file is not in the pool")))
      (assert= (file/slurp path) "xone\r\ntwo\r\n"))))

(describe "a file with a byte-order mark keeps it, off the text (Emacs's utf-8-with-signature)"
  (test "visited, the mark is not in the buffer; saved, it is written back"
    (let (path (fixture-file "\u{feff}one\ntwo\n")
          m (ed-find-file (ed-init (make-buffer "")) path))
      (assert= (buffer-text (cur m)) "one\ntwo\n")
      (is (buffer-bom? (cur m)))
      (is (not (buffer-modified? (cur m))))
      (file-save/ed-save-buf-at (ed-update m "x" 80 24)
        (or (ed-buffer-index-by-file m path) (error "the visited file is not in the pool")))
      (assert= (file/slurp path) "\u{feff}xone\ntwo\n")))
  (test "a buffer process holding the text without the mark has nothing unsaved"
    (let (path (fixture-file "\u{feff}a\nb\n")
          registry (registry-start)
          _ (registry-share registry "bom" "a\nb\n" {:file path :bom true}))
      (assert= (emergency-save! registry) [])
      (registry-stop registry))))

;; A sidecar that could not be written was a log line nobody saw, and the round still counted it
;; written — so it was not tried again until the text changed. The writer tells the loop now.
(describe "a failed auto-save is said, and tried again"
  (test "the writer reports a sidecar it could not write to the loop it was given"
    ;; under a FILE, so its sidecar's directory cannot exist on any OS — a drive-less
    ;; `/nonexistent/…` is not absolute on Windows, and its sidecar went somewhere writable
    (let (path (path/join (fixture-file "a file, not a directory") "notes.txt"))
      (ed-auto-save-write {path (text/string-> "unsaved")} {} (self) #{})
      (let (event (receive ([:auto-save-failed failed reason] [failed reason]) (after 2000 nil)))
        (assert= (first event) path)
        (is (string? (second event))))))

  (test "the loop says it once, counts the path unwritten, and says when it works again"
    (let (path "/somewhere/notes.txt"
          m (assoc (ed-init (make-buffer "")) :auto-saved {path :a-rope})
          failed (ed-ev-auto-save-failed m [:auto-save-failed path "Permission denied"] 24 80 24)
          again (ed-ev-auto-save-failed (assoc failed :echo "")
                  [:auto-save-failed path "Permission denied"]
                  24
                  80
                  24)
          back (ed-ev-auto-save-ok again [:auto-save-ok path] 24 80 24))
      (is (includes? (:echo failed) "auto-save of /somewhere/notes.txt failed: Permission denied"))
      (is (includes? (:echo failed) "only in the editor"))
      (assert= (get (:auto-saved failed) path) nil)
      ;; the second failure of the same file is not said again
      (assert= (:echo again) "")
      (is (includes? (:echo back) "works again"))
      (refute (contains? (:auto-save-failing back) path)))))

;; A killed buffer's text is given up, so its sidecar goes with it — on every kill path. Only
;; C-x k removed it; C-x p k and the other kills left it to offer the text back on each visit.
(describe "a killed buffer leaves no sidecar"
  (test "killing a modified file buffer by name (C-x p k's path) removes its sidecar"
    (let (dir (temp-dir "bedit-killsidecar-")
          _ (file/mkdir dir)
          path (path/join dir "notes.txt")
          _ (file/spit path "on disk")
          m (ed-init (insert (make-buffer "" "notes.txt" path) "unsaved"))
          _ (ed-auto-save-write {path (buffer-rope (ed-current-buf m))})
          sidecar (ed-auto-save-path path))
      (is (file/exists? sidecar))
      (ed-kill-buffer-named m "notes.txt")
      (refute (file/exists? sidecar)))))
