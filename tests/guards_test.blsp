;; Guards for the moves a refactor makes. A key names its command by quoted symbol and a mode
;; names its services the same way, so moving a function leaves the symbol stale with no
;; compiler to say so: `keymap-run` catches the error and the key is simply dead. And a
;; guest's session is a security boundary: a move must not widen or narrow it silently.
(defmodule guards-test
  (:use test)
  (:use guest)
  (:use model)
  (:use interactive)
  (:use keymaps))

(defn- named-symbols (value)
  "Every qualified symbol anywhere inside `value`, a layer or keymap: maps, vectors, lists."
  (cond
    (symbol? value) (if (includes? (->string value) "/") [value] [])
    (map? value) (mapcat (dissoc value :name) (fn ([_ inner]) (named-symbols inner)))
    (or (vector? value) (list? value)) (mapcat value named-symbols)
    else []))

(defn- layer-value (ref)
  "The layer map `ref` names (a layer may be its map already)."
  (if (symbol? ref) (reflect/eval ref) ref))

(defn- registered-layers ()
  "Every layer a buffer type or the system list binds."
  (let (typed (mapcat editor/layers/*type-layers* (fn ([_ refs]) (vec refs))))
    (map (seq/distinct (append typed editor/layers/*system-layers*)) layer-value)))

(defn- keymap-and-mode-symbols ()
  "Every symbol the profiles' keymaps and the registered modes name."
  (seq/distinct (append (mapcat [:emacs :vim]
                          (fn (profile)
                            (vec (editor/keymap/keymap-commands (profile-keymap profile)))))
                  (mapcat (registered-layers) named-symbols))))

(defn- unbound-symbols () (seq/reject (keymap-and-mode-symbols) bound?))

(describe "a quoted symbol still names something"
  (test "every declared command trait names a command"
    (let (declared (map (keys (registry/entries :interactive/traits)) (fn ([_ command]) command)))
      (is (> (count declared) 200))
      (assert= (vec (seq/reject (seq/filter declared symbol?) bound?)) [])))
  (test "the walk sees the keymaps and the modes"
    (is (> (count (keymap-and-mode-symbols)) 500)))
  (test "every keymap and mode symbol is bound"
    (assert= (vec (unbound-symbols)) [])))

;; A module's top-level forms run when it loads, so a call there into another project module
;; is a load-time dependency, and only a `:use` (direct or through the modules it `:use`s)
;; loads the callee first. Named only by its qualified symbol, nothing orders the load:
;; `dired` claimed its buffer type through `modes/register-special-type` before `modes` had
;; declared where types go, so the type landed in a plain registry and a Dired buffer opened
;; editable whenever `dired` happened to load first (tests/dired_test.blsp run alone).
(defn- module-source (module) (file/slurp (str "src/" module ".blsp")))

(defn- project-modules ()
  (into #{}
    (map (seq/filter (file/list-files "src") (fn (f) (string/ends-with? f ".blsp")))
      (fn (f) (string/replace f ".blsp" "")))))

(defn- used-modules (text modules)
  "The project modules `text`'s `(:use …)` / `(:use-internals …)` clauses name."
  (into #{}
    (seq/keep (regex/find-all text "\\(:use(?:-internals)? ([a-z][a-z0-9/-]*)")
      (fn (found)
        (let (name (:text (first (:groups found)))) (when (contains? modules name) name))))))

(defn- top-level-callees (text modules)
  "The project modules a line of `text` starting with `(module/…` calls: a top-level form."
  (seq/distinct (seq/keep (string/split text "\n")
                  (fn (line)
                    (let (found (regex/find line "^\\(([a-z][a-z0-9-]*)/"))
                      (when found
                        (let (name (:text (first (:groups found))))
                          (when (contains? modules name) name))))))))

(defn- reach (graph seen pending)
  (if (empty? pending)
    seen
    (let (next (first pending))
      (if (contains? seen next)
        (reach graph seen (rest pending))
        (reach graph (conj seen next) (append (rest pending) (vec (get graph next #{}))))))))

(defn- loaded-before (graph module)
  "Every module `module`'s `:use`s load, directly or through theirs."
  (reach graph #{} (vec (get graph module #{}))))

(defn- unordered-load-calls ()
  "`[module callee]` for each top-level call into a project module nothing loads first."
  (let (modules (project-modules)
        sources (into {} (map modules (fn (module) [module (module-source module)])))
        graph (into {} (map sources (fn ([module text]) [module (used-modules text modules)]))))
    (vec (mapcat (sort (vec modules))
           (fn (module)
             (let (before (loaded-before graph module))
               (seq/keep (top-level-callees (get sources module) modules)
                 (fn (callee)
                   (when (and (not (= callee module)) (not (contains? before callee)))
                     [module callee])))))))))

(describe "a load-time call loads what it calls"
  (test "the walk sees the modules and their uses"
    (is (> (count (project-modules)) 100))
    (is (contains? (used-modules (module-source "dired") (project-modules)) "modes")))
  (test "a top-level call into another project module is loaded before it"
    (assert= (unordered-load-calls) [])))

(def- allowed-file "tests/guest_allowed.txt")

(defn- snapshot-lines ()
  (seq/reject (string/split (file/slurp allowed-file) "\n") string/blank?))

(defn- command-tail (command) (last (string/split (->string command) "/")))

(defn- allowed-keys ()
  "`key:` plus the tail of every command a profile or mode keymap binds that a guest may run."
  (let (bound (seq/distinct (append (mapcat [:emacs :vim]
                                      (fn (profile)
                                        (vec (editor/keymap/keymap-commands (profile-keymap profile)))))
                              (mapcat (registered-layers)
                                (fn (layer)
                                  (vec (editor/keymap/keymap-commands (:keymap layer {}))))))))
    (map (seq/filter bound ed-guest-allows?) (fn (command) (str "key:" (command-tail command))))))

(defn- allowed-names ()
  "`name:` plus every M-x command a guest may run."
  (map (seq/filter (command-names) ed-guest-allows-name?) (fn (name) (str "name:" name))))

(defn- allowed-now () (sort (seq/distinct (append (allowed-names) (allowed-keys)))))

(describe "a guest's session runs exactly what it ran"
  (test "the allowed set is the snapshot"
    ;; tests/guest_allowed.txt is the set by M-x name and by key command. A move that drops a
    ;; line refuses a guest what it could do; a line that appears is a capability a guest
    ;; gained. Adding one is a security decision, made here on purpose or not at all.
    (let (now (allowed-now)
          snapshot (snapshot-lines))
      (assert= (vec (seq/reject now (fn (line) (includes? snapshot line)))) [])
      (assert= (vec (seq/reject snapshot (fn (line) (includes? now line)))) [])))
  (test "what reaches past the session stays refused"
    (each ["find-file"
            "write-file" "insert-file" "shell-command" "project-find-file" "reload-config"
            "git-status" "execute-extended-command-nonsense"]
      (fn (name) (is (not (ed-guest-allows-name? name)))))))
