;; The eval-the-Lisp-I'm-editing core (the C-x C-e family) — `src/eval-command.blsp`.
;; Moved here from brood `std/` (it's the editor's policy, not language). The kernel
;; `read-all` primitive these build on is tested in brood (tests/read_all_test.blsp).
;;
;; We test the two functions the editor actually drives: `last-sexp-source` (pure
;; form extraction from text + point) and `eval-source` (reflect/eval a source string,
;; capturing value + output). The editor reads the form on its own process and hands
;; the string to a spawned evaluator, so the across-processes test mirrors the live
;; path most closely.

(defmodule eval-command-test
  (:use test)
  (:use eval-command))

(describe "last-sexp-source — the last complete form ending at or before point"
  (test "returns that form's source"
    (assert= (last-sexp-source "(+ 1 2)" 7) "(+ 1 2)"))

  (test "respects point — the last form *before* point, not after it"
    ;; point 7 sits just after the first form; the second is past point.
    (assert= (last-sexp-source "(+ 1 2) (* 9 9)" 7) "(+ 1 2)"))

  (test "nil when there's no complete form before point"
    (is (nil? (last-sexp-source "" 0))))

  (test "nil when the prefix up to point doesn't parse"
    (is (nil? (last-sexp-source "(+ 1 " 5)))))

(describe "eval-source — eval a source string; value + captured output"
  (test "the value comes back as `=> <form>`"
    (assert= (eval-source "(+ 1 2)") "=> 3"))

  (test "every form runs in order; the last value wins"
    (assert= (eval-source "(+ 1 1) (* 5 5)") "=> 25"))

  (test "captured output from the form is prefixed before the value"
    (assert= (eval-source "(do (io/write \"hi\") 7)") "hi\n=> 7"))

  (test "output across several forms is all captured"
    (assert= (eval-source "(io/write \"a\") (io/write \"b\") 0") "ab\n=> 0"))

  (test "an unbalanced form is reported, not raised"
    (is (string/starts-with? (eval-source "(+ 1 ") "error:")))

  (test "a throw from the form comes back as a clean error message"
    (is (string/starts-with? (eval-source "(throw \"boom\")") "error:"))))

;; ---- the session's compile context ------------------------------------------

(describe "eval-source — a defmodule in one evaluation governs the next"
  (test "one form per spawned evaluator still builds a module, imports included"
    ;; Each `C-x C-e` runs in a fresh process, and the compile context is per process:
    ;; this used to echo `=> probe-fn` (bare) for the second form and
    ;; `error: unbound symbol: evalcmd-probe/probe-fn` for the third.
    (let (in-fresh-process (fn (src)
                             (let (me (self))
                               (spawn (send me [:evalcmd (eval-source src)]))
                               (receive ([:evalcmd r] r)))))
      (in-fresh-process "(defmodule evalcmd-probe (:use test))")
      (assert= (in-fresh-process "(defn probe-fn (x) (assert= x x) x)") "=> evalcmd-probe/probe-fn")
      (assert= (in-fresh-process "(evalcmd-probe/probe-fn 41)") "=> 41")
      ;; and a return to root sticks
      (in-fresh-process "(%in-ns nil)")
      (assert= (in-fresh-process "(reflect/current-ns)") "=> nil"))))

;; ---- across processes -------------------------------------------------------
;; The editor evaluates in a spawned process (so a looping form can't freeze the
;; loop); a rope/buffer can't cross a process, only the source string can. A worker
;; evaluates a string and sends back only the message — proving the eval and the
;; inherited output capture work off the root process, exactly as the editor uses it.
(defn ec-worker (parent src) (send parent (eval-source src)))

(describe "eval-source across processes"
  :isolated (test "a spawned evaluator's message string crosses back unchanged"
    (let (me (self))
      (spawn (ec-worker me "(* 7 8)"))
      (assert= (receive) "=> 56")))
  (test "output captured in a spawned evaluator rides along"
    (let (me (self))
      (spawn (ec-worker me "(do (io/write \"P\") 1)"))
      (assert= (receive) "P\n=> 1"))))
