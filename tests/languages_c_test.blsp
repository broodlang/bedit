;; C (src/languages/c.blsp): a `deflanguage` over tree-sitter-c, whose spec C++ extends.
;; The mode half needs no grammar; the parsed half needs the grammar (`testkit/load-test-grammar`)
;; and SKIPS without it.
(defmodule languages-c-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model faced? indents]))

(describe "c, the mode"
  (test "a .c and a .h file open in c mode, formatted by clang-format"
    (doseq (file ["main.c" "main.h"])
      (let (buf (cur (file-model "" file)))
        (assert= (ed-buf-mode-name buf) "c")
        (assert= (first (model/ed-mode-service buf :format-command)) "clang-format")))))

(describe "c's fontify restart"
  (test "a block comment closed above cuts at the item after it"
    (let (src "/** doc */\nint b(void) {\n    return 2;\n}\n")
      (assert= (languages/c/c-restart src (index-of src "    return")) (index-of src "int b"))))
  (test "one still open across the candidate line declines"
    (let (src "/*\nint x;\nint b(void) {\n    return 2;\n")
      (assert= (languages/c/c-restart src (index-of src "    return")) 0))))

(def c-src
  "#include <stdio.h>\n\nstruct point {\n    int x;\n    double y;\n};\n\nstatic int area(const struct point *p, int scale) {\n    int values[] = {\n        1,\n        2,\n    };\n    switch (scale) {\n    case 1:\n        return p->x;\n    default:\n        break;\n    }\n    if (p == NULL) {\n        printf(\"none %c\\n\", 'x');\n    }\n    return values[0] * 3;\n}\n")

(when (testkit/load-test-grammar :c)
  (describe "c, parsed"
    (test "it colours — a string, a number, a type"
      (let (spans (languages/c/c-fontify c-src))
        (is (faced? spans :syntax/string))
        (is (faced? spans :syntax/number))
        (is (faced? spans :syntax/special))))
    (test "#include is a keyword, though the grammar leaves it anonymous"
      (assert= (first (languages/c/c-fontify c-src)) [0 8 (editor/face/face :syntax/keyword)]))
    (test "it indents every line, `case` at the switch's level"
      (let ([got want] (indents c-src "main.c"))
        (assert= got want)))
    (test "C-M-a inside a function lands on it"
      (assert= (editor/treesit/point-defun-start c-src :c (index-of c-src "switch (scale)"))
        (index-of c-src "static int area")))))
