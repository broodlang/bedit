;; TSX (src/languages/tsx.blsp): TypeScript's spec over tree-sitter-typescript's `tsx` grammar.
;; The mode half needs no grammar; the parsed half needs the grammar (`testkit/load-test-grammar`)
;; and SKIPS without it.
(defmodule languages-tsx-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model faced? indents]))

(describe "tsx, the mode"
  (test "a .tsx file opens in tsx mode, formatted by prettier"
    (let (buf (cur (file-model "" "app.tsx")))
      (assert= (ed-buf-mode-name buf) "tsx")
      (assert= (first (model/ed-mode-service buf :format-command)) "prettier")))
  (test "it declares where its grammar lives, for M-x grammar-install"
    (assert= (dissoc (model/grammar-source :tsx) :revision :fingerprint)
      {:url "https://github.com/tree-sitter/tree-sitter-typescript" :subdir "tsx"})))

(def tsx-src
  "interface Props {\n  title: string;\n}\n\nexport function App(props: Props) {\n  return (\n    <div className=\"app\">\n      <span>{props.title}</span>\n    </div>\n  );\n}\n")

(when (testkit/load-test-grammar :tsx)
  (describe "tsx, parsed"
    (test "types colour, and a JSX closing tag leaves its element"
      (is (faced? (languages/tsx/tsx-fontify tsx-src) :syntax/special))
      (let ([got want] (indents tsx-src "app.tsx"))
        (assert= got want)))))
