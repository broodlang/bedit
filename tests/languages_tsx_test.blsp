;; TSX (src/languages/tsx.blsp): TypeScript's spec over tree-sitter-typescript's `tsx` grammar.
;; Its parsed sample is the corpus's, tests/corpus/tsx/; what is here needs no grammar.
(defmodule languages-tsx-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model]))

(describe "tsx, the mode"
  (test "tsx mode formats with prettier"
    (let (buf (cur (file-model "" "app.tsx")))
      (assert= (first (model/ed-mode-service buf :format-command)) "prettier")))
  (test "it declares where its grammar lives, for M-x grammar-install"
    (assert= (dissoc (grammarfallback/grammar-source :tsx) :revision :fingerprint)
      {:url "https://github.com/tree-sitter/tree-sitter-typescript" :subdir "tsx"})))

;; The sample, tests/corpus/tsx/Counter.tsx (prettier), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart.
