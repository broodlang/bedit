;; The held tree-sitter tree (brood ADR-443): a tree-sitter buffer's highlighting comes from
;; the document's own parse, updated incrementally per edit, instead of a sliced window
;; parsed from scratch. A handle is freed only when a turn commits
;; (`ed-release-dropped-trees`), so a test that checks a handle is gone releases first.
(defmodule syntaxtree-test
  (:use model)
  (:use-internals spancache)
  (:use-internals mouse)
  (:use-internals panes)
  (:use pool)
  (:use main)
  (:use-internals syntaxtree)
  (:use treewarm)
  (:use editor/buffer)
  (:use test))

(defn ruby-model (text) (ed-init (make-buffer text "x.rb" "x.rb")))
(defn big-ruby (n) (string/join (map (range n) (fn (i) (str "def f" i "\n  " i "\nend"))) "\n"))
(defn refreshed (m) (ed-refresh-spans m 80 24))
(defn band-of (m)
  (get (:span-cache m) (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))))
(defn edited-at (m position text)
  (ed-set-buf m (insert (goto-char (ed-current-buf m) position) text)))
(defn has-span? (spans from to)
  (any? spans (fn (span) (and (= (nth span 0) from) (= (nth span 1) to)))))

(describe "syntaxtree: the services a held tree is coloured with"
  (test "a deflanguage mode names its face table and language"
    (let (buf (ed-current-buf (ruby-model "def f\nend\n")))
      (assert= (ed-mode-service buf :ts-lang) :ruby)
      (is (map? (ed-mode-service buf :ts-faces)))))

  (test "a lexer-only mode has no face table, so it keeps the slice path"
    (let (m (refreshed (ed-init (make-buffer "A=1\n" ".env" ".env"))))
      (is (nil? (ed-mode-service (ed-current-buf m) :ts-faces)))
      (is (nil? (syntax-tree-entry m 0))))))

(describe "syntaxtree: a tree per buffer, kept across edits"
  (test "the first refresh opens the shown buffer's tree and colours the band from it"
    (let (m (refreshed (ruby-model "def f\nend\n"))
          entry (syntax-tree-entry m 0)
          band (band-of m))
      (is (not (nil? entry)))
      (is (= (:rope entry) (buffer-rope (ed-current-buf m))))
      (assert= (:lang entry) :ruby)
      (is (:tree? band))
      (is (has-span? (:spans band) 0 3))))

  (test "an edit updates the tree from the old one, and the committed turn frees the old handle"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          old (syntax-tree-entry m0 0)
          m1 (refreshed (edited-at m0 0 "x = 1\n"))
          new (syntax-tree-entry m1 0))
      (is (= (:rope new) (buffer-rope (ed-current-buf m1))))
      (is (= (:from-rope new) (:rope old)))
      (is (vector? (:changes new)))
      ;; not freed until the turn commits
      (is (not (nil? (tree-changed-ranges (:tree old)))))
      (ed-release-dropped-trees m0 m1)
      (is (nil? (tree-changed-ranges (:tree old))))
      (is (not (nil? (tree-changed-ranges (:tree new)))))
      ;; the def moved down six chars and is still coloured, in absolute offsets
      (is (has-span? (:spans (band-of m1)) 6 9))))

  (test "a turn rolled back to the model before it frees nothing that model names"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          tree (:tree (syntax-tree-entry m0 0)))
      (ed-release-dropped-trees m0 m0)
      (is (not (nil? (tree-changed-ranges tree))))))

  (test "an edit far below the band keeps its spans and re-stamps its rope"
    (let (m0 (refreshed (ruby-model (big-ruby 300)))
          band0 (band-of m0)
          end (buffer-length (ed-current-buf m0))
          ;; point stays at the top, so the viewport does not follow the edit
          m1 (refreshed (ed-set-buf m0
                          (goto-char (insert (goto-char (ed-current-buf m0) end) "\nx = 1") 0)))
          band1 (band-of m1))
      (is (= (:spans band1) (:spans band0)))
      (is (= (:rope band1) (buffer-rope (ed-current-buf m1))))))

  (test "an edit inside the band re-colours it from the updated tree"
    (let (m1 (refreshed (edited-at (refreshed (ruby-model (big-ruby 300))) 0 "x = 1\n"))
          band (band-of m1))
      (is (:tree? band))
      (is (= (:rope band) (buffer-rope (ed-current-buf m1))))
      (is (has-span? (:spans band) 6 9))))

  (test "a band nothing colours is an empty band, not a gone handle"
    (let (m (refreshed (ruby-model "\n\n\n")))
      (is (:tree? (band-of m)))
      (assert= (:spans (band-of m)) [])))

  ;; a gone handle counts as none: a small buffer reopens its tree (a large one waits for
  ;; the warm, below) rather than sitting on the slice path until its rope moves
  (test "a gone handle in a small buffer is reopened"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          gone (:tree (syntax-tree-entry m0 0))
          _ (tree-free gone)
          m1 (refreshed (assoc m0 :span-cache {}))
          band (band-of m1))
      (is (not (= (:tree (syntax-tree-entry m1 0)) gone)))
      (is (:tree? band))
      (is (has-span? (:spans band) 0 3))))

  (test "a buffer too large to parse on the loop waits for the warm"
    (binding (*tree-open-max* 10)
      (let (m (refreshed (ruby-model "def f\nend\ndef g\nend\n")))
        (is (nil? (syntax-tree-entry m 0)))
        (is (has-span? (:spans (band-of m)) 0 3))))))

(describe "syntaxtree: a tree's lifetime follows its buffer"
  (test "dropping a pool slot frees its tree on commit and shifts the ones above it down"
    (let (trees (map (range 3)
                  (fn (i) (tree-open (text/string-> (str "def f" i "\nend\n")) :ruby)))
          m0 (fold (range 3)
               (ruby-model "")
               (fn (acc i) (install-syntax-tree acc i (nth trees i) nil :ruby)))
          m1 (ed-release-dropped-trees m0 (ed-drop-slot m0 1)))
      (assert= (vec (sort (keys (:syntax-trees m1)))) [0 1])
      (is (nil? (tree-changed-ranges (nth trees 1))))
      (is (= (:tree (syntax-tree-entry m1 1)) (nth trees 2)))
      (is (= (:tree (syntax-tree-entry m1 0)) (nth trees 0)))))

  (test "a warm in flight follows the pool shift, and aims at nothing when its buffer is killed"
    (let (warming (fn (index killed)
                    (:tree-warm-index (ed-drop-slot (assoc (ruby-model "") :tree-warm-index index)
                                        killed))))
      (assert= (warming 2 1) 1)
      (assert= (warming 0 1) 0)
      (is (nil? (warming 1 1)))))

  (test "killing a buffer frees its tree once the turn commits"
    ;; the second buffer is not on screen, so its tree is installed by hand, as a warm would
    (let (opened (ed-open-buffer (ruby-model "def f\nend\n")
                   (make-buffer "def g\nend\n" "y.rb" "y.rb"))
          tree (tree-open (text/string-> "def g\nend\n") :ruby)
          m0 (install-syntax-tree opened 1 tree nil :ruby)
          m1 (ed-release-dropped-trees m0 (ed-kill-buffer-at m0 1)))
      (is (not (nil? tree)))
      (is (nil? (syntax-tree-entry m1 1)))
      (is (nil? (tree-changed-ranges tree)))))

  (test "a warm's tree is installed for its slot, or freed when the slot has one"
    (let (m0 (ruby-model "def f\nend\n")
          rope (buffer-rope (ed-current-buf m0))
          warmed (tree-open rope :ruby)
          ;; the reply is the tree alone — a rope cannot cross a message — and the rope and
          ;; language it was launched over wait in the model
          launched (fn (m) (assoc m :tree-warm-index 0 :tree-warm-rope rope :tree-warm-lang :ruby))
          m1 (treewarm/ed-apply-tree-warm (launched m0) {:tree warmed})
          spare (tree-open rope :ruby)
          m2 (treewarm/ed-apply-tree-warm (launched m1) {:tree spare}))
      (is (= (:tree (syntax-tree-entry m1 0)) warmed))
      (is (= (:rope (syntax-tree-entry m1 0)) rope))
      (assert= (:lang (syntax-tree-entry m1 0)) :ruby)
      (is (nil? (:tree-warm-rope m1)))
      (is (= (:tree (syntax-tree-entry m2 0)) warmed))
      (is (nil? (tree-changed-ranges spare)))
      (is (nil? (:tree-warm-index m2))))))

;; The update is TOLD what changed, from the buffer's own splice log, so the kernel does not
;; compare the old rope with the new one to find it. Several edits in one turn are several
;; splices, each against the text the one before it left.
(describe "syntaxtree: the edits an update is told"
  (test "one splice per edit, oldest first, in the kernel's [start old-end new-end] shape"
    (let (buf (ed-current-buf (ruby-model "def f\nend\n"))
          typed (insert (goto-char buf 0) "x = 1\n")
          ;; a second edit away from the first, so no splice log merges the two
          again (insert (goto-char typed 9) "zz"))
      (assert= (syntaxtree/splice-edits (buffer-rope buf) typed) [[0 0 6]])
      (assert= (syntaxtree/splice-edits (buffer-rope buf) again) [[0 0 6] [9 9 11]])
      ;; the same text, or a change the log cannot account for: nil — the kernel compares
      (is (nil? (syntaxtree/splice-edits (buffer-rope typed) typed)))
      (is (nil? (syntaxtree/splice-edits (buffer-rope (make-buffer "other")) typed)))))

  (test "a tree updated through several edits colours as a fresh parse of the result does"
    (let (m0 (refreshed (ruby-model (big-ruby 20)))
          buf (ed-current-buf m0)
          ;; two edits in one turn, the second inside the first's text
          twice (insert (goto-char (insert (goto-char buf 0) "x = 1\n") 4) "22")
          m1 (refreshed (ed-set-buf m0 twice))
          entry (syntax-tree-entry m1 0)
          fresh (tree-open (buffer-rope twice) :ruby)
          faces (ed-mode-service twice :ts-faces)
          length (buffer-length twice))
      (assert= (buffer-text twice) (str "x = 221\n" (big-ruby 20)))
      (is (= (:from-rope entry) (buffer-rope buf)))
      (assert= (tree-spans (:tree entry) faces 0 length) (tree-spans fresh faces 0 length))
      (tree-free fresh))))

;; The structural queries read the held tree (brood ADR-467) — but only one parsed from the
;; very text they are asked about, and a gone handle falls back to parsing that text.
(describe "syntaxtree: the structural queries are handed the held tree"
  (test "a tree is handed over only for its own rope and language"
    (let (m (refreshed (ruby-model "def f\nend\n"))
          entry (syntax-tree-entry m 0)
          buf (ed-current-buf m))
      (is (= (held-tree-for entry buf :ruby) (:tree entry)))
      (is (nil? (held-tree-for entry buf :elixir)))
      (is (nil? (held-tree-for entry (insert (goto-char buf 0) "x") :ruby)))
      (is (nil? (held-tree-for nil buf :ruby)))))

  (test "C-M-f and TAB answer the same over the held tree, and after it is gone"
    (let (m (refreshed (ruby-model "def f\n1\nend\ndef g\nend\n"))
          entry (syntax-tree-entry m 0)
          moved (buffer-point (ed-current-buf (structural/cmd-forward-sexp m nil)))
          indented (indent/ed-indent-target (goto-char (ed-current-buf m) 6) entry))
      (is (not (nil? (:tree entry))))
      (assert= moved 11)
      (assert= indented 2)
      (tree-free (:tree entry))
      (is (not (tree-alive? (:tree entry))))
      (assert= (buffer-point (ed-current-buf (structural/cmd-forward-sexp m nil))) moved)
      (assert= (indent/ed-indent-target (goto-char (ed-current-buf m) 6) entry) indented))))

(describe "treewarm: a warm is for a buffer with no tree, never per edit"
  (test "due while a large buffer has none; not once it has one, however it is edited"
    (binding (*tree-open-max* 10)
      (let (m (ruby-model "def f\nend\ndef g\nend\n")
            rope (buffer-rope (ed-current-buf m))
            held (install-syntax-tree m 0 (tree-open rope :ruby) rope :ruby))
        (is (ed-tree-warm-stale? m))
        (is (not (ed-tree-warm-stale? (assoc m :tree-warm-proc :running))))
        (is (not (ed-tree-warm-stale? held)))
        (is (not (ed-tree-warm-stale? (edited-at held 0 "x = 1\n")))))))
  (test "the tree a warm opens outlives its task: it is handed to the editor before the reply"
    ;; a handle is its opener's and dies with it (brood ADR-495); run as a loop would
    (binding (*tree-open-max* 10 editor/ui/*loop* (self))
      (let (m (ed-launch-tree-warm (ruby-model "def f\nend\ndef g\nend\n"))
            job (:tree-warm-proc m)
            reply (receive ([:task-done ^job value] value) (after 5000 :timeout))
            warmed (ed-apply-tree-warm m reply)
            tree (:tree (syntax-tree-entry warmed 0)))
        (is (not (nil? job)))
        (is (tree-alive? tree))
        (tree-free tree)))))

;; An edit that then asks the tree about what it just changed — RET's indent, each line of a
;; region reindent after the first — follows the held tree to the edited text (one incremental
;; update) instead of the indenter parsing the document, and hands the model that tree.
(describe "syntaxtree: an edit that indents follows the held tree"
  (test "RET indents as a text parse does, and the refresh keeps the tree RET left"
    (let (m (refreshed (ruby-model "def f\n1\nend\n"))
          before (syntax-tree-entry m 0)
          before-one (ed-set-buf m (goto-char (ed-current-buf m) 6))
          returned (indent/cmd-newline-and-indent before-one nil)
          buf (ed-current-buf returned)
          entry (syntax-tree-entry returned 0)
          by-text (indent/ed-indent-target (insert (goto-char (ed-current-buf m) 6) "\n")))
      (assert= by-text 2)
      (assert= (buffer-text buf) "def f\n\n  1\nend\n")
      (assert= (buffer-point buf) 9)
      ;; the entry is current for the edited text, on a new handle, and the refresh keeps it
      (is (= (:rope entry) (buffer-rope buf)))
      (is (tree-alive? (:tree entry)))
      (is (not (= (:tree entry) (:tree before))))
      (is (= (:tree (syntax-tree-entry (refreshed returned) 0)) (:tree entry)))
      ;; the tree the command began with is the committed turn's to free
      (is (tree-alive? (:tree before)))
      (ed-release-dropped-trees m returned)
      (is (not (tree-alive? (:tree before))))
      (is (tree-alive? (:tree entry)))))

  (test "a region reindent over the followed tree answers as one over the text"
    (let (text "def f\n1\nif x\n2\nend\nend\n"
          region (fn (m)
                   (ed-set-buf m (assoc (ed-current-buf m) :mark 0 :point (string/length text))))
          held (refreshed (ruby-model text))
          over-tree (indent/cmd-indent-region (region held) nil)
          over-text (indent/cmd-indent-region (region (ruby-model text)) nil)
          entry (syntax-tree-entry over-tree 0))
      (is (nil? (syntax-tree-entry (ruby-model text) 0)))
      (assert= (buffer-text (ed-current-buf over-tree)) "def f\n  1\n  if x\n    2\n  end\nend\n")
      (assert= (buffer-text (ed-current-buf over-tree)) (buffer-text (ed-current-buf over-text)))
      (is (= (:rope entry) (buffer-rope (ed-current-buf over-tree))))
      (is (= (:tree (syntax-tree-entry (refreshed over-tree) 0)) (:tree entry))))))

;; A buffer past `*tree-sync-max*` is reparsed off the loop. These tests make a small one
;; count as large and run as a loop would (`editor/ui/*loop*` bound, so `ed-headless?` is false),
;; then hand each reply to the fold the way the dispatcher would.
(defn off-loop (thunk)
  (binding (*tree-sync-max* 10 editor/ui/*loop* (self)) (thunk)))
(defn landed (m)
  ;; the in-flight reparse's reply, folded in and refreshed — as its turn would be
  (let (job (:tree-reparse-proc m)
        reply (receive
                ([:task-done ^job value] value)
                (after 5000 :timeout)))
    (refreshed (ed-apply-tree-reparse m reply))))
(defn whole-spans (m tree)
  (let (buf (ed-current-buf m))
    (tree-spans tree (ed-mode-service buf :ts-faces) 0 (buffer-length buf))))

(describe "syntaxtree: a large buffer's tree is reparsed off the loop"
  (test "a burst of edits launches one reparse; the follow-up lands the latest text's tree"
    (off-loop
      (fn ()
        (let (m0 (refreshed (ruby-model (big-ruby 40)))
              base (:tree (syntax-tree-entry m0 0))
              m1 (refreshed (edited-at m0 0 "x"))
              first-job (:tree-reparse-proc m1)
              m2 (refreshed (edited-at m1 1 "y"))
              m3 (refreshed (edited-at m2 2 " = 1\n"))
              m4 (landed m3)
              m5 (landed m4)
              entry (syntax-tree-entry m5 0)
              fresh (tree-open (buffer-rope (ed-current-buf m5)) :ruby))
          (is (not (nil? first-job)))
          ;; the keys behind the first one queued nothing: the same job, the same old tree
          (is (= (:tree-reparse-proc m2) first-job))
          (is (= (:tree-reparse-proc m3) first-job))
          (is (= (:tree (syntax-tree-entry m3 0)) base))
          ;; the first landing was a text behind, so one follow-up went out from its tree
          (is (= (:rope (syntax-tree-entry m4 0)) (buffer-rope (ed-current-buf m1))))
          (is (not (nil? (:tree-reparse-proc m4))))
          (is (not (= (:tree-reparse-proc m4) first-job)))
          ;; and its landing is current, with nothing left in flight
          (is (= (:rope entry) (buffer-rope (ed-current-buf m5))))
          (is (nil? (:tree-reparse-proc m5)))
          (assert= (whole-spans m5 (:tree entry)) (whole-spans m5 fresh))
          (tree-free fresh)))))

  (test "a superseded tree is freed by the turn that lands its successor, not before"
    (off-loop
      (fn ()
        (let (m0 (refreshed (ruby-model (big-ruby 40)))
              base (:tree (syntax-tree-entry m0 0))
              m1 (refreshed (edited-at m0 0 "x"))
              m2 (refreshed (edited-at m1 1 "y")))
          ;; a turn while the reparse runs keeps the tree it reads from
          (ed-release-dropped-trees m1 m2)
          (is (tree-alive? base))
          (let (m3 (landed m2)
                middle (:tree (syntax-tree-entry m3 0)))
            (ed-release-dropped-trees m2 m3)
            (is (not (tree-alive? base)))
            (let (m4 (landed m3))
              (ed-release-dropped-trees m3 m4)
              (is (not (tree-alive? middle)))
              (is (tree-alive? (:tree (syntax-tree-entry m4 0))))))))))

  (test "while the tree is behind, the band's colours are carried past the edit"
    (off-loop
      (fn ()
        (let (m0 (refreshed (ruby-model (big-ruby 40)))
              m1 (refreshed (edited-at m0 0 "x = 1\n"))
              band (band-of m1)
              caught (landed m1))
          (is (has-span? (:spans (band-of m0)) 0 3))
          (is (not (nil? (:tree-reparse-proc m1))))
          ;; not dropped to a slice: the tree's own spans, six chars on
          (is (:shifted? band))
          (is (= (:rope band) (buffer-rope (ed-current-buf m1))))
          (is (has-span? (:spans band) 6 9))
          ;; once the tree lands it colours the band again
          (is (:tree? (band-of caught)))
          (is (not (:shifted? (band-of caught))))
          (is (has-span? (:spans (band-of caught)) 6 9))))))

  (test "a structural command on a behind tree answers as on a fresh one, catching it up once"
    (let (text "def f\n1\nend\ndef g\nend\n"
          by-text (buffer-point (ed-current-buf (structural/cmd-forward-sexp (ed-set-buf (ruby-model (str "x = 1\n"
                                                                                                       text))
                                                                               (goto-char (ed-current-buf (ruby-model (str "x = 1\n"
                                                                                                                        text)))
                                                                                 6))
                                                  nil))))
      (off-loop
        (fn ()
          (let (m1 (refreshed (edited-at (refreshed (ruby-model text)) 0 "x = 1\n"))
                base (:tree (syntax-tree-entry m1 0))
                moved (structural/cmd-forward-sexp m1 nil)
                entry (syntax-tree-entry moved 0))
            (assert= by-text 17)
            (assert= (buffer-point (ed-current-buf moved)) by-text)
            ;; caught up: the model holds a current tree, a new handle
            (is (= (:rope entry) (buffer-rope (ed-current-buf moved))))
            (is (not (= (:tree entry) base)))
            ;; and the reparse that was in flight lands on a tree no longer the buffer's
            (let (job (:tree-reparse-proc moved)
                  reply (receive
                          ([:task-done ^job value] value)
                          (after 5000 :timeout))
                  after (ed-apply-tree-reparse moved reply))
              (is (= (:tree (syntax-tree-entry after 0)) (:tree entry)))
              (is (not (tree-alive? (:tree reply))))))))))

  (test "headless, a large buffer is still updated on the loop"
    (binding (*tree-sync-max* 10)
      (let (m (refreshed (edited-at (refreshed (ruby-model (big-ruby 40))) 0 "x")))
        (is (nil? (:tree-reparse-proc m)))
        (is (= (:rope (syntax-tree-entry m 0)) (buffer-rope (ed-current-buf m)))))))

  (test "a reparse in flight follows the pool shift, and aims at nothing when its buffer is killed"
    (let (reparsing (fn (index killed)
                      (map/get-in (ed-drop-slot (assoc (ruby-model "") :tree-reparse {:index index})
                                    killed)
                        [:tree-reparse :index])))
      (assert= (reparsing 2 1) 1)
      (assert= (reparsing 0 1) 0)
      (is (nil? (reparsing 1 1))))))

;; A turn that opens a tree and throws is rolled back to a model that never named it, and no
;; kernel bound evicts it any more (brood ADR-495): the idle beat sweeps what the editor
;; process owns and the model does not name. A test runs in its own process, so what this
;; process owns is exactly what the test opened.
(describe "syntaxtree: the idle sweep frees what no turn will"
  (test "a tree a thrown turn opened is freed; the held one is kept"
    (let (m (refreshed (ruby-model "def f\nend\n"))
          held (:tree (syntax-tree-entry m 0))
          ;; the turn opens a tree, then throws: the model it rolls back to never named it
          rolled-back (check-allow :discarded-catch
                        (try
                          (do
                            (tree-open (buffer-rope (ed-current-buf m)) :ruby)
                            (error "the turn throws"))
                          (catch _ m))))
      (assert= (count (editor/treesit/owned-trees)) 2)
      (is (ed-tree-sweep-due? rolled-back))
      (let (swept (ed-run-idle-jobs rolled-back))
        (assert= (editor/treesit/owned-trees) [held])
        (is (not (ed-tree-sweep-due? swept)))
        (tree-free held))))
  (test "nothing is swept while a reparse or a warm is in flight"
    ;; its task may have handed the editor a tree its reply has not folded in yet
    (let (m (refreshed (ruby-model "def f\nend\n"))
          handed (tree-open (buffer-rope (ed-current-buf m)) :ruby))
      (each [:tree-reparse-proc :tree-warm-proc]
        (fn (slot)
          (let (flying (assoc m slot :running))
            (is (not (ed-tree-sweep-due? flying)))
            (ed-sweep-orphaned-trees flying)
            (is (tree-alive? handed)))))
      (ed-sweep-orphaned-trees m)
      (is (not (tree-alive? handed)))
      (tree-free (:tree (syntax-tree-entry m 0))))))
