;; What the window PAINTS, read from its pixels: bedit's real view for a model, painted
;; through brood's window painter into memory (`gui/render-frame`, brood ADR-609) at a
;; real window's size with bedit's own font, line height, inset and background.
;;
;; The frame tests elsewhere say which ops land on which row. Where those rows land on the
;; screen is the renderer's: a strip of window between the title bar and the header line
;; survived three fixes because nothing could look (brood ADR-508's 2026-11-05 addendum).
;; These look. Each one needs a GUI-built runtime; without one it checks nothing.
(defmodule window-paint-test
  (:use test)
  (:use minibuffer)
  (:use model)
  (:use editor/buffer)
  (:use theme)) ; the palette: the window background and the header line

(def- window-width 1000)
(def- window-height 600)

(defn- rgb (hex)
  "A theme colour `#rrggbb` as `[r g b]`."
  (vec (map [1 3 5] (fn (at) (string/->number (string/substring hex at (+ at 2)) 16)))))

(defn- spec (&optional (height window-height))
  "The window bedit opens, `height` pixels tall, as the renderer is told it: the init file's
default font, size and line height, startup's inset, the theme's background."
  {:width window-width
   :height height
   :font (config/setting {} :font)
   :size (config/setting {} :font-size)
   :line-height (config/setting {} :line-height)
   :inset startup/*inset*
   :bg *base*})

(def- source "def greet(name)\n  puts \"hello #{name}\"\nend\n")

(defn- painted (&optional (height window-height) (header-line true))
  "A file buffer, the header line on unless `header-line` is false, painted at the grid a
window `height` pixels tall holds — the grid the view's own seam op gives (brood ADR-610: no
header line, and the top takes the inset too): the frame's ops and the picture."
  (let (probe [[:clear] [:seam nil {:top-band header-line}]]
        grid (:grid (gui/render-frame probe (spec height)))
        buf (make-buffer source "greet.rb" (path/join (temp-dir "bedit-paint-") "greet.rb"))
        m (assoc (ed-init buf) :header-line header-line)
        ops (view/ed-view m (first grid) (second grid)))
    {:ops ops :image (gui/render-frame ops (spec height))}))

(defn- row-text (ops row needle)
  "The first `:text` op on `row` whose text includes `needle`."
  (seq/find ops
    (fn (op)
      (and (vector? op) (= (first op) :text) (= (nth op 1) row) (includes? (nth op 3) needle)))))

(defn- inked-rows (image x0 x1 y0 y1 background)
  "The pixel rows in [y0, y1) where some pixel of columns [x0, x1) is not `background`."
  (seq/filter (vec (range (math/floor y0) (math/floor y1)))
    (fn (y)
      (any? (vec (range (math/floor x0) (math/floor x1)))
        (fn (x) (not (= (gui/pixel image x y) background)))))))

(defn- band-end (image colour)
  "The first pixel row, going down from the top, that is not `colour` — read in the grid's
  last column, which the header line leaves blank (its text stops a cell short of the edge)."
  (let ([cell-w _] (:cell image)
        [cols _] (:grid image)
        x (+ (first (:origin image)) (* cell-w (dec cols)) (math/quot cell-w 2)))
    (letrec (walk (fn (y) (if (= (gui/pixel image x y) colour) (walk (inc y)) y)))
      (walk 0))))

(describe "the header line is the top of the window"
  (test "its background starts at y = 0 and is exactly one row tall"
    (when (gui/available?)
      (let ({:keys [image]} (painted)
            [_ cell-h] (:cell image)
            header (rgb (:bg headerline/face-header-line)))
        (assert= (band-end image header) cell-h))))

  (test "the file's name is centred in it: as much space above its ink as below"
    (when (gui/available?)
      (let ({:keys [ops image]} (painted)
            [cell-w _cell-h] (:cell image)
            [inset _] (:origin image)
            header (rgb (:bg headerline/face-header-line))
            name-op (row-text ops 0 "greet.rb")
            x0 (+ inset (* cell-w (nth name-op 2)))
            x1 (+ x0 (* cell-w (count (nth name-op 3))))
            top (band-end image header)
            inked (inked-rows image x0 x1 0 top header)
            above (or (first inked) 0)
            below (- top 1 (or (last inked) top)))
        (is (not (empty? inked)))
        ;; on failure the pair shows the space above the ink and below it, in pixels
        (assert= [above below (<= (math/abs (- above below)) 2)] [above below true]))))

  (test "the buffer's first line is painted on row 1, under the header"
    (when (gui/available?)
      (let ({:keys [ops image]} (painted)
            [cell-w cell-h] (:cell image)
            [inset _] (:origin image)
            line-op (row-text ops 1 "def")
            x0 (+ inset (* cell-w (nth line-op 2)))
            ;; `de`: the line below has spaces in those two columns, so all the ink is row 1's
            x1 (+ x0 (* cell-w 2))
            inked (inked-rows image x0 x1 cell-h (* 3 cell-h) (rgb *base*)))
        (is (not (nil? line-op)))
        (is (not (empty? inked)))
        (is (< (or (last inked) window-height) (* 2 cell-h)))))))

(describe "the inset"
  (test "is a margin on the left: no glyph's ink reaches into it"
    (when (gui/available?)
      (let ({:keys [image]} (painted)
            [inset origin-y] (:origin image))
        (assert= [inset origin-y] [startup/*inset* 0])
        ;; each pixel row of the margin is one colour — the window's, or a band bled across
        (is (every? (vec (range 0 window-height))
              (fn (y)
                (every? (vec (range 1 inset))
                  (fn (x) (= (gui/pixel image x y) (gui/pixel image 0 y))))))))))

  (test "is a margin below too: the last row ends exactly the inset short of the bottom"
    (when (gui/available?)
      (let ({:keys [image]} (painted))
        (assert= (last (:row-tops image)) (- window-height startup/*inset*))))))

(defn- last-column-x (image)
  "The middle of the grid's last column, which the mode line and the header line leave
blank (their text stops a cell short of the edge)."
  (let ([cell-w _] (:cell image)
        [cols _] (:grid image))
    (+ (first (:origin image)) (* cell-w (dec cols)) (math/quot cell-w 2))))

(defn- bottom-chrome (height header-line)
  "Where the bottom chrome lands in a window `height` pixels tall: the pixel row the mode
line's colour ends at, read up from the bottom in the last column, the row map's account of
the grid's top and the last row's end, and the view's seam op."
  (let ({:keys [ops image]} (painted height header-line)
        x (last-column-x image)
        modeline (rgb (:bg face-modeline))
        mode-end (letrec (walk (fn (y)
                                 (if (= (gui/pixel image x (dec y)) modeline) y (walk (dec y)))))
                   (walk height)))
    {:mode-end mode-end
     :grid-end (last (:row-tops image))
     :seam-op (seq/find ops (fn (op) (and (vector? op) (= (first op) :seam))))
     :cell-h (second (:cell image))
     :top (first (:row-tops image))}))

(describe "the bottom chrome is anchored to the window's bottom edge (brood ADR-610)"
  (test "at two heights 7 px apart the echo area ends exactly the inset above the bottom"
    (when (gui/available?)
      (doseq (header-line [true false])
        (doseq (height [600 607])
          (let ({:keys [mode-end grid-end cell-h]} (bottom-chrome height header-line)
                bottom (- height startup/*inset*))
            ;; on failure: which window, then where the grid and the mode line ended
            (assert= [height header-line grid-end mode-end]
              [height header-line bottom (- bottom cell-h)]))))))

  (test "the view names the bottom mode line as the seam, and row 0 a band only under a header"
    (when (gui/available?)
      (let (with-header (bottom-chrome 600 true)
            without (bottom-chrome 600 false))
        (assert= (nth (:seam-op with-header) 2) {:top-band true})
        (assert= (nth (:seam-op without) 2) {:top-band false})
        (assert= (:top with-header) 0)
        (assert= (:top without) startup/*inset*)))))

(describe "a floating card keeps its gap from the mode line, in pixels"
  ;; The 2026-11-05 screenshot: a transient's bottom edge drawn ON the mode line. The card is
  ;; placed by `ui-kit/ui-place`; here the picture says the row between them is the window's
  ;; own background across the card's width, and the card's last row is its surface.
  (test "the row above the mode line under an open transient is the window background"
    (when (gui/available?)
      (let (probe [[:clear] [:seam nil {:top-band false}]]
            grid (:grid (gui/render-frame probe (spec)))
            [cols rows] grid
            m (transient/ed-transient-open (assoc (ed-init (make-buffer source)) :gui true)
                {:name 'paint-menu
                 :title "Push"
                 :groups [{:title "Push to"
                           :suffixes [{:key "p"
                                       :kind :command
                                       :command 'motion/cmd-forward-char
                                       :label "origin/main"}]}]})
            [col row w h] (:area (overlayview/ed-transient-widget m cols rows))
            image (gui/render-frame (view/ed-view m cols rows) (spec))
            [cell-w cell-h] (:cell image)
            [origin-x _] (:origin image)
            tops (:row-tops image)
            gap (first (ui-kit/ui-space-box :card-gap))
            ;; every pixel column across the card's middle, off its rounded corners
            xs (vec (range (math/floor (+ origin-x (* cell-w (+ col 2))))
                      (math/floor (+ origin-x (* cell-w (+ col w -2))))))
            pixels-on (fn (y) (map xs (fn (x) (gui/pixel image x y))))
            ;; the middle of the row just above the mode line, and of the card's last row
            gap-row (+ row h (dec gap))
            gap-y (+ (nth tops gap-row) (math/quot cell-h 2))
            card-y (+ (nth tops (dec (+ row h))) (math/quot cell-h 2))
            surface (rgb *surface0*)
            background (rgb *base*))
        (assert= (dec (- rows (minibuffer/ed-echo-rows m rows))) (+ row h gap))
        (is (every? (pixels-on gap-y) (fn (pixel) (= pixel background))))
        (is (every? (pixels-on card-y) (fn (pixel) (= pixel surface))))))))

;; ---- the partial line (brood ADR-615) -------------------------------------------------

(def- long-source
  (string/join (map (vec (range 0 200)) (fn (i) (str "line " i " says |É|"))) "\n"))

(defn- painted-long (height)
  "A 200-line file buffer, the header line on, at a window `height` pixels tall: the
frame's ops, the picture, the grid, the model it was drawn from and the pane's text rows."
  (let (probe [[:clear] [:seam nil {:top-band true}]]
        [cols rows] (:grid (gui/render-frame probe (spec height)))
        buf (make-buffer long-source "long.txt" (path/join (temp-dir "bedit-partial-") "long.txt"))
        m (assoc (ed-init buf) :header-line true :gui true)
        ops (view/ed-view m cols rows))
    {:ops ops
     :image (gui/render-frame ops (spec height))
     :cols cols
     :rows rows
     :m m}))

(defn- above-seam-op (ops)
  "The frame's `[:above-seam …]` block."
  (seq/find ops (fn (op) (and (vector? op) (= (first op) :above-seam)))))

(defn- text-ops-on (ops row)
  "Every `:text` op on `row`, walking into blocks and memo markers."
  (mapcat ops
    (fn (op)
      (cond
        (not (vector? op)) []
        (and (= (first op) :text) (= (nth op 1) row)) [op]
        (= (first op) :above-seam) (text-ops-on (nth op 1) row)
        (= (first op) :scroll-region) (text-ops-on (nth op 2) row)
        (= (first op) :ui/memo) (text-ops-on (nth op 3) row)
        else []))))

(describe "the leftover strip shows the next line, partly (brood ADR-615)"
  (test "the pane over the seam paints its next line on the seam's row, inside above-seam"
    (when (gui/available?)
      (let ({:keys [ops rows m]} (painted-long 607)
            seam (- rows (ed-echo-rows m rows) 1)
            block (above-seam-op ops)
            ;; header on row 0, so text row k shows buffer line k - 1; the seam row is the
            ;; line after the last whole one
            next-line (str "line " (dec seam) " says"))
        (is (not (nil? block)))
        (is (any? (text-ops-on [block] seam) (fn (op) (includes? (nth op 3) next-line))))
        ;; and its gutter number
        (is (any? (text-ops-on [block] seam) (fn (op) (includes? (nth op 3) (str seam))))))))

  (test "607 and 613 px show the line's ink in the strip; 600 px (5 px of it) is the plain strip"
    (when (gui/available?)
      (doseq ([height partial?] [[600 false] [607 true] [613 true]])
        (let ({:keys [image rows m]} (painted-long height)
              tops (:row-tops image)
              cell-h (second (:cell image))
              seam (- rows (ed-echo-rows m rows) 1)
              strip-top (math/round (+ (nth tops (dec seam)) cell-h))
              strip-bottom (nth tops seam)
              [inset _] (:origin image)
              x1 (* (first (:cell image)) 30)
              inked (inked-rows image inset x1 strip-top strip-bottom (rgb *base*))
              ;; phase 1: every pixel row of the strip is the last row's own bottom pixel row
              ;; (its leading), stretched — the brood rule under half a row (ADR-615)
              plain? (every? (vec (range strip-top strip-bottom))
                       (fn (y)
                         (every? (vec (range 0 window-width))
                           (fn (x) (= (gui/pixel image x y) (gui/pixel image x (dec strip-top))))))))
          ;; on failure: the window, the strip's height, whether it showed ink, whether plain
          (assert= [height (- strip-bottom strip-top) (not (empty? inked)) plain?]
            [height (- strip-bottom strip-top) partial? (not partial?)])
          ;; the echo area still ends on the inset
          (assert= (last tops) (- height startup/*inset*)))))))

(describe "the partial line to the mouse (brood ADR-615)"
  (test "a click in the strip puts point on that line, and the pane scrolls it into view"
    (let ({:keys [cols rows m]} (if (gui/available?)
                                  (painted-long 607)
                                  {:cols 80
                                   :rows 30
                                   :m (assoc (ed-init (make-buffer long-source "long.txt" nil))
                                        :header-line true
                                        :gui true)})
          seam (- rows (ed-echo-rows m rows) 1)
          ;; the runtime's event for a pointer in the strip: the seam's row, flagged, the
          ;; exact position a third of the way into the partly shown line
          click [:mouse :press :left seam 12 [] 1 {:at [(+ seam 0.3) 12.5] :partial true}]
          clicked (input/ed-update m click cols rows)
          buf (ed-current-buf clicked)
          ;; text row k shows line k - 1 under the header: the strip's line is seam - 1
          want (dec seam))
      (assert= (buffer-current-line buf) want)
      ;; it was past the window; the clamp brought it in, so the view starts further down
      (is (> (ed-current-top clicked) 0))
      ;; the mode line was not clicked: no drag, no menu, the press armed a text selection
      (is (not (nil? (:text-drag clicked))))))

  (test "the same row without the flag is the mode line, and does not move point"
    (let (m (assoc (ed-init (make-buffer long-source "long.txt" nil)) :header-line true :gui true)
          [cols rows] [80 30]
          seam (- rows (ed-echo-rows m rows) 1)
          clicked (input/ed-update m
                    [:mouse :press :left seam 12 [] 1 {:at [(+ seam 0.3) 12.5]}]
                    cols
                    rows))
      (assert= (buffer-current-line (ed-current-buf clicked)) 0)
      (assert= (ed-current-top clicked) 0))))
