;; C++ (src/languages/cpp.blsp): a `deflanguage` over tree-sitter-cpp, C's tables
;; extended. The mode half needs no grammar; the parsed half needs
;; `libtree-sitter-cpp.so` (M-x grammar-install cpp) and SKIPS without it.
(defmodule languages-cpp-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at indents load-test-grammar]))

(defn- face-of (name) (editor/face/face name))

(describe "c++, the mode"
  (test "the C++ extensions open in c++ mode; a .h and a .c stay C"
    (doseq (file ["/p/a.cpp" "/p/a.cc" "/p/a.cxx" "/p/a.hpp" "/p/a.hh" "/p/a.ipp"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "cpp"))
    (assert= (ed-buf-mode-name (file-buffer "" "/p/a.h")) "c")
    (assert= (ed-buf-mode-name (file-buffer "" "/p/a.c")) "c"))
  (test "it parses with tree-sitter-cpp, comments with // and formats with clang-format"
    (assert= (ed-mode-service (file-buffer "" "/p/a.cpp") :ts-lang) :cpp)
    (assert= (:url (model/grammar-source :cpp)) "https://github.com/tree-sitter/tree-sitter-cpp")
    (assert= (ed-mode-service (file-buffer "" "/p/a.cpp") :comment-syntax) "// ")
    (assert= (ed-mode-service (file-buffer "" "/p/a.cpp") :format-command) ["clang-format" "-i"]))
  (test "the restart: a column-0 item, the one before a raw string still open across it"
    (let (src "#include <x>\n\nint f() {\n    return 1;\n}\n")
      (assert= (languages/cpp/cpp-restart src (index-of src "    return"))
        (index-of src "int f")))
    (let (src "auto s = R\"(\nint f() {\n)\";\nint g() {\n    return 1;\n}\n")
      (assert= (languages/cpp/cpp-restart src (index-of src "    return"))
        (index-of src "int g")))
    (let (src "int f() {}\nauto s = R\"x(\nint g() {\n    return 1;\n")
      (assert= (languages/cpp/cpp-restart src (index-of src "    return"))
        (index-of src "auto s")))))

(def cpp-src
  "// the widget\n#include <vector>\n\nnamespace app {\n\nclass Widget : public Base {\npublic:\n    auto size() const -> int;\n    ~Widget();\n\nprivate:\n    int count_ = 0;\n};\n\ntemplate <typename T>\nvoid Widget::run(int n,\n                 T t) {\n    switch (n) {\n    case 1:\n        std::sort(v.begin(), v.end());\n        break;\n    }\n    auto s = R\"(raw)\";\n    this->get<int>(nullptr, true, 1.5);\n}\n\n} // namespace app\n")

(when (load-test-grammar :cpp)
  (describe "c++, parsed"
    (def cpp-spans (languages/cpp/cpp-fontify cpp-src))
    (test "a comment, a directive, the keywords"
      (assert= (face-at cpp-spans cpp-src "// the") (face-of :syntax/comment))
      (assert= (face-at cpp-spans cpp-src "#include") (face-of :syntax/keyword))
      (assert= (face-at cpp-spans cpp-src "namespace") (face-of :syntax/keyword))
      (assert= (face-at cpp-spans cpp-src "template") (face-of :syntax/keyword))
      (assert= (face-at cpp-spans cpp-src "this") (face-of :syntax/keyword)))
    (test "a class, a base, a namespace, a primitive and auto are specials"
      (assert= (face-at cpp-spans cpp-src "Widget :") (face-of :syntax/special))
      (assert= (face-at cpp-spans cpp-src "Base") (face-of :syntax/special))
      (assert= (face-at cpp-spans cpp-src "std::") (face-of :syntax/special))
      (assert= (face-at cpp-spans cpp-src "auto size") (face-of :syntax/special)))
    (test "a method declared in its class, a destructor and an out-of-class definition"
      (assert= (face-at cpp-spans cpp-src "size()") (face-of :syntax/definition))
      (assert= (face-at cpp-spans cpp-src "~Widget") (face-of :syntax/definition))
      (assert= (face-at cpp-spans cpp-src "run(") (face-of :syntax/definition)))
    (test "a qualified call, a method call and a template call are functions"
      (assert= (face-at cpp-spans cpp-src "sort(") (face-of :syntax/function))
      (assert= (face-at cpp-spans cpp-src "begin(") (face-of :syntax/function))
      (assert= (face-at cpp-spans cpp-src "get<") (face-of :syntax/function)))
    (test "literals: a raw string, nullptr, a boolean, a number"
      (assert= (face-at cpp-spans cpp-src "R\"(raw)\"") (face-of :syntax/string))
      (assert= (face-at cpp-spans cpp-src "nullptr") (face-of :syntax/constant))
      (assert= (face-at cpp-spans cpp-src "true") (face-of :syntax/constant))
      (assert= (face-at cpp-spans cpp-src "1.5") (face-of :syntax/number)))
    (test "it indents every line: a class's body, access specifiers, a switch, continued arguments"
      (let ([got want] (indents cpp-src "/p/widget.cpp")) (assert= got want)))
    (test "a class, a method and a namespace are definitions C-M-a stops at"
      (let (kinds (get languages/cpp/cpp-spec :definitions))
        (is (contains? (:kinds kinds) :class_specifier))
        (is (contains? (:kinds kinds) :namespace_definition))))))
