;; Fennel (src/languages/fennel.blsp): a `deflisp` over src/languages/lisps.blsp — its file pattern
;; and the Fennel heads it paints as special forms.
(defmodule languages-fennel-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model face-at]))

(describe "fennel-mode"
  (test "an .fnl file routes, and Fennel's heads paint as specials"
    (assert= (ed-buf-mode-name (cur (file-model "(fn f [] 1)" "init.fnl"))) "fennel")
    (let (src "(icollect [_ v (ipairs t)] v)")
      (assert= (face-at (languages/fennel/fennel-fontify src) src "icollect")
        (editor/face/face :syntax/special)))))
