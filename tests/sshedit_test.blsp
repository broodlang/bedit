;; A file on another machine (`src/sshedit.blsp` over `sshremote` and `sshpath`): the `/ssh:`
;; path syntax, the prompt reading it, the scripts and the ssh command line, the handler's
;; open / save / revert / password / failure folds, the private sidecar, and the local tools
;; leaving a remote buffer alone. ssh is STOOD IN FOR: `sshremote/*program*` is bound to a
;; shell script that takes ssh's options and runs the remote command HERE, in a temp folder
;; (its HOME too) — so the scripts really run, against real files, and no test reaches a
;; network. The stand-in can refuse a key (wanting the password `secret`, through the real
;; askpass helper), fail the host key, or be down.
(defmodule sshedit-test
  (:use sshedit)
  (:use sshpath :only [])
  (:use sshremote) ; *program* / *control-dir* — the stand-in and its sockets
  (:use config-paths) ; *config-base* — a scratch config dir
  (:use autosave)
  (:use sidecar)
  (:use model)
  (:use input)
  (:use pool)
  (:use main :only [])
  (:use editor/buffer)
  (:use test))

(purge-stale-temp "bedit-ssh-")

(defn- stub-source (state)
  (str "#!/bin/sh\n"
    "state="
    (os/shell-quote state)
    "\n"
    "batch=yes\n"
    "proxy=\n"
    "printf '%s\\n' \"$*\" > \"$state/last-args\"\n"
    "printf '%s\\n' \"$*\" >> \"$state/ssh-calls\"\n"
    "while [ $# -gt 0 ]; do\n"
    "  case \"$1\" in\n"
    "    -o) case \"$2\" in BatchMode=no) batch=no ;; ProxyCommand=*) proxy=${2#ProxyCommand=} ;; esac; shift 2 ;;\n"
    "    -p|-l|-e) shift 2 ;;\n"
    "    -T) shift ;;\n"
    "    -tt) touch \"$state/tty-asked\"; shift ;;\n"
    "    --) shift; break ;;\n"
    "    *) break ;;\n"
    "  esac\n"
    "done\n"
    "host=$1; shift\n"
    "if [ -f \"$state/hostkey\" ]; then echo 'Host key verification failed.' >&2; exit 255; fi\n"
    "if [ -f \"$state/down\" ]; then echo \"ssh: connect to host $host port 22: Connection refused\" >&2; exit 255; fi\n"
    "# a jump host wanting a password, reached in batch mode through the ProxyCommand: its last word\n"
    "hop=$(printf '%s\\n' \"$proxy\" | awk '{print $NF}' | tr -d \"'\")\n"
    "if [ -n \"$hop\" ] && [ -f \"$state/needpw-$hop\" ] && [ ! -f \"$state/connected-$hop\" ]; then\n"
    "  echo \"me@$hop: Permission denied (publickey,password).\" >&2; echo 'Connection closed by UNKNOWN port 65535' >&2; exit 255\n"
    "fi\n"
    "mark=\n"
    "if [ -f \"$state/needpw\" ]; then mark=\"$state/connected\"; elif [ -f \"$state/needpw-$host\" ]; then mark=\"$state/connected-$host\"; fi\n"
    "if [ -n \"$mark\" ] && [ ! -f \"$mark\" ]; then\n"
    "  if [ $batch = yes ]; then echo \"me@$host: Permission denied (publickey,password).\" >&2; exit 255; fi\n"
    "  typed=$(\"$SSH_ASKPASS\" \"me@$host's password: \")\n"
    "  if [ \"$typed\" != secret ]; then echo \"me@$host: Permission denied (publickey,password).\" >&2; exit 255; fi\n"
    "  touch \"$mark\"\n"
    "fi\n"
    "HOME=\"$state/home\"; export HOME\n"
    "PATH=\"$state/bin:$PATH\"; export PATH\n"
    "exec /bin/sh -c \"$*\"\n"))

(defn- sudo-source (state)
  ;; the `sudo` the stand-in host runs: as the user it was told (written to `sudo-user`), a
  ;; password (`rootpw`) wanted when `sudopw` is there — asked again once when wrong, as sudo does.
  ;; `sudo-flavour` holding `rs-old` makes it sudo-rs before 0.2.5 (no `-p`, no SUDO_PROMPT: its
  ;; own `[sudo: authenticate] Password: `), `rs-new` sudo-rs since (SUDO_PROMPT wrapped in its
  ;; brackets); else classic sudo (SUDO_PROMPT as it is)
  (str "#!/bin/sh\n"
    "state="
    (os/shell-quote state)
    "\n"
    "flavour=$(cat \"$state/sudo-flavour\" 2>/dev/null)\n"
    "case $flavour in\n"
    "  rs-old) prompt='[sudo: authenticate] Password: ' ;;\n"
    "  rs-new) prompt=\"[sudo: $SUDO_PROMPT] Password: \" ;;\n"
    "  *) prompt=${SUDO_PROMPT:-'[sudo] password for me: '} ;;\n"
    "esac\n"
    "user=root\n"
    "while [ $# -gt 0 ]; do\n"
    "  case \"$1\" in -S|-n|-k) shift ;; -u) user=$2; shift 2 ;; --) shift; break ;;\n"
    "    -p) if [ \"$flavour\" = rs-old ]; then echo 'sudo-rs: invalid option provided' >&2; exit 1; fi; prompt=$2; shift 2 ;;\n"
    "    *) break ;; esac\n"
    "done\n"
    "printf '%s\\n' \"$user\" > \"$state/sudo-user\"\n"
    "if [ -f \"$state/sudopw\" ]; then\n"
    "  printf '%s' \"$prompt\" >&2\n"
    "  IFS= read -r typed || exit 1\n"
    "  if [ \"$typed\" != rootpw ]; then printf 'Sorry, try again.\\n%s' \"$prompt\" >&2; IFS= read -r typed; exit 1; fi\n"
    "fi\n"
    "exec \"$@\"\n"))

(defn- su-source (state)
  ;; the stand-in host's `su - USER -c SCRIPT`: as the user it was told (written to `su-user`),
  ;; always asking for that user's password (`rootpw`) on its one stream, as on a terminal, and
  ;; ending at once when it is wrong, as su does
  (str "#!/bin/sh\n"
    "state="
    (os/shell-quote state)
    "\n"
    "[ \"$1\" = - ] && shift\n"
    "user=$1; shift\n"
    "[ \"$1\" = -c ] || exit 2\n"
    "printf '%s\\n' \"$user\" > \"$state/su-user\"\n"
    "printf 'Password: '\n"
    "IFS= read -r typed || exit 1\n"
    "printf '\\n'\n"
    "if [ \"$typed\" != rootpw ]; then echo 'su: Authentication failure'; exit 1; fi\n"
    "exec /bin/sh -c \"$2\"\n"))

(defn- doas-source (state)
  ;; the stand-in host's `doas -u USER COMMAND…`: as the user it was told (written to
  ;; `doas-user`), asking for YOUR password (`mypw`) when `doaspw` is there (else `nopass`), on
  ;; its one stream, ending at once when it is wrong, as doas does
  (str "#!/bin/sh\n"
    "state="
    (os/shell-quote state)
    "\n"
    "user=root\n"
    "if [ \"$1\" = -u ]; then user=$2; shift 2; fi\n"
    "printf '%s\\n' \"$user\" > \"$state/doas-user\"\n"
    "if [ -f \"$state/doaspw\" ]; then\n"
    "  printf 'doas (me@web1) password: '\n"
    "  IFS= read -r typed || exit 1\n"
    "  if [ \"$typed\" != mypw ]; then echo 'doas: Authentication failed'; exit 1; fi\n"
    "fi\n"
    "exec \"$@\"\n"))

(defn- with-stub (body)
  "`(body dir)` with ssh stood in for by a script in a fresh temp `dir` (the remote commands
run here, `dir/home` their HOME), the editor's config and the control sockets under `dir`."
  (let (dir (temp-dir "bedit-ssh-")
        stub (path/join dir "ssh"))
    (do
      (file/mkdir (path/join dir "home"))
      (file/spit stub (stub-source dir))
      (os/cmd "chmod" ["+x" stub])
      (file/mkdir (path/join dir "bin"))
      (each [["sudo" (sudo-source dir)] ["su" (su-source dir)] ["doas" (doas-source dir)]]
        (fn ([program source])
          (do
            (file/spit (path/join dir "bin" program) source)
            (os/cmd "chmod" ["+x" (path/join dir "bin" program)]))))
      (let (result (binding (*program* stub
                             *control-dir* (path/join dir "ctl")
                             *config-base* dir)
                     (body dir)))
        (do (sshsudo/stop-all dir) result)))))

(defn- type-text (m text)
  (fold (string/->graphemes text) m (fn (acc key) (ed-update acc key 80 24))))

(defn- remote (path) (str "/ssh:web1:" path))

(defn- last-three (argv) (vec (drop argv (- (count argv) 3))))

;; ---- the path ------------------------------------------------------------------------

(describe "TRAMP's ssh path"
  (test "is read as a user, a host, a port and a path"
    (assert= (sshpath/parse "/ssh:web1:/etc/nginx.conf")
      {:user nil :host "web1" :port nil :path "/etc/nginx.conf"})
    (assert= (sshpath/parse "/ssh:me@web1#2222:/srv/a b")
      {:user "me" :host "web1" :port 2222 :path "/srv/a b"})
    (assert= (:host (sshpath/parse "/ssh:me@[fe80::1]#22:/x")) "fe80::1")
    (assert= (:path (sshpath/parse "/ssh:web1:")) ""))
  (test "refuses what is not one, and a name ssh would take for an option"
    (each ["/etc/hosts"
            "/ssh:" "/ssh:web1" "/ssh::/x" "/ssh:web1#port:/x" "/ssh:web1#0:/x"
            "/ssh:-oProxyCommand=evil:/x" "/ssh:-l@web1:/x" "/ssh:we b:/x" "/ssh:[::1/x"]
      (fn (spec) (is (nil? (sshpath/parse spec))))))
  (test "is spelled back, and in one spelling for a buffer"
    (assert= (sshpath/spec (sshpath/parse "/ssh:me@[::1]#22:~/x")) "/ssh:me@[::1]#22:~/x")
    (assert= (sshpath/canonical "/ssh:web1:/etc/./nginx/../hosts/") "/ssh:web1:/etc/hosts")
    (assert= (sshpath/canonical "/ssh:web1:notes") "/ssh:web1:~/notes")
    (assert= (sshpath/canonical "/ssh:web1:") "/ssh:web1:~")
    (assert= (sshpath/canonical "/ssh:web1:/") "/ssh:web1:/"))
  (test "knows its directory"
    (assert= (sshpath/dirname "/ssh:web1:/etc/hosts") "/ssh:web1:/etc")
    (assert= (sshpath/dirname "/ssh:web1:/etc") "/ssh:web1:/")
    (assert= (sshpath/dirname "/ssh:web1:~/a") "/ssh:web1:~"))
  (test "goes through jump hosts, TRAMP's multi-hop"
    (let (parts (sshpath/parse "/ssh:me@bastion#2222|ssh:gate|ssh:you@web1:/etc/hosts"))
      (do
        (assert= (:hops parts)
          [{:user "me" :host "bastion" :port 2222} {:user nil :host "gate" :port nil}])
        (assert= (:host parts) "web1")
        (assert= (:user parts) "you")
        (assert= (:path parts) "/etc/hosts")
        (assert= (sshpath/spec parts) "/ssh:me@bastion#2222|ssh:gate|ssh:you@web1:/etc/hosts")))
    (assert= (:path (sshpath/parse "/ssh:h:/tmp/a|ssh:b")) "/tmp/a|ssh:b")
    (assert= (sshpath/canonical "/ssh:j|ssh:h:/etc/../x") "/ssh:j|ssh:h:/x")
    (assert= (sshpath/dirname "/ssh:j|ssh:h:/etc/x") "/ssh:j|ssh:h:/etc")
    (assert= (sshpath/prefix (sshpath/parse "/ssh:j|ssh:h:/x")) "/ssh:j|ssh:h:")
    (each ["/ssh:j|scp:h:/x" "/ssh:-j|ssh:h:/x" "/ssh:j%h|ssh:h:/x" "/ssh:j|ssh:" "/ssh:j|ssh:h"]
      (fn (spec) (is (nil? (sshpath/parse spec))))))
  (test "another user's home stays as typed"
    (assert= (sshpath/canonical "/ssh:h:~www/site/") "/ssh:h:~www/site")
    (assert= (sshpath/dirname "/ssh:h:~www/site") "/ssh:h:~www")
    (assert= (sshpath/dirname "/ssh:h:~www") "/ssh:h:~www"))
  (test "a name is joined in a remote directory, and two paths know their connection"
    (assert= (sshpath/join "/ssh:h:/etc" "hosts") "/ssh:h:/etc/hosts")
    (assert= (sshpath/join "/ssh:h:/" "etc") "/ssh:h:/etc")
    (assert= (sshpath/join "/ssh:h:/etc" "../srv") "/ssh:h:/srv")
    (assert= (sshpath/join "/ssh:h:/etc" "/srv/a") "/ssh:h:/srv/a")
    (assert= (sshpath/join "/ssh:h:/etc" "~/a") "/ssh:h:~/a")
    (is (sshpath/same-connection? "/ssh:me@h:/a" "/ssh:me@h:~/b"))
    (is (not (sshpath/same-connection? "/ssh:h:/a" "/ssh:j|ssh:h:/a"))))
  (test "is found where it was typed over a local path"
    (assert= (sshpath/remote-start "/ssh:h:/x") 0)
    (assert= (sshpath/remote-start "~/src//ssh:h:/x") 6)
    (is (nil? (sshpath/remote-start "~/notes/ssh:h:x")))))

(describe "the prompt reads an ssh path the TRAMP way"
  (test "it stays remote, made absolute on the host"
    (assert= (filename/expand "/ssh:web1:/etc/nginx.conf") "/ssh:web1:/etc/nginx.conf")
    (assert= (filename/expand "/ssh:web1:notes") "/ssh:web1:~/notes")
    (assert= (filename/expand "/ssh:web1:") "/ssh:web1:~")
    (assert= (filename/expand "/ssh:web1:/etc/") "/ssh:web1:/etc/"))
  (test "a relative name in a remote directory is on that host"
    (assert= (filename/expand "nginx.conf" "/ssh:web1:/etc") "/ssh:web1:/etc/nginx.conf"))
  (test "`//` and `/~/` restart the REMOTE path, a typed /ssh: restarts the local one"
    (assert= (filename/expand "/ssh:web1:/etc//srv/a") "/ssh:web1:/srv/a")
    (assert= (filename/expand "/ssh:web1:/etc/~/a") "/ssh:web1:~/a")
    (assert= (filename/expand "~/src//ssh:web1:/etc") "/ssh:web1:/etc")
    (assert= (filename/shadow-end "/ssh:web1:/etc//srv") 15)
    (assert= (filename/shadow-end "~/src//ssh:web1:/etc") 6)))

;; ---- the transport -------------------------------------------------------------------

(describe "the ssh command line"
  (test "never asks, shares one connection, and keeps the host an argument"
    (binding (*control-dir* "/run/x")
      (let (argv (sshremote/ssh-argv {:user "me" :host "web1" :port 2222} "/bin/sh -s"))
        (do
          (is (includes? argv "BatchMode=yes"))
          (is (includes? argv "ControlMaster=auto"))
          (is (includes? argv "ControlPath=/run/x/%C"))
          (is (any? argv (fn (a) (string/starts-with? a "ControlPersist="))))
          (assert= (last-three argv) ["--" "web1" "/bin/sh -s"])
          (is (includes? argv "2222"))
          (is (includes? argv "me"))))))
  (test "the password call alone is not in batch mode, and asks once"
    (let (argv (sshremote/ssh-argv {:host "h"} "true" false))
      (do
        (is (includes? argv "BatchMode=no"))
        (is (includes? argv "NumberOfPasswordPrompts=1")))))
  (test "a route through jump hosts is a ProxyCommand, each hop in batch mode"
    (binding (*program* "ssh")
      (let (argv (sshremote/ssh-argv (sshpath/parse "/ssh:me@bastion#2222|ssh:gate|ssh:web1:/x")
                   "/bin/sh -s")
            proxy (seq/find argv (fn (a) (string/starts-with? a "ProxyCommand="))))
        (do
          (assert= (last-three argv) ["--" "web1" "/bin/sh -s"])
          ;; the last hop carries the connection, `%h`/`%p` this ssh's own
          (is (string/ends-with? proxy "-W '[%h]:%p' -- gate"))
          (is (includes? proxy "BatchMode=yes"))
          ;; the hop before it, nested: its `%` doubled so the outer ssh hands it on
          (is (includes? proxy "ProxyCommand="))
          (is (includes? proxy "[%%h]:%%p"))
          (is (includes? proxy "-p 2222 -l me"))))))
  (test "a direct path has no ProxyCommand of bedit's"
    (is (not (any? (sshremote/ssh-argv {:host "h"} "true")
               (fn (a) (string/starts-with? a "ProxyCommand="))))))
  (test "a too long state folder puts the sockets in the runtime dir"
    (binding (*config-base* (str "/tmp/" (string/repeat "x" 90)))
      (is (not (string/starts-with? (sshremote/control-dir) "/tmp/xxxx"))))))

(describe "the remote scripts"
  (test "quote every argument for POSIX sh"
    (let (script (sshremote/read-script "/srv/it's a $HOME `x` \"y\";z"))
      (is (includes? script "set -- '/srv/it'\\''s a $HOME `x` \"y\";z' 0"))))
  (test "a write carries the bytes, their count and their SHA-256"
    (let (script (sshremote/write-script "/srv/a" "hi"))
      (do
        (is (includes? script (str "set -- /srv/a 2 " (hash/sha256-bytes (string/->bytes "hi")))))
        (is (includes? script "aGk=\nBEDIT_EOF\n")))))
  (test "Base64 is wrapped for the here-document"
    (assert= (sshremote/wrap-base64 "abcdefgh" 3) "abc\ndef\ngh\n")
    (assert= (sshremote/wrap-base64 "") ""))
  (test "answers are read back"
    (assert= (sshremote/parse-read "dir\n/etc\n") {:kind :dir :path "/etc"})
    (assert= (:bytes (sshremote/parse-read "file\n/a\n5\n2\naGk=\n")) (string/->bytes "hi"))
    (assert= (sshremote/parse-read "large\n/a\n5\n99\n")
      {:kind :large :path "/a" :mtime 5 :size 99})
    (is (failure? (sshremote/parse-read "")))
    (assert= (sshremote/parse-list "/srv\n./\n../\nz\na/\n") {:dir "/srv" :names ["a/" "z"]})
    (assert= (sshremote/parse-write "17\n") 17)))

(describe "what an ssh failure is"
  (test "a host key is never taken, and says how to check it"
    (let (failed (sshremote/classify {:exit 255 :stderr "Host key verification failed.\n"}
                   {:host "web1"}))
      (do
        (assert= (:error failed) :host-key)
        (is (includes? (:reason failed) "never accepts")))))
  (test "a refusal says whether a password would do"
    (is (:password? (sshremote/classify {:exit 255
                                         :stderr "me@h: Permission denied (publickey,password)."}
                      {:host "h"})))
    (is (not (:password? (sshremote/classify {:exit 255
                                              :stderr "me@h: Permission denied (publickey)."}
                           {:host "h"})))))
  (test "anything else of ssh's own is the connection; the script's exits are not ssh's"
    (assert= (:error (sshremote/classify {:exit 255 :stderr "Connection reset by peer"} {:host "h"}))
      :connection)
    (is (nil? (sshremote/classify {:exit 4 :stderr "x"} {:host "h"})))
    (assert= (:error (sshremote/classify {:exit -1 :timed-out true} {:host "h"})) :timeout)))

(describe "the transport, through the stand-in"
  (test "reads a file whose name is full of shell metacharacters, byte for byte"
    (with-stub (fn (dir)
                 (let (path (path/join dir "it's a $HOME `x` \"y\";z")
                       bytes (bytes 0 1 2 255 10 104 105))
                   (do
                     (file/spit-bytes path bytes)
                     (let (read (sshremote/read-file {:host "web1"} path))
                       (do
                         (assert= (:kind read) :file)
                         (assert= (:path read) path)
                         (assert= (:bytes read) bytes))))))))
  (test "writes atomically, keeping the file's mode, and makes a new file"
    (with-stub
      (fn (dir)
        (let (path (path/join dir "a b.conf"))
          (do
            (file/spit path "old\n")
            (os/cmd "chmod" ["640" path])
            (let (mode-before (:mode (file/stat path))
                  written (sshremote/write-file {:host "web1"} path "new\n"))
              (do
                (is (int? (:mtime written)))
                (assert= (file/slurp path) "new\n")
                (assert= (:mode (file/stat path)) mode-before)
                ;; no stage left beside it
                (is (empty? (seq/filter (file/ls dir)
                              (fn (n) (string/starts-with? n ".bedit-write")))))))
            (sshremote/write-file {:host "web1"} (path/join dir "fresh") "x")
            (assert= (file/slurp (path/join dir "fresh")) "x"))))))
  (test "`~` is the remote home"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "home" "notes") "hi\n")
                   (let (read (sshremote/read-file {:host "web1"} "~/notes"))
                     (assert= (:path read) (path/join dir "home" "notes")))))))
  (test "a file past the limit sends only its size; a directory and a new file are said"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "big") (string/repeat "x" 100))
                   (assert= (:kind (sshremote/read-file {:host "web1"} (path/join dir "big") 10))
                     :large)
                   (assert= (:kind (sshremote/read-file {:host "web1"} dir)) :dir)
                   (assert= (:kind (sshremote/read-file {:host "web1"} (path/join dir "nope")))
                     :new)
                   (is (failure? (sshremote/read-file {:host "web1"} (path/join dir "no" "such"))))))))
  (test "lists a directory for the prompt, and keeps it a while"
    (with-stub (fn (dir)
                 (do
                   (file/mkdir (path/join dir "sub"))
                   (file/spit (path/join dir "a.txt") "")
                   (let (spec (remote dir))
                     (do
                       (is (nil? (sshremote/cached-listing spec)))
                       (let (names (sshremote/fetch-listing spec))
                         (do
                           (is (includes? names "sub/"))
                           (is (includes? names "a.txt"))
                           (assert= (sshremote/cached-listing spec) names)))))))))
  (test "a password reaches ssh through the askpass helper, once"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "needpw") "")
                   (is (:failed (sshremote/read-file {:host "web1"} dir)))
                   (is (:failed (sshremote/connect-with-password {:host "web1"} "wrong")))
                   (is (= true (sshremote/connect-with-password {:host "web1"} "secret"))))))))

(describe "the askpass helper"
  (test "refuses a host key question, and answers a password from its standard input"
    (with-stub
      (fn (_dir)
        (let (helper (sshremote/askpass-helper))
          (do
            (is (not (= 0
                       (:exit (os/cmd helper
                                ["Are you sure you want to continue connecting (yes/no/[fingerprint])?"]
                                {:stdin "yes\n"})))))
            (assert= (:stdout (os/cmd helper ["me@h's password: "] {:stdin "secret\n"})) "secret\n")
            ;; owner-only and executable: 0700
            (assert= (math/mod (:mode (file/stat helper)) 512) 448)))))))

;; ---- the handler ---------------------------------------------------------------------

(describe "C-x C-f /ssh:host:PATH"
  (test "opens the file, visiting its TRAMP path"
    (with-stub
      (fn (dir)
        (let (path (path/join dir "nginx.conf"))
          (do
            (file/spit path "server {}\n")
            (let (m (ed-find-file (ed-init (make-buffer "")) (remote path))
                  b (ed-current-buf m))
              (do
                (is (= true (:ssh b)))
                (assert= (buffer-file b) (remote path))
                (assert= (buffer-text b) "server {}\n")
                (assert= (buffer-name b) "nginx.conf")
                (assert= (:dir b) (remote dir))
                (is (not (buffer-modified? b)))
                (is (includes? (:echo m) "opened /ssh:web1:"))
                ;; asked again, the same buffer
                (assert= (count (:buffers (ed-find-file m (remote path)))) (count (:buffers m))))))))))
  (test "a file that is not there yet is a new remote buffer"
    (with-stub (fn (dir)
                 (let (m (ed-find-file (ed-init (make-buffer ""))
                           (remote (path/join dir "new.txt"))))
                   (do
                     (is (= true (:ssh (ed-current-buf m))))
                     (is (includes? (:echo m) "new file")))))))
  (test "a binary opens as the hex view"
    (with-stub (fn (dir)
                 (let (path (path/join dir "blob"))
                   (do
                     (file/spit-bytes path (bytes 0 1 2 0 255))
                     (let (m (ed-find-file (ed-init (make-buffer "")) (remote path)))
                       (is (includes? (:echo m) "as hex"))))))))
  (test "a directory opens in dired, listed over ssh"
    (with-stub (fn (dir)
                 (let (m (ed-find-file (ed-init (make-buffer "")) (remote dir)))
                   (do
                     (assert= (editor/layers/buffer-type-for (ed-current-buf m)) :dired)
                     (assert= (buffer-name (ed-current-buf m)) (remote dir))
                     (is (not (any? (:buffers m) :ssh-loading))))))))
  (test "a large file is asked about before its bytes cross"
    (with-stub (fn (dir)
                 (let (path (path/join dir "big"))
                   (do
                     (file/spit path (string/repeat "x" 100))
                     (let (asked (ed-find-file (assoc (ed-init (make-buffer ""))
                                                 :large-file-warning-threshold 10)
                                   (remote path)))
                       (do
                         (is (includes? (:echo asked) "is large"))
                         (let (m (ed-update asked "y" 80 24))
                           (assert= (buffer-text (ed-current-buf m)) (string/repeat "x" 100))))))))))
  (test "a host key it does not know opens nothing and says so"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "hostkey") "")
                   (let (m (ed-find-file (ed-init (make-buffer "")) (remote (path/join dir "x"))))
                     (do
                       (is (includes? (:echo m) "host key"))
                       (is (not (any? (:buffers m) :ssh)))
                       (is (not (any? (:buffers m) :ssh-loading)))))))))
  (test "asks for the password, masked, opens once it is typed, and keeps it nowhere"
    (with-stub (fn (dir)
                 (let (path (path/join dir "app.conf"))
                   (do
                     (file/spit path "x\n")
                     (file/spit (path/join dir "needpw") "")
                     (let (asked (ed-find-file (ed-init (make-buffer "")) (remote path)))
                       (do
                         (is (map/get-in asked [:minibuffer :masked]))
                         (is (map/get-in asked [:minibuffer :no-history]))
                         (let (m (ed-update (type-text asked "secret") :enter 80 24))
                           (do
                             (assert= (buffer-text (ed-current-buf m)) "x\n")
                             (is (not (includes? (pr-str (dissoc m :buffers)) "secret"))))))))))))
  (test "a wrong password opens nothing and says so"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "needpw") "")
                   (let (asked (ed-find-file (ed-init (make-buffer ""))
                                 (remote (path/join dir "x")))
                         m (ed-update (type-text asked "nope") :enter 80 24))
                     (do
                       (is (includes? (:echo m) "refused the password"))
                       (is (not (any? (:buffers m) :ssh-loading)))))))))
  (test "a path that is not one is said"
    (is (includes? (:echo (ed-find-file (ed-init (make-buffer "")) "/ssh:-oProxyCommand=x:/etc"))
          "not an ssh path"))))

(describe "a remote buffer is saved through ssh"
  (test "C-x C-s writes the file, and the buffer is saved"
    (with-stub (fn (dir)
                 (let (path (path/join dir "a.conf"))
                   (do
                     (file/spit path "one\n")
                     (let (opened (ed-find-file (ed-init (make-buffer "")) (remote path))
                           edited (ed-update opened "#" 80 24)
                           saved (file-save/ed-save-buf-at edited (ed-current-index edited)))
                       (do
                         (assert= (file/slurp path) "#one\n")
                         (is (not (buffer-modified? (ed-current-buf saved))))
                         (is (includes? (:echo saved) "on web1")))))))))
  (test "a dropped connection is said, and the buffer stays modified"
    (with-stub (fn (dir)
                 (let (path (path/join dir "a.conf"))
                   (do
                     (file/spit path "one\n")
                     (let (opened (ed-find-file (ed-init (make-buffer "")) (remote path))
                           edited (ed-update opened "#" 80 24)
                           _ (file/spit (path/join dir "down") "")
                           saved (file-save/ed-save-buf-at edited (ed-current-index edited)))
                       (do
                         (assert= (file/slurp path) "one\n")
                         (is (buffer-modified? (ed-current-buf saved)))
                         (is (includes? (:echo saved) "failed or dropped")))))))))
  (test "M-x revert-buffer reads it again, one undoable edit"
    (with-stub (fn (dir)
                 (let (path (path/join dir "a.conf"))
                   (do
                     (file/spit path "one\n")
                     (let (opened (ed-find-file (ed-init (make-buffer "")) (remote path))
                           _ (file/spit path "two\n")
                           reverted (lifecycle/cmd-revert-buffer opened nil))
                       (do
                         (assert= (buffer-text (ed-current-buf reverted)) "two\n")
                         (is (includes? (:echo reverted) "reverted"))))))))))

(describe "C-x C-w to an ssh path"
  (test "makes the buffer a remote one and writes it there"
    (with-stub (fn (dir)
                 (let (path (path/join dir "moved.txt")
                       m (ed-ssh-write-file (ed-init (make-buffer "hello\n")) (remote path))
                       b (ed-current-buf m))
                   (do
                     (assert= (file/slurp path) "hello\n")
                     (is (= true (:ssh b)))
                     (assert= (buffer-file b) (remote path))
                     (is (not (buffer-modified? b)))))))))

(describe "a remote buffer's sidecar is private"
  (test "it goes to the editor's state folder, named for the TRAMP path"
    (with-stub (fn (dir)
                 (let (spec "/ssh:web1:/etc/hosts"
                       sidecar (ed-auto-save-path spec))
                   (do
                     (is (string/starts-with? sidecar (path/join dir "bedit" "state" "auto-save")))
                     (assert= (path/basename sidecar) "#%2Fssh:web1:%2Fetc%2Fhosts#")
                     (assert= (private-sidecar-spec (path/basename sidecar)) spec))))))
  (test "an auto-save round writes it there, owner-only"
    (with-stub (fn (dir)
                 (let (path (path/join dir "a.conf"))
                   (do
                     (file/spit path "one\n")
                     (let (m (ed-update (ed-find-file (ed-init (make-buffer "")) (remote path))
                               "#" 80 24)
                           due (ed-auto-save-due m))
                       (do
                         (ed-auto-save-write (:due due) (:sudo due))
                         (assert= (file/slurp (ed-auto-save-path (remote path))) "#one\n")
                         (is (not (file/exists? (path/join dir "#a.conf#")))))))))))
  (test "recover-session lists it by its TRAMP path"
    (with-stub (fn (_dir)
                 (do
                   (write-sidecar "/ssh:web1:/etc/hosts" nil "x")
                   (is (includes? (recover/ed-private-recoverable (ed-private-auto-save-dir))
                         "/ssh:web1:/etc/hosts")))))))

(describe "the local tools leave a remote buffer alone"
  (test "it is a file handler's row"
    (assert= (:name (ed-path-handler "/ssh:web1:/etc/hosts")) :ssh)
    (assert= (:name (ed-buffer-handler {:ssh true})) :ssh))
  (test "no project, no language server, no editorconfig, no dir-locals, no formatter"
    (is (nil? (projects/project-root "/ssh:web1:/srv/app")))
    (assert= (lsp/lsp-specs-for "/ssh:web1:/srv/app/main.py") [])
    (assert= (editorconfig/properties-for "/ssh:web1:/srv/a.py"
               (fn (_) "root = true\n[*]\nindent_size = 2\n"))
      {})
    (is (nil? (dirlocals/file-for "/ssh:web1:/srv/a.py" (fn (_) true)))))
  (test "diff-hl does not look, compile and M-! do not run"
    (let (m (ed-init (assoc (sshedit/ssh-buffer "/ssh:web1:/srv/a.py" "x = 1\n")
                       :dir "/ssh:web1:/srv")))
      (do
        (is (not (diffhl/ed-diffhl-stale? m)))
        (is (includes? (:echo (compile/compile-run m "make")) "another machine"))
        (is (nil? (ed-project-root m)))
        ;; auto-revert asks the disk about no remote buffer
        (is (empty? (first (autorevert/ed-auto-revert-candidates m 999999999))))
        (is (nil? (formatter/format-command-for (ed-current-buf m)))))))
  (test "another frame and a restarted loop carry the mark"
    (is (= true (:ssh (hosted/hosted-meta (sshedit/ssh-buffer "/ssh:web1:/a" "x")))))))

(describe "the path prompt completes a remote directory"
  (test "from its listing, once it has been fetched"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "alpha.txt") "")
                   (file/mkdir (path/join dir "beta"))
                   (let (text (str (remote dir) "/"))
                     (do
                       (is (mincomplete/remote-listing-wanted? text))
                       (let (fetched (mincomplete/ed-remote-candidates-fetched text [] 12))
                         (do
                           (is (includes? fetched (str text "alpha.txt")))
                           (is (includes? fetched (str text "beta/")))
                           (is (not (mincomplete/remote-listing-wanted? text)))
                           (assert= (vec (mincomplete/ed-path-candidates (str text "al")))
                             [(str text "alpha.txt")])))))))))
  (test "a local path never asks the network"
    (is (not (mincomplete/remote-listing-wanted? "/tmp/" nil)))))

;; ---- another user's home, a route through jump hosts ---------------------------------

(describe "another user's home on the remote"
  (test "`~USER/…` is resolved by the remote shell"
    (with-stub (fn (_dir)
                 (let (user (os/user-name)
                       home (string/trim (:stdout (os/cmd "sh" ["-c" (str "eval echo ~" user)])))
                       read (sshremote/read-file {:host "web1"} (str "~" user)))
                   (do
                     (assert= (:kind read) :dir)
                     (assert= (:path read) home))))))
  (test "a user there is not, or a name that is not one, is said"
    (with-stub (fn (_dir)
                 (do
                   (is (includes? (error-message (sshremote/read-file {:host "web1"}
                                                   "~nosuchuser4711/x"))
                         "no such user"))
                   (is (includes? (error-message (sshremote/read-file {:host "web1"} "~a;b/x"))
                         "not a user's home")))))))

(describe "a route through jump hosts"
  (test "reaches the host through them, the hop given to ssh as a ProxyCommand"
    (with-stub (fn (dir)
                 (let (path (path/join dir "far.txt"))
                   (do
                     (file/spit path "far\n")
                     (let (m (ed-find-file (ed-init (make-buffer ""))
                               (str "/ssh:bastion|ssh:web1:" path))
                           b (ed-current-buf m))
                       (do
                         (assert= (buffer-text b) "far\n")
                         (assert= (buffer-file b) (str "/ssh:bastion|ssh:web1:" path))
                         (is (includes? (file/slurp (path/join dir "last-args")) "ProxyCommand="))
                         (is (includes? (file/slurp (path/join dir "last-args")) "-- bastion"))))))))))

;; ---- dired over ssh ------------------------------------------------------------------

(defn- dired-at (m name)
  ;; the remote listing `m` shows with point on entry `name`
  (let (index (index-of (:dired-names (ed-current-buf m)) name))
    (ed-apply m (fn (buffer) (ed-goto-line buffer (+ index 2))))))

(defn- press-keys (m keys) (fold keys m (fn (acc key) (ed-update acc key 80 24))))

(defn- answer (m typed)
  ;; the open prompt's text replaced by `typed`, and RET
  (press-keys (type-text (press-keys m [:ctrl-a :ctrl-k]) typed) [:enter]))

(defn- remote-fixture (dir)
  (do
    (file/mkdir (path/join dir "tree"))
    (file/mkdir (path/join dir "tree" "sub"))
    (file/spit (path/join dir "tree" "a.txt") "alpha\n")
    (path/join dir "tree")))

(describe "a remote directory in dired"
  (test "is listed over ssh: its entries, which are directories, `ls -l` rows"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       b (ed-current-buf m))
                   (do
                     (assert= (buffer-name b) (remote tree))
                     (assert= (:dired-dir b) (remote tree))
                     (assert= (vec (take (:dired-names b) 2)) ["." ".."])
                     (is (includes? (:dired-names b) "a.txt"))
                     (is (contains? (:dired-dirs b) "sub"))
                     (is (not (contains? (:dired-dirs b) "a.txt")))
                     (is (includes? (buffer-text b) "\n -rw"))
                     (is (includes? (buffer-text b) "\n drwx")))))))
  (test "RET visits a file over ssh and enters a directory; ^ goes up"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       visited (ed-update (dired-at m "a.txt") :enter 80 24)
                       entered (ed-update (dired-at m "sub") :enter 80 24)
                       up (ed-update entered "^" 80 24))
                   (do
                     (assert= (buffer-file (ed-current-buf visited))
                       (remote (path/join tree "a.txt")))
                     (assert= (buffer-text (ed-current-buf visited)) "alpha\n")
                     (assert= (:dired-dir (ed-current-buf entered)) (remote (path/join tree "sub")))
                     (assert= (:dired-dir (ed-current-buf up)) (remote tree)))))))
  (test "g lists it again, + makes a directory there"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       _ (file/spit (path/join tree "late.txt") "")
                       refreshed (ed-update m "g" 80 24)
                       made (answer (ed-update refreshed "+" 80 24) "fresh"))
                   (do
                     (is (includes? (:dired-names (ed-current-buf refreshed)) "late.txt"))
                     (is (file/dir? (path/join tree "fresh")))
                     (is (includes? (:dired-names (ed-current-buf made)) "fresh")))))))
  (test "R moves an entry on the host, and a buffer visiting it follows"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       listed (dired/ed-show-dired (ed-find-file (ed-init (make-buffer ""))
                                                     (remote (path/join tree "a.txt")))
                                (remote tree))
                       moved (answer (ed-update (dired-at listed "a.txt") "R" 80 24) "b.txt"))
                   (do
                     (is (file/exists? (path/join tree "b.txt")))
                     (is (not (file/exists? (path/join tree "a.txt"))))
                     (is (includes? (:dired-names (ed-current-buf moved)) "b.txt"))
                     (is (any? (:buffers moved)
                           (fn (b) (= (buffer-file b) (remote (path/join tree "b.txt")))))))))))
  (test "C copies into a directory, and asks before it replaces an entry there"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       copied (answer (ed-update (dired-at m "a.txt") "C" 80 24) "sub")
                       again (answer (ed-update (dired-at copied "a.txt") "C" 80 24) "sub"))
                   (do
                     (assert= (file/slurp (path/join tree "sub" "a.txt")) "alpha\n")
                     (is (file/exists? (path/join tree "a.txt")))
                     (is (includes? (:echo again) "exists; overwrite it?")))))))
  (test "C-x C-q edits the names: a swap, and a move into directories made there"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       _ (file/spit (path/join tree "b.txt") "bee\n")
                       _ (file/spit (path/join tree "c.txt") "sea\n")
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       rename (fn (at name new)
                                (type-text (press-keys (dired-at at name) [:ctrl-a :ctrl-k]) new))
                       editing (press-keys m [:ctrl-x :ctrl-q])
                       edited (rename (rename (rename editing "a.txt" "b.txt") "b.txt" "a.txt")
                                "c.txt" "new/deep/c.txt")
                       done (press-keys edited [:ctrl-c :ctrl-c]))
                   (do
                     (assert= (editor/layers/buffer-type-for (ed-current-buf editing)) :wdired)
                     (assert= (file/slurp (path/join tree "a.txt")) "bee\n")
                     (assert= (file/slurp (path/join tree "b.txt")) "alpha\n")
                     (assert= (file/slurp (path/join tree "new" "deep" "c.txt")) "sea\n")
                     (is (includes? (:echo done) "Renamed 3 entries"))
                     (assert= (editor/layers/buffer-type-for (ed-current-buf done)) :dired))))))
  (test "D deletes for good after a question that says there is no trash"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       asked (ed-update (dired-at m "sub") "D" 80 24)
                       done (ed-update asked "y" 80 24))
                   (do
                     (is (includes? (:echo asked) "no trash"))
                     (is (not (file/exists? (path/join tree "sub"))))
                     (is (not (includes? (:dired-names (ed-current-buf done)) "sub"))))))))
  (test "a host that refuses the listing is said, and no listing is shown"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "down") "")
                   (let (m (dired/ed-show-dired (ed-init (make-buffer "")) (remote dir)))
                     (do
                       (is (includes? (:echo m) "failed or dropped"))
                       (is (not (= (editor/layers/buffer-type-for (ed-current-buf m)) :dired))))))))))

(describe "a jump host that wants a password"
  (test "the ProxyCommand rides the hop's own shared connection"
    (binding (*program* "ssh"
              *control-dir* "/run/x")
      (let (proxy (seq/find (sshremote/ssh-argv (sshpath/parse "/ssh:bastion|ssh:web1:/x") "true")
                    (fn (a) (string/starts-with? a "ProxyCommand="))))
        (do
          (is (includes? proxy "ControlPath=/run/x/%%C"))
          (is (includes? proxy "ControlMaster=no"))))))
  (test "a host reached through a jump host keeps a socket of its own, apart from a direct one"
    (binding (*control-dir* "/run/x")
      (let (control-path (fn (argv)
                           (seq/find argv (fn (a) (string/starts-with? a "ControlPath="))))
            direct (control-path (sshremote/ssh-argv (sshpath/parse "/ssh:web1:/x") "true"))
            hopped (control-path (sshremote/ssh-argv (sshpath/parse "/ssh:bastion|ssh:web1:/x")
                                   "true")))
        (do
          (assert= direct "ControlPath=/run/x/%C")
          (is (string/ends-with? hopped "-%C"))
          (is (not (= direct hopped)))))))
  (test "a later hop's socket is the one its own connection opened, through the hops before it"
    (binding (*program* "ssh"
              *control-dir* "/run/x")
      (let (parts (sshpath/parse "/ssh:a|ssh:b|ssh:web1:/x")
            opened (seq/find (sshremote/ssh-argv (sshremote/hop-parts parts 1) "true")
                     (fn (a) (string/starts-with? a "ControlPath=")))
            proxy (seq/find (sshremote/ssh-argv parts "true")
                    (fn (a) (string/starts-with? a "ProxyCommand="))))
        (is (includes? proxy (string/replace opened "%" "%%"))))))
  (test "a hop is a host of its own, reached through the hops before it"
    (let (parts (sshpath/parse "/ssh:a|ssh:b|ssh:web1:/x"))
      (do
        (assert= (sshremote/hop-parts parts 0) {:user nil :host "a" :port nil})
        (assert= (sshremote/hop-parts parts 1)
          {:user nil :host "b" :port nil :hops [{:user nil :host "a" :port nil}]}))))
  (test "is named and asked for, masked; the file opens once it is typed"
    (with-stub (fn (dir)
                 (let (path (path/join dir "far.txt"))
                   (do
                     (file/spit path "far\n")
                     (file/spit (path/join dir "needpw-bastion") "")
                     (let (asked (ed-find-file (ed-init (make-buffer ""))
                                   (str "/ssh:bastion|ssh:web1:" path)))
                       (do
                         (is (map/get-in asked [:minibuffer :masked]))
                         (is (includes? (pr-str (:minibuffer asked)) "bastion (jump host)"))
                         (let (m (ed-update (type-text asked "secret") :enter 80 24))
                           (do
                             (assert= (buffer-text (ed-current-buf m)) "far\n")
                             (is (file/exists? (path/join dir "connected-bastion")))
                             (is (not (includes? (pr-str (dissoc m :buffers)) "secret"))))))))))))
  (test "a wrong one is said as the jump host's refusal"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "needpw-bastion") "")
                   (let (asked (ed-find-file (ed-init (make-buffer ""))
                                 (str "/ssh:bastion|ssh:web1:" (path/join dir "x")))
                         m (ed-update (type-text asked "nope") :enter 80 24))
                     (do
                       (is (includes? (:echo m) "bastion refused the password"))
                       (is (not (any? (:buffers m) :ssh-loading)))))))))
  (test "a failure of the target itself is still the target's"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "needpw-web1") "")
                   (let (asked (ed-find-file (ed-init (make-buffer ""))
                                 (str "/ssh:bastion|ssh:web1:" (path/join dir "x"))))
                     (is (includes? (pr-str (:minibuffer asked)) "Password for web1 ("))))))))

(describe "C-x C-j from a remote file"
  (test "lands on the file's line in the remote listing"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       _ (file/spit (path/join tree "z.txt") "zed\n")
                       opened (ed-find-file (ed-init (make-buffer ""))
                                (remote (path/join tree "z.txt")))
                       jumped (dired/cmd-dired-jump opened nil)
                       b (ed-current-buf jumped))
                   (do
                     (assert= (:dired-dir b) (remote tree))
                     (assert= (nth (:dired-names b) (dec (buffer-current-line b))) "z.txt"))))))
  (test "a listing that waits its turn still knows the entry"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       opened (ed-find-file (ed-init (make-buffer ""))
                                (remote (path/join tree "a.txt")))
                       jumped (dired/cmd-dired-jump (assoc opened :ssh-proc :busy) nil))
                   (assert= (:line (:job (first (:ssh-waiting jumped)))) "a.txt"))))))

(describe "remote dired replacing an entry"
  (test "C over a file there asks first; n leaves it, y replaces it"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       _ (file/spit (path/join tree "sub" "a.txt") "old\n")
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       asked (answer (ed-update (dired-at m "a.txt") "C" 80 24) "sub")
                       kept (ed-update asked "n" 80 24)
                       asked-again (answer (ed-update (dired-at kept "a.txt") "C" 80 24) "sub")
                       replaced (ed-update asked-again "y" 80 24))
                   (do
                     (is (includes? (:echo asked) "exists; overwrite it?"))
                     (is (includes? (:echo kept) "canceled"))
                     (assert= (file/slurp (path/join tree "sub" "a.txt")) "alpha\n")
                     (is (file/exists? (path/join tree "a.txt")))
                     (is (empty? (seq/filter (file/ls (path/join tree "sub"))
                                   (fn (n) (string/starts-with? n ".bedit-copy")))))
                     (is (includes? (:echo replaced) "Copied")))))))
  (test "R over a file there asks, then moves over it"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       _ (file/spit (path/join tree "b.txt") "bee\n")
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       asked (answer (ed-update (dired-at m "a.txt") "R" 80 24) "b.txt")
                       moved (ed-update asked "y" 80 24))
                   (do
                     (is (includes? (:echo asked) "exists; overwrite it?"))
                     (assert= (file/slurp (path/join tree "b.txt")) "alpha\n")
                     (is (not (file/exists? (path/join tree "a.txt"))))
                     (is (not (includes? (:dired-names (ed-current-buf moved)) "a.txt"))))))))
  (test "a directory there is never replaced"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       _ (file/mkdir (path/join tree "dest"))
                       _ (file/mkdir (path/join tree "dest" "sub"))
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       refused (answer (ed-update (dired-at m "sub") "C" 80 24) "dest"))
                   (is (includes? (:echo refused) "is a directory, not replaced")))))))

(describe "copy and move between machines"
  (test "C from a remote listing to this machine copies a directory with everything in it"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       local (path/join dir "local")
                       _ (file/mkdir local)
                       _ (file/spit (path/join tree "sub" "deep.txt") "deep\n")
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       copied (answer (ed-update (dired-at m "sub") "C" 80 24) local))
                   (do
                     (assert= (file/slurp (path/join local "sub" "deep.txt")) "deep\n")
                     (is (file/dir? (path/join tree "sub")))
                     (is (includes? (:echo copied) "Copied")))))))
  (test "the prompt in a remote listing starts at the entry's whole path"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       asked (ed-update (dired-at m "a.txt") "C" 80 24))
                   (assert= (minibuffer/mb-text (:minibuffer asked))
                     (remote (path/join tree "a.txt")))))))
  (test "C from a local listing to an ssh path copies there"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       far (path/join dir "far")
                       _ (file/mkdir far)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) tree)
                       copied (answer (ed-update (dired-at m "a.txt") "C" 80 24) (remote far)))
                   (do
                     (assert= (file/slurp (path/join far "a.txt")) "alpha\n")
                     (is (includes? (:echo copied) "Copied")))))))
  (test "R between two hosts removes the original once the copy landed"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       far (path/join dir "far")
                       _ (file/mkdir far)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       moved (answer (ed-update (dired-at m "a.txt") "R" 80 24)
                               (str "/ssh:web2:" far "/moved.txt")))
                   (do
                     (assert= (file/slurp (path/join far "moved.txt")) "alpha\n")
                     (is (not (file/exists? (path/join tree "a.txt"))))
                     (is (includes? (:echo moved) "Renamed")))))))
  (test "a copy that cannot land keeps the original"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       failed (answer (ed-update (dired-at m "a.txt") "R" 80 24)
                                (path/join dir "no" "such" "x.txt")))
                   (do
                     (is (file/exists? (path/join tree "a.txt")))
                     (is (includes? (:echo failed) "no such directory")))))))
  (test "a file there is asked about, and replaced"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       local (path/join dir "local")
                       _ (file/mkdir local)
                       _ (file/spit (path/join local "a.txt") "old\n")
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       asked (answer (ed-update (dired-at m "a.txt") "C" 80 24) local)
                       replaced (ed-update asked "y" 80 24))
                   (do
                     (is (includes? (:echo asked) "exists; overwrite it?"))
                     (assert= (file/slurp (path/join local "a.txt")) "alpha\n")
                     (is (includes? (:echo replaced) "Copied")))))))
  (test "a buffer visiting a file moved here follows it, and is a local buffer now"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       local (path/join dir "local")
                       _ (file/mkdir local)
                       listed (dired/ed-show-dired (ed-find-file (ed-init (make-buffer ""))
                                                     (remote (path/join tree "a.txt")))
                                (remote tree))
                       moved (answer (ed-update (dired-at listed "a.txt") "R" 80 24) local)
                       buffer (seq/find (:buffers moved)
                                (fn (b) (= (buffer-file b) (path/join local "a.txt")))))
                   (do
                     (is (not (nil? buffer)))
                     (is (not (:ssh buffer)))
                     (assert= (:dir buffer) local))))))
  (test "a copy between hosts STREAMS through a pipe, past the size a carried copy may take"
    (with-stub
      (fn (dir)
        (let (tree (remote-fixture dir)
              far (path/join dir "far")
              _ (file/mkdir far)
              big (string/repeat "0123456789abcdef\n" 4000)
              _ (file/spit (path/join tree "big.txt") big)
              went (binding (*transfer-max-bytes* 1000)
                     (sshremote/cross-transfer :move
                       (sshpath/parse (remote tree))
                       (path/join tree "big.txt")
                       (sshpath/parse (str "/ssh:web2:" far))
                       far
                       true
                       false))
              calls (file/slurp (path/join dir "ssh-calls")))
          (do
            (assert= went (path/join far "big.txt"))
            (assert= (file/slurp (path/join far "big.txt")) big)
            (is (not (file/exists? (path/join tree "big.txt"))))
            ;; the two sides of the pipe: the staged archive read on web1, the
            ;; receiver run on web2 — and neither temporary file left behind
            (is (regex/find "web1 cat -- /\\S*\\.bedit-pack\\." calls))
            (is (regex/find "web2 /bin/sh /\\S*\\.bedit-recv\\." calls))
            (is (empty? (seq/filter (file/ls (or (os/env "TMPDIR") "/tmp"))
                          (fn (name)
                            (and (string/starts-with? name ".bedit-recv.")
                              (includes? calls name)))))))))))
  (test "a streamed copy that arrives short or changed is refused, nothing left there"
    (let (staged {:name "a.txt" :count 1 :size 6 :digest (hash/sha256 "alpha\n")}
          target (temp-dir "bedit-ssh-")
          _ (file/mkdir target)
          deliver (fn (input)
                    (let (receiver (sshremote/run-local (sshremote/receiver-script target
                                                          staged true false "T"))
                          path (string/trim (:stdout receiver)))
                      (assoc (os/cmd "/bin/sh" [path] {:stdin input}) :path path)))
          short (deliver "alp")
          changed (deliver "alphX\n"))
      (do
        (assert= (:exit short) 4)
        (is (includes? (:stderr short) "3 of 6 bytes arrived; nothing was copied"))
        (is (includes? (:stderr changed) "the copy arrived changed; nothing was copied"))
        (is (not (file/exists? (:path short))))
        (is (empty? (file/ls target))))))
  (test "a side through a root hop is carried through the editor, within its limit"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       etc (path/join dir "etc")
                       _ (file/mkdir etc)
                       _ (file/spit (path/join tree "big.txt") (string/repeat "x" 5000))
                       went (binding (*transfer-max-bytes* 1000)
                              (sshremote/cross-transfer :copy
                                (sshpath/parse (remote tree))
                                (path/join tree "big.txt")
                                (sshpath/parse (str "/ssh:web1|sudo::" etc))
                                etc
                                true
                                false)))
                   (do
                     (is (failure? went))
                     (is (includes? (error-message went) "more than 1000 cross between machines"))
                     (is (not (file/exists? (path/join etc "big.txt")))))))))
  (test "the staged pack's answer"
    (let (staged (sshremote/parse-staged (str "a\n2\n10240\n"
                                           (hash/sha256 "x")
                                           "\n/tmp/.bedit-pack.Ab1\n")))
      (do (assert= (:count staged) 2) (assert= (:archive staged) "/tmp/.bedit-pack.Ab1")))
    (is (failure? (sshremote/parse-staged "a\n2\n10240\n-\n/tmp/it's here\n")))
    (is (failure? (sshremote/parse-staged "a\n2\n10240\nnot-a-hash\n/tmp/x\n"))))
  (test "the pack and its answer"
    (let (packed (sshremote/parse-pack "a\n1\n2\naGk=\n"))
      (do
        (assert= (:name packed) "a")
        (assert= (:bytes packed) (string/->bytes "hi"))))
    (is (failure? (sshremote/parse-pack "a\n1\n3\naGk=\n")))
    (is (failure? (sshremote/parse-pack "")))))

(describe "a file edited as root on another machine (`|sudo:`)"
  (test "is read as a sudo hop on the host before it"
    (let (parts (sshpath/parse "/ssh:me@web1|sudo::/etc/hosts"))
      (do
        (assert= (:become parts) {:method :sudo :user nil})
        (assert= (:host parts) "web1")
        (assert= (:path parts) "/etc/hosts")
        (assert= (sshpath/spec parts) "/ssh:me@web1|sudo::/etc/hosts")))
    (assert= (:become (sshpath/parse "/ssh:web1|sudo:www-data@web1:/srv"))
      {:method :sudo :user "www-data"})
    (assert= (sshpath/canonical "/ssh:web1|sudo:www@web1:/srv/./a") "/ssh:web1|sudo:www@:/srv/a")
    (assert= (sshpath/canonical "/ssh:j|ssh:web1|sudo::x") "/ssh:j|ssh:web1|sudo::~/x")
    (assert= (sshpath/dirname "/ssh:web1|sudo::/etc/hosts") "/ssh:web1|sudo::/etc")
    (is (not (sshpath/same-connection? "/ssh:web1|sudo::/a" "/ssh:web1:/a")))
    (each ["/ssh:web1|sudo:other:/x"
            "/ssh:web1|sudo:a;b@:/x" "/ssh:web1|sudo:-u@:/y" "/ssh:web1|sudo:/x"]
      (fn (spec) (is (nil? (sshpath/parse spec))))))
  (test "the remote command is words every login shell reads alike, the prompt in SUDO_PROMPT"
    ;; never `-p`: sudo-rs before 0.2.5 refuses the whole command over it
    (assert= (sshsudo/remote-command {:method :sudo :user nil})
      "env SUDO_PROMPT=BEDIT-SUDO-PASSWORD sudo -S -u root /bin/sh -c 'echo BEDIT-SUDO-READY; exec /bin/sh'"))
  (test "sudo's prompt is told apart however it is worded: classic sudo, sudo-rs old and new"
    (assert= (sshsudo/prompts-in {:method :sudo} "BEDIT-SUDO-PASSWORD") 1)
    (assert= (sshsudo/prompts-in {:method :sudo} "[sudo: BEDIT-SUDO-PASSWORD] Password: ") 1)
    (assert= (sshsudo/prompts-in {:method :sudo}
               "[sudo: authenticate] Password: \nAuthentication failed, try again.\n[sudo: authenticate] Password: ")
      2)
    (assert= (sshsudo/prompts-in {:method :sudo} "sudo: a password is required\n") 0))
  (test "a request's reply is read between its markers"
    (let (reply (sshsudo/parse-reply (str "noise\nBEDIT-OUT-T 0\n"
                                       (encoding/base64-encode (str "dir\n/etc\n"))
                                       "\nBEDIT-ERR-T\n\nBEDIT-END-T\n")
                  "T"))
      (do
        (assert= (:exit reply) 0)
        (assert= (:stdout reply) "dir\n/etc\n")
        (assert= (:stderr reply) "")))
    (is (nil? (sshsudo/parse-reply "BEDIT-OUT-T 0\n" "T"))))
  (test "opens and saves through a root shell there, sudo asking nothing (NOPASSWD)"
    (with-stub (fn (dir)
                 (let (path (path/join dir "hosts"))
                   (do
                     (file/spit path "127.0.0.1 localhost\n")
                     (let (m (ed-find-file (ed-init (make-buffer "")) (str "/ssh:web1|sudo::" path))
                           b (ed-current-buf m))
                       (do
                         (assert= (buffer-text b) "127.0.0.1 localhost\n")
                         (is (= true (:ssh b)))
                         (assert= (string/trim (file/slurp (path/join dir "sudo-user"))) "root")
                         (let (saved (file-save/ed-save-buf-at (ed-update m "#" 80 24)
                                       (ed-current-index m)))
                           (do
                             (assert= (file/slurp path) "#127.0.0.1 localhost\n")
                             (is (not (buffer-modified? (ed-current-buf saved))))))
                         (let (segment (sshedit/ssh-segment m nil b))
                           (is (includes? (pr-str segment) "@web1 # root"))))))))))
  (test "as another user"
    (with-stub (fn (dir)
                 (let (path (path/join dir "site.conf"))
                   (do
                     (file/spit path "x\n")
                     (ed-find-file (ed-init (make-buffer "")) (str "/ssh:web1|sudo:www@:" path))
                     (assert= (string/trim (file/slurp (path/join dir "sudo-user"))) "www"))))))
  (test "asks for sudo's password, masked, writes it once, and keeps it nowhere"
    (with-stub
      (fn (dir)
        (let (path (path/join dir "shadow"))
          (do
            (file/spit path "secret stuff\n")
            (file/spit (path/join dir "sudopw") "")
            (let (asked (ed-find-file (ed-init (make-buffer "")) (str "/ssh:web1|sudo::" path)))
              (do
                (is (map/get-in asked [:minibuffer :masked]))
                (is (includes? (pr-str (:minibuffer asked)) "sudo on web1"))
                (let (m (ed-update (type-text asked "rootpw") :enter 80 24))
                  (do
                    (assert= (buffer-text (ed-current-buf m)) "secret stuff\n")
                    (is (not (includes? (pr-str (dissoc m :buffers)) "rootpw")))
                    ;; the root shell stays open: the save asks nothing
                    (let (saved (file-save/ed-save-buf-at (ed-update m "#" 80 24)
                                  (ed-current-index m)))
                      (do
                        (is (nil? (:minibuffer saved)))
                        (assert= (file/slurp path) "#secret stuff\n"))))))))))))
  (test "a wrong password is said, and nothing opens"
    (with-stub (fn (dir)
                 (do
                   (file/spit (path/join dir "sudopw") "")
                   (let (asked (ed-find-file (ed-init (make-buffer ""))
                                 (str "/ssh:web1|sudo::" (path/join dir "x")))
                         m (ed-update (type-text asked "nope") :enter 80 24))
                     (do
                       (is (includes? (:echo m) "sudo on web1 refused the password"))
                       (is (not (any? (:buffers m) :ssh-loading)))))))))
  (test "dired lists a directory as root there, and a copy reaches it from the plain login"
    (with-stub (fn (dir)
                 (let (tree (remote-fixture dir)
                       etc (path/join dir "etc")
                       _ (file/mkdir etc)
                       m (dired/ed-show-dired (ed-init (make-buffer "")) (remote tree))
                       copied (answer (ed-update (dired-at m "a.txt") "C" 80 24)
                                (str "/ssh:web1|sudo::" etc)))
                   (do
                     (assert= (file/slurp (path/join etc "a.txt")) "alpha\n")
                     (is (includes? (:echo copied) "Copied"))
                     (let (listed (dired/ed-show-dired (ed-init (make-buffer ""))
                                    (str "/ssh:web1|sudo::" etc)))
                       (is (includes? (:dired-names (ed-current-buf listed)) "a.txt")))))))))

(defn- open-with-password (dir spec password)
  ;; `spec` opened, the masked prompt answered with `password`: `[asked answered]`
  (let (asked (ed-find-file (ed-init (make-buffer "")) spec))
    [asked (ed-update (type-text asked password) :enter 80 24)]))

(describe "sudo-rs as the host's sudo"
  (each [["before 0.2.5 (no -p, no SUDO_PROMPT)" "rs-old"]
          ["since 0.2.5 (SUDO_PROMPT bracketed)" "rs-new"]]
    (fn ([label flavour])
      (test (str "its password prompt is recognised: " label)
        (with-stub (fn (dir)
                     (let (path (path/join dir "shadow"))
                       (do
                         (file/spit path "secret stuff\n")
                         (file/spit (path/join dir "sudopw") "")
                         (file/spit (path/join dir "sudo-flavour") flavour)
                         (let ([asked m] (open-with-password dir
                                           (str "/ssh:web1|sudo::" path)
                                           "rootpw"))
                           (do
                             (is (map/get-in asked [:minibuffer :masked]))
                             (is (includes? (pr-str (:minibuffer asked)) "sudo on web1"))
                             (assert= (buffer-text (ed-current-buf m)) "secret stuff\n")
                             (let (saved (file-save/ed-save-buf-at (ed-update m "#" 80 24)
                                           (ed-current-index m)))
                               (do
                                 (assert= (file/slurp path) "#secret stuff\n")
                                 (is (not (buffer-modified? (ed-current-buf saved))))))))))))))))

(describe "a file edited as root through `|su:` and `|doas:`"
  (test "the paths read and spell back"
    (assert= (:become (sshpath/parse "/ssh:me@web1|su::/etc/hosts")) {:method :su :user nil})
    (assert= (:become (sshpath/parse "/ssh:web1|doas:www@web1:/srv")) {:method :doas :user "www"})
    (assert= (sshpath/canonical "/ssh:web1|su:root@:/etc/./x") "/ssh:web1|su:root@:/etc/x")
    (assert= (sshpath/dirname "/ssh:j|ssh:web1|doas::/etc/hosts") "/ssh:j|ssh:web1|doas::/etc")
    (is (not (sshpath/same-connection? "/ssh:web1|su::/a" "/ssh:web1|sudo::/a")))
    (each ["/ssh:web1|su:other:/x" "/ssh:web1|doas:a;b@:/x" "/ssh:web1|sux::/x"]
      (fn (spec) (is (nil? (sshpath/parse spec))))))
  (test "su and doas run on a terminal, the root shell raw and silent"
    (is (sshsudo/tty? {:method :su}))
    (is (sshsudo/tty? {:method :doas}))
    (is (not (sshsudo/tty? {:method :sudo})))
    (assert= (sshsudo/remote-command {:method :su :user nil})
      "env LC_ALL=C su - root -c 'stty raw -echo 2>/dev/null; echo BEDIT-SUDO-READY; exec /bin/sh 2>/dev/null'")
    (let (argv (sshremote/ssh-argv {:host "h"} "x" true true))
      (do (is (includes? argv "-tt")) (is (not (includes? argv "-T"))))))
  (test "su asks for root's password, masked, opens and saves, and the mode line says root"
    (with-stub (fn (dir)
                 (let (path (path/join dir "hosts"))
                   (do
                     (file/spit path "127.0.0.1 localhost\n")
                     (let ([asked m] (open-with-password dir (str "/ssh:web1|su::" path) "rootpw"))
                       (do
                         (is (map/get-in asked [:minibuffer :masked]))
                         (is (includes? (pr-str (:minibuffer asked))
                               "su on web1 (theirs, as su asks)"))
                         (is (file/exists? (path/join dir "tty-asked")))
                         (assert= (string/trim (file/slurp (path/join dir "su-user"))) "root")
                         (assert= (buffer-text (ed-current-buf m)) "127.0.0.1 localhost\n")
                         (is (not (includes? (pr-str (dissoc m :buffers)) "rootpw")))
                         (is (includes? (pr-str (sshedit/ssh-segment m nil (ed-current-buf m)))
                               "@web1 # root"))
                         (let (saved (file-save/ed-save-buf-at (ed-update m "#" 80 24)
                                       (ed-current-index m)))
                           (do
                             (is (nil? (:minibuffer saved)))
                             (assert= (file/slurp path) "#127.0.0.1 localhost\n"))))))))))
  (test "a wrong su password is said — su ends at once — and nothing opens"
    (with-stub (fn (dir)
                 (let ([_asked m] (open-with-password dir
                                    (str "/ssh:web1|su::" (path/join dir "x"))
                                    "nope"))
                   (do
                     (is (includes? (:echo m) "su on web1 refused the password"))
                     (is (not (any? (:buffers m) :ssh-loading))))))))
  (test "doas with `nopass` opens as the user named, asking nothing"
    (with-stub (fn (dir)
                 (let (path (path/join dir "site.conf"))
                   (do
                     (file/spit path "x\n")
                     (let (m (ed-find-file (ed-init (make-buffer ""))
                               (str "/ssh:web1|doas:www@:" path)))
                       (do
                         (assert= (buffer-text (ed-current-buf m)) "x\n")
                         (is (nil? (:minibuffer m)))
                         (assert= (string/trim (file/slurp (path/join dir "doas-user"))) "www"))))))))
  (test "doas asks for your password, and a wrong one is refused"
    (with-stub (fn (dir)
                 (let (path (path/join dir "hosts"))
                   (do
                     (file/spit path "doas\n")
                     (file/spit (path/join dir "doaspw") "")
                     (let ([_ wrong] (open-with-password dir (str "/ssh:web1|doas::" path) "nope"))
                       (is (includes? (:echo wrong) "doas on web1 refused the password")))
                     (let ([asked m] (open-with-password dir (str "/ssh:web1|doas::" path) "mypw"))
                       (do
                         (is (includes? (pr-str (:minibuffer asked)) "doas on web1 (yours there"))
                         (assert= (buffer-text (ed-current-buf m)) "doas\n")))))))))
