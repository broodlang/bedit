;; Grammar pinning (src/grammars.blsp) and the grammar check (src/grammarcheck.blsp): every
;; declared grammar names the revision bedit's tables were written against, an install
;; fetches exactly that revision, the grammar list says where each installed one stands, and
;; an installed grammar lacking a name the tables use is reported and stood in for. Nothing
;; here touches the network or a compiler — the fetch and build are stood in for — and the
;; grammar directory is a temporary one. The check against the REAL installed grammars runs
;; per language when its library is there, and skips otherwise.
(defmodule grammarpin-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use config-paths) ; *config-base* — a scratch config dir, never the user's grammars
  (:use grammars) ; *grammar-installer* — the fetch and build, stood in for
  (:use grammarcheck)) ; *grammar-problems* — a grammar of another revision, stood in for

;; loaded here, at file load, so the `when`s below see what is installed
(grammars/load-user-grammars)

(defn- file-model (text file) (ed-init (make-buffer text file file)))
(defn- file-buffer (text file) (ed-current-buf (file-model text file)))

(defn- declared-languages () (keys (registry/entries :grammars/sources)))

(purge-stale-temp "bedit-grammarpin-")

(defn- with-config (thunk)
  ;; `thunk` called with a fresh config base, whose bedit/grammars directory it may fill
  (let (base (temp-dir "bedit-grammarpin-"))
    (file/mkdir (path/join base "bedit" "grammars"))
    (let (result (binding (*config-base* base) (thunk base)))
      (file/rmdir base)
      result)))

(defn- write-library (lang text)
  ;; a stand-in library file for `lang` in the current grammar directory
  (let (path (grammars/ts-grammar-path lang)) (file/spit path text) path))

(defn- write-manifest (lang manifest)
  (file/spit (editor/grammar-install/grammar-manifest-path (grammars/ts-grammar-path lang))
    (pr-str manifest)))

(def pin-test-revision "0123456789abcdef0123456789abcdef01234567")
(def pin-test-fingerprint "0123abcd0123abcd0123abcd0123abcd0123abcd0123abcd0123abcd0123abcd")

(grammars/declare-grammar :pintest
  {:url "https://example.invalid/tree-sitter-pintest"
   :revision pin-test-revision
   :fingerprint pin-test-fingerprint})

(describe "every declared grammar is pinned"
  (test "each names its repository, a full commit hash and that revision's shape"
    (let (unpinned (seq/filter (declared-languages)
                     (fn (lang)
                       (let (source (model/grammar-source lang))
                         (not (and (map? source)
                                (string? (get source :url))
                                (regex/matches? (or (get source :revision) "") "[0-9a-f]{40}")
                                (regex/matches? (or (get source :fingerprint) "") "[0-9a-f]{64}"))))))
          ;; languages a test declared for itself
          real-unpinned (seq/filter unpinned
                          (fn (lang) (not (contains? #{:bedit-test-language :pkgsreg} lang)))))
      (assert= real-unpinned '())))

  (test "the languages bedit ships each have one"
    (doseq (lang [:python
                   :rust :go :c :javascript :typescript :tsx :gomod :hcl :bash :json :toml :yaml
                   :dockerfile :css :html :c-sharp :heex :elixir])
      (is (string? (grammars/grammar-pin lang)))))

  (test "TypeScript and TSX share one repository, one revision, two directories"
    (let (typescript (model/grammar-source :typescript)
          tsx (model/grammar-source :tsx))
      (assert= (:url typescript) (:url tsx))
      (assert= (:revision typescript) (:revision tsx))
      (assert= [(:subdir typescript) (:subdir tsx)] ["typescript" "tsx"]))))

(describe "at-pin?: is an install the pinned revision"
  (test "by the revision it asked for, or the commit it resolved to"
    (is (grammars/at-pin? {:revision "v1.0" :commit "aaa"} "v1.0"))
    (is (grammars/at-pin? {:revision nil :commit pin-test-revision} pin-test-revision))
    (is (grammars/at-pin? {:revision nil :commit pin-test-revision} "0123456789ab"))
    (refute (grammars/at-pin? {:revision nil :commit "fedcba"} pin-test-revision))
    (refute (grammars/at-pin? nil pin-test-revision))
    (refute (grammars/at-pin? {:commit pin-test-revision} nil))))

(describe "pin-state: the installed grammar against its pin"
  (test "missing, unknown, pinned, other and replaced"
    (with-config
      (fn (_base)
        (assert= (:state (grammars/pin-state :pintest)) :missing)
        (let (library (write-library :pintest "not really a library"))
          ;; built by hand: no manifest, so no revision to compare
          (assert= (:state (grammars/pin-state :pintest)) :unknown)
          (write-manifest :pintest
            {:revision pin-test-revision
             :commit pin-test-revision
             :sha256 (editor/grammar-install/grammar-file-hash library)})
          (assert= (grammars/pin-state :pintest)
            {:state :pinned :pin pin-test-revision :installed pin-test-revision})
          (write-manifest :pintest
            {:revision nil
             :commit "fedcba9876543210"
             :sha256 (editor/grammar-install/grammar-file-hash library)})
          (assert= (grammars/pin-state :pintest)
            {:state :other :pin pin-test-revision :installed "fedcba9876543210"})
          ;; the library swapped under its manifest: the manifest no longer describes it
          (write-library :pintest "another library")
          (assert= (:state (grammars/pin-state :pintest)) :replaced)))))

  (test "a language that declared no revision is unpinned"
    (grammars/declare-grammar :pintest-loose "https://example.invalid/tree-sitter-loose")
    (assert= (:state (grammars/pin-state :pintest-loose)) :unpinned)))

;; A library built by hand has no manifest; its SHAPE says whether it is the pinned revision.
;; The library's shape is stood in for (`*library-fingerprint*`): this file builds no grammar.
(describe "a library with no manifest is compared with the pin by its shape"
  (test "the pin's shape: at the pin, not offered for update, said so in the list"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (binding (*library-fingerprint* (fn (_lang _path) pin-test-fingerprint))
                     (assert= (:state (grammars/pin-state :pintest)) :shape-match)
                     (refute (includes? (grammars/outdated-grammars) :pintest))
                     (is (includes? (grammars/grammar-report)
                           "at pin 0123456789ab (matched by its shape"))))))

  (test "another shape: differs from the pin, offered for update, said so in the list"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (binding (*library-fingerprint* (fn (_lang _path)
                                                     (str "ff"
                                                       (string/substring pin-test-fingerprint 2))))
                     (assert= (:state (grammars/pin-state :pintest)) :shape-differs)
                     (is (includes? (grammars/outdated-grammars) :pintest))
                     (is (includes? (grammars/grammar-report) "DIFFERS from pin 0123456789ab"))))))

  (test "a library replaced under its manifest is judged by its shape too"
    (with-config (fn (_base)
                   (write-library :pintest "first")
                   (write-manifest :pintest
                     {:revision pin-test-revision :commit pin-test-revision :sha256 "stale"})
                   (binding (*library-fingerprint* (fn (_lang _path) pin-test-fingerprint))
                     (assert= (:state (grammars/pin-state :pintest)) :shape-match)))))

  (test "a shape that cannot be read leaves it unknown, and offered"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (binding (*library-fingerprint* (fn (_lang _path) nil))
                     (assert= (:state (grammars/pin-state :pintest)) :unknown)
                     (is (includes? (grammars/outdated-grammars) :pintest)))))))

;; The pinned fingerprints are the shapes of the libraries the pins were rebuilt into: an
;; installed grammar with no manifest, at its pin, must match. Per language, where installed.
(describe "the installed grammars are at their pins"
  (test "no installed grammar differs from its pin"
    (let (states (into {}
                   (seq/keep (declared-languages)
                     (fn (lang)
                       (when (not (contains? #{:pintest :pintest-loose} lang))
                         (let (state (:state (grammars/pin-state lang)))
                           (when (not (contains? #{:missing :pinned :shape-match :unpinned} state))
                             [lang state])))))))
      (assert= states {}))))

(describe "grammar-install fetches the pinned revision"
  (test "the installer is asked for the url, the subdir and the revision"
    (let (asked (with-config (fn (_base)
                               (binding (*grammar-installer* (fn (url lang
                                                                   out-dir _work-dir options)
                                                               {:error (pr-str [url
                                                                                 lang
                                                                                 (path/basename out-dir)
                                                                                 options])}))
                                 (:echo (grammars/grammar-install-start (ed-init (make-buffer ""
                                                                                   "x"))
                                          :tsx))))))
      (is (includes? asked "https://github.com/tree-sitter/tree-sitter-typescript"))
      (is (includes? asked ":tsx"))
      (is (includes? asked ":subdir \"tsx\""))
      (is (includes? asked (str ":revision \"" (grammars/grammar-pin :tsx) "\"")))))

  (test "a failed build says which language and why, and nothing arrives"
    (let (echo (with-config (fn (_base)
                              (binding (*grammar-installer* (fn (& _) {:error "cc failed: boom"}))
                                (:echo (grammars/grammar-install-start (ed-init (make-buffer "" "x"))
                                         :pintest))))))
      (assert= echo "grammar-install pintest: cc failed: boom")))

  (test "several languages are installed in turn, each reported"
    (let (asked (with-config (fn (_base)
                               (binding (*grammar-installer* (fn (_url lang & _)
                                                               {:error (str "no " (->string lang))}))
                                 (:echo (grammars/grammar-install-start (ed-init (make-buffer ""
                                                                                   "x"))
                                          [:pintest :tsx]))))))
      (assert= asked "grammar-install pintest: no pintest; tsx: no tsx")))

  ;; brood ADR-660: a freshly built library is vetted in a child, with its own test corpus,
  ;; before anything loads it. The vetting is stood in for.
  (test "a build its vetting quarantines is said so, and is not loaded"
    (let (vetted (table/new)
          echo (with-config (fn (_base)
                              (binding (*grammar-installer* (fn (& _)
                                                              {:ok "/nowhere/libtree-sitter-pintest.so"
                                                               :commit pin-test-revision})
                                        *grammar-vetter* (fn (library lang checkout)
                                                           (table/put vetted
                                                             :asked [library lang (path/basename checkout)])
                                                           {:verdict :quarantined
                                                            :reason "it stopped answering for 10000 ms while loading"}))
                                (:echo (grammars/grammar-install-start (ed-init (make-buffer "" "x"))
                                         :pintest))))))
      (assert= (table/get vetted :asked) ["/nowhere/libtree-sitter-pintest.so" :pintest "pintest"])
      (assert= echo
        "grammar-install pintest: built, but QUARANTINED — it stopped answering for 10000 ms while loading — not loaded"))))

(describe "declared grammars vetted at startup (brood ADR-672)"
  (test "off the caller's process, with the vetter bound when it was started"
    (let (caller (self)
          pid (binding (*grammar-prevetter* (fn ()
                                              (send caller [:vetted (self)])
                                              {:pintest {:verdict :passed :cached true}}))
                (grammars/prevet-declared-grammars)))
      (refute (= pid caller))
      (assert= (receive ([:vetted from] from) (after 5000 :timeout)) pid)))
  (test "a vetter that fails is no verdict, and the process ends normally"
    (let (pid (binding (*grammar-prevetter* (fn ()
                                              (receive ([:go] nil))
                                              (error "no child could start")))
                (grammars/prevet-declared-grammars))
          ref (monitor pid))
      (send pid [:go])
      (assert= (receive ([:down ^ref _ reason] reason) (after 5000 :timeout)) :normal))))

(describe "M-x grammar-reload vets each library before loading it (brood ADR-660)"
  (test "a quarantined library is said and not loaded; the vetter is asked with its path"
    (let (asked (table/new)
          echo (with-config (fn (_base)
                              (let (library (write-library :pintest "built by hand"))
                                (binding (*grammar-vetter* (fn (path lang checkout)
                                                             (table/put asked
                                                               :asked [path lang checkout])
                                                             {:verdict :quarantined
                                                              :reason "it crashed parsing input 3"}))
                                  [library
                                    (:echo (grammars/cmd-grammar-reload (ed-init (make-buffer ""
                                                                                   "x"))
                                             nil))]))))
          [library said] echo)
      ;; no checkout beside a hand-built library: vetted without a corpus
      (assert= (table/get asked :asked) [library :pintest nil])
      (assert= said "grammar-reload: pintest QUARANTINED — it crashed parsing input 3 — not loaded")))

  (test "a library that passed is loaded, and one that will not load is said"
    (let (said (with-config (fn (_base)
                              (write-library :pintest "not a library")
                              (binding (*grammar-vetter* (fn (& _) {:verdict :passed}))
                                (:echo (grammars/cmd-grammar-reload (ed-init (make-buffer "" "x"))
                                         nil))))))
      (assert= said "grammar-reload: pintest did not load — see *Messages*")))

  (test "an empty grammar directory starts no vetting"
    (let (said (with-config (fn (_base)
                              (binding (*grammar-vetter* (fn (& _) (error "vetted nothing")))
                                (:echo (grammars/cmd-grammar-reload (ed-init (make-buffer "" "x"))
                                         nil))))))
      (is (string/starts-with? said "no grammars in "))))

  (test "inside a loop the vetting is a task, folded when its reply lands"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (let (vetter (fn (& _) {:verdict :quarantined :reason "it hung"})
                         started (binding (editor/ui/*loop* (self) *grammar-vetter* vetter)
                                   (grammars/cmd-grammar-reload (ed-init (make-buffer "" "x")) nil))
                         handle (:grammar-reload-proc started))
                     (refute (nil? handle))
                     (is (includes? (:echo started) "vetting 1 grammar"))
                     (receive
                       ([:task-done ^handle value] (let (landed (input/ed-update started
                                                                  [:task-done handle value]
                                                                  80
                                                                  24))
                                                     (assert= (:grammar-reload-proc landed) nil)
                                                     (assert= (:echo landed)
                                                       "grammar-reload: pintest QUARANTINED — it hung — not loaded")))
                       (after 5000 (assert= :task-reply :never-landed)))))))

  (test "C-g cancels the vetting in flight and loads nothing"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (let (started (binding (editor/ui/*loop* (self)
                                           *grammar-vetter* (fn (& _) (receive (after 100000 nil))))
                                   (grammars/cmd-grammar-reload (ed-init (make-buffer "" "x")) nil))
                         [quit cancelled?] (ed-cancel-quit-jobs started))
                     (refute (nil? (:grammar-reload-proc started)))
                     (is cancelled?)
                     (assert= (:grammar-reload-proc quit) nil)))))

  (test "a vetting that failed or timed out loads nothing, and says so"
    (let (landed (grammars/grammar-reload-apply (assoc (ed-init (make-buffer "" "x"))
                                                  :grammar-reload-proc :h)
                   nil))
      (assert= (:grammar-reload-proc landed) nil)
      (is (includes? (:echo landed) "nothing reloaded")))))

(describe "a quarantined grammar in the grammar list"
  (test "its row says why, and the library is not loaded to ask its ABI"
    (with-config (fn (_base)
                   (write-library :pintest "built by hand")
                   (binding (*library-fingerprint* (fn (_lang _path) nil)
                             *grammar-verdict* (fn (_path)
                                                 {:verdict :quarantined
                                                  :by :crash
                                                  :reason "it crashed a runtime"
                                                  :signal "SIGSEGV"}))
                     (let (report (grammars/grammar-report))
                       (is (includes? report
                             "QUARANTINED: it crashed a runtime (SIGSEGV) — it crashed bedit"))
                       (is (includes? report "pintest      abi -"))))))))

(describe "grammar-update offers what is not at its pin"
  (test "an install at another revision is outdated; one at the pin is not"
    (with-config (fn (_base)
                   (let (library (write-library :pintest "x"))
                     (write-manifest :pintest
                       {:revision nil
                        :commit "fedcba"
                        :sha256 (editor/grammar-install/grammar-file-hash library)})
                     (is (includes? (grammars/outdated-grammars) :pintest))
                     (write-manifest :pintest
                       {:revision pin-test-revision
                        :commit pin-test-revision
                        :sha256 (editor/grammar-install/grammar-file-hash library)})
                     (refute (includes? (grammars/outdated-grammars) :pintest))))))

  (test "the grammar list says pinned, or the mismatch"
    (with-config
      (fn (_base)
        (let (library (write-library :pintest "x"))
          (write-manifest :pintest
            {:revision nil
             :commit "fedcba9876543210"
             :sha256 (editor/grammar-install/grammar-file-hash library)})
          ;; the stand-in library does not load, so its row stops at the ABI's message
          (is (includes? (grammars/grammar-report)
                "MISMATCH installed fedcba987654, pinned 0123456789ab")))))))

;; ---- the check: names the tables use against the grammar installed ----------------------

(describe "grammarcheck: a verdict per grammar, asked once"
  (test "the problems are asked once and kept until forgotten"
    (let (calls (table/new)
          stub (fn (lang _names)
                 (table/incr calls :n)
                 (list (str "node kind `gone` is not in the :" (->string lang) " grammar"))))
      (grammarcheck/forget :pinverdict)
      (binding (*grammar-problems* stub *verdict-scope* :pin-test-verdict)
        (assert= (grammarcheck/verdict :pinverdict)
          '("node kind `gone` is not in the :pinverdict grammar"))
        (grammarcheck/verdict :pinverdict)
        (refute (grammarcheck/sound? :pinverdict))
        (assert= (table/get calls :n) 1)
        (grammarcheck/forget :pinverdict)
        (grammarcheck/verdict :pinverdict)
        (assert= (table/get calls :n) 2))
      (grammarcheck/forget :pinverdict)))

  (test "the names of every mode over a grammar are checked together"
    (grammarcheck/expect-names :pinunion :a {:kinds #{:x} :fields #{:f}})
    (grammarcheck/expect-names :pinunion :b {:kinds #{:y} :fields #{}})
    (assert= (grammarcheck/expected-names :pinunion) {:kinds #{:x :y} :fields #{:f}}))

  (test "a language's names come from its whole spec"
    (let (names (grammarcheck/expected-names :hcl))
      ;; the face table, the indent spec (a heredoc is verbatim), and Terraform's own table
      (is (contains? (:kinds names) :heredoc_template))
      (is (contains? (:kinds names) :block))))

  (test "the report names the language, the missing names and the remedy"
    (let (line (grammarcheck/report-line :hcl
                 '("node kind `a` is not in the :hcl grammar" "b" "c" "d" "e")))
      (is (includes? line "node kind `a`"))
      (is (includes? line "(and 2 more)"))
      (is (includes? line "M-x grammar-update")))))

;; The pins are the revisions the specs were written against, so the grammars installed at
;; them must have every name the specs use. Per language, where its library is installed.
(describe "the installed grammars have every name bedit's tables use"
  (test "no installed grammar lacks a kind or field its modes name"
    (let (checked (seq/filter (declared-languages)
                    (fn (lang)
                      (and (grammar-loadable? lang)
                        (not (contains? #{:pintest :pintest-loose} lang)))))
          failing (into {}
                    (seq/keep checked
                      (fn (lang)
                        (grammarcheck/forget lang)
                        (let (problems (grammarcheck/verdict lang))
                          (when (not (empty? problems)) [lang problems]))))))
      (assert= failing {}))))

;; A grammar of another revision, made by asking the installed one for a name it never had:
;; the same verdict a renamed node gives, with no second library. Stood in for in this test's
;; own verdict scope, so the runtime's JSON (every other test's) is never touched.
(when (grammar-loadable? :json)
  (describe "a grammar lacking a name the tables use stands in with its line lexer"
    (test "the JSON buffer is the lexer mode, and its note says why and what to run"
      (let (real *grammar-problems*
            drifted (fn (lang names)
                      (if (= lang :json)
                        (real lang
                          (update names :kinds (fn (kinds) (conj kinds :no_such_json_node))))
                        (real lang names))))
        (binding (*grammar-problems* drifted *verdict-scope* :pin-test-drift)
          (let (buf (file-buffer "{\"a\": 1}\n" "/p/x.json")
                note (model/missing-note buf))
            (refute (grammar-ready? :json))
            (assert= (:grammar-wanted buf) :json)
            (is (includes? note "not the revision bedit expects"))
            (is (includes? note "no_such_json_node"))
            (is (includes? note "M-x grammar-update"))
            (is (includes? (grammars/outdated-grammars) :json))))
        ;; outside the scope the runtime's JSON grammar is sound, as it was
        (is (grammar-ready? :json))))))
