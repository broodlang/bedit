;; Tests for the editor. The pane loop (`ui-run`) needs a display, so it's not
;; tested here; we test the pure pieces exactly as they run in the loop:
;; `ed-update` (key + model -> model, via the keymap / minibuffer), the model
;; accessors, `message`, the C-x C-e eval command, the region/undo/buffer commands,
;; and `ed-view` (model -> render frame). These run under plain `nest test` — no GUI
;; build needed (but the eval tests need a `nest` whose prelude has `with-out-str`).
(defmodule editing-test
  (:use scroll) ; ed-scroll / ed-max-top / ed-wrap? — keeping point on screen
  (:use model) ; ed-init / ed-scroll / message / current-buffer accessors
  (:use-internals input) ; ed-update
  (:use-internals view) ; ed-view
  (:use commands) ; ed-has-editable? / the editor commands
  (:use main) ; start-logging — the supervised logger
  (:use editor/buffer)
  (:use test))

(purge-stale-temp "bedit-") ; drop fixtures a prior run left in /tmp (at load)
;; A model over a fresh buffer of `text`, the starting point for edits.
(defn m-of (text) (ed-init (make-buffer text)))
;; The current (active) buffer of a model.
(defn cur (m) (ed-current-buf m))
;; The current buffer's text after folding key `k` into a model over `text`.
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
;; Fold a sequence of keys into a model — for chords like [:ctrl-x :ctrl-e].
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
;; Type a string into a model one printable key at a time (for the minibuffer).
(defn type-str (m s) (press m (string/->list s)))

;; A model whose current buffer is a brood-mode (.blsp) buffer of `text`, point at `p`.
(defn blsp-cm (text p)
  (let (m (ed-init (make-buffer text "x.blsp" "x.blsp")))
    (ed-set-buf m (goto-char (ed-current-buf m) p))))

(describe "editor edits"
  (test "a printable key inserts at point"
    (assert= (after "ac" "b") "bac")) ; point starts at 0
  (test "Enter splits the line at point"
    (let (m (ed-update (ed-set-buf (m-of "abcd") (goto-char (cur (m-of "abcd")) 2)) :enter 80 24))
      (assert= (buffer-text (cur m)) "ab\ncd")))
  (test "Backspace deletes the char before point"
    (let (m (ed-update (ed-set-buf (m-of "") (forward-char (make-buffer "abc") 2)) :backspace 80 24))
      (assert= (buffer-text (cur m)) "ac")))
  (test "Delete removes the char after point"
    (assert= (after "abc" :delete) "bc"))
  (test "a resize event is a no-op on content (re-render only, echo preserved)"
    (let (m (message (m-of "hello") "note")
          r (ed-update m [:resize 100 30] 80 24))
      (assert= (buffer-text (cur r)) "hello")
      (assert= (:echo r) "note")))) ; resize doesn't clear the echo
(describe "typing an opening bracket (electric pair, and wrapping a selection)"
  ;; The other half of electric-pair-mode: an opener types its pair and lands inside; a
  ;; backspace between an empty pair takes both; and an opener typed over an ACTIVE REGION
  ;; wraps the region — always, whatever the mode says. The mechanism is std's
  ;; (`insert-pair`, `delete-empty-pair`, `sexp/wrap-region`); these pin the WIRING and the
  ;; toggle. brood-keymap only: a text-mode buffer types the bare character.
  (defn typed (text p k)
    (let (m (ed-update (blsp-cm text p) k 80 24))
      [(buffer-text (cur m)) (buffer-point (cur m))]))
  (defn typed-off (text p k)
    (let (m (ed-update (assoc (blsp-cm text p) :electric-pair? false) k 80 24))
      [(buffer-text (cur m)) (buffer-point (cur m))]))

  (test "an opener types its pair and leaves point inside"
    (assert= (typed "ab" 1 "(") ["a()b" 2])
    (assert= (typed "ab" 1 "[") ["a[]b" 2])
    (assert= (typed "ab" 1 "{") ["a{}b" 2]))

  (test "a double-quote is a self-closing pair: opens a string, steps over its own close"
    ;; a quote plausibly OPENS one — at a bracket, after whitespace, at the edge — so it pairs
    (assert= (typed "(x)" 1 "\"") ["(\"\"x)" 2])
    (assert= (typed "a b" 2 "\"") ["a \"\"b" 3])
    (assert= (typed "" 0 "\"") ["\"\"" 1])
    ;; sitting at a closing quote, one more steps over it rather than doubling
    (assert= (typed "a\"\"b" 2 "\"") ["a\"\"b" 3])
    ;; after a word it self-inserts — how you close a string you typed by hand
    (assert= (typed "ab" 2 "\"") ["ab\"" 3])
    ;; backspace between an empty string takes both quotes
    (assert= (typed "a\"\"b" 2 :backspace) ["ab" 1])
    ;; a quote wraps an active region like any pair (mark 2, point 3 in "a b c")
    (let (m (ed-set-buf (blsp-cm "a b c" 3) (assoc (cur (blsp-cm "a b c" 3)) :mark 2))
          w (ed-update m "\"" 80 24))
      (assert= (buffer-text (cur w)) "a \"b\" c")))

  (test "a backspace between an empty pair takes both; elsewhere it is an ordinary backspace"
    (assert= (typed "a()b" 2 :backspace) ["ab" 1])
    (assert= (typed "a(x)b" 2 :backspace) ["ax)b" 1])
    (assert= (typed "a[)b" 2 :backspace) ["a)b" 1]))

  (test "with the mode off an opener is just a character, and backspace just a backspace"
    (assert= (typed-off "ab" 1 "(") ["a(b" 2])
    (assert= (typed-off "a()b" 2 :backspace) ["a)b" 1]))

  (test "M-x electric-pair-mode toggles it, and says so"
    (let (m (blsp-cm "ab" 1)
          off (commands/cmd-electric-pair-mode m nil)
          on (commands/cmd-electric-pair-mode off nil))
      (is (electric-pair? m)) ; the default
      (is (not (electric-pair? off)))
      (is (includes? (:echo off) "disabled"))
      (is (electric-pair? on))
      (assert= (buffer-text (cur (ed-update off "(" 80 24))) "a(b")
      (assert= (buffer-text (cur (ed-update on "(" 80 24))) "a()b")))

  (test "an opener over an active region wraps the region, point inside the opener, mark dropped"
    (let (m (ed-set-buf (blsp-cm "a b c" 3) (assoc (cur (blsp-cm "a b c" 3)) :mark 2))
          w (ed-update m "(" 80 24))
      (assert= (buffer-text (cur w)) "a (b) c")
      (assert= (buffer-point (cur w)) 3)
      (assert= (buffer-mark (cur w)) nil)
      ;; …and with the electric half off, the wrap still happens: one meaning
      (let (w2 (ed-update (assoc m :electric-pair? false) "[" 80 24))
        (assert= (buffer-text (cur w2)) "a [b] c"))))

  (test "text-mode pairs too, as Emacs's global electric-pair-mode does"
    (assert= (after "ab" "(") "()ab")
    (let (m (ed-update (ed-set-buf (m-of "a()b") (goto-char (cur (m-of "a()b")) 2))
              :backspace 80 24))
      ;; between an empty pair, backspace takes both
      (assert= (buffer-text (cur m)) "ab"))))

(describe "typing a closing delimiter (electric-pair skip)"
  ;; With point at `(+ 1 2|)`, typing `)` should step over the one already there rather than
  ;; leave `(+ 1 2))` — Emacs's `electric-pair-mode` skip. The predicate is
  ;; `editor/highlight/closer-redundant?`; what these pin is the WIRING: bound on
  ;; brood-keymap, moving point instead of editing, and falling through to a plain
  ;; self-insert everywhere else.
  (defn typed (text p k)
    (let (m (ed-update (blsp-cm text p) k 80 24))
      [(buffer-text (cur m)) (buffer-point (cur m))]))

  (test "the closer already there is stepped over, not typed again"
    (assert= (typed "(+ 1 2)" 6 ")") ["(+ 1 2)" 7])
    (assert= (typed "[1 2]" 4 "]") ["[1 2]" 5])
    (assert= (typed "{:a 1}" 5 "}") ["{:a 1}" 6]))

  ;; The inner form's closer is stepped over; the outer one still has to be typed, so two
  ;; presses balance `(foo (bar` exactly.
  (test "two presses close two forms"
    (assert= (typed "(foo (bar)" 9 ")") ["(foo (bar)" 10])
    (assert= (typed "(foo (bar)" 10 ")") ["(foo (bar))" 11]))

  (test "a closer that closes nothing is typed, like any other character"
    (assert= (typed "(+ 1 2)" 7 ")") ["(+ 1 2))" 8])
    (assert= (typed "[1 2)" 4 ")") ["[1 2))" 5]))

  ;; `(str ";)")` — point 7 sits on the `)` INSIDE the string, where a bracket is a
  ;; character rather than structure, so it is typed.
  (test "inside a string a bracket is a character"
    (assert= (typed "(str \";)\")" 7 ")") ["(str \";))\")" 8]))

  ;; Brood syntax only: the scan reads `;` as a comment start, which a plain text buffer's
  ;; content is not, so an ordinary buffer keeps plain self-insert.
  (test "a plain text buffer just types the character"
    (assert= (after "()" ")") ")()")))

(describe "editor movement"
  (test "Right then a key inserts one char over"
    (assert= (buffer-text (cur (press (m-of "ac") [:right "b"]))) "abc"))
  (test "C-f then a key inserts one char over (Emacs binding)"
    (assert= (buffer-text (cur (press (m-of "ac") [:ctrl-f "b"]))) "abc"))
  (test "Down (and C-n) move point to the next line"
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :down 80 24))) 1)
    (assert= (buffer-current-line (cur (ed-update (m-of "abc\ndef") :ctrl-n 80 24))) 1))
  (test "M-f / M-b move by word"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:alt-f]))) 3) ; end of "foo"
    (assert= (buffer-point (cur (press (m-of "foo bar") [:end :alt-b]))) 4)) ; start of "bar"
  (test "M-> / M-< jump to buffer end / start"
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->")]))) 7) ; end of buffer
    (assert= (buffer-point (cur (press (m-of "abc\ndef") [(keyword "alt->") (keyword "alt-<")]))) 0))
  (test "C-v / PageDown scroll forward a screenful, M-v / PageUp back"
    ;; rows=24 -> view-rows=22 -> a page step of 21 lines, over a 31-line buffer
    (let (text (apply str (map (range 30) (fn (i) (str "L" i "\n"))))
          down (ed-update (m-of text) :ctrl-v 80 24)
          back (ed-update down :alt-v 80 24)
          pgdn (ed-update (m-of text) :page-down 80 24))
      (assert= (buffer-current-line (cur down)) 21)
      (assert= (buffer-current-line (cur back)) 0)
      (assert= (buffer-current-line (cur pgdn)) 21)))) ; PageDown == C-v
(describe "a held key (the desktop repeats it; bedit keeps no state about it)"
  (test "a press moves once, with no repeat timer of bedit's own"
    (let (m (ed-update (m-of "a\nb\nc\nd") :ctrl-n 80 24))
      (assert= (buffer-current-line (cur m)) 1)
      (is (nil? (map/get-in m [:timers :key-repeat])))))
  (test "the desktop's repeats are presses: each one moves again"
    (let (m (press (m-of "a\nb\nc\nd\ne") [:ctrl-n :ctrl-n :ctrl-n]))
      (assert= (buffer-current-line (cur m)) 3)))
  (test "a key's release changes nothing — it is not dispatched as a key"
    (let (m1 (ed-update (m-of "a\nb\nc") :ctrl-n 80 24)
          m2 (ed-update m1 [:key-up :ctrl-n] 80 24))
      (assert= (buffer-text (cur m2)) (buffer-text (cur m1)))
      (assert= (buffer-point (cur m2)) (buffer-point (cur m1)))))
  (test "losing focus hollows the caret and stops the blink; focus back restores both"
    (let (m2 (ed-update (ed-update (m-of "a\nb\nc") :ctrl-n 80 24) :blur 80 24)
          caret-of (fn (m)
                     (seq/find (ed-view m 80 24)
                       (fn (op) (and (vector? op) (= (first op) :cursor))))))
      (is (:unfocused m2))
      ;; an unfocused window does not blink (its caret is a still, hollow box)
      (assert= (count (caret-of m2)) 5)
      (assert= (nth (caret-of m2) 3) :hollow)
      (let (back (ed-update m2 :focus-in 80 24))
        (is (nil? (:unfocused back)))
        (is (map? (nth (caret-of back) 5)))))))

(describe "input-method text (brood ADR-441's [:text …] and [:preedit …])"
  (test "committed text is typed character by character"
    (let (m (ed-update (m-of "") [:text "日本語"] 80 24))
      (assert= (buffer-text (cur m)) "日本語")))
  (test "a composition in progress is shown, not inserted, and the commit ends it"
    (let (composing (ed-update (m-of "") [:preedit "にほ" [2 2]] 80 24)
          committed (ed-update composing [:text "日本"] 80 24))
      (assert= (map/get-in composing [:preedit :text]) "にほ")
      (assert= (buffer-text (cur composing)) "")
      (is (nil? (:preedit committed)))
      (assert= (buffer-text (cur committed)) "日本")))
  (test "an empty preedit clears the composition"
    (let (m (ed-update (ed-update (m-of "") [:preedit "に" nil] 80 24) [:preedit "" nil] 80 24))
      (is (nil? (:preedit m)))))
  (test "a key that reaches the editor ends a composition left showing (a cancelled one)"
    (let (m (ed-update (ed-update (m-of "") [:preedit "に" nil] 80 24) "a" 80 24))
      (is (nil? (:preedit m)))
      (assert= (buffer-text (cur m)) "a")))
  (test "the window losing focus clears the composition"
    (let (m (ed-update (ed-update (m-of "") [:preedit "に" nil] 80 24) :blur 80 24))
      (is (nil? (:preedit m)))
      (is (:unfocused m))))
  (test "a keyboard macro records committed text, and not the window regaining focus"
    (let (m (press (assoc (m-of "") :macro-recording [])
              [[:text "日本"] :focus-in [:preedit "に" nil]]))
      (assert= (:macro-recording m) [[:text "日本"]]))))

(describe "repeat-mode (Emacs: tap the last key again to repeat a command)"
  (test "a repeatable chord command arms :repeat with its last key + command"
    (let (m (press (m-of "x") [:ctrl-x "o"]))
      ; C-x o = other-pane
      (assert= (map/get-in m [:repeat :key]) "o")
      (assert= (map/get-in m [:repeat :command]) 'commands/cmd-other-pane)))
  (test "tapping the repeat key again keeps repeat-mode armed"
    (assert= (map/get-in (press (m-of "x") [:ctrl-x "o" "o"]) [:repeat :key]) "o"))
  (test "any other key exits repeat-mode and dispatches normally"
    (let (m (press (m-of "") [:ctrl-x "o" "a"]))
      (is (nil? (:repeat m)))
      (assert= (buffer-text (cur m)) "a"))) ; the 'a' inserts as usual
  (test "a non-repeat command does not arm repeat-mode"
    (is (nil? (get (ed-update (m-of "x") :ctrl-f 80 24) :repeat)))))

(describe "cursor blink (the window's own clock, brood ADR-469)"
  (test "the caret op carries its blink: the half-period and the configured count"
    (let (m (ed-update (m-of "x") "a" 80 24)
          caret (seq/find (ed-view m 80 24) (fn (op) (and (vector? op) (= (first op) :cursor)))))
      (assert= (nth caret 5) {:interval *blink-ms* :blinks *blink-cursor-blinks*})))
  (test "the model's :blink-cursor-blinks (the init setting) is the count; 0 blinks forever"
    (let (caret-of (fn (m)
                     (seq/find (ed-view m 80 24)
                       (fn (op) (and (vector? op) (= (first op) :cursor)))))
          m (ed-update (m-of "x") "a" 80 24))
      (assert= (:blinks (nth (caret-of (assoc m :blink-cursor-blinks 3)) 5)) 3)
      (assert= (:blinks (nth (caret-of (assoc m :blink-cursor-blinks 0)) 5)) 0)))
  (test "no turn of the loop runs for the blink: no timer, no phase on the model"
    (let (m (ed-update (m-of "x") "a" 80 24))
      (is (not (contains? (:timers m) :cursor-blink)))
      (is (not (contains? m :blink-on?)))))
  (test "a key's release and a scrollbar fade beat change nothing else"
    (let (m (ed-update (m-of "x") "a" 80 24))
      (assert= (ed-update m [:key-up "a"] 80 24) m)
      (let (faded (ed-update (assoc m :sb-fade 3) [:timer :scrollbar-fade] 80 24))
        (assert= (:sb-fade faded) 2)
        (assert= (dissoc faded :sb-fade) m))))
  (test "a model starts with its idle beat armed — an editor left alone has no event to arm it"
    ;; the caret blinks in the window, so a window opened and never touched gives the loop no
    ;; input at all: the git summary waited for the first key
    (let (fresh (ed-init (make-buffer "x")))
      (is (:timers-synced? fresh))
      (is (contains? (:timers fresh) :idle-recompute))))
  (test "a model built without a sync still takes a full first turn, even on a cosmetic tick"
    (let (unsynced (dissoc (m-of "x") :timers-synced?)
          ticked (ed-update unsynced [:timer :spinner] 80 24))
      (is (:timers-synced? ticked))
      (is (:timers-synced? (ed-update unsynced [:key-up "a"] 80 24)))))
  ;; Run as one turn the beat cost 6–18 ms on the loop, and a key pressed meanwhile waited
  ;; for all of it. In a live loop it runs in slices; the loop takes queued input between them.
  (test "in a live loop the idle beat runs in slices, every job once, in order"
    (binding (editor/ui/*loop* (self))
      (binding (*idle-slice-ms* 0)
        ; one job per slice
        (let (jobs (count (ed-idle-jobs))
              first-slice (ed-update (m-of "x") [:timer :idle-recompute] 80 24)
              ;; keep firing the continuation until the beat says it is done
              finish (fn (m n)
                       (if (or (nil? (:idle-resume m)) (> n 100))
                         [m n]
                         (finish (ed-update m [:timer :idle-continue] 80 24) (inc n))))
              [done slices] (finish first-slice 1))
          (is (> jobs 1))
          (assert= (:idle-resume first-slice) 1) ; one job ran, the next one is waiting
          (is (contains? (:timers first-slice) :idle-continue))
          (assert= slices jobs) ; one slice per job, none skipped, none repeated
          (is (nil? (:idle-resume done)))
          (is (not (contains? (:timers done) :idle-continue))))))))

(describe "editor quit + save (Emacs C-x chords)"
  (test "Esc does NOT quit — it's keyboard-escape-quit (cancel), an Emacs command"
    (let (m (ed-update (m-of "x") :escape 80 24))
      (is (not (:done m))) ; the editor stays open
      (is (includes? (:echo m) "quit")))) ; just a cancel/echo, not exit
  (test "C-x C-c quits"
    (is (get (press (m-of "x") [:ctrl-x :ctrl-c]) :done)))
  (test "C-x C-s on a fileless buffer reports it can't save (no crash)"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-s]))
      (is (not (:done m)))
      (is (includes? (:echo m) "no file")))))

(describe "editor prefix keymap"
  (test "a prefix key (C-x) sets :pending and inserts nothing"
    (let (m (ed-update (m-of "") :ctrl-x 80 24))
      (is (not (nil? (:pending m))))
      (assert= (buffer-text (cur m)) "")))
  (test "C-x z (seq/repeat) with no prior command reports so"
    (let (m (press (m-of "") [:ctrl-x "z"]))
      (is (nil? (:pending m)))
      (is (includes? (:echo m) "No previous command")))))

(describe "editor undo / redo"
  ;; Emacs-style grouping: a consecutive typing (or deletion) run is ONE undo step, and
  ;; any other command starts a fresh group (so a command undoes atomically).
  (test "a typing run undoes as one step (not char by char)"
    (assert= (buffer-text (cur (press (m-of "") (append (string/->list "hello") [:ctrl-/])))) ""))
  (test "C-x u also undoes the whole run"
    (assert= (buffer-text (cur (press (m-of "") (append (string/->list "ab") [:ctrl-x "u"])))) ""))
  (test "a command between typing runs splits the undo groups"
    ;; type "ab", move left (boundary), type "c" → "acb"; one undo removes only "c"
    (assert= (buffer-text (cur (press (m-of "") ["a" "b" :left "c" :ctrl-/]))) "ab"))
  (test "a deletion run undoes as one step"
    ;; type "abcd", backspace twice → "ab"; one undo restores both deletions
    (assert= (buffer-text (cur (press (m-of "")
                                 (append (string/->list "abcd") [:backspace :backspace :ctrl-/]))))
      "abcd"))
  (test "C-? redoes an undone edit"
    (assert= (buffer-text (cur (press (m-of "") ["a" :ctrl-/ :ctrl-?]))) "a"))
  (test "a typing PAUSE (the undo-pause timer) splits the undo groups"
    ;; type "hello", pause (the :undo-pause timer fires an undo boundary), type " he" →
    ;; one undo removes only " he", leaving "hello" (not the whole run)
    (assert= (buffer-text (cur (press (m-of "")
                                 (append (string/->list "hello")
                                   (append [[:timer :undo-pause]]
                                     (append (string/->list " he") [:ctrl-/]))))))
      "hello"))
  (test "redo after a pause-split undo re-adds the second run"
    (assert= (buffer-text (cur (press (m-of "")
                                 (append (string/->list "hello")
                                   (append [[:timer :undo-pause]]
                                     (append (string/->list " he") [:ctrl-/ :ctrl-?]))))))
      "hello he"))
  (test "a typing command arms the undo-pause timer (so plain buffers get boundaries too)"
    ;; the fix for 'undo has no history': without an eldoc/diagnostics debounce, a plain
    ;; buffer must still arm an idle timer after an edit so a pause fires a boundary.
    (assert= (map/get-in (ed-update (m-of "") "a" 80 24) [:timers :undo-pause])
      {:after *undo-pause-ms* :idle? true}))
  (test "undo tree: after a break, undoing redoes your undos (no state lost)"
    ;; type "a"<pause>"b" (two groups); undo twice -> ""; break with C-f; undo twice walks
    ;; the recorded undos forward, back to "ab" — Emacs undo-tree, the whole point.
    (assert= (buffer-text (cur (press (m-of "")
                                 (append (string/->list "a")
                                   (append [[:timer :undo-pause]]
                                     (append (string/->list "b")
                                       [:ctrl-/ :ctrl-/ :ctrl-f :ctrl-/ :ctrl-/]))))))
      "ab"))
  (test "M-/ redoes multiple steps without a break"
    ;; type "a"<pause>"b"; undo twice -> ""; M-/ M-/ redoes both -> "ab"
    (assert= (buffer-text (cur (press (m-of "")
                                 (append (string/->list "a")
                                   (append [[:timer :undo-pause]]
                                     (append (string/->list "b")
                                       [:ctrl-/ :ctrl-/ :ctrl-? :ctrl-?]))))))
      "ab")))

(describe "editor mark / select"
  (test "C-x h marks the whole buffer (point at start, mark at end)"
    (let (b (cur (press (m-of "abc\ndef") [:ctrl-x "h"])))
      (assert= (buffer-point b) 0)
      (assert= (buffer-mark b) 7)))
  (test "C-x C-x exchanges point and mark"
    (let (b (cur (press (m-of "abcdef") [(keyword "ctrl- ") :ctrl-f :ctrl-f :ctrl-x :ctrl-x])))
      (assert= (buffer-point b) 0) ; was the mark (set at 0)
      (assert= (buffer-mark b) 2))) ; was point (moved to 2)
  (test "M-h marks the paragraph (point at its start)"
    (let (b (cur (press (m-of "one two\n\nthree") [:alt-h])))
      (is (not (nil? (buffer-mark b))))
      (assert= (buffer-point b) 0)))
  (test "C-M-h marks the defun (brood)"
    (let (b (cur (press (blsp-cm "(defn f ())\n(defn g ())" 3) [:ctrl-meta-h])))
      (assert= (buffer-point b) 0) ; start of (defn f ())
      (assert= (buffer-mark b) 11))) ; end of (defn f ())
  (test "hl-line is a text-area rect band on the current line — only with :hl-line set, no region"
    (let (buf (make-buffer "aaa\nbbb")
          sel {:selected true}
          ;; gw=6 (min for a non-file buffer): band starts at text col 6, excludes the scrollbar
          band (fn (m)
                 (view/ed-hl-line-band m
                   sel
                   buf
                   {:top 0
                    :x 0
                    :y 0
                    :width 80
                    :gutter-width 6
                    :margin-width 0
                    :text-height 23
                    :render-height 23
                    :rows nil
                    :hscroll 0})))
      (let (ops (band (assoc (m-of "x") :hl-line true)))
        ; flag on, no region → one rect band
        (assert= (count ops) 1)
        (assert= (first (first ops)) :rect) ; a rect, not a char range
        (assert= (nth (first ops) 2) 6) ; left edge = text col (past gutter gw=6)
        (assert= (nth (first ops) 3) 73) ; width = pane w (80) − gutter (6) − scrollbar (1)
        (assert= (nth (first ops) 4) 1) ; 1 row tall (s=1)
        (assert= (nth (first ops) 5) theme/face-hl-line))
      (is (empty? (band (m-of "x"))))))) ; off without the flag
(describe "editor shift-select"
  (test "Shift+Right starts and extends a region"
    (let (b (cur (press (m-of "abc") [:shift-right :shift-right])))
      (assert= (buffer-mark b) 0)
      (assert= (buffer-point b) 2)))
  (test "a plain motion collapses the shift-selection"
    (let (m (press (m-of "abc") [:shift-right :right]))
      (is (nil? (buffer-mark (cur m)))) ; region cleared
      (is (nil? (:shift-select m))))) ; flag cleared
  (test "a region command (C-w) acts on a shift-selection, keeping it"
    (assert= (buffer-text (cur (press (m-of "abc") [:shift-right :shift-right :ctrl-w]))) "c"))
  (test "Shift+End selects to end of line"
    (let (b (cur (press (m-of "abc\ndef") [:shift-end])))
      (assert= (buffer-mark b) 0)
      (assert= (buffer-point b) 3))))

(describe "editor region indent / dedent (TAB / Shift-TAB)"
  (defn sel-all (m)
    ; activate a region over the whole buffer
    (let (b (cur m)) (ed-set-buf m (assoc b :mark 0 :point (buffer-length b)))))
  (test "Shift-TAB dedents every line of the region by a tab-width"
    (let (done (ed-update (sel-all (m-of "    aaa\n    bbb")) :back-tab 80 24))
      (assert= (buffer-text (cur done)) "  aaa\n  bbb")))
  (test "Shift-TAB dedents the current line when there's no region"
    (let (m0 (m-of "    abc")
          m1 (ed-set-buf m0 (goto-char (cur m0) 7))
          done (ed-update m1 :back-tab 80 24))
      (assert= (buffer-text (cur done)) "  abc")))
  (test "a region dedent is one undo step and keeps the region selected"
    (let (done (ed-update (sel-all (m-of "  a\n  b")) :back-tab 80 24)
          undone (ed-update done :ctrl-/ 80 24))
      (is (not (nil? (buffer-mark (cur done))))) ; region still active
      (assert= (buffer-text (cur undone)) "  a\n  b"))) ; one undo restores both lines
  (test "TAB reindents a region (brood) and keeps it selected"
    (let (done (ed-update (sel-all (blsp-cm "(defn f ()\nx)" 0)) :tab 80 24))
      (is (not (nil? (buffer-mark (cur done))))))))

(describe "editor region & kill ring"
  (test "C-SPC + move + C-w kills the region and fills the kill ring"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w]))
      (assert= (buffer-text (cur m)) "def")
      (assert= (first (:kill-ring m)) "abc")))
  (test "C-y yanks the most recently killed text"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :ctrl-w :end :ctrl-y]))
      (assert= (buffer-text (cur m)) "defabc")))
  (test "M-w copies the region without deleting it"
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right :alt-w]))
      (assert= (buffer-text (cur m)) "abcdef")
      (assert= (first (:kill-ring m)) "abc")))
  (test "C-w with no region is a no-op-with-message"
    (let (m (press (m-of "abc") [:ctrl-w]))
      (assert= (buffer-text (cur m)) "abc")
      (is (includes? (:echo m) "no region")))))

;; The inbound async events `input` folds — each is a plain (model, event) -> model,
;; so they test exactly like a keystroke does: no window, no process.
(describe "editor async event folds"
  (test "[:resize] re-clamps scrolling to the new viewport"
    ;; scrolled down a short buffer, a resize must not leave :top past the end
    (let (m (map/assoc-in (m-of "a\nb\nc\nd\ne") [:layout :payload :top] 4)
          resized (ed-update m [:resize 80 100] 80 24))
      (assert= (:top (ed-current-pane resized)) 0))) ; the whole buffer fits again
  (test "a web-port-event records the bound port and echoes the URL — unless the server stopped"
    (let (serving (assoc (m-of "x") :server {:proc :fake :token "tk"})
          bound (ed-update serving (web/web-port-event 8123) 80 24))
      (assert= (map/get-in bound [:server :port]) 8123)
      (is (includes? (:echo bound) "localhost:8123/?token=tk"))
      ;; a stop that raced ahead of the bind leaves no :server — the event is dropped
      (is (nil? (get (ed-update (m-of "x") (web/web-port-event 8123) 80 24) :server))))))

;; ---- undo limited to the region (Emacs undo-in-region) ---------------------------

(describe "C-/ with a region undoes only those lines"
  (defn ur-model ()
    ;; two edits on two different lines, most recent on line 1
    (let (m (ed-init (make-buffer "one\ntwo\nthree"))
          m1 (ed-edit m (fn (b) (insert (goto-char b 3) "!")))
          m2 (ed-edit m1 (fn (b) (insert (goto-char b 8) "?"))))
      m2))

  (test "selecting a line undoes that line's change and leaves the others"
    (let (m (ur-model)
          ;; select line 0 (its edit is the OLDER one — history is searched for it)
          sel (ed-set-buf m (assoc (goto-char (cur m) 0) :mark 4))
          out (cmd-undo sel nil))
      (assert= (buffer-text (cur out)) "one\ntwo?\nthree")))

  (test "with no region it is an ordinary undo"
    (let (m (ur-model)
          out (cmd-undo m nil))
      (assert= (buffer-text (cur out)) "one!\ntwo\nthree")))

  (test "a region with nothing to undo says so rather than changing the text"
    (let (m (ed-init (make-buffer "untouched\ntext"))
          sel (ed-set-buf m (assoc (goto-char (cur m) 0) :mark 5))
          out (cmd-undo sel nil))
      (assert= (buffer-text (cur out)) "untouched\ntext")
      (is (includes? (:echo out) "no change in the region"))))

  (test "the region survives, so C-/ again peels the next change off the same lines"
    (let (m (ed-init (make-buffer "x\ny"))
          m1 (ed-edit m (fn (b) (insert (goto-char b 1) "1")))
          m2 (ed-edit m1 (fn (b) (insert (goto-char b 2) "2")))
          sel (ed-set-buf m2 (assoc (goto-char (cur m2) 0) :mark 3))
          once (cmd-undo sel nil))
      (assert= (buffer-text (cur once)) "x1\ny")
      (is (not (nil? (buffer-mark (cur once)))))
      (assert= (buffer-text (cur (cmd-undo once nil))) "x\ny"))))

(describe "M-^ joins the line UP (Emacs delete-indentation)"
  (defn on (text n)
    (let (m (ed-init (make-buffer text "t.blsp")))
      (ed-apply m (fn (b) (goto-char b n)))))
  (defn text-of (m) (buffer-text (ed-current-buf m)))

  (test "REGRESSION: it pulls this line up, not the next line down"
    ;; it used to delete the newline at END of line — Vim's J — so the line under
    ;; point never moved and M-^ appeared to do nothing to it
    (let (m (cmd-join-line (on "(foo)\n    (bar)\n(baz)" 10) (keyword "alt-^")))
      (assert= (text-of m) "(foo) (bar)\n(baz)")))

  (test "the seam rule holds on Brood source: no space before a closing delimiter"
    (let (m (cmd-join-line (on "(let (x 1)\n  )" 12) (keyword "alt-^")))
      (assert= (text-of m) "(let (x 1))")))

  (test "the first line has nothing above it — a no-op, not an error"
    (let (m (cmd-join-line (on "(foo)\n(bar)" 2) (keyword "alt-^")))
      (assert= (text-of m) "(foo)\n(bar)")))

  (test "with a region it joins every line in it, bottom-up"
    ;; walking downward would use line numbers the earlier joins already invalidated
    ;; no second argument: it is the buffer NAME (a string), and the `0` this used to pass
    ;; there was caught by the `buffer` record's contract once `nest test` enforced it
    (let (b0 (make-buffer "a\n  b\n  c\n  d\ne")
          m (ed-init b0)
          marked (ed-apply m (fn (b) (assoc (goto-char b 0) :mark 12))) ; through "d"
          joined (cmd-join-line marked (keyword "alt-^")))
      (assert= (text-of joined) "a b c d\ne")))

  (test "M-SPC / M-\\ still collapse the gap around point"
    (let (m (on "a   \t  b" 4))
      (assert= (text-of (cmd-just-one-space m :alt-space)) "a b")
      (assert= (text-of (ed-collapse-ws m "")) "ab"))))

;; M-SPC is `cycle-spacing` (Emacs 29 took the key from `just-one-space`): one press
;; leaves one space, the next leaves none, the third puts back what was there.
(describe "cycle-spacing (M-SPC)"
  ;; a repeat is "the last command was this one" — what the real key path threads
  ;; through `:last-command`
  (defn cyc (m)
    (cmd-cycle-spacing (assoc m :last-command 'commands/cmd-cycle-spacing)
      (keyword "alt- ")))

  (test "the first press collapses to one space, like just-one-space"
    (let (once (cmd-cycle-spacing (on "a   \t  b" 4) (keyword "alt- ")))
      (assert= (text-of once) "a b")
      (assert= (buffer-point (cur once)) 2))) ; point after the space
  (test "the second press deletes the gap entirely"
    (let (twice (cyc (cmd-cycle-spacing (on "a   \t  b" 4) (keyword "alt- "))))
      (assert= (text-of twice) "ab")))

  (test "the third press restores the original run, point included"
    (let (thrice (cyc (cyc (cmd-cycle-spacing (on "a   \t  b" 4) (keyword "alt- ")))))
      (assert= (text-of thrice) "a   \t  b")
      (assert= (buffer-point (cur thrice)) 4))) ; exactly where the cycle began
  (test "a fourth press starts the cycle over"
    (let (four (cyc (cyc (cyc (cmd-cycle-spacing (on "a   \t  b" 4) (keyword "alt- "))))))
      (assert= (text-of four) "a b")))

  (test "another command in between starts a fresh cycle, never a restore"
    ;; without this, M-SPC in one gap then M-SPC in another would 'restore' the first
    ;; gap's text into the second
    (let (once (cmd-cycle-spacing (on "a   b   c" 2) (keyword "alt- ")) ; -> "a b   c"
          ;; :last-command is some other command, so this is a first press again
          elsewhere (cmd-cycle-spacing (ed-apply (assoc once
                                                   :last-command 'commands/cmd-forward-char)
                                         (fn (b) (goto-char b 4)))
                      (keyword "alt- ")))
      (assert= (text-of elsewhere) "a b c")))

  (test "the same key in a DIFFERENT gap starts over, even as an immediate repeat"
    ;; the stash is keyed by where the run starts, so it cannot leak across gaps
    (let (once (cmd-cycle-spacing (on "a   b   c" 2) (keyword "alt- ")) ; -> "a b   c", point 2
          moved (ed-apply once (fn (b) (goto-char b 4))) ; into the second gap
          second (cyc moved))
      (assert= (text-of second) "a b c")))

  (test "in a gap that is already one space it still cycles to none and back"
    (let (m (on "a b" 1)
          once (cmd-cycle-spacing m (keyword "alt- ")))
      (assert= (text-of once) "a b")
      (assert= (text-of (cyc once)) "ab")
      (assert= (text-of (cyc (cyc once))) "a b")))

  (test "with no whitespace at point it INSERTS one, then cycles back to none"
    ;; `just-one-space` leaves one space whether or not there was any — so between two
    ;; letters the first press adds one (Emacs does this too), and `restore` puts the
    ;; original *emptiness* back rather than leaving the space behind
    (let (once (cmd-cycle-spacing (on "ab" 1) (keyword "alt- ")))
      (assert= (text-of once) "a b")
      (assert= (text-of (cyc once)) "ab")
      (assert= (text-of (cyc (cyc once))) "ab")
      (assert= (buffer-point (cur (cyc (cyc once)))) 1)))

  (test "it never eats across a newline"
    (let (once (cmd-cycle-spacing (on "a  \n  b" 2) (keyword "alt- ")))
      (assert= (text-of once) "a \n  b")
      (assert= (text-of (cyc once)) "a\n  b")
      (assert= (text-of (cyc (cyc once))) "a  \n  b"))))

;; The non-structural Emacs motions that had no editor commands yet:
;; back-to-indentation (M-m), sentence motion (M-a / M-e) with its kills (M-k, C-x DEL),
;; mark-word (M-@) and goto-char (M-g c). Each is one `ed-apply`/`ed-kill-span` over a
;; `std/editor/buffer` primitive, so these pin the WIRING (key → command → primitive).
(describe "editor motion — indentation, sentences, mark-word, goto-char"
  (defn at (text p) (let (m (m-of text)) (ed-set-buf m (goto-char (cur m) p))))
  (defn pt (m) (buffer-point (cur m)))

  (test "M-m moves to the line's first non-whitespace character"
    (assert= (pt (ed-update (at "  hi\nthere" 4) :alt-m 80 24)) 2)
    ; an all-whitespace line lands at its end
    (assert= (pt (ed-update (at "   \nx" 0) :alt-m 80 24)) 3))

  (test "M-e / M-a move by sentence"
    ;; "One. Two? Three!" — terminators at 3, 8, 15; sentence starts at 0, 5, 10
    (assert= (pt (ed-update (at "One. Two? Three!" 0) :alt-e 80 24)) 4)
    (assert= (pt (ed-update (at "One. Two? Three!" 4) :alt-e 80 24)) 9)
    (assert= (pt (ed-update (at "One. Two? Three!" 16) :alt-a 80 24)) 10)
    (assert= (pt (ed-update (at "One. Two? Three!" 10) :alt-a 80 24)) 5))

  (test "M-a / M-e stay inside the paragraph — they never cross a blank line"
    ;; "One. Two.\n\nThree." — the blank line starts at 10
    (assert= (pt (ed-update (at "One. Two.\n\nThree." 9) :alt-e 80 24)) 10))

  (test "M-k kills to the end of the sentence; C-x DEL kills back to its start"
    (assert= (buffer-text (cur (ed-update (at "One. Two." 0) :alt-k 80 24))) " Two.")
    (assert= (buffer-text (cur (press (at "One. Two." 9) [:ctrl-x :backspace]))) "One. "))

  (test "M-@ marks the next word, leaving point — and extends on repeat"
    (let (once (cmd-mark-word (at "ab cd" 0) nil)
          twice (cmd-mark-word (assoc once :last-command 'commands/cmd-mark-word) nil))
      ; point stays put
      (assert= (pt once) 0)
      ; mark at the end of "ab"
      (assert= (buffer-mark (cur once)) 2)
      (assert= (buffer-mark (cur twice)) 5)))

  (test "M-g c jumps to a character offset"
    (let (m (cmd-goto-char (at "abcdef" 0) nil)
          done (ed-update (assoc m
                            :minibuffer
                              (assoc (:minibuffer m)
                                :edit (ed-mb-set-text (:edit (:minibuffer m)) "3")))
                 :enter 80 24))
      (assert= (pt done) 3)))

  (test "each new motion registers its opposite direction, so a negative arg reverses it"
    ;; M-- M-e runs backward-sentence (and M-- M-m has no inverse — it isn't directional)
    (assert= (interactive/command-inverse 'commands/cmd-forward-sentence)
      'commands/cmd-backward-sentence)
    (assert= (interactive/command-inverse 'commands/cmd-forward-list)
      'commands/cmd-backward-list)
    (assert= (interactive/command-inverse 'commands/cmd-kill-sexp)
      'commands/cmd-backward-kill-sexp)
    (assert= (interactive/command-inverse 'compile/cmd-next-error)
      'compile/cmd-previous-error)))

(describe "paste into a transient input — C-y goes to the search / the prompt, not the buffer"
  (test "C-y in isearch appends the kill-ring head to the search string and finds it"
    (let (m (assoc (m-of "alpha beta gamma beta") :kill-ring (list "beta"))
          s (ed-update m :ctrl-s 80 24)
          y (ed-update s :ctrl-y 80 24))
      (assert= (map/get-in y [:isearch :string]) "beta")
      (assert= (map/get-in y [:isearch :match]) 6)
      ;; the buffer text is untouched — the paste went to the search
      (assert= (buffer-text (cur y)) "alpha beta gamma beta")))
  (test "C-w in isearch pulls the next word of the buffer into the search"
    (let (m (m-of "alpha beta gamma")
          s (ed-update m :ctrl-s 80 24)
          w (ed-update s :ctrl-w 80 24)
          w2 (ed-update w :ctrl-w 80 24))
      (assert= (map/get-in w [:isearch :string]) "alpha")
      (assert= (map/get-in w2 [:isearch :string]) "alpha beta")))
  (test "C-y in a minibuffer prompt pastes the kill-ring head into the line"
    (let (m (assoc (m-of "body") :kill-ring (list "notes.txt"))
          p (ed-update (ed-update m :ctrl-x 80 24) :ctrl-f 80 24)
          y (ed-update p :ctrl-y 80 24))
      (is (not (nil? (:minibuffer y))))
      (is (string/ends-with? (:text (:edit (:minibuffer y))) "notes.txt"))
      (assert= (buffer-text (cur y)) "body"))))

;; ---- isearch steps the way Emacs's does ----------------------------------------
;; Three differences from Emacs that a reader of either notices at once: the search wrapped
;; on the first miss without saying it had run out, C-s then C-r skipped the match under
;; point, and DEL searched again from the origin instead of stepping back.
(describe "isearch: failing before wrapping, turning round in place, DEL steps back"
  (defn- keys-in (m ks) (fold ks m (fn (acc k) (ed-update acc k 80 24))))
  (defn- searched (text ks) (keys-in (m-of text) (cons :ctrl-s ks)))
  (defn- match-of (m) (map/get-in m [:isearch :match]))

  (test "past the last match, C-s fails in place; the next C-s wraps"
    (let (last (searched "foo x foo" ["f" "o" "o" :ctrl-s])
          failing (keys-in last [:ctrl-s])
          wrapped (keys-in failing [:ctrl-s]))
      (assert= (match-of last) 6)
      (is (nil? (match-of failing)))
      (is (string/starts-with? (:echo failing) "Failing"))
      ;; point stays on the last match, and its highlight with it
      (assert= (buffer-point (cur failing)) 9)
      (is (not (empty? (:overlays failing))))
      (assert= (match-of wrapped) 0)
      (is (string/starts-with? (:echo wrapped) "Wrapped"))))
  (test "C-r after C-s turns round on the same match; the next C-r moves on"
    (let (fwd (searched "foo foo foo" ["f" "o" "o" :ctrl-s])
          turned (keys-in fwd [:ctrl-r])
          back (keys-in turned [:ctrl-r]))
      (assert= (match-of fwd) 4)
      (assert= (match-of turned) 4)
      (assert= (buffer-point (cur turned)) 4)
      (assert= (match-of back) 0)))
  (test "DEL undoes a C-s — back to the match before it, not to the origin"
    (let (third (searched "foo foo foo" ["f" "o" "o" :ctrl-s :ctrl-s])
          once (keys-in third [:backspace])
          twice (keys-in once [:backspace]))
      (assert= (match-of third) 8)
      (assert= (match-of once) 4)
      (assert= (buffer-point (cur once)) 7)
      (assert= (match-of twice) 0)
      (assert= (map/get-in twice [:isearch :string]) "foo")))
  (test "DEL undoes a typed character, and at the start there is nothing to undo"
    (let (grown (searched "ab ac" ["a" "c"])
          shrunk (keys-in grown [:backspace])
          empty (keys-in shrunk [:backspace])
          still (keys-in empty [:backspace]))
      (assert= (match-of grown) 3)
      (assert= (map/get-in shrunk [:isearch :string]) "a")
      (assert= (match-of shrunk) 0)
      (assert= (map/get-in empty [:isearch :string]) "")
      (assert= (buffer-point (cur empty)) 0)
      (assert= (:isearch still) (:isearch empty))))
  ;; Typing on into a failing search skips the search (the miss already proves the longer
  ;; string cannot match) — so these pin that it answers exactly what searching would.
  (test "typing into a failing search stays failing; DEL back finds the match again"
    (let (failing (searched "foo bar" ["b" "a" "z"])
          further (keys-in failing ["q"])
          back (keys-in further [:backspace :backspace]))
      (is (nil? (match-of failing)))
      (is (nil? (match-of further)))
      (is (string/starts-with? (:echo further) "Failing I-search: bazq"))
      (assert= (match-of back) 4)
      (assert= (match-of (keys-in back ["r"])) 4)))
  (test "a capital typed into a failing search still fails — it only narrows"
    (is (nil? (match-of (searched "Foo foo" ["f" "o" "x" "O"])))))
  (test "a failing search from a later match still finds an earlier one when extended"
    ;; the miss after C-s was searched from past the last match, not from the origin, so
    ;; it proves nothing about the origin — typing searches again
    (let (failing (searched "abc ab" ["a" "b" :ctrl-s :ctrl-s])
          extended (keys-in failing ["c"]))
      (is (nil? (match-of failing)))
      (assert= (match-of extended) 0))))

;; ---- search case: fold, unless you typed a capital ---------------------------
;; Emacs' rule, two settings working together: `case-fold-search` is `t` so search ignores
;; case, and `search-upper-case` is `'not-yanks` so isearch turns folding off the moment
;; the pattern contains an upper-case letter (`isearch-no-upper-case-p`). The effect is
;; that you never think about it — asking for case is typing it.
(describe "search is case-insensitive until you type a capital"
  (defn type-search (m s)
    (fold (string/->list s) (ed-update m :ctrl-s 80 24) (fn (acc c) (ed-update acc c 80 24))))

  (test "a lower-case pattern finds any case"
    ;; `hello` at 0 is lower; the capitalised one is at 6. A folded search from the origin
    ;; lands on the first, which is what an Emacs user expects.
    (let (m (type-search (m-of "hello Hello HELLO") "hello"))
      (assert= (map/get-in m [:isearch :match]) 0)))

  (test "a lower-case pattern matches a capitalised occurrence when that is all there is"
    (let (m (type-search (m-of "xx Hello xx") "hello"))
      (assert= (map/get-in m [:isearch :match]) 3)))

  (test "a lower-case pattern matches an ALL-CAPS occurrence"
    (let (m (type-search (m-of "xx HELLO xx") "hello"))
      (assert= (map/get-in m [:isearch :match]) 3)))

  ;; The other half, and the point of the rule: a capital is a decision.
  (test "a pattern with a capital is case-SENSITIVE"
    (let (m (type-search (m-of "hello Hello") "Hello"))
      (assert= (map/get-in m [:isearch :match]) 6)))

  (test "a pattern with a capital that matches nothing is a failing search, not a fallback"
    (let (m (type-search (m-of "hello hello") "Hello"))
      (is (nil? (map/get-in m [:isearch :match])))))

  ;; Characters with no case are not a decision about case.
  (test "digits and punctuation do not make a search case-sensitive"
    (is (isearch/search-fold? "foo123[]"))
    (is (isearch/search-fold? "日本語"))
    (is (not (isearch/search-fold? "Foo")))
    (is (isearch/search-fold? "foo"))))

;; Emacs' `case-replace`: if the search ignored case then the text matched may be
;; capitalised differently from what you typed, and copying the replacement in verbatim
;; would change the case of prose you never meant to touch.
(describe "query-replace keeps the case it found"
  (test "a capitalised match takes a capitalised replacement"
    (assert= (isearch/replacement-for "Foo" "bar" true) "Bar"))

  (test "an ALL-CAPS match takes an ALL-CAPS replacement"
    (assert= (isearch/replacement-for "FOO" "bar" true) "BAR"))

  (test "a lower-case match takes the replacement as typed"
    (assert= (isearch/replacement-for "foo" "bar" true) "bar"))

  ;; A replacement that was typed WITH case is a name, not a sentence — leave it alone.
  (test "a replacement typed with capitals is never re-cased"
    (assert= (isearch/replacement-for "FOO" "fooBar" true) "fooBar")
    (assert= (isearch/replacement-for "Foo" "MyApp.Thing" true) "MyApp.Thing"))

  ;; And when the search was case-sensitive, what you typed is exactly what you meant.
  (test "a case-sensitive search replaces verbatim"
    (assert= (isearch/replacement-for "Foo" "bar" false) "bar"))

  (test "a match with no letters is not 'all caps'"
    (assert= (isearch/replacement-for "---" "bar" true) "bar"))

  (test "query-replace end to end preserves each occurrence's case"
    (let (m (isearch/qr-start (m-of "foo Foo FOO done") "foo" "bar")
          done (letrec (go (fn (acc n)
                             (if (or (= n 0) (nil? (:query-replace acc)))
                               acc
                               (go (isearch/qr-handle acc "y") (dec n)))))
                 (go m 6)))
      (assert= (buffer-text (cur done)) "bar Bar BAR done"))))

;; ---- the replace family (M-x) ------------------------------------------------
;; The text transforms are pure, so the edge cases are testable without a model — and the
;; edge cases are the whole risk: a literal replace that quietly behaves like a regex eats
;; a file, and a line filter that drops the final newline is a diff nobody asked for.

(describe "replace-string is literal, replace-regexp is not"
  (test "a literal replace treats regex metacharacters as text"
    ;; the command you reach for BECAUSE the text has dots and brackets in it
    (let ([out n] (isearch/replace-all-in "a.c and abc" "a.c" "X" false))
      (assert= out "X and abc")
      (assert= n 1)))
  (test "a regexp replace treats them as a pattern"
    (let ([out n] (isearch/replace-all-in "a.c and abc" "a.c" "X" true))
      (assert= out "X and X")
      (assert= n 2)))
  (test "a regexp replacement expands its groups"
    (let ([out _] (isearch/replace-all-in "jane doe" "(\\w+) (\\w+)" "$2, $1" true))
      (assert= out "doe, jane")))
  (test "no match changes nothing and counts nothing"
    (let ([out n] (isearch/replace-all-in "abc" "zzz" "X" false))
      (assert= out "abc")
      (assert= n 0)))
  (test "an empty pattern is a no-op, not an infinite insertion"
    (let ([out n] (isearch/replace-all-in "abc" "" "X" false))
      (assert= out "abc")
      (assert= n 0)))
  (test "every occurrence goes, including adjacent ones"
    (let ([out n] (isearch/replace-all-in "aaa" "a" "b" false))
      (assert= out "bbb")
      (assert= n 3))))

(describe "flush-lines and keep-lines"
  (test "flush removes the matching lines and counts them"
    (let ([out n] (isearch/filter-lines "keep\nDEBUG one\nkeep2\nDEBUG two\n" "DEBUG" false))
      (assert= out "keep\nkeep2\n")
      (assert= n 2)))
  (test "keep is its exact opposite"
    (let ([out n] (isearch/filter-lines "keep\nDEBUG one\nkeep2\nDEBUG two\n" "DEBUG" true))
      (assert= out "DEBUG one\nDEBUG two\n")
      (assert= n 2)))
  (test "a trailing newline survives"
    ;; silently eating the final newline is a one-line diff in every file it touches
    (let ([out _] (isearch/filter-lines "a\nb\n" "b" false))
      (assert= out "a\n")))
  (test "text with no trailing newline does not gain one"
    (let ([out _] (isearch/filter-lines "a\nb" "b" false))
      (assert= out "a")))
  (test "dropping everything leaves nothing, not a stray newline"
    (let ([out n] (isearch/filter-lines "x\ny\n" "." false))
      (assert= out "")
      (assert= n 2)))
  (test "matching nothing leaves the text byte-identical"
    (let ([out n] (isearch/filter-lines "a\nb\n" "zzz" false))
      (assert= out "a\nb\n")
      (assert= n 0)))
  (test "the pattern is a regexp, matched anywhere in the line"
    (let ([out _] (isearch/filter-lines "err: 1\nok\nerr: 2\n" "^err:" false))
      (assert= out "ok\n"))))

(describe "how-many counts without changing anything"
  (test "counts non-overlapping matches"
    (assert= (isearch/count-matches-in "aa aa aa" "aa") 3))
  (test "zero is an answer"
    (assert= (isearch/count-matches-in "abc" "zzz") 0))
  (test "it is a regexp"
    (assert= (isearch/count-matches-in "a1 b2 c3" "[a-z][0-9]") 3)))

(describe "the replace commands act on the region, else from point"
  (test "with no region, from point to the end"
    (let (m (ed-set-buf (ed-init (make-buffer "aaa")) (goto-char (make-buffer "aaa") 1))
          done (commands/ed-replace-in-span m "a" "b" false "replaced"))
      ;; the `a` before point is untouched
      (assert= (buffer-text (ed-current-buf done)) "abb")))
  (test "with a region, only inside it"
    (let (buf (goto-char (push-mark (goto-char (make-buffer "aaaa") 1)) 3)
          m (ed-set-buf (ed-init (make-buffer "aaaa")) buf)
          done (commands/ed-replace-in-span m "a" "b" false "replaced"))
      (assert= (buffer-text (ed-current-buf done)) "abba")))
  (test "no match says so and leaves the buffer alone"
    (let (m (ed-init (make-buffer "abc"))
          done (commands/ed-replace-in-span m "zzz" "x" false "replaced"))
      (assert= (buffer-text (ed-current-buf done)) "abc")
      (is (includes? (:echo done) "no matches"))))
  (test "the report counts what it did"
    (let (m (ed-init (make-buffer "aaa"))
          done (commands/ed-replace-in-span m "a" "b" false "replaced"))
      (is (includes? (:echo done) "replaced 3 occurrences")))))

;; ---- the small daily set -----------------------------------------------------
;; The whitespace ones are where this goes quietly wrong: a tab's width depends on where
;; in the line it sits, and tabifying anything but the indentation changes what a string
;; literal contains.

(describe "untabify expands to the next tab stop, not a fixed run"
  (test "a tab at the start of a line reaches the first stop"
    (assert= (commands/ed-untabify-text "\tx" 4) "    x"))
  (test "a tab after one character reaches the SAME stop, not four further on"
    ;; the blind `\t -> N spaces` version gives "a    b" and shifts every line after it
    (assert= (commands/ed-untabify-text "a\tb" 4) "a   b"))
  (test "two tabs in a line each advance to their own stop"
    (assert= (commands/ed-untabify-text "a\tb\tc" 4) "a   b   c"))
  (test "a tab exactly on a stop advances a full width"
    (assert= (commands/ed-untabify-text "abcd\tx" 4) "abcd    x"))
  (test "text with no tabs is untouched"
    (assert= (commands/ed-untabify-text "plain text" 4) "plain text"))
  (test "every line is handled, and the line structure survives"
    (assert= (commands/ed-untabify-text "\ta\n\tb" 4) "    a\n    b")))

(describe "tabify converts the indentation only"
  (test "leading spaces become tabs"
    (assert= (commands/ed-tabify-text "    x" 4) "\tx"))
  (test "a partial stop keeps its remainder as spaces"
    (assert= (commands/ed-tabify-text "      x" 4) "\t  x"))
  (test "spaces INSIDE the line are left alone"
    ;; they are aligning a comment or sitting in a string literal — both on purpose
    (assert= (commands/ed-tabify-text "a    b" 4) "a    b"))
  (test "a line indented less than one stop is unchanged"
    (assert= (commands/ed-tabify-text "  x" 4) "  x"))
  (test "it round-trips with untabify for pure indentation"
    (assert= (commands/ed-untabify-text (commands/ed-tabify-text "        x" 4) 4) "        x")))

(describe "delete-duplicate-lines collapses consecutive runs"
  (test "a run becomes one line"
    (let ([out n] (commands/ed-dedupe-lines "a\na\na\nb\n"))
      (assert= out "a\nb\n")
      (assert= n 2)))
  (test "duplicates that are NOT adjacent both stay"
    ;; global dedup would delete a line far from the one it matched — not eyeballable
    (let ([out n] (commands/ed-dedupe-lines "a\nb\na\n"))
      (assert= out "a\nb\na\n")
      (assert= n 0)))
  (test "the trailing newline is preserved"
    (let ([out _] (commands/ed-dedupe-lines "a\na\n")) (assert= out "a\n")))
  (test "and not invented"
    (let ([out _] (commands/ed-dedupe-lines "a\na")) (assert= out "a"))))

(describe "reverse-region"
  (test "the lines come back in the opposite order"
    (assert= (commands/ed-reverse-lines "a\nb\nc") "c\nb\na"))
  (test "a trailing newline stays at the end, not the start"
    (assert= (commands/ed-reverse-lines "a\nb\n") "b\na\n"))
  (test "one line reverses to itself"
    (assert= (commands/ed-reverse-lines "only") "only")))

(describe "what-cursor-position names the character it is on"
  (test "an ordinary character, with its codepoint"
    (let (s (commands/ed-cursor-position-text (make-buffer "abc")))
      (is (includes? s "char: a"))
      (is (includes? s "U+0061"))))
  (test "a newline is shown as an escape, not as a line break in the echo area"
    (let (s (commands/ed-cursor-position-text (goto-char (make-buffer "a\nb") 1)))
      (is (includes? s "\\n"))))
  (test "an invisible character is identified by codepoint — the reason the command exists"
    ;; a non-breaking space looks exactly like a space and breaks the build
    (let (s (commands/ed-cursor-position-text (make-buffer "\u{00a0}x")))
      (is (includes? s "U+00A0"))))
  (test "the end of the buffer says so rather than inventing a character"
    (let (s (commands/ed-cursor-position-text (goto-char (make-buffer "ab") 2)))
      (is (includes? s "end of buffer"))))
  (test "line and column are 1-based and 0-based as Emacs reports them"
    (let (s (commands/ed-cursor-position-text (goto-char (make-buffer "ab\ncd") 4)))
      (is (includes? s "line 2"))
      (is (includes? s "col 1")))))

;; ---- map-y-or-n-p: ask about each of a list ---------------------------------
;; Emacs's `map-y-or-n-p`. It existed already, spelled out inside `ed-quit-ask`;
;; `save-some-buffers` needed the same loop, which is the moment to pull it up. Not a
;; modal overlay — each answer is an `ed-read-char` continuation, so the loop stays live
;; between questions and a long list freezes nothing.

(defn- my-answer (m k)
  "Feed one key to the pending read-char continuation."
  ((map/get-in m [:read-char :then]) (dissoc m :read-char) k))

(describe "map-y-or-n asks about each item in turn"
  (test "y accepts, n skips, and the count is what was accepted"
    (let (m0 (commands/ed-map-y-or-n (ed-init (make-buffer ""))
               ["a" "b" "c"]
               (fn (i) (str "Take " i "?"))
               (fn (mm i) (assoc mm :taken (conj (:taken mm []) i)))
               (fn (mm n) (assoc mm :accepted-count n)))
          m1 (my-answer m0 "y")
          m2 (my-answer m1 "n")
          m3 (my-answer m2 "y"))
      (assert= (:taken m3) ["a" "c"])
      (assert= (:accepted-count m3) 2)))
  (test "the prompt names the item and lists the answers"
    (let (m (commands/ed-map-y-or-n (ed-init (make-buffer ""))
              ["one"]
              (fn (i) (str "Take " i "?"))
              (fn (mm _) mm)
              (fn (mm n) mm)))
      (is (includes? (:echo m) "Take one?"))
      (is (includes? (:echo m) "(y, n, !, q)"))))
  (test "! takes this one and every one after, in a single step"
    (let (m0 (commands/ed-map-y-or-n (ed-init (make-buffer ""))
               ["a" "b" "c"]
               (fn (i) "?")
               (fn (mm i) (assoc mm :taken (conj (:taken mm []) i)))
               (fn (mm n) (assoc mm :accepted-count n)))
          done (my-answer m0 "!"))
      (assert= (:taken done) ["a" "b" "c"])
      (assert= (:accepted-count done) 3)
      ;; …and it is finished: no further question is pending
      (assert= (:read-char done) nil)))
  (test "q stops asking and keeps what was already accepted"
    (let (m0 (commands/ed-map-y-or-n (ed-init (make-buffer ""))
               ["a" "b" "c"]
               (fn (i) "?")
               (fn (mm i) (assoc mm :taken (conj (:taken mm []) i)))
               (fn (mm n) (assoc mm :accepted-count n)))
          m1 (my-answer m0 "y")
          done (my-answer m1 "q"))
      (assert= (:taken done) ["a"])
      (assert= (:accepted-count done) 1)
      (assert= (:read-char done) nil)))
  (test "an unrecognised key is NO, not a re-ask"
    ;; re-asking on an unknown key is how you get stuck in a prompt you cannot leave
    (let (m0 (commands/ed-map-y-or-n (ed-init (make-buffer ""))
               ["a" "b"]
               (fn (i) "?")
               (fn (mm i) (assoc mm :taken (conj (:taken mm []) i)))
               (fn (mm n) (assoc mm :accepted-count n)))
          m1 (my-answer m0 "z")
          done (my-answer m1 "y"))
      (assert= (:taken done) ["b"])
      (assert= (:accepted-count done) 1)))
  (test "an empty list asks nothing and reports zero"
    (let (m (commands/ed-map-y-or-n (ed-init (make-buffer ""))
              []
              (fn (i) "?")
              (fn (mm _) mm)
              (fn (mm n) (assoc mm :accepted-count n))))
      (assert= (:accepted-count m) 0)
      (assert= (:read-char m) nil)))
  (test "save-some-buffers says so when there is nothing to save"
    (is (includes? (:echo (commands/cmd-save-some-buffers (ed-init (make-buffer "")) nil))
          "no changes need saving"))))

;; ---- align-regexp ------------------------------------------------------------
;; "Line up on this" is under-specified until you say which occurrence and what happens
;; to lines with none. These pin the three answers.

(describe "align-regexp lines up a column"
  (test "assignments line up on ="
    (assert= (commands/align-text "a = 1\nbbbb = 2\ncc = 3" "=")
      "a    = 1\nbbbb = 2\ncc   = 3"))
  (test "a line with no match is passed through untouched"
    ;; it is a blank line, a comment, or the one line not part of the table — padding it
    ;; to a column it has no field at would be inventing structure
    (assert= (commands/align-text "a = 1\n# note\nbbbb = 2" "=")
      "a    = 1\n# note\nbbbb = 2"))
  (test "it is IDEMPOTENT — running it twice is running it once"
    ;; an align that only ever adds space cannot be re-run after an edit, which is
    ;; exactly when you want it
    (let (once (commands/align-text "a = 1\nbbbb = 2" "=")
          twice (commands/align-text once "="))
      (assert= twice once)))
  (test "it also TIGHTENS a block that was over-padded"
    (assert= (commands/align-text "a        = 1\nbb       = 2" "=")
      "a  = 1\nbb = 2"))
  (test "the FIRST match on a line is the anchor"
    (assert= (commands/align-text "a = 1 = x\nbbbb = 2" "=")
      "a    = 1 = x\nbbbb = 2"))
  (test "a trailing newline survives"
    (assert= (commands/align-text "a = 1\nbb = 2\n" "=") "a  = 1\nbb = 2\n"))
  (test "the pattern is a regexp, not a literal"
    (assert= (commands/align-text "a -> 1\nbbb -> 2" "->") "a   -> 1\nbbb -> 2"))
  (test "no line matching leaves the text identical"
    (assert= (commands/align-text "one\ntwo" "=") "one\ntwo"))
  (test "the command needs a region"
    (is (includes? (:echo (commands/cmd-align-regexp (ed-init (make-buffer "a = 1")) nil))
          "no region"))))

;; ---- one edit path: modified, undo steps, read-only (issues S2/S3/C4) --------------
;; Every one of these was a command that changed the text by its own route: it did not
;; mark the buffer modified (so closing it lost the work without asking), undid in two
;; half-steps, or ignored a read-only buffer.

(defn- at (text point) (ed-set-buf (m-of text) (goto-char (make-buffer text) point)))
(defn- text-of (m) (buffer-text (cur m)))

(describe "every edit marks the buffer modified"
  (test "a kill, a yank, a query-replace and an undo each leave it modified"
    (is (buffer-modified? (cur (press (at "one\ntwo" 0) [:ctrl-k]))))
    (is (buffer-modified? (cur (press (at "one two" 0) [:alt-d]))))
    (is (buffer-modified? (cur (press (at "one\ntwo" 0) [:ctrl-k :ctrl-y :ctrl-y]))))
    (is (buffer-modified? (cur (press (at "foo foo" 0)
                                 [(keyword "alt-%") "f" "o" "o" :enter "b" :enter "y"])))))
  (test "undoing back to the text it was opened with is unmodified again"
    (refute (buffer-modified? (cur (press (at "one\ntwo" 0) [:ctrl-k :ctrl-/]))))))

(describe "a command that is several edits undoes in one step"
  (test "M-q then C-/ restores the paragraph"
    (let (m (press (at "aa\nbb\n" 0) [:alt-q]))
      (assert= (text-of m) "aa bb\n")
      (assert= (text-of (press m [:ctrl-/])) "aa\nbb\n")))
  (test "M-c then C-/ restores the word"
    (assert= (text-of (press (at "foo bar" 0) [:alt-c :ctrl-/])) "foo bar"))
  (test "C-t then C-/ restores both characters"
    (assert= (text-of (press (at "abcd" 2) [:ctrl-t :ctrl-/])) "abcd"))
  (test "query-replace ! then ONE C-/ puts every occurrence back"
    (let (m (press (at "foo foo foo" 0)
              [(keyword "alt-%") "f" "o" "o" :enter "b" "a" "r" :enter "!"]))
      (assert= (text-of m) "bar bar bar")
      (is (includes? (:echo m) "Replaced 3 occurrences"))
      (assert= (text-of (press m [:ctrl-/])) "foo foo foo")))
  (test "M-y then ONE C-/ undoes the swap, back to the first yank"
    (let (m (press (assoc (at "" 0) :kill-ring '("new" "old")) [:ctrl-y :alt-y]))
      (assert= (text-of m) "old")
      (assert= (text-of (press m [:ctrl-/])) "new"))))

(describe "a read-only buffer refuses kills and yanks cleanly"
  (defn- ro (text) (ed-set-buf (m-of text) (set-read-only (make-buffer text) true)))
  (test "C-y says the buffer is read-only and records no yank"
    (let (m (press (assoc (ro "abc") :kill-ring '("x")) [:ctrl-y]))
      (assert= (text-of m) "abc")
      (is (includes? (:echo m) "read-only"))
      (is (nil? (:yank m)))))
  (test "C-k at end of line kills nothing — the kill ring is untouched"
    (let (m (press (ed-set-buf (m-of "ab\ncd")
                     (set-read-only (goto-char (make-buffer "ab\ncd") 2) true))
              [:ctrl-k]))
      (assert= (text-of m) "ab\ncd")
      (is (includes? (:echo m) "read-only"))
      (is (empty? (or (:kill-ring m) []))))))

;; A prefix argument on a CHORD (issues C1/C2): the repeat used to re-run the keymap step
;; after the first had already ended the chord, so the final key was looked up at top
;; level and typed; and the negative (inverse) branch never cleared the chord at all.
(describe "a prefix argument on a chord"
  (test "C-u 3 C-x o runs the command three times and types nothing"
    (let (m (press (m-of "abc") [:ctrl-u "3" :ctrl-x "o"]))
      (assert= (text-of m) "abc")
      (is (nil? (:pending m)))))
  (test "C-u 3 C-f still repeats a plain key"
    (assert= (buffer-point (cur (press (at "abcdef" 0) [:ctrl-u "3" :ctrl-f]))) 3))
  (test "C-u - on a chord leaves no chord pending — the next key types"
    (let (m (press (at "abc" 0) [:ctrl-u "-" :alt-g "n"]))
      (is (nil? (:pending m)))
      (is (includes? (text-of (press m ["z"])) "z")))))

(describe "Tab in a prompt with nothing to complete against (issue C10)"
  (test "leaves the text as typed instead of calling a nil :complete-fn"
    (let (m (press (assoc (m-of "")
                     :minibuffer
                       {:edit (ed-mb-edit "Compile command: " "make") :on-complete (fn (mm t) mm)})
              [:tab]))
      (is (not (includes? (or (:echo m) "") "error")))
      (assert= (mb-text (:minibuffer m)) "make"))))

;; The transposes at their edges, as Emacs does them (issues E1/E2/E5).
(describe "transpose and kill at the edges"
  (test "C-t at end of line swaps the two characters before point, not the newline"
    (let (m (press (at "ab\ncd" 2) [:ctrl-t]))
      (assert= (text-of m) "ba\ncd")
      (assert= (buffer-point (cur m)) 2)))
  (test "C-t at end of buffer does the same"
    (assert= (text-of (press (at "abc" 3) [:ctrl-t])) "acb"))
  (test "C-t in the middle still swaps around point and moves on"
    (let (m (press (at "abcd" 2) [:ctrl-t]))
      (assert= (text-of m) "acbd")
      (assert= (buffer-point (cur m)) 3)))
  (test "C-x C-t twice drags a line down two places"
    (assert= (text-of (press (at "a\nb\nc\nd\n" 2) [:ctrl-x :ctrl-t :ctrl-x :ctrl-t]))
      "b\nc\na\nd\n"))
  (test "consecutive sentence kills coalesce into one kill-ring entry"
    (let (m (press (at "One. Two." 0) [:alt-k :alt-k]))
      (assert= (count (:kill-ring m)) 1))))

(describe "M-q keeps a paragraph's prefix (issue E3)"
  (test "a commented paragraph refills inside its comment"
    (assert= (text-of (press (at "  ;; aa\n  ;; bb\n" 0) [:alt-q])) "  ;; aa bb\n"))
  (test "an indented paragraph keeps its indentation"
    (assert= (text-of (press (at "    one\n    two\n" 0) [:alt-q])) "    one two\n"))
  (test "a plain paragraph is as before"
    (assert= (text-of (press (at "aa\nbb\n" 0) [:alt-q])) "aa bb\n")))

;; Horizontal scroll decides in display cells (issue C7): `:hscroll` is a character offset,
;; the pane is cells wide, and tabs make the two differ by up to eight per character.
(describe "horizontal scroll follows point in cells"
  (defn- point-cells-in-view? (m cols)
    (let (b (cur m)
          line (ed-strip-newline (buffer-line-at b (buffer-current-line b)))
          upto (fn (i)
                 (string/display-width (string/substring line 0 (math/min i (string/length line)))))
          from (upto (ed-current-hscroll m))
          at (upto (buffer-column b)))
      (and (>= at from) (< (- at from) cols))))
  (test "a line of leading tabs scrolls so the cursor is on screen"
    (let (text (str (string/repeat "\t" 10) "x")
          m (ed-scroll-horizontal (at text (string/length text)) 40))
      (is (> (ed-current-hscroll m) 0))
      (is (point-cells-in-view? m 40))))
  (test "a plain long line scrolls as it always did"
    (let (text (string/repeat "a" 100)
          m (ed-scroll-horizontal (at text 100) 40))
      (is (point-cells-in-view? m 40))
      (is (> (ed-current-hscroll m) 50)))))

(describe "C-M-h marks the defun as the buffer's mode sees one (issue E4)"
  (test "in a plain-text buffer, the paragraph — not a Brood parse of the prose"
    (let (m (press (at "one (two\nthree\n\nfour\n" 1) [:ctrl-meta-h])
          b (cur m))
      (assert= (buffer-region b) "one (two\nthree\n"))))

;; ROADMAP I.6: a frame is its own process and model, so each kept its own ring — a kill in
;; one window could not be M-y'd in the other. The live editor's ring is an agent now, and
;; every frame holds its pid.
(describe "one kill ring for every frame"
  (test "a kill in one model is the yank in another that shares the agent"
    (let (kill-agent (model/ed-start-kill-agent)
          first-frame (assoc (m-of "alpha beta") :kill-agent kill-agent)
          second-frame (assoc (m-of "") :kill-agent kill-agent)
          killed (press first-frame [:alt-d])
          yanked (press second-frame [:ctrl-y]))
      (assert= (buffer-text (cur killed)) " beta")
      (assert= (buffer-text (cur yanked)) "alpha")
      (agent/stop kill-agent)))
  (test "and M-y in the other reaches the older entries"
    (let (kill-agent (model/ed-start-kill-agent)
          first-frame (assoc (m-of "one two") :kill-agent kill-agent)
          _ (press first-frame [:alt-d :ctrl-f :alt-d])
          second-frame (assoc (m-of "") :kill-agent kill-agent)
          popped (press second-frame [:ctrl-y :alt-y]))
      (assert= (buffer-text (cur popped)) "one")
      (agent/stop kill-agent))))

;; ROADMAP D: M-y walks the ring blind; *Kill Ring* shows it all
(describe "browse-kill-ring"
  (test "lists the ring newest first, and RET inserts the entry back where you were"
    (let (m (assoc (m-of "x") :kill-ring '("newest" "older\ntwo lines"))
          shown (commands/cmd-browse-kill-ring m nil)
          text (buffer-text (cur shown)))
      (assert= (buffer-name (cur shown)) "*Kill Ring*")
      (is (< (index-of text "newest") (index-of text "older")))
      ;; onto the second entry, then RET
      (let (on-older (ed-set-buf shown (goto-char (cur shown) (index-of text "two lines")))
            inserted (press on-older [:enter]))
        (assert= (buffer-name (cur inserted)) "*scratch*")
        (is (string/starts-with? (buffer-text (cur inserted)) "older\ntwo lines"))
        ;; …and it is the newest entry now, so C-y repeats it
        (assert= (:kill-ring inserted) '("older\ntwo lines" "newest")))))
  (test "an empty ring says so"
    (is (includes? (buffer-text (cur (commands/cmd-browse-kill-ring (m-of "") nil))) "empty"))))

(describe "*Messages* keeps its newest message-log-max lines"
  (test "past the cap the oldest lines go, one cut at the head"
    (let (m (binding (*message-log-max* 3)
              (fold (range 5) (m-of "") (fn (acc i) (message acc (str "line " i)))))
          log (ed-buf-at m (or (ed-buffer-index-by-name m "*Messages*") (error "no *Messages*"))))
      (assert= (buffer-text log) "line 2\nline 3\nline 4\n")))
  (test "under the cap nothing is cut"
    (let (b (make-buffer "a\nb\n"))
      (assert= (buffer-text (ed-trim-head-lines b 2)) "a\nb\n")
      (assert= (buffer-text (ed-trim-head-lines b 1)) "b\n"))))

(describe "keyboard macro recording"
  (test "keys are appended in order to a vector"
    (let (m (press (assoc (m-of "") :macro-recording []) ["a" "b" :ctrl-f]))
      (assert= (:macro-recording m) ["a" "b" :ctrl-f]))))

(describe "ed-current-buf is the pool buffer itself once the pane's cursor is on it"
  (test "after an edit, repeated reads answer the same buffer as the pool"
    (let (m (ed-update (m-of "hello") "x" 80 24))
      (assert= (cur m) (ed-buf-at m (ed-current-index m)))
      (is (= (cur m) (cur m)))))
  (test "selecting the other pane on the same buffer writes its cursor to the pool"
    (let (m0 (ed-set-buf (m-of "0123456789") (goto-char (cur (m-of "0123456789")) 8))
          split (commands/cmd-split-pane-right m0 nil)
          moved (ed-set-buf split (goto-char (cur split) 2))
          other (press moved [:ctrl-x "o"]))
      (assert= (buffer-point (cur other)) 8)
      ;; the post step copied the selected pane's point back: no overlay per read
      (assert= (buffer-point (ed-buf-at other (ed-current-index other))) 8))))
