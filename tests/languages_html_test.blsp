;; HTML (src/languages/html.blsp): a `deflanguage` over tree-sitter-html, the page's `<style>` /
;; `<script>` injections, and its language-server row (src/lsp/client.blsp).
;; The mode half needs no grammar. The parsed half needs the grammar (`testkit/load-test-grammar`:
;; `$BROOD_TEST_GRAMMARS`, which CI fills, else the user's `~/.config/bedit/grammars`) and SKIPS
;; without it, as every runtime-loaded language's tests do.
(defmodule languages-html-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer face-at]))

(defn- face-of (name) (editor/face/face name))

(describe "html, the mode"
  (test "an .htm file opens in html mode too"
    (doseq (file ["/p/old.htm"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "html")))
  (test "it parses with tree-sitter-html, which says where it lives"
    (assert= (ed-mode-service (file-buffer "" "/p/a.html") :ts-lang) :html)
    (assert= (:url (model/grammar-source :html))
      "https://github.com/tree-sitter/tree-sitter-html"))
  (test "it has only a block comment"
    (assert= (ed-mode-service (file-buffer "" "/p/a.html") :comment-block) ["<!-- " " -->"]))
  (test "HTML embeds CSS and JavaScript, and only HTML holds a held tree's injections"
    (is (ed-mode-service (file-buffer "" "/p/a.html") :ts-injections))
    (is (nil? (ed-mode-service (file-buffer "" "/p/a.css") :ts-injections)))
    (assert= (into #{} (map languages/html/html-injections :lang)) #{:css :javascript}))
  (test "a page reaches VS Code's html server, as language id html"
    (assert= (into [] (map (lsp/client/lsp-specs-for "/p/index.html") :name)) ["html"])
    (assert= (lsp/client/lsp-language-id "/p/old.htm") "html")))

;; The sample, tests/corpus/html/index.html (prettier), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart. What stays here is
;; what a caret line cannot reach: the root tag in column 0, and the embedded CSS and JavaScript,
;; inside whose raw text an HTML comment would be content.
(def html-src (file/slurp "tests/corpus/html/index.html"))

(when (testkit/load-test-grammar :html)
  (test "html — the root element's tag is a keyword"
    (assert= (face-at (languages/html/html-fontify html-src) html-src "html lang")
      (face-of :syntax/keyword))))

(when (and (testkit/load-test-grammar :html) (testkit/load-test-grammar :css))
  (describe "a <style> element is CSS"
    (test "its property is coloured with CSS's table"
      (let (spans (languages/html/html-fontify html-src))
        (assert= (face-at spans html-src "color: red") (face-of :syntax/keyword))
        (assert= (face-at spans html-src "body {") (face-of :syntax/function))))))

(when (and (testkit/load-test-grammar :html) (testkit/load-test-grammar :javascript))
  (describe "a <script> element is JavaScript"
    (test "its call and its number are coloured with JavaScript's table"
      (let (spans (languages/html/html-fontify html-src))
        (assert= (face-at spans html-src "const") (face-of :syntax/keyword))
        (assert= (face-at spans html-src "compute(") (face-of :syntax/function))
        (assert= (face-at spans html-src "1);") (face-of :syntax/number))))))
