;; tests/codecrumbs_test.blsp — breadcrumbs for code: the definitions point is inside, by name,
;; read off the held parse; a Lisp's top-level form.

(defmodule codecrumbs-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use languages/crumbs))

(defn- crumbs-at (text file point)
  ;; the header line's crumbs with point at `point` of a `file` buffer, its parse held
  (let (m (ed-init (goto-char (make-buffer text file file) point))
        buffer (ed-current-buf m)
        lang (ed-mode-service buffer :ts-lang)
        tree (when lang (editor/treesit/open-tree (buffer-rope buffer) lang))
        found (headerline/crumbs buffer tree))
    (when tree (editor/treesit/free-tree tree))
    found))

(def- ruby
  "module Shop\n  class Cart\n    def total(items)\n      items.sum\n    end\n  end\nend\n")

(describe "breadcrumbs for code"
  (test "a definition's name is its first word that is not a keyword"
    (assert= (definition-name "  pub async fn fetch(url: &str) {") "fetch")
    (assert= (definition-name "defmodule XB.Probe do") "XB.Probe")
    (assert= (definition-name "class Cart < Base") "Cart"))
  (test "Ruby: the module, class and method around point"
    (assert= (crumbs-at ruby "a.rb" 45) '("Shop" "Cart" "total")))
  (test "Elixir: the defmodule and def calls around point"
    (assert= (crumbs-at "defmodule XB.Probe do\n  def run(x) do\n    x\n  end\nend\n" "a.ex" 34)
      '("XB.Probe" "run")))
  (test "outside every definition, none"
    (assert= (crumbs-at "x = 1\n" "a.rb" 1) '()))
  (test "a Lisp: the top-level form's name"
    (assert= (crumbs-at "(defn total (items)\n  (sum items))\n" "a.blsp" 25) '("total"))))

(describe "every definition in a buffer (M-g i without a server)"
  (test "Ruby: each definition by its path, where it starts"
    (let (m (ed-init (make-buffer ruby "a.rb" "a.rb"))
          buffer (ed-current-buf m)
          tree (editor/treesit/open-tree (buffer-rope buffer) :ruby)
          found (tree-definitions :ruby buffer tree))
      (editor/treesit/free-tree tree)
      (assert= (map found first) '("Shop" "Shop.Cart" "Shop.Cart.total"))
      (assert= (second (nth found 2)) 29)))
  (test "a Lisp: the top-level forms that define"
    (let (buffer (make-buffer "(defn total (items)\n  (sum items))\n\n(total [1])\n(def limit 3)\n"
                   "a.blsp" "a.blsp"))
      (assert= (map (form-definitions buffer) first) '("total" "limit"))))
  (test "M-g i with no server lists them and RET goes to one"
    (let (m (ed-init (make-buffer "(defn total (items)\n  (sum items))\n(def limit 3)\n"
                       "a.blsp" "/tmp/xrefgrep-imenu.blsp"))
          asked (lsp/xrefgrep/imenu m)
          chosen ((:on-complete (:minibuffer asked)) asked "limit"))
      (assert= (buffer-point (ed-current-buf chosen)) 35))))

;; ---- the name field (brood ADR-759) ------------------------------------------------------
;; A definition's name is the word its parse puts in the name field, whatever precedes it —
;; Java's return type, Go's receiver, C#'s modifiers.

(defn- crumb-names (lang file text)
  (vec (map (tree-definitions lang (make-buffer text file file) nil) first)))

(describe "a definition is named by its name field"
  :skip-unless (testkit/load-test-grammar :ruby)
  "no ruby grammar"
  (test "a Ruby method by its name, without the field rule's help"
    (assert= (crumb-names :ruby "/p/a.rb" "def greet\nend\n") ["greet"]))
  (test "Java's main, not its return type; Go's method, not its receiver; C#'s method, not its type"
    (when (testkit/load-test-grammar :java)
      (assert= (crumb-names :java
                 "/p/A.java" "class A {\n    public static void main(String[] args) {\n    }\n}\n")
        ["A" "A.main"]))
    (when (testkit/load-test-grammar :go)
      (assert= (crumb-names :go
                 "/p/a.go" "package p\n\nfunc (r *Rec) Name() string {\n\treturn \"\"\n}\n")
        ["Name"]))
    (when (testkit/load-test-grammar :c-sharp)
      (assert= (crumb-names :c-sharp
                 "/p/a.cs" "class A {\n    public async Task<int> Run() { return 1; }\n}\n")
        ["A" "A.Run"])))
  (test "C's function through its declarator"
    (when (testkit/load-test-grammar :c)
      (assert= (crumb-names :c "/p/a.c" "static int area(int w) {\n    return w;\n}\n") ["area"]))))
