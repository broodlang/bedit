;; tests/imageview_test.blsp — an image opens as a picture: find-file on a PNG gives an :image
;; buffer naming it, the pane paints it as one brood [:image …] op, and a file that does not decode is
;; the hex view.

(defmodule imageview-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use imageview))

(defn- png-file ()
  ;; a 4×2 PNG: the top row red, the bottom row blue
  (let (dir (temp-dir "bedit-image-"))
    (file/mkdir dir)
    (let (red [255 0 0 255]
          blue [0 0 255 255]
          rgba (into [] (append (mapcat (range 4) (fn (_) red)) (mapcat (range 4) (fn (_) blue))))
          path (path/join dir "dot.png"))
      (gui/write-png {:width 4
                      :height 2
                      :rgba (apply bytes/append (map rgba (fn (b) (bytes/int-> b 1))))}
        path)
      path)))

(defn- geometry (x y width text-height)
  ;; a pane body's geometry map, as `view` builds it, with no gutter or margin
  {:top 0
   :x x
   :y y
   :width width
   :gutter-width 0
   :margin-width 0
   :text-height text-height
   :render-height text-height
   :rows nil
   :top-continued nil
   :hscroll 0})

(describe "viewing an image"
  (test "find-file on a PNG opens an :image buffer that names it"
    (let (opened (pool/ed-find-file (ed-init (make-buffer "")) (png-file))
          buffer (ed-current-buf opened))
      (assert= (editor/layers/buffer-type-for buffer) :image)
      (is (string/starts-with? (buffer-text buffer) "PNG 4×2"))
      (is (read-only? buffer))))
  (test "the pane paints it as one [:image …] op over its text area, under the title line"
    (let (bytes (file/slurp-bytes (png-file))
          ops (image-layer nil nil {:image-bytes bytes} (geometry 2 1 30 10)))
      (assert= (count ops) 1)
      (let ([tag row col width height source placement] (vec (first ops)))
        (assert= tag :image)
        (assert= row 2)
        (assert= height 9)
        (is (> width 0))
        (is (>= col 2))
        (assert= source bytes)
        (assert= placement {:fit :scale-down :align :top-left}))))
  (test "a buffer's own placement is the one painted (doc-view fits its page)"
    (let (placement {:fit :contain :align :center}
          ops (image-layer nil
                nil
                {:image-bytes (file/slurp-bytes (png-file)) :image-placement placement}
                (geometry 0 0 20 5)))
      (assert= (nth (first ops) 6) placement)))
  (test "with no picture yet the layer paints nothing"
    (assert= (count (image-layer nil nil {} (geometry 0 0 20 5))) 0))
  (test "a file named like an image that does not decode is the hex view"
    (let (dir (temp-dir "bedit-image-"))
      (file/mkdir dir)
      (file/spit-bytes (path/join dir "broken.png") [0 1 2 3 255 0])
      (let (opened (pool/ed-find-file (ed-init (make-buffer "")) (path/join dir "broken.png")))
        (assert= (editor/layers/buffer-type-for (ed-current-buf opened)) :hexl)))))
