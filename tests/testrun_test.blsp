;; Tests for src/testrun.blsp — native test runs in a dedicated nest subprocess.
;; Pure folds + line parsing, plus one end-to-end run of the GENERATED script against
;; a throwaway fixture project — that pins the advised std seam (trace-result and the
;; r-* accessors) against upstream drift, which a pure test can't.
(defmodule testrun-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use-internals testrun)
  (:use-internals view))

(defn trt-model () (ed-init (make-buffer "x")))

(describe "testrun — rendering (pure)"
  (test "a passing result renders one indented ✓ row (name only, no visible path)"
    (let (lines (testrun-result-lines {:group "math"
                                       :name "adds"
                                       :passed true
                                       :ms 3
                                       :where "tests/math_test.blsp:7"}))
      (is (includes? lines "  ✓ adds")) ; indented under its describe header
      (is (not (includes? lines "›"))) ; the group is the header, not the row
      (is (includes? lines "(3 ms)"))
      ;; the row is CLEAN — the jump location is stored off-text, not shown
      (is (nil? (results/loc-at-line lines)))
      (assert= {:file "tests/math_test.blsp" :line 7 :col 1}
        (testrun/testrun-where->loc "tests/math_test.blsp:7"))))
  (test "a failing result renders its ✗ row plus file:line:col failure lines"
    (let (lines (testrun-result-lines {:group "math"
                                       :name "adds"
                                       :passed false
                                       :ms 1
                                       :failures [{:loc ["tests/math_test.blsp" 2 25]
                                                   :details ["assert: (assert= (+ 1 1) 3)"
                                                              "actual: 2" "expect: 3"]}]}))
      (is (includes? lines "  ✗ adds"))
      (is (includes? lines "tests/math_test.blsp:2:25: assert:"))
      (is (includes? lines "actual: 2"))))
  (test "a passing row colours the ✓ mark green and dims the timing, name stays default"
    (let (spans (testrun/testrun-fontify "  ✓ adds  (3 ms)")
          faces (map spans (fn (sp) (nth sp 2))))
      (is (includes? faces test-face-pass)) ; the ✓ mark is green
      (is (includes? faces test-face-timing)) ; the (3 ms) is dim
      (is (not (includes? faces test-face-name-fail))))) ; a pass doesn't red the name
  (test "a failing row reddens the mark AND the name"
    (let (spans (testrun/testrun-fontify "  ✗ nope  (1 ms)")
          faces (map spans (fn (sp) (nth sp 2))))
      (is (includes? faces test-face-fail))
      (is (includes? faces test-face-name-fail))
      (is (includes? faces test-face-timing))))
  (test "the describe header is the group; ungrouped falls back to (top level)"
    (is (includes? (testrun-result-lines {:group "" :name "solo" :passed true :ms 0}) "  ✓ solo"))
    (assert= "math" (testrun-group-header "math"))
    (assert= "(top level)" (testrun-group-header ""))))

(describe "the Brood adapter — stdout line decoding (pure)"
  (test "JSON events classify; dot-noise drops; prints pass through"
    (assert= :test (first (testadapter/brood-decode-line "{\"event\":\"test\",\"name\":\"n\"}")))
    (assert= :summary (first (testadapter/brood-decode-line "{\"event\":\"summary\",\"total\":1}")))
    (assert= [:drop] (testadapter/brood-decode-line "F.○."))
    (assert= [:drop] (testadapter/brood-decode-line "   "))
    (assert= [:output "hello from a test"] (testadapter/brood-decode-line "hello from a test")))
  (test "a dots-prefixed JSON line is salvaged from the first brace"
    (let ([kind value] (testadapter/brood-decode-line "F.{\"event\":\"summary\",\"total\":2}"))
      (assert= :summary kind)
      (assert= 2 (get value :total)))))

(describe "the shared location parse (results/loc-at-line — RET/click jump)"
  (test "file:line:col: parses; plain rows do not"
    (assert= {:file "tests/x_test.blsp" :line 42 :col 3}
      (results/loc-at-line "    tests/x_test.blsp:42:3: assert: boom"))
    (assert= {:file "src/a.blsp" :line 7 :col 1}
      (results/loc-at-line "src/a.blsp:7: whatever"))
    (is (nil? (results/loc-at-line "✓ math › adds  (3 ms)")))
    (is (nil? (results/loc-at-line "")))
    ;; a timestamp / host:port must NOT read as a location (findings #5/#12)
    (is (nil? (results/loc-at-line "12:34:56 INFO booting")))
    (is (nil? (results/loc-at-line "  | serving on http://localhost:5000")))
    (is (nil? (results/loc-at-line "  | listening on 0.0.0.0:8080")))))

(describe "testrun — model folds"
  (test "a test-result-event appends its row to *Tests* and counts it"
    (let (m (assoc (trt-model) :testrun {:gen 1 :passed 0 :failed 0})
          e (test-result-event {:group "g" :name "n" :passed true :ms 2} 1)
          m2 (ui-event-fold e m 24 80 24)
          i (ed-buffer-index-by-name! m2 "*Tests*"))
      (let (text (buffer-text (ed-buf-at m2 i)))
        (is (includes? text "g\n")) ; the describe header
        (is (includes? text "  ✓ n"))) ; the indented test row
      (assert= 1 (get-in m2 [:testrun :passed]))))
  (test "a test-summary-event appends the tally and echoes it"
    (let (m2 (ui-event-fold (test-summary-event {:total 3 :passed 2 :failed 1 :ms 40} 1)
               (assoc (trt-model) :testrun {:gen 1})
               24
               80
               24))
      (is (includes? (:echo m2) "2/3 passed"))
      (is (includes? (:echo m2) "1 FAILED"))))
  (test "a non-zero exit without a summary reports the runner death"
    (let (m2 (ui-event-fold (test-done-event 2 1) (assoc (trt-model) :testrun {:gen 1}) 24 80 24))
      (is (includes? (:echo m2) "exited 2"))))
  (test "results stream into a READ-ONLY *Tests* (the special-mode report) and it stays locked"
    ;; the real path: testrun-start shows *Tests* as :test-menu (read-only on activate),
    ;; then every result APPENDS — regression for the 'buffer is read-only' break
    (let (m (commands/ed-show-named (trt-model) "*Tests*" "-*- tests -*-\n\n" :test-menu)
          m2 (ui-event-fold (test-result-event {:group "g" :name "n" :passed true :ms 1} 1)
               (assoc m :testrun {:gen 1})
               24
               80
               24)
          i (ed-buffer-index-by-name! m2 "*Tests*")
          b (ed-buf-at m2 i))
      (is (includes? (buffer-text b) "  ✓ n"))
      (is (editor/buffer/read-only? b)))))

;; ---- end to end: the generated script against a fixture project ------------------
;; Slow-ish (a nest subprocess boots an image), so one test covers the whole path:
;; script generation -> nest run -> JSON events -> parseability. Uses the runner's
;; own dispatch indirectly by parsing the raw stdout the way testrun--feed does.

(defn trt-write-fixture (dir)
  (file/mkdir dir)
  (file/mkdir (str dir "/src"))
  (file/mkdir (str dir "/tests"))
  (file/spit (str dir "/project.blsp") "(project :name \"trt-fixture\" :version \"0.0.1\")")
  (file/spit (str dir "/src/core.blsp") "(defmodule core \"d\")\n(defn core-add (a b) (+ a b))")
  (file/spit (str dir "/tests/core_test.blsp")
    ;; `spy` in the passing one: both runners are supposed to stream what it traces into
    ;; *Tests*, and the warm one silently did not until the sink was installed for a run
    (str "(defmodule core-test (:use test) (:use core))\n"
      "(describe \"core\"\n" "  (test \"adds\" (assert= 5 (spy (core-add 2 3))))\n"
      "  (test \"fails\" (assert= 9 (core-add 2 3))))\n")))

(describe "testrun — end to end (fixture project, real subprocess)"
  :isolated (test "the generated runner streams one JSON event per test plus a summary"
    (let (dir (str "/tmp/bedit-trt-fixture-" (self-id))
          script (str dir "/runner.blsp"))
      (trt-write-fixture dir)
      (file/spit script
        (testrun/testrun-script-source (list {:file (str dir "/tests/core_test.blsp") :line nil})))
      (let (runner-proc (os/spawn "nest" ["run" script] {:cwd dir})
            out (letrec (drain (fn (acc)
                                 (receive
                                   ([:proc pp data] (drain (str acc data)))
                                   ([:proc-err pp data] (drain acc))
                                   ([:proc-closed pp code] (do
                                                             (check-allow :discarded-catch
                                                               (try
                                                                 (os/close runner-proc)
                                                                 (catch e :close-failed)))
                                                             acc))
                                   (after 30000 acc))))
                  (drain ""))
            events (seq/keep (string/split out "\n")
                     (fn (line)
                       (let (kv (testadapter/brood-decode-line line))
                         (when (or (= (first kv) :test) (= (first kv) :summary)) kv))))
            tests (seq/keep events (fn (kv) (when (= (first kv) :test) (second kv))))
            summary (first (seq/keep events (fn (kv) (when (= (first kv) :summary) (second kv))))))
        (assert= 2 (count tests))
        (let (adds (seq/find tests (fn (e) (= (get e :name) "adds")))
              fails (seq/find tests (fn (e) (= (get e :name) "fails"))))
          (assert= true (get adds :passed))
          (assert= false (get fails :passed))
          ;; the test row carries its declaration site (per-assertion :loc is nil
          ;; here — same as real `nest test` on this shape — so RET falls back to it)
          (is (includes? (get fails :where) "core_test.blsp:4")))
        (is (not (nil? summary)))
        (assert= 2 (get summary :total))
        (assert= 1 (get summary :failed))))))

;; self-id: a per-run unique suffix so parallel/repeat runs never share the fixture dir
(defn self-id () (:id (proc/info (self))))

(describe "testrun — margin verdicts on the test file's buffer"
  (test "a finished test stamps ✓/✗ at its declaration line; a fresh run clears them"
    (let (b (make-buffer "(describe \"g\"\n  (test \"n\" (is true)))"
              "x_test" "/proj/tests/x_test.blsp")
          m (ed-init b)
          m1 (ui-event-fold (test-result-event {:group "g"
                                                :name "n"
                                                :passed false
                                                :where "tests/x_test.blsp:2"}
                              1)
               (assoc m :testrun {:gen 1})
               24
               80
               24)
          marked (ed-buf-at m1 0))
      (assert= {1 false} (editor/buffer/annotation-value marked :test-marks))
      (assert= 2 (:lines (get marked :test-marks))) ; the annotation's line stamp
      ;; the mark renders through the shared gutter seam
      (assert= "✗" (first (modes/gutter-mark-for marked 1)))
      ;; a new run resets the old verdicts
      (is (nil? (:test-marks (ed-buf-at (testrun/testrun-clear-marks m1) 0))))))
  (test "the mark resolves UP to the (test …) head when :where points at the body"
    ;; multi-line test: head on line 1, first body form (what :where names) on line 2
    (let (b (make-buffer (str "(describe \"g\"\n" "  (test \"n\"\n" "    (is true)))")
              "x_test" "/proj/tests/x_test.blsp")
          m1 (ui-event-fold (test-result-event {:group "g"
                                                :name "n"
                                                :passed true
                                                :where "tests/x_test.blsp:3"}
                              1)
               (assoc (ed-init b) :testrun {:gen 1})
               24
               80
               24)
          marked (ed-buf-at m1 0))
      ;; :where says line 3 (0-based 2, the body) — the ✓ lands on the head (0-based 1)
      (assert= {1 true} (editor/buffer/annotation-value marked :test-marks))
      (assert= "✓" (first (modes/gutter-mark-for marked 1))))))

(describe "testrun — describe rollup marks"
  (defn rollup-buf ()
    ;; describe on line 1; three tests on lines 2,3,4; a following top-level form
    (make-buffer (str "(defmodule x-test (:use test))\n"
                   "(describe \"g\"\n" "  (test \"a\" (is true))\n" "  (test \"b\" (is true))\n"
                   "  (test \"c\" (is true)))\n" "(defn helper (x) x)")
      "x_test" "/proj/tests/x_test.blsp"))
  (test "the block counts its (test …) forms to the next top-level form"
    (assert= 3 (testrun/testrun-describe-test-total (rollup-buf) 1)))
  (test "all three passing → a ✓ rollup on the describe line"
    (let (m (assoc (ed-init (rollup-buf)) :testrun {:gen 1})
          fold (fn (mm nm ln)
                 (ui-event-fold (test-result-event {:group "g"
                                                    :name nm
                                                    :passed true
                                                    :where (str "tests/x_test.blsp:" ln)}
                                  1)
                   mm 24 80 24))
          m3 (fold (fold (fold m "a" 3) "b" 4) "c" 5)
          b (ed-buf-at m3 0))
      (assert= "✓" (first (modes/gutter-mark-for b 1))))) ; the describe line
  (test "one failing → a ◐ mixed rollup"
    (let (m (assoc (ed-init (rollup-buf)) :testrun {:gen 1})
          pass (ui-event-fold (test-result-event {:group "g"
                                                  :name "a"
                                                  :passed true
                                                  :where "tests/x_test.blsp:3"}
                                1)
                 m 24 80 24)
          fail (ui-event-fold (test-result-event {:group "g"
                                                  :name "b"
                                                  :passed false
                                                  :where "tests/x_test.blsp:4"}
                                1)
                 pass 24 80 24)
          b (ed-buf-at fail 0))
      (assert= "◐" (first (modes/gutter-mark-for b 1)))))
  (test "only one of three ran → a ◔ partial rollup"
    (let (m (assoc (ed-init (rollup-buf)) :testrun {:gen 1})
          one (ui-event-fold (test-result-event {:group "g"
                                                 :name "a"
                                                 :passed true
                                                 :where "tests/x_test.blsp:3"}
                               1)
                m 24 80 24)
          b (ed-buf-at one 0))
      (assert= "◔" (first (modes/gutter-mark-for b 1))))))

(describe "location jump — a clickable line resolves, output falls back above"
  (test "line-link-loc uses the default text parser and walks up for a locationless line"
    (let (b (make-buffer (str "    tests/x_test.blsp:13:5: assert: boom\n"
                           "        actual: 3\n" "  | some stdout from the test")))
      ;; line 0 has a location; the dim output lines below name none -> walk up to it
      (assert= 13 (:line (results/line-link-loc b 0)))
      (assert= 13 (:line (results/line-link-loc b 2))) ; output line -> nearest above
      ;; nothing above -> nil
      (is (nil? (results/line-link-loc (make-buffer "plain text\nmore text") 1))))))

(describe "link affordance — pointer cursor + hover on clickable rows"
  ;; a *Tests*-typed buffer with off-text links on lines 0 and 2 (its :line-loc reads them)
  (defn linky-buf ()
    (model/ed-stamp (assoc (editor/layers/set-buffer-type (make-buffer "web/req-log\n  ✓ start\n  ✗ done\n")
                             :test-menu)
                      :line-links
                        {0 {:file "a.blsp" :line 3 :col 1}
                         2 {:file "a.blsp" :line 9 :col 1}})))
  (defn linky-pane () {:payload {:buffer 0} :rect [0 0 40 20] :selected true})
  (test "line-link-loc resolves a stored row and clears an unlinked one"
    (let (b (linky-buf))
      (assert= 3 (:line (results/line-link-loc b 0)))
      (assert= 9 (:line (results/line-link-loc b 2)))))
  (test "the view emits a :pointer cursor-zone over each clickable line"
    (let (b (linky-buf)
          m {:buffers [b] :link-hover nil}
          ops (view/ed-pane-link-ops m (linky-pane) b 0 20 0 0 40 0 nil 0)
          zones (seq/filter ops (fn (op) (and (vector? op) (= (first op) :cursor-zone)))))
      (assert= 2 (count zones)) ; one per linked line
      (is (any? zones (fn (z) (= (last z) :pointer)))))) ; the hand shape
  (test "the underline covers only the row's text, not its leading indent"
    ;; line 1 of linky-buf is "  ✓ start" — 2-space indent; the underline must
    ;; start at char 2 (the ✓), not char 0
    (let (b (linky-buf)
          m {:buffers [b] :link-hover {:buffer 0 :line 1}}
          rand/rng (view/ed-link-hover-range m (linky-pane) b)
          [lo hi face] (first rand/rng)
          bol (text/line->char (editor/buffer/buffer-rope b) 1))
      (is (not (empty? rand/rng)))
      (assert= {:underline true} face)
      (assert= 2 (- lo bol)) ; starts after the 2-space indent
      (is (> hi lo))
      ;; a pane not holding the hovered buffer gets none
      (is (empty? (view/ed-link-hover-range m {:payload {:buffer 5}} b)))))
  (test "a zoomed pane's link zones ride INSIDE its cell-region, in the region's cells"
    ;; The zones are body ops, so a zoom puts them inside the region — which is only
    ;; hoverable because the frontend's zone walk recurses into `cell-region` (brood's
    ;; ADR-080 amendment). Before it did, zooming a results pane silently lost the hand.
    (let (m (assoc (model/ed-init (linky-buf)) :gui true)
          pane (first (:panes (panes/ed-body-layout m 80 24)))
          zoomed (assoc-in pane [:payload :zoom] {:px 30 :ratio [2 2]})
          ops (view/ed-pane-ops m zoomed)
          region (seq/find ops (fn (op) (and (vector? op) (= (first op) :cell-region))))
          pointer? (fn (op) (and (vector? op) (= (first op) :cursor-zone) (= (last op) :pointer))))
      (is (not (nil? region)))
      (is (not (any? ops pointer?))) ; none escaped to the window's cells
      (is (any? (nth region 6) pointer?)))) ; both are in the region, at its size
  (test "the click hit-test: a link line navigates, a non-link line is inert"
    ;; a single-pane model over linky-buf (links on lines 0 and 2, not 1)
    (let (m (model/ed-init (linky-buf)))
      (assert= :link (first (view/ed-results-link-at m 80 24 0 4))) ; line 0 → a link
      (assert= :inert (first (view/ed-results-link-at m 80 24 1 4))) ; line 1 → no link
      (assert= :link (first (view/ed-results-link-at m 80 24 2 4))) ; line 2 → a link
      ;; an ordinary buffer (no :line-loc) → nil (normal click, untouched)
      (is
        (nil?
          (view/ed-results-link-at
            (model/ed-init
              (make-buffer
                "plain
text"))
            80
            24
            0
            2))))))

;; ---- the warm node: the same suite, without the VM boot ------------------------------
;; An Elixir run costs a VM start and a compile before its first verdict; `elixir-test`
;; keeps a `MIX_ENV=test` node up and the verdicts stream back one per test. Everything
;; below is that path's model side — what the node is asked for, and what its replies
;; become — which is all of it apart from the node itself.
(describe "testrun — the warm Elixir node"
  (defn- wt-model (&optional (specs '()))
    (assoc (trt-model)
      :project-root "/p"
      :testrun {:gen 1
                :warm-id 7
                :warm-session :elixir-test
                :warm-restart "M-x elixir-test-restart"
                :passed 0
                :failed 0
                :last-group nil
                :specs specs}))

  ;; Each language addresses a test its own way, and the backend row is where that lives —
  ;; so a third one is an entry in the table rather than another branch in the runner.
  (test "Elixir is addressed the way ExUnit addresses a test: paths, root-relative"
    (let (m (assoc (trt-model) :project-root "/p"))
      (assert= (testrun/warm-elixir-specs m (list {:file "/p/test/a_test.exs" :line nil}))
        ["test/a_test.exs"])
      (assert= (testrun/warm-elixir-specs m (list {:file "/p/test/a_test.exs" :line 12}))
        ["test/a_test.exs:12"])
      ;; the whole suite is ExUnit's own default directory, not an empty list
      (assert= (testrun/warm-elixir-specs m '()) ["test"])))

  (test "Brood is addressed by absolute file and line, and an empty list is the suite"
    ;; absolute, because the child resolves `reflect/load` against its own working
    ;; directory and a relative path that happens to work is a coincidence
    (let (m (assoc (trt-model) :project-root "/p"))
      (assert= (testrun/warm-brood-specs m (list {:file "/p/tests/a_test.blsp" :line nil}))
        [["/p/tests/a_test.blsp" nil]])
      (assert= (testrun/warm-brood-specs m (list {:file "/p/tests/a_test.blsp" :line 12}))
        [["/p/tests/a_test.blsp" 12]])
      (assert= (testrun/warm-brood-specs m '()) [])))

  (test "a streamed verdict is one finished test, applied like any other"
    (let (m (wt-model)
          m2 (testrun/testrun-warm-reply m
               {:id 7
                :more true
                :test {:group "add/2"
                       :name "adds two numbers"
                       :passed true
                       :ms 3
                       :where "test/warmproj_test.exs:5"
                       :failures []}}
               80
               24)
          text (buffer-text (ed-buf-at m2 (or (ed-buffer-index-by-name m2 "*Tests*") 0))))
      (assert= (get-in m2 [:testrun :passed]) 1)
      (is (includes? text "adds two numbers"))
      ;; the describe header, emitted the first time its group is seen
      (is (includes? text "add/2"))))

  (test "the final reply is the summary, and `passed` is arithmetic rather than a claim"
    ;; the node counts what it counted — total, failed, skipped — and the two runners'
    ;; summaries cannot drift if only one of them does the subtraction
    (let (m (wt-model)
          m2 (testrun/testrun-warm-reply m
               {:id 7 :ok true :summary {:total 10 :failed 2 :skipped 3 :ms 42}}
               80
               24))
      (is (includes? (:echo m2) "5/10 passed"))
      (is (includes? (:echo m2) "2 FAILED"))))

  (test "a reply from a run you have moved past is dropped"
    (let (m (wt-model)
          m2 (testrun/testrun-warm-reply m {:id 99 :more true :test {:group "g" :name "n"}} 80 24))
      (assert= (get-in m2 [:testrun :passed]) 0)))

  (test "a failed run says why, and a wedged node says which key fixes it"
    (let (m (wt-model)
          broken (testrun/testrun-warm-reply m {:id 7 :ok false :error "no such test file: x"} 80 24)
          wedged (testrun/testrun-warm-reply m {:id 7 :timeout true} 80 24))
      (is (includes? (:echo broken) "no such test file"))
      (is (includes? (:echo wedged) "elixir-test-restart"))))

  ;; The node is only faster than a cold run once it is past its own compile. A worker that
  ;; is merely alive would QUEUE the request behind that boot — the cold wait, with none of
  ;; the cold feedback.
  (test "a node that has not announced itself is not ready"
    (is (not (testrun/warm-ready? (trt-model))))
    (is (not (testrun/warm-ready? (assoc-in (trt-model) [:warm-tests :brood-test :ready] nil)))))

  (test "the ready banner arms it and the node going away disarms it"
    ;; folded through the SHARED router now — one event vocabulary, scoped by the session
    ;; name on the event, rather than records of its own
    (let (up (ui-event-fold (session/session-ready :elixir-test 4 {:ready true})
               (trt-model)
               24
               80
               24))
      (assert= (get-in up [:warm-tests :elixir-test :ready]) 4)
      (is
        (nil?
          (get-in (ui-event-fold (session/session-down :elixir-test 1 4) up 24 80 24)
            [:warm-tests :elixir-test :ready])))
      ;; and a DIFFERENT session saying the same thing says nothing about this one — which
      ;; is the whole reason the name rides on the event
      (assert= (get-in (ui-event-fold (session/session-down :sandbox 1 4) up 24 80 24)
                 [:warm-tests :elixir-test :ready])
        4))))

;; ---- one table, one row per language --------------------------------------------
;; The warm path is written against `*warm-backends*`, so a third language is an entry
;; rather than another branch in the runner. These pin the two rows that exist and the
;; rule that picks between them.
(describe "testrun — which warm session a project gets"
  (test "a Brood project gets the Brood session, and says which restart fixes it"
    ;; this repo IS one, so `toolchain/adapter-id` resolves against a real root
    (let (m (assoc (trt-model) :project-root (file/cwd))
          backend (testrun/warm-backend m))
      (is (not (nil? backend)))
      (assert= (get backend :session) :brood-test)
      (assert= (get backend :adapter) :brood)
      (is (includes? (get backend :restart) "brood-test-restart"))))

  (test "a project with no toolchain row gets no warm session"
    (let (m (assoc (trt-model) :project-root "/tmp"))
      (is (nil? (testrun/warm-backend m)))))

  ;; The switch a machine flips when a resident runtime per project is not a trade it
  ;; wants — the cold runner is what every other editor gives you anyway.
  (test "switching warm sessions off leaves only the cold runner"
    (let (m (assoc (trt-model) :project-root (file/cwd)))
      (binding (*warm-tests* false) (is (nil? (testrun/warm-backend m))))
      (is (not (nil? (testrun/warm-backend m))))))

  (test "a backend whose module has not loaded is not a backend yet"
    ;; every row names a DEFERRED module; naming them eagerly would load a BEAM agent into
    ;; an editor that never opens an Elixir file
    (let (m (assoc (trt-model) :project-root (file/cwd)))
      (is (not (testrun/warm-ready? m))))) ; nothing started, so nothing is ready

  (test "each row's hooks are symbols, resolved late"
    (doseq (b *warm-backends*)
      (doseq (k [:applies? :specs :running? :start :run :reset])
        (is (symbol? (get b k))))
      (is (keyword? (get b :session)))
      (is (keyword? (get b :adapter)))
      (is (string? (get b :restart))))))

;; A session is kept alive by the project that USES it, not merely by a *Tests* buffer.
;; Without that, an editor that had run an Elixir suite and moved to a Brood project
;; answered "somebody is watching" for the Elixir node — so its death was followed by a
;; respawn, which in a mix project recompiles the whole thing for a project you have left.
(describe "testrun — which session a *Tests* buffer keeps alive"
  (test "a Brood project keeps the Brood session, not the Elixir one"
    (let (m (commands/ed-show-named (assoc (trt-model) :project-root (file/cwd))
              "*Tests*"
              "-*- tests -*-\n\n"
              :test-menu))
      (is (testrun/warm-live-brood? m))
      (is (not (testrun/warm-live-elixir? m)))))

  (test "and with no *Tests* buffer, nothing is watching either of them"
    (let (m (assoc (trt-model) :project-root (file/cwd)))
      (is (not (testrun/warm-live-brood? m)))
      (is (not (testrun/warm-live-elixir? m))))))

;; A warm session tests the code on disk, not the code it booted with — and says so when
;; it had to pick something up. The alternative is the worst thing a test runner can do:
;; report green for a function you have already broken.
(describe "testrun — a warm run says what it had to reload"
  (test "the note appears only when something was reloaded"
    (assert= (testrun/warm-reload-note {:reloaded 0}) "")
    (assert= (testrun/warm-reload-note {}) "")
    (is (includes? (testrun/warm-reload-note {:reloaded 1}) "reloaded 1 source first"))
    ;; plural, because "reloaded 3 source first" reads as a typo in a report people scan
    (is (includes? (testrun/warm-reload-note {:reloaded 3}) "reloaded 3 sources first")))

  (test "the summary carries it through to the buffer"
    (let (m (assoc (trt-model)
              :testrun {:gen 1 :warm-id 7 :passed 0 :failed 0 :last-group nil})
          m2 (testrun/testrun-warm-reply m
               {:id 7 :ok true :summary {:total 2 :failed 0 :passed 2 :ms 5 :reloaded 2}}
               80
               24)
          text (buffer-text (ed-buf-at m2 (or (ed-buffer-index-by-name m2 "*Tests*") 0))))
      (is (includes? text "reloaded 2 sources first"))
      (is (includes? (:echo m2) "2/2 passed"))))

  (test "a run that reloaded nothing says nothing about it"
    (let (m (assoc (trt-model)
              :testrun {:gen 1 :warm-id 7 :passed 0 :failed 0 :last-group nil})
          m2 (testrun/testrun-warm-reply m
               {:id 7 :ok true :summary {:total 1 :failed 0 :passed 1 :ms 1}}
               80
               24)
          text (buffer-text (ed-buf-at m2 (or (ed-buffer-index-by-name m2 "*Tests*") 0))))
      (is (not (includes? text "reloaded"))))))

;; ---- end to end through the MODEL (a real warm session) -------------------------
;; The other end-to-end test drives the cold runner's script and parses its stdout. This
;; one drives the WARM path the way the editor does: a real `brood-test` child, its events
;; folded through `ui-event-fold` exactly as the loop folds them, asserting on the *Tests*
;; buffer that comes out. It is the only test that covers the whole chain — session,
;; streaming `:more` replies, the router, the fold, the rendering — and every piece of that
;; chain was built this session on probes rather than on tests.

(defn trt-fold-session (m deadline stop?)
  "Receive this session's events and fold each through `ui-event-fold`, as the `ui-run` loop
does, until `stop?` says this was the one we were waiting for (or `deadline` passes).

The barrier is a predicate rather than \"a reply arrived\" because the two waits are for
different events: the ready banner is not a reply, and waiting for one that never comes is
sixty seconds of a test suite doing nothing."
  (letrec (go (fn (mm)
                (receive
                  (e (let (mm2 (check-allow :discarded-catch
                                 (try (ui-event-fold e mm 24 80 24) (catch _ mm))))
                       (if (stop? e) mm2 (go mm2))))
                  (after (math/max 0 (- deadline (os/now))) mm))))
    (go m)))

(defn trt-ready? (e) (= (get e :__id__) :bedit/session/session-ready))

(defn trt-final-reply? (e)
  (and (= (get e :__id__) :bedit/session/session-reply) (not (get (get e :reply) :more))))

(describe "testrun — end to end through the model (a real warm session)"
  :isolated (test "a warm run fills *Tests* with rows, marks and a summary"
    (let (dir (str "/tmp/bedit-warm-e2e-" (self-id))
          test-file (str dir "/tests/core_test.blsp"))
      (trt-write-fixture dir)
      ;; this test process IS the sink, so the events arrive here rather than at :editor
      (brood-test/brood-test-start dir (self))
      ;; the banner is the barrier: a request sent before it queues, and we want the run
      ;; timed against a child that is up
      (let (ready (trt-fold-session (assoc (trt-model) :project-root dir) (+ (os/now) 60000) trt-ready?)
            m (assoc ready
                :testrun {:gen 1
                          :warm-id 1
                          :warm-restart "M-x brood-test-restart"
                          :passed 0
                          :failed 0
                          :last-group nil})
            _ (brood-test/brood-test-run 1 [[test-file nil]])
            done (trt-fold-session m (+ (os/now) 60000) trt-final-reply?)
            i (or (ed-buffer-index-by-name done "*Tests*")
                (error "the warm run never opened *Tests*"))
            text (buffer-text (ed-buf-at done i)))
        (brood-test/brood-test-shutdown)
        ;; the fixture has one passing test and one failing one
        (is (includes? text "✓ adds"))
        (is (includes? text "✗ fails"))
        (is (includes? text "core")) ; the describe header
        ;; the rows are CLEAN — the jump location is stored off-text (`:line-links`), which
        ;; is what RET in *Tests* reads and what a visible path would only duplicate
        (is (not (empty? (:line-links (ed-buf-at done i)))))
        ;; …and the counters the summary echo is built from
        (assert= (get-in done [:testrun :passed]) 1)
        (assert= (get-in done [:testrun :failed]) 1)
        (is (includes? (:echo done) "1/2 passed"))
        (is (includes? (:echo done) "1 FAILED"))
        ;; …and `spy` inside a test reached the buffer too — the cold runner streams it
        ;; through its stdout tap, and the warm one has to stream it as chunks of the run
        ;; or the same key means different things in the same project
        (is (includes? text "core-add"))))))

;; ---- stopping a run in flight ----------------------------------------------------
;; The eval-server answers strictly request→reply, so while a suite runs it is not reading
;; its own stdin and a stop request would sit unread until the thing it was meant to
;; abandon had finished. The loop reads through a separate process for exactly this, and
;; this is the test that the restructure works: a suite that would take five seconds is
;; abandoned in well under one.
(describe "testrun — a warm run can be abandoned"
  :isolated (test "a stop kills the run and answers both the run and the stop"
    (let (dir (str "/tmp/bedit-warm-stop-" (self-id)))
      (file/mkdir dir)
      (file/mkdir (str dir "/tests"))
      (file/spit (str dir "/project.blsp") "(project :name \"stopfix\" :version \"0.0.1\")")
      (file/spit (str dir "/tests/slow_test.blsp")
        (str "(defmodule slow-test (:use test))\n"
          "(describe \"slow\"\n" "  (test \"quick\" (is true))\n"
          "  (test \"slow\" (do (sleep 5000) (is true))))\n"))
      (brood-test/brood-test-start dir (self))
      (let (_ (trt-fold-session (trt-model) (+ (os/now) 60000) trt-ready?)
            started (os/now)
            _ (brood-test/brood-test-run 1 [[(str dir "/tests/slow_test.blsp") nil]])
            ;; the first verdict means the quick one is done and the slow one is running
            _ (trt-fold-session (trt-model) (+ (os/now) 30000)
                (fn (e)
                  (let (r (when (= (get e :__id__) :bedit/session/session-reply) (get e :reply)))
                    (and r (get r :test)))))
            _ (brood-test/brood-test-stop 99)
            ;; …and both replies are owed: the abandoned run, then the stop itself
            _ (trt-fold-session (trt-model) (+ (os/now) 30000)
                      (fn (e)
                        (let (r (when (= (get e :__id__) :bedit/session/session-reply) (get e :reply)))
                          (and r (= (get r :id) 99) (get r :stopped)))))
            elapsed (- (os/now) started))
        (brood-test/brood-test-shutdown)
        ;; the slow test sleeps five seconds; abandoning it must not wait them out
        (is (< elapsed 4000))))))

(describe "testrun — the *Tests* banner names the runner"
  (test "cold and warm are told apart, and the label always survives"
    (is (includes? (testrun/tests-header "math_test.blsp" "cold") "math_test.blsp"))
    (is (includes? (testrun/tests-header "math_test.blsp" "cold") "cold"))
    (is (includes? (testrun/tests-header "x" "warm · brood-test") "warm · brood-test"))
    ;; no mode named is the old banner, unchanged
    (assert= (testrun/tests-header "x" nil) "-*- tests: x -*-\n\n")))

(describe "testrun — a stopped run is not a failed run"
  (test "a `:stopped` reply says so rather than reporting a failure"
    (let (m (assoc (trt-model)
              :testrun {:gen 1 :warm-id 7 :passed 0 :failed 0 :last-group nil})
          m2 (testrun/testrun-warm-reply m {:id 7 :ok false :stopped true} 80 24))
      (is (includes? (:echo m2) "stopped"))
      (is (not (includes? (:echo m2) "failed"))))))

;; A line-filtered run is what `C-c t t` sends — the framework's own FILE:LINE resolution,
;; "the last test declared at or before this line". The spec shapes are pinned above; this
;; is the round trip that proves the filter actually narrows.
(describe "testrun — a warm run narrowed to one test"
  :isolated (test "a spec carrying a line runs that test and not its neighbour"
    (let (dir (str "/tmp/bedit-warm-line-" (self-id))
          test-file (str dir "/tests/core_test.blsp"))
      (trt-write-fixture dir)
      (brood-test/brood-test-start dir (self))
      (let (_ (trt-fold-session (trt-model) (+ (os/now) 60000) trt-ready?)
            base (assoc (trt-model)
                   :project-root dir
                   :testrun {:gen 1 :warm-id 1 :passed 0 :failed 0 :last-group nil})
            ;; line 3 is the `adds` test; `fails` is on line 4
            _ (brood-test/brood-test-run 1 [[test-file 3]])
            done (trt-fold-session base (+ (os/now) 60000) trt-final-reply?)
            i (or (ed-buffer-index-by-name done "*Tests*") (error "no *Tests*"))
            text (buffer-text (ed-buf-at done i)))
        (brood-test/brood-test-shutdown)
        (is (includes? text "adds"))
        (is (not (includes? text "fails")))
        (assert= (get-in done [:testrun :passed]) 1)
        (assert= (get-in done [:testrun :failed]) 0)))))

;; `nest run <file>` inside a project runs `<file>` as a script only when it ends in
;; `.blsp`; anything else is a document to open, and the project's own `:main` runs.
(describe "the generated runner scripts are .blsp"
  (test "the test runner and the app runner"
    (is (string/ends-with? *testrun-script-path* ".blsp"))
    (is (string/ends-with? apprun/*apprun-script-path* ".blsp"))))
