;; Which buffers number their lines, and how (src/display-settings.blsp `ed-line-numbers-for`, the
;; gutter's `line-number-cell`): Emacs turns line numbers on from a mode's hook —
;; `prog-mode-hook` reaches every code mode and no prose — and picks relative numbering
;; with `display-line-numbers-type`. The init file's `:line-numbers` says both, per mode.
(defmodule line-numbers-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use display-settings) ; the per-mode display settings, bound per test
  (:use scroll))

(defn- buffer-of (text path)
  (ed-current-buf (ed-init (make-buffer text path path))))

(def- code "(def a 1)\n(def b 2)\n(def c 3)\n(def d 4)")

(describe "the :line-numbers setting, per mode"
  (test "by default code is numbered, and prose and special buffers are not"
    (binding (*line-numbers* *line-numbers-defaults*)
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) true)
      (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) false)
      (assert= (ed-line-numbers-for (buffer-of "# x" "/tmp/n.md")) false)))
  (test "a map in the init file is merged over the defaults; a bare value sets every buffer"
    (ed-set-line-numbers {'markdown true})
    (let (merged *line-numbers*)
      (ed-set-line-numbers true)
      (let (every *line-numbers*)
        (ed-set-line-numbers nil)
        (binding (*line-numbers* merged)
          (assert= (ed-line-numbers-for (buffer-of "# x" "/tmp/n.md")) true)
          (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) false)
          (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) true))
        (binding (*line-numbers* every)
          (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) true)))))
  (test "a plain setting holds for every buffer"
    (binding (*line-numbers* :relative)
      (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) :relative)
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) :relative)))
  (test "a map reaches a code mode through :prog, and prose takes :default"
    (binding (*line-numbers* {:default false :prog :relative})
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) :relative)
      (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) false)))
  (test "the most specific mode the map names wins, as a mode's own hook runs last"
    (binding (*line-numbers* {:default false :prog :relative 'brood true})
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) true)))
  (test "false hides the numbers (a file keeps its fringe); C-x l's pane override still wins"
    (binding (*line-numbers* {:default false})
      (let (m (ed-init (make-buffer "x" "/tmp/n.txt" "/tmp/n.txt"))
            buf (ed-current-buf m)
            pane (first (:panes (panes/ed-body-layout m 80 24)))
            forced (assoc pane :payload (assoc (:payload pane) :line-numbers true)))
        (assert= (panes/ed-pane-gutter-width buf pane) gutter/line-number-bar-width)
        (is (> (panes/ed-pane-gutter-width buf forced) gutter/line-number-bar-width)))))
  (test "the init file's value is checked: a mode map of true / false / :relative"
    (is (config/line-numbers-valid? :relative))
    (is (config/line-numbers-valid? {:default false :prog :relative 'elixir true}))
    (is (not (config/line-numbers-valid? :absolute)))
    (is (not (config/line-numbers-valid? {:prog "yes"})))))

(describe "relative numbering"
  (test "point's line shows its own number, the others their distance from it"
    (binding (*line-numbers* :relative)
      (let (buf (goto-char (buffer-of code "/tmp/n.blsp") 10) ; line 1
            gw (gutter/line-number-width buf)
            number-of (fn (line)
                        (string/trim (first (second (gutter/line-number-cell buf line gw))))))
        (assert= (map (range 4) number-of) (list "1" "2" "1" "2"))
        (assert= (second (second (gutter/line-number-cell buf 1 gw)))
          gutter/gutter-face-line-number-current))))
  (test "moving point re-numbers the column: the cached cells key on point's line"
    (binding (*line-numbers* :relative)
      (let (m (spancache/ed-refresh-spans (ed-init (make-buffer code "/tmp/n.blsp" "/tmp/n.blsp"))
                80 24)
            ;; the column is cached for line 0; moving must not be served from it
            moved (spancache/ed-refresh-spans (input/ed-update m :ctrl-n 80 24) 80 24)
            numbers (fn (model)
                      (map (seq/filter (view/ed-view model 80 24)
                             (fn (op) (and (vector? op) (= (first op) :text) (= (nth op 2) 1))))
                        (fn (op) (string/trim (nth op 3))))))
        (assert= (take (numbers m) 4) (list "1" "1" "2" "3"))
        (assert= (take (numbers moved) 4) (list "1" "2" "1" "2"))))))

(describe "an unnumbered file keeps its fringe"
  ;; Emacs's fringe outlives `display-line-numbers-mode`: a prose file's change bar still shows
  (test "a prose file reserves the mark column alone, and its cell is the mark"
    (binding (*line-numbers* *line-numbers-defaults*)
      (let (m (ed-init (make-buffer "one\ntwo\n" "/tmp/n.md" "/tmp/n.md"))
            buf (ed-current-buf m)
            pane (panes/ed-selected-pane (:panes (panes/ed-body-layout m 80 24))))
        (assert= (panes/ed-pane-gutter-width buf pane) gutter/line-number-bar-width)
        (assert= (count (gutter/line-number-cell buf 0 gutter/line-number-bar-width)) 1))))
  (test "a buffer with no file spends no column"
    (binding (*line-numbers* *line-numbers-defaults*)
      (let (m (ed-init (make-buffer "one\ntwo\n")))
        (assert= (panes/ed-pane-gutter-width (ed-current-buf m)
                   (panes/ed-selected-pane (:panes (panes/ed-body-layout m 80 24))))
          0)))))

;; The gutter's cells are cached across frames with their faces resolved, and the current line's
;; number is painted over them. A theme applied since must reach both: the cells rebuild on the
;; theme's generation (`spancache/ed-gutter-key`), and the current number is found by its role in
;; the cell (`:line-number`), not by comparing its face with the live one — which stopped matching
;; the moment the theme changed, and the highlight vanished.
(describe "the current line's number across a theme switch"
  :isolated (test "is still painted in face-gutter-line-current, the other numbers in face-gutter-line"
    (binding (*line-numbers* *line-numbers-defaults*)
      (let (numbers (fn (model)
                      ;; the ops that paint line 1's number (" 1 ", in the digit columns), by face
                      (map (seq/filter (view/ed-view model 80 10)
                             (fn (op)
                               (and (vector? op)
                                 (= (first op) :text)
                                 (= (nth op 2) 1)
                                 (= (string/trim (nth op 3)) "1"))))
                        (fn (op) (nth op 4))))
            m (input/ed-update (testkit/file-model code "/p/n.blsp") [:resize 80 10] 80 10)
            switched (themes/themes-apply m "Catppuccin Latte (light)")
            current (:fg theme/face-gutter-line-current)
            dim (:fg theme/face-gutter-line)
            painted (numbers (input/ed-update switched [:resize 80 10] 80 10)))
        (theme/theme-apply! theme/*theme-mocha*)
        (assert= (map painted :fg) (list dim current))))))
