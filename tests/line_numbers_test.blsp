;; Which buffers number their lines, and how (src/scroll.blsp `ed-line-numbers-for`, the
;; gutter's `line-number-cell`): Emacs turns line numbers on from a mode's hook —
;; `prog-mode-hook` reaches every code mode and no prose — and picks relative numbering
;; with `display-line-numbers-type`. The init file's `:line-numbers` says both, per mode.
(defmodule line-numbers-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use scroll))

(defn- buffer-of (text path)
  (ed-current-buf (ed-init (make-buffer text path path))))

(def- code "(def a 1)\n(def b 2)\n(def c 3)\n(def d 4)")

(describe "the :line-numbers setting, per mode"
  (test "a plain setting holds for every buffer"
    (binding (*line-numbers* :relative)
      (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) :relative)
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) :relative)))
  (test "a map reaches a code mode through :prog, and prose takes :default"
    (binding (*line-numbers* {:default false :prog :relative})
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) :relative)
      (assert= (ed-line-numbers-for (buffer-of "x" "/tmp/n.txt")) false)))
  (test "the most specific mode the map names wins, as a mode's own hook runs last"
    (binding (*line-numbers* {:default false :prog :relative 'brood true})
      (assert= (ed-line-numbers-for (buffer-of code "/tmp/n.blsp")) true)))
  (test "false hides the gutter; C-x l's pane override still wins"
    (binding (*line-numbers* {:default false})
      (let (m (ed-init (make-buffer "x" "/tmp/n.txt" "/tmp/n.txt"))
            buf (ed-current-buf m)
            pane (first (:panes (panes/ed-body-layout m 80 24)))
            forced (assoc pane :payload (assoc (:payload pane) :line-numbers true)))
        (assert= (panes/ed-pane-gutter-width buf pane) 0)
        (is (> (panes/ed-pane-gutter-width buf forced) 0)))))
  (test "the init file's value is checked: a mode map of true / false / :relative"
    (is (config/line-numbers-valid? :relative))
    (is (config/line-numbers-valid? {:default false :prog :relative 'elixir true}))
    (is (not (config/line-numbers-valid? :absolute)))
    (is (not (config/line-numbers-valid? {:prog "yes"})))))

(describe "relative numbering"
  (test "point's line shows its own number, the others their distance from it"
    (binding (*line-numbers* :relative)
      (let (buf (goto-char (buffer-of code "/tmp/n.blsp") 10) ; line 1
            gw (gutter/line-number-width buf)
            number-of (fn (line)
                        (string/trim (first (second (gutter/line-number-cell buf line gw))))))
        (assert= (map (range 4) number-of) (list "1" "2" "1" "2"))
        (assert= (second (second (gutter/line-number-cell buf 1 gw)))
          gutter/gutter-face-line-number-current))))
  (test "moving point re-numbers the column: the cached cells key on point's line"
    (binding (*line-numbers* :relative)
      (let (m (panes/ed-refresh-spans (ed-init (make-buffer code "/tmp/n.blsp" "/tmp/n.blsp"))
                80 24)
            ;; the column is cached for line 0; moving must not be served from it
            moved (panes/ed-refresh-spans (input/ed-update m :ctrl-n 80 24) 80 24)
            numbers (fn (model)
                      (map (seq/filter (view/ed-view model 80 24)
                             (fn (op) (and (vector? op) (= (first op) :text) (= (nth op 2) 1))))
                        (fn (op) (string/trim (nth op 3))))))
        (assert= (take (numbers m) 4) (list "1" "1" "2" "3"))
        (assert= (take (numbers moved) 4) (list "1" "2" "1" "2"))))))
