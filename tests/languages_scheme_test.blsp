;; Scheme and Racket (src/languages/scheme.blsp): a `deflisp` over src/languages/lisps.blsp — its
;; file patterns, its special forms, and lisp-mode's indent rule.
(defmodule languages-scheme-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model face-at]))

(describe "scheme-mode"
  (test "the file patterns route, and Scheme's heads paint as specials"
    (assert= (ed-buf-mode-name (cur (file-model "(define x 1)" "main.rkt"))) "scheme")
    (let (src "(define-syntax m)")
      (assert= (face-at (languages/scheme/scheme-fontify src) src "define-syntax")
        (editor/face/face :syntax/special))))
  (test "Scheme indents like lisp-mode: a define's body +2, a call's arguments aligned"
    (let (src "(define (f x)\n  (+ x\n     1))"
          svc (model/ed-mode-service (cur (file-model src "a.scm")) :indent))
      (assert= (svc src (inc (index-of src "\n"))) 2)
      (assert= (svc src (inc (string/last-index-of src "\n"))) 5))))
