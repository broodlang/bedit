;; Scheme and Racket (src/languages/scheme.blsp): a `deflisp` over src/languages/lisps.blsp. Its
;; sample, tests/corpus/scheme/queue.scm, carries the colours and the indentation (a define's body
;; +2, a call's arguments aligned) and is checked by tests/language_corpus_test.blsp.
(defmodule languages-scheme-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model]))

(describe "scheme-mode"
  (test "a Racket file routes to it"
    (assert= (ed-buf-mode-name (cur (file-model "(define x 1)" "main.rkt"))) "scheme")))
