;; Editor tests — dired (the directory browser, C-x C-d). Same shared `main-test`
;; module as the other split test files (helpers resolve at run time across files).
(defmodule main-test
  (:use model)
  (:use input)
  (:use-internals commands)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(defn type-str (m s) (press m (string->list s)))

;; Clear any fixtures a crashed earlier run left behind, before any test builds one.
(purge-stale-temp "myedit-dired-")

;; A fixture directory holding a subdir `sub/` and a file `a.txt` ("hello"). Returns the
;; absolute dir path. list-dir sorts entries, so dired's order is: "." ".." then dirs
;; (sub) then files (a.txt) — i.e. 1-based lines 2,3,4,5.
(defn dired-fixture ()
  (let (d (temp-dir "myedit-dired-")
        _ (make-dir d)
        _ (make-dir (path-join d "sub"))
        _ (spit (path-join d "a.txt") "hello"))
    d))

;; A model showing dired on `dir` with point on (1-based) `line`.
(defn dired-on (dir line) (ed-show-dired (m-of "") dir line))

(describe "editor dired: listing"
  (test "lists . .. dirs-first then files, in a read-only buffer named by the dir"
    (let (d (dired-fixture)
          m (dired-on d 2)
          txt (buffer-text (cur m)))
      (is (read-only? (cur m)))
      (is (string-contains? (buffer-name (cur m)) d))
      (is (string-contains? txt "sub"))
      (is (string-contains? txt "a.txt"))
      ;; dir row marked d, file row marked - ; the model records the ordered names
      (assert= (get m :dired-names) ["." ".." "sub" "a.txt"])
      (delete-dir d)))
  (test "the entry under point is recovered by line index, not column parsing"
    (let (d (dired-fixture))
      (assert= (commands/ed--dired-name-at (dired-on d 4)) "sub")    ; line 4 = the subdir
      (assert= (commands/ed--dired-name-at (dired-on d 5)) "a.txt")  ; line 5 = the file
      (is (nil? (commands/ed--dired-name-at (dired-on d 1))))        ; line 1 = the header
      (delete-dir d))))

(describe "editor dired: navigation"
  (test "RET on a subdir enters it; ^ returns to the parent"
    (let (d (dired-fixture)
          into (cmd-dired-open (dired-on d 4) nil))        ; point on sub → enter
      (assert= (get into :dired-dir) (path-join d "sub"))
      (let (back (cmd-dired-up into nil))
        (assert= (get back :dired-dir) d))
      (delete-dir d)))
  (test "RET on a file opens it as a normal editable buffer"
    (let (d (dired-fixture)
          opened (cmd-dired-open (dired-on d 5) nil))       ; point on a.txt
      (refute (read-only? (cur opened)))
      (is (string-contains? (buffer-file (cur opened)) "a.txt"))
      (assert= (buffer-text (cur opened)) "hello")
      (delete-dir d))))

(describe "editor dired: file operations"
  (test "+ creates a directory; the refreshed listing shows it"
    (let (d (dired-fixture)
          done (press (type-str (cmd-dired-create-dir (dired-on d 2) nil) "newdir") [:enter]))
      (is (dir? (path-join d "newdir")))
      (is (string-contains? (buffer-text (cur done)) "newdir"))
      (delete-dir d)))
  (test "C copies the file under point, leaving the original"
    ;; the prompt is seeded with the current name (point at end); C-a C-k clears it first
    (let (d (dired-fixture)
          done (press (type-str (press (cmd-dired-copy (dired-on d 5) nil) [:ctrl-a :ctrl-k])
                        "b.txt")
                 [:enter]))
      (assert= (slurp (path-join d "a.txt")) "hello")       ; original kept
      (assert= (slurp (path-join d "b.txt")) "hello")       ; copy made
      (is (string-contains? (buffer-text (cur done)) "b.txt"))
      (delete-dir d)))
  (test "R renames the file under point"
    (let (d (dired-fixture))
      (press (type-str (press (cmd-dired-rename (dired-on d 5) nil) [:ctrl-a :ctrl-k])
               "renamed.txt")
        [:enter])
      (refute (file-exists? (path-join d "a.txt")))
      (assert= (slurp (path-join d "renamed.txt")) "hello")
      (delete-dir d)))
  (test "D deletes the file under point after a y confirm"
    (let (d (dired-fixture)
          done (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24))
      (refute (file-exists? (path-join d "a.txt")))
      (refute (string-contains? (buffer-text (cur done)) "a.txt"))
      (delete-dir d)))
  (test "D with any non-y key cancels — the file stays"
    (let (d (dired-fixture))
      (ed-update (cmd-dired-delete (dired-on d 5) nil) "n" 80 24)
      (is (file-exists? (path-join d "a.txt")))
      (delete-dir d))))

(describe "editor dired: ls -l columns (class / perms / date)"
  (test "ed--dired-class: dir d, symlink l (wins over dir), exec x, else -"
    (assert= (commands/ed--dired-class {:dir? true}) "d")
    (assert= (commands/ed--dired-class {:dir? true :symlink? true}) "l")
    (assert= (commands/ed--dired-class {:exec? true}) "x")
    (assert= (commands/ed--dired-class {}) "-")
    (assert= (commands/ed--dired-class nil) "-"))
  (test "completion/rwx: a 3-bit group → the rwx triad (shared with marginalia)"
    (assert= (completion/rwx 7) "rwx")
    (assert= (completion/rwx 5) "r-x")
    (assert= (completion/rwx 6) "rw-")
    (assert= (completion/rwx 0) "---"))
  (test "completion/perms-string: the 10-char ls -l permission string from :mode + type"
    (assert= (completion/perms-string {:dir? true :mode 493}) "drwxr-xr-x")    ; 0o755 dir
    (assert= (completion/perms-string {:mode 420}) "-rw-r--r--")               ; 0o644 file
    (assert= (completion/perms-string {:symlink? true :mode 509}) "lrwxrwxr-x"); 0o775 link
    (assert= (completion/perms-string nil) "----------"))
  (test "ed--dired-date: epoch-ms → Mon DD HH:MM (UTC), 12-wide blank when nil"
    (assert= (commands/ed--dired-date 0) "Jan  1 00:00")
    (assert= (string-length (commands/ed--dired-date nil)) 12)))

(describe "editor dired: fontify (diredfl colours)"
  (test "dired-fontify paints the header, the perms column, and a directory name"
    (let (d (dired-fixture)
          spans (commands/dired-fontify (buffer-text (cur (dired-on d 2))))
          faces (map (fn (s) (nth s 2)) spans))
      (is (not (empty? spans)))
      (is (member? theme/face-dired-header faces))  ; the directory-path header line
      (is (member? theme/face-dired-perms faces))   ; the rwx permission column
      (is (member? theme/face-dired-dir faces))     ; sub is a directory → blue
      (delete-dir d)))
  (test "the name span survives a filename containing spaces"
    (let (d (dired-fixture)
          _ (spit (path-join d "a b c.txt") "x")      ; a space-bearing name
          spans (commands/dired-fontify (buffer-text (cur (dired-on d 2))))
          ;; a file-name span (file face) is emitted past the metadata columns
          file-spans (filter (fn (s) (= (nth s 2) theme/face-dired-file)) spans))
      (is (not (empty? file-spans)))
      (delete-dir d)))
  (test "a marked row's * flag is painted in the mark face"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil)  ; mark sub
          spans (commands/dired-fontify (buffer-text (cur marked)))
          faces (map (fn (s) (nth s 2)) spans))
      (is (member? theme/face-dired-mark faces))
      (delete-dir d))))

(describe "editor dired: marking"
  (test "m marks the entry under point and advances; * shows in the listing"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil))   ; point on sub
      (is (includes? (get marked :dired-marks) "sub"))
      (is (string-contains? (buffer-text (cur marked)) "*"))
      (delete-dir d)))
  (test "u/U: a second mark, then unmark-all clears them"
    (let (d (dired-fixture)
          m1 (cmd-dired-mark (dired-on d 4) nil)        ; mark sub (point advances to a.txt)
          m2 (cmd-dired-mark m1 nil)                    ; mark a.txt
          cleared (cmd-dired-unmark-all m2 nil))
      (assert= (count (get m2 :dired-marks)) 2)
      (is (empty? (get cleared :dired-marks)))
      (delete-dir d)))
  (test ". and .. cannot be marked — m just advances"
    (let (d (dired-fixture)
          done (cmd-dired-mark (dired-on d 2) nil))     ; point on "."
      (is (empty? (get done :dired-marks)))
      (delete-dir d)))
  (test "x deletes every marked entry after a y confirm"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil)    ; mark sub (a directory)
          done (ed-update (cmd-dired-delete marked nil) "y" 80 24))
      (refute (dir? (path-join d "sub")))
      (is (empty? (get done :dired-marks)))
      (delete-dir d))))

;; point's column on its line, and the line text from point to EOL — to assert the
;; cursor sits on the filename.
(defn col-at (b)
  (- (buffer-point b) (rope-line->char (buffer-rope b) (buffer-current-line b))))
(defn name-under (b)
  (let (line (buffer-current-line b)
        lt (ed-strip-newline (buffer-line-at b line)))
    (substring lt (col-at b) (string-length lt))))

(describe "editor dired: point sits on the filename"
  (test "show lands point on the name, not the leading mark column"
    (let (d (dired-fixture)
          b (cur (dired-on d 4)))                        ; line 4 = sub
      (is (> (col-at b) 0))                              ; past column 0
      (assert= (name-under b) "sub")                    ; the cursor is on the name
      (delete-dir d)))
  (test "n / p move by line and re-snap point onto the filename"
    (let (d (dired-fixture)
          down (cmd-dired-next-line (dired-on d 4) nil)) ; sub → a.txt
      (assert= (commands/ed--dired-name-at down) "a.txt")
      (assert= (name-under (cur down)) "a.txt")
      (let (up (cmd-dired-previous-line down nil))       ; back to sub
        (assert= (name-under (cur up)) "sub"))
      (delete-dir d))))

(describe "editor dired: keybindings"
  (test "C-x C-j opens dired (Emacs dired-jump), same as C-x C-d"
    (let (j (press (m-of "x") [:ctrl-x :ctrl-j])
          cd (press (m-of "x") [:ctrl-x :ctrl-d]))
      (is (not (nil? (get j :minibuffer))))                 ; the dired prompt opened
      (assert= (mb-text (get j :minibuffer)) (mb-text (get cd :minibuffer))))))

(describe "find-file: the project follows the visited file"
  (test "visiting a file in a .git repo sets :project-root to that repo"
    (let (d (temp-dir "myedit-gitproj-")
          _ (make-dir d)
          _ (make-dir (path-join d ".git"))      ; a git repo with no project.blsp
          f (path-join d "foo.txt")
          _ (spit f "hi")
          m (commands/ed-find-file (m-of "") f))
      (assert= (get m :project-root) d)
      (delete-dir d)))
  (test "visiting a file outside any project leaves :project-root unset"
    (let (d (temp-dir "myedit-noproj-")
          _ (make-dir d)
          f (path-join d "bare.txt")
          _ (spit f "hi")
          m (commands/ed-find-file (m-of "") f))
      (is (nil? (get m :project-root)))
      (delete-dir d))))
