;; Editor tests — dired (the directory browser, C-x C-d). Same shared `main-test`
;; module as the other split test files (helpers resolve at run time across files).
(defmodule dired-test
  (:use view)
  (:use minibuffer)
  (:use model)
  (:use input)
  (:use pool)
  (:use-internals lifecycle)
  (:use-internals window-commands)
  (:use-internals commands)
  (:use-internals dired) ; the listing, marks and flags — split out of commands (X1)
  (:use hexl) ; hexl-row / hexl-text / hexl-fontify — the hex view, split out of commands
  (:use-internals main) ; launch-buffer / open-pending — a launch file read once
  (:use editor/buffer)
  (:use editor/buffer-file)
  (:use fileops :only [remove-path]) ; a path removed for good
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn type-str (m s) (press m (string/->list s)))
;; `nth`/`second` over a line list are `nil | string`, and every use below is on a listing
;; the fixture guarantees is long enough — so the nil is ruled out here, once, and a listing
;; that is unexpectedly short says so instead of reaching `string/starts-with?` as a nil.
(sig line! ((list string) int -> string))
(defn line! (lines i)
  (or (nth lines i)
    (error (str "no line " i " in a listing of " (count lines)))))

;; Clear any fixtures a crashed earlier run left behind, before any test builds one.
(purge-stale-temp "bedit-dired-")

;; A fixture directory holding a subdir `sub/` and a file `a.txt` ("hello"). Returns the
;; absolute dir path. The listings below group directories first (`dired-on`), so the order
;; is "." ".." then dirs (sub) then files (a.txt) — 1-based lines 2,3,4,5 — whatever the
;; default order (by name, mixed) would put first.
(defn dired-fixture ()
  (let (d (temp-dir "bedit-dired-")
        _ (file/mkdir d)
        _ (file/mkdir (path/join d "sub"))
        _ (file/spit (path/join d "a.txt") "hello"))
    d))

;; A model showing dired on `dir` with point on (1-based) `line`, directories grouped first
;; (`ls --group-directories-first`) so the fixture's lines are fixed
(defn dired-on (dir line)
  (ed-show-dired (assoc (m-of "") :dired-listing-switches "-al --group-directories-first") dir line))

(describe "editor dired: listing"
  (test "lists . .. then folders and files, in a read-only buffer named by the dir"
    (let (d (dired-fixture)
          m (dired-on d 2)
          txt (buffer-text (cur m)))
      (is (read-only? (cur m)))
      (is (includes? (buffer-name (cur m)) d))
      (is (includes? txt "sub"))
      (is (includes? txt "a.txt"))
      ;; grouped (as `dired-on` asks), the folder first; the model records the ordered names
      (assert= (ed-dired-state m :dired-names) ["." ".." "sub" "a.txt"])
      ;; by default, by name — folders and files mixed, as `ls -al` lists them
      (assert= (ed-dired-state (ed-show-dired (m-of "") d 2) :dired-names) ["." ".." "a.txt" "sub"])
      (file/rmdir d)))
  (test "the entry under point is recovered by line index, not column parsing"
    (let (d (dired-fixture))
      (assert= (dired/ed-dired-name-at (dired-on d 4)) "sub") ; line 4 = the subdir
      (assert= (dired/ed-dired-name-at (dired-on d 5)) "a.txt") ; line 5 = the file
      (is (nil? (dired/ed-dired-name-at (dired-on d 1)))) ; line 1 = the header
      (file/rmdir d))))

(describe "editor dired: navigation"
  (test "RET on a subdir enters it; ^ returns to the parent"
    (let (d (dired-fixture)
          into (cmd-dired-open (dired-on d 4) nil))
      ; point on sub → enter
      (assert= (ed-dired-state into :dired-dir) (path/join d "sub"))
      (let (back (cmd-dired-up into nil))
        (assert= (ed-dired-state back :dired-dir) d))
      (file/rmdir d)))
  (test "RET on a file opens it as a normal editable buffer"
    (let (d (dired-fixture)
          opened (cmd-dired-open (dired-on d 5) nil))
      ; point on a.txt
      (refute (read-only? (cur opened)))
      (is (includes? (buffer-file (cur opened)) "a.txt"))
      (assert= (buffer-text (cur opened)) "hello")
      (file/rmdir d))))

(describe "editor dired: file operations"
  (test "+ creates a directory; the refreshed listing shows it"
    (let (d (dired-fixture)
          done (press (type-str (cmd-dired-create-dir (dired-on d 2) nil) "newdir") [:enter]))
      (is (file/dir? (path/join d "newdir")))
      (is (includes? (buffer-text (cur done)) "newdir"))
      (file/rmdir d)))
  (test "C copies the file under point, leaving the original"
    ;; the prompt is seeded with the current name (point at end); C-a C-k clears it first
    (let (d (dired-fixture)
          done (press (type-str (press (cmd-dired-copy (dired-on d 5) nil) [:ctrl-a :ctrl-k])
                        "b.txt")
                 [:enter]))
      (assert= (file/slurp (path/join d "a.txt")) "hello") ; original kept
      (assert= (file/slurp (path/join d "b.txt")) "hello") ; copy made
      (is (includes? (buffer-text (cur done)) "b.txt"))
      (file/rmdir d)))
  (test "R renames the file under point"
    (let (d (dired-fixture))
      (press (type-str (press (cmd-dired-rename (dired-on d 5) nil) [:ctrl-a :ctrl-k])
               "renamed.txt")
        [:enter])
      (refute (file/exists? (path/join d "a.txt")))
      (assert= (file/slurp (path/join d "renamed.txt")) "hello")
      (file/rmdir d)))
  (test "D deletes the file under point after a y confirm"
    (let (d (dired-fixture)
          done (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24))
      (refute (file/exists? (path/join d "a.txt")))
      (refute (includes? (buffer-text (cur done)) "a.txt"))
      (file/rmdir d)))
  (test "D with any non-y key cancels — the file stays"
    (let (d (dired-fixture))
      (ed-update (cmd-dired-delete (dired-on d 5) nil) "n" 80 24)
      (is (file/exists? (path/join d "a.txt")))
      (file/rmdir d))))

;; D and x deleted for good, a directory recursively, behind one y/n that named neither. Now
;; they move to the freedesktop trash (Emacs's delete-by-moving-to-trash) unless init.blsp's
;; `:delete-by-moving-to-trash` is false, when the question says how many files go with it.
;; Every test here binds the trash to a directory of its own.

(defn- with-trash (f)
  ;; `(f trash-dir)` with the trash bound to a fresh scratch directory, removed after
  (let (trash (temp-dir "bedit-dired-trash-"))
    (binding (file/*trash-home* trash) (let (result (f trash)) (do (file/rmdir trash) result)))))

(describe "editor dired: deleting moves to the trash"
  (test "D asks to move the entry to the trash, and y puts it there with its info file"
    (with-trash (fn (trash)
                  (let (d (dired-fixture)
                        asked (cmd-dired-delete (dired-on d 5) nil)
                        done (ed-update asked "y" 80 24)
                        info (file/slurp (path/join trash "info" "a.txt.trashinfo")))
                    (assert= (:echo asked) "Move a.txt to the trash? (y/n)")
                    (refute (file/exists? (path/join d "a.txt")))
                    (assert= (file/slurp (path/join trash "files" "a.txt")) "hello")
                    (is (includes? info "[Trash Info]"))
                    (is (includes? info (str "Path=" (path/join d "a.txt"))))
                    (is (includes? info "DeletionDate="))
                    (is (includes? (:echo done) "Trashed a.txt"))
                    (file/rmdir d)))))
  (test "a second file of the same name is trashed beside the first, not over it"
    (with-trash (fn (trash)
                  (let (d (dired-fixture))
                    (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24)
                    (file/spit (path/join d "a.txt") "again")
                    (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24)
                    (assert= (file/slurp (path/join trash "files" "a.txt")) "hello")
                    (assert= (file/slurp (path/join trash "files" "a.txt.2")) "again")
                    (is (file/exists? (path/join trash "info" "a.txt.2.trashinfo")))
                    (file/rmdir d)))))
  (test "x moves a flagged directory to the trash whole"
    (with-trash (fn (trash)
                  (let (d (dired-fixture)
                        _ (file/spit (path/join d "sub" "inner.txt") "in")
                        flagged (cmd-dired-flag (dired-on d 4) nil))
                    (ed-update (cmd-dired-do-flagged-delete flagged nil) "y" 80 24)
                    (refute (file/exists? (path/join d "sub")))
                    (assert= (file/slurp (path/join trash "files" "sub" "inner.txt")) "in")
                    (file/rmdir d)))))
  (test "with :delete-by-moving-to-trash false, the question names the files a directory takes"
    (with-trash
      (fn (trash)
        (let (d (dired-fixture)
              _ (file/spit (path/join d "sub" "one.txt") "1")
              _ (file/spit (path/join d "sub" "two.txt") "2")
              m (assoc (dired-on d 4) :delete-by-moving-to-trash false)
              asked (cmd-dired-delete m nil))
          (assert= (:echo asked) "Delete sub/ and its 2 files for good? (y/n)")
          (ed-update asked "y" 80 24)
          (refute (file/exists? (path/join d "sub")))
          ;; for good: nothing reached the trash
          (refute (file/exists? (path/join trash "files" "sub")))
          (file/rmdir d)))))
  (test "the question: one file, several, and no trash to move to"
    (let (file {:label "a.txt" :dir? false :files 1}
          dir {:label "sub/" :dir? true :files 3})
      (assert= (dired-delete-question [file dir] "marked" :trash)
        "Move 2 marked to the trash? (y/n)")
      (assert= (dired-delete-question [file] "marked" :delete) "Delete a.txt for good? (y/n)")
      (assert= (dired-delete-question [file dir] "flagged" :delete)
        "Delete 2 flagged (4 files in all) for good? (y/n)")
      (assert= (dired-delete-question [file] "marked" :no-trash)
        "No trash here — delete a.txt for good? (y/n)")))
  (test "a symlink to a directory is removed as the link, never what it points at"
    (let (d (dired-fixture)
          link (path/join d "link"))
      (os/cmd "ln" ["-s" (path/join d "sub") link])
      (file/spit (path/join d "sub" "kept.txt") "kept")
      (fileops/remove-path link)
      (refute (file/exists? link))
      (is (file/exists? (path/join d "sub" "kept.txt")))
      (file/rmdir d))))

;; R and C replaced an existing file without a word, and a renamed file's open buffer kept the
;; old path — its next save recreated the file the rename had moved (Emacs's dired asks; the
;; findings' trust round, class K).
(defn- rename-to (m typed)
  "`R` on the entry under point, the prompt cleared and `typed` entered."
  (press (type-str (press (cmd-dired-rename m nil) [:ctrl-a :ctrl-k]) typed) [:enter]))

(describe "editor dired: R and C never replace a file unasked"
  (test "R onto an existing file asks, and n leaves both files as they were"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "b.txt") "other")
          asked (rename-to (dired-on d 5) "b.txt"))
      (is (includes? (:echo asked) "exists; overwrite it?"))
      (let (declined (ed-update asked "n" 80 24))
        (assert= (file/slurp (path/join d "a.txt")) "hello")
        (assert= (file/slurp (path/join d "b.txt")) "other")
        (is (includes? (:echo declined) "rename canceled")))
      (file/rmdir d)))

  (test "and y replaces it"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "b.txt") "other"))
      (ed-update (rename-to (dired-on d 5) "b.txt") "y" 80 24)
      (refute (file/exists? (path/join d "a.txt")))
      (assert= (file/slurp (path/join d "b.txt")) "hello")
      (file/rmdir d)))

  (test "C onto an existing file asks too"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "b.txt") "other")
          asked (press (type-str (press (cmd-dired-copy (dired-on d 5) nil) [:ctrl-a :ctrl-k])
                         "b.txt")
                  [:enter]))
      (is (includes? (:echo asked) "exists; overwrite it?"))
      (assert= (file/slurp (path/join d "b.txt")) "other")
      (file/rmdir d)))

  (test "R into a directory moves the file into it, keeping its name"
    (let (d (dired-fixture))
      (rename-to (dired-on d 5) "sub")
      (assert= (file/slurp (path/join d "sub" "a.txt")) "hello")
      (refute (file/exists? (path/join d "a.txt")))
      (file/rmdir d)))

  (test "a buffer visiting the renamed file follows it, so its save lands at the new name"
    (let (d (dired-fixture)
          old (path/join d "a.txt")
          new (path/join d "moved.txt")
          visiting (ed-find-file (dired-on d 5) old)
          back (ed-show-dired visiting d 5)
          renamed (rename-to back "moved.txt")
          index (ed-buffer-index-by-file renamed new))
      (is (not (nil? index)))
      (assert= (ed-buffer-index-by-file renamed old) nil)
      (file/rmdir d))))

;; R and C acted on the line at point and ignored the marks. As Emacs's: on the marked entries
;; when any are, into the directory typed, one question per target that exists (`!` for all).
(defn- marked-both (d &optional (base nil))
  ;; a listing of the fixture with `sub` and `a.txt` marked, plus a destination `dest/`
  (let (_ (file/mkdir (path/join d "dest"))
        listed (if base (ed-show-dired base d 2) (dired-on d 2))
        names (ed-dired-state listed :dired-names))
    (cmd-dired-mark (cmd-dired-mark (ed-show-dired listed d (+ 2 (index-of names "sub"))) nil) nil)))

(defn- answer-prompt (m typed)
  ;; the open prompt cleared, `typed` entered
  (press (type-str (press m [:ctrl-a :ctrl-k]) typed) [:enter]))

(describe "editor dired: R and C act on the marked entries"
  (test "C copies every marked entry into the directory typed, a directory whole"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "sub" "inner.txt") "in")
          marked (marked-both d)
          asked (cmd-dired-copy marked nil)
          done (answer-prompt asked "dest"))
      (assert= (into #{} (ed-dired-state marked :dired-marks)) #{"sub" "a.txt"})
      (is (includes? (mb-prompt (:minibuffer asked)) "Copy 2 marked into"))
      (assert= (file/slurp (path/join d "dest" "a.txt")) "hello")
      (assert= (file/slurp (path/join d "dest" "sub" "inner.txt")) "in")
      (is (file/exists? (path/join d "a.txt")))
      (is (empty? (ed-dired-state done :dired-marks)))
      (is (includes? (:echo done) "Copied 2 entries"))
      (file/rmdir d)))
  (test "R moves every marked entry into the directory, and a buffer on one follows it"
    (let (d (dired-fixture)
          old (path/join d "a.txt")
          visiting (ed-find-file (dired-on d 5) old)
          marked (marked-both d visiting)
          done (answer-prompt (cmd-dired-rename marked nil) "dest"))
      (refute (file/exists? old))
      (refute (file/exists? (path/join d "sub")))
      (assert= (file/slurp (path/join d "dest" "a.txt")) "hello")
      (is (not (nil? (ed-buffer-index-by-file done (path/join d "dest" "a.txt")))))
      (file/rmdir d)))
  (test "several marked into a name that is not a directory is refused"
    (let (d (dired-fixture)
          done (answer-prompt (cmd-dired-copy (marked-both d) nil) "nowhere"))
      (is (includes? (:echo done) "is not a directory"))
      (refute (file/exists? (path/join d "nowhere")))
      (file/rmdir d)))
  (test "each target that exists is asked about: n keeps it, y replaces it"
    (let (d (dired-fixture)
          marked (marked-both d)
          _ (file/spit (path/join d "dest" "a.txt") "old")
          _ (file/mkdir (path/join d "dest" "sub"))
          _ (file/spit (path/join d "dest" "sub" "x") "x")
          asked (answer-prompt (cmd-dired-copy marked nil) "dest"))
      ;; listing order, folders first: sub is asked about first
      (is (includes? (:echo asked) "dest/sub exists; overwrite it?"))
      (let (second-question (ed-update asked "n" 80 24)
            done (ed-update second-question "y" 80 24))
        (is (includes? (:echo second-question) "dest/a.txt exists; overwrite it?"))
        (assert= (file/slurp (path/join d "dest" "a.txt")) "hello")
        ;; the declined directory is as it was, and stays marked
        (assert= (file/slurp (path/join d "dest" "sub" "x")) "x")
        (assert= (ed-dired-state done :dired-marks) (list "sub")))
      (file/rmdir d)))
  (test "! answers yes to this target and every one after"
    (let (d (dired-fixture)
          _ (file/mkdir (path/join d "dest"))
          _ (file/spit (path/join d "b.txt") "bee")
          _ (file/spit (path/join d "dest" "a.txt") "old")
          _ (file/spit (path/join d "dest" "b.txt") "old")
          listed (dired-on d 2)
          names (ed-dired-state listed :dired-names)
          at (fn (m name) (ed-show-dired m d (+ 2 (index-of names name))))
          marked (cmd-dired-mark (at (cmd-dired-mark (at listed "a.txt") nil) "b.txt") nil)
          done (ed-update (answer-prompt (cmd-dired-copy marked nil) "dest") "!" 80 24))
      (assert= (file/slurp (path/join d "dest" "a.txt")) "hello")
      (assert= (file/slurp (path/join d "dest" "b.txt")) "bee")
      (is (includes? (:echo done) "Copied 2 entries"))
      (file/rmdir d)))
  (test "a directory copied into itself is refused"
    (let (d (dired-fixture)
          done (answer-prompt (cmd-dired-copy (dired-on d 4) nil) "sub/inner"))
      (is (includes? (:echo done) "is inside sub"))
      (refute (file/exists? (path/join d "sub" "inner")))
      (file/rmdir d))))

;; Deleting a file an open buffer visited said nothing, and the buffer looked saved — so its
;; next C-x C-s quietly put the file back, and quitting lost the text without a question.
(describe "editor dired: a deleted file's open buffer"
  (test "is kept, flagged modified, and the echo area says how to write it back"
    (with-trash
      (fn (_trash)
        (let (d (dired-fixture)
              file (path/join d "a.txt")
              visiting (ed-find-file (dired-on d 5) file)
              done (ed-update (cmd-dired-delete (ed-show-dired visiting d 5) nil) "y" 80 24)
              index (ed-buffer-index-by-file done file))
          (refute (file/exists? file))
          (is (not (nil? index)))
          (is (buffer-modified? (ed-buf-at done (or index 0))))
          (assert= (:echo done)
            "a.txt was moved to the trash; its buffer still holds the text — C-x C-s writes it back")
          ;; and C-x C-s there writes it back
          (let (saved (press (ed-switch-to-named done (buffer-name (ed-buf-at done (or index 0))))
                        [:ctrl-x :ctrl-s]))
            (assert= (file/slurp file) "hello")
            (refute (buffer-modified? (cur saved))))
          (file/rmdir d)))))
  (test "a buffer on a file under a deleted directory is flagged too"
    (let (d (dired-fixture)
          inner (path/join d "sub" "inner.txt")
          _ (file/spit inner "in")
          visiting (ed-find-file (assoc (dired-on d 4) :delete-by-moving-to-trash false) inner)
          done (ed-update (cmd-dired-delete (ed-show-dired visiting d 4) nil) "y" 80 24)
          index (ed-buffer-index-by-file done inner))
      (refute (file/exists? (path/join d "sub")))
      (is (buffer-modified? (ed-buf-at done (or index 0))))
      (assert= (:echo done)
        "inner.txt was deleted; its buffer still holds the text — C-x C-s writes it back")
      (file/rmdir d)))
  (test "a delete with no buffer open on it just reports"
    (with-trash (fn (_trash)
                  (let (d (dired-fixture)
                        done (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24))
                    (assert= (:echo done) "Trashed a.txt")
                    (file/rmdir d))))))

;; Copy, rename and delete ran ON the loop: a large tree froze the editor until it was done.
;; In a live editor they run in a task, and the listing is read again when the report lands.
(describe "editor dired: operations run off the loop"
  (test "C returns at once with the copy in flight; the listing shows it when it lands"
    (let (d (dired-fixture)
          launched (binding (editor/ui/*loop* (self))
                     (answer-prompt (cmd-dired-copy (dired-on d 5) nil) "b.txt")))
      (is (not (nil? (:ready-wait-dired launched))))
      (refute (includes? (buffer-text (cur launched)) "b.txt"))
      ;; a second operation waits for the first rather than racing it over the same files
      (is (includes? (:echo (cmd-dired-delete launched nil)) "still running"))
      (let (answer (receive ([:task-done _ value] value) (after 10000 :lost))
            landed (offloop/ed-apply-ready launched answer :ready-wait-dired))
        (assert= (file/slurp (path/join d "b.txt")) "hello")
        (is (includes? (buffer-text (cur landed)) "b.txt"))
        (is (includes? (:echo landed) "Copied a.txt"))
        (is (nil? (:ready-wait-dired landed))))
      (file/rmdir d)))
  (test "a delete for good counts the files off the loop, then asks"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "sub" "one.txt") "1")
          m (assoc (dired-on d 4) :delete-by-moving-to-trash false)
          launched (binding (editor/ui/*loop* (self)) (cmd-dired-delete m nil)))
      (is (nil? (:read-char launched)))
      (let (answer (receive ([:task-done _ value] value) (after 10000 :lost))
            asked (offloop/ed-apply-ready launched answer :ready-wait-dired))
        (assert= (:echo asked) "Delete sub/ and its 1 file for good? (y/n)")
        (is (file/exists? (path/join d "sub" "one.txt"))))
      (file/rmdir d))))
(describe "editor dired: ls -l columns (class / perms / date)"
  ;; The class char is the first of `fileperm/perms-string` — the one home for the `ls -l`
  ;; column (the listing and the marginalia share it); a separate `ed-dired-class` was dead.
  (test "the class char: dir d, symlink l (wins over dir), else - (an executable shows in its triads)"
    (assert= (string/char-at (fileperm/perms-string {:dir? true :mode 493}) 0) "d")
    (assert= (string/char-at (fileperm/perms-string {:dir? true :symlink? true}) 0) "l")
    (assert= (fileperm/perms-string {:exec? true :mode 493}) "-rwxr-xr-x")
    (assert= (string/char-at (fileperm/perms-string {}) 0) "-")
    (assert= (fileperm/perms-string nil) "----------"))
  (test "fileperm/rwx: a 3-bit group → the rwx triad (shared with marginalia)"
    (assert= (fileperm/rwx 7) "rwx")
    (assert= (fileperm/rwx 5) "r-x")
    (assert= (fileperm/rwx 6) "rw-")
    (assert= (fileperm/rwx 0) "---"))
  (test "fileperm/perms-string: the 10-char ls -l permission string from :mode + type"
    (assert= (fileperm/perms-string {:dir? true :mode 493}) "drwxr-xr-x") ; 0o755 dir
    (assert= (fileperm/perms-string {:mode 420}) "-rw-r--r--") ; 0o644 file
    (assert= (fileperm/perms-string {:symlink? true :mode 509}) "lrwxrwxr-x") ; 0o775 link
    (assert= (fileperm/perms-string nil) "----------"))
  (test "the setuid, setgid and sticky bits read as ls shows them, and back"
    (assert= (fileperm/perms-string {:mode 3565}) "-rwsr-sr-x") ; 0o6755
    (assert= (fileperm/perms-string {:dir? true :mode 1023}) "drwxrwxrwt") ; 0o1777
    (assert= (fileperm/perms-string {:mode 2468}) "-rwSr--r--") ; 0o4644
    (assert= (fileperm/perms-string {:mode 932}) "-rw-r--r-T") ; 0o1644
    (each [0 420 493 1023 2541 3565 2468 932 4095]
      (fn (mode) (assert= (fileperm/perms->mode (fileperm/mode-string mode)) mode)))
    (is (failure? (fileperm/perms->mode "rwxrwxrw")))
    (is (failure? (fileperm/perms->mode "rwxrwxrws")))
    (is (failure? (fileperm/perms->mode "rwtrwxrwx"))))
  (test "a symlink's row ends `name -> target`, a dangling one's too"
    (let (d (dired-fixture)
          _ (file/symlink "a.txt" (path/join d "link"))
          _ (file/symlink "../nowhere" (path/join d "gone"))
          m (dired-on d 2)
          txt (buffer-text (cur m)))
      (is (regex/find "\n l[rwx-]{9} [^\n]* link -> a\\.txt\n" txt))
      (is (includes? txt " gone -> ../nowhere\n"))
      ;; the entry is still the link's name: RET-style lookups index by line, not text
      (is (includes? (ed-dired-state m :dired-names) "link"))
      (assert= (get (ed-dired-state m :dired-links) "gone") "../nowhere")
      (let (rows (dired-entry-rows (cur m) {:links? true}))
        (assert= (vec (map (seq/filter rows (fn (row) (= (:name row) "link")))
                        (fn (row) [(:kind row) (:text row)])))
          [[:name "link"] [:target "a.txt"]]))))
  (test "ed--dired-date: epoch-ms → Mon DD HH:MM (UTC), 12-wide blank when nil"
    (assert= (dired/ed-dired-date 0) "Jan  1 00:00")
    (assert= (string/length (dired/ed-dired-date nil)) 12)))

(describe "editor dired: fontify (diredfl colours)"
  (test "dired-fontify paints the header, the perms column, and a directory name"
    (let (d (dired-fixture)
          spans (dired/dired-fontify (buffer-text (cur (dired-on d 2))))
          faces (map spans (fn (s) (nth s 2))))
      (is (not (empty? spans)))
      (is (includes? faces dired/face-dired-header)) ; the directory-path header line
      (is (includes? faces dired/face-dired-perms)) ; the rwx permission column
      (is (includes? faces dired/face-dired-dir)) ; sub is a directory → blue
      (file/rmdir d)))
  (test "the name span survives a filename containing spaces"
    (let (d (dired-fixture)
          _ (file/spit (path/join d "a b c.txt") "x") ; a space-bearing name
          spans (dired/dired-fontify (buffer-text (cur (dired-on d 2))))
          ;; a file-name span (file face) is emitted past the metadata columns
          file-spans (seq/filter spans (fn (s) (= (nth s 2) dired/face-dired-file))))
      (is (not (empty? file-spans)))
      (file/rmdir d)))
  (test "a marked row's * flag is painted in the mark face"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil) ; mark sub
          spans (dired/dired-fontify (buffer-text (cur marked)))
          faces (map spans (fn (s) (nth s 2))))
      (is (includes? faces dired/face-dired-mark))
      (file/rmdir d))))

(describe "editor dired: marking"
  (test "m marks the entry under point and advances; * shows in the listing"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil))
      ; point on sub
      (is (includes? (ed-dired-state marked :dired-marks) "sub"))
      (is (includes? (buffer-text (cur marked)) "*"))
      (file/rmdir d)))
  (test "u/U: a second mark, then unmark-all clears them"
    (let (d (dired-fixture)
          m1 (cmd-dired-mark (dired-on d 4) nil) ; mark sub (point advances to a.txt)
          m2 (cmd-dired-mark m1 nil) ; mark a.txt
          cleared (cmd-dired-unmark-all m2 nil))
      (assert= (count (ed-dired-state m2 :dired-marks)) 2)
      (is (empty? (ed-dired-state cleared :dired-marks)))
      (file/rmdir d)))
  (test ". and .. cannot be marked — m just advances"
    (let (d (dired-fixture)
          done (cmd-dired-mark (dired-on d 2) nil))
      ; point on "."
      (is (empty? (ed-dired-state done :dired-marks)))
      (file/rmdir d)))
  (test "D deletes every marked entry after a y confirm"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil) ; mark sub (a directory)
          done (ed-update (cmd-dired-delete marked nil) "y" 80 24))
      (refute (file/dir? (path/join d "sub")))
      (is (empty? (ed-dired-state done :dired-marks)))
      (file/rmdir d)))
  (test "D in one listing deletes in ITS directory, not the one listed last"
    ;; the state was on the model: back in the first listing, D took the entry at the same
    ;; line of the second directory
    (let (first-dir (dired-fixture)
          second-dir (temp-dir "bedit-dired-")
          _ (file/mkdir second-dir)
          _ (file/mkdir (path/join second-dir "other"))
          _ (file/spit (path/join second-dir "keep.txt") "keep")
          both (ed-show-dired (dired-on first-dir 5) second-dir 5)
          back (ed-apply (ed-switch-to-named both first-dir) (fn (b) (ed-goto-line b 5)))
          asked (cmd-dired-delete back nil)
          done (ed-update asked "y" 80 24))
      (assert= (ed-dired-state back :dired-dir) first-dir)
      (assert= (ed-dired-state done :dired-dir) first-dir)
      (is (includes? (:echo asked) "a.txt"))
      (refute (file/exists? (path/join first-dir "a.txt")))
      (is (file/exists? (path/join second-dir "keep.txt")))
      (file/rmdir first-dir)
      (file/rmdir second-dir)))
  (test "marks belong to their listing: marking in one leaves the other unmarked"
    (let (first-dir (dired-fixture)
          second-dir (dired-fixture)
          marked (cmd-dired-mark (dired-on first-dir 4) nil)
          other (ed-show-dired marked second-dir 4)
          back (ed-switch-to-named other first-dir))
      (is (empty? (ed-dired-state other :dired-marks)))
      (assert= (ed-dired-state back :dired-marks) (list "sub"))
      (file/rmdir first-dir)
      (file/rmdir second-dir)))
  (test "d flags an entry with a D in the mark cell; x deletes the flagged after a y confirm"
    (let (d (dired-fixture)
          flagged (cmd-dired-flag (dired-on d 4) nil) ; flag sub, point advances
          row (line! (string/split (buffer-text (cur flagged)) "\n") 3))
      (assert= (ed-dired-state flagged :dired-flags) (list "sub"))
      (is (string/starts-with? row "D"))
      ;; the flag survives a same-dir refresh, and u takes it off again
      (assert= (ed-dired-state (cmd-dired-refresh flagged nil) :dired-flags) (list "sub"))
      (is (empty? (ed-dired-state (cmd-dired-unmark (ed-show-dired flagged d 4) nil) :dired-flags)))
      (let (done (ed-update (cmd-dired-do-flagged-delete flagged nil) "y" 80 24))
        (refute (file/dir? (path/join d "sub")))
        (is (empty? (ed-dired-state done :dired-flags))))
      (file/rmdir d)))
  (test "x with nothing flagged says so and deletes nothing; a mark is not a flag"
    (let (d (dired-fixture)
          marked (cmd-dired-mark (dired-on d 4) nil)
          r (cmd-dired-do-flagged-delete marked nil))
      (is (includes? (:echo r) "no files flagged"))
      (is (file/dir? (path/join d "sub")))
      (file/rmdir d))))

;; point's column on its line, and the line text from point to EOL — to assert the
;; cursor sits on the filename.
(defn col-at (b)
  (- (buffer-point b) (text/line->char (buffer-rope b) (buffer-current-line b))))
(defn name-under (b)
  (let (line (buffer-current-line b)
        lt (wrap/line-text b line))
    (string/substring lt (col-at b) (string/length lt))))

(describe "editor dired: point sits on the filename"
  (test "show lands point on the name, not the leading mark column"
    (let (d (dired-fixture)
          b (cur (dired-on d 4)))
      ; line 4 = sub
      (is (> (col-at b) 0)) ; past column 0
      (assert= (name-under b) "sub") ; the cursor is on the name
      (file/rmdir d)))
  (test "n / p move by line and re-snap point onto the filename"
    (let (d (dired-fixture)
          down (cmd-dired-next-line (dired-on d 4) nil))
      ; sub → a.txt
      (assert= (dired/ed-dired-name-at down) "a.txt")
      (assert= (name-under (cur down)) "a.txt")
      (let (up (cmd-dired-previous-line down nil))
        ; back to sub
        (assert= (name-under (cur up)) "sub"))
      (file/rmdir d))))

(describe "editor dired: keybindings"
  (test "C-x d and C-x C-d prompt for a directory (Emacs dired); C-x C-j and C-x j jump without one"
    (let (d (press (m-of "x") [:ctrl-x "d"])
          cd (press (m-of "x") [:ctrl-x :ctrl-d])
          j (press (m-of "x") [:ctrl-x :ctrl-j])
          jj (press (m-of "x") [:ctrl-x "j"]))
      (is (not (nil? (:minibuffer d)))) ; the dired prompt opened
      (assert= (mb-text (:minibuffer d)) (mb-text (:minibuffer cd)))
      ;; dired-jump: no prompt — the listing of the default directory IS the selector
      (is (nil? (:minibuffer j)))
      (assert= (editor/layers/buffer-type-for (cur j)) :dired)
      (assert= (ed-dired-state jj :dired-dir) (ed-dired-state j :dired-dir)))))

(describe "find-file: the project follows the visited file"
  (test "visiting a file in a .git repo sets :project-root to that repo"
    (let (d (temp-dir "bedit-gitproj-")
          _ (file/mkdir d)
          _ (file/mkdir (path/join d ".git")) ; a git repo with no project.blsp
          f (path/join d "foo.txt")
          _ (file/spit f "hi")
          m (pool/ed-find-file (m-of "") f))
      (assert= (:project-root m) d)
      (file/rmdir d)))
  (test "visiting a file outside any project leaves :project-root unset"
    (let (d (temp-dir "bedit-noproj-")
          _ (file/mkdir d)
          f (path/join d "bare.txt")
          _ (file/spit f "hi")
          m (pool/ed-find-file (m-of "") f))
      (is (nil? (:project-root m)))
      (file/rmdir d))))

(describe "hexl — a binary file opens as a hex view, not an error"
  (test "hexl-row is an xxd row: offset, hex pairs, ascii — padded on a short row"
    (let (b (string/->bytes "ELFrest of row here!"))
      (assert= (hexl-row b 0 16)
        "00000000: 454c 4672 6573 7420 6f66 2072 6f77 2068  ELFrest of row h")
      (assert= (hexl-row b 16 4) "00000010: 6572 6521                                ere!")))
  (test "hexl-text caps what it shows and says so"
    (let (small (hexl-text (string/->bytes "abc"))
          lines (string/split small "\n"))
      (assert= (count lines) 2)
      (is (string/starts-with? (first lines) ";; binary file: 3 bytes (read-only)"))
      (is (string/starts-with? (line! lines 1) "00000000: 6162 63")))
    (let (hundred (string/->bytes (string/join (map (range 10) (fn (_) "0123456789")) ""))
          big (binding (*hexl-cap* 32) (hexl-text hundred))
          lines (string/split big "\n"))
      (assert= (count lines) 3)
      (is (includes? (first lines) "100 bytes — the first 32 shown"))))
  (test "find-file on a non-UTF-8 file opens a read-only :hexl buffer named for it"
    (let (dir (path/temp "bedit-hexl-")
          _ (file/mkdir dir)
          path (path/join dir "blob.bin")
          _ (file/spit-bytes path (bytes 127 69 76 70 0 255 254 1))
          m (ed-find-file (ed-init (make-buffer "" "*scratch*")) path)
          buf (ed-current-buf m))
      (assert= (editor/layers/buffer-type-for buf) :hexl)
      (assert= (:file buf) path)
      (is (includes? (buffer-text buf) "7f45 4c46 00ff fe01"))
      (is (includes? (:echo m) "as hex")))))

;; find-file read every file twice — once to ask whether it was UTF-8, once to build the
;; buffer — and read a file of any size without asking. Emacs asks above
;; `large-file-warning-threshold` (10 MB), since the file is read whole and the editor waits.
(defn- vf-file (name text)
  (let (dir (path/temp "bedit-visit-"))
    (file/mkdir dir)
    (let (path (path/join dir name)) (do (file/spit path text) path))))

(describe "find-file reads a file once, and asks before a large one"
  (test "ed-read-file: one read says text or binary, and keeps what it read"
    (let (text-path (vf-file "a.txt" "héllo\r\n")
          blob-path (path/join (path/dirname text-path) "b.bin"))
      (file/spit-bytes blob-path (bytes 0 255 1))
      (assert= (ed-read-file text-path) {:text "héllo\r\n"})
      (assert= (count (:bytes (ed-read-file blob-path))) 3)))
  (test "a text file opens from that one read: decoded, stamped, unmodified"
    (let (path (vf-file "c.txt" "one\r\ntwo\r\n")
          buf (cur (ed-find-file (m-of "") path)))
      (assert= (buffer-text buf) "one\ntwo\n")
      (assert= (buffer-eol buf) :crlf)
      (is (not (buffer-modified? buf)))
      (is (not (buffer-file-changed? buf)))))
  (test "a file over the threshold is asked about: y opens it, n leaves it"
    (let (path (vf-file "big.log" "0123456789abcdef\n")
          m (assoc (m-of "") :large-file-warning-threshold 10)
          asked (ed-visit-file m path))
      (assert= (:echo asked) "File big.log is large (17 B), really open? (y or n)")
      (is (not (= (buffer-file (cur asked)) path)))
      (assert= (buffer-file (cur (ed-update asked "y" 80 24))) path)
      (let (declined (ed-update asked "n" 80 24))
        (is (not (= (buffer-file (cur declined)) path)))
        (assert= (:echo declined) "not opened"))))
  (test "within the threshold, 0 (never ask), already open, or missing: opened at once"
    (let (path (vf-file "small.log" "0123456789abcdef\n"))
      (assert= (buffer-file (cur (ed-visit-file (assoc (m-of "") :large-file-warning-threshold 100)
                                   path)))
        path)
      (assert= (buffer-file (cur (ed-visit-file (assoc (m-of "") :large-file-warning-threshold 0)
                                   path)))
        path)
      (let (opened (ed-find-file (assoc (m-of "") :large-file-warning-threshold 10) path))
        (assert= (buffer-file (cur (ed-visit-file opened path))) path))
      (let (missing (path/join (path/dirname path) "new.txt"))
        (assert= (buffer-file (cur (ed-visit-file (assoc (m-of "") :large-file-warning-threshold 1)
                                     missing)))
          missing))))
  (test "the default is Emacs's, 10 MB, when the model has none"
    (assert= config/*large-file-warning-default* 10000000)
    (is (nil? (ed-large-file-question (m-of "") (vf-file "d.txt" "small")))))
  (test "the C-x C-f prompt asks, and C-x 4 f does too"
    (let (path (vf-file "e.log" "0123456789abcdef\n")
          m (assoc (m-of "") :large-file-warning-threshold 10))
      (is (string/starts-with? (:echo ((:on-complete (ed-find-file-prompt "/" [])) m path))
            "File e.log is large"))
      (is (string/starts-with? (:echo ((:on-complete (window-commands/ed-find-file-other-window-prompt "/"
                                                       [])) m
                                        path))
            "File e.log is large"))))
  (test "dired's RET on a large file asks"
    (let (path (vf-file "f.log" "0123456789abcdef\n")
          dir (path/dirname path)
          ;; the listing's line for f.log, whichever it is
          line (seq/find (range 12) (fn (n) (= (dired/ed-dired-name-at (dired-on dir n)) "f.log")))
          m (assoc (dired-on dir line) :large-file-warning-threshold 10))
      (is (string/starts-with? (:echo (cmd-dired-open m nil)) "File f.log is large"))))
  (test "a launch file that is large, binary or unreadable starts on the welcome buffer, pending"
    (let (text-path (vf-file "g.txt" "hello\n")
          dir (path/dirname text-path)
          blob-path (path/join dir "g.bin")
          big-path (vf-file "g.log" "0123456789abcdef\n")
          cfg {:large-file-warning-threshold 10})
      (file/spit-bytes blob-path (bytes 0 255 1))
      (let ([buf pending] (main/launch-buffer text-path false nil {}))
        (assert= (buffer-text buf) "hello\n")
        (is (nil? pending)))
      (let ([buf pending] (main/launch-buffer blob-path false nil {}))
        (is (nil? (buffer-file buf)))
        (assert= (count (:bytes pending)) 3))
      (let ([buf pending] (main/launch-buffer big-path false nil cfg))
        (is (nil? (buffer-file buf)))
        (assert= pending :ask))
      ;; and opened once there is a model: the binary as hex, the large file asked about
      (is (includes? (:echo (main/open-pending (m-of "") blob-path {:bytes (bytes 0 255 1)}))
            "as hex"))
      (is (string/starts-with? (:echo (main/open-pending (assoc (m-of "")
                                                           :large-file-warning-threshold 10)
                                        big-path :ask))
            "File g.log is large")))))

(describe "dired-jump — C-x C-j / C-x j: the file's directory, point on the file, no prompt"
  (test "from a file buffer, dired opens on its directory with point on its name"
    (let (dir (path/temp "bedit-jump-")
          _ (file/mkdir dir)
          _ (file/spit (path/join dir "aaa.txt") "a")
          _ (file/spit (path/join dir "mmm.txt") "m")
          _ (file/spit (path/join dir "zzz.txt") "z")
          m (ed-find-file (ed-init (make-buffer "" "*scratch*")) (path/join dir "mmm.txt"))
          j (cmd-dired-jump m nil)
          buf (ed-current-buf j))
      (is (nil? (:minibuffer j)))
      (assert= (ed-dired-state j :dired-dir) dir)
      (assert= (editor/layers/buffer-type-for buf) :dired)
      ;; point sits on the entry for the file we came from
      (is (string/starts-with? (string/substring (wrap/line-text buf (buffer-current-line buf))
                                 (buffer-column buf))
            "mmm.txt"))))
  (test "from a dired buffer it jumps to the parent, point on the directory just left"
    (let (dir (path/temp "bedit-jump-")
          sub (path/join dir "inner")
          _ (file/mkdir sub)
          _ (file/spit (path/join sub "f.txt") "f")
          m (ed-show-dired (ed-init (make-buffer "" "*scratch*")) sub)
          j (cmd-dired-jump m nil)
          buf (ed-current-buf j))
      (assert= (ed-dired-state j :dired-dir) dir)
      (is (string/starts-with? (string/substring (wrap/line-text buf (buffer-current-line buf))
                                 (buffer-column buf))
            "inner")))))

(describe "find-file on a directory opens dired, not a buffer (Emacs)"
  (test "a directory path visits its listing; a file inside it still visits the file"
    (let (dir (path/temp "bedit-ff-dir-")
          _ (file/mkdir dir)
          _ (file/spit (path/join dir "a.txt") "a")
          d (ed-find-file (ed-init (make-buffer "" "*scratch*")) dir)
          f (ed-find-file d (path/join dir "a.txt")))
      (assert= (editor/layers/buffer-type-for (ed-current-buf d)) :dired)
      (assert= (ed-dired-state d :dired-dir) dir)
      (assert= (:file (ed-current-buf f)) (path/join dir "a.txt")))))

(describe "hexl-mode — the hex view is its own mode, with syntax"
  (test "a binary buffer is typed :hexl and its mode is named hexl, not special"
    (let (dir (path/temp "bedit-hexl-mode-")
          _ (file/mkdir dir)
          path (path/join dir "blob.bin")
          _ (file/spit-bytes path (bytes 0 0 65 66 255))
          m (ed-find-file (ed-init (make-buffer "" "*scratch*")) path)
          buf (ed-current-buf m))
      (assert= (editor/layers/buffer-type-for buf) :hexl)
      (assert= (:name (first (editor/layers/active-layers buf))) 'hexl)
      (is (fn? (ed-mode-service buf :fontify)))))
  (test "hexl-fontify: the offset is dim, zero pairs dimmer, the ascii column a string, the header a comment"
    (let (src (str ";; binary file: 5 bytes (read-only)\n" (hexl-row (bytes 0 0 65 66 255) 0 5))
          spans (hexl-fontify src)
          row-off 36 ; after the 35-char header line + newline
          faces (map spans
                  (fn ([s e f])
                    [(- s row-off)
                      (- e row-off)
                      (if (= f dired/face-dired-size) :dim (if (:fg f) :colour :none))])))
      ;; header comment, offset, two zero pairs (`00 00` at hex columns 10 and 12), then the ascii column
      (assert= (first faces) [(- 0 row-off) (- 35 row-off) :colour]) ; the header, 35 chars
      (assert= (nth faces 1) [0 8 :dim])
      (assert= (nth faces 2) [10 12 :dim])
      (assert= (nth faces 3) [12 14 :dim])
      ;; the ascii column: hexl-ascii-col (51) into the row, five glyphs (`..AB.`)
      (assert= (last faces) [51 56 :colour])
      (assert= (string/substring src (+ 51 row-off) (+ 56 row-off)) "..AB."))))

(describe "review fixes — hexl is never written; toggle keeps flags; jump on an unsaved file"
  (test "C-x C-s and C-x C-w refuse a hex view, and the binary is untouched"
    (let (dir (path/temp "bedit-hexl-save-")
          _ (file/mkdir dir)
          path (path/join dir "blob.bin")
          _ (file/spit-bytes path (bytes 127 69 76 70 0 255))
          m (ed-find-file (ed-init (make-buffer "" "*scratch*")) path)
          saved (cmd-save m nil)
          written (cmd-write-file m nil))
      (is (includes? (:echo saved) "not saved"))
      (is (nil? (:minibuffer written)))
      (assert= (count (file/slurp-bytes path)) 6)))
  (test "t (toggle marks) leaves a flagged row flagged, in one set only"
    (let (d (dired-fixture)
          flagged (cmd-dired-flag (dired-on d 4) nil) ; flag sub
          toggled (cmd-dired-toggle-marks flagged nil))
      (assert= (ed-dired-state toggled :dired-flags) (list "sub"))
      (is (not (includes? (ed-dired-state toggled :dired-marks) "sub")))
      (is (not (empty? (ed-dired-state toggled :dired-marks)))) ; the others were marked
      (file/rmdir d)))
  (test "dired-jump from a file not yet on disk lands on the first entry, not the header"
    (let (d (dired-fixture)
          m (ed-find-file (m-of "") (path/join d "unsaved.txt"))
          j (cmd-dired-jump m nil)
          buf (cur j))
      (assert= (ed-dired-state j :dired-dir) d)
      (is (> (buffer-current-line buf) 0))
      (file/rmdir d))))

;; ---- sorting (s, C-u s) — Emacs's dired-sort-toggle-or-edit ----------------------------
(defn- sort-fixture ()
  ;; three files whose name, size and age orders all differ, and a folder among them
  (let (d (temp-dir "bedit-dired-")
        _ (file/mkdir d)
        _ (file/spit (path/join d "Beta.md") "xx")
        _ (file/spit (path/join d "alpha.txt") "xxxxxx")
        _ (file/mkdir (path/join d "bin"))
        _ (file/spit (path/join d ".config") "x"))
    d))

(defn- names-after (m) (into [] (drop (ed-dired-state m :dired-names) 2)))

(describe "editor dired: sorting"
  (test "by name by default: case and a leading dot ignored, folders and files mixed"
    (let (d (sort-fixture))
      (assert= (names-after (ed-show-dired (m-of "") d 2)) ["alpha.txt" "Beta.md" "bin" ".config"])
      (file/rmdir d)))
  (test "the switches say the order: size, extension, reversed, folders first"
    (let (d (sort-fixture)
          by (fn (switches)
               (names-after (ed-show-dired (assoc (m-of "") :dired-listing-switches switches) d 2))))
      (assert= (into [] (take (by "-alS") 2)) ["bin" "alpha.txt"])
      (assert= (by "-alr") [".config" "bin" "Beta.md" "alpha.txt"])
      (assert= (by "-alX") ["bin" ".config" "Beta.md" "alpha.txt"])
      (assert= (by "-al --group-directories-first") ["bin" "alpha.txt" "Beta.md" ".config"])
      (file/rmdir d)))
  (test "s toggles name and date, says so, keeps point on its entry, and is kept for the directory"
    (let (d (sort-fixture)
          m (ed-show-dired (m-of "") d 5) ; on Beta.md (after . .. alpha.txt)
          sorted (cmd-dired-sort-toggle-or-edit m nil))
      (assert= (:echo sorted) "Dired by date")
      (assert= (ed-dired-switches sorted d) "-alt")
      (assert= (dired/ed-dired-name-at sorted) "Beta.md")
      (assert= (ed-dired-switches (cmd-dired-refresh sorted nil) d) "-alt")
      (assert= (:echo (cmd-dired-sort-toggle-or-edit sorted nil)) "Dired by name")
      (file/rmdir d)))
  (test "C-u s edits the switches"
    (let (d (sort-fixture)
          m (assoc (ed-show-dired (m-of "") d 2) :prefix-arg {:count 4 :raw true})
          asked (cmd-dired-sort-toggle-or-edit m nil)
          done (press (type-str (press asked [:ctrl-a :ctrl-k]) "-alSr") [:enter]))
      (assert= (ed-dired-switches done d) "-alSr")
      (assert= (dired-sort-label "-alSr") "by size, reversed")
      (file/rmdir d)))
  (test "the switch rules: long options are not letters, the last order letter wins"
    (assert= (dired-sort-of "-al --group-directories-first")
      {:key :name :reverse false :dirs-first true})
    (assert= (dired-sort-of "-alt -S") {:key :size :reverse false :dirs-first false})
    (assert= (dired-toggle-switches "-al --group-directories-first")
      "-alt --group-directories-first")
    (assert= (dired-toggle-switches "-alSt") "-al")))
