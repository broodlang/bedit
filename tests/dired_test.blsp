;; Editor tests — dired (the directory browser, C-x C-d). Same shared `main-test`
;; module as the other split test files (helpers resolve at run time across files).
(defmodule main-test
  (:use model)
  (:use input)
  (:use view)
  (:use commands)
  (:use panes)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(defn type-str (m s) (press m (string->list s)))

;; Clear any fixtures a crashed earlier run left behind, before any test builds one.
(purge-stale-temp "myedit-dired-")

;; A fixture directory holding a subdir `sub/` and a file `a.txt` ("hello"). Returns the
;; absolute dir path. list-dir sorts entries, so dired's order is: "." ".." then dirs
;; (sub) then files (a.txt) — i.e. 1-based lines 2,3,4,5.
(defn dired-fixture ()
  (let (d (temp-dir "myedit-dired-")
        _ (make-dir d)
        _ (make-dir (path-join d "sub"))
        _ (spit (path-join d "a.txt") "hello"))
    d))

;; A model showing dired on `dir` with point on (1-based) `line`.
(defn dired-on (dir line) (ed-show-dired (m-of "") dir line))

(describe "editor dired: listing"
  (test "lists . .. dirs-first then files, in a read-only buffer named by the dir"
    (let (d (dired-fixture)
          m (dired-on d 2)
          txt (buffer-text (cur m)))
      (is (read-only? (cur m)))
      (is (string-contains? (buffer-name (cur m)) d))
      (is (string-contains? txt "sub"))
      (is (string-contains? txt "a.txt"))
      ;; dir row marked d, file row marked - ; the model records the ordered names
      (assert= (get m :dired-names) ["." ".." "sub" "a.txt"])
      (delete-dir d)))
  (test "the entry under point is recovered by line index, not column parsing"
    (let (d (dired-fixture))
      (assert= (commands/ed--dired-name-at (dired-on d 4)) "sub")    ; line 4 = the subdir
      (assert= (commands/ed--dired-name-at (dired-on d 5)) "a.txt")  ; line 5 = the file
      (is (nil? (commands/ed--dired-name-at (dired-on d 1))))        ; line 1 = the header
      (delete-dir d))))

(describe "editor dired: navigation"
  (test "RET on a subdir enters it; ^ returns to the parent"
    (let (d (dired-fixture)
          into (cmd-dired-open (dired-on d 4) nil))        ; point on sub → enter
      (assert= (get into :dired-dir) (path-join d "sub"))
      (let (back (cmd-dired-up into nil))
        (assert= (get back :dired-dir) d))
      (delete-dir d)))
  (test "RET on a file opens it as a normal editable buffer"
    (let (d (dired-fixture)
          opened (cmd-dired-open (dired-on d 5) nil))       ; point on a.txt
      (refute (read-only? (cur opened)))
      (is (string-contains? (buffer-file (cur opened)) "a.txt"))
      (assert= (buffer-text (cur opened)) "hello")
      (delete-dir d))))

(describe "editor dired: file operations"
  (test "+ creates a directory; the refreshed listing shows it"
    (let (d (dired-fixture)
          done (press (type-str (cmd-dired-create-dir (dired-on d 2) nil) "newdir") [:enter]))
      (is (dir? (path-join d "newdir")))
      (is (string-contains? (buffer-text (cur done)) "newdir"))
      (delete-dir d)))
  (test "C copies the file under point, leaving the original"
    ;; the prompt is seeded with the current name (point at end); C-a C-k clears it first
    (let (d (dired-fixture)
          done (press (type-str (press (cmd-dired-copy (dired-on d 5) nil) [:ctrl-a :ctrl-k])
                        "b.txt")
                 [:enter]))
      (assert= (slurp (path-join d "a.txt")) "hello")       ; original kept
      (assert= (slurp (path-join d "b.txt")) "hello")       ; copy made
      (is (string-contains? (buffer-text (cur done)) "b.txt"))
      (delete-dir d)))
  (test "R renames the file under point"
    (let (d (dired-fixture)
          done (press (type-str (press (cmd-dired-rename (dired-on d 5) nil) [:ctrl-a :ctrl-k])
                        "renamed.txt")
                 [:enter]))
      (refute (file-exists? (path-join d "a.txt")))
      (assert= (slurp (path-join d "renamed.txt")) "hello")
      (delete-dir d)))
  (test "D deletes the file under point after a y confirm"
    (let (d (dired-fixture)
          done (ed-update (cmd-dired-delete (dired-on d 5) nil) "y" 80 24))
      (refute (file-exists? (path-join d "a.txt")))
      (refute (string-contains? (buffer-text (cur done)) "a.txt"))
      (delete-dir d)))
  (test "D with any non-y key cancels — the file stays"
    (let (d (dired-fixture)
          done (ed-update (cmd-dired-delete (dired-on d 5) nil) "n" 80 24))
      (is (file-exists? (path-join d "a.txt")))
      (delete-dir d))))
