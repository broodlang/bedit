;; C# (src/languages/csharp.blsp): a `deflanguage` over tree-sitter-c-sharp, and its
;; language-server row (src/lsp/client.blsp): csharp-ls, rooted at a solution.
;; Its parsed sample is the corpus's, tests/corpus/csharp/, which tests/language_corpus_test.blsp
;; checks; what is here needs no grammar.
(defmodule languages-csharp-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer]))

(purge-stale-temp "bedit-lsp-marker-")

(describe "c#, the mode"
  (test "a .csx file opens in csharp mode too"
    (doseq (file ["/p/build.csx"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "csharp")))
  (test "a `.cs` pattern does not take a `.css` file"
    (assert= (ed-buf-mode-name (file-buffer "" "/p/a.css")) "css"))
  (test "it parses with tree-sitter-c-sharp, which says where it lives"
    (assert= (ed-mode-service (file-buffer "" "/p/A.cs") :ts-lang) :c-sharp)
    (assert= (:url (model/grammar-source :c-sharp))
      "https://github.com/tree-sitter/tree-sitter-c-sharp"))
  (test "it comments with //"
    (assert= (ed-mode-service (file-buffer "" "/p/A.cs") :comment-syntax) "// "))
  (test "it indents with spaces"
    (is (not (ed-mode-service (file-buffer "" "/p/A.cs") :indent-tabs))))
  (test "it formats with csharpier"
    (assert= (ed-mode-service (file-buffer "" "/p/A.cs") :format-command)
      [["csharpier" "format"] ["dotnet-csharpier"]])))

(describe "c#, the fontify restart"

  (test "C#: a verbatim @\"…\" and a raw \"\"\"…\"\"\" string span lines and take no escapes"
    (let (data (stringlex/lexer-data (get languages/csharp/csharp-spec :strings) [["(" ")"]])
          verbatim (stringlex/state-after data "var s = @\"C:\\dir" [nil ""]))
      (assert= verbatim [[:string "@\"" true true] ""])
      ;; a backslash does not escape, and the plain quote closes it
      (assert= (stringlex/state-after data "var s = @\"C:\\dir\\\"; f(" [nil ""]) [nil "("])
      (assert= (stringlex/state-after data "still inside\\\"; f(" verbatim) [nil "("])
      (assert= (stringlex/state-after data "var s = \"\"\"" [nil ""])
        [[:string "\"\"\"" true true] ""])
      ;; an ordinary string still escapes its quote, and ends with its line
      (assert= (stringlex/state-after data "var s = \"a\\\"b\"; f(" [nil ""]) [nil "("])))
  (test "C#: a column-0 declaration, the one before a verbatim string still open across it"
    (let (src "using System;\n\npublic class A\n{\n    int x;\n}\n")
      (assert= (languages/csharp/csharp-restart src (index-of src "    int"))
        (index-of src "public class")))
    (let (src "var s = @\"\npublic class A\n\";\npublic class B\n{\n    int x;\n}\n")
      (assert= (languages/csharp/csharp-restart src (index-of src "    int"))
        (index-of src "public class B")))
    (let (src "using System;\npublic class B\n{\n    var s = @\"\npublic class A\n    int x;\n")
      (assert= (languages/csharp/csharp-restart src (index-of src "    int"))
        (index-of src "public class B")))))

;; The sample, tests/corpus/csharp/Greeter.cs (csharpier), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart.

(describe "c#, the language server"
  (test "a C# file reaches csharp-ls"
    (assert= (into [] (map (lsp/client/lsp-specs-for "/p/Program.cs") :name)) ["csharp-ls"]))
  (test "the language id csharp-ls expects"
    (assert= (lsp/client/lsp-language-id "/p/Program.cs") "csharp"))

  (test "a `*.sln` marker is any solution file in the folder, a plain one a file name"
    (let (dir (temp-dir "bedit-lsp-marker-")
          _ (file/mkdir dir))
      (file/spit (path/join dir "Shop.sln") "")
      (is (lsp/client/lsp-marker-in? dir "*.sln"))
      (is (not (lsp/client/lsp-marker-in? dir "*.csproj")))
      (is (lsp/client/lsp-marker-in? dir "Shop.sln"))
      (is (not (lsp/client/lsp-marker-in? (path/join dir "nowhere") "*.sln"))))))
