;; tests/electric_test.blsp — electric pairs per mode (Emacs's electric-pair-mode with each
;; mode's pairs), the inhibit rules, a closer skipped past spaces, a region wrapped by a closer,
;; triple quotes, and the global / local switches and the per-mode setting.
;;
;; The edits are std's (`insert-pair`, `delete-empty-pair`, `sexp/wrap-region`); the bracket
;; keys' wiring in a Brood buffer is pinned in editing_test. These pin `electric`'s POLICY.

(defmodule electric-test
  (:use testkit :only [press cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use electric)
  (:use editor/buffer))

(defn- file-model (text file point)
  (let (m (ed-init (make-buffer text file file)))
    (ed-set-buf m (goto-char (ed-current-buf m) point))))
(defn- typed (text file point keys)
  ;; `[text point]` after `keys` at `point` of a `file` buffer
  (let (m (press (file-model text file point) keys))
    [(buffer-text (cur m)) (buffer-point (cur m))]))

(describe "each mode pairs its own characters"
  (test "`'` pairs where it opens a string, and not in a Lisp or in prose"
    (assert= (typed "x = " "a.py" 4 ["'"]) ["x = ''" 5])
    (assert= (typed "x = " "a.rb" 4 ["'"]) ["x = ''" 5])
    (assert= (typed "(a " "a.blsp" 3 ["'"]) ["(a '" 4])
    (assert= (typed "it " "a.txt" 3 ["'"]) ["it '" 4])
    ;; Rust's `'` is a lifetime
    (assert= (typed "fn f<" "a.rs" 5 ["'"]) ["fn f<'" 6]))
  (test "a backtick pairs in Markdown, JavaScript and the shell, not in text"
    (assert= (typed "see " "a.md" 4 ["`"]) ["see ``" 5])
    (assert= (typed "x = " "a.js" 4 ["`"]) ["x = ``" 5])
    (assert= (typed "x=" "a.sh" 2 ["`"]) ["x=``" 3])
    (assert= (typed "see " "a.txt" 4 ["`"]) ["see `" 5]))
  (test "`<>` pairs nowhere by default"
    (assert= (typed "a " "a.rs" 2 ["<"]) ["a <" 3])
    (assert= (typed "a " "a.html" 2 ["<"]) ["a <" 3]))
  (test "the mode's table, and the default for a mode with none"
    (assert= (pairs-for (file-model "" "a.txt" 0) (cur (file-model "" "a.txt" 0))) *default-pairs*)
    (is (includes? (pairs-for (file-model "" "a.md" 0) (cur (file-model "" "a.md" 0))) ["`" "`"]))))

(describe "the inhibit rules"
  (test "an opener before a word character is typed alone"
    (assert= (typed "foo" "a.txt" 0 ["("]) ["(foo" 1])
    (assert= (typed "foo" "a.py" 0 ["["]) ["[foo" 1])
    (assert= (typed "x = foo" "a.py" 4 ["'"]) ["x = 'foo" 5]))
  (test "…and before the same character, and as the third of a run"
    (assert= (typed " (" "a.txt" 1 ["("]) [" ((" 2])
    (assert= (typed "((" "a.txt" 2 ["("]) ["(((" 3]))
  (test "before a space, a closer or the end it pairs"
    (assert= (typed "a " "a.txt" 2 ["("]) ["a ()" 3])
    (assert= (typed "f()" "a.py" 2 ["["]) ["f([])" 3]))
  (test "a Lisp always pairs, as paredit does"
    (assert= (typed "foo" "a.blsp" 0 ["("]) ["()foo" 1]))
  (test "a quote after a word closes rather than opens"
    (assert= (typed "x = 'it" "a.py" 7 ["'"]) ["x = 'it'" 8])))

(describe "closers and backspace"
  (test "a closer at point is stepped over — past spaces on the line too"
    (assert= (typed "f(a)" "a.py" 3 [")"]) ["f(a)" 4])
    (assert= (typed "f(a  )" "a.py" 3 [")"]) ["f(a  )" 6])
    (assert= (typed "[1 ]" "a.blsp" 2 ["]"]) ["[1 ]" 4]))
  (test "across a line too (Emacs's skip-whitespace chars: space, tab, newline)"
    (assert= (typed "{a\n}" "a.js" 2 ["}"]) ["{a\n}" 4])
    (assert= (typed "f(a,\n  )" "a.py" 4 [")"]) ["f(a,\n  )" 8])))

(describe "electric-pair-preserve-balance"
  (test "a closer the brackets still need is typed, not stepped over"
    (assert= (typed "((a)" "a.py" 3 [")"]) ["((a))" 4])
    (assert= (typed "(a)" "a.py" 2 [")"]) ["(a)" 3]))
  (test "an opener a waiting closer balances is typed alone"
    (assert= (typed " x)" "a.py" 0 ["("]) ["( x)" 1])
    (assert= (typed " x" "a.py" 0 ["("]) ["() x" 1]))
  (test "brackets in strings and comments are not counted"
    ;; the `(` in the string and the `)` in the comment close nothing: the closer steps over
    (assert= (typed "f(\"(\" )" "a.py" 5 [")"]) ["f(\"(\" )" 7])
    (assert= (typed "(a)  # (" "a.py" 2 [")"]) ["(a)  # (" 3]))
  (test "without a grammar: Python's balance and strings come from its string syntax"
    (assert= (typed "x = '''(\n'''\nf(a" "a.py" 16 ["("]) ["x = '''(\n'''\nf(a()" 17]))
  (test "the setting turns it off — everywhere, or for one mode"
    (defn- typed-with (setting text file point keys)
      (let (m (press (assoc (file-model text file point) :electric-pair-preserve-balance setting)
                keys))
        [(buffer-text (cur m)) (buffer-point (cur m))]))
    (assert= (typed-with false "((a)" "a.py" 3 [")"]) ["((a)" 4])
    (assert= (typed-with false " x)" "a.py" 0 ["("]) ["() x)" 1])
    (assert= (typed-with {:python false} "((a)" "a.py" 3 [")"]) ["((a)" 4])
    (assert= (typed-with {:python false :default true} "((a)" "a.js" 3 [")"]) ["((a))" 4])
    (is (config/per-mode-bool-valid? {:default true :python false}))))

(describe "a quote reads the string state at point"
  (test "in a string it closes it, after anything"
    (assert= (typed "x = \"hello world." "a.py" 17 ["\""]) ["x = \"hello world.\"" 18])
    (assert= (typed "say \"hi." "a.md" 8 ["\""]) ["say \"hi.\"" 9]))
  (test "in code it opens one, after a word too"
    (assert= (typed "x = f" "a.py" 5 ["\""]) ["x = f\"\"" 6]))
  (test "another quote inside a string is a character of it"
    (assert= (typed "x = \"it" "a.py" 7 ["'"]) ["x = \"it'" 8]))
  (test "a triple quote opens only in code"
    (assert= (typed "x = \"a\"\"" "a.py" 8 ["\""]) ["x = \"a\"\"\"" 9]))
  (test "in a comment it pairs as prose does on the line"
    (assert= (typed "# say " "a.py" 6 ["\""]) ["# say \"\"" 7])
    (assert= (typed "# say \"hi" "a.py" 9 ["\""]) ["# say \"hi\"" 10]))
  (test "a multi-line string's quote closes it lines later"
    (assert= (typed "x = \"\"\"doc\nmore" "a.py" 15 ["\""]) ["x = \"\"\"doc\nmore\"" 16])))

(describe "quotes and backspace"
  (test "a quote at point is stepped over"
    (assert= (typed "x = ''" "a.py" 5 ["'"]) ["x = ''" 6]))
  (test "backspace between an empty pair of the mode takes both"
    (assert= (typed "x = ''" "a.py" 5 [:backspace]) ["x = " 4])
    (assert= (typed "see ``" "a.md" 5 [:backspace]) ["see " 4])
    ;; a pair the mode does not have is one character
    (assert= (typed "it ''" "a.txt" 4 [:backspace]) ["it '" 3])))

(describe "triple quotes"
  (test "the third quote of a run opens a triple and its closer"
    (assert= (typed "x = " "a.py" 4 ["\"" "\"" "\""]) ["x = \"\"\"\"\"\"" 7])
    (assert= (typed "x = " "a.py" 4 ["'" "'" "'"]) ["x = ''''''" 7]))
  (test "a mode without triples types the quote"
    (assert= (typed "x = " "a.js" 4 ["\"" "\"" "\""]) ["x = \"\"\"" 7])))

(describe "a region and a bracket"
  (defn- selected (file text lo hi)
    ;; `text` in a `file` buffer with the region [lo hi], point at hi
    (let (m (file-model text file hi)) (ed-set-buf m (assoc (cur m) :mark lo))))
  (test "an opener wraps the region, point inside the opener"
    (let (m (press (selected "a.txt" "a b c" 2 3) ["("]))
      (assert= (buffer-text (cur m)) "a (b) c")
      (assert= (buffer-point (cur m)) 3)))
  (test "a closer wraps it too, point after the closer"
    (let (m (press (selected "a.txt" "a b c" 2 3) ["]"]))
      (assert= (buffer-text (cur m)) "a [b] c")
      (assert= (buffer-point (cur m)) 5))
    (let (m (press (selected "a.blsp" "a b c" 2 3) [")"]))
      (assert= (buffer-text (cur m)) "a (b) c")
      (assert= (buffer-point (cur m)) 5)))
  (test "a mode's own pair wraps: a backtick in Markdown"
    (assert= (buffer-text (cur (press (selected "a.md" "use x now" 4 5) ["`"]))) "use `x` now"))
  (test "the wrap happens with the mode off"
    (let (m (assoc (selected "a.txt" "a b c" 2 3) :electric-pair? false))
      (assert= (buffer-text (cur (press m ["{"]))) "a {b} c"))))

(describe "the switches and the setting"
  (test "M-x electric-pair-local-mode turns it off in one buffer, and back on"
    (let (m (file-model "a " "a.txt" 2)
          off (cmd-electric-pair-local-mode m nil)
          on (cmd-electric-pair-local-mode off nil))
      (is (not (electric-pair-in? off (cur off))))
      (is (includes? (:echo off) "this buffer"))
      (assert= (buffer-text (cur (press off ["("]))) "a (")
      (assert= (buffer-text (cur (press on ["("]))) "a ()")))
  (test "the local switch wins over the global one"
    (let (m (assoc (file-model "a " "a.txt" 2) :electric-pair? false)
          on (cmd-electric-pair-local-mode m nil))
      (assert= (buffer-text (cur (press m ["("]))) "a (")
      (assert= (buffer-text (cur (press on ["("]))) "a ()")))
  (test "the setting: false is off everywhere, a map per mode"
    (let (text (file-model "a " "a.txt" 2)
          md (file-model "a " "a.md" 2))
      (assert= (buffer-text (cur (press (assoc text :electric-pair false) ["("]))) "a (")
      (assert= (buffer-text (cur (press (assoc text :electric-pair {:default true :text false})
                                   ["("])))
        "a (")
      (assert= (buffer-text (cur (press (assoc md :electric-pair {:text false :markdown true})
                                   ["("])))
        "a ()")))
  (test "a mode's entry may be its pairs, replacing the mode's"
    (let (m (assoc (file-model "a " "a.md" 2) :electric-pair {:markdown [["*" "*"] ["(" ")"]]}))
      (assert= (buffer-text (cur (press m ["*"]))) "a **")
      (assert= (buffer-text (cur (press m ["`"]))) "a `")))
  (test "the project shell's input does not pair unless the setting names it"
    (bshell/bshell-fontify "") ; bshell-mode's layer, registered
    (let (shell (editor/layers/set-buffer-type (end-of-buffer (insert (make-buffer "" "*bshell*")
                                                                "/tmp $ "))
                  :bshell)
          m (pool/ed-open-buffer (ed-init (make-buffer "")) shell))
      (is (not (electric-pair-in? m (cur m))))
      (assert= (buffer-text (cur (press m ["\""]))) "/tmp $ \"")
      (is (electric-pair-in? (assoc m :electric-pair {:bshell true}) (cur m)))
      ;; a `:default` is below the mode's own choice, as every per-mode convention
      (is (not (electric-pair-in? (assoc m :electric-pair {:default true}) (cur m))))))
  (test "M-x electric-pair-mode turns a plain `false` setting back on"
    (let (m (assoc (file-model "a " "a.txt" 2) :electric-pair false)
          on (cmd-electric-pair-mode m nil))
      (is (electric-pair? on))
      (assert= (buffer-text (cur (press on ["("]))) "a ()")))
  (test "the setting's values are checked"
    (is (config/electric-pair-valid? true))
    (is (config/electric-pair-valid? {:default true :markdown [["*" "*"]]}))
    (is (not (config/electric-pair-valid? {:markdown [["*"]]})))
    (is (not (config/electric-pair-valid? "yes")))))

(describe "comment text pairs as prose"
  (test "an apostrophe in a comment is typed alone, in every language whose `'` opens a string"
    (assert= (typed "# don" "a.py" 5 ["'" "t"]) ["# don't" 7])
    (assert= (typed "# it is " "a.rb" 8 ["'"]) ["# it is '" 9]))
  (test "a double quote still pairs there"
    (assert= (typed "# say " "a.py" 6 ["\""]) ["# say \"\"" 7])))

;; Emacs's electric-indent-mode: a key that ends a block reindents its line as it is typed.
(describe "electric indent"
  (test "`end` lands at its block's column as its last letter is typed"
    (assert= (first (typed "def f\n  x\n  en" "a.rb" 14 ["d"])) "def f\n  x\nend")
    (assert= (first (typed "def f do\n  x\n  en" "a.ex" 17 ["d"])) "def f do\n  x\nend"))
  (test "…and goes back when the word turns out longer (`end_time`)"
    (assert= (first (typed "def f\n  x\n  en" "a.rb" 14 ["d" "_"])) "def f\n  x\n  end_"))
  (test "a closing bracket alone on its line goes to the block's column"
    (assert= (first (typed "x = [\n  1\n  " "a.rb" 12 ["]"])) "x = [\n  1\n]"))
  (test "not inside a string"
    (assert= (first (typed "def f\n  x = \"a\n  en" "a.rb" 20 ["d"])) "def f\n  x = \"a\n  end"))
  (test "the reindent is part of the character's undo step"
    (assert= (first (typed "def f\n  x\n  en" "a.rb" 14 ["d" :ctrl-/])) "def f\n  x\n  en"))
  (test "RET between an empty pair opens a line for the body"
    (assert= (typed "x = []" "a.rb" 5 [:enter]) ["x = [\n  \n]" 8])
    ;; not between a pair: a plain newline
    (assert= (count (string/split (first (typed "x = [1]" "a.rb" 6 [:enter])) "\n")) 2))
  (test "…and one undo takes the whole RET back"
    (assert= (typed "x = []" "a.rb" 5 [:enter :ctrl-/]) ["x = []" 5])))
