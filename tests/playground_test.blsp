;; The Brood playground (`src/playground.blsp`) and the vocabulary it shares with the
;; tutorial (`src/liveeval.blsp`).
;;
;; Everything here runs WITHOUT a sandbox. The eval path is a round trip to another OS
;; process, so the tests drive the two halves it sits between directly: what the launcher
;; decides to send (`first-changed`, `parse-state`) and what a reply becomes once it lands
;; (`playground-sandbox-reply` fed a synthetic reply map). That is the same seam the
;; tutorial's own suite uses, and it is why a feature built on a subprocess is still
;; testable in 40ms with no window.

(defmodule playground-test
  (:use test)
  (:use model)
  (:use input)
  (:use editor/buffer)
  (:use-internals playground)
  (:use-internals view) ; ed-eol-note-ops / ed-eol-note-face — the ghost-text layout
  (:use-internals modes)) ; mark-note-glyph — the margin mark for a note kind
(defn m-of (text) (ed-init (make-buffer text)))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))

;; Open the playground and put `text` in it — the state a launch or a reply acts on.
;;
;; Stamps the same parse cache a launch does (`:playground-rope` + the extents),
;; because that is the state a REPLY arrives into: a reply is only accepted when the rope is
;; still the one its request was sent for, and everything it needs to place a note is read
;; from that launch's cache rather than re-parsed. A fixture without it would be testing a
;; buffer no reply can reach.
(defn pg-seed (b text)
  (let (rope (buffer-rope (make-buffer text))
        forms (playground/forms-of text))
    (assoc b
      :rope rope
      :playground-rope rope
      :playground-spans (playground/form-spans-in text forms))))

(defn pg-open (text)
  (let (m (playground/cmd-brood-playground (m-of "") :none)
        i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (assoc m
      :buffers
        (assoc (:buffers m)
          i (assoc (nth (:buffers m) i) :rope (buffer-rope (make-buffer text)))))))

;; The state a REPLY arrives into — the launch's parse cache, and no results yet. Distinct
;; from `pg-open` (a buffer nothing has evaluated) because a launch over the same text would
;; also evaluate it, which is not what a test about placing one reply wants to assert.
(defn pg-after-launch (text)
  (let (m (pg-open text)
        i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (assoc m :buffers (assoc (:buffers m) i (pg-seed (nth (:buffers m) i) text)))))

(defn pg-buf-of (m)
  (let (i (model/ed-buffer-index-by-name m playground/*buffer-name*)) (nth (:buffers m) i)))

;; A REAL edit through the buffer ops — the path a keystroke takes, so the toolkit shifts
;; markers with the text. `retext` swaps the rope wholesale, which nothing in the editor
;; does; a note anchored by markers cannot follow that, and shouldn't be asked to.
(defn pg-do (m f)
  (let (i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (assoc m :buffers (assoc (:buffers m) i (f (nth (:buffers m) i))))))
(defn pg-type (m at str) (pg-do m (fn (b) (insert (goto-char b at) str))))
(defn pg-undo (m) (pg-do m undo))

(defn retext (m text)
  (let (i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (assoc m
      :buffers
        (assoc (:buffers m)
          i (assoc (nth (:buffers m) i) :rope (buffer-rope (make-buffer text)))))))

;; Put point at offset `p` in the playground buffer — what a motion key leaves behind.
(defn pg-goto (m p)
  (let (i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (assoc m :buffers (assoc (:buffers m) i (goto-char (nth (:buffers m) i) p)))))

(defn pg-notes (m)
  (let (i (model/ed-buffer-index-by-name m playground/*buffer-name*))
    (or (results/eol-notes-any (nth (:buffers m) i)) {})))

;; ---- liveeval: the shared vocabulary ------------------------------------------------

(describe "liveeval/parse-state — ready, unfinished, or broken"
  (test "blank text is blank, not an error"
    (assert= (liveeval/parse-state "") :blank)
    (assert= (liveeval/parse-state "   \n  ") :blank))

  (test "a complete form is ready to send"
    (assert= (liveeval/parse-state "(+ 1 2)") :ok))

  ;; The distinction the whole live-eval idea rests on: an unclosed paren is the state every
  ;; form passes through while being typed, so it must not read as a mistake.
  (test "an unclosed form is INCOMPLETE, and says what it is waiting for"
    (let (state (liveeval/parse-state "(+ 1"))
      (assert= (first state) :incomplete)
      (is (string? (second state)))))

  (test "an unterminated string is incomplete too, not broken"
    (assert= (first (liveeval/parse-state "(str \"hi")) :incomplete))

  (test "a stray closer is a real error — no further typing fixes it"
    (assert= (first (liveeval/parse-state ")")) :err)))

(describe "liveeval/in-flight — which regions are already waiting"
  ;; Tagged, so a caller can merge these over its record of what the session has actually
  ;; evaluated, align the one map to the current text in a single pass, and still tell the
  ;; promises from the facts afterwards.
  (test "the request book, read by region, each answer marked a promise"
    (assert= (liveeval/in-flight {7 {:region 0 :src "(a)"} 8 {:region 2 :src "(c)"}})
      {0 {:src "(a)" :in-flight? true} 2 {:src "(c)" :in-flight? true}}))

  ;; Edit a region again before its first request answers and there are two out for it. The
  ;; newest is the one whose source is closest to the buffer, so it is the one that decides
  ;; whether the region needs sending again — and `into` over the map left that to whichever
  ;; entry iteration happened to visit last.
  (test "two requests for one region: the newest id wins, always"
    (assert= (:src (get (liveeval/in-flight {3 {:region 0 :src "(old)"}
                                             9 {:region 0 :src "(new)"}})
                     0))
      "(new)")
    (assert= (:src (get (liveeval/in-flight {9 {:region 0 :src "(new)"}
                                             3 {:region 0 :src "(old)"}})
                     0))
      "(new)"))

  (test "nothing out, nothing waiting"
    (assert= (liveeval/in-flight {}) {})))

(describe "liveeval/type-hint — what the checker makes of a form"
  (test "an expression's type"
    (assert= (liveeval/type-hint "(+ 1 2)") ": int"))

  ;; The question that forced this to exist. A definition form evaluates to its own NAME,
  ;; so `=> foo` is all a live evaluator had to show — and `foo` is a value, not a type.
  (test "a definition's SIGNATURE, named, not the symbol it evaluates to"
    (assert= (liveeval/type-hint "(defn pgt-len (s) (string/length s))")
      "pgt-len : (string -> int)"))

  ;; `(+ 1 1/2)` is 3/2 and can be nothing else — the checker says so since brood 0.17.
  (test "a ratio is a ratio"
    (assert= (liveeval/type-hint "(+ 1 1/2)") ": ratio"))

  (test "no opinion is nil — never a guess, and never a dangling separator"
    (assert= (liveeval/type-hint "(fn (x) x)") nil)
    (assert= (liveeval/type-hint "(+ 1") nil)
    (assert= (liveeval/type-hint "") nil)))

(describe "liveeval — what a reply is worth saying"
  ;; The value and the type are two different claims — what the code DID and what the
  ;; language thinks it MAY do — so they travel together and are placed apart: the answer
  ;; under the form, the type at it (`playground/pg-set-note`).
  (test "a value, with its type carried alongside rather than inside"
    (let (note (liveeval/result-note {:ok true :value "3" :ms 0} "(+ 1 2)"))
      (assert= (:kind note) :info)
      (assert= (:text note) "=> 3")
      (assert= (:hint note) ": int")))

  (test "no source, no type — the value alone"
    (let (note (liveeval/result-note {:ok true :value "3" :ms 0}))
      (assert= (:text note) "=> 3")
      (assert= (:hint note) nil)))

  ;; The type is advisory and often absent (an anonymous fn); a missing one must leave no
  ;; hint entry at all rather than an empty one.
  (test "an expression the checker has no opinion about shows the value only"
    (let (note (liveeval/result-note {:ok true :value "#<fn>" :ms 0} "(fn (n) n)"))
      (assert= (:text note) "=> #<fn>")
      (assert= (:hint note) nil)))

  (test "what it printed rides along — the half a value alone loses"
    (is (includes? (:text (liveeval/result-note {:ok true :value "nil" :output "hi\n" :ms 0}))
          "(printed: hi)")))

  (test "how long it took, once that is worth knowing"
    (is (not (includes? (:text (liveeval/result-note {:ok true :value "1" :ms 5})) "ms)")))
    (is (includes? (:text (liveeval/result-note {:ok true :value "1" :ms 400})) "(400ms)")))

  ;; Concurrency has no return value to look at, so what it LEFT RUNNING is the report.
  (test "processes it left running"
    (is (includes? (:text (liveeval/result-note {:ok true :value "nil" :ms 0 :procs {:alive 1}}))
          "1 process still running"))
    (is (includes? (:text (liveeval/result-note {:ok true :value "nil" :ms 0 :procs {:alive 3}}))
          "3 processes still running")))

  (test "a raise is a fail, and marked as one that RAN rather than one that was wrong"
    (let (note (liveeval/result-note {:ok false :error "unbound symbol: nope"}))
      (assert= (:kind note) :fail)
      (assert= (:error? note) true)
      (is (includes? (:text note) "unbound symbol: nope"))))

  (test "a timeout says how to get the sandbox back"
    (is (includes? (:text (liveeval/result-note {:timeout true})) "C-c C-k")))

  (test "no error is no error-note"
    (assert= (liveeval/error-note {:ok true :value "1"}) nil)))

(describe "liveeval/spy-lines — the cascade"
  (test "a call opens a level and its return closes it"
    (assert= (liveeval/spy-lines [{:kind "call" :fn "fac" :args "(2)"}
                                   {:kind "call" :fn "fac" :args "(1)"}
                                   {:kind "return" :value "1"}
                                   {:kind "return" :value "2"}])
      (list "fac 2" "  fac 1" "  = 1" "= 2")))

  (test "an args list loses its wrapping parens — it reads better without them"
    (assert= (first (liveeval/spy-lines [{:kind "call" :fn "f" :args "(1 2)"}])) "f 1 2"))

  (test "nothing traced is no lines"
    (assert= (liveeval/spy-lines []) '()))

  (test "the cascade is one section of the report, indented under a line naming it"
    (let (lines (liveeval/report-lines {:ok true
                                        :value "1"
                                        :spy [{:kind "call" :fn "f" :args "(1)"}]}))
      (is (any? lines (fn (l) (includes? l "every traced call"))))
      (is (includes? lines "  f 1")))))

;; What the PANE says, as opposed to the one line beside the code. Everything here is a
;; section that a note structurally cannot carry: output as it was written, a value with room
;; to be read, the reason a trace is empty.
(describe "liveeval/report-lines — a whole reply, for a pane"
  (test "the value, with its derived type when the source is at hand"
    (assert= (first (liveeval/report-lines {:ok true :value "3" :ms 0} "(+ 1 2)")) "=> 3   : int")
    (assert= (first (liveeval/report-lines {:ok true :value "3" :ms 0})) "=> 3"))

  ;; The half `printed-note` mangles: it trims the output and puts it on one line, so three
  ;; printed lines arrive as one run-on and then get clipped by the pane width.
  (test "printed output arrives verbatim, line by line"
    (let (lines (liveeval/report-lines {:ok true :value "nil" :output "one\ntwo\nthree\n"}))
      (is (includes? lines "printed:"))
      (is (includes? lines "  one"))
      (is (includes? lines "  two"))
      (is (includes? lines "  three"))))

  (test "nothing printed, no printed section"
    (is (not (any? (liveeval/report-lines {:ok true :value "1" :output ""})
               (fn (l) (includes? l "printed"))))))

  ;; The pane stays quiet about the ordinary case: a fast evaluation that left nothing
  ;; behind has no cost worth a line.
  (test "cost is reported only when there is one"
    (assert= (liveeval/cost-lines {:ok true :ms 5}) '())
    (assert= (liveeval/cost-lines {:ok true :ms 400}) (list "400ms"))
    (assert= (liveeval/cost-lines {:ok true :ms 5 :procs {:alive 2}})
      (list "2 processes still running"))
    (assert= (liveeval/cost-lines {:ok true :ms 400 :procs {:alive 1}})
      (list "400ms · 1 process still running")))

  (test "a raise reports the error where the value would be, and nothing else pretends"
    (let (lines (liveeval/report-lines {:ok false :error "unbound symbol: nope"}))
      (is (includes? (first lines) "unbound symbol: nope"))))

  ;; "It traced nothing" and "nothing happened" are different facts, and the difference is
  ;; worth ONE dim line at the bottom. It began as a paragraph explaining the tracing policy,
  ;; which was right while it was the only thing the pane could say and a wall the moment
  ;; there was a value, an output and a cost above it.
  (test "an empty trace says so in one line, last"
    (let (lines (liveeval/report-lines {:ok true :value "6" :spy ()}))
      (assert= (first lines) "=> 6")
      (assert= (last lines) liveeval/*untraced-note*)
      (assert= (count (string/split liveeval/*untraced-note* "\n")) 1)))

  ;; A raise is the story; "nothing of yours ran" beside it is true and unhelpful.
  (test "a raise with no trace says nothing about the trace"
    (assert= (count (liveeval/report-lines {:ok false :error "boom" :spy ()})) 1)))

;; ---- the playground's own pieces -------------------------------------------------------

(describe "form-srcs — the buffer as top-level forms"
  (test "each top-level form, by index"
    (let (srcs (playground/form-srcs "(+ 1 2)\n(* 3 4)\n"))
      (assert= (count srcs) 2)
      (assert= (get srcs 0) "(+ 1 2)")
      (assert= (get srcs 1) "(* 3 4)")))

  ;; Error-tolerant by way of `sexp/top-level-forms`: the buffer is mid-typing most of the
  ;; time, and "which form is this" must still answer while it is.
  (test "answers over text that doesn't parse"
    (is (>= (count (playground/form-srcs "(+ 1 2)\n(* 3")) 1)))

  (test "answers over an empty buffer"
    (assert= (playground/form-srcs "") {})))

;; The anchoring `results` owns, exercised through the shape the playground hands it: an
;; answer goes BELOW its code (on the opening line it would read as a label on the paren),
;; a hint goes AT it.
(describe "results — which line derived text lands on"
  ;; Line arithmetic is asked of the ROPE (it indexes lines); the text is only for parsing.
  (defn rope-of (text) (buffer-rope (make-buffer text)))
  (defn answer-at (text n)
    ;; where form `n`'s answer goes, the way `playground/pg-set-note` asks for it
    (results/answer-line (rope-of text) (dec (:end (nth (sexp/top-level-forms text) n)))))

  (test "an answer goes on the blank line below its form"
    (assert= (answer-at "(defn f (n)\n  (* n 2))\n" 0) 2))

  (test "a hint anchors on the form's own opening line"
    (let (text "(+ 1 2)\n\n(defn f (n)\n  (* n 2))\n"
          nodes (sexp/top-level-forms text))
      (assert= (results/line-of (rope-of text) (:start (first nodes))) 0)
      (assert= (results/line-of (rope-of text) (:start (second nodes))) 2)))

  ;; The overlap this closes, and the reason the rule is "the line below IF BLANK" rather
  ;; than "the line below": forms written with no blank line between them — the normal way
  ;; to write — put one form's answer where the next form's own derived text already is.
  ;; `=> bar` and `=> 42` at the same cell come out as unreadable mush.
  (test "a form with another form directly below it keeps its answer on its own line"
    ;; the exact shape that showed the overlap: two forms, no blank line, no trailing newline
    (let (text "(defmodule bar)\n(bar/foo 1)")
      (assert= (answer-at text 0) 0)
      (assert= (answer-at text 1) 1))
    ;; …and the last form still drops onto the empty line a trailing newline opens
    (let (text "(defmodule bar)\n(bar/foo 1)\n")
      (assert= (answer-at text 0) 0)
      (assert= (answer-at text 1) 2)))

  ;; The crash this closes: a form ending at the very end of a buffer with no trailing
  ;; newline has no line below it, and an anchor past EOF is not merely invisible — a
  ;; renderer asks the rope for that line and the whole frame dies (`%rope-line: line 4 out
  ;; of bounds`, seen on `nest run` with the welcome text edited down to one form).
  (test "text with no line below its last form still anchors somewhere that EXISTS"
    (let (text ";; note\n\n(+ 1 1/2)")
      (assert= (results/line-count (rope-of text)) 3)
      (assert= (answer-at text 0) 2)))

  ;; Whatever the producer does, no two notes may end up drawn at one cell — so every
  ;; reader of the annotation has to see ALL of a line's notes, in a stable order.
  (test "a line's notes are all reported, hint first"
    (let (buf (results/set-note (results/set-note (make-buffer "(a)\n(b)\n")
                                  0
                                  {:kind :info :text "=> 1" :hint ": int"}
                                  1
                                  0)
                1
                {:kind :info :text "=> 2"}
                1))
      (assert= (map (results/notes-on-line buf 0) :text) (list ": int"))
      (assert= (map (results/notes-on-line buf 1) :text) (list "=> 1" "=> 2"))
      (assert= (results/note-lines buf) (list 0 1))
      ;; the echo row shows the whole line, not whichever note it happened to find first
      (assert= (results/eol-note-at buf 1) "=> 1  => 2")
      (assert= (results/eol-note-at buf 2) nil)))

  ;; The guarantee, at the renderer rather than at the producer: whatever anchors a second
  ;; note on a line, the two are LAID OUT, never stacked. Asserting on the columns is the
  ;; whole point — the bug drew both ops and looked like one note of garbled text.
  (test "two notes on one line are drawn side by side, not on top of each other"
    (let (buf (results/set-note (results/set-note (make-buffer "(a)\n")
                                  0
                                  {:kind :info :text "=> 1"}
                                  0)
                1
                {:kind :info :text "=> 2"}
                0)
          ops (view/ed-eol-note-ops buf 0 24 0 0 200 4 1 0)
          cols (map ops (fn (op) (nth op 2)))
          texts (map ops (fn (op) (nth op 3))))
      (assert= (count ops) 2)
      (assert= texts (list "=> 1" "=> 2"))
      ;; the second starts past the end of the first, with a gap
      (is (>= (second cols) (+ (first cols) (string/display-width "=> 1"))))))

  ;; The rope opens a final empty line for a trailing newline, and `buffer-line-count`
  ;; reports it — an anchor clamped against a different count is clamped to the wrong line.
  (test "lines are counted the way the rope counts them"
    (assert= (results/line-count (rope-of "a\nb")) (buffer-line-count (make-buffer "a\nb")))
    (assert= (results/line-count (rope-of "a\nb\n")) (buffer-line-count (make-buffer "a\nb\n")))
    (assert= (results/line-count (rope-of "")) (buffer-line-count (make-buffer "")))))

;; What the session has evaluated, as the launch records it: `{index -> {:src :deps}}`.
(defn evaluated (srcs) (into {} (map srcs (fn (kv) [(first kv) {:src (second kv)}]))))

(describe "results/set-note re-stamps idempotently"
  ;; A form at EOF joins its hint into the answer's line. Re-anchoring re-stamps the note
  ;; it reads back, hint still inside — which used to append `: int` once per keystroke.
  (test "a joined note re-stamped on the same line keeps one hint"
    (let (b0 (make-buffer "(+ 1 2)")
          b1 (results/set-note b0 0 {:kind :info :text "=> 3" :hint ": int"} 0 0)
          n1 (get (results/eol-notes-any b1) 0)
          b2 (results/set-note b1 0 (dissoc n1 :line) 0 0)
          b3 (results/set-note b2 0 (dissoc (get (results/eol-notes-any b2) 0) :line) 0 0))
      (assert= (:text n1) "=> 3  : int")
      (assert= (:text (get (results/eol-notes-any b3) 0)) "=> 3  : int")))

  (test "…and moved to two lines, the answer stands alone again"
    (let (b0 (make-buffer "(+ 1 2)\n")
          b1 (results/set-note b0 0 {:kind :info :text "=> 3" :hint ": int"} 0 0)
          b2 (results/set-note b1 0 (dissoc (get (results/eol-notes-any b1) 0) :line) 1 0))
      (assert= (:text (get (results/eol-notes-any b2) 0)) "=> 3")
      (assert= (:text (get (results/eol-notes-any b2) (results/hint-key 0))) ": int"))))

(describe "changed-forms — whose text moved"
  (test "nothing changed, nothing to send"
    (assert= (playground/changed-forms {0 "(a)" 1 "(b)"} (evaluated {0 "(a)" 1 "(b)"}) 2) '()))

  (test "the ones that differ, in order"
    (assert= (playground/changed-forms {0 "(z)" 1 "(c)"} (evaluated {0 "(a)" 1 "(b)"}) 2)
      (list 0 1))
    (assert= (playground/changed-forms {0 "(a)" 1 "(c)"} (evaluated {0 "(a)" 1 "(b)"}) 2) (list 1)))

  (test "a newly typed form is a change"
    (assert= (playground/changed-forms {0 "(a)" 1 "(b)"} (evaluated {0 "(a)"}) 2) (list 1))))

;; An index is not an identity: a record follows its text, so a form that merely moved down
;; a slot (you typed a form, or a line that split one, above it) is still evaluated.
(describe "realign-evaluated — a record follows its text"
  (test "nothing moved: the records stay where they are, nothing dropped"
    (let (r (playground/realign-evaluated {0 "(a)" 1 "(b)"} (evaluated {0 "(a)" 1 "(b)"}) 2))
      (assert= (:aligned r) (evaluated {0 "(a)" 1 "(b)"}))
      (assert= (:dropped r) '())))

  (test "a form inserted at the top shifts the records down with their forms"
    (let (r (playground/realign-evaluated {0 "(new)" 1 "(a)" 2 "(b)"}
              (evaluated {0 "(a)" 1 "(b)"})
              3))
      (assert= (:aligned r) (evaluated {1 "(a)" 2 "(b)"}))
      (assert= (:dropped r) '())))

  (test "a deleted form's record is dropped, the rest realign"
    (let (r (playground/realign-evaluated {0 "(b)"} (evaluated {0 "(a)" 1 "(b)"}) 1))
      (assert= (:aligned r) (evaluated {0 "(b)"}))
      (assert= (map (:dropped r) :src) (list "(a)"))
      ;; it stood above `(b)`, which is now form 0
      (assert= (map (:dropped r) :before) (list 0))))

  (test "a dropped record with nothing surviving below it stands at the end"
    (let (r (playground/realign-evaluated {0 "(a)"} (evaluated {0 "(a)" 1 "(b)"}) 1))
      (assert= (map (:dropped r) :before) (list 1))))

  (test "an edited form's old record is dropped, not handed to a later twin"
    ;; the first `(f 1)` was edited; the second is the same text it always was
    (let (r (playground/realign-evaluated {0 "(f 2)" 1 "(f 1)"} (evaluated {0 "(f 1)" 1 "(f 1)"}) 2))
      (assert= (:aligned r) (evaluated {1 "(f 1)"}))
      (assert= (count (:dropped r)) 1))))

;; What a launch re-sends. The rule this replaced was "everything from the first change
;; down", which is correct and expensive — editing the second of twenty forms re-evaluated
;; nineteen, every time typing settled. Most edits are to a CALL, and nothing below a call
;; can see it.
(describe "the launch plan — only what the edit could reach"
  ;; Drives the real path: `srcs`/`deps` derived from text the way a launch derives them, so
  ;; a change to how forms or deps are computed is caught here rather than in a fixture.
  ;; `before` is what the session has evaluated — the records a launch over it would have
  ;; left behind, sources and deps alike.
  (defn evaluated-of (text)
    (let (deps (playground/deps-of text))
      (into {}
        (map (playground/form-srcs text)
          (fn (kv) [(first kv) {:src (second kv) :deps (nth deps (first kv) {})}])))))
  ;; `launch-plan` takes the ALIGNMENT (its caller has one anyway), so a plan over a raw
  ;; record map aligns first — the one line the launch itself also writes.
  (defn plan (before after)
    (let (srcs (playground/form-srcs after)
          total (count (playground/forms-of after)))
      (playground/launch-plan srcs
        (playground/realign-evaluated srcs (evaluated-of before) total)
        (playground/deps-of after)
        total)))

  (test "nothing changed, nothing re-sent"
    (assert= (plan "(+ 1 2)\n(+ 3 4)\n" "(+ 1 2)\n(+ 3 4)\n") '()))

  ;; The complaint that motivated realignment: adding a line near the top re-evaluated the
  ;; whole buffer, because every form below it had moved down a slot.
  (test "a blank line added between forms re-sends nothing"
    (assert= (plan "(+ 1 2)\n(+ 3 4)\n" "(+ 1 2)\n\n\n(+ 3 4)\n") '()))

  (test "a form typed above the others re-sends that form alone"
    (assert= (plan "(defn f (n) n)\n(f 1)\n(+ 3 4)\n" "(+ 0 0)\n(defn f (n) n)\n(f 1)\n(+ 3 4)\n")
      (list 0)))

  (test "a form typed in the middle re-sends that form alone"
    (assert= (plan "(defn f (n) n)\n(f 1)\n(+ 3 4)\n" "(defn f (n) n)\n(+ 0 0)\n(f 1)\n(+ 3 4)\n")
      (list 1)))

  ;; …unless what it defines is used below it — then, as for any definition, its users too.
  (test "a definition typed above its users re-sends them as well"
    (assert= (plan "(g 1)\n(+ 3 4)\n" "(defn g (n) n)\n(g 1)\n(+ 3 4)\n") (list 0 1)))

  ;; The point of the whole exercise.
  (test "editing a form nothing uses re-sends that form alone"
    (assert= (plan "(defn f (n) n)\n(+ 1 2)\n(+ 3 4)\n" "(defn f (n) n)\n(+ 1 9)\n(+ 3 4)\n")
      (list 1)))

  (test "editing a definition re-sends its users, and only its users"
    (assert= (plan "(defn f (n) n)\n(f 1)\n(+ 3 4)\n" "(defn f (n) (inc n))\n(f 1)\n(+ 3 4)\n")
      (list 0 1)))

  ;; Transitively: g uses f, and h uses g, so editing f reaches h without naming it.
  (test "a dependency of a dependency is re-sent too"
    (assert= (plan "(defn f (n) n)\n(defn g (n) (f n))\n(g 1)\n(+ 5 6)\n"
               "(defn f (n) (inc n))\n(defn g (n) (f n))\n(g 1)\n(+ 5 6)\n")
      (list 0 1 2)))

  ;; Renaming would otherwise leave `(f 1)` sitting on a stale `=> 1` instead of the unbound
  ;; error it now deserves — which is why the OLD defines count as well as the new.
  (test "renaming a definition still reaches what called it by the old name"
    (is (includes? (plan "(defn f (n) n)\n(f 1)\n" "(defn ff (n) n)\n(f 1)\n") 1)))

  ;; Not an edge dependency analysis can see: the forms below name nothing that changed,
  ;; they just mean something different.
  (test "a namespace form takes the whole tail with it"
    (assert= (plan "(defmodule aa)\n(+ 1 2)\n(+ 3 4)\n" "(defmodule bb)\n(+ 1 2)\n(+ 3 4)\n")
      (list 0 1 2)))

  ;; Downward only — the model the buffer already documents.
  (test "a form above the edit is left alone even when it names the same thing"
    (assert= (plan "(f 1)\n(defn f (n) n)\n" "(f 1)\n(defn f (n) (inc n))\n") (list 1)))

  ;; A deleted form's index is past the end of the new buffer, so the walk never visits it —
  ;; and its users would keep showing the answer the definition it lost used to give.
  (test "deleting a definition still reaches what called it"
    (assert= (plan "(defn f (n) n)\n(f 1)\n" "(f 1)\n") (list 0)))

  ;; Realigned, `(+ 3 4)` keeps its record; `(f 1)` matches too, and would keep the answer the
  ;; definition it lost used to give — so a dropped record's defines reach its callers.
  (test "deleting a definition above unmoved callers still reaches them"
    (assert= (plan "(defn f (n) n)\n(+ 3 4)\n(f 1)\n" "(+ 3 4)\n(f 1)\n") (list 1)))

  ;; The safety valve: if the deps ever failed to line up with the forms one-for-one, the
  ;; indices would be off and this would re-run the WRONG forms, silently. Re-running too
  ;; much is the failure worth having.
  (test "deps that do not line up fall back to the old suffix rule"
    (assert= (playground/launch-plan {0 "(a)" 1 "(b)" 2 "(c)"}
               (playground/realign-evaluated {0 "(a)" 1 "(b)" 2 "(c)"}
                 (evaluated {0 "(a)" 1 "(z)" 2 "(c)"})
                 3)
               '()
               3)
      (list 1 2))))

(describe "the command"
  (test "M-x brood-playground opens *Playground*"
    (let (m (playground/cmd-brood-playground (m-of "x") :none))
      (is (not (nil? (model/ed-buffer-index-by-name m playground/*buffer-name*))))))

  ;; Reopening must not wipe what you were in the middle of.
  (test "reopening selects the existing buffer rather than clearing it"
    (let (m1 (pg-open "(my-work 1)")
          m2 (playground/cmd-brood-playground m1 :none)
          i (model/ed-buffer-index-by-name m2 playground/*buffer-name*))
      (is (includes? (buffer-text (nth (:buffers m2) i)) "my-work")))))

(describe "notes follow the text on the edit itself"
  ;; `results/eol-notes` hides every note the moment the line count changes; the launch
  ;; used to be what re-stamped them, a debounce later — so Enter blanked every result
  ;; for a quarter-second. Now the edit re-anchors them and the debounce only evaluates.
  ;; the real stamping path (`pg-set-note`), so the note is remembered as well as anchored —
  ;; a fixture that only wrote `:eol-notes` would be testing a buffer no launch can produce
  (defn with-note (m i note)
    (let (b (pg-buf-of m))
      (playground/pg-set-note m
        i
        note
        (playground/pg-placement (buffer-rope b) (buffer-text b) (:playground-spans b)))))

  (test "Enter at the end keeps every note visible, at its line"
    (let (m0 (with-note (pg-after-launch "(+ 1 2)") 0 {:kind :info :text "=> 3"})
          m1 (playground/ed-playground-reanchor (pg-type m0 7 "\n\n"))
          b (pg-buf-of m1))
      (is (not (nil? (results/eol-notes b)))) ; current, so the view shows them
      (assert= (:text (get (results/eol-notes b) 0)) "=> 3")
      (assert= (:line (get (results/eol-notes b) 0)) 1)))

  (test "a line typed above moves the note with its form"
    (let (m0 (with-note (pg-after-launch "(+ 1 2)") 0 {:kind :info :text "=> 3"})
          m1 (playground/ed-playground-reanchor (pg-type m0 0 "\n\n"))
          b (pg-buf-of m1))
      (assert= (:line (get (results/eol-notes b) 0)) 2)))

  (test "a note whose form was edited is dropped rather than left on a stranger"
    (let (m0 (with-note (pg-after-launch "(+ 1 2)") 0 {:kind :info :text "=> 3"})
          m1 (playground/ed-playground-reanchor (pg-type m0 5 "9"))
          b (pg-buf-of m1))
      (assert= (or (results/eol-notes b) {}) {})))

  ;; …dropped from the SCREEN, not forgotten. Typing a character and taking it back leaves
  ;; the buffer exactly as the last launch parsed it, so no launch runs to re-derive the
  ;; note — if the re-anchor had destroyed it, that form would show nothing until it was
  ;; edited again.
  (test "un-placing a note is not forgetting it: undo the edit and it comes back"
    (let (m0 (with-note (pg-after-launch "(+ 1 2)") 0 {:kind :info :text "=> 3"})
          m1 (playground/ed-playground-reanchor (pg-type m0 5 "9"))
          m2 (playground/ed-playground-reanchor (pg-undo m1))
          b (pg-buf-of m2))
      (assert= (:text (get (results/eol-notes b) 0)) "=> 3")))

  ;; The stuck-with-no-output bug. A reply stamps its note against the text of the moment it
  ;; lands; if the buffer then returns to what the launch parsed, a guard keyed on the launch
  ;; rope says "already anchored" while the notes describe a line count that is gone —
  ;; `eol-notes` answers nil, and `ed-playground-stale?` (the same comparison) arms nothing.
  (test "a reply that landed on a shifted buffer still shows once the edit is undone"
    (let (m0 (update (pg-after-launch "(+ 1 2)")
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          ;; Enter, before the reply came back…
          m1 (playground/ed-playground-reanchor (pg-type m0 7 "\n\n"))
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "3" :ms 0} 1)
          ;; …and backspaced away again: the buffer is exactly what the launch parsed
          m3 (playground/ed-playground-reanchor (pg-undo m2))
          b (pg-buf-of m3))
      (is (not (nil? (results/eol-notes b)))) ; renderable, not merely stored
      (is (includes? (:text (get (results/eol-notes b) 0)) "=> 3"))))

  (test "it runs from the post-event step, and is a no-op until the buffer moves"
    (let (m0 (with-note (pg-after-launch "(+ 1 2)") 0 {:kind :info :text "=> 3"})
          m1 (model/ed-post-step (retext m0 "(+ 1 2)\n\n") :none)
          m2 (model/ed-post-step m1 :none))
      (assert= (:line (get (results/eol-notes (pg-buf-of m1)) 0)) 1)
      (assert= (pg-buf-of m2) (pg-buf-of m1))))

  ;; The launch keys its notes by form index; a form typed above shifts the rest, and a
  ;; carried note must land on the form it describes, not on the slot it used to have.
  (test "a launch carries a note to the form that moved, not to its old slot"
    ;; (`pgt-same`, not `f`: the headless launch evaluates in THIS image, and a bare `f`
    ;; would stay bound for every later test — `brood-doc-at` answers differently on it)
    (let (m0 (playground/ed-playground-launch (pg-open "(defn pgt-same (n) n)\n(+ 1 2)\n"))
          m1 (playground/ed-playground-launch (retext m0
                                                "(+ 5 5)\n(defn pgt-same (n) n)\n(+ 1 2)\n"))
          notes (pg-notes m1))
      (is (includes? (:text (get notes 0)) "=> 10"))
      (is (includes? (:text (get notes 2)) "=> 3")))))

(describe "the notes that are not results"
  ;; The playground used to spell these itself, and spelled the KIND wrong: `:pending` is in
  ;; neither renderer's table, so `⋯ evaluating…` painted in the result colour with a `·` in
  ;; the margin — the "stale verdict looking current" its own docstring promises never to
  ;; show. Both features now take them from `liveeval`, and both renderers branch on
  ;; `results/note-pending?` rather than on a list of kinds each keeps its own copy of.
  (test "a half-typed form wears the pending voice, not a verdict"
    (let (m (playground/ed-playground-launch (pg-open "(+ 1 "))
          note (get (pg-notes m) 0))
      (is (results/note-pending? (:kind note)))
      (assert= (first (modes/mark-note-glyph note false)) "⋯")
      (is (:italic (view/ed-eol-note-face (:kind note) false)))))

  (test "a form no further typing can fix is a failure, and says so once"
    (let (m (playground/ed-playground-launch (pg-open ")"))
          note (get (pg-notes m) 0))
      (assert= (:kind note) :fail)
      (is (:error? note)) ; so a checker advisory does not repeat the error beside it
      (is (string/starts-with? (:text note) "✗ "))))

  (test "an in-flight form says so in the same voice"
    (is (results/note-pending? (:kind (liveeval/running-note))))))

(describe "the ready banner and what was already sent"
  ;; On open, the launch runs before the child has booted: its request QUEUES in the worker,
  ;; and the worker flushes the queue to the child that then readies. The reply is coming.
  (test "ready keeps the pending requests and forgets what was evaluated"
    (let (m0 (pg-after-launch "(+ 1 2)")
          i (model/ed-buffer-index-by-name m0 playground/*buffer-name*)
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          m2 (playground/playground-sandbox-ready (assoc m1
                                                    :buffers
                                                      (assoc (:buffers m1)
                                                        i
                                                          (assoc (nth (:buffers m1) i)
                                                            :playground-evaluated
                                                              {0 {:src "(+ 1 2)"}})))
               1))
      (assert= (get-in m2 [:playground :pending]) {7 {:region 0 :src "(+ 1 2)"}})
      (assert= (:playground-evaluated (pg-buf-of m2)) {})
      ;; the reply that follows lands as usual
      (let (m3 (playground/playground-sandbox-reply m2 {:id 7 :ok true :value "3" :ms 0} 1))
        (is (includes? (:text (get (pg-notes m3) 0)) "=> 3"))
        (assert= (get-in (pg-buf-of m3) [:playground-evaluated 0 :src]) "(+ 1 2)"))))

  ;; …and the launch the banner provokes (it drops `:playground-rope`) must not send the
  ;; same form a second time while the first request is still in flight.
  (test "a launch does not re-send a form whose identical request is in flight"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          m2 (playground/playground-sandbox-ready m1 1)
          m3 (playground/ed-playground-launch m2))
      (assert= (keys (get-in m3 [:playground :pending])) (list 7)))))

(describe "sandbox replies land as notes"
  ;; The fan-out router hands every client every reply, so ignoring what isn't yours is not
  ;; an optimisation — it is what makes routing without an owner tag correct.
  (test "a reply the playground never sent is ignored"
    (let (m (pg-open "(+ 1 2)"))
      (assert= (playground/playground-sandbox-reply m {:id 999 :ok true :value "3"} nil) m)))

  (test "a reply for a live request becomes the form's note"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "3" :ms 0} 1))
      (is (includes? (:text (get (pg-notes m2) 0)) "=> 3"))))

  ;; A superseded child's straggler carries an answer computed in a session that no longer
  ;; exists. Showing it would be showing a confident value for code that never ran here.
  (test "a reply from a superseded child is dropped"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 2 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "3"} 1))
      (assert= (pg-notes m2) {})
      ;; …and unpended: nothing further is coming for it, so the next launch must be free
      ;; to re-send the form rather than treat it as still in flight
      (assert= (get-in m2 [:playground :pending]) {})))

  ;; Two entries, two lines: the answer where the form ends, the derived type where it
  ;; begins. Nothing is inserted into the buffer to make room for either — a hint that
  ;; appeared on a line of its own would push every line below it down each time the
  ;; checker changed its mind, which is text jumping under the cursor.
  (test "the type hint lands AT the form and the answer under it"
    (let (m0 (pg-after-launch "(defn pgt-len (s)\n  (string/length s))\n")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1
                :pending {7 {:region 0 :src "(defn pgt-len (s)\n  (string/length s))"}}})
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "pgt-len" :ms 0} 1)
          notes (pg-notes m2))
      (assert= (:text (get notes 0)) "=> pgt-len")
      (assert= (:line (get notes 0)) 2)
      (assert= (:text (get notes (results/hint-key 0))) "pgt-len : (string -> int)")
      (assert= (:line (get notes (results/hint-key 0))) 0)
      ;; a hint is not a verdict — the gutter leaves the code line alone
      (assert= (:kind (get notes (results/hint-key 0))) :hint)))

  ;; The one case that cannot have the two-line layout: a single-line form at the very end
  ;; of the buffer has its answer clamped back onto its own line, which is where the hint
  ;; would go. Two ghost texts at one line's end overpaint, so there they rejoin.
  (test "a form with nowhere below it keeps hint and answer on one line"
    (let (m0 (pg-after-launch "(+ 1 1/2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 1/2)"}}})
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "3/2" :ms 0} 1)
          notes (pg-notes m2))
      (assert= (:text (get notes 0)) "=> 3/2  : ratio")
      (assert= (:line (get notes 0)) 0)
      (assert= (get notes (results/hint-key 0)) nil)))

  ;; A line typed above the form while its reply was in flight moved it down a slot; the
  ;; reply still belongs to it, and finds it by its text.
  (test "a reply for a form that moved since the send lands on the moved form"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
          m2 (retext m1 "(+ 5 5)\n(+ 1 2)")
          m3 (playground/playground-sandbox-reply m2 {:id 7 :ok true :value "3" :ms 0} 1)
          notes (pg-notes m3))
      ;; keyed by the REQUEST (region 0), anchored on the line the form moved to
      (is (includes? (:text (get notes 0)) "=> 3"))
      (assert= (:line (get notes 0)) 1)
      (assert= (get-in (pg-buf-of m3) [:playground-evaluated 1 :src]) "(+ 1 2)")))

  ;; …and the key is the request's for a reason. Under the form's NEW index the answer landed
  ;; on whatever key the launch had given the form now standing there — those two differ
  ;; exactly when the forms have shifted, so the slot this one moved into is somebody else's.
  ;; The visible half: the launch's own `⋯ evaluating…` sat at the old key on the same line,
  ;; and `results/notes-on-line` paints every note a line carries — so the running indicator
  ;; stayed on screen beside the result it had just produced.
  (test "the result REPLACES the running indicator, rather than joining it"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (with-note (update m0
                          :playground merge
                          {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 2)"}}})
               0
               (liveeval/running-note))
          ;; the keystroke re-anchors the indicator onto the line the form moved to…
          m2 (playground/ed-playground-reanchor (retext m1 "(+ 5 5)\n(+ 1 2)"))
          ;; …and the reply must land on that same note, not beside it
          m3 (playground/playground-sandbox-reply m2 {:id 7 :ok true :value "3" :ms 0} 1)
          on-line-1 (map (filter (pg-notes m3) (fn (kv) (= (:line (second kv)) 1))) second))
      (assert= (count on-line-1) 1)
      (is (includes? (:text (first on-line-1)) "=> 3"))))

  (test "a reply whose form has been edited since the send is dropped"
    (let (m0 (pg-after-launch "(+ 1 2)")
          m1 (update m0
               :playground merge
               {:sandbox-gen 1 :pending {7 {:region 0 :src "(+ 1 3)"}}})
          m2 (playground/playground-sandbox-reply m1 {:id 7 :ok true :value "3"} 1))
      (assert= (pg-notes m2) {}))))

(describe "the spy pane"
  ;; The bug this pins: every ingredient of the pane worked — the cascade cached, the body
  ;; rendered, the layer registered — and nothing ever put it on screen, because both
  ;; refresh call sites were gated on it being open already. Assert the OUTCOME.
  (test "opening the playground opens the pane beside it"
    (is (playground/spy-on-screen? (playground/cmd-brood-playground (m-of "x") :none))))

  (test "a form that hasn't run says so, rather than showing an empty pane"
    (is (includes? (workings/body playground/*spy-spec* (m-of "") 0) "has not run yet")))

  ;; ":none" and "no entry" must not look alike: one means the form ran and called nothing
  ;; traceable, the other means it never ran. A pane that conflated them would report a
  ;; working session as a broken one.
  (test "a form that ran and traced nothing still shows what it answered"
    (let (m (assoc-in (m-of "")
              [:playground :workings 0]
              {:traced? false :body "=> 6\n\nnothing of yours ran"}))
      (is (includes? (workings/body playground/*spy-spec* m 0) "=> 6"))
      (is (includes? (workings/body playground/*spy-spec* m 0) "nothing of yours ran"))
      ;; …but it is still not worth halving the page for on its own
      (assert= (workings/cascade playground/*spy-spec* m 0) nil)))

  ;; What the cursor is POINTING at, above what the form DID — two answers to two questions
  ;; on two different clocks (per keystroke, per reply) in one pane.
  (test "the docs of the symbol at point sit above the report, behind a rule"
    (let (m (workings/at-point playground/*spy-spec*
              (assoc-in (m-of "") [:playground :workings 0] {:traced? true :body "=> 6"})
              (list "(map coll f)" "" "A list of `(f x)` for each `x` in `coll`."))
          text (workings/body playground/*spy-spec* m 0))
      (is (string/starts-with? text "(map coll f)"))
      (is (includes? text workings/*rule*))
      ;; …and the report is still under it
      (is (< (index-of text workings/*rule*) (index-of text "=> 6")))))

  (test "nothing under the cursor, no rule and no gap"
    (let (m (assoc-in (m-of "") [:playground :workings 0] {:traced? true :body "=> 6"}))
      (is (not (includes? (workings/body playground/*spy-spec* m 0) workings/*rule*)))))

  ;; The service, through the mode — a cursor anywhere in a call documents its head, so the
  ;; pane is never a dead spot wherever you happen to have stopped.
  (test "the doc block is the symbol at point, else the call around it"
    (let (head (fn (p) (first (or (modes/brood-doc-at "(map [1 2 3] f)" p) '(nil)))))
      (assert= (head 2) "(map coll f)") ; on `map`
      (assert= (head 6) "(map coll f)") ; on `f`, which is not bound — the call answers
      (assert= (head 10) "(map coll f)"))) ; inside the vector — one level out
  (test "a cached report is the body, under a heading naming the form"
    (let (m (assoc-in (m-of "")
              [:playground :workings 0]
              {:traced? true :body "=> 6\n\n  fac 3\n  = 6"}))
      (assert= (workings/body playground/*spy-spec* m 0)
        "What ran — form 1:\n\n=> 6\n\n  fac 3\n  = 6")
      (assert= (workings/cascade playground/*spy-spec* m 0) "=> 6\n\n  fac 3\n  = 6")))

  ;; Closing it is a choice; a later result must not undo it.
  (test "a dismissed pane stays dismissed, and M-x playground-spy is the way back"
    (let (opened (playground/cmd-brood-playground (m-of "x") :none)
          closed (assoc-in opened [:playground :workings-closed?] true)
          after (workings/refresh playground/*spy-spec* closed 0 true))
      (is (not (playground/spy-on-screen? (dissoc after :buffers))))
      (is (playground/spy-on-screen? (playground/cmd-brood-playground closed :none))))))

;; The two outcome-level tests. The originals asserted on the PIECES — `spy-body` renders,
;; `refresh-spy` returns a model — and passed while the pane never opened once and a deleted
;; form's result sat on screen forever. A test that never asks "and then what does the user
;; see?" can be fully green over a feature that does not work.
(describe "what the user actually ends up looking at"
  ;; #1: every ingredient of the pane worked; nothing put it on screen.
  (test "the pane is on screen after opening the playground, and follows the cursor"
    (let (m (playground/cmd-brood-playground (m-of "x") :none))
      (is (playground/spy-on-screen? m))
      (assert= (get-in m [:playground :workings-region]) 0)))

  ;; The pane follows the cursor WITHOUT parsing the buffer: the extents the last launch
  ;; cached answer "which form is this?" with a scan, and they are exact exactly while the
  ;; rope is still the text that launch parsed. The parse this replaced cost 345µs on a
  ;; 40-form buffer and ran on every keystroke.
  (test "the pane follows the cursor from form to form, off the launch's cached extents"
    (let (launched (playground/ed-playground-launch (pg-open "(+ 1 2)\n\n(* 3 4)\n"))
          at (fn (m p)
               (get-in (playground/playground-post-key m (pg-goto m p) "x")
                 [:playground :workings-region])))
      ;; point 2 is inside `(+ 1 2)`, point 11 inside `(* 3 4)`
      (assert= (at launched 2) 0)
      (assert= (at launched 11) 1)))

  ;; While the text has moved on the extents describe text that no longer exists, so the pane
  ;; HOLDS rather than guessing — typing inside a form does not change which form you are in,
  ;; and the debounce re-parses and corrects any boundary case ~150ms later.
  (test "mid-edit the pane holds its form rather than guessing from stale extents"
    (let (launched (playground/ed-playground-launch (pg-open "(+ 1 2)\n\n(* 3 4)\n"))
          moved (playground/playground-post-key launched (pg-goto launched 11) "x")
          edited (retext moved "(+ 1 2 3)\n\n(* 3 4)\n")
          after (playground/playground-post-key edited edited "x"))
      (assert= (get-in moved [:playground :workings-region]) 1)
      (assert= (get-in after [:playground :workings-region]) 1)))

  ;; #2: notes were patched into the existing map, so a form's result outlived the form.
  ;; `filter int?` because a form now owns TWO entries — its answer, keyed by index, and its
  ;; type hint, keyed by `hint-key` — and the hint is asserted separately below rather than
  ;; conflated into the count, which is what would let one of the two linger unnoticed.
  (test "deleting a form takes its result — and its type hint — with it"
    (let (m1 (playground/ed-playground-launch (pg-open "(+ 1 2)\n(* 3 4)\n"))
          m2 (playground/ed-playground-launch (retext m1 "(+ 1 2)\n")))
      (assert= (sort (filter (map (pg-notes m1) first) int?)) '(0 1))
      (assert= (sort (filter (map (pg-notes m2) first) int?)) '(0))
      (is (not (nil? (get (pg-notes m1) (results/hint-key 1)))))
      (assert= (get (pg-notes m2) (results/hint-key 1)) nil)))

  (test "editing a form replaces its result rather than leaving the old one beside it"
    (let (m1 (playground/ed-playground-launch (pg-open "(+ 1 2)\n"))
          m2 (playground/ed-playground-launch (retext m1 "(+ 10 20)\n")))
      (assert= (count (filter (map (pg-notes m2) first) int?)) 1)
      (is (includes? (:text (get (pg-notes m2) 0)) "=> 30"))))

  ;; A headless open must not start a child runtime — nothing could deliver its replies.
  (test "opening the playground headless starts no sandbox"
    (do
      (playground/cmd-brood-playground (m-of "x") :none)
      (assert= (proc/whereis :sandbox) nil))))

;; ---- the router ------------------------------------------------------------------------

(describe "sandbox-events — one sandbox, several clients"
  ;; The reason this module exists: `impl` is per record type, so the three sandbox events
  ;; can have exactly one fold between them, and it cannot belong to any single client.
  (test "both clients are registered"
    (let (names (map sandbox-events/*clients* (fn (c) (->string (get c :reply)))))
      (is (any? names (fn (n) (includes? n "tutor"))))
      (is (any? names (fn (n) (includes? n "playground"))))))

  (test "fanning out threads the model through every client and returns it"
    (let (m (m-of "x"))
      (is (map? (sandbox-events/fan-out m :reply (list {:id 999 :ok true} nil))))))

  ;; With neither buffer open nobody wants a sandbox, and the child is let go for good —
  ;; the decision that used to be "is the tutorial open?" and could not stay that way.
  (test "no client buffer open means nobody wants a sandbox"
    (is (not (sandbox-events/any-client-live? (m-of "x")))))

  (test "an open playground keeps it alive"
    (is (sandbox-events/any-client-live? (pg-open "(+ 1 2)")))))

(describe "the checker's warnings ride the line as ⚠ notes"
  ;; `(< number)` typed `: bool` and answered `=> true` while the checker knew the argument
  ;; could not be ordered — the warning sat in the gutter, easy to miss beside the live
  ;; buffer's own marks. It is painted as a note on the line now, and ONLY for the rope the
  ;; check was run on, so it can never drift onto a line the text moved out from under.
  (test "a diagnostic on the checked rope is a ⚠ note beside the line's other notes"
    (let (buf (results/set-note (make-buffer "(< number)\n") 0 {:kind :info :text "=> true"} 0)
          m {:diagnostics (list {:line 1 :col 1 :message "<: argument 1 expects ordered, got list"})
             :diag-rope (buffer-rope buf)}
          ops (view/ed-eol-note-ops buf 0 24 0 0 400 4 1 0 (view/ed-diag-notes m buf))
          texts (map ops (fn (op) (nth op 3))))
      (is (any? texts (fn (t) (= t "=> true"))))
      (is (any? texts (fn (t) (string/starts-with? t "⚠ <: argument 1"))))))
  (test "a diagnostic computed for another rope is not painted"
    (let (buf (make-buffer "(< number)\n")
          other (make-buffer "(< other)\n")
          m {:diagnostics (list {:line 1 :col 1 :message "x"}) :diag-rope (buffer-rope other)})
      (assert= (view/ed-diag-notes m buf) {}))))
