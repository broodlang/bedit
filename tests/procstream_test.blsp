;; Tests for src/procstream.blsp — the shared streaming-subprocess worker. Pure
;; line-buffering + a real end-to-end run of a trivial `nest run` child.
(defmodule procstream-test
  (:use test)
  (:use-internals procstream))
;; A run as the worker holds it: handlers that BUILD events, delivered to `reply`.
(defn- run-to (reply on-line on-err)
  {:handlers {:on-line on-line :on-err-line on-err :on-done (fn (code tok) [:done code tok])}
   :token :g1
   :reply reply})

(defn- feed-all (run deliver chunks)
  "The stream state after `chunks` are fed, in order, from a fresh stream."
  (fold chunks
    (procstream/procstream-stream)
    (fn (stream chunk) (procstream/procstream-feed run stream chunk deliver))))

(defn- received-lines ()
  "Every `[:line text spans tok]` event already in the mailbox, in order."
  (letrec (go (fn (acc)
                (receive
                  ([:line l s t] (go (conj acc [l s t])))
                  (after 0 acc))))
    (go [])))

(describe "procstream — line buffering (pure)"
  (test "complete lines are delivered; the trailing partial is kept, token threaded"
    (let (run (run-to (self) (fn (line spans tok) [:line line spans tok]) (fn (_l _s _t) nil))
          stream (feed-all run procstream/procstream-out-line ["a\nb\nc"]))
      (assert= ["c" []] (:partial stream)) ; the partial carries over
      (assert= [["a" [] :g1] ["b" [] :g1]] (received-lines))))
  (test "a handler that builds nothing delivers nothing"
    (let (run (run-to (self) (fn (_line _spans _tok) nil) (fn (_l _s _t) nil)))
      (feed-all run procstream/procstream-out-line ["quiet\n"])
      (is (nil? (receive (anything anything) (after 100 nil))))))
  (test "a handler throw is caught and routed to on-err, not fatal"
    (let (run (run-to (self)
                (fn (_line _spans _tok) (throw "boom"))
                (fn (line _spans _tok) [:err line])))
      (feed-all run procstream/procstream-out-line ["x\n"])
      (is (includes? (receive ([:err l] l) (after 500 :timeout)) "boom"))))
  (test "stderr rides the same splitter, its blank lines dropped"
    (let (run (run-to (self) (fn (_line _spans _tok) nil) (fn (line _spans _tok) [:err line]))
          stream (feed-all run procstream/procstream-err-line ["tra" "ce\n\n  \nnext"]))
      (assert= ["next" []] (:partial stream))
      (assert= "trace" (receive ([:err l] l) (after 500 :timeout)))
      (is (nil? (receive (anything anything) (after 100 nil)))))))

(describe "procstream — ANSI escapes split across reads (issue #24)"
  (test "a line arrives with no escape in it, its colours beside it"
    (let (run (run-to (self) (fn (line spans tok) [:line line spans tok]) (fn (_l _s _t) nil)))
      (feed-all run procstream/procstream-out-line ["\e[1" "mERROR\e[0m done\n"])
      (assert= [["ERROR done" [[0 5 {:bold true}]] :g1]] (received-lines))))
  (test "every cut of a coloured stream delivers the same lines and colours"
    (let (stream-text "\e[32mok\e[0m one\r\n\e[31mred\nstill red\e[0m\n\e]0;title\x07plain\n"
          n (count stream-text)
          run (run-to (self) (fn (line spans tok) [:line line spans tok]) (fn (_l _s _t) nil))
          expected (do
                     (feed-all run procstream/procstream-out-line [stream-text])
                     (received-lines)))
      (assert= (into [] (map expected first)) ["ok one" "red" "still red" "plain"])
      (assert= (second (nth expected 2)) [[0 9 {:fg 1}]]) ; the colour carried over a line
      (doseq (i (range 1 n))
        (feed-all run
          procstream/procstream-out-line
          [(string/substring stream-text 0 i) (string/substring stream-text i n)])
        (assert= [i (received-lines)] [i expected]))))
  (test "the partial line keeps its colours for the line it completes"
    (let (run (run-to (self) (fn (line spans tok) [:line line spans tok]) (fn (_l _s _t) nil)))
      (feed-all run procstream/procstream-out-line ["ab\e[4mcd" "ef\e[0m\n"])
      (assert= [["abcdef" [[2 6 {:underline true}]] :g1]] (received-lines)))))

(describe "procstream — end to end (a real nest run child)"
  :isolated (test "stdout lines and the exit code reach the run's reply address, tagged with its token"
    (let (script "/tmp/bedit-procstream-probe.blsp")
      (file/spit script "(io/puts \"line-one\")\n(io/puts \"line-two\")\n")
      (let (handlers {:on-line (fn (line _spans tok) [:line line tok])
                      :on-err-line (fn (_line _spans _tok) nil)
                      :on-done (fn (code tok) [:done code tok])}
            w (spawn (procstream/procstream-loop handlers)))
        ;; the address is per RUN: the worker is shared, the loop that asked is not
        (send w [:run "nest" ["run" script] {:cwd "/tmp"} :run7 (self)])
        (let (l1 (receive ([:line l t] [l t]) (after 30000 :timeout))
              l2 (receive ([:line l t] [l t]) (after 30000 :timeout))
              d (receive ([:done c t] [c t]) (after 30000 :timeout)))
          (assert= ["line-one" :run7] l1)
          (assert= ["line-two" :run7] l2)
          (assert= [0 :run7] d))
        (send w [:shutdown])))))

(describe "procstream — one worker, many loops"
  ;; the worker is a named singleton every frame shares: a run started from a second frame
  ;; must answer THAT frame, not whichever one happened to start the worker
  :isolated (test "each run's events go to the address that run was started with"
    (let (me (self)
          script "/tmp/bedit-procstream-route.blsp"
          ;; stands in for another frame's loop: tags what it receives, hands it on
          other-loop (spawn (letrec (relay (fn ()
                                             (receive (msg (do (send me [:other msg]) (relay))))))
                              (relay)))
          handlers {:on-line (fn (_line _spans _tok) nil)
                    :on-err-line (fn (_line _spans _tok) nil)
                    :on-done (fn (_code tok) [:done tok])}
          w (spawn (procstream/procstream-loop handlers)))
      (file/spit script "(io/puts \"x\")\n")
      (send w [:run "nest" ["run" script] {:cwd "/tmp"} :first other-loop])
      (assert= [:other [:done :first]] (receive ([:other msg] [:other msg]) (after 30000 :timeout)))
      (send w [:run "nest" ["run" script] {:cwd "/tmp"} :second me])
      (assert= [:done :second] (receive ([:done t] [:done t]) (after 30000 :timeout)))
      (send w [:shutdown]))))
