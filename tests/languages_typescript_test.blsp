;; TypeScript (src/languages/typescript.blsp): JavaScript's spec over tree-sitter-typescript.
(defmodule languages-typescript-test
  (:use test)
  (:use model)
  (:use testkit :only [cur file-model]))

(describe "typescript, the mode"
  (test "typescript formats with prettier"
    (let (buf (cur (file-model "" "app.ts")))
      (assert= (first (model/ed-mode-service buf :format-command)) "prettier")))
  (test "TypeScript claims no #! name"
    (assert= (get languages/typescript/typescript-spec :interpreters) [])))
