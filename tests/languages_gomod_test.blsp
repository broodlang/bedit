;; go.mod (src/languages/gomod.blsp): a `deflanguage` over camdencheek/tree-sitter-go-mod.
;; Its parsed sample is the corpus's, tests/corpus/gomod/; what is here needs no grammar.
(defmodule languages-gomod-test
  (:use test)
  (:use model)
  (:use testkit :only [file-buffer]))

(describe "go.mod, the mode"
  (test "go.mod's pattern does not take a `.mod` file"
    (is (not (= (ed-buf-mode-name (file-buffer "" "/p/x.mod")) "gomod"))))
  (test "it parses with tree-sitter-go-mod, which says where it lives"
    (assert= (ed-mode-service (file-buffer "" "/p/go.mod") :ts-lang) :gomod)
    (assert= (:url (model/grammar-source :gomod))
      "https://github.com/camdencheek/tree-sitter-go-mod"))
  (test "it comments with //"
    (assert= (ed-mode-service (file-buffer "" "/p/go.mod") :comment-syntax) "// "))
  (test "go.mod indents with tabs, as `go mod tidy` writes it"
    (is (ed-mode-service (file-buffer "" "/p/go.mod") :indent-tabs)))
  (test "it formats with go mod edit"
    (assert= (ed-mode-service (file-buffer "" "/p/go.mod") :format-command)
      ["go" "mod" "edit" "-fmt"])))
;; The sample, tests/corpus/gomod/go.mod (`go mod edit -fmt`), is checked by
;; tests/language_corpus_test.blsp: its mode, colours, indentation and restart.
