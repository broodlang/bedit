;; The project REPL (`C-x p r`): a long-lived interpreter hosted in a terminal buffer in
;; LINE mode — `src/term.blsp`, with bshell's history and boundary commands over the
;; same `:input-start` field.
;;
;; This is the one bedit feature that could not exist before `os/spawn-pty`. On a pipe
;; an interpreter asks `isatty`, is told no, and drops its prompt, its line editing and
;; its unbuffered output — so the tests that matter are the ones that drive a REAL
;; interpreter and watch it answer, not ones that assert the shape of a spawn call.

(defmodule repl-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use commands)
  (:use-internals term)
  (:use-internals bshell)
  (:use-internals input)
  (:use toolchain))

(describe "the REPL runs the toolchain's command, not a hardcoded one"
  (test "each project type names its own"
    (assert= (repl-command {:project-root "/tmp"}) nil) ; nothing there to recognise
    ;; This project — a Brood one, so `nest repl`. It named an absolute path on the
    ;; author's machine, which passes there and nowhere else: CI checks the repo out
    ;; somewhere quite different, `detect` recognised nothing, and the assertion failed
    ;; for a reason that had nothing to do with the toolchain lookup it is testing.
    (is (includes? (str (get (detect (file/cwd)) :repl)) "nest repl")))
  (test "a project with no REPL is told so rather than given someone else's"
    (let (m (ed-init (make-buffer "" "x" "x"))
          m1 (assoc m :project-root "/tmp"))
      ;; no toolchain recognised at /tmp, so no REPL command
      (is (nil? (repl-command m1))))))

;; ---- line mode over a synthetic screen ---------------------------------------------
;; The REPL buffer is a term buffer in line mode: the program's screen up to its cursor,
;; then bedit's input region. These fold screens the way the worker sends them.

(def repl-name (term/term-buffer-name "repl" "/tmp"))

(defn repl-model ()
  "A model whose current buffer is a /tmp REPL in line mode, as `cmd-project-repl` makes
it — no worker."
  (let (buf (assoc (editor/layers/set-buffer-type (make-buffer "" repl-name) :term)
              :dir "/tmp"
              :term-proc nil
              :term-size [80 24]
              :term-hstart 0
              :term-hspans []
              :face-spans []
              :term-line-mode true
              :term-label "repl"
              :input-start 0
              :bshell-history []
              :bshell-hist-idx nil
              :bshell-draft nil))
    (ed-open-buffer (ed-init (make-buffer "")) buf)))

(defn screen (text cursor)
  {:text text :spans [] :cursor cursor :cursor-visible true :cursor-style :block})

(defn fold-screen (m scr)
  (term/ed-ev-term-screen m (term/term-screen-event repl-name [] scr) 24 80 24))

(defn repl-buf (m) (ed-buf-at m (ed-buffer-index-by-name! m repl-name)))
(defn repl-text (m) (buffer-text (repl-buf m)))
(defn repl-point (m) (buffer-point (ed-current-buf m)))
(defn type-keys (m keys) (fold keys m (fn (mm k) (ed-update mm k 80 24))))

(describe "line mode: the buffer is the program's screen up to its cursor, then yours"
  (test "the screen's blank rows below the prompt are not shown; input begins at the prompt"
    (let (m (fold-screen (repl-model) (screen "iex(1)> \n\n\n" 8)))
      (assert= (repl-text m) "iex(1)> ")
      (assert= (:input-start (repl-buf m)) 8)
      (assert= (repl-point m) 8)))
  (test "typing goes into the buffer, not to the program, and RET sends it whole"
    (let (m0 (ed-set-buf (fold-screen (repl-model) (screen "iex(1)> " 8))
               (assoc (ed-current-buf (fold-screen (repl-model) (screen "iex(1)> " 8))) :term-proc (self)))
          typed (type-keys m0 (list "1" " " "+" " " "1"))
          sent (ed-update typed :enter 80 24))
      (assert= (repl-text typed) "iex(1)> 1 + 1")
      (receive ([:term-line line] (assert= line "1 + 1")) (after 500 (is (= :sent "RET sent nothing"))))
      ;; the region is cleared — the program's echo will replace it
      (assert= (repl-text sent) "iex(1)> ")
      (is (includes? (:bshell-history (repl-buf sent)) "1 + 1"))))
  (test "a redraw while typing keeps what was typed, after the new prompt"
    (let (m0 (fold-screen (repl-model) (screen "iex(1)> " 8))
          typed (type-keys m0 (list "a" "b"))
          redrawn (fold-screen typed (screen "iex(1)> \nlog line\niex(1)> " 26)))
      (assert= (repl-text redrawn) "iex(1)> \nlog line\niex(1)> ab")
      (assert= (:input-start (repl-buf redrawn)) 26)
      (assert= (repl-point redrawn) 28)))
  (test "the boundary holds: backspace and C-a stop at the prompt"
    (let (m0 (fold-screen (repl-model) (screen "iex(1)> " 8))
          typed (type-keys m0 (list "x"))
          m1 (type-keys typed (list :backspace :backspace :backspace)))
      (assert= (repl-text m1) "iex(1)> ")
      (assert= (repl-point (type-keys (type-keys m1 (list "y" "z")) (list :ctrl-a))) 8)))
  (test "↑ recalls history into the input"
    (let (m0 (ed-set-buf (fold-screen (repl-model) (screen "> " 2))
               (assoc (ed-current-buf (fold-screen (repl-model) (screen "> " 2))) :bshell-history ["first" "second"]))
          m (type-keys m0 (list :up)))
      (assert= (repl-text m) "> second")))
  (test "the keys are the editor's in line mode: the term overlay stands aside"
    (let (m (fold-screen (repl-model) (screen "> " 2))
          o (seq/find input/ed-transient-handlers (fn (o) (= (:__id__ o) :bedit/input/term-overlay))))
      (is (not (editor/ui/overlay-active? o m))))))

(describe "switching modes"
  (test "C-c C-k hands the keys to the program; C-c C-j takes them back"
    (let (m0 (fold-screen (repl-model) (screen "> " 2))
          char (type-keys m0 (list :ctrl-c :ctrl-k))
          o (seq/find input/ed-transient-handlers (fn (o) (= (:__id__ o) :bedit/input/term-overlay))))
      (is (not (:term-line-mode (repl-buf char))))
      (is (editor/ui/overlay-active? o char))
      (is (read-only? (repl-buf char)))
      ;; from char mode, C-c belongs to the program: C-x c is the way to its map
      (let (line (type-keys char (list :ctrl-x "c" :ctrl-j)))
        (is (:term-line-mode (repl-buf line)))
        (assert= (:input-start (repl-buf line)) 2))))
  (test "the mode line chip names the program and the mode"
    (let (m (fold-screen (repl-model) (screen "> " 2)))
      (assert= (term/term-modeline m (repl-buf m)) "● repl · line")
      (assert= (term/term-modeline m (assoc (repl-buf m) :term-exited true)) "○ exited"))))

;; ---- a real interpreter -------------------------------------------------------------
;; `sh -i` stands in for `iex`/`nest repl`: it is an interpreter, it prompts, and it is
;; present on every machine this suite runs on. What is being tested is the hosting —
;; that a line typed in the buffer reaches the child and its answer comes back — and
;; that is identical whichever interpreter it is.

(defn rt-await-screen (want deadline)
  (receive
    (msg
      (let (text (check-allow :discarded-catch
                   (try (:text (term/term-screen-event-screen msg)) (catch _ nil))))
        (if (and text (includes? text want)) msg (rt-await-screen want deadline))))
    (after deadline nil)))

(defn rt-as-editor (f)
  (let (previous (proc/whereis :editor))
    (proc/register :editor (self))
    (let (out (f))
      (when previous (proc/register :editor previous))
      out)))

(defn rt-has-vt? ()
  (check-allow :discarded-catch (try (do (vt/make 1 1) true) (catch _ false))))

(describe "a hosted interpreter answers what the buffer sends it"
  :isolated (test "the session is LONG-LIVED: a variable set by one line survives into the next"
    (if (not (rt-has-vt?))
      (io/puts "  (skipped: this nest has no std/vt)")
      (rt-as-editor
        (fn ()
          (let (pid (term/term-connect repl-name "/tmp" "PS1='> ' sh -i" 60 8)
                prompt (rt-await-screen "> " 8000))
            (do
              (is (not (nil? prompt)))
              (send pid [:term-line "X=99"])
              (is (not (nil? (rt-await-screen "X=99" 8000))))
              (send pid [:term-line "echo value-is-$X"])
              (let (ev (rt-await-screen "value-is-99" 8000))
                ;; a variable set by the first line survives into the second — the whole
                ;; difference between a REPL and `sh -c` per line
                (is (not (nil? ev))))
              (send pid [:shutdown]))))))))
