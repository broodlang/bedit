;; Keybinding-profile tests: the emacs/vim profiles on the model scope (src/keymaps.blsp)
;; and the Vim modal dispatch. Same `main-test` module as the other test files; the
;; common model helpers are repeated so a standalone `nest check` of this file resolves.
(defmodule keymaps-test
  (:use model)
  (:use input)
  (:use-internals view)
  (:use commands)
  (:use keymaps)
  (:use editor/buffer)
  (:use editor/keymap) ; keymap-bind / keymap-where-is — the help-text lookups below
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(defn type-str (m s) (press m (string/to-list s)))
;; A model in the Vim profile (normal mode), editing `text` with point at the start.
(defn vim-of (text) (ed-set-profile (m-of text) :vim))

(describe "keybinding profiles"
  (test "the editor starts in the emacs profile with no modal state"
    (let (m (m-of "abc"))
      (assert= (:profile m) :emacs)
      (is (nil? (:edit-state m)))))

  (test "vim-mode switches profile and starts in normal mode; emacs-mode switches back"
    (let (v (cmd-vim-mode (m-of "abc") nil))
      (assert= (:profile v) :vim)
      (assert= (:edit-state v) :normal)
      (let (e (cmd-emacs-mode v nil))
        (assert= (:profile e) :emacs)
        (is (nil? (:edit-state e))))))

  (test "the mode line NAMES the typing mode, nothing under emacs"
    (assert= (view/ed-edit-state-label (vim-of "abc")) "NORMAL")
    (assert= (view/ed-edit-state-label (press (vim-of "abc") (list "i"))) "INSERT")
    (assert= (view/ed-edit-state-label (press (vim-of "abc") (list "v"))) "VISUAL")
    (assert= (view/ed-edit-state-label (m-of "abc")) ""))

  (test "the mode chip is coloured by state (insert reads as 'keys go in the buffer')"
    (assert= (:fg (view/ed-edit-state-face (press (vim-of "abc") (list "i")))) *green*)
    (assert= (:fg (view/ed-edit-state-face (press (vim-of "abc") (list "v")))) *mauve*)
    (assert= (:fg (view/ed-edit-state-face (vim-of "abc"))) *subtext*))

  (test "the chip reaches the rendered status bar segments"
    (let (m (vim-of "abc")
          pane {:selected true :payload {:buffer 0 :top 0} :rect [0 0 80 24]}
          segs (view/ed-statusbar-segments m pane (cur m)))
      (is (find (fn (s) (= (:text s) "NORMAL")) segs))))

  (test "the caret shape: block in normal/visual + the Emacs default, bar in vim insert"
    (assert= (view/ed-cursor-style (vim-of "abc")) :block) ; normal
    (assert= (view/ed-cursor-style (press (vim-of "abc") (list "i"))) :bar) ; insert
    (assert= (view/ed-cursor-style (press (vim-of "abc") (list "v"))) :block) ; visual
    (assert= (view/ed-cursor-style (m-of "abc")) :block) ; emacs default → block
    ;; …and the Emacs caret is configurable via the model's :cursor-style
    (assert= (view/ed-cursor-style (assoc (m-of "abc") :cursor-style :bar)) :bar))

  (test "the profile registry resolves both registered profiles to layers"
    (is (not (empty? (keymaps/profile-layers :vim))))
    (is (not (empty? (keymaps/profile-layers :emacs))))
    ;; an unknown profile falls back to the emacs set
    (assert= (keymaps/profile-layers :nope) (keymaps/profile-layers :emacs))))

(describe "vim normal mode"
  (test "h/l/j/k move point and plain letters are commands, not self-insert"
    (let (m (vim-of "abc"))
      (assert= (buffer-point (cur (press m (list "l" "l")))) 2) ; l l → right twice
      (assert= (buffer-point (cur (press m (list "l" "h")))) 0) ; l then h → back
      ;; j/k are line motion, not text: the buffer is unchanged (no "j"/"k" inserted)
      (assert= (buffer-text (cur (press m (list "j" "k")))) "abc")))

  (test "x deletes the char at point; dd kills the whole line"
    (assert= (buffer-text (cur (press (vim-of "abc") (list "x")))) "bc")
    (assert= (buffer-text (cur (press (vim-of "one\ntwo\nthree") (list "d" "d"))))
      "two\nthree"))

  (test "G / gg jump to end / start of buffer"
    (let (m (vim-of "a\nb\nc"))
      (assert= (buffer-current-line (cur (press m (list "G")))) 2)
      (assert= (buffer-current-line (cur (press (press m (list "G")) (list "g" "g")))) 0))))

(describe "modal command state never types (mode layers outrank the profile)"
  ;; REGRESSION: a buffer's mode layer wins over the model's profile, so brood-mode's
  ;; `:enter → cmd-newline-and-indent` used to insert a newline in vim NORMAL mode.
  ;; `commands/ed-vim-command-mode?` makes such an editing binding a motion instead.
  (defn blsp-vim (text)
    (ed-set-profile (ed-init (editor/layers/init-buffer-layers (editor/layers/set-buffer-type (make-buffer text
                                                                                                "f.blsp")
                                                                 :brood)))
      :vim))

  (test "ed-vim-command-mode? is true in normal/visual, false in insert and in emacs"
    (is (ed-vim-command-mode? (vim-of "abc")))
    (is (ed-vim-command-mode? (press (vim-of "abc") (list "v"))))
    (is (not (ed-vim-command-mode? (press (vim-of "abc") (list "i")))))
    (is (not (ed-vim-command-mode? (m-of "abc")))))

  (test "RET in a brood buffer in NORMAL mode moves down, never inserts"
    (let (m (blsp-vim "(defn f (x)\n  x)")
          after (press m (list :enter)))
      (assert= (buffer-text (cur after)) (buffer-text (cur m))) ; nothing typed
      (assert= (buffer-current-line (cur after)) 1))) ; moved down instead
  (test "RET in INSERT mode still inserts and indents"
    (let (m (press (blsp-vim "(defn f (x)") (list "A")) ; A → append at EOL, insert
          after (press m (list :enter)))
      (is (not= (buffer-text (cur after)) (buffer-text (cur m))))
      (is (includes? (buffer-text (cur after)) "\n"))))

  (test "RET in a PLAIN buffer in normal mode is a motion too (vim binds it)"
    (let (m (vim-of "one\ntwo")
          after (press m (list :enter)))
      (assert= (buffer-text (cur after)) "one\ntwo")
      (assert= (buffer-current-line (cur after)) 1)))

  (test "under emacs, RET in a brood buffer inserts and indents as always"
    (let (m (ed-init (editor/layers/init-buffer-layers (editor/layers/set-buffer-type (make-buffer "(defn f (x)"
                                                                                        "f.blsp")
                                                         :brood)))
          after (press m (list :enter)))
      (is (not= (buffer-text (cur after)) (buffer-text (cur m)))))))

(describe "vim insert mode"
  (test "i enters insert; typing self-inserts; Esc returns to normal"
    (let (ins (press (vim-of "abc") (list "i")))
      (assert= (:edit-state ins) :insert)
      (let (typed (type-str ins "XY"))
        (assert= (buffer-text (cur typed)) "XYabc") ; inserted at point 0
        (assert= (get (press typed (list :escape)) :edit-state) :normal))))

  (test "a appends after point; o opens a line below, both entering insert"
    (let (appended (type-str (press (vim-of "ab") (list "a")) "X"))
      (assert= (:edit-state appended) :insert)
      (assert= (buffer-text (cur appended)) "aXb")) ; a → after point 0, insert X
    (let (opened (press (vim-of "ab") (list "o")))
      (assert= (:edit-state opened) :insert)
      (assert= (buffer-text (cur opened)) "ab\n")))) ; new line below
(describe "vim visual mode"
  (test "v anchors the selection; a motion extends it; d kills the region → normal"
    (let (vis (press (vim-of "abcdef") (list "v")))
      (assert= (:edit-state vis) :visual)
      (is (not (nil? (buffer-mark (cur vis))))) ; mark set at the anchor
      ;; Vim's charwise selection is INCLUSIVE of the character under the cursor, so
      ;; v-l-l covers a, b AND c. This asserted "cdef" while the region ran one short.
      (let (deleted (press vis (list "l" "l" "d")))
        (assert= (buffer-text (cur deleted)) "def")
        (assert= (:edit-state deleted) :normal))))

  (test "y copies the selection and returns to normal without changing the text"
    (let (yanked (press (vim-of "abcdef") (list "v" "l" "l" "y")))
      (assert= (buffer-text (cur yanked)) "abcdef")
      (assert= (:edit-state yanked) :normal))))

(describe "vim grammar: counts, operators, motions, text objects, dot"
  (test "a count repeats a motion (3l moves three right)"
    (assert= (buffer-point (cur (press (vim-of "abcdef") (list "3" "l")))) 3))

  (test "w and e are distinct: w to next word start, e to this word's end"
    ;; "abc def": e → 2 (ON the "c", vim's inclusive word end); w → 4 (start of "def")
    (assert= (buffer-point (cur (press (vim-of "abc def") (list "e")))) 2)
    (assert= (buffer-point (cur (press (vim-of "abc def") (list "w")))) 4))

  (test "w crosses a multi-space gap and stops at the buffer end"
    (assert= (buffer-point (cur (press (vim-of "abc     def") (list "w")))) 8)
    (assert= (buffer-point (cur (press (vim-of "abc") (list "w")))) 3))

  (test "the motion table binds SYMBOLS, so a redefined motion hot-swaps live"
    ;; the same late-binding contract keymaps have: capturing function values here would
    ;; freeze the motions at load time (and hide them from `nest test --cover`)
    (is (every? (fn (kv) (symbol? (:op (second kv)))) (map-pairs *vim-motions*)))
    ;; …and every one of them resolves to a callable in the live image
    (is (every? (fn (kv) (fn? (eval (:op (second kv))))) (map-pairs *vim-motions*))))

  (test "operator + motion: dw deletes the word and its trailing space (to next word start)"
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "d" "w")))) "def ghi"))

  (test "counts compose: d2w and 2dw both delete two words"
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "d" "2" "w")))) "ghi")
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "2" "d" "w")))) "ghi"))

  (test "d0 deletes to the line start; d$ deletes to the line end"
    ;; point at 4 (the 'd' of "def"); d0 removes "abc " before it
    (assert= (buffer-text (cur (press (vim-of "abc def") (list "l" "l" "l" "l" "d" "0")))) "def")
    (assert= (buffer-text (cur (press (vim-of "abc def") (list "d" "$")))) ""))

  (test "linewise operators: dd deletes the line, dj deletes two lines"
    (assert= (buffer-text (cur (press (vim-of "one\ntwo\nthree") (list "d" "d")))) "two\nthree")
    (assert= (buffer-text (cur (press (vim-of "one\ntwo\nthree") (list "d" "j")))) "three"))

  (test "yy then p duplicates the current line"
    (assert= (buffer-text (cur (press (vim-of "one\ntwo") (list "y" "y" "p")))) "one\none\ntwo"))

  (test "cc empties the line, keeps it, and enters insert mode"
    ;; asserted "two" — i.e. the line removed, which is `dd`. Vim's `cc` leaves you on
    ;; a BLANK line to type into, so the newline stays.
    (let (m (press (vim-of "one\ntwo") (list "c" "c")))
      (assert= (:edit-state m) :insert)
      (assert= (buffer-text (cur m)) "\ntwo")))

  (test "text objects: diw deletes the inner word, daw deletes it with a trailing space"
    ;; point moved into "def" (index 4) first
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "l" "l" "l" "l" "d" "i" "w"))))
      "abc  ghi")
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "l" "l" "l" "l" "d" "a" "w"))))
      "abc ghi"))

  (test "x deletes count chars; . repeats the last change"
    (assert= (buffer-text (cur (press (vim-of "abcdef") (list "3" "x")))) "def")
    ;; dw deletes "abc " (→ "def ghi"); . repeats, deleting "def " → "ghi"
    (assert= (buffer-text (cur (press (vim-of "abc def ghi") (list "d" "w" ".")))) "ghi"))

  (test "Esc clears a half-entered count/operator"
    (let (m (press (vim-of "abcdef") (list "2" "d" :escape)))
      (is (nil? (:vim-pending m)))
      ;; after Esc, a plain motion moves once (the pending 2d is gone)
      (assert= (buffer-point (cur (press m (list "l")))) 1))))

;; ---- key-accurate help text: ask the keymap, don't hardcode -------------------
;; `keymap-where-is` (std) + `ed-where-is` / `ed-command-keys` (model): the seam any
;; buffer's help text uses so documentation follows the user's real bindings.

(describe "ed-where-is"
  (test "renders the bound key of a command, Emacs-labelled"
    (assert= (ed-where-is (profile-keymap :emacs) 'commands/cmd-forward-char) "C-f")
    (assert= (ed-where-is (profile-keymap :emacs) 'commands/cmd-save) "C-x C-s"))

  (test "an unbound command falls back to the literal given"
    (assert= (ed-where-is (profile-keymap :emacs) 'commands/cmd-no-such-thing "?!") "?!")
    (assert= (ed-where-is (profile-keymap :emacs) 'commands/cmd-no-such-thing) nil))

  (test "a nil command means grammar, not a binding — the literal stands"
    ;; vim routes every motion through one command, so its keys have no lookup
    (assert= (ed-where-is (profile-keymap :vim) nil "h") "h"))

  (test "the pick is deterministic: shortest sequence, then label order"
    ;; cmd-next-line is on both C-n and Down in the emacs profile
    (assert= (ed-where-is (profile-keymap :emacs) 'commands/cmd-next-line) "C-n")
    ;; a chord loses to a single key for the same command
    (let (km (-> {} (keymap-bind [:ctrl-c "z"] 'zap) (keymap-bind [:f5] 'zap)))
      (assert= (ed-where-is km 'zap) "f5"))))

(describe "ed-command-keys (the help-text vocabulary)"
  (test "builds a name → key map from specs, mixing lookups and literals"
    (let (v (ed-command-keys (profile-keymap :emacs)
              {:fwd ['commands/cmd-forward-char "C-f"]
               :save ['commands/cmd-save "C-x C-s"]
               :grammar [nil "l"]
               :missing ['commands/cmd-nope "fallback!"]}))
      (assert= (:fwd v) "C-f")
      (assert= (:save v) "C-x C-s")
      (assert= (:grammar v) "l")
      (assert= (:missing v) "fallback!")))

  (test "THE PAYOFF: a rebinding shows through — help text can't go stale"
    ;; bind forward-char to F9 in a derived keymap; the vocabulary follows the
    ;; binding rather than repeating a hardcoded "C-f"
    (let (rebound (keymap-bind (profile-keymap :emacs) [:f9] 'commands/cmd-forward-char)
          v (ed-command-keys rebound {:fwd ['commands/cmd-forward-char "C-f"]}))
      ;; f9 is a single key, and "C-f" sorts before "f9"… so assert the SET instead:
      (is (includes? (list "C-f" "f9") (:fwd v)))
      ;; on a keymap where ONLY f9 is bound, the answer is unambiguous
      (assert= (ed-command-keys (keymap-bind {} [:f9] 'commands/cmd-forward-char)
                 {:fwd ['commands/cmd-forward-char "C-f"]})
        {:fwd "f9"}))))

(describe "ed-substitute-command-keys (the low-ceremony form)"
  (test "a hole becomes the key actually bound to that command"
    (assert= (ed-substitute-command-keys (profile-keymap :emacs)
               "press \\[commands/cmd-save] to save")
      "press C-x C-s to save"))

  (test "several holes in one string, and text around them survives"
    (assert= (ed-substitute-command-keys (profile-keymap :emacs)
               "\\[commands/cmd-forward-char] forward · \\[commands/cmd-backward-char] back")
      "C-f forward · C-b back"))

  (test "an unbound command falls back to run-it-by-name — never a lie, never a blank"
    (assert= (ed-substitute-command-keys {} "run \\[commands/cmd-tutorial]")
      "run M-x tutorial"))

  (test "…and the fallback's PROMPT KEY AND SEPARATOR are looked up too (vim has no M-x)"
    ;; nothing binds cmd-dired in the vim profile, so it falls back — and you type
    ;; `:dired` with no space, where emacs is `M-x dired` with one. The separator is
    ;; part of the answer, not decoration.
    (assert= (ed-substitute-command-keys (profile-keymap :vim) "\\[commands/cmd-dired] browses")
      ":dired browses")
    (assert= (ed-substitute-command-keys (profile-keymap :emacs) "\\[commands/cmd-no-such] runs")
      "M-x no-such runs"))

  (test "the same text renders each profile's own keys"
    (let (t "\\[commands/cmd-isearch-forward] searches")
      (assert= (ed-substitute-command-keys (profile-keymap :emacs) t) "C-s searches")
      (assert= (ed-substitute-command-keys (profile-keymap :vim) t) "/ searches")))

  (test "text with no holes is returned untouched; an unterminated hole is left alone"
    (assert= (ed-substitute-command-keys (profile-keymap :emacs) "plain text") "plain text")
    (is (includes? (ed-substitute-command-keys (profile-keymap :emacs) "oops \\[unclosed")
          "\\[unclosed"))))

;; ---- vim conformance: the places this diverged from real vim --------------------
;; Written after a report that "vim-mode seems very broken". Each of these was
;; measured against what vim actually does, not against what the code did.

(describe "vim motions land where vim lands"
  (defn at (text point) (ed-apply (vim-of text) (fn (b) (goto-char b point))))
  (defn point-after (text point ks) (buffer-point (cur (press (at text point) ks))))
  (def TXT "hello world\nsecond line\nthird")

  (test "REGRESSION: G goes to the LAST LINE, not past the last character"
    ;; end-of-buffer left the cursor after the final line, so G then any horizontal
    ;; motion behaved as though the file had one more line than it has
    (assert= (point-after TXT 0 (list "G")) 24)
    (assert= (buffer-current-line (cur (press (at TXT 0) (list "G")))) 2))

  (test "gg goes to the first line"
    (assert= (point-after TXT 20 (list "g" "g")) 0))

  (test "counts multiply a motion"
    (assert= (point-after TXT 0 (list "l")) 1)
    (assert= (point-after TXT 0 (list "3" "l")) 3)
    (assert= (point-after TXT 0 (list "2" "w")) 12))

  (test "0 and $ are the line's ends"
    (assert= (point-after TXT 5 (list "0")) 0)
    (assert= (point-after TXT 0 (list "$")) 11))

  (test "j and k move by line"
    (assert= (point-after TXT 0 (list "j")) 12)
    (assert= (point-after TXT 12 (list "k")) 0)))

(describe "vim visual mode is inclusive, like vim"
  (test "REGRESSION: v with no motion still covers one character"
    ;; the region ran from mark to point exclusive, so `v d` deleted NOTHING
    (let (deleted (press (vim-of "abcdef") (list "v" "d")))
      (assert= (buffer-text (cur deleted)) "bcdef")))

  (test "v l l d takes three characters, not two"
    (assert= (buffer-text (cur (press (vim-of "abcdef") (list "v" "l" "l" "d")))) "def"))

  (test "…and y leaves the text alone while returning to normal"
    (let (yanked (press (vim-of "abcdef") (list "v" "l" "y")))
      (assert= (buffer-text (cur yanked)) "abcdef")
      (assert= (:edit-state yanked) :normal))))

(describe "vim edits and modes"
  (def TXT2 "hello world\nsecond line\nthird")
  (test "the mode transitions land in the right state"
    (assert= (:edit-state (press (vim-of "abc") (list "i"))) :insert)
    (assert= (:edit-state (press (vim-of "abc") (list "i" :escape))) :normal)
    (assert= (:edit-state (press (vim-of "abc") (list "v"))) :visual)
    (assert= (:edit-state (press (vim-of "abc") (list "v" :escape))) :normal))

  (test "insert-mode keys reach the buffer; normal-mode letters do not"
    (assert= (buffer-text (cur (press (vim-of "abc") (list "i" "X")))) "Xabc")
    ;; `z` is unbound in normal mode: a dead key, never self-insert
    (assert= (buffer-text (cur (press (vim-of "abc") (list "z")))) "abc"))

  (test "x, dd, dw and counts edit the way vim does"
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "x")))) "ello world\nsecond line\nthird")
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "3" "x"))))
      "lo world\nsecond line\nthird")
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "d" "d")))) "second line\nthird")
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "3" "d" "d")))) "")
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "d" "w")))) "world\nsecond line\nthird"))

  (test "yy then p duplicates the line, and u undoes an edit"
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "y" "y" "p"))))
      "hello world\nhello world\nsecond line\nthird")
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "x" "u")))) TXT2))

  (test ". repeats the last change"
    (assert= (buffer-text (cur (press (vim-of TXT2) (list "x" "."))))
      "llo world\nsecond line\nthird")))

(describe "REGRESSION: nothing types in a vim COMMAND state"
  ;; The keymap fallback self-inserted any printable key, so every key vim does not
  ;; bind typed itself into the buffer in NORMAL mode — z q s t r m f and most of the
  ;; keyboard. `ed-vim-command-mode?` existed for exactly this rule and the fallback,
  ;; where the majority of keys land, never consulted it.
  (test "unbound letters are dead keys in normal mode"
    (dolist (k (list "z" "q" "s" "t" "r" "m" "f" "n" "Z" "Q"))
      (assert= (buffer-text (cur (press (vim-of "abc") (list k)))) "abc")))

  (test "…and in visual mode"
    (dolist (k (list "z" "q" "s"))
      (assert= (buffer-text (cur (press (vim-of "abc") (list "v" k)))) "abc")))

  (test "but insert mode still types everything, including those keys"
    (dolist (k (list "z" "q" "s"))
      (assert= (buffer-text (cur (press (vim-of "abc") (list "i" k)))) (str k "abc"))))

  (test "and the emacs profile is untouched — plain keys type there"
    (let (m (ed-init (make-buffer "abc" "t.txt")))
      (assert= (buffer-text (cur (press m (list "z")))) "zabc"))))

(describe "vim `cc` empties the line but keeps it"
  (def L3 "hello world\nsecond line\nthird")
  (test "REGRESSION: cc leaves you on a blank line, it does not join the next one up"
    ;; the doubled operator expands to whole lines INCLUDING the trailing newline, so a
    ;; change killed the same range as dd and "cc" then "new" gave "newsecond line"
    (assert= (buffer-text (cur (press (vim-of L3) (list "c" "c" "new" :escape))))
      "new\nsecond line\nthird"))

  (test "…while dd still takes the line whole"
    (assert= (buffer-text (cur (press (vim-of L3) (list "d" "d")))) "second line\nthird")
    (assert= (buffer-text (cur (press (vim-of L3) (list "3" "d" "d")))) ""))

  (test "cc on the LAST line works too (no trailing newline to trim)"
    (let (m (ed-apply (vim-of L3) (fn (b) (goto-char b 25))))
      (assert= (buffer-text (cur (press m (list "c" "c" "x" :escape))))
        "hello world\nsecond line\nx")))

  (test "cc leaves insert mode active before Esc"
    (assert= (:edit-state (press (vim-of L3) (list "c" "c"))) :insert))

  (test "2cc empties two lines into one blank"
    (assert= (buffer-text (cur (press (vim-of L3) (list "2" "c" "c" "z" :escape))))
      "z\nthird")))

(describe "vim `e` lands ON the word's last character"
  (defn at2 (text point) (ed-apply (vim-of text) (fn (b) (goto-char b point))))
  (test "REGRESSION: e is the last char, not one past it"
    (assert= (buffer-point (cur (press (at2 "hello world" 0) (list "e")))) 4)
    (assert= (buffer-point (cur (press (at2 "hello world" 6) (list "e")))) 10))

  (test "from a word's last character it moves to the NEXT word's end"
    ;; otherwise e sticks, and a count never leaves the first word
    (assert= (buffer-point (cur (press (at2 "one two three" 2) (list "e")))) 6)
    (assert= (buffer-point (cur (press (at2 "one two three" 0) (list "2" "e")))) 6))

  (test "…and as an operator target it is INCLUSIVE: de eats the word"
    (assert= (buffer-text (cur (press (at2 "hello world" 0) (list "d" "e")))) " world"))

  (test "an exclusive motion is unaffected — dw still stops at the next word"
    (assert= (buffer-text (cur (press (at2 "hello world" 0) (list "d" "w")))) "world")))
