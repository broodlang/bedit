;; The key panel (src/keypanel.blsp): a transient menu and which-key as ONE shape of data, drawn
;; by the style the `:key-panel` setting names — the editor's own `:echo`, a flat strip in the
;; echo area below the mode line, or one a package registers.
(defmodule keypanel-test
  (:use test)
  (:use model)
  (:use testkit :only [m-of press]))

(def- test-menu
  {:name 'keypanel-menu
   :title "Push"
   :groups [{:title "Arguments"
             :suffixes [{:key "-f" :kind :switch :arg "--force-with-lease" :label "force"}]}
             {:title "Push to"
              :suffixes [{:key "p" :kind :command :command 'motion/cmd-forward-char :label "origin"}]}]})

(defn- menu-model () (transient/ed-transient-open (m-of "abc\ndef") test-menu))

(defn- texts (ops) (seq/filter ops (fn (op) (= (first op) :text))))

(defn- modeline-row (m rows) (dec (- rows (minibuffer/ed-echo-rows m rows))))

(describe "which panel is shown"
  (test "none with no menu open and no prefix pending"
    (is (nil? (keypanel/ed-key-panel (m-of "x") 30)))
    (assert= (keypanel/panel-rows (m-of "x") 30) 0))
  (test "an open menu's panel, before a pending prefix's"
    (assert= (:title (keypanel/ed-key-panel (menu-model) 30)) "Push"))
  (test "none while a prompt lists candidates: its list owns the echo area"
    (let (m (assoc (menu-model) :minibuffer {:accept-selection true}))
      (is (nil? (keypanel/ed-key-panel m 30))))))

(describe "the :echo style, a strip below the mode line"
  (test "the echo area grows by the panel's rows, and every line is painted below the mode line"
    (let (m (menu-model)
          ops (texts (keypanel/ed-key-panel-ops m 100 30)))
      ;; the message row, the title, and the tallest group's heading and row
      (assert= (minibuffer/ed-echo-rows m 30) 4)
      (is (not (empty? ops)))
      (is (every? ops (fn (op) (> (nth op 1) (modeline-row m 30)))))))
  (test "the groups sit side by side, each key before its description"
    (let (ops (texts (keypanel/ed-key-panel-ops (menu-model) 100 30))
          at (fn (label) (seq/find ops (fn (op) (= (nth op 3) label)))))
      (assert= (nth (at "Arguments") 1) (nth (at "Push to") 1))
      (is (< (nth (at "Arguments") 2) (nth (at "Push to") 2)))
      (assert= (nth (at "p") 1) (nth (at "-f") 1))))
  (test "a column starts at the same screen column on every row, wide glyphs before it"
    ;; columns are measured in display cells: a CJK label is two cells a character
    (let (panel {:groups [{:title nil
                           :rows [{:key "a" :text "日本 x"}
                                   {:key "b" :text "ab"}
                                   {:key "c" :text "c"}
                                   {:key "d" :text "d"}]}]
                 :layout :flow}
          ops (texts (keypanel/echo-paint panel (m-of "x") 80 4))
          column-of (fn (label) (nth (seq/find ops (fn (op) (= (nth op 3) label))) 2)))
      ;; four rows in a frame four tall cap a column at one line: each entry its own column
      (assert= (column-of "日本 x") 3)
      (assert= (- (column-of "b") (column-of "a")) (+ 3 6 3))))
  (test "a panel wider than the frame is paged, its first row saying which page and how to turn"
    (let (rows (map (range 30) (fn (n) {:key (str "k" n) :text "a command of some length"}))
          panel {:groups [{:title nil :rows rows}] :layout :flow :page 1 :page-hint "C-h n/p"}
          labels (map (texts (keypanel/echo-paint panel (m-of "x") 80 30)) (fn (op) (nth op 3))))
      (is (includes? labels "page 2/2 · C-h n/p"))
      (is (not (includes? labels "k0"))))))

;; a package's style, registered as a package would register one
(defn plain-rows (_panel _rows) 1)
(defn plain-paint (panel _m _columns rows) [[:text (dec rows) 0 (str "plain: " (:title panel)) {}]])

(describe "a package changes how the panel looks"
  (test "the setting names a registered style, and that style draws every panel"
    (keypanel/register-panel-style :plain
      {:rows 'keypanel-test/plain-rows :paint 'keypanel-test/plain-paint})
    (let (m (assoc (menu-model) :key-panel :plain))
      (assert= (keypanel/ed-key-panel-ops m 100 30) [[:text 29 0 "plain: Push" {}]])
      (assert= (minibuffer/ed-echo-rows m 30) 2)))
  (test "a setting naming no registered style falls back to the editor's own"
    (let (m (assoc (menu-model) :key-panel :nonexistent))
      (is (any? (texts (keypanel/ed-key-panel-ops m 100 30)) (fn (op) (= (nth op 3) "Push")))))))

(describe "which-key is a key panel"
  (test "a prefix pending past the delay shows its keys in the strip"
    (let (m (press (m-of "x") [:ctrl-x [:timer :which-key]])
          labels (map (texts (keypanel/ed-key-panel-ops m 200 30)) (fn (op) (nth op 3))))
      (is (includes? labels "find-file"))
      (is (includes? labels "C-f")))))
