;; The registries the core folds instead of naming features. Each row is written by a module
;; when it loads, so what can go wrong is not the code in a row but the shape of the whole:
;; the order, a row the fold never reaches, a package's row left behind.
(defmodule registries-test
  (:use test)
  (:use model)
  (:use pool)
  (:use editor/buffer)
  (:use editor/buffer-server)
  ;; every module with a row: an unloaded row is a row that does not run
  (:use collab)
  (:use hosted)
  (:use syntaxtree)
  (:use linecache)
  (:use stringstate)
  (:use sudoedit)
  (:use saveplace)
  (:use solong)
  (:use recover)
  (:use file-save) ; a save refused by the OS
  (:use main :only []) ; the released image: every row loaded
  (:use sidecar))

(purge-stale-temp "bedit-registries-")

(defn- keeper-names () (map (ed-slot-keepers) :name))

(defn- core-keepers ()
  "The keepers in `:order`, without the rows the tests below add for a moment."
  (vec (seq/reject (keeper-names) (fn (name) (includes? [:gone :pkg] name)))))

(defn- fixture-file (name text)
  "A fresh file `name` holding `text` in its own temp directory; its path."
  (let (dir (temp-dir "bedit-registries-")
        _ (file/mkdir dir)
        path (path/join dir name))
    (do (file/spit path text) path)))

(defn- long-text () (str (string/join (map (range 3000) (fn (_) "x")) "") "\n"))

(defn- row-names (id) (vec (map (registry/ranked id) first)))

;; `main` is in this file's header: its image is the released editor's, so these lists also say
;; every row is loaded with it. An unloaded row paints nothing and fails nothing.
(describe "what paints"
  (test "the highlight sources, in the order they paint"
    (assert= (row-names :model/highlight-sources)
      [:rainbow :glyphless :whitespace :spell :isearch :remote-selections]))

  (test "the frame overlays, bottom to top"
    (assert= (row-names :model/frame-overlays)
      [:tab-bar
        :minibuffer-list :avy :which-key :completion-popup :transient :context-menu
        :modeline-tooltip :diagnostic-tooltip]))

  (test "the pane layers, each in its slot"
    (assert= (sort (row-names :model/pane-layers))
      (sort [:pulse :header-line :remote-carets :fold-markers :image :fill-column-indicator]))
    (assert= (:slot (registry/lookup :model/pane-layers :remote-carets)) :with-text)
    (assert= (:slot (registry/lookup :model/pane-layers :pulse)) :over-text)
    (assert= (:slot (registry/lookup :model/pane-layers :header-line)) :chrome))

  (test "a source that does not answer paints nothing rather than failing the frame"
    (is (empty? (reflect/call-if-bound 'nowhere-module/hook '() {} {} {} {}))))

  (test "so-long's line services are off through every door"
    (let (long (make-buffer "text"))
      (is (:line-services-off (so-long-on long nil)))
      (is (:line-services-off (so-long-carried long {:line 0})))
      (is (nil? (:line-services-off (so-long-off (so-long-on long nil))))))))

;; What the loop (input, events, the span painter) used to call by name and now folds: the
;; hosted propagate, the collab steps, the tree release, a process down, the ANSI colours.
(describe "the loop's own rows"
  (test "an event's tail: the hosted propagate first, then collab; only the propagate on recovery"
    (assert= (row-names :model/tail-steps) [:hosted :collab])
    (is (:recover (registry/lookup :model/tail-steps :hosted)))
    (is (not (:recover (registry/lookup :model/tail-steps :collab)))))

  (test "a committed turn frees the dropped trees"
    (assert= (row-names :model/commit-steps) [:syntax-trees]))

  (test "a buffer process's push is collab's to fold, its own echo is inert"
    (assert= (ed-registered-event-handler :buffer-updated) 'collab/ed-ev-buffer-updated)
    (is (contains? (registry/entries :model/inert-inputs) :hosted-own-echo))
    (is (not (ed-inert-input? (ed-init (make-buffer "x")) :ctrl-f))))

  (test "a process down reaches hosted and collab, and a pid of nobody's changes nothing"
    (let (handlers (registry/entries :model/down-handlers)
          m (ed-init (make-buffer "x")))
      (is (contains? handlers :hosted))
      (is (contains? handlers :collab))
      (assert= (ed-run-down-handlers m (spawn nil) :normal) m)))

  (test "a client's identity reaches collab: its name recorded"
    (is (contains? (registry/entries :model/identity-steps) :collab))
    (assert= (:participant (events/ed-apply-client-identity (ed-init (make-buffer "x"))
                             {:name "ann"}))
      "ann"))

  (test "a producer's colours are a text-face row, painted through the palette"
    (let (coloured (ansicolor/add-faces (make-buffer "hello") [[0 2 {:fg 1}]] 0)
          [spans palette] (ed-text-faces coloured))
      (assert= spans [[0 2 {:fg 1}]])
      (is (not (nil? palette))))
    (is (nil? (ed-text-faces (make-buffer "plain"))))))

;; The order `input` documents. It was a literal list; now it is ranks in eleven files, so a
;; rank moved in one of them shows here and nowhere else until a key goes to the wrong mode.
(describe "the key overlays"
  (test "are offered a key in the load-bearing order"
    (assert= (row-names :model/overlays)
      [:describe-key
        :read-char :menu :query-replace :isearch :minibuffer :completion :transient :term
        :secret :snippet :preview :repeat]))

  (test "a transient menu reading an option leaves the keys to the prompt"
    (let (both {:transient {:menu true} :minibuffer {:edit true}}
          open (editor/ui/overlay-active (ed-overlays) both))
      (is (record? open))
      (assert= (editor/ui/overlay-active? open both) (:minibuffer both))))

  (test "a password read opened by the first typed key comes before the preview"
    (let (ranks (registry/entries :model/overlays))
      (is (< (:rank (get ranks :secret)) (:rank (get ranks :preview))))
      (is (> (:rank (get ranks :secret)) (:rank (get ranks :minibuffer))))))

  (test "a package's overlay goes back with the package"
    (ownership/with-claimant "/nowhere/overlay/x.blsp"
      (fn () (register-overlay :pkg 75 :a-record)))
    (is (contains? (registry/entries :model/overlays) :pkg))
    (ownership/release-under! "/nowhere/overlay")
    (is (not (contains? (registry/entries :model/overlays) :pkg)))))

(describe "a mode's facets for the input layer"
  (test "a plain buffer waits for no password"
    (is (not (passwd/ed-secret-pending? (ed-init (make-buffer "text"))))))

  (test "a terminal and a shell both declare how a password is waited for"
    (each [terminal/term-mode-layer bshell/bshell-mode-layer]
      (fn (layer)
        (is (symbol? (:secret-pending? layer)))
        (is (symbol? (:secret-key layer))))))

  (test "only a terminal takes the pointer and a paste"
    (is (symbol? (:mouse terminal/term-mode-layer)))
    (is (symbol? (:paste terminal/term-mode-layer)))
    (is (nil? (:mouse bshell/bshell-mode-layer))))

  (test "a line-mode terminal leaves a paste to the yank, a char-mode one takes it"
    (let (char-mode (ed-init (assoc (make-buffer "") :type :term))
          line-mode (ed-init (assoc (make-buffer "") :type :term :term-line-mode true)))
      (is (map? (terminal/term-paste-text char-mode "x")))
      (is (nil? (terminal/term-paste-text line-mode "x")))))

  (test "the window's rows reach a terminal"
    (is (contains? (registry/entries :model/resize-steps) :terminals))
    (is (contains? (registry/entries :model/palette-steps) :terminals))
    (let (m (ed-init (make-buffer "")))
      (is (= m (ed-run-resize-steps m)))
      (is (= m (ed-run-palette-steps m))))))

(describe "a kill's slot keepers"
  (test "run in the load-bearing order: a link is used before it goes, the caches last"
    (assert= (core-keepers)
      [:save-place
        :killed-files :collab :sudo-open :file-loading :ssh-open :hosted :syntax-trees :line-caches
        :string-caches :string-warm :tabs]))

  (test "a table beside the pool shifts by the one rule, its indexes with it"
    (assert= (shift-slots {0 :a 1 :b 2 :c} 1) {0 :a 1 :c})
    (assert= (shift-slots nil 1) nil)
    (assert= (shift-slot-index 2 1) 1)
    (assert= (shift-slot-index 1 1) nil)
    (assert= (shift-slot-index 0 1) 0)
    (assert= (shift-slot-index nil 1) nil))

  (test "every table keyed by pool index follows one kill"
    (let (m (assoc (ed-init (make-buffer "one" "a"))
              :line-caches {0 :a 1 :b}
              :string-caches {0 :c 1 :d}
              :syntax-trees {1 :e}
              :string-warm-index 1
              :tree-warm-index 1)
          dropped (ed-drop-slot m 0))
      (assert= (:line-caches dropped) {0 :b})
      (assert= (:string-caches dropped) {0 :d})
      (assert= (:syntax-trees dropped) {0 :e})
      (assert= (:string-warm-index dropped) 0)
      (assert= (:tree-warm-index dropped) 0)
      (is (:pool-shifted dropped))))

  (test "a shared slot withdraws through its link before the hosted row unhosts it"
    (let (shared (ed-open-buffer (ed-init (make-buffer "one" "a")) (make-buffer "two" "b"))
          proc (spawn-buffer (make-buffer "two" "b"))
          slot (map/assoc-in (hosted/ed-host-slot shared 1 proc) [:hosted 1 :collab?] true)
          dropped (ed-drop-slot slot 1))
      (is (nil? (map/get-in dropped [:hosted 1])))
      ;; a shared host outlives its subscribers: the hosted row must not have stopped it
      (is (proc/alive? proc))
      (stop-buffer proc)))

  (test "a row without its module does nothing rather than failing the kill"
    (ownership/with-claimant "/nowhere/gone/x.blsp"
      (fn () (register-slot-keeper :gone {:order 1 :drop 'nowhere-module/hook})))
    (let (m (ed-init (make-buffer "one" "a")))
      (is (map? (ed-drop-slot m 0))))
    (ownership/release-under! "/nowhere/gone"))

  (test "a package's row goes back with the package"
    (ownership/with-claimant "/nowhere/pkg/x.blsp"
      (fn () (register-slot-keeper :pkg {:order 1 :slots [:pkg-table]})))
    (is (includes? (keeper-names) :pkg))
    (ownership/release-under! "/nowhere/pkg")
    (is (not (includes? (keeper-names) :pkg)))))

(defn test-open (m spec) (message m (str "handled open of " spec)))
(defn test-save (m index) (message m (str "handled save of " index)))
(defn test-revert (m index coding) (message m (str "handled revert as " coding)))
(defn test-write (m spec) (message m (str "handled write to " spec)))
(defn test-file-of (spec) (string/substring spec 6 (string/length spec)))

;; registered once, at load: tests run concurrently, and one taking a row back would pull
;; it from under another
(register-file-handler :test
  {:order 20
   :prefix "/test:"
   :mark :test-owned
   :buffer-keys [:test-owned :test-extra]
   :file-of 'registries-test/test-file-of
   :find-file 'registries-test/test-open
   :write-file 'registries-test/test-write
   :save 'registries-test/test-save
   :revert 'registries-test/test-revert})

(defn- owned-model ()
  (ed-init (assoc (make-buffer "text" "x" "/nowhere/x") :test-owned true :test-extra 1)))

(describe "a file handler"
  (test "sudoedit is a row, not a branch"
    (is (includes? (map (ed-file-handlers) :name) :sudo))
    (assert= (:name (ed-path-handler "/sudo::/etc/hosts")) :sudo)
    (is (nil? (ed-path-handler "/etc/hosts")))
    (assert= (:name (ed-buffer-handler {:sudo true})) :sudo)
    (is (nil? (ed-buffer-handler {:sudo false})))
    (is (nil? (ed-buffer-handler {}))))

  (test "a typed path goes to the handler claiming it"
    (assert= (:echo (ed-find-file (ed-init (make-buffer "")) "/test:a")) "handled open of /test:a")
    (assert= (ed-file-of-spec "/test:a/b") "a/b")
    (assert= (ed-file-of-spec "/plain/b") "/plain/b"))

  (test "a buffer it owns is saved and reverted through it"
    (let (m (owned-model))
      (assert= (:echo (file-save/ed-save-buf-at m 0)) "handled save of 0")
      (assert= (:echo (ed-revert-handled m 0 :latin-1)) "handled revert as :latin-1")))

  (test "a buffer written somewhere plain stops being its"
    (let (plain (ed-buffer-unhandled (ed-current-buf (owned-model))))
      (is (nil? (ed-buffer-handler plain)))
      (is (nil? (:test-extra plain)))))

  (test "a save refused by the OS offers what a handler offers"
    (let (refuse (fn (_file _content) (error "Permission denied"))
          echo (binding (*write-file* refuse)
                 (:echo (file-save/ed-save-buf-at (ed-init (make-buffer "t" "x" "/nowhere/x")) 0))))
      (is (includes? echo "M-x sudo-edit"))
      (is (includes? echo "still modified"))))

  (test "a package's handler goes back with the package"
    (ownership/with-claimant "/nowhere/handler/x.blsp"
      (fn () (register-file-handler :pkg {:order 30 :prefix "/pkg:" :mark :pkg-owned})))
    (is (includes? (map (ed-file-handlers) :name) :pkg))
    (ownership/release-under! "/nowhere/handler")
    (is (not (includes? (map (ed-file-handlers) :name) :pkg)))))

(describe "a visit's steps"
  (test "run in order, the place restored before a long line is looked for"
    (assert= (vec (map (map (registry/ranked :model/visit-steps) second) :name))
      [:dir-locals :save-place :so-long :mixed-eol :recovery]))

  (test "a long line is noted after the open notice"
    (let (path (fixture-file "long.txt" (long-text))
          opened (ed-find-file (assoc (ed-init (make-buffer "")) :so-long-threshold 100) path))
      (is (so-long? (ed-current-buf opened)))
      (is (includes? (:echo opened) (str "opened " path " — so-long: line 1")))))

  (test "a newer sidecar is said instead of every other note"
    (let (path (fixture-file "long.txt" (long-text))
          sidecar (ed-auto-save-path path)
          _ (file/spit sidecar "unsaved")
          _ (file/set-mtime path 1577836800000)
          opened (ed-find-file (assoc (ed-init (make-buffer "")) :so-long-threshold 100) path))
      ;; the steps still ran: only the note gave way
      (is (so-long? (ed-current-buf opened)))
      (is (includes? (:echo opened) "M-x recover-this-file"))
      (is (not (includes? (:echo opened) "opened")))
      (is (not (includes? (:echo opened) "so-long")))))

  (test "a jump runs only the steps marked for it, and says what they note"
    (let (path (fixture-file "long.txt" (long-text))
          base (assoc (ed-init (make-buffer "")) :so-long-threshold 100)
          jumped (ed-pop-to-file base path 1))
      (is (so-long? (ed-current-buf jumped)))
      (is (string/starts-with? (:echo jumped) "so-long: line 1"))))

  (test "a jump has no open notice to replace: a newer sidecar waits for a real visit"
    (let (path (fixture-file "notes.txt" "text\n")
          sidecar (ed-auto-save-path path)
          _ (file/spit sidecar "unsaved")
          _ (file/set-mtime path 1577836800000)
          jumped (ed-pop-to-file (ed-init (make-buffer "")) path 1))
      (is (not (includes? (str (:echo jumped)) "recover-this-file"))))))
