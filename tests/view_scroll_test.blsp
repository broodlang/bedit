;; Editor tests (split from the original monolithic main_test.blsp by concern).
;; Every split file keeps the `main-test` module name, so a helper defined in any
;; file is visible to every test body at run time (test bodies are lazy thunks the
;; runner evaluates only after all files load into the shared image). The common
;; model helpers below are repeated in each file so a standalone `nest check` of a
;; single file still resolves them.
(defmodule view-scroll-test
  (:use model)
  (:use input)
  (:use view)
  (:use panes)
  (:use complete-at-point)
  (:use main)
  (:use editor/buffer)
  (:use test))

(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn after (text k) (buffer-text (cur (ed-update (m-of text) k 80 24))))
(defn press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))
(defn type-str (m s) (press m (string/->list s)))

(describe "editor completion-at-point"
  ;; a model whose current buffer is `text` with point at `p`
  (defn cm (text p) (ed-set-buf (m-of "") (goto-char (make-buffer text) p)))
  (test "completion-candidates: distinct buffer words by prefix, sorted"
    (assert= (completion-candidates (cm "for foreach for fold" 0) "fo")
      (list "fold" "for" "foreach")))
  (test "Tab with a single candidate inserts it directly (no popup)"
    (let (m (cmd-complete (cm "alpha al" 8) nil))
      (is (nil? (:completion m)))
      (assert= (buffer-text (cur m)) "alpha alpha")))
  (test "Tab expands to the longest common prefix; a second Tab opens the popup (alphabetical)"
    (let (m (cmd-complete (cm "alpha alps al" 13) nil))
      ;; first Tab: `al` → `alp` — the lcp extends what was typed, so no popup yet
      (is (nil? (:completion m)))
      (assert= (buffer-text (cur m)) "alpha alps alp")
      ;; second Tab: nothing more expands — the popup lists the candidates
      (let (c (get (cmd-complete m nil) :completion))
        (is (not (nil? c)))
        (assert= (:items c) (list "alpha" "alps"))
        (assert= (:index c) 0))))
  (test "Tab with no candidate reports it; an empty prefix is a no-op"
    (is (includes? (get (cmd-complete (cm "zzz q" 5) nil) :echo) "no completions"))
    (is (includes? (get (cmd-complete (cm "abc" 0) nil) :echo) "nothing to complete")))
  (test "C-n moves the selection and Enter accepts it"
    (let (m (cmd-complete (cmd-complete (cm "alpha alps al" 13) nil) nil) ; expand, then popup
          done (complete-handle (complete-handle m :ctrl-n) :enter))
      ; items are ("alpha" "alps"); C-n → "alps", accept
      (is (nil? (:completion done)))
      (assert= (buffer-text (cur done)) "alpha alps alps")))
  (test "typing a word-char narrows the open popup live (Corfu-style)"
    (let (m (cmd-complete (cmd-complete (cm "alpha alps al" 13) nil) nil) ; popup: alpha, alps
          narrowed (complete-handle m "h"))
      ; prefix "alph" — only alpha still matches; the popup stays open
      (assert= (buffer-text (cur narrowed)) "alpha alps alph")
      (is (not (nil? (:completion narrowed))))
      (assert= (:prefix (:completion narrowed)) "alph")
      (assert= (count (:items (:completion narrowed))) 1)))
  (test "a word-char that matches nothing closes the popup and inserts (through ed-update)"
    (let (m (ed-update (ed-update (cm "alpha alps al" 13) :tab 80 24) :tab 80 24)
          ; first Tab expands to `alp`, second opens the popup
          m2 (ed-update m "x" 80 24))
      ; `alpx` matches nothing: the popup closes, the char lands in the buffer
      (is (not (nil? (:completion m))))
      (is (nil? (:completion m2)))
      (assert= (buffer-text (cur m2)) "alpha alps alpx")))
  (test "complete-popup-ops: empty when closed, draws cells when open"
    (assert= (complete-popup-ops (m-of "x") 80 24) [])
    (let (ops (complete-popup-ops (cmd-complete (cmd-complete (cm "alpha alps al" 13) nil) nil)
                80 24))
      (is (> (count ops) 0))
      (is (= (first (first ops)) :rect)) ; the solid card fills behind the rows
      (is (any? ops (fn (op) (= (first op) :text)))))) ; …with the candidate rows on top
  (test "the popup never overruns a short pane (caps to the text area)"
    ;; 10 candidates for prefix \"a\", in a 5-row pane (text area = 3 rows): the bordered
    ;; box (frame + items) must stay within those 3 rows.
    (let (m (cmd-complete (cm "aa ab ac ad ae af ag ah ai aj a" 31) nil)
          ops (complete-popup-ops m 80 5))
      (is (> (count ops) 0))
      (is (every? ops (fn (op) (< (nth op 1) 3))))))) ; every row (incl. the frame) is inside the text area
;; The minibuffer ranks a fixed candidate source to the number of rows it will SHOW, and
;; `fuzzy/top` skips whatever that cap makes unnecessary (a bounded fold instead of a sort,
;; and sharding past a few thousand candidates). The saving is only sound if the capped
;; ranking is exactly the front of the uncapped one — these pin that.
(describe "completion: ranking to the display cap"
  (def narrow-src
    (list "model.blsp" "modes.blsp" "main.blsp" "complete.blsp" "completion.blsp" "view.blsp"))
  (test "a capped rank is the front of the uncapped one"
    (assert= (completion/completion-rank "m" narrow-src 2) (take (completion/completion-rank "m" narrow-src) 2))
    (assert= (completion/completion-rank "mo" narrow-src 1) (take (completion/completion-rank "mo" narrow-src) 1)))
  (test "no cap ranks everything that matches"
    (assert= (completion/completion-rank "m" narrow-src) (fuzzy/filter "m" narrow-src)))
  (test "a cap past the match count is not padded"
    (assert= (completion/completion-rank "mo" narrow-src 99) (completion/completion-rank "mo" narrow-src)))
  (test "an empty query keeps the source order, capped"
    (assert= (completion/completion-rank "" narrow-src 2) (take narrow-src 2))))

(describe "editor horizontal scroll (long lines)"
  (test "ed-scroll-horizontal follows point past the right edge"
    (let (text (string/repeat "x" 200)
          m0 (ed-set-buf (m-of text) (goto-char (cur (m-of text)) 100)) ; point at col 100
          m (ed-scroll-horizontal m0 40) ; 40-col text area
          hs (ed-current-hscroll m))
      (is (> hs 0)) ; scrolled right to reveal col 100
      (is (>= 100 (+ hs 8))) ; point past the left margin
      (is (<= 100 (- (+ hs 40) 1 8))))) ; ...and within the right margin
  (test "a short line never scrolls horizontally"
    (assert= (ed-current-hscroll (ed-scroll-horizontal (m-of "abc") 40)) 0))
  (test "ed-line-ops renders the slice starting at hscroll"
    (let (buf (cur (m-of "abcdefghij")))
      ; 10 chars
      (assert= (nth (first (ed-line-ops buf 0 0 0 0 5 '() nil '() 3)) 3) "defgh"))) ; [3,3+5)
  (test "the cursor column is offset by hscroll (display-width aware)"
    (let (buf (goto-char (cur (m-of "abcdefghij")) 7))
      ; point at col 7
      (assert= (ed-visual-column-from buf 0) 7) ; whole prefix
      (assert= (ed-visual-column-from buf 3) 4))) ; from col 3 → "defg"
  (test "a click column maps through hscroll"
    (let (buf (cur (m-of "abcdefghij")))
      ; gw 0, s 1, hscroll 3, click col 2
      (assert= (ed-buf-offset-at buf 0 3 0 1 0 2) 5))) ; line 0, hscroll 3, click col 2 → col 5
  ;; The column half of the click, by the view's own measure: `ed-visual-column-from` places
  ;; the caret in display CELLS (an emoji or CJK glyph is two), so the click must come back
  ;; through the same measure (`string/width->index`) — a 1:1 cell→char mapping put point one
  ;; character too far for every wide glyph left of the click.
  (test "a click column maps back through display width: a wide glyph is two cells, one char"
    (let (buf (cur (m-of "a😀b中c")))
      ; cells: a=0 😀=1,2 b=3 中=4,5 c=6
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 0) 0)
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 1) 1) ; on the emoji → before it
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 2) 1) ; its second cell → still before it
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 3) 2) ; b
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 5) 3) ; second cell of 中
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 6) 4) ; c
      (assert= (ed-buf-offset-at buf 0 0 0 1 0 40) 5) ; past the end → the end
      ;; and it agrees with the caret: the cell the view draws point at maps back to point
      (is (every? (range 0 6)
            (fn (p)
              (= (ed-buf-offset-at buf 0 0 0 1 0 (ed-visual-column-from (goto-char buf p) 0)) p))))))
  (test "a click column past a wide glyph under hscroll starts counting at the first shown char"
    (let (buf (cur (m-of "😀😀abc")))
      ;; hscroll 1 shows "😀abc": cells 😀=0,1 a=2 b=3; a click at cell 3 is b (char 3)
      (assert= (ed-buf-offset-at buf 0 1 0 1 0 3) 3)
      (assert= (ed-visual-column-from (goto-char buf 3) 1) 3))))
(describe "editor scrolling"
  (test "the point line stays inside the viewport after moving past the bottom"
    (let (text "l0\nl1\nl2\nl3\nl4"
          m (ed-scroll (ed-set-buf (m-of text) (end-of-buffer (cur (m-of text)))) 2)
          line (buffer-current-line (cur m))
          top (ed-current-top m))
      (is (>= line top))
      (is (< line (+ top 2))))))

(describe "editor scrolling — margin, recenter, window-line (slick navigation)"
  ;; an N-line buffer (each line is its index); `at` puts point at line `ln`, view at `top`.
  (defn lines-of (n) (string/join (map (range n) str) "\n"))
  (defn nav-at (text ln top)
    (ed-set-top (ed-set-buf (m-of text) (forward-line (make-buffer text) ln)) top))

  (test "scroll-margin: point within the bottom margin doesn't scroll, one past it does"
    (let (t (lines-of 50))
      ;; viewport 20, margin 4 → last comfortable line is top+20-1-4 = 15
      (assert= (ed-current-top (ed-scroll (nav-at t 15 0) 20)) 0)
      (assert= (ed-current-top (ed-scroll (nav-at t 16 0) 20)) 1)))
  (test "scroll-margin keeps context above point too"
    (assert= (ed-current-top (ed-scroll (nav-at (lines-of 50) 4 10) 20)) 0))
  (test "C-v scrolls the view with the page (preserve screen position); M-v round-trips point"
    (let (t (lines-of 50)
          m1 (ed-update (m-of t) :ctrl-v 80 24)
          m2 (ed-update m1 :alt-v 80 24))
      (is (> (ed-current-top m1) 0)) ; the view followed the page, not just point
      (assert= (buffer-current-line (cur m2)) 0))) ; C-v then M-v returns to the start
  (test "C-l recenters point to the middle, then top, then bottom (cycling on repeat)"
    (let (t (lines-of 50) ; view-rows 22, margin 4
          mid (ed-update (nav-at t 30 0) :ctrl-l 80 24)
          tp (ed-update mid :ctrl-l 80 24)
          bot (ed-update tp :ctrl-l 80 24))
      (assert= (- 30 (ed-current-top mid)) 11) ; middle row (22/2)
      (assert= (- 30 (ed-current-top tp)) 4) ; top + margin
      (assert= (- 30 (ed-current-top bot)) 17))) ; bottom - margin
  (test "M-r moves point to window top, then middle, then bottom (cycling on repeat)"
    (let (t (lines-of 50)
          a (ed-update (nav-at t 0 10) :alt-r 80 24)
          b (ed-update a :alt-r 80 24)
          c (ed-update b :alt-r 80 24))
      (assert= (buffer-current-line (cur a)) 14) ; top(10) + margin(4)
      (assert= (buffer-current-line (cur b)) 21) ; top + rows/2
      (assert= (buffer-current-line (cur c)) 27))) ; top + rows-1-margin
  (test "M-} / M-{ move by paragraph (blank-line delimited)"
    (let (t "aa\nbb\n\ncc\ndd"
          fwd (ed-update (m-of t) (keyword "alt-}") 80 24)
          back (ed-update fwd (keyword "alt-{") 80 24))
      (is (> (buffer-point (cur fwd)) 0)) ; advanced toward the blank separator
      (assert= (buffer-point (cur back)) 0))) ; and back to the first paragraph
  (test "scrolling clamps at end-of-file (the last line never scrolls past the bottom)"
    ;; 50 lines, viewport 20, point on the last line → top can't exceed 50-20 = 30
    (assert= (ed-current-top (ed-scroll (nav-at (lines-of 50) 49 0) 20)) 30)))

(describe "editor view chrome — scroll indicator + scrollbar"
  (test "ed-scroll-pct: All / Top / Bot / NN%"
    (assert= (ed-scroll-pct 0 22 10) "All") ; whole buffer fits
    (assert= (ed-scroll-pct 0 10 100) "Top")
    (assert= (ed-scroll-pct 90 10 100) "Bot") ; last line visible
    (assert= (ed-scroll-pct 45 10 100) "50%"))
  (test "ed-scrollbar-ops draws one smooth frect pill — sub-cell, right-edge, at point's fraction"
    (let (ops (ed-scrollbar-ops (make-buffer (string/join (map (range 100) str) "\n"))
                0 10 79 0 1.0))
      (assert= (count ops) 1) ; a single sub-cell op, not per-row glyphs
      (let ([tag x y w h _face op _r] (first ops))
        (assert= tag :frect) ; the smooth rounded-rect primitive
        (is (and (> x 79.0) (< x 80.0))) ; hugs the right edge of column sx=79
        (assert= y 0.0) ; top=0 → thumb at the very top
        (assert= w *scrollbar-width*)
        (assert= op 1.0) ; full opacity passed through
        (is (< h 10.0))))) ; thumb shorter than the viewport
  (test "ed-scrollbar-ops is hidden when it fits, when faded out, and shown otherwise"
    ;; nothing to scroll (3 lines in a 10-row viewport) → no thumb
    (is (empty? (ed-scrollbar-ops (make-buffer "a\nb\nc") 0 10 79 0 1.0)))
    ;; overflowing buffer but opacity 0 (faded out / at rest) → no thumb
    (is (empty? (ed-scrollbar-ops (make-buffer (string/join (map (range 100) str) "\n"))
                  0 10 79 0 0.0)))
    ;; overflowing and visible → a thumb
    (is (not (empty? (ed-scrollbar-ops (make-buffer (string/join (map (range 100) str) "\n"))
                       0 10 79 0 1.0)))))
  ;; The fade is ONE model-wide budget, so before this the bar lit in every pane on any
  ;; scroll — including panes nothing had touched. It marks where you are, and you are in
  ;; one pane.
  (test "only the selected pane draws a scrollbar"
    (let (tall (string/join (map (range 200) str) "\n")
          split (press (m-of tall) [:ctrl-x "2"]) ; two panes on the same long buffer
          woken (ed-scrollbar-wake split) ; a scroll lights the bar
          panes (:panes (ed-body-layout woken 80 24))
          bars (fn (pane)
                 (seq/filter (ed-pane-ops woken pane)
                   (fn (op) (and (vector? op) (= (first op) :frect)
                              (>= (nth op 1) 78.0))))) ; the right-edge pill
          ;; the split leaves exactly one selected pane and one not; say so
          pane-of (fn (selected?)
                    (or (seq/find panes (fn (p) (= selected? (= true (:selected p)))))
                      (error "the split has no " (if selected? "selected" "unselected") " pane"))))
      (assert= (count panes) 2)
      (is (not (empty? (bars (pane-of true)))))
      (is (empty? (bars (pane-of false))))))
  (test "mouse hover (:move) never re-clamps scroll — no snap-back to point"
    ;; point at end, wheel-scrolled to the top; a bare hover must leave the viewport put.
    ;; (It used to snap `top` back to the cursor — the buffer 'scrolling while idle' bug.)
    (let (tall (string/join (map (range 200) str) "\n")
          atend (ed-update (m-of tall) (keyword "alt->") 80 24)
          scrolled (fold (range 90)
                     atend
                     (fn (m _) (ed-update m [:mouse :scroll-up nil 5 5 []] 80 24)))
          hovered (ed-update scrolled [:mouse :move nil 6 6 []] 80 24))
      (assert= (:top (ed-current-pane scrolled)) 0)
      (assert= (:top (ed-current-pane hovered)) 0)))
  (test "a key after scrolling away pulls point into view, not back to the top"
    ;; point at line 0; wheel down so it's off the top. Pressing Up must resume from the
    ;; visible area (point near the viewport), NOT snap the whole view back to line 0.
    (let (text (string/join (map (range 200) str) "\n")
          scrolled (fold (range 15)
                     (m-of text)
                     (fn (m _) (ed-update m [:mouse :scroll-down nil 5 5 []] 80 24)))
          up (ed-update scrolled :up 80 24))
      (assert= (buffer-current-line (ed-current-buf scrolled)) 0) ; the wheel left point put (off-screen)
      (is (> (buffer-current-line (ed-current-buf up)) 30)) ; Up resumed from the view…
      (is (> (ed-current-top up) 0))))) ; …not by jumping to the top
(describe "editor view"
  (test "the frame draws the first buffer line and places the cursor"
    (let (f (ed-view (m-of "hello\nworld") 80 24))
      (is (> (count (seq/filter f
                      (fn (op) (and (= (first op) :text) (includes? (nth op 3) "hello")))))
            0))
      (is (> (count (seq/filter f (fn (op) (= (first op) :cursor)))) 0))))
  (test "an active region is drawn with the selection tint"
    ;; region [0,3) over "abcdef" → a `face-region` (a :bg tint) op carrying "abc"
    ;; (match on the region's text to be specific).
    (let (m (press (m-of "abcdef") [(keyword "ctrl- ") :right :right :right])
          f (ed-view m 80 24)
          region-ops (seq/filter f
                       (fn (op)
                         (and (= (first op) :text)
                           (= (nth op 4 nil) theme/face-region)
                           (includes? (nth op 3 "") "abc")))))
      (is (> (count region-ops) 0))))
  (test "the region fills blank/short lines through end-of-line (rect bands, not just text)"
    ;; select [0,4) over "ab\\n\\ncd": through "ab", the blank line, to the start of "cd".
    ;; the blank line has no text to tint, so a `face-region` `rect` band covers it — the
    ;; full-width counterpart to the char-range tint, mirroring the hl-line band.
    (let (m (press (m-of "ab\n\ncd") [(keyword "ctrl- ") :right :right :right :right])
          f (ed-view m 80 24)
          region-rects (seq/filter f
                         (fn (op)
                           (and (= (first op) :rect)
                             (= (nth op 5 nil) theme/face-region)))))
      (is (> (count region-rects) 0))
      (is (> (count (seq/filter region-rects (fn (op) (= (nth op 1) 1)))) 0)))) ; the blank line's row
  (test "a model :overlay is drawn with its face (the isearch/query-replace highlight)"
    (let (m (assoc (m-of "abcdef") :overlays [{:start 0 :end 3 :face {:bg :yellow :fg :black}}])
          f (ed-view m 80 24)
          hl-ops (seq/filter f
                   (fn (op)
                     (and (= (first op) :text)
                       (= (nth op 4 nil) {:bg :yellow :fg :black})
                       (includes? (nth op 3 "") "abc")))))
      (is (> (count hl-ops) 0))))
  (test "an open minibuffer is rendered on the bottom row"
    (let (m (press (m-of "x") [:ctrl-x :ctrl-f])
          f (ed-view m 80 24)
          mb-ops (seq/filter f
                   (fn (op) (and (= (first op) :text) (includes? (nth op 3 "") "Find file:")))))
      (is (> (count mb-ops) 0))))
  (test "the mode line is a full-width bar (so it tracks a horizontal resize)"
    ;; the bar is now a `face-modeline` **fill rect** spanning the pane; its width tracks the
    ;; screen width at any size (segments are drawn on top of it).
    (let (ml-width (fn (cols)
                     (nth (seq/find (ed-view (m-of "hi") cols 24)
                            (fn (op)
                              (and (= (first op) :rect)
                                (= (nth op 5 nil) theme/face-modeline))))
                       3)))
      ; → w @3
      (assert= (ml-width 80) 80)
      (assert= (ml-width 150) 150)))) ; the fill spans the full width
(describe "a glide settles — a pane never rests between lines, and a click lands on the row it sees"
  (defn lines-text (n) (string/join (map (range n) (fn (i) (str "line-" i))) "\n"))
  (test "the settle timer is armed while a pane holds a fraction, and the snap rounds to the nearest line"
    (let (m (m-of (lines-text 60))
          ;; a runtime scroll delta of 0.7 lines: the pane sits between lines 0 and 1
          s (ed-update m [:mouse :scroll-down nil 5 5 [] 0.7] 80 24)
          pane (first (:panes (ed-body-layout s 80 24))))
      (assert= (get-in pane [:payload :top]) 0)
      (is (> (get-in pane [:payload :scroll-frac]) 0.5))
      (is (contains? (:timers s) :scroll-settle))
      (let (settled (ed-update s [:timer :scroll-settle] 80 24)
            p2 (first (:panes (ed-body-layout settled 80 24))))
        (assert= (get-in p2 [:payload :top]) 1) ; 0.7 rounds up
        (assert= (get-in p2 [:payload :scroll-frac]) 0.0)
        (is (not (contains? (:timers settled) :scroll-settle))))
      ;; a smaller fraction falls back
      (let (s2 (ed-update m [:mouse :scroll-down nil 5 5 [] 0.3] 80 24)
            settled (ed-update s2 [:timer :scroll-settle] 80 24))
        (assert= (get-in (first (:panes (ed-body-layout settled 80 24))) [:payload :top]) 0))))
  (test "before the snap, a click on a row selects the line the row mostly shows"
    (let (m (m-of (lines-text 60))
          s (ed-update m [:mouse :scroll-down nil 5 5 [] 0.7] 80 24)
          ;; row 3 of the text area shows most of line 4 (top 0 + row 3 + the 0.7 shift)
          clicked (ed-update s [:mouse :press :left 3 2 []] 80 24))
      (assert= (buffer-current-line (cur clicked)) 4))))

(describe "ed-pane-line-at — the one row→line mapping every hit-test uses"
  (defn lines-text (n) (string/join (map (range n) (fn (i) (str "line-" i))) "\n"))
  (test "a row maps to top + offset, scaled; below the text it is nil (hover) or the last line (click)"
    (let (m (m-of (lines-text 5))
          pane (first (:panes (ed-body-layout m 80 24)))
          buf (cur m))
      (assert= (ed-pane-line-at pane buf 0) 0)
      (assert= (ed-pane-line-at pane buf 4) 4)
      (is (nil? (ed-pane-line-at pane buf 5)))
      (assert= (ed-pane-line-at-clamped pane buf 20) 4)))
  (test "a resting fraction of half a line or more shifts every row to the next line"
    (let (m (m-of (lines-text 60))
          s (ed-update m [:mouse :scroll-down nil 5 5 [] 0.6] 80 24)
          pane (first (:panes (ed-body-layout s 80 24)))
          buf (cur s))
      (assert= (ed-pane-view-top pane buf) 1)
      (assert= (ed-pane-line-at pane buf 3) 4)
      ;; the link-hover hit-test and a drag go through the same owner
      (let (dragged (ed-update (ed-update s [:mouse :press :left 3 2 []] 80 24)
                      [:mouse :drag :left 5 4 []]
                      80
                      24))
        (assert= (buffer-current-line (cur dragged)) 6)))))

;; The inline completion preview is painted at the CURSOR's own cell, so it reads as the
;; line continuing rather than as a remark about it.
(describe "the inline completion preview paints at the cursor"
  (defn- pv-model (text point preview)
    (let (m (ed-init (goto-char (make-buffer text) point)))
      (assoc m
        :completion-preview preview
        :completion-preview-at [point (buffer-rope (ed-current-buf m))]
        :blink-on? true)))

  ;; Found by its TEXT, not its face: the line-number gutter is the same dim grey (both
  ;; are recessive), so a face match finds whichever op comes first.
  (defn- pv-op (m)
    (seq/find (ed-view m 60 12)
      (fn (op) (and (= (first op) :text) (= (nth op 3 "") "habetical")))))

  (test "the remainder is drawn on the point's row, at the point's column"
    (let (m (pv-model "alp" 3 {:start 0 :prefix "alp" :text "habetical"})
          op (pv-op m)
          ;; the cell the caret is on — the preview starts exactly there
          caret (seq/find (ed-view m 60 12) (fn (o) (= (first o) :cursor))))
      (is (not (nil? op)))
      (assert= (nth op 4 nil) view/face-completion-preview)
      (is (not (nil? caret)))
      (assert= (nth op 1) (nth caret 1)) ; same row
      (assert= (nth op 2) (nth caret 2)))) ; same column

  ;; The preview is computed on the idle beat, so between a keystroke and the recompute
  ;; the cached one describes text that has already moved on. Painting it there would put
  ;; somebody else's word after your cursor — the guard is the whole difference between a
  ;; suggestion and a lie.
  (test "a preview computed for other text is not painted"
    (let (m (pv-model "alp" 3 {:start 0 :prefix "alp" :text "habetical"})
          stale (assoc m :completion-preview-at [99 nil]))
      (is (nil? (pv-op stale)))))

  (test "nothing is painted while the minibuffer is open"
    ;; the cursor is down there, not in the buffer
    (let (m (pv-model "alp" 3 {:start 0 :prefix "alp" :text "habetical"}))
      (is (nil? (pv-op (assoc m :minibuffer {:prompt "x" :line "" :point 0})))))))
