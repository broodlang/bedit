;; hosted — a pool buffer backed by a buffer PROCESS, without any collab/presence layer:
;; the actor-architecture seam (docs/actor-architecture.md) every buffer will ride.
;; The tests play the editor process themselves (the collab_test pattern): host a slot,
;; drive real keys through ed-update (the loop-tail hosted-step propagates), receive the
;; process's pushes and fold them back through ed-update — asserting convergence, echo
;; suppression, untouched window-local points, and clean unhosting. No node, no window.
(defmodule hosted-test
  (:use hosted)
  (:use model)
  (:use input)
  (:use commands)  ; ed-open-buffer / ed-select / cmd-kill-buffer — the flip's pool ops
  (:use collab)    ; collab-autoshare / collab-registry-* — the re-link seam
  (:use editor/buffer)
  (:use test))

(defn ht-text (m) (buffer-text (ed-current-buf m)))
(defn ht-press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))

;; Wait for the next push from `proc` and return the raw [v view origin] (or :none).
(defn ht-await (proc)
  (receive ([:buffer-updated ^proc v view o] [v view o]) (after 2000 :none)))

;; A BARRIER, not a delay: `buffer-query` is a synchronous round-trip, and a mailbox is
;; FIFO per sender — when the reply lands, every message we sent `proc` before it has been
;; handled and every push it made in response is already queued on us. So the drain below
;; never has to wait, and an "expect nothing" assertion after it is strict rather than a
;; race with a timeout.
(defn ht-settle (proc) (buffer-query proc buffer-text) nil)

;; Drain until quiet (the seed push, marker announces, …).
(defn ht-drain (proc)
  (ht-settle proc)
  (ht-drain-now proc))

(defn ht-drain-now (proc)
  (receive ([:buffer-updated ^proc _ _ _] (ht-drain-now proc)) (after 0 nil)))

;; `:none` iff `proc` pushed us nothing — barrier first, so a push that merely hasn't
;; arrived yet fails the assertion instead of outrunning a timeout.
(defn ht-none (proc)
  (ht-settle proc)
  (receive ([:buffer-updated ^proc v view o] [v view o]) (after 0 :none)))

;; THE [:down] for `pid` specifically — earlier tests' stopped-but-still-monitored
;; procs can leave stale corpse messages queued; skip (consume) any that aren't ours.
(defn ht-await-down (pid)
  (receive ([:down r p rsn] (if (= p pid) [:down r p rsn] (ht-await-down pid)))
    (after 2000 :none)))

(describe "hosted — a pool buffer backed by a buffer process" :isolated

  (test "ed-host-slot spawns from the slot's cache; the process holds the same text"
    (let (m (ed-host-slot (ed-init (make-buffer "hello" "h.txt")) 0)
          proc (get-in m [:hosted 0 :proc]))
      (is (ed-hosted? m 0))
      (assert= (buffer-query proc buffer-text) "hello")
      (ht-drain proc)
      (stop-buffer proc)))

  (test "typing through ed-update converges the process (the loop-tail hosted-step)"
    (let (m (ed-host-slot (ed-init (make-buffer "hello" "t.txt")) 0)
          proc (get-in m [:hosted 0 :proc]))
      (ht-drain proc)
      (let (m2 (ht-press m ["!"]))
        (assert= (ht-text m2) "!hello")                    ; local-apply-first (point 0)
        (assert= (count (get-in m2 [:hosted 0 :pending])) 1)  ; splice in flight
        (let ([v view o] (ht-await proc))
          (assert= (get view :splice) [0 0 "!"])           ; the DELTA, not the document
          (assert= (buffer-query proc buffer-text) "!hello")
          ;; the echo folds back through ed-update as a version bump: pending drains,
          ;; content untouched (never rebuilt from our own round-trip)
          (let (m3 (ed-update m2 [:buffer-updated proc v view o] 80 24))
            (assert= (ht-text m3) "!hello")
            (assert= (get-in m3 [:hosted 0 :version]) v)
            (assert= (get-in m3 [:hosted 0 :pending]) ()))))
      (stop-buffer proc)))

  (test "a foreign splice folds into the pool cache; the pane's window-local point stays"
    (let (m0 (ed-host-slot (ed-init (make-buffer "hello" "f.txt")) 0)
          proc (get-in m0 [:hosted 0 :proc])
          ;; park the pane cursor at 5 (window-local)
          m (ed-set-buf m0 (goto-char (ed-current-buf m0) 5)))
      (ht-drain proc)
      (buffer-splice proc 0 0 ">" :someone-else)
      (let ([v view o] (ht-await proc)
            m2 (ed-update m [:buffer-updated proc v view o] 80 24))
        (assert= (ht-text m2) ">hello")
        (assert= (get (ed-current-pane m2) :point) 5))     ; untouched by the push
      (stop-buffer proc)))

  (test "a push is not echoed back (hosted-step skips [:buffer-updated] inputs)"
    (let (m (ed-host-slot (ed-init (make-buffer "hi" "e.txt")) 0)
          proc (get-in m [:hosted 0 :proc]))
      (ht-drain proc)
      (buffer-splice proc 2 2 "!" :someone-else)
      (let ([v view o] (ht-await proc)
            m2 (ed-update m [:buffer-updated proc v view o] 80 24))
        (assert= (ht-text m2) "hi!")
        ;; folding the push changed the pool text, but hosted-step must NOT diff that
        ;; change back out as a new splice — no further push arrives
        (assert= (ht-none proc) :none))
      (stop-buffer proc)))

  (test "ed-unhost-slot with stop? reverts to a plain pool buffer and stops the process"
    (let (m (ed-host-slot (ed-init (make-buffer "bye" "u.txt")) 0)
          proc (get-in m [:hosted 0 :proc]))
      (ht-drain proc)
      (let (m2 (ed-unhost-slot m 0 true))
        (is (not (ed-hosted? m2 0)))
        (is (nil? (get-in m2 [:hosted 0])))
        ;; the pool copy lives on as an ordinary buffer; edits stay local
        (assert= (ht-text (ht-press m2 ["x"])) "xbye"))))

  (test "hosted-slot-for-proc finds the slot; unrelated procs map to nil"
    (let (m (ed-host-slot (ed-init (make-buffer "a" "s.txt")) 0)
          proc (get-in m [:hosted 0 :proc]))
      (ht-drain proc)
      (assert= (hosted-slot-for-proc m proc) 0)
      (is (nil? (hosted-slot-for-proc m :not-a-proc)))
      (stop-buffer proc))))

;; ---- the every-buffer flip: :host-buffers? + hosted-reconcile at the loop tail ----

(describe "hosted — the every-buffer flip" :isolated

  (test "a flagged model hosts every pool slot on the first event; typing converges"
    (let (m1 (ht-press (assoc (ed-init (make-buffer "hello" "flip.txt")) :host-buffers? true)
               [:right]))
      (is (ed-hosted? m1 0))
      (is (ed-hosted? m1 1))                             ; *Messages* too
      (let (proc (get-in m1 [:hosted 0 :proc]))
        (ht-drain proc)
        (let (m2 (ht-press m1 ["!"]))
          (assert= (buffer-query proc buffer-text) "h!ello")   ; point was at 1 after :right
          (ed-unhost-slot (ed-unhost-slot m2 0 true) 1 true)))))

  (test "an unflagged (headless/test) model hosts nothing — the pure suite stays pure"
    (is (nil? (get (ht-press (ed-init (make-buffer "x")) [:right "y"]) :hosted))))

  (test "kill-buffer stops the killed slot's local process and remaps surviving links"
    (let (m0 (assoc (ed-init (make-buffer "aaa" "a.txt")) :host-buffers? true)
          m1 (ed-open-buffer m0 (make-buffer "bbb" "b.txt"))  ; slot 2, selected
          m2 (ht-press m1 [:right])                           ; reconcile hosts 0/1/2
          pa (get-in m2 [:hosted 0 :proc])
          pb (get-in m2 [:hosted 2 :proc])
          mref (monitor pa)
          m3 (cmd-kill-buffer (ed-select m2 0) nil))          ; kill slot 0 (a.txt)
      (assert= (receive ([:down ^mref _ _] :dead) (after 2000 :alive)) :dead)
      ;; pool shifted: *Messages* 1→0, b.txt 2→1 — the links followed
      (assert= (get-in m3 [:hosted 1 :proc]) pb)
      (is (nil? (get-in m3 [:hosted 2])))
      (ed-unhost-slot (ed-unhost-slot m3 0 true) 1 true)))

  (test "kill-buffer through the LOOP TAIL ships no cross-document splice (index skew)"
    ;; the review bug: after a kill shifts the pool, diffing before/after BY INDEX
    ;; compares different documents and would ship corrupting splices to every
    ;; surviving process above the kill — hosted-drop-slot's :pool-shifted stamp
    ;; makes hosted-step skip the diff for exactly that event
    (let (m0 (assoc (ed-init (make-buffer "aaaa" "a.txt")) :host-buffers? true)
          m1 (ed-open-buffer m0 (make-buffer "bbbbbbbb" "b.txt"))
          m2 (ht-press m1 [:right])                       ; reconcile hosts 0/1/2
          pb (get-in m2 [:hosted 2 :proc])
          pm (get-in m2 [:hosted 1 :proc])
          ;; kill a.txt (slot 0) THROUGH ed-update — the loop tail runs after it
          m3 (ht-press (ed-select m2 0) [:ctrl-x "k"]))
      (assert= (buffer-query pb buffer-text) "bbbbbbbb")  ; b.txt's process untouched
      (assert= (buffer-query pm buffer-text)
        (buffer-text (ed-buf-at m3 0)))                   ; *Messages* still converged
      ;; …and the survivors still track edits (links point at the right processes):
      ;; the invariant is CONVERGENCE — the process holds exactly the pool's text
      (let (m4 (ht-press (ed-select m3 1) ["Z"])) ; type into b.txt (now slot 1)
        (assert= (buffer-query pb buffer-text) (buffer-text (ed-buf-at m4 1)))
        (is (includes? (buffer-query pb buffer-text) "Z"))
        (ed-unhost-slot (ed-unhost-slot m4 0 true) 1 true))))

  (test "a push-fold's edits to OTHER slots still propagate (only the pushed slot is exempt)"
    ;; the review bug: skipping propagation for the whole [:buffer-updated] event let
    ;; a fold's *Messages* append (presence echo) silently diverge from its process
    (let (m1 (ht-press (assoc (ed-init (make-buffer "doc" "x.txt")) :host-buffers? true)
               [:right])
          p0 (get-in m1 [:hosted 0 :proc])
          pm (get-in m1 [:hosted 1 :proc]))
      (ht-drain p0)
      (ht-drain pm)
      ;; simulate a fold that rewrote slot 0 from its process's truth AND appended to
      ;; *Messages* in the same event
      (let (m2 (ed-append-named m1 "*Messages*" "bob joined\n")
            m3 (hosted-step m1 m2 [:buffer-updated p0 99 {:splice [0 0 "!"]} nil]))
        ;; slot 0 was exempt (nothing sent for it: its rope didn't change here anyway),
        ;; but *Messages*' append reached its process
        (assert= (buffer-query pm buffer-text)
          (buffer-text (ed-buf-at m3 1)))
        (ed-unhost-slot (ed-unhost-slot m3 0 true) 1 true))))

  (test "fault isolation: a killed local buffer process is rehosted from the cache"
    (let (m1 (ht-press (assoc (ed-init (make-buffer "safe" "fi.txt")) :host-buffers? true)
               [:right])
          p1 (get-in m1 [:hosted 0 :proc]))
      (ht-drain p1)
      (exit p1 :kill)
      ;; the monitor's [:down] lands in this (editor-shaped) process's mailbox —
      ;; feed it through ed-update like the loop would
      (let (down (ht-await-down p1)
            m2 (ed-update m1 down 80 24)
            p2 (get-in m2 [:hosted 0 :proc]))
        (is (not (= p1 p2)))
        (assert= (buffer-query p2 buffer-text) "safe")     ; recovered from the pool cache
        (is (includes? (get m2 :echo) "restarted"))
        ;; the fresh process tracks new edits (the loop-tail propagate re-linked)
        (ht-drain p2)
        (let (m3 (ht-press m2 ["!"]))                       ; point 1 after :right
          (assert= (buffer-query p2 buffer-text) "s!afe")
          (ed-unhost-slot (ed-unhost-slot m3 0 true) 1 true)))))

  (test "a [:down] for a pid backing no slot is ignored"
    (let (m (ed-init (make-buffer "x"))
          m2 (ed-update m [:down :ref :not-a-proc :killed] 80 24))
      (assert= (buffer-text (ed-current-buf m2)) "x")))

  (test "collab-autoshare re-links a locally hosted file buffer to the registry's process"
    (let (m1 (ht-press (assoc (ed-init (make-buffer "shared" "as.txt" "/tmp/as.txt"))
                         :host-buffers? true)
               [:right])                                      ; locally hosted now
          local (get-in m1 [:hosted 0 :proc])
          mref (monitor local)
          reg (collab-registry-start)
          m2 (collab-autoshare (assoc m1 :collab-reg reg))
          sp (get-in m2 [:hosted 0 :proc]))
      (is (not (= local sp)))                                 ; the registry's proc took over
      (is (collab-shared? m2 0))
      (assert= (receive ([:down ^mref _ _] :dead) (after 2000 :alive)) :dead)  ; local stopped
      (assert= (buffer-query sp buffer-text) "shared")
      (collab-registry-stop reg)
      (ed-unhost-slot m2 1 true))))
