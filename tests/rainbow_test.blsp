;; Brackets coloured by depth over a tree-sitter parse (src/rainbow.blsp) — Ruby's grammar,
;; which the runtime is built with.
(defmodule rainbow-test
  (:use test))

(defn- depths (src from to)
  ;; `[offset depth]` for each bracket coloured between `from` and `to` of `src` parsed as Ruby
  (let (tree (editor/treesit/open-tree src :ruby)
        found (rainbow/window-ranges tree (text/string-> src) from to (fn (depth) depth)))
    (editor/treesit/free-tree tree)
    (vec (map found (fn (range) [(first range) (nth range 2)])))))

(describe "rainbow brackets (tree-sitter)"
  (test "each pair one depth, the outermost 1"
    (let (src "f(a, [b, {c: (1)}])\n")
      (assert= (depths src 0 (count src))
        [[1 1] [5 2] [9 3] [13 4] [15 4] [16 3] [17 2] [18 1]])))
  (test "a bracket in a string or a comment is not a delimiter"
    (let (src "f(\"(\", 1) # (\n")
      (assert= (depths src 0 (count src)) [[1 1] [8 1]])))
  (test "a window that starts inside brackets starts at their depth"
    (let (src "f(\n  [1,\n   (2)])\n"
          from (index-of src "   (2)")
          tree (editor/treesit/open-tree src :ruby)
          depth (rainbow/depth-at tree (text/string-> src) from))
      (editor/treesit/free-tree tree)
      (assert= depth 2)
      (assert= (depths src from (count src))
        [[(+ from 3) 3] [(+ from 5) 3] [(+ from 6) 2] [(+ from 7) 1]])))
  (test "depths past the ninth cycle back to the first face"
    (assert= (rainbow/depth-name 10) :syntax/delimiter-1)
    (assert= (rainbow/depth-name 9) :syntax/delimiter-9)))

(describe "rainbow brackets in the editor"
  (test "a Ruby buffer's held parse colours its brackets in the pane, and only when on"
    (let (m0 (model/ed-init (editor/buffer/make-buffer "f(a, [b])\n" "a.rb" "a.rb"))
          m (input/ed-update m0 :ctrl-e 80 24)
          buf (model/ed-current-buf m)
          was theme/*rainbow-delimiters*
          _ (theme/set-rainbow-delimiters true)
          on (rainbow/ranges m 0 buf 0 10)
          _ (theme/set-rainbow-delimiters false)
          off (rainbow/ranges m 0 buf 0 10)
          _ (theme/set-rainbow-delimiters was))
      (is (not (nil? (syntaxtree/current-syntax-tree m 0 buf))))
      (assert= (vec (map on first)) [1 5 7 8])
      (assert= off ()))))

(describe "M-x rainbow-delimiters-mode"
  (test "turns the colours on and off for the session, saying so"
    (let (before theme/*rainbow-delimiters*
          once (rainbow/cmd-rainbow-delimiters-mode (model/ed-init (editor/buffer/make-buffer ""))
                 nil)
          after-once theme/*rainbow-delimiters*
          twice (rainbow/cmd-rainbow-delimiters-mode once nil))
      (assert= after-once (not before))
      (assert= theme/*rainbow-delimiters* before)
      (is (includes? (:echo twice) (if before "on" "off"))))))
