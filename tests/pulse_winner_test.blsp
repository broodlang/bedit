;; Two window habits from the user's Emacs: pulsar's flash after a jump (src/pulse.blsp) and
;; winner-mode's undo of window layouts (src/winner.blsp). Both run as post-step rows, so
;; the tests drive real events through `input/ed-update`.
(defmodule pulse-winner-test
  (:use test)
  (:use model)
  (:use editor/buffer))

(defn- lines (n) (string/join (map (range n) (fn (i) (str "line " i))) "\n"))

(defn- keys (m pressed) (fold pressed m (fn (acc key) (input/ed-update acc key 80 24))))

(defn- pane-count (m) (count (:panes (panes/ed-body-layout m 80 24))))

(describe "pulse: a flash after a jump"
  (test "a jump by a key command pulses the line point lands on"
    (let (m (keys (assoc (ed-init (make-buffer (lines 60))) :pulse-on true) [:ctrl-n]))
      (is (nil? (:pulse m))) ; one line is not a jump
      (let (jumped (keys m [:alt->]))
        (assert= (:line (:pulse jumped)) (buffer-current-line (ed-current-buf jumped)))
        (assert= (:level (:pulse jumped)) 1.0))))
  (test "typing never pulses"
    (let (m (keys (assoc (ed-init (make-buffer "")) :pulse-on true) ["a" :enter "b" :enter "c"]))
      (is (nil? (:pulse m)))))
  (test "a mouse click far away does not pulse — only a key command jumps"
    (let (m (keys (assoc (ed-init (make-buffer (lines 60))) :pulse-on true) [:ctrl-n])
          clicked (input/ed-update m [:mouse :press :left 20 6] 80 24))
      (is (> (buffer-current-line (ed-current-buf clicked)) 10))
      (is (nil? (:pulse clicked)))))
  (test "a jump through the minibuffer pulses: M-g g 50 RET"
    (let (m (keys (assoc (ed-init (make-buffer (lines 60))) :pulse-on true) [:ctrl-n])
          jumped (keys m [:alt-g "g" "5" "0" :enter]))
      (assert= (buffer-current-line (ed-current-buf jumped)) 49)
      (assert= (:line (:pulse jumped)) 49)))
  (test "the pulse fades away tick by tick"
    (let (m (keys (assoc (ed-init (make-buffer (lines 60))) :pulse-on true) [:ctrl-n :alt->])
          faded (fold (range 20) m (fn (acc _) (pulse/fade acc))))
      (is (< (:level (:pulse (pulse/fade m))) 1.0))
      (is (nil? (:pulse faded)))
      (is (nil? (pulse/timer-spec faded)))))
  (test "off, nothing pulses"
    (is (nil? (:pulse (keys (ed-init (make-buffer (lines 60))) [:ctrl-n :alt->]))))))

(describe "winner: undo and redo of window layouts"
  (test "C-c ← undoes a split, C-c → redoes it"
    (let (m (keys (assoc (ed-init (make-buffer "x")) :winner-on true) [:ctrl-n])
          split (keys m [:ctrl-x "2"])
          undone (keys split [:ctrl-c :left])
          redone (keys undone [:ctrl-c :right]))
      (assert= (pane-count split) 2)
      (assert= (pane-count undone) 1)
      (assert= (pane-count redone) 2)))
  (test "moving point is not a layout change"
    (let (m (keys (assoc (ed-init (make-buffer (lines 10))) :winner-on true)
              [:ctrl-n :ctrl-n :alt->]))
      (assert= (count (or (:winner-undo m) '())) 0)))
  (test "a layout whose buffer was killed is skipped, never shown with another buffer"
    ;; A, then B, then C shown in the one window; kill A; C-c ← goes back to B
    (let (m (assoc (ed-init (make-buffer "a" "A")) :winner-on true)
          m (pool/ed-open-buffer m (make-buffer "b" "B"))
          m (keys m [:ctrl-n])
          m (pool/ed-open-buffer m (make-buffer "c" "C"))
          m (keys m [:ctrl-n])
          killed (pool/ed-kill-at m (ed-buffer-index-by-name! m "A") false)
          killed (keys killed [:ctrl-n])
          undone (keys killed [:ctrl-c :left]))
      (assert= (buffer-name (ed-current-buf undone)) "B")))
  (test "previewing buffers in C-x b is not a layout change"
    (let (m (assoc (ed-init (make-buffer "a" "A")) :winner-on true)
          m (pool/ed-open-buffer m (make-buffer "b" "B"))
          m (keys m [:ctrl-n])
          before (count (or (:winner-undo m) '()))
          previewed (keys m [:ctrl-x "b" :ctrl-n :ctrl-n :ctrl-g]))
      (assert= (count (or (:winner-undo previewed) '())) before)))
  (test "with nothing to undo it says so"
    (let (m (keys (assoc (ed-init (make-buffer "x")) :winner-on true) [:ctrl-n :ctrl-c :left]))
      (is (includes? (:echo m) "no earlier window layout")))))
