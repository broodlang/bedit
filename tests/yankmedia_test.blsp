;; M-x yank-media (src/yankmedia.blsp, Emacs 29's yank-media): a clipboard image put in by the
;; buffer's mode — Markdown and Org save it beside the file and link it. The clipboard and the
;; write are stand-ins (`*image-reader*`, `*image-writer*`), so no real clipboard is read.
(defmodule yankmedia-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use yankmedia) ; *image-reader* / *image-writer*: the clipboard and the write, stood in
  (:use-internals input)) ; ed-ensure-layers: a named buffer's modes

(def- fake-image {:png "PNG bytes" :width 3 :height 2})

(defn- visiting (name text)
  ;; a model on a fresh file `name` in its own temp directory, its mode layers on, with a
  ;; local clipboard to read
  (let (dir (temp-dir "bedit-yankmedia-")
        _ (file/mkdir dir)
        path (path/join dir name))
    (do
      (file/spit path text)
      (assoc (input/ed-ensure-layers (ed-init (make-buffer text path path))) :os-clipboard true))))

(defn- yank (m image)
  ;; M-x yank-media with `image` on the clipboard
  (binding (*image-reader* (fn () image)) (yankmedia/cmd-yank-media m nil)))

(defn- answer (m name writes)
  ;; type `name` at the prompt, every write going to the process `writes` collects into
  (binding (*image-writer* (fn (path png) (send writes [path png])))
    ((:on-complete (:minibuffer m)) (dissoc m :minibuffer) name)))

(defn- collected (writes)
  ;; the reply is tagged and matched: a catch-all took whatever came first, and in CI that
  ;; was a `[:down …]` from a process the command had monitored
  (do (send writes [:get (self)]) (receive ([:collected got] got))))

(defn- collector ()
  (spawn (letrec (go (fn (acc)
                       (receive
                         ([:get from] (do (send from [:collected acc]) (go acc)))
                         (write (go (conj acc write))))))
           (go []))))

(describe "M-x yank-media in a Markdown or Org buffer"
  (test "the path is asked with the file prompt, a timestamped PNG beside the file by default"
    (let (asked (yank (visiting "notes.md" "# notes\n") fake-image))
      (is (:minibuffer asked))
      (is (:complete-fn (:minibuffer asked)))
      (is (string/starts-with? (path/basename (minibuffer/mb-text (:minibuffer asked))) "image-"))
      (is (string/ends-with? (minibuffer/mb-text (:minibuffer asked)) ".png"))))
  (test "Markdown: the PNG written beside the file, ![](name) inserted at point"
    (let (m (visiting "notes.md" "")
          writes (collector)
          done (answer (yank m fake-image) "shot.png" writes)
          directory (path/dirname (or (:file (ed-current-buf m))
                                    (error "the buffer visits no file"))))
      (assert= (collected writes) [[(path/join directory "shot.png") (:png fake-image)]])
      (assert= (buffer-text (ed-current-buf done)) "![](shot.png)")))
  (test "Org: [[file:name]] inserted"
    (let (done (answer (yank (visiting "notes.org" "") fake-image) "a.png" (collector)))
      (assert= (buffer-text (ed-current-buf done)) "[[file:a.png]]")))
  (test "a name already taken is asked about: n writes and inserts nothing, y writes over it"
    (let (m (visiting "notes.md" "")
          directory (path/dirname (or (:file (ed-current-buf m))
                                    (error "the buffer visits no file")))
          _ (file/spit (path/join directory "taken.png") "x")
          writes (collector)
          done (answer (yank m fake-image) "taken.png" writes))
      (is (includes? (:echo done) "exists; overwrite?"))
      (let (key (fn (answer-key)
                  (binding (*image-writer* (fn (path png) (send writes [path png])))
                    ((:then (:read-char done)) (dissoc done :read-char) answer-key)))
            declined (key "n"))
        (assert= (collected writes) [])
        (assert= (buffer-text (ed-current-buf declined)) "")
        (let (taken (key "y"))
          (assert= (count (collected writes)) 1)
          (assert= (buffer-text (ed-current-buf taken)) "![](taken.png)")))))
  (test "the default name is the time it was yanked"
    (assert= (yankmedia/default-image-name 0) "image-19700101-000000.png")))

(describe "what yank-media says when it cannot"
  (test "a mode with no handler says so, and reads nothing"
    (let (m (visiting "plain.txt" "")
          said (binding (*image-reader* (fn () (error "read!")))
                 (yankmedia/cmd-yank-media m nil)))
      (is (includes? (:echo said) "no media handler"))))
  (test "a clipboard with no image says so"
    (is (includes? (:echo (yank (visiting "notes.md" "") nil)) "no image on the clipboard")))
  (test "a read that fails says so"
    (let (said (binding (*image-reader* (fn () (error "wedged")))
                 (yankmedia/cmd-yank-media (visiting "notes.md" "") nil)))
      (is (includes? (:echo said) "could not be read"))))
  (test "a served session's clipboard is the client's: said, not read"
    (let (m (assoc (visiting "notes.md" "") :os-clipboard nil :client-clipboard true))
      (is (includes? (:echo (yank m fake-image)) "client"))))
  (test "M-x knows the command"
    (is (includes? (interactive/command-names) "yank-media"))))
