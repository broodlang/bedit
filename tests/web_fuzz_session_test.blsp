(defmodule web-fuzz-session-test
  (:use testkit :only [press cur]) ; the shared test helpers (tests/support)
  (:use model)
  (:use input)
  (:use pool)
  (:use commands)
  (:use view)
  (:use web)
  (:use gitstatus) ; cmd-git-status / cmd-git-visit
  (:use editor/buffer)
  (:use test))

(defn beat (m) (ed-update m [:timer :idle-recompute] 80 24))
(defn tick (m) (ed-update m [:timer :spinner] 80 24))

(defn- fz-git (dir args) (os/cmd "git" args {:cwd dir}))

(defn- fz-repo ()
  "A repository with a FIXED history, built from three of the editor's real files: two commits,
an unstaged change, a staged one and an untracked file. The status, and each diff a preview
paints, are the same on every run — the real checkout's recent commits made the test take
13 s on one run and past its 120 s limit on another, depending on what was last committed."
  (let (dir (path/temp "bedit-web-fuzz-repo-")
        real (fn (path) (file/slurp path))
        lines (fn (text count) (string/join (take (string/split text "\n") count) "\n")))
    (os/cmd "rm" ["-rf" dir] {:cwd "/"})
    (file/mkdir dir)
    (file/mkdir (path/join dir "src"))
    (fz-git dir ["init" "-q" "-b" "main"])
    (fz-git dir ["config" "user.email" "t@example.com"])
    (fz-git dir ["config" "user.name" "Test"])
    (fz-git dir ["config" "commit.gpgsign" "false"])
    (file/spit (path/join dir "src/commands.blsp") (real "src/commands.blsp"))
    (file/spit (path/join dir "src/web.blsp") (lines (real "src/web.blsp") 400))
    (file/spit (path/join dir "project.blsp") (real "project.blsp"))
    (fz-git dir ["add" "-A"])
    (fz-git dir ["commit" "-qm" "base"])
    ;; a second commit: the rest of web.blsp
    (file/spit (path/join dir "src/web.blsp") (real "src/web.blsp"))
    (fz-git dir ["commit" "-qam" "the rest of web"])
    ;; staged: project.blsp; unstaged: a few lines into commands.blsp; untracked: a note
    (file/spit (path/join dir "project.blsp") (str (real "project.blsp") "\n;; staged\n"))
    (fz-git dir ["add" "project.blsp"])
    (file/spit (path/join dir "src/commands.blsp")
      (str (lines (real "src/commands.blsp") 300)
        "\n;; unstaged\n(def x 1)\n"
        (string/join (drop (string/split (real "src/commands.blsp") "\n") 300) "\n")))
    (file/spit (path/join dir "notes.txt") "untracked\n")
    dir))

;; Render the model and report whether the native view fell into its error frame.
(defn err? (m)
  ;; the error frame is `ed-view`'s fallback: a `render error: …` text at column 0 of the
  ;; echo row — NOT any op whose text contains the phrase (a diff preview of a file that
  ;; mentions it read as a failure once, 2026-09-15)
  (any? (rest (ed-view m 80 24))
    (fn (op)
      (and (vector? op)
        (= (first op) :text)
        (= (nth op 2) 0)
        (string/starts-with? (str (nth op 3)) "render error:")))))
;; Does web-snapshot throw for this model? (what would silently freeze the mirror)
(defn snap-throws? (m) (try (do (web-snapshot m) false) (catch e (error-message e))))

;; Assert a whole step-list keeps both the native view and the mirror healthy.
(defn check (label m)
  (do
    (when (err? m)
      (io/puts (str "RENDER ERROR after " label ": " (str (ed-view m 80 24)))))
    (let (st (snap-throws? m))
      (when st (io/puts (str "SNAPSHOT THREW after " label ": " st))))
    (refute (err? m))
    (assert= (snap-throws? m) false)))

(describe "full session fuzz on a fixture repo (web mirror running)"
  (test "open files, git status, diff previews (splits), switch, scroll, edit"
    (let (repo (fz-repo)
          m0 (assoc (ed-init (make-buffer "")) :server {:pub (self) :proc nil :port 0})
          ;; 1. open a big real file, scroll to the bottom, then open a tiny one
          m1 (beat (ed-find-file m0 (path/join repo "src/commands.blsp")))
          _ (check "open commands.blsp" m1)
          m2 (press m1 (list :page-down :page-down :page-down :page-down :page-down))
          _ (check "scrolled to bottom" m2)
          m3 (beat (ed-find-file m2 (path/join repo "project.blsp")))
          _ (check "switched to short project.blsp" m3)
          ;; 2. git status, then preview the diff of each of its rows in a split (the fixture's
          ;; status is a few rows; the cap guards a fixture that grows)
          m4 (beat (cmd-git-status m3 nil))
          _ (check "git-status" m4)
          rows-previewed 30
          nl (math/min rows-previewed (buffer-line-count (cur m4)))
          m5 (fold (range 0 nl)
               m4
               (fn (mm ln)
                 (let (rope (buffer-rope (cur mm))
                       mm2 (if (< ln (buffer-line-count (cur mm)))
                             (ed-set-buf mm (goto-char (cur mm) (text/line->char rope ln)))
                             mm)
                       mm3 (beat (cmd-git-visit mm2 nil)))
                   (check (str "git-visit at line " ln) mm3)
                   mm3)))
          ;; 3. from the split, switch the selected buffer back and forth, scroll, edit
          m6 (beat (ed-find-file m5 (path/join repo "src/web.blsp")))
          _ (check "find-file web.blsp into split" m6)
          m7 (press m6 (list :page-down :page-down "x" "y" :enter))
          _ (check "edit in split" m7)
          m8 (tick (beat m7))
          _ (check "idle + spinner beats" m8))
      (is true))))
