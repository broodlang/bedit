;; tests/keycolumns_test.blsp — keys and what they do, in titled groups, laid into columns: the
;; layout which-key's panel, a transient menu's card and the start page share (src/keycolumns).

(defmodule keycolumns-test
  (:use test)
  (:use keycolumns))

(defn- group (title size)
  ;; a group titled `title` with `size` one-letter entries
  {:title title :rows (vec (map (range size) (fn (n) {:key (str n) :text "x"})))})

(describe "an entry's cell"
  (test "the key column is as wide as the widest key, the text after the gap"
    (let (entries [{:key "f" :text "find"} {:key "C-x b" :text "buffer"}]
          width (key-width entries))
      (assert= width 5)
      (assert= (vec (map entries (fn (entry) (entry-cell entry width))))
        ["f      find" "C-x b  buffer"]))))

(describe "a group's lines"
  (test "a titled group leads with its heading; an untitled one has none"
    (assert= (vec (map (group-lines (group "G" 2)) first)) [:heading :row :row])
    (assert= (vec (map (group-lines (group nil 2)) first)) [:row :row])
    (assert= (vec (map (group-lines (group "" 1)) first)) [:row]))
  (test "a column of groups has a blank line between two, none at its ends"
    (assert= (vec (map (column-lines [(group "a" 1) (group "b" 1)]) first))
      [:heading :row :blank :heading :row])))

(describe "whole groups balanced over columns (a transient card)"
  (test "the groups split, in order, where the tallest column is shortest"
    (let (columns (balanced-columns [(group "a" 4) (group "b" 1) (group "c" 1) (group "d" 4)] 2))
      (assert= (vec (map columns (fn (column) (vec (map column :title))))) [["a" "b"] ["c" "d"]])))
  (test "one column when one is asked for, and none for no groups"
    (assert= (count (balanced-columns [(group "a" 2) (group "b" 2)] 1)) 1)
    (assert= (balanced-columns [] 3) [])))

(describe "groups flowing down then across (which-key's grid)"
  (test "a heading never ends a column: it moves to the next, with its rows"
    (let (rows 4
          lines (flow-lines [(group "a" 1) (group "b" 3)] rows))
      ;; `a` and its row, a blank, then `b`'s heading would be the column's last line
      (assert= (vec (map lines first)) [:heading :row :blank :blank :heading :row :row :row])
      (doseq (index (range (count lines)))
        (when (= (first (nth lines index)) :heading)
          (is (not (= (math/mod index rows) (dec rows))))))))
  (test "a group that opens a column has no blank above it"
    (assert= (vec (map (flow-lines [(group "a" 1) (group "b" 1)] 2) first))
      [:heading :row :heading :row])))

(describe "a grid of cells"
  (test "cells run down then across, as many columns as fit the width"
    (assert= (grid-rows ["a" "b" "c" "d" "e"] 2 20 0 str) '("a   c   e" "b   d")))
  (test "more cells than fit are paged, each page ending in its label, and the page wraps"
    (let (cells (vec (map (range 9) (fn (n) (str "k" n))))
          label (fn (index total) (str index "/" total))
          first-page (grid-rows cells 2 10 0 label)
          wrapped (grid-rows cells 2 10 3 label))
      ;; two columns of two fit in ten cells: three cells and the label a page
      (assert= first-page '("k0   k2" "k1   1/3"))
      (is (includes? (string/join (grid-rows cells 2 10 -1 label) " ") "3/3"))
      ;; one past the last page is the first again
      (assert= wrapped first-page))))
