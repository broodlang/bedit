;; The invisible format characters are shown (src/glyphless.blsp, brood ADR-556): a zero
;; width space, a bidi control, a BOM in mid-text lay out as a `<200b>` escape in every
;; measure — the paint, the caret, a click, a wrap — and the view gives the escape its face.
(defmodule glyphless-test
  (:use test)
  (:use model)
  (:use input) ; ed-update
  (:use window-commands)
  (:use commands) ; cmd-visual-line-mode
  (:use editor/buffer))

(defn- cur (m) (ed-current-buf m))
(defn- press (m keys cols) (fold keys m (fn (acc k) (ed-update acc k cols 24))))

(defn- text-ops (frame)
  ;; every `[:text row col string face]` op of a frame
  (seq/filter frame (fn (op) (and (vector? op) (= (first op) :text)))))

(defn- caret-column (frame)
  (nth (seq/find frame (fn (op) (and (vector? op) (= (first op) :cursor)))) 2))

(defn- with-glyphless (how thunk)
  ;; `(thunk)` with the editor showing glyphless characters `how` — bound, not set: the
  ;; tests run side by side, and every one reads the setting
  (binding (*glyphless-chars* how) (thunk)))

(describe "the view shows a glyphless character as its escape"
  (test "a zero width space is painted `<200b>`, and no raw one reaches the painter"
    (let (frame (view/ed-view (ed-init (make-buffer "ab\u{200b}cd")) 60 10)
          texts (map (text-ops frame) (fn (op) (str (nth op 3 "")))))
      (is (any? texts (fn (text) (includes? text "<200b>"))))
      (is (not (any? texts (fn (text) (includes? text "\u{200b}")))))))
  (test "the escape is painted in the escape face, a bidi control in the hazard face"
    (let (frame (view/ed-view (ed-init (make-buffer "x\u{200b}y\u{202e}z")) 60 10)
          face-of (fn (shown)
                    (nth (seq/find (text-ops frame) (fn (op) (= (nth op 3 nil) shown))) 4 nil)))
      (assert= (:fg (face-of "<200b>")) (:fg glyphless/face-glyphless))
      (assert= (:bg (face-of "<202e>")) (:bg glyphless/face-glyphless-bidi))))
  (test "the text after the escape is pushed right by its six cells"
    (let (frame (view/ed-view (ed-init (make-buffer "a\u{200b}bc")) 60 10)
          column-of (fn (shown)
                      (nth (seq/find (text-ops frame) (fn (op) (= (nth op 3 nil) shown))) 2 nil)))
      (assert= (column-of "<200b>") (+ (column-of "a") 1))
      (assert= (column-of "bc") (+ (column-of "<200b>") 6))))
  (test ":hidden shows nothing, as before"
    (with-glyphless :hidden
      (fn ()
        (let (texts (map (text-ops (view/ed-view (ed-init (make-buffer "ab\u{200b}cd")) 60 10))
                      (fn (op) (str (nth op 3 "")))))
          (is (not (any? texts (fn (text) (includes? text "<200b>"))))))))))

(describe "point, the caret and a click agree with the escape"
  (test "C-f steps over the character, and the caret lands after its escape"
    (let (m (ed-init (make-buffer "a\u{200b}b"))
          before (press m [:ctrl-a :ctrl-f] 60)
          after (press before [:ctrl-f] 60))
      (assert= (buffer-point (cur before)) 1)
      (assert= (buffer-point (cur after)) 2)
      (assert= (- (caret-column (view/ed-view after 60 10))
                 (caret-column (view/ed-view before 60 10)))
        6)))
  (test "a click on any cell of the escape lands before the character, after it past it"
    (let (buf (make-buffer "a\u{200b}b"))
      (assert= (mouse/ed-buf-offset-at buf 0 0 0 1 0 0) 0)
      (assert= (mouse/ed-buf-offset-at buf 0 0 0 1 0 1) 1)
      (assert= (mouse/ed-buf-offset-at buf 0 0 0 1 0 6) 1)
      (assert= (mouse/ed-buf-offset-at buf 0 0 0 1 0 7) 2)))
  (test "C-n keeps the column the view shows across a line holding an escape"
    ;; the end of `a<200b>b` is column 8; the next line is long enough to reach it
    (let (m (ed-init (make-buffer "a\u{200b}b\nabcdefghijklmnop"))
          moved (press m [:ctrl-e :ctrl-n] 80))
      (assert= (buffer-column (cur moved)) 8)))
  (test "a wrapped line breaks where the escapes take the room"
    ;; `ab` + three escapes + `cd` is 2 + 18 + 2 cells, and an escape is never split: rows
    ;; of 12 are `ab<200b>`, `<200b><200b>`, `cd` — where hidden they were one row
    (let (m (cmd-visual-line-mode (ed-init (make-buffer "ab\u{200b}\u{200b}\u{200b}cd\nx")) nil)
          b (cur m))
      (assert= (wrap/line-rows b 0 12 (scroll/ed-row-extras b)) 3)
      (with-glyphless :hidden
        (fn () (assert= (wrap/line-rows b 0 12 (scroll/ed-row-extras b)) 1))))))

(describe "flipping :glyphless-chars on the SAME rope lays it out again"
  ;; every cell memo (`wrap/rope-rows`, `panebody/ed-row-facts-at`, `ed-point-cell-at`,
  ;; `ed-visual-column-at`, the pane fragment) keys on
  ;; `conventions/cell-layout-key`; keyed on the tab width alone, the second frame below got
  ;; back the first one's cells. One model throughout, so the rope is the very same.
  (defn- shown-state (m)
    (let (frame (view/ed-view m 60 10)
          texts (map (text-ops frame) (fn (op) (str (nth op 3 ""))))
          b (cur m))
      {:escape? (any? texts (fn (text) (includes? text "<200b>")))
       :caret (caret-column frame)
       :click (mouse/ed-buf-offset-at b 0 0 0 1 0 3)
       :rows (count (seq/filter (wrap/rows-from b 0 12 10) (fn (row) (= (first row) 0))))}))
  (test "the paint, the caret, a click and the wrap all follow the flip, both ways"
    (let (m (press (cmd-visual-line-mode (ed-init (make-buffer "ab\u{200b}\u{200b}\u{200b}cd\nx"))
                     nil)
              [:ctrl-a :ctrl-f :ctrl-f :ctrl-f]
              60)
          hidden (with-glyphless :hidden (fn () (shown-state m)))
          escaped (with-glyphless :hex-code (fn () (shown-state m)))
          hidden-again (with-glyphless :hidden (fn () (shown-state m))))
      (is (not (:escape? hidden)))
      (is (:escape? escaped))
      ;; point after the first zero width space: column 2 hidden, 2 + 6 escaped
      (assert= (- (:caret escaped) (:caret hidden)) 6)
      ;; cell 3 is the `d` (the spaces hidden take no cell), and inside the first escape shown
      (assert= (:click hidden) 6)
      (assert= (:click escaped) 2)
      (assert= (:rows hidden) 1)
      (assert= (:rows escaped) 3)
      (assert= hidden-again hidden))))

(describe "the minibuffer shows them too"
  (test "the input is shown with its escapes, and the caret measured past them"
    (assert= (echoarea/ed-mb-shown "a\u{200b}b") "a<200b>b")
    (assert= (echoarea/ed-mb-shown "plain") "plain")
    (assert= (echoarea/ed-mb-shown "a\tb") "a       b")
    (with-glyphless :hidden (fn () (assert= (echoarea/ed-mb-shown "a\u{200b}b") "a\u{200b}b")))))

(describe "the ranges and the setting"
  (test "text-ranges marks each glyphless character, a bidi control apart"
    (assert= (vec (glyphless/text-ranges "\u{202e}a\u{feff}" 5 [:plain :bidi]))
      [[5 6 :bidi] [7 8 :plain]])
    (assert= (vec (glyphless/text-ranges "nothing here" 0 [:plain :bidi])) []))
  (test "a bidi control is one of the reordering characters"
    (is (glyphless/bidi-control? "\u{2066}"))
    (is (glyphless/bidi-control? "\u{200f}"))
    (is (not (glyphless/bidi-control? "\u{2060}"))))
  (test "init.blsp's :glyphless-chars takes :hex-code or :hidden"
    (is (empty? (config/config-warnings {:glyphless-chars :hidden})))
    (is (not (empty? (config/config-warnings {:glyphless-chars :box})))))
  (test "the setting reads as the init file says, :hex-code by default"
    ;; `config/apply-to-model` hands it to `conventions/set-glyphless-chars`; setting the
    ;; root here would race the tests beside it, so only the default is applied
    (assert= (config/setting {:glyphless-chars :hidden} :glyphless-chars) :hidden)
    (assert= (config/setting {} :glyphless-chars) :hex-code)
    (config/apply-to-model (ed-init (make-buffer "")) {})
    (assert= *glyphless-chars* :hex-code)))

(describe "a no-break space is marked (nobreak-char-display)"
  (defn- face-at (frame column-text)
    ;; the face of the text op painting exactly `column-text`
    (nth (seq/find (text-ops frame) (fn (op) (= (nth op 3 nil) column-text))) 4 nil))
  (test "U+00A0 and U+202F get the nobreak face; a plain space does not"
    (assert= (vec (glyphless/nobreak-text-ranges "a\u{a0}b \u{202f}" 4 :nb)) [[5 6 :nb] [8 9 :nb]])
    (is (empty? (glyphless/nobreak-text-ranges "a b" 0 :nb))))
  (test "the view paints it, one cell wide, in the nobreak face"
    (let (frame (view/ed-view (ed-init (make-buffer "a\u{a0}b")) 60 10))
      (assert= (:underline (face-at frame "\u{a0}")) true)))
  (test ":nobreak-char-display false shows it as a plain space"
    (let (m (assoc (ed-init (make-buffer "a\u{a0}b")) :nobreak-char-display false)
          frame (view/ed-view m 60 10))
      (is (not (any? (text-ops frame) (fn (op) (= (nth op 4 nil) glyphless/face-nobreak-space)))))))
  (test "the setting is on by default, and a bool"
    (assert= (config/setting {} :nobreak-char-display) true)
    (is (not (empty? (config/config-warnings {:nobreak-char-display :yes}))))))

;; A Cyrillic `а` inside a Latin word passes for an `a` (a homoglyph): the word mixes scripts
;; (brood's string/mixed-script?, UTS #39) and its odd letters out get the hazard face
(describe "a word that mixes scripts is marked (homoglyphs)"
  (test "the letter outside the word's script is marked, and only it"
    (assert= (vec (glyphless/mixed-script-text-ranges "see p\u{430}ypal" 10 :hazard))
      [[15 16 :hazard]])
    (assert= (vec (glyphless/mixed-script-text-ranges "\u{441}\u{43e}\u{441}o" 0 :hazard))
      [[3 4 :hazard]]))
  (test "one script per word, prose in two languages, and Japanese are left alone"
    (is (empty? (glyphless/mixed-script-text-ranges "paypal and friends" 0 :hazard)))
    (is (empty? (glyphless/mixed-script-text-ranges "Привет world, Ελληνικά" 0 :hazard)))
    (is (empty? (glyphless/mixed-script-text-ranges "日本語のテキスト Unicode漢字" 0 :hazard))))
  (test "the view paints the odd letter in the hazard face, and the setting turns it off"
    (let (m (ed-init (make-buffer "p\u{430}ypal"))
          painted (fn (model)
                    (any? (text-ops (view/ed-view model 60 10))
                      (fn (op) (= (nth op 4 nil) glyphless/face-glyphless-bidi)))))
      (is (painted m))
      (refute (painted (assoc m :mixed-script-warning false)))))
  (test "the setting is on by default"
    (assert= (config/setting {} :mixed-script-warning) true)))
