;; src/transient.blsp — the editor half of a transient menu: the overlay, the prompt for an
;; option's value, and a command reading the arguments the menu built. The mechanism is
;; `transient-core`'s (brood ADR-387) and tested in transient_core_test; these are the
;; three joins only an editor has.

(defmodule transient-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use transient))

;; A menu over a command that records what it was given, rather than one that does
;; anything: the point of every `:run` test below is the ARGUMENTS that arrive.
(defn tr-record (m key)
  (assoc m :ran (ed-transient-args m)))

(def tr-spec
  {:name 'test-menu
   :title "Test"
   :groups [{:title "Arguments"
             :suffixes [{:key "-f" :kind :switch :arg "--force" :label "Force"}
                         {:key "=d"
                          :kind :option
                          :arg "--depth="
                          :label "Depth"
                          :prompt "Depth"}]}
             {:title "Do"
              :suffixes [{:key "r"
                          :kind :command
                          :command 'transient-test/tr-record
                          :label "record"}]}]})

(defn tr-model () (ed-init (make-buffer "x")))
(defn tr-open () (ed-transient-open (tr-model) tr-spec))
(defn tr-keys (m keys) (fold keys m (fn (acc k) (ed-transient-key acc k))))

(describe "the menu is a modal overlay on the model"
  (test "opening puts it on the model"
    (is (not (nil? (:transient (tr-open))))))
  (test "a key toggles a switch without touching the buffer"
    (let (m (tr-keys (tr-open) ["-" "f"]))
      (assert= (transient-core/transient-args (:transient m)) ["--force"])
      (assert= (buffer-text (ed-current-buf m)) "x")))
  (test "Esc closes it"
    (assert= (:transient (tr-keys (tr-open) [:escape])) nil))
  (test "C-g closes it too"
    (assert= (:transient (tr-keys (tr-open) [:ctrl-g])) nil))
  (test "a key the menu does not bind closes it and says so"
    (let (m (tr-keys (tr-open) ["z"]))
      (assert= (:transient m) nil)
      (is (includes? (:echo m) "not in this menu")))))

(describe "a command invoked from the menu reads the arguments"
  (test "the arguments reach the command"
    (assert= (:ran (tr-keys (tr-open) ["-" "f" "r"])) ["--force"]))
  (test "with nothing toggled it gets an empty vector, not nil"
    (assert= (:ran (tr-keys (tr-open) ["r"])) []))
  (test "running closes the menu"
    (assert= (:transient (tr-keys (tr-open) ["r"])) nil))
  (test "the arguments do NOT linger on the model afterwards"
    ;; otherwise the next command reached by a keybinding would silently inherit them
    (let (m (tr-keys (tr-open) ["-" "f" "r"]))
      (assert= (:transient-args m) nil)
      (assert= (ed-transient-args m) [])))
  (test "a command reached any other way sees no arguments"
    (assert= (ed-transient-args (tr-model)) []))
  (test "a command that throws is reported, not propagated"
    (let (spec (assoc tr-spec
                 :groups
                   [{:title "Do"
                     :suffixes [{:key "r"
                                 :kind :command
                                 :command 'transient-test/tr-missing
                                 :label "boom"}]}])
          m (ed-transient-key (ed-transient-open (tr-model) spec) "r"))
      (is (includes? (:echo m) "error"))
      (assert= (:transient m) nil))))

(describe "an option is read through the minibuffer"
  (test "pressing it opens a prompt and keeps the menu"
    (let (m (tr-keys (tr-open) ["=" "d"]))
      (is (not (nil? (:minibuffer m))))
      (is (not (nil? (:transient m))))))
  (test "the prompt names the option"
    (is (includes? (:prompt (:edit (:minibuffer (tr-keys (tr-open) ["=" "d"])))) "Depth")))
  (test "accepting the prompt sets the value, and the command gets it"
    (let (m (tr-keys (tr-open) ["=" "d"])
          answered ((:on-complete (:minibuffer m)) m "5")
          ran (ed-transient-key answered "r"))
      (assert= (:ran ran) ["--depth=5"])))
  (test "an empty answer clears it rather than passing a bare flag"
    (let (m (tr-keys (tr-open) ["=" "d"])
          answered ((:on-complete (:minibuffer m)) m "")
          ran (ed-transient-key answered "r"))
      (assert= (:ran ran) []))))

(describe "the git menus are wired to the real commands"
  (test "P opens the push menu"
    (let (m (vc/gitremote/cmd-git-push-menu (tr-model) "P"))
      (assert= (transient-core/transient-title (:transient m)) "Push")))
  (test "its switches are the ones a push actually takes"
    (let (m (tr-keys (vc/gitremote/cmd-git-push-menu (tr-model) "P") ["-" "f"]))
      (assert= (transient-core/transient-args (:transient m)) ["--force-with-lease"])))
  (test "the pull menu offers --rebase"
    (let (m (tr-keys (vc/gitremote/cmd-git-pull-menu (tr-model) "F") ["-" "r"]))
      (assert= (transient-core/transient-args (:transient m)) ["--rebase"])))
  (test "every command every menu names is a symbol that resolves"
    ;; a menu naming a command that does not exist fails at the keypress, which is the
    ;; one moment nobody is looking at a test
    (doseq (spec git-menus)
      (doseq (s (transient-core/spec-suffixes spec))
        (when (= (:kind s) :command)
          (is (bound? (:command s))))))))

;; ---- the menus as DATA: the mistakes a spec can contain ---------------------
;; A menu is a literal, and a literal's failure mode is a typo that nothing notices until
;; someone presses the key. These are the checks the shape can be held to.

(def git-menus
  [vc/gitremote/git-push-transient
    vc/gitremote/git-pull-transient vc/gitsequence/git-merge-transient
    vc/gitsequence/git-rebase-transient vc/gitsequence/git-cherry-pick-transient
    vc/gitsequence/git-revert-transient vc/gitrefs/git-tag-transient
    vc/gitremote/git-remote-transient vc/gitrefs/git-reset-transient vc/git/git-log-transient
    vc/gitremote/git-fetch-transient vc/gitrefs/git-stash-transient
    vc/gitcommit/git-commit-transient vc/gitrefs/git-branch-transient vc/git/git-diff-transient
    vc/git/git-file-transient vc/gitsequence/git-bisect-transient vc/git/git-worktree-transient
    vc/git/git-patch-transient vc/git/git-apply-transient vc/git/git-submodule-transient
    vc/git/git-notes-transient vc/git/git-ignore-transient vc/git/git-jump-transient
    vc/git/git-dispatch-transient])

(describe "every git menu holds together"
  (test "each has a name, a title and at least one group"
    (doseq (spec git-menus)
      (is (not (nil? (:name spec))))
      (is (not (nil? (:title spec))))
      (is (> (count (:groups spec)) 0))))
  (test "every suffix has a key, a kind and a label"
    (doseq (spec git-menus)
      (doseq (s (transient-core/spec-suffixes spec))
        (is (not (nil? (:key s))))
        (is (includes? [:switch :option :command :menu] (:kind s)))
        (is (not (nil? (:label s)))))))
  (test "a switch's argument is a flag"
    (doseq (spec git-menus)
      (doseq (s (transient-core/spec-suffixes spec))
        (when (= (:kind s) :switch)
          (is (string/starts-with? (:arg s) "-"))))))
  (test "an option's argument ends in `=`, or its value would be glued to the flag"
    ;; `(str arg value)` is how an option emits, so `--author` + `me` is `--authorme`
    (doseq (spec git-menus)
      (doseq (s (transient-core/spec-suffixes spec))
        (when (= (:kind s) :option)
          ;; a one-letter short option (`-n`, `-S`) takes its value glued on, as git expects
          (is (or (string/ends-with? (:arg s) "=")
                (and (= (count (:arg s)) 2) (string/starts-with? (:arg s) "-"))))))))
  (test "no two suffixes in one menu share a key"
    ;; a duplicate key is not an error anywhere — `keymap-bind` simply overwrites, and the
    ;; row that lost stays on the card looking pressable
    (doseq (spec git-menus)
      (let (keys (map (transient-core/spec-suffixes spec) transient-core/suffix-keys))
        (assert= (count keys) (count (seq/distinct keys))))))
  (test "no suffix key is a PREFIX of another in the same menu"
    ;; `-f` and `-` in one menu means `-` can never resolve: the chord walk enters the
    ;; prefix and waits for a second key that will never be looked for
    (doseq (spec git-menus)
      (let (keys (map (transient-core/spec-suffixes spec) transient-core/suffix-keys))
        (doseq (a keys)
          (doseq (b keys)
            (when (not (= a b))
              (is (not (= a (seq/subvec (vec b) 0 (math/min (count a) (count b))))))))))))
  (test "every menu answers a sensible argument vector when nothing is set"
    (doseq (spec git-menus)
      (assert= (transient-core/transient-args (transient-core/transient-open spec)) []))))

(describe "the rendering"
  (test "a heading per group and a row per suffix (2 groups, 3 suffixes)"
    (let (rows (transient-core/transient-rows (:transient (tr-open))))
      (assert= (count rows) 5)))
  (test "the painted panel leads with the menu's title, on its own row"
    (let (ops (panel/ed-panel-ops (tr-open) 100 30)
          title (seq/find ops (fn (op) (= (nth op 3 nil) "Test"))))
      (is (not (nil? title)))
      (assert= (nth title 2) 0)))
  (test "the view paints the open menu and nothing when closed"
    (let (m (tr-keys (tr-open) ["-" "f"]))
      (is (> (count (panel/ed-panel-ops m 100 30)) 0))
      (assert= (panel/ed-panel-ops (tr-model) 100 30) []))))

;; ---- `?` and the keys it maps (issues.md X2) ---------------------------------------
;; The dispatch menu is a map of the keys a git buffer answers directly — "pressing `?`
;; then `P` is the same journey as pressing `P`" — so the letters live twice: in
;; `git-dispatch-transient` and in `vc/gitsection/git-common-keymap`. The keymap stays in modes
;; (git is DEFERRED, and a git buffer another frame rebuilds from the registry needs its
;; keys before git has loaded), so the two are held together here instead.
(describe "every key the dispatch menu names does the same thing pressed directly"
  ;; `g` is the one exception, as in Magit: pressed directly it refreshes, and the file
  ;; menu it opens from `?` has no direct key in a git buffer
  (def- direct-exceptions #{"g"})
  (test "a sub-menu's key opens that same menu"
    (doseq (s (transient-core/spec-suffixes vc/git/git-dispatch-transient))
      (when (and (= (:kind s) :menu) (not (contains? direct-exceptions (:key s))))
        (let (command (get vc/gitstatus/git-status-keymap (:key s)))
          (is (symbol? command))
          (when (symbol? command)
            (assert= [(:key s)
                       (:name (:spec (:transient ((reflect/eval command) (tr-model) (:key s)))))]
              [(:key s) (:name (:menu s))]))))))
  (test "a command suffix's key runs that same command"
    (doseq (s (transient-core/spec-suffixes vc/git/git-dispatch-transient))
      (when (= (:kind s) :command)
        (assert= [(:key s) (get vc/gitstatus/git-status-keymap (:key s))] [(:key s) (:command s)]))))
  (test "every menu key in a git buffer is on the map `?` shows"
    (let (dispatch-keys (into #{}
                          (map (transient-core/spec-suffixes vc/git/git-dispatch-transient) :key)))
      (doseq (kv (seq vc/gitstatus/git-status-keymap))
        (let ([key command] kv)
          (when (and (symbol? command) (string/ends-with? (str command) "-menu"))
            (is (contains? dispatch-keys key))))))))

;; ---- the panel's layout: keys first, groups side by side ------------------------------
(defn- tr-panel ()
  (or (transient/key-panel (transient/menu-state (tr-open)) 24) {:groups [] :layout :balanced}))
(defn- tr-layout (columns) (panel/panel-layout (tr-panel) columns 30))

(describe "the transient panel lays its groups out as Magit does"
  (test "each row leads with its key, then says what it does"
    (let (groups (transient/panel-groups (:transient (tr-open))))
      (assert= (vec (map groups :title)) ["Arguments" "Do"])
      (assert= (vec (map (:rows (first groups)) :key)) ["-f" "=d"])
      (assert= (:text (first (:rows (first groups)))) "  --force  Force")
      (assert= (vec (map (:rows (second groups)) :index)) [2])))

  (test "the groups sit side by side when they fit, whole, one column each"
    (let (pages (:pages (tr-layout 120)))
      (assert= (:title (tr-panel)) "Test")
      (assert= (count pages) 1)
      (assert= (count (first pages)) 1)
      (assert= (count (first (first pages))) 2)))

  (test "a frame too narrow for both wraps the second below the first, on one page"
    (let (layout (tr-layout 14)
          bands (first (:pages layout)))
      (assert= (count (:pages layout)) 1)
      (assert= (count bands) 2)
      (assert= (vec (map (first (first bands)) first)) [:heading :row :row])
      (assert= (vec (map (first (second bands)) first)) [:heading :row])
      ;; three lines, a blank, two
      (assert= (:height layout) 6)))

  (test "a group with no title has no heading row"
    (let (state (transient-core/transient-open {:title "T"
                                                :groups [{:suffixes [{:key "a"
                                                                      :kind :command
                                                                      :label "A"}]}]})
          panel (transient/key-panel {:state state :page 0} 24))
      (assert= (vec (map (first (first (first (:pages (panel/panel-layout panel 80 30))))) first))
        [:row])))

  (test "the painted panel puts the key before its description on the same row"
    (let (ops (panel/ed-panel-ops (tr-open) 120 30)
          texts (seq/filter ops (fn (op) (= (first op) :text)))
          key-op (seq/find texts (fn (op) (= (nth op 3) "-f")))
          description (seq/find texts (fn (op) (includes? (nth op 3) "--force"))))
      (assert= (nth key-op 1) (nth description 1))
      (is (< (nth key-op 2) (nth description 2))))))

;; ---- a menu too big for the frame: wrapped as Magit wraps it, paged only past that ----------
(defn- tr-menu (spec) (ed-transient-open (tr-model) spec))
(defn- tr-texts (ops) (seq/keep ops (fn (op) (when (= (first op) :text) (nth op 3)))))
(defn- tr-paged? (ops) (any? (tr-texts ops) (fn (text) (string/starts-with? text "page "))))

(describe "a menu wider than the frame wraps its columns below one another"
  (test "every git menu shows every one of its keys at 80 and 120 columns, on one page"
    (doseq (spec git-menus)
      (doseq (columns [80 120])
        (let (m (tr-menu spec)
              texts (into #{} (tr-texts (panel/ed-panel-ops m columns 30)))
              keys (mapcat (:groups (panel/ed-panel m 30)) (fn (group) (map (:rows group) :key))))
          (assert= [(:name spec) columns (tr-paged? (panel/ed-panel-ops m columns 30))]
            [(:name spec) columns false])
          (assert= [(:name spec) columns (vec (seq/reject keys (fn (key) (contains? texts key))))]
            [(:name spec) columns []])))))

  (test "git push at 80 columns: its arguments above, its two command groups side by side below"
    (let (ops (seq/filter (panel/ed-panel-ops (tr-menu vc/gitremote/git-push-transient) 80 30)
                (fn (op) (= (first op) :text)))
          at (fn (label) (seq/find ops (fn (op) (= (nth op 3) label)))))
      (is (< (nth (at "-f") 1) (nth (at "o") 1)))
      (assert= (nth (at "p") 1) (nth (at "o") 1))
      (is (< (nth (at "p") 2) (nth (at "o") 2))))))

(describe "a menu taller than the frame stays inside it"
  (test "a group taller than a column is split across columns, every line on the frame"
    (doseq (spec git-menus)
      (let (m (tr-menu spec)
            ops (panel/ed-panel-ops m 80 14))
        (is (every? ops (fn (op) (< (nth op 1) 14)))))))
  (test "in a frame too short for its title, the title is left out and the message row kept"
    (let (m (tr-menu vc/git/git-log-transient)
          message-row (- 5 (minibuffer/ed-echo-rows m 80 5))
          ;; the page hint is said on the message row; everything else is below it
          body (seq/reject (seq/filter (panel/ed-panel-ops m 80 5) (fn (op) (= (first op) :text)))
                 (fn (op) (string/starts-with? (nth op 3) "page "))))
      (is (not (empty? body)))
      (is (every? body (fn (op) (> (nth op 1) message-row))))
      (is (not (any? body (fn (op) (string/starts-with? (nth op 3) "Log")))))))
  (test "a menu that does not fit even wrapped pages, C-v / M-v turning it, its page on the echo row"
    (let (m (tr-menu vc/git/git-log-transient)
          ops (panel/ed-panel-ops m 80 14)
          hint (seq/find ops
                 (fn (op) (and (= (first op) :text) (string/starts-with? (nth op 3) "page "))))
          turned (ed-transient-key m :ctrl-v))
      (assert= (nth hint 3) "page 1/2 · C-v/M-v")
      (assert= (nth hint 1) (- 14 (minibuffer/ed-echo-rows m 80 14)))
      (is (not (nil? (:transient turned))))
      (is (any? (tr-texts (panel/ed-panel-ops turned 80 14))
            (fn (text) (= text "page 2/2 · C-v/M-v"))))
      (is (any? (tr-texts (panel/ed-panel-ops (ed-transient-key turned :alt-v) 80 14))
            (fn (text) (= text "page 1/2 · C-v/M-v")))))))
