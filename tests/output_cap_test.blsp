;; Unbounded growth (review #18): a streaming output buffer keeps only its newest lines —
;; cut from the top, whole lines, every position into it kept — and the undo limits reach
;; std/editor/buffer from the user's settings.
(defmodule output-cap-test
  (:use test)
  (:use model)
  (:use input :only [ed-update]) ; the user's own keys over a coloured buffer
  (:use editor/buffer)
  (:use-internals results) ; ed-append-follow
  (:use-internals testrun-cold) ; testrun-append-link — the *Tests* row and its off-text link
  (:use-internals compile) ; compile-append — *compilation*'s raw-chunk stream
  (:use-internals procstream) ; procstream-feed — the worker's line buffer
  (:use-internals bshell) ; bshell-append-output — a shell's output at its process mark
  (:use-internals vcsproc) ; vcs-entry-tail — a journal entry's output
  (:use-internals config)) ; apply-to-model / setting — the settings reaching the model

(defn- lines-text (from to)
  "`line FROM` … `line TO-1`, each ending in a newline."
  (string/join (map (range from to) (fn (i) (str "line " i "\n"))) ""))

(defn- output-index (m name)
  (or (ed-buffer-index-by-name m name) (error "no buffer " name)))

(defn- show-at (m idx top point)
  "`m` with its selected pane on pool buffer `idx`, scrolled to `top`, its cursor at `point`."
  (ed-map-panes m (fn (pane) (assoc pane :buffer idx :top top :point point :mark nil))))

(describe "cutting an output buffer's head keeps every position"
  (test "point, mark and a shell's input start move back with the text"
    (let (b (assoc (set-mark (goto-char (make-buffer (lines-text 0 4)) 20)) :input-start 25)
          cut (ed-cut-head b 14))
      (assert= (buffer-text cut) (lines-text 2 4))
      (assert= (buffer-point cut) 6)
      (assert= (buffer-mark cut) 6)
      (assert= (:input-start cut) 11)))
  (test "a position inside the deleted text lands at the start"
    (assert= (buffer-point (ed-cut-head (goto-char (make-buffer (lines-text 0 4)) 3) 14)) 0))
  (test "the off-text line links move up with their rows, the deleted rows' dropped"
    (let (b (assoc (make-buffer (lines-text 0 4)) :line-links {0 :zero 2 :two 3 :three})
          cut (ed-cut-head b 14))
      (assert= (:line-links cut) {0 :two 1 :three})))
  (test "a read-only buffer is cut and stays read-only"
    (let (b (set-read-only (make-buffer (lines-text 0 4)) true))
      (is (read-only? (ed-cut-head b 7)))
      (assert= (buffer-text (ed-cut-head b 7)) (lines-text 1 4)))))

(describe "a streaming sink keeps its newest lines"
  (test "past :output-max-lines the oldest go, back to nine tenths of it"
    (let (m (fold (range 25)
              (assoc (ed-init (make-buffer "")) :output-max-lines 10)
              (fn (acc i) (ed-append-named acc "*out*" (str "line " i))))
          out (ed-buf-at m (output-index m "*out*")))
      (is (<= (ed-complete-lines out) 10))
      (is (string/ends-with? (buffer-text out) "line 24\n"))
      (is (string/starts-with? (buffer-text out) (str "line " (- 25 (ed-complete-lines out)) "\n")))))
  (test "a model with no setting keeps *output-max-lines*"
    (assert= (ed-output-max-lines (ed-init (make-buffer ""))) *output-max-lines*)
    (assert= (ed-output-max-lines (assoc (ed-init (make-buffer "")) :output-max-lines 7)) 7))
  (test "a pane reading the scrollback keeps reading the same lines"
    (let (m0 (ed-append-named (assoc (ed-init (make-buffer "")) :output-max-lines 10)
               "*out*"
               (string/trim-right (lines-text 0 9)))
          idx (output-index m0 "*out*")
          ;; scrolled to `line 5`, the cursor on `line 6`
          reading (show-at m0 idx 5 (index-of (buffer-text (ed-buf-at m0 idx)) "line 6"))
          m (fold (range 9 14) reading (fn (acc i) (ed-append-named acc "*out*" (str "line " i))))
          out (ed-buf-at m idx)
          pane (ed-current-pane m))
      (assert= (buffer-line-at out (:top pane)) "line 5\n")
      (assert= (:point pane) (index-of (buffer-text out) "line 6"))))
  (test "a pane following the tail is still at the tail after the cut"
    (let (m0 (assoc (ed-init (make-buffer "")) :output-max-lines 10 :scroll-output true)
          m1 (ed-append-follow m0 "*out*" "line 0" 80 8)
          idx (output-index m1 "*out*")
          following (show-at m1 idx 0 0)
          m (fold (range 1 30)
              following
              (fn (acc i) (ed-append-follow acc "*out*" (str "line " i) 80 8)))
          out (ed-buf-at m idx))
      (is (<= (ed-complete-lines out) 10))
      ;; the pane shows the last line
      (is (>= (+ (:top (ed-current-pane m)) 4) (dec (ed-complete-lines out))))))
  (test "*compilation*'s raw chunks are capped too"
    (let (m (fold (range 30)
              (assoc (ed-init (make-buffer "")) :output-max-lines 10)
              (fn (acc i) (compile/compile-append acc (str "chunk " i "\n"))))
          out (ed-buf-at m (output-index m compile/*compile-buf*)))
      (is (<= (ed-complete-lines out) 10))
      (is (string/ends-with? (buffer-text out) "chunk 29\n")))))

(describe "a *Tests* row's link survives the cut"
  (test "the link is recorded on the row it landed on, after the oldest lines went"
    (let (m (fold (range 30)
              (assoc (ed-init (make-buffer "")) :output-max-lines 10)
              (fn (acc i)
                (testrun-cold/testrun-append-link acc (str "row " i) {:file "a.blsp" :line i} 80 24)))
          out (ed-buf-at m (output-index m testrun-cold/*tests-buffer*))
          links (:line-links out))
      ;; every kept link points at the row that names it
      (is (every? links
            (fn ([line loc])
              (= (buffer-line-at out line) (str "row " (:line loc) "\n")))))
      (assert= (get links (dec (ed-complete-lines out))) {:file "a.blsp" :line 29}))))

(describe "a child's endless partial line is bounded"
  (test "past *procstream-line-max* the partial is delivered as a line and starts again"
    (let (run {:handlers {:on-line (fn (line _spans _token) [:line (count line)])
                          :on-err-line (fn (_line _spans _token) nil)
                          :on-done (fn (_code _token) nil)}
               :token :t
               :reply (self)}
          stream (procstream/procstream-feed run
                   (procstream/procstream-stream)
                   "abcdefgh"
                   procstream/procstream-out-line)
          rest (binding (*procstream-line-max* 10)
                 (procstream/procstream-feed run stream "ijklmn" procstream/procstream-out-line)))
      (assert= (:partial rest) ["" []])
      (assert= (receive ([:line n] n) (after 500 :timeout)) 14)))
  (test "an escape the cut falls inside waits in the decoder and colours the next line"
    (let (run {:handlers {:on-line (fn (line spans _token) [:line line spans])
                          :on-err-line (fn (_line _spans _token) nil)
                          :on-done (fn (_code _token) nil)}
               :token :t
               :reply (self)}
          cut (binding (*procstream-line-max* 5)
                (procstream/procstream-feed run
                  (procstream/procstream-stream)
                  "abcdefgh\e[3"
                  procstream/procstream-out-line))
          _ (procstream/procstream-feed run cut "1mXY\n" procstream/procstream-out-line))
      (assert= (receive ([:line line spans] [line spans]) (after 500 :timeout)) ["abcdefgh" []])
      (assert= (receive ([:line line spans] [line spans]) (after 500 :timeout))
        ["XY" [[0 2 {:fg 1}]]]))))

(describe "colour spans are cut with the lines they colour"
  (test "a head cut moves the spans back, clips one it splits and drops one it deletes"
    (let (b (insert (make-buffer "") (lines-text 0 4) {:ansi [[0 4 :a] [5 9 :b] [10 16 :c]]})
          cut (ed-cut-head b 7))
      (assert= (ansicolor/colour-spans cut) [[0 2 :b] [3 9 :c]])))
  (test "the user's own edits move the colours with the text they colour"
    ;; brood ADR-579: the colours are the text's properties, so typing before them, typing
    ;; inside them and deleting back carry them as Emacs carries ansi-color's faces
    (let (coloured (insert (make-buffer "") "ok FAIL\n" {:ansi [[3 7 {:fg 1}]]})
          m0 (ed-init (goto-char coloured 0))
          typed (fold ["X" "Y"] m0 (fn (acc key) (ed-update acc key 80 24)))
          inside (fold [:right :right :right :right "z"]
                   typed
                   (fn (acc key) (ed-update acc key 80 24)))
          deleted (ed-update (ed-update inside :backspace 80 24) :backspace 80 24))
      (assert= (ansicolor/colour-spans (ed-current-buf typed)) [[5 9 {:fg 1}]])
      (assert= (buffer-text (ed-current-buf inside)) "XYok FzAIL\n")
      (assert= (ansicolor/colour-spans (ed-current-buf inside)) [[5 6 {:fg 1}] [7 10 {:fg 1}]])
      (assert= (buffer-text (ed-current-buf deleted)) "XYok AIL\n")
      (assert= (ansicolor/colour-spans (ed-current-buf deleted)) [[5 8 {:fg 1}]])))
  (test "a shell's process mark moves with the cut"
    (assert= (comint/process-mark-at (ed-cut-head (comint/with-process-mark (make-buffer (lines-text 0
                                                                                           4))
                                                    20)
                                       14))
      6))
  (test "*compilation*'s capped colours still cover the words they coloured"
    (let (m (fold (range 30)
              (assoc (ed-init (make-buffer "")) :output-max-lines 10)
              (fn (acc i) (compile/compile-append acc (str "ERR " i "\n") [[0 3 {:fg 1}]])))
          out (ed-buf-at m (output-index m compile/*compile-buf*))
          text (buffer-text out)
          spans (ansicolor/colour-spans out))
      (is (<= (ed-complete-lines out) 10))
      (assert= (count spans) (ed-complete-lines out))
      (is (every? spans (fn (span) (= (string/substring text (first span) (second span)) "ERR"))))))
  (test "a results stream's capped colours still cover the words they coloured"
    (let (m (fold (range 30)
              (assoc (ed-init (make-buffer "")) :output-max-lines 10)
              (fn (acc i) (ed-append-follow acc "*Run*" (str "ok " i) 80 8 [[0 2 {:fg 2}]])))
          out (ed-buf-at m (output-index m "*Run*"))
          text (buffer-text out)
          spans (ansicolor/colour-spans out))
      (assert= (count spans) (ed-complete-lines out))
      (is (every? spans (fn (span) (= (string/substring text (first span) (second span)) "ok"))))))
  (test "a shell's capped output keeps its colours and its process mark on the text"
    (let (m0 (bshell/bshell-append-output (assoc (ed-init (make-buffer "")) :output-max-lines 10)
               "*sh*" "$ make\n" nil)
          idx (output-index m0 "*sh*")
          running (ed-set-buf-at m0
                    idx
                    (comint/with-process-mark (assoc (ed-buf-at m0 idx) :input-running true) 7))
          ;; something typed ahead, after the process mark
          typed (ed-set-buf-at running idx (insert (end-of-buffer (ed-buf-at running idx)) "ls"))
          m (fold (range 30)
              typed
              (fn (acc i)
                (bshell/bshell-append-output acc "*sh*" (str "WARN " i "\n") [[0 4 {:fg 3}]])))
          out (ed-buf-at m idx)
          text (buffer-text out)
          spans (ansicolor/colour-spans out))
      (is (<= (ed-complete-lines out) 10))
      (is (string/ends-with? text "WARN 29\nls"))
      (assert= (comint/process-mark-at out) (- (count text) 2))
      (is (every? spans (fn (span) (= (string/substring text (first span) (second span)) "WARN")))))))

(describe "a VCS journal entry keeps its last lines"
  (test "older lines are dropped and counted"
    (assert= (binding (*vcs-entry-output-max-lines* 2) (vcs-entry-tail "a\nb\nc\nd"))
      "[2 earlier lines dropped]\nc\nd")
    (assert= (binding (*vcs-entry-output-max-lines* 5) (vcs-entry-tail "a\nb")) "a\nb")))

(describe "the limits come from the settings"
  (test "the undo limits reach std/editor/buffer and the output cap reaches the model"
    (let (before-limit editor/buffer/*undo-limit*
          before-strong editor/buffer/*undo-strong-limit*
          m (apply-to-model (ed-init (make-buffer ""))
              {:undo-limit 1234 :undo-strong-limit 5678 :output-buffer-max-lines 42}))
      (assert= editor/buffer/*undo-limit* 1234)
      (assert= editor/buffer/*undo-strong-limit* 5678)
      (assert= (ed-output-max-lines m) 42)
      ;; put the image back as it was for the rest of the run
      (def editor/buffer/*undo-limit* before-limit)
      (def editor/buffer/*undo-strong-limit* before-strong)))
  (test "an unset file means the defaults"
    (assert= (setting {} :undo-limit) 2000000)
    (assert= (setting {} :undo-strong-limit) 3000000)
    (assert= (setting {} :output-buffer-max-lines) 10000)))

;; Emacs's comint-carriage-motion in every streaming output buffer: a progress counter
;; rewrites its line (`10%\r20%` shows `20%`), whichever read its returns arrive in.
(describe "carriage returns rewrite the output line"
  (test "*compilation*: a counter streamed over several reads ends as one line"
    (let ([_ m] (fold ["$ build\n10%" "\r20%" "\r" "30%\r\n" "ok\n"]
                  [(ansicolor/decoder) (ed-init (make-buffer ""))]
                  (fn (acc chunk)
                    (let ([decoder model] acc
                          [next-decoder text spans] (ansicolor/decode decoder chunk))
                      [next-decoder (compile/compile-append model text spans)])))
          out (ed-buf-at m (output-index m compile/*compile-buf*)))
      ;; the read that ended in a lone return held it; the next said what it was
      (assert= (buffer-text out) "$ build\n30%\nok\n")))
  (test "a shell's output at its process mark rewrites its line, the mark after it"
    (let (m0 (bshell/bshell-append-output (ed-init (make-buffer "")) "*sh*" "$ x\n1/3" nil)
          m (bshell/bshell-append-output m0 "*sh*" "\r2/3" [[1 4 {:fg 2}]])
          out (ed-buf-at m (output-index m "*sh*")))
      (assert= (buffer-text out) "$ x\n2/3")
      (assert= (comint/process-mark-at out) 7)
      (assert= (ansicolor/colour-spans out) [[4 7 {:fg 2}]])))
  (test "a line-buffered stream delivers each line as its last return left it"
    (let (run {:handlers {:on-line (fn (line _spans _token) [:line line])
                          :on-err-line (fn (_line _spans _token) nil)
                          :on-done (fn (_code _token) nil)}
               :token :t
               :reply (self)}
          stream (procstream/procstream-feed run
                   (procstream/procstream-stream)
                   "1%\r2%\r3%"
                   procstream/procstream-out-line))
      ;; the partial line keeps one count, not all of them
      (assert= (first (:partial stream)) "3%")
      (procstream/procstream-feed run stream "\r4%\ndone\n" procstream/procstream-out-line)
      (assert= (receive ([:line line] line) (after 500 :timeout)) "4%")
      (assert= (receive ([:line line] line) (after 500 :timeout)) "done"))))
