;; Diff-hl recomputes on the idle beat (model/ed-launch-gitdiff, synchronous) and C-g
;; (commands/cmd-keyboard-quit) cancels every background worker — the fix for the editor
;; wedging on a large file's full-buffer diff. These cover the pure model-side staleness,
;; the rope-guarded result fold, the universal cancel, and (last describe) the task-reply
;; contract itself — proof the async plumbing the June-16 revert blamed was never broken;
;; the live gutter is exercised by hand against a real repo.
(defmodule gitdiff-async-test
  (:use model)
  (:use-internals input)
  (:use-internals panes) ; ed--gutter-key — the gutter cache key (cache-invalidation regression)
  (:use commands)
  (:use editor/buffer)
  (:use test))

;; A parked process stands in for an in-flight task handle: cmd-keyboard-quit's
;; `cancel-task` just `send`s it a cancel message (a harmless no-op here).
(defn- gd-handle () (spawn (receive (:never nil))))
(defn- gd-file-model (text) (ed-init (make-buffer text "f.txt" "/tmp/f.txt")))

(describe "diff-hl staleness (ed-gitdiff-stale?)"
  (test "a fresh file buffer with no cached rope is stale"
    (is (ed-gitdiff-stale? (gd-file-model "a\nb\nc"))))
  (test "a fileless buffer is never stale"
    (is (not (ed-gitdiff-stale? (ed-init (make-buffer "a\nb\nc"))))))
  (test "a buffer whose :git-status-rope matches the current rope is not stale"
    (let (m (gd-file-model "a\nb\nc")
          b (ed-current-buf m)
          m1 (ed-set-buf m (editor/buffer/annotate b :git-line-status {})))
      (is (not (ed-gitdiff-stale? m1)))))
  (test "an edit (new rope) re-arms a previously-current gutter — the drift fix"
    (let (m (gd-file-model "a\nb\nc")
          b (ed-current-buf m)
          current (ed-set-buf m (editor/buffer/annotate b :git-line-status {}))
          edited (ed-set-buf current (insert (ed-current-buf current) "X")))
      (is (not (ed-gitdiff-stale? current))) ; current text → no recompute
      (is (ed-gitdiff-stale? edited)))) ; text changed → recompute due, bars follow
  (test "diff-hl turned off makes nothing stale"
    (is (not (ed-gitdiff-stale? (assoc (gd-file-model "a\nb\nc") :diff-hl? false))))))

(describe "diff-hl gutter width is stable (no save/open shrink-then-expand)"
  (test "a file buffer reserves the change-bar column whether or not the diff has landed"
    (let (b0 (make-buffer "a\nb\nc" "f.txt" "/tmp/f.txt")
          ;; width must be identical before the async diff lands (nil status) and after
          before (modes/line-number-width b0)
          after (modes/line-number-width (editor/buffer/annotate b0 :git-line-status {0 :modified})))
      (assert= before after)))
  (test "a fileless buffer reserves no change-bar column (one narrower)"
    (let (file (modes/line-number-width (make-buffer "a\nb" "f" "/tmp/f"))
          fileless (modes/line-number-width (make-buffer "a\nb")))
      (assert= 1 (- file fileless)))))

(describe "diff-hl bars hide while positionally stale (never drawn on the wrong line)"
  (test "the change bar shows while the annotation is positionally current"
    (let (b (editor/buffer/annotate (make-buffer "a\nb\nc" "f.txt" "/tmp/f.txt")
              :git-line-status {0 :modified})
          cell (modes/line-number-cell b 0 (modes/line-number-width b)))
      (assert= :bar (nth (first cell) 0)))) ; [:bar colour] is the change-bar chunk
  (test "the bar blanks once a line was inserted since the diff (positional currency)"
    ;; annotate at 3 lines, then insert one: the line->status map would now point at the
    ;; wrong lines, so the bars blank rather than draw one line off
    (let (b (insert (goto-char (editor/buffer/annotate (make-buffer "a\nb\nc" "f.txt" "/tmp/f.txt")
                                 :git-line-status {0 :modified})
                      0)
              "\n")
          cell (modes/line-number-cell b 0 (modes/line-number-width b)))
      (assert= " " (nth (first cell) 0))))) ; blank, not a stale-positioned bar
(describe "diff-hl recompute (ed-launch-gitdiff — synchronous, runs on the idle beat)"
  (test "recomputing a stale file buffer stamps the rope + line count (no longer stale)"
    (let (m (ed-launch-gitdiff (gd-file-model "a\nb\nc"))
          b (ed-current-buf m))
      (is (not (nil? (editor/buffer/annotation-value b :git-line-status)))) ; a status map was set ({} for untracked)
      (is (not (:stale? (editor/buffer/annotation b :git-line-status)))) ; stamped to the current rope
      (assert= 3 (:lines (get b :git-line-status))) ; line count at compute (positional key)
      (is (not (ed-gitdiff-stale? m))))) ; current → no re-arm
  (test "an edit re-arms it; the next recompute clears the staleness — the live-update fix"
    (let (m (ed-launch-gitdiff (gd-file-model "a\nb\nc"))
          edited (ed-set-buf m (insert (ed-current-buf m) "X"))
          recomputed (ed-launch-gitdiff edited))
      (is (ed-gitdiff-stale? edited)) ; text changed → stale
      (is (not (ed-gitdiff-stale? recomputed))))) ; recompute caught up
  (test "no-op when not stale (idempotent)"
    ;; a second launch on unchanged text must not re-annotate — the stamp is identical
    (let (m (ed-launch-gitdiff (gd-file-model "a\nb\nc")))
      (assert= (get (ed-current-buf m) :git-line-status)
        (get (ed-current-buf (ed-launch-gitdiff m)) :git-line-status))
      (is (not (ed-gitdiff-stale? m)))))
  (test "the cursor-blink tick recomputes a stale gutter (the reliable, ungated trigger)"
    ;; blink fires even when :held-key is stuck (which suppresses the idle beat), so it keeps
    ;; the gutter current — see input/ed--timer-fire :cursor-blink.
    (let (m (gd-file-model "a\nb\nc") ; stale: no annotation yet
          m1 (input/ed-timer-fire m :cursor-blink 24 80 80 24))
      (is (ed-gitdiff-stale? m)) ; was stale
      (is (not (ed-gitdiff-stale? m1)))))) ; the blink recomputed it
(describe "keyboard-quit cancels all background workers"
  (test "C-g clears the eval / diagnostics / diff-hl handles and their checking ropes"
    (let (m (gd-file-model "a\nb\nc")
          m1 (assoc m
               :eval-proc (gd-handle)
               :diag-proc (gd-handle)
               :gitdiff-proc (gd-handle)
               :diag-checking :r
               :gitdiff-checking :r
               :pending {:x 1}
               :prefix-arg {:count 4 :raw true})
          m2 (cmd-keyboard-quit m1 :ctrl-g))
      (is (nil? (:eval-proc m2)))
      (is (nil? (:diag-proc m2)))
      (is (nil? (:gitdiff-proc m2)))
      (is (nil? (:diag-checking m2)))
      (is (nil? (:gitdiff-checking m2)))
      (is (nil? (:pending m2)))
      (is (nil? (:prefix-arg m2)))
      (assert= "quit — interrupted background work" (:echo m2))))
  (test "a cancelled diff-hl gets an empty status so it doesn't immediately relaunch"
    (let (m (gd-file-model "a\nb\nc")
          m1 (assoc m :gitdiff-proc (gd-handle) :gitdiff-checking (buffer-rope (ed-current-buf m)))
          m2 (cmd-keyboard-quit m1 :ctrl-g))
      (assert= {} (editor/buffer/annotation-value (ed-current-buf m2) :git-line-status))
      (is (not (ed-gitdiff-stale? m2)))))
  (test "C-g with nothing in flight just quits (region cleared, plain message)"
    (let (m2 (cmd-keyboard-quit (gd-file-model "a\nb\nc") :ctrl-g))
      (assert= "quit" (:echo m2))
      (is (nil? (:eval-proc m2))))))

;; ---- async task replies land in a ui-run-shaped loop (the June-16 exoneration) ------
;; History: 1a855fb went synchronous blaming a lost `[:task-done]` reply for the frozen
;; gutter; 25 minutes later cac0ce3 — sync fix loaded, gutter STILL frozen — found the
;; real cause: the idle beat was suppressed by a stuck `:held-key`, so the recompute never
;; *fired* (the ungated blink timer kept the cursor alive, which made the loop look
;; healthy while the beat was dead). The task/reply plumbing was never broken. These pin
;; the contract every off-loop service (diagnostics today; fontify / eldoc / LSP as they
;; move off the loop — ROADMAP §E.2) rests on: a task launched from the model delivers its
;; tagged reply to the launching process's mailbox, the handle compares equal to the
;; stored one, and `ed-update` folds it.
;;
;; Keep this describe LAST in the file: it registers `:editor` for this test process
;; (irreversibly — there is no unregister), and the launcher tests above assert the
;; headless-synchronous fallbacks.

(def- gd-bad-src "(map (list 1 2 3) cons)") ; type-checker flags it → non-empty diagnostics
(describe "async task replies land in a ui-run-shaped loop"
  :isolated
  ;; registers `:editor` (the async reply target), which is process-global and read by ten
  ;; modules as "there is a live editor" — so it must not be visible to a test running in
  ;; parallel. Same rule as sandbox/processes/web-logging/debugger's live blocks.
  (test "a diag task's [:task-done] reply arrives, matches its stored handle, and folds"
    (let (_ (proc/register :editor (self))
          m1 (ed-launch-diag (ed-init (make-buffer gd-bad-src "x.blsp" "x.blsp")))
          h1 (:diag-proc m1))
      (is (not (nil? h1))) ; :editor live → task launched
      (receive
        ([:task-done h v]
          (do
            (assert= h1 h) ; the reply's handle IS the stored one
            (let (m2 (ed-update m1 [:task-done h v] 80 24))
              (is (nil? (:diag-proc m2))) ; the in-flight gate cleared
              (is (> (count (:diagnostics m2)) 0))))) ; the result folded in
        (after 5000 (assert= :task-reply :never-landed)))))
  (test "an unmatched reply is dropped and the in-flight gate stays set"
    ;; The structural lesson of the freeze: an in-flight handle gates relaunch until the
    ;; MATCHING reply clears it — a reply that never comes (or never matches) wedges the
    ;; service. Any off-loop service must either guarantee its reply (std/task does:
    ;; done/error/timeout all reply) or not gate on one.
    (let (m (assoc (gd-file-model "a\nb\nc") :diag-proc :h :diag-checking :r)
          m2 (input/ed-ev-task-reply m [:task-done :other [{:line 1 :col 1 :message "x"}]] 24 80 24))
      (assert= :h (:diag-proc m2)) ; still gated on the real handle
      (is (nil? (:diagnostics m2)))))) ; the stale result did not fold
;; ---- REGRESSION: the gutter cache must not outlive a mark's staleness ------------
;; The margin dims a verdict once the text differs from the run that produced it. That
;; dimming is computed by `modes/gutter-mark-for`, but the screen shows CACHED cells
;; (`panes/ed--gutter-cells`), so the cache key has to change when staleness does.
;; An annotation's own stamp is frozen at annotation time, so the key needs the live
;; rope; without it the bright ✓ stayed on screen forever on a non-file buffer.

(describe "gutter cache invalidation vs mark staleness"
  (test "an edit that dims a verdict also changes the gutter cache key"
    (let (b0 (editor/buffer/annotate (make-buffer "a\nb\nc") :test-marks {0 true})
          b1 (insert (goto-char b0 0) "x") ; same line count, text differs
          gw (modes/line-number-width b0))
      ;; the mark itself dims…
      (assert= modes/gutter-face-test-pass (second (modes/gutter-mark-for b0 0)))
      (assert= modes/gutter-face-test-stale (second (modes/gutter-mark-for b1 0)))
      ;; …and the cache is forced to ask again
      (is (not (= (panes/ed-gutter-key b0 gw) (panes/ed-gutter-key b1 gw))))))

  (test "the key is stable when nothing relevant changed (the cache still works)"
    (let (b (editor/buffer/annotate (make-buffer "a\nb\nc") :test-marks {0 true})
          gw (modes/line-number-width b))
      (assert= (panes/ed-gutter-key b gw) (panes/ed-gutter-key b gw))
      ;; moving point is not a text change: the cells stay valid
      (assert= (panes/ed-gutter-key b gw) (panes/ed-gutter-key (goto-char b 2) gw)))))
