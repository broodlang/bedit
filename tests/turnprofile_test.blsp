;; Where a slow turn's time went (`src/turnprofile.blsp`): the update's stages and the hooks it
;; called, kept when the turn was slow, and taken by the slow-turn report.

(defmodule turnprofile-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use ownership :only [*claimant*]))

(defn slow-step (m)
  "A post-step that takes 60 ms on a model asking for it, and nothing on any other: tests run
beside this one fold events through the same post-steps."
  (if (:turnprofile-test-slow m) (receive (after 60 m)) m))

(describe "a turn's breakdown"
  (test "a phase past the line keeps its parts, costliest first, and is taken once"
    (turnprofile/begin!)
    (turnprofile/note! 'git/tick 30000000)
    (turnprofile/note! 'git/tick 30000000)
    (turnprofile/stage! "fold" 2000000)
    (turnprofile/finish! "update" 70000000)
    (let (parts (turnprofile/take-breakdown "update"))
      ;; first how much the loop ran and how much it did not, then its parts costliest first
      (assert= (vec (map (take parts 2) first)) ["loop ran" "loop did not run"])
      (assert= (nth parts 2) ["git/tick" 60.0 2])
      (assert= (nth parts 3) ["stage fold" 2.0 1])
      (is (nil? (turnprofile/take-breakdown "update")))))
  (test "a context that raises is noted, never raised: the turn it describes already survived"
    (turnprofile/begin!)
    (turnprofile/finish! "view" 70000000 (fn () (throw "no layout")))
    (assert= (first (first (turnprofile/take-breakdown "view"))) "in ? (no layout)"))
  (test "a phase spent waiting reads as the loop not running"
    (turnprofile/begin!)
    (receive (after 60 nil))
    (turnprofile/finish! "update" 60000000)
    (let ([ran waited] (vec (map (take (turnprofile/take-breakdown "update") 2) second)))
      (is (< ran 20.0))
      (is (> waited 40.0))))
  (test "a quick phase keeps nothing"
    (turnprofile/begin!)
    (turnprofile/note! 'git/tick 1000000)
    (turnprofile/finish! "view" 10000000)
    (is (nil? (turnprofile/take-breakdown "view"))))
  (test "a slow post-step is named in the update's breakdown, and the slow-turn report takes it"
    (binding (*claimant* "/tests/turnprofile")
      (register-post-step :turnprofile-test-slow {:order 1003 :run 'turnprofile-test/slow-step})
      (let (m (assoc (ed-init (make-buffer "x")) :turnprofile-test-slow true)
            _ (input/ed-update m :ctrl-f 80 24)
            reported (slowlog/ed-ev-ui-slow m
                       [:ui-slow {:phase "update" :tag :ctrl-f :ms 64}]
                       24
                       80
                       24)
            logged (buffer-text (ed-buf-at reported
                                  (ed-buffer-index-by-name! reported "*Messages*"))))
        (ownership/release-under! "/tests/turnprofile")
        (is (includes? logged "slow update 64ms on :ctrl-f: "))
        (is (includes? logged "turnprofile-test/slow-step "))
        (is (includes? logged "stage post-steps"))))))

(describe "the slow-turn summary"
  (test "names where the worst of a kind spent its time"
    (let (lines (slowlog/summary-lines [{:phase "update" :tag :lsp :ms 80}
                                         {:phase "update"
                                          :tag :lsp
                                          :ms 120
                                          :parts [["lsp/fold" 100 1]]}]))
      (assert= lines
        ["  200 ms total    2×  worst 120 ms   update :lsp"
          "            the worst: lsp/fold 100 ms"]))))

(describe "a slow turn says what it ran in"
  (test "the selected buffer, its mode and size, the buffers and windows, first"
    (turnprofile/begin!)
    (turnprofile/finish! "update"
      70000000
      (fn () (ed-turn-context (ed-init (make-buffer "hello")))))
    (let (first-part (first (turnprofile/take-breakdown "update")))
      (assert= (first first-part) "in *scratch* :fundamental 5 chars · 2 buffers · 1 windows")
      (assert= (turnprofile/parts-line [first-part])
        "in *scratch* :fundamental 5 chars · 2 buffers · 1 windows"))))
