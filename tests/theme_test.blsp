;; The theme's hierarchy, measured: the text-emphasis tiers of every registered theme held to
;; APCA contrast floors, the selection and the search's matches told apart (in the frame's
;; faces and, with a GUI runtime, in the window's pixels), the recessed mode line, the
;; gutter's current number, and the calm syntax variant.
(defmodule theme-test
  (:use testkit :only [press m-of]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use view)
  (:use editor/buffer)
  (:use theme))

(defn- magnitude (fg bg) (math/abs (apca-lc fg bg)))

(defn- near? (value expected) (< (math/abs (- value expected)) 0.15))

(describe "the contrast arithmetic"
  (test "APCA Lc matches the reference implementation's values"
    ;; computed with APCA 0.0.98G-4g (the scratch awk port the design notes used)
    (is (near? (apca-lc "#cdd6f4" "#1e1e2e") -80.0))
    (is (near? (apca-lc "#a6adc8" "#181825") -57.0))
    (is (near? (apca-lc "#7f849c" "#1e1e2e") -35.1))
    (is (near? (apca-lc "#4c4f69" "#eff1f5") 79.3))
    (is (near? (apca-lc "#ffffff" "#0d0e1c") -107.5))
    ;; two backgrounds a step apart are below the low clip: no contrast at all
    (assert= (apca-lc "#181825" "#1e1e2e") 0.0))
  (test "the WCAG ratio is the familiar one"
    (is (< (math/abs (- (wcag-ratio "#cdd6f4" "#1e1e2e") 11.34)) 0.01))
    (is (< (math/abs (- (wcag-ratio "#1e1e2e" "#cdd6f4") 11.34)) 0.01))
    (assert= (math/round (wcag-ratio "#ffffff" "#000000")) 21)))

;; ---- every theme's tiers -------------------------------------------------------
;; The floors are APCA's: Lc 75 body text, 60 content text that is not body text, 45 larger
;; or secondary text, 30 any text at all, 15 a discernible non-text mark. A theme whose
;; authored body text is softer (`:contrast :soft`) is held to the same floors scaled by its
;; own body contrast, so its hierarchy keeps the proportions.

(def- floors {:code 75 :chrome 60 :chrome-dim 45 :tertiary 30 :decor 15})

(defn- theme-measures ()
  "The contrast of each tier, as the LIVE faces paint it once the theme is applied: the
code on the background, the tiers on the background, the mode line and header line on
their own backgrounds, the gutter's numbers on the gutter — and PLAIN text, what the window
paints a face with no `:fg` in on its background ([[window-look]], `gui/fg` and `gui/bg`)."
  {:code (magnitude *fg-code* *base*)
   :plain (magnitude (:fg (window-look)) (:bg (window-look)))
   :chrome (magnitude *fg-chrome* *base*)
   :chrome-dim (magnitude *fg-chrome-dim* *base*)
   :tertiary (magnitude *fg-tertiary* *base*)
   :decor (magnitude *fg-decor* *base*)
   :modeline (magnitude (:fg face-modeline) (:bg face-modeline))
   :modeline-name (magnitude (:fg face-modeline-name) (:bg face-modeline))
   :modeline-inactive (magnitude (:fg face-modeline-inactive) (:bg face-modeline-inactive))
   :header-line (magnitude (:fg headerline/face-header-line) (:bg headerline/face-header-line))
   :line-number (magnitude (:fg face-gutter-line) (:bg face-gutter-bg))
   :line-number-current (magnitude (:fg face-gutter-line-current) (:bg face-gutter-bg))
   :truncation (magnitude (:fg face-truncation) *base*)})

(defn- theme-problems (theme)
  "Every floor `theme` misses, as readable strings; empty when it meets them all."
  (let (_ (themes/theme-activate! (:name theme))
        measured (theme-measures)
        soft? (= (:contrast theme) :soft)
        scale (if soft? (math/min 1.0 (/ (:code measured) 75.0)) 1.0)
        floor (fn (tier) (* scale (get floors tier)))
        checks [[:code :code]
                 [:plain :code]
                 [:chrome :chrome]
                 [:chrome-dim :chrome-dim]
                 [:tertiary :tertiary]
                 [:decor :decor]
                 [:modeline :chrome-dim]
                 [:modeline-name :chrome]
                 [:modeline-inactive :tertiary]
                 [:header-line :chrome-dim]
                 [:line-number :tertiary]
                 [:line-number-current :tertiary]
                 [:truncation :decor]]
        below (seq/keep checks
                (fn ([what tier])
                  (when (< (get measured what) (floor tier))
                    (str (:name theme)
                      ": "
                      what
                      " is Lc "
                      (math/->fixed (get measured what) 1)
                      ", under the "
                      tier
                      " floor "
                      (math/->fixed (floor tier) 1)))))
        ;; the tiers run brightest to dimmest, each a step under the one above
        ladder [:code :chrome :chrome-dim :tertiary :decor]
        out-of-order (seq/keep (seq/zip ladder (rest ladder))
                       (fn ([upper lower])
                         (when (< (get measured upper) (get measured lower))
                           (str (:name theme) ": " lower " is brighter than " upper))))
        ;; a recessed bar: the active one says more than an inactive one
        quieter (when (< (:modeline measured) (:modeline-inactive measured))
                  (str (:name theme) ": the inactive mode line is louder than the active one"))
        ;; `:soft` is a claim about the theme's colours, kept honest both ways
        soft-claim (cond
                     (and soft? (>= (:code measured) 75))
                       (str (:name theme)
                         ": says :contrast :soft but its body text is Lc "
                         (math/->fixed (:code measured) 1))
                     (and soft? (< (:code measured) 45))
                       (str (:name theme)
                         ": body text Lc "
                         (math/->fixed (:code measured) 1)
                         " is unreadable, soft or not")
                     else nil))
    (into (into (vec below) out-of-order) (seq/reject [quieter soft-claim] nil?))))

(describe "every registered theme keeps the tier hierarchy"
  :isolated (test "each tier and each chrome face meets its APCA floor, brightest to dimmest"
    (let (problems (mapcat themes/*themes* theme-problems)
          _ (theme-apply! *theme-mocha*))
      (assert= (vec problems) [])))
  (test "every bundled theme names the whole ladder itself"
    (let (roles [:text :subtext1 :subtext :overlay2 :overlay1 :overlay0 :lavender])
      (assert= (vec (seq/keep themes/*themes*
                      (fn (theme)
                        (let (missing (seq/reject roles (fn (role) (get (:palette theme) role))))
                          (when (not (empty? missing)) [(:name theme) missing])))))
        []))))

(describe "the palette's optional roles and tiers"
  (test "a plugin theme without the new roles gets a coherent ladder"
    (let (old (dissoc *theme-mocha* :subtext1 :overlay2 :lavender)
          complete (palette-complete old))
      (assert= (:subtext1 complete) (mix (:text old) (:subtext old) 0.5))
      (assert= (:overlay2 complete) (mix (:subtext old) (:overlay1 old) 0.5))
      (assert= (:lavender complete) (:blue old))))
  (test "a palette may name a tier itself"
    (assert= (:fg-tertiary (tiers-of (assoc *theme-mocha* :fg-tertiary "#989898"))) "#989898")
    (assert= (:fg-tertiary (tiers-of *theme-mocha*)) (:overlay1 *theme-mocha*)))
  :isolated (test "a theme switch rebinds the tiers, and the chrome faces follow them"
    (let (_ (theme-apply! (assoc *theme-mocha* :fg-chrome-dim "#123456"))
          modeline face-modeline
          header headerline/face-header-line
          _ (theme-apply! *theme-mocha*))
      (assert= (:fg modeline) "#123456")
      (assert= (:fg header) "#123456"))))

;; ---- the recessed mode line ----------------------------------------------------

(defn- modeline-texts (m)
  "The mode line's `:text` ops (row 23 of an 80x24 frame), as `[text face]`."
  (map (seq/filter (ed-view m 80 24) (fn (op) (and (= (first op) :text) (= (nth op 1) 22))))
    (fn (op) [(nth op 3) (nth op 4)])))
(defn- text-face (texts needle)
  (second (seq/find texts (fn (entry) (includes? (first entry) needle)))))

(describe "the mode line is recessed chrome"
  (test "the bar is the mantle with secondary-tier text, not a raised surface"
    (assert= face-modeline {:fg *fg-chrome-dim* :bg *mantle*})
    (assert= face-modeline-inactive {:fg *fg-tertiary* :bg *mantle*}))
  (test "the selected pane's name is in the code's colour; an unselected pane's is not"
    (let (split (press (m-of "hello") [:ctrl-x "2"])
          frame (ed-view split 80 24)
          names (seq/filter frame
                  (fn (op) (and (= (first op) :text) (= (nth op 3) "  *scratch*")))))
      (assert= (count names) 2)
      (assert= (count (seq/filter names (fn (op) (= (:fg (nth op 4)) *fg-code*)))) 1)))
  (test "a modified file buffer shows the state accent; a clean one does not"
    (let (dir (temp-dir "bedit-theme-")
          buf (make-buffer "hello\n" "notes.txt" (path/join dir "notes.txt"))
          clean (ed-init buf)
          edited (press clean ["x"])
          marker (fn (m) (seq/find (modeline-texts m) (fn (entry) (= (first entry) "●")))))
      (is (nil? (marker clean)))
      (assert= (:fg (second (marker edited))) *peach*)))
  (test "recording a keyboard macro says Def in the state accent"
    (let (recording (press (m-of "hello") [:ctrl-x "("]))
      (assert= (:fg (text-face (modeline-texts recording) "Def")) *peach*)
      (is (nil? (text-face (modeline-texts (m-of "hello")) "Def"))))))

;; ---- selection, other matches, current match -----------------------------------

(def- search-text "foo bar foo baz foo")

(defn- searching () (press (press (m-of search-text) [:ctrl-s]) ["f" "o" "o"]))
(defn- selecting ()
  ;; C-SPC at `bar`, then three characters forward: the region is `bar`
  (press (m-of search-text) [:right :right :right :right (keyword "ctrl- ") :right :right :right]))

(defn- face-of (ops needle face-pred)
  (nth (seq/find ops
         (fn (op)
           (and (= (first op) :text) (= (nth op 3 "") needle) (face-pred (nth op 4 nil)))))
    4 nil))

(describe "the selection and the search's matches read as three things"
  (test "the region is overlay2 at 25%, the other matches a teal tint, the current match yellow"
    (assert= (:bg face-region) (mix *overlay2* *base* 0.25))
    (assert= (:bg face-isearch-lazy) (mix *teal* *base* 0.25))
    (assert= (:bg face-isearch) *yellow*))
  (test "the frame paints the three in three different backgrounds, none the editor's"
    (let (search-ops (ed-view (searching) 80 24)
          region-ops (ed-view (selecting) 80 24)
          current (:bg (face-of search-ops "foo" (fn (face) (= face face-isearch))))
          lazy (:bg (face-of search-ops "foo" (fn (face) (= face face-isearch-lazy))))
          region (:bg (face-of region-ops "bar" (fn (face) (= (:bg face) (:bg face-region))))))
      (is (not (nil? current)))
      (is (not (nil? lazy)))
      (is (not (nil? region)))
      (assert= (count (into #{} [current lazy region *base*])) 4)))
  (test "in the window's pixels too"
    (when (and (gui/available?) (bound? 'gui/render-frame))
      (let (spec {:width 800
                  :height 480
                  :font (config/setting {} :font)
                  :size (config/setting {} :font-size)
                  :line-height (config/setting {} :line-height)
                  :inset startup/*inset*
                  :bg *base*}
            grid (:grid (gui/render-frame [[:clear]] spec))
            paint (fn (m)
                    (let (ops (view/ed-view m (first grid) (second grid)))
                      [ops (gui/render-frame ops spec)]))
            ;; the top-left pixel of the cell where `needle`'s op starts: inside the text's
            ;; background, clear of any glyph's ink
            sample (fn (painted needle face-pred)
                     (let ([ops image] painted
                           op (seq/find ops
                                (fn (op)
                                  (and (= (first op) :text)
                                    (= (nth op 3 "") needle)
                                    (face-pred (nth op 4 nil)))))
                           [cell-w cell-h] (:cell image)
                           [origin-x origin-y] (:origin image))
                       (gui/pixel image
                         (+ origin-x (* cell-w (nth op 2)) 1)
                         (+ origin-y (* cell-h (nth op 1)) 1))))
            search-painted (paint (searching))
            region-painted (paint (selecting))
            current (sample search-painted "foo" (fn (face) (= face face-isearch)))
            lazy (sample search-painted "foo" (fn (face) (= face face-isearch-lazy)))
            region (sample region-painted "bar" (fn (face) (= (:bg face) (:bg face-region))))
            background (gui/pixel (second region-painted) 1 1))
        (assert= (count (into #{} [current lazy region background])) 4)))))

;; ---- plain text ------------------------------------------------------------------
;; Text no face colours — a plain identifier, the echo line — carries no `:fg` in the frame:
;; the WINDOW's default text colour paints it (brood's `gui/fg`, ADR-613), set with the
;; background by every theme switch (`window-look!`). Before, only the background was set and
;; plain text kept the renderer's light default: on Catppuccin Latte, light grey on white.

(defn- hex->rgb (color)
  (seq/mapv [0 1 2]
    (fn (i) (string/->number (string/substring color (+ 1 (* 2 i)) (+ 3 (* 2 i))) 16))))

(describe "every theme paints plain text in its own text colour"
  :isolated (test "the window's default face is the code tier on the base, for every theme"
    (let (looks (map themes/*themes*
                  (fn (theme)
                    (themes/theme-activate! (:name theme))
                    [(window-look) {:bg *base* :fg *fg-code*}]))
          _ (theme-apply! *theme-mocha*))
      (is (every? looks (fn ([look expected]) (= look expected))))))
  (test "an identifier with no face is painted in it, in the window's pixels"
    (when (and (gui/available?) (bound? 'gui/render-frame))
      (let (m (m-of "x █plain")
            painted (fn (theme)
                      (themes/theme-activate! (:name theme))
                      (let (look (window-look)
                            ops (ed-view m 40 6)
                            op (seq/find ops
                                 (fn (op)
                                   (and (= (first op) :text) (includes? (nth op 3 "") "█plain"))))
                            image (gui/render-frame ops
                                    {:width 400 :height 140 :bg (:bg look) :fg (:fg look)})
                            [cell-w cell-h] (:cell image)
                            [origin-x origin-y] (:origin image)
                            column (+ (nth op 2) (index-of (nth op 3) "█")))
                        [(:name theme)
                          (:fg (nth op 4 {}))
                          (gui/pixel image
                            (+ origin-x (* cell-w column) (math/quot cell-w 2))
                            (+ origin-y (* cell-h (nth op 1)) (math/quot cell-h 2)))
                          (hex->rgb (:fg look))]))
            results (map themes/*themes* painted)
            _ (theme-apply! *theme-mocha*))
        ;; the frame leaves the text's colour to the window, and the window paints the theme's
        (assert= (vec (seq/filter results
                        (fn ([_ face-fg pixel expected])
                          (or (not (nil? face-fg)) (not (= pixel expected))))))
          [])))))

;; ---- the gutter -----------------------------------------------------------------

(describe "the gutter sits on the editor background"
  (test "its surface is the base, its numbers the tertiary tier"
    (assert= face-gutter-bg {:bg *base*})
    (assert= face-gutter-line {:fg *fg-tertiary*}))
  (test "the current line's number is lavender, the others are not"
    (let (m (press (m-of "one\ntwo\nthree") [:ctrl-n])
          ops (ed-view m 80 24)
          numbers (fn (digit)
                    (seq/filter ops
                      (fn (op) (and (= (first op) :text) (= (string/trim (nth op 3 "")) digit)))))
          lavender? (fn (op) (= (:fg (nth op 4 nil)) *lavender*)))
      (is (any? (numbers "2") lavender?))
      (is (not (any? (numbers "1") lavender?)))
      (is (not (any? (numbers "3") lavender?)))))
  (test "only the selected pane marks its current number"
    (let (split (press (m-of "one\ntwo") [:ctrl-x "2"])
          lavender (seq/filter (ed-view split 80 24)
                     (fn (op) (and (= (first op) :text) (= (:fg (nth op 4 nil)) *lavender*)))))
      (assert= (count lavender) 1))))

;; ---- the calm syntax variant ------------------------------------------------------

(defn- chroma (hex)
  "How coloured `hex` is: its largest channel less its smallest (0 for a grey)."
  (let (channels (map [1 3 5]
                   (fn (at)
                     (let (value (string/->number (string/substring hex at (+ at 2)) 16))
                       (if (int? value) value 0)))))
    (- (reduce channels math/max) (reduce channels math/min))))

(describe "Catppuccin Mocha Calm"
  (test "is in the registry, and is not the default"
    (is (any? themes/*themes* (fn (theme) (= (:name theme) "Catppuccin Mocha Calm"))))
    (assert= (:name (first themes/*themes*)) "Catppuccin Mocha"))
  (test "no bold, no italic; keywords plain; comments readable; literals coloured"
    (let (faces themes/*mocha-calm-faces*
          syntax (seq/filter faces (fn ([name _]) (string/starts-with? (->string name) ":syntax/"))))
      (is (every? syntax (fn ([_ face]) (and (not (:bold face)) (not (:italic face))))))
      (assert= (:fg (:syntax/special faces)) (:text *theme-mocha*))
      (assert= (:fg (:syntax/keyword faces)) (:text *theme-mocha*))
      (is (>= (magnitude (:fg (:syntax/comment faces)) (:base *theme-mocha*)) 60))
      (assert= (:fg (:syntax/string faces)) (:green *theme-mocha*))
      (assert= (:fg (:syntax/number faces)) (:peach *theme-mocha*))))
  (test "its depth-coloured brackets are lower in chroma than the default's"
    (let (default-colours [:text :mauve :blue :peach :green :yellow :teal :red :subtext])
      (each (seq/enumerate default-colours)
        (fn ([index role])
          (let (calm (:fg (get themes/*mocha-calm-faces*
                            (keyword (str "syntax/delimiter-" (inc index)))))
                full (get *theme-mocha* role))
            (is (<= (chroma calm) (chroma full)))
            (is (< (magnitude calm (:base *theme-mocha*))
                  (+ 0.5 (magnitude full (:base *theme-mocha*))))))))))
  :isolated (test "activating it restyles the syntax and leaves the chrome alone"
    (let (_ (themes/theme-activate! "Catppuccin Mocha Calm")
          keyword-face (editor/face/face :syntax/special)
          modeline face-modeline
          _ (theme-apply! *theme-mocha*))
      (assert= keyword-face {:fg (:text *theme-mocha*)})
      (assert= modeline {:fg (:subtext *theme-mocha*) :bg (:mantle *theme-mocha*)}))))

;; ---- definitions and punctuation (brood ADR-614) -----------------------------------
;; The two faces are new; a theme that names neither must look as it did — the definition
;; face resolving to the call face it used to share, punctuation to no colour at all.
(describe "definitions and punctuation across the registry"
  :isolated (test "a theme that names neither face looks as it did"
    (doseq (theme themes/*themes*)
      (when (not (= (:name theme) "Catppuccin Mocha Calm"))
        (themes/theme-activate! (:name theme))
        (assert= (editor/face/face :syntax/definition) (editor/face/face :syntax/function))
        (assert= (editor/face/face :syntax/punctuation) {})))
    (theme-apply! *theme-mocha*))
  (test "the calm theme colours definitions, leaves calls plain and dims punctuation"
    (themes/theme-activate! "Catppuccin Mocha Calm")
    (let (definition (:fg (editor/face/face :syntax/definition))
          call (:fg (editor/face/face :syntax/function))
          punctuation (:fg (editor/face/face :syntax/punctuation))
          base (:base *theme-mocha*))
      (theme-apply! *theme-mocha*)
      (assert= call (:text *theme-mocha*))
      (is (> (chroma definition) (chroma call)))
      (assert= punctuation (:overlay2 *theme-mocha*))
      ;; dimmer than the text, still well above a disabled control's floor
      (is (< (magnitude punctuation base) (magnitude call base)))
      (is (>= (magnitude punctuation base) 40)))))

;; ---- keyword literals and named constants (brood ADR-616) ---------------------------
;; A language's keywords (`def`, `fn`) and its literals (`:foo`, `True`, an atom) were painted
;; in the keyword and special faces; each literal now has a face of its own. A theme that
;; names neither must look as it did — every literal in the colour it had.
(describe "keywords and literals across the registry"
  :isolated (test "a theme that names neither literal face looks as it did"
    (doseq (theme themes/*themes*)
      (when (not (= (:name theme) "Catppuccin Mocha Calm"))
        (themes/theme-activate! (:name theme))
        (assert= (editor/face/face :syntax/symbol) (editor/face/face :syntax/keyword))
        (assert= (editor/face/face :syntax/constant) (editor/face/face :syntax/special))))
    (theme-apply! *theme-mocha*))
  (test "the default theme's keyword, `:foo` and `True` colours are the ones they were"
    (themes/theme-activate! "Catppuccin Mocha")
    (let (keyword-face (editor/face/face :syntax/keyword)
          symbol (editor/face/face :syntax/symbol)
          constant (editor/face/face :syntax/constant))
      (theme-apply! *theme-mocha*)
      (assert= keyword-face {:fg (:yellow *theme-mocha*)})
      (assert= symbol {:fg (:yellow *theme-mocha*)})
      (assert= constant {:fg (:mauve *theme-mocha*)})))
  (test "the calm theme leaves keywords the text colour and colours the literals"
    (themes/theme-activate! "Catppuccin Mocha Calm")
    (let (keyword-face (:fg (editor/face/face :syntax/keyword))
          symbol (:fg (editor/face/face :syntax/symbol))
          constant (:fg (editor/face/face :syntax/constant)))
      (theme-apply! *theme-mocha*)
      (assert= keyword-face (:text *theme-mocha*))
      (assert= symbol (:mauve *theme-mocha*))
      (assert= constant (:mauve *theme-mocha*)))))

;; ---- init.blsp's :faces (Emacs's custom-set-faces) ----------------------------------
(describe "init.blsp's :faces over every theme"
  :isolated (test "a face named there holds at startup, across a theme switch, and goes when removed"
    (let (wanted {:fg "#888888" :italic true}
          config {:faces {:syntax/comment wanted 'theme/face-hl-line {:bg "#010203"}}})
      (binding (*windowless-runtime* true)
        (themes/theme-from-config! config)
        (assert= (editor/face/face :syntax/comment) wanted)
        (assert= face-hl-line {:bg "#010203"})
        ;; a theme switch keeps it
        (themes/theme-activate! "Catppuccin Mocha Calm")
        (assert= (editor/face/face :syntax/comment) wanted)
        ;; M-x reload-config with it gone: the theme's own again
        (themes/theme-from-config! {})
        (assert= (editor/face/face :syntax/comment)
          (get themes/*mocha-calm-faces* :syntax/comment))
        (is (not (= face-hl-line {:bg "#010203"})))
        (theme-apply! *theme-mocha*))))
  (test "the setting's values are checked"
    (is (config/faces-valid? {:syntax/comment {:fg "#888888"}}))
    (is (not (config/faces-valid? {:syntax/comment "#888888"})))
    (is (not (config/faces-valid? [:syntax/comment])))))
