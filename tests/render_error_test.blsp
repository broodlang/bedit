;; A frame that cannot be painted must never leave a question unanswerable. When the view
;; raises, the editor paints `render error: …` in place of the frame (`view/ed-render-error-
;; frame`) — and a question standing then (C-x C-c's "save this buffer?", any y/n read) has to
;; stay on screen above it, or the editor waits for an answer no one can see and cannot even be
;; quit (2026-11-11: a plugin's mode-line chip raised on every frame, and C-x C-c hung).

(defmodule render-error-test
  (:use test)
  (:use model)
  (:use editor/buffer))

(defn ret-texts (frame)
  "Every text a frame paints."
  (vec (seq/keep frame (fn (op) (when (and (vector? op) (= (first op) :text)) (str (nth op 3 "")))))))

(defn ret-broken (m)
  "`m` with a layout the view cannot lay out: every frame raises."
  (assoc m :layout :not-a-layout))

(describe "a frame that cannot be painted"
  (test "still shows a standing question, so it can be answered"
    (let (asking (ed-read-char (ed-init (make-buffer ""))
                   "Modified buffers exist; exit anyway? (y or n) "
                   (fn (m _key) m))
          texts (ret-texts (view/ed-view (ret-broken asking) 80 10)))
      (is (any? texts (fn (text) (includes? text "render error"))))
      (is (any? texts (fn (text) (includes? text "exit anyway? (y or n)"))))))
  (test "with nothing asked, only the error"
    (let (texts (ret-texts (view/ed-view (ret-broken (ed-init (make-buffer ""))) 80 10)))
      (is (any? texts (fn (text) (includes? text "render error")))))))
