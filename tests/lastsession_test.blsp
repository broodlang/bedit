;; tests/lastsession_test.blsp — the last session in a project reopened (Emacs's desktop): its
;; files, and each pane on its file at its scroll and point; a file gone since is skipped.

(defmodule lastsession-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use editor/pane)
  (:use pool) ; *read-off-loop* / *read-off-loop-bytes*: a large file read off the loop
  (:use lastsession))

(defn- project ()
  (let (root (temp-dir "bedit-lastsession-"))
    (file/mkdir root)
    (file/spit (path/join root "a.txt") "alpha\nbeta\n")
    (file/spit (path/join root "b.txt") "one\ntwo\nthree\n")
    root))

(defn- working (root)
  ;; a.txt and b.txt open, the window split with b.txt (point on `two`) beside a.txt
  (let (m (assoc (ed-init (make-buffer ""))
            :project-root root
            :session-root root
            :restore-session true)
        with-a (pool/ed-find-file m (path/join root "a.txt"))
        split (assoc with-a
                :layout (pane-split (:layout with-a) :col (ed-pane (ed-current-index with-a))))
        with-b (pool/ed-find-file split (path/join root "b.txt")))
    (ed-set-buf with-b (goto-char (ed-current-buf with-b) 4))))

(defn- pane-files (m)
  (map (pane-leaf-paths (:layout m))
    (fn (path) (buffer-file (ed-buf-at m (:buffer (pane-payload-at (:layout m) path)))))))

(describe "a session"
  (test "names each pane's buffer by its file, with its point"
    (let (root (project)
          session (session-of (working root)))
      (assert= (:files session) [(path/join root "a.txt") (path/join root "b.txt")])
      (is (any? (map (pane-leaf-paths (:layout session))
                  (fn (path) (pane-payload-at (:layout session) path)))
            (fn (pane) (and (= (:file pane) (path/join root "b.txt")) (= (:point pane) 4)))))))

  ;; Emacs bug#82040: the buffer order was the pool's, so C-x b's default after a restore was
  ;; arbitrary
  (test "the files are kept most recently selected first, and the restore keeps that recency"
    (let (root (project)
          m (working root)
          a (path/join root "a.txt")
          b (path/join root "b.txt")
          ;; b selected, then a: a is the most recent
          visited (ed-note-buffer-recency (pool/ed-find-file (ed-note-buffer-recency (pool/ed-find-file m
                                                                                       b))
                                            a))
          session (session-of visited)
          fresh (assoc (ed-init (make-buffer "")) :project-root root :session-root root)
          restored (restore fresh session))
      (assert= (:files session) [a b])
      (assert= (vec (take (ed-recent-buffers restored) 2)) ["a.txt" "b.txt"])
      (let (later (session-of (ed-note-buffer-recency (pool/ed-find-file visited b))))
        (assert= (:files later) [b a]))))

  (test "saved at quit and reopened at the next start: the files, the panes, the points"
    (let (root (project)
          _ (save! (working root))
          fresh (assoc (ed-init (make-buffer ""))
                  :project-root root
                  :session-root root
                  :restore-session true)
          restored (restore-for-start fresh))
      (assert= (pane-files restored) (pane-files (working root)))
      (assert= (buffer-file (ed-current-buf restored)) (path/join root "b.txt"))
      (assert= (buffer-point (ed-current-buf restored)) 4)
      (is (includes? (:echo restored) "2 files"))))

  (test "large files are read off the loop: each pane gets its file, and point, as it lands"
    (let (root (project)
          session (session-of (working root))
          restoring (binding (*read-off-loop* true *read-off-loop-bytes* 4)
                      (restore (assoc (ed-init (make-buffer "")) :project-root root) session))
          land (fn (m) (pool/ed-apply-read m (task/await (:read-proc m) 5000)))
          ;; one read at a time: a.txt's, then b.txt's
          restored (land (land restoring)))
      (assert= (buffer-text (ed-current-buf restoring)) "Loading…\n")
      (assert= (pane-files restored) (pane-files (working root)))
      (assert= (buffer-file (ed-current-buf restored)) (path/join root "b.txt"))
      (assert= (buffer-point (ed-current-buf restored)) 4)))

  (test "a file gone since is skipped; its panes show the session's first file"
    (let (root (project)
          session (session-of (working root))
          _ (file/rm (path/join root "b.txt"))
          restored (restore (assoc (ed-init (make-buffer "")) :project-root root) session))
      (assert= (into #{} (pane-files restored)) #{(path/join root "a.txt")})))

  (test "the tabs come back too: each its layout and name, the one shown shown"
    ;; tab 0 the split session, renamed; tab 1 a.txt alone, shown
    (let (root (project)
          working-tabs (tabbar/rename-tab (working root) "work")
          tabbed (tabbar/new-tab working-tabs (pane-delete-others (:layout working-tabs)))
          tabbed (pool/ed-find-file tabbed (path/join root "a.txt"))
          _ (save! tabbed)
          fresh (assoc (ed-init (make-buffer ""))
                  :project-root root
                  :session-root root
                  :restore-session true)
          restored (restore-for-start fresh))
      (assert= (count (tabbar/tabs restored)) 2)
      (assert= (tabbar/current-tab restored) 1)
      (assert= (vec (pane-files restored)) [(path/join root "a.txt")])
      (assert= (tabbar/tab-name restored 0) "work")
      (assert= (pane-files (tabbar/select-tab restored 0)) (pane-files (working root)))))

  (test "off, or no session kept: the start is left as it was"
    (let (root (project)
          fresh (assoc (ed-init (make-buffer ""))
                  :project-root root
                  :session-root root
                  :restore-session true))
      (assert= (restore-for-start fresh) fresh)
      (assert= (restore-for-start (assoc fresh :restore-session false))
        (assoc fresh :restore-session false)))))
