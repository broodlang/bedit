;; Plugin discovery — the editor folding in packages that `:enhances bedit`
;; (src/plugins.blsp). We test the PURE half on fixtures: the `enhances-bedit?`
;; predicate (names bedit AND the constraint accepts us), and the `enhancers` disk
;; walk over a temp `_deps/` of hand-written manifests — a plain dep, an enhancer of
;; something else, and an enhancer whose constraint is too new all stay out; only a
;; satisfied `:enhances bedit` package is discovered. The apply half (`require` + the
;; global theme rebind) is a live-editor concern exercised by hand, not here.

(defmodule plugins-test
  (:use test)
  (:use-internals plugins))

(require 'plugins)

(purge-stale-temp "bedit-plug-") ; drop fixtures a prior run left in /tmp (at load)

;; Build a temp project root with a `_deps/` of manifests: `layout` is a map of
;; dep-name -> the `:enhances …` clause text (or "" for a plain dep). Returns the root.
(defn with-deps (layout)
  (let (root (temp-dir "bedit-plug-"))
    (doseq (kv (map-pairs layout))
      (let ([name enhances] kv
            dir (str root "/_deps/" name))
        (make-dir dir)
        (spit (str dir "/project.blsp")
          (str "(project :name \"" name "\" :version \"1.0.0\" " enhances ")"))))
    root))

(describe "enhances-bedit? — the plugin predicate"
  (test "true when it names bedit and the constraint accepts us"
    (assert= (enhances-bedit? {'bedit ">= 0.1"}) true))

  (test "falsy for a constraint that wants a newer bedit than ours"
    (refute (enhances-bedit? {'bedit ">= 9.0"})))

  (test "falsy for an empty map (naming bedit is what gates, not vacuous satisfaction)"
    (refute (enhances-bedit? {})))

  (test "falsy when it enhances a DIFFERENT application"
    (refute (enhances-bedit? {'someother ">= 0.1"}))))

(describe "dep-enhances — reading a manifest's :enhances"
  (test "plucks the map from a (project …) manifest"
    (let (root (with-deps {'foo ":enhances {bedit \">= 0.1\"}"}))
      (assert= (dep-enhances root 'foo) {'bedit ">= 0.1"})))

  (test "{} for a manifest with no :enhances"
    (let (root (with-deps {'plain ""}))
      (assert= (dep-enhances root 'plain) {})))

  (test "{} for a missing dep (never throws)"
    (assert= (dep-enhances (temp-dir "bedit-plug-") 'nope) {})))

(describe "enhancers — the _deps walk"
  (test "keeps only satisfied bedit enhancers"
    (let (root (with-deps {'good ":enhances {bedit \">= 0.1\"}"
                           'plain ""
                           'other ":enhances {zig \">= 0.1\"}"
                           'toonew ":enhances {bedit \">= 9.0\"}"}))
      (assert= (enhancers root) ["good"])))

  (test "[] when there is no _deps at all"
    (assert= (enhancers (temp-dir "bedit-plug-")) [])))
