;; Plugin loading — the editor folding in packages that `:enhances bedit`
;; (src/plugins.blsp). DISCOVERY (which installed packages qualify) now lives in std
;; and is tested there — `installed-enhancers` in brood's tests/project_test.blsp.
;; What's bedit's own is the apply path: delegate to std, then require + register.
;; This smoke-tests that it's wired and safe; the require+register half needs a real
;; installed plugin, exercised by hand in the live editor.

(defmodule plugins-test
  (:use test)
  (:use plugins))

(require 'plugins)

(purge-stale-temp "bedit-plug-") ; drop fixtures a prior run left in /tmp (at load)

(describe "load-plugins! — folding in :enhances bedit packages"
  (test "a root with no _deps loads nothing, and never throws"
    (assert= (load-plugins! (temp-dir "bedit-plug-")) []))

  (test "*bedit-version* is the version plugins are checked against"
    (is (string? *bedit-version*))))
