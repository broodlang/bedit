;; tests/codefold_test.blsp — code folding (Emacs's hideshow): what a block covers, read from
;; the parse (a tree-sitter mode's node, a Lisp's form), the C-c @ keys, and the ellipsis a
;; folded line shows.

(defmodule codefold-test
  (:use testkit :only [press cur]) ; the shared test helpers (tests/support)
  (:use test)
  (:use model)
  (:use input)
  (:use codefold)
  (:use editor/buffer))

(defn- file-model (text file point)
  (let (m (ed-init (make-buffer text file file)))
    (ed-set-buf m (goto-char (ed-current-buf m) point))))
(defn- extent-of (text file line) (folds/extent (cur (file-model text file 0)) line))

(def- ruby "class A\n  def f\n    x\n    y\n  end\n\n  def g = 1\nend\n")

(describe "what a block covers"
  (test "a Ruby method hides its body; its `end` stays showing"
    (assert= (extent-of ruby "a.rb" 1) 3)
    ;; the class: everything to the line before its own `end`
    (assert= (extent-of ruby "a.rb" 0) 6))
  (test "a line that opens nothing folds nothing"
    (assert= (extent-of ruby "a.rb" 2) nil)
    (assert= (extent-of ruby "a.rb" 6) nil))
  (test "an Elixir do-block, likewise"
    (assert= (extent-of "defmodule A do\n  def f(x) do\n    x\n  end\nend\n" "a.ex" 1) 2))
  (test "a Lisp form hides through the line it closes on"
    (assert= (extent-of "(defn f (x)\n  (+ x\n     1))\n(g)\n" "a.blsp" 0) 2)
    (assert= (extent-of "(defn f (x)\n  (+ x\n     1))\n(g)\n" "a.blsp" 3) nil)))

(describe "the hideshow keys (C-c @)"
  (test "C-c @ C-c inside a block folds it, point to its first line; again unfolds it"
    (let (folded (press (file-model ruby "a.rb" 20) [:ctrl-c "@" :ctrl-c]))
      (assert= (folds/folded-lines (cur folded)) '(1))
      (assert= (buffer-current-line (cur folded)) 1)
      (is (contains? (folds/hidden-lines (cur folded)) 2))
      (assert= (folds/folded-lines (cur (press folded [:ctrl-c "@" :ctrl-c]))) '())))
  (test "C-c @ C-M-h folds every top-level block; C-c @ C-M-s opens them all"
    (let (text "def a\n  1\nend\n\ndef b\n  2\nend\n"
          hidden (press (file-model text "a.rb" 0) [:ctrl-c "@" :ctrl-meta-h]))
      (assert= (folds/folded-lines (cur hidden)) '(0 4))
      (assert= (folds/folded-lines (cur (press hidden [:ctrl-c "@" :ctrl-meta-s]))) '())))
  (test "a mode with nothing to fold says so and fails"
    ;; C-c @ is bound only where code folds (prog modes); the command itself says why not
    (is (:command-failed (cmd-hs-toggle-hiding (file-model "plain words\n" "a.txt" 0) nil)))))

(describe "a folded line shows that it folds"
  (test "an ellipsis is painted after the folded line"
    (let (m (press (ed-update (file-model ruby "a.rb" 20) [:resize 80 24] 80 24)
              [:ctrl-c "@" :ctrl-c])
          frame (view/ed-view m 80 24)
          texts (map (seq/filter frame (fn (op) (= (first op) :text))) (fn (op) (nth op 3 ""))))
      (is (includes? texts " …")))))
