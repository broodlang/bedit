;; Shell (src/languages/shell.blsp): a `deflanguage` over tree-sitter-bash that keeps its line lexer
;; (src/languages/lex-shell.blsp) as the `:fallback`, typed by extension, name or `#!` line.
;; Two halves: the STAND-IN, its line lexer, tested whatever is installed (`model/*grammar-ready?*`
;; answers "missing"), and the parsed mode, which needs the grammar (`testkit/load-test-grammar`:
;; `$BROOD_TEST_GRAMMARS`, else `~/.config/bedit/grammars`) and SKIPS without it.
(defmodule languages-shell-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use pool :only [ed-open-buffer])
  (:use testkit :only [m-of file-model file-buffer press face-at fontified]))

(defn- face-of (name) (editor/face/face name))

;; ---- shell, parsed by tree-sitter-bash ----------------------------------------------
(describe "shell-mode declares its grammar, formatter and interpreters"
  (test "the shells' start-up files and direnv's .envrc open in shell mode"
    (doseq (file ["/h/.bashrc" "/h/.zshrc" "/h/.profile" "/h/.bash_profile" "/p/.envrc"])
      (assert= (ed-buf-mode-name (file-buffer "" file)) "shell")))
  (test "where tree-sitter-bash lives, and shfmt"
    (assert= (:url (model/grammar-source :bash))
      "https://github.com/tree-sitter/tree-sitter-bash")
    (assert= (first (ed-mode-service (file-buffer "" "/p/run.sh") :format-command)) "shfmt"))
  (test "the restart is a column-0 statement, not prose inside a string or a heredoc"
    (let (src "usage=\"one\ntwo three\nfour\"\n\nbuild() {\n  make\n}\n")
      (assert= (languages/shell/shell-restart src (index-of src "four")) 0)
      (assert= (languages/shell/shell-restart src (index-of src "  make"))
        (index-of src "build()")))
    (let (src "cat <<EOF\nNAME=x\nEOF\nif true; then\n  echo\nfi\n")
      (assert= (languages/shell/shell-restart src (index-of src "  echo")) 0))))

;; The sample, tests/corpus/shell/release.sh (`shfmt -i 2`), is checked by
;; tests/language_corpus_test.blsp — its mode, colours, indentation and restart — beside
;; tests/corpus/shell/deploy.sh. What stays here is what a caret line cannot reach: the text of a
;; heredoc and of a multi-line string, and a command after a `\` continuation.
(def sh-src (file/slurp "tests/corpus/shell/release.sh"))

(describe "shell, parsed"
  :skip-unless (testkit/load-test-grammar :bash)
  "no bash grammar"
  (defn- sh-spans () (fontified sh-src "release.sh"))

  (test "a block folds; a command continued over lines does not (`:folds`)"
    (let (rope (text/string-> "make a \\\n  b \\\n  c\nx() {\n  y\n}\n"))
      (assert= (languages/shell/shell-fold-extent rope 0) nil)
      (assert= (languages/shell/shell-fold-extent rope 3) 4)))
  ;; the lexer coloured a multi-line string's first line only, and a heredoc not at all
  (test "a heredoc and a multi-line string are strings to their last line"
    (assert= (face-at (sh-spans) sh-src "usage: deploy") (face-of :syntax/string))
    (assert= (face-at (sh-spans) sh-src "line one") (face-of :syntax/string))
    (is (not (nil? (seq/find (sh-spans)
                     (fn (span)
                       (and (<= (first span) (index-of sh-src "line two"))
                         (> (second span) (index-of sh-src "line two"))
                         (= (nth span 2) (face-of :syntax/string)))))))))
  (test "a command after a continuation is a call"
    (assert= (face-at (sh-spans) sh-src "docker") (face-of :syntax/function)))
  (test "TAB inside a heredoc leaves the line as it was written"
    (let (text "f() {\n  cat <<EOF\n      kept\nEOF\n}\n"
          m (file-model text "a.sh")
          on (ed-set-buf m (goto-char (ed-current-buf m) (index-of text "kept"))))
      (assert= (buffer-text (ed-current-buf (press on [:tab]))) text)))
  (test "RET after `then` indents the new line, though nothing parses yet"
    (let (text "if true; then"
          m (file-model text "a.sh")
          entered (press (ed-set-buf m (goto-char (ed-current-buf m) (count text)))
                    [:enter]))
      (assert= (buffer-text (ed-current-buf entered)) (str text "\n  "))))
  (test "C-M-a lands on the enclosing function"
    (assert= (languages/defun-start sh-src :bash (index-of sh-src "xargs"))
      (index-of sh-src "function build"))
    (assert= (languages/defun-start sh-src :bash (index-of sh-src "dry run"))
      (index-of sh-src "usage() {"))))

(describe "shell-mode — by extension, by name, and by the #! line"
  (test "a .sh file and a dotfile are shell; a bare name is not"
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/p/build.sh"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/home/u/.bashrc"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "x" "b") :file "/p/run"))
      :fundamental))
  (test "an extensionless script with a bash shebang is shell (interpreter-mode-alist)"
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env bash\nset -euo pipefail\n"
                                                     "run")
                                              :file "/p/run"))
      :shell)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/bin/sh\necho hi\n" "run")
                                              :file "/p/run"))
      :shell)
    ;; the filename rule wins over the shebang, and a non-shell shebang stays fundamental
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env bash\n" "n.md")
                                              :file "/p/n.md"))
      :markdown)
    (assert= (editor/layers/buffer-type-for (assoc (make-buffer "#!/usr/bin/env tclsh\n" "t")
                                              :file "/p/t"))
      :fundamental))
  ;; the line lexer is shell's stand-in while bash's grammar is missing
  ;; (tests/lexed_languages_test.blsp); here it is asked for, whatever is installed
  (test "the shell layer fontifies through the shared spans shape"
    (let (m (binding (*grammar-ready?* (fn (_lang) false))
              (ed-open-buffer (m-of "") (make-buffer "echo \"$HOME\" # hi" "/p/s.sh" "/p/s.sh")))
          fontify (ed-mode-service (ed-current-buf m) :fontify))
      (is (fn? fontify))
      (assert= (map (fontify "echo \"$HOME\" # hi") (fn ([s e _]) [s e]))
        (list [0 4] [5 12] [13 17])))))
