;; myedit — a super-minimal GUI text editor, built on the rope-backed buffer
;; framework (std/buffer.blsp) + the ui-run loop (std/ui.blsp). The M2 editor
;; app: a standalone `nest` project that `(:use buffer)`s the framework, as
;; opposed to the naive `nest new --template editor` starter. See src/main.blsp.
;;
;; Run it (needs a GUI-enabled `nest` — `./configure --with-gui && make install`
;; in the brood repo):
;;     nest run                 ; a scratch buffer
;;     nest run -- notes.txt    ; open (Ctrl-S saves) that file
(project :name
  "myedit"
  :version
  "0.1.0")
