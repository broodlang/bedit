(defmodule eval-command
  "Evaluate Brood source and describe the result. Add `(:use eval-command)` to a
module's header (or call the fns qualified as `eval-command/…`, which auto-loads):

    (eval-command/eval-source (eval-command/last-sexp-source \"(+ 1 2)\" 7))  ; => \"=> 3\"

`last-sexp-source` returns the source of the last complete form ending at or before
point (pure — no eval); `eval-source` evaluates a source string and returns a message
string (captured output then `=> <value>`, or `error: <…>`), never throwing. The
editor reads the form on its own process, then hands the string to a spawned
evaluator — so neither call assumes a buffer or blocks the loop.")

;; ---- the value+output core --------------------------------------------------

(defn- eval-command-capturing (thunk)
  "Run `thunk` with stdout captured; return `[value output-string]`. Pops the
capture buffer even if `thunk` throws (re-raising), so a failed eval never leaves a
dangling capture. The low-level pairing under `eval-source` — it keeps *both* halves
a REPL shows (the value and what was printed), which `with-out-str` can't, since it
discards the value. The same pairing graduated to std as `eval-server/eval-capturing`
(ADR-198) in string-in/reply-map-out shape (never throws, `pr-str-bounded` value) —
that one feeds the tutorial's sandbox and any wire; this thunk-shaped, rethrowing,
full-`pr-str` variant stays because `eval-source`'s exact output is bshell's and
C-x C-e's contract."
  (do
    (%capture-begin)
    (let (v (try (thunk) (catch e (do (%capture-take) (throw e)))))
      [v (%capture-take)])))

(defn- eval-command-describe (thunk)
  "Run `thunk` (which produces a value, perhaps printing along the way) and format a
message string: any captured output, then `=> <value>`. A throw — from reading or
from evaluating — becomes `error: <message>` instead of propagating."
  (try
    (let (vo (eval-command-capturing thunk)
          out (second vo))
      (str (if (= out "") "" (str out (if (string/ends-with? out "\n") "" "\n")))
        "=> "
        ;; the echo area / *Messages* is a display, so the value prints bounded (Emacs's
        ;; own `eval-expression-print-length`/`-level` exist for the same reason);
        ;; `(binding (*print-length* nil) …)` around the form shows one whole
        (pr-str-bounded (first vo))))
    (catch e (str "error: " (error-message e)))))

;; ---- the session's compile context ------------------------------------------

;; The compile context — the namespace a `defmodule` opened AND its `(:use …)` imports
;; — is PER PROCESS, and every `C-x C-e` evaluates in a fresh one (`task/latest` in
;; commands.blsp). Without this hand-over `(defmodule calc)` set the namespace of an
;; evaluator that then exited, the next form's `(defn eval (exp) exp)` defined a bare
;; `eval` (the echo read `=> eval`), and `(calc/eval …)` was `unbound symbol` — a module
;; could never be built one form at a time. A module-private global, because a `def`
;; is shared across every process of the runtime: each evaluator restores it first and
;; re-snapshots it after a successful eval (a form that threw does not move it). The
;; same discipline as brood's `eval-server/answer`; `%compile-context` is its primitive.
(def- *session-context* nil)

(defn- eval-command-in-session (thunk)
  "Run `thunk` under the session's compile context and record where it left it."
  (do
    (when *session-context* (%restore-compile-context *session-context*))
    (let (v (thunk))
      (def- *session-context* (%compile-context))
      v)))

;; ---- the string entry (so an evaluator can run on any process) --------------

;; ---- the contract, re-checked on a live redefinition ------------------------------
;; `defcommand` declares `(sig cmd (model any -> model))` for every command, and `nest
;; check` holds the file to it. A command redefined LIVE — `C-x C-e` on its form — used to
;; escape that: the new body ran from the next keystroke with nobody having read it against
;; the contract. So an eval of a definition ends with the checker's verdict on exactly what
;; was evaluated, under the session's own namespace and imports
;; (`reflect/check-string-here`, brood ADR-327 addendum): `✓ cmd-x honours (model any ->
;; model)`, or the mismatch, named through the alias the sig spelled — `declared return
;; type model but the body yields 42`. Only definitions get a verdict; `(+ 1 2)` is not a
;; contract and reads as before.

(def- *definition-heads*
  '(defcommand interactive/defcommand defn defn- sig))

(defn- defined-names (src)
  "The names the top-level forms of `src` define — a `defcommand`/`defn`/`sig` head's
second element — as symbols, in order; `()` when it does not parse."
  (check-allow :discarded-catch
    (try
      (seq/keep (reflect/read-all src)
        (fn (form)
          (if (and (list? form) (>= (count form) 2) (includes? *definition-heads* (first form))
                (symbol? (second form)))
            (second form)
            nil)))
      (catch _ '()))))

(defn contract-notes (src)
  "The checker's verdict on the definitions in `src`, after they were evaluated here: one
line per warning (`✗ …`), else one `✓ name honours <sig>` per name with a declared
signature; `\"\"` when `src` defines nothing. Runs under the process's current compile
context — the session's — so a bare import and the module's own types resolve as the
eval just resolved them."
  (let (names (seq/distinct (defined-names src)))
    (if (empty? names)
      ""
      (let (warnings (check-allow :discarded-catch
                       (try (reflect/check-string-here src) (catch _ '()))))
        (if (empty? warnings)
          (string/join
            (seq/keep names
              (fn (n)
                (let (sig (check-allow :discarded-catch
                            (try (reflect/declared-signature n) (catch _ nil))))
                  (if (nil? sig) nil (str "✓ " n " honours " sig)))))
            "\n")
          (string/join (map warnings (fn (w) (str "✗ " (:message w)))) "\n"))))))
(sig contract-notes (string -> string))

(defn- with-notes (msg src)
  ;; the verdict under the value, when there is one
  (let (notes (contract-notes src))
    (if (= notes "") msg (str msg "\n" notes))))

(defn eval-source (src)
  "Evaluate Brood source string `src` (all its forms, in order) and return a message
string — captured output then `=> <value>` of the last form, or `error: <…>`; a
definition's message ends with the checker's verdict on it ([[contract-notes]]). Never
edits anything or throws. The async-friendly entry point: the editor hands a source
string to a spawned process, which calls this and sends the message back, so a
long-running or looping form never blocks the editor."
  (let (msg (eval-command-describe (fn () (eval-command-in-session (fn () (reflect/eval-string src))))))
    (if (string/starts-with? msg "error: ") msg (with-notes msg src))))

(defn eval-source-value (src)
  "Evaluate Brood source `src` and return just `=> <value>` of the last form (or
`error: <…>`), **without** capturing output — print/println flow to whatever `*out*`
the caller bound; a definition's message ends with the checker's verdict on it
([[contract-notes]]). The streaming entry point: with `*out*` bound to a live editor
sink, a form's output appears as it's produced (so even a long-running or looping
form's prints show up), and only the value comes back in the reply. Never throws."
  (try
    (with-notes
      (str "=> "
        ; display: bounded, like `describe`'s
        (pr-str-bounded (eval-command-in-session (fn () (reflect/eval-string src)))))
      src)
    (catch e (str "error: " (error-message e)))))

(defn last-sexp-source (text point)
  "The source of the **last complete form** ending at or before `point` in `text`, as
a (re-readable) string, or nil when there's none / the prefix doesn't parse. Pure —
no eval — so the editor can extract the form on its own process and hand the string
to an async evaluator (`eval-source`)."
  ;; the prefix up to point is being edited — an unreadable one has no last form, by design
  (check-allow :discarded-catch
    (try
      (let (forms (reflect/read-all (string/substring text 0 point)))
        (if (empty? forms) nil (pr-str (last forms))))
      (catch e nil))))
