(defmodule overlayview
  "The cards laid over the panes as ui-kit widgets: the right-click context menu and the
transient menu. A widget paints and hit-tests in one pass, so `hittest` reads a menu's zones
from the same widget the view drew."
  (:use model)
  (:use keyhelp :only [ed-keys-label])
  (:use panes) ; ed-card-stage — what a floating card covers
  (:use theme)
  (:use ui-kit)
  (:use editor/display :only [text zone])) ; the transient card's own rows

;; ---- the right-click context menu, as a ui-kit widget -----------------------
;; The menu is ONE `ui-list` inside a `ui-panel` (src/ui-kit.blsp). The widget emits its
;; paint AND its click zones in one pass, so the view renders `:ops` and the click hit-test
;; (input/ed-menu-mouse-*) reads `:zones` from the SAME widget — no parallel geometry to
;; drift. Styling is by role (`ui-ctx`, in theme.blsp, supplies the palette).

(defn- ed-menu-rowfn (item index selected?)
  "A menu item → a `ui-list` row: label + shortcut key + enabled + the divider-above flag."
  {:label (:label item) :key (:key item) :enabled (:enabled item) :sep (:sep item)})

(def ed-menu-style
  ;; A popup card: raised surface, a hairline, and the `:menu` padding — 1 row above and
  ;; below, 1 cell at each side. Not the 1 row : 2 cells `:card` default, because what the
  ;; card frames here is the selection PILL, a full-width surface of its own: 2 cells of
  ;; card outside it left the text cramped inside it, which read worse than the uneven
  ;; margin. The vertical pad matters as much as the horizontal one: the card is rounded
  ;; (`:radius`), so with no top/bottom pad the highlight ran into the rounded corner and
  ;; the hairline — the first and last items looked clipped.
  ;;
  ;; The room goes INSIDE the pill: `:menu-row-inset` (2 cells), so the label sits 3 cells
  ;; in from the border. A context menu is a handful of short rows with a shortcut column,
  ;; so it can afford room that Plume (where the marginalia column IS the width) cannot.
  ;; `:menu-key-gap` (3 cells) between the label and its key stops `Select All` and
  ;; `C-x h` from reading as one run-on string.
  {:fg :on-surface
   :bg :surface
   :border :hairline
   :pad :menu
   :radius 0.5
   :inset :menu-row-inset
   :gap :menu-key-gap
   ;; The shortcut column is a reminder, not content — a weight below a disabled label,
   ;; so `Cut` greyed out because there is no selection cannot be confused with `C-w`
   ;; greyed out because it is a hint.
   :key-fg :faint})

(defn ed-menu-widget (m columns rows)
  "The context menu as a widget: a `ui-list` of the items in a `ui-panel`, sized and
clamped on-screen. Returns `{:ops :zones :area}` — the ops the view paints, the zones the
click hit-tests, and the clamped card rect (so a click inside the card but off an item
keeps the menu open). `{:ops [] :zones [] :area nil}` when no menu is open."
  (let (menu (:menu m))
    (if (nil? menu)
      {:ops [] :zones [] :area nil}
      (let (items (:items menu)
            ;; measured WITH the style the rows are rendered with, so the width reserved
            ;; and the inset actually used cannot disagree
            measured (ui-list-measure items ed-menu-rowfn (:sel menu) ed-menu-style)
            ;; the card's outer size = the rows plus the style's padding on each edge
            ;; (`ui-panel` renders the body into the PADDED inner rect, so the caller
            ;; owns the outer size — a vertical pad the area didn't account for would
            ;; simply clip the last row)
            [pad-width pad-height] (ui-pad-size (:pad ed-menu-style))
            ;; at the click, kept off the chrome of the pane clicked in (`ui-place`): a
            ;; click near the bottom no longer drops the card over the mode line
            area (ui-place [(:col menu)
                             (:row menu)
                             (+ (:w measured) pad-width)
                             (+ (:h measured) pad-height)]
                   (ed-card-stage m columns rows [(:row menu) (:col menu)])
                   columns
                   rows)
            context (ui-ctx (:gui m))
            panel (ui-panel area
                    context
                    ed-menu-style
                    (ui-list {:items items
                              :selected (:sel menu)
                              :row ed-menu-rowfn
                              :tag :menu-run
                              :style ed-menu-style})))
        (assoc panel :area area)))))

(defn ed-menu-ops (m columns rows)
  "Render ops for the open context menu (`[]` when none) — the widget's `:ops`."
  (:ops (ed-menu-widget m columns rows)))

;; ---- the transient menu (`P` in *git-status*) --------------------------------
;; Magit's popup: a card at the BOTTOM of the frame listing what each key does and which
;; arguments are on. Laid out as Magit lays it: the groups side by side in columns, each row
;; KEY FIRST — `-f  ✓ --force-with-lease  refuses if the remote moved` — the keys aligned in
;; their own column, because the key is what you are looking for and the description is what
;; you read once you have found it. The columns are balanced: the groups, in order, split
;; where the tallest column is shortest.

(def ed-transient-style
  ;; The context menu's card. Its width is the columns', capped by the frame.
  ed-menu-style)

(def- ed-transient-gap
  ;; cells between two columns of groups
  3)

(def- ed-transient-max-columns
  ;; the most columns the groups are spread over, however wide the frame
  4)

(def- ed-transient-min-width
  ;; the narrowest the card's body is laid out for, even in a frame narrower than that
  12)

(defn- ed-transient-keylabel (keys)
  "A transient's key sequence, spelled the way a menu spells it: `-f`, not `- f`. Plain
characters run together because that is how the menu is read aloud and how Magit prints
it; anything with a real key name in it (`C-c p`) falls back to the spaced spelling, where
the space is doing necessary work."
  (if (every? keys (fn (key) (and (string? key) (= (count key) 1))))
    (string/join keys "")
    (ed-keys-label keys)))

(defn- ed-transient-description (item)
  "What a suffix row says after its key. A switch or an option leads with its FLAG, ticked
when on — the flag is what will actually run, so it is the part never clipped — then
explains itself."
  (if (nil? (:arg item))
    (:label item)
    (let (flag (if (nil? (:value item)) (:arg item) (str (:arg item) (:value item))))
      (str (if (:on? item) "✓ " "  ") flag "  " (:label item)))))

(defn ed-transient-groups (state)
  "The open menu's groups as `{:title :rows}`, each row `{:key :text :index}` — `:index` the
suffix's place in the menu, the id its click zone carries."
  (second (fold (transient-core/transient-rows state)
            [0 []]
            (fn ([index groups] row)
              (if (= (:kind row) :heading)
                [index (conj groups {:title (or (:label row) "") :rows []})]
                (let (entry {:key (ed-transient-keylabel (:keys row))
                             :text (ed-transient-description row)
                             :index index}
                      last-group (dec (count groups)))
                  [(inc index)
                    (if (< last-group 0)
                      [{:title "" :rows [entry]}]
                      (assoc groups last-group (update (nth groups last-group) :rows conj entry)))]))))))

(defn- ed-column-layout (column)
  "A column of groups as `{:key-width :width :lines}`: its lines (`keycolumns/column-lines`)
and the widths that align them."
  (let (entries (mapcat column :rows)
        key-width (keycolumns/key-width entries)
        row-width (fold entries
                    0
                    (fn (widest entry)
                      (math/max widest
                        (+ key-width keycolumns/key-gap (string/display-width (:text entry))))))
        width (fold column
                row-width
                (fn (widest group) (math/max widest (string/display-width (or (:title group) "")))))
        lines (keycolumns/column-lines column))
    {:key-width key-width :width width :lines lines}))

(defn- ed-columns-width (layouts)
  (+ (fold layouts 0 (fn (sum layout) (+ sum (:width layout))))
    (* ed-transient-gap (math/max 0 (dec (count layouts))))))

(defn ed-transient-layout (state available)
  "The open menu laid out for `available` cells of inner width: its title and its columns
(`ed-column-layout` each), as many columns as fit — at most [[ed-transient-max-columns]], the groups balanced across
them (`keycolumns/balanced-columns`)."
  (let (groups (ed-transient-groups state)
        tries (map (range (math/min ed-transient-max-columns (math/max 1 (count groups))) 0 -1)
                (fn (wanted) (map (keycolumns/balanced-columns groups wanted) ed-column-layout)))
        fitting (or (seq/find tries (fn (layouts) (<= (ed-columns-width layouts) available)))
                  (last tries)))
    {:title (transient-core/transient-title state) :columns (vec fitting)}))

;; check-allow: the columns are cell counts — a card's ints, summed with a column's widths — which
;; the checker reads back out of the area and the layout maps as `number`
(check-allow :type-mismatch
  (defn- ed-transient-line (acc line x y right column faces)
    "`acc` (`[ops zones]`) with one line of a column painted at `x`, row `y`, clipped at `right`:
a group's heading, or a suffix — its key, then its description after the key column — and
the suffix's click zone."
    (let ([ops zones] acc
          room (math/max 0 (- right x)))
      (case (first line)
        :heading [(conj ops (text y x (ui-clip (second line) room) (:heading faces))) zones]
        :row
          (let (entry (second line)
                after (+ x (:key-width column) keycolumns/key-gap))
            [(conj ops
               (text y x (:key entry) (:key faces))
               (text y after (ui-clip (:text entry) (math/max 0 (- right after))) (:text faces)))
              (conj zones
                (zone [x y (math/min room (:width column)) 1]
                  [:transient-run (:index entry)]
                  :pointer))])
        acc))))

(defn- ed-transient-body (layout)
  "The card's body widget: the title, a blank row, then the columns side by side — each row
its key in the key colour, aligned, and its description after the gap."
  (fn (area ctx)
    (let ([col row w _h] area
          theme (:theme ctx)
          faces {:title (ui-face theme {:fg :on-surface :bg :surface :bold true})
                 :heading (ui-face theme {:fg :muted :bg :surface :bold true})
                 :key (ui-face theme {:fg :accent :bg :surface :bold true})
                 :text (ui-face theme {:fg :on-surface :bg :surface})}
          right (+ col w)
          [_ ops zones] (fold (:columns layout)
                          [col [] []]
                          (fn ([x ops zones] column)
                            (let ([column-ops column-zones] (fold (seq/enumerate (:lines column))
                                                              [ops zones]
                                                              (fn (acc [index line])
                                                                (ed-transient-line acc
                                                                  line
                                                                  x
                                                                  (+ row 2 index)
                                                                  right
                                                                  column
                                                                  faces))))
                              [(+ x (:width column) ed-transient-gap) column-ops column-zones]))))
      {:ops (into [(text row col (ui-clip (:title layout) w) (:title faces))] ops) :zones zones})))

(defn ed-transient-widget (m columns rows)
  "The open transient menu as a widget: `{:ops :zones :area}`, `{:ops [] …}` when none.
Anchored BOTTOM-LEFT, above the echo area — the menu is a thing you are working through,
so it sits where a Magit popup sits rather than floating over the point you are reading."
  ;; `(:transient m)` is the inline guard: the flag can only be set by `transient.blsp`,
  ;; so an editor that never opened a menu never reaches that deferred module from here —
  ;; the deferred-module rule. The ROWS come from std, which is
  ;; embedded and always loadable.
  (let (state (:transient m))
    (if (nil? state)
      {:ops [] :zones [] :area nil}
      (let ([pad-width pad-height] (ui-pad-size (:pad ed-transient-style))
            inset (ui-row-inset ed-transient-style)
            ;; the card's own frame, and the stage's gap on either side of it
            chrome (+ pad-width
                     inset
                     inset
                     (nth (ui-space-box :card-gap) 1)
                     (nth (ui-space-box :card-gap) 3))
            layout (ed-transient-layout state (math/max ed-transient-min-width (- columns chrome)))
            ;; the TITLE first: without it a menu is a list of flags with no name on it —
            ;; tolerable at the top level, not once sub-menus exist (`transient-title`
            ;; carries the trail, `Git → Rebase`, the only thing saying what Escape will do)
            body-width (math/max (string/display-width (:title layout))
                         (ed-columns-width (:columns layout)))
            body-height (+ 2
                          (fold (:columns layout)
                            0
                            (fn (tallest column) (math/max tallest (count (:lines column))))))
            width (+ body-width inset inset pad-width)
            height (+ body-height pad-height)
            ;; along the bottom of the frame's text, `:card-gap` above the bottom mode line
            ;; (`ui-place`): the mode line and the echo area keep their places, so the
            ;; menu never covers the message its own command is about to write, and it
            ;; does not sit ON the bar either
            stage (ed-card-stage m columns rows)
            area (ui-place [0 (- (+ (second stage) (nth stage 3)) height) width height]
                   stage columns rows)
            context (ui-ctx (:gui m))
            panel (ui-panel area
                    context
                    ed-transient-style
                    (fn (inner ctx)
                      (let ([col row w h] inner)
                        ((ed-transient-body layout) [(+ col inset)
                                                      row
                                                      (math/max 0 (- w inset inset))
                                                      h]
                          ctx)))))
        (assoc panel :area area)))))

(defn ed-transient-ops (m columns rows)
  "Render ops for the open transient menu (`[]` when none)."
  (:ops (ed-transient-widget m columns rows)))

(register-frame-overlay :transient {:rank 50 :run 'overlayview/ed-transient-ops})
(register-frame-overlay :context-menu {:rank 60 :run 'overlayview/ed-menu-ops})
