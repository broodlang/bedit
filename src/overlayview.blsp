(defmodule overlayview
  "The cards laid over the panes as ui-kit widgets: the right-click context menu and the
transient menu. A widget paints and hit-tests in one pass, so `hittest` reads a menu's zones
from the same widget the view drew."
  (:use model)
  (:use keyhelp :only [ed-keys-label])
  (:use panes) ; ed-card-stage — what a floating card covers
  (:use theme)
  (:use ui-kit))

;; ---- the right-click context menu, as a ui-kit widget -----------------------
;; The menu is ONE `ui-list` inside a `ui-panel` (src/ui-kit.blsp). The widget emits its
;; paint AND its click zones in one pass, so the view renders `:ops` and the click hit-test
;; (input/ed-menu-mouse-*) reads `:zones` from the SAME widget — no parallel geometry to
;; drift. Styling is by role (`ui-ctx`, in theme.blsp, supplies the palette).

(defn- ed-menu-rowfn (item index selected?)
  "A menu item → a `ui-list` row: label + shortcut key + enabled + the divider-above flag."
  {:label (:label item) :key (:key item) :enabled (:enabled item) :sep (:sep item)})

(def ed-menu-style
  ;; A popup card: raised surface, a hairline, and the `:menu` padding — 1 row above and
  ;; below, 1 cell at each side. Not the 1 row : 2 cells `:card` default, because what the
  ;; card frames here is the selection PILL, a full-width surface of its own: 2 cells of
  ;; card outside it left the text cramped inside it, which read worse than the uneven
  ;; margin. The vertical pad matters as much as the horizontal one: the card is rounded
  ;; (`:radius`), so with no top/bottom pad the highlight ran into the rounded corner and
  ;; the hairline — the first and last items looked clipped.
  ;;
  ;; The room goes INSIDE the pill: `:menu-row-inset` (2 cells), so the label sits 3 cells
  ;; in from the border. A context menu is a handful of short rows with a shortcut column,
  ;; so it can afford room that Plume (where the marginalia column IS the width) cannot.
  ;; `:menu-key-gap` (3 cells) between the label and its key stops `Select All` and
  ;; `C-x h` from reading as one run-on string.
  {:fg :on-surface
   :bg :surface
   :border :hairline
   :pad :menu
   :radius 0.5
   :inset :menu-row-inset
   :gap :menu-key-gap
   ;; The shortcut column is a reminder, not content — a weight below a disabled label,
   ;; so `Cut` greyed out because there is no selection cannot be confused with `C-w`
   ;; greyed out because it is a hint.
   :key-fg :faint})

(defn ed-menu-widget (m columns rows)
  "The context menu as a widget: a `ui-list` of the items in a `ui-panel`, sized and
clamped on-screen. Returns `{:ops :zones :area}` — the ops the view paints, the zones the
click hit-tests, and the clamped card rect (so a click inside the card but off an item
keeps the menu open). `{:ops [] :zones [] :area nil}` when no menu is open."
  (let (menu (:menu m))
    (if (nil? menu)
      {:ops [] :zones [] :area nil}
      (let (items (:items menu)
            ;; measured WITH the style the rows are rendered with, so the width reserved
            ;; and the inset actually used cannot disagree
            measured (ui-list-measure items ed-menu-rowfn (:sel menu) ed-menu-style)
            ;; the card's outer size = the rows plus the style's padding on each edge
            ;; (`ui-panel` renders the body into the PADDED inner rect, so the caller
            ;; owns the outer size — a vertical pad the area didn't account for would
            ;; simply clip the last row)
            [pad-width pad-height] (ui-pad-size (:pad ed-menu-style))
            ;; at the click, kept off the chrome of the pane clicked in (`ui-place`): a
            ;; click near the bottom no longer drops the card over the mode line
            area (ui-place [(:col menu)
                             (:row menu)
                             (+ (:w measured) pad-width)
                             (+ (:h measured) pad-height)]
                   (ed-card-stage m columns rows [(:row menu) (:col menu)])
                   columns
                   rows)
            context (ui-ctx (:gui m))
            panel (ui-panel area
                    context
                    ed-menu-style
                    (ui-list {:items items
                              :selected (:sel menu)
                              :row ed-menu-rowfn
                              :tag :menu-run
                              :style ed-menu-style})))
        (assoc panel :area area)))))

(defn ed-menu-ops (m columns rows)
  "Render ops for the open context menu (`[]` when none) — the widget's `:ops`."
  (:ops (ed-menu-widget m columns rows)))

;; ---- the transient menu (`P` in *git-status*) --------------------------------
;; Magit's popup: a card at the BOTTOM of the frame listing what each key does and which
;; arguments are on. It reuses the context menu's widget wholesale — a transient row is a
;; label plus a key, which is what `ui-list` already paints — so what is written here is
;; only the part that is about transients: how a row reads.

(def ed-transient-style
  ;; The context menu's card, with the width cap lifted. A menu item is `Paste`; a
  ;; transient row is a flag AND what it does, and the flag is the part you cannot afford
  ;; to lose. Still placed by `ui-place`, so it keeps on screen and off the chrome.
  (assoc ed-menu-style :max-w 96))

(defn- ed-transient-keylabel (keys)
  "A transient's key sequence, spelled the way a menu spells it: `-f`, not `- f`. Plain
characters run together because that is how the menu is read aloud and how Magit prints
it; anything with a real key name in it (`C-c p`) falls back to the spaced spelling, where
the space is doing necessary work."
  (if (every? keys (fn (key) (and (string? key) (= (count key) 1))))
    (string/join keys "")
    (ed-keys-label keys)))

(defn- ed-transient-rowfn (item index selected?)
  "A `transient-rows` row → a `ui-list` row. A heading is a disabled row with a rule above
it (the group titles ARE the structure, so they get the divider rather than a blank line).

A suffix leads with the FLAG and explains itself after it — `✓ --force-with-lease  refuses
if the remote moved`. The first cut led with the prose and appended the flag once the
switch was on, which reads better right up until it does not fit: the card is sized from
the longest row, a toggled switch is the longest row, and the argument — the one thing on
the card that says what will actually run — was the part clipped off the end. Leading with
it makes the widest column the stable one, and there is nothing to lose off the right."
  (if (= (:kind item) :heading)
    {:label (:label item) :key "" :enabled false :sep (> index 0)}
    (let (flag (cond
                 (nil? (:arg item)) ""
                 (nil? (:value item)) (:arg item)
                 else (str (:arg item) (:value item))))
      {:label (str (if (:on? item) "✓ " "  ") flag (if (= flag "") "" "  ") (:label item))
       :key (ed-transient-keylabel (:keys item))
       :enabled true
       :sep false})))

(defn ed-transient-widget (m columns rows)
  "The open transient menu as a widget: `{:ops :zones :area}`, `{:ops [] …}` when none.
Anchored BOTTOM-LEFT, above the echo area — the menu is a thing you are working through,
so it sits where a Magit popup sits rather than floating over the point you are reading."
  ;; `(:transient m)` is the inline guard: the flag can only be set by `transient.blsp`,
  ;; so an editor that never opened a menu never reaches that deferred module from here —
  ;; the deferred-module rule. The ROWS come from std, which is
  ;; embedded and always loadable.
  (let (state (:transient m))
    (if (nil? state)
      {:ops [] :zones [] :area nil}
      (let (
            ;; the TITLE as the first row. Without it a menu is a list of flags with no
            ;; name on it — tolerable at the top level, where you just pressed the key, and
            ;; not at all once sub-menus exist: `transient-title` carries the trail
            ;; (`Git → Rebase`), which is the only thing saying what Escape will do.
            items (into [{:kind :heading :label (transient-core/transient-title state)}]
                    (transient-core/transient-rows state))
            measured (ui-list-measure items ed-transient-rowfn nil ed-transient-style)
            [pad-width pad-height] (ui-pad-size (:pad ed-transient-style))
            width (+ (:w measured) pad-width)
            height (+ (:h measured) pad-height)
            ;; along the bottom of the frame's text, `:card-gap` above the bottom mode line
            ;; (`ui-place`): the mode line and the echo area keep their places, so the
            ;; menu never covers the message its own command is about to write, and it
            ;; does not sit ON the bar either
            stage (ed-card-stage m columns rows)
            area (ui-place [0 (- (+ (second stage) (nth stage 3)) height) width height]
                   stage columns rows)
            context (ui-ctx (:gui m))
            panel (ui-panel area
                    context
                    ed-transient-style
                    (ui-list {:items items
                              :selected nil
                              :row ed-transient-rowfn
                              :tag :transient-run
                              :style ed-transient-style})))
        (assoc panel :area area)))))

(defn ed-transient-ops (m columns rows)
  "Render ops for the open transient menu (`[]` when none)."
  (:ops (ed-transient-widget m columns rows)))

(register-frame-overlay :transient {:rank 50 :run 'overlayview/ed-transient-ops})
(register-frame-overlay :context-menu {:rank 60 :run 'overlayview/ed-menu-ops})
