(defmodule lisp-modes
  "The other s-expression languages — Emacs Lisp, Common Lisp, Clojure, Scheme / Racket,
Fennel, and wos kernel source. Each is `deflisp` (or, for wos, a layer) over Brood's own
reader, lexer and structural motions: what is dialect-specific is a set of special forms
and, where the dialect indents like Emacs rather than like Brood, `lisp-indent-with`."
  (:use modes :only [register-prog-mode]))
;; sexp, model, reflect, editor/highlight and brood-mode are referenced qualified below —
;; each `mod/name` auto-loads its module.

(defmacro deflisp (name spec)
  "Declare an s-expression language mode from ONE spec, and register it — the sibling of
`deflanguage` for the OTHER parser family.

    (deflisp elisp
      {:pattern \"[.]el$\"
       :specials elisp-special-forms
       :comment \";; \"})

A Lisp needs no grammar. `brood-mode` was never tree-sitter-backed: structural motion
comes from `std/sexp`, which is delimiter matching and knows nothing of any dialect, and
`editor/highlight` is a generic Lisp lexer — parens, `;` comments, `\"` strings, numbers —
with exactly one dialect-specific decision, whether a head symbol is a special form. So a
second Lisp is that set plus a file pattern.

`commands/ed-structural` picks its backend by the presence of `:ts-lang`; a mode without
one gets the sexp motions, which is why every `C-M-*` key works here without being
mentioned.

Indentation defaults to Brood's (`brood-mode/brood-indent`): body +2, `let`-family bindings
aligned. A dialect that indents differently supplies `:indent` — elisp does, because
Emacs aligns a plain call's arguments under the first argument where Brood indents +2,
and a config file is full of exactly that."
  (let (base (->string name)
        fontify (symbol (str base "-fontify"))
        line-lexer (symbol (str base "-line-lexer"))
        layer (symbol (str base "-mode-layer"))
        fontify-ref (symbol (str "lisp-modes/" base "-fontify"))
        line-lexer-ref (symbol (str "lisp-modes/" base "-line-lexer"))
        layer-ref (symbol (str "lisp-modes/" base "-mode-layer")))
    `(do
       (defn ~fontify (text)
         (editor/highlight/highlight-spans text (get ~spec :specials)))
       (defn ~line-lexer ()
         (editor/highlight/lisp-line-lexer (get ~spec :specials)
           {:rainbow theme/*rainbow-delimiters*}))
       (def ~layer
         {:name '~name
          :file-pattern (get ~spec :pattern)
          :fontify '~fontify-ref
          :fontify-restart 'editor/highlight/safe-restart
          :line-lexer '~line-lexer-ref
          :bracket-match 'editor/highlight/bracket-match
          :indent (get ~spec :indent 'brood-mode/brood-indent)
          :comment-syntax (get ~spec :comment)})
       (register-prog-mode '~layer-ref (get ~spec :lang (keyword '~name))))))

(defn elisp-indent (text bol)
  "The elisp `:indent` service — Emacs' rule, which differs from Brood's in one place
that a config file is full of.

Brood indents every non-`let` form's body `+2`. Emacs indents the body of a SPECIAL FORM
by 2 and aligns a plain CALL's arguments under its first argument:

    (set-face-attribute 'default nil
                        :family my/font)     ; a call — aligned under `'default`

    (when (display-graphic-p)
      (tool-bar-mode -1))                    ; a special form — body +2

Which is which is the same `elisp-special-forms` set that decides the colouring, so the
two agree by construction: anything painted as a keyword indents its body, and anything
painted as a call aligns its arguments. A call with nothing after its head on the line
falls back to one past the open paren, as Emacs does. The rule is `lisp-indent-with`
over `elisp-special-forms`; Common Lisp's `lisp-indent` is the same rule over its own set."
  (lisp-indent-with elisp-special-forms text bol))

(defn lisp-indent-with (specials text bol)
  "Emacs's Lisp indent rule for the line at `bol` of `text`, given the dialect's
`specials` (head → true): a special form's body +2, a plain call's arguments under its
first argument, a call whose head is alone on its line one past the open paren. Shared
by `elisp-indent` and `lisp-indent` — which set decides is the one thing a dialect says.
`text` is a string or the buffer's rope: only the top-level form up to `bol` is read from
a rope (brood ADR-488)."
  (let (fstart (reflect/scan-form-start text bol)
        start (model/ed-line-start-offset text fstart)
        sub (text/slice text start bol)
        n (string/length sub))
    (if (= n 0)
      0
      (let (tr (sexp/tree sub)
            enc (sexp/enclosing tr (dec n))
            kind (:kind enc))
        (if (= kind :root)
          0
          (let (opencol (model/ed-column-at sub (:start enc))
                kids (sexp/forms-of enc)
                head (when (not (empty? kids)) (brood-mode/brood-head-text sub (first kids)))
                special (and head (= true (get specials head))))
            (cond
              ;; a special form, or a form with no head to speak of: body +2
              (or special (empty? kids)) (+ opencol 2)
              ;; a call with arguments on the head's line: align under the first argument
              (>= (count kids) 2) (model/ed-column-at sub (:start (second kids)))
              ;; a call whose head is alone on its line
              else (+ opencol 1))))))))

;; ---- elisp-mode: editing an Emacs config, in an Emacs clone that is not Emacs -------
;; The joke is load-bearing. `init.el` is a file people edit constantly and it is
;; s-expressions, so everything bedit already has for Brood — `C-M-f/b/u/d`, `C-M-SPC`,
;; the paren matching, the comment/string lexing — applies to it unchanged. What is
;; genuinely elisp is this list.

(def elisp-special-forms
  ;; Special forms and the core macros an `init.el` is made of. `if`/`let`/`lambda`/`when`
  ;; overlap with Brood's set, which is unsurprising — they are both Lisps — but the
  ;; `defcustom`/`use-package`/`setq` end of it is what makes a config look right.
  (fold ["defun"
          "defmacro" "defvar" "defconst" "defcustom" "defface" "defgroup" "defsubst"
          "define-minor-mode" "define-derived-mode" "define-key" "lambda" "let" "let*" "letrec" "if"
          "when" "unless" "cond" "case" "pcase" "while" "dolist" "dotimes" "catch" "condition-case"
          "unwind-protect" "save-excursion" "save-restriction" "with-current-buffer"
          "with-eval-after-load" "setq" "setq-default" "setq-local" "push" "add-hook" "require"
          "provide" "use-package" "quote" "function" "progn" "prog1" "and" "or" "not"]
    {}
    (fn (m s) (assoc m s true))))

(deflisp elisp
  {:pattern "\\.el$"
   :specials lisp-modes/elisp-special-forms
   :indent 'lisp-modes/elisp-indent
   :comment ";; "})

;; ---- lisp-mode: Common Lisp, the other Lisp people still write by hand ------------
;; The same argument as elisp: s-expressions, so the structural keys, the paren matching
;; and the comment/string lexing are Brood's unchanged; what is Common Lisp is the set of
;; heads that indent their body and paint as keywords, and Emacs's `lisp-mode` indent
;; rule — which is `elisp-indent`'s, over this set (`lisp-indent-with`).

(def lisp-special-forms
  ;; The defining forms and the special operators / core macros of Common Lisp (the
  ;; `defpackage`/`defclass`/`loop`/`handler-case` end of it is what makes a `.lisp` file
  ;; look right), plus the `setf` family.
  (fold ["defun"
          "defmacro" "defvar" "defparameter" "defconstant" "defclass" "defmethod" "defgeneric"
          "defstruct" "deftype" "defpackage" "define-condition" "defsetf" "in-package" "lambda"
          "let" "let*" "flet" "labels" "macrolet" "symbol-macrolet" "if" "when" "unless" "cond"
          "case" "ecase" "ccase" "typecase" "etypecase" "loop" "do" "do*" "dolist" "dotimes" "progn"
          "prog1" "prog2" "block" "return" "return-from" "tagbody" "go" "catch" "throw"
          "handler-case" "handler-bind" "restart-case" "ignore-errors" "unwind-protect"
          "multiple-value-bind" "multiple-value-prog1" "destructuring-bind" "with-open-file"
          "with-slots" "with-accessors" "with-output-to-string" "with-input-from-string" "setf"
          "setq" "psetf" "push" "pop" "incf" "decf" "declare" "declaim" "proclaim" "quote"
          "function" "and" "or" "not" "the" "eval-when" "locally" "assert" "check-type" "error"
          "signal" "warn"]
    {}
    (fn (m s) (assoc m s true))))

(defn lisp-indent (text bol)
  "The Common Lisp `:indent` service: Emacs's `lisp-mode` rule — a special form's body
+2, a plain call's arguments under the first argument (`lisp-indent-with`, over
`lisp-special-forms`)."
  (lisp-indent-with lisp-special-forms text bol))

(deflisp lisp
  {:pattern "\\.(lisp|cl|lsp|asd)$"
   :specials lisp-modes/lisp-special-forms
   :indent 'lisp-modes/lisp-indent
   :comment ";; "})

;; ---- the other Lisps: Clojure, Scheme / Racket, Fennel ------------------------------
;; Each is `deflisp` with its own head set — the whole of what is dialect-specific here.
;; Brood's indent rule (body +2, `let`-family bindings aligned) is Clojure's and Fennel's
;; own convention; Scheme's is the elisp/Common Lisp rule (special forms +2, calls
;; aligned under the first argument), so it shares `lisp-indent-with`.

(def clojure-special-forms
  (fold ["def"
          "defn" "defn-" "defmacro" "defmulti" "defmethod" "defprotocol" "defrecord" "deftype"
          "defonce" "definterface" "ns" "fn" "let" "letfn" "if" "if-let" "if-not" "if-some" "when"
          "when-let" "when-not" "when-some" "cond" "condp" "case" "do" "loop" "recur" "for" "doseq"
          "dotimes" "while" "try" "catch" "finally" "throw" "quote" "var" "set!" "binding"
          "with-open" "with-redefs" "and" "or" "not" "->" "->>" "as->" "some->" "some->>" "cond->"
          "cond->>" "comment" "import" "require" "use" "declare" "delay" "future" "lazy-seq" "reify"
          "proxy" "extend-protocol" "extend-type"]
    {}
    (fn (m s) (assoc m s true))))

(deflisp clojure
  {:pattern "\\.(clj|cljs|cljc|cljx|edn|bb)$"
   :specials lisp-modes/clojure-special-forms
   :comment ";; "})

(def scheme-special-forms
  (fold ["define"
          "define-syntax" "define-record-type" "define-values" "define-macro" "define-module"
          "lambda" "λ" "case-lambda" "let" "let*" "letrec" "letrec*" "let-values" "let*-values"
          "let-syntax" "letrec-syntax" "named-lambda" "if" "when" "unless" "cond" "case" "and" "or"
          "not" "do" "begin" "delay" "force" "set!" "quote" "quasiquote" "unquote" "syntax-rules"
          "syntax-case" "guard" "dynamic-wind" "call/cc" "call-with-current-continuation"
          "parameterize" "assert" "import" "export" "library" "require" "provide" "module" "struct"
          "match" "for" "for/list" "for/fold" "define-struct" "else"]
    {}
    (fn (m s) (assoc m s true))))

(defn scheme-indent (text bol)
  "The Scheme / Racket `:indent` service: the Lisp rule over `scheme-special-forms`."
  (lisp-indent-with scheme-special-forms text bol))

(deflisp scheme
  {:pattern "\\.(scm|ss|sld|sls|rkt|rktl)$"
   :specials lisp-modes/scheme-special-forms
   :indent 'lisp-modes/scheme-indent
   :comment ";; "})

(def fennel-special-forms
  (fold ["fn"
          "lambda" "λ" "local" "var" "global" "let" "set" "tset" "if" "when" "each" "for" "while"
          "do" "match" "case" "macro" "macros" "import-macros" "require-macros" "eval-compiler"
          "values" "not" "and" "or" "->" "->>" "-?>" "-?>>" "doto" "collect" "icollect" "accumulate"
          "faccumulate" "fcollect" "with-open" "pick-values" "pick-args" "comment" "lua" "quote"
          "hashfn" "partial"]
    {}
    (fn (m s) (assoc m s true))))

(deflisp fennel
  {:pattern "\\.fnl$"
   :specials lisp-modes/fennel-special-forms
   :comment ";; "})

;; ---- wos-mode: wos kernel source (.wos), stacked on prog + text-mode --------
;;
;; `.wos` files are the kernel language of `broodlang/wos` — s-expressions read by
;; Brood's reader and compiled by a different compiler into machine code (wos
;; D-032: same reader, different semantics).
;;
;; That split is exactly the split between what this mode keeps and what it drops.
;; The STRUCTURAL half of brood-mode is right here, because the structure IS
;; Brood's: paredit, sexp motion, bracket matching, indentation, `;;` comments.
;; The SEMANTIC half is wrong, because the semantics are not: `var`, `loop` and
;; `out8` are not Brood functions, so eldoc, doc-at, completion and the checker
;; would each answer confidently about a language this buffer is not written in —
;; and `eval-last-sexp` would evaluate kernel source as a Brood expression.
;;
;; So: no `:eldoc`, `:doc-at`, `:complete-at`, `:diagnostics`, `:check-remote` or
;; `:gutter-click`, and no `eval-*` in `:commands`. A mode that answers nothing is
;; better than one that answers about the wrong language.

;; The heads that colour as keywords in a `.wos` buffer: wos's statements and
;; expression forms, not Brood's special forms. `highlight-spans` takes the set as
;; an argument precisely so another dialect can be taught to colour without
;; another highlighter — this is that, and all of it.
;; (Plain `def` takes no docstring, so this is a comment.)
(def wos-specials
  (fold ["program"
          "var" "set" "loop" "break" "when-zero" "out8" "halt" "data" "const" "addr" "load8" "asciz"
          "ascii" "align" "space"]
    {}
    (fn (acc name) (assoc acc name true))))

(defn wos-fontify (text)
  "wos-mode's `:fontify` — the shared lexer with wos's keyword set."
  (editor/highlight/highlight-spans text wos-specials))

(defn wos-line-lexer ()
  "wos-mode's `:line-lexer` builder — the shared Lisp line lexer with wos's keyword set."
  (editor/highlight/lisp-line-lexer wos-specials {:rainbow theme/*rainbow-delimiters*}))

(def wos-mode-layer
  {:name 'wos
   :file-pattern "\\.wos$"
   :keymap brood-mode/brood-keymap
   ;; the structural edits, and nothing that evaluates
   :commands '("mark-sexp" "slurp-forward"
                "barf-forward" "slurp-backward" "barf-backward" "raise-sexp" "splice-sexp"
                "wrap-round" "transpose-sexps" "sexp-kill")
   :fontify 'lisp-modes/wos-fontify
   :fontify-restart 'editor/highlight/safe-restart
   :line-lexer 'lisp-modes/wos-line-lexer
   :bracket-match 'editor/highlight/bracket-match
   :indent 'brood-mode/brood-indent
   :comment-syntax ";; "})

(register-prog-mode 'lisp-modes/wos-mode-layer :wos)
