(defmodule query-replace
  "Query-replace (`M-%`, `C-M-%` by regexp): a modal mini-loop that runs *beside* the keymap,
as isearch does. When `:query-replace` is set on the model, `input/ed-update` routes keys
here instead of dispatching them; each match is lit and answered y/n/!/./q. The case rule
is the search's (`isearch/search-fold?`) and the window's other matches are lit through
`isearch/lazy-ranges`. Also the replace family that does not ask, as data over text."
  (:use editor/buffer) ; buffer-search-forward, goto-char, point/length
  (:use isearch :only [search-fold? regexp-fold?]) ; a replace folds case as a search does
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use theme) ; face-isearch — the match at point
  (:use minibuffer :only [ed-mb-edit]) ; E edits the replacement
  (:use model)) ; ed-current-buf / ed-set-buf

;; `:query-replace` carries `{:from :to :regexp? :match :found :count}`; each match is highlighted with a transient
;; overlay (and every other one in the window lit, as in a search) and the user answers
;; y/n/!/./q. Two minibuffer prompts (from, then to) precede it — see
;; `search-commands/cmd-query-replace` and `cmd-query-replace-regexp`.
;;
;; A regexp's replacement may refer to what matched: `\&` is the whole match, `\1`…`\9` its
;; groups and `\\` a backslash (Emacs's syntax, [[expand-replacement]]).

;; The query-replace state, as the commands below read it. `:match` is nil between the
;; start and the first `qr-goto`; every replace runs at a match, and `qr-match` says so.
(deftype qr (record &open :from string :to string :match (or nil int) :count int))
(sig qr-state (model -> qr))
(defn- qr-state (m)
  "The query-replace in progress — which there is, for every key `qr-key` folds."
  (or (:query-replace m) (error "no query-replace in progress")))
(sig qr-match (qr -> int))
(defn- qr-match (qr)
  "The current match's start — set by `qr-goto` before any replace can run."
  (or (:match qr) (error "query-replace is not at a match")))

(defn- qr-fold? (qr)
  "Does this replace ignore case — the search rule for its kind."
  (if (:regexp? qr) (regexp-fold? (:from qr)) (search-fold? (:from qr))))

(defn- qr-prompt (qr)
  "The echo-area prompt for a query-replace at a match."
  (str "Query replacing "
    (if (:regexp? qr) "regexp " "")
    (:from qr)
    " with "
    (:to qr)
    ": (y/n/!/./q)"))

(defn- qr-limit (qr buf)
  "Where the replace's matches must end by: its region's end (`:limit`, carried along as
replacements change the text's length) when it was started over a region, else the end of
the buffer."
  (or (:limit qr) (buffer-length buf)))

(defn- qr-find (qr buf position)
  "The next match at or after `position` that the buffer lets the replace change — in a buffer
narrowed to editable regions (edited search results, a form) a match outside them is passed
over rather than ending the replace — [[qr-find-any]]'s."
  (let (found (qr-find-any qr buf position)
        regions (editable-regions buf))
    (cond
      (or (nil? found) (nil? regions)) found
      (any? regions (fn ([low high]) (and (<= low (:start found)) (<= (:end found) high)))) found
      (< (:start found) (buffer-length buf)) (qr-find qr buf (inc (:start found)))
      else nil)))

(defn- qr-find-any (qr buf position)
  "The next match of the replace at or after `position`, as `regex/find`'s map
(`{:start :end :text :groups}`), or nil — one that ENDS by [[qr-limit]], so a replace over
the region never reaches past it. A regexp is searched with that limit as its bound (brood
ADR-554: a greedy match stops at the region's end, as Emacs's `re-search-forward` BOUND
does, while `$` and `\\b` there still read the text beyond); a literal match cannot be
shortened, so one ending past the limit is simply none."
  (let (fold? (qr-fold? qr)
        from (:from qr)
        limit (qr-limit qr buf))
    (cond
      (> position limit) nil
      (:regexp? qr)
        (regex/rope-find (buffer-rope buf) from position {:fold? fold? :empty? true :bound limit})
      else
        (when-let (start (buffer-search-forward buf from position fold?))
          (let (end (+ start (string/length from)))
            (when (<= end limit)
              {:start start :end end :text (text/slice (buffer-rope buf) start end) :groups []}))))))

(defn expand-replacement (to found)
  "The replacement template `to` with its references filled in from `found` (a match map,
as `regex/find` answers): `\\&` the whole match, `\\1`…`\\9` a group (empty when it did not
take part), `\\\\` a backslash — Emacs's `replace-match` syntax. Any other text is itself.

    (query-replace/expand-replacement \"\\\\2, \\\\1\" (regex/find \"jane doe\" \"(\\\\w+) (\\\\w+)\"))   ;=> \"doe, jane\"
    (query-replace/expand-replacement \"<\\\\&>\" (regex/find \"foo\" \"o+\"))                       ;=> \"<oo>\""
  (regex/replace to
    "\\\\([&0-9\\\\])"
    (fn (reference)
      (let (what (:text (first (:groups reference))))
        (cond
          (= what "&") (:text found)
          (= what "\\") "\\"
          (= what "0") (:text found)
          else
            (let (group (nth (:groups found) (- (string/char->int what) (string/char->int "1")) nil))
              (if (nil? group) "" (:text group))))))))

(defn- qr-replacement (qr found)
  "The text that replaces the match `found`: a regexp's template expanded
([[expand-replacement]]), then — when the search folded and the template was typed in lower
case — given the case of the text it replaces ([[replacement-for]])."
  (let (to (:to qr)
        expanded (if (:regexp? qr) (expand-replacement to found) to))
    (if (= to (string/fold-case to))
      (replacement-for (:text found) expanded (qr-fold? qr))
      expanded)))

(defn qr-finish (m)
  "End query-replace: clear the state + the match overlay, and report the count."
  (let (qr (qr-state m)
        replaced (:count qr))
    (assoc m
      :query-replace nil
      :overlays nil
      :isearch-lazy nil
      :echo (str "Replaced " (ed-count-noun replaced "occurrence")))))

;; Where a replace looks next is Emacs's `perform-replace` rule (replace.el), and it decides
;; what a pattern that can match nothing (`x*`, `^`, `$`) replaces. The next match may be
;; ADJACENT to this one only when this one was non-empty and the match starting where it ends
;; is non-empty too — judged in the text before the replacement goes in, since that can change
;; what matches. Otherwise the search steps one character on first, so an empty match is
;; never taken twice nor right after a replacement — and a step never lands on the end of the
;; buffer. `x*` → `-` over `xxa` is `-a`, over `xxaxx` `-a-` (what `emacs --batch` gives).

(defn- qr-adjacent? (qr buf found)
  "May the match after `found` (a match in `buf`, before it is replaced) start right where
it ends? Only when `found` is non-empty, and for a regexp only when the match there is
non-empty too (`perform-replace`'s `match-again`)."
  (and (not (= (:start found) (:end found)))
    (or (not (:regexp? qr))
      (let (next (regex/rope-find (buffer-rope buf)
                   (:from qr)
                   (:end found)
                   {:fold? (qr-fold? qr) :empty? true :bound (qr-limit qr buf)}))
        (and next (= (:start next) (:end found)) (not (= (:start next) (:end next))))))))

(sig qr-next (any any any int -> (or nil int)))
(defn- qr-next (qr buf adjacent? position)
  "Where the next search starts, in `buf` (as it is now), from `position` just past the last match
or its replacement: `position` itself when the next match may be adjacent ([[qr-adjacent?]]),
else a character on — nil at the end of the buffer (or of the region the replace is confined
to, [[qr-limit]]), or when the step would reach it: `perform-replace`'s loop runs while
point is short of its limit."
  (let (limit (qr-limit qr buf))
    (cond
      (>= position limit) nil
      adjacent? position
      (< (inc position) limit) (inc position)
      else nil)))

(sig qr-goto (model (or nil int) -> model))
(defn- qr-lazy-spec (qr)
  "The replace as the lazy highlight describes a search (`isearch/lazy-ranges`): its pattern as a
regexp, its case rule, and over a region only the matches the replace will reach."
  (merge {:pattern (if (:regexp? qr) (:from qr) (regex/escape (:from qr))) :fold? (qr-fold? qr)}
    (if (:limit qr) {:within [(:region-start qr) (:limit qr)]} {})))

(defn- qr-goto (m position)
  "Highlight the next match at or after `position` (a transient overlay, point at its start, the
other matches in the window lit), or finish if there is none — or no `position` at all, past an
empty match at the buffer's end ([[qr-next]])."
  (let (qr (qr-state m)
        buf (ed-current-buf m)
        found (when (int? position) (qr-find qr buf position)))
    (if (nil? found)
      (qr-finish m)
      (assoc (ed-set-buf m (goto-char buf (:start found)))
        :overlays [{:start (:start found) :end (:end found) :face face-isearch}]
        :isearch-lazy (qr-lazy-spec qr)
        :echo (qr-prompt qr)
        ;; the question stands until answered: a `message` meanwhile shows beside it
        :query-replace
          (assoc (dissoc qr :message) :match (:start found) :found found :prompt (qr-prompt qr))))))

(defn replacement-for (matched to fold?)
  "The text to put in place of `matched`, given the replacement `to`.

Emacs' `case-replace`, and the half of case-insensitive replace that is easy to forget:
if the search ignored case then the text you matched may be capitalised differently from
what you typed, and copying the replacement in verbatim would change the case of prose you
never meant to touch. Replacing `foo` with `bar` across `Foo is FOO` should give
`Bar is BAR`, not `bar is bar`.

Only when the pattern of the MATCH is unambiguous — all upper, or capitalised — and only
when the replacement was typed in lower case, which is the signal that no particular case
was intended. Anything else is left exactly as written: `fooBar` typed as a replacement is
a name, not a sentence."
  (cond
    (not fold?) to
    (not (= to (string/fold-case to))) to
    (= matched "") to
    (= to "") to
    ;; ALL CAPS in, all caps out — but only when there is a letter to be sure about, so
    ;; `---` does not count as upper case
    (and (= matched (string/upper matched)) (not (= matched (string/fold-case matched))))
      (string/upper to)
    ;; Capitalised in, capitalised out
    (and (= (string/char-at matched 0) (string/upper (string/char-at matched 0)))
      (not (= (string/char-at matched 0) (string/fold-case (string/char-at matched 0)))))
      (str (string/upper (string/char-at to 0)) (string/substring to 1))
    else to))

(sig qr-replace (model -> (tuple model (or nil int))))
(defn- qr-replace (m)
  "Replace the current match with its replacement ([[qr-replacement]]) and return
`[model' next-search-pos]` (the model with its count bumped, point just past the inserted
text — and a region's end moved by what the replacement added or removed, so the replace
stays confined to the text the region held). A buffer that refuses the edit (read-only) ends
the replace there."
  (let (qr (qr-state m)
        start (qr-match qr)
        found (:found qr)
        end (:end found)
        to (qr-replacement qr found)
        adjacent? (qr-adjacent? qr (ed-current-buf m) found)
        [edited replaced?] (ed-try-edit m (fn (buf) (replace-region buf start end to)))
        grown (- (string/length to) (- end start))
        moved (if (:limit qr) (assoc qr :limit (+ (:limit qr) grown)) qr))
    (if replaced?
      [(assoc edited :query-replace (assoc moved :count (inc (:count qr))))
        (qr-next moved (ed-current-buf edited) adjacent? (+ start (string/length to)))]
      [(assoc edited :query-replace (assoc qr :match nil)) (buffer-length (ed-current-buf edited))])))

(defn- qr-matches (qr buf position collected)
  "Every match at or after `position`, non-overlapping, as a reversed list of `[start end
replacement]` — the matches `!` will replace and what each becomes, found before any of
them is."
  (let (found (when (int? position) (qr-find qr buf position)))
    (if (nil? found)
      collected
      (qr-matches qr
        buf
        (qr-next qr buf (qr-adjacent? qr buf found) (:end found))
        (cons [(:start found) (:end found) (qr-replacement qr found)] collected)))))

(sig qr-replace-at (buffer (list (tuple int int string)) -> buffer))
(defn- qr-replace-at (buf replacements)
  "`buf` with each `[start end text]` of `replacements` (ascending, found in `buf` before any
edit) put in. Front to back, each span shifted by what the replacements before it added or
removed, so point ends after the last one."
  (first (fold replacements
           [buf 0]
           (fn (progress replacement)
             (let ([edited shift] progress
                   [start end text] replacement)
               [(replace-region edited (+ start shift) (+ end shift) text)
                 (+ shift (- (string/length text) (- end start)))])))))

(defn- qr-all (m)
  "Replace the current match and every one after it, then finish (`!`). All of them are
ONE edit in one `undo-group`, so a single undo puts every occurrence back — never the
2×N steps of replacing them one by one."
  (let (qr (qr-state m)
        match (:match qr))
    (if (nil? match)
      (qr-finish m)
      (let (replacements (reverse (qr-matches qr (ed-current-buf m) match '()))
            [edited replaced?] (ed-try-edit m
                                 (fn (buf)
                                   (undo-group buf
                                     (fn (grouped) (qr-replace-at grouped replacements))))))
        (qr-finish (if replaced?
                     (assoc edited
                       :query-replace (assoc qr :count (+ (:count qr) (count replacements))))
                     (assoc edited :query-replace qr)))))))

(sig replace-all (buffer string string map -> (tuple buffer int)))
(defn replace-all (buf from to options)
  "`[buf' count]`: every match of `from` in `buf` between `options`' `:low` and `:high`
replaced by `to` without asking — `replace-string` and `replace-regexp`, which are `!` at
query-replace's first match: the same rope search (a regexp bounded by `:high`, so `$` and
`\\b` at the span's end read the text beyond it — brood ADR-554), the same `\\&` / `\\1`
references when `:regexp?`, the same case rule, and the edit ONE undo group. Point ends
after the last replacement, as Emacs's does. No match, or an empty `from`, is `[buf 0]`.

    (editor/buffer/buffer-text (first (query-replace/replace-all (editor/buffer/make-buffer \"a.c abc\") \"a.c\" \"X\" {:low 0 :high 7})))   ;=> \"X abc\""
  (let (qr {:from from
            :to to
            :regexp? (= true (:regexp? options))
            :match nil
            :count 0
            :region-start (:low options)
            :limit (:high options)}
        replacements (if (= from "") '() (reverse (qr-matches qr buf (:low options) '()))))
    (if (empty? replacements)
      [buf 0]
      [(undo-group buf (fn (group) (qr-replace-at group replacements))) (count replacements)])))

;; ---- going back: ^ , u U, and E -------------------------------------------------
;; Emacs's query-replace remembers each answer (`stack` in `perform-replace`): `^` goes back to
;; the previous match, `u` undoes the last replacement and asks about it again, `U` undoes them
;; all, `,` replaces and stays to show the result. A remembered answer is `{:state :replaced?
;; :next}`: the replace as it stood at that match, whether it was replaced, and where the search
;; went on from.

(defn- qr-remembered (m before replaced? next)
  "`m` with the answer just given at the match `before` (the replace's state there) pushed on its
history, when the replace is still going."
  (let (qr (:query-replace m))
    (if (nil? qr)
      m
      (assoc m
        :query-replace
          (assoc qr
            :history
              (cons {:state (dissoc before :history :shown) :replaced? replaced? :next next}
                (or (:history before) '())))))))

(defn- qr-show-replaced (m current entry history)
  "Point at a match already replaced (`entry`'s), its replacement lit and the question standing:
y, n or SPC go on from where the search went on before, `!` replaces the rest from there."
  (let (state (:state entry)
        start (:match state)
        to (qr-replacement state (:found state))
        shown (assoc current :history history :shown entry :match nil))
    (assoc (ed-set-buf m (goto-char (ed-current-buf m) start))
      :overlays [{:start start :end (+ start (string/length to)) :face face-isearch}]
      :echo (str (qr-prompt state) " (replaced)")
      :query-replace (assoc shown :prompt (qr-prompt current)))))

(defn- qr-back (m)
  "`^`: back to the previous match — asked again when it was skipped, shown when it was
replaced. Dings at the first."
  (let (qr (qr-state m)
        history (or (:history qr) '()))
    (if (empty? history)
      (ed-ding (message m "No previous match"))
      (let (entry (first history))
        (if (:replaced? entry)
          (qr-show-replaced m qr entry (rest history))
          (qr-goto (assoc m :query-replace (assoc (:state entry) :history (rest history)))
            (:match (:state entry))))))))

(defn- qr-undo-one (m)
  "`[m' undone?]`: the last replacement undone (one buffer undo — each was one edit) and the
replace back at its match, the answers since it forgotten."
  (let (qr (qr-state m)
        ;; the match shown after `^` or `,` is the latest answer
        answers (if (:shown qr) (cons (:shown qr) (or (:history qr) '())) (or (:history qr) '()))
        history (seq/drop-while answers (fn (entry) (not (:replaced? entry)))))
    (if (empty? history)
      [m false]
      (let (entry (first history)
            buf (ed-current-buf m)
            ;; one run of undo: a fresh `undo` after another would redo it
            undone (ed-set-buf m (if (:undoing qr) (undo-next buf) (undo buf))))
        [(qr-goto (assoc undone
                    :query-replace (assoc (:state entry) :history (rest history) :undoing true))
           (:match (:state entry)))
          true]))))

(defn- qr-undo (m)
  "`u`: undo the last replacement and ask about its match again."
  (let ([undone done?] (qr-undo-one m))
    (if done? undone (ed-ding (message m "Nothing to undo")))))

(defn- qr-undo-all (m)
  "`U`: undo every replacement made so far, back at the first one's match."
  (let ([undone done?] (qr-undo-one m))
    (cond
      (not done?) (ed-ding (message m "Nothing to undo"))
      (any? (or (map/get-in undone [:query-replace :history]) []) (fn (entry) (:replaced? entry)))
        (qr-undo-all undone)
      else undone)))

(defn- qr-edit-replacement (m)
  "`E`: the replacement edited in the minibuffer, then asked again at this match with it. The
replace is set aside while the minibuffer reads, since it would take the keys; C-g goes back
to it unchanged."
  (let (qr (qr-state m))
    (assoc m
      :query-replace nil
      :minibuffer
        {:edit (ed-mb-edit (str "Edit replacement string: ") (:to qr))
         :on-complete (fn (mm to) (qr-goto (assoc mm :query-replace (assoc qr :to to)) (:match qr)))
         :on-abort (fn (mm) (qr-goto (assoc mm :query-replace qr) (:match qr)))})))

(def- *qr-help*
  "y/SPC replace · n/DEL skip · , replace and stay · ! all · . replace and quit · ^ back · u undo · U undo all · E edit · q quit")

(def *qr-keys* ["y" "n" " " "!" "." "q" "," "^" "u" "U" "E" "?"])

(defn qr-control-key? (input)
  "Whether an active query-replace consumes `input`: an answer key (y/n/space/!/./q)
or Enter/Esc/C-g/Delete. Any other key finishes the replace and is dispatched normally."
  (or (and (string? input) (includes? *qr-keys* input))
    (includes? [:enter :escape :ctrl-g :delete] input)))

(defn- qr-new-state (from to options)
  "A replace of `from` → `to` not yet at a match, as [[qr-start]]'s `options` describe it (over a
region: its start, and the limit no match may pass)."
  (merge {:from from :to to :regexp? (= true (:regexp? options)) :match nil :count 0}
    (if-let (region (:region options)) {:region-start (first region) :limit (second region)} {})))

(defn qr-start (m from to &optional (options {}))
  "Begin query-replace of `from` → `to` from point; jump to the first match. `options`:
`:regexp?` makes `from` a regexp and lets `to` refer to its groups (C-M-%); `:region [low
high]` confines it to that span of the text (Emacs's query-replace with the region active):
it starts at `low` rather than point, the region is deactivated so the matches show, and no
match may end past `high` — which moves as replacements change the text's length
([[qr-limit]])."
  (let (region (:region options)
        buf (ed-current-buf m)
        state (qr-new-state from to options))
    (cond
      (= from "") (message m "(nothing to replace)")
      (and (:regexp? options) (regex/incomplete? from))
        (message m (str "Invalid regexp: " from " [incomplete input]"))
      (nil? region) (qr-goto (assoc m :query-replace state) (buffer-point buf))
      else
        (qr-goto (assoc (ed-set-buf m (clear-mark (goto-char buf (first region))))
                   :query-replace state)
          (first region)))))

(defn qr-handle (m input)
  "Fold one query-replace answer key: y/space replace+advance, n/Delete skip, `,` replace and
stay, ! all, . replace-one-and-stop, ^ back, u / U undo one / all, E edit the replacement,
? the keys, q/Enter/Esc/C-g stop. At a match already replaced (after `^` or `,`), y / n / SPC
go on and ! replaces the rest from there."
  (let (qr0 (qr-state m)
        ;; an undo run goes on only while u / U are pressed
        qr (if (includes? ["u" "U"] input) qr0 (dissoc qr0 :undoing))
        m (assoc m :query-replace qr)
        shown (:shown qr))
    (cond
      (= input "^") (qr-back m)
      (= input "u") (qr-undo m)
      (= input "U") (qr-undo-all m)
      (= input "?") (message m *qr-help*)
      shown
        (let (going (dissoc qr :shown))
          (cond
            (includes? ["y" " " "n" :delete] input)
              (qr-remembered (qr-goto (assoc m :query-replace going) (:next shown))
                (assoc (:state shown) :history (:history qr))
                true
                (:next shown))
            (= input "!") (qr-all (assoc m :query-replace (assoc going :match (:next shown))))
            (= input "E") (ed-ding m)
            else (qr-finish m)))
      (or (= input "y") (= input " "))
        (let ([replaced position] (qr-replace m))
          (qr-remembered (qr-goto replaced position) qr true position))
      (= input ",")
        (let ([replaced position] (qr-replace m))
          (if (:query-replace replaced)
            (qr-show-replaced replaced
              (:query-replace replaced)
              {:state (dissoc qr :history :shown) :replaced? true :next position}
              (or (:history qr) '()))
            replaced))
      (or (= input "n") (= input :delete))
        (let (buf (ed-current-buf m)
              found (:found qr)
              next (qr-next qr buf (qr-adjacent? qr buf found) (:end found)))
          (qr-remembered (qr-goto m next) qr false next))
      (= input "!") (qr-all m)
      (= input ".") (let ([replaced _] (qr-replace m)) (qr-finish replaced))
      (= input "E") (qr-edit-replacement m)
      else (qr-finish m)))) ; q / Enter / Esc / C-g

(defrecord query-replace-overlay ())
(impl Overlay
  query-replace-overlay
  (overlay-active? (_ m) (:query-replace m))
  (overlay-owns? (_ m input) (qr-control-key? input))
  (overlay-handle (_ m input) (qr-handle m input))
  (overlay-exit (_ m) (qr-finish m)))

(register-overlay :query-replace 40 (query-replace-overlay))

;; ---- the preview while the replacement is typed ------------------------------------------
;; Emacs 32's `query-replace-show-preview`: while `Query replace X with: ` is answered, every
;; match on screen shows what it will become. The match keeps the lazy highlight it has in the
;; y/n loop, and its replacement follows it as INLINE virtual text (`inlinetext`, an owner of
;; its own), so the text never changes until a key says so. Built on the replace's own search
;; and replacement ([[qr-find-any]], [[qr-replacement]]): the preview is what `y` would do.

(def *preview-owner* :query-replace-preview)
(def *preview-max* 400) ; the most matches one preview shows: a screen holds far fewer

(defn preview-annotations (qr buf low high)
  "The inline annotations previewing replace `qr` over the matches starting between `low` and
`high`: each match's replacement, after it, in `face-qr-preview`."
  (letrec (walk (fn (position acc)
                  (let (found (when (and (<= position high) (< (count acc) *preview-max*))
                                (qr-find qr buf position)))
                    (if (or (nil? found) (> (:start found) high))
                      acc
                      (walk (if (= (:end found) (:start found)) (inc (:end found)) (:end found))
                        (conj acc
                          {:at (:end found) :text (qr-replacement qr found) :face face-qr-preview}))))))
    (walk low [])))

(defn- preview-window (m buf)
  "`[low high]`: the chars of the selected pane's lines on screen."
  (let (rope (buffer-rope buf)
        top (ed-current-top m)
        rows (or (:view-rows m) 50)
        last-line (math/min (dec (text/line-count rope)) (+ top rows)))
    [(text/line->char rope (math/min top last-line))
      (if (< (inc last-line) (text/line-count rope))
        (text/line->char rope (inc last-line))
        (count rope))]))

(sig preview (model string string map -> model))
(defn preview (m from to options)
  "`m` showing what replacing `from` with `to` (as typed so far, [[qr-start]]'s `options`) does
to every match on screen: lit as the y/n loop lights them, each followed by its replacement.
Nothing to show — a regexp still being typed — clears it."
  (let (buf (ed-current-buf m)
        cleared (inlinetext/clear buf *preview-owner*))
    (if (or (= from "") (and (:regexp? options) (regex/incomplete? from)))
      (preview-off m)
      (let (qr (qr-new-state from to options)
            [low high] (preview-window m buf)
            start (if (:region-start qr) (math/max low (:region-start qr)) low))
        (assoc (ed-set-buf m
                 (inlinetext/set-annotations cleared
                   *preview-owner*
                   (preview-annotations qr cleared start high)))
          :query-replace-preview true
          :isearch-lazy (qr-lazy-spec qr))))))

(defn preview-off (m)
  "`m` with the replacement preview gone: its annotations and the highlight it lit."
  (if (:query-replace-preview m)
    (dissoc (ed-set-buf m (inlinetext/clear (ed-current-buf m) *preview-owner*))
      :query-replace-preview :isearch-lazy)
    m))
