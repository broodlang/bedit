(defmodule collab-commands
  "The shared-session COMMANDS — share this editor (M-x share-session), follow or mirror a
participant, stop sharing, ask what the session is doing. The mechanism they drive —
presence, the file registry, follow — is `collab`'s; this is the editor's front of it.

Split out of `commands.blsp` (issues.md X1)."
  (:use model) ; message / ed-current-index — the model a session lives on
  (:use commands) ; ed-name-prompt — the participant-name prompt
  (:use interactive) ; defcommand — the session commands, on M-x
  (:use collab) ; follow / participants / unshare — the presence layer the commands drive
  (:use editor/serve) ; serve / serve-stop — M-x share-session makes THIS editor a host
  (:use editor/buffer)) ; buffer-file / make-buffer / spawn-buffer — the buffers a session shares
;; ---- collab: follow a participant (the pairing view) + status ---------------
;; The shared-session commands. `collab` is a hard :use (not deferred): the model
;; layer already loads it via `input`, so this adds no startup weight.

(defn- ed-share-track (m mode verb)
  "The shared body of `share-follow` / `share-mirror`: toggle off if already tracking,
follow the one other participant immediately, else prompt (completing over everyone
present on any shared buffer)."
  (let (parts (collab/collab-participants m))
    (cond
      (:follow m) (collab/collab-unfollow m)
      (empty? parts) (message m "no one else is here")
      (= (count parts) 1)
        (let (kv (first (%map-pairs parts)))
          (collab/collab-follow-jump (collab/collab-follow m (first kv) (second kv) mode)
            (or (:view-rows m) 24))) ; engage NOW, not on their next move
      :else
        (let (by-name (fold (%map-pairs parts) {} (fn (acc kv) (assoc acc (second kv) (first kv)))))
          (assoc m
            :minibuffer
              (ed-name-prompt (str verb ": ")
                (keys by-name)
                (fn (mm nm)
                  (let (pid (get by-name nm))
                    (if (nil? pid)
                      (message mm (str "no participant " nm))
                      (collab/collab-follow-jump (collab/collab-follow mm pid nm mode)
                        (or (:view-rows mm) 24)))))))))))

;; check-allow: as `cmd-share-mirror` below — `ed-share-track`'s result is the unknown
(check-allow :trusted
  (defcommand cmd-share-follow
    (m key)
    "Follow another participant (M-x share-follow / C-x f): your point — and buffer,
when they switch — rides their caret live, until you move yourself (any point-moving
key takes the wheel back) or they leave. Already tracking? This stops it (a toggle).
With exactly one other participant it follows them at once; with more it prompts,
completing over who's here."
    (ed-share-track m :follow "Follow")))

;; check-allow: `ed-share-track` folds a collab call whose result the checker cannot see; it
;; answers a model
(check-allow :trusted
  (defcommand cmd-share-mirror
    (m key)
    "Mirror another participant (M-x share-mirror / C-x F): like `share-follow`, but
your window also reproduces their VIEWPORT — buffer, caret, and scroll — so you see
what they see, the old one-view shared experience, per-person and reversible. Any
move of your own takes the wheel back; a toggle like share-follow."
    (ed-share-track m :mirror "Mirror")))

(def *share-session-welcome*
  "bedit — a shared session.\n\nYou are attached to someone's live editor: open any file they have (C-x C-f)\nand you edit it together, each with your own caret. C-x f follows a participant;\nC-x F mirrors their view. C-x C-c detaches.\n")

(defn- ed-share-session-start (m)
  "Turn THIS editor into a shared-session host: become a node (\"bedit\", if not
already one), start the file registry, share the current buffer, and serve fresh
sessions to attachers (each gets `:collab-reg`, so any file they visit is shared too).
The serve manager pid rides `:collab-serving` for share-session-stop. The `make-model`
closure must capture only plain values (strings, pids) — it crosses process boundaries
(manager → session spawns), and a captured MODEL would smuggle rope handles across,
which cannot cross (ADR-033)."
  (do
    (when (= (node/name) :nonode) (node/start :bedit))
    (let (reg (collab/collab-registry-start)
          m1 (collab/collab-autoshare (assoc m :collab-reg reg))
          ;; attachers open the host's current file when it has one, else ONE shared
          ;; welcome (spawned here, once — not per attacher)
          file (buffer-file (ed-current-buf m1))
          proc (if (nil? file)
                 (spawn-buffer (make-buffer *share-session-welcome* "*shared*"))
                 ;; autoshare just linked it; the registry fallback covers a slot that
                 ;; somehow didn't link (e.g. a slow registry) — same pid either way
                 (or (get-in m1 [:hosted (ed-current-index m1) :proc])
                   (collab/collab-registry-share reg
                     file
                     (buffer-text (ed-current-buf m1))
                     (buffer-name (ed-current-buf m1)))))
          mk (fn ()
               (collab/collab-share-slot (assoc (ed-init (if (nil? file)
                                                           (make-buffer *share-session-welcome*
                                                             "*shared*")
                                                           (find-file-buffer file)))
                                           :collab-reg reg)
                 0 proc))
          ;; view/update resolved late (quoted symbols), as keymap dispatch does —
          ;; commands must not :use view/input (they :use commands)
          mgr (serve mk (reflect/eval 'view/ed-view) (reflect/eval 'input/ed-update)))
      (message (assoc m1 :collab-serving mgr)
        (str "sharing this editor — attach with: bedit --attach bedit --as NAME")))))

(defcommand cmd-share-session
  (m key)
  "Share THIS editor (M-x share-session): become a host others attach to
(`bedit --attach bedit --as NAME`) — every file buffer anyone visits is shared, with
presence, follow, and mirror. Prompts for your display name when none is set (set
`:share-name \"you\"` in init.blsp, or launch with --as, to skip the prompt).
M-x share-session-stop ends it."
  (cond
    (:collab-serving m) (message m "already sharing — M-x share-session-stop to end")
    ;; an ATTACHED session already lives inside someone's share — serving from it
    ;; would clobber the daemon's own session manager (one serve name per node)
    (:collab-reg m) (message m "already in a shared session")
    (nil? (:participant m))
    ;; a plain free-text prompt (the query-replace shape) — no candidate list to
    ;; complete against, any typed name accepted on RET
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit "Your name: " "")
           :on-complete (fn (mm nm)
                          (if (= (string/trim nm) "")
                            (message mm "share-session needs a name")
                            (ed-share-session-start (collab/collab-set-name mm (string/trim nm)))))})
    :else (ed-share-session-start m)))

(defcommand cmd-share-session-stop
  (m key)
  "Stop sharing this editor (M-x share-session-stop), completely: every attached
participant's session is ended (their window closes), every shared buffer process and
the registry are stopped, and this editor's slots unshare — the session is truly over,
not just closed to newcomers. Your buffers keep their current content locally."
  (if (nil? (:collab-serving m))
    (message m "not sharing — M-x share-session starts")
    (let (ended (serve-stop (:collab-serving m))
          ;; unshare the SHARED slots BEFORE stopping the processes (the withdraws
          ;; still land). Only :collab? slots — under the flip every buffer is
          ;; hosted, and unsharing a purely local one would orphan its process
          ;; (unsubscribed but never stopped) and force a pointless respawn.
          m1 (fold (%map-pairs (or (:hosted m) {}))
               m
               (fn (acc kv)
                 (if (:collab? (second kv))
                   (collab/collab-unshare acc (first kv))
                   acc)))
          _ (when (:collab-reg m) (collab/collab-registry-stop (:collab-reg m))))
      (message (dissoc (dissoc m1 :collab-reg) :collab-serving)
        (str "stopped sharing"
          (if (and (number? ended) (> ended 0)) (str " — " ended " session(s) ended") ""))))))


(defcommand cmd-collab-status
  (m key)
  "Echo this buffer's collab state — shared or not, the push version, who's here, and
who you're following (M-x collab-status; a quick sanity probe when testing sessions)."
  (let (i (ed-current-index m)
        sh (get-in m [:hosted i]))
    (if (nil? (:collab? sh))
      ; hosted ≠ shared: every live buffer is hosted
      (message m "not a shared buffer")
      (let (who (map (%map-pairs (collab/collab-participants m)) (fn (kv) (second kv)))
            f (:follow m))
        (message m
          (str "shared v"
            (:version sh)
            " · here: "
            (if (empty? who) "just you" (string/join who ", "))
            (if f (str " · following " (:name f)) "")))))))

