(defmodule input
  "The editor's input layer: fold one key event into the next model.

Dispatch goes through **layers** (`std/layers.blsp`) composed across two scopes
(`ed-active-keymap` → `scope-keymap`): the active buffer's *mode* layers (`text-mode`
by default, see `modes`) over the model's keybinding *profile* layers (emacs/vim, see
`keymaps`), the buffer winning. `keymap-step` then runs one (possibly chorded)
keystroke through it, threading the prefix-`:pending` state — so the chord state
machine (prefix entry, mid-chord resolution, dead-end reset, self-insert fallback)
lives in the language toolkit, not here (the prime directive — see CLAUDE.md). The
bindings are data, declared per-mode in `modes`; this module only resolves the
active keymap, renders the echo-area label for a prefix / undefined chord, and
gates the minibuffer. Keys map to fully-qualified command **symbols** resolved
with `(eval sym)` at dispatch time, so redefining a command (or rebinding a key)
hot-swaps behaviour on the next keystroke (late binding, the path to a
self-editing editor)."
  (:use editor/buffer)
  (:use model) ; ed-scroll, message, the minibuffer field, current-buffer accessors
  (:use panes) ; ed-selected-text-rows (split-aware viewport) + ed-mouse (event folding)
  (:use view) ; ed-modeline-click / ed-modeline-hover — status-bar segment click + hover hit-test
  (:use commands) ; the self-insert fallback
  (:use complete-at-point) ; the completion popup (Tab) + its modal key handling
  (:use isearch) ; the modal incremental-search / query-replace mini-loops
  (:use interactive) ; current-prefix-arg / prefix-consuming? — the prefix-arg seam
  (:use editor/keymap) ; keymap-step — the std chord dispatcher
  (:use editor/ui) ; overlay-route — the shared modal-overlay dispatch fallthrough
  ; bshell is loaded below with a bare `require`: its event handlers register at load,
  ; and its per-key prompt guard rides the generic `:post-key` layer facet now — nothing
  ; here refers to its names anymore
  ; compile is loaded below with a bare `require`: its defcommands + UiEvent impls
  ; register at load, but nothing here refers to its names anymore
  (:use hosted) ; hosted-step — the loop-tail content propagate for process-backed slots
  (:use collab) ; shared-buffer-process pushes: the [:buffer-updated …] event handler
  ; web / git are deferred — guarded at their call sites with (bound? ...)
  (:use keymaps) ; ed-ensure-profile — seed the model-scope keybinding profile (emacs/vim)
  (:use editor/layers)) ; scope-keymap (compose buffer + model layers) + init-buffer-layers
;; `modes` defines the layers and registers the default (text-mode); the bindings live
;; there, as data, not here. It — with bshell (C-x p e shell), compile (M-x compile +
;; next-error) and git (idle-beat git-cache-status) — registers commands / event handlers
;; / UiEvent impls at load; as project source modules they load with the image.
;; editor/lineedit (the minibuffer's one-line editor core) is referenced qualified below
;; and auto-loads.
;; ---- the active keymap comes from the buffer's layers -----------------------

(defn- ed-ensure-layers
  (m)
  "Make sure both layer scopes are seeded before dispatch: the model's keybinding
*profile* (`keymaps/ed-ensure-profile` — emacs by default), and the current buffer's
*mode* layers (from its type — `text-mode` by default, `.blsp` → brood). Buffers
created anywhere get their mode here, lazily, so dispatch always has a keymap."
  (let (m1 (ed-ensure-profile m)
        b (ed-current-buf m1))
    (if (nil? (:layers b)) (ed-set-buf m1 (init-buffer-layers b)) m1)))

(defn- ed-active-keymap
  (m)
  "The keymap in force: the selected buffer's **mode** layers composed with the
model's **profile** layers (`scope-keymap`), the buffer winning. The profile (emacs/vim
— `keymaps`) lives on the model scope; the mode (brood/text/…) on the buffer."
  (scope-keymap (list (ed-current-buf m) m)))

(defn- ed-post-key-guards
  (m-before m key)
  "Run the current buffer's mode `:post-key` guards over the just-dispatched model
(layers §7): each guard is `(m-before m-after key) -> model`, collected highest
precedence first, each seeing the previous guard's result. The model is immutable,
so a guard vetoes what the key did by returning `m-before` — how bshell keeps
point out of its prompt and the tutorial protects its prose without this dispatch
path naming either. Guards are fn symbols, resolved late (hot-swappable)."
  (fold (fn (mm g) ((if (symbol? g) (eval g) g) m-before mm key))
    m
    (layer-collect (ed-current-buf m) :post-key)))

;; ---- dispatch (the chord state machine is keymap-step; echo policy is ours) --
;; The echo-area key label is `model/ed-key-label` (shared with which-key + describe-key),
;; so a prefix / undefined-chord label reads identically everywhere (C-M-, S-, SPC, …).

(defn- ed-self-insert
  (m key)
  "The keymap fallback: a printable key self-inserts; any other unbound key is a
no-op (so a stray :f5 / :page-up never tries to insert a keyword).

In a modal COMMAND state — vim `:normal` or `:visual` — NOTHING types. An unbound
letter there is a dead key, exactly as in vim, where `z` alone is simply an incomplete
command. Without this the fallback typed every key vim does not bind: z, q, s, t, r,
m, f and most of the rest of the keyboard inserted themselves into the buffer, which
is what \"vim mode is very broken\" turns out to mean. `ed-vim-command-mode?` already
existed for the same reason — a mode layer's RET must not type in normal mode — but
the fallback, which is where the majority of keys land, never asked it."
  (cond
    (ed-vim-command-mode? m) m
    (string? key) (cmd-self-insert m key)
    else m))

;; ---- prefix arguments (C-u N) -----------------------------------------------
;; `:prefix-arg` is `{:count N :raw bool}` while a numeric argument is being built:
;; C-u seeds 4 (`:raw` — not yet explicit digits); a further C-u multiplies by 4; a
;; digit switches to explicit accumulation. The next *complete* command runs `:count`
;; times (the common-case Emacs mechanism; per-command interactive specs are the
;; deferred std/layers improvement). A command that reads the arg itself (C-u C-SPC →
;; pop-mark) registers via `interactive/register-prefix-consuming` (declared next to
;; the command) so it runs once, not repeated.

(defn- ed-digit?
  (input)
  "True if `input` is a single decimal-digit key."
  (and (string? input) (= (string/length input) 1) (>= (index-of "0123456789" input) 0)))

(defn- ed-prefix-continues?
  (m input)
  "Keys that extend a pending prefix arg rather than ending it: another C-u, a digit, or
a `-` **only while the argument is still raw** (no digits yet) — `C-u -` negates, but a
`-` after digits terminates the arg and self-inserts (so `C-u 5 -` types five dashes)."
  (or (= input :ctrl-u)
    (ed-digit? input)
    (and (= input "-") (get-in m [:prefix-arg :raw]))))

(defn- ed-prefix-read
  (m input)
  "Fold a C-u / digit / `-` into the active prefix-arg accumulator. The count carries its
sign, so digits after a negative seed (from `M--`/`C--` or `-`) accumulate negative."
  (let (pa (:prefix-arg m)
        c (:count pa)
        neg (< c 0))
    (cond
      (= input :ctrl-u) (assoc m :prefix-arg {:count (* 4 c) :raw true})
      ;; `-`: raw → seed a negative argument (-1); mid-number → flip the sign.
      (= input "-") (assoc m :prefix-arg {:count (if (:raw pa) -1 (- c)) :raw (:raw pa)})
      else
        (let (d (string->number input)
              sd (if neg (- d) d))
          (assoc m
            :prefix-arg (if (:raw pa) {:count sd :raw false} {:count (+ (* 10 c) sd) :raw false}))))))

(defn- ed-run-arg
  (m1 step this-cmd input n)
  "Run `this-cmd` under numeric prefix argument `n`: `|n|` repetitions, swapping to its
registered inverse command when `n` is negative (Emacs negative-argument — `C-- C-f`
goes backward). Repeats thread `:last-command`/`:this-command` so consecutive kills /
inserts coalesce. With no registered inverse a negative arg just repeats `|n|` times."
  (let (an (math/abs n)
        inv (command-inverse this-cmd))
    (if (and (< n 0) inv)
      (fold (fn (mm i)
              ((eval inv) (assoc mm
                            :last-command (if (= i 0) (:last-command mm) inv)
                            :this-command inv)
                input))
        m1
        (range an))
      (fold (fn (mm i) (step (if (= i 0) mm (assoc mm :last-command this-cmd)))) m1 (range an)))))

(defn- ed-amalgamate-undo?
  (this last)
  "Whether `this` command's edit amalgamates into the previous undo group: it repeats
`last` and both are typing/deletion run commands (`model/*typing-commands*`). Drives
`amalgamate-undo`."
  (and (= this last) (includes? *typing-commands* this)))

(def- ed-shift-deactivators
  ;; plain motions that collapse a shift-selection (Emacs shift-select-mode): a non-shift
  ;; arrow/word/buffer move clears the region and just moves. Region-using commands (kill,
  ;; copy, …) aren't here, so they still act on a shift-selected region.
  (list 'commands/cmd-forward-char
    'commands/cmd-backward-char 'commands/cmd-next-line 'commands/cmd-previous-line
    'commands/cmd-beginning-of-line 'commands/cmd-end-of-line 'commands/cmd-forward-word
    'commands/cmd-backward-word 'commands/cmd-beginning-of-buffer 'commands/cmd-end-of-buffer))

(defn- ed-shift-deactivate
  (m this-cmd)
  "Collapse a shift-selection when a plain motion runs: clear the mark + `:shift-select`
flag so a non-shift arrow moves without a region (Emacs shift-select-mode). Other
commands leave the region intact (so kill/copy act on a shift-selection)."
  (if (and (:shift-select m) (includes? ed-shift-deactivators this-cmd))
    (ed-set-buf (dissoc m :shift-select) (clear-mark (ed-current-buf m)))
    m))

(defn- ed-dispatch-key
  (m input)
  "Resolve and run `input` through the active keymap (the chord work is `keymap-step`),
repeating the command `:prefix-arg` times when one is set (negative runs the inverse —
see `ed-run-arg`). A prefix key mid-chord just steps (the prefix arg carries until the
chord completes); a prefix-consuming command (set-mark) runs once and reads the arg."
  (let (km (ed-active-keymap m)
        binding (get (or (:pending m) km) input)
        ;; the command keymap-step will run: a symbol when bound, :self-insert when
        ;; unbound (the fallback), nil for a prefix key (mid-chord — no command).
        this-cmd (cond (map? binding) nil (nil? binding) :self-insert :else binding)
        pa (current-prefix-arg m) ; the numeric arg (count), or nil when none is active
        n (or pa 1) ; the repeat count; an explicit C-u 0 runs the command zero times
        ;; record this/last command (the Emacs mechanism) so kills coalesce and
        ;; M-y yank-pop knows it follows a yank; a prefix key leaves them untouched.
        m1 (if (nil? this-cmd)
             m
             (assoc m :last-command (:this-command m) :this-command this-cmd))
        ;; Arm the current buffer's undo amalgamation for this command: a typing /
        ;; deletion run merges into one undo group, every other command starts a fresh
        ;; one (so a command undoes atomically — Emacs `undo-boundary`). Set explicitly
        ;; each command so a no-op edit can't leave a stale flag.
        mc (if (nil? this-cmd)
             m1
             (ed-shift-deactivate (ed-set-buf (dissoc m1 :undo-break)
                                    (assoc (ed-current-buf m1)
                                      :undo-amalgamate
                                        (and (ed-amalgamate-undo? this-cmd (:last-command m1))
                                          (not (:undo-break m1)))))
               this-cmd))
        ;; one keymap step (resolve through :pending / the keymap, threading :pending)
        step (fn (mm)
               (let ([m2 p2] (keymap-step km
                               (:pending mm)
                               (assoc mm :echo "")
                               input
                               ed-self-insert))
                 (assoc m2 :pending p2)))
        result (cond
                 ;; a prefix key mid-chord: step, keep the prefix arg for the resolving key
                 (nil? this-cmd) (step mc)
                 ;; a command that consumes the arg itself (set-mark → pop-mark): run once
                 (and pa (prefix-consuming? this-cmd)) (dissoc (step mc) :prefix-arg)
                 ;; a normal command under a prefix arg: run |N| times — the inverse when N is
                 ;; negative (`ed-run-arg`) — then clear the arg
                 pa (dissoc (ed-run-arg mc step this-cmd input n) :prefix-arg)
                 else (step mc)))
    ;; `:chord` accumulates the keys of the in-progress prefix chord, so the echo shows the
    ;; FULL chord ("C-x p-", "C-x p e is undefined") — not just the last key. Carried while a
    ;; prefix is pending; cleared the moment the chord resolves (a command ran) or aborts.
    (let (chord (append (or (:chord m) []) [input]))
      (cond
        (map? binding) (assoc result :echo (str (ed-keys-label chord) "-") :chord chord)
        (and (nil? binding) (:pending m))
          (assoc result
            :echo (str (ed-keys-label chord) " is undefined")
            :chord [])
        else (assoc result :chord [])))))

;; ---- repeat-mode (Emacs `repeat-mode`: tap the last key to repeat the command) -----
;; After a command in `*repeat-commands*` runs (typically via a chord like C-x o), arm a
;; `:repeat` transient: pressing the same key again re-invokes the command, and again, …
;; until any other key (which exits and dispatches normally). This is how a chord command
;; repeats — Emacs never hold-repeats chords; it taps. The `:repeat` overlay lives in
;; `ed-transient-handlers`; arming happens here, post-dispatch.

(def *repeat-commands*
  ;; Commands that arm repeat-mode. Add a command symbol here to make it tap-repeatable:
  ;; C-x o then `o o o` cycles panes; C-x → then `→ → →` cycles buffers.
  (list 'commands/cmd-other-pane
    'commands/cmd-next-buffer 'commands/cmd-previous-buffer 'commands/cmd-repeat-complex-command))

(defn- ed-arm-repeat-mode
  (m input)
  "After `ed-dispatch-key`, arm `:repeat` (repeat-mode) when this step actually ran a
command (`:pending` is clear — not a mid-chord prefix) that's in `*repeat-commands*`, so
pressing `input` (its last key) again re-invokes it. Otherwise leave the model as-is (the
`:repeat` overlay's `:exit` has already cleared any prior repeat on a non-repeat key)."
  (if (and (nil? (:pending m)) (includes? *repeat-commands* (:this-command m)))
    (assoc m :repeat {:key input :command (:this-command m)})
    m))

(defn- ed-repeat-run
  (m)
  "Re-invoke the armed repeat-mode command (an Emacs repeat-mode tap), keeping `:repeat`
armed so it keeps repeating. Resolves the command symbol to its fn and runs it with the
repeat key; the command itself does the work (pane/buffer cycling, …)."
  (let (rp (:repeat m))
    ((eval (:command rp)) m (:key rp))))

(defn ed-dispatch (m0 input)
  "Fold one key `input` into the next model. While a numeric prefix argument is being
built (`:prefix-arg` set and `input` a C-u/digit), accumulate it and run nothing yet;
otherwise resolve and run the key through the active keymap (`ed-dispatch-key`)."
  (let (m (ed-ensure-layers m0))
    (if (and (:prefix-arg m) (ed-prefix-continues? m input))
      (let (m2 (ed-prefix-read m input))
        (assoc m2 :echo (str "C-u " (get-in m2 [:prefix-arg :count]) "-")))
      (ed-arm-repeat-mode (ed-dispatch-key m input) input))))

;; ---- the minibuffer (modal: when active, all input is the minibuffer's) ------
;; A one-line prompt that REUSES the REPL line editor: `:minibuffer :edit` is a
;; `std/lineedit` state (the same pure core std/observer's minibuffer drives), so
;; the prompt gets emacs editing for free — C-a/C-e, C-f/C-b, M-f/M-b, C-k/C-u/C-w/
;; M-d, C-y yank, C-t, ↑/↓ history, C-r reverse-search. Keys are fed to
;; `lineedit-handle`; we intercept only **Tab** (per-prompt completion via the
;; minibuffer's `:complete-fn`, not lineedit's symbol completion) and **Esc / C-g**
;; (abort). Enter makes lineedit set `:done :submit`, and we run `:on-complete` with
;; the text; C-c (`:cancel`) closes. (The text/point/prompt accessors live in `model`.)

(defn- mb-preview
  (m cand)
  "Fire the active minibuffer's optional `:on-preview` hook with the currently-selected
candidate `cand`, returning the updated model. The hook previews the selection (e.g. imenu
jumps point to that symbol) *without* closing the prompt; absent hook or nil candidate is a
no-op. The post-step `ed-scroll` then brings the previewed point into view."
  (let (hook (get-in m [:minibuffer :on-preview]))
    (if (or (nil? hook) (nil? cand)) m (hook m cand))))

(defn- mb-abort
  (m)
  "Close the minibuffer, first firing its optional `:on-abort` hook so a previewing prompt
can restore the position it started from (the imenu cancel-returns-home behaviour)."
  (let (hook (get-in m [:minibuffer :on-abort])
        m2 (if (nil? hook) m (hook m)))
    (assoc m2 :minibuffer nil :echo "quit")))

(defn minibuffer-handle (m input)
  "Fold one key into the active minibuffer. Tab replaces the text with the
`:complete-fn` of the input; Esc / C-g abort (firing `:on-abort`); moving the selection
fires `:on-preview`; every other key drives lineedit's pure editor (`lineedit-handle`) —
on `:submit` (Enter) run `:on-complete` with the text, on `:cancel` close."
  (let (m (if (and (get-in m [:minibuffer :accept-selection])
                (includes? [:tab :enter :ctrl-n :ctrl-p :up :down] input))
            (ed-cache-mb-candidates m) ; a deliberate candidate action forces a fresh list (a
            m) ; large debounced source may be showing a stale one)
        mb (:minibuffer m)
        sel? (:accept-selection mb) ; Vertico-style prompts (M-x, C-x b, C-x p f)
        cands (if sel? (mb-candidates mb) ())
        n (count cands)
        cur (mb-sel mb))
    (cond
      ;; Tab on a Vertico prompt with candidates fills the **selected** candidate (the
      ;; highlighted row), not the common prefix of the typed text — so Tab on a hovered
      ;; directory completes THAT directory (its trailing "/" then re-lists its contents =
      ;; expands it) instead of snapping the selection back to the top. With no candidates
      ;; (a freshly typed path), fall back to the prompt's own `:complete-fn`.
      (= input :tab)
        (if (and sel? (> n 0))
          (assoc m
            :minibuffer
              (assoc mb
                :edit (ed-mb-set-text (:edit mb) (nth cands (min cur (dec n))))
                :sel 0))
          (let (completed ((:complete-fn mb) (mb-text mb)))
            (assoc m
              :minibuffer (assoc mb :edit (ed-mb-set-text (:edit mb) completed) :sel 0))))
      (ed-cancel-key? input) (mb-abort m)
      ;; Vertico selection: C-n/↓ and C-p/↑ move the selected candidate — only on a
      ;; prompt that accepts a selection and has candidates (else they fall through to
      ;; lineedit's history). Each move fires `:on-preview` with the newly-selected
      ;; candidate so a previewing prompt (imenu) tracks the highlight.
      (and sel? (> n 0) (or (= input :ctrl-n) (= input :down)))
        (let (next (mod (inc cur) n))
          (mb-preview (assoc m :minibuffer (assoc mb :sel next)) (nth cands next)))
      (and sel? (> n 0) (or (= input :ctrl-p) (= input :up)))
        (let (prev (mod (+ (dec cur) n) n))
          (mb-preview (assoc m :minibuffer (assoc mb :sel prev)) (nth cands prev)))
      ;; Enter accepts the *selected candidate* (Vertico prompt with candidates), else
      ;; the typed text (find-file, or no candidates).
      (= input :enter)
        (if (and sel? (> n 0))
          ((:on-complete mb) (assoc m :minibuffer nil)
            (nth cands (min cur (dec n))))
          ((:on-complete mb) (assoc m :minibuffer nil) (mb-text mb)))
      else
        (let (edit (editor/lineedit/lineedit-handle (:edit mb) input)
              done (:done edit))
          (cond
            (= done :submit) ((:on-complete mb) (assoc m :minibuffer nil) (:text edit))
            (nil? done) (assoc m :minibuffer (assoc mb :edit edit :sel 0))
            ; typing resets the selection
            else (mb-abort m))))))

(defn ed-cancel-key? (input)
  "Whether `input` is a cancel key (Esc / C-g) — what every transient reads as quit."
  (or (= input :escape) (= input :ctrl-g)))

;; ---- transient input overlays (one registry; std's fallthrough policy) ------
;; The minibuffer, the completion popup, incremental search, and query-replace are
;; all *transient* modes that sit beside the keymap: while open, one of them captures
;; input. Each is a record implementing `editor/ui`'s `Overlay` ability (ADR-183):
;; `overlay-active?` says when it is open, `overlay-owns?` which keys are its to
;; handle (skipped = capture-all, like the minibuffer), `overlay-handle` folds an
;; owned key into the model, and `overlay-exit` dismisses before a non-owned key
;; falls through (skipped = no dismiss step). The shared `editor/ui/overlay-route`
;; routes one key to whichever is open. A new modal feature defines a record + impl
;; and joins `ed-transient-handlers` instead of growing `ed-update`. The dispatch
;; rule itself lives in std (ADR-094) — the observer's minibuffer rides the same
;; `overlay-route` — and re-registering an impl hot-swaps a live overlay (late
;; binding, same as commands).

(defn ed-describe-key-step (m input)
  "One key of a C-h k key sequence: resolve `input` through the active keymap (descending
into a pending prefix). On a command, report its name + first docstring line; on a prefix,
keep reading; on an unbound key, say so. Esc/C-g aborts."
  (if (ed-cancel-key? input)
    (message (dissoc m :describe-key) "quit")
    (let (km (ed-active-keymap m)
          st (:describe-key m)
          keys (append (:keys st) (list input))
          binding (get (or (:pending st) km) input))
      (cond
        (map? binding) (assoc m :describe-key {:pending binding :keys keys})
        (nil? binding) (message (dissoc m :describe-key) (str (ed-keys-label keys) " is undefined"))
        :else
          (message (dissoc m :describe-key)
            (str (ed-keys-label keys)
              " runs "
              (ed-cmd-label binding)
              (let (d (ed-doc binding)) (if d (str " — " (ed-first-line d)) ""))))))))

(defrecord describe-key-overlay ()) ; C-h k: the next key sequence is described, not executed
(impl Overlay
  describe-key-overlay
  (overlay-active? [_ m] (:describe-key m))
  ;; no overlay-owns? — capture-all: the whole next chord is ours to resolve
  (overlay-handle [_ m input] (ed-describe-key-step m input)))

(defrecord read-char-overlay ()) ; ed-read-char: the next key is handed to a continuation (zap, registers)
(impl Overlay
  read-char-overlay
  (overlay-active? [_ m] (:read-char m))
  ;; no overlay-owns? — capture-all: the next key is the one being read
  (overlay-handle [_ m input]
    (if (ed-cancel-key? input)
      (message (dissoc m :read-char) "quit")
      ((get-in m [:read-char :then]) (dissoc m :read-char) input))))

(defrecord menu-overlay ()) ; the right-click context menu: arrows move, Enter runs, Esc/C-g closes
(impl Overlay
  menu-overlay
  (overlay-active? [_ m] (:menu m))
  ;; no overlay-owns? — modal: every key is the menu's while it's open
  (overlay-handle [_ m input]
    (cond
      (= input :up) (ed-menu-move m -1)
      (= input :down) (ed-menu-move m 1)
      (= input :enter) (ed-menu-run m)
      (ed-cancel-key? input) (ed-close-menu m)
      else m))) ; any other key is swallowed (the menu stays open)
(defrecord query-replace-overlay ())
(impl Overlay
  query-replace-overlay
  (overlay-active? [_ m] (:query-replace m))
  (overlay-owns? [_ m input] (qr-control-key? input))
  (overlay-handle [_ m input] (qr-handle m input))
  (overlay-exit [_ m] (qr-finish m)))

(defrecord isearch-overlay ())
(impl Overlay
  isearch-overlay
  (overlay-active? [_ m] (:isearch m))
  (overlay-owns? [_ m input] (isearch-control-key? input))
  (overlay-handle [_ m input] (isearch-handle m input))
  (overlay-exit [_ m] (isearch-exit m)))

(defrecord minibuffer-overlay ())
(impl Overlay
  minibuffer-overlay
  (overlay-active? [_ m] (:minibuffer m))
  ;; no overlay-owns? — capture-all: every key is the minibuffer's
  (overlay-handle [_ m input] (minibuffer-handle m input)))

(defrecord completion-overlay ())
(impl Overlay
  completion-overlay
  (overlay-active? [_ m] (:completion m))
  (overlay-owns? [_ m input] (complete-control-key? input))
  (overlay-handle [_ m input] (complete-handle m input))
  (overlay-exit [_ m] (complete-cancel m)))

(defrecord repeat-overlay ()) ; Emacs repeat-mode: tap the last key again to repeat the command
(impl Overlay
  repeat-overlay
  (overlay-active? [_ m] (:repeat m))
  (overlay-owns? [_ m input] (= input (get-in m [:repeat :key])))
  (overlay-handle [_ m input] (ed-repeat-run m))
  (overlay-exit [_ m] (dissoc m :repeat)))

(def- ed-transient-handlers
  (list (describe-key-overlay)
    (read-char-overlay)
    (menu-overlay)
    (query-replace-overlay)
    (isearch-overlay)
    (minibuffer-overlay)
    (completion-overlay)
    (repeat-overlay)))

(defn ed-route-transient (m input)
  "Fold `input` into the active transient overlay, or through normal dispatch
(`ed-dispatch`) when none is open — via the shared `editor/ui/overlay-route`. The
owning handler consumes the key; otherwise the overlay exits (`:exit`) and the key is
dispatched normally (Emacs' dismiss-and-process)."
  (overlay-route ed-transient-handlers m input ed-dispatch))

;; ---- key repeat (consumer-paced, off the GUI's down/up pair) ----------------
;; The GUI backend no longer relays the OS auto-repeat (it floods the mailbox, so a
;; release left a backlog that kept "playing" — the cursor scrolling on past the
;; key-up). Instead it sends one key-down and, on release, a `[:key-up k]`. We track
;; the held key (`:held-key`) and re-issue it on the refresh `:tick`, shortening the
;; tick to a repeat beat so the cadence is paced by *our* render loop — it can't
;; outrun the screen and stops the instant the key lifts. The terminal frontend sends
;; no releases, so repeat is gated on `:gui-keys` (set once a `[:key-up]` is seen):
;; there the terminal's own key repeat still applies, and we never engage (and so
;; never run away with no release to stop us).

(defdyn *repeat-delay-ms* 220) ; initial pause before a held key starts repeating (typematic)
(defdyn *repeat-rate-ms* 30) ; interval between repeats once it has started
(defn ed-repeat-delay (m)
  "The hold-before-repeat delay for this model: the init file's `:repeat-delay` when
set (`config/apply-to-model` seeds it), else `*repeat-delay-ms*`. The 'initial motion'
feel of holding a key is exactly this number."
  (or (:repeat-delay m) *repeat-delay-ms*))

(defn ed-repeat-rate (m)
  "The interval between repeats once a held key is repeating: the init file's
`:repeat-rate` when set, else `*repeat-rate-ms*`."
  (or (:repeat-rate m) *repeat-rate-ms*))

(def *view-resume-keys*
  ;; Plain cursor-movement keys that should resume from the VISIBLE area after you've
  ;; scrolled the cursor off-screen (wheel / scrollbar): they pull point into view first
  ;; (`ed-point-into-view`), so the view doesn't snap back to the off-screen cursor — what
  ;; reads as "jumping to the top". Everything else (recenter C-l, goto, isearch, page
  ;; scroll, typing, …) deliberately acts on the real point, off-screen or not.
  [:up :down :left :right :ctrl-n :ctrl-p :ctrl-f :ctrl-b])

(defdyn *no-repeat-keys*
  ;; Repeat is the DEFAULT for any key in the plain editing context (so every motion,
  ;; deletion, open-line, etc. auto-repeats while held without being enumerated). Only
  ;; these are excluded: the cancel keys, where holding is pointless. Prefix chords
  ;; (C-x, M-x, …) need no entry — they set `:pending`, which `ed-repeatable?` already
  ;; excludes; transient overlays (isearch, completion, the minibuffer) are excluded the
  ;; same way. Add a key here only to *stop* it repeating.
  [:escape :ctrl-g])

(defn ed-repeat-key? (input)
  "Whether `input` is a key that may auto-repeat while held. Repeat-by-default: any
self-inserting character (a 1-char string) or command key repeats, EXCEPT the cancel
keys in `*no-repeat-keys*`. (Prefix keys are excluded separately by `ed-repeatable?`
via `:pending`, so they need no entry here.) So every navigation / text-manipulation
key repeats without being enumerated — to opt a key out, add it to `*no-repeat-keys*`."
  (and (or (string? input) (keyword? input))
    (not (includes? *no-repeat-keys* input))))

(defn- ed-base-key
  (k)
  "The modifier-stripped base of key `k` — `:ctrl-n`/`:alt-n` → \"n\", a printable key →
itself, any other keyword → its name. Lets a release match the held key regardless of
whether the modifier or the key itself came up first (`C-n` held, then either `n` or
`C-n` released → same base \"n\")."
  (cond
    (string? k) k
    (keyword? k)
      (let (n (name k))
        (cond
          (string/starts-with? n "ctrl-") (string/substring n 5 (string/length n))
          (string/starts-with? n "alt-") (string/substring n 4 (string/length n))
          else n))
    else (pr-str k)))

(defn- ed-minibuffer-nav?
  (m input)
  "True if a Vertico-style minibuffer (`:accept-selection`) is open and `input` is a
selection-move key (↓/↑/C-n/C-p) — so holding it scrolls the candidate list, the same
delay-then-repeat as holding a motion key in a buffer."
  (let (mb (:minibuffer m))
    (and mb
      (:accept-selection mb)
      (includes? [:up :down :ctrl-n :ctrl-p] input))))

(defn- ed-repeatable?
  (m input)
  "Whether, after dispatching `input`, key-repeat should be armed: `input` is a
repeatable key, it landed in the plain editing context (no prefix chord mid-flight) and
either no transient overlay is open or it's the minibuffer candidate list being scrolled
(`ed-minibuffer-nav?`), and this frontend can *stop* a hold — either it reports key
releases (`:gui-keys`) or it's a GUI window we can poll (`:window`, via `ed-still-held?`
on `gui-held-key`). Gating on `:window` lets repeat engage from the very first keystroke
(before any release has been seen), while the terminal — no `:window`, no `:gui-keys`,
and its own OS repeat — never engages. Re-checked each repeat, so a key whose context
changed stops cleanly."
  (and (or (:gui-keys m) (:window m))
    (ed-repeat-key? input)
    (nil? (:pending m))
    (or (nil? (overlay-active ed-transient-handlers m))
      (ed-minibuffer-nav? m input))))

(defn- ed-repeat-clear
  (m)
  "Stop any in-progress key repeat: drop `:held-key` and remove the `:key-repeat` timer."
  (ed-drop-timer (dissoc m :held-key) :key-repeat))

(defn- ed-still-held?
  (m)
  "Confirm the held key is *still physically down* by polling the GUI's source of
truth (`gui-held-key` on the window) before a repeat tick fires — so a missed key-up
(e.g. one lost when focus changed) can't sustain runaway repeat: the next tick polls,
sees it's no longer held, and stops. With no window to poll (terminal / tests) it
returns true and we fall back to the `:key-up`/`:blur` events (and the terminal's own
repeat); a poll error (a non-GUI runtime) likewise falls back. This is the games-engine
pattern — re-read the device state each frame rather than trust accumulated edges."
  (let (w (:window m))
    (if (nil? w)
      true
      (try (= (gui-held-key w) (:held-key m)) (catch e true)))))

(defn- ed-arm-repeat
  (m input spec)
  "After dispatching `input`, arm repeat if it's a repeatable key still in the plain
editing context — hold it and set the `:key-repeat` timer to `spec` (`{:after delay}` on
a fresh press, `{:every rate}` once repeating — ADR-102); otherwise stop any repeat."
  (if (ed-repeatable? m input)
    (ed-set-timer (assoc m :held-key input) :key-repeat spec)
    (ed-repeat-clear m)))

(defn ed-repeat-key-step (m input textrows textcols spec)
  "Route one key through normal dispatch, re-clamp scroll (vertical + horizontal so a long
line follows point), then (re)arm the `:key-repeat` timer at `spec`. The shared core of a
fresh keystroke (`spec` = `{:after delay}`) and a held-key repeat fire (`spec` =
`{:every rate}`).

A key that **completes a chord** (a prefix was pending before it dispatched — e.g. the
`C-o` of `C-x C-o`, or the `o` of `C-x o`) does NOT arm hold-repeat: re-issuing it would
run the *bare* key (insert `o`, plain open-line), not the chord, since the prefix is
already consumed. This matches Emacs, where OS auto-repeat only repeats the last physical
key, so chords never hold-repeat — repeating a command is `C-x z` / `repeat-mode` instead."
  (let (chord? (:pending m) ; this key is mid-/completing a prefix chord
        ;; The mode `:post-key` guards run HERE, so every key that edits is guarded on the
        ;; one shared step — the fresh press AND each held-key repeat. A held key repeats
        ;; down the timer path (`ed-timer-fire` → here), which used to skip the guard
        ;; entirely: holding backspace to clear a tutorial box then ate straight through the
        ;; ╭─ border into the read-only prose (and past a bshell prompt), because only the
        ;; fresh-press call site wrapped the guard. Guarding in the shared step makes that
        ;; bypass structurally impossible. Before scroll so a veto's restored point is what
        ;; the viewport clamps to.
        guarded (ed-post-key-guards m (ed-route-transient m input) input)
        stepped (ed-scroll-horizontal (ed-scroll guarded textrows) textcols))
    (if chord?
      (ed-repeat-clear stepped)
      (ed-arm-repeat stepped input spec))))

;; ---- named timers (ADR-102): firing the model's declared `:timers` -------------
;; `ed-update` routes a `[:timer name]` firing here. The arming side (which timers are
;; present) lives in `model/ed-sync-timers`; this is the dispatch for what each does when
;; it fires. Note `[:timer …]` is a vector, so its arm must precede `ed-system-event?`
;; (else it'd fall through to key dispatch); `ed-macro-record` already skips vectors.

(defn- ed-timer-event?
  (input)
  "True if `input` is a named-timer firing — a `[:timer name]` vector (ADR-102)."
  (and (vector? input) (= (first input) :timer)))

(defn- ed-timer-fire
  (m name textrows textcols cols rows)
  "Service the fired timer `name`: `:key-repeat` re-issues the held key at the repeat rate
(confirming it's still physically down first, so a missed key-up can't run away);
`:idle-recompute` runs the debounced eldoc cache + diagnostics check; `:which-key` reveals
the prefix panel; `:undo-pause` closes the typing run (next edit starts a fresh undo
group); `:cursor-blink` toggles the caret. An unknown name is a no-op."
  (cond
    (= name :key-repeat)
      (cond
        (nil? (:held-key m)) (ed-drop-timer m :key-repeat)
        (ed-still-held? m)
          (ed-repeat-key-step m
            (:held-key m)
            textrows
            textcols
            ;; :idle? — see the fresh-press arm in
            ;; ed-update for why both specs carry it
            {:every (ed-repeat-rate m) :idle? true})
        else (ed-repeat-clear m))
    ;; the idle debounce: eldoc + diagnostics + a large completion source's candidate re-rank,
    ;; plus the off-the-loop diff-hl launch and the debounced web-mirror push — all the work
    ;; too costly for the per-key path, run once activity settles.
    (= name :idle-recompute)
      (let (m1 (if (bound? 'git/git-cache-status)
                 (git/git-cache-status (ed-launch-gitdiff (ed-cache-mb-candidates (ed-run-diag (ed-launch-eldoc m)))))
                 (ed-launch-gitdiff (ed-cache-mb-candidates (ed-run-diag (ed-launch-eldoc m)))))
            m2 (ed-auto-save! m1))
        (if (and (ed-web-dirty? m2) (bound? 'web/web-publish!))
          (web/web-publish! (dissoc m2 :web-dirty))
          m2))
    (= name :which-key) (ed-which-key-reveal m)
    (= name :undo-pause) (ed-break-undo-run m)
    ;; the tutorial's eval-on-type: typing in *Tutorial* settled — re-evaluate the
    ;; lesson's playgrounds in the sandbox (tutor is deferred-loaded: bound?-guarded
    ;; + late-bound, the keymap idiom)
    (= name :tutor-eval) (if (bound? 'tutor/ed-tutor-launch)
                           ((eval 'tutor/ed-tutor-launch) m)
                           m)
    ;; The blink tick fires reliably whenever the editor is idle — it is NOT gated by the
    ;; held-key state the way `:idle-recompute` is — so we also refresh the diff-hl gutter
    ;; here. `ed-launch-gitdiff` is a no-op unless the buffer changed since its last diff, so
    ;; this recomputes once after an edit settles and then idles. This is the reliable path:
    ;; if a missed key-up leaves `:held-key` stuck, the idle beat is suppressed and the gutter
    ;; would otherwise freeze; the blink keeps it current.
    (= name :cursor-blink)
      (collab-decay-tags (ed-launch-gitdiff (assoc m :blink-on? (not (:blink-on? m)))))
    ;; The overlay scrollbar fade: tick the visibility budget down; dragging refreshes
    ;; it (pin the thumb), and hitting zero hides the thumb and stops the timer so the
    ;; editor idles again (no wakeups at rest).
    (= name :scrollbar-fade)
      (if (:sb-drag m)
        (assoc m :sb-fade (+ *scrollbar-hold-ticks* *scrollbar-fade-ticks*))
        (let (budget (dec (or (:sb-fade m) 0)))
          (if (<= budget 0)
            (ed-drop-timer (assoc m :sb-fade 0) :scrollbar-fade)
            (assoc m :sb-fade budget))))
    else m))

;; ---- inbound system / async events (the loop's event bus) -------------------
;; Besides keys, the ui-run loop receives async messages on its mailbox. An event the
;; editor PRODUCES ITSELF is a record implementing model's `UiEvent` ability — the
;; producer module defines the record + impl and just sends it; `ed-update` folds any
;; such record via `ui-event-fold`, so a new async producer (an LSP client, a
;; file-watcher, a buffer-process stream) registers an impl rather than editing the
;; loop or this file. What remains BELOW is the residual `[:tag …]` vector registry,
;; for events whose producer we don't own: redirected output (`:io/write` — std/io /
;; std/log), a spawned eval's reply (`:task-done` / `:task-error` / `:task-timeout`,
;; std/task), the frontend's `:resize` / `:mouse` / `:key-up`, the runtime's `:down`,
;; std's `:buffer-updated` / `:client-opts`, and the lsp reply tags (vectors because
;; completion's bounded wait selectively receives `[:lsp-completion ^corr …]`). Each
;; handler does its own scroll-clamp (output/eval don't move point; resize/mouse do).

(defn- ed-ev-io-write
  (m input textrows cols rows)
  "Redirected output (`[:io/write s]`) → *Messages* + the echo area (the default
output sink: eval stdout, the uncategorised logger backend)."
  (message m (string/trimr (nth input 1))))

(defn- ed-ev-task-reply
  (m input textrows cols rows)
  "A spawned task's reply (`:task-done` / `:task-error` / `:task-timeout`): route by which
in-flight handle it matches. The async diagnostics check (`:diag-proc`) folds its result
into the `:diagnostics` cache; the async eldoc compute (`:eldoc-proc`) caches its hint;
the C-x C-e eval (`:eval-proc`) shows its message in the echo area; the async diff-hl gutter
(`:gitdiff-proc`) folds its `{line -> status}` map onto the buffer it diffed. A handle matching
none is a stale/cancelled reply and is dropped, so it can't clobber a newer one."
  (let (h (nth input 1))
    (cond
      (= (:diag-proc m) h) (ed-apply-diag m (if (= (first input) :task-done) (nth input 2) '()))
      (= (:gitdiff-proc m) h)
        (ed-apply-gitdiff m (if (= (first input) :task-done) (nth input 2) '()))
      (= (:eldoc-proc m) h) (ed-apply-eldoc m (if (= (first input) :task-done) (nth input 2) nil))
      (= (:eval-proc m) h)
        (message (dissoc m :eval-proc)
          (if (= (first input) :task-timeout)
            (str "eval timed out after " *eval-timeout-ms* "ms")
            (nth input 2)))
      :else m)))

(defn- ed-ev-resize
  (m input textrows cols rows)
  "A `[:resize cols rows]`: re-clamp the scroll (vertical + horizontal) to the new viewport."
  (ed-scroll-horizontal (ed-scroll m textrows) (ed-selected-text-cols m cols rows)))

(defn- ed-mouse-on-click
  (m)
  "After a left-click moved point, run the current buffer mode's `:on-click` command (a
command symbol, resolved late like a keymap binding) — e.g. *git-status* visits the file
under the click. A no-op when the buffer's mode defines no `:on-click`."
  (let (svc (ed-mode-service (ed-current-buf m) :on-click))
    (if (nil? svc) m (svc m :mouse))))

(defn- ed-drag-release
  (m input textrows cols rows row col)
  "End a left press over the text: a real drag-selection copies its region to the kill
ring + OS clipboard (Emacs `mouse-drag-copy-region`, in ANY buffer, keeping the region
highlighted); a plain CLICK (no region) runs the buffer mode's `:on-click` — so a
results-buffer row (`*Tests*` / `*git-status*` / `*Occur*` / `*compile*`) navigates to
its source ON CLICK, while a press-and-drag in the SAME buffer selects text instead.
That click-vs-drag split is what makes a results buffer's output highlightable/copyable
rather than every press being swallowed as a link jump.

A navigate then re-clamps the (now-selected) SOURCE pane so the visited line is actually
brought on screen — `ed-pop-to-file` only moves point and relies on this clamp, and unlike
the key path (RET) a mouse release returns straight out of here, so without it a click set
point but never scrolled the target into view. The copy path scrolls nothing (the region
stays put)."
  (let (folded (ed-mouse m input cols rows))
    ; ends the drag; the region (mark↔point) survives
    (if (nil? (buffer-region (ed-current-buf folded)))
      (let (navigated (ed-mouse-on-click folded))
        ; a plain click — navigate via :on-click (if any)
        (ed-scroll-horizontal (ed-scroll navigated textrows)
          (ed-selected-text-cols navigated cols rows)))
      (ed-drag-copy folded)))) ; a real region — copy it, leaving it selected
(defn- ed-menu-mouse-press
  (m cols rows row col)
  "A press while the context menu is open: hit-test via the view's widget zones
(`view/ed-menu-hit`) and drive the pure model op — run the enabled item, stay open on a
divider/disabled/padding click (`:inside`), dismiss on a click outside."
  (let (hit (ed-menu-hit m cols rows col row))
    ; view/ed-menu-hit — [:run i] | :inside | nil
    (cond
      (and (vector? hit) (= (first hit) :run)) (ed-menu-activate m (second hit))
      (= hit :inside) m
      else (ed-close-menu m))))

(defn- ed-menu-mouse-hover
  (m cols rows row col)
  "Pointer moved over the open menu: select the enabled item under it (standard dropdown
hover), else leave the selection put."
  (let (hit (ed-menu-hit m cols rows col row))
    (if (and (vector? hit) (= (first hit) :run)) (ed-menu-select m (second hit)) m)))

(defn- ed-ev-mouse
  (m input textrows cols rows)
  "A `[:mouse …]`: fold it via `ed-mouse`. A wheel notch scrolls/zooms the hovered pane,
and a scrollbar grab/drag/release moves the viewport directly — both leave point alone,
so they bypass the selected-pane point-clamp (`:sb-drag` spans the grab, so its press,
drags, and the release that clears it all skip the clamp); every other mouse action
re-clamps so a moved point stays on screen. A **right-press** opens the Copy/Cut/Paste
context menu at the pointer (`ed-open-menu`, point/region untouched); while a menu is open
it owns clicks — a press runs/hovers the item under it or dismisses it (`ed-menu-mouse-*`
over the view widget's zones)."
  (let (action (nth input 1) button (nth input 2) row (nth input 3) col (nth input 4))
    (cond
      ;; Bare hover (no button) folds into `:hover` for the status bar (the renderer draws the
      ;; hover pill + tooltip) — but must NOT re-clamp scroll: moving the mouse while you've
      ;; wheel-scrolled away from point would otherwise snap the view back to the cursor (the
      ;; GUI emits a :move per cell crossed).
      ;; An open context menu owns the mouse (modal): a press runs/dismisses, a move
      ;; hovers-to-select like a standard dropdown, everything else is swallowed. Checked
      ;; before the bare-move hover so the menu, not the status bar, gets the motion.
      (:menu m)
        (cond
          (= action :press) (ed-menu-mouse-press m cols rows row col)
          (= action :move) (ed-menu-mouse-hover m cols rows row col)
          else m)
      (= action :move) (ed-link-hover (ed-modeline-hover m cols rows col row) cols rows col row)
      (and (= action :press) (= button :right)) (ed-open-menu m row col)
      ;; Releasing a left press: a real drag-selection copies its region; a plain click
      ;; runs the row's `:on-click` (a results buffer navigates to its source ON CLICK).
      ;; Navigation is here on RELEASE, not on press, so a press begins a drag-select
      ;; instead of being swallowed as a link jump — that's what lets you highlight and
      ;; copy text in *Tests* / *git-status* / *Occur* / *compile*.
      (and (= action :release) (:text-drag m)) (ed-drag-release m input textrows cols rows row col)
      ;; A left-press on a clickable status-bar segment (the branch / git indicator) runs its
      ;; command instead of the normal press handling — so it opens *git-status*, not moves
      ;; point. `ed-modeline-click` is nil unless a segment with an `:on-click` is under it.
      :else
        (let (mclick (if (and (= action :press) (= button :left))
                       (ed-modeline-click m cols rows col row)
                       nil))
          (if mclick
            mclick
            (let (folded (ed-mouse m input cols rows))
              ;; NB: a results row's `:on-click` navigation fires on the click's RELEASE
              ;; (ed-drag-release), NOT here on press — so the press can begin a
              ;; drag-select rather than steal it as a link click.
              (if (or (= action :scroll-up)
                    (= action :scroll-down)
                    (:sb-drag m)
                    (:sb-drag folded))
                folded
                (ed-scroll-horizontal (ed-scroll folded textrows)
                  (ed-selected-text-cols folded cols rows)))))))))

(defn- ed-ev-buffer-updated
  (m input textrows cols rows)
  "A shared buffer process's push (`[:buffer-updated proc version text]`, from
`subscribe-buffer` — see `src/collab.blsp`): fold the new content into the pool slot
linked to `proc`, leaving every pane's window-local point alone (cursors stay
independent). Stale versions and pushes for an unlinked process are ignored inside
`ed-apply-buffer-update`. While FOLLOWING a participant, point then rides their caret
(`collab-follow-jump` — the one point-move here, scroll-clamped). Otherwise no scroll
clamp: content changed under the view, point didn't move — the render clamps points
into the new text."
  (collab-follow-jump (ed-apply-buffer-update m
                        (nth input 1)
                        (nth input 2)
                        (nth input 3)
                        (nth input 4 nil))
    textrows))

(defn- ed-ev-down
  (m input textrows cols rows)
  "A monitored process died (`[:down ref pid reason]` — `ed-host-slot` monitors every
hosted buffer process). If `pid` backs a pool slot, recover it: a SHARED slot re-asks
the registry (which respawns died buffers from its text mirror) or falls back to a
local host — `collab-reshare`; a local slot respawns from the pool cache —
`hosted-rehost`. The per-buffer fault boundary: one crashed buffer process costs at
most its in-flight splices, never the editor. A pid backing nothing (some other
monitor's corpse) is ignored."
  (let (pid (nth input 2)
        i (hosted-slot-for-proc m pid))
    (cond
      (nil? i) m
      (get-in m [:hosted i :shared?]) (collab-reshare m i)
      :else (hosted-rehost m i))))

(defn- ed-ev-client-opts
  (m input textrows cols rows)
  "The attach identity (`[:client-opts {:name …}]`, queued by a serve session before any
key — std/editor/serve): record the participant name and announce it on every shared
buffer process, so collab presence (name tags, join/leave echoes) shows who this is.
A nil/empty name is ignored."
  (collab-set-name m (:name (nth input 1))))

(defn- ed-ev-key-up
  (m input textrows cols rows)
  "A `[:key-up k]` (GUI only — the terminal frontend sends no releases): note that
this frontend reports releases (`:gui-keys`, which gates held-key repeat so a
release-less terminal never engages it), and if `k` ends the held key (matched
modifier-insensitively, so releasing the modifier or the key first both count), stop
the repeat. Other releases just keep the flag set."
  (let (m1 (assoc m :gui-keys true)
        held (:held-key m))
    (if (and held (= (ed-base-key (nth input 1)) (ed-base-key held)))
      (ed-repeat-clear m1)
      m1)))

(def- ed-event-handlers
  ;; `[:tag …]` -> the handler's SYMBOL, resolved at dispatch (`(eval …)`, below) — the
  ;; same late binding keys get: redefine a handler in the running editor and the next
  ;; event of that tag uses it, with no reload. Function *values* here would freeze the
  ;; async half of the loop at module-load time while the key half stayed hot-swappable
  ;; (and would hide every handler from `nest test --cover`, whose instrumentation
  ;; rebinds the global that a captured value has already bypassed).
  {:io/write 'input/ed-ev-io-write
   :key-up 'input/ed-ev-key-up
   :task-done 'input/ed-ev-task-reply
   :task-error 'input/ed-ev-task-reply
   :task-timeout 'input/ed-ev-task-reply
   :resize 'input/ed-ev-resize
   :mouse 'input/ed-ev-mouse
   :buffer-updated 'input/ed-ev-buffer-updated
   :down 'input/ed-ev-down
   :client-opts 'input/ed-ev-client-opts
   ;; async LSP replies (corr-matched against :lsp-pending; stale ones drop) — the
   ;; navigation/edit commands fire and forget, the answer folds here on arrival
   :lsp-definition 'commands/ed-ev-lsp-reply
   :lsp-references 'commands/ed-ev-lsp-reply
   :lsp-hover 'commands/ed-ev-lsp-reply
   :lsp-symbols 'commands/ed-ev-lsp-reply
   :lsp-text-edits 'commands/ed-ev-lsp-reply
   :lsp-workspace-edit 'commands/ed-ev-lsp-reply
   :lsp-completion 'commands/ed-ev-lsp-reply}) ; only ever stale here (completion's bounded wait consumes live ones)
(defn ed-system-event? (input)
  "Whether `input` is an inbound `[:tag …]` event with a registered handler."
  (and (vector? input) (contains? ed-event-handlers (first input))))

;; ---- the ui-run update ------------------------------------------------------

(defn- ed-macro-record
  (m input)
  "While a keyboard macro is recording (`:macro-recording` is a vector), append the raw key
`input` to it — skipping ticks, focus events, inbound `[:tag …]` system events AND
`UiEvent` records (only real keystrokes belong in a macro; a replayed async event
would re-append phantom report lines and resurrect dead pids). The C-x ) that ends
recording is captured too and trimmed by `cmd-end-kbd-macro`."
  (if (and (vector? (:macro-recording m))
        (not (= input :tick))
        (not (= input :blur))
        (not (vector? input))
        (not (record? input)))
    (assoc m :macro-recording (into (:macro-recording m) (list input))) ; keep it a vector
    m))

(defn- ed-point-into-view
  (m textrows)
  "If the selected pane's point has scrolled off-screen — the user wheeled or dragged the
view away from the cursor — move point to the nearest visible line (keeping its column), so
the next keystroke continues from what's on screen rather than snapping the whole view back
to the off-screen cursor (which, with point near the top, reads as 'jumping to the top').
A no-op when point is already visible, so normal editing is untouched."
  (let (buf (ed-current-buf m)
        top (ed-current-top m)
        cl (buffer-current-line buf)
        bot (+ top (dec textrows)))
    (if (and (>= cl top) (<= cl bot))
      m
      (ed-set-buf m (forward-line buf (- (max top (min bot cl)) cl))))))

(defn ed-update (m input cols rows)
  "ui-run update: fold one key into the next model, then keep point on screen.
`:tick` re-issues the currently held key (consumer-paced key repeat — see the key-repeat
section) when one is held, else a no-op (leaving a pending prefix / open minibuffer intact); a
`[:resize cols rows]` event just re-clamps the scroll to the new viewport and lets
the loop re-render (it isn't a command, so it doesn't touch the keymap or echo); a
`[:mouse …]` event is handled by `ed-mouse` (left-click selects the window under it,
a press on a divider begins a drag, `:drag` resizes it, `:release` ends it). Scroll
clamping uses the *selected pane's* height (`ed-selected-text-rows`), so it's correct
inside a split. Any non-system input is a key, routed by `ed-route-transient`: to the
open transient overlay (minibuffer / completion / isearch / query-replace) if one
owns it, else through the keymap (`ed-dispatch`)."
  (let ([textrows textcols] (ed-viewport m cols rows)
        ; both pane dimensions in one layout call
        m0 (ed-macro-record (assoc m :view-rows textrows :view-cols textcols) input))
    ; capture the key if recording
    ; so page commands know the viewport
    ;; A thrown error — from a command, the minibuffer, completion, or a re-check —
    ;; surfaces in the echo area and the editor keeps running: a crash must never take
    ;; down the whole editor (ui-run would otherwise restore the screen and re-raise,
    ;; exiting). The model `m0` (pre-dispatch) is kept so editing can continue.
    (let (result (try
                   ;; After folding the event in, `ed-post-step` schedules the debounced eldoc +
                   ;; diagnostics check (off the per-key path — see model.blsp); `ed-refresh-spans`
                   ;; refreshes the fontify span cache for the new viewport (a no-op when nothing
                   ;; scrolled or changed — see panes.blsp), so the pure `view` re-lexes nothing on
                   ;; Note: the diff-hl git annotation and the web-mirror snapshot push are NOT done
                   ;; here on the per-event path — both can be slow (a full-file diff; a fontify), and
                   ;; doing them per keystroke once wedged the whole loop on a large file. They run
                   ;; debounced on the idle beat instead (`ed-timer-fire :idle-recompute`).
                   (let (result (ed-refresh-spans
                                  (ed-post-step
                                    (cond
                                      ;; a named timer fired (ADR-102): key-repeat / debounce / which-key / undo /
                                      ;; blink. Must precede `ed-system-event?` — `[:timer …]` is a vector but isn't
                                      ;; in the event-handler registry, so it'd otherwise fall through to key dispatch.
                                      (ed-timer-event? input)
                                        (ed-timer-fire m0
                                          (nth input 1)
                                          textrows
                                          textcols
                                          cols
                                          rows)
                                      ;; a bare `:tick` (only reachable via a legacy `:tick-ms` model — not ours):
                                      ;; nothing to do, leave any pending prefix / open overlay intact.
                                      (= input :tick) m0
                                      ;; the window lost focus (`:blur`): the key-up may now never arrive (the
                                      ;; release lands in another window), so stop any repeat now — the safety net
                                      ;; for a missed key-up.
                                      (= input :blur) (ed-repeat-clear m0)
                                      ;; an app-produced async event record → it folds itself in
                                      ;; (`UiEvent`, see model.blsp — no handler table to consult).
                                      (ui-event? input) (ui-event-fold input m0 textrows cols rows)
                                      ;; an inbound async/system event (`[:tag …]`) → its registered handler.
                                      ;; A MOUSE gesture can edit the buffer (context-menu Paste/Cut, a
                                      ;; drag-kill), so the buffer's `:post-key` guards apply to it exactly
                                      ;; as to a key — without this, a right-click Paste bypassed the
                                      ;; tutorial's prose protection. Other system events (task replies,
                                      ;; subprocess lines) never edit interactively and skip the guards.
                                      (ed-system-event? input)
                                        (let (folded ((eval (get ed-event-handlers (first input))) m0
                                                       input textrows cols rows))
                                          (if (= (first input) :mouse)
                                            (ed-post-key-guards m0 folded input)
                                            folded))
                                      ;; otherwise a key: for a plain cursor-movement key, first pull point
                                      ;; back into view if the user scrolled it off-screen (so the move resumes
                                      ;; from what's visible instead of snapping the view to the off-screen
                                      ;; cursor) — skipped while a transient overlay owns input, and NOT for other
                                      ;; commands (recenter/goto/search act on the real point). Then route through
                                      ;; the keymap and arm held-key repeat if it's repeatable, and let the
                                      ;; buffer's mode `:post-key` guards veto/repair what the key did (bshell's
                                      ;; prompt boundary, the tutorial's read-only prose — layers §7).
                                      ;; The repeat delay is `:idle? true` — it counts from the LAST
                                      ;; real input, not from when the timer first appeared. During
                                      ;; rollover typing (press b while a is still down) the timer
                                      ;; NAME never leaves `:timers`, so a plain `{:after …}` stayed
                                      ;; anchored to the burst's FIRST key: the delay budget eroded
                                      ;; to nothing mid-burst and the current key machine-gunned at
                                      ;; the repeat rate. Idle anchoring = true typematic: repeat
                                      ;; starts `delay` after the newest press, whatever came before.
                                      ;; the `:post-key` guards now ride `ed-repeat-key-step`
                                      ;; itself (so the held-repeat timer path gets them too),
                                      ;; hence no wrapper here.
                                      else
                                        (ed-repeat-key-step (if (and (includes? *view-resume-keys* input)
                                                                  (nil? (overlay-active ed-transient-handlers
                                                                          m0)))
                                                              (ed-point-into-view m0 textrows)
                                                              m0)
                                          input
                                          textrows
                                          textcols
                                          {:after (ed-repeat-delay m0) :idle? true}))
                                    input)
                                  cols
                                  rows))
                     ;; C-x e (cmd-execute-kbd-macro) set `:run-macro`: replay the recorded macro by
                     ;; re-feeding its events through `ed-update` (recording is off, so they aren't
                     ;; re-captured). Done here, where cols/rows are in scope. The replayed calls
                     ;; each run their OWN collab chain, so the replay path must NOT be wrapped in
                     ;; another `collab-step` — the outer propagate would diff the pre-replay model
                     ;; against the final one and send the macro's whole change a SECOND time.
                     (if (:run-macro result)
                       (fold (fn (mm ev) (ed-update mm ev cols rows))
                         (dissoc result :run-macro)
                         (or (:macro-last result) '()))
                       ;; the hosted content propagate (`hosted-step` — ships this event's edits to
                       ;; every process-backed slot, shared or purely local), then the collab
                       ;; presence chain (`collab-step` — auto-share / follow / presence sync).
                       ;; Each is a map-lookup no-op on a model with nothing hosted, which is what
                       ;; lets `share-session` turn a LIVE editor into a host without swapping
                       ;; update fns
                       (collab-step m0 (hosted-step m0 result input) input)))
                   ;; the error echo appends to *Messages*, which is HOSTED under the flip — the
                   ;; append must still propagate or the pool cache silently diverges from the
                   ;; *Messages* process (its own guarded try: a propagate error here must not
                   ;; recurse into another echo)
                   (catch e
                     ;; A read-only span refusing an edit is not an error to surface as one:
                     ;; `ed-edit` already turns the common path into the buffer's hint, and this
                     ;; is the SAFETY NET for any command that edits some other way — a
                     ;; `:kind :read-only` throw (std/editor/buffer) degrades to the same hint,
                     ;; never a raw `error:`. The pre-event model `m0` stands (the edit is undone
                     ;; by being abandoned — the buffer is immutable).
                     (let (me (if (and (map? e) (= (:kind e) :read-only))
                                (message m0
                                  (or (ed-mode-service (ed-current-buf m0) :read-only-hint)
                                    "read-only text here"))
                                (message m0 (str "error: " (error-message e)))))
                       (try (hosted-step m0 me input) (catch e2 me)))))
          ;; Update the OS title bar from the result model every event (cheap: a string set).
          win (:window result)
          title (ed-window-title result))
      (do
        (when (and win (not (= title (:window-title result))))
          (try (gui-title! win title) (catch e nil)))
        (assoc result :window-title title)))))
