(defmodule input
  "The editor's input layer: fold one key event into the next model.

Dispatch goes through **layers** (`std/layers.blsp`): the active buffer carries
`:layers` (its mode — `text-mode` by default, see `modes`), and `active-keymap`
composes them into one keymap. `keymap-step` then runs one (possibly chorded)
keystroke through it, threading the prefix-`:pending` state — so the chord state
machine (prefix entry, mid-chord resolution, dead-end reset, self-insert fallback)
lives in the language toolkit, not here (the prime directive — see CLAUDE.md). The
bindings are data, declared per-mode in `modes`; this module only resolves the
active keymap, renders the echo-area label for a prefix / undefined chord, and
gates the minibuffer. Keys map to fully-qualified command **symbols** resolved
with `(eval sym)` at dispatch time, so redefining a command (or rebinding a key)
hot-swaps behaviour on the next keystroke (late binding, the path to a
self-editing editor)."
  (:use buffer)
  (:use model)  ; ed-scroll, message, the minibuffer field, current-buffer accessors
  (:use panes)  ; ed-selected-text-rows (split-aware viewport) + ed-mouse (event folding)
  (:use commands)  ; the self-insert fallback
  (:use complete)  ; the completion popup (Tab) + its modal key handling
  (:use isearch)  ; the modal incremental-search / query-replace mini-loops
  (:use keymap)  ; keymap-step — the std chord dispatcher
  (:use layers))  ; active-keymap (compose a buffer's layers) + init-buffer-layers

;; Loading `modes` defines the layers and registers the default (text-mode); the
;; bindings live there, as data, not here.
(require 'modes)
(require 'lineedit)  ; the minibuffer drives lineedit's pure one-line editor core

;; ---- the active keymap comes from the buffer's layers -----------------------

(defn ed--ensure-layers (m)
  "Make sure the current buffer carries its mode layers, seeding them from its
type (filename / `:type` → `text-mode` by default) on first use. Buffers created
anywhere in the editor get their mode here, lazily, so dispatch always has a
keymap and a `.blsp` buffer can later resolve to a richer mode automatically."
  (let (b (ed-current-buf m))
    (if (nil? (get b :layers)) (ed-set-buf m (init-buffer-layers b)) m)))

;; ---- key labels (for the echo area) -----------------------------------------

(defn key-label (k)
  "A human label for key `k`: \"C-x\" for :ctrl-x, \"M-f\" for :alt-f, the keyword
name otherwise, the string itself for a printable key."
  (cond
    (string? k) k
    (keyword? k) (let (n (name k))
                   (cond
                     (starts-with? n "ctrl-") (str "C-" (substring n 5 (string-length n)))
                     (starts-with? n "alt-") (str "M-" (substring n 4 (string-length n)))
                     else n))
    else (pr-str k)))

;; ---- dispatch (the chord state machine is keymap-step; echo policy is ours) --

(defn ed--self-insert (m key)
  "The keymap fallback: a printable key self-inserts; any other unbound key is a
no-op (so a stray :f5 / :page-up never tries to insert a keyword)."
  (if (string? key) (cmd-self-insert m key) m))

;; ---- prefix arguments (C-u N) -----------------------------------------------
;; `:prefix-arg` is `{:count N :raw bool}` while a numeric argument is being built:
;; C-u seeds 4 (`:raw` — not yet explicit digits); a further C-u multiplies by 4; a
;; digit switches to explicit accumulation. The next *complete* command runs `:count`
;; times (the common-case Emacs mechanism; per-command interactive specs are the
;; deferred std/layers improvement). `cmd-set-mark` reads the arg itself (C-u C-SPC →
;; pop-mark) and so is listed in `ed--prefix-consuming` to run once, not repeat.

(def ed--prefix-consuming '(commands/cmd-set-mark))

(defn ed--digit? (input)
  "True if `input` is a single decimal-digit key."
  (and (string? input) (= (string-length input) 1) (>= (index-of "0123456789" input) 0)))

(defn ed--prefix-continues? (input)
  "Keys that extend a pending prefix arg rather than ending it: another C-u or a digit."
  (or (= input :ctrl-u) (ed--digit? input)))

(defn ed--prefix-read (m input)
  "Fold a C-u / digit into the active prefix-arg accumulator."
  (let (pa (get m :prefix-arg))
    (cond
      (= input :ctrl-u) (assoc m :prefix-arg {:count (* 4 (get pa :count)) :raw true})
      else (let (d (string->number input))
             (assoc m :prefix-arg
               (if (get pa :raw) {:count d :raw false} {:count (+ (* 10 (get pa :count)) d) :raw false}))))))

(defn ed--dispatch-key (m input)
  "Resolve and run `input` through the active keymap (the chord work is `keymap-step`),
repeating the command `:prefix-arg` times when one is set. A prefix key mid-chord just
steps (the prefix arg carries until the chord completes); a prefix-consuming command
(set-mark) runs once and reads the arg itself."
  (let (km
         (active-keymap (ed-current-buf m))
         binding
         (get (or (get m :pending) km) input)
         ;; the command keymap-step will run: a symbol when bound, :self-insert when
         ;; unbound (the fallback), nil for a prefix key (mid-chord — no command).
         this-cmd
         (cond (map? binding) nil (nil? binding) :self-insert :else binding)
         pa
         (get m :prefix-arg)
         n
         (if (nil? pa) 1 (get pa :count))  ; an explicit C-u 0 runs the command zero times
         ;; record this/last command (the Emacs mechanism) so kills coalesce and
         ;; M-y yank-pop knows it follows a yank; a prefix key leaves them untouched.
         m1
         (if (nil? this-cmd) m (assoc m :last-command (get m :this-command) :this-command this-cmd))
         ;; one keymap step (resolve through :pending / the keymap, threading :pending)
         step
         (fn (mm)
           (let ([m2 p2] (keymap-step km (get mm :pending) (assoc mm :echo "") input ed--self-insert))
             (assoc m2 :pending p2)))
         result
         (cond
           ;; a prefix key mid-chord: step, keep the prefix arg for the resolving key
           (nil? this-cmd) (step m1)
           ;; a command that consumes the arg itself (set-mark → pop-mark): run once
           (and pa (includes? ed--prefix-consuming this-cmd)) (dissoc (step m1) :prefix-arg)
           ;; a normal command under a prefix arg: run it N times (set last-command on
           ;; the repeats so consecutive kills/inserts coalesce), then clear the arg
           pa (dissoc (fold (fn (mm i) (step (if (= i 0) mm (assoc mm :last-command this-cmd))))
                        m1 (range n))
                :prefix-arg)
           else (step m1)))
    (cond
      (map? binding) (assoc result :echo (str (key-label input) "-"))
      (and (nil? binding) (get m :pending)) (assoc result :echo (str (key-label input) " is undefined"))
      else result)))

(defn ed-dispatch (m0 input)
  "Fold one key `input` into the next model. While a numeric prefix argument is being
built (`:prefix-arg` set and `input` a C-u/digit), accumulate it and run nothing yet;
otherwise resolve and run the key through the active keymap (`ed--dispatch-key`)."
  (let (m (ed--ensure-layers m0))
    (if (and (get m :prefix-arg) (ed--prefix-continues? input))
      (let (m2 (ed--prefix-read m input))
        (assoc m2 :echo (str "C-u " (get (get m2 :prefix-arg) :count) "-")))
      (ed--dispatch-key m input))))

;; ---- the minibuffer (modal: when active, all input is the minibuffer's) ------
;; A one-line prompt that REUSES the REPL line editor: `:minibuffer :edit` is a
;; `std/lineedit` state (the same pure core std/observer's minibuffer drives), so
;; the prompt gets emacs editing for free — C-a/C-e, C-f/C-b, M-f/M-b, C-k/C-u/C-w/
;; M-d, C-y yank, C-t, ↑/↓ history, C-r reverse-search. Keys are fed to
;; `lineedit--handle`; we intercept only **Tab** (per-prompt completion via the
;; minibuffer's `:complete-fn`, not lineedit's symbol completion) and **Esc / C-g**
;; (abort). Enter makes lineedit set `:done :submit`, and we run `:on-complete` with
;; the text; C-c (`:cancel`) closes. (The text/point/prompt accessors live in `model`.)

(defn minibuffer-handle (m input)
  "Fold one key into the active minibuffer. Tab replaces the text with the
`:complete-fn` of the input; Esc / C-g abort; every other key drives lineedit's pure
editor (`lineedit--handle`) — on `:submit` (Enter) run `:on-complete` with the text,
on `:cancel` close. Movement, kill-ring, yank, and history all come from lineedit."
  (let (mb (get m :minibuffer))
    (cond
      (= input :tab) (let (completed ((get mb :complete-fn) (mb-text mb)))
                       (assoc m
                         :minibuffer
                         (assoc mb :edit (ed-mb-set-text (get mb :edit) completed))))
      (or (= input :escape) (= input :ctrl-g)) (assoc m :minibuffer nil :echo "quit")
      else (let (edit (lineedit/lineedit--handle (get mb :edit) input)
                 done (get edit :done))
             (cond
               (= done :submit) ((get mb :on-complete) (assoc m :minibuffer nil) (get edit :text))
               (nil? done) (assoc m :minibuffer (assoc mb :edit edit))
               else (assoc m :minibuffer nil :echo "quit"))))))

;; ---- the ui-run update ------------------------------------------------------

(defn ed-update (m input cols rows)
  "ui-run update: fold one key into the next model, then keep point on screen.
`:tick` is a no-op (and leaves a pending prefix / open minibuffer intact); a
`[:resize cols rows]` event just re-clamps the scroll to the new viewport and lets
the loop re-render (it isn't a command, so it doesn't touch the keymap or echo); a
`[:mouse …]` event is handled by `ed-mouse` (left-click selects the window under it,
a press on a divider begins a drag, `:drag` resizes it, `:release` ends it). Scroll
clamping uses the *selected pane's* height (`ed-selected-text-rows`), so it's correct
inside a split. While a minibuffer is open, every key goes to it; while the completion
popup is open, its control keys (C-n/C-p/Enter/…) go to it and any other key dismisses
it and is then dispatched normally; otherwise the key is dispatched through the keymap."
  (let (textrows (ed-selected-text-rows m cols rows)
         ; selected pane height (split-aware)
         m0
         (assoc m :view-rows textrows))
    ; so page commands know the viewport
    ;; A thrown error — from a command, the minibuffer, completion, or a re-check —
    ;; surfaces in the echo area and the editor keeps running: a crash must never take
    ;; down the whole editor (ui-run would otherwise restore the screen and re-raise,
    ;; exiting). The model `m0` (pre-dispatch) is kept so editing can continue.
    (try
      ;; Refresh diagnostics after folding the key in — a no-op (cache hit on
      ;; `:diag-text`) unless the current buffer's text changed.
      (ed-refresh-diagnostics
        (cond
          (= input :tick) m0
          ;; output redirected to the editor via std/io / std/log — a `process-port`
          ;; or the logger's `process-backend` sends `[:io-write s]` to this process.
          ;; Land it in *Messages* (Emacs' message sink), trimming the trailing
          ;; newline the writer added. This is how `(log-info …)` and any
          ;; `(with-out (process-port <editor>) (println …))` reach the editor.
          (and (vector? input) (= (first input) :io-write)) (message m0 (trimr (nth input 1)))
          ;; a spawned evaluator's std/task reply — `[:task-done <handle> <msg>]` (and
          ;; `[:task-error …]`, though `eval-source` never throws), or `[:task-timeout
          ;; <handle>]`. Show it only if the handle is the current in-flight eval (so a
          ;; stale/cancelled eval's late reply can't clobber a newer one); then clear
          ;; `:eval-proc`. The handle is the `task`'s coordinator pid — see ed-eval-async.
          (and (vector? input) (or (= (first input) :task-done) (= (first input) :task-error)))
            (if (= (get m0 :eval-proc) (nth input 1))
              (message (dissoc m0 :eval-proc) (nth input 2))
              m0)
          (and (vector? input) (= (first input) :task-timeout))
            (if (= (get m0 :eval-proc) (nth input 1))
              (message (dissoc m0 :eval-proc) (str "eval timed out after " *eval-timeout-ms* "ms"))
              m0)
          (and (vector? input) (= (first input) :resize)) (ed-scroll m0 textrows)
          ;; A wheel notch scrolls/zooms the HOVERED pane (:top/:scale), so it bypasses
          ;; the selected-pane point-clamp (ed-scroll) that would snap it back to point.
          (and (vector? input) (= (first input) :mouse)) (let (mm (ed-mouse m0 input cols rows))
                                                           (if (or (= (nth input 1) :scroll-up)
                                                                 (= (nth input 1) :scroll-down))
                                                             mm
                                                             (ed-scroll mm textrows)))
          ;; an active query-replace consumes its answer keys; any other key finishes
          ;; the replace and is dispatched normally.
          (get m0 :query-replace) (if (qr-control-key? input)
                                    (ed-scroll (qr-handle m0 input) textrows)
                                    (ed-scroll (ed-dispatch (qr-finish m0) input) textrows))
          ;; an active incremental search consumes its control keys (and printable
          ;; chars, which extend it); any other key exits the search and is then
          ;; dispatched normally (Emacs isearch). Mirrors the completion popup below.
          (get m0 :isearch) (if (isearch-control-key? input)
                              (ed-scroll (isearch-handle m0 input) textrows)
                              (ed-scroll (ed-dispatch (isearch-exit m0) input) textrows))
          (get m0 :minibuffer) (ed-scroll (minibuffer-handle m0 input) textrows)
          (get m0 :completion) (if (complete-control-key? input)
                                 (ed-scroll (complete-handle m0 input) textrows)
                                 (ed-scroll (ed-dispatch (complete-cancel m0) input) textrows))
          else (ed-scroll (ed-dispatch m0 input) textrows)))
      (catch e (message m0 (str "error: " (error-message e)))))))
