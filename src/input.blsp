(defmodule input
  "The editor's input layer: fold one key event into the next model.

Dispatch is delegated to `std/keymap.blsp`: `keymap-step` runs one (possibly
chorded) keystroke through `*global-keymap*`, threading the prefix-`:pending`
state — so the chord state machine (prefix entry, mid-chord resolution, dead-end
reset, self-insert fallback) lives in the language toolkit, not here (the
prime directive — see CLAUDE.md). This module only declares the *bindings* (data,
via `keymap-bind`), renders the echo-area label for a prefix / undefined chord,
and gates the minibuffer. Keys map to fully-qualified command **symbols**
resolved with `(eval sym)` at dispatch time, so redefining a command (or
rebinding a key) hot-swaps behaviour on the next keystroke (late binding, the
path to a self-editing editor)."
  (:use buffer)
  (:use model)     ; ed-scroll, message, the minibuffer field
  (:use commands)  ; the commands the keymap names + the self-insert fallback
  (:use complete)  ; the completion popup (Tab) + its modal key handling
  (:use keymap))   ; keymap-step / keymap-bind — the std chord dispatcher

;; ---- the keymap (data: every binding declared here, none in the language) ----
;; Command values are quoted, fully-qualified symbols (`commands/…`) so `(eval
;; sym)` resolves them at dispatch regardless of namespace. Built with
;; `keymap-bind`, which nests the prefix sub-keymaps for chords like `C-x C-e`.

(def *global-keymap*
  (-> {}
      ;; movement — arrows + the Emacs C-/M- equivalents
      (keymap-bind [:left]  'commands/cmd-backward-char)
      (keymap-bind [:ctrl-b] 'commands/cmd-backward-char)
      (keymap-bind [:right] 'commands/cmd-forward-char)
      (keymap-bind [:ctrl-f] 'commands/cmd-forward-char)
      (keymap-bind [:up]    'commands/cmd-previous-line)
      (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
      (keymap-bind [:down]  'commands/cmd-next-line)
      (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
      (keymap-bind [:home]  'commands/cmd-beginning-of-line)
      (keymap-bind [:ctrl-a] 'commands/cmd-beginning-of-line)
      (keymap-bind [:end]   'commands/cmd-end-of-line)
      (keymap-bind [:ctrl-e] 'commands/cmd-end-of-line)
      (keymap-bind [:alt-f] 'commands/cmd-forward-word)
      (keymap-bind [:alt-b] 'commands/cmd-backward-word)
      (keymap-bind [(keyword "alt-<")] 'commands/cmd-beginning-of-buffer)  ; M-<
      (keymap-bind [(keyword "alt->")] 'commands/cmd-end-of-buffer)        ; M->
      ;; screenful scrolling — C-v / M-v + the PageDown / PageUp keys
      (keymap-bind [:ctrl-v]    'commands/cmd-scroll-up)
      (keymap-bind [:page-down] 'commands/cmd-scroll-up)
      (keymap-bind [:alt-v]     'commands/cmd-scroll-down)
      (keymap-bind [:page-up]   'commands/cmd-scroll-down)
      ;; completion-at-point
      (keymap-bind [:tab] 'complete/cmd-complete)
      ;; editing
      (keymap-bind [:enter]     'commands/cmd-newline)
      (keymap-bind [:backspace] 'commands/cmd-delete-backward)
      (keymap-bind [:delete]    'commands/cmd-delete-char)
      (keymap-bind [:ctrl-d]    'commands/cmd-delete-char)
      ;; undo / redo
      (keymap-bind [:ctrl-/] 'commands/cmd-undo)
      (keymap-bind [:alt-/]  'commands/cmd-redo)
      ;; region / kill ring — C-SPC arrives as the keyword named "ctrl- "
      (keymap-bind [(keyword "ctrl- ")] 'commands/cmd-set-mark)
      (keymap-bind [:ctrl-w] 'commands/cmd-kill-region)
      (keymap-bind [:alt-w]  'commands/cmd-copy-region)
      (keymap-bind [:ctrl-y] 'commands/cmd-yank)
      ;; quit — the window close button is delivered as :escape
      (keymap-bind [:escape] 'commands/cmd-quit)
      ;; the C-x prefix
      (keymap-bind [:ctrl-x :ctrl-c] 'commands/cmd-quit)
      (keymap-bind [:ctrl-x :ctrl-s] 'commands/cmd-save)
      (keymap-bind [:ctrl-x :ctrl-e] 'commands/cmd-eval-last-sexp)
      (keymap-bind [:ctrl-x :ctrl-f] 'commands/cmd-find-file)
      (keymap-bind [:ctrl-x "b"]     'commands/cmd-switch-buffer)
      (keymap-bind [:ctrl-x "k"]     'commands/cmd-kill-buffer)
      (keymap-bind [:ctrl-x "u"]     'commands/cmd-undo)
      (keymap-bind [:ctrl-x :right]  'commands/cmd-next-buffer)
      (keymap-bind [:ctrl-x :left]   'commands/cmd-previous-buffer)))

;; ---- key labels (for the echo area) -----------------------------------------

(defn key-label (k)
  "A human label for key `k`: \"C-x\" for :ctrl-x, \"M-f\" for :alt-f, the keyword
name otherwise, the string itself for a printable key."
  (cond
    (string? k) k
    (keyword? k) (let (n (name k))
                   (cond
                     (starts-with? n "ctrl-") (str "C-" (substring n 5 (string-length n)))
                     (starts-with? n "alt-")  (str "M-" (substring n 4 (string-length n)))
                     else n))
    else (pr-str k)))

;; ---- dispatch (the chord state machine is keymap-step; echo policy is ours) --

(defn ed--self-insert (m key)
  "The keymap fallback: a printable key self-inserts; any other unbound key is a
no-op (so a stray :f5 / :page-up never tries to insert a keyword)."
  (if (string? key) (cmd-self-insert m key) m))

(defn ed-dispatch (m input)
  "Fold one key `input` into the next model. `keymap-step` (std) does the chord
work — resolve through the `:pending` prefix or `*global-keymap*`, enter a prefix,
reset a dead-end, or fall back to self-insert — returning `[model' pending']`. We
add only the echo-area label: a prefix shows `\"C-x-\"`, an unbound chord
`\"… is undefined\"`, and a fresh keystroke clears it (a command then sets its own
message)."
  (let (binding (get (or (get m :pending) *global-keymap*) input)
        [m2 pending2] (keymap-step *global-keymap* (get m :pending)
                                   (assoc m :echo "") input ed--self-insert)
        m3 (assoc m2 :pending pending2))
    (cond
      (map? binding)                        (assoc m3 :echo (str (key-label input) "-"))
      (and (nil? binding) (get m :pending)) (assoc m3 :echo (str (key-label input) " is undefined"))
      else                                  m3)))

;; ---- the minibuffer (modal: when active, all input is the minibuffer's) ------

(defn mb-set-input (m s)
  "The model with the active minibuffer's typed `:input` set to `s`."
  (assoc m :minibuffer (assoc (get m :minibuffer) :input s)))

(defn minibuffer-handle (m input)
  "Fold one key into an active minibuffer prompt: Enter runs its `:on-complete`
with the typed text (and closes it); Esc / C-g abort; Backspace deletes; Tab
completes via `:complete-fn`; a printable key appends; everything else is ignored."
  (let (mb (get m :minibuffer))
    (cond
      (= input :enter) ((get mb :on-complete) (assoc m :minibuffer nil) (get mb :input))
      (or (= input :escape) (= input :ctrl-g)) (assoc m :minibuffer nil :echo "quit")
      (= input :backspace) (let (s (get mb :input) n (string-length s))
                             (mb-set-input m (if (> n 0) (substring s 0 (dec n)) s)))
      (= input :tab) (mb-set-input m ((get mb :complete-fn) (get mb :input)))
      (string? input) (mb-set-input m (str (get mb :input) input))
      else m)))

;; ---- the ui-run update ------------------------------------------------------

(defn ed-update (m input cols rows)
  "ui-run update: fold one key into the next model, then keep point on screen.
`:tick` is a no-op (and leaves a pending prefix / open minibuffer intact); a
`[:resize cols rows]` event just re-clamps the scroll to the new viewport and lets
the loop re-render (it isn't a command, so it doesn't touch the keymap or echo).
While a minibuffer is open, every key goes to it; while the completion popup is
open, its control keys (C-n/C-p/Enter/…) go to it and any other key dismisses it
and is then dispatched normally; otherwise the key is dispatched through the keymap."
  (let (textrows (max 1 (- rows 2))
        m (assoc m :view-rows textrows))   ; so page commands (C-v/M-v) know the viewport
    (cond
      (= input :tick) m
      (and (vector? input) (= (first input) :resize)) (ed-scroll m textrows)
      (get m :minibuffer) (ed-scroll (minibuffer-handle m input) textrows)
      (get m :completion)
        (if (complete-control-key? input)
          (ed-scroll (complete-handle m input) textrows)
          (ed-scroll (ed-dispatch (complete-cancel m) input) textrows))
      else (ed-scroll (ed-dispatch m input) textrows))))
