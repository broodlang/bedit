(defmodule input
  "The editor's input layer: fold one key event into the next model.

Dispatch goes through **layers** (`editor/layers`) composed across two scopes
(`ed-key-binding` → `scope-binding`): the active buffer's *mode* layers (`text-mode`
by default, see `modes`) over the model's keybinding *profile* layers (emacs/vim, see
`keymaps`), the buffer winning. `keymap-run` then runs one (possibly chorded)
keystroke through it, threading the prefix-`:pending` state — so the chord state
machine (prefix entry, mid-chord resolution, dead-end reset, self-insert fallback)
lives in the language toolkit, not here (the prime directive — see CLAUDE.md). The
bindings are data, declared per-mode in `modes`; this module only resolves the
active keymap, renders the echo-area label for a prefix / undefined chord, and
gates the minibuffer. Keys map to fully-qualified command **symbols** resolved
with `(reflect/eval sym)` at dispatch time, so redefining a command (or rebinding a key)
hot-swaps behaviour on the next keystroke (late binding, the path to a
self-editing editor)."
  (:use editor/buffer)
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use guest)
  (:use clipboard)
  (:use minibuffer)
  (:use scrollbar)
  (:use model) ; message, the minibuffer field, current-buffer accessors, the registries
  (:use spancache)
  (:use panes) ; ed-selected-text-rows — the split-aware viewport
  (:use textops) ; replace, tabify, align, case: their keys reach them by symbol
  (:use comment :only []) ; M-;: its key reaches it by symbol
  (:use kmacro :only []) ; C-x ( ) e: their keys reach them by symbol
  (:use browse-kill-ring :only []) ; M-x browse-kill-ring and its mode
  (:use window-commands) ; C-x 2 3 0 1 o, windmove, C-x 4: their keys reach them by symbol
  (:use lifecycle) ; the file and quit commands: their keys reach them by symbol
  (:use project-commands) ; likewise C-x p
  (:use complete-at-point :only []) ; the completion popup and preview: their overlays register at load
  (:use interactive) ; current-prefix-arg / prefix-consuming? — the prefix-arg seam
  (:use editor/keymap) ; keymap-run — the std chord dispatcher's running half
  (:use editor/ui) ; overlay-route — the shared modal-overlay dispatch fallthrough
  (:use events) ; the `[:tag …]` table, the mouse, a task's reply
  (:use keymaps) ; ed-ensure-profile — seed the model-scope keybinding profile (emacs/vim)
  (:use userkeys) ; ed-user-scope — the scope with init.blsp's :keys / :mode-keys bound in
  (:use whichkey :only []) ; C-h after a prefix: the which-key paging menu
  (:use editor/layers)) ; scope-resolve / scope-binding (buffer + model layers) + init-buffer-layers
;; `modes` defines the layers and registers the default (text-mode); the bindings live
;; there, as data, not here. Every project source module loads with the image, so a
;; feature's commands, event handlers and idle jobs are registered before the first key.

;; ---- the active keymap comes from the buffer's layers -----------------------

(defn- ed-ensure-layers (m)
  "Make sure both layer scopes are seeded before dispatch: the model's keybinding
*profile* (`keymaps/ed-ensure-profile` — emacs by default), and the current buffer's
*mode* layers (from its type — `text-mode` by default, `.blsp` → brood). Buffers
created anywhere get their mode here, lazily, so dispatch always has a keymap."
  (let (m1 (ed-ensure-profile m)
        b (ed-current-buf m1))
    (if (nil? (:layers b)) (ed-set-buf m1 (init-buffer-layers b)) m1)))

(defn- ed-facet-call (hook & arguments)
  ;; a mode facet's hook — a fn symbol, resolved late so a redefinition hot-swaps, or a fn
  (apply (if (symbol? hook) (reflect/eval hook) hook) arguments))

(defn- ed-post-key-guards (m-before m key)
  "Run the current buffer's mode `:post-key` guards over the just-dispatched model
(layers §7): each guard is `(m-before m-after key) -> model`, collected highest
precedence first, each seeing the previous guard's result. The model is immutable,
so a guard vetoes what the key did by returning `m-before` — how bshell keeps
point out of its prompt and the tutorial protects its prose without this dispatch
path naming either. Guards are fn symbols, resolved late (hot-swappable).

Then the `:on-move` FOLLOWERS (`ed-on-move-hooks`), which see only the guards' result:
a guard decides what the event did; a follower reacts to where the cursor ended up."
  (ed-on-move-hooks m-before
    (fold (layer-collect (ed-current-buf m) :post-key)
      m
      (fn (mm guard) (ed-facet-call guard m-before mm key)))))

(defn- ed-moved? (m-before m)
  "Did the event move the reader — a different buffer in the selected pane, or the
same buffer with its point or text changed (`buffer-moved?`)? The one test that gates
the `:on-move` facet, so no follower has to remember where it last was."
  (or (not (= (:buffer (ed-current-pane m-before)) (:buffer (ed-current-pane m))))
    (buffer-moved? (ed-current-buf m-before) (ed-current-buf m))))

(defn- ed-on-move-hooks (m-before m)
  "Run the current buffer's mode `:on-move` followers — each `(m) -> model`, collected
highest precedence first, each seeing the previous one's result — ONLY when the event
moved point or changed the text (`ed-moved?`). A follower keeps a companion pane on the
cursor (the markdown preview, the *Workings* pane); on the guard facet it re-asserted that
position on every event, including the wheel scrolling the very pane it follows with, and
snapped the reader's scroll back under them. Gating here, once, is what makes that class
of bug impossible to write: a follower never sees an event that moved nothing. Fn
symbols, resolved late (hot-swappable), like `:post-key`."
  (if (ed-moved? m-before m)
    (fold (layer-collect (ed-current-buf m) :on-move)
      m
      (fn (mm hook) (ed-facet-call hook mm)))
    m))

(defn ed-on-idle-hooks (m)
  "Run the current buffer's mode `:on-idle` hooks — each `(m) -> model`, collected highest
precedence first, each seeing the previous one's result — on the `:idle-recompute` beat,
once typing has settled. The per-mode half of that beat: the editor's own debounced work
(eldoc, diagnostics, the diff gutter) is the registered idle jobs; a mode's (the markdown
preview's re-render) rides this facet, so `:idle-recompute` names no mode. Fn symbols,
resolved late (hot-swappable), like `:post-key`."
  (fold (layer-collect (ed-current-buf m) :on-idle)
    m
    (fn (mm hook) (ed-facet-call hook mm))))

;; the mode's hooks run after the auto-save/revert and before the web mirror publishes, so
;; the snapshot shows what a hook re-rendered
(register-idle-job :mode-on-idle {:order 130 :run 'input/ed-on-idle-hooks})

;; ---- dispatch (the chord state machine is keymap-step; echo policy is ours) --
;; The echo-area key label is `keyhelp/ed-key-label` (shared with which-key + describe-key),
;; so a prefix / undefined-chord label reads identically everywhere (C-M-, S-, SPC, …).

(defn- ed-self-insert (m key)
  "The keymap fallback: a printable key self-inserts; any other unbound key is a
no-op (so a stray :f5 / :page-up never tries to insert a keyword).

In a modal COMMAND state — vim `:normal` or `:visual` — NOTHING types. An unbound
letter there is a dead key, exactly as in vim, where `z` alone is simply an incomplete
command (`keymaps/ed-vim-command-mode?`)."
  (cond
    (ed-vim-command-mode? m) m
    (string? key) (typing/cmd-self-insert m key)
    else m))

;; ---- prefix arguments (C-u N) -----------------------------------------------
;; `:prefix-arg` is `{:count N :raw bool}` while a numeric argument is being built:
;; C-u seeds 4 (`:raw` — not yet explicit digits); a further C-u multiplies by 4; a
;; digit switches to explicit accumulation. The next *complete* command runs `:count`
;; times (the common-case Emacs mechanism; per-command interactive specs are the
;; deferred std/layers improvement). A command that reads the arg itself (C-u C-SPC →
;; pop-mark) registers via `interactive/register-prefix-consuming` (declared next to
;; the command) so it runs once, not repeated.

(defn- ed-digit? (input)
  "True if `input` is a single decimal-digit key."
  (and (string? input) (= (count input) 1) (>= (index-of "0123456789" input) 0)))

(defn- ed-prefix-continues? (m input)
  "Keys that extend a pending prefix arg rather than ending it: another C-u, a digit, or
a `-` **only while the argument is still raw** (no digits yet) — `C-u -` negates, but a
`-` after digits terminates the arg and self-inserts (so `C-u 5 -` types five dashes)."
  (or (= input :ctrl-u)
    (ed-digit? input)
    (and (= input "-") (map/get-in m [:prefix-arg :raw]))))

(defn- ed-prefix-read (m input)
  "Fold a C-u / digit / `-` into the active prefix-arg accumulator. The count carries its
sign, so digits after a negative seed (from `M--`/`C--` or `-`) accumulate negative."
  (let (pa (:prefix-arg m)
        c (:count pa)
        neg (< c 0))
    (cond
      (= input :ctrl-u) (assoc m :prefix-arg {:count (* 4 c) :raw true})
      ;; `-`: raw → seed a negative argument (-1); mid-number → flip the sign.
      (= input "-") (assoc m :prefix-arg {:count (if (:raw pa) -1 (- c)) :raw (:raw pa)})
      else
      ;; A digit, by `ed-prefix-continues?` at the only call site — but that invariant
      ;; lives in another function, and `string/->number` answers `number | failure`.
      ;; An unparseable key leaves the accumulator alone rather than raising in `-`/`+`.
        (let (d (string/->number input))
          (if (failure? d)
            m
            (let (sd (if neg (- d) d))
              (assoc m
                :prefix-arg
                  (if (:raw pa) {:count sd :raw false} {:count (+ (* 10 c) sd) :raw false}))))))))

(sig ed-run-arg (model any any any int -> model))
;; check-allow: the inverse command is resolved late (`reflect/eval`); its result is the model
;; every command answers
(check-allow :trusted
  (defn- ed-run-arg (m1 step this-cmd input n)
    "Run `this-cmd` under numeric prefix argument `n`: `|n|` repetitions, swapping to its
registered inverse command when `n` is negative (Emacs negative-argument — `C-- C-f`
goes backward). Repeats thread `:last-command`/`:this-command` so consecutive kills /
inserts coalesce. With no registered inverse a negative arg just repeats `|n|` times."
    (let (an (math/abs n)
          inv (command-inverse this-cmd))
      (if (and (< n 0) inv)
        ;; the inverse runs directly, not through the keymap, so it does what a keymap step
        ;; does around a command itself: the echo starts clean, and the chord that led here
        ;; is over — a `C-u - M-g n` left `:pending` on the M-g map, and the next `n`
        ;; ran next-error instead of typing
        (assoc (fold (range an)
                 m1
                 (fn (mm i)
                   ((reflect/eval inv) (assoc mm
                                         :last-command (if (= i 0) (:last-command mm) inv)
                                         :this-command inv
                                         :echo "")
                     input)))
          :pending nil)
        (fold (range an) m1 (fn (mm i) (step (if (= i 0) mm (assoc mm :last-command this-cmd)))))))))

(defn- ed-amalgamate-undo? (this last)
  "Whether `this` command's edit amalgamates into the previous undo group: it repeats
`last` and is a typing/deletion run command (the `:typing` trait). Drives
`amalgamate-undo`."
  (and (= this last) (command-trait? this :typing)))

(def- ed-shift-deactivators
  ;; plain motions that collapse a shift-selection (Emacs shift-select-mode): a non-shift
  ;; arrow/word/buffer move clears the region and just moves. Region-using commands (kill,
  ;; copy, …) aren't here, so they still act on a shift-selected region.
  (list 'motion/cmd-forward-char
    'motion/cmd-backward-char 'motion/cmd-next-line 'motion/cmd-previous-line
    'motion/cmd-beginning-of-line 'motion/cmd-end-of-line 'motion/cmd-forward-word
    'motion/cmd-backward-word 'motion/cmd-beginning-of-buffer 'motion/cmd-end-of-buffer))

(defn- ed-shift-deactivate (m this-cmd)
  "Collapse a shift-selection when a plain motion runs: clear the mark + `:shift-select`
flag so a non-shift arrow moves without a region (Emacs shift-select-mode). Other
commands leave the region intact (so kill/copy act on a shift-selection)."
  (if (and (:shift-select m) (includes? ed-shift-deactivators this-cmd))
    (ed-set-buf (dissoc m :shift-select) (clear-mark (ed-current-buf m)))
    m))

(defn- ed-binding-command (binding)
  "The command `keymap-step` will run for `binding`: the symbol when bound, `:self-insert`
when unbound (the fallback), nil for a prefix key (mid-chord — no command)."
  (cond
    (map? binding) nil
    (nil? binding) :self-insert
    else binding))

;; How many typing commands one undo step takes at most (Emacs's self-insert amalgamation: 20).
(def *typing-run-max* 20)

(defn- ed-begin-command (m this-cmd)
  "The model as a command `this-cmd` is about to run: `:last-command`/`:this-command`
recorded (the Emacs mechanism) so kills coalesce and M-y yank-pop knows it follows a yank;
the current buffer's undo amalgamation armed — a typing / deletion run merges into one undo
group, every other command starts a fresh one (so a command undoes atomically — Emacs
`undo-boundary`), set explicitly each command so a no-op edit can't leave a stale flag; and
a shift-selection collapsed when the command is a plain motion."
  (let (run (or (:typing-run m) 0)
        ;; a typing run is cut every `*typing-run-max*` commands, as Emacs's self-insert
        ;; amalgamation is: one undo took back a whole fast-typed sentence, a pause being the
        ;; only other boundary
        amalgamate (and (ed-amalgamate-undo? this-cmd (:this-command m))
                     (not (:undo-break m))
                     (< (inc run) *typing-run-max*))
        started (assoc (dissoc m :undo-break)
                  :typing-run (if amalgamate (inc run) 0)
                  :last-command (:this-command m)
                  :this-command this-cmd
                  ;; one per key command: how a post-step tells a command ran from a mouse event
                  ;; or a timer (pulse's jump test)
                  :command-count (inc (or (:command-count m) 0))))
    (ed-shift-deactivate (ed-set-buf started
                           (assoc (ed-current-buf started) :undo-amalgamate amalgamate))
      this-cmd)))

(defn- ed-keymap-step (resolved input m)
  "One keymap step: run `input`'s `resolved` binding (`scope-resolve` against `:pending`)
through `keymap-run`, threading `:pending`. A command that PRESSED a prefix
(`ed-press-prefix`) leaves the next key to resolve in that sub-map, and the chord reads as
the prefix."
  (let ([stepped pending] (keymap-run resolved (:pending m) (assoc m :echo "") input ed-self-insert)
        pressed (:prefix-map stepped))
    (if (nil? pressed)
      (assoc stepped :pending pending)
      (assoc (dissoc stepped :prefix-map :prefix-key)
        :pending pressed
        :chord [(:prefix-key stepped)]
        :echo (str (ed-keys-label [(:prefix-key stepped)]) "-")))))

(defn- ed-run-command (m this-cmd input step)
  "Run the started command `this-cmd` through `step`, under the numeric prefix argument
when one is set, and clear the argument once it has been consumed. A package's command runs
under its package's claimant (`ownership/with-symbol-claimant`), so a row it registers as it
runs goes back with the package."
  (ownership/with-symbol-claimant this-cmd (fn () (ed-run-command-now m this-cmd input step))))

(defn- ed-run-command-now (m this-cmd input step)
  (let (repeat-count (current-prefix-arg m))
    (cond
      (nil? repeat-count) (step m)
      ;; a command that consumes the arg itself (set-mark → pop-mark): run once
      (prefix-consuming? this-cmd) (dissoc (step m) :prefix-arg)
      ;; a normal command under a prefix arg: run |N| times — the inverse when N is
      ;; negative (`ed-run-arg`). Every repetition resolves `input` in the SAME map the
      ;; first did: the first step ends the chord, so a bare `step` would look the last key
      ;; up at top level — `C-u 3 C-x o` switched pane once and then typed `oo`
      else
        (dissoc (ed-run-arg m
                  (fn (mm) (step (assoc mm :pending (:pending m))))
                  this-cmd
                  input
                  repeat-count)
          :prefix-arg))))

(defn- ed-echo-chord (m binding result input)
  "`result` with the echo area showing the chord so far. `:chord` accumulates the keys of the
in-progress prefix chord, so the echo shows the FULL chord (\"C-x p-\", \"C-x p e is
undefined\") — not just the last key. Carried while a prefix is pending; cleared the moment
the chord resolves (a command ran) or aborts."
  (let (chord (append (or (:chord m) []) [input]))
    (cond
      (map? binding) (assoc result :echo (str (ed-keys-label chord) "-") :chord chord)
      ;; a chord bound to nothing fails, as Emacs's `undefined` rings the bell (and ends a
      ;; keyboard macro)
      (and (nil? binding) (:pending m))
        (ed-ding (assoc result :chord []) (str (ed-keys-label chord) " is undefined"))
      ;; the command pressed a prefix: the step set the chord and echo to it
      (:pending result) result
      else (assoc result :chord []))))

(defn ed-dispatch-key (m input)
  "Resolve and run `input` through the active keymap (the chord work is `keymap-step`),
repeating the command `:prefix-arg` times when one is set (negative runs the inverse —
see `ed-run-arg`). A prefix key mid-chord just steps (the prefix arg carries until the
chord completes); a prefix-consuming command (set-mark) runs once and reads the arg."
  (let (pending (:pending m)
        binding (if (nil? pending) (ed-key-binding m input) (get pending input))
        ;; resolved ONCE: every repetition under a prefix arg steps from this same
        ;; `:pending` (`ed-run-command`), so it would find this same binding
        resolved (keymap-classify binding)
        this-cmd (ed-binding-command binding)
        step (fn (mm) (ed-keymap-step resolved input mm))
        result (cond
                 ;; a prefix key mid-chord: step, keep the prefix arg for the resolving key
                 (nil? this-cmd) (step m)
                 ;; a guest's session runs only what edits the buffers it was given
                 (and (:guest-session m) (not (ed-guest-allows? this-cmd)))
                   (ed-guest-refusal (dissoc m :pending :prefix-arg))
                 else (ed-run-command (ed-begin-command m this-cmd) this-cmd input step)))
    (ed-echo-chord m binding result input)))

;; ---- repeat-mode (Emacs `repeat-mode`: tap the last key to repeat the command) -----
;; After a command with the `:repeat` trait runs (typically via a chord like C-x o), arm a
;; `:repeat` transient: pressing the same key again re-invokes the command, and again, …
;; until any other key (which exits and dispatches normally). A command with a REPEAT MAP
;; (`interactive/declare-repeat-map`, Emacs's `repeat-map`) arms every key of it as well: after
;; C-x C-M-+, `+` / `-` / `0` keep zooming. This is how a chord command
;; repeats — Emacs never hold-repeats chords; it taps. The `:repeat` overlay lives in
;; the overlay table; arming happens here, post-dispatch.

(defn- ed-repeat-keys (command input)
  "The keys that repeat after `command` ran from the key `input`, `{key -> command}`: its
declared repeat map (`interactive/declare-repeat-map`, Emacs's `repeat-map`) with `input`
itself, or `input` alone for a command with the `:repeat` trait; nil for any other."
  (let (declared (command-repeat-map command))
    (cond
      declared (assoc declared input command)
      (command-trait? command :repeat) {input command}
      else nil)))

(defn- ed-arm-repeat-mode (m input)
  "After `ed-dispatch-key`, arm `:repeat` (repeat-mode) when this step actually ran a
command (`:pending` is clear — not a mid-chord prefix) that repeats ([[ed-repeat-keys]]), so
pressing `input` (its last key) again, or a key of its repeat map, runs again. Otherwise
leave the model as-is (the `:repeat` overlay's `:exit` has already cleared any prior repeat
on a non-repeat key)."
  (let (repeat-keys (when (nil? (:pending m)) (ed-repeat-keys (:this-command m) input)))
    (if (nil? repeat-keys)
      m
      (assoc m :repeat {:key input :command (:this-command m) :keys repeat-keys}))))

(defn- ed-repeat-run (m input)
  "Run the command the armed repeat map gives `input` (an Emacs repeat-mode tap), keeping
`:repeat` armed so it keeps repeating. Resolves the command symbol to its fn and runs it with
the key; the command itself does the work (pane/buffer cycling, a zoom step, …)."
  ((reflect/eval (map/get-in m [:repeat :keys input])) m input))

(defn ed-dispatch (m0 input)
  "Fold one key `input` into the next model, recording it in the lossage ring first (`C-h l`
sees every key that reached here, bound or not). While a numeric prefix argument is being
built (`:prefix-arg` set and `input` a C-u/digit), accumulate it and run nothing yet;
otherwise resolve and run the key through the active keymap (`ed-dispatch-key`). `C-h`
after a prefix that leaves it free opens the which-key paging menu (`whichkey`), whose keys
turn the panel's pages without ending the chord; any other key leaves the menu and goes to
the prefix."
  (let (m (lossage/lossage-record (ed-ensure-layers m0) input))
    (cond
      (and (:prefix-arg m) (ed-prefix-continues? m input))
        (let (m2 (ed-prefix-read m input))
          (assoc m2 :echo (str "C-u " (map/get-in m2 [:prefix-arg :count]) "-")))
      (:which-key-paging m)
        (or (whichkey/paging-key m input)
          (ed-arm-repeat-mode (ed-dispatch-key (dissoc m :which-key-paging) input) input))
      (whichkey/help-key? m input) (whichkey/open-paging m)
      else (ed-arm-repeat-mode (ed-dispatch-key m input) input))))

;; ---- transient input overlays (one registry; std's fallthrough policy) ------
;; The minibuffer, the completion popup, incremental search, and query-replace are
;; all *transient* modes that sit beside the keymap: while open, one of them captures
;; input. Each is a record implementing `editor/ui`'s `Overlay` ability (ADR-183):
;; `overlay-active?` says when it is open, `overlay-owns?` which keys are its to
;; handle (skipped = capture-all, like the minibuffer), `overlay-handle` folds an
;; owned key into the model, and `overlay-exit` dismisses before a non-owned key
;; falls through (skipped = no dismiss step). The shared `editor/ui/overlay-route`
;; routes one key to whichever is open. A new modal feature defines a record + impl
;; and registers a row (`model/register-overlay`) instead of growing `ed-update`. The dispatch
;; rule itself lives in std (ADR-094) — the observer's minibuffer rides the same
;; `overlay-route` — and re-registering an impl hot-swaps a live overlay (late
;; binding, same as commands).

(defrecord read-char-overlay ()) ; ed-read-char: the next key is handed to a continuation (zap, registers)
(impl Overlay
  read-char-overlay
  (overlay-active? (_ m) (:read-char m))
  ;; no overlay-owns? — capture-all: the next key is the one being read
  ;; a reader that holds the keyboard for an answer still on its way (vcsproc's hold) names
  ;; what C-g must also cancel — `:on-cancel`, a `(model) -> model` symbol, run late
  (overlay-handle (_ m input)
    (let (on-cancel (map/get-in m [:read-char :on-cancel]))
      (cond
        (and (ed-cancel-key? input) on-cancel) ((reflect/eval on-cancel) m)
        (ed-cancel-key? input) (message (dissoc m :read-char) "quit")
        ;; the prompt leaves the echo area with its answer, as Emacs's does: a continuation
        ;; that says nothing must not leave it standing over the next buffer
        else ((map/get-in m [:read-char :then]) (assoc (dissoc m :read-char) :echo "") input)))))

(defrecord minibuffer-overlay ())
(impl Overlay
  minibuffer-overlay
  (overlay-active? (_ m) (:minibuffer m))
  ;; no overlay-owns? — capture-all: every key is the minibuffer's. A message shown beside the
  ;; prompt (`model/message`) lasts until the next key, as Emacs's minibuffer message does.
  (overlay-handle (_ m input)
    (minibuffer-handle (assoc m :minibuffer (dissoc (:minibuffer m) :message)) input)))

(defrecord repeat-overlay ()) ; Emacs repeat-mode: tap the last key again to repeat the command
(impl Overlay
  repeat-overlay
  (overlay-active? (_ m) (:repeat m))
  (overlay-owns? (_ m input) (contains? (map/get-in m [:repeat :keys] {}) input))
  (overlay-handle (_ m input) (ed-repeat-run m input))
  (overlay-exit (_ m) (dissoc m :repeat)))

;; The input layer's own rows. The ranks between them are held for the features' rows, and the
;; order is load-bearing (tests/registries_test pins it):
;;   10 describe-key (help)  20 read-char  30 menu  40 query-replace  50 isearch  60 minibuffer
;;   70 completion (complete-at-point)  80 transient  90 term  100 secret  105 snippet
;;   110 preview (complete-at-point)  120 repeat
;; An active snippet's TAB is below the popup's (a candidate is taken first) and above the
;; preview's (with a suggestion standing, TAB still moves to the next field).
;; A transient menu is BELOW the minibuffer: reading an option's value leaves the menu on the
;; model and opens a minibuffer, so a menu above it would eat the keys meant for the prompt.
;; A terminal owns its keys, but the minibuffer and the popups above it win when open. The
;; preview is below everything you deliberately opened and below a terminal: it has no exit,
;; so a key it does not own skips every overlay under it straight to dispatch. Above the
;; terminal, it sent a char-mode program's keys to self-insert in its read-only buffer for as
;; long as a suggestion stood, and none reached the program to change the screen and clear it.
(register-overlay :read-char 20 (read-char-overlay))
(register-overlay :minibuffer 60 (minibuffer-overlay))
(register-overlay :repeat 120 (repeat-overlay))

(defn ed-route-transient (m input)
  "Fold `input` into the active transient overlay, or through normal dispatch
(`ed-dispatch`) when none is open — via the shared `editor/ui/overlay-route`. The
owning handler consumes the key; otherwise the overlay exits (`:exit`) and the key is
dispatched normally (Emacs' dismiss-and-process)."
  (overlay-route (ed-overlays) m input ed-dispatch))

;; ---- key repeat: the desktop's, not ours (brood ADR-441) ---------------------
;; The window is opened with `{:key-repeat :os}`: a held key's auto-repeats arrive as
;; plain presses at the delay and rate the user set for their desktop (GNOME's keyboard
;; settings, `xset r rate`, KDE's), with at most one ever queued and that one taken back at
;; the release, so the screen stops with the key even behind a slow frame. Each repeat is
;; dispatched like the press it repeats: a chord's last key repeats as itself (C-x o o o,
;; which repeat-mode answers), and a mode's `:post-key` guards see every one.
;;
;; Every repeat is a real press (and the window restarts its caret blink on it). Every
;; timer that waits for a pause is `:idle?`, and `ui-run` holds those while a key is down,
;; the delay before the first repeat included, so the idle beat, a live-eval debounce and
;; the typing undo boundary all wait for the key to come up. What bedit does keep is
;; whether the key it is folding IS a repeat (`:key-repeat`, from brood's
;; `gui/key-repeat?`, ADR-612): a held key starts no animation (`pulse/note-jump`).

;; Whether the key being folded is an OS auto-repeat, for a caller that knows without a
;; window (a test). nil, the default, asks the window.
(defdyn *key-repeat?* nil)

(defn ed-key-repeat? (m)
  "Whether the key being folded is an OS auto-repeat of a key held down: [[*key-repeat?*]]
when bound, else the window's answer (`gui/key-repeat?` — exact, since the window marks
each press as the app takes it from its mailbox). False with no window of our own (a test, a
terminal, a served session, whose keys come over a link)."
  (let (forced *key-repeat?*
        window (:window m))
    (cond
      (not (nil? forced)) (= forced true)
      (nil? window) false
      else (= (theme/gui-only gui/key-repeat? window) true))))

(defn- ed-note-key (m)
  "`m` as a key finds it: `:key-repeat` set to whether this key is an OS repeat
([[ed-key-repeat?]], the model untouched when that has not changed), and a scroll still
resting between lines settled at once (`scroll/ed-settle-now`), so the key never shares
its frames with the settle ease."
  (let (repeat (ed-key-repeat? m)
        noted (if (= repeat (= (:key-repeat m) true)) m (assoc m :key-repeat repeat)))
    (ed-settle-now noted)))

(defn ed-key-step (m input textrows textcols)
  "Route one key through normal dispatch, then re-clamp scroll (vertical + horizontal so a
long line follows point). A press and each of its OS auto-repeats take this same step, so
the mode `:post-key` guards see every one: holding backspace in a tutorial box stops at its
╭─ border instead of eating into the read-only prose. The guards run before the scroll
clamp, so a veto's restored point is what the viewport follows."
  (let (guarded (ed-clamp-restriction (ed-adjust-restriction m
                                        (ed-post-key-guards m (ed-route-transient m input) input))))
    (ed-scroll-horizontal (ed-scroll guarded textrows) textcols)))

;; ---- named timers (ADR-102): firing the model's declared `:timers` -------------
;; `ed-update` routes a `[:timer name]` firing here. The arming side (which timers are
;; present) lives in `model/ed-sync-timers`; this is the dispatch for what each does when
;; it fires. Note `[:timer …]` is a vector, so its arm must precede `ed-system-event?`
;; (else it'd fall through to key dispatch); `ed-macro-record` already skips vectors.

(defn- ed-timer-event? (input)
  "True if `input` is a named-timer firing — a `[:timer name]` vector (ADR-102)."
  (and (vector? input) (= (first input) :timer)))

(def- *cosmetic-timers*
  ;; The timers whose firing changes only how the frame LOOKS — the spinner frame, the
  ;; scrollbar's opacity — and nothing any other part of the turn reads: no text, no
  ;; point, no scroll, no pane. `ed-update` folds them through `ed-cosmetic-fire` alone
  ;; and skips the rest of the pipeline (timer sync, post steps, span refresh, the hosted
  ;; propagate, the collab chain), which on a 16 ms fade tick was a whole editor turn for
  ;; an opacity that only had to drop. Each one keeps its own timer honest: the fade drops
  ;; itself when it reaches zero, the hold by starting the fade; the spinner is dropped by
  ;; the turn that finishes the work (`model/ed-sync-timers`), which is never a cosmetic
  ;; one. The caret blink is not here at all: the window blinks it (brood ADR-469).
  #{:spinner :scrollbar-hold :scrollbar-fade})

(defn- ed-cosmetic-timer? (input)
  "True if `input` fires one of the [[*cosmetic-timers*]]."
  (and (ed-timer-event? input) (contains? *cosmetic-timers* (nth input 1))))

(defn- ed-cosmetic-fire (m name)
  "Service a fired [[*cosmetic-timers*]] entry: `:spinner` advances the activity frame,
`:scrollbar-hold` starts the thumb's fade and `:scrollbar-fade` ticks it down."
  (cond
    ;; the activity spinner: advance the frame, nothing else. The segment reads the
    ;; counter; when the work finishes `ed-sync-timers` drops this timer entirely.
    (= name :spinner)
      (let (n (:spin m 0)
            next (if (int? n) (inc n) 1))
        ; the field is `any` off the model, like every other read
        (assoc m :spin (math/mod next 1000)))
    ;; The overlay scrollbar: the quiet hold ends by starting the fade ticker, which ticks
    ;; the visibility budget down; dragging pins the thumb, and hitting zero hides it and
    ;; stops the timer so the editor idles again (no wakeups at rest).
    (= name :scrollbar-hold) (ed-scrollbar-start-fade m)
    (= name :scrollbar-fade)
      (if (:sb-drag m)
        (assoc m :sb-fade *scrollbar-fade-ticks*)
        (let (budget (dec (or (:sb-fade m) 0)))
          (if (<= budget 0)
            (ed-drop-timer (assoc m :sb-fade 0) :scrollbar-fade)
            (assoc m :sb-fade budget))))
    else m))

(defn- ed-timer-fire (m name textrows textcols cols rows)
  "Service the fired timer `name`: `:idle-recompute` / `:idle-continue` run the idle beat's
jobs; a feature's timer its `:fire`; `:which-key` reveals the prefix panel; the scroll settle
and glide ease a pane onto a line; `:undo-pause` closes the typing run (next edit starts a
fresh undo group); a live-evaluating buffer's debounce launches it; a cosmetic one (the
spinner, the scrollbar) is `ed-cosmetic-fire`'s. An unknown name is a no-op."
  (cond
    ;; the idle debounce: eldoc, the diagnostics check, a large completion source's
    ;; re-rank, the off-the-loop diff-hl launch, the web-mirror push… — all the work too
    ;; costly for the per-key path, run once activity settles. Each is a row its module
    ;; registered (`model/register-idle-job`), run in the table's order.
    ;; In a live loop the beat runs in slices so a key never waits for all of it; headless
    ;; (tests, a batch run) it runs whole.
    (= name :idle-recompute) (if (ed-headless?) (ed-run-idle-jobs m) (ed-run-idle-slice m 0))
    (= name :idle-continue) (ed-run-idle-slice m (or (:idle-resume m) 0))
    ;; a timer a feature registered (`model/register-timer-client`) — git's upstream watch,
    ;; a displayed BEAM view re-asking its node, a collaborator's name tag fading
    (contains? (ed-timer-clients) name)
      (ed-call-deferred m (map/get-in (ed-timer-clients) [name :fire]) m)
    (contains? *cosmetic-timers* name) (ed-cosmetic-fire m name)
    (= name :which-key) (ed-which-key-reveal m)
    ;; the glide stopped: ease every pane onto a whole line (`scroll/ed-glide-scroll-step`)
    (= name :scroll-settle) (ed-start-settle m)
    (= name :scroll-glide) (ed-glide-scroll-step m)
    (= name :undo-pause) (ed-break-undo-run m)
    ;; A live-evaluating buffer's debounce landed: the tutorial's lesson boxes, the Brood
    ;; playground, the Elixir playground. Re-evaluate the forms this edit could have
    ;; changed the answer of. All three are rows in `model/ed-live-eval-clients`, so a fourth
    ;; language that evaluates as you type is a table entry rather than another arm here.
    (includes? (map (ed-live-eval-clients) :timer) name) (ed-live-eval-launch m name)
    else m))

;; ---- the ui-run update ------------------------------------------------------

(defn- ed-macro-record (m input)
  "While a keyboard macro is recording (`:macro-recording` is a vector), append the raw key
`input` to it — skipping timers, focus events, inbound `[:tag …]` system events AND
`UiEvent` records (only real keystrokes belong in a macro; a replayed async event
would re-append phantom report lines and resurrect dead pids). Text an input method
committed (`[:text s]`) is typing, so it is kept; a composition still in progress
(`[:preedit …]`) is not, since only its commit changes the buffer. The C-x ) that ends
recording is captured too and trimmed by `cmd-end-kbd-macro`. Nor is a key a registered guard
keeps out (`model/register-macro-guard`): a password typed into a masked read."
  (if (and (vector? (:macro-recording m))
        (not (ed-macro-private? m input))
        (not (= input :blur))
        (not (= input :focus-in))
        (not (= input :close))
        (or (not (vector? input)) (contains? #{:text :paste} (first input)))
        (not (record? input)))
    (assoc m :macro-recording (conj (:macro-recording m) input))
    m))

(def *view-resume-keys*
  ;; Plain cursor-movement keys that should resume from the VISIBLE area after you've
  ;; scrolled the cursor off-screen (wheel / scrollbar): they pull point into view first
  ;; (`ed-point-into-view`), so the view doesn't snap back to the off-screen cursor — what
  ;; reads as "jumping to the top". Everything else (recenter C-l, goto, isearch, page
  ;; scroll, typing, …) deliberately acts on the real point, off-screen or not.
  [:up :down :left :right :ctrl-n :ctrl-p :ctrl-f :ctrl-b])

(sig ed-point-into-view (model int -> model))
(defn- ed-point-into-view (m textrows)
  "If the selected pane's point has scrolled off-screen — the user wheeled or dragged the
view away from the cursor — move point to the nearest visible line (keeping its column), so
the next keystroke continues from what's on screen rather than snapping the whole view back
to the off-screen cursor (which, with point near the top, reads as 'jumping to the top').
A no-op when point is already visible, so normal editing is untouched."
  (let (buf (ed-current-buf m)
        top (ed-current-top m)
        cl (buffer-current-line buf)
        ;; the last line on screen: `top + rows - 1`, or for a row-wise buffer the last
        ;; line whose TEXT is in its row table (a long line above takes several rows, an
        ;; inlay takes one, and a trailing inlay row shows a line's note, not the line)
        w (or (:view-cols m) 0)
        inlays (ed-row-extras buf)
        bot (if (and (ed-row-wise? buf inlays) (> w 0))
              ;; from the pane's start, which may be part-way down its top line
              (let (skip (second (ed-current-start m w inlays))
                    text-rows (seq/filter (wrap/rows-from buf top w textrows inlays skip)
                                (fn (row) (nil? (nth row 3)))))
                (if (empty? text-rows) top (first (last text-rows))))
              (+ top (dec textrows))))
    (if (and (>= cl top) (<= cl bot))
      m
      (ed-set-buf m (forward-line buf (- (math/max top (math/min bot cl)) cl))))))

(defn- ed-refresh-spans-guarded (m cols rows)
  "The loop-tail span refresh (`spancache/ed-refresh-spans`), which may NOT veto the event it
follows. A lexer or restart that throws — a mode naming a service its module never defined —
is reported in the echo area and the command's model stands, `:done` included. Unguarded,
the throw would reach the dispatch guard ([[ed-recover]]), which keeps the PRE-event model:
every input dropped, the close request among them. `ed-view` guards the same failure on the
paint side (the `render error` frame)."
  (try
    (ed-refresh-spans m cols rows)
    (catch e (message m (str "fontify " (ed-error-text e :fontify))))))

(defn- ed-type-text (m text textrows textcols)
  ;; each character of `text` down the key path, as though typed, so the minibuffer, isearch
  ;; and a terminal's program get it the way they get typing; a composition showing at point
  ;; ends
  (fold (string/->graphemes text)
    (dissoc m :preedit)
    (fn (acc character) (ed-key-step acc character textrows textcols))))

(defn- ed-paste (m text textrows textcols)
  "A bracketed paste from the terminal bedit runs in (`[:paste text]`, brood ADR-586). When
nothing modal holds the keys: to a registered taker first (`model/register-paste-taker`: a
program waiting for a password), then the mode's `:paste` facet, else into the buffer as one
yank (`killing/ed-paste-text`, Emacs's `xterm-paste`). Otherwise — a prompt, a search — each
character the way typing gets there, as committed text does."
  (if (ed-modal-open? m)
    (ed-type-text m text textrows textcols)
    ;; a taker, then the mode (a char-mode terminal's program); else one yank
    (or (ed-take-paste m text)
      (let (paste (ed-mode-service (ed-current-buf m) :paste))
        (or (when paste (paste m text)) (killing/ed-paste-text m text))))))

(defn- ed-fold-input (m0 input textrows textcols cols rows)
  "Fold one input into the model, by what kind of input it is: a named timer, a bare tick, the
window's close/blur, a `UiEvent` record, an inbound `[:tag …]` system event, or — anything
else — a key."
  (cond
    ;; a named timer fired (ADR-102): debounce / which-key / undo / spinner / glide. Must
    ;; precede `ed-system-event?` — `[:timer …]` is a vector but isn't in the event-handler
    ;; registry, so it'd otherwise fall through to key dispatch.
    (ed-timer-event? input) (ed-timer-fire m0 (nth input 1) textrows textcols cols rows)
    ;; the window's X button (`:close`, claimed via `:close-is-input?`): the same command as
    ;; C-x C-c, so unsaved work is asked about first. Late-bound like the event handlers, and
    ;; outside any transient — a close is never a key.
    (= input :close) ((reflect/eval 'lifecycle/cmd-quit) m0 input)
    ;; the window lost focus (`:blur`): the caret goes hollow, and a composition left showing
    ;; goes with it — not every input method says it ended; another app may copy now
    (= input :blur) (ed-clipboard-blur (assoc (dissoc m0 :preedit) :unfocused true))
    ;; and back: the caret is solid again (brood ADR-441's `:focus-in`), and the window
    ;; blinks it again (it held it shown while unfocused, brood ADR-469); what another app
    ;; copied meanwhile is read off the loop, so a yank never waits on it
    (= input :focus-in) (ed-clipboard-focus (dissoc m0 :unfocused))
    ;; Text that is more than one key's worth (an input method's commit, a compose sequence,
    ;; brood ADR-441): each character takes the key path, as though typed
    (and (vector? input) (= (first input) :text)) (ed-type-text m0 (nth input 1) textrows textcols)
    ;; a terminal's bracketed paste, whole (brood ADR-586) — see `ed-paste`
    (and (vector? input) (= (first input) :paste)) (ed-paste m0 (nth input 1) textrows textcols)
    ;; The input method's composition in progress, shown at point and not yet inserted
    ;; (`[:preedit text range]`); an empty text clears it.
    (and (vector? input) (= (first input) :preedit))
      (if (= (nth input 1) "")
        (dissoc m0 :preedit)
        (assoc m0 :preedit {:text (nth input 1) :range (nth input 2 nil)}))
    ;; an app-produced async event record → it folds itself in (`UiEvent`, see model.blsp —
    ;; no handler table to consult).
    (ui-event? input) (ui-event-fold input m0 textrows cols rows)
    ;; an inbound async/system event (`[:tag …]`) → its registered handler. A MOUSE gesture
    ;; can edit the buffer (context-menu Paste/Cut, a drag-kill), so the buffer's `:post-key`
    ;; guards apply to it exactly as to a key — without this, a right-click Paste bypassed the
    ;; tutorial's prose protection. Other system events (task replies, subprocess lines) never
    ;; edit interactively and skip the guards.
    (ed-system-event? input)
      (let (folded ((reflect/eval (ed-event-handler (first input))) m0
                     input textrows cols rows))
        (if (= (first input) :mouse) (ed-post-key-guards m0 folded input) folded))
    ;; otherwise a key: for a plain cursor-movement key, first pull point back into view if
    ;; the user scrolled it off-screen (so the move resumes from what's visible instead of
    ;; snapping the view to the off-screen cursor) — skipped while a transient overlay owns
    ;; input, and NOT for other commands (recenter/goto/search act on the real point). Then
    ;; route through the keymap (`ed-key-step`, which also runs the mode `:post-key`
    ;; guards). A key that reaches the editor is not part of a
    ;; composition, so one still showing (a cancelled one, C-g) is cleared.
    else
      (ed-key-step (let (typed (ed-note-key (if (:preedit m0) (dissoc m0 :preedit) m0)))
                     (if (and (includes? *view-resume-keys* input)
                           (nil? (overlay-active (ed-overlays) typed)))
                       (ed-point-into-view typed textrows)
                       typed))
        input textrows textcols)))

;; ---- replaying a keyboard macro (C-x e) ---------------------------------------
;; Each recorded key goes back through the whole turn (`ed-update-direct`), as if typed.
;; Emacs's rules: a run of N passes stops at the first key whose command fails — an error,
;; or a bell (`model/ed-ding`: a failing search, a motion at the buffer's edge, a read-only
;; refusal) — and N = 0 runs passes until one does, or until C-g.
;;
;; C-g has to reach a run, so a run is not one turn: it replays keys for at most
;; `*macro-slice-ms*` and then yields to the loop, which takes queued input before it fires
;; the `:macro-continue` ticker that resumes the run (the idle beat's slicing). Between
;; slices a C-g ends the run, keeping what it did, and runs as the quit it is; any other
;; input the user types meanwhile waits in `:macro-typeahead` and is folded, in order, when
;; the run ends — Emacs reads the macro's keys before the keyboard's. The run's state is
;; `:macro-run` (`{:keys :passes :done :index}`); `:macro-executing` is on while it lasts,
;; so the macro cannot start itself again.

;; How long one slice of a macro run may replay keys before it yields to the loop, which
;; then takes the input queued behind it (C-g above all). Half a 60 Hz frame, as the loop's
;; own fold budget: a long run shows its progress every frame or two.
(defdyn *macro-slice-ms* 8)

(def- *macro-continue-timer* :macro-continue)

(defn- ed-macro-stop (m)
  ;; the macro run in `m` gone — its state, its typeahead and its ticker
  (ed-drop-timer (dissoc m :macro-run :macro-executing :macro-typeahead) *macro-continue-timer*))

(defn- ed-macro-end (m cols rows)
  "End the macro run in `m`: its state and ticker gone, the repeat-mode tap that started it
armed again (the replayed keys disarmed it — C-x e then `e` runs it again), then the input
typed while it ran folded in the order it came (`:macro-typeahead`)."
  (let (repeat (:repeat (:macro-run m))
        stopped (ed-macro-stop m))
    (fold (or (:macro-typeahead m) [])
      (if repeat (assoc stopped :repeat repeat) (dissoc stopped :repeat))
      (fn (acc input) (ed-update acc input cols rows)))))

(defn- ed-macro-slice (m cols rows)
  "Replay the run in `m` (`:macro-run`) from where it stands for up to `*macro-slice-ms*` —
at least one step, so a run always progresses. Ends the run at the first key whose command
failed (`:command-failed`, cleared before each key so only that key's failure counts) or
after its last pass; otherwise keeps the position and arms `:macro-continue`."
  (let (deadline (+ (os/now) *macro-slice-ms*))
    (letrec (step (fn (mm run stepped)
                    (let (keys (:keys run)
                          index (:index run))
                      (cond
                        (and (> stepped 0) (>= (os/now) deadline))
                          (ed-set-timer (assoc mm :macro-run run)
                            *macro-continue-timer*
                            {:every 1 :command? true})
                        (>= index (count keys))
                          (let (done (inc (:done run)))
                            (if (and (> (:passes run) 0) (>= done (:passes run)))
                              (ed-macro-end mm cols rows)
                              (step mm (assoc run :done done :index 0) (inc stepped))))
                        else
                          (let (after (ed-update-direct (dissoc mm :command-failed)
                                        (nth keys index)
                                        cols
                                        rows))
                            (if (:command-failed after)
                              (ed-macro-end (dissoc after :command-failed) cols rows)
                              (step after (assoc run :index (inc index)) (inc stepped))))))))
      (step m (:macro-run m) 0))))

(defn ed-run-macro (m request cols rows)
  "Start replaying the last keyboard macro as `request` (`{:count N}`, from
`cmd-execute-kbd-macro`) asks — N passes, or with N = 0 passes until one fails — and run its
first slice ([[ed-macro-slice]]); the loop runs the rest, between the user's input."
  (ed-macro-slice (assoc m
                    :macro-executing true
                    :macro-run
                      {:repeat (:repeat m)
                       :keys (vec (or (:macro-last m) []))
                       :passes (or (:count request) 1)
                       :done 0
                       :index 0})
    cols rows))

(defn- ed-macro-typeahead? (input)
  "Whether `input` is the user's — a key, typed or committed text, the mouse, the close
button — which a running macro makes wait, rather than a timer, a reply or a window event
that folds as usual."
  (and (not (record? input))
    (not (= input :blur))
    (not (= input :focus-in))
    (or (not (vector? input)) (contains? #{:text :paste :mouse :preedit} (first input)))))

(defn- ed-macro-continue (m cols rows)
  "The `:macro-continue` ticker fired: the run's next slice ([[ed-macro-slice]]). The ticker
is a `:command?` timer (brood ADR-564), so the loop folds it as the user's command — no
background ceiling stops a slice part-way and rolls it back to run again. A slice that
throws (each key's own error is already caught, and ends the run) ends the run here too,
said, never left to be retried."
  (try
    (ed-macro-slice m cols rows)
    (catch e
      (ed-ding (message (ed-macro-stop m) (str "keyboard macro stopped: " (error-message e)))))))

(sig ed-macro-input (model any int int -> model))
(defn- ed-macro-input (m input cols rows)
  "Fold `input` into `m` while a macro runs: its ticker resumes the run, C-g ends it — the
work done so far kept, the typeahead dropped, and C-g then run as the quit it is — and
other user input waits for the run to end."
  (cond
    (= input [:timer *macro-continue-timer*]) (ed-macro-continue m cols rows)
    (= input :ctrl-g) (ed-update-direct (ed-macro-stop m) input cols rows)
    (ed-macro-typeahead? input) (assoc m :macro-typeahead (conj (or (:macro-typeahead m) []) input))
    else (ed-update-direct m input cols rows)))

(defn- ed-loop-tail (m0 result input cols rows)
  "After the event folded in: replay a keyboard macro if one was asked for, else propagate.

C-x e (cmd-execute-kbd-macro) set `:run-macro`: replay the recorded macro by re-feeding its
events through `ed-update` (recording is off, so they aren't re-captured). The replayed calls
each run their OWN tail steps, so the replay path must NOT be wrapped in another
run of them — the outer propagate would diff the pre-replay model against the final one and
send the macro's whole change a SECOND time.

Otherwise the registered tail steps (`model/register-tail-step`): first the hosted content
propagate (ships this event's edits to every process-backed slot, shared or purely local),
then collab's auto-share / follow / presence sync. Each is a map-lookup no-op on a model with
nothing hosted, which is what lets `share-session` turn a LIVE editor into a host without
swapping update fns."
  (if (:run-macro result)
    (ed-run-macro (dissoc result :run-macro) (:run-macro result) cols rows)
    (ed-run-tail-steps m0 result input)))

(defn- ed-recover (m0 e input)
  "A thrown error — from a command, the minibuffer, completion, or a re-check — surfaces in the
echo area and the editor keeps running: a crash must never take down the whole editor (ui-run
would otherwise restore the screen and re-raise, exiting). The pre-event model `m0` stands
(the edit is undone by being abandoned — the buffer is immutable), marked failed
(`ed-ding`), so a keyboard macro running it stops here as Emacs's does on an error.

A read-only span refusing an edit is not an error to surface as one: `ed-edit` already turns
the common path into the buffer's hint, and this is the SAFETY NET for any command that edits
some other way — a `:kind :read-only` throw (std/editor/buffer) degrades to the same hint,
never a raw `error:`.

The error echo appends to *Messages*, which is HOSTED under the flip — the append must still
propagate or the pool cache silently diverges from the *Messages* process: the tail steps
marked `:recover` run (`model/ed-run-recover-steps`, the hosted propagate), in their own
guarded try: a propagate error here must not recurse into another echo."
  (let (recovered (if (ed-read-only-refusal? e)
                    (ed-read-only-refused m0)
                    (ed-ding (message m0 (ed-error-text e :command)))))
    (try (ed-run-recover-steps m0 recovered input) (catch _propagate-error recovered))))

(defn- ed-sync-title (result)
  ;; Update the OS title bar from the result model every event (cheap: a string set).
  (let (win (:window result)
        title (ed-window-title result))
    (when (and win (not (= title (:window-title result))))
      (theme/gui-only gui/title win title))
    (assoc result :window-title title)))

(defn- ed-key-up? (input)
  "True if `input` is a key's release (`[:key-up k]`)."
  (and (vector? input) (= (first input) :key-up)))

(defn- ed-update-turn (m input cols rows)
  "The whole update: fold one key into the next model, then keep point on screen.
A `[:resize cols rows]` event just re-clamps the scroll to the new viewport and lets
the loop re-render (it isn't a command, so it doesn't touch the keymap or echo); a
`[:mouse …]` event is handled by `ed-mouse` (left-click selects the window under it,
a press on a divider begins a drag, `:drag` resizes it, `:release` ends it). Scroll
clamping uses the *selected pane's* height (`ed-selected-text-rows`), so it's correct
inside a split. Any non-system input is a key, routed by `ed-route-transient`: to the
open transient overlay (minibuffer / completion / isearch / query-replace) if one
owns it, else through the keymap (`ed-dispatch`).

The pipeline: [[ed-fold-input]], then `ed-post-step` schedules the debounced eldoc +
diagnostics check (off the per-key path — see model.blsp) and `ed-refresh-spans` refreshes
the fontify span cache for the new viewport (a no-op when nothing scrolled or changed —
`spancache`), then [[ed-loop-tail]]; a throw anywhere is [[ed-recover]]ed. The diff-hl git
annotation and the web-mirror snapshot push are NOT done on this per-event path — both can be
slow (a full-file diff; a fontify) — but debounced on the idle beat (`ed-timer-fire
:idle-recompute`)."
  (let ([textrows textcols] (ed-viewport m cols rows)
        ;; …and the WHOLE frame beside them (`:frame`), which is a different question: the
        ;; view rows are the selected pane's, and laying panes out (`ed-body-layout`) needs
        ;; the window. Anything reached OFF the render path — an async reply that appends to
        ;; a streaming buffer and wants to follow its tail — has no other way to ask, and
        ;; every such consumer inventing its own stash is how a model grows three of them.
        ;; The viewport goes on the model so page commands know it; the key is captured if a
        ;; macro is recording.
        m0 (ed-macro-record (assoc (dissoc m :command-failed)
                              :view-rows textrows
                              :view-cols textcols
                              :frame [cols rows])
             input))
    ;; a committed turn runs the commit steps (`model/register-commit-step`: the tree handles it
    ;; dropped freed); a rolled-back one never reaches them
    ;; each stage timed for a slow turn's report (`turnprofile`): where the time went, not
    ;; only which input it was
    (let (started (do (turnprofile/begin!) (os/now-ns))
          turned (ed-sync-title (ed-run-commit-steps m
                                  (try
                                    (let (folded (ed-staged "fold"
                                                   (fn ()
                                                     (ed-fold-input m0
                                                       input textrows textcols cols rows)))
                                          stepped (ed-staged "post-steps"
                                                    (fn () (ed-post-step folded input)))
                                          spanned (ed-staged "spans"
                                                    (fn ()
                                                      (ed-refresh-spans-guarded stepped cols rows))))
                                      (ed-staged "tail"
                                        (fn () (ed-loop-tail m0 spanned input cols rows))))
                                    (catch e (ed-recover m0 e input))))))
      (turnprofile/finish! "update" (- (os/now-ns) started))
      turned)))

(defn- ed-staged (name thunk)
  ;; `(thunk)`, a stage of the update: its time noted for a slow turn's report
  (let (started (os/now-ns)
        result (thunk))
    (turnprofile/stage! name (- (os/now-ns) started))
    result))

;; The loop's update contract, in types. `assoc` answers `vector | map` — a receiver's type
;; does not survive an update — so without it every caller that threads two events through
;; `ed-update` (mostly the tests) re-reports the width. Declaring it here moves the report
;; to ONE place; closing it for real means typing the `model -> model` chain through the
;; interior too (`ed-timer-fire`, `ui-event-fold`, `hosted-step`, `message`, …), whole,
;; since a narrow sig on an interior node with untyped callers only moves the reports upstream.
(sig ed-update (model any int int -> model))
(defn ed-update (m input cols rows)
  "ui-run update: fold one input into the next model. While a keyboard macro runs
(`:macro-run`) the input is [[ed-macro-input]]'s — the run's ticker, C-g, or typeahead that
waits for it; otherwise [[ed-update-direct]]."
  (if (nil? (:macro-run m))
    (ed-update-direct m input cols rows)
    (ed-macro-input m input cols rows)))

(sig ed-update-direct (model any int int -> model))
(defn- ed-update-direct (m input cols rows)
  "Fold one input into the next model — the whole pipeline ([[ed-update-turn]]) unless the
input can change nothing it would act on. Three can't:

- a key's release (`[:key-up k]`): nothing bedit keeps changes at a release (the desktop
  repeats a held key, brood ADR-441; `ui-run` holds the idle timers while one is down; and
  whether a press is a repeat is asked of the window as the press is folded,
  [[ed-key-repeat?]]), so `m` comes back as it was;
- an input a feature declares inert (`model/register-inert-input`: our OWN edit echoed back by a hosted buffer's process): the
  pool already has it, so `m` comes back as it was;
- a [[*cosmetic-timers*]] beat (the spinner, the scrollbar fade): only the
  field it animates changes ([[ed-cosmetic-fire]]).

Handing `m` back untouched is what lets `ui-run`'s `=` test see a turn that changed nothing
and draw nothing — our own echo would otherwise cost every keystroke on a hosted buffer a
second full update and a second frame.

Only a model that has had one full turn takes the short path (`:timers-synced?`, set by
`model/ed-sync-timers`): the model `main` starts the loop with was built outside it, and its
idle beat — the git summary, diff-hl, the diagnostics — is armed by the first full turn,
which a cosmetic tick as the first input would otherwise skip, leaving an editor left alone
at launch without its branch."
  (cond
    (not (:timers-synced? m)) (ed-update-tabbed m input cols rows)
    (ed-key-up? input) m
    (ed-inert-input? m input) m
    (ed-cosmetic-timer? input) (ed-cosmetic-fire m (nth input 1))
    else (ed-update-tabbed m input cols rows)))

;; check-allow: `with-cell-layout` runs its body in a thunk whose result the checker does not
;; carry; the body is `ed-update-turn`, which answers a model
(sig ed-update-tabbed (model any int int -> model))
(check-allow :trusted
  (defn- ed-update-tabbed (m input cols rows)
    "[[ed-update-turn]] with brood's `*tab-width*` bound to the current buffer's tab width
(`conventions/with-cell-layout`): the ONE place every fold of the model passes through, so a
command's goal column, a row motion, the scroll clamp and the view all measure a tab as the
buffer's. A measure that names ANOTHER buffer binds that one's itself (`wrap`'s buffer
functions, the view's pane, a click)."
    (conventions/with-cell-layout (ed-current-buf m) (fn () (ed-update-turn m input cols rows)))))

(defn ed-post-step (m input)
  "The post-event step run after `input/ed-update` folds an event in. The eldoc hint and
the advisory type-check are **debounced onto idle timers** (ADR-102; Emacs's idle-timer
model) — recomputing them per keystroke makes a large buffer crawl. So this recomputes
nothing directly; it reconciles `:timers` (`ed-sync-timers`) with the new model
state — arming the eldoc/diagnostics debounce, the which-key delay, and the undo-pause
boundary when each is due — and the timers' firing (in `input/ed-timer-fire`) does the
work; then runs the registered post-step hooks (`ed-run-post-steps`). Finally refreshes
the open minibuffer's memoized candidate list (`ed-cache-mb-candidates`) so the view/input
read it cheaply."
  (let (
        ;; what the input marks for the idle beat (a web mirror gone stale), before the
        ;; timers are reconciled so they arm for it
        touched (ed-run-input-steps m input)
        stepped (ed-run-post-steps (ed-sync-timers touched))
        mb (:minibuffer stepped))
    ;; Bring the candidate list up to date with the typed text: a small source ranks here on
    ;; the keystroke (instant), a large one ASKS its ranking session and folds the answer
    ;; when it arrives (`ed-cache-mb-candidates`). Either way this is O(1) on the event when
    ;; the text has not changed, which is every frame, tick and selection move.
    (if (or (nil? mb) (not (mb-source? mb))) stepped (ed-cache-mb-candidates stepped))))
