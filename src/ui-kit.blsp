(defmodule ui-kit
  "A small widget kit over the `editor/display` render ops. A **widget** is a pure function
`(area ctx) -> {:ops … :zones …}` that emits its paint AND its interaction zones in ONE
pass — so the hit-test is the zone list (`editor/display`'s `zone-at`), never a parallel
function that can drift out of sync. Styling is by SEMANTIC ROLE: the caller supplies a
`:theme` role→colour map in `ctx`, so the kit is theme-agnostic and the SAME widget renders
on both backends (the `card-*` primitives lower by `ctx`'s `:gui?` — rounded sub-cell in the
GUI, flat cells in the terminal). This is the shared shape behind the context menu, the
completion popup, Plume and which-key.

  area = [col row w h]   (a cell rect, same order as `zone`)
  ctx  = {:gui? bool :theme {<role> <colour> …}}

Roles the kit reads: :surface :on-surface :muted :selection :on-selection :border.

Dependency-light on purpose (only `editor/display`): the canonical home is
`../brood/std/editor/ui-kit.blsp` — promoting is a move + a `system.rs` registration."
  (:use editor/display)) ; text / rect / frect / card-surface / card-pill / zone
;; ---- style: semantic roles, one struct, dual lowering -----------------------

(defn ui-color (theme role)
  "A semantic role → a concrete colour via the caller's theme map, or nil (the primitive
then omits that channel)."
  (get theme role))

(defn ui-face (theme style)
  "The `{:fg :bg :bold}` face for a style — its `:fg`/`:bg` roles resolved against `theme`.
Backend-neutral; borders/radius are the panel/pill's job, not the face's."
  (merge (merge (if (:fg style) {:fg (ui-color theme (:fg style))} {})
           (if (:bg style) {:bg (ui-color theme (:bg style))} {}))
    (if (:bold style) {:bold true} {})))

;; ---- spacing: ONE table, token names only -----------------------------------
;; Every space the chrome puts between things comes from here (report §"One spacing table").
;; The units are the grid's own: ONE ROW vertically, ONE CELL horizontally. A row is about
;; twice as tall as a cell is wide, so padding that LOOKS equal on all four sides is 1 row
;; to 2 cells (ratatui's `Padding::proportional`). Half is the only fractional step, and
;; the hairline the only finer one; neither ever moves text — anything that holds text
;; moves by whole rows and cells (`ui-pad` refuses a fraction), and the sub-cell steps only
;; decorate inside a row (a hover block's inset, a scrollbar thumb off the edge).

(def ui-spacing
  ;; Primitives (a number), then the semantic tokens (an alias, or `[rows cells]` for a
  ;; box's padding). A widget style's `:pad` / `:inset` / `:gap`, and any spacing constant
  ;; outside this module, names one of these keys — tests/spacing_ratchet_test counts the
  ;; raw numbers that slipped past.
  {:none 0
   ;; a border's thickness in cells: the crisp ≈1px rule the chrome draws (docs/ui-chrome.md)
   :hairline 0.05
   :half 0.5
   :one 1
   :two 2
   :three 3
   ;; a raised card's default: 1 row : 2 cells, what LOOKS equal on all four sides
   :card [:one :two]
   ;; a menu card (the context menu, a transient): its selection pill is a full-width
   ;; surface of its own, so the card frames the PILL — a row above and below, a cell at
   ;; the sides — and the room goes inside the pill (`:menu-row-inset`)
   :menu [:one :one]
   ;; the frameless completion card and its info card: no rows above or below (it sits
   ;; on the line under point, as Corfu's does), a cell at each side
   :popup [:none :one]
   ;; a floating card's distance from the chrome it floats over (a mode line, the echo
   ;; area, a header line) and from the window's edges: a row above and below, a cell at
   ;; each side (`ui-place`) — so a card never sits on the bar under it
   :card-gap [:one :one]
   ;; a row's text inside its own width (and its selection pill), both sides
   :row-inset :one
   ;; a menu row's text inside its pill: 2 cells, so a highlighted item reads as a button
   ;; and its label sits 3 cells from the card's border
   :menu-row-inset :two
   ;; Vertico's list: the text flush with the prompt above it
   :flush :none
   ;; the least room between a row's label and its key column
   :key-gap :one
   ;; a menu's label and shortcut: `Select All` and `C-x h` must not read as one string
   :menu-key-gap :three
   ;; an end-of-line note after the line's own text
   :note-gap :three
   ;; a mode-line chip's hover block: half a cell out from the text at each side, a
   ;; hairline in from the bar's top and bottom edge
   :hover-pad :half
   :hover-inset :hairline
   ;; a scrollbar thumb's gap from the pane's right edge
   :thumb-inset :hairline})

(defn ui-space (token)
  "The length a spacing `token` names in `ui-spacing` — rows on a vertical axis, cells on a
horizontal one; an alias is followed. Anything that is not a token key RAISES: a raw number
in a spacing position is exactly the off-scale value the table exists to rule out.

    (ui-kit/ui-space :row-inset)   ;=> 1"
  (let (value (if (keyword? token) (get ui-spacing token) nil))
    (cond
      (number? value) value
      (keyword? value) (ui-space value)
      (vector? value) (error "ui-space: a box padding, not a length: " token)
      else (error "ui-space: not a spacing token (see ui-kit/ui-spacing): " token))))
(sig ui-space (keyword -> number))

(defn ui-space-box (token)
  "The `[top right bottom left]` padding a box token names: a `[rows cells]` entry, or one
length on every side. Raises on anything that is not a token, as `ui-space` does.

    (ui-kit/ui-space-box :card)   ;=> [1 2 1 2]"
  (let (value (if (keyword? token) (get ui-spacing token) nil))
    (if (vector? value)
      (let ([rows cells] value
            vertical (ui-space rows)
            horizontal (ui-space cells))
        [vertical horizontal vertical horizontal])
      (let (length (ui-space token)) [length length length length]))))
(sig ui-space-box (keyword -> vector))

(defn ui-space-cells (token)
  "A spacing `token` as whole cells or rows — what anything that places TEXT uses. A
fractional token (`:half`, `:hairline`) raises: text only ever moves by whole rows and
cells; the sub-cell steps are for decoration inside a row."
  (let (length (ui-space token))
    (if (int? length)
      length
      (error "ui-space-cells: text moves by whole rows and cells, not " token))))
(sig ui-space-cells (keyword -> int))

;; ---- geometry ---------------------------------------------------------------

(defn ui-pad-amount (pad side)
  "The padding for `side` (0=top 1=right 2=bottom 3=left) from `pad` — a box token of
`ui-spacing` (`:card`, `:popup`, …), or nil for none. Whole cells only: a card's padding
places its rows."
  (if (nil? pad)
    0
    (let (length (nth (ui-space-box pad) side))
      (if (int? length)
        length
        (error "ui-pad-amount: text moves by whole rows and cells, not " pad)))))
(sig ui-pad-amount (any int -> int))

(defn ui-pad (area pad)
  "Shrink rect `area` [col row w h] by the box token `pad` (nil for none)."
  (let ([col row w h] area
        t (ui-pad-amount pad 0)
        r (ui-pad-amount pad 1)
        b (ui-pad-amount pad 2)
        l (ui-pad-amount pad 3))
    [(+ col l) (+ row t) (math/max 0 (- w l r)) (math/max 0 (- h t b))]))

(defn ui-pad-size (pad)
  "`[w h]`: what the box token `pad` adds to a body's size — so a caller sizing a card
from its rows grows it by the same padding `ui-pad` takes back off."
  [(+ (ui-pad-amount pad 1) (ui-pad-amount pad 3)) (+ (ui-pad-amount pad 0) (ui-pad-amount pad 2))])
(sig ui-pad-size (any -> vector))

(deftype area (tuple int int int int))

;; ---- placing a floating card: ONE rule ---------------------------------------
;; Every card that floats over the editor — the transient, the context menu, the completion
;; card and its info card, the mode line's and a diagnostic's tooltip — is placed by
;; `ui-place`. The caller names where it WANTS the card and the STAGE it floats over: the
;; rows between the chrome (a header line above, a mode line or the echo area below) across
;; the window's width. The card keeps `:card-gap` from every side of the stage, so it never
;; sits on a mode line or under a header line and never touches a window edge; it gives up
;; the gap only when it cannot fit with it, and leaves the stage only when it cannot fit in
;; it at all (a card taller than the pane it floats over is still drawn whole).

(defn- ui-place-axis (start size low high gap-low gap-high screen)
  "One axis of `ui-place`: `start` moved so `[start, start+size)` lies inside
`[low+gap-low, high-gap-high)` — failing that inside `[low, high)`, failing that on the
`screen`."
  (let (clamp (fn (from to) (math/max from (math/min (- to size) start)))
        room-low (+ low gap-low)
        room-high (- high gap-high))
    (cond
      (<= size (- room-high room-low)) (clamp room-low room-high)
      (<= size (- high low)) (clamp low high)
      else (clamp 0 screen))))

(sig ui-place (any any int int -> area))
(defn ui-place (area stage cols rows)
  "Rect `area` [col row w h] slid to keep `:card-gap` from the edges of `stage` [col row w
h] — the rows a floating card may cover, between the chrome above and below it, across the
window's width. Without room for the gap the card keeps to the stage; without room in the
stage it keeps to the `cols`×`rows` screen. The one placement every floating card calls, so
a card a row from the mode line in one place is a row from it everywhere.

    (ui-kit/ui-place [0 17 10 4] [0 0 80 22] 80 24)   ;=> [1 17 10 4]"
  (let ([col row w h] area
        [stage-col stage-row stage-w stage-h] stage
        [gap-top gap-right gap-bottom gap-left] (ui-space-box :card-gap))
    (ui-area [(ui-place-axis col w stage-col (+ stage-col stage-w) gap-left gap-right cols)
               (ui-place-axis row h stage-row (+ stage-row stage-h) gap-top gap-bottom rows)
               w
               h])))

(sig ui-card-room (any -> area))
(defn ui-card-room (stage)
  "The part of `stage` a card may cover while keeping its `:card-gap` — for a caller that
must CHOOSE a side before placing (the completion card goes below point when it fits there,
else above)."
  (ui-area (ui-pad stage :card-gap)))

(sig ui-tooltip-area (int int any any int int -> area))
(defn ui-tooltip-area (anchor-row anchor-col lines stage cols rows)
  "Where a tooltip of `lines` goes for cell `(anchor-row, anchor-col)`: its bottom just
above the anchor, or just below it when the room above is too short, then `ui-place`d in
`stage`. Sized as `editor/display`'s `tooltip` sizes its card (the widest line plus a cell
each side), so drawing that tooltip anchored under the returned rect paints it there."
  (let (n (count lines)
        w (+ 2 (fold lines 0 (fn (widest line) (math/max widest (count line)))))
        above (- anchor-row n)
        row (if (>= above (second (ui-card-room stage))) above (inc anchor-row)))
    (ui-place [anchor-col row w n] stage cols rows)))

(sig ui-area (any -> area))
;; check-allow: the widget context is an open map, so the area read off it is unknown to the
;; checker; every caller builds it with `ui-area`'s own shape
(check-allow :trusted
  (defn ui-area (area)
    "The widget protocol's `area` as the rect it promises — for a widget written as a bare
`(fn (area ctx) …)`, whose parameter no `sig` can reach."
    area))

(sig ui-in-rect? (area int int -> bool))
(defn ui-in-rect? (area col row)
  "Whether cell `(col, row)` is inside rect `area` [col row w h]."
  (let ([c r w h] area)
    (and (>= col c) (< col (+ c w)) (>= row r) (< row (+ r h)))))

;; ---- render results ---------------------------------------------------------

(defn ui-empty () "The empty render result." {:ops [] :zones []})

(defn ui-merge (a b)
  "Concatenate two render results (`{:ops :zones}`), `a` painted under `b`."
  {:ops (append (:ops a) (:ops b)) :zones (append (:zones a) (:zones b))})

(defn ui-stack (results)
  "Merge a sequence of render results in paint order (first under last)."
  ;; Every result's ops and zones consed onto two REVERSED accumulators and reversed once —
  ;; a fold of `ui-merge` re-copied everything stacked so far for each result, quadratic
  ;; in a list's rows, and a Plume list is re-stacked on every key typed into the prompt.
  (if (empty? results)
    (ui-empty)
    (let (stacked (fold results
                    ['() '()]
                    (fn (acc result)
                      [(fold (:ops result) (first acc) (fn (ops op) (cons op ops)))
                        (fold (:zones result) (second acc) (fn (zones z) (cons z zones)))])))
      {:ops (reverse (first stacked)) :zones (reverse (second stacked))})))

;; ---- list layout: divider expansion (shared by measure + render) ------------

(defn- ui-list-rows (items rowfn selected &optional (base 0))
  "Materialise `items` (a visible slice) into screen rows: for slice position `j`, its
ABSOLUTE index is `(+ base j)` — so a windowed/scrolled list slices `items` and passes the
window start as `base`, and selection + zone ids stay in absolute terms. `(rowfn item i
(= i selected))` yields a row map; a row flagged `:sep` gets a divider screen-row ABOVE it.
Returns a vector of `{:kind :divider}` / `{:kind :item :index i :selected bool :row <rowmap>}`
— the one layout the measure and the render share, so a divider shifts item rows identically."
  (fold (range (count items))
    []
    (fn (acc j)
      (let (i (+ base j)
            r (rowfn (nth items j) i (= i selected))
            acc2 (if (:sep r) (conj acc {:kind :divider}) acc))
        (conj acc2 {:kind :item :index i :selected (= i selected) :row r})))))

(sig ui-clip (string int -> string))
(defn ui-clip (s w)
  "Fit string `s` to `w` display cells — truncated with a trailing … when longer (so a long
completion candidate never overruns its row / the marginalia column). Cells, not characters:
a CJK or emoji label measured by `length` overflowed its column."
  (if (<= w 1) (string/clip-cells s (math/max 0 w)) (string/clip-cells s w "…")))

(defn ui-row-inset (style)
  "How far a row's text sits inside its own width, on BOTH sides — the `:inset` token
(`ui-spacing`), default `:row-inset` (one cell).

The default is one cell, which is what every list here had when the label was placed at
`col + 1` and the key was pushed flush against the last cell. That asymmetry is invisible
until a row is selected, and then it is the only thing you can see: the highlight is a
pill, and the text touches its right edge while floating a cell off its left. A menu sets
`:menu-row-inset` (2 cells inside its pill, on a `:menu` card); Plume
is `:flush`, because its marginalia column is the width."
  (ui-space-cells (get style :inset :row-inset)))
(sig ui-row-inset (any -> int))

(defn ui-row-gap (style)
  "The least space between a row's label and its key column — the `:gap` token, default
`:key-gap` (one cell). What [[ui-list-measure]] reserves so the two never collide at the
widest row."
  (ui-space-cells (get style :gap :key-gap)))
(sig ui-row-gap (any -> int))

(defn- ui-row-label-room (w inset key gap)
  "The width a row's LABEL may take: the inner width less the `key` column and the `gap`
before it (nothing to leave when there is no key), never negative. Declared like
[[ui-row-inner]]: `math/max` over two ints reads as `number`."
  (math/max 0 (- (ui-row-inner w inset) (if (= key "") 0 (+ (string/display-width key) gap)))))
(sig ui-row-label-room (int int string int -> int))

(defn- ui-row-inner (w inset)
  "The width left for a row's own text once `inset` cells are taken off each side, never
negative. Declared, because `math/max` over two ints reads as `number` and both callers
hand the result to something that wants an `int`."
  (math/max 0 (- w (* 2 inset))))
(sig ui-row-inner (int int -> int))

(defn- ui-row-maxw (style)
  "The widest a list may measure itself, `:max-w` (default 44).

44 is tuned for a context menu — `Copy`, `Paste`, `Select All` — where a wide card over
the text would be the wrong shape. It is not a universal truth about lists, and a widget
whose rows are legitimately longer must be able to say so: the transient menu's rows are a
flag plus what it does, and under the fixed cap the flag — the one thing on the card that
says what will actually run — was clipped off the right-hand edge."
  (or (:max-w style) 44))

(defn ui-list-measure (items rowfn selected &optional (style nil))
  "`{:w :h}` for a list: inner width (widest `label` + gap + `key`, plus the row inset on
each side, clamped [12, `ui-row-maxw`]) and height in screen rows (items + dividers).

`style` is the same style the list will be rendered with, so the width it reserves and the
inset the rows actually use cannot disagree — measured without it, a roomier inset simply
ate into the gap and the key column crept left until it touched the label."
  (let (srows (ui-list-rows items rowfn selected)
        pad (+ (* 2 (ui-row-inset style)) (ui-row-gap style))
        w (fold srows
            0
            (fn (acc sr)
              (if (= (:kind sr) :item)
                (let (r (:row sr))
                  (math/max acc
                    (+ pad
                      (string/display-width (:label r))
                      (string/display-width (or (:key r) "")))))
                acc))))
    {:w (math/min (ui-row-maxw style) (math/max 12 w)) :h (count srows)}))

;; ---- widgets: panel + list --------------------------------------------------

(def ui-match-roles
  ;; the role a fuzzy query's Nth term paints its matched characters in, cycling past the
  ;; last — `theme/ui-ctx` binds them (orderless's `orderless-match-face-0..3`)
  [:match-0 :match-1 :match-2 :match-3])

(defn ui-label-ops (rr x label shown base-face marks theme sel?)
  "The paint for a row label shown as `shown` (`label` after `ui-clip`) at column `x`: one
`text` op when `marks` is empty, else the label in RUNS — each matched character in its
term's role (`ui-match-roles`, bold), the rest in `base-face` — laid side by side, so no
cell is painted twice. `marks` are `[index term]` pairs, an index into `label`; one the clip
cut off is not drawn. A selected row keeps its pill's text colour and shows a match by
weight alone: a palette colour on the selection pill is a contrast problem, not a highlight."
  (if (empty? marks)
    [(text rr x shown base-face)]
    ;; `ui-clip` ends a cut label in `…` — except in a row too narrow for one
    (let (kept (if (and (not (= shown label)) (string/ends-with? shown "…"))
                 (dec (count shown))
                 (count shown))
          by-index (fold marks
                     {}
                     (fn (acc [index term])
                       (if (and (>= index 0) (< index kept)) (assoc acc index term) acc)))
          face-of (fn (index)
                    (let (term (get by-index index))
                      (cond
                        (nil? term) base-face
                        sel? (ui-face theme {:fg :on-selection :bold true})
                        else
                          (ui-face theme
                            {:fg (nth ui-match-roles (math/mod term (count ui-match-roles)))
                             :bold true}))))
          [ops col run face] (fold (seq/enumerate (string/->list shown))
                               [[] x "" nil]
                               (fn ([ops col run face] [index ch])
                                 (let (f (face-of index))
                                   (if (or (= run "") (= f face))
                                     [ops col (str run ch) f]
                                     [(conj ops (text rr col run face))
                                       (+ col (string/display-width run))
                                       ch
                                       f])))))
      (if (= run "") ops (conj ops (text rr col run face))))))

(defn ui-row-ops (rr col w r sel? theme style gui?)
  "One list row's paint: a full-width selection highlight (a rounded pill in the GUI, a
solid bar in the terminal, and wherever the style says `:selection :bar`) when `sel?`, then the `:label` left + the `:key` right-aligned +
dim, the label dimmed when `:enabled` is false.

The label and the key are inset from the row's own edges by the SAME amount
([[ui-row-inset]]), so a selected row reads as text centred in a pill rather than text
shoved against one side of it."
  (let (key (or (:key r) "")
        inset (ui-row-inset style)
        ;; right-align the key to end `inset` cells short of the row's last cell, INSIDE
        ;; the highlight span [col, col+w) — so it sits within the pill by the same margin
        ;; the label has, rather than flush against its edge.
        kcol (+ col (math/max 0 (- w inset (string/display-width key))))
        label-face (cond
                     sel? (ui-face theme {:fg :on-selection}) ; the pill colour signals selection — no bold weight
                     (:enabled r) (ui-face theme {:fg :on-surface})
                     else (ui-face theme {:fg :muted}))
        ;; The key column's weight is the style's to choose (`:key-fg`, default `:muted`).
        ;; A menu wants it fainter than a disabled label, so the two are told apart by
        ;; colour and not only by which column they are in; Plume's marginalia is content
        ;; rather than a hint and keeps the default. Selected, it stays at full contrast:
        ;; legibility on the pill beats hierarchy, and a half-dimmed shortcut on a solid
        ;; blue bar is just hard to read.
        key-face (if sel?
                   (ui-face theme {:fg :on-selection})
                   (ui-face theme {:fg (get style :key-fg :muted)}))
        ;; a style may ask for the flat bar in the GUI too (`:selection :bar` — Plume, as Vertico)
        hl (cond
             (not sel?) []
             (and gui? (not (= (:selection style) :bar)))
               [(card-pill rr col w {:bg (ui-color theme :selection)})]
             else [(rect rr col w 1 (ui-face theme {:bg :selection}))])
        ;; the label stops short of the key column (and the gap before it): clipped to the
        ;; whole inner width, a long label on a capped row ran under its own shortcut
        label (ui-label-ops rr
                (+ col inset)
                (:label r)
                (ui-clip (:label r) (ui-row-label-room w inset key (ui-row-gap style)))
                label-face
                (or (:marks r) [])
                theme
                sel?)
        key-op (if (= key "") [] [(text rr kcol key key-face)]))
    (append hl (append label key-op))))

(defn- ui-list-divider (row col w theme style)
  "A divider row's paint: a rule inset to the row text's own margin, drawn in the BORDER
role rather than in `:muted`. A divider is a rule, not writing: in the text colour, full
width, it was the loudest thing in the card — heavier than the labels it was separating."
  (let (inset (ui-row-inset style))
    {:ops [(text row
             (+ col inset)
             (string/repeat "─" (ui-row-inner w inset))
             (ui-face theme {:fg :border}))]
     :zones []}))

(defn- ui-list-item (sr row col w theme style gui? tag)
  "An item row's paint and — when enabled — its click zone, id `[tag index]`."
  (let (r (:row sr))
    {:ops (ui-row-ops row col w r (:selected sr) theme style gui?)
     :zones (if (:enabled r) [(zone [col row w 1] [tag (:index sr)] :pointer)] [])}))

(defn ui-list (spec)
  "A vertical selectable list — the shared widget behind the context menu, the completion
popup, Plume and which-key. Returns a widget fn `(area ctx) -> {:ops :zones}`.

`spec`:
  :items     a vector of row values (a windowed list passes only the VISIBLE slice)
  :selected  the selected index, in ABSOLUTE terms (or nil)
  :base      the absolute index of `items`' first element (default 0) — so a windowed list
             slices `items` and passes its window start here, keeping selection + zone ids
             absolute even though only the slice is rendered
  :row       `(item i selected?) -> {:label :key :enabled :sep :marks}` — the row's content;
             `:marks` (`[index term]` pairs into the label) paints matched characters in
             their term's role (`ui-label-ops`);
             `:sep true` draws a divider rule above the row and gets no click zone
  :tag       the zone id tag — a click on enabled row `i` yields the zone id `[tag i]`
  :style     a style whose fg/bg roles paint the rows

Each row emits its paint AND (for an enabled item) its click zone in the same step, so the
returned `:zones` ARE the hit-test (`zone-at`) and the pointer-shape source
(`zone-cursor-ops`) — there is no separate hit-test to fall out of sync."
  (fn (area ctx)
    (let ([col row w _h] (ui-area area)
          theme (:theme ctx)
          style (:style spec)
          srows (ui-list-rows (:items spec) (:row spec) (:selected spec) (or (:base spec) 0)))
      (ui-stack (map (seq/enumerate srows)
                  (fn ([si sr])
                    (if (= (:kind sr) :divider)
                      (ui-list-divider (+ row si) col w theme style)
                      (ui-list-item sr (+ row si) col w theme style (:gui? ctx) (:tag spec)))))))))

(sig ui-panel (area any any any -> map))
(defn ui-panel (area ctx style body)
  "A raised floating card at `area`: the `card-surface` (a rounded frect + a hairline
border in the GUI when `style` has a truthy `:border`, a flat filled panel in the terminal —
it already lowers by `:gui?`), then the `body` widget rendered in the padded inner area.
Surfaces + hairlines, never a shadow (dark-UI chrome — see docs/ui-chrome.md)."
  (let ([col row w h] area
        theme (:theme ctx)
        opts (if (:border style)
               {:border (ui-color theme :border) :radius (or (:radius style) 0.5)}
               {:radius (or (:radius style) 0.5)})
        surface (card-surface row col w h (ui-face theme style) (:gui? ctx) opts)
        inner (ui-pad area (:pad style))
        body-res (body inner ctx))
    {:ops (append surface (:ops body-res)) :zones (:zones body-res)}))

;; ---- assembling a frame's ops: one pass, not an `append` per layer ------------------
;; A frame is a few hundred ops built in a dozen layers per pane. Spliced together with
;; `append` at every level (row → body → layers → pane → frame), each op was copied twice
;; per level it passed through — `append` walks every argument but the last twice — so the
;; same ops were re-copied five or six times on their way to the screen. The layers now
;; hand back their op lists as GROUPS, and `ed-flatten-ops` copies each op exactly once.

(defn ed-push-op (acc op)
  "`op` consed onto the reversed accumulator `acc` — the fold step every flattening walk
here shares; a nil op (a layer's absent caret, say) is dropped, as `frame` would."
  (if (nil? op) acc (cons op acc)))

(defn ed-flatten-ops (groups)
  "The ops of every op list in `groups` (lists or vectors, nil for an empty one), in order,
as ONE list with nils dropped — a single copy of each op."
  (reverse (fold groups '() (fn (acc group) (fold group acc ed-push-op)))))

(defn ed-fit-cells (s w)
  "Clip `s` to `w` display cells — the tab-free, width-aware clip a laid-out chunk needs
(`ed-fit` clips by character, before layout). std's `string/clip-cells`, which the mode
line and the widgets measure with too."
  (string/clip-cells s w))

;; eolnotes/eol-notes and eolnotes/eol-note-at (the shared end-of-line annotation) are
;; referenced qualified below — each `mod/name` auto-loads its module.
(sig ed-fit (string int -> string))
(defn ed-fit (s w)
  "Clip string `s` to `w` columns (long lines don't wrap — v1 has no h-scroll)."
  (if (> (count s) w) (string/substring s 0 w) s))
