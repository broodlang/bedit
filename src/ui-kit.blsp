(defmodule ui-kit
  "A small widget kit over the `editor/display` render ops. A **widget** is a pure function
`(area ctx) -> {:ops … :zones …}` that emits its paint AND its interaction zones in ONE
pass — so the hit-test is the zone list (`editor/display`'s `zone-at`), never a parallel
function that can drift out of sync. Styling is by SEMANTIC ROLE: the caller supplies a
`:theme` role→colour map in `ctx`, so the kit is theme-agnostic and the SAME widget renders
on both backends (the `card-*` primitives lower by `ctx`'s `:gui?` — rounded sub-cell in the
GUI, flat cells in the terminal). This is the shared shape behind the context menu, the
completion popup, Plume and which-key.

  area = [col row w h]   (a cell rect, same order as `zone`)
  ctx  = {:gui? bool :theme {<role> <colour> …}}

Roles the kit reads: :surface :on-surface :muted :selection :on-selection :border.

Dependency-light on purpose (only `editor/display`): the canonical home is
`../brood/std/editor/ui-kit.blsp` — promoting is a move + a `system.rs` registration."
  (:use editor/display)) ; text / rect / frect / card-surface / card-pill / zone
;; ---- style: semantic roles, one struct, dual lowering -----------------------

(defn ui-color (theme role)
  "A semantic role → a concrete colour via the caller's theme map, or nil (the primitive
then omits that channel)."
  (get theme role))

(defn ui-face (theme style)
  "The `{:fg :bg :bold}` face for a style — its `:fg`/`:bg` roles resolved against `theme`.
Backend-neutral; borders/radius are the panel/pill's job, not the face's."
  (merge (merge (if (:fg style) {:fg (ui-color theme (:fg style))} {})
           (if (:bg style) {:bg (ui-color theme (:bg style))} {}))
    (if (:bold style) {:bold true} {})))

;; ---- geometry ---------------------------------------------------------------

(defn ui-pad-amount (pad side)
  "The padding for `side` (0=top 1=right 2=bottom 3=left) from `pad` — an int (all sides)
or a `[t r b l]` vector."
  (cond
    (nil? pad) 0
    (int? pad) pad
    else (nth pad side 0)))

(defn ui-pad (area pad)
  "Shrink rect `area` [col row w h] by `pad` (an int or `[t r b l]`)."
  (let ([col row w h] area
        t (ui-pad-amount pad 0)
        r (ui-pad-amount pad 1)
        b (ui-pad-amount pad 2)
        l (ui-pad-amount pad 3))
    [(+ col l) (+ row t) (math/max 0 (- w l r)) (math/max 0 (- h t b))]))

(defn ui-clamp (area cols rows)
  "Shift rect `area` [col row w h] so it stays fully on the `cols`×`rows` screen — a popup
near an edge slides into view (the `card-rect` discipline, shared by render + hit-test)."
  (let ([col row w h] area)
    [(math/max 0 (math/min (- cols w) col)) (math/max 0 (math/min (- rows h) row)) w h]))

(deftype area (tuple int int int int))
(sig ui-area (any -> area))
;; check-allow: the widget context is an open map, so the area read off it is unknown to the
;; checker; every caller builds it with `ui-area`'s own shape
(check-allow :trusted
  (defn ui-area (area)
    "The widget protocol's `area` as the rect it promises — for a widget written as a bare
`(fn (area ctx) …)`, whose parameter no `sig` can reach."
    area))

(sig ui-in-rect? (area int int -> bool))
(defn ui-in-rect? (area col row)
  "Whether cell `(col, row)` is inside rect `area` [col row w h]."
  (let ([c r w h] area)
    (and (>= col c) (< col (+ c w)) (>= row r) (< row (+ r h)))))

;; ---- render results ---------------------------------------------------------

(defn ui-empty () "The empty render result." {:ops [] :zones []})

(defn ui-merge (a b)
  "Concatenate two render results (`{:ops :zones}`), `a` painted under `b`."
  {:ops (append (:ops a) (:ops b)) :zones (append (:zones a) (:zones b))})

(defn ui-stack (results)
  "Merge a sequence of render results in paint order (first under last)."
  (fold results (ui-empty) ui-merge))

;; ---- list layout: divider expansion (shared by measure + render) ------------

(defn ui-list-rows (items rowfn selected &optional (base 0))
  "Materialise `items` (a visible slice) into screen rows: for slice position `j`, its
ABSOLUTE index is `(+ base j)` — so a windowed/scrolled list slices `items` and passes the
window start as `base`, and selection + zone ids stay in absolute terms. `(rowfn item i
(= i selected))` yields a row map; a row flagged `:sep` gets a divider screen-row ABOVE it.
Returns a vector of `{:kind :divider}` / `{:kind :item :index i :selected bool :row <rowmap>}`
— the one layout the measure and the render share, so a divider shifts item rows identically."
  (fold (range (count items))
    []
    (fn (acc j)
      (let (i (+ base j)
            r (rowfn (nth items j) i (= i selected))
            acc2 (if (:sep r) (conj acc {:kind :divider}) acc))
        (conj acc2 {:kind :item :index i :selected (= i selected) :row r})))))

(sig ui-clip (string int -> string))
(defn ui-clip (s w)
  "Fit string `s` to `w` display cells — truncated with a trailing … when longer (so a long
completion candidate never overruns its row / the marginalia column). Cells, not characters:
a CJK or emoji label measured by `length` overflowed its column."
  (if (<= w 1) (string/clip-cells s (math/max 0 w)) (string/clip-cells s w "…")))

(defn ui-row-inset (style)
  "How far a row's text sits inside its own width, on BOTH sides — `:inset`, default 1.

The default is one cell, which is what every list here had when the label was placed at
`col + 1` and the key was pushed flush against the last cell. That asymmetry is invisible
until a row is selected, and then it is the only thing you can see: the highlight is a
pill, and the text touches its right edge while floating a cell off its left. A menu sets
a roomier inset; Plume keeps the tight one, because its marginalia column is the width."
  (get style :inset 1))

(defn ui-row-gap (style)
  "The least space between a row's label and its key column — `:gap`, default 1. What
[[ui-list-measure]] reserves so the two never collide at the widest row."
  (get style :gap 1))

(defn ui-row-inner (w inset)
  "The width left for a row's own text once `inset` cells are taken off each side, never
negative. Declared, because `math/max` over two ints reads as `number` and both callers
hand the result to something that wants an `int`."
  (math/max 0 (- w (* 2 inset))))
(sig ui-row-inner (int int -> int))

(defn ui-row-maxw (style)
  "The widest a list may measure itself, `:max-w` (default 44).

44 is tuned for a context menu — `Copy`, `Paste`, `Select All` — where a wide card over
the text would be the wrong shape. It is not a universal truth about lists, and a widget
whose rows are legitimately longer must be able to say so: the transient menu's rows are a
flag plus what it does, and under the fixed cap the flag — the one thing on the card that
says what will actually run — was clipped off the right-hand edge."
  (or (:max-w style) 44))

(defn ui-list-measure (items rowfn selected &optional (style nil))
  "`{:w :h}` for a list: inner width (widest `label` + gap + `key`, plus the row inset on
each side, clamped [12, `ui-row-maxw`]) and height in screen rows (items + dividers).

`style` is the same style the list will be rendered with, so the width it reserves and the
inset the rows actually use cannot disagree — measured without it, a roomier inset simply
ate into the gap and the key column crept left until it touched the label."
  (let (srows (ui-list-rows items rowfn selected)
        pad (+ (* 2 (ui-row-inset style)) (ui-row-gap style))
        w (fold srows
            0
            (fn (acc sr)
              (if (= (:kind sr) :item)
                (let (r (:row sr))
                  (math/max acc
                    (+ pad (string/display-width (:label r)) (string/display-width (or (:key r) "")))))
                acc))))
    {:w (math/min (ui-row-maxw style) (math/max 12 w)) :h (count srows)}))

;; ---- widgets: panel + list --------------------------------------------------

(defn ui-row-ops (rr col w r sel? theme style gui?)
  "One list row's paint: a full-width selection highlight (a rounded pill in the GUI, a
solid bar in the terminal) when `sel?`, then the `:label` left + the `:key` right-aligned +
dim, the label dimmed when `:enabled` is false.

The label and the key are inset from the row's own edges by the SAME amount
([[ui-row-inset]]), so a selected row reads as text centred in a pill rather than text
shoved against one side of it."
  (let (key (or (:key r) "")
        inset (ui-row-inset style)
        ;; right-align the key to end `inset` cells short of the row's last cell, INSIDE
        ;; the highlight span [col, col+w) — so it sits within the pill by the same margin
        ;; the label has, rather than flush against its edge.
        kcol (+ col (math/max 0 (- w inset (string/display-width key))))
        label-face (cond
                     sel? (ui-face theme {:fg :on-selection}) ; the pill colour signals selection — no bold weight
                     (:enabled r) (ui-face theme {:fg :on-surface})
                     else (ui-face theme {:fg :muted}))
        ;; The key column's weight is the style's to choose (`:key-fg`, default `:muted`).
        ;; A menu wants it fainter than a disabled label, so the two are told apart by
        ;; colour and not only by which column they are in; Plume's marginalia is content
        ;; rather than a hint and keeps the default. Selected, it stays at full contrast:
        ;; legibility on the pill beats hierarchy, and a half-dimmed shortcut on a solid
        ;; blue bar is just hard to read.
        key-face (if sel?
                   (ui-face theme {:fg :on-selection})
                   (ui-face theme {:fg (get style :key-fg :muted)}))
        hl (cond
             (not sel?) []
             gui? [(card-pill rr col w {:bg (ui-color theme :selection)})]
             else [(rect rr col w 1 (ui-face theme {:bg :selection}))])
        ;; the label stops short of the key column (and the gap before it): clipped to the
        ;; whole inner width, a long label on a capped row ran under its own shortcut
        label-room (- (ui-row-inner w inset)
                     (if (= key "") 0 (+ (string/display-width key) (ui-row-gap style))))
        label [(text rr (+ col inset) (ui-clip (:label r) (math/max 0 label-room)) label-face)]
        key-op (if (= key "") [] [(text rr kcol key key-face)]))
    (append hl (append label key-op))))

(defn ui-list (spec)
  "A vertical selectable list — the shared widget behind the context menu, the completion
popup, Plume and which-key. Returns a widget fn `(area ctx) -> {:ops :zones}`.

`spec`:
  :items     a vector of row values (a windowed list passes only the VISIBLE slice)
  :selected  the selected index, in ABSOLUTE terms (or nil)
  :base      the absolute index of `items`' first element (default 0) — so a windowed list
             slices `items` and passes its window start here, keeping selection + zone ids
             absolute even though only the slice is rendered
  :row       `(item i selected?) -> {:label :key :enabled :sep}` — the row's content;
             `:sep true` draws a divider rule above the row and gets no click zone
  :tag       the zone id tag — a click on enabled row `i` yields the zone id `[tag i]`
  :style     a style whose fg/bg roles paint the rows

Each row emits its paint AND (for an enabled item) its click zone in the same step, so the
returned `:zones` ARE the hit-test (`zone-at`) and the pointer-shape source
(`zone-cursor-ops`) — there is no separate hit-test to fall out of sync."
  (fn (area ctx)
    (let ([col row w h] (ui-area area)
          theme (:theme ctx)
          gui? (:gui? ctx)
          srows (ui-list-rows (:items spec) (:row spec) (:selected spec) (or (:base spec) 0))
          tag (:tag spec)
          style (:style spec))
      (ui-stack (map (range (count srows))
                  (fn (si)
                    (let (sr (nth srows si) rr (+ row si))
                      (if (= (:kind sr) :divider)
                        ;; Inset to the row text's own margin, and drawn in the BORDER
                        ;; role rather than in `:muted`. A divider is a rule, not writing:
                        ;; in the text colour, full width, it was the loudest thing in the
                        ;; card — heavier than the labels it was separating.
                        (let (inset (ui-row-inset style))
                          {:ops [(text rr
                                   (+ col inset)
                                   (string/repeat "─" (ui-row-inner w inset))
                                   (ui-face theme {:fg :border}))]
                           :zones []})
                        (let (r (:row sr))
                          {:ops (ui-row-ops rr col w r (:selected sr) theme style gui?)
                           :zones (if (:enabled r)
                                    [(zone [col rr w 1] [tag (:index sr)] :pointer)]
                                    [])})))))))))

(sig ui-panel (area any any any -> map))
(defn ui-panel (area ctx style body)
  "A raised floating card at `area`: the `card-surface` (a rounded frect + a hairline
border in the GUI when `style` has a truthy `:border`, a flat filled panel in the terminal —
it already lowers by `:gui?`), then the `body` widget rendered in the padded inner area.
Surfaces + hairlines, never a shadow (dark-UI chrome — see docs/ui-chrome.md)."
  (let ([col row w h] area
        theme (:theme ctx)
        opts (if (:border style)
               {:border (ui-color theme :border) :radius (or (:radius style) 0.5)}
               {:radius (or (:radius style) 0.5)})
        surface (card-surface row col w h (ui-face theme style) (:gui? ctx) opts)
        inner (ui-pad area (:pad style))
        body-res (body inner ctx))
    {:ops (append surface (:ops body-res)) :zones (:zones body-res)}))
