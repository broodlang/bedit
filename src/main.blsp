(defmodule main
  "myedit — a small Emacs-style GUI text editor, written in Brood on the editor
toolkit. This file is just the **entry point**: it opens a window and runs the
`ui-run` loop, wiring together the layers that live in their own files —

  - `model`    — the `ui-run` model + scrolling                (src/model.blsp)
  - `view`     — render a frame from the model                 (src/view.blsp)
  - `commands` — editing commands, each a `model -> model`      (src/commands.blsp)
  - `input`    — fold a key event into the next model           (src/input.blsp)

and three std modules underneath: `buffer` (the rope-backed model), `display`
(render ops), and `ui` (`ui-run` over `(gui-display)`, a native window). Nothing
custom in any kernel — see CLAUDE.md.

Run it:

    nest run                 ; a *scratch* buffer
    nest run -- notes.txt    ; open (and Ctrl-S saves) that file

Keys: printable inserts, arrows move, Home/End jump line ends, Enter splits,
Backspace/Delete remove, Ctrl-S saves, Esc / Ctrl-C / the window close button
quits. (Emacs keybindings + eval-in-buffer are the next step — see CLAUDE.md.)"
  (:use ui)       ; gui-display + the ui-run loop
  (:use model)    ; ed-init
  (:use view)     ; ed-view
  (:use input)    ; ed-update
  (:use buffer))  ; make-buffer / buffer-from-file

(def *welcome*
  "hello — a tiny editor on the rope buffer framework.\n\nType to edit · arrows move · Enter splits · Backspace deletes · Ctrl-S saves\nEsc (or the window's close button) quits.\n")

(defn main (&optional file)
  "Open the editor in a native window. With a `file` argument (`nest run --
<path>`) it edits that file and Ctrl-S saves it; with none, a *scratch* buffer.
Swap `(gui-display)` for `*term-display*` to run in the terminal instead."
  (let (buf (if (nil? file) (make-buffer *welcome*) (buffer-from-file file)))
    (ui-run (ed-init buf) ed-view ed-update (gui-display))))
