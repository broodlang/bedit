(defmodule grammars
  "Managing the tree-sitter grammars — `M-x grammar-list`, `M-x grammar-reload`, and the
recipe for building one.

A grammar is a shared library in `~/.config/bedit/grammars/`, named
`libtree-sitter-<lang>.so`, loaded at startup by `modes/load-user-grammars`. Upgrading
one was therefore \"replace the file and restart the editor\", which is a poor answer for
the one thing you are most likely to be iterating on when a language colours wrongly.

The runtime already supports better: `tree-sitter-load-grammar` deliberately overrides a
grammar of the same name, and clears both the parser pool and the tree cache so nothing
survives the swap holding pointers into the old library. So a reload is a real reload —
drop in a new `.so`, run `M-x grammar-reload`, and the next keystroke is parsed by it.

What is NOT here is a downloader. Fetching and compiling a grammar needs the network and
a C toolchain, and an editor that quietly shells out to both is doing something the user
should have asked for explicitly. `M-x grammar-list` prints the build recipe instead, so
the command you need is in front of you rather than in a README."
  (:use model) ; message / ed-current-buf
  (:use commands) ; ed-show-named
  (:use interactive)) ; defcommand

(def *grammar-buffer* "*Grammars*")

(defn grammar-files ()
  "The `[lang path]` pairs for every grammar library in the user's grammar directory."
  (let (dir (modes/ts-grammar-dir))
    (if (not (file/dir? dir))
      '()
      (seq/keep (or (file/list-files dir) '())
        (fn (name)
          (when (and (string/starts-with? name "libtree-sitter-") (string/ends-with? name ".so"))
            [(string/substring name
               (string/length "libtree-sitter-")
               (- (string/length name) (string/length ".so")))
              (path/join dir name)]))))))

(defn grammar-abi (lang path)
  "The ABI version reported by loading `path` as `lang`, or the error text. Loading is how
you ask — a grammar's ABI lives in the library, and `tree-sitter-load-grammar` returns it."
  (check-allow :discarded-catch
    (try (%tree-sitter-load-grammar path (keyword lang)) (catch e (error-message e)))))

(defn- grammar-row (pair)
  (let ([lang path] pair
        abi (grammar-abi lang path)
        size (check-allow :discarded-catch (try (get (file/stat path) :size) (catch _ nil))))
    (str "  " (string/pad-right lang 12)
      " abi " (string/pad-right (->string abi) 6)
      " " (if size (str (math/floor (/ size 1024)) "K ") "")
      path)))

(defn grammar-report ()
  "The *Grammars* buffer's text: what is installed, what the runtime has built in, and how
to build another."
  (let (files (grammar-files)
        dir (modes/ts-grammar-dir))
    (string/join
      (append
        (list "-*- tree-sitter grammars -*-"
          ""
          (str "loaded from " dir)
          "")
        (if (empty? files)
          (list "  (none installed)" "")
          (append (into [] (map files grammar-row)) (list "")))
        (list "built into this runtime: elixir, ruby (nest --features treesit-grammars)"
          ""
          "To upgrade one, replace the library and reload — no restart:"
          ""
          "    git clone --depth=1 https://github.com/tree-sitter/tree-sitter-<lang>"
          "    cd tree-sitter-<lang>"
          "    cc -shared -fPIC -Isrc -O2 -o libtree-sitter-<lang>.so \\\\"
          "       src/parser.c $(ls src/scanner.c 2>/dev/null)"
          (str "    cp libtree-sitter-<lang>.so " dir "/")
          ""
          "    M-x grammar-reload"
          ""
          "A grammar built for a tree-sitter this runtime cannot drive is refused by ABI"
          "with the range it accepts — a message, never a crash."))
      "\n")))

(defcommand cmd-grammar-list
  (m key)
  "Show the installed tree-sitter grammars, their ABI versions, and how to build one
(M-x grammar-list)."
  (ed-show-named m *grammar-buffer* (grammar-report)))

(defcommand cmd-grammar-reload
  (m key)
  "Re-load every grammar from the user's grammar directory (M-x grammar-reload) — the
upgrade path: replace the `.so` and run this, without restarting.

Safe because the runtime treats a re-load as a swap: it overrides the registration, drops
the pooled parsers bound to the old library, and clears the cached trees, which were
shaped by it. Anything that survived would be holding pointers into a library the next
parse no longer uses."
  (let (loaded (modes/load-user-grammars))
    (message m
      (if (empty? loaded)
        (str "no grammars in " (modes/ts-grammar-dir))
        (str "reloaded " (string/join (map loaded ->string) ", "))))))
