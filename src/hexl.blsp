(defmodule hexl
  "Emacs `hexl-mode`: a binary file (an ELF, a PNG, a .o: `charset/detect`) opened as a read-only
hex view — xxd rows, the `:hexl` mode's fontifier, and the open itself, which `pool`'s
`ed-find-file` reaches late-bound (`hexl/ed-open-binary`) when a decode would fail.

The mode (`modes/hexl-mode-layer`) declares the view unwritable with its `:no-write`
facet, so the save / write commands refuse it without naming it."
  (:use model) ; message / ed-current-buf / ed-set-buf
  (:use pool) ; ed-show-named — the read-only view buffer
  (:use projects) ; file-display-name — the view is named for its file
  (:use theme)) ; the palette the dim columns are drawn from

;; ---- hexl: a binary file as a hex view ---------------------------------------
;; `find-file` on a file that is not text (an ELF, a PNG, a .o) opens it as Emacs's
;; `hexl-mode` does: a read-only `:hexl` buffer of xxd-style rows — offset,
;; sixteen bytes as hex pairs, the printable ASCII beside — capped at `*hexl-cap*`
;; bytes with a header saying so, because the rows are built in Brood and a
;; multi-megabyte object file is not what anyone reads by eye.

(defdyn *hexl-cap* 65536) ; bytes of a binary shown (4096 rows)
(sig *hexl-cap* int)
(def- hexl-row-bytes 16)

(defn- hexl-ascii (byte)
  "The ASCII column's character for `byte`: printable 7-bit as itself, else `.`."
  (if (and (>= byte 32) (< byte 127)) (string/codepoints-> (list byte)) "."))

(defn hexl-row (bytes offset size)
  "One xxd row for the `size` bytes of `bytes` from `offset`: `00000010: 7f45 4c46 … |.ELF…|`.
Pure over the bytes value; the row is padded so the ASCII column lines up on a short
last row."
  (letrec (go (fn (j hex ascii)
                (if (>= j hexl-row-bytes)
                  (str (string/format "%08x: " offset) hex "  " (string/trim-right ascii))
                  (let (separator (if (and (> j 0) (= 0 (math/rem j 2))) " " "")
                        in? (< j size)
                        byte (if in? (nth bytes (+ offset j) 0) 0))
                    (go (inc j)
                      (str hex separator (if in? (string/format "%02x" byte) "  "))
                      (str ascii (if in? (hexl-ascii byte) " ")))))))
    (go 0 "" "")))

(defn hexl-text (bytes)
  "The hex view of `bytes`: a header line, then a row per sixteen bytes up to
`*hexl-cap*`."
  (let (total (count bytes)
        shown (math/min total *hexl-cap*)
        rows (math/quot (+ shown (dec hexl-row-bytes)) hexl-row-bytes)
        header (if (> total shown)
                 (str ";; binary file: " total " bytes — the first " shown " shown (read-only)")
                 (str ";; binary file: " total " bytes (read-only)")))
    (string/join (cons header
                   (map (range rows)
                     (fn (row)
                       (let (offset (* row hexl-row-bytes))
                         (hexl-row bytes offset (math/min hexl-row-bytes (- shown offset)))))))
      "\n")))

;; The hex view's `:fontify` service: a row is `<8 hex offset>: <hex pairs>  <ascii>` —
;; the offset dim (a line number), the pairs in the text colour, a zero pair dimmer
;; still (padding reads as structure at a glance), the ASCII column as a string; the
;; header as a comment. Line-structural, so a windowed slice fontifies wherever it starts.

(theme/defchrome face-hexl-dim {:fg *overlay0*}) ; the offset column and the `00` pairs
(def- hexl-hex-col 10) ; the first hex pair's column: 8 offset digits, `:`, a space
(def- hexl-ascii-col (+ hexl-hex-col 39 2)) ; 16 pairs + 7 group spaces, then two spaces
(sig hexl-ascii-col int)

(defn- hexl-pair-spans (line offset i end acc)
  "The dim spans over the zero pairs (`00`) of row `line` between hex columns `i`..`end`."
  (if (>= i end)
    acc
    (let (pair (string/substring line i (math/min end (+ i 2))))
      (hexl-pair-spans line
        offset
        ;; pairs sit at +0 and +2 of each `xxxx ` group of five columns
        (+ i (if (= 0 (math/rem (- i hexl-hex-col) 5)) 2 3))
        end
        (if (= pair "00") (cons [(+ offset i) (+ offset i 2) face-hexl-dim] acc) acc)))))
(sig hexl-pair-spans (string int int int list -> list))

(defn- hexl-line-spans (line offset)
  "The spans for one hex-view line at absolute offset `offset`."
  (let (size (count line))
    (cond
      (string/starts-with? line ";;")
        (list [offset (+ offset size) (editor/face/face :syntax/comment)])
      (and (>= size hexl-hex-col) (= (string/substring line 8 9) ":"))
        (append (list [offset (+ offset 8) face-hexl-dim])
          (reverse (hexl-pair-spans line
                     offset
                     hexl-hex-col
                     (math/min size (- hexl-ascii-col 2))
                     '()))
          (if (> size hexl-ascii-col)
            (list [(+ offset hexl-ascii-col) (+ offset size) (editor/face/face :syntax/string)])
            '()))
      else '())))

(defn hexl-fontify (source)
  "The hex view's `:fontify` service: `[start end face]` spans for a slice `source` of a
`:hexl` buffer — offsets dim, zero bytes dimmer, the ASCII column as a string, the
header as a comment."
  (modes/fontify-lines source hexl-line-spans))

(defn ed-open-binary (m path root &optional bytes)
  "Open `path` (an existing file that is not UTF-8) as a `:hexl` buffer — Emacs
`hexl-mode`, read-only. Its `:file` is kept so the mode line names it and `C-x C-j`
lands in its directory, but there is no saving a hex view. `bytes` are the file's when
the caller has read them already (find-file did, to learn it is not text)."
  (let (contents (if (nil? bytes) (file/slurp-bytes path) bytes)
        shown (ed-show-named m (file-display-name path root) (hexl-text contents) :hexl))
    (message (ed-set-buf shown (assoc (ed-current-buf shown) :file path :dir (path/dirname path)))
      (str "opened " path " as hex (binary, " (count contents) " bytes)"))))

;; A file that is not text opens as the hex view.
(register-presenter :binary 'hexl/ed-open-binary)
