(defmodule backup
  "BACKUP FILES (Emacs's `make-backup-files`, with `backup-directory-alist` pointing at one
folder): the first time a buffer saves over its file in a session, the file as it was is
copied first to `state/backups/` — owner-only, named by its whole path — so a save that
replaced the wrong text can be undone without version control. An auto-save sidecar keeps
what was TYPED; this keeps what was on DISK. One copy per file, the newest first save's.
Plain local files only: a file another machine or root holds is its handler's."
  (:use editor/buffer :only [buffer-file]))

(defn backup-dir ()
  "Where backup files go: the editor's state folder, `…/bedit/state/backups` — never beside
the file, where they would litter a project and show in its listings."
  (path/join (config-paths/config-dir) "state" "backups"))

(defn backup-name (path)
  "The backup's name for the file at absolute `path`: the path made a file name as a private
sidecar's is (`sidecar/path-file-name`: percent-encoded, so no two files share one) and a `~`.

    (backup/backup-name \"/home/me/notes.txt\")   ;=> \"%2Fhome%2Fme%2Fnotes.txt~\""
  (str (sidecar/path-file-name path) "~"))

(defn backup-path (path)
  "Where the file at `path` is backed up ([[backup-dir]], [[backup-name]])."
  (path/join (backup-dir) (backup-name path)))

(defn backup-wanted? (m buffer)
  "Whether saving `buffer` should back its file up first: backups on (`:make-backup-files`),
a plain local file (no file handler), and not yet backed up this session (`:backed-up`)."
  (let (file (buffer-file buffer))
    (and (:make-backup-files m)
      (not (nil? file))
      (not (:backed-up buffer))
      (nil? (model/ed-buffer-handler buffer)))))

(defn make-backup (file)
  "Copy `file` as it is on disk to its backup ([[backup-path]]), owner-only, the folder made
owner-only too. Nothing when `file` is not a regular file (new, or a directory). Never raises:
a backup that cannot be made must not stop the save — the reason comes back, nil when it went."
  (try
    (when (file/regular? file)
      (let (target (backup-path file))
        (do
          (file/mkdir-private (backup-dir))
          (file/cp file target)
          (file/chmod target 384)
          nil)))
    (catch failure (str "no backup of " file ": " (error-message failure)))))
