(defmodule passwd
  "Reading a password a program asked for (Emacs's `read-passwd` and comint's
`comint-watch-for-password-prompt`): a masked minibuffer read whose answer goes to the
program and nowhere else — never into the buffer, the input history, savehist, the kill
ring, `*Messages*`, a keyboard macro or the slow-turn log.

Two signals say a program wants one. The reliable one is its terminal: a program reading a
secret turns echo off and keeps line mode (`os/pty-password?`, brood ADR-570), so a
line-mode terminal (terminal.blsp) asks its pty. The fallback is the prompt's text, matched
by `*password-prompt-regexp*` (Emacs's `comint-password-prompt-regexp`) — for the shell
(bshell.blsp), whose commands run on pipes with no terminal to ask, and for a program that
reads its password through its own raw-mode line editor, which the terminal cannot tell
from any other read."
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use model
    :only [ed-current-buf
      ed-mode-service ed-prompt-free? register-overlay register-paste-taker register-macro-guard])) ; the selected buffer's facets

;; Emacs's `comint-password-prompt-regexp` (Emacs 29), case-folded as comint matches it
;; (`(?i)`, brood ADR-573): the password word at the start of the line, or after one of the
;; words prompts put before it ("Enter", "[sudo]", "user@host's", "Old", "Retype"), then an
;; optional "again" or a few words ("for wilhelm" — `[[:alpha:]]+`, so not only English), ending
;; in a colon at the end of the line — or ssh-keygen's "Enter passphrase … ." with a period. One
;; word beyond Emacs's: "local", for Hex's `Local password:` (`mix hex.user auth`,
;; `mix hex.publish`).
(def *password-prompt-regexp*
  (str "(?i)(?:^ *|(?:enter|enter same|enter the|enter auth|old|new|'s|login|kerberos|cvs|unix|"
    " smb|ldap|pem|sudo|\\[sudo\\]|doas|repeat|bad|retype|local) +.*)"
    "(?:password|passcode|passphrase|pass phrase|pin|response)"
    "(?:(?:, try)? *again| \\(empty for no passphrase\\)| \\(again\\))?"
    "(?: [[:alpha:]]+ .+)?[[:blank:]]*[:：៖][[:space:]]*$" "|enter (?:same )?passphrase.*\\.\\s*$"))

(defn prompt-line (text)
  "The last line of `text` — what a program printed since its last newline, which is the
prompt when it is waiting for input.

    (passwd/prompt-line \"Sorry, try again.\\n[sudo] password for me: \")   ;=> \"[sudo] password for me: \""
  (let (newline (string/last-index-of text "\n"))
    (if (< newline 0) text (string/substring text (inc newline) (count text)))))

(defn password-prompt? (line)
  "Whether prompt `line` asks for a password, by its text (`*password-prompt-regexp*`) —
the guess for when the program's terminal cannot be asked.

    (passwd/password-prompt? \"[sudo] password for wilhelm: \")   ;=> true
    (passwd/password-prompt? \"me@host's password:\")   ;=> true
    (passwd/password-prompt? \"Password changed.\")   ;=> false"
  (and (string? line) (regex/match? line *password-prompt-regexp*)))

(defn ed-read-passwd (m prompt then &optional (owner nil) (held ""))
  "Open a MASKED minibuffer read at `prompt` (Emacs's `read-passwd`): the input shows as
`*`s, nothing is recalled into it and the answer is never remembered (`:no-history`, so
not savehist either), C-g cancels. On RET, `(then m password)`; whatever `then` does
with the password is the only place it goes. The input is the prompt's lineedit state,
dropped when the prompt closes. `owner` names who asked (a buffer name), so the read
can be withdrawn when that program goes away (`ed-withdraw-read`). `held` is text the read
starts holding — what was typed before it opened (`take-typed`)."
  (let (edit (editor/lineedit/lineedit-init prompt '()))
    (assoc m
      :minibuffer
        {:edit (if (= held "") edit (editor/lineedit/lineedit-insert edit held))
         :masked true
         :no-history true
         :passwd-for owner
         :on-complete then})))

;; ---- what was typed before the read opened ---------------------------------------------------
;; A shell's command or a terminal's program can ask for a password while text typed ahead sits
;; in the buffer's input region — typed one key at a time, so the buffer's undo history holds a
;; snapshot per key, and deleting it as an ordinary edit records one more. `take-typed` moves it
;; out with `redact-region` (brood ADR-581): the text goes, the history goes with it, and the
;; buffer processes and other frames holding a copy redact theirs.

(defn take-typed (buffer start end)
  "`[buffer text]`: the text `[start, end)` of `buffer` — typed ahead of a password read — and
`buffer` with it removed and NO trace of it left: no undo step brings any of it back, and a
holder of a copy redacts its own (`editor/buffer/redact-region`). An empty range is `[buffer \"\"]`.

    (second (passwd/take-typed (editor/buffer/make-buffer \"pw: hun\") 4 7))   ;=> \"hun\""
  (if (>= start end)
    [buffer ""]
    [(editor/buffer/redact-region buffer start end)
      (text/slice (editor/buffer/buffer-rope buffer) start end)]))

;; Only what was typed AFTER the prompt appeared is the password's. Text typed ahead of it
;; — before the program asked — is not a secret: it stays in the input region as the next
;; input, as comint leaves pending input alone when it reads a password. When the watch sees
;; the prompt it drops a marker where the input region then ended (`mark-prompt`); every edit
;; shifts it, so it keeps dividing the type-ahead from what followed.

(def *prompt-marker* :passwd-prompt) ; the buffer marker where the input region ended when the prompt appeared

(defn mark-prompt (buffer)
  "`buffer` with the password prompt's marker (`*prompt-marker*`) at its end — where its input
region ended when the prompt appeared, so the text typed before it stays put (`take-since-prompt`)."
  (editor/buffer/buffer-marker-set buffer *prompt-marker* (editor/buffer/buffer-length buffer)))

(defn since-prompt (buffer start)
  "Where the text typed since the password prompt appeared begins in `buffer`'s input region,
which begins at `start`: the prompt's marker (`mark-prompt`), never before `start` — or
`start` when no prompt was marked."
  (let (marked (editor/buffer/buffer-marker buffer *prompt-marker*))
    (if (nil? marked) start (math/max start marked))))

(defn take-since-prompt (buffer start end)
  "`take-typed` of only what was typed into `[start, end)` since the password prompt appeared
(`since-prompt`): `[buffer text]`, that text gone without a trace and the type-ahead before
it left in place, as the next input.

    (second (passwd/take-since-prompt (passwd/mark-prompt (editor/buffer/make-buffer \"pw: ls\")) 4 6))   ;=> \"\""
  (take-typed buffer (math/min (since-prompt buffer start) end) end))

;; ---- a password asked for while you were elsewhere -------------------------------------------
;; A prompt that arrives while you are looking at another buffer only marks its own (a
;; terminal's `:term-secret`, a shell's `:bshell-secret`): nothing opens over the buffer you
;; are in. When you come back and type, the FIRST key opens the read and is its first
;; character — the keys never reach the input region, where a password would show while it was
;; typed and RET would make it the next command. The input layer routes them
;; (`passwd/secret-overlay`) and keeps them out of a recording macro.

(defn secret-key? (input)
  "Whether `input` is a key that TYPES — a printable key, or text an input method committed:
what opens the masked read of a program waiting for a password."
  (or (string? input) (and (vector? input) (= (first input) :text) (string? (second input)))))

(defn secret-key-text (input)
  "The text typing key `input` (`secret-key?`) types."
  (if (string? input) input (second input)))

(defn ed-withdraw-read (m owner)
  "Close the masked read `owner` opened, if it is still open — its program exited, so
there is nobody left to send the answer to. Any other prompt is left alone."
  (if (and (not (nil? owner))
        (map/get-in m [:minibuffer :masked])
        (= owner (map/get-in m [:minibuffer :passwd-for])))
    (assoc m :minibuffer nil :echo "password prompt closed: the program exited")
    m))

;; A buffer whose program can wait for a password says how with two facets of its mode: its
;; `:secret-pending?` `(model) -> bool`, whether the selected buffer waits with no read open,
;; and its `:secret-key` `(model input) -> model`, opening the read with a typing key.

(defn ed-secret-pending? (m)
  "Whether the selected buffer waits for a password no read is open for: where a typed key
belongs to a masked read. Asked on every key, so a buffer whose mode has no such facet answers
at once."
  (let (pending? (ed-mode-service (ed-current-buf m) :secret-pending?))
    (if (nil? pending?) false (pending? m))))

(defn ed-secret-type (m input)
  "Open the masked read of the selected buffer's waiting program with typing key `input`
([[secret-key?]]): the read takes it, never the input region in clear."
  ((ed-mode-service (ed-current-buf m) :secret-key) m input))

(defn ed-secret-yank-text (m input)
  "The text C-y would put in, when `input` is C-y and the kill ring has something: what a
password prompt takes masked, as typed text. Otherwise nil."
  (when (= input :ctrl-y)
    (let (head (first (or (:kill-ring m) [])))
      (when (and (string? head) (not (= head ""))) head))))

(defn ed-secret-text (text)
  "Pasted or yanked `text` as typing into a password read: its line breaks dropped, so a
paste never submits the password by itself."
  [:text (string/replace (string/replace text "\r" "") "\n" "")])

(defrecord secret-overlay ()) ; a program waiting for a password: the first typed key opens the masked read
(impl Overlay
  secret-overlay
  (overlay-active? (_ m) (and (nil? (:pending m)) (ed-secret-pending? m)))
  ;; a C-y too: yanked text is typed into the masked read, never into the input region
  (overlay-owns? (_ m input) (or (secret-key? input) (string? (ed-secret-yank-text m input))))
  (overlay-handle (_ m input)
    (let (yanked (ed-secret-yank-text m input))
      (ed-secret-type m (if (nil? yanked) input (ed-secret-text yanked))))))
;; No `overlay-exit`: a key that does not type (RET, C-a, C-x …) is the buffer's as ever.

;; below the minibuffer (the read it opens takes the next keys) and above the preview, whose
;; dispatch would type the key
(register-overlay :secret 100 (secret-overlay))

(defn paste-take (m text)
  "A paste into a program waiting for a password: the masked read opens with it, line breaks
dropped, never the input region in clear. Nil when no program here waits for one."
  (when (and (nil? (:pending m)) (ed-secret-pending? m)) (ed-secret-type m (ed-secret-text text))))

(defn macro-private? (m input)
  "Whether `input` is a password and so no key for a keyboard macro: a key typed into a masked
read, the typing key or paste or yank that opens one."
  (or (= true (get (:minibuffer m) :masked))
    (and (ed-secret-pending? m)
      (or (secret-key? input)
        (and (vector? input) (= (first input) :paste))
        (string? (ed-secret-yank-text m input))))))

(register-paste-taker :secret 'passwd/paste-take)
(register-macro-guard :secret 'passwd/macro-private?)
