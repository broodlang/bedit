(defmodule syntaxtree
  "The tree-sitter parse tree each pool buffer keeps (brood ADR-443), so highlighting
reparses a document INCREMENTALLY from its last tree instead of re-parsing a sliced window
from scratch on every keystroke.

The model's `:syntax-trees` maps a pool index to `{:tree :rope :lang :from-rope :changes}`:
the kernel's handle, the rope it was parsed from, its language, the rope of the tree it was
updated from, and `editor/treesit/tree-changes` of that update (the char ranges whose
colouring may differ). `spancache/ed-refresh-spans` brings the entries of the buffers on screen
up to date each event (`ed-sync-syntax-trees`) and reads them to colour a band
(`editor/treesit/fontify-tree`); a kill drops a killed buffer's (its slot keeper,
`model/ed-drop-slot`); `treewarm` opens a large buffer's first tree off the loop.

Keyed by pool index, the way `:hosted` is, and kept honest the same way: a kill shifts the
keys above it down. A key that ever names a different document than its tree was parsed
from costs a full reparse and is never wrong, because a handle carries its own text and an
update diffs the two ropes.

A handle is freed in ONE place, after a turn commits (`ed-release-dropped-trees`, which
`input/ed-update` calls): every handle the model held before the turn and not after. The one
exception is a handle a command opened and then replaced itself, within the turn
(`follow-held-tree`, which RET and a region reindent advance the tree with as they edit) —
named by nothing else, it is freed at once. No other turn frees, so a turn that throws and is
rolled back still names live handles. What a thrown turn opened is the editor process's own
(brood ADR-495), never evicted by the kernel and named by no model: the idle beat sweeps it
([[ed-sweep-orphaned-trees]]). A task that opens or updates a tree OFF the loop hands it to
the editor ([[tree-give]]) before it replies, or the tree dies with the task.

A buffer past `*tree-sync-max*` is brought up to date OFF the loop instead
([[ed-apply-tree-reparse]]): one reparse in flight at a time, launched from the newest tree
when the last one lands, so a burst of typing costs one or two reparses rather than one per
key. While it runs the entry is BEHIND the text: the bands it coloured are carried across the
edits by shifting their spans (`panes`), and a structural command catches the tree up once,
synchronously ([[ed-catch-up-syntax-tree]]). The tree the reparse started from is held for
as long as it runs, so a turn that drops it meanwhile does not free it under the task."
  (:use editor/buffer) ; buffer-rope / buffer-length / buffer-splices-since
  (:use model) ; ed-buf-at / ed-mode-service / ed-headless? / register-task-reply
  (:use task) ; task — a large buffer's reparse runs off the loop
  (:use tsbrackets :only [or-nil])) ; a tree-sitter call that raises answers nil

(defdyn *tree-open-max*
  ;; The largest buffer whose FIRST tree is opened on the loop. A cold whole-document parse
  ;; of 250 KB costs ~650 ms; below about 40 KB it is imperceptible. A larger buffer keeps
  ;; the windowed slice path until `treewarm` has opened its tree in a task; after that
  ;; every update is incremental (see `*tree-sync-max*` for where it runs).
  40000)

(defdyn *tree-sync-max*
  ;; The largest buffer whose tree is brought up to date ON the loop, synchronously, per
  ;; edit. An incremental reparse is not free: tree-sitter re-walks the regions a keystroke
  ;; leaves in error, and on Rust it grows about linearly with the document — one typed
  ;; character measured 0.3 ms at 20 KB and 50 KB, 0.55 ms at 100 KB, 1.4 ms at 200 KB,
  ;; 2.1 ms at 400 KB, 3.3 ms at 800 KB, 7.6 ms at 1.6 MB and 11.3 ms at 2.3 MB (installed
  ;; nest 0.44.0, 2026-10-27). Past this a reparse runs off the loop and lands as its own
  ;; turn (`ed-apply-tree-reparse`); below it the ~1.5 ms is cheaper than that extra turn
  ;; and the shifted, briefly-stale colouring it buys.
  250000)

;; ---- the editor/treesit tree API ------------------------------------------------
;; Each answers nil when the call raises (a language whose grammar is not loaded), which
;; every caller reads as "no tree: take the slice path" (`tsbrackets/or-nil`).

(defn tree-open (rope lang)
  "A fresh tree handle for the whole document `rope` in tree-sitter language `lang`, or nil."
  (or-nil (fn () (editor/treesit/open-tree rope lang))))

(defn- splice-edits (rope buffer)
  "The edits that turned `rope` into `buffer`'s text, as the kernel's reparse takes them —
`[start old-end new-end]` per splice, oldest first, each against the text the one before it
left — read from the buffer's own splice log (`buffer-splices-since`), or nil when the log
cannot account for the change (it overflowed, or the text was replaced wholesale)."
  (let (splices (buffer-splices-since (assoc buffer :rope rope) buffer))
    (when (and splices (not (empty? splices)))
      (into []
        (map splices (fn ([lo hi replacement]) [lo hi (+ lo (count replacement))]))))))

(defn- tree-update-to (tree rope lang edits)
  ;; Told the edits when the buffer's splice log knows them, so the kernel need not find the
  ;; change by comparing the tree's text with `rope` — a scan of both ropes per keystroke.
  ;; Without them (nil) it compares, which is exact for one contiguous edit and sound for
  ;; several. Edits that do not fit the two texts are an error rather than a wrong tree, and
  ;; that falls back to the comparison too. Reads no model: an off-loop reparse runs it.
  (let (told (when edits (or-nil (fn () (editor/treesit/update-tree tree rope lang edits)))))
    (or told (or-nil (fn () (editor/treesit/update-tree tree rope lang nil))))))

(defn- tree-update (tree from-rope buffer lang)
  (tree-update-to tree (buffer-rope buffer) lang (splice-edits from-rope buffer)))

(defn tree-free (tree)
  "Drop `tree`'s handle now (nil-safe)."
  (when tree (or-nil (fn () (editor/treesit/free-tree tree)))))

(defn tree-give (tree pid)
  "`tree` handed to process `pid` (`editor/treesit/give-tree`, brood ADR-495), nil-safe; the
tree. A handle belongs to the process that opened or updated it and dies with it, so a task
that parsed off the loop gives the editor its tree before it replies. A tree that cannot be
given (gone already, or a runtime without tree handles) arrives dead, and the reply's fold
treats it as the failure it is."
  (when tree (or-nil (fn () (editor/treesit/give-tree tree pid))))
  tree)

(defn tree-alive? (tree)
  "Whether `tree`'s handle is still held — not freed, its owner alive (`editor/treesit/tree-alive?`,
which builds nothing: the check made per event, where asking `tree-changed-ranges` would
build its vector only to test it for nil). False on a runtime without tree handles."
  (= true (or-nil (fn () (editor/treesit/tree-alive? tree)))))

(defn tree-changed-ranges (tree &optional (injections nil))
  "`editor/treesit/tree-changes` of `tree`: `[[start end] …]`, `true` for a fresh parse, nil
when the handle is gone. With the buffer's `injections` (brood ADR-489) a range reaching an
embedded document — a heredoc's shell, a `RUN` line — covers all of it: an edit inside one
can recolour it below the edit, where the host's own syntax did not change."
  (or-nil (fn () (editor/treesit/tree-changes tree injections))))

(defn tree-spans (tree faces from to &optional (injections nil))
  "`[start end face]` spans, absolute, for chars `[from, to)` of `tree` coloured by the face
table `faces` and the injection spec `injections` (`buffer-injections`) — `[]` when nothing
there is coloured — or nil when the handle is gone."
  (or-nil (fn () (editor/treesit/fontify-tree tree faces from to true injections))))

(defn buffer-injections (buffer)
  "The injection spec `buffer`'s mode colours embedded code with — its `:ts-injections` service,
built per call so an embedded language's table is its own mode's as it stands — or nil."
  (let (spec-of (ed-mode-service buffer :ts-injections))
    (when (fn? spec-of) (spec-of))))

;; ---- the per-buffer store ----------------------------------------------------------

(defn syntax-tree-entry (m index)
  "Pool buffer `index`'s tree entry, or nil."
  (get (or (:syntax-trees m) {}) index))

(defn current-syntax-tree (m index buffer)
  "Pool buffer `index`'s tree entry when it was parsed from `buffer`'s rope exactly — the only
entry `editor/treesit/fontify-tree` may be asked about, since its offsets are that text's."
  (let (entry (syntax-tree-entry m index))
    (when (and entry (= (:rope entry) (buffer-rope buffer))) entry)))

(defn behind-syntax-tree? (m index buffer)
  "Whether pool buffer `index` holds a tree parsed from an OLDER text than `buffer`'s — after the
refresh's sync, a large buffer whose reparse runs off the loop ([[ed-sync-syntax-trees]]).
Its bands are shifted across the edits rather than recoloured until the tree lands."
  (let (entry (syntax-tree-entry m index))
    (and (not (nil? entry)) (not (= (:rope entry) (buffer-rope buffer))))))

(defn held-tree-for (entry buffer lang)
  "`entry`'s tree handle when it was parsed as `lang` from exactly `buffer`'s rope, else nil —
the one test before a held tree is passed to a structural query (`editor/treesit/point-*`,
`indent-column`), whose offsets must be that text's. A command reads the entry off the
model once and asks this of the buffer it is moving in, which an edit in the same command
may already have moved past the tree."
  (when (and entry (= (:lang entry) lang) (= (:rope entry) (buffer-rope buffer))) (:tree entry)))

(defn- without-entry (m index)
  (assoc m :syntax-trees (dissoc (or (:syntax-trees m) {}) index)))

(defn install-syntax-tree (m index tree rope lang)
  "`m` with `tree` (parsed from `rope` as `lang`) as pool buffer `index`'s tree, in place of the
one it had (freed once the turn commits). A fresh parse, so its changes are `true` — every
cached band is suspect."
  (assoc m
    :syntax-trees
      (assoc (or (:syntax-trees m) {})
        index {:tree tree :rope rope :lang lang :from-rope nil :changes true})))

(defn- advanced-entry (entry buffer lang)
  "`entry` brought up to `buffer`'s rope by an incremental update of its tree — a NEW handle,
`entry`'s left alone — or nil when the update fails."
  (let (updated (tree-update (:tree entry) (:rope entry) buffer lang))
    (when updated
      {:tree updated
       :rope (buffer-rope buffer)
       :lang lang
       :from-rope (:rope entry)
       :changes (tree-changed-ranges updated (buffer-injections buffer))})))

(defn follow-held-tree (entry buffer lang origin)
  "`entry` (a held tree entry, or nil) brought up to `buffer`'s rope, for a command that edits
and then asks the tree about what it just edited — RET's indent, each line of a region
reindent after the first. Without it those queries miss the tree (it was parsed from the
text BEFORE the edit) and parse the whole document; with it each costs an incremental
update of the splices the edit made.

The handle it replaces is freed, unless it is `origin` — the tree the model held when the
command began, which only a committed turn may free (`ed-release-dropped-trees`): every
other handle a chain of follows passes through was opened by this command and is named by
nothing else. Nil when there is no entry, it is not a `lang` tree, its handle is gone, or
the update fails; the caller then reads the text."
  (cond
    (or (nil? entry) (not (= (:lang entry) lang))) nil
    (= (:rope entry) (buffer-rope buffer)) entry
    (not (tree-alive? (:tree entry))) nil
    else
      (let (next (advanced-entry entry buffer lang))
        (when (not (= (:tree entry) origin)) (tree-free (:tree entry)))
        next)))

(defn ed-adopt-syntax-tree (m index entry)
  "`m` with `entry` — a tree a command brought up to pool buffer `index`'s edited text
([[follow-held-tree]]) — as that buffer's tree, so the next refresh finds it current and
does not re-apply the same edit. The entry it replaces is freed once the turn commits. Nil
`entry` leaves `m` as it was."
  (if (nil? entry) m (map/assoc-in m [:syntax-trees index] entry)))

(sig ed-catch-up-syntax-tree (model any -> (tuple model any)))
(defn ed-catch-up-syntax-tree (m index)
  "`[m entry]`: pool buffer `index`'s tree entry brought up to its text NOW, synchronously, and
`m` holding it — for a structural command (C-M-f, TAB's indent, C-M-h), which asks the tree
about the text as it stands. A large buffer's tree trails the text while its reparse runs
off the loop; a deliberate key pays one incremental update rather than the whole-document
parse a query without a tree costs. The reparse in flight lands on a tree that is no longer
the buffer's and is freed. The entry as it was when there is nothing to catch up, no tree,
or the update fails."
  (let (entry (syntax-tree-entry m index)
        buffer (when (and (int? index) (< index (count (:buffers m)))) (ed-buf-at m index))
        lang (when buffer (ed-mode-service buffer :ts-lang)))
    (if (or (nil? buffer)
          (nil? entry)
          (nil? lang)
          (not (= (:lang entry) lang))
          (= (:rope entry) (buffer-rope buffer))
          (not (tree-alive? (:tree entry))))
      [m entry]
      (let (advanced (advanced-entry entry buffer lang))
        (if (nil? advanced) [m entry] [(map/assoc-in m [:syntax-trees index] advanced) advanced])))))

;; ---- the off-loop reparse of a large buffer ----------------------------------------
;; One in flight for the whole editor: `:tree-reparse-proc` is its task, `:tree-reparse` what
;; it was launched over — the pool index, the tree it starts from (`:base`), that tree's rope,
;; the rope it parses and the language. A rope cannot cross a message, so they wait here and
;; the reply carries the new handle and its change ranges alone (as `treewarm`'s does).

(defn- reparse-off-loop? (buffer)
  ;; headless (a test, a batch run) has no loop to land a reply on, and stays synchronous
  (and (> (buffer-length buffer) *tree-sync-max*) (not (ed-headless?))))

(defn- launch-reparse (m index entry buffer lang)
  "`m` with a task bringing `entry`'s tree up to `buffer`'s rope in flight. The edits are read
from the splice log here, on the loop (a walk of rope handles); the task captures the rope
and parses it, then hands the new tree to the editor (`tree-give`): it is the task's until
then, and the task exits as it replies."
  (let (tree (:tree entry)
        rope (buffer-rope buffer)
        edits (splice-edits (:rope entry) buffer)
        injections (buffer-injections buffer)
        editor (self)
        job (task (fn ()
                    (let (updated (tree-update-to tree rope lang edits))
                      {:tree (tree-give updated editor)
                       :changes (when updated (tree-changed-ranges updated injections))}))))
    (assoc m
      :tree-reparse-proc job
      :tree-reparse {:index index :base tree :from-rope (:rope entry) :rope rope :lang lang})))

(sig ed-apply-tree-reparse (model any -> model))
(defn ed-apply-tree-reparse (m result)
  "A finished off-loop reparse: its tree becomes the buffer's entry when the entry is still
the one it started from — else something caught the buffer up meanwhile (a structural
command), killed it or reopened it, and the new handle is freed. The tree it replaces is
dropped from the model and freed when this turn commits. The buffer has usually moved on
while it ran; this turn's refresh then launches the next reparse from this tree, over the
edits since ([[ed-sync-syntax-trees]]). A failed reparse drops the entry, so `treewarm`
opens a fresh tree off the loop rather than the loop retrying one that failed."
  (let (flight (or (:tree-reparse m) {})
        index (:index flight)
        tree (when (map? result) (:tree result))
        cleared (assoc m :tree-reparse-proc nil :tree-reparse nil)
        entry (when (int? index) (syntax-tree-entry cleared index))
        ours? (and (not (nil? entry)) (= (:tree entry) (:base flight))))
    (cond
      (and (nil? tree) ours?) (without-entry cleared index)
      (nil? tree) cleared
      (or (not ours?) (not (tree-alive? tree))) (do (tree-free tree) cleared)
      else
        (map/assoc-in cleared
          [:syntax-trees index]
          {:tree tree
           :rope (:rope flight)
           :lang (:lang flight)
           :from-rope (:from-rope flight)
           :changes (:changes result)}))))

(defn- synced-entry (m index buffer)
  "`m` with pool buffer `index`'s tree brought up to `buffer`'s rope: kept when current, updated
incrementally from the old tree when the rope moved, opened when there is none and the
buffer is small enough to parse on the loop, dropped when the buffer is no longer a
tree-sitter one. A buffer past `*tree-sync-max*` is updated off the loop instead: a reparse
is launched when none is in flight, and the entry stays behind until it lands.

An entry whose handle is gone (freed by a turn that a render failure then rolled back, or
opened by a task that never handed it over) counts as none: updating from it would be a full parse anyway, on the loop, so a small
buffer reopens and a large one waits for `treewarm`."
  (let (held (syntax-tree-entry m index)
        entry (when (and held (tree-alive? (:tree held))) held)
        lang (ed-mode-service buffer :ts-lang)
        rope (buffer-rope buffer))
    (cond
      (or (nil? lang) (nil? (ed-mode-service buffer :ts-faces))) (without-entry m index)
      (and entry (= (:lang entry) lang) (= (:rope entry) rope)) m
      (and entry (= (:lang entry) lang) (reparse-off-loop? buffer))
        (if (:tree-reparse-proc m) m (launch-reparse m index entry buffer lang))
      (and entry (= (:lang entry) lang))
        (let (advanced (advanced-entry entry buffer lang))
          (if (nil? advanced)
            (without-entry m index)
            (map/assoc-in m [:syntax-trees index] advanced)))
      (> (buffer-length buffer) *tree-open-max*) (without-entry m index)
      else
        (let (opened (tree-open rope lang))
          (if (nil? opened) (without-entry m index) (install-syntax-tree m index opened rope lang))))))

(defn ed-sync-syntax-trees (m indices)
  "`m` with the trees of the pool buffers at `indices` (the ones on screen) brought up to
date, and every entry whose index fell off the end of the pool dropped."
  (let (pool-size (count (:buffers m))
        swept (fold (keys (or (:syntax-trees m) {}))
                m
                (fn (acc index) (if (>= index pool-size) (without-entry acc index) acc))))
    (fold (seq/distinct indices)
      swept
      (fn (acc index)
        (if (and (int? index) (< index pool-size))
          (synced-entry acc index (ed-buf-at acc index))
          acc)))))

(defn- held-trees (m)
  ;; the entries' trees, and the one a reparse in flight is reading from
  (let (entries (map (vals (or (:syntax-trees m) {})) (fn (entry) (:tree entry)))
        base (map/get-in m [:tree-reparse :base]))
    (if (nil? base) entries (cons base entries))))

(defn ed-release-dropped-trees (before after)
  "`after`, once every tree handle `before` held and `after` does not has been freed — the one
place a handle is freed, run when a turn COMMITS, so a turn rolled back to `before` frees
nothing it still names. Freeing a gone handle is a no-op, so a nested turn (a macro's replay)
releasing first is harmless."
  (let (held (held-trees before))
    (if (empty? held)
      after
      (let (kept (held-trees after))
        (do
          (doseq (tree held) (when (not (includes? kept tree)) (tree-free tree)))
          after)))))

;; ---- the sweep: handles no turn will ever free -------------------------------------
;; A turn that opens a tree and then throws is rolled back to a model that never named it, so
;; `ed-release-dropped-trees` never sees it, and the kernel no longer evicts anything (brood
;; ADR-495): the editor process owns it until it exits. Nor does a reply dropped as stale free
;; the tree its task handed over. The idle beat sweeps both: every tree the editor process owns
;; (`editor/treesit/owned-trees`) that the model names nowhere is freed. Never while a warm or a
;; reparse is in flight — its task may have handed the editor a tree the reply has not yet
;; folded in.

(defn ed-orphaned-trees (m)
  "The tree handles this process owns that `m` names nowhere — not an entry's, not the one a
reparse reads from — and so that nothing will free; `()` while a warm or a reparse is in
flight, or on a runtime without tree handles."
  (if (or (:tree-warm-proc m) (:tree-reparse-proc m))
    '()
    (let (owned (or (or-nil (fn () (editor/treesit/owned-trees))) [])
          held (into #{} (held-trees m)))
      (seq/filter owned (fn (tree) (not (contains? held tree)))))))

(defn ed-tree-sweep-due? (m)
  "Whether the idle beat has orphaned trees to free ([[ed-orphaned-trees]]) — after a turn that
threw, or a dropped reply; otherwise never, since a committed turn frees what it dropped."
  (not (empty? (ed-orphaned-trees m))))

(defn ed-sweep-orphaned-trees (m)
  "`m`, once every orphaned tree ([[ed-orphaned-trees]]) has been freed."
  (do (doseq (tree (ed-orphaned-trees m)) (tree-free tree)) m))

(defn ed-tree-jobs-follow-kill (m killed)
  "`m` with a warm (`treewarm`) or reparse in flight re-aimed once slot `killed` goes: at the
buffer it was working on, or at none when that is the one killed, so its tree is freed on
arrival rather than installed on a neighbour."
  (let (warmed (assoc m :tree-warm-index (shift-slot-index (:tree-warm-index m) killed))
        flight (:tree-reparse m))
    (if (nil? flight)
      warmed
      (assoc warmed :tree-reparse (assoc flight :index (shift-slot-index (:index flight) killed))))))

;; ---- registration ---------------------------------------------------------------
;; a killed buffer's tree leaves the model here and is freed once the turn commits; the trees
;; above it follow the pool, each staying with its document
(register-slot-keeper :syntax-trees
  {:order 40 :slots [:syntax-trees] :drop 'syntaxtree/ed-tree-jobs-follow-kill})
;; the reply carries the reparsed tree and its change ranges, and clears the slot either
;; way; upkeep nobody waits on, so it has no activity label
(register-task-reply :tree-reparse-proc 'syntaxtree/ed-apply-tree-reparse :failed nil)
;; frees the trees a rolled-back turn or a dropped reply left the editor owning; due only then
(register-idle-job :tree-sweep
  {:order 95 :run 'syntaxtree/ed-sweep-orphaned-trees :stale? 'syntaxtree/ed-tree-sweep-due?})
;; a committed turn frees the tree handles it dropped; a rolled-back one still names them
(register-commit-step :syntax-trees {:order 10 :run 'syntaxtree/ed-release-dropped-trees})
