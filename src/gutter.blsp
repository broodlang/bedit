(defmodule gutter
  "The line-number gutter and the margin marks drawn in it — a VIEW concern that a mode
merely names. `text-mode` (src/modes.blsp) registers `line-number-width` /
`line-number-cell` as its `:gutter-width` / `:gutter-cell` services; this module is what
they compute: the number column, the diff-hl change bar, and the per-line marks (a
breakpoint ●, a test ✓/✗, a diagnostic ⚠) other features annotate onto the buffer, read
through one precedence table (`gutter-mark-sources`) that both paints and resolves clicks."
  (:use theme)) ; face-gutter-line + the palette the gutter faces are computed over
;; editor/buffer, results, diffhl and diagnostics are referenced qualified below — each
;; `mod/name` auto-loads its module.

;; ---- the line-number gutter, as a mode service -----------------------------
;; A *gutter* is generic per-line margin content a layer contributes via two facets
;; `ed-mode-service` looks up: `:gutter-width` (columns to reserve, given the buffer)
;; and `:gutter-cell` (`[text face]` for a 0-based line, given the buffer + width).
;; Both renderers consume it without naming "line numbers" — the view paints the cells
;; left of the text (src/view.blsp), the web mirror materialises them into its snapshot
;; (src/web.blsp). line-numbers is the first such gutter; a future diagnostics/git
;; gutter is the same two functions registered on a layer. Lives on text-mode (the
;; shared base), so plain *and* brood buffers get it (brood stacks text-mode beneath).

(theme/defchrome gutter-face-line-number face-gutter-line) ; the dim line-number colour (theme)
;; the current line's number under relative numbering (Emacs's `line-number-current-line`):
;; the absolute number, lavender, standing out from the distances around it (under absolute
;; numbering the view paints the current line's number in the same face, `panebody/ed-current-number-ops`)
(theme/defchrome gutter-face-line-number-current face-gutter-line-current)

;; The gutter is Emacs's left fringe and line numbers in one strip, as narrow as Emacs's:
;;
;;   [mark] [digits] [gap]
;;
;; The MARK column is the fringe: the diff-hl change bar, or a margin mark over it (a
;; breakpoint ●, a test ✓/✗, a diagnostic ⚠) — the two share it as diff-hl and flymake share
;; Emacs's fringe, the mark winning. It sits LEFT of the number, so a mark never reads as the
;; first character of the line (`✗defmodule`), which is why it once took a column of its own
;; between the number and the text. Then the digits, and one blank column before the text.
(def line-number-min-digits 2) ; digit columns held even for a short buffer, so the gutter
; does not widen as a buffer passes 9 lines — Emacs's
; `display-line-numbers-width`. A buffer past 99 lines
; widens once, and stays.
(def line-number-right-margin 1) ; the blank column between the number and the text
(def line-number-bar-width 1) ; the mark column, left of the digits

(sig line-number-width (buffer -> int))
(defn line-number-width (buf)
  "The `:gutter-width` for line numbers: the mark column, the last line number's digit count
(but at least `line-number-min-digits`, so the gutter stays put as the buffer passes 9 and 99
lines) and the one blank column before the text. Every buffer keeps the mark column, so a
mark, and a file's change bar arriving off the loop, never moves the text."
  (+ gutter/line-number-bar-width
    gutter/line-number-right-margin
    (math/max gutter/line-number-min-digits
      (count (str (editor/buffer/buffer-line-count buf))))))

(defn fringe-width (buf)
  "The `:gutter-fringe-width` for a buffer whose lines are NOT numbered: the mark column alone
for a file (its change bar and margin marks, as Emacs's fringe shows them with numbering off),
nil for a buffer with no file — nothing could mark it, so no column is spent."
  (when (editor/buffer/buffer-file buf) gutter/line-number-bar-width))

;; ---- margin marks (breakpoints + test verdicts) ------------------------------
;; Per-line marks other features annotate ONTO the buffer (the diffhl trick — a
;; gutter cell sees only the buffer, no model): `:debug-break-lines {line true}` from
;; the margin-click breakpoint (debugger), `:test-marks {line passed?}` from a test
;; run (testrun). Each carries the line count at annotation time and is drawn only
;; while positionally current (`:git-status-lines`' discipline); a test verdict on a
;; MODIFIED buffer dims — it predates your edit.

(theme/defchrome gutter-face-breakpoint {:fg *red* :bold true})
(theme/defchrome gutter-face-test-pass {:fg *green*})
(theme/defchrome gutter-face-test-fail {:fg *red* :bold true})
(theme/defchrome gutter-face-test-stale {:fg *overlay0*})
(theme/defchrome gutter-face-warn {:fg *yellow*}) ; an advisory type warning (⚠)
(theme/defchrome gutter-face-describe-mixed {:fg *yellow* :bold true}) ; some passed, some failed
(theme/defchrome gutter-face-describe-partial {:fg *blue*}) ; only some of the block's tests ran
(defn- mark-line-keyed (value line)
  ;; `{:at <what the annotation holds for `line`>}`, or nil when it holds nothing there.
  ;; WRAPPED, not returned bare: a failing test's verdict is `false`, which is a mark and
  ;; not an absence, and returned raw it would make `✗` vanish from the margin. The currency and
  ;; staleness come from the source's annotation, read once per
  ;; buffer (`gutter-ctx`) rather than once per line per source.
  (when (contains? value line) {:at (get value line)}))

(defn mark-line-at (value line buf)
  ;; The DEFAULT `:lookup` of a `gutter-mark-sources` row: the annotation is a
  ;; `{line -> mark}` map and the line is the key. Four of the five sources are that, and
  ;; spelling it out per row was four copies of the one line that must stay wrapped (see
  ;; `mark-line-keyed`). A row only names a `:lookup` when it reads something else — the
  ;; end-of-line note, which asks the BUFFER.
  (mark-line-keyed value line))

;; The margin's sources, each a ROW the feature that owns the mark registers
;; ([[register-gutter-mark]]), in PRECEDENCE order by `:rank` — the first with something to say
;; about a line marks it. A row is `{:rank :annotation :lookup :glyph :on-click}`:
;;   :annotation  the buffer annotation the source reads (naming it rather than hiding it inside
;;                a reader is what lets the column be built with one read per source, not one
;;                per line — see `gutter-ctx`)
;;   :lookup      optional `(value line buf) -> {:at hit}` symbol for one line, nil when that
;;                line has none — WRAPPED, since a hit can legitimately BE `false` (a FAILING
;;                test's verdict); defaults to [[mark-line-at]], the `{line -> mark}` read
;;   :glyph       `(hit stale) -> [text face]` symbol, in the margin's faces (`gutter-face-*`)
;;   :on-click    the command symbol a CLICK on that mark runs, or nil: the click then goes to
;;                the mode's own `:gutter-click` — as does a line with no mark at all, which is
;;                how a breakpoint gets SET on a bare line rather than only cleared.
;; The click lives beside the glyph deliberately: the margin shows one mark per line, and
;; resolving the click through the same rows is what makes pressing it do the thing you see.
;; Today's rows: a breakpoint (`debugger`, 10), a test's verdict and a `describe` rollup
;; (`testrun-cold`, 20, 30), an end-of-line note (`eolnotes`, 40), a diagnostic (`diagpaint`, 50:
;; last, so a line that already carries a verdict keeps it).

(defn register-gutter-mark (name row)
  "Add the margin mark source `name`, `{:rank :annotation :lookup :glyph :on-click}` (see the
comment above), replacing any registered under `name` — a row of the source table
`:gutter/mark-sources` (`sources`). Called when the source's module loads."
  (sources/register :gutter/mark-sources name row))

(defn gutter-mark-sources ()
  "The registered margin mark sources, in precedence order (lowest `:rank` first)."
  (sources/rows :gutter/mark-sources))

;; ---- the gutter context: the buffer's answers, read once per COLUMN --------
;; `editor/buffer/annotation` allocates a `{:value :current? :stale?}` map and calls
;; `buffer-line-count` on every call, and every mark source asked it PER LINE — as did the
;; change bar. A 49-row gutter therefore did ~300 of each, per rebuild, and a rebuild was
;; every keystroke: the cache key carried the live rope, because a mark dims once the text
;; moves past it. Together that was ~2 ms of a 5.5 ms typing turn, spent asking the same six
;; questions forty-nine times over.
;;
;; The answers are per BUFFER, not per line, so they are read once into a context and the
;; per-line work becomes a map lookup. The context travels on a dynvar rather than through
;; `:gutter-cell`'s arguments because the column is built through a MODE SERVICE, whose
;; contract is `(buf line gw)` and is not this concern's to widen; each reader falls back to
;; asking the buffer itself when no column is being built (a click, a test).
;;
;; It is also the cache KEY (`spancache/ed-gutter-key`), which is the other half of the fix: a
;; mark's staleness is a BOOLEAN that flips once, so keying on it rebuilds the column on the
;; first keystroke after a test run and reuses it on every one after — where keying on the
;; rope rebuilt on all of them.

(defdyn *gutter-ctx* nil)
;; The gutter context in force while a column is built — nil outside one.

(defn gutter-ctx (buf)
  "Everything a gutter cell reads about the BUFFER rather than about its line, read once:
`:bars` — the diff-hl change-bar map, only while positionally current — and `:marks`, a
`[source {:value :stale?}]` for each `gutter-mark-sources` row, in precedence order, whose
annotation has something to say (a source with nothing, or whose lines have shifted so it would
now point at the wrong ones, is left out). The sources ride with their annotations, so a
line's lookup reads no registry and a row registered since cannot be paired with another's.

Read fresh on every call, which is a handful of annotation reads. The answer is the gutter
cache's KEY (`spancache/ed-gutter-key`), compared against the one the model kept last frame,
and its parts are the registry's own rows and the buffer's own annotation values — the same
cells until something re-stamps them — so that comparison answers at once without remembering
anything here. It was remembered once, in a global keyed on the annotations themselves: a
global's store is a deep copy, so every lookup compared the change-bar map line by line (a new
or rewritten file marks every line) and every keystroke copied it."
  {:bars (editor/buffer/annotation-value buf :vcs-line-status)
   :marks (into []
            (seq/keep (gutter-mark-sources)
              (fn (source)
                (let (a (editor/buffer/annotation buf (:annotation source)))
                  ;; An EMPTY annotation is recorded as absent, not as an empty-and-stale one.
                  ;; It marks no line, so its staleness cannot change a single cell — but it
                  ;; flips on every edit, and this context is the cache key, so leaving it in
                  ;; rebuilt the whole column on every keystroke over a clean file. (A checker
                  ;; that finds nothing still stamps `:diagnostic-lines {}`, which is exactly
                  ;; the common case.)
                  (when (and a (:current? a) (not (empty? (:value a))))
                    [source {:value (:value a) :stale? (:stale? a)}])))))})

(defn- gutter-bars (buf)
  "The change-bar map for `buf` — from the column's context when one is in force."
  (let (ctx *gutter-ctx*)
    (if ctx (:bars ctx) (editor/buffer/annotation-value buf :vcs-line-status))))

(defn- gutter-hit (buf line)
  ;; `[source {:at :stale?}]` for the first source with something to say about `line`, or
  ;; nil. Reads the column's context when one is in force, else builds one for this line —
  ;; so a single-line caller (a click, a test) needs no ceremony.
  ;; A walk that stops at the first source with a hit, rather than `seq/keep` over every
  ;; source then `first`: on a clean file the context has no source at all, and this runs for
  ;; each line of a column rebuilt on every scroll.
  (let (marks (:marks (or *gutter-ctx* (gutter-ctx buf)))
        n (count marks))
    (letrec (walk (fn (index)
                    (if (>= index n)
                      nil
                      (let ([source mark] (nth marks index)
                            lookup (:lookup source)
                            found (if lookup
                                    (reflect/call-if-bound lookup nil (:value mark) line buf)
                                    (mark-line-at (:value mark) line buf)))
                        (if found
                          [source {:at (:at found) :stale? (:stale? mark)}]
                          (walk (inc index)))))))
      (walk 0))))

(defn gutter-mark-for (buf line)
  "The `[glyph face]` margin mark for `line`, or nil: the first source in
`gutter-mark-sources` that has something to say — a breakpoint ●, a per-test verdict
✓/✗/·, a `(describe …)` rollup ✓/◐/◔, an end-of-line note's ·/✓/✗/⋯, or a diagnostic's
⚠/✗.

Every source is a buffer ANNOTATION (`std/editor/buffer`), so all of them share one
discipline instead of five copies of it: a mark blanks entirely once lines have
shifted (it would point at the wrong line) and DIMS while the text differs from what
produced it (an edit dims a verdict; undoing back restores it). That is also why the
model's diagnostics are stamped onto the buffer to get here — the gutter's cell cache is
keyed on the buffer, so model state cannot reach it and would go stale unnoticed if it
did."
  (let (hit (gutter-hit buf line))
    (when hit
      (let ([source found] hit)
        (reflect/call-if-bound (:glyph source) nil (:at found) (:stale? found))))))

(defn gutter-click-for (buf line)
  "The command symbol — `(m line) -> m` — that a margin click on `line` should run, or nil
to leave the click to the mode's own `:gutter-click`.

The mark you clicked decides, through the SAME table that painted it, so the margin cannot
show one thing and do another. Only a marked line claims a click: an unmarked one still
reaches the mode, which is what lets a click on empty margin set a breakpoint."
  (let (hit (gutter-hit buf line))
    (when hit (:on-click (first hit)))))

(defn gutter-annotate (buf line cell)
  "Overlay the line's margin mark (if any) on a gutter `cell` — the mark takes the MARK
column, left of the number, over the change bar there (the two share Emacs's fringe, and the
mark says more). `cell` is one `[text face]` chunk or a list of them whose first chunk is
that column; returns the same shape family (a chunk list when marked)."
  (let (mark (gutter-mark-for buf line))
    (if (nil? mark)
      cell
      (let (chunks (if (list? cell) cell (list cell))) (cons mark (rest chunks))))))

(defn- line-number-text (buf line)
  ;; what the number column says for `line`, and its face: the 1-based number, or under
  ;; relative numbering the distance from point's line, which shows its own number — counted
  ;; in lines on screen, so the lines a fold hides between them are not counted (Emacs's)
  (let (current (editor/buffer/buffer-current-line buf))
    (cond
      (not (= (display-settings/ed-line-numbers-for buf) :relative))
        [(str (inc line)) gutter/gutter-face-line-number]
      (= line current) [(str (inc line)) gutter/gutter-face-line-number-current]
      else
        [(str (- (math/abs (- line current)) (folds/hidden-between buf line current)))
          gutter/gutter-face-line-number])))

(sig line-number-cell (buffer int int -> any))
(defn line-number-cell (buf line gw)
  "The `:gutter-cell` for 0-based `line`: the mark column, then its number right-aligned in
the digit columns (the distance from point's line under `:relative`, `display-settings/ed-line-numbers-for`) and
the blank column before the text. A **file buffer**'s mark column is its coloured change bar
(diff-hl); any margin mark (a breakpoint ●, a test ✓/✗ — `gutter-mark-for`) takes it over.

The bar is drawn only while the cached `:vcs-line-status` annotation is **positionally
current** (`annotation-value` — the line count still matches what it was computed for). The moment
a line is inserted/deleted the cached line→status map is shifted, so every bar below the edit
would land on the wrong line; we blank the bars until the idle recompute lands a fresh map
(rather than draw them too high/low). A within-line edit keeps the line count, so its bars stay."
  (let (bars (when (editor/buffer/buffer-file buf) (gutter-bars buf))
        lead (if (nil? (editor/buffer/buffer-file buf))
               [" " nil]
               (diffhl/bar-chunk (when bars (get bars line))))
        digits (- gw gutter/line-number-bar-width))
    (gutter-annotate buf
      line
      (if (<= digits 0)
        ;; the fringe alone (`fringe-width`): a numbering-off file keeps its mark column
        (list lead)
        (let ([number face] (line-number-text buf line))
          (list lead
            [(string/pad-right (string/pad-left number (- digits gutter/line-number-right-margin))
               digits)
              face]))))))
