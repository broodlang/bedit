(defmodule lsp-lens
  "LSP **code lens** (`textDocument/codeLens`, `codeLens/resolve`): the actions a language
server attaches to a line — `3 references`, `▶ Run test`, `Debug` — shown as a dim row of
their own ABOVE the line (an inlay row, `wrap/inlay-lines`, which the cursor steps over and the
scroll counts), the way VS Code and lsp-mode draw them. M-x lsp-code-lens-run runs the one on
point's line (a picker when it has several) through `workspace/executeCommand`; the edits a
command makes come back as the server's `workspace/applyEdit`, applied as a code action's are
(`lsp-commands/ed-ev-lsp-apply-edit`).

Asked on the idle beat when the current buffer's text moved since the last ask — so on open
and once edits settle — of a live server offering `codeLensProvider`. A lens the server sends
without its command is resolved (`codeLens/resolve`) when the server says it resolves. Each
lens is anchored by a char offset carried through the buffer's splice log by a post-step
(`lens-follow`), so a row stays above its line while you type rather than vanishing until the
next answer. Per file under `:lsp-lenses`: `{path {:seen buffer :lenses [...] :generation ref
:requested rope :conn}}`.

Off unless init.blsp's `:lsp-code-lens` is true (most Emacs clients make lenses opt-in);
M-x lsp-code-lens-mode toggles it."
  (:use model) ; message / ed-current-buf / ed-buf-at / ed-carry-position / the registries
  (:use editor/buffer) ; buffer-rope / buffer-file / annotate — the rows are one annotation
  (:use interactive) ; defcommand — M-x lsp-code-lens-run / lsp-code-lens-mode
  (:use lsp-requests) ; the LspRequest ability, and lsp-execute-command which a lens runs through
  (:use lsp-servers)) ; ed-lsp-ask-server — one request path for every lookup

;; ---- pure: what a server answers --------------------------------------------------

(defn parse-lens (lens)
  "One `CodeLens` as `{:line :units :title :command :arguments :raw}` — its range's start
(0-based line, UTF-16 column), its command's title and call (nil while unresolved), and the
server's own object, which `codeLens/resolve` hands back.

    (:title (lsp-lens/parse-lens {:range {:start {:line 2 :character 0}} :command {:title \"Run\" :command \"run\"}}))   ;=> \"Run\""
  (let (start (map/get-in lens [:range :start] {})
        command (:command lens))
    {:line (or (:line start) 0)
     :units (or (:character start) 0)
     :title (when (and (map? command) (string? (:title command))) (string/trim (:title command)))
     :command (when (map? command) (:command command))
     :arguments (if (map? command) (or (:arguments command) []) [])
     :raw lens}))

(defn parse-lenses (result)
  "A `textDocument/codeLens` `result` (a vector of CodeLens, or null) as [[parse-lens]] maps.

    (count (lsp-lens/parse-lenses [{:range {:start {:line 0 :character 0}}}]))   ;=> 1"
  (if (not (or (vector? result) (list? result)))
    []
    (into [] (map (seq/filter result map?) parse-lens))))

(defn anchor-lenses (lenses rope)
  "`lenses` ([[parse-lenses]]) each with `:offset`, the char offset of its start in `rope` — the
anchor that edits carry. A lens past the end of the text is left out."
  (let (lines (text/line-count rope))
    (into []
      (seq/keep lenses
        (fn (lens)
          (let (line (:line lens))
            (when (and (>= line 0) (< line lines))
              (assoc lens
                :offset
                  (+ (text/line->char rope line)
                    (lsp-protocol/lsp-units->column rope line (:units lens)))))))))))

(defn shown? (lens)
  "Whether a lens has something to show: a resolved command with a title."
  (and (string? (:title lens)) (not (string/blank? (:title lens)))))

(defn- indentation (rope line)
  ;; the leading spaces and tabs of `line`, so a row sits over the code it describes
  (let (hit (regex/find (text/line rope line) "^[ \\t]*")) (if hit (:text hit) "")))

(defn lens-rows (lenses rope)
  "The inlay rows `[{:line :text} …]` for `lenses` (anchored, [[anchor-lenses]]) over `rope`:
one row per line holding a shown lens, its titles joined by ` | `, indented as the line is, in
line order. A lens not yet resolved shows nothing.

    (lsp-lens/lens-rows [{:offset 4 :title \"Run\"} {:offset 5 :title \"Debug\"}] (text/string-> \"a\\n  fn x\"))   ;=> [{:line 1 :text \"  Run | Debug\"}]"
  (let (by-line (fold (seq/filter lenses shown?)
                  {}
                  (fn (acc lens)
                    (let (line (text/char->line rope (math/min (:offset lens) (text/length rope))))
                      (assoc acc line (conj (get acc line []) (:title lens)))))))
    (into []
      (map (sort (keys by-line))
        (fn (line)
          {:line line :text (str (indentation rope line) (string/join (get by-line line) " | "))})))))

(defn carry-lenses (lenses seen current)
  "`lenses`, anchored against buffer `seen`, with their offsets carried to buffer `current`
through every edit between them (`model/ed-carry-position`), or nil when the buffer's log
cannot say what changed."
  (if (= (buffer-rope seen) (buffer-rope current))
    lenses
    (let (splices (buffer-splices-since seen current))
      (when (not (nil? splices))
        (into []
          (map lenses
            (fn (lens)
              (assoc lens
                :offset
                  (fold splices
                    (:offset lens)
                    (fn (offset splice)
                      (let ([lo hi replacement] splice)
                        (ed-carry-position offset lo hi (string/length replacement)))))))))))))

(defn lenses-on-line (lenses rope line)
  "The shown `lenses` whose anchor is on 0-based `line` of `rope`, in order."
  (into []
    (seq/filter lenses
      (fn (lens)
        (and (shown? lens)
          (= line (text/char->line rope (math/min (:offset lens) (text/length rope)))))))))

;; ---- the wire -------------------------------------------------------------------

(defrecord lsp-code-lens ()) ; textDocument/codeLens
(defrecord lsp-code-lens-resolve ()) ; codeLens/resolve — a lens's command filled in

(impl LspRequest
  lsp-lens/lsp-code-lens
  (lsp-request-method (_) "textDocument/codeLens")
  (lsp-request-params (_ request) {:textDocument {:uri (:uri request)}})
  (lsp-request-shape (_ result) [:lsp-code-lens (parse-lenses result)])
  (lsp-request-fold (pending m payload) (ed-lens-fold pending m payload)))

(impl LspRequest
  lsp-lens/lsp-code-lens-resolve
  (lsp-request-method (_) "codeLens/resolve")
  ;; about no document: the lens object the server sent, handed back
  (lsp-request-params (_ request) (:lens request))
  (lsp-request-shape (_ result) [:lsp-code-lens-resolve (when (map? result) (parse-lens result))])
  (lsp-request-fold (pending m payload) (ed-lens-resolved pending m payload)))

;; ---- the model --------------------------------------------------------------------

(def *resolve-max*
  ;; lenses resolved per answer: a file of a thousand tests is a thousand requests otherwise
  64)

(def- *inlay-owner* :lsp-code-lens)

(defn lens-on? (m)
  "Whether code lenses are wanted: init.blsp's `:lsp-code-lens` (off unless true)."
  (= true (:lsp-code-lens m)))

(defn lens-entry (m file)
  "The live server for `file` that offers code lenses, or nil."
  (seq/find (lsp/lsp-live-entries m file)
    (fn (entry) (lsp/lsp-capable? (:caps entry) :codeLensProvider))))

(defn ed-lens-due? (m)
  "True when the current buffer's lenses are due an ask: wanted, a live server offering them,
and the text moved since the last ask. The idle job's `:stale?`."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer))
    (and (lens-on? m)
      (string? file)
      (not (= (buffer-rope buffer) (map/get-in m [:lsp-lenses file :requested])))
      (not (nil? (lens-entry m file))))))

(defn ed-lens-request (m)
  "Ask the current buffer's server for its code lenses, quietly; the text they are about is
the buffer as it is now, kept on the lookup as `:seen`."
  (ed-lens-request-at m (ed-current-index m)))

(defn ed-lens-request-at (m index)
  "[[ed-lens-request]] for pool buffer `index`, whichever pane shows it — what a server's
refresh asks for each buffer of its on screen. Nothing for a buffer no live server lenses."
  (let (buffer (ed-buf-at m index)
        file (buffer-file buffer)
        entry (when (string? file) (lens-entry m file)))
    (if (nil? entry)
      m
      ;; `:asked`: the ask the answer must be — an older one landing later is dropped
      (let (token (ref))
        (ed-lsp-ask-server-at (map/assoc-in (map/assoc-in m
                                              [:lsp-lenses file :requested]
                                              (buffer-rope buffer))
                                [:lsp-lenses file :asked]
                                token)
          index
          (:conn entry)
          (lsp-code-lens)
          {:uri (lsp-protocol/lsp-path->uri file) :lang (lsp/lsp-language-id file)}
          {:path file :seen buffer :token token}
          :quiet)))))

(defn ed-launch-lens (m)
  "The idle beat's code lenses: ask when [[ed-lens-due?]]. Never in a headless run."
  (if (or (ed-headless?) (not (ed-lens-due? m))) m (ed-lens-request m)))

(defn- ed-lens-stamp (m index path store)
  "`m` with `store` filed for `path` and its rows stamped on pool buffer `index` as its inlay
rows (owner `:lsp-code-lens`, beside any other producer's) — `:seen` becomes the stamped buffer."
  (let (buffer (ed-buf-at m index)
        rows (lens-rows (:lenses store) (buffer-rope buffer))
        inlays (wrap/raw-inlays buffer)
        stamped (if (and (empty? rows) (not (contains? inlays *inlay-owner*)))
                  buffer
                  (annotate buffer
                    :inlay-lines (if (empty? rows)
                      (dissoc inlays *inlay-owner*)
                      (assoc inlays *inlay-owner* rows)))))
    (map/assoc-in (if (= stamped buffer) m (ed-set-buf-at m index stamped))
      [:lsp-lenses path]
      (assoc store :seen stamped))))

(defn- ed-lens-resolve-all (m path store)
  "Ask the server to resolve each of `store`'s lenses that came without a command, when it says
it resolves them (`codeLensProvider.resolveProvider`) — at most `*resolve-max*`."
  (let (entry (seq/find (vals (or (:lsp-servers m) {}))
                (fn (entry) (= (:conn entry) (:conn store))))
        resolves? (= true (map/get-in entry [:caps :codeLensProvider :resolveProvider])))
    (if (not resolves?)
      m
      (fold (take (seq/filter (seq/enumerate (:lenses store))
                    (fn ([_ lens]) (nil? (:command lens))))
              *resolve-max*)
        m
        (fn (acc pair)
          (let ([index lens] pair)
            (ed-lsp-ask-server acc
              (:conn store)
              (lsp-code-lens-resolve)
              {:lens (:raw lens)}
              {:path path :index index :generation (:generation store)}
              :quiet)))))))

(defn ed-lens-fold (pending m payload)
  "A code-lens answer landing: anchored on the text it was about (`:seen`), carried to the text
now, its rows stamped, and the lenses without a command sent to be resolved. Dropped for a
closed file, with lenses off, or for an ask a newer one has replaced."
  (let (path (:path pending)
        index (when path (ed-buffer-index-by-file m path)))
    (if (or (nil? payload)
          (nil? index)
          (not (lens-on? m))
          (not (= (:token pending) (map/get-in m [:lsp-lenses path :asked]))))
      m
      (if (= payload :lsp-retry)
        ;; the server said ask again (`lsp-protocol/lsp-retry?`): due on the next beat
        (map/assoc-in m [:lsp-lenses path :requested] nil)
        (let (seen (:seen pending)
              anchored (anchor-lenses payload (buffer-rope seen))
              carried (carry-lenses anchored seen (ed-buf-at m index))
              store (assoc (or (map/get-in m [:lsp-lenses path]) {})
                      :lenses (or carried [])
                      :generation (ref)
                      :conn (:conn pending))
              store (if carried store (assoc store :requested nil))
              stamped (ed-lens-stamp m index path store))
          (ed-lens-resolve-all stamped path store))))))

(defn ed-lens-resolved (pending m payload)
  "A resolved lens landing: its title and command put on the lens it was asked for — when that
lens is still from the same answer (`:generation`) — and the rows restamped."
  (let (path (:path pending)
        store (map/get-in m [:lsp-lenses path])
        index (when path (ed-buffer-index-by-file m path)))
    (if (or (nil? payload)
          (nil? store)
          (nil? index)
          (not (= (:generation store) (:generation pending)))
          (>= (:index pending) (count (:lenses store))))
      m
      (ed-lens-stamp m
        index
        path
        (assoc store
          :lenses
            (assoc (:lenses store)
              (:index pending)
                (merge (nth (:lenses store) (:index pending))
                  (map/select-keys payload [:title :command :arguments]))))))))

(defn lens-follow (m)
  "The post-step: every file's lenses carried through what this event did to its buffer
([[carry-lenses]]) and their rows restamped; a file whose buffer is gone forgotten."
  (let (stores (or (:lsp-lenses m) {}))
    (if (empty? stores)
      m
      (fold (%map-pairs stores)
        m
        (fn (acc pair)
          (let ([path store] pair
                index (ed-buffer-index-by-file acc path)
                seen (:seen store))
            (cond
              (nil? index) (assoc acc :lsp-lenses (dissoc (:lsp-lenses acc) path))
              (nil? seen) acc
              (= (buffer-rope seen) (buffer-rope (ed-buf-at acc index))) acc
              else
                (let (carried (carry-lenses (:lenses store) seen (ed-buf-at acc index)))
                  (ed-lens-stamp acc
                    index
                    path
                    (if (nil? carried)
                      (assoc store :lenses [] :requested nil)
                      (assoc store :lenses carried)))))))))))

;; ---- running a lens: the server's command, or the client's ------------------------------
;; A lens's command is one of two things. A SERVER command — one the server lists in
;; `executeCommandProvider.commands` — is sent back to it (`workspace/executeCommand`), and the
;; edits it makes come as `workspace/applyEdit`. A CLIENT command is the server asking the
;; editor to do something only an editor can: rust-analyzer's `▶ Run` is
;; `rust-analyzer.runSingle` with a cargo invocation as its argument, its `3 implementations`
;; is `rust-analyzer.showReferences` with the locations. Those are mapped to what bedit
;; already does (`*client-commands*`); any other is said, never sent to a server that would
;; refuse it, and never swallowed.

(defn runnable-command (runnable)
  "`[command-line directory]` for a rust-analyzer `Runnable` (the argument of
`rust-analyzer.runSingle`): a `cargo` runnable as `cargo ARGS -- EXECUTABLE-ARGS` (its
`overrideCargo` for `cargo`, its `environment` as assignments in front) in its `cwd` (else
its `workspaceRoot`); a `shell` runnable as its program and arguments. Nil for anything else.

    (lsp-lens/runnable-command {:kind \"cargo\" :args {:cargoArgs [\"test\" \"--package\" \"x\"] :executableArgs [\"t::a\" \"--exact\"] :cwd \"/p\"}})   ;=> [\"cargo test --package x -- t::a --exact\" \"/p\"]"
  (let (kind (when (map? runnable) (:kind runnable))
        arguments (or (when (map? runnable) (:args runnable)) {})
        words (fn (values)
                (into [] (map (seq/filter (or values []) string?) os/shell-quote)))
        environment (into []
                      (seq/keep (%map-pairs (or (:environment arguments) {}))
                        (fn ([name value])
                          (when (string? value)
                            (str (->string name)
                              "="
                              (os/shell-quote value))))))
        directory (or (:cwd arguments) (:workspaceRoot arguments)))
    (cond
      (= kind "cargo")
        (let (program (os/shell-quote (or (:overrideCargo arguments) "cargo"))
              executable (words (:executableArgs arguments)))
          [(string/join (append environment
                          [program]
                          (words (:cargoArgs arguments))
                          (words (:cargoExtraArgs arguments))
                          (if (empty? executable) [] (into ["--"] executable)))
             " ")
            directory])
      (and (= kind "shell") (string? (:program arguments)))
        [(string/join (append environment
                        [(os/shell-quote (:program arguments))]
                        (words (:args arguments)))
           " ")
          directory]
      else nil)))

(defn ed-lens-run-runnable (m lens)
  "`rust-analyzer.runSingle` (▶ Run, ▶ Run Test): the lens's runnable run as its cargo command in
*compilation* ([[runnable-command]], `compile/compile-run`), or said when it is not one."
  (let (found (runnable-command (first (:arguments lens))))
    (if (nil? found)
      (message m (str "lsp: " (:command lens) " gave nothing bedit knows how to run"))
      (compile/compile-run m (first found) (second found)))))

(defn- ed-lens-show-locations (m locations)
  ;; one location is a jump, several a picker (M-, returns from either)
  (cond
    (empty? locations) (message m "lsp: no locations")
    (= 1 (count locations)) (lsp-commands/ed-lsp-goto-loc m (first locations))
    else (lsp-commands/ed-lsp-locations-prompt m "Locations: " locations)))

(defn ed-lens-show-references (m lens)
  "`editor.action.showReferences` and rust-analyzer's `showReferences` (`[uri position
locations]`, a `N references` or `N implementations` lens): one location jumped to, several
in a picker."
  (ed-lens-show-locations m (lsp-protocol/lsp-locations (nth (:arguments lens) 2 []))))

(defn ed-lens-goto-location (m lens)
  "rust-analyzer's `gotoLocation` (`[location]`): jumped to."
  (ed-lens-show-locations m (lsp-protocol/lsp-locations (first (:arguments lens)))))

(defn ed-lens-no-debugger (m lens)
  "rust-analyzer's `debugSingle`: bedit has no debugger to hand it, which is said."
  (message m (str "lsp: bedit has no debugger for " (:command lens) " — ▶ Run runs it")))

(def *client-commands*
  ;; command name -> what bedit does for it, `(m lens) -> m`. Extend live for another server.
  {"rust-analyzer.runSingle" 'lsp-lens/ed-lens-run-runnable
   "rust-analyzer.debugSingle" 'lsp-lens/ed-lens-no-debugger
   "rust-analyzer.showReferences" 'lsp-lens/ed-lens-show-references
   "rust-analyzer.gotoLocation" 'lsp-lens/ed-lens-goto-location
   "editor.action.showReferences" 'lsp-lens/ed-lens-show-references})

(defn server-command? (caps command)
  "Whether `command` is one the server with `caps` runs (`executeCommandProvider.commands`).

    (lsp-lens/server-command? {:executeCommandProvider {:commands [\"a\"]}} \"a\")   ;=> true"
  (includes? (or (map/get-in caps [:executeCommandProvider :commands]) []) command))

;; check-allow: a client command's handler is resolved late, so its result is unknown to the
;; checker; every `*client-commands*` handler answers a model, as the fallback `m` is one
(sig ed-lens-run (model map -> model))
(check-allow :trusted
  (defn ed-lens-run (m lens)
    "Run `lens`'s command: a server command on the server that sent it
(`workspace/executeCommand` — the path a code action's command takes; the edits it makes
arrive as the server's `workspace/applyEdit`), a client command through `*client-commands*`,
and any other said."
    (let (file (buffer-file (ed-current-buf m))
          store (map/get-in m [:lsp-lenses file])
          command (:command lens)
          caps (map/get-in m [:lsp-servers (:conn store) :caps])
          client (get *client-commands* command))
      (cond
        (not (string? command)) (message m "lsp: that lens has no command yet")
        (server-command? caps command)
          (ed-lsp-ask-server m
            (:conn store)
            (lsp-execute-command)
            {:command command :arguments (:arguments lens)}
            nil
            (str (:title lens) "…"))
        client (ed-call-hook client m m lens)
        else (message m (str "lsp: " command " is a client command bedit does not run"))))))

(defn lens-at-cell (lenses rope line cell)
  "The shown lens of `lenses` on 0-based `line` whose title is painted at `cell` of its row
([[lens-rows]]: the line's indentation, then the titles joined ` | `) — the one left of a
separator, the first for a cell in the indentation, the last past the end; nil with none.

    (:title (lsp-lens/lens-at-cell [{:offset 0 :title \"Run\"} {:offset 0 :title \"Debug\"}] (text/string-> \"fn\") 0 7))   ;=> \"Debug\""
  (let (here (lenses-on-line lenses rope line))
    (when (not (empty? here))
      (letrec (pick (fn (left at)
                      (let (end (+ at (string/display-width (:title (first left))) 3))
                        (if (or (empty? (rest left)) (< cell end))
                          (first left)
                          (pick (rest left) end)))))
        (pick here (string/display-width (indentation rope line)))))))

(defn lens-click (m index line text cell)
  "A click on a lens row (`model/register-inlay-click`): the lens under the pointer run, as
M-x lsp-code-lens-run runs point's. `index` is the pool buffer — the current one, its pane
selected by the press; `text` the row as painted, `cell` the column clicked in it."
  (let (buffer (ed-buf-at m index)
        store (map/get-in m [:lsp-lenses (buffer-file buffer)])
        lens (when store (lens-at-cell (:lenses store) (buffer-rope buffer) line cell)))
    (if (nil? lens) m (ed-lens-run m lens))))

(defcommand cmd-lsp-code-lens-run
  (m key)
  "Run the code lens on point's line (Emacs lsp-mode's `lsp-avy-lens`, eglot's code lens): its
command goes to the language server, and any edit it makes is applied as a code action's is.
With several on the line, pick one."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer)
        store (when file (map/get-in m [:lsp-lenses file]))
        here (if store
               (seq/filter (lenses-on-line (:lenses store)
                             (buffer-rope buffer)
                             (buffer-current-line buffer))
                 (fn (lens) (string? (:command lens))))
               []))
    (cond
      (not (lens-on? m)) (message m "lsp: code lenses are off (M-x lsp-code-lens-mode)")
      (empty? here) (message m "lsp: no code lens on this line")
      (= 1 (count here)) (ed-lens-run m (first here))
      else
        (let (labeled (map (seq/enumerate here)
                        (fn ([position lens]) [(str (inc position) ". " (:title lens)) lens])))
          (assoc m
            :minibuffer
              (pool/ed-name-prompt "Code lens: "
                (map labeled first)
                (fn (mm label)
                  (let (hit (seq/find labeled (fn (pair) (= (first pair) label))))
                    (if (nil? hit) (message mm "lsp: lens gone") (ed-lens-run mm (second hit)))))))))))

(defn- ed-lens-clear (m)
  ;; every buffer's lens rows taken off and the files forgotten
  (assoc (fold (range (count (:buffers m)))
           m
           (fn (acc index)
             (let (buffer (ed-buf-at acc index)
                   inlays (wrap/raw-inlays buffer))
               (if (contains? inlays *inlay-owner*)
                 (ed-set-buf-at acc
                   index
                   (annotate buffer :inlay-lines (dissoc inlays *inlay-owner*)))
                 acc))))
    :lsp-lenses {}))

(defcommand cmd-lsp-code-lens-mode
  (m key)
  "Toggle the language server's code lenses — `3 references`, `Run test` — as a dim row above
the lines they are about. Off by default; init.blsp's `:lsp-code-lens true` starts it on."
  (if (lens-on? m)
    (message (assoc (ed-lens-clear m) :lsp-code-lens false) "lsp code lenses off")
    (message (assoc m :lsp-code-lens true :lsp-lenses {}) "lsp code lenses on")))

(defn ed-ev-lens-refresh (m input text-rows columns rows)
  "A server asking for its code lenses again (`[:lsp-refresh-code-lens connection]`,
`workspace/codeLens/refresh`): every file it lenses is due again, and each buffer of its on
screen is asked now."
  (let (connection (nth input 1 nil)
        stores (or (:lsp-lenses m) {})
        forgotten (assoc m
                    :lsp-lenses
                      (fold (%map-pairs stores)
                        stores
                        (fn (acc [path store])
                          (if (= (:conn store) connection)
                            (assoc acc path (dissoc store :requested))
                            acc)))))
    (if (not (lens-on? forgotten))
      forgotten
      (fold (ed-lsp-shown forgotten connection)
        forgotten
        (fn (acc [index _top])
          (let (entry (lens-entry acc (buffer-file (ed-buf-at acc index))))
            (if (= (:conn entry) connection) (ed-lens-request-at acc index) acc)))))))

;; ---- registration -------------------------------------------------------------------
(register-event-handler :lsp-code-lens 'lsp-commands/ed-ev-lsp-reply)
(register-event-handler :lsp-refresh-code-lens 'lsp-lens/ed-ev-lens-refresh)
;; a click on a lens's row runs that lens
(register-inlay-click *inlay-owner* 'lsp-lens/lens-click)
(register-event-handler :lsp-code-lens-resolve 'lsp-commands/ed-ev-lsp-reply)
;; after the text push (30), the signature (50) and semantic tokens (55)
(register-idle-job :lsp-code-lens
  {:order 60 :run 'lsp-lens/ed-launch-lens :stale? 'lsp-lens/ed-lens-due?})
;; after the snippet's carry (35) and semantic tokens' (45)
(register-post-step :lsp-code-lens {:order 46 :run 'lsp-lens/lens-follow})
