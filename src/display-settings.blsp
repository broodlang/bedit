(defmodule display-settings
  "The init file's per-mode DISPLAY settings, held where the code that reads them can reach
them without a model: `:line-numbers` (which buffers number their lines), `:long-lines` and
`:truncation-ellipsis` (how a line too long for its pane shows), `:wrap-prefix` (where a
wrapped line continues) — each a global `config/apply-to-model` re-binds at startup and on
M-x reload-config (a test `binding`s it instead), merged over its defaults here — and the
per-mode lookup every such setting reaches a buffer through (`ed-mode-setting`, a directory
file's first: `ed-local-setting`). `scroll` lays rows out by what these say; `panes`, `gutter`
and the per-mode switches (whitespace, fill, the fill-column rule) ask here."
  (:use conventions :only [mode-key])) ; a per-mode setting's entry

;; ---- per-mode settings, and which buffers number their lines ---------------------------
;; A display setting may be a map keyed by MODE: any layer in a buffer's stack, the most
;; specific named entry winning (`ed-mode-key`), so `prog` reaches every code mode and
;; `elixir` just Elixir. `:line-numbers`, `:show-whitespace` and `:long-lines` all read it.
;;
;; Emacs turns `display-line-numbers-mode` on from a mode's hook (`prog-mode-hook`) and
;; picks absolute or relative with `display-line-numbers-type`. Here the init file's
;; `:line-numbers` says both: `true`, `false` or `:relative` for every buffer, or a per-mode
;; map of them with `:default` for the rest; the most specific entry wins, as a mode's own
;; hook runs after its parent's. Held here beside `:long-lines`, and for the same reason: the
;; gutter that reads it has a buffer and no model.
;;
;; By default code is numbered and nothing else is — prose (text, markdown, org) and the
;; special buffers (a status, a listing, help) read as pages, as in Emacs, where
;; `display-line-numbers-mode` rides `prog-mode-hook`. A map in the init file is merged over
;; that; a bare `true`, `false` or `:relative` sets every buffer.
(def *line-numbers-defaults* {:default false 'prog true})

(defdyn *line-numbers* *line-numbers-defaults*) ; the user's `:line-numbers`, over the defaults

(defn ed-set-line-numbers (setting)
  "Make `setting` (the init file's `:line-numbers`: a value for every buffer, or a per-mode map
merged over `*line-numbers-defaults*`) the one every buffer is numbered by.
`config/apply-to-model` calls it at startup and on M-x reload-config."
  (def *line-numbers*
    (cond
      (map? setting) (merge *line-numbers-defaults* setting)
      (nil? setting) *line-numbers-defaults*
      else setting))
  nil)

(defn ed-mode-key (setting buf)
  "The key of the per-mode map `setting` that names the most specific mode in `buf`'s layer
stack (`:elixir` before `:prog` before `:text`), as the map spells it (keyword or bare
symbol), or nil when it names none of them. A language mode stacks over `prog`, which stacks
over `text`, so one entry for `prog` reaches every code mode the way Emacs's
`prog-mode-hook` does, and an entry for the language itself still wins. The rule is
`conventions/mode-key`'s, which the indentation settings read too."
  (mode-key setting buf))

(defn ed-mode-setting (setting buf default)
  "The value a per-mode `setting` gives `buf`: `setting` itself when it is not a map; else
the entry for the most specific mode in `buf`'s layer stack the map names (`ed-mode-key`),
else its `:default`, else `default`. How `:line-numbers` and `:show-whitespace` reach a mode
the way an Emacs mode hook does."
  (if (not (map? setting))
    setting
    (let (key (ed-mode-key setting buf))
      (if (nil? key) (get setting :default default) (get setting key)))))

(defn ed-local-setting (name setting buf default)
  "The value per-mode `setting` (init.blsp's `name`) gives `buf` ([[ed-mode-setting]]),
unless the project's directory-local settings give `buf` one for `name` first
(`conventions/dir-local`, `.bedit-locals.blsp`) — how a display switch (`:line-numbers`,
`:show-whitespace`, `:auto-fill`, `:wrap-prefix`) reaches a buffer when a directory file may
set it."
  (let (local (conventions/dir-local buf name))
    (if local (second local) (ed-mode-setting setting buf default))))

(defn ed-line-numbers-for (buf)
  "How `buf` numbers its lines under `*line-numbers*` (`ed-mode-setting`, a directory file's
first — [[ed-local-setting]]): `true` (absolute), `:relative` or `false` (no numbers)."
  (ed-local-setting :line-numbers *line-numbers* buf true))

;; ---- long lines: wrap, truncate or scroll ---------------------------------------------
;; How a line too long for its pane is shown is a POLICY (`wrap` has the three and what each
;; does to the row table). Which one a line takes, first answer wins:
;;
;;   1. the buffer's own toggle — `:long-lines` on the buffer (M-x toggle-truncate-lines,
;;      M-x visual-line-mode), the whole buffer
;;   2. the user's setting for the buffer's MODE — `:long-lines {git-status :wrap}` in
;;      init.blsp, the whole buffer. Any layer in its stack counts, the most specific
;;      first: `prog` reaches every code mode, `elixir` just Elixir (`ed-mode-key`)
;;   3. the line's KIND — `:line-kinds` on the buffer, a vector parallel to its lines (a
;;      section buffer marks headings `:section-heading` and body lines `:section-body`) —
;;      and the policy the user's setting gives that kind
;;   4. the mode's `:long-lines` facet (markdown and org wrap; every code mode scrolls, from
;;      the `prog` layer under it), the most specific layer's first
;;   5. the setting's `:default`
;;
;; The user's setting is `config`'s `:long-lines`, merged over `*long-lines-defaults*` and
;; held here as a dynamic var whose root the config re-binds (`ed-set-long-lines`) — a test
;; `binding`s it instead — as a theme switch re-binds
;; the palette: it is read from the row table's inputs, which have a buffer and no model.

(def *long-lines-defaults*
  ;; what `:long-lines` in init.blsp is merged over: lines scroll unless a mode says
  ;; otherwise, and in a section buffer (*git-status*, a log, *mur-status*) a heading — a
  ;; commit, a stash, a file — keeps to one row with an ellipsis while a hunk's code wraps
  {:default :scroll :section-heading :truncate :section-body :wrap})

(defdyn *long-lines* *long-lines-defaults*) ; the user's `:long-lines`, over the defaults
(defdyn *truncation-ellipsis* "…") ; what ends a truncated line (the user's `:truncation-ellipsis`)

(defn ed-set-long-lines (policies ellipsis)
  "Make the user's `:long-lines` `policies` (merged over `*long-lines-defaults*`) and
`:truncation-ellipsis` the ones every buffer is laid out by. `config/apply-to-model`
calls it at startup and on M-x reload-config; an empty or missing ellipsis is the default."
  (def *long-lines* (merge *long-lines-defaults* (if (map? policies) policies {})))
  (def *truncation-ellipsis*
    (if (and (string? ellipsis) (not (empty? ellipsis))) ellipsis "…"))
  nil)

(def *long-lines-policies*
  ;; each policy: the name its toggle's echo gives it (scrolling has no toggle) and what the
  ;; echo says of it. What config checks a `:long-lines` entry against and the toggles
  ;; report, so a policy's words live in one place
  {:wrap {:name "visual-line-mode" :says "long lines wrap"}
   :truncate {:name "truncate-lines" :says "long lines end in"}
   :scroll {:says "long lines scroll"}})

(defn ed-long-lines-says (policy)
  "What a toggle echoes about `policy`: `long lines wrap`, `long lines end in …` (with the
user's `:truncation-ellipsis`), `long lines scroll`."
  (let (says (:says (get *long-lines-policies* policy)))
    (if (= policy :truncate) (str says " " *truncation-ellipsis*) says)))

;; ---- the wrap prefix: where a wrapped line's continuation rows start --------------------
;; `wrap` lays a continuation row out under its line's indentation (`:indent`) or its fill
;; prefix (`:adaptive`), or from the edge (`:none`) — Emacs's `wrap-prefix`, adaptive-wrap.
;; Per mode, as `:long-lines` is: the init file's `:wrap-prefix`, a directory file's first
;; (`ed-local-setting`), held as a dynamic var the config re-binds, because the row table
;; that reads it has a buffer and no model.

(def *wrap-prefix-defaults*
  ;; code continues under its indentation, prose under its fill prefix (a list item's text)
  {:default :none 'text :adaptive 'prog :indent})

(defdyn *wrap-prefix* *wrap-prefix-defaults*) ; the user's `:wrap-prefix`, over the defaults

(defn ed-set-wrap-prefix (setting)
  "Make `setting` (the init file's `:wrap-prefix`: a style, or a per-mode map of them merged
over `*wrap-prefix-defaults*`) the one every buffer wraps by. `config/apply-to-model` calls
it at startup and on M-x reload-config."
  (def *wrap-prefix*
    (cond
      (map? setting) (merge *wrap-prefix-defaults* setting)
      (keyword? setting) setting
      else *wrap-prefix-defaults*))
  nil)

(defn ed-wrap-prefix-style (buf)
  "Where `buf`'s wrapped lines continue: `:indent`, `:adaptive` or `:none` — its directory
file's `:wrap-prefix`, else the init file's for its mode ([[ed-local-setting]])."
  (let (style (ed-local-setting :wrap-prefix *wrap-prefix* buf :none))
    (if (contains? #{:indent :adaptive} style) style :none)))
