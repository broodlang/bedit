;; src/terminal.blsp — a terminal buffer: a full-screen program under a pty, its screen
;; painted from `std/vt`.
;;
;; The project shell (bshell) and the project REPL host LINE-oriented programs: the
;; buffer is the line editor, RET sends a line, and decoding a stream's ANSI colours is
;; enough for the redraw a prompt does. A full-screen program — `claude`, `htop`, `vim`, a TUI test
;; runner — is the other thing: it positions the cursor, scrolls a region, switches to
;; the alternate screen, colours everything and BLOCKS on a query it expects the
;; terminal to answer. That needs a terminal, and `std/vt` (ADR-384) is one as pure
;; data: the worker that owns the pty feeds it the child's output and sends the
;; editor a rendered SCREEN; the editor writes that screen into the buffer's tail and
;; puts the cursor where the program put it. Emacs's `term` / `vterm`, in char mode.
;;
;; Where the pieces live:
;;   - the WORKER (a process per buffer) owns the pty child and the `vt` value: it
;;     feeds chunks (coalescing a burst into one screen), writes the replies the
;;     program waits on, encodes keys with `vt/key->bytes` (the vt knows the
;;     program's cursor-key mode) and answers a resize;
;;   - the MODEL fold (`ed-ev-term-screen`) keeps the buffer as scrollback + screen:
;;     `:term-hstart` is the char offset where the live screen begins, everything
;;     before it is history (rows the vt evicted, appended once, with their colour
;;     kept as `:history-spans`, apart from the screen's `:face-spans`), and point in
;;     any pane watching the screen IS the
;;     program's cursor;
;;   - a term buffer is in CHAR mode (the program's line editor: every key goes to it) or
;;     LINE mode (bedit's: the input region after the program's cursor is edited here,
;;     with comint's history and boundary commands, and RET sends the line) — Emacs
;;     `term-char-mode` / `term-line-mode`, `C-c C-k` / `C-c C-j`. The project REPL
;;     (`C-x p r`) opens in line mode; a full-screen program in char mode;
;;   - the OVERLAY (`term-overlay`, below) routes every key of a char-mode term buffer to the
;;     worker, except `C-x` — the editor's own prefix stays, so you can switch
;;     buffers and panes out of a running program — and `C-y`, which pastes into it;
;;     the mode layer adds `C-x c` (the editor's C-c map) and `C-x C-x` / `C-x C-y`
;;     (the literal keys), and `mouse/ed-mouse` hands a term pane's pointer to
;;     `term-mouse`.

(defmodule terminal
  "A terminal buffer (M-x term): a full-screen program under a pty,
its screen emulated by `std/vt` and painted into a buffer — every key goes to the
program, the buffer's tail is its screen, everything above it is scrollback."
  (:use editor/keymap :only [keymap-bind]) ; the mode keymap below
  (:use editor/layers :only [register-type-layers]) ; the buffer type below
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use clipboard)
  (:use minibuffer)
  (:use model)
  (:use pool) ; ed-open-buffer / ed-select / ed-project-root — the terminal buffer and where it runs
  (:use editor/buffer)
  (:use interactive)
  (:use comint) ; the input region a line-mode program's prompt leaves, its history
  (:use passwd)) ; ed-read-passwd / password-prompt? — a password the program asks for, read masked

;; ---- the buffer ---------------------------------------------------------------------

(defn term-buffer-name (label root)
  "The buffer name for a `label` program in `root`: `*claude: ~/src/x*`."
  (str "*" label ": " (path/abbreviate root) "*"))

(defn term-buffer? (buffer)
  "Whether `buffer` is a terminal buffer (mode `:type` `:term`), of either mode."
  (= (:type buffer) :term))

(defn- live-program (buffer)
  "The worker pid of term `buffer` while its program is still running, else nil."
  (if (:term-exited buffer) nil (:term-proc buffer)))

(defn term-live (m)
  "Every terminal whose program C-x C-c would kill (`model/register-exit-query`): a term
buffer whose program has not exited — claude, htop, the project REPL."
  (vec (seq/keep (:buffers m)
         (fn (buffer)
           (when (and (term-buffer? buffer) (live-program buffer))
             (str (buffer-name buffer) ": " (or (:term-label buffer) "a program")))))))

(register-exit-query :terminal 'terminal/term-live)

;; check-allow: `:term-hstart` is the term buffer's own field, which the buffer record
;; does not declare; every write below keeps it an int
(check-allow :trusted
  (defn- history-start (buffer)
    "The char offset where `buffer`'s live screen begins — everything before it is history."
    (or (:term-hstart buffer) 0)))
(sig history-start (buffer -> int))

;; ---- the worker: owns the pty child and the vt ----------------------------------------
;; State: {:buffer :root :command :cols :rows :palette :proc :vt :evicted :reply}.
;; The record constructors are named QUALIFIED because these sends run inside a
;; `spawn`ed process, where the bare name is not bound.

(def *term-coalesce-ms* 8) ; how long after a chunk the worker waits for the next before rendering
(defn- term-palette ()
  "How a program's colours look: the theme's sixteen, and its text / background for
inverse video (`theme/ansi-palette`, which a build's coloured output reads too)."
  (theme/ansi-palette))

(defn- term-write (state bytes)
  "Write `bytes` to the child, tolerating one that has gone."
  (let (proc (:proc state))
    (when (and proc (not (= bytes "")))
      (check-allow :discarded-catch (try (os/write proc bytes) (catch _ nil))))))

(defn- term-guarded-feed (state chunk)
  "`[vt faulted?]`: `vt/feed` of `chunk` — and when the emulator RAISES (a bug in it, met
by the program's output), the screen as it stood with the chunk dropped and nothing
carried, and one warning per worker (`:vt-faulted?` on the worker's state after). The
worker must outlive its emulator: one that dies leaves its buffer running forever, deaf
to every key."
  (try
    [(vt/feed (:vt state) chunk) (= true (:vt-faulted? state))]
    (catch e
      (do
        (when (not (:vt-faulted? state))
          (log/warn (str "terminal: the emulator failed on the program's output; a chunk was dropped: "
                      (error-message e))))
        [(assoc (:vt state) :carry "" :replies [] :evicted []) true]))))

(defn- term-feed (state chunk)
  "Fold `chunk` into the vt; answer what the program asked; keep the rows it scrolled off
until the next render."
  (let ([fed faulted?] (term-guarded-feed state chunk))
    (doseq (reply (:replies fed)) (term-write state reply))
    (assoc state
      :vt fed
      :evicted (into (:evicted state) (:evicted fed))
      :vt-faulted? faulted?)))

(defn- term-password (state)
  "Whether the program is reading a password right now — its terminal's echo off in line
mode (`os/pty-password?`, brood ADR-570) — or nil when that cannot be known (no child, a
closed one, a runtime without the primitive), which leaves the editor to guess from the
prompt's text. Asked once per render, which is once per burst of output: a prompt arriving
is output, so this is when the answer can change."
  (let (proc (:proc state))
    (when proc
      (check-allow :discarded-catch (try (os/pty-password? proc) (catch _ nil))))))

(defn- term-render (state)
  "Send the editor the screen as it stands — with `:password`, whether the program is
reading one (`term-password`) — the rows evicted since the last render read through the
palette ahead of it, and start a fresh eviction list."
  (let (palette (:palette state)
        lines (into [] (map (:evicted state) (fn (row) (vt/line row palette)))))
    (send (:reply state)
      (terminal/term-screen-event (:buffer state)
        lines
        (assoc (vt/screen (:vt state) palette) :password (term-password state))))
    (assoc state :evicted [])))

(defn- term-drain (state)
  "After a chunk: keep folding chunks that are already queued (a program writes a frame
as several), then render once the pipe goes quiet."
  (receive
    ([:proc _p data] (term-drain (term-feed state data)))
    (after *term-coalesce-ms* (term-render state))))

(defn- term-loop (state)
  (receive
    ([:proc _p data] (term-loop (term-drain (term-feed state data))))
    ([:proc-closed _p code] (do
                              (send (:reply state) (terminal/term-exit-event (:buffer state) code))
                              (term-loop (assoc state :proc nil))))
    ([:term-key key] (do
                       (term-write state (or (vt/key->bytes key (:vt state)) ""))
                       (term-loop state)))
    ([:term-paste text] (do (term-write state (vt/paste->bytes text (:vt state))) (term-loop state)))
    ;; line mode: the whole line, as typed, ended the way RET ends it
    ([:term-line text] (do (term-write state (str text "\r")) (term-loop state)))
    ([:term-mouse action button row col mods] (do
                                                (term-write state
                                                  (or (vt/mouse->bytes action
                                                        button
                                                        row
                                                        col
                                                        mods
                                                        (:vt state))
                                                    ""))
                                                (term-loop state)))
    ([:term-palette palette] (term-loop (term-render (assoc state :palette palette))))
    ([:term-resize cols rows] (do
                                (when (:proc state)
                                  (check-allow :discarded-catch
                                    (try (os/resize-pty (:proc state) cols rows) (catch _ nil))))
                                (term-loop (term-render (assoc state
                                                          :vt (vt/resize (:vt state) cols rows))))))
    ([:shutdown] (do (when (:proc state) (os/close (:proc state))) :term-stopped))))

(defn- term-boot (state)
  "Start the child under a pty of the buffer's size — through the platform's shell
(`os/shell-spawn-pty`: `sh -c` on Unix, `cmd.exe` under ConPTY on Windows), since a
program is configured as a command line — and serve it. A spawn the runtime refuses (a
Windows older than 10 1809 has no ConPTY; a directory that is gone) is said on the
buffer's screen, and the buffer ends as an exited program's does."
  (let (spawned (try
                  (os/shell-spawn-pty (:command state)
                    {:cwd (:root state)
                     :cols (:cols state)
                     :rows (:rows state)
                     :env {"TERM" "xterm-256color" "COLORTERM" "truecolor"}})
                  (catch e [:refused (str e)])))
    (if (vector? spawned)
      (term-refused state (second spawned))
      (term-loop (assoc state :proc spawned :vt (vt/make (:cols state) (:rows state)) :evicted [])))))

(defn- term-refused (state reason)
  "The program could not be started: put `reason` on the buffer's screen, then end it."
  (let (text (str "cannot start " (:command state) ": " reason))
    (do
      (send (:reply state)
        (terminal/term-screen-event (:buffer state)
          []
          {:text text
           :spans []
           :cursor (string/length text)
           :cursor-visible false
           :cursor-style :block}))
      (send (:reply state) (terminal/term-exit-event (:buffer state) nil))
      :term-stopped)))

(defn term-connect (buffer root command cols rows)
  "Spawn the worker for `buffer`: `command` under a `cols`×`rows` pty in `root`, for the
buffer's life. Returns its pid. Its screens go to the loop that opened it
(`ed-loop-address`), so a terminal opened in a second frame paints there."
  (let (state {:buffer buffer
               :reply (ed-loop-address)
               :root root
               :command command
               :cols cols
               :rows rows
               :palette (term-palette)})
    (spawn (term-boot state))))

(defn term-on-close (buffer)
  "The term layer's `:on-close`: the buffer is going, so is its worker and the program."
  (do (when (:term-proc buffer) (send (:term-proc buffer) [:shutdown])) buffer))

;; ---- the inbound events -------------------------------------------------------------

;; each folds through its named `ed-ev-*` fn (`model/defuievent`) — redefining one hot-swaps
(defuievent term-screen-event (buffer lines screen) ed-ev-term-screen) ; rows evicted since the last screen, then the screen
(defuievent term-exit-event (buffer code) ed-ev-term-exit) ; the program exited
(deftype screen (record &open :text string :spans vector :cursor int)) ; what `vt/screen` answers

;; ---- history: the rows above the screen ----------------------------------------------
;; A program that runs for hours must not leave a buffer the renderer carries whole, so
;; the history is trimmed from the top — in one cut, at a line start — once it grows past
;; the ceiling, down to the floor.

(def *term-scrollback-chars* 600000)
(def *term-scrollback-keep* 400000)
(def *term-scrollback-spans* 40000) ; a second ceiling: the faces the view is handed per frame
(defn- shift-spans (spans by)
  ;; `spans` moved `by` chars
  (into [] (map spans (fn ([from to face]) [(+ from by) (+ to by) face]))))

(defn- clip-spans (spans at)
  "`spans` cut at offset `at`: those past it dropped, one straddling it shortened."
  (into []
    (map (seq/filter spans (fn (span) (< (first span) at)))
      (fn ([from to face]) [from (math/min to at) face]))))

(defn- history-lines (lines base)
  "The evicted `lines` (`[text spans]` each, spans from 0) laid out one per line from
offset `base`: `[text spans end]` — their text, their spans made absolute, the offset
after them. The spans are gathered as a list and vectored once: a program that dumps ten
thousand lines evicts them in ONE event, and growing a vector per row is quadratic there."
  (let ([acc end] (fold lines
                    [() base]
                    (fn (state line)
                      (let ([acc pos] state
                            [text spans] line
                            shifted (fold spans
                                      acc
                                      (fn (gathered [from to face])
                                        (cons [(+ from pos) (+ to pos) face] gathered))))
                        [shifted (+ pos (string/length text) 1)])))
        text (string/join (map lines (fn (line) (str (first line) "\n"))) ""))
    [text (into [] (reverse acc)) end]))

(defn- trim-history (buffer)
  "`buffer` with its history cut back to `*term-scrollback-keep*` chars once it has grown past
`*term-scrollback-chars*` — or past `*term-scrollback-spans*` faces, a program that colours
every cell reaching that first; a no-op below both."
  (let (hstart (history-start buffer)
        hspans (:history-spans buffer)
        excess (- (count hspans) (math/quot (* 2 *term-scrollback-spans*) 3)))
    (if (and (<= hstart *term-scrollback-chars*) (<= (count hspans) *term-scrollback-spans*))
      buffer
      (let (by-chars (math/max 0 (- hstart *term-scrollback-keep*))
            ;; past the span ceiling: cut where the span a third of the way in begins
            by-spans (if (> excess 0) (first (nth hspans excess)) 0)
            at (math/max by-chars by-spans)
            newline (index-of (buffer-text buffer) "\n" at)
            cut (if (< newline 0) at (inc newline))
            kept (seq/filter hspans (fn (span) (>= (first span) cut))))
        (assoc (replace-region buffer 0 cut "")
          :term-hstart (- hstart cut)
          :history-spans (shift-spans kept (- cut)))))))

;; The input region is comint's (`input-region`, CLAMPED into the buffer): a kill
;; that reached above `:input-start` leaves the field past the end of the rope, and the
;; next screen would index off it — the shell's commands read the same field, so one
;; clamped reader serves both.

(defn- pending-input (buffer)
  "In line mode, what the user has typed past the program's cursor and not yet sent —
kept across a redraw, as comint keeps the text after its process mark. \"\" otherwise."
  (if (not (:term-line-mode buffer)) "" (input-text buffer)))
(sig pending-input (buffer -> string))

(defn- term-apply-screen (buffer lines screen)
  "`buffer` with the evicted `lines` appended to its history and `screen` written as
its tail, `:history-spans` the history's faces and `:face-spans` the screen's — two
sources the view slices apart (`spanpaint/ed-span-sources`), so a repaint of the screen never
copies the history's tens of thousands of faces — its own point at the
program's cursor — or, in line mode, at the end of the input still being typed, which
is re-appended after the screen and marked as the input region. The buffer is read-only
for the user in char mode; its producer unlocks it."
  (let (hstart (history-start buffer)
        line? (:term-line-mode buffer)
        typed (pending-input buffer)
        ;; how far into the input the password prompt's marker sits (`passwd/mark-prompt`):
        ;; the redraw rewrites the input, so the marker is put back at the same distance
        ahead (when (and line?
                      (not (nil? (editor/buffer/buffer-marker buffer passwd/*prompt-marker*))))
                (let ([start _] (input-region buffer)) (- (passwd/since-prompt buffer start) start)))
        ;; line mode shows the screen only up to the cursor: the input goes where the
        ;; program's prompt ends, not after its blank rows
        shown (if line? (string/substring (:text screen) 0 (:cursor screen)) (:text screen))
        spans (if line? (clip-spans (:spans screen) (:cursor screen)) (:spans screen))
        [htext hspans hend] (history-lines lines hstart)
        unlocked (set-read-only buffer false)
        written (assoc (replace-region unlocked hstart (buffer-length unlocked) (str htext shown))
                  :term-hstart hend
                  ;; a vector `into` copies the whole history, so only when rows left the
                  ;; screen; otherwise the history keeps its cell (and its slicing memo)
                  :history-spans
                    (if (empty? hspans)
                      (or (:history-spans buffer) [])
                      (into (or (:history-spans buffer) []) hspans))
                  ;; the program's cursor as the VIEW paints it, and what the MOUSE needs
                  :cursor-hidden (not (:cursor-visible screen))
                  :cursor-shape (:cursor-style screen)
                  :term-mouse (:mouse screen)
                  :term-alt-screen (:alt-screen screen)
                  ;; every row that ever left the screen: what tells a re-asked password
                  ;; prompt on a full screen from the one already answered
                  :term-scrolled (+ (or (:term-scrolled buffer) 0) (count lines)))
        ;; trim BEFORE the faces are laid out, so both halves share one offset
        trimmed (trim-history written)
        screen-start (history-start trimmed)
        cursor (+ screen-start (:cursor screen))
        faced (assoc (goto-char trimmed cursor)
                ;; where the PROGRAM's cursor is, which the pane's point stops being the
                ;; moment a reader clicks anywhere else
                :term-cursor cursor
                ;; the screen's faces alone: the history's stay in `:history-spans`
                :face-spans (shift-spans spans screen-start)))
    (if line?
      ;; the input region begins at the program's cursor; what was typed goes back after it
      (let (input (assoc (insert faced typed) :input-start cursor))
        (if (nil? ahead)
          input
          (editor/buffer/buffer-marker-set input passwd/*prompt-marker* (+ cursor ahead))))
      (set-read-only faced true))))
(sig term-apply-screen (buffer vector screen -> buffer))

(defn- term-follow (m index before after)
  "Every pane on pool buffer `index` whose point was watching the screen (at or past the
old `:term-hstart`) follows the program's cursor, and scrolls so the screen's first
row is its top row — the pane SHOWS the program. A pane scrolled up into the history
stays where the reader left it."
  (let (watching (history-start before)
        cursor (buffer-point after)
        top (eolnotes/line-of (buffer-rope after) (history-start after)))
    (ed-map-panes m
      (fn (pane)
        (if (and (= (:buffer pane) index) (or (nil? (:point pane)) (>= (:point pane) watching)))
          (assoc pane :point cursor :mark nil :top top)
          pane)))))

(defn ed-ev-term-screen (m event textrows cols rows)
  "A `term-screen-event` → the buffer's tail becomes the screen, the evicted rows join
its history, every pane watching the screen follows the cursor, and a pane that changed
size since tells its program."
  (let (index (ed-buffer-index-by-name m (term-screen-event-buffer event)))
    (if (nil? index)
      m
      (let (before (ed-buf-at m index)
            screen (term-screen-event-screen event)
            after (term-apply-screen before (term-screen-event-lines event) screen))
        (term-watch-password (term-sync-sizes (term-follow (ed-set-buf-at m index after)
                                                index before after))
          index screen)))))

;; ---- a password the program asks for -------------------------------------------------------
;; In line mode the buffer is the line editor, so what is typed SHOWS and RET remembers it —
;; right for `1 + 1`, wrong for the password `sudo` or `mix hex.user auth` asks for. Emacs's
;; comint watches for that prompt and reads the answer in the minibuffer, masked
;; (`comint-watch-for-password-prompt`, `send-invisible`); this does the same, on the better
;; of two signals: the worker asks the pty whether the program turned echo off for a line
;; read (`:password` on the screen, brood ADR-570), and the prompt's text is matched as
;; comint matches it (`passwd/password-prompt?`) — for a program that reads its password
;; through its own raw-mode editor, which the pty cannot tell from any other read.
;;
;; On the buffer: `:term-secret` (the program is waiting for one now), `:term-prompt-mark`
;; (where its prompt is) and `:term-secret-answered` (that mark when a password was sent).
;; A screen that shows the SAME prompt after the answer — a resize or a theme redraw before
;; the program has read it — is the old request, not a new one. The mark is the prompt line,
;; the screen cursor and how many rows have ever scrolled off the screen (`:term-scrolled`):
;; a re-asked prompt (`Sorry, try again.`) prints at least one line, so on a full screen,
;; where the cursor stays on the bottom row, the rows scrolled still tell it from the old one.
;; And a program that turned echo back ON since the answer has read it: echo going off again
;; is a new request wherever its prompt is — a cleared screen re-asking on the same row.
;; A char-mode terminal is the program's own screen, and is left alone.

(defn- screen-prompt (screen)
  "The line the program's cursor is on, up to the cursor: its prompt."
  (passwd/prompt-line (string/substring (:text screen)
                        0
                        (math/min (:cursor screen)
                          (string/length (:text screen))))))

(defn- term-open-password (m name &optional (seed nil))
  "Read the password terminal `name`'s program asks for, masked; RET sends it. With `seed`
(text the user already typed, or the key that opened the read), the read starts holding it:
what was typed into the input region since the prompt APPEARED is MOVED into the read — out
of the buffer, where it showed, and out of its undo history (`passwd/take-since-prompt`) —
and `seed` follows it. Text typed ahead of the prompt stays as the next input."
  (let (index (ed-buffer-index-by-name! m name)
        terminal (ed-buf-at m index)
        line (string/trim (or (:line (:term-prompt-mark terminal)) ""))
        prompt (if (= line "") "Password: " (str line " "))
        [start end] (input-region terminal)
        [taken typed] (if (nil? seed) [terminal ""] (passwd/take-since-prompt terminal start end)))
    (passwd/ed-read-passwd (ed-set-buf-at m index taken)
      prompt
      (fn (answered password) (term-send-secret answered name password))
      name
      (str typed (or seed "")))))

(defn- term-send-secret (m name password)
  "Send `password` to terminal `name`'s program as a line — to the program only: not into
the buffer, not into its history — and mark the request answered."
  (let (index (ed-buffer-index-by-name m name)
        gone "the program has exited; nothing sent")
    (if (nil? index)
      (message m gone)
      (let (terminal (ed-buf-at m index)
            pid (live-program terminal))
        (if (nil? pid)
          (message m gone)
          (do
            (send pid [:term-line password])
            (ed-set-buf-at m
              index
              (assoc terminal :term-secret false :term-secret-answered (:term-prompt-mark terminal)))))))))

(defn- term-watch-password (m index screen)
  "After screen `screen` folded into terminal `index`: in line mode, note whether its program
is waiting for a password, and when it has just started to — and you are looking at it,
with no other prompt open — read it (`term-open-password`). Elsewhere the first key typed
there, or RET, asks (`passwd/secret-overlay`)."
  (let (terminal (ed-buf-at m index))
    (if (not (:term-line-mode terminal))
      m
      (let (line (screen-prompt screen)
            echo-off? (= true (:password screen))
            mark {:scrolled (or (:term-scrolled terminal) 0) :cursor (:cursor screen) :line line}
            ;; echo back on (a definite false: nil is "cannot say") — the answer was read
            answered (let (previous (:term-secret-answered terminal))
                       (if (and (map? previous) (= false (:password screen)))
                         (assoc previous :echo-returned true)
                         previous))
            stale? (and (map? answered)
                     (= (dissoc answered :echo-returned) mark)
                     (not (and (:echo-returned answered) echo-off?)))
            secret? (and (not stale?) (or echo-off? (passwd/password-prompt? line)))
            asked? (and secret? (not (:term-secret terminal)))
            flagged (assoc terminal
                      :term-secret secret?
                      :term-prompt-mark mark
                      :term-secret-answered (if stale? answered nil))
            ;; what is typed from here on is the password's; what was typed before stays
            noted (ed-set-buf-at m index (if asked? (passwd/mark-prompt flagged) flagged)))
        (if (and asked? (= index (ed-current-index noted)) (ed-prompt-free? noted))
          (term-open-password noted (buffer-name terminal) "")
          noted)))))

;; A prompt that arrives while you are looking at something else only marks the buffer
;; (`:term-secret`); the first key typed when you come back opens the read
;; (`passwd/secret-overlay`, the shell's too).

(defn term-secret-pending? (m)
  "Whether the selected buffer is a line-mode terminal whose live program waits for a
password that no read has been opened for yet — where a typed key belongs to a masked read."
  (let (terminal (ed-current-buf m))
    (and (term-buffer? terminal)
      (:term-line-mode terminal)
      (= true (:term-secret terminal))
      (not (nil? (live-program terminal)))
      (nil? (:minibuffer m)))))

(defn term-secret-key (m input)
  "Open the masked read of the selected terminal's password prompt with typed key `input`
(`passwd/secret-key?`) as its last character, after whatever was typed since the prompt
appeared; type-ahead from before it stays in the input region."
  (term-open-password m (buffer-name (ed-current-buf m)) (passwd/secret-key-text input)))

(defn ed-ev-term-exit (m event textrows cols rows)
  "A `term-exit-event` → say so on the buffer's tail; the buffer stays to be read, `C-x k`
closes it."
  (let (code (term-exit-event-code event)
        note (str "\n[process exited"
               (if (nil? code) "" (str " with code " code))
               " — C-x k to close]\n"))
    (ed-update-named (passwd/ed-withdraw-read m (term-exit-event-buffer event))
      (term-exit-event-buffer event)
      (fn (terminal)
        (let (noted (insert (end-of-buffer (set-read-only terminal false)) note))
          (set-read-only (assoc noted :term-exited true :term-secret false) true))))))

;; ---- sizing: the vt is the size of the smallest pane that shows it ------------------------

(defn- term-pane-size (pane buffer)
  [(panes/ed-pane-text-cols pane buffer) (math/max 1 (panes/ed-pane-vrows pane buffer))])

(defn- term-wanted-sizes (m panes)
  "Pool index → the size its term program should have, for every term buffer with a live
program in `panes`: the SMALLEST of the panes showing it, column by column and row by
row (Emacs's `window-adjust-process-window-size-smallest`). One size per program, so
two panes of different sizes on one terminal never take turns resizing it — each resize
made the program repaint, each repaint resized it to the other pane, without end."
  (fold panes
    {}
    (fn (acc pane)
      (let (index (map/get-in pane [:payload :buffer])
            buffer (if (int? index) (ed-buf-at m index) nil))
        (if (or (nil? buffer) (not (term-buffer? buffer)) (nil? (live-program buffer)))
          acc
          (let ([cols rows] (term-pane-size pane buffer)
                smallest (get acc index))
            (assoc acc
              index
                (if (nil? smallest)
                  [cols rows]
                  [(math/min cols (first smallest)) (math/min rows (second smallest))]))))))))

(defn term-sync-sizes (m)
  "Tell every term worker whose size changed — `[:term-resize cols rows]`, recorded on
the buffer as `:term-size` so it is sent once per change. A term buffer shown in several
panes is sized to fit all of them (`term-wanted-sizes`)."
  (let (layout (panes/ed-layout-now m))
    (if (nil? layout)
      m
      (fold (term-wanted-sizes m (:panes layout))
        m
        (fn (synced [index size])
          (let (buffer (ed-buf-at synced index))
            (if (= size (:term-size buffer))
              synced
              (do
                (send (live-program buffer) [:term-resize (first size) (second size)])
                (ed-set-buf-at synced index (assoc buffer :term-size size))))))))))

(defn- term-size-for (m buffer)
  "The size a new term buffer gets: the selected pane's text area for `buffer` (a term
buffer draws no gutter), or 80×24 before any frame."
  (let (layout (panes/ed-layout-now m))
    (if (nil? layout)
      [80 24]
      (term-pane-size (panes/ed-selected-pane (:panes layout)) buffer))))

;; ---- keys: everything goes to the program ------------------------------------------------

(defn term-send-key (m key)
  "Forward `key` to the current term buffer's program (the worker encodes it against the
program's own cursor-key mode). Nothing to send once the program has exited."
  (do
    (when-let (pid (live-program (ed-current-buf m)))
      (send pid [:term-key key]))
    m))

;; check-allow: `ed-kill-head` answers `[model text]`, and a vector's parts are unknown to
;; the checker; every branch answers that model
(check-allow :trusted
  (defcommand cmd-term-paste
    (m key)
    "C-y in a terminal buffer: paste the kill ring's head into the program — bracketed
when the program asked for pastes to be marked, so it can tell one from typing."
    (let ([headed text] (ed-kill-head m)
          pid (live-program (ed-current-buf headed)))
      (when (and text pid) (send pid [:term-paste text]))
      (if (nil? text) (message headed "kill ring is empty") headed))))

;; ---- the commands --------------------------------------------------------------------------

(defn- term-start (m label root command line-mode?)
  "Open a `label` terminal buffer running `command` in `root`, sized to the selected pane,
in line mode when `line-mode?`."
  (let (fresh (assoc (editor/layers/set-buffer-type (set-read-only (make-buffer ""
                                                                     (term-buffer-name label root))
                                                      (not line-mode?))
                       :term)
                :dir root
                :term-hstart 0
                :history-spans []
                :face-spans []
                :term-line-mode line-mode?
                :term-label label
                :input-start (if line-mode? 0 nil)
                :input-history []
                :input-history-index nil
                :input-draft nil)
        [cols rows] (term-size-for m fresh)
        pid (term-connect (buffer-name fresh) root command cols rows)
        buffer (assoc fresh :term-proc pid :term-size [cols rows]))
    (message (ed-open-buffer m buffer)
      (str command
        (if line-mode?
          " (RET sends the line; C-c C-k for char mode)"
          " (C-x k closes; every other key goes to it)")))))

(defn term-run (m label root command)
  "A terminal buffer `label` in `root` running shell `command` line (in char mode), selected:
the one of that name when it is already open, else a new one. How a package puts a program
in a terminal of its own, a name per session (bedit-agent's Claude Code sessions)."
  (let (index (ed-buffer-index-by-name m (term-buffer-name label root)))
    (if (nil? index) (term-start m label root command false) (ed-select m index))))

(defn- term-open (m label command &optional (line-mode? false))
  "Switch to this project's `label` terminal, or start one running `command`."
  (let (root (or (ed-project-root m) (:dir (ed-current-buf m)) (file/cwd))
        index (ed-buffer-index-by-name m (term-buffer-name label root)))
    (if (nil? index) (term-start m label root command line-mode?) (ed-select m index))))

;; ---- line mode ------------------------------------------------------------------------------
;; The program's screen ends at its cursor; from there the buffer is bedit's — an input
;; region (`:input-start`, the field comint's boundary and history commands read) that RET
;; sends whole. The echo comes back from the pty and REPLACES the tail, so the region is
;; cleared on send rather than left to show twice.

(defn- set-line-mode (m on)
  (let (terminal (ed-current-buf m))
    (if (not (term-buffer? terminal))
      m
      ;; on: the tail past the cursor (the screen's blank rows) goes, the region starts at
      ;; the cursor; off: whatever was typed and not sent goes, the next redraw restores
      ;; ON cuts at the PROGRAM'S cursor, never at point: point is the pane's, and a reader
      ;; who clicked up into the scrollback before pressing this would otherwise delete
      ;; everything below the click
      (let (cut (if on
                  (math/min (or (:term-cursor terminal) (buffer-length terminal))
                    (buffer-length terminal))
                  (first (input-region terminal)))
            trimmed (replace-region (set-read-only terminal false) cut (buffer-length terminal) "")
            switched (assoc (set-read-only trimmed (not on))
                       :term-line-mode on
                       :input-start (if on cut nil)))
        (message (ed-set-buf m (goto-char switched cut))
          (if on
            "line mode: RET sends the line (C-c C-k for char mode)"
            "char mode: every key goes to the program (C-c C-j for line mode)"))))))

(defcommand cmd-term-line-mode
  (m key)
  "C-c C-j (C-x c C-j from char mode): line mode — the input after the program's cursor is
edited here with the shell's history and boundary keys, and RET sends it whole."
  (set-line-mode m true))

(defcommand cmd-term-char-mode
  (m key)
  "C-c C-k: char mode — every key goes straight to the program, which does its own editing."
  (set-line-mode m false))

(defcommand cmd-term-send-line
  (m key)
  "RET in a line-mode terminal: send the input region to the program as one line and
remember it in the buffer's history — in memory, this terminal's own: a line typed at iex
or `nest repl` is not a shell command, so it stays out of the shell's history file. The
program's echo replaces it.

While the program waits for a PASSWORD (`term-watch-password`), RET reads it masked
instead; what was typed since the prompt appeared is sent as the answer but never
remembered, and leaves no undo step behind. Text typed ahead of the prompt is not the
password: it stays as the next input."
  (let (terminal (ed-current-buf m)
        [start end] (input-region terminal)
        line (string/substring (buffer-text terminal) start end)
        secret (string/substring (buffer-text terminal) (passwd/since-prompt terminal start) end)
        pid (live-program terminal))
    (cond
      (nil? pid) m
      (and (:term-secret terminal) (= secret "")) (term-open-password m (buffer-name terminal))
      ;; out of the buffer AND its undo history: it was the password
      (:term-secret terminal)
        (let (sent (term-send-secret m (buffer-name terminal) secret))
          (ed-set-buf sent (first (passwd/take-since-prompt (ed-current-buf sent) start end))))
      else
        (do
          (send pid [:term-line line])
          (let (remembered (if (string/blank? line) m (remember-input m line))
                cleared (replace-region (ed-current-buf remembered) start end ""))
            (ed-set-buf remembered cleared))))))

(defn term-send-invisible (m)
  "A terminal's `:send-invisible` service: in line mode, read a line masked for the program
(`comint/cmd-send-invisible` is the command); in char mode the program reads its own keys."
  (let (terminal (ed-current-buf m))
    (cond
      (and (:term-line-mode terminal) (live-program terminal))
        (term-open-password m (buffer-name terminal))
      (live-program terminal)
        (message m "char mode: the program reads its own keys (C-c C-j for line mode)")
      else (message m "no program here to send to"))))

(defcommand cmd-project-repl
  (m key)
  "Open this project's REPL (C-x p r): `iex -S mix` in a mix project, `nest repl` in a
Brood one, `python3`, `node` — whatever `toolchain/*toolchains*` says this project's is,
in a terminal buffer in LINE mode: bedit's editing, history and C-r over the input,
RET sends the line; `C-c C-k` hands the keys to the REPL's own line editor instead."
  (let (root (ed-project-root m)
        command (if (nil? root) nil (toolchain/repl-command m)))
    (cond
      (nil? root) (message m "not in a project")
      (nil? command) (message m (str "no REPL for a " (toolchain/name-of m) " project"))
      else (term-open m "repl" command true))))

(defn shell-command-for (platform shell interpreter)
  "The command line C-x p t runs on `platform` (`os/type`), given the user's `$SHELL` (`shell`,
or nil) and the platform's interpreter (`interpreter`, `(first (os/shell))`): on Unix the
user's shell, else `sh`, quoted as one word for `sh -c`; on Windows the platform's shell —
never `$SHELL`, which Git Bash and MSYS set to a POSIX path (`/usr/bin/bash`) that cmd.exe
cannot run — double-quoted for cmd.exe's line, so a `COMSPEC` with a space in it is one word.

    (terminal/shell-command-for :linux \"/bin/zsh\" \"sh\")   ;=> \"/bin/zsh\""
  (if (= platform :windows)
    (str "\"" interpreter "\"")
    (os/shell-quote (if (string/blank? (or shell "")) interpreter (or shell interpreter)))))

(defcommand cmd-term
  (m key)
  "Open a terminal for the current project (C-x p t): your shell (`$SHELL`, else `sh` —
the platform's shell on Windows, [[shell-command-for]]) under a real terminal emulator in the project root — for the
programs the project shell's line editor cannot host: `htop`, `vim`, a TUI test runner. Each project has its
own; re-running switches to it. With a prefix argument (`C-u`), asks for the program to
run instead, in a buffer named after it."
  (if (nil? (current-prefix-arg m))
    (term-open m "term" (shell-command-for (os/type) (os/env "SHELL") (first (os/shell))))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Run in a terminal: " "")
         :on-complete (fn (prompted command)
                        (if (string/blank? command)
                          (message prompted "no program")
                          (term-open prompted
                            (first (string/split (string/trim command) " "))
                            (string/trim command))))})))
(interactive/register-prefix-consuming 'terminal/cmd-term)

;; ---- the keys the program cannot have ---------------------------------------------------
;; C-x is the editor's prefix and C-y pastes, so neither reaches the program as itself;
;; `C-x C-x` / `C-x C-y` send the literal. And the editor's C-c map — tests, the debugger,
;; the playground — sits under a key the program owns outright, so `C-x c` stands in for
;; C-c: the next key resolves in that map exactly as if C-c had been pressed.

(defcommand cmd-term-send-literal
  (m key)
  "C-x C-x / C-x C-y in a terminal buffer: send the chord's last key (C-x, C-y) to the
program as itself — the two keys the editor keeps for its own use."
  (term-send-key m key))

(defcommand cmd-term-editor-c-c
  (m key)
  "C-x c in a terminal buffer: the editor's C-c map — the next key resolves in it as if
C-c had been pressed (`C-x c t` runs the tests), since the program owns C-c itself."
  (userkeys/ed-press-prefix m :ctrl-c))

;; ---- the mouse ----------------------------------------------------------------------------
;; A program that asked for mouse reporting gets clicks, drags and the wheel in the cells of
;; ITS screen — the pane's rows mapped through the history above the screen. A pane scrolled
;; up into the history is being read, and its clicks are the editor's. A full-screen program
;; that did not ask for the mouse still gets the wheel as arrow keys, which is what every
;; terminal does for `less` and friends; anywhere else the wheel scrolls the buffer.

(defn- term-screen-cell (m pane buffer row col)
  "The `[row col]` of the program's screen under window cell (`row`, `col`) in `pane`, or
nil when that cell is above the screen (history) or off the text."
  (let ([x y _ _] (:rect pane)
        ;; a zoomed pane's cells are bigger than the window's: the click lands in fewer of them
        [width-ratio height-ratio] (panes/ed-zoom-ratio pane)
        text-row (math/floor (/ (- row y) height-ratio))
        text-col (math/floor (/ (- col x) width-ratio))
        screen-top (eolnotes/line-of (buffer-rope buffer) (history-start buffer))
        screen-row (- (+ (panes/ed-pane-top pane buffer) text-row) screen-top))
    (if (and (>= text-row 0)
          (< text-row (panes/ed-pane-vrows pane buffer))
          (>= text-col 0)
          (>= screen-row 0))
      [screen-row text-col]
      nil)))

(defn term-mouse (m pane input)
  "Fold a `[:mouse action button row col mods]` event over `pane` (which shows a term
buffer) into the program, answering the model when the event was the program's — else
nil, and the editor handles it as it would in any buffer."
  (let (buffer (panes/ed-pane-buf m pane)
        pid (live-program buffer)
        action (nth input 1)
        wheel? (includes? [:scroll-up :scroll-down] action)
        cell (term-screen-cell m pane buffer (nth input 3) (nth input 4)))
    (cond
      (nil? pid) nil
      ;; a program that did not ask for the mouse: a middle click pastes the PRIMARY selection
      ;; into it, as text typed — bracketed when it asked for that — as C-y pastes the kill
      ;; ring (Emacs's `term-mouse-paste`). Anywhere in the pane, history included: the
      ;; program is what reads it
      ;; In LINE mode the input after the prompt is bedit's, so the selection joins the line
      ;; being typed — Emacs's `term-mouse-paste` is a char-mode binding; sent to the program
      ;; it would arrive AHEAD of the half-typed input, still unsent
      (and (= action :press)
        (= (nth input 2) :middle)
        (not (:term-mouse buffer))
        (:term-line-mode buffer))
        (ed-primary-ask m 'terminal/term-primary-into-input (buffer-name buffer))
      (and (= action :press) (= (nth input 2) :middle) (not (:term-mouse buffer)))
        (ed-primary-ask m 'terminal/term-primary-answered pid)
      (nil? cell) nil
      (:term-mouse buffer)
        (do
          (send pid [:term-mouse action (nth input 2) (first cell) (second cell) (nth input 5 [])])
          m)
      ;; a full-screen program without the mouse: the wheel is arrow keys, three a notch
      (and wheel? (:term-alt-screen buffer))
        (let (key (if (= action :scroll-up) :up :down))
          (doseq (_ (range 3)) (send pid [:term-key key]))
          m)
      else nil)))

(defn term-paste-text (m text)
  "The `:paste` facet: a paste the editor's own terminal delivered whole (`[:paste text]`, brood
ADR-586) into the program of a char-mode terminal buffer — bracketed when the program asked
for pastes to be marked, as C-y pastes the kill ring. nil in line mode, whose input is bedit's:
the paste is an ordinary yank there."
  (when (term-char-mode? m)
    (let (pid (live-program (ed-current-buf m)))
      (do (when pid (send pid [:term-paste text])) m))))

(defn term-primary-answered (m text pid)
  "The rest of a middle click in a terminal pane once the PRIMARY selection's `text` is known:
pasted into the program `pid` (`[:term-paste text]`, the worker brackets it when the program
asked) — or said, when there is nothing selected anywhere."
  (if (or (not (string? text)) (= text ""))
    (message m "no primary selection to paste")
    (do (send pid [:term-paste text]) m)))

(defn term-primary-into-input (m text name)
  "The rest of a middle click in the LINE-mode terminal `name` once the PRIMARY selection's
`text` is known: put into the input being typed — at point when point is in the input
region, else at its end — never sent to the program ahead of it."
  (let (index (ed-buffer-index-by-name m name))
    (cond
      (or (not (string? text)) (= text "")) (message m "no primary selection to paste")
      (nil? index) m
      else
        (let (terminal (ed-buf-at m index)
              start (or (:input-start terminal) (buffer-length terminal))
              at (if (< (buffer-point terminal) start)
                   (goto-char terminal (buffer-length terminal))
                   terminal))
          (ed-set-buf-at m index (insert at text))))))

;; ---- the mode line ---------------------------------------------------------------------

(defn term-modeline (m buffer)
  "The term layer's `:modeline` service: the program's state and which mode the keys are
in — `● claude · char`, `○ exited`."
  (if (:term-exited buffer)
    "○ exited"
    (str "● " (or (:term-label buffer) "program") " · " (if (:term-line-mode buffer) "line" "char"))))

;; ---- the theme ------------------------------------------------------------------------------

(defn term-repalette (m)
  "After a theme switch: every running program's screen is re-read through the new
palette. History keeps the colours it was written in — its cells are gone."
  (doseq (buffer (:buffers m))
    (when-let (pid (and (term-buffer? buffer) (live-program buffer)))
      (send pid [:term-palette (term-palette)])))
  m)

;; term-mode: a full-screen program under a real terminal emulator (M-x term —
;; src/terminal.blsp). Its keys never reach a keymap: `term-overlay` hands every key but
;; C-x to the program, so the layer is the buffer's IDENTITY — no gutter (a terminal has
;; none, and the vt is sized to the pane's full width), the one editor binding a terminal
;; needs (C-y pastes, as in vterm — the program never wanted a ^Y), and the hook that stops the program with the buffer. Not stacked on text-mode.
(def term-mode-layer
  {:name 'term
   :doc "A terminal: every key goes to the program; C-x is still yours, C-y pastes, C-x c is C-c. In line mode RET sends the line."
   :keymap (-> {}
             (keymap-bind [:ctrl-y] 'terminal/cmd-term-paste)
             ;; the two modes (Emacs term: C-c C-j line, C-c C-k char); reachable from char
             ;; mode as C-x c C-j, since C-c itself belongs to the program there
             (keymap-bind [:ctrl-c :ctrl-j] 'terminal/cmd-term-line-mode)
             (keymap-bind [:ctrl-c :ctrl-k] 'terminal/cmd-term-char-mode)
             ;; LINE mode only (in char mode the overlay owns these keys before any keymap):
             ;; RET sends the input region; the history and boundary keys are comint's, over
             ;; the same `:input-start` field
             (keymap-bind [:enter] 'terminal/cmd-term-send-line)
             (keymap-bind [:ctrl-a] 'comint/cmd-comint-beginning-of-input)
             (keymap-bind [:home] 'comint/cmd-comint-beginning-of-input)
             (keymap-bind [:ctrl-b] 'comint/cmd-comint-backward-char)
             (keymap-bind [:left] 'comint/cmd-comint-backward-char)
             (keymap-bind [:backspace] 'comint/cmd-comint-delete-backward)
             (keymap-bind [:up] 'comint/cmd-comint-previous-history)
             (keymap-bind [:ctrl-p] 'comint/cmd-comint-previous-history)
             (keymap-bind [:down] 'comint/cmd-comint-next-history)
             (keymap-bind [:ctrl-n] 'comint/cmd-comint-next-history)
             (keymap-bind [:ctrl-r] 'comint/cmd-comint-history-search)
             ;; the two keys kept from the program, sent as themselves
             (keymap-bind [:ctrl-x :ctrl-x] 'terminal/cmd-term-send-literal)
             (keymap-bind [:ctrl-x :ctrl-y] 'terminal/cmd-term-send-literal)
             ;; the editor's C-c map, under a key the program does not own
             (keymap-bind [:ctrl-x "c"] 'terminal/cmd-term-editor-c-c))
   :send-invisible 'terminal/term-send-invisible
   ;; what the input layer and the mouse ask of a mode
   :secret-pending? 'terminal/term-secret-pending?
   :secret-key 'terminal/term-secret-key
   :paste 'terminal/term-paste-text
   :mouse 'terminal/term-mouse
   ;; line mode: point never enters the program's prompt (the shell's guard, same field)
   :post-key 'comint/input-post-key
   :modeline 'terminal/term-modeline
   :hooks {:on-close '(terminal/term-on-close)}})
(register-type-layers :term (list 'terminal/term-mode-layer))

(defn- ed-terminals? (m)
  ;; whether any pooled buffer is a terminal: a resize and a theme switch ask first
  (any? (:buffers m) term-buffer?))

(defn term-char-mode? (m)
  "Whether the selected pane shows a terminal buffer in CHAR mode: the program's keys. A term in
line mode is edited like a shell, through the keymaps."
  (let (terminal (ed-current-buf m)) (and (term-buffer? terminal) (not (:term-line-mode terminal)))))

;; A terminal buffer: every key is the program's but the editor's own — C-x (its prefix), C-y
;; (paste into it) and M-x (a command by name, which no terminal program needs and losing it
;; inside a terminal costs more: vterm keeps it for the editor too).
(def *term-editor-keys* [:ctrl-x :ctrl-y :alt-x])

(defrecord term-overlay ())
(impl Overlay
  term-overlay
  (overlay-active? (_ m) (and (nil? (:pending m)) (term-char-mode? m)))
  (overlay-owns? (_ m input) (not (includes? *term-editor-keys* input)))
  (overlay-handle (_ m input) (term-send-key m input)))
;; No `overlay-exit`: C-x falling through starts a chord, and the buffer is still a terminal.

(register-overlay :term 90 (term-overlay))

(defn term-resized (m)
  "A resize step: a pty child lays out against the size it is TOLD (`iex` wraps its input at
the width it believes it has), so every terminal whose panes changed size is told."
  (if (ed-terminals? m) (term-sync-sizes m) m))

(defn term-recoloured (m)
  "A palette step: a running program's SCREEN is read again through the new colours."
  (if (ed-terminals? m) (term-repalette m) m))

(register-resize-step :terminals 'terminal/term-resized)
(register-palette-step :terminals 'terminal/term-recoloured)
