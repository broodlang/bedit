(defmodule gitcore
  "The ground every part of the git porcelain stands on: running git (`git-git`, never
prompting), finding the repo a buffer is about (`git-resolve-root`), reading `git status
--porcelain -z`, the upstream and how far ahead or behind it HEAD is, the refs, remotes and
stashes, and which operation (rebase, merge, cherry-pick, revert, bisect) is part-way through.

Every command that changes the repo goes through one seam here, and none runs on the loop:
`git-do` queues it (journalled in the shared process log, `$`, in `vcsproc`) and refreshes,
`git-run-then` queues it and goes on with its result, `git-gather` asks git what a key must
know before it can go on, `git-launch-op` runs a network one, and `vcsproc/vcs-confirm` asks
before one that cannot be undone. Where the repo is — its root, its git dir, the operation
part-way through — is read from the disk, with no process at all. The faces the git buffers
share and the plain-text git buffer type live here too.

Nothing here knows about the status buffer: refreshing it is `git-refresh-status`, which
reaches `gitstatus` by name, because `gitstatus` stands on this module."
  (:use editor/keymap :only [keymap-bind]) ; the plain-text git keymap below
  (:use editor/layers :only [register-type-layers]) ; their buffer types
  (:use model) ; message / ed-read-char / ed-apply / ed-buffer-index-by-name
  (:use pool) ; ed-default-dir / ed-display-buffer / ed-upsert-named
  (:use interactive) ; defcommand
  (:use sectionbuf) ; sb-ctx — the repo and `:reload` a git section buffer carries
  (:use vcsproc)) ; vcs-run / vcs-launch / vcs-report-cmd — the process log and the off-loop runner
;; `theme` (a project source module, loaded with the image) provides the *green* / *red* /
;; *blue* / *yellow* / *subtext* dynamic-var colour globals this file reads bare.
;; ---- the git buffers' faces ---------------------------------------------------
;; A unified diff's faces (added, removed, hunk, file, meta) are every VCS's and live in
;; `vcsproc`; these are what only git's buffers show.

(theme/defchrome git-face-section {:fg *blue* :bold true}) ; a *git-status* section header
(theme/defchrome git-face-note {:fg *subtext* :italic true})
(def git-face-summary {:bold true}) ; a commit's summary line, heading its message
(theme/defchrome git-face-hash {:fg *overlay0*}) ; a commit hash — quiet, as Magit's grey `magit-hash`
(theme/defchrome git-face-tag {:fg *yellow*}) ; a tag in a commit's labels and the refs buffer (`magit-tag`)
(theme/defchrome git-face-branch-current {:fg *blue* :bold true :underline true}) ; the checked-out branch among a commit's labels (`magit-branch-current`)
(theme/defchrome git-face-author {:fg *peach*}) ; the log margin's author (`magit-log-author`)
(theme/defchrome git-face-date {:fg *overlay0*}) ; the log margin's age (`magit-log-date`)
;; the status-bar segment faces (branch + colour-coded working-tree indicator): staged reads
;; green, unstaged yellow, untracked dim; a clean/staged tree dot is green. Chrome faces
;; over the theme's colour tokens, kept here beside the rest of git's.
(theme/defchrome git-face-branch {:fg *subtext*}) ; the ⎇ branch label (quiet, secondary)
(theme/defchrome git-face-clean {:fg *green*}) ; the state dot when the tree is clean / staged
(theme/defchrome git-face-staged {:fg *green*}) ; the +N staged-change count (ready to commit)
(theme/defchrome git-face-unstaged {:fg *yellow*}) ; the ~N unstaged-change count (modified, dirty)
(theme/defchrome git-face-untracked {:fg *overlay0*}) ; the ?N untracked-file count (dim)
;; the *git-status* header block: a local branch (the `Head:` line) reads blue, a remote /
;; upstream branch (the `Merge:` line) green — Magit's magit-branch-local / -remote.
(theme/defchrome git-face-branch-local {:fg *blue* :bold true}) ; the `Head:` line's branch
(theme/defchrome git-face-branch-remote {:fg *green* :bold true}) ; the `Merge:` line's upstream

;; ---- running git ------------------------------------------------------------

(def *git-env*
  ;; Every git the editor runs: there is no terminal for git to prompt on — bedit started
  ;; from a shell would hand git THAT terminal, and a password prompt would appear in a
  ;; window nobody is looking at while the command hangs. A credential git cannot find is a
  ;; failed command, reported like any other.
  {"GIT_TERMINAL_PROMPT" "0"})

(def *git-background-env*
  ;; A git nobody asked for (the background fetch) must not ask anything at all: no askpass
  ;; dialog popping up every three minutes, no ssh passphrase prompt. `true` as the askpass
  ;; program answers every question with nothing, so the fetch fails quietly instead.
  (merge *git-env*
    {"GIT_ASKPASS" "true" "SSH_ASKPASS" "true" "GIT_SSH_COMMAND" "ssh -o BatchMode=yes"}))

(defn git-git (root args &optional (opts {}))
  "Run git in `root` with `args` (a vector); `{:exit :stdout :stderr}`. `core.quotePath=false`
keeps non-ASCII paths literal (no octal escapes) in status / diff output; `*git-env*` keeps
git from prompting. `opts` go to `os/cmd` (`:stdin`, `:timeout-ms`, `:env` over `*git-env*`)."
  (os/cmd "git"
    (into ["-C" root "-c" "core.quotePath=false"] args)
    (assoc opts :env (merge *git-env* (get opts :env {})))))

(defn git-read (root args &optional (opts {}))
  "`git-git` for a READ that must leave the repository as it found it: the mode line's
summary, the status buffer's collection, a view. `git status` and `git diff` refresh the
index as a side effect and write it back under `index.lock` — so a summary on the idle
beat, or a status refresh after the background fetch, could make the user's own `git
commit` at that moment fail with \"Unable to create '.git/index.lock': File exists\".
`GIT_OPTIONAL_LOCKS=0` stops `status` from writing; the porcelain `diff` ignores that and
needs `diff.autoRefreshIndex=false`, which leaves its answer the same (a file whose stat
moved but whose text did not is still compared by content, in memory)."
  (git-git root
    (into ["-c" "diff.autoRefreshIndex=false"] args)
    (assoc opts :env (merge {"GIT_OPTIONAL_LOCKS" "0"} (get opts :env {})))))

(defn git-output (root args)
  "What `git args` printed on stdout in `root`, trimmed — \"\" when it printed nothing. For
a question with a one-line answer (`rev-parse`, `config`, a commit message); a caller that
must tell failure from an empty answer reads `git-git`'s `:exit`."
  (string/trim (:stdout (git-git root args) "")))

(defn git-lines (root args)
  "The non-empty lines `git args` printed on stdout in `root` — `()` when it printed none.
For a list, one name or hash a line (`git remote`, `git log --format=%h`)."
  (seq/reject (string/split (git-output root args) "\n") empty?))

;; ---- where the repo is, read from the disk ---------------------------------------
;; The two questions nearly every command asks first — which work tree is this, and where
;; is its `.git` — are answered by looking, not by running git: a `stat` per directory up
;; to the top, and one small file read in a worktree — not `git rev-parse`, a process on the
;; loop before every key in the porcelain.

(defn- git-toplevel-from (dir limit)
  ;; the nearest directory from `dir` up that holds a `.git` (a directory, or a worktree's
  ;; or submodule's pointer file)
  (cond
    (file/exists? (path/join dir ".git")) dir
    (or (<= limit 0) (= dir (path/dirname dir))) nil
    else (git-toplevel-from (path/dirname dir) (dec limit))))

(defn git-toplevel (dir)
  "The git work-tree root containing `dir` — the nearest directory, walking up, that holds a
`.git` — or nil when `dir` isn't in a repo. Read from the disk, no process.

    (gitcore/git-toplevel \"/\")   ;=> nil"
  (if (nil? dir) nil (git-toplevel-from (path/absolute dir) 64)))

(defn git-dir (root)
  "The absolute git directory of the work tree `root`: `<root>/.git`, or — where `.git` is a
FILE, as in a worktree or a submodule — the directory its `gitdir:` line names (relative to
`root` when it is not absolute). Read from the disk; nil when there is neither."
  (let (dot (path/join root ".git"))
    (cond
      (file/dir? dot) dot
      (file/exists? dot)
        (let (line (seq/find (string/split (file/slurp dot) "\n")
                     (fn (l) (string/starts-with? l "gitdir:")))
              target (if (nil? line)
                       nil
                       (string/trim (string/substring line 7 (string/length line)))))
          (cond
            (or (nil? target) (= target "")) nil
            (path/absolute? target) target
            else (path/normalize (path/join root target))))
      else nil)))

(defn git-branch (root)
  "The current branch name (or a short hash when detached), `?` on error ([[git-branch-or-sha]])."
  (or (git-branch-or-sha root) "?"))

(defn- git-born? (root)
  "Whether the repo at `root` has a first commit. Before one, HEAD names a branch with
nothing on it, and everything that resolves `HEAD` fails."
  (= 0 (:exit (git-git root ["rev-parse" "-q" "--verify" "HEAD"]))))

(defn git-unstage-args (root paths)
  "The git arguments that take `paths` out of the index, back to HEAD. `reset HEAD` is the
usual way, and it fails in a repo with no commits yet (there is no HEAD to reset to): there,
the index entry is simply removed."
  (if (or (nil? root) (git-born? root))
    (into ["reset" "-q" "HEAD" "--"] paths)
    (into ["rm" "--cached" "-q" "-r" "--"] paths)))

(defn git-unstage-paths (m verb paths)
  "Take `paths` out of the index (`git-unstage-args`), reported as `verb`: whether the repo
has a commit to reset to is asked of git off the loop, and the unstage queued straight
after it — ahead of anything pressed meanwhile, so `u` then `s` on a file leaves it staged."
  (git-with-root m
    (fn (m0 root)
      (git-gather m0
        "rev-parse"
        root
        (fn (dir) (git-unstage-args dir paths))
        (fn (mm args) (git-do mm verb args))))))

(defn git-resolve-root (m)
  "The repo the current buffer is about: a git section buffer's own root (a status, a log, a
commit — each knows which repo it shows), else the repo containing the buffer's directory,
else the root the last git command ran in. Nil when there is none.

The buffer comes before `:git-root`, which is one slot on the MODEL: a file in repo B,
visited after a status of repo A, runs its git in B.

Before either: the repo a FOLLOW-UP was asked in (`vcsproc/vcs-pinned-root`). A read's
answer, a queued command's result, a prompt's answer and a y/n all run later than their
key, and the reader may be in another repo's buffer by then — `U` then a switch to a file in
B still unstages in the repo `U` was pressed in."
  (or (vcs-pinned-root m)
    (get (sectionbuf/sb-ctx m) :root)
    (git-toplevel (pool/ed-default-dir m))
    (:git-root m)))

;; ---- applying a patch (hunk- and line-level staging) --------------------------
;; A hunk, or a run of its lines, is turned back into a patch by `std/diff`
;; (`diff/hunk-patch`, `diff/hunk-select` — brood ADR-388) and piped to `git apply` over
;; stdin: `--cached` stages it, `--reverse` with it unstages, `--reverse` alone discards,
;; and `--index --reverse` discards a staged change from the index and the work tree at once.

(defn- git-apply-hunk (root patch-text cached? reverse?)
  "Pipe `patch-text` to `git apply -` (stdin). `cached?` adds `--cached` (the index alone),
or `:index` for `--index` (index and work tree together — discarding a staged hunk);
`reverse?` adds `--reverse` (for unstage/discard). Returns `{:exit :stdout :stderr}`."
  (git-git root
    (append ["apply" "--ignore-space-change"]
      (cond (= cached? :index) ["--index"] cached? ["--cached"] else [])
      (if reverse? ["--reverse"] [])
      ["-"])
    {:stdin patch-text}))

;; ---- pure: parse `git status --porcelain -z` --------------------------------
;; The NUL-separated form is robust to paths with spaces / quotes / newlines (no quoting, no
;; octal escapes) — git never mangles a filename in `-z`. A rename or copy emits its NEW path
;; in the status token and the OLD source as a separate trailing token, which we consume.

(defn- git-parse-z (tokens acc)
  "Walk NUL-split `git status --porcelain -z` tokens into `{:x :y :path}` entries; a rename or
copy (`R`/`C` in the status code) consumes the following token as its source path, keeping the
new path under point."
  (if (empty? tokens)
    (reverse acc)
    (let (t (first tokens))
      (if (< (string/length t) 4)
        (git-parse-z (rest tokens) acc)
        (let (x (string/substring t 0 1)
              y (string/substring t 1 2)
              path (string/substring t 3 (string/length t))
              rename? (or (= x "R") (= x "C")))
          ;; keep a rename's source: unstaging `new` alone would leave the deletion of `old` staged
          (git-parse-z (if rename? (rest (rest tokens)) (rest tokens))
            (cons (if rename?
                    {:x x :y y :path path :orig-path (second tokens)}
                    {:x x :y y :path path})
              acc)))))))

(defn git-entries (porcelain)
  "Parse `git status --porcelain -z` output (NUL-separated; a rename/copy carries its source as
a trailing field) into a list of `{:x :y :path}`."
  (git-parse-z (seq/reject (string/split porcelain "\u{0}") empty?) '()))

(defn git-conflicted? (e)
  "Whether `e` is an unmerged path — a conflict waiting to be resolved.

Porcelain v1 spells these `UU` `AA` `DD` `AU` `UA` `DU` `UD`: either side `U`, or both
sides the same `A`/`D`. They are NOT staged-and-unstaged, which is how the plain
`git-staged?` / `git-unstaged?` tests read them — read so, a conflicted file would appear
in both sections at once, and `s` on it would stage a file with `<<<<<<<` markers in it.
So it has its own section, as in Magit."
  (let (x (:x e) y (:y e))
    (or (= x "U") (= y "U") (and (= x "A") (= y "A")) (and (= x "D") (= y "D")))))

(defn git-untracked? (e)
  "Whether porcelain entry `e` is an untracked file (`??`)."
  (and (= (:x e) "?") (= (:y e) "?")))

(defn git-staged? (e)
  "Whether porcelain entry `e` has a change in the index."
  (and (not (= (:x e) " ")) (not (= (:x e) "?"))))

(defn git-unstaged? (e)
  "Whether porcelain entry `e` has a change in the work tree that is not staged."
  (and (not (= (:y e) " ")) (not (git-untracked? e))))
(defn git-upstream (root)
  "The upstream ref (e.g. `origin/main`) of the current branch, or nil when it has none."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{u}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn git-ahead-behind (root)
  "`{:ahead :behind}` commit counts (as strings — tooltip-only) vs the upstream, or nil when
there is no upstream. `--left-right` counts the upstream side (behind) and the HEAD side (ahead)."
  (let (r (git-git root ["rev-list" "--left-right" "--count" "@{u}...HEAD"]))
    (if (not (= (:exit r) 0))
      nil
      (let (parts (seq/reject (string/split (string/trim (:stdout r)) "\t") empty?))
        (if (= (count parts) 2) {:behind (first parts) :ahead (second parts)} nil)))))

(defn git-basename (path)
  "The last path component of `path` (the repo directory name), tolerating a trailing slash."
  (let (parts (seq/reject (string/split path "/") empty?))
    (if (empty? parts) path (last parts))))

(defn git-push-target (root)
  "Where a plain `git push` of this branch goes (`@{push}`), or nil."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "@{push}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r "")) nil)))

;; ---- git off the loop: no git command ever blocks a keystroke -----------------
;; Three git commands talk to a network: `pull`, `push`, `fetch`. They go through
;; `git-launch-op`, git's side of `vcsproc/vcs-launch`: run in a task, folded when it lands,
;; journalled in the shared process log. `ed-headless?` keeps the synchronous path for tests
;; and `--headless`, so every git test still exercises real git.

(def *git-op-timeout-ms* vcsproc/*vcs-op-timeout-ms*)
;; How long a git task (a network op, the status collection, the background fetch) gets
;; before it is killed and reported as a timeout: the shared bound.

(defn git-op-running (m)
  "The verb of the operation in flight (`\"pull\"`, `\"push\"`, …), or nil."
  (vcs-op-running m))

(defn git-subcommand (args)
  "The git subcommand `args` run — the first word after any leading `-c name=value` pairs
(`git-no-editor` puts some in front).

    (gitcore/git-subcommand [\"-c\" \"core.editor=true\" \"commit\" \"-m\" \"x\"])   ;=> \"commit\""
  (letrec (skip (fn (rest-args)
                  (if (and (> (count rest-args) 1) (= (first rest-args) "-c"))
                    (skip (drop rest-args 2))
                    (first rest-args))))
    (skip (into [] args))))

(def- git-remote-only-subcommands
  ;; what talks to the other side and leaves the index and the work tree alone: a fetch
  ;; writes only remote-tracking refs, a push nothing here at all
  #{"push" "fetch" "ls-remote"})

(defn git-writes-checkout? (args)
  "Whether running `git args` writes this checkout — its index, work tree or local refs — so
it must take its turn against the working-tree commands (a pull racing a discard for
`index.lock`). A push, a fetch and `ls-remote` do not.

    (gitcore/git-writes-checkout? [\"push\" \"origin\"])   ;=> false
    (gitcore/git-writes-checkout? [\"pull\" \"--ff-only\"])   ;=> true"
  (not (contains? git-remote-only-subcommands (git-subcommand args))))

;; check-allow: `then` is an opaque caller-supplied `(model result) -> model`; the
;; declaration is the contract (ADR-341's `:trusted`).
(check-allow :trusted
  (sig git-launch-op-in (model any string seqable &optional any -> model))
  (defn git-launch-op-in (m root verb args &optional (then git-refresh-if-open))
    "Run `git args` in the repo `root` OFF the loop and report when it lands. `then` is a
`(model result) -> model` run after the report — by default refreshing *git-status* when it
is open, which is what nearly every network command wants. For a command that already
knows its repo and may no longer be on a buffer in it (C-c C-c has just closed the
message buffer it was typed in).

Ordered in the working-tree queue only when it writes this checkout (`git-writes-checkout?`):
a pull, a commit, a submodule update wait their turn; a push or a fetch runs beside staging."
    (if (nil? root)
      (message m "not in a git repository")
      (vcs-launch (assoc m :git-root root)
        "git"
        verb
        root
        args
        (fn (dir arguments) (git-git dir arguments))
        then
        (git-writes-checkout? args))))

  (sig git-launch-op (model string seqable &optional any -> model))
  (defn git-launch-op (m verb args &optional (then git-refresh-if-open))
    "`git-launch-op-in` the repo the current buffer is about (`git-resolve-root`)."
    (git-launch-op-in m (git-resolve-root m) verb args then)))

(defn git-status-index (m root)
  "The pool index of repo `root`'s *git-status* buffer, or nil when it has none open — one
per repo (`vcsproc/vcs-status-index`)."
  (vcs-status-index m :git-status root))

;; check-allow: the function is fetched by name, so the checker cannot see its result; it is
;; `git-refresh`'s own `model -> model` contract.
(check-allow :trusted
  (sig git-refresh-status (model -> model))
  (defn git-refresh-status (m)
    "Refresh the *git-status* of the repo the buffer is about (`git-resolve-root`, which a
follow-up's pin decides) by qualified name, loaded when it runs. The status buffer shows
commits and diffs (`gitview`), and `gitview` stands on this module, so this module cannot
`:use` the status back; every command that changes the working tree still has to refresh
it."
    (gitstatus/git-refresh m)))

(defn git-refresh-if-open (m _r)
  "Refresh the *git-status* of the repo the command ran in when it is open — the usual `then`
for a `git-launch-op`. Another repo's status is left alone: nothing changed there."
  (if (nil? (git-status-index m (git-resolve-root m))) m (git-refresh-status m)))

(defcommand cmd-git-quit
  (m key)
  "Bury the git buffer (q)."
  (cmd-kill-buffer m key))

;; ---- running a git command, journalled -----------------------------------------
;; Through `vcsproc/vcs-run`, so a git command cannot be run without being recorded in the
;; process log (`$`); the two runners below differ only in how they invoke git.

(sig git-run (model seqable -> vector))
(defn git-run (m args)
  "Run `git args` in the repo root, journalled: `[model' result]`. The seam every
model-threaded git command goes through, so the journal cannot disagree with what ran."
  (vcs-run m "git" args (fn () (git-git (:git-root m) args))))

;; ---- off the loop, in order: what a key runs before it can go on -------------------
;; A command that has to ASK git something before it knows what to do (is anything staged,
;; which branch is checked out, does it track an upstream) or that shows what a command
;; printed: each step queued behind the working-tree commands already pressed
;; (`vcsproc/vcs-gather`, `vcs-run-queued`), so nothing a key runs blocks the loop and
;; nothing overtakes what was pressed before it. Headless runs each step at once.

;; check-allow: `collect` and `then` are opaque caller-supplied functions; the declarations
;; are the contract (ADR-341's `:trusted`).
(check-allow :trusted
  (sig git-gather (model string string fn fn -> model))
  (defn git-gather (m verb root collect then)
    "Ask git `(collect root)` OFF the loop — behind any working-tree command still queued —
and go on with `(then model answer)`. `collect` runs in a task: it may call git, and must
close over nothing but plain data (never the model). `verb` names the read when it fails."
    (vcs-gather (assoc m :git-root root) (str "git " verb) root collect then))

  (sig git-gather-holding (model string string fn fn -> model))
  (defn git-gather-holding (m verb root collect then)
    "[[git-gather]] for an answer the reader is about to WORK IN — the message an amend opens
on, the branch a rename renames, whether `c c` must offer to stage: the keyboard is held
until it lands (`vcsproc/vcs-gather-holding`), so what they type meanwhile is not run as
commands in the buffer underneath. C-g lets go and cancels it."
    (vcs-gather-holding (assoc m :git-root root) (str "git " verb) root collect then))

  (sig git-run-then (model seqable fn -> model))
  (defn git-run-then (m args then)
    "[[git-run]] OFF the loop: run `git args` (journalled) in `(:git-root m)` behind any
command still queued, then `(then model result)` — for a command whose next step depends on
how this one went (`branch -d` refused offers `-D`), which [[git-do]] would only refresh after."
    (vcs-run-queued m "git" (:git-root m) args (fn (dir arguments) (git-git dir arguments)) then)))

(defn git-run-report (m args buffer)
  "Run `git args` (journalled) in the repo the buffer is about, off the loop, and show what it
printed in the plain-text report `buffer` beside the page — `M l`'s remotes, `% l`'s
worktrees, `B l`'s bisect log."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-run-then (assoc m :git-root root)
        args
        (fn (m1 r) (vcs-show-report m1 buffer (:stdout r "") :git-text {:action :pop}))))))

(defn git-with-root (m then)
  "`(then model root)` with the repo the buffer is about — or say there is none."
  (let (root (git-resolve-root m))
    (if (nil? root) (message m "not in a git repository") (then (assoc m :git-root root) root))))

(defn- git-hunk-args (cached? reverse?)
  ;; the `git apply` a hunk runs, as the journal names it (the patch goes over stdin)
  (append ["apply"]
    (cond (= cached? :index) ["--index"] cached? ["--cached"] else [])
    (if reverse? ["--reverse"] [])
    ["-"]))

(defn git-do (m verb args)
  "Run `git args` (logged) in the repo the buffer is about, then refresh the status buffer
on success -- else report what went wrong. The shape every working-tree action has: the run,
the log and the refresh in one place, so no command refreshes after it FAILED.

The root is RESOLVED, not read from `(:git-root m)`: that is set while *git-status* is open
and nil everywhere else, and every command is also reachable by `M-x` from a buffer that
has never opened a status. Outside a repo it says so rather than running git in nil.

The command runs OFF the loop, queued behind any still running (`vcsproc/vcs-run-queued`):
`s s s` down a list of files is three commands in order, and a large repository or a held
index lock never freezes the window."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (vcs-run-queued (assoc m :git-root root)
        "git"
        root
        args
        (fn (dir arguments) (git-git dir arguments))
        (fn (m1 r) (git-refreshed m1 verb r))))))

(defn git-do-hunk (m verb patch cached? reverse?)
  "[[git-do]] for a hunk: `git apply` over stdin, queued off the loop, then the same refresh."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (vcs-run-queued (assoc m :git-root root)
        "git"
        root
        (git-hunk-args cached? reverse?)
        (fn (dir _arguments) (git-apply-hunk dir patch cached? reverse?))
        (fn (m1 r) (git-refreshed m1 verb r))))))

(defn- git-refreshed (m verb r)
  "The outcome of a working-tree-changing git command `r`: re-read the status buffer when it
succeeded, else say what went wrong (`vcs-report-cmd`, `verb` naming it). Every stage /
unstage / discard action ends this way — eight sites spelled the same three lines, and the
one thing they must not get wrong is refreshing after a command that FAILED, which is what
having it in one place makes impossible."
  (if (= (:exit r) 0) (git-refresh-status (git-reload-view m)) (vcs-report-cmd m verb r)))

(defn git-reload-view (m)
  "Re-run the git view the reader is in (a diff, a commit) when it has a `:reload` — so
staging a hunk from *git-diff* takes it out of *git-diff*, not only out of the status."
  (let (reload (get (sectionbuf/sb-ctx m) :reload))
    (if (nil? reload) m ((reflect/eval reload) m))))

(defn git-remotes (root)
  "The repo's remote names, `origin` first when there is one."
  (let (names (git-lines root ["remote"]))
    (git-first (if (includes? names "origin") "origin" nil) names)))

(defn git-current-branch (root)
  "The checked-out branch's name, or nil when HEAD is detached."
  (let (r (git-git root ["symbolic-ref" "--short" "-q" "HEAD"]))
    (if (= (:exit r) 0) (string/trim (:stdout r "")) nil)))

(defn git-first (here names)
  "`names` with `here` moved to the front — the candidate RET takes in a completing prompt."
  (if (nil? here) names (cons here (seq/reject names (fn (n) (= n here))))))

(defn git-split-remote-branch (root ref)
  "`[remote branch]` for a remote-tracking ref like `origin/feature/x`, when it names one
of the repo's remotes; else nil."
  (let (remote (seq/find (git-remotes root) (fn (r) (string/starts-with? ref (str r "/")))))
    (if (nil? remote)
      nil
      [remote (string/substring ref (inc (string/length remote)) (string/length ref))])))

(def git-no-editor
  ;; `git rebase --continue`, `merge`, `commit --amend` and friends all open an EDITOR for
  ;; the message unless told otherwise. There is no terminal on this side of the pipe, so
  ;; git would launch a `vi` nobody can see and the command would hang until the 120 s
  ;; timeout — the editor frozen, waiting on an editor.
  ;;
  ;; `core.editor=true` points git at `true(1)`, which exits 0 having changed nothing: the
  ;; message git prepared is accepted as it stands, exactly what `--no-edit` means for the
  ;; verbs that have such a flag. `sequence.editor` is the same thing for the interactive
  ;; rebase todo list.
  ;;
  ;; Prepended to the ARGS rather than passed as config, because `git-git` puts our args
  ;; immediately after its own `-c core.quotePath=false` and `-c` may repeat. The journal's
  ;; `vcsproc/vcs-command-text` strips leading `-c` pairs, so `$` still shows `git rebase
  ;; --continue` rather than the plumbing.
  ["-c" "core.editor=true" "-c" "sequence.editor=true"])

(def- git-sequencer-markers
  ;; The file git leaves in `.git` while an operation is part-way through, and what to
  ;; call it. Order matters: `rebase-merge` and `rebase-apply` are two implementations of
  ;; the same verb, and a cherry-pick in the middle of a rebase is still a rebase. A stopped
  ;; `git am` leaves `rebase-apply` too, marked `applying` — and `git rebase --continue`
  ;; refuses while an am is in progress, so it is told apart first.
  [["rebase-apply/applying" :am "am"]
    ["rebase-merge" :rebase "rebase"]
    ["rebase-apply" :rebase "rebase"]
    ["CHERRY_PICK_HEAD" :cherry-pick "cherry-pick"]
    ["REVERT_HEAD" :revert "revert"]
    ["MERGE_HEAD" :merge "merge"]
    ["BISECT_LOG" :bisect "bisect"]])

(defn git-sequencer (root)
  "The git operation this repo is part-way through — `{:kind :rebase :verb \"rebase\"}` —
or **nil** when none is. Read from the marker `.git` leaves behind, which is how git
itself knows, so this cannot disagree with what `--continue` would resume.

`.git` is a FILE, not a directory, in a worktree or a submodule (it holds a `gitdir:`
pointer), so the markers are looked for in the directory it points at ([[git-dir]]) rather
than at `<root>/.git` — otherwise every one of these features would be silently dead in a
worktree, which is where a rebase is most likely to be happening. Read from the disk, no
process: `r c` asks it on the loop, before the command it picks is queued."
  (let (dir (git-dir root)
        hit (if (nil? dir)
              nil
              (seq/find git-sequencer-markers
                (fn (row) (file/exists? (path/join dir (first row)))))))
    (if (nil? hit) nil {:kind (nth hit 1) :verb (nth hit 2)})))

;; ---- the repo's refs ---------------------------------------------------------

(defn git-refs (root kind)
  "The repo's refs of `kind` — `:branches` (local and remote), `:local` or `:tags` — newest
first where git will say, as a list of plain names."
  (let (args (case kind
               :local ["branch" "--format=%(refname:short)" "--sort=-committerdate"]
               :tags ["tag" "--sort=-creatordate"]
               :remote ["branch" "-r" "--format=%(refname:short)" "--sort=-committerdate"]
               ["branch" "-a" "--format=%(refname:short)" "--sort=-committerdate"])
        r (git-git root args))
    (if (= (:exit r) 0)
      (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?)
      '())))

;; ---- the stashes, in the status buffer --------------------------------------
;; A stash you cannot see is a stash you forget you made. Magit lists them; so does this,
;; below the commit sections, collapsed like any other section.

(defn git-stashes (root)
  "The repo's stashes as `{:hash :subject}` rows, `:hash` the stash's ref (`stash@{0}`) — what
the status's Stashes section lists. `()` when there are none."
  (let (r (git-git root ["stash" "list" "--format=%gd %s"]))
    (if (not (= (:exit r) 0))
      '()
      (map (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?)
        (fn (line) (let ([hash subject] (git-split-word line)) {:hash hash :subject subject}))))))

(defn git-split-word (line)
  "`line` split at its first space into `[word rest]` — `rest` is \"\" when there is no
space. The shape of most of what git prints one record per line: `stash@{0} subject`, a
porcelain blame's `author Ann`.

    (gitcore/git-split-word \"author Ann Lee\") ;=> [\"author\" \"Ann Lee\"]"
  (let (space (index-of line " "))
    (if (< space 0)
      [line ""]
      [(string/substring line 0 space) (string/substring line (inc space) (string/length line))])))

;; *git-remotes* / *git-worktrees* / `!`'s output — plain text git reports: q quits, and a
;; diff in one is coloured by its text.
(def git-report-keymap
  (-> {}
    (keymap-bind ["$"] 'vcsproc/cmd-vcs-process) ; $ reaches the process log from any git buffer
    (keymap-bind ["q"] 'gitcore/cmd-git-quit)))

(def git-text-mode-layer
  {:name 'git-text
   :keymap gitcore/git-report-keymap
   :commands '("git-quit")
   :fontify 'vcsproc/vcs-diff-fontify})

(register-type-layers :git-text
  (list 'gitcore/git-text-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

(defn git-branch-or-sha (root)
  "The current git branch name for repo `root` — or a short commit SHA when HEAD is detached,
`nil` when `root` is nil / not a git repo / git errors. A quick `git -C root` porcelain call."
  (if (or (nil? root) (not (file/exists? (path/join root ".git"))))
    nil
    (try
      ;; `symbolic-ref`, not `rev-parse --abbrev-ref HEAD`: it names the branch even before
      ;; the first commit, where there is no HEAD commit to resolve and rev-parse fails
      (let (symbolic (os/cmd "git" ["-C" root "symbolic-ref" "--short" "-q" "HEAD"])
            branch (string/trim (:stdout symbolic "")))
        (if (and (= (:exit symbolic) 0) (not (= branch "")))
          branch
          ;; detached HEAD → a short SHA instead of a name
          (let (parsed (os/cmd "git" ["-C" root "rev-parse" "--short" "HEAD"]))
            (if (= (:exit parsed) 0)
              (let (sha (string/trim (:stdout parsed ""))) (if (= sha "") nil sha))
              nil))))
      (catch e (do (log/warn (str "git branch lookup failed: " (error-message e))) nil)))))
