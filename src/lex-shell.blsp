;; src/lex-shell.blsp — lexical shell-script (sh / bash / zsh) highlighting.
;;
;; The shell analogue of lex-dotenv: a pure data→data tokenizer, no IO and no kernel
;; surface. `(shell-spans src)` returns `[start end face]` colour spans (character
;; offsets, end-exclusive, ascending, non-overlapping) in exactly the `highlight-spans`
;; shape, so it drops straight into the editor's `:fontify` mode service and the shared
;; `fontify-runs` tiler (ADR-052). Line-oriented — one `regex/tokens` scan per line on
;; the bitset DFA, so the per-character work is a memo lookup, not a capture thread
;; (ADR-352) — which is what lets a band re-lex on every keystroke: a comment, a `"…"` /
;; `'…'` string, a `$var` /
;; `${…}` / `$(…)` expansion, a `name()` definition, a keyword (`if` `fi` `for` …) and a
;; builtin (`echo` `cd` `export` …). A string that spans lines is coloured on its first
;; line only, and a heredoc body is plain text: the costs of staying line-oriented, and
;; the same trade dotenv and markdown make.
;;
;; Faces are the shared `:syntax/*` registry (`editor/face`), resolved once per pass like
;; `editor/highlight`'s, so an app's theme restyles this mode with the rest.

(defmodule lex-shell
  "Lexical highlighting for shell scripts (sh / bash / zsh), as a pure function over a
source string — `(shell-spans src)` returns `[start end face]` colour spans in the
`highlight-spans` shape (ascending, non-overlapping, end-exclusive), feeding the editor's
`:fontify` service and the shared `fontify-runs` tiler unchanged. Per line: `#` comments
(the shebang included), quoted strings, `$` expansions, `name()` definitions, keywords and
builtins, in the `:syntax/*` faces. Pure, so independently testable."
  (:use editor/face))

;; ---- the vocabulary ---------------------------------------------------------

(def shell-keywords
  ;; the reserved words: control flow and the declaration words that shape a script
  ["if"
    "then" "else" "elif" "fi" "for" "while" "until" "do" "done" "case" "esac" "in" "function"
    "select" "time" "return" "exit" "break" "continue" "local" "export" "readonly" "declare"
    "typeset" "unset" "source" "alias"])

(def shell-builtins
  ;; the builtins a script leans on, coloured as calls
  ["echo"
    "printf" "cd" "pwd" "test" "read" "shift" "eval" "exec" "set" "trap" "wait" "kill" "true"
    "false" "let" "getopts" "command" "type" "hash" "ulimit" "umask" "exit" "pushd" "popd" "dirs"
    "jobs" "fg" "bg" "sleep" "mkdir" "rm" "cp" "mv" "ln" "cat" "grep" "sed" "awk" "find" "xargs"
    "sort" "cut" "tr" "head" "tail" "tee" "chmod" "chown" "touch" "basename" "dirname" "which" "env"
    "sudo" "git" "make" "curl" "wget" "tar"])

;; One `regex/tokens` scan per line. The STRUCTURED rules find the tokens whose extent
;; is not a word, in this order:
;;   1 comment (to end of line; only where a `#` starts a word)
;;   2 double-quoted string   3 single-quoted string
;;   4 expansion: `${…}` `$(…)` `$name` `$1` `$@` `$?` …
;; and the WORD rule, last, finds every identifier whole (maximal munch — `file` never
;; yields `fi`, `done_` never `done`). The earliest position wins, and at it the first
;; rule, so a `#` inside a string is the string's and a word inside one is never seen; a
;; word is then a keyword, a builtin or a function name by exact lookup — that is what a
;; word boundary means here, with no `\b` in the rules.
(def- shell-structured-rules
  ;; the comment rule consumes the separator that lets it match — `shell-line-spans`
  ;; trims it, so the span is the `#…` alone
  [["(?:^|[\\s;&|(])#.*" :comment]
    ["\"(?:[^\"\\\\]|\\\\.)*\"" :string]
    ["'[^']*'" :string]
    ["\\$\\{[^}]*\\}|\\$\\([^)]*\\)|\\$[A-Za-z_][A-Za-z0-9_]*|\\$[0-9@#?*!$-]" :expansion]])

;; ONE scanner, compiled once: the structured rules first, the word rule last — so a
;; word inside a string or a comment is never produced at all (the string took it), and
;; a line pays a single scan.
(def- shell-scanner
  (regex/tokenizer (into shell-structured-rules [["[A-Za-z_][A-Za-z0-9_]*" :word]])))

(def- shell-keyword-set (into #{} shell-keywords))
(def- shell-builtin-set (into #{} shell-builtins))

(defn- shell-faces ()
  "The `:syntax/*` faces one pass paints with, resolved once."
  {:comment (face :syntax/comment)
   :string (face :syntax/string)
   :expansion (face :syntax/keyword)
   :definition (face :syntax/definition)
   :keyword (face :syntax/special)
   :builtin (face :syntax/function)})

(defn- shell-skip-blank (line index)
  "`index` advanced past the spaces and tabs at `index`."
  (if (and (< index (string/length line))
        (or (= (string/char-at line index) " ") (= (string/char-at line index) "\t")))
    (shell-skip-blank line (inc index))
    index))
(sig shell-skip-blank (string int -> int))

(defn- shell-defines-after? (line word-end)
  "Is the word ending at `word-end` followed by `()` (spaces allowed) — a function
definition? Two character reads, asked once per word: a regex here (`^\\s*\\(\\)` over
the rest of the line) would be a third of the whole pass."
  (let (index (shell-skip-blank line word-end))
    (and (< (inc index) (string/length line))
      (= (string/char-at line index) "(")
      (= (string/char-at line (inc index)) ")"))))

(defn- shell-line-spans (line base faces)
  "The spans for one `line` at offset `base`, ascending and non-overlapping: one scan,
each token painted by its rule — a comment (the separator that let it match is consumed,
not coloured: the span starts at the `#`), a string, an expansion — or, for a word, by
exact lookup: a function name (a word after `function`, or before `()`), a keyword, a
builtin, or nothing."
  (reverse (first (fold (regex/tokens line shell-scanner)
                    [(list) false]
                    (fn (acc token)
                      (let ([out after-function?] acc
                            start (+ base (get token :start))
                            end (+ base (get token :end))
                            tag (get token :tag)
                            word (get token :text))
                        (cond
                          (= tag :comment)
                            [(cons [(if (= (string/char-at line (get token :start)) "#")
                                      start
                                      (inc start))
                                     end
                                     (:comment faces)]
                               out)
                              false]
                          (not (= tag :word)) [(cons [start end (get faces tag)] out) false]
                          (or after-function? (shell-defines-after? line (get token :end)))
                            [(cons [start end (:definition faces)] out) false]
                          (contains? shell-keyword-set word)
                            [(cons [start end (:keyword faces)] out) (= word "function")]
                          (contains? shell-builtin-set word)
                            [(cons [start end (:builtin faces)] out) false]
                          else [out false])))))))

(defn shell-spans (src)
  "Lexically tokenize shell `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive, ascending, non-overlapping) — comments, quoted
strings, `$` expansions, function definitions, keywords and builtins — in the
`:syntax/*` faces, resolved once per call.

    (map (lex-shell/shell-spans \"echo $HOME # hi\") (fn ([s e _]) [s e]))   ;=> ([0 4] [5 10] [11 15])"
  (let (faces (shell-faces))
    (editor/lexer/lexer-walk-lines src (fn (line base) (shell-line-spans line base faces)))))
(sig shell-spans (string -> any))

(defn shell-line-lexer ()
  "`shell-spans` as an `editor/highlight` stateless line lexer (brood ADR-471) — shell-mode's
`:line-lexer`: a line's spans are its own, so the editor keeps them as a memo on its text.

    (:stateless? (lex-shell/shell-line-lexer))   ;=> true"
  (editor/line-cache/stateless-lexer shell-spans))
