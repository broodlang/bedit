(defmodule format
  "Run the language's own formatter over a buffer — `M-x format-buffer`, and on save.

**Why the language's formatter and not the indenter.** bedit can indent Elixir line for
line, and does. It cannot decide where to break a long call, how to align a pipeline, or
whether a keyword list fits on one line — and those are the changes `mix format` makes.
Emacs learned the same thing: `elixir-ts-mode` indents, and `mix format` formats, and the
sensible default is to let the language's own tool own the whole answer on save. A
formatter is also the ground truth the indenter is checked against
(`tests/modes_test.blsp` diffs a real module against `mix format`), so running it is not
a second opinion — it is the one this editor already defers to.

**How.** A formatter is a service on the buffer's mode (`:format-command`, declared by
`modes/deflanguage`), so nothing here names a language: ask the buffer what formats it,
append the file, run it, re-read. Almost every formatter is file-in-place — `mix format
FILE`, `black FILE`, `rustfmt FILE` — which decides the order:

  1. write the buffer, so the formatter sees what you typed;
  2. run the formatter on the FILE;
  3. re-read the file into the buffer, keeping point where it was.

If the formatter fails, step 3 finds the file exactly as step 1 wrote it, so a broken
formatter or a syntax error costs nothing but a message. That is the whole reason it goes
through the file rather than piping the buffer: a formatter that refuses to parse a
half-written function must leave the text alone, and a pipe would hand back its empty
output."
  (:use model) ; ed-mode-service / ed-current-buf / ed-set-buf / message
  (:use commands) ; ed-find-file / save-buffer
  (:use interactive) ; defcommand
  (:use editor/buffer) ; buffer-file / buffer-text / goto-char / buffer-point
  (:use task)) ; task — the formatter runs off the loop
(defdyn *format-on-save*
  ;; Off by default: reformatting a file someone did not ask to reformat is a large,
  ;; surprising diff, and in a shared repo it is a diff with someone else's name on the
  ;; lines. Turn it on per user (`~/.config/bedit/init.blsp`), where the person who owns
  ;; the repo's conventions is the one deciding.
  false)

(defn format-command-for (buf)
  "`[prog arg … file]` that formats `buf`, or nil when its mode declares no formatter or
the buffer has no file. The file is appended because every formatter worth having takes
it last."
  (let (cmd (ed-mode-service buf :format-command)
        file (buffer-file buf))
    (when (and cmd file (not (empty? cmd))) (into (into [] cmd) [file]))))

(defn format-job (buf)
  "What running `buf`'s formatter takes, as plain data: `{:argv :root :file}`, or nil when
it has none. Worked out on the loop — the formatter is a MODE service, and a task can see
neither the model nor a buffer — so the part that can take seconds carries only this.

`:root` is the file's PROJECT root: `mix format` reads `.formatter.exs` from the directory
it runs in, so run from `lib/foo/` it ignored the project's `import_deps` and plugins and
reformatted Ecto's `field :x` with parens."
  (let (argv (format-command-for buf))
    (when argv
      (let (file (buffer-file buf)
            dir (if file (path/dirname file) (or (:dir buf) ".")))
        {:argv argv :root (or (projects/project-root dir) dir) :file file}))))

(defn format-run (job)
  "Run a `format-job`. `[ok? detail]` — `detail` is the formatter's own complaint on
failure, which is the useful half (a syntax error names the line). Plain data in and out,
so it runs in a task."
  (let (argv (:argv job)
        r (os/cmd (first argv) (into [] (rest argv)) {:cwd (:root job)})
        out (string/trim (str (get r :stderr) (get r :stdout))))
    (if (= (get r :exit) 0)
      [true (first argv)]
      [false (if (= out "") (str (first argv) " exited " (get r :exit)) out)])))

(defn format-file (buf)
  "Run `buf`'s formatter over its file, synchronously: `[ok? detail]`."
  (let (job (format-job buf))
    (if (nil? job) [false "no formatter for this buffer"] (format-run job))))

(defn format-land (m saved-rope file result)
  "Fold a finished formatter run (`result` is `format-run`'s `[ok? detail]`) into the buffer
visiting `file`: re-read the formatted file into it, keeping point.

Only while the buffer still holds exactly the text the save wrote (`saved-rope`). The
formatter runs OFF the loop now, so you can type while it runs; if you did, re-reading
would throw away what you typed. Your edits win, and the message says the file on disk is
the formatted one — which the next C-x C-s notices and asks about, as it should.

Point is restored by OFFSET rather than by line, deliberately: a formatter may join or
split lines, so a line number means something different afterwards, while an offset is
merely approximate. Clamped to the new length, so a formatter that shortened the file
cannot leave point past its end."
  (let ([ok detail] result
        i (ed-buffer-index-by-file m file)
        buf (if (nil? i) nil (ed-buf-at m i)))
    (cond
      (not ok) (message m (str "format failed: " detail))
      (nil? buf) (message m (str "formatted " file))
      (not (= (buffer-rope buf) saved-rope))
        (message m (str "formatted " file " on disk — kept your edits since the save"))
      :else
        (check-allow :discarded-catch
          (try
            (let (formatted (file/slurp file)
                  point (math/min (buffer-point buf) (string/length formatted))
                  reread (goto-char (editor/buffer/replace-region buf
                                      0
                                      (buffer-length buf)
                                      formatted)
                           point)
                  m2 (ed-set-buf-at m i (buffer-stamp-file (mark-buffer-saved reread))))
              (message m2
                (if (= formatted (buffer-text buf))
                  ;; already canonical: say so rather than reporting a no-op as work
                  (str "saved " file " (already formatted)")
                  (str "saved and formatted " file))))
            (catch e (message m (str "format failed: " (error-message e)))))))))

;; `mix format` takes seconds, so not on the loop (F1) — `model/register-task-reply`
(register-task-reply :format-proc 'format/format-apply nil "formatting")
(defn format-apply (m result)
  "The `:format-proc` task's reply, folded: the job's `[ok? detail]`, or nil when the task
errored or timed out."
  (let (pending (:format-pending m)
        m1 (dissoc m :format-proc :format-pending))
    (cond
      (nil? pending) m1
      (nil? result) (message m1 (str "format of " (:file pending) " failed or timed out"))
      :else (format-land m1 (:rope pending) (:file pending) result))))

(defn format-buffer-now (m)
  "Save, then format — the save at once, the formatter off the loop.

The write is the plain save (`ed-save-buf-at`), so a format is a save in every respect
that matters afterwards: the buffer is unmodified, its auto-save file is gone, and it is
stamped with the file's mtime — also when the formatter then FAILS.

The formatter itself runs in a task (`:format-proc`): `mix format` on a real project takes
seconds, and it used to take them on the loop, with the window frozen until it finished
(issues.md F1). Headless — a test, a batch run — has no loop for a reply to come back to,
so it runs inline there, as every other off-loop job does."
  (let (buf (ed-current-buf m)
        file (buffer-file buf)
        job (format-job buf))
    (cond
      (nil? file) (message m "no file to format")
      (nil? job) (message m (str "no formatter for " (or (ed-buf-mode-name buf) "this buffer")))
      ;; still a SAVE: C-x C-s comes through here when format-on-save is on, and a format
      ;; already in flight must not turn it into a no-op
      (:format-proc m)
        (message (ed-save-buf-at m (ed-current-index m))
          (str "saved " file " — not formatted, a format is still running"))
      :else
        (let (m1 (ed-save-buf-at m (ed-current-index m))
              saved (ed-current-buf m1))
          (cond
            (buffer-modified? saved) m1 ; the write failed and said so; nothing to format
            (ed-headless?) (format-land m1 (buffer-rope saved) file (format-run job))
            :else
              (assoc m1
                :format-proc (task (fn () (format-run job)) {:timeout 60000})
                :format-pending {:file file :rope (buffer-rope saved)}))))))

(defcommand cmd-format-buffer
  (m key)
  "Format the current buffer with its language's own formatter (M-x format-buffer):
`mix format` in Elixir, `black` in Python, whatever `modes/deflanguage` declared. Saves
first, so the formatter sees what you typed, and re-reads afterwards. A buffer whose
language declares no formatter says so and changes nothing."
  (format-buffer-now m))

(defn on-save (m)
  "The save path's hook: format when `*format-on-save*` is on and this buffer has a
formatter, else leave the plain save alone. Returns nil when it did not act, so the
caller keeps its own message."
  (let (buf (ed-current-buf m))
    (when (and *format-on-save* (format-command-for buf)) (format-buffer-now m))))
