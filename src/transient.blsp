;; src/transient.blsp — TRANSIENT MENUS in the editor: the host half of
;; `transient-core` (brood ADR-387, moved here by ADR-417).
;;
;; The mechanism — the keymap, the argument value, the rows — is transient-core's and
;; knows nothing about an editor. This file is the three things only an editor can supply:
;;
;;   the OVERLAY     while a menu is open every key is the menu's (`transient-overlay`)
;;   the PROMPT      a `:read` outcome becomes a minibuffer read, and its answer goes back
;;   the MEMORY      a menu reopens with the arguments it had last time, across sessions
;;
;; The last of those is most of why a transient is pleasant: you set `--force-with-lease`
;; once and the push menu remembers that is how you push. It rides the shared persistence
;; layer every other generated file uses (`projects/persist-read-value` /
;; `persist-write!` under `editor-state-dir`), so it is one more file in `state/`, not a
;; new mechanism.
;;
;; A command invoked from a menu reads its flags with `ed-transient-args`. That is the
;; whole contract: `cmd-git-push` does not know whether it was reached from the menu, a
;; keybinding or `M-x` — it asks for arguments and gets the ones that were set, or none.

(defmodule transient
  "Transient menus in the editor — the host half of `transient-core`. `ed-transient-open`
opens a menu (restoring the arguments it had last time), `ed-transient-key` folds a key into
the model, and `ed-transient-args` is what a command invoked from a menu reads its flags from.
The mechanism is transient-core's; this is the overlay, the prompt and the memory."
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use model) ; message / the model accessors
  (:use pool) ; ed-name-prompt — a plain minibuffer read for an option's value
  (:use projects) ; persist-read-value / persist-write! / editor-state-dir
  (:use panel :only [register-panel-source]) ; the menu shown as a key panel
  (:use transient-core))

;; ---- remembering a menu's arguments ---------------------------------------------

(defn- persists? (m)
  "Whether this editor persists generated state — `:recent-files`, the same gate recentf,
bookmarks and the tutorial's progress use, which `main` sets and a test or a headless
harness does not, so one test never reopens a menu with the arguments another left."
  (= true (:recent-files m)))

(defn- transients-file ()
  "Where each menu's last arguments live — one map, `{name -> args}`, beside the other
generated state."
  (path/join (editor-state-dir) "transients.blsp"))

(defn- remembered ()
  "Every menu's remembered arguments, `{name -> args}`."
  (let (v (persist-read-value (transients-file) {}))
    (if (map? v) v {})))

(defn- remember! (name args)
  "Store `args` as menu `name`'s arguments. Best-effort, like every other persisted file:
a menu that cannot write its state still works, it just forgets."
  (persist-write! (transients-file)
    (assoc (remembered) (->string name) args)
    ";; bedit — the arguments each transient menu last had. Safe to delete."))

(defn- recalled (name)
  "Menu `name`'s arguments from last time, or nil when it has never been closed here."
  (let (v (get (remembered) (->string name))) (when (map? v) v)))

;; ---- opening and closing ----------------------------------------------------------

(sig ed-transient-open (model any -> model))
(defn ed-transient-open (m spec)
  "Open the menu `spec` describes, restoring the arguments it had last time — or, the first
time, its `:defaults` (`{arg value}`, a switch's value `true`), as Magit's log starts with
`--graph` on. The command behind a menu key is this and nothing else."
  (let (initial (or (when (persists? m) (recalled (:name spec))) (:defaults spec) {}))
    (assoc m :transient (transient-open spec initial))))

(sig ed-transient-close (model -> model))
(defn ed-transient-close (m)
  "Dismiss the menu, remembering its arguments first."
  (let (menu (:transient m))
    (do
      (when (and menu (persists? m)) (remember! (:name (:spec menu)) (:args menu)))
      (dissoc m :transient))))

(check-allow :trusted
  (sig ed-transient-args (model -> vector))
  (defn ed-transient-args (m)
    "The arguments the menu that invoked this command had set — `[]` when the command was
reached any other way. A command asks for this and splices it into its argv; it never has
to know whether a menu was involved."
    (or (:transient-args m) [])))

;; ---- the outcomes -----------------------------------------------------------------
;; One fold per outcome `transient-core` can answer. Each is small on purpose: the
;; decisions (what a chord means, what the value is) are transient-core's, and what is
;; left here is only the part that needs an editor.

(defn- run-suffix (m menu command args)
  "Dismiss the menu and run `command` with `args` on the model. The command is resolved by
SYMBOL at this moment, exactly like a keymap binding, so a menu can name a command whose
module has not been loaded and a redefined command hot-swaps."
  (let (closed (assoc (ed-transient-close (assoc m :transient menu)) :transient-args args))
    ;; the command's error is said in the echo area, not dropped: the menu has closed either way
    (check-allow :discarded-catch
      (try
        (dissoc ((reflect/eval command) closed :transient) :transient-args)
        (catch e (message (dissoc closed :transient-args) (str "error: " e)))))))

(defn- read-option (m menu arg prompt current)
  "Prompt for option `arg`'s value and put the answer back in the menu. The menu stays on
the model while the minibuffer is up, so accepting returns to it with the value set and the
rows already showing it."
  (assoc (assoc m :transient menu)
    :minibuffer
      (ed-name-prompt (str prompt (if (nil? current) "" (str " (" current ")")) ": ")
        '()
        (fn (mm text)
          (assoc mm :transient (transient-set (:transient mm) arg (string/trim text)))))))

(sig ed-transient-key (model any -> model))
(defn ed-transient-key (m input)
  "Fold one key into the open menu.

Cancel (Esc / C-g) pops one level out of a sub-menu, or dismisses the menu at the top —
`transient-pop` answers nil there, which is transient-core's way of saying \"this one is
yours to close\". Everything else goes to `transient-press`, and its outcome is serviced here."
  (let (menu (:transient m))
    (cond
      (nil? menu) m
      (ed-cancel-key? input)
        (let (out (transient-pop menu))
          (if (nil? out) (message (ed-transient-close m) "quit") (assoc m :transient out)))
      else
        (let ([stepped outcome] (transient-press menu input))
          (case (first outcome)
            :run (run-suffix m stepped (nth outcome 1) (nth outcome 2))
            :read (read-option m stepped (nth outcome 1) (nth outcome 2) (nth outcome 3))
            ;; Magit lets an unbound key dismiss rather than beep, because a menu you
            ;; cannot type your way out of is a trap
            :unbound
              (message (ed-transient-close (assoc m :transient stepped))
                (str (ed-key-label input) " is not in this menu"))
            (assoc m :transient stepped))))))

(defrecord transient-overlay ()) ; a transient menu (Magit's `P`): every key is the menu's until it closes
(impl Overlay
  transient-overlay
  (overlay-active? (_ m) (:transient m))
  ;; no overlay-owns? — modal: a menu binds its own keys and answers `:unbound` for the
  ;; rest, which is how it decides for itself what an unknown key means
  (overlay-handle (_ m input) (ed-transient-key m input)))

(register-overlay :transient 80 (transient-overlay))

;; ---- the menu as a key panel ---------------------------------------------------------
;; Laid out as Magit lays it: the groups side by side, each row KEY FIRST —
;; `-f  ✓ --force-with-lease  refuses if the remote moved` — the keys aligned in their own
;; column, because the key is what you are looking for and the description is what you read
;; once you have found it. How it looks is `panel`'s: this says only what the menu holds.

(defn- panel-key-label (keys)
  "A transient's key sequence, spelled the way a menu spells it: `-f`, not `- f`. Plain
characters run together because that is how the menu is read aloud and how Magit prints
it; anything with a real key name in it (`C-c p`) falls back to the spaced spelling, where
the space is doing necessary work."
  (if (every? keys (fn (key) (and (string? key) (= (count key) 1))))
    (string/join keys "")
    (ed-keys-label keys)))

(defn- panel-description (item)
  "What a suffix row says after its key. A switch or an option leads with its FLAG, ticked
when on — the flag is what will actually run, so it is the part never clipped — then
explains itself."
  (if (nil? (:arg item))
    (:label item)
    (let (flag (if (nil? (:value item)) (:arg item) (str (:arg item) (:value item))))
      (str (if (:on? item) "✓ " "  ") flag "  " (:label item)))))

(defn panel-groups (state)
  "The open menu's groups as `keycolumns` groups `{:title :rows}`, each row `{:key :text :index}`
— `:index` the suffix's place in the menu."
  (second (fold (transient-core/transient-rows state)
            [0 []]
            (fn ([index groups] row)
              (if (= (:kind row) :heading)
                [index (conj groups {:title (or (:label row) "") :rows []})]
                (let (entry {:key (panel-key-label (:keys row))
                             :text (panel-description row)
                             :index index}
                      last-group (dec (count groups)))
                  [(inc index)
                    (if (< last-group 0)
                      [{:title "" :rows [entry]}]
                      (assoc groups last-group (update (nth groups last-group) :rows conj entry)))]))))))

(defn menu-state (m)
  "The open menu's state (the model's `:transient`), nil when none is open: all its key panel
is made from."
  (:transient m))

(defn key-panel (state _rows)
  "The open menu `state` ([[menu-state]]) as a key panel (`panel`): its title — with the trail
of the sub-menus it was reached through, the only thing saying what Escape will do — and its
groups, whole and side by side. nil when no menu is open."
  (when state
    {:title (transient-core/transient-title state) :groups (panel-groups state) :layout :balanced}))

(register-panel-source :transient
  {:rank 10 :when :transient :deps 'transient/menu-state :run 'transient/key-panel})
