;; src/lex-dotenv.blsp — lexical .env (dotenv) highlighting: each line is a `#` comment, a
;; blank, or a `KEY=value` assignment (optionally `export`-prefixed, the value optionally
;; quoted). The faces are the shared `:syntax/*` ones, so a theme recolours them.

(defmodule lex-dotenv
  "Lexical highlighting for `.env` (dotenv) files, as a pure function over a source
string — `(env-spans src)` returns `[start end face]` colour spans in the
`highlight-spans` shape (ascending, non-overlapping, end-exclusive), feeding the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Per line it
classifies a `#` comment, an optional leading `export` keyword, the `KEY` of a
`KEY=value` assignment, and a quoted value string. Pure, so independently testable."
  (:use editor/face))

;; ---- faces: the shared `:syntax/*` registry, resolved as a line is lexed --------------

(defn env-face-comment () (face :syntax/comment))
(defn env-face-export () (face :syntax/keyword))
(defn env-face-key () (face :syntax/definition))
(defn env-face-string () (face :syntax/string))

;; ---- scanning helpers -------------------------------------------------------

(defn- env-key-end (line start line-length)
  ;; a dotenv key is letters, digits, `_` and `.`
  (math/min line-length
    (string/span line start "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.")))
(sig env-key-end (string int int -> int))

;; ---- per-line spans ---------------------------------------------------------

(defn- env-value-spans (line base value-start line-length)
  "A one-element string span for a quoted value starting at offset `value-start` (to its
closing quote, or end of line if unclosed); `()` for an unquoted value (the default face)."
  (let (quote-char (when (< value-start line-length) (string/char-at line value-start)))
    (if (or (= quote-char "\"") (= quote-char "'"))
      (let (close (index-of line quote-char (inc value-start))
            value-end (if (< close 0) line-length (inc close)))
        (list [(+ base value-start) (+ base value-end) (env-face-string)]))
      '())))
(sig env-value-spans (string int int int -> (list (tuple int int any))))

(defn- env-assign-spans (line base lead line-length)
  "Spans for a `KEY=value` line (offsets shifted by `base`): an `export` keyword when
present, the key, and a quoted value. `()` when the line isn't an assignment."
  (let (export? (string/starts-with? (string/substring line lead line-length) "export ")
        key-start (if export? (+ lead 7) lead)
        key-end (env-key-end line key-start line-length))
    (if (and (> key-end key-start) (< key-end line-length) (= (string/char-at line key-end) "="))
      (append (if export? (list [(+ base lead) (+ base (+ lead 6)) (env-face-export)]) '())
        (cons [(+ base key-start) (+ base key-end) (env-face-key)]
          (env-value-spans line base (inc key-end) line-length)))
      '())))
(sig env-assign-spans (string int int int -> (list (tuple int int any))))

(defn- env-line-spans (line base)
  "The spans for one `line` starting at offset `base`: a `#` comment whole, else the
assignment spans (key / export / quoted value), else none."
  (let (line-length (count line) lead (string/span line 0 " \t"))
    (cond
      (>= lead line-length) '()
      (= (string/char-at line lead) "#")
        (list [(+ base lead) (+ base line-length) (env-face-comment)])
      else (env-assign-spans line base lead line-length))))
(sig env-line-spans (string int -> list))

(defn env-spans (src)
  "Lexically tokenize dotenv `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive) — in the `highlight-spans` shape, so it feeds the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Covers `#`
comments, the `export` keyword, the `KEY` of an assignment, and quoted values. Spans
are ascending and non-overlapping; unquoted values carry no span (the default face)."
  (editor/lexer/lexer-walk-lines src env-line-spans))
(sig env-spans (string -> any))

(defn env-line-lexer ()
  "`env-spans` as an `editor/highlight` stateless line lexer (brood ADR-471) — env-mode's
`:line-lexer`.

    (:stateless? (lex-dotenv/env-line-lexer))   ;=> true"
  (editor/line-cache/stateless-lexer env-spans))
