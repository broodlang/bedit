(defmodule wdired
  "Wdired — a Dired listing edited as text (Emacs's wdired-mode). `C-x C-q` in Dired (or M-x
wdired-change-to-wdired-mode) makes the file NAMES editable: the mark cell, sizes and dates, the
header and `.` / `..` stay read-only (`editspans`), and no Dired key is in force, so `m` types an
m. Rename by editing a name; type a `/` to move an entry into a directory (made when missing);
erase a name to flag the entry for deletion (`D`, as Emacs: `x` then deletes it).

A symlink's TARGET after ` -> ` is editable too while `:wdired-allow-to-redirect-links` is on
(Emacs's default): an edited target re-points the link. The permission column is editable when
`:wdired-allow-to-change-permissions` says so (off by default, as Emacs): `true` makes each of
the nine characters a toggle — SPC flips it between its letter and `-`, typing `r` `w` `x` `s`
`t` `S` `T` or `-` sets it, where `ls` would show that letter — and `:advanced` free text, read
as `ls -l` shows it (`fileperm/perms->mode`).

`C-c C-c` or `C-x C-s` applies every change at once: links re-pointed and modes set first, on
the entries' own names (`dired/ed-dired-set-attributes`), then the renames — swaps and cycles too
— through dired's (`dired/ed-dired-rename-entries`: an existing target is asked about, a buffer
visiting a renamed file follows it, another machine's listing renames through its file handler).
Each change stands alone: one that fails is said, the rest are made. `C-c C-k` or `C-c ESC` puts
everything back; `C-x C-q` leaves, asking first whether to apply when anything changed
(`editspans/leave`). Either way the buffer is Dired again, read again, its marks kept."
  (:use editor/buffer) ; the rope, regions, point
  (:use interactive) ; defcommand, declare-trait
  (:use model) ; ed-current-buf / ed-apply / message / ed-ding
  (:use editor/keymap :only [keymap-bind]) ; the mode's keys
  (:use modes :only []) ; register-type runs at load, after modes declares its kinds
  (:use dired
    :only [ed-show-dired
      ed-dired-move-to-filename dired-entry-rows ed-dired-busy? ed-dired-rename-entries
      ed-dired-set-attributes])) ; the listing, its renames and attributes

(defn- editing? (buffer) (and (editspans/editing? buffer) (not (nil? (:dired-dir buffer)))))

(defn- in-dired? (buffer)
  ;; a Dired listing that has landed (another machine's is listed off the loop)
  (and (= (editor/layers/buffer-type-for buffer) :dired) (not (nil? (:dired-names buffer)))))

(defn redirect-links? (m)
  "Whether wdired makes a symlink's target editable: init.blsp's
`:wdired-allow-to-redirect-links`, on unless it says false (Emacs's default)."
  (not (= false (:wdired-allow-to-redirect-links m))))

(defn permissions-mode (m)
  "How wdired edits the permission column, from init.blsp's `:wdired-allow-to-change-permissions`:
`:toggle` (true — each character flips), `:advanced` (free text) or nil (not editable, the
default)."
  (case (:wdired-allow-to-change-permissions m)
    true :toggle
    :advanced :advanced
    nil))

;; ---- the spans on point's line ------------------------------------------------------------

(defn- spans (buffer)
  ;; `[row region]` for every editable span, top to bottom — the rows editing began with beside
  ;; where each one is now
  (seq/zip (editspans/rows buffer) (or (editable-regions buffer) [])))

(defn- span-at-point (buffer)
  ;; the `[row region]` point is in (an end counts), or nil
  (let (point (buffer-point buffer))
    (seq/find (spans buffer)
      (fn ([_row region]) (and (>= point (first region)) (<= point (second region)))))))

(defn- name-region (buffer)
  "The editable name on point's line as `[from to]`, or nil on the header, `.` and `..`."
  (let (line (buffer-current-line buffer)
        found (seq/find (spans buffer)
                (fn ([row _region]) (and (= (:kind row) :name) (= (:line row) line)))))
    (when found (second found))))

(defn- into-name (buffer)
  ;; point moved onto its line's name when it is in no span and left of the name (wdired-next-line
  ;; keeps the column otherwise); a line with no name puts it where Dired would
  (let (region (name-region buffer))
    (cond
      (nil? region) (ed-dired-move-to-filename buffer)
      (not (nil? (span-at-point buffer))) buffer
      (< (buffer-point buffer) (first region)) (goto-char buffer (first region))
      else buffer)))

(defcommand cmd-wdired-next-line
  (m key)
  "Move to the next line, point kept in the name column (C-n, Emacs's wdired-next-line)."
  (ed-apply (motion/cmd-next-line m key) into-name))

(defcommand cmd-wdired-previous-line
  (m key)
  "Move to the previous line, point kept in the name column (C-p, wdired-previous-line)."
  (ed-apply (motion/cmd-previous-line m key) into-name))

(defcommand cmd-wdired-beginning-of-line
  (m key)
  "Move to the start of the name on this line, or of the line where there is none (C-a)."
  (ed-apply m
    (fn (buffer)
      (let (region (name-region buffer))
        (if (nil? region)
          (goto-char buffer (text/line->char (buffer-rope buffer) (buffer-current-line buffer)))
          (goto-char buffer (first region)))))))

(defcommand cmd-wdired-no-newline
  (m key)
  "Refuse a line break (RET, C-o): a file name cannot hold one."
  (ed-ding (message m "a file name cannot hold a line break")))

;; ---- the permission toggles (Emacs's wdired-toggle-bit / wdired-set-bit) -------------------
;; With the permissions as toggles, the keys a permission can read are bound to one TYPING
;; command: in a permission span it sets the character under point and steps past it, anywhere
;; else it types as any letter does. So no letter runs a command over the names, which
;; tests/writable_test holds every edit variant to (a `:typing` command is typing).

(defn- set-bit (m buffer region key)
  ;; the permission character under point set as `key` asks — SPC flipping it — point past it
  (let (point (buffer-point buffer)
        index (- point (first region))
        current (when (< point (second region)) (text/slice (buffer-rope buffer) point (inc point)))
        letter (when (and (int? index) (< index 9)) (fileperm/position-letter index))
        new (cond
              (or (nil? current) (nil? letter)) nil
              (= key " ") (if (= current "-") letter "-")
              (fileperm/allowed-at? index key) key
              else nil))
    (cond
      (nil? current)
        (ed-ding (message m "past the permissions — SPC, r, w, x, s, t or - edits one"))
      (nil? new) (ed-ding (message m (str key " cannot stand there — " letter ", - or SPC")))
      else
        (ed-edit m
          (fn (edited) (goto-char (replace-region edited point (inc point) new) (inc point)))))))

(defcommand cmd-wdired-set-bit
  (m key)
  "Type `key`: in a permission span while the permissions are toggles (init.blsp's
`:wdired-allow-to-change-permissions` true), set the character under point — SPC flips it
between its letter and `-`, a letter `ls` would show there or `-` sets it — and step past it
(Emacs's wdired-toggle-bit / wdired-set-bit); anywhere else, insert it."
  (let (buffer (ed-current-buf m)
        found (span-at-point buffer))
    (if (and (editing? buffer)
          (= (:wdired-perms buffer) :toggle)
          found
          (= (:kind (first found)) :perms))
      (set-bit m buffer (second found) key)
      (typing/cmd-self-insert m key))))

(declare-trait :typing '(wdired/cmd-wdired-set-bit))

;; ---- C-x C-q in Dired: the names become editable -----------------------------------------

(defcommand cmd-wdired-change-to-wdired-mode
  (m key)
  "Make this Dired listing's file names editable (C-x C-q, Emacs's wdired-change-to-wdired-mode):
edit a name to rename the entry, add a directory to move it, erase it to flag it for deletion —
and a symlink's target to re-point it, the permissions to change them when init.blsp allows.
C-c C-c applies the changes, C-c C-k puts them back."
  (let (buffer (ed-current-buf m)
        perms (permissions-mode m)
        rows (into []
               (dired-entry-rows buffer {:links? (redirect-links? m) :perms? (not (nil? perms))})))
    (cond
      (editing? buffer) (message m "already editing the names — C-c C-c applies, C-c C-k aborts")
      (not (in-dired? buffer)) (message m "not a Dired listing")
      (not (any? rows (fn (row) (= (:kind row) :name))))
        (ed-ding (message m "no entries to rename here"))
      else
        (message (ed-set-buf m
                   (into-name (assoc (editspans/begin buffer rows :wdired) :wdired-perms perms)))
          "Editing the names — C-c C-c applies, C-c C-k aborts"))))

;; ---- leaving: back to Dired --------------------------------------------------------------

(defn- back-to-dired (m buffer)
  ;; `buffer` (the one being edited) put back as the listing: its names as they began, read-only
  ;; in Dired, point on its line's name
  (ed-set-buf m (into-name (dissoc (editspans/finish (editspans/restore buffer)) :wdired-perms))))

(defn- flag-all (m names)
  ;; `m` with `names` flagged for deletion on the current listing, each `*` mark replaced (one
  ;; mark cell a row, as Dired's d)
  (let (buffer (ed-current-buf m)
        flagged (into #{} names))
    (ed-set-buf m
      (assoc buffer
        :dired-marks
          (seq/reject (or (:dired-marks buffer) '()) (fn (name) (contains? flagged name)))
        :dired-flags (seq/distinct (append (or (:dired-flags buffer) '()) names))))))

(defn- flagged-note (count-flagged)
  ;; what flagging says, after the renames' report
  (if (= count-flagged 0)
    ""
    (str "; " (ed-count-noun count-flagged "file") " flagged for deletion — x deletes")))

(defn attributes-note (report)
  "What re-pointing links and setting modes says after the renames' report, from
`dired/ed-dired-set-attributes`' `report`: `; ` then how many links and modes changed and the
first failure with its reason — \"\" when there were none.

    (wdired/attributes-note {:done [{:op :redirect :name \"l\"}] :failed []})   ;=> \"; 1 link redirected\"
    (wdired/attributes-note {:done [] :failed [[{:op :chmod :name \"a\"} \"denied\"]]})   ;=> \"; 1 change failed — a: denied\""
  (let (done (:done report)
        failed (:failed report)
        of-op (fn (op) (count (seq/filter done (fn (change) (= (:op change) op)))))
        redirected (of-op :redirect)
        chmodded (of-op :chmod)
        parts (seq/keep [(when (> redirected 0)
                           (str (ed-count-noun redirected "link") " redirected"))
                          (when (> chmodded 0) (str (ed-count-noun chmodded "mode") " changed"))
                          (when (not (empty? failed))
                            (let ([change reason] (first failed))
                              (str (ed-count-noun (count failed) "change")
                                " failed — "
                                (:name change)
                                ": "
                                reason)))]
                identity))
    (if (empty? parts) "" (str "; " (string/join parts "; ")))))

(defn- relisted (m dir)
  ;; `dir`'s listing read again when it is the buffer shown, point kept on its line
  (let (buffer (ed-current-buf m))
    (if (= (:dired-dir buffer) dir) (ed-show-dired m dir (inc (buffer-current-line buffer))) m)))

(defn- sentence (tail)
  ;; a `; `-led tail said on its own: the separator gone, the first letter capital
  (let (text (string/substring tail 2 (count tail)))
    (if (= text "")
      text
      (str (string/upper (string/substring text 0 1))
        (string/substring text 1 (count text))))))

(defn- attribute-of (row now)
  ;; what an edited target or permission span asks dired to do
  (if (= (:kind row) :target)
    {:op :redirect
     :name (:name row)
     :value (if (= now "") (failure "a link needs a target") now)}
    {:op :chmod :name (:name row) :value (fileperm/perms->mode now)}))

(defn- after-attributes (m dir renames erased report)
  ;; the renames made once the links and modes are, everything said in one line
  (let (tail (str (attributes-note report) (flagged-note (count erased)))
        touched? (or (not (empty? erased))
                   (not (empty? (:done report)))
                   (not (empty? (:failed report)))))
    (cond
      (empty? renames) (message (relisted m dir) (sentence tail))
      touched? (ed-dired-rename-entries (relisted m dir) dir renames tail)
      else (ed-dired-rename-entries m dir renames tail))))

(defcommand cmd-wdired-finish-edit
  (m key)
  "Apply the edits (C-c C-c, C-x C-s — Emacs's wdired-finish-edit): an edited link target
re-points the link and edited permissions set the mode, on the entries' own names; then each
changed name renames its entry, all at once (a swap works), a name with a directory moves the
entry there, an erased name flags the entry for deletion (`x` then deletes it). A target already
there is asked about. Each change stands alone, a failure said. Back to Dired, read again."
  (let (buffer (ed-current-buf m)
        dir (:dired-dir buffer)
        changes (editspans/changes buffer)
        of-kind (fn (kind) (seq/filter changes (fn ([row _now]) (= (:kind row) kind))))
        named (of-kind :name)
        erased (into []
                 (map (seq/filter named (fn ([_row now]) (= now ""))) (fn ([row _]) (:name row))))
        renames (into []
                  (map (seq/reject named (fn ([_row now]) (= now "")))
                    (fn ([row now]) [(:name row) now])))
        attributes (into []
                     (map (seq/reject changes (fn ([row _now]) (= (:kind row) :name)))
                       (fn ([row now]) (attribute-of row now)))))
    (cond
      (not (editing? buffer)) (message m "not editing the names — C-x C-q starts")
      (any? changes (fn ([row now]) (and (not (= (:kind row) :perms)) (includes? now "\n"))))
        (ed-ding (message m "a file name cannot hold a line break — C-c C-k puts the names back"))
      (and (or (not (empty? renames)) (not (empty? attributes))) (ed-dired-busy? m))
        (message m "a Dired operation is still running (C-g stops it) — C-c C-c again after")
      (empty? changes) (message (back-to-dired m buffer) "(No changes to be performed)")
      else
        (ed-dired-set-attributes (flag-all (back-to-dired m buffer) erased)
          dir
          attributes
          (fn (mm report) (after-attributes mm dir renames erased report))))))

(defcommand cmd-wdired-abort-changes
  (m key)
  "Put every name back as it was and return to Dired (C-c C-k, C-c ESC — wdired-abort-changes)."
  (let (buffer (ed-current-buf m))
    (if (not (editing? buffer))
      (message m "not editing the names")
      (message (back-to-dired m buffer) "Changes aborted"))))

;; ---- the mode ----------------------------------------------------------------------
;; Text-mode's typing under these keys and the listing's colours — and no Dired keymap, which
;; is the point: every letter types (the permission letters through `cmd-wdired-set-bit`, a
;; typing command). C-c C-c / C-x C-s apply, C-c C-k / C-c ESC abort and C-x C-q leaves (asking
;; when anything changed) as every edit variant does (`editspans/edit-layer`).

(def wdired-keymap
  (fold ["r" "w" "x" "s" "t" "S" "T" "-" " "]
    (-> {}
      (keymap-bind [:ctrl-n] 'wdired/cmd-wdired-next-line)
      (keymap-bind [:down] 'wdired/cmd-wdired-next-line)
      (keymap-bind [:ctrl-p] 'wdired/cmd-wdired-previous-line)
      (keymap-bind [:up] 'wdired/cmd-wdired-previous-line)
      (keymap-bind [:ctrl-a] 'wdired/cmd-wdired-beginning-of-line)
      (keymap-bind [:home] 'wdired/cmd-wdired-beginning-of-line)
      (keymap-bind [:enter] 'wdired/cmd-wdired-no-newline)
      (keymap-bind [:ctrl-o] 'wdired/cmd-wdired-no-newline))
    (fn (keymap key) (keymap-bind keymap [key] 'wdired/cmd-wdired-set-bit))))

(defn wdired-modeline (m buf)
  "wdired-mode's `:modeline` segment: what the keys are, Emacs's `Editable` lighter."
  "Editable — C-c C-c applies, C-c C-k aborts")

(def wdired-mode-layer
  (editspans/edit-layer {:name 'wdired
                         :doc "A Dired listing's names as text: edit to rename, C-c C-c applies, C-c C-k aborts."
                         :keymap wdired/wdired-keymap
                         :modeline 'wdired/wdired-modeline
                         :fontify 'dired/dired-fontify}
    'wdired/cmd-wdired-finish-edit 'wdired/cmd-wdired-abort-changes))

(modes/register-type :wdired (list 'wdired/wdired-mode-layer 'modes/text-mode-layer))
