(defmodule fillindicator
  "The fill-column indicator (Emacs's `display-fill-column-indicator-mode`): a thin vertical
rule, `│` in the decor tier, at the buffer's fill column (`conventions/fill-column`, so its
.editorconfig, init.blsp's `:fill-column` per mode and M-x set-fill-column all move it). On per
mode with init.blsp's `:fill-column-indicator` (`scroll/ed-local-setting`, a directory file's
first), off by default; M-x display-fill-column-indicator-mode toggles one buffer.

As Emacs draws it, the rule shows only where the screen line leaves the column EMPTY: a
character standing there keeps its cell. A `:with-text` pane layer, so it scrolls and is
memoised with the text. Where each row's column is:

- an unwrapped pane scrolled `hscroll` columns left: the fill column less the scroll, and
  nothing when that is off the text's left or right edge;
- a wrapped line: every screen row of it at the fill column from the text's left edge (Emacs
  draws the rule at one x down the window), the row's own text measured from its start;
- a truncated line cut at the pane's edge (a clipped row) or an inlay row: no rule."
  (:use editor/buffer) ; buffer-rope / buffer-line-count
  (:use editor/display :only [text]) ; the rule's cell
  (:use model) ; register-pane-layer / ed-current-buf / ed-set-buf / message
  (:use interactive) ; defcommand — M-x display-fill-column-indicator-mode
  (:use theme)) ; *fg-decor*, the tier the rule is drawn in

(def *indicator-character* "│") ; Emacs's `display-fill-column-indicator-character`

;; Emacs's `fill-column-indicator` face: furniture, the quietest tier
(theme/defchrome face-fill-column-indicator {:fg *fg-decor*})

(sig shown? (model any -> bool))
(defn shown? (m buf)
  "Whether `buf` shows the indicator: its own M-x display-fill-column-indicator-mode when
toggled, else init.blsp's `:fill-column-indicator` for its mode."
  (let (local (when buf (:fill-column-indicator buf)))
    (cond
      (bool? local) local
      (nil? buf) false
      else
        (= true
          (scroll/ed-local-setting :fill-column-indicator (:fill-column-indicator m) buf false)))))

(defn- screen-rows (rope geometry)
  ;; `[k entry]` for each text row the pane shows, `entry` its row entry (`wrap/row-cell`'s
  ;; shape) — an inlay or clipped row left out. An unwrapped pane's entry starts at its
  ;; horizontal scroll, as the view paints it
  (let (height (:text-height geometry)
        rows (:rows geometry)
        top (:top geometry))
    (if (nil? rows)
      (seq/keep (range height)
        (fn (k)
          (let (line (+ top k))
            (when (< line (text/line-count rope)) [k [line (:hscroll geometry) nil nil]]))))
      (seq/keep (range (math/min height (count rows)))
        (fn (k)
          (let (row (nth rows k))
            (when (and (nil? (nth row 3 nil)) (nil? (nth row 4 nil))) [k row])))))))

(sig indicator-cells (any any int -> any))
(defn indicator-cells (buf geometry column)
  "`[row cell]` for each body row of the pane `geometry` lays out where the rule at fill
`column` shows: the cell from the text's left edge, on a row whose text stops short of it.
A row's text is measured by `wrap/row-cell`, as it is painted: tab stops, a wrap prefix and
inline annotations included."
  (let (rope (buffer-rope buf)
        width (second (panegeometry/geometry-span geometry :text))
        hscroll (if (nil? (:rows geometry)) (:hscroll geometry) 0)
        cell (- column hscroll))
    (if (or (< cell 0) (>= cell width))
      '()
      (seq/keep (screen-rows rope geometry)
        (fn ([k entry])
          (let (end (nth entry 2 nil)
                shown (wrap/row-cell rope entry (if (nil? end) (count rope) end)))
            (when (<= shown cell) [k cell])))))))

(defn indicator-ops (m pane buf geometry)
  "The pane layer: `│` at the fill column on every shown row that leaves it empty, when the
buffer shows the indicator ([[shown?]])."
  (if (and geometry (shown? m buf))
    (let (text-left (first (panegeometry/geometry-span geometry :text)))
      (map (indicator-cells buf geometry (conventions/fill-column buf))
        (fn ([row cell])
          (text (+ (:y geometry) row)
            (+ text-left cell)
            *indicator-character*
            face-fill-column-indicator))))
    '()))

(defn indicator-deps (m pane buf)
  "What the layer reads besides the buffer and the pane: the init file's switch, and the face
(a theme switch recolours it)."
  [(:fill-column-indicator m) face-fill-column-indicator])

(register-pane-layer :fill-column-indicator
  {:rank 5 :slot :with-text :run 'fillindicator/indicator-ops :deps 'fillindicator/indicator-deps})

(defcommand cmd-display-fill-column-indicator-mode
  (m key)
  "Toggle the fill-column indicator in this buffer (Emacs `display-fill-column-indicator-mode`):
a thin rule at the fill column wherever a line leaves it empty. The `:fill-column-indicator`
setting turns it on per mode."
  (let (buf (ed-current-buf m)
        on (not (shown? m buf)))
    (message (ed-set-buf m (assoc buf :fill-column-indicator on))
      (if on
        "Display-Fill-Column-Indicator mode enabled in this buffer"
        "Display-Fill-Column-Indicator mode disabled in this buffer"))))
