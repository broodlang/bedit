(defmodule fileperm
  "The `ls -l` permission column: a `file-stat` map turned into `drwxr-xr-x`, and back — the nine
permission characters read as a mode ([[perms->mode]]), which wdired's edited permissions are.
Shared by dired's listing and Plume's `:file` marginalia, which format permissions identically
through it.")

(defn rwx (bits)
  "The `rwx`/`-` triad for a 3-bit permission group `bits` (0–7)."
  (str (if (>= (math/rem (math/quot bits 4) 2) 1) "r" "-")
    (if (>= (math/rem (math/quot bits 2) 2) 1) "w" "-")
    (if (>= (math/rem bits 2) 1) "x" "-")))

(defn- with-special (triad special? letter)
  ;; `triad` with its execute character shown as `ls` shows a set special bit: `letter` (s or
  ;; t) over x, its capital where the x is not set
  (if special?
    (str (string/substring triad 0 2)
      (if (= (string/substring triad 2 3) "x") letter (string/upper letter)))
    triad))

(defn mode-string (mode)
  "The nine `ls -l` permission characters for the mode bits `mode` (0..0o7777): the owner, group
and other triads, a setuid / setgid bit as `s` (`S` without the x under it), the sticky bit as
`t` (`T`).

    (fileperm/mode-string 493)   ;=> \"rwxr-xr-x\"
    (fileperm/mode-string 2541)   ;=> \"rwsr-xr-x\"
    (fileperm/mode-string 1023)   ;=> \"rwxrwxrwt\"
    (fileperm/mode-string 1024)   ;=> \"-----S---\""
  (let (bit-set? (fn (bit) (>= (math/rem (math/quot mode bit) 2) 1)))
    (str (with-special (rwx (math/quot (math/rem mode 512) 64)) (bit-set? 2048) "s")
      (with-special (rwx (math/quot (math/rem mode 64) 8)) (bit-set? 1024) "s")
      (with-special (rwx (math/rem mode 8)) (bit-set? 512) "t"))))

(defn perms-string (stat)
  "The 10-char `ls -l` permission string for `file-stat` map `stat`: a type char
(`d`/`l`/`-`) then the owner/group/other triads from `:mode` ([[mode-string]], the special bits
as `s` / `t`). `----------` for a missing stat."
  (if (nil? stat)
    "----------"
    (let (type (cond (:symlink? stat) "l" (:dir? stat) "d" else "-"))
      (str type (mode-string (or (:mode stat) 0))))))

(def- position-letters
  ;; what each of the nine places may read besides `-`, and the bits each letter sets: r, w, x,
  ;; then the special bit an `s` / `t` adds over the x (its capital: the special bit alone)
  [{"r" 256}
    {"w" 128}
    {"x" 64 "s" 2112 "S" 2048}
    {"r" 32}
    {"w" 16}
    {"x" 8 "s" 1032 "S" 1024}
    {"r" 4}
    {"w" 2}
    {"x" 1 "t" 513 "T" 512}])

(defn position-letter (index)
  "The letter the permission place `index` (0..8) reads when its bit is set: r, w or x.

    (fileperm/position-letter 4)   ;=> \"w\""
  (nth ["r" "w" "x"] (math/rem index 3)))

(defn allowed-at? (index char)
  "Whether `char` may stand at permission place `index` (0..8) of an `ls -l` string: `-`, the
place's letter, or at an execute place `s` / `S` (owner and group) or `t` / `T` (other).

    (fileperm/allowed-at? 2 \"s\")   ;=> true
    (fileperm/allowed-at? 8 \"s\")   ;=> false"
  (and (>= index 0)
    (< index 9)
    (or (= char "-") (contains? (nth position-letters index) char))))

(defn perms->mode (text)
  "The mode bits the nine `ls -l` permission characters `text` say — what [[mode-string]] wrote,
read back (`rwsr-x--T` too) — or a failure naming what does not read.

    (fileperm/perms->mode \"rwxr-xr-x\")   ;=> 493
    (fileperm/perms->mode \"rwsr-xr-x\")   ;=> 2541
    (fileperm/perms->mode \"rw-r--r-T\")   ;=> 932
    (failure? (fileperm/perms->mode \"rwq------\"))   ;=> true"
  (let (chars (if (string? text) (string/->list text) []))
    (if (not (= (count chars) 9))
      (failure (str "not nine permission characters: " text))
      (fold (range 0 9)
        0
        (fn (mode index)
          (let (char (nth chars index))
            (cond
              (failure? mode) mode
              (= char "-") mode
              (allowed-at? index char) (+ mode (get (nth position-letters index) char))
              else (failure (str "not a permission character there: " char " in " text)))))))))
