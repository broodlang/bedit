(defmodule compile
  "Compilation mode: M-x compile prompts for a shell command, runs it in the project
root, and streams output to a `*compilation*` buffer. C-x ` / M-g n (cmd-next-error)
parses error locations and jumps to each in turn; M-g p (cmd-previous-error) walks back.

The compile worker process is named `:compile` (`spawn :compile …`) so it is
idempotent across M-x compile invocations — a fresh spawn recycles the live process,
and a dead one (e.g. after a crash) is replaced transparently."
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use minibuffer)
  (:use model) ; ed-buffer-index-by-name / ed-scroll / ed-stamp / message
  (:use pool) ; ed-open-buffer / ed-select / ed-goto-line / ed-find-file
  (:use interactive) ; defcommand
  (:use ansicolor :only [insert-output]) ; a stream's ANSI escapes decoded: its colours as text properties, its returns done
  (:use editor/buffer)) ; make-buffer / insert / end-of-buffer / buffer-text
(def *compile-buf* "*compilation*")

;; ---- error line parser -------------------------------------------------------
;; The table of error formats (Emacs' `compilation-error-regexp-alist`) is
;; `results/*error-patterns*`: one parser for C-x ` here and for RET / click on any
;; results row.

(defn- compile-parse-errors (text)
  ;; every error location `text` names, in order (`results/loc-at-line`)
  (seq/keep (string/split text "\n") results/loc-at-line))

;; ---- buffer append (raw stream chunks, no forced newline) -------------------

(defn- compile-append (m text &optional spans)
  "Append a chunk of output to `*compilation*`, its ANSI colours (`spans` from the chunk's
start, as `ansicolor/decode` gives them) as faces on it — Emacs colours a compilation's
output (`ansi-color-for-compilation-mode`) — and its carriage returns done, so a progress
counter rewrites its line (`ansicolor/insert-output`, Emacs's `comint-carriage-motion`). The
buffer then keeps only its newest lines (`model/ed-cap-output`, the `:output-buffer-max-lines`
setting), its colours cut with them — a build that talks for an hour must not keep every line
it said. C-x ` walks the errors in what is kept."
  (model/ed-cap-output
    (model/ed-write-output m
      *compile-buf*
      ;; *compilation* is read-only for the user; the stream unlocks per append
      (fn (buffer) (first (insert-output buffer (buffer-length buffer) text spans))))
    *compile-buf*))

;; ---- reset the compilation buffer at the start of a new compile -------------

(defn- compile-reset (m cmd)
  "Clear `*compilation*`, write a header, and select it in the current pane. Stamped
`:compile-log`, which stacks the shared location-jump layer — RET or a click on a
`file:line[:col]:` error row visits it (C-x ` still walks them in order)."
  (let (header (str "-*- compilation: " cmd " -*-\n\n")
        fresh (ed-stamp (assoc (make-buffer header *compile-buf* nil)
                          :read-only true
                          :type :compile-log))
        index (ed-buffer-index-by-name m *compile-buf*))
    (if (nil? index)
      (ed-open-buffer m fresh)
      (let (existing (nth (:buffers m) index))
        (ed-select (update m :buffers assoc index (assoc fresh :dir (:dir existing))) index)))))

;; *compilation* rows are GNU-style `file:line[:col]: message` — exactly the shared
;; parser's shape, so the stock location-jump layer is the whole integration.
(modes/register-special-type :compile-log 'results/location-jump-layer)

;; *Project Search* rows (C-x p g) are `file:line:text` from grep — the same shape.
;; …plus its own `:fontify`, which colours the file, the line number and the match the way
;; Emacs's grep-mode does (`project-search/project-search-layer`).
(modes/register-special-type :project-search
  'project-search/project-search-layer 'results/location-jump-layer)

;; ---- the compile worker process ---------------------------------------------
;; One long-lived process per editor session, registered as `:compile`.
;; `(spawn :compile (compile-loop))` is idempotent: returns the live handle if
;; the process is alive, or starts a fresh one if it died. Receives
;; `[:compile-run cmd root reply]` to start a compilation, its output going to `reply` (the
;; loop that asked — `ed-loop-address`); stays alive between compiles.

(defn- compile-forward (reply decoder data)
  "Decode the chunk `data` with its stream's `decoder`, send its text and ANSI colours to
`reply`, and return the decoder to continue that stream with."
  (let ([next-decoder text spans] (ansicolor/decode decoder data))
    (when (not (= text "")) (send reply (compile-output-event text spans)))
    next-decoder))

(defn- compile-recv (proc reply out err)
  "Wait for proc messages after spawning `sh -c cmd`; forward chunks to the editor.
`out` / `err` are the two streams' ANSI decoders (`ansicolor/decode`): an escape split
across two reads is finished by the second, never shown, and the colours travel with the
text. Messages from a superseded proc (wrong handle) are silently dropped so stale output
never bleeds into a fresh compilation. Handles `[:compile-run]` mid-flight to kill
the current proc and immediately restart — re-running compile never queues."
  (receive
    ([:proc p data] (compile-recv proc
                      reply
                      (if (= p proc) (compile-forward reply out data) out)
                      err))
    ([:proc-err p data] (compile-recv proc
                          reply
                          out
                          (if (= p proc) (compile-forward reply err data) err)))
    ([:proc-closed p code] (if (= p proc)
                             (do
                               (send reply (compile-done-event code))
                               (compile-loop))
                             (compile-recv proc reply out err)))
    ([:compile-run cmd root new-reply] (do
                                         (procstream/close-quietly proc "compile")
                                         (compile-start cmd root new-reply)))
    ([:shutdown] (do (procstream/close-quietly proc "compile") :compile-stopped))))

(defn- compile-start (cmd root reply)
  "Spawn `cmd` through the platform's shell (`os/shell-spawn`) in `root` and stream it to `reply`, each stream with a fresh decoder."
  (compile-recv (os/shell-spawn cmd {:cwd root})
    reply
    (ansicolor/decoder)
    (ansicolor/decoder)))

(defn- compile-loop ()
  "Idle — wait for the next `[:compile-run cmd root reply]` message. Compiles are minutes
apart (human-paced), so `hibernate` while idle: shrink the heap and drop the caches;
they rebuild on the next run. (Only here — `compile-recv` streams output and must
stay hot.)"
  (proc/hibernate)
  (receive
    ([:compile-run cmd root reply] (compile-start cmd root reply))
    ([:shutdown] :compile-stopped)))

;; ---- inbound async events (UiEvent records — see model.blsp) ----------------
;; Each folds through its named `ed-ev-*` fn (`model/defuievent`), so redefining one
;; hot-swaps the live editor (the impl's global call resolves late, like a keymap binding).

(defuievent compile-output-event (text spans) ed-ev-compile-output) ; a chunk of compiler output, ANSI-decoded, and its colours
(defuievent compile-done-event (code) ed-ev-compile-done) ; the build's exit code

(defn ed-ev-compile-output (m event textrows cols rows)
  "Stream a chunk of compiler output into `*compilation*`, its ANSI colours as faces."
  (ed-scroll (compile-append m (compile-output-event-text event) (compile-output-event-spans event))
    textrows))

(defn ed-ev-compile-done (m event textrows cols rows)
  "Compilation finished: append a summary, parse errors, store on model."
  (let (code (compile-done-event-code event)
        index (ed-buffer-index-by-name m *compile-buf*)
        text (when index (buffer-text (nth (:buffers m) index)))
        errors (if text (compile-parse-errors text) '())
        summary (if (= code 0)
                  "\nCompilation finished\n"
                  (str "\nCompilation exited with code " code "\n"))
        finished (assoc (dissoc (compile-append m summary) :compile-running)
                   :compile-errors errors
                   :compile-error-idx -1)
        echo (cond
               (= code 0) "Compilation finished"
               (empty? errors) (str "Compilation failed (exit " code ")")
               else (str (count errors) " error(s)")))
    (ed-scroll (message finished echo) textrows)))

;; ---- M-x compile ------------------------------------------------------------

(defn compile-run (m cmd &optional directory)
  "Start `cmd` in the project root (or `directory`, when given: a runnable a language server
named, `lsp-lens`), streaming its output into `*compilation*` and
arming `next-error` over whatever locations it prints.

This is the body of `M-x compile` once the command is known, lifted out so it is
also what a non-Brood toolchain's test and run commands go through: \"stream a
subprocess and parse the file:line it prints\" is one behaviour, and Emacs reaches
it the same way — running `mix test` there is `M-x compile` with a different
command, not a second runner. It deliberately does NOT remember `cmd` as the
compile default; `M-x compile` records that itself, so running the tests does not
change what the next build offers.

From a buffer on another machine (`/ssh:…`) it runs nothing: the build would run HERE, in a
project that is not the file's, and its errors would name paths that are not the remote ones."
  (if (sshpath/remote? (:dir (ed-current-buf m)))
    (message m
      (str "compile: this buffer is on another machine ("
        (:dir (ed-current-buf m))
        ") — a build runs on this one; run it from a local buffer"))
    (let (root (or directory (:project-root m) (file/cwd))
          proc (spawn :compile (compile-loop))
          reset (compile-reset m cmd))
      (send proc [:compile-run cmd root (ed-loop-address)])
      (message (assoc reset
                 :compile-proc proc
                 :compile-running cmd
                 :compile-errors '()
                 :compile-error-idx -1)
        (str "Running: " cmd)))))

(defn compile-live (m)
  "The build C-x C-c would kill (`model/register-exit-query`): `:compile-running` is the
command from `compile-run` until its exit folds in — the worker process itself outlives
every run, so it is not the sign one is in flight."
  (if-let (cmd (:compile-running m)) [(str *compile-buf* ": " cmd)] []))

(register-exit-query :compile 'compile/compile-live)

(defcommand cmd-compile
  (m key)
  "Run a shell command in the project root, streaming output to `*compilation*` (M-x compile).
The prompt is prefilled with what you last compiled here, else with what this
project's toolchain builds with — `mix compile` in a mix project, `cargo build` in a
cargo one — Emacs' buffer-local `compile-command` with projectile filling it in;
`make` where the toolchain names none."
  (let (default (or (:compile-last-cmd m) (toolchain/compile-command m) "make"))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Compile command: " default)
         :on-complete (fn (prompted cmd) (assoc (compile-run prompted cmd) :compile-last-cmd cmd))})))

;; ---- M-x project-task -------------------------------------------------------

(defcommand cmd-project-task
  (m key)
  "Run one of this project's build-tool tasks (M-x project-task) — a `mix` task, a
script from a `package.json` — streaming it into `*compilation*`.

The list comes from the TOOL, the way `mix.el`'s `mix-execute-task` completes over
`mix help` rather than over a list someone typed into the editor: `mix help` includes
the tasks a project defines for itself, so `mix ecto.migrate` shows up in a project
that has Ecto and nowhere else.

The tool is asked OFF the loop (`ed-open-when-ready`), since `mix help` takes seconds; the
prompt opens when it answers."
  (let (lister (toolchain/task-lister m)
        label (toolchain/name-of m))
    (if (nil? lister)
      (message m (str "no tasks to list for a " label " project"))
      (offloop/ed-open-when-ready m
        (str "listing " label " tasks")
        lister
        (fn (ready tasks)
          (if (empty? tasks)
            (message ready (str "no tasks to list for a " label " project"))
            (assoc ready
              :minibuffer
                (ed-name-prompt (str label " task: ")
                  tasks
                  (fn (chosen task)
                    (let (cmd (toolchain/task-command chosen task))
                      (if (nil? cmd)
                        (message chosen (str "no way to run a task in a " label " project"))
                        (compile-run chosen cmd))))))))))))

;; ---- next-error / previous-error (C-x ` · M-g n / M-g p) --------------------
;; One walk parameterised by `step` (±1) — the cursor into `:compile-errors` moves either
;; way, so the pair is Emacs' `next-error` / `previous-error` over the same parsed list.

(sig compile-visit-error (model int -> model))
(defn- compile-visit-error (m step)
  "Move the `:compile-error-idx` cursor by `step` (+1 next, -1 previous) and visit that
error's file/line, echoing `file:line`. A message-only no-op when there are no errors or
the cursor would run off the end."
  (let (errors (:compile-errors m)
        index (+ step (or (:compile-error-idx m) -1)))
    (if (or (nil? errors) (empty? errors) (< index 0) (>= index (count errors)))
      (message m (if (or (nil? errors) (empty? errors)) "No compilation errors" "No more errors"))
      (let (found (or (nth errors index) (error "no compilation error at the cursor")) ; in range by the test above
            file (path/absolute (path/join (or (:project-root m) ".") (:file found)))
            line (:line found)
            column (if (int? (:col found)) (:col found) 1))
        ;; the column too, when the tool gave one; a large file is read off the loop, point
        ;; landing on the error once it is there
        (message (ed-find-file-then (assoc m :compile-error-idx index)
                   file
                   (fn (buffer)
                     (let (target (math/max 0
                                    (math/min (dec line) (dec (buffer-line-count buffer))))
                           at-line (fold (range target)
                                     (beginning-of-buffer buffer)
                                     (fn (moved _) (forward-line moved)))
                           room (count (string/trim-right (buffer-line-at at-line target))))
                       (forward-char at-line (math/max 0 (math/min (dec column) room))))))
          (str (:file found) ":" line))))))

(defcommand cmd-next-error
  (m key)
  "Jump to the next compiler error parsed from `*compilation*` (C-x ` / M-g n)."
  (compile-visit-error m 1))

(defcommand cmd-previous-error
  (m key)
  "Jump back to the previous compiler error (M-g p)."
  (compile-visit-error m -1))

(register-inverse 'compile/cmd-next-error 'compile/cmd-previous-error)
