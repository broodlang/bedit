(defmodule compile
  "Compilation mode: M-x compile prompts for a shell command, runs it in the project
root, and streams output to a `*compilation*` buffer. C-x ` / M-g n (cmd-next-error)
parses error locations and jumps to each in turn; M-g p (cmd-previous-error) walks back.

The compile worker process is named `:compile` (`spawn :compile …`) so it is
idempotent across M-x compile invocations — a fresh spawn recycles the live process,
and a dead one (e.g. after a crash) is replaced transparently."
  (:use model) ; ed-buffer-index-by-name / ed-scroll / ed-stamp / message
  (:use commands) ; ed-open-buffer / ed-select / ed-apply / ed-goto-line / ed-find-file
  (:use interactive) ; defcommand
  (:use editor/layers) ; register-type-layers — the :compile-log buffer type
  (:use editor/buffer)) ; make-buffer / insert / end-of-buffer / buffer-text
;; ansi/strip-ansi and regex/matches? are referenced qualified below — each `mod/name`
;; auto-loads its module.
(def *compile-buf* "*compilation*")

;; ---- error line parser -------------------------------------------------------
;; Emacs keeps `compilation-error-regexp-alist-alist`: a table of (REGEXP FILE LINE
;; COL) rows where the numbers say which capture group holds what, and teaching
;; `next-error` a new tool is adding a row. bedit could not have that table until
;; Brood's regex engine grew capture groups — with a boolean `match?` there is no
;; way to say "group 1 is the file" — so this was three hand-written
;; string-splitting parsers, one per format someone had bothered to code, and a
;; fourth format meant a fourth function.
;;
;; The order is the priority: a `-->` line also contains `file:line:col`, and a
;; Python traceback must be read before anything hunts for colons in it.

(def *error-patterns*
  [;; rustc / cargo:      -->  src/main.rs:10:5
   {:name :rust :pattern "--> +([^\\s:]+):(\\d+):(\\d+)" :file 1 :line 2 :col 3}
   ;; python traceback:   File "app.py", line 12, in foo
   {:name :python :pattern "File \"([^\"]+)\", line (\\d+)" :file 1 :line 2 :col nil}
   ;; gcc / clang / mix / elixir / brood:   path:12:5: message
   {:name :gnu :pattern "([^\\s:()]*[^\\s:()\\d][^\\s:()]*):(\\d+):(\\d+)" :file 1 :line 2 :col 3}
   ;; the same without a column — ExUnit's `test/foo_test.exs:12`, mix warnings,
   ;; and every `file:line:` message whose next field is prose rather than a number
   {:name :gnu-line
    :pattern "([^\\s:()]*[^\\s:()\\d][^\\s:()]*):(\\d+)"
    :file 1
    :line 2
    :col nil}])

;; The file group is spelled `[^\s:()]*[^\s:()\d][^\s:()]*` — path characters, at
;; least one of which is not a digit — rather than a plain `[^\s:()]+`, so that a
;; bare `12:34:56` in a log is not read as line 34 of a file called `12`. The old
;; parser, which split on `:` and asked only whether the next field was numeric,
;; reported exactly that.

(defn- compile-parse-int (s)
  ;; `s` is a token scraped from compiler output — not reading as a number is the answer
  (check-allow :discarded-catch
    (try (let (v (reflect/read-string s)) (if (int? v) v nil)) (catch e nil))))

(defn- compile-group-text (match k)
  "The text of capture group `k` of `match`, or nil — for a group index that is
itself nil (a pattern with no column), and for a group that did not participate."
  (when k
    (let (g (nth (get match :groups) (dec k) nil))
      (when g (get g :text)))))

(defn- compile-loc-from (pattern line)
  "Apply one `*error-patterns*` row to `line`; returns `{:file :line :col}` or nil.
A row that matches but yields no usable file or line counts as no match, so the
next row still gets its turn."
  (let (m (regex/find (get pattern :pattern) line))
    (when m
      (let (file (compile-group-text m (get pattern :file))
            ln (compile-parse-int (compile-group-text m (get pattern :line))))
        (when (and file (> (string/length file) 0) ln)
          ;; a column the pattern does not capture is column 1, as it was
          {:file file :line ln :col (or (compile-parse-int (compile-group-text m (get pattern :col))) 1)})))))

(defn- compile-first-loc (patterns line)
  (when (not (empty? patterns))
    (or (compile-loc-from (first patterns) line) (compile-first-loc (rest patterns) line))))

(defn- compile-parse-error-line (line)
  "Parse a compiler error/warning location from `line` — the first `*error-patterns*`
row that matches it, or nil."
  (compile-first-loc *error-patterns* line))

(defn- compile-parse-errors (text)
  (seq/remove (map (string/split text "\n") compile-parse-error-line) nil?))

;; ---- buffer append (raw stream chunks, no forced newline) -------------------

(defn- compile-append (m text)
  (let (idx (ed-buffer-index-by-name m *compile-buf*))
    (if (nil? idx)
      (update m :buffers into [(ed-stamp (insert (model/ed-log-buffer *compile-buf*) text))])
      (update m
        :buffers assoc
        idx
        ;; *compilation* is read-only for the user; the stream unlocks per append
        (ed-append-end (nth (:buffers m) idx) text)))))

;; ---- reset the compilation buffer at the start of a new compile -------------

(defn- compile-reset (m cmd)
  "Clear `*compilation*`, write a header, and select it in the current pane. Stamped
`:compile-log`, which stacks the shared location-jump layer — RET or a click on a
`file:line[:col]:` error row visits it (C-x ` still walks them in order)."
  (let (header (str "-*- compilation: " cmd " -*-\n\n")
        fresh (ed-stamp (assoc (make-buffer header *compile-buf* nil)
                          :read-only true
                          :type :compile-log))
        idx (ed-buffer-index-by-name m *compile-buf*))
    (if (nil? idx)
      (ed-open-buffer m fresh)
      (let (existing (nth (:buffers m) idx))
        (ed-select (update m :buffers assoc idx (assoc fresh :dir (:dir existing))) idx)))))

;; *compilation* rows are GNU-style `file:line[:col]: message` — exactly the shared
;; parser's shape, so the stock location-jump layer is the whole integration.
(register-type-layers :compile-log
  (list 'results/location-jump-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- the compile worker process ---------------------------------------------
;; One long-lived process per editor session, registered as `:compile`.
;; `(spawn :compile (compile-loop))` is idempotent: returns the live handle if
;; the process is alive, or starts a fresh one if it died. Receives
;; `[:compile-run cmd root]` to start a compilation; stays alive between compiles.

(defn- compile-recv (proc)
  "Wait for proc messages after spawning `sh -c cmd`; forward chunks to the editor.
Messages from a superseded proc (wrong handle) are silently dropped so stale output
never bleeds into a fresh compilation. Handles `[:compile-run]` mid-flight to kill
the current proc and immediately restart — re-running compile never queues."
  (receive
    ([:proc p data] (do
                      (when (= p proc)
                        (send (proc/whereis :editor) (compile-output-event (ansi/strip data))))
                      (compile-recv proc)))
    ([:proc-err p data] (do
                          (when (= p proc)
                            (send (proc/whereis :editor) (compile-output-event (ansi/strip data))))
                          (compile-recv proc)))
    ([:proc-closed p code] (if (= p proc)
                             (do
                               (send (proc/whereis :editor) (compile-done-event code))
                               (compile-loop))
                             (compile-recv proc)))
    ([:compile-run cmd root] (do
                               (try
                                 (os/close proc)
                                 (catch e
                                   (log/warn (str "compile: close failed: " (error-message e)))))
                               (let (np (os/spawn "sh" ["-c" cmd] {:cwd root}))
                                 (compile-recv np))))
    ([:shutdown] (do
                   (try
                     (os/close proc)
                     (catch e (log/warn (str "compile: close failed: " (error-message e)))))
                   :compile-stopped))))

(defn- compile-loop ()
  "Idle — wait for the next `[:compile-run cmd root]` message. Compiles are minutes
apart (human-paced), so `hibernate` while idle: shrink the heap and drop the caches;
they rebuild on the next run. (Only here — `compile-recv` streams output and must
stay hot.)"
  (proc/hibernate)
  (receive
    ([:compile-run cmd root] (let (p (os/spawn "sh" ["-c" cmd] {:cwd root})) (compile-recv p)))
    ([:shutdown] :compile-stopped)))

;; ---- inbound async events (UiEvent records — see model.blsp) ----------------
;; The impls delegate to the named `ed-ev-*` fns so redefining one hot-swaps the
;; live editor (the impl body's global call resolves late, like a keymap binding).

(defrecord compile-output-event (text)) ; a chunk of compiler output
(defrecord compile-done-event (code)) ; the build's exit code
(impl UiEvent
  compile-output-event
  (ui-event-fold [e m textrows cols rows] (ed-ev-compile-output m e textrows cols rows)))
(impl UiEvent
  compile-done-event
  (ui-event-fold [e m textrows cols rows] (ed-ev-compile-done m e textrows cols rows)))

(defn ed-ev-compile-output (m event textrows cols rows)
  "Stream a chunk of compiler output into `*compilation*`."
  (ed-scroll (compile-append m (compile-output-event-text event)) textrows))

(defn ed-ev-compile-done (m event textrows cols rows)
  "Compilation finished: append a summary, parse errors, store on model."
  (let (code (compile-done-event-code event)
        idx (ed-buffer-index-by-name m *compile-buf*)
        text (when idx (buffer-text (nth (:buffers m) idx)))
        errors (if text (compile-parse-errors text) '())
        summary (if (= code 0)
                  "\nCompilation finished\n"
                  (str "\nCompilation exited with code " code "\n"))
        m1 (compile-append m summary)
        m2 (assoc m1 :compile-errors errors :compile-error-idx -1)
        echo (cond
               (= code 0) "Compilation finished"
               (empty? errors) (str "Compilation failed (exit " code ")")
               :else (str (count errors) " error(s)")))
    (ed-scroll (message m2 echo) textrows)))

;; ---- M-x compile ------------------------------------------------------------

(defn compile-run (m cmd)
  "Start `cmd` in the project root, streaming its output into `*compilation*` and
arming `next-error` over whatever locations it prints.

This is the body of `M-x compile` once the command is known, lifted out so it is
also what a non-Brood toolchain's test and run commands go through: \"stream a
subprocess and parse the file:line it prints\" is one behaviour, and Emacs reaches
it the same way — running `mix test` there is `M-x compile` with a different
command, not a second runner. It deliberately does NOT remember `cmd` as the
compile default; `M-x compile` records that itself, so running the tests does not
change what the next build offers."
  (let (root (or (:project-root m) (file/cwd))
        proc (spawn :compile (compile-loop))
        m2 (compile-reset m cmd))
    (send proc [:compile-run cmd root])
    (message (assoc m2 :compile-proc proc :compile-errors '() :compile-error-idx -1)
      (str "Running: " cmd))))

(defcommand cmd-compile
  (m key)
  "Run a shell command in the project root, streaming output to `*compilation*` (M-x compile).
The prompt is prefilled with what you last compiled here, else with what this
project's toolchain builds with — `mix compile` in a mix project, `cargo build` in a
cargo one — which is Emacs' buffer-local `compile-command` with projectile filling
it in, rather than the bare `make` that used to be every project's answer."
  (let (default (or (:compile-last-cmd m) (toolchain/compile-command m) "make"))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Compile command: " default)
         :on-complete (fn (m2 cmd) (assoc (compile-run m2 cmd) :compile-last-cmd cmd))})))

;; ---- M-x project-task -------------------------------------------------------

(defcommand cmd-project-task
  (m key)
  "Run one of this project's build-tool tasks (M-x project-task) — a `mix` task, a
script from a `package.json` — streaming it into `*compilation*`.

The list comes from the TOOL, the way `mix.el`'s `mix-execute-task` completes over
`mix help` rather than over a list someone typed into the editor: `mix help` includes
the tasks a project defines for itself, so `mix ecto.migrate` shows up in a project
that has Ecto and nowhere else."
  (let (tasks (toolchain/tasks m)
        label (toolchain/name-of m))
    (if (empty? tasks)
      (message m (str "no tasks to list for a " label " project"))
      (assoc m
        :minibuffer
          (ed-name-prompt (str label " task: ")
            tasks
            (fn (m2 task)
              (let (cmd (toolchain/task-command m2 task))
                (if (nil? cmd)
                  (message m2 (str "no way to run a task in a " label " project"))
                  (compile-run m2 cmd)))))))))

;; ---- next-error / previous-error (C-x ` · M-g n / M-g p) --------------------
;; One walk parameterised by `step` (±1) — the cursor into `:compile-errors` moves either
;; way, so the pair is Emacs' `next-error` / `previous-error` over the same parsed list.

(defn- compile-visit-error (m step)
  "Move the `:compile-error-idx` cursor by `step` (+1 next, -1 previous) and visit that
error's file/line, echoing `file:line`. A message-only no-op when there are no errors or
the cursor would run off the end."
  (let (errors (:compile-errors m)
        idx (+ step (or (:compile-error-idx m) -1)))
    (if (or (nil? errors) (empty? errors) (< idx 0) (>= idx (count errors)))
      (message m (if (or (nil? errors) (empty? errors)) "No compilation errors" "No more errors"))
      (let (err (nth errors idx)
            file (path/absolute (path/join (or (:project-root m) ".") (:file err)))
            line (:line err)
            m1 (assoc (ed-find-file m file) :compile-error-idx idx))
        (message (ed-apply m1
                   (fn (b)
                     (let (target (math/max 0 (math/min (dec line) (dec (buffer-line-count b)))))
                       (fold (range target) (beginning-of-buffer b) (fn (bb _) (forward-line bb))))))
          (str (:file err) ":" line))))))

(defcommand cmd-next-error
  (m key)
  "Jump to the next compiler error parsed from `*compilation*` (C-x ` / M-g n)."
  (compile-visit-error m 1))

(defcommand cmd-previous-error
  (m key)
  "Jump back to the previous compiler error (M-g p)."
  (compile-visit-error m -1))

(register-inverse 'compile/cmd-next-error 'compile/cmd-previous-error)
