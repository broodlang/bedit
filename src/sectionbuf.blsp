(defmodule sectionbuf
  "A **section buffer**: a read-only buffer whose text is a `section` tree, so
every such buffer folds and walks the same way — Magit's feel, once, for all of them.

The tree, the rendering's rows and the visibility live ON THE BUFFER (`:section-tree`,
`:section-rows`, `:section-vis`, and whatever the owner keeps in `:section-ctx`), not on
the model, so two section buffers can be open at once — a status, a log and a
commit beside it — and each answers \"what is at point?\" for itself.

What the buffer's MODE supplies, as services:

  - `:section-faces` — `(row line) -> [[from to face] …]`, the faces of one rendered line
    in line-relative columns. Colouring comes from what a line IS (its row), not from its
    text, so the layout can be as tight as Magit's without indentation to tell a diff line
    from a file line; the spans travel with the text as `:face-spans`.
  - `:section-reload` — `(model) -> model`, run when TAB opens a section whose children
    were never fetched (a status file whose diff is fetched only when it is looked at).
  - `:section-margin` — `(row) -> [[text face] …]` or nil, what a line shows in the
    buffer's RIGHT MARGIN (a log's author and age, Magit's margin): kept beside the text
    as `:right-margin`, so it stays at the window's edge however long the line is.
  - `:section-bands` — `(row line) -> face` or nil, a line's BACKGROUND across the whole
    text area (a diff's added and removed lines, a hunk heading's bar), kept as
    `:line-bands` and painted behind the text by the view.
  - `:section-link` — `(row ctx) -> {:file :line}` or nil, where a line goes when it is
    clicked or visited (`ctx` is the owner's `:section-ctx`), kept as `:line-links`.

A line is painted once per tree: TAB re-renders only the section it folds and splices its
lines into the buffer (`sb-splice`), and a line painted before answers from the buffer's
`:section-paint` cache — a fold, an unfold or a level calls no service for it.

The commands here are the ones every section buffer shares: TAB, `n`/`p`, `^`,
`M-n`/`M-p`, `1`–`4` and `M-w` (copy the value at point). A mode binds them in its keymap
next to its own."
  (:use clipboard)
  (:use model) ; ed-current-buf / ed-buf-at / ed-set-buf-at / ed-buffer-index-by-name / ed-apply / message
  (:use pool) ; ed-display-buffer / ed-goto-line
  (:use interactive) ; defcommand
  (:use editor/buffer) ; buffer-current-line / buffer-mark / region-line-range
  (:use editor/keymap :only [keymap-bind]) ; `sb-keymap`, the keys every section buffer shares
  (:use section))

;; ---- painting: what each line looks like ------------------------------------------
;; A line's PAINT is everything the mode's services say about it: its face spans
;; (line-relative), its background band, its right-margin segments and the location it links
;; to — `[spans band margin link]`, nil for a separator. A paint depends on the row and the
;; line only, so it is CACHED on the buffer (`:section-paint`), keyed by what makes a line
;; the line it is within one tree: its section's id, heading or body (and which body line),
;; folded or open. A fold, an unfold or a level (`1`–`4`) re-renders the same tree, and
;; every line it has painted before answers from the cache without calling a service; a new
;; tree (a refresh) starts a new cache, because the same id may now stand for other text.

(defn- buffer-services (buf ctx)
  "The mode's section services for `buf`, resolved once per render, with the owner's `ctx`."
  {:faces (ed-mode-service buf :section-faces)
   :bands (ed-mode-service buf :section-bands)
   :margin (ed-mode-service buf :section-margin)
   :link (ed-mode-service buf :section-link)
   :ctx ctx})

(defn- relative-spans (faces row line)
  "One line's face spans from the mode's `faces` service, line-relative. An empty span, or
one with no face, says nothing."
  (if (nil? faces)
    []
    (into []
      (seq/keep (faces row line)
        (fn (span) (let ([from to face] span) (when (and face (< from to)) [from to face])))))))

(defn- paint-line (services row line)
  "The `[spans band margin link]` of `line`, which `row` says is."
  (let (bands (:bands services)
        margin (:margin services)
        link (:link services))
    [(relative-spans (:faces services) row line)
      (when bands (bands row line))
      (when margin (margin row))
      (when link (link row (:ctx services)))]))

(defn- paint-key (row)
  "What makes a line the line it is within one tree: its section, heading or which body
line, and — a heading's text gains an ellipsis when folded with something to hide — whether it
is folded and has children."
  [(:id row) (:heading? row) (:line row) (:hidden? row) (:children? row)])

(defn- paint-lines (services rows lines cache)
  "`[paints cache]`: the paint of each of `lines` (parallel to `rows`), from `cache` where it
has one and from the services otherwise, and the cache with the new ones added."
  ;; The paints gather in a list, newest first, and become a vector once at the end: a `conj`
  ;; onto a vector copies it, so building one a line at a time cost O(lines²) — a root
  ;; commit's diff (every file in the repository) ran past 6 GB in one render.
  (let (n (count lines))
    (letrec (walk (fn (i paints cache)
                    (if (>= i n)
                      [(into [] (reverse paints)) cache]
                      (let (row (nth rows i nil))
                        (if (nil? row)
                          (walk (inc i) (cons nil paints) cache)
                          (let (key (paint-key row)
                                hit (get cache key))
                            (if (nil? hit)
                              (let (paint (paint-line services row (nth lines i)))
                                (walk (inc i) (cons paint paints) (assoc cache key paint)))
                              (walk (inc i) (cons hit paints) cache))))))))
      (walk 0 '() cache))))

(defn- assemble (paints lines line0 char0)
  "The paints of a run of `lines` laid onto the buffer from line `line0`, character `char0`:
`{:spans :bands :margin :links}` — the spans absolute, the rest keyed by line. Lines are
joined by one newline, so each starts one past the end of the one before."
  ;; The absolute spans gather newest first and become a vector once, as in `paint-lines`.
  (let (n (count lines))
    (letrec (walk (fn (i start spans bands margin links)
                    (if (>= i n)
                      {:spans (into [] (reverse spans)) :bands bands :margin margin :links links}
                      (let (paint (nth paints i)
                            line (+ line0 i)
                            next (+ start (count (nth lines i)) 1))
                        (if (nil? paint)
                          (walk (inc i) next spans bands margin links)
                          (let ([relative band segments link] paint)
                            (walk (inc i)
                              next
                              (fold relative
                                spans
                                (fn (acc span)
                                  (cons [(+ start (first span))
                                          (+ start (second span))
                                          (nth span 2)]
                                    acc)))
                              (if (nil? band) bands (assoc bands line band))
                              (if (nil? segments) margin (assoc margin line segments))
                              (if (nil? link) links (assoc links line link)))))))))
      (walk 0 char0 '() {} {} {}))))

(defn- segments-width (segments)
  "The cells `[[text face] …]` takes on screen."
  (fold segments 0 (fn (n segment) (+ n (string/display-width (first segment))))))

(defn- with-paint (buf services parts)
  "`buf` carrying assembled `parts` where the view reads them: `:face-spans`, `:line-bands`
(`{line face}`), `:right-margin` (`{:width :lines}`, as wide as its widest line) and, when the
mode links lines somewhere (`:section-link`), `:line-links`. An empty band or margin table is
nil, which is what a buffer without them carries."
  (let (bands (:bands parts)
        margin (:margin parts)
        painted (assoc buf
                  :face-spans (:spans parts)
                  :line-bands (if (empty? bands) nil bands)
                  :right-margin
                    (if (empty? margin)
                      nil
                      {:width (reduce (map (vals margin) segments-width) math/max)
                       :lines margin})))
    (if (:link services) (assoc painted :line-links (:links parts)) painted)))

(defn sb-render (tree vis faces &optional (bands nil))
  "`{:text :rows :spans :bands :extents}` for section `tree` under visibility `vis`, coloured by
`faces` (a `:section-faces` service, or nil) and `bands` (a `:section-bands` one). Pure:
what a test asserts against."
  (let (r (section-render tree vis)
        [paints _] (paint-lines {:faces faces :bands bands} (:rows r) (:lines r) {})
        parts (assemble paints (:lines r) 0 0))
    {:text (section-text r)
     :rows (:rows r)
     :extents (:extents r)
     :spans (:spans parts)
     :bands (if (empty? (:bands parts)) nil (:bands parts))}))

;; ---- line kinds: how a long line shows ----------------------------------------------
;; A section buffer's lines are of two kinds, and a long one of each wants a different
;; treatment: a HEADING (a file, a commit, a stash, a ref — a row of a list) is read down the
;; list, so it keeps to one row and ends in an ellipsis, while a section's BODY (a hunk's
;; code, a commit message) is read across, so it wraps. The buffer says which line is which
;; (`:line-kinds`, a vector parallel to its lines) and `scroll/ed-long-lines` gives each kind
;; the policy the user's `:long-lines` setting does — `:section-heading` / `:section-body`.

(defn row-kinds (rows)
  "The `:line-kinds` of a section buffer whose lines are `rows`: `:section-heading` for a
heading line, `:section-body` for a body line, nil for a separator.

    (sectionbuf/row-kinds [{:heading? true} {:heading? false} nil])   ;=> [:section-heading :section-body nil]"
  (into []
    (map rows
      (fn (row)
        (cond
          (nil? row) nil
          (:heading? row) :section-heading
          else :section-body)))))

(defn- with-rows (buf rows)
  "`buf` holding `rows` as its `:section-rows`, and the line kinds they make (`row-kinds`)."
  (assoc buf :section-rows rows :line-kinds (row-kinds rows)))

;; ---- rendering onto a buffer ----------------------------------------------------

(defn- sb-target-line (line rows old-line)
  ;; Where point goes, 1-based and clamped to the rows: `line` (a number, or `(rows -> line)`
  ;; resolved against the new rows), else the line point was on, else the top.
  (let (target (cond
                 (fn? line) (line rows)
                 (int? line) line
                 (int? old-line) (inc old-line)
                 else 1))
    (math/max 1 (math/min target (math/max 1 (count rows))))))

(defn- show-tree (m name tree type opts cache)
  "`sb-show`, painting from `cache` — the buffer's own when the tree is the one it already
shows (a fold, a level), `{}` for a tree that is new."
  (let (old-i (ed-buffer-index-by-name m name)
        old (if (nil? old-i) nil (ed-buf-at m old-i))
        old-line (if (and old (= old-i (ed-current-index m)))
                   (buffer-current-line (ed-current-buf m))
                   nil)
        vis (or (:vis opts) (and old (:section-vis old)) {})
        ctx (if (contains? opts :ctx) (:ctx opts) (and old (:section-ctx old)))
        r (section-render tree vis)
        m1 (ed-display-buffer m
             name
             ;; ending in a newline, as Magit's buffers do: the bottom (M->, the last C-v) is an
             ;; empty line at column 0, not the end of a long last line scrolled sideways
             (str (section-text r) "\n")
             type
             {:action (:action opts :here) :keep-scroll (not (nil? old))})
        i (ed-buffer-index-by-name! m1 name)
        placed (ed-buf-at m1 i)
        ;; the services are the MODE's, asked of the buffer now that it has one
        services (buffer-services placed ctx)
        [paints painted-cache] (paint-lines services (:rows r) (:lines r) cache)
        m2 (ed-set-buf-at m1
             i
             (with-rows (assoc (with-paint placed services (assemble paints (:lines r) 0 0))
                          :section-paint painted-cache
                          :section-tree tree
                          :section-extents (:extents r)
                          :section-vis vis
                          :section-ctx ctx)
               (:rows r))))
    (if (= (ed-current-index m2) i)
      (ed-apply m2 (fn (b) (ed-goto-line b (sb-target-line (:line opts) (:rows r) old-line))))
      m2)))

(defn sb-show (m name tree type &optional (opts {}))
  "Show section `tree` as buffer `name` of `type` and return the model with it placed
(`:action` in `opts`: `:here` (default), `:pop` or `:display`, as `ed-display-buffer`).

Visibility is the buffer's own from its last render unless `opts` gives `:vis`, so a
refresh keeps what the reader had open. `:ctx` is stored as the buffer's `:section-ctx`
(the owner's data: a repo root, a revision). `:line` places point — a 1-based number, or
`(rows -> line)` resolved against the new rows; without it point stays on the line it was
on, or goes to the top of a new buffer."
  (show-tree m name tree type opts {}))
(sig sb-show (model string any any &optional map -> model))

(defn sb-rerender (m &optional (vis nil))
  "Re-render the CURRENT section buffer from its stored tree — a fold, a level — keeping
point on its line. No fetch: the tree is already here, and so is every line it painted
(`:section-paint`)."
  (let (b (ed-current-buf m))
    (if (nil? (:section-tree b))
      m
      (show-tree m
        (buffer-name b)
        (:section-tree b)
        (:type b)
        {:vis (or vis (:section-vis b))}
        (or (:section-paint b) {})))))
(sig sb-rerender (model &optional any -> model))

;; ---- re-rendering ONE section in place -----------------------------------------
;; TAB changes one section's lines and nothing else, so it re-renders that section alone and
;; splices its lines into the buffer: the rope, the rows, the extents, the spans, the bands,
;; the margin and the links each take the new lines in place of the old and move whatever
;; came after by the difference. A file of a thousand diff lines folds without the rest of
;; the status being rendered, joined, painted or re-read.

(defn- first-span-from (spans position)
  "The index of the first of `spans` (absolute, ascending by start) starting at or after
`position`."
  (letrec (search (fn (lo hi)
                    (if (>= lo hi)
                      lo
                      (let (mid (math/quot (+ lo hi) 2))
                        (if (< (first (nth spans mid)) position)
                          (search (inc mid) hi)
                          (search lo mid))))))
    (search 0 (count spans))))

(defn- splice-spans (spans lo-char hi-char delta added)
  "`spans` with those starting in `[lo-char hi-char)` replaced by `added` and those after
moved by `delta` characters."
  (let (spans (or spans [])
        a (first-span-from spans lo-char)
        b (first-span-from spans hi-char))
    (into (into (seq/subvec spans 0 a) added)
      (map (seq/subvec spans b (count spans))
        (fn (span) [(+ (first span) delta) (+ (second span) delta) (nth span 2)])))))

(defn- splice-lines (table lo hi delta added)
  "A line-keyed `table` with the lines `[lo hi)` replaced by `added` and those after moved by
`delta` lines."
  (merge (fold (or table {})
           {}
           (fn (acc entry)
             (let ([line value] entry)
               (cond
                 (< line lo) (assoc acc line value)
                 (>= line hi) (assoc acc (+ line delta) value)
                 else acc))))
    added))

(defn- within? (id ancestor)
  "Whether section `id` is `ancestor` or inside it."
  (and (>= (count id) (count ancestor)) (= (seq/subvec id 0 (count ancestor)) ancestor)))

(defn- splice-extents (extents id hi delta added)
  "The extents with section `id`'s own (and everything inside it) replaced by `added`, the
sections after it moved by `delta` lines and the ones around it grown by it."
  (merge (fold extents
           {}
           (fn (acc entry)
             (let ([other [start end]] entry)
               (cond
                 (within? other id) acc
                 (>= start hi) (assoc acc other [(+ start delta) (+ end delta)])
                 (>= end hi) (assoc acc other [start (+ end delta)])
                 else (assoc acc other [start end])))))
    added))

(defn- forget-paint (cache id)
  "`cache` without the paints of section `id` and everything inside it — what a section
REPLACED by another value must not answer from, since the same ids may now be other text."
  (fold cache
    {}
    (fn (acc entry)
      (let ([key paint] entry) (if (within? (first key) id) acc (assoc acc key paint))))))

(defn- splice-buffer (b id tree vis replaced?)
  "Buffer `b` with section `id` of `tree` re-rendered under `vis` and spliced over the lines
it covered — `replaced?` when the section is a new value rather than the same one folded, so
its old paints are forgotten. A section with no lines on screen (inside a folded one) changes
only the tree. Nil when the section cannot be found to splice (the caller renders the whole
tree instead)."
  (let (rows (:section-rows b)
        extent (get (or (:section-extents b) {}) id)
        head (when rows (section-heading-index rows id))
        s (section-at tree id)
        known (if replaced? (forget-paint (or (:section-paint b) {}) id) (or (:section-paint b) {})))
    (cond
      (or (nil? rows) (nil? s)) nil
      (nil? extent) (assoc b :section-tree tree :section-vis vis :section-paint known)
      (nil? head) nil
      else
        (let ([lo hi] extent
              r (section-render-section s (section-parent-id id) (:depth (nth rows head)) vis lo)
              lines (:lines r)
              services (buffer-services b (:section-ctx b))
              [paints cache] (paint-lines services (:rows r) lines known)
              rope (buffer-rope b)
              lo-char (text/line->char rope lo)
              hi-char (text/line->char rope hi)
              replacement (str (string/join lines "\n") "\n")
              line-delta (- (count lines) (- hi lo))
              char-delta (- (count replacement) (- hi-char lo-char))
              parts (assemble paints lines lo lo-char)
              point (buffer-point b)
              spliced (mark-buffer-saved (assoc b
                                           :rope
                                             (text/insert (text/delete rope lo-char hi-char)
                                               lo-char replacement)
                                           :point
                                             (cond
                                               (< point lo-char) point
                                               (>= point hi-char) (+ point char-delta)
                                               else lo-char)
                                           :mark nil)))
          (with-rows (assoc (with-paint spliced
                              services
                              {:spans (splice-spans (:face-spans b)
                                        lo-char
                                        hi-char
                                        char-delta
                                        (:spans parts))
                               :bands (splice-lines (:line-bands b) lo hi line-delta (:bands parts))
                               :margin (splice-lines (get (:right-margin b) :lines)
                                         lo
                                         hi
                                         line-delta
                                         (:margin parts))
                               :links (splice-lines (:line-links b) lo hi line-delta (:links parts))})
                       :section-paint cache
                       :section-tree tree
                       :section-extents
                         (splice-extents (:section-extents b) id hi line-delta (:extents r))
                       :section-vis vis)
            (into (into (seq/subvec rows 0 lo) (:rows r)) (seq/subvec rows hi (count rows))))))))

(defn sb-splice (m i id tree vis &optional (replaced? true))
  "Pool buffer `i` (a section buffer) with section `id` of `tree` re-rendered under `vis` in
place — its lines alone, everything else moved rather than redrawn. `tree` is the buffer's
tree with that section REPLACED (a diff fetched later, a log that landed) unless `replaced?`
is false (the same tree, a fold). Falls back to rendering the whole tree when the section
cannot be spliced."
  (let (b (ed-buf-at m i)
        spliced (splice-buffer b id tree vis replaced?))
    (if (nil? spliced)
      (show-tree m
        (buffer-name b)
        tree
        (:type b)
        {:vis vis :action (if (= i (ed-current-index m)) :here :none)}
        (if replaced? {} (or (:section-paint b) {})))
      (ed-set-buf-at m i spliced))))
(sig sb-splice (model int vector map map &optional any -> model))

;; ---- asking the buffer ------------------------------------------------------------

(defn sb-rows (m)
  "The current buffer's section rows, or nil when it is not a section buffer."
  (:section-rows (ed-current-buf m)))

(defn sb-ctx (m)
  "The current section buffer's owner data (`:section-ctx`), or nil."
  (:section-ctx (ed-current-buf m)))

(defn sb-line (m)
  "The 0-based line point is on."
  (buffer-current-line (ed-current-buf m)))

(defn sb-at (m)
  "The section row on point's line, or nil."
  (let (rs (sb-rows m)) (if (nil? rs) nil (section-row rs (sb-line m)))))

(defn sb-ancestor (m type)
  "The row of the nearest enclosing section of `type` at point (point's own included)."
  (let (rs (sb-rows m)) (if (nil? rs) nil (section-ancestor rs (sb-line m) type))))

(defn sb-region-lines (m)
  "`[first last]` 0-based lines of the active region, or nil when there is none."
  (let (b (ed-current-buf m))
    (if (nil? (buffer-mark b)) nil (region-line-range b))))

(defn sb-region-rows (m)
  "The rows of the lines the region covers, or nil when there is no region."
  (let (lines (sb-region-lines m) rs (sb-rows m))
    (if (or (nil? lines) (nil? rs))
      nil
      (let ([a z] lines) (map (range a (inc z)) (fn (i) (section-row rs i)))))))

;; ---- moving -----------------------------------------------------------------------

(defn- goto (m i)
  "Point to 0-based line `i` when it is a line, else say there is nowhere to go."
  (if (int? i) (ed-apply m (fn (b) (ed-goto-line b (inc i)))) m))

;; check-allow: `fallback` is the calling command's own `(model) -> model` — a next-line, or
;; identity — so the checker cannot see what that branch returns; the declaration is the
;; contract (ADR-341's `:trusted`).
(check-allow :trusted
  (sig move (model any any -> model))
  (defn- move (m f fallback)
    "Move by section function `f`, or run `fallback` outside a section buffer."
    (let (rs (sb-rows m))
      (if (nil? rs) (fallback m) (goto m (f rs (sb-line m)))))))

(defcommand cmd-section-next
  (m key)
  "The next section heading (n) — a file, a hunk, a commit."
  (move m section-next (fn (mm) (motion/cmd-next-line mm key))))

(defcommand cmd-section-prev
  (m key)
  "The previous section heading (p)."
  (move m section-prev (fn (mm) (motion/cmd-previous-line mm key))))

(defcommand cmd-section-up
  (m key)
  "The heading of the section point is in, or of its parent when point is on one (^)."
  (move m section-up (fn (mm) mm)))

(defcommand cmd-section-next-sibling
  (m key)
  "The next section at this level (M-n) — the next file, skipping its hunks."
  (move m section-next-sibling (fn (mm) mm)))

(defcommand cmd-section-prev-sibling
  (m key)
  "The previous section at this level (M-p)."
  (move m section-prev-sibling (fn (mm) mm)))

;; ---- folding ----------------------------------------------------------------------

;; check-allow: `reload` is the MODE's `:section-reload` service, resolved late by
;; `ed-mode-service`, so its result is opaque here; every mode that declares one declares a
;; `(model) -> model`.
(check-allow :trusted
  (sig sb-toggle (model -> model))
  (defn sb-toggle (m)
    "Fold or unfold the section at point. A section that has never been FILLED (`:lazy?` on
its heading row: a status file whose diff is fetched only when opened) asks the mode's
`:section-reload` to fetch it; everything else re-renders that one section in place
(`sb-splice`), with point on its heading."
    (let (row (sb-at m)
          b (ed-current-buf m)
          i (ed-current-index m))
      (if (nil? row)
        m
        (let (vis (section-toggle (:section-vis b) row)
              head (section-heading-index (:section-rows b) (:id row))
              reload (ed-mode-service b :section-reload)
              lazy? (and (:heading? row)
                      (:hidden? row)
                      (not (:children? row))
                      (= true (map/get-in row [:value :lazy?]))))
          (cond
            (and lazy? reload)
              (let (m1 (ed-set-buf-at m i (assoc (ed-buf-at m i) :section-vis vis)))
                (reload (if (nil? head) m1 (goto m1 head))))
            ;; a section with no heading of its own always shows its body: nothing to redraw
            (nil? head) (ed-set-buf-at m i (assoc (ed-buf-at m i) :section-vis vis))
            else (goto (sb-splice m i (:id row) (:section-tree b) vis false) head)))))))

(defcommand cmd-section-toggle
  (m key)
  "Fold or unfold the section at point (TAB)."
  (sb-toggle m))

(defn- show-level (m level)
  "Show the current buffer's tree to `level` (Magit's `1`–`4`)."
  (let (tree (:section-tree (ed-current-buf m)))
    (if (nil? tree) m (sb-rerender m (section-level-visibility tree level)))))

(defcommand cmd-section-level-1 (m key) "Only the top-level headings (1)." (show-level m 1))
(defcommand cmd-section-level-2 (m key) "Open the top level (2) — the files." (show-level m 2))
(defcommand cmd-section-level-3 (m key) "Open two levels (3) — the hunks." (show-level m 3))
(defcommand cmd-section-level-4 (m key) "Open everything (4)." (show-level m 4))

;; ---- copying ----------------------------------------------------------------------

(defn sb-value-text (v)
  "The text `M-w` copies for a section value: a commit's hash, a file's path, a ref's
name, or the value itself when it is a string."
  (cond
    (string? v) v
    (map? v) (or (:hash v) (:ref v) (:path v) (:name v))
    else nil))

(defcommand cmd-section-copy
  (m key)
  "Copy the value of the section at point (M-w): a commit's hash, a file's path. With a
region, copy the region as usual."
  (let (row (sb-at m)
        text (if (nil? row) nil (sb-value-text (:value row))))
    (cond
      (not (nil? (sb-region-lines m))) (killing/cmd-copy-region m key)
      (nil? text) (killing/cmd-copy-region m key)
      else (message (ed-push-kill m text true) (str "copied " text)))))

(defn sb-keymap ()
  "The keys every section buffer has, for a mode to build its own keymap on: TAB folds the
section at point, `n`/`p` walk the headings, `^` climbs to the parent, `M-n`/`M-p` step
between siblings, `1`–`4` show the tree to a depth and `M-w` copies the value at point."
  (-> {}
    (keymap-bind [:tab] 'sectionbuf/cmd-section-toggle)
    (keymap-bind ["n"] 'sectionbuf/cmd-section-next)
    (keymap-bind ["p"] 'sectionbuf/cmd-section-prev)
    (keymap-bind ["^"] 'sectionbuf/cmd-section-up)
    (keymap-bind [:alt-n] 'sectionbuf/cmd-section-next-sibling)
    (keymap-bind [:alt-p] 'sectionbuf/cmd-section-prev-sibling)
    (keymap-bind ["1"] 'sectionbuf/cmd-section-level-1)
    (keymap-bind ["2"] 'sectionbuf/cmd-section-level-2)
    (keymap-bind ["3"] 'sectionbuf/cmd-section-level-3)
    (keymap-bind ["4"] 'sectionbuf/cmd-section-level-4)
    (keymap-bind [:alt-w] 'sectionbuf/cmd-section-copy)))
