(defmodule pool
  "The buffer pool and where its buffers are shown — the API most of the editor needs
from `commands` without needing a single command: open / select / kill a pool buffer,
upsert a named report buffer and hand it to the window manager (`ed-display-buffer`, the
Emacs `display-buffer` analog), pop to a file or buffer at a line in another pane
(`ed-pop-to-file`, the `next-error` discipline), find-file and its path prompt, the
default directory and project root. Saving is `file-save`.

A feature module (git, the BEAM views, the test runner, …) depends on the pool without
depending on every keystroke's command. `commands` builds on this module, never the
reverse: the two things find-file needs from above it — the hex view of a binary
(`hexl`) and a directory listing (`dired`) — are reached by qualified name."
  (:use interactive) ; defcommand — C-x k lives with the kill it runs
  (:use editor/buffer) ; make-buffer / point motion
  (:use editor/buffer-file) ; find-file-buffer / save-buffer
  (:use editor/pane) ; pane-leaf-paths / pane-split / pane-update-path — where a buffer goes
  (:use filename) ; expand / as-input / shadow-end — a typed path read the Emacs way
  (:use mincomplete) ; ed-complete-name / ed-complete-path / path candidates — the prompts
  (:use projects) ; project-root / file-display-name / remember-* — the project a file is in
  (:use sidecar) ; a saved file's sidecar removed
  (:use hosted :only []) ; hosted-key / hosted-rekey-slot — a moved file's shared copy follows it
  (:use display-rules) ; the rules, their defaults, an action read
  (:use charset :only [label]) ; a file's coding: loaded with the pool, as a release needs
  (:use minibuffer)
  (:use model)) ; the pool + layout accessors, ed-stamp, message, ed-mb-edit
;; editor/layers (close hooks, buffer types) and text (line->char) are referenced qualified
;; below and auto-load.

(defn ed-name-prompt (prompt names on-complete &optional (limit 20) (recent []))
  "A Vertico minibuffer spec that completes input against a fixed `names` list — Tab to
the common prefix, a fuzzy candidate list (top `limit`) — and runs `on-complete`
(`(model text) -> model`) on the accepted entry. The shared shape behind M-x,
switch-buffer, recentf, describe-function, and bookmark-jump. `recent` (a most-recent-first
list, default none) floats its entries to the top on empty input via the shared
`projects/float-recent` — the same recency any completion opts into (see `recent-commands`) —
and, once something is typed, ranks them above equally good matches (`projects/history-boost`,
the fuzzy ranking's `:boost`)."
  {:edit (ed-mb-edit prompt "")
   :on-complete on-complete
   :complete-fn (fn (t) (ed-complete-name t names))
   :rank-source (projects/float-recent names recent) ; recents first, then fuzzy-narrowed on typing
   :rank-cap limit
   :rank-boost (if (empty? recent) nil (projects/history-boost recent))
   :accept-selection true})

(defn ed-large-file-size (path threshold)
  "The size of the file at `path` when it is over `threshold` bytes — a file to ask about
before reading it — else nil: within it, missing, a directory, or `threshold` 0 (never ask)."
  (let (size (file/size path))
    (when (and (> threshold 0) (int? size) (> size threshold) (not (file/dir? path))) size)))

(defn ed-file-of-spec (spec)
  "The file a path the user typed names: `spec` itself, or what its file handler says it names,
so a file reached through a handler is asked about by its size as a plain one is.

    (pool/ed-file-of-spec \"/home/me/a.txt\")   ;=> \"/home/me/a.txt\""
  (let (handler (ed-path-handler spec))
    (if (nil? handler) spec (ed-handler-call handler :file-of spec spec))))

(defn ed-large-file-question (m path)
  "The question to ask before opening `path`, or nil to open it at once: nil when it is
already open, or not large ([[ed-large-file-size]] against `:large-file-warning-threshold` on
the model, else `config/*large-file-warning-default*`)."
  (let (size (ed-large-file-size (ed-file-of-spec path)
               (or (:large-file-warning-threshold m) config/*large-file-warning-default*)))
    (when (and size (nil? (ed-buffer-index-by-file m (path/normalize (path/absolute path)))))
      (str "File "
        (path/basename path)
        " is large ("
        (humanize/byte-size size)
        "), really open? (y or n)"))))

;; check-allow: `open` is caller-supplied, so the checker cannot see what it returns (ADR-341's
;; `:trusted`, as `lifecycle/ed-map-y-or-n`).
(check-allow :trusted
  (sig ed-visit-file (model string &optional any -> model))
  (defn ed-visit-file (m path &optional (open nil))
    "Open `path` as a person asked to — the find-file prompt, dired's RET, a recent or project
file, embark's open: `open` (a `(model path) -> model`, [[ed-find-file-soon]] by default — a large
file read off the loop; C-x 4 f
passes its other-window one), after asking first when the file is large
([[ed-large-file-question]]). A caller that goes on to act on the buffer it opened (a jump,
an edit a language server sent) calls `ed-find-file` itself, since a question would leave
it acting on whichever buffer was current."
    (let (opener (or open ed-find-file-soon)
          question (ed-large-file-question m path))
      (if (nil? question)
        (opener m path)
        (ed-confirm m question (fn (mm) (opener mm path)) "not opened")))))

(defn- file-truename (path)
  "The real path of the file `path` names, links followed, or nil when there is no such file.
Emacs's `file-truename`."
  (when (file/exists? path)
    (let (real (check-allow :discarded-catch (try (os/canonicalize path) (catch _ nil))))
      (when (string? real) real))))

(defn- ed-buffer-index-by-truename (m path)
  "The pool index of a buffer visiting the file `path` is really (Emacs's
`find-file-existing-other-name`): the two names of a symlink are one file, and two buffers
on it would each save over the other. nil when none is. A buffer a file handler owns is
another buffer on purpose: the same file reached another way."
  (let (truename (file-truename path))
    (when truename
      (let (i (seq/index-where (:buffers m)
                (fn (buffer)
                  (let (file (buffer-file buffer))
                    (and file (nil? (ed-buffer-handler buffer)) (= (file-truename file) truename))))))
        (if (< i 0) nil i)))))

(defn ed-read-file (path)
  "The file at `path`, read ONCE: `{:text :coding}` when it is text (`charset/detect`, which
reads the charset its `.editorconfig` declares), else `{:bytes}`
(a binary, for the hex view): the decode that tells text from a binary is the text the buffer
is built from. Raises when the file cannot be read."
  (let (bytes (file/slurp-bytes path)
        declared (editorconfig/declared-charset path))
    (or (charset/detect bytes declared) {:bytes bytes})))

;; ---- a large file read off the loop -----------------------------------------------
;; Reading and decoding a file of many megabytes (`ed-read-file`: the bytes, the charset
;; detection, the UTF-8 decode) is seconds on a slow disk, so a person's visit of one
;; ([[ed-find-file-soon]], what `ed-visit-file` opens with) shows a read-only `Loading…` buffer
;; at once ([[file-loading-buffer]], as a file opened as root does) and reads in a task
;; (`:read-proc`, its job on `:read-job`); the file replaces the placeholder in every pane
;; showing it when it lands ([[ed-apply-read]]). One read at a time, the rest waiting on
;; `:read-waiting`. Killing a placeholder cancels its read; C-g cancels them all. The
;; large-file QUESTION (`ed-large-file-question`, 10 MB) is asked before any of this.

(defdyn *read-off-loop-bytes* (* 2 1000 1000))
;; A file over this many bytes is read off the loop by a person's visit; 0 reads every file
;; there.

(defdyn *read-off-loop* nil)
;; Whether a large read runs in a task: nil follows the loop (off it when there is one,
;; `model/ed-headless?`; inline in a test). A test binds true to see the `Loading…` buffer, and
;; folds the reply itself ([[ed-apply-read]]).

(defn file-loading-buffer (path name &optional (mark :file-loading))
  "The buffer a file read off the loop shows until its text lands: `Loading…`, read-only,
named `name` and with no file of its own (so no other buffer or frame takes it for the file) —
`mark` (`:file-loading`; a root read's is `:sudo-loading`) names the path.

    (:file-loading (pool/file-loading-buffer \"/var/log/big.log\" \"big.log <loading>\"))   ;=> \"/var/log/big.log\""
  (assoc (set-read-only (make-buffer "Loading…\n" name) true) mark path))

(defn ed-loading-index (m path)
  "The pool index of the `Loading…` buffer a read of `path` shows ([[file-loading-buffer]]), or nil."
  (let (index (seq/index-where (:buffers m) (fn (buffer) (= (:file-loading buffer) path))))
    (if (< index 0) nil index)))

(defn- read-off-loop? ()
  (if (nil? *read-off-loop*) (not (ed-headless?)) *read-off-loop*))

(defn large-read? (path)
  "Whether `path` is a plain file big enough to read off the loop (over
`*read-off-loop-bytes*`)."
  (and (not (file/dir? path)) (int? (ed-large-file-size path *read-off-loop-bytes*))))

;; check-allow: `thunk` is the caller's; its result is handed back as it is
(check-allow :trusted
  (defn reading-off-loop (thunk)
    "`(thunk)` with a large file's read sent OFF the loop although no loop runs yet — what the
editor's startup opens its files under: the loop starts in this process next, so the read's
answer lands in its mailbox."
    (binding (*read-off-loop* true) (thunk))))

;; check-allow: `then` is the caller's continuation (a jump's go-to-line), whose result the
;; checker cannot see; every caller hands one that answers a model
(check-allow :trusted
  (sig ed-find-file-soon (model string &optional any -> model))
  (defn ed-find-file-soon (m path &optional (then nil))
    "Open `path` as [[ed-find-file]] does, but a plain file over `*read-off-loop-bytes*` is read
OFF the loop: a read-only `Loading…` buffer is shown at once, and the file takes its place when
read. A file already open, or already loading, is selected; any other path is opened at once.
Headless — a test — it all runs inline.

`then`, a `(fn (m index) …)`, is what the caller does with the file once it is open — a jump
going to its line ([[ed-find-file-then]]): called at once with the current index when the
file opened now, and with the file's pool index when a read off the loop lands (not when it
fails or is cancelled, nor for a file that was already loading: the first open's stands)."
    (let (absolute (when (not (string/blank? path)) (path/normalize (path/absolute path)))
          loading (when absolute (ed-loading-index m absolute))
          now (fn (opened) (if (nil? then) opened (then opened (ed-current-index opened)))))
      (cond
        (or (nil? absolute) (ed-path-handler path)) (now (ed-find-file m path))
        (ed-buffer-index-by-file m absolute) (now (ed-find-file m path))
        (int? loading) (ed-select m loading)
        (or (not (read-off-loop?)) (not (large-read? absolute))) (now (ed-find-file m path))
        else
          (ed-read-launch (ed-open-buffer m (file-loading-buffer absolute (loading-name absolute)))
            absolute then)))))

(defn- loading-name (path) (str (path/basename path) " <loading>"))

(defn ed-find-file-then (m path step)
  "Open `path` ([[ed-find-file-soon]], so a large file is read off the loop) and apply `step`
(a `buffer -> buffer`: a go-to-line, a go-to-position) to the file's buffer — now, or when its
read lands. What a jump to a location (an LSP definition, a compile error) opens with: the
editor answers at once, and point lands on the line once the file is there."
  (ed-find-file-soon m
    path
    (fn (opened index) (ed-set-buf-at opened index (step (ed-buf-at opened index))))))

(defn- read-work (path)
  ;; the read task: `ed-read-file`'s answer, or `{:error reason}` — never raises
  (try (ed-read-file path) (catch failure {:error (error-message failure)})))

(defn- ed-read-launch (m path then)
  ;; the read of `path` started, or put behind the one that is out; `then` runs when it lands
  (if (:read-proc m)
    (message (assoc m :read-waiting (conj (or (:read-waiting m) []) {:path path :then then}))
      (str "loading " path " after the file being read"))
    (assoc (message m (str "Loading " path "… (C-g stops)"))
      :read-proc (task/task (fn () (read-work path)))
      :read-job {:path path :then then})))

(defn- ed-read-pump (m)
  ;; the next read waiting launched, passed over when its `Loading…` buffer was killed
  (let (waiting (or (:read-waiting m) []))
    (if (or (:read-proc m) (empty? waiting))
      m
      (let (entry (first waiting)
            rest-m (if (= 1 (count waiting))
                     (dissoc m :read-waiting)
                     (assoc m :read-waiting (vec (rest waiting)))))
        (if (nil? (ed-loading-index rest-m (:path entry)))
          (ed-read-pump rest-m)
          (ed-read-launch rest-m (:path entry) (:then entry)))))))

(defn- ed-read-landed (m path placeholder answer)
  "The file `path` read (`answer`, [[read-work]]'s) opened in place of its `Loading…` buffer:
every pane showing that buffer shows the file, the rest of the layout as it was — a read that
lands while you are in another buffer does not take you away from it — and the placeholder
goes. A read that failed is said, and the placeholder (pool index `placeholder`) goes too."
  (let (before (ed-current-index m)
        opened (ed-find-file-with m path answer)
        index (ed-current-index opened)
        echo (:echo opened)
        ;; the file opened (or was open already) unless the open failed and left the selection
        shown (if (= index before)
                opened
                (ed-map-panes (assoc opened :layout (:layout m))
                  (fn (window)
                    (if (= (:buffer window) placeholder)
                      (assoc window
                        :buffer index
                        :top (ed-top-showing opened index)
                        :point nil
                        :mark nil)
                      window))))
        killed (ed-kill-buffer-at shown placeholder))
    ;; the open said, not the kill of the placeholder
    (message killed echo)))

(defn ed-apply-read (m answer)
  "Fold a large file's read (`answer`, [[read-work]]'s; nil when its task failed) into the
model — the file in place of its `Loading…` buffer, or why not — then the next read waiting."
  (let (job (:read-job m)
        rest-m (dissoc m :read-proc :read-job)
        path (:path job)
        placeholder (when path (ed-loading-index rest-m path)))
    (ed-read-pump (cond
                    (nil? job) rest-m
                    (not (int? placeholder)) (message rest-m (str "opening " path " cancelled"))
                    (nil? answer)
                      (message (ed-kill-buffer-at rest-m placeholder)
                        (str "open failed: reading " path " did not finish"))
                    else
                      (let (landed (ed-read-landed rest-m path placeholder answer)
                            index (ed-buffer-index-by-file landed path)
                            then (:then job))
                        (if (or (nil? then) (nil? index)) landed (then landed index)))))))

(defn ed-read-quit (m)
  "C-g's clean-up for a large read (its task already killed): its `Loading…` buffer goes, and
so do those of the reads waiting."
  (let (paths (into (if (:read-job m) [(:path (:read-job m))] [])
                (map (or (:read-waiting m) []) :path))
        dropped (fold paths
                  (dissoc m :read-job :read-waiting)
                  (fn (acc path)
                    (let (index (ed-loading-index acc path))
                      (if (nil? index) acc (ed-kill-buffer-at acc index))))))
    (if (empty? paths)
      dropped
      (ed-quit-note dropped (str "loading " (string/join paths ", ") " stopped")))))

(defn ed-read-cancel-killed (m killed)
  "`m` with the read behind a killed `Loading…` buffer cancelled — its task stopped, so the
file does not open after all. Any other kill leaves it as it is."
  (let (loading (when (:read-proc m) (:file-loading (ed-buf-at m killed))))
    (if (and loading (:read-proc m) (= loading (:path (:read-job m))))
      ;; and the next read waiting goes ahead
      (do (task/cancel (:read-proc m)) (ed-read-pump (dissoc m :read-proc :read-job)))
      m)))

(register-task-reply :read-proc
  'pool/ed-apply-read
  nil
  "loading"
  {:cancel-on-quit? true :on-quit 'pool/ed-read-quit})
(register-slot-keeper :file-loading {:order 26 :drop 'pool/ed-read-cancel-killed})

;; ---- dired lives in src/dired.blsp, the hex view in src/hexl.blsp -----------------
;; Both build on this module, so it reaches them by qualified name rather than through its
;; header: a header each way would be a cycle, which leaves one module half-initialised. A
;; qualified call loads its module when it runs, by which time this one has finished loading.

(sig ed-goto-line (buffer int -> buffer))
(defn ed-goto-line (buffer line)
  "Move point to the start of (1-based) line `line`, clamped to the buffer's line range."
  (ed-goto-line-col buffer (dec line) 0))

(sig ed-goto-line-col (buffer int int -> buffer))
(defn ed-goto-line-col (buffer line column)
  "Move point to 0-based `line` / `column` (LSP coordinates), clamped to the buffer. Used by
imenu/xref jumps, which land on a symbol's start position."
  (let (rope (buffer-rope buffer)
        clamped (math/max 0 (math/min line (dec (buffer-line-count buffer))))
        line-start (text/line->char rope clamped))
    (goto-char buffer (math/min (+ line-start (math/max 0 column)) (buffer-length buffer)))))

;; Switching shows buffer `i` in the SELECTED pane (other panes keep their
;; buffers); `:status` is per-model, so reset it (else a stale "modified" from the
;; previous buffer would describe the new one).
(sig ed-select (model int -> model))
(defn ed-select (m i)
  (assoc (ed-show-index m i) :status ""))

(defn ed-has-editable? (buffers)
  "Whether the pool `buffers` holds a buffer other than `*Messages*`."
  (any? buffers (fn (buffer) (not (= (buffer-name buffer) "*Messages*")))))

(defn- ed-remap (m killed target)
  "Re-point every pane after pool index `killed` was removed: a pane on
`killed` now shows `target`; panes above `killed` shift down one; below are
unchanged. (Routes through `ed-map-panes` over all leaf payloads.)"
  (ed-map-panes m
    (fn (window)
      (let (shown (:buffer window))
        (assoc window
          :buffer (cond (< shown killed) shown (> shown killed) (dec shown) else target))))))

(defn- ed-kill-replacement (m removed killed-idx)
  "The pool index, in `removed` (the pool after the kill), of the buffer a pane that showed
the killed one turns to — Emacs's `other-buffer`: the most recently selected buffer that no
OTHER pane is showing, else the most recent at all, so killing the buffer you opened goes
back to the one you were in before it. Falls back to the buffer that shifted into the
killed slot when nothing was ever selected (a fresh session's pool)."
  (let (killed-name (buffer-name (nth (:buffers m) killed-idx))
        names (into [] (map removed buffer-name))
        shown (seq/keep (editor/pane/pane-leaf-paths (:layout m))
                (fn (path)
                  (let (index (:buffer (editor/pane/pane-payload-at (:layout m) path)))
                    (when (not (= index killed-idx)) (buffer-name (nth (:buffers m) index))))))
        recent (seq/filter (ed-recent-buffers m)
                 (fn (name) (and (not (= name killed-name)) (includes? names name))))
        pick (or (seq/find recent (fn (name) (not (includes? shown name)))) (first recent)))
    (if (nil? pick) (math/min killed-idx (dec (count removed))) (index-of names pick))))

(defn ed-closed-with-source (m name)
  "`m` remembering that companion `name` went because its SOURCE was killed, not because the
reader closed it — `:closed-with-source`, the set `aside/closed?` reads, so a pane taken down
with its source does not latch closed the way a dismissed one does. The aside clears the
name when it shows the pane again."
  (assoc m :closed-with-source (conj (or (:closed-with-source m) #{}) name)))

(defn ed-kill-at (m killed-idx follow-companions?)
  "Kill pool buffer `killed-idx`: fire its mode layers' `:on-close`, let everything kept by
pool index let go of it (`model/ed-drop-slot`), remove it, and re-point the panes that showed it (appending a fresh `*scratch*` if the pool
would be left with nothing editable). The body of `cmd-kill-buffer`, factored out so the
companion sweep below can reuse the whole path rather than half of it.

With `follow-companions?` the buffers the closing mode NAMED (`layers/request-close`) are
killed too — a mode's own second window, like the tutorial's *Workings* pane, which means
nothing once the tutorial is gone. Their own `:on-close` fires (they may own workers), but
their requests are NOT followed: one level, so a pair of modes naming each other cannot
loop."
  (let (buf (nth (:buffers m) killed-idx)
        ;; The close hooks are effects (a mode kills the worker it spawned), but the closed
        ;; context is also DATA — the companion names it left on itself. A hook cannot close
        ;; them itself: it only ever sees its own buffer, and layers has no idea the app
        ;; keeps a pool. So it names them and we act, here, where the pool is.
        closed (try
                 (editor/layers/close-context buf)
                 (catch e (do (log/warn (str "close hook failed: " (error-message e))) nil)))
        companions (if follow-companions?
                     (try (editor/layers/close-requests closed) (catch _ (list)))
                     (list))
        ;; its text is given up with it: a sidecar left now would offer it back on every visit
        ;; (Emacs deletes a killed buffer's auto-save file) — on every kill path, here
        _ (when (buffer-file buf) (ed-forget-auto-save buf))
        ;; everything kept by pool index follows the pool (`model/register-slot-keeper`)
        m0 (ed-drop-slot m killed-idx)
        removed (seq/remove-nth (:buffers m0) killed-idx)
        label (str "killed " (buffer-name buf))
        m1 (if (ed-has-editable? removed)
             ;; another editable buffer remains: the killed pane goes back to the buffer
             ;; selected before it (`ed-kill-replacement`, Emacs's `other-buffer`)
             (message (ed-remap (assoc m0 :buffers removed)
                        killed-idx
                        (ed-kill-replacement m removed killed-idx))
               label)
             ;; none left → append a fresh *scratch* and point the killed pane at it.
             (let (buffers (into removed [(ed-stamp (make-buffer ""))]))
               (message (ed-remap (assoc m0 :buffers buffers) killed-idx (count removed)) label))))
    ;; Then the companions, by NAME — indices have just shifted, so each is looked up
    ;; afresh; one that is already gone (or never existed) is simply skipped.
    ;;
    ;; The echo is re-stated at the end, naming what the reader actually killed: each
    ;; companion kill echoes its own name as it goes, which is not the buffer anyone asked
    ;; about.
    (let ([m2 also] (fold companions
                      [m1 (list)]
                      (fn (acc name)
                        (let ([mm killed] acc
                              i (ed-buffer-index-by-name mm name))
                          (cond
                            (nil? i) acc
                            (= name "*Messages*") acc
                            else
                              [(ed-closed-with-source (ed-kill-at mm i false) name)
                                (append killed (list name))])))))
      (if (empty? also)
        m2
        (message m2 (str label " (with " (string/join also ", ") ")"))))))

(sig ed-kill-buffer-named (model string -> model))
(defn ed-kill-buffer-named (m name)
  "Kill the pool buffer named `name` — the full `ed-kill-at` path (its `:on-close`, the
pane re-point), companions not followed — or `m` unchanged when there is none. For a mode
closing a pane it owns (`aside/close`), which knows the pane by NAME and is not on it."
  (let (index (ed-buffer-index-by-name m name))
    (if (nil? index) m (ed-kill-at m index false))))

(defn ed-kill-buffer-at (m index)
  "Kill pool buffer `index` — the full `ed-kill-at` path, companions not followed. For a
caller that knows the buffer by its SLOT because a name would be ambiguous: another
frame's kill arrives keyed by document (`frames/ed-ev-registry-removed`), and two
buffers may share a display name."
  (ed-kill-at m index false))

(defn- ed-inherit-dir (m buf)
  "`buf` carrying a `:dir`: its own when it has one (a file's folder, given by `ed-stamp`),
else the **current** buffer's — Emacs `default-directory` inheritance, so a fileless buffer
(scratch, *Occur*, a report) opens 'in' the directory/project you were in. The one rule
every way a buffer enters the pool follows."
  (if (nil? (:dir buf)) (assoc buf :dir (:dir (ed-current-buf m))) buf))

(defn ed-open-buffer (m buf)
  "Add `buf` to the pool (mode-stamped, and carrying a `:dir` — `ed-inherit-dir`) and show
it in the selected pane."
  (let (buffers (into (:buffers m) [(ed-inherit-dir m (ed-stamp buf))]))
    (ed-select (assoc m :buffers buffers) (dec (count buffers)))))

(defn ed-upsert-named (m name text &optional (type nil))
  "Add or replace the pool buffer named `name` holding `text` (stamped `type`, so a special mode
and its read-only `:activate` hook apply) **without** touching the layout or selection. The
pool-side half shared by `ed-show-named` (which then selects it) and `ed-show-named-aside`
(which shows it in a side pane). Look the buffer's index up afterwards with
`ed-buffer-index-by-name`. A fresh buffer inherits the current buffer's `:dir`; a re-show keeps
the existing one's."
  (let (index (ed-buffer-index-by-name m name)
        raw (make-buffer text name)
        buf (if (nil? type) raw (editor/layers/set-buffer-type raw type)))
    (if (nil? index)
      (assoc m :buffers (into (:buffers m) [(ed-inherit-dir m (ed-stamp buf))]))
      (assoc m
        :buffers
          (assoc (:buffers m)
            index
              (ed-inherit-dir m
                (assoc (ed-stamp buf) :dir (get (nth (:buffers m) index) :dir))))))))

(defn ed-pane-dedicated? (layout path)
  "Whether the pane at `path` of `layout` is DEDICATED to its buffer (M-x
toggle-window-dedicated, Emacs's `set-window-dedicated-p`): `ed-display-buffer` never shows
another buffer in it."
  (= true (:dedicated (pane-payload-at layout path))))

(defn- ed-other-pane-path (layout)
  "The path of the MAIN pane (not a side window, `ed-place-side`, nor one dedicated to its
buffer) after the selected one in traversal order, wrapping — where an other-window buffer goes
— or nil when there is none but the selected pane."
  (let (paths (pane-leaf-paths layout)
        here (pane-selected-path layout)
        n (count paths)
        i (index-of paths here)
        kept? (fn (path)
                (or (not (nil? (:side (pane-payload-at layout path))))
                  (ed-pane-dedicated? layout path))))
    (seq/find (map (range 1 n) (fn (step) (nth paths (math/mod (+ i step) n))))
      (fn (path) (not (kept? path))))))

(defn- ed-pane-showing (layout index)
  "The path of the first pane already showing pool buffer `index`, or nil — the reuse probe
behind `ed-display-buffer` (an existing window wins over a fresh split, like Emacs
`display-buffer`). Reads each pane's payload by path (`pane-payload-at`, std editor/pane)."
  (seq/find (pane-leaf-paths layout) (fn (p) (= index (:buffer (pane-payload-at layout p))))))

(defn- ed-place-aside (layout index)
  "Show buffer `index` in a pane beside the selected one, returning `{:layout :path}`: re-point the
next MAIN pane in traversal order, else split one off — the selected pane, or, when that is a
side window, the first main pane — the new pane at `:path`. A side window is never taken for
another buffer: it belongs to what its rule sent there. Selection is left untouched — the caller
decides whether to move onto `:path`."
  (let (other (ed-other-pane-path layout)
        here (pane-selected-path layout)
        side? (fn (path) (not (nil? (:side (pane-payload-at layout path))))))
    (if (nil? other)
      (let (main (if (side? here)
                   (seq/find (pane-leaf-paths layout) (fn (path) (not (side? path))))
                   here)
            target (or main here)
            split (pane-select-path (pane-split (pane-select-path layout target)
                                      :col (ed-pane index))
                    (append target (list :a))))
        ;; selection back where it was: the side window, or the pane that was split (now `:a`)
        {:layout (if (= target here) split (pane-select-path split here))
         :path (append target (list :b))})
      {:layout (pane-update-path layout
                 other
                 (fn (w) (assoc w :buffer index :top 0 :point nil :mark nil)))
       :path other})))

(sig ed-place-other (map int -> (record &open :layout map :path list)))
(defn- ed-place-other (layout index)
  "Where buffer `index` goes when it is shown in a pane OTHER than the selected one,
`{:layout :path}`: the pane already showing it when there is one (`ed-pane-showing` — reuse
wins, as in Emacs `display-buffer`), else a pane beside the selected one (`ed-place-aside`).
Selection is left untouched."
  (let (existing (ed-pane-showing layout index))
    (if (nil? existing) (ed-place-aside layout index) {:layout layout :path existing})))

;; ---- display-buffer rules (Emacs's `display-buffer-alist`) --------------------------------
;; WHERE a buffer goes is the user's to say: init.blsp's `:display-buffer` is an ordered list of
;; rules, each `{:match … :action …}`, consulted first match wins, before the defaults
;; (`display-rules/*display-buffer-defaults*`, which are rules too and say what every command got
;; before there were rules). A rule's
;;   `:match`   — a regex on the buffer's NAME (`"^\\*compilation\\*$"`), or a keyword / symbol
;;                naming its type or a mode in its stack (`:help`, `git-status`, `:prog`);
;;                absent, every buffer
;;   `:request` — optional: only when the command asked for that (`:here`, `:pop`, `:display`)
;;   `:action`  — `:same-window` (the selected pane), `:other-window` (a pane already showing
;;                it, else one beside the selected), `:reuse` (a pane already showing it, else
;;                the next rule decides), `:side` / `{:side :bottom :size 0.3}` (a pane along
;;                that side of the whole frame, the fraction `:size` of it, reused while it
;;                is there), `:new-frame` (a second window, C-x 5 2's)
;; Selection is the COMMAND's: one that asked to pop (or to show here) moves to the buffer,
;; a preview (`:display`) stays put — the rule says where, not whether you go there.

(defn- name-of (value)
  ;; a keyword's or a symbol's name, without the colon
  (let (text (->string value))
    (if (string/starts-with? text ":") (string/substring text 1 (string/length text)) text)))

(defn display-rule-matches? (rule name buf request)
  "Whether `:display-buffer` rule `rule` applies to the buffer `buf` named `name` shown at the
command's `request` (`:here` / `:pop` / `:display`)."
  (let (match (:match rule)
        wanted (:request rule))
    (and (or (nil? wanted) (= wanted request))
      (cond
        (nil? match) true
        (string? match) (regex/match? match name)
        (or (keyword? match) (symbol? match))
          (or (= (name-of match) (name-of (or (:type buf) "")))
            (not (nil? (conventions/mode-key {match true} buf))))
        else false))))

(defn- ed-display-rules (m)
  ;; the user's rules, then the defaults — a user list need not repeat them
  (let (user (:display-buffer m))
    (append (display-buffer-rules user) *display-buffer-defaults*)))

(defn ed-display-action (m name buf request)
  "The action the first `:display-buffer` rule matching the buffer `buf` named `name` gives it
(`display-rule-action`), skipping a `:reuse` when no pane shows it — Emacs's
`display-buffer-reuse-window` falling through to the next action. With none, the request's
own: `:same-window` for `:here`, else `:other-window`."
  (let (shown? (not (nil? (ed-pane-showing (:layout m) (ed-buffer-index-by-name m name))))
        rule (seq/find (ed-display-rules m)
               (fn (rule)
                 (and (display-rule-matches? rule name buf request)
                   (or shown? (not (= (:action rule) :reuse)))))))
    (if (nil? rule)
      {:kind (if (= request :here) :same-window :other-window) :side :bottom :size 0.3}
      (display-rule-action rule))))

(defn- ed-place-side (layout index side size)
  ;; buffer `index` in the side pane along `side`, `{:layout :path}`: the pane already there
  ;; (its payload marked `:side`), re-pointed, else a new one along that side of the frame —
  ;; a side pane dedicated to another buffer is left to it
  (let (existing (seq/find (pane-leaf-paths layout)
                   (fn (p)
                     (let (payload (pane-payload-at layout p))
                       (and (= side (:side payload))
                         (or (not (ed-pane-dedicated? layout p)) (= index (:buffer payload))))))))
    (if (nil? existing)
      (let (grown (pane-split-edge layout side (assoc (ed-pane index) :side side) size)
            paths (pane-leaf-paths grown))
        {:layout grown :path (if (or (= side :top) (= side :left)) (first paths) (last paths))})
      {:layout (pane-update-path layout
                 existing
                 (fn (w) (assoc w :buffer index :top 0 :point nil :mark nil)))
       :path existing})))

;; check-allow: the `:new-frame` presenter (frames) is resolved late, so its result is unknown
;; to the checker; it answers a model or nil
(check-allow :trusted
  (defn- ed-display-in-frame (m name)
    ;; a second window showing `name` (C-x 5 2's): the live editor's; a model with no buffer
    ;; registry (a test, a headless session) answers nil, and the caller shows it beside
    (if (nil? (:buffer-reg m))
      nil
      (let (presenter (ed-presenter :new-frame))
        (when presenter (ed-call-hook presenter nil m name))))))
(sig ed-display-in-frame (model string -> (or nil model)))
(defn ed-display-buffer (m name text &optional (type nil) (opts {}))
  "The single place a command hands a report buffer to the window manager — an Emacs
`display-buffer`/`pop-to-buffer` analog, so callers say WHAT to show and HOW, never WHERE.
Upserts `name`/`text`/`type` into the pool (stamping `type` so a special mode + its read-only
`:activate` hook apply, and re-apply on every re-show), then places it by the user's
`:display-buffer` rules and the defaults after them (`ed-display-action`), given what the
command asked for, `(:action opts)`:
  `:here`    — show it and select it; by default the selected pane, replacing it (the default).
  `:pop`     — show it and select it; by default another pane (Emacs `pop-to-buffer`).
  `:display` — show it, selection left put; by default another pane — a preview.
  `:none`    — nowhere new, whatever the rules say: the pool takes it, and only a pane already
              showing it shows the new text — a refresh landing behind a reader who has moved on.
Another pane is the one already showing `name` when there is one — no new split — matching
`display-buffer`'s reuse rule. The reuse seam for generated/refreshable buffers
(*Process List*, *git-log*, *git-diff*, …).

Two more options shape a buffer that is RE-shown as it changes rather than regenerated:
`:spans` stamps `[start end face]` faces onto the buffer as data (`:face-spans`, for text
whose faces no lexer can recover — a rendered preview); `:keep-scroll` leaves a reused
pane's scroll where it was instead of returning it to the top, so a refresh under a
reader does not yank the view (the caller then places it — `mdpreview` follows the
cursor)."
  (let (request (:action opts :here)
        m1 (ed-upsert-named m name text type)
        index (ed-buffer-index-by-name! m1 name) ; `ed-upsert-named` just put it there
        m1 (if (contains? opts :spans)
             (ed-set-buf-at m1 index (assoc (ed-buf-at m1 index) :face-spans (:spans opts)))
             m1)
        layout (:layout m1)
        showing (ed-pane-showing layout index)
        action (if (= request :none)
                 {:kind :none}
                 (ed-display-action m1 name (ed-buf-at m1 index) request))
        here (pane-selected-path layout)
        ;; a pane dedicated to another buffer is never re-pointed: the buffer goes beside it
        kind (if (and (= (:kind action) :same-window)
                   (ed-pane-dedicated? layout here)
                   (not (= index (:buffer (pane-payload-at layout here)))))
               :other-window (:kind action))
        framed (when (= kind :new-frame) (ed-display-in-frame m1 name)))
    (cond
      (not (nil? framed)) framed
      (= kind :same-window) (ed-select m1 index)
      else
        (let (placed (case kind
                       :none (if (nil? showing) nil {:layout layout :path showing})
                       :reuse {:layout layout :path showing}
                       :side (ed-place-side layout index (:side action) (:size action))
                       (ed-place-other layout index))
              m1 (if (and (= kind :new-frame) (nil? framed))
                   (message m1 "a new frame needs the live editor; shown beside instead")
                   m1))
          (if (nil? placed)
            m1
            ;; Reset the target pane to the top of the (freshly regenerated) report, clearing
            ;; any stale scroll/point a reused pane carried from a previous, longer buffer — a
            ;; shorter refresh would otherwise render a point past the new end (out-of-bounds).
            ;; A `:keep-scroll` caller keeps the scroll (`ed-pane-top` clamps it into the buffer).
            (let (reset (pane-update-path (:layout placed)
                          (:path placed)
                          (fn (w)
                            (if (:keep-scroll opts)
                              (assoc w :point nil :mark nil)
                              (assoc w :top 0 :point nil :mark nil))))
                  m2 (assoc m1 :layout reset))
              (if (or (= request :pop) (= request :here))
                (assoc m2 :layout (pane-select-path (:layout m2) (:path placed)))
                m2)))))))

(defn ed-show-named (m name text &optional (type nil))
  "Show report buffer `name`/`text`/`type` in the selected pane (replacing it) and select it —
the thin `ed-display-buffer` `:here` wrapper kept for existing callers."
  (ed-display-buffer m name text type {:action :here}))

(defn ed-show-named-aside (m name text &optional (type nil))
  "Show report buffer `name`/`text`/`type` in a side / preview pane without moving selection —
the thin `ed-display-buffer` `:display` wrapper. Splits a lone pane off, else reuses the next
pane; if the buffer is already visible, that pane is refreshed in place (press-to-preview)."
  (ed-display-buffer m name text type {:action :display}))

(defn ed-switch-to-named (m name)
  "Switch to the buffer named `name`, or report there's no such buffer."
  (let (index (ed-buffer-index-by-name m name))
    (if (nil? index) (message m (str "no buffer named " name)) (ed-select m index))))

;; ---- next-error: jump to a source location from a results buffer -------------
;; The Emacs `next-error` / `display-buffer-other-window` discipline, as ONE
;; primitive every results buffer shares (*Tests* / *Run* / *compilation* / *Occur*
;; / *git-status*): a jump opens the source in a pane OTHER than the results pane —
;; the results stay visible — and moves selection there. A buffer computes its own
;; source location (the `:line-loc` mode service, or git's row→path) and hands it to
;; `ed-pop-to-file`; WHERE/HOW lives here, once.

(defn ed-ensure-file-buffer (m path)
  "Ensure the (absolute) `path` is in the pool WITHOUT changing selection — returns
`[m index]`. Reuses an open buffer for the file, else reads-or-news it (find-file
semantics: an existing file is read, a missing one starts a fresh backed buffer). The visit
steps marked `:passing` run over it, and what they note is said."
  (let (index (ed-buffer-index-by-file m path))
    (if index
      [m index]
      (let (root (or (project-root (path/dirname path)) (:project-root m))
            read (ed-stamp (assoc (find-file-buffer path) :name (file-display-name path root)))
            visit (ed-visit-steps m read true)
            buffers (into (:buffers m) [(ed-inherit-dir m (:buffer visit))])
            added (assoc m :buffers buffers))
        [(if (empty? (:notes visit))
           added
           (message added (string/join (:notes visit) " — ")))
          (dec (count buffers))]))))

(defn ed-pop-to-index (m index &optional (line nil))
  "Show pool buffer `index` at (1-based) `line` in a pane OTHER than the current one, select
that pane and put point on the line — the placement half of [[ed-pop-to-file]], shared so a
location naming a BUFFER lands exactly where one naming a file does. A nil `line` leaves
point where it was: Emacs's `pop-to-buffer` on a buffer you asked to see again. A pane
already showing the buffer is reused, the current one included."
  (let (placed (ed-place-other (:layout m) index)
        m1 (assoc m :layout (pane-select-path (:layout placed) (:path placed))))
    ;; point moves; the loop's own scroll-clamp on the (now-selected) source pane
    ;; brings it on screen this tick, as with `cmd-goto-definition`.
    (if (nil? line) m1 (ed-apply m1 (fn (buffer) (ed-goto-line buffer line))))))

(defn ed-pop-to-buffer-named (m name line)
  "[[ed-pop-to-index]] for a buffer named rather than a file — what a location `{:buffer …}`
visits. A buffer that is no longer in the pool says so instead of jumping somewhere else."
  (let (index (ed-buffer-index-by-name m name))
    (if (nil? index) (message m (str name " is no longer open")) (ed-pop-to-index m index line))))

(defn ed-location-path (m path)
  "A report row's `path` made absolute: against the project root, or the cwd without one."
  (if (path/absolute? path) path (str (or (:project-root m) (file/cwd)) "/" path)))

;; check-allow: `after` is the caller's continuation (gitstage's smerge step); it answers a model
(check-allow :trusted
  (sig ed-pop-to-file (model any any &optional any -> model))
  (defn ed-pop-to-file (m path line &optional (after nil))
    "Emacs `next-error` / `display-buffer-other-window`: show `path` at (1-based)
`line` in a pane OTHER than the current one — the results buffer stays visible —
select that pane, and put point on the line. Reuses a pane already showing the file;
splits a lone pane (the results buffer keeps the original). THE jump every
results-buffer 'visit source' routes through, so the behaviour is uniform.

A large file not yet open is read OFF the loop ([[ed-find-file-soon]]'s read): its `Loading…`
buffer pops up at once, and point goes to the line when the file lands in its place. `after`, a
`(fn (m) …)`, runs once point is on the line in the selected pane — at once, or when the read
lands if the file is still the one being looked at then."
    (cond
      (string/blank? path) (message m "(no file)")
      (ed-pop-later? m path) (ed-pop-to-loading m (path/normalize (path/absolute path)) line after)
      else
        (let ([m1 index] (ed-ensure-file-buffer m (path/absolute path))
              popped (ed-pop-to-index m1 index line))
          (if (nil? after) popped (after popped))))))

(defn- ed-pop-later? (m path)
  ;; a jump to `path` that reads it off the loop: a large plain file not open yet
  (let (absolute (path/normalize (path/absolute path)))
    (and (read-off-loop?)
      (nil? (ed-path-handler path))
      (nil? (ed-buffer-index-by-file m absolute))
      (large-read? absolute))))

;; check-allow: `after` is the caller's continuation; it answers a model
(check-allow :trusted
  (defn- ed-pop-to-loading (m path line after)
    ;; [[ed-pop-to-file]] on a file read off the loop: its `Loading…` buffer added (or the one
    ;; already loading) and popped to, the line gone to when the read lands
    (let (loading (ed-loading-index m path))
      (if (int? loading)
        (ed-pop-to-index m loading)
        (let (added (assoc m
                      :buffers
                        (into (:buffers m)
                          [(ed-inherit-dir m
                             (ed-stamp (file-loading-buffer path (loading-name path))))]))
              popped (ed-pop-to-index added (dec (count (:buffers added)))))
          (ed-read-launch popped
            path
            (fn (landed index)
              (let (placed (if (nil? line)
                             landed
                             (ed-set-buf-at landed
                               index
                               (ed-goto-line (ed-buf-at landed index) line))))
                (if (and after (= (ed-current-index placed) index)) (after placed) placed)))))))))

;; ---- the jump stack (Emacs's xref marker stack) ---------------------------------
;; Where a jump came FROM, newest first: what a command that takes point away to another
;; place (a definition, a search hit) pushes before it goes, and what M-, pops back to. One
;; stack for every such command, as Emacs's `xref-push-marker-stack` is shared by xref,
;; consult and the rest. A location is a buffer NAME and a point, so killing the buffer
;; leaves an entry M-, reports rather than one that lands somewhere else.

(defn ed-push-jump (m)
  "The model with the current buffer and point pushed onto the jump stack (`:jump-markers`),
for M-, to come back to."
  (let (buf (ed-current-buf m))
    (assoc m
      :jump-markers
        (cons {:buffer (buffer-name buf) :point (buffer-point buf)}
          (or (:jump-markers m) '())))))

(defn ed-pop-jump (m)
  "Back to the newest location on the jump stack, popped (M-, — Emacs's
`xref-go-back`); a message when the stack is empty or that buffer is gone."
  (let (stack (or (:jump-markers m) '()))
    (if (empty? stack)
      (message m "no jump to return from")
      (let (marker (first stack)
            popped (assoc m :jump-markers (rest stack))
            index (ed-buffer-index-by-name popped (:buffer marker)))
        (if (nil? index)
          (message popped (str "buffer gone: " (:buffer marker)))
          (ed-apply (ed-select popped index)
            (fn (buf) (goto-char buf (math/min (:point marker) (buffer-length buf))))))))))

(defn- ed-visit-project (m path)
  "The project root visiting `path` puts the editor in (Emacs `default-directory`): the visited
file's own (`.git` / `project.blsp`), so the mode line, find-file-in-project and the
project-relative name track the buffer, not the directory the editor launched in — else the
model's `:project-root` (a file in no project), or nil. In the live editor (`:recent-files`)
the visit is remembered too: the file (recentf), a freshly resolved project, and the file in
that project's recent list (the \"last access\" the project-file sort orders by)."
  (let (live? (:recent-files m)
        resolved (project-root (path/dirname path))
        relative (path-under resolved path))
    (do
      (when live? (remember-file! path))
      (when (and resolved live?) (remember-project! resolved))
      (when (and relative live?) (remember-project-file! resolved relative))
      (or resolved (:project-root m)))))

(defn ed-find-file (m path)
  "Open `path`: switch to it if already open, read it if it exists, else start a
fresh buffer backed by it (so Ctrl-S creates it). A relative or `~` path is resolved
to absolute (`path-absolute`) first, so the prompt can stay short/relative while the
buffer's `:file`, dedup, and project-relative name all key off a canonical path. A
directory and a binary go to their presenters (`model/register-presenter`: dired, as Emacs's
`find-file` on a directory; the hex view). A path a file handler claims goes to that handler
(`model/register-file-handler`). The read is on the loop: a caller that acts on the buffer it
opened needs it now. A person's visit of a large file reads it off the loop
([[ed-find-file-soon]])."
  (ed-find-file-with m path nil))

(defn- ed-find-file-with (m path preread)
  ;; [[ed-find-file]], with the file's contents already read when `preread` is not nil
  ;; ([[ed-read-file]]'s answer, or `{:error reason}`) — a large file read off the loop
  (cond
    (string/blank? path) (message m "(no file)")
    (ed-path-handler path) (ed-open-handled m path)
    (file/dir? (path/absolute path))
      (ed-present m :directory (message m "no directory browser is loaded") (path/absolute path))
    else
      (let (path (path/normalize (path/absolute path)) ; `./` and `..` collapsed: one spelling per file
            root (ed-visit-project m path)
            m (if (nil? root) m (assoc m :project-root root))
            index (ed-buffer-index-by-file m path)
            same-file (when (nil? index) (ed-buffer-index-by-truename m path)))
        (cond
          index (ed-select m index)
          same-file
            (message (ed-select m same-file)
              (str path " and " (buffer-file (ed-buf-at m same-file)) " are the same file"))
          ;; read-or-new (vim/emacs find-file) via the shared toolkit primitive; the
          ;; try guards a read error (e.g. a permission denial on an existing file). The
          ;; display name is project-relative inside a project, else the basename
          ;; (`file-display-name`) — `:file` keeps the full path for saving / dedup.
          ;; A binary file (an ELF, an image) opens as a hex view (the `:binary` presenter,
          ;; Emacs hexl-mode) instead of failing on the decode. The
          ;; file is read ONCE (`ed-read-file`): the decode that tells text from binary
          ;; is the text the buffer is built from.
          else
            (let (contents (cond
                             (not (nil? preread)) preread
                             (file/exists? path) (try (ed-read-file path) (catch e {:error e}))
                             else nil))
              (cond
                (:error contents)
                  (message m
                    (str "open failed: "
                      (let (reason (:error contents))
                        (if (string? reason) reason (error-message reason)))))
                (:bytes contents)
                ;; an image or a PDF to its viewer, any other binary to the hex view
                  (ed-present m
                    (binary-role path)
                    (message m "not text, and no hex view is loaded")
                    path
                    root
                    (:bytes contents))
                else (ed-open-text m path root (:text contents) (:coding contents))))))))
(def *image-extensions* #{".png" ".jpg" ".jpeg" ".gif" ".webp" ".bmp"})

(defn image-file? (path)
  "Whether `path` names an image, by its extension — what find-file shows as a picture (the
`:image` presenter, `imageview`) rather than as hex."
  (contains? *image-extensions* (string/lower (or (path/extension path) ""))))

(defn binary-role (path)
  "The presenter role a file that is not text is shown by, from its extension: `:image` (a
picture, `imageview`), `:document` (a PDF's pages, `docview`), else `:binary` (the hex view).

    (pool/binary-role \"a.PDF\")   ;=> :document"
  (cond
    (image-file? path) :image
    (= ".pdf" (string/lower (or (path/extension path) ""))) :document
    else :binary))

(sig ed-find-file (model string -> model))

(defn- ed-open-text (m path root text coding)
  "The pool with `path` open in a new buffer holding `text` (its contents, already read —
nil for a file that does not exist yet) in `coding` (nil for UTF-8), selected, and the open
said in the echo area. The buffer passes through the visit steps first
(`model/register-visit-step`): a note of theirs marked `:instead` is said in place of the open
notice, and the rest follow it."
  (try
    (let (opened-buf (assoc (charset/with-coding (if (nil? text)
                                                   (find-file-buffer path)
                                                   (buffer-from-file path text))
                              coding)
                       :name (file-display-name path root))
          visit (ed-visit-steps m opened-buf)
          opened (ed-open-buffer m (:buffer visit)))
      (message opened
        (or (:instead visit)
          (str (if (nil? text) (str "new file " path) (str "opened " path))
            (if coding (str " as " (charset/label coding)) "")
            ;; a tree-sitter language with no grammar loaded says how to get one
            (missing-note (ed-current-buf opened))
            (string/join (map (:notes visit) (fn (note) (str " — " note))) "")))))
    (catch e (message m (str "open failed: " (error-message e))))))

(defn ed-default-dir (m)
  "The current buffer's directory (Emacs `default-directory`) — its **`:dir`**: every buffer
carries one (a file's folder via `ed-stamp`, a Dired listing's dir, a shell's root, or
inherited by a fileless buffer from the one it was created in). Falls back to a visited
file's folder, then the working dir. The one place find-file, Dired, and `ed-project-root`
read — so every path/project input starts from where you *are*, uniformly across buffers."
  (ed-buffer-dir (ed-current-buf m)))

(defn ed-default-dir-input (m)
  "[[ed-default-dir]] as a path prompt opens in it: spelled as a directory (`filename/as-dir`)."
  (filename/as-dir (ed-default-dir m)))

(defn ed-file-defaults (m)
  "What M-n offers in a find-file prompt (Emacs's future history, `file-name-at-point-functions`):
the existing file named at point, then the current buffer's own file — each spelled as the prompt
line spells a path (`filename/as-input`), none twice."
  (let (buf (ed-current-buf m)
        at (thingatpt/file-at (wrap/line-text buf (buffer-current-line buf))
             (buffer-column buf)
             (ed-buffer-dir buf)))
    (vec (seq/distinct (map (seq/keep [at (buffer-file buf)] identity) filename/as-input)))))

(defn ed-into-dir (target name)
  "Where writing `name` to `target` lands: INTO `target`, keeping `name`, when it is a directory
of this machine (Emacs's write-file, dired's R / C, rename-visited-file); else `target`. A
path a file handler claims is the handler's to place.

    (pool/ed-into-dir \"/no/such/x.txt\" \"a.txt\")   ;=> \"/no/such/x.txt\""
  (if (and (nil? (ed-path-handler target)) (file/dir? target)) (path/join target name) target))

(defn ed-confirm-overwrite (m path then)
  "`(then m)` when nothing is at `path` (or a file handler claims it, and asks its own way) —
else first the y/n question Emacs asks, `File PATH exists; overwrite?`, and `then` on a yes. What
every command that writes a NEW file goes through, so a slip of the prompt never replaces one."
  (if (and (nil? (ed-path-handler path)) (file/exists? path))
    (ed-confirm m (str "File " (path/abbreviate path) " exists; overwrite? (y or n)") then)
    (then m)))

(defn ed-path-prompt (prompt initial recent on-complete &optional (opts {}))
  "The shared path-completing minibuffer spec — the ONE shape every file/folder input uses
(find-file, dired): prefilled with `initial` (an absolute dir; `:word-mode :path` so
`C-w`/`M-DEL` walks **up** a component at a time, no `../`), a Plume candidate list of the
entries completing the typed path (recentf floated to the top via `recent`, basename
labels, perms/size/time marginalia), `Tab` to expand. `on-complete` is `(model path) ->
model` — what to do with the chosen path. Consistent across the board.

The path is read the way Emacs reads one (`filename`): the line SHOWS the home as `~`, a
`//` or `/~/` typed after a slash restarts the path (the overridden part painted dim — the
`:shadow-fn`), `$VAR`s expand, and `on-complete` always receives the ABSOLUTE path that
was meant (`filename/expand`) — so no consumer has to know about `~` or `$HOME`. A relative
name is read under the directory the prompt opened in, as Emacs reads one against
`default-directory`. Every candidate is in the same input spelling (`$` doubled), so
accepting one is reading it.

`opts` `{:new-name true}` is a prompt for a path that need not exist yet — where to WRITE
(C-x C-w, dired's R / C / +, a saved attachment): Enter takes the line as typed, as Emacs's
`read-file-name` does, never the first entry listed under it, so `notes` typed beside
`notes-old.md` names `notes`. ↓ / C-n still select an entry, Tab still completes one. A
blank line names nothing and is said, never handed on."
  (let (base (prompt-dir initial)
        new-name? (:new-name opts))
    {:edit (assoc (ed-mb-edit prompt (filename/as-input initial)) :word-mode :path)
     :shadow-fn (fn (t) (filename/shadow-end t base))
     :complete-fn (fn (t) (ed-complete-path t base))
     ;; only the twelve shown are built (`ed-path-candidates-top`): /tmp has 10k entries
     :candidates-fn (fn (t) (ed-path-candidates-top t recent 12 base))
     ;; a REMOTE directory (`/ssh:h:/etc/`) is listed over ssh, off the loop, then kept a few
     ;; seconds so the keys typed within it complete on the key again
     :async-when (fn (t) (remote-listing-wanted? t base))
     :async-source (fn (t) (ed-remote-candidates-fetched t recent 12 base))
     :label-fn path-label ; show basenames in the list, not the full absolute path
     :category :file ; marginalia: perms/size/mtime per row
     :path-of (fn (candidate) (filename/expand candidate base)) ; … of the file it names
     :accept-selection true
     ;; a line naming a directory selects the PROMPT, so Enter takes that directory rather
     ;; than the first entry listed inside it (Vertico's `vertico-preselect 'directory`)
     :preselect-prompt? (fn (t) (or new-name? (string/ends-with? t "/")))
     :on-complete (fn (mm text)
                    (if (and new-name? (string/blank? text))
                      (message mm "(no file name)")
                      (on-complete mm (filename/expand text base))))}))

(defn- prompt-dir (initial)
  "The directory a path prompt prefilled with `initial` opened in: `initial` itself when it
names a directory (a trailing `/`), else the one holding it — where a relative name is read."
  (let (dir (if (string/ends-with? initial "/")
              (string/substring initial 0 (dec (string/length initial)))
              (path/dirname initial)))
    (if (string/blank? dir) "/" dir)))

(defn ed-path-list-prompt (prompt paths on-complete base)
  "A Vertico prompt choosing among absolute `paths` — the recent files, the known projects,
a default directory — or a path typed instead. The other half of `ed-path-prompt`, read the
same way (`filename`): each entry is shown as the line would spell it (`~/src/whk`), the
list narrows fuzzily as you type, a file's marginalia is shown, and a `//` restarts a typed
path. Tab takes the highlighted entry; with none matching, it completes the text as a path
from the disk (a relative one under `base`), the way find-file does.
`on-complete` gets the ABSOLUTE path meant (`filename/expand`, a relative one under `base`,
the directory you are in) — the empty string when nothing was typed or chosen."
  (let (entries (map paths filename/as-input))
    (assoc (ed-name-prompt prompt
             entries
             (fn (mm text) (on-complete mm (filename/expand (string/trim text) base))))
      :edit (assoc (ed-mb-edit prompt "") :word-mode :path)
      :shadow-fn (fn (t) (filename/shadow-end t base))
      :complete-fn (fn (t) (ed-complete-path t base))
      :category :file
      :path-of (fn (candidate) (filename/expand candidate base)))))

(defn ed-find-file-prompt (initial recent &optional (open nil) (prompt nil))
  "The find-file prompt over `ed-path-prompt`: what Enter accepts is handed to `open` —
`ed-find-file` by default, which opens a file here and a DIRECTORY in dired, as Emacs's
`find-file` does. Tab is what descends into a directory (it fills the highlighted entry,
and the list re-reads inside it).

`open` is a parameter so `C-x 4 f` is this same prompt with a different destination
(`ed-find-file-other-window`). WHERE a buffer goes is the only thing the two commands
disagree about; Emacs splits them into two functions and bedit does not need to."
  (ed-path-prompt (or prompt "Find file: ") initial recent (or open ed-visit-file)))

(defn ed-find-file-spec (m &optional (open nil) (prompt nil))
  "[[ed-find-file-prompt]] as `m` opens it — C-x C-f, C-x 4 f, C-x t f: in the current buffer's
directory ([[ed-default-dir-input]]), the recent files floated up in the live editor, and M-n
offering the file named at point, then the buffer's own ([[ed-file-defaults]])."
  (assoc (ed-find-file-prompt (ed-default-dir-input m)
           (if (:recent-files m) (projects/recent-files) [])
           open
           prompt)
    :defaults (ed-file-defaults m)))

(defn ed-project-root (m)
  "The current project's root — resolved **live from the current buffer's directory**
(Emacs `project-current`/`default-directory`): the nearest ancestor of the buffer's file
holding a `*project-markers*` entry. So every project command (C-x p e/f/p/d) and Dired
acts on the project you're *visiting*, not where the editor launched. Falls back to the
model's cached `:project-root` (for a fileless buffer like *scratch*/*bshell*), then the
working dir. Nil when there's no project anywhere — and in a buffer on another machine
(`/ssh:…`): a local project is not where a remote file is, so C-x p f, C-x p e and the rest
say there is none rather than act on the editor's own."
  (let (dir (ed-default-dir m))
    (if (sshpath/remote? dir)
      nil
      (or (project-root dir) (:project-root m) (project-root (file/cwd))))))

(defn ed-leading-int (line)
  "The leading integer of `line` (after trimming left whitespace), or nil when it doesn't
start with a digit. The shared `\"<n> …\"`-row parser: a `*Process List*` row's process id,
a `*Debug*` row's N, an `*Occur*` row's source line number, and a fuzzy line-search
candidate's line number."
  (let (trimmed (string/triml line)
        digits (string/span trimmed 0 "0123456789"))
    (if (= digits 0)
      nil
      ;; The span is all digits, so this parse cannot fail — but `string/->number`
      ;; answers `number | failure`, and a failure is TRUTHY, so a caller's nil guard
      ;; would let one through into `dec`/`goto-line`. Say nil, as promised.
      (let (number (string/->number (string/substring trimmed 0 digits)))
        (when (int? number) number)))))

(sig ed-modified-file-indices (model -> list))
(defn ed-modified-file-indices (m)
  "The pool indices of the buffers with unsaved changes to a FILE, in pool order — what a
quit must ask about. A modified scratch or generated buffer has nowhere to be saved and is
not asked about (Emacs asks only for file-visiting buffers)."
  (seq/filter (range (count (:buffers m)))
    (fn (index)
      (let (buffer (ed-buf-at m index))
        (and (buffer-modified? buffer) (not (nil? (buffer-file buffer))))))))

(defn ed-reopen-as-text (m path coding)
  "The hex view of `path` replaced by the file as text in `coding`, for a binary that was not
one (`filecoding`). Says so when the file is not valid in it."
  (let (text (charset/decode (file/slurp-bytes path) coding)
        index (ed-buffer-index-by-file m path))
    (if (nil? text)
      (message m (str path " is not " (charset/label coding)))
      (ed-open-text (if (nil? index) m (ed-kill-buffer-at m index))
        path
        (:project-root m)
        text
        (if (= coding :utf-8) nil coding)))))

(defn ed-show-as-hex (m i bytes)
  "Pool buffer `i` replaced by the hex view of its file, whose `bytes` these are, for a text
that was not one (`filecoding`). A buffer with unsaved text is the caller's to refuse."
  (let (path (buffer-file (ed-buf-at m i)))
    (if (nil? path)
      (message m "this buffer visits no file")
      (ed-present (ed-kill-buffer-at m i)
        :binary (message m "no hex view is loaded")
        path
        (:project-root m)
        bytes))))

;; check-allow: a handler's operation is resolved late; every one answers a model
(sig ed-open-handled (model string -> model))
(check-allow :trusted
  (defn- ed-open-handled (m spec)
    ;; the typed path `spec` opened by the file handler claiming it
    (ed-handler-call (ed-path-handler spec) :find-file m m spec)))

(sig ed-revert-handled (model int any -> model))
(check-allow :trusted
  (defn ed-revert-handled (m i coding)
    "Read pool buffer `i` again through the file handler that owns it, in `coding` (nil for the
one it has)."
    (ed-handler-call (ed-buffer-handler (ed-buf-at m i)) :revert m m i coding)))

(defcommand cmd-kill-buffer
  (m key)
  "Kill the current buffer (C-x k) — asking first when it holds unsaved changes to a
file. Refuses to kill `*Messages*`; if it would leave
no editable buffer, opens a fresh `*scratch*`. Panes showing the killed buffer are
re-pointed; indices above it shift down, and everything kept by pool index follows
(`model/ed-drop-slot`). The buffer's mode layers get their `:on-close` (via std's
`close-context`) — the async-cleanup seam where a mode kills a worker it owns — and any
companion buffers that mode asked to take with it (`layers/request-close`) are killed as well."
  (let (buf (ed-current-buf m))
    (cond
      (= (buffer-name buf) "*Messages*") (message m "cannot kill *Messages*")
      ;; unsaved changes to a file: ask, as Emacs does, rather than drop them silently
      (and (buffer-modified? buf) (buffer-file buf))
        (ed-confirm m
          (str "Buffer " (buffer-name buf) " modified; kill anyway? (y or n)")
          (fn (mm) (ed-kill-at mm (ed-current-index mm) true))
          "kill canceled")
      else (ed-kill-at m (ed-current-index m) true))))

;; a guest may run these (src/guest.blsp)
(interactive/declare-trait :guest
  '(pool/cmd-kill-buffer))

;; ---- a file that moved under the editor --------------------------------------------------

(defn- ed-moved-path (path from to)
  "`path` after `from` moved to `to`: `to` when it is `from`, the same place under `to` when it
is under the directory `from`, else nil (untouched by the move)."
  (cond
    (nil? path) nil
    (= path from) to
    else (when-let (relative (path-under from path)) (str to "/" relative))))

(defn- ed-rehandled (buf moved)
  ;; `buf` visiting `moved` now: when the move crossed into or out of a file handler's paths (a
  ;; file moved to another machine, or from one), the old handler's keys gone, the new one's
  ;; mark set and its directory the new one's — so the next save goes where the file is
  (let (before (ed-path-handler (or (buffer-file buf) ""))
        after (ed-path-handler moved))
    (if (= (:name before) (:name after))
      buf
      (let (plain (if (nil? before) buf (ed-buffer-unhandled buf)))
        (assoc (if (nil? after) plain (assoc plain (:mark after) true))
          :dir
            (if (nil? after)
              (path/dirname moved)
              (ed-handler-call after :parent-directory (path/dirname moved) moved)))))))

(defn ed-retype-for-file (buffer old-file)
  "`buffer`, which visited `old-file` and now visits its own `:file`, in the mode its new name
asks for when that differs from what the old name asked for — Emacs's `set-visited-file-name`
choosing the mode again: `notes.txt` renamed `notes.md` becomes Markdown. A mode chosen by hand
stays when the name's mode did not change."
  (let (auto (fn (file) (editor/layers/buffer-type-for (assoc (dissoc buffer :type) :file file))))
    (if (= (auto old-file) (auto (buffer-file buffer)))
      buffer
      (ed-grammar-fallback (editor/layers/init-buffer-layers (dissoc buffer :type))))))

(defn ed-visit-moved (m index path &optional (plain? false))
  "`m` with pool buffer `index` visiting `path`, its file just moved or written there: named for
it, its mode chosen again when the new name asks for another ([[ed-retype-for-file]]), its old
sidecar removed (the next auto-save writes the new one), a shared copy's registry entry and
every other frame's copy following it (`hosted/hosted-rekey-slot`) — and, in the live editor,
`path` among the recent files. With `plain?` (C-x C-w to a plain path) it is no longer its file
handler's; otherwise a move into or out of a handler's paths (a file moved to another machine)
switches handler ([[ed-rehandled]]). What C-x C-w, M-x rename-visited-file and dired's R share."
  (let (old (ed-buf-at m index)
        retargeted (ed-retype-for-file (assoc (if plain?
                                                (ed-buffer-unhandled old)
                                                (ed-rehandled old path))
                                         :file path
                                         :name (file-display-name path (ed-project-root m)))
                     (buffer-file old)))
    (do
      (ed-forget-auto-save old)
      (when (and (:recent-files m) (nil? (ed-path-handler path))) (remember-file! path))
      (hosted/hosted-rekey-slot (ed-set-buf-at m index retargeted) index (hosted/hosted-key old)))))

(defn ed-file-moved (m from to)
  "`m` after the file (or directory) `from` was renamed to `to` (dired's R, M-x
rename-visited-file): every buffer visiting it, or a file under it, follows ([[ed-visit-moved]])
— so its next save does not recreate the file the rename just moved."
  (fold (range (count (:buffers m)))
    m
    (fn (acc index)
      (let (moved (ed-moved-path (buffer-file (ed-buf-at acc index)) from to))
        (if (nil? moved) acc (ed-visit-moved acc index moved))))))

(defn ed-file-deleted (m path)
  "`[m' files]` after the file (or directory) `path` was deleted (dired's D and x): every buffer
visiting it, or a file under it, kept and flagged MODIFIED — its text is now nowhere on disk,
so the mode line, C-x s and the quit's questions treat it as unsaved and C-x C-s writes it
back, as Emacs's buffer of a deleted file — and `files`, the files those buffers visit."
  (fold (range (count (:buffers m)))
    [m []]
    (fn (acc index)
      (let ([model files] acc
            buf (ed-buf-at model index)
            file (buffer-file buf))
        (if (nil? (ed-moved-path file path path))
          acc
          [(ed-set-buf-at model index (mark-buffer-modified buf)) (conj files file)])))))

;; ---- editing other files from where you are -------------------------------------------
;; A change that reaches several files — a language server's rename, edited search results —
;; opens each, edits its buffer (left modified for the user to save, as Emacs leaves them) and
;; comes back to the buffer it started from.

(defn ed-edit-file (m path f)
  "`m` with `path` opened (no question: the caller is acting on it) and `f` (`buffer ->
buffer`) applied to its buffer, which is left modified and current."
  (ed-apply (ed-find-file m path) f))

(defn ed-return-to (m buffer-name point)
  "`m` with the buffer named `buffer-name` selected again and point at `point` — where a
change across files began. Unchanged when that buffer has gone."
  (let (index (ed-buffer-index-by-name m buffer-name))
    (if (nil? index)
      m
      (ed-apply (ed-select m index)
        (fn (buffer) (goto-char buffer (math/min point (buffer-length buffer))))))))
