(defmodule elixir-playground
  "The **Elixir playground** (`M-x elixir-playground`, `C-c p e`) — `*Elixir Playground*`,
a scratch `.exs` buffer that runs as you type.

    defmodule Fac do
      def f(0), do: 1
      def f(n), do: n * f(n - 1)
    end
                                        => Fac  : Fac, 2 functions
    Fac.f(5)
                                        => 120  : Integer

with *Elixir Playground Spy* beside it showing the nested call/return cascade that
produced the form under the cursor — `:erlang.trace` over the modules this session
defined, so a private helper you never exported shows up and your application's ten
thousand other calls do not.

**Inside your project.** The session is a real BEAM node started with `mix run` in the
project root, so the application is compiled and STARTED before the first form runs:
`Accounts.list_users()` and `Repo.aggregate(Post, :count)` mean here what they mean in
`iex -S mix`. Opening this in a cold checkout therefore costs a compile — the buffer says
so rather than sitting blank.

**What is in this file is the language.** The playground itself — form diffing, the
marker-anchored notes, the launch plan, the reply fold, the pane — is `playground-core`,
shared with the Brood playground and the tutorial. Here: how Elixir text splits into
top-level forms, what one form's dependencies are, and what a reply's note says.

Two things this needed that Brood did not have, both added there rather than worked around
here (see `../brood`):

  - `editor/treesit/parse-state` — is this text blank, mid-form, broken, or ready? Brood's
    reader answers that for Brood with two error codes. tree-sitter answers it for any
    grammar, but only if the kernel will say WHERE the parse came apart: an unclosed
    `do` is repaired with an ERROR node, not a MISSING `end`, so the kind alone would have
    put a red ✗ on every `defmodule` the moment its first line was typed.
  - `include-str` — the agent that runs inside the BEAM is an Elixir program, and a
    release bundle carries module source and no asset files. Without a compile-time file
    embed it would have had to live as an escaped blob in a Brood string literal."
  (:use playground-core :only []) ; its hooks register at load (`register-client`), after playground-core is there
  (:use model) ; message
  (:use interactive) ; defcommand — M-x elixir-playground
  (:use editor/layers) ; register-type-layers / request-close
  (:use elixir-sandbox)) ; elixir-start / elixir-eval / elixir-available?
;; liveeval, playground-core, sandbox-events, projects and editor/treesit are referenced
;; qualified below — each `mod/name` auto-loads its module.

(def *buffer-name* "*Elixir Playground*")
(def *spy-buffer-name* "*Elixir Playground Spy*")

(def *spy-spec*
  {:key :elixir-playground
   :buffer elixir-playground/*spy-buffer-name*
   :type :elixir-playground-spy
   :noun "form"
   :heading "What ran"
   :report 'elixir-playground/report-text})

(def *welcome*
  ;; Two lines and one expression, like the Brood playground's: a surface that opens full
  ;; of somebody else's examples is a file you clear before you can use it.
  (str "# Elixir playground — every top-level expression runs as you stop typing.\n"
    "# Results appear at the end of each one; the pane on the right shows what ran.\n\n" "1 + 1\n"))

;; ---- splitting the buffer into forms ------------------------------------------------

;; Node kinds that are not code. A comment evaluated as a form would answer `nil` and
;; stamp `=> nil` on every prose line in the buffer, which is both wrong and the most
;; visible thing on screen.
(def *skip-kinds* #{:comment})

(defn forms-of (text &optional (tree nil))
  "The buffer's top-level expressions as positioned nodes — the named children of the
tree's root, comments dropped. Read off `tree` — the buffer's held tree of exactly `text`
(`syntaxtree`), which the loop keeps incrementally — when there is one alive, else off a
parse of `text`.

`%tree-sitter-kids` at offset 0 is the root's own child list: the deepest node STRICTLY
containing offset 0 is the root, since nothing else can begin before the first character.
Error-tolerant like the rest of tree-sitter, so it answers over text someone is mid-typing;
whether a given form *evaluates* is [[parse-state]]'s separate question."
  ;; check-allow :discarded-catch — no grammar installed is "no forms", which the command guards against
  (check-allow :discarded-catch
    (try
      (seq/reject (or (when tree (%tree-sitter-tree-kids tree 0))
                    (%tree-sitter-kids text :elixir 0))
        (fn (node) (contains? *skip-kinds* (get node :kind))))
      (catch _ '()))))

(defn parse-state (src)
  "Is this form blank, mid-typing, broken, or ready? `editor/treesit/parse-state` over the
Elixir grammar — which reads WHERE the parse came apart, so `defmodule Foo do` is
`[:incomplete \"unclosed `do`\"]` and not an error.

Locally, and deliberately: this runs per form on every settled keystroke, where a round
trip to the node cannot. Elixir's own parser would answer more precisely — it names a
missing terminator as such — but the one case the grammar is wrong about is a stray
closing delimiter, which it reads as unfinished rather than broken, and that is the
direction that costs nothing: a dim pending note on text someone is mid-way through
fixing. A form that really is broken says so when it evaluates."
  ;; check-allow :discarded-catch — without the grammar nothing can be classified, so nothing is sent
  (check-allow :discarded-catch
    (try (editor/treesit/parse-state src :elixir) (catch _ [:err "no Elixir grammar installed"]))))

;; ---- what one form defines and uses ---------------------------------------------------
;; Brood asks its own checker (`reflect/source-deps`). Elixir has no such thing reachable
;; from here without a round trip per keystroke, so this reads the two bindings that
;; actually flow between top-level forms in a playground buffer:
;;
;;   a MODULE   `defmodule Fac do … end` defines `Fac`, and every later form naming `Fac`
;;              depends on it — the dominant shape, and the one worth being precise about;
;;   a VARIABLE `x = 41` defines `x`, and every later form naming `x` depends on it.
;;
;; References are read generously — every alias and every bare lowercase word in the form —
;; because over-matching only re-runs a form that did not need it, which is the direction
;; `playground-core/stale-forms` documents as safe. Under-matching shows a stale answer,
;; which is the failure this whole mechanism exists to prevent.

(def *alias-pattern* "[A-Z][A-Za-z0-9_]*(\\.[A-Z][A-Za-z0-9_]*)*")
(def *name-pattern* "[a-z_][A-Za-z0-9_]*[?!]?")
(def *defmodule-pattern* "^\\s*defmodule\\s+([A-Z][A-Za-z0-9_.]*)")
;; A top-level binding: everything up to the form's first `=` that is not `==`, `!=`, `<=`,
;; `>=`, `=~` or `=>`. The LEFT-HAND SIDE, not a single name — Elixir's `=` is a pattern
;; match, so `{a, b} = …`, `[h | t] = …` and `%{k: v} = …` each bind several, and missing
;; one would leave a form below that uses it showing the value from before the edit.
(def *binding-pattern* "^\\s*([^=<>!~\\n]+?)\\s*=[^=~>]")

(defn- matches (pattern src)
  ;; Every match of `pattern` in `src` as text. `()` rather than a raise on a source the
  ;; regex engine chokes on — a dependency it cannot see costs a re-run, never a crash.
  ;; check-allow :discarded-catch — an unmatchable fragment mid-typing has no deps, which is the answer
  (check-allow :discarded-catch
    (try (map (regex/find-all src pattern) (fn (m) (get m :text))) (catch _ '()))))

(defn- first-group (pattern src)
  ;; The first capture group of `pattern`'s first match, or nil.
  ;; check-allow :discarded-catch — same as `matches`
  (check-allow :discarded-catch
    (try
      (let (m (regex/find src pattern))
        (when m (get (first (get m :groups)) :text)))
      (catch _ nil))))

(defn form-deps (src)
  "`{:defines (…) :references (…)}` for one top-level Elixir form — see the section note
above for the rule and why references are read generously."
  (let (module (first-group *defmodule-pattern* src)
        lhs (first-group *binding-pattern* src)
        ;; every name the left-hand side binds, which for a pattern match is several
        bound (if lhs (matches *name-pattern* lhs) '())
        defines (into '() (seq/reject (cons module bound) nil?))
        ;; A binding's references are read from its RIGHT-hand side only, so `x = x + 1`
        ;; still references the `x` above it (filtering its own names out of the whole form
        ;; would leave it referencing nothing, and showing a stale answer).
        scanned (if lhs
                  (string/substring src
                    (+ (index-of src lhs) (string/length lhs))
                    (string/length src))
                  src)
        ;; A module is not a reference to itself: a `defmodule Fac` naming `Fac` in its own
        ;; body would otherwise make every module depend on itself and re-run the whole
        ;; tail on any edit to any of them.
        references (seq/reject (append (matches *alias-pattern* scanned)
                                 (matches *name-pattern* scanned))
                     (fn (r) (= r module))))
    {:defines defines :references references}))

(defn deps-of (text &optional (tree nil))
  "Per top-level form of `text`, `{:defines :references}` — [[form-deps]] over each. The
count must line up with [[forms-of]] one-for-one or `playground-core/launch-plan` falls
back to the suffix rule, which is why both walk the same node list — off `tree` when the
buffer has one, as [[forms-of]] reads it."
  (let (forms (forms-of text tree))
    (map forms (fn (node) (form-deps (string/substring text (:start node) (:end node)))))))

(defn namespace-form? (src)
  "Does this form change what names MEAN below it? `import`, `alias`, `require` and `use`
all do — they are exactly the edges a name-based dependency scan cannot see, since the
affected forms name nothing that changed — so re-running one takes the whole tail with it."
  (let (head (first-group "^\\s*(import|alias|require|use)\\b" src))
    (not (nil? head))))

;; ---- what a reply says -------------------------------------------------------------------

(defn- type-hint (reply)
  "The `: Integer` / `: %User{}` / `: Fac, 2 functions` hint, computed in the agent because
only the BEAM can see what a term is. Brood derives its hint from the checker; here the
value itself is the only source, so it travels on the reply."
  (let (inferred (get reply :type))
    (when (and (string? inferred) (not (= inferred ""))) (str ": " inferred))))

(def *compile-failures*
  ;; The exceptions Elixir raises INSTEAD of running your code. Same rule as a syntax
  ;; error found locally: the form did not run, so it did not fail — it is `:broken`.
  ["CompileError" "SyntaxError" "TokenMissingError" "MismatchedDelimiterError"])

(defn compile-failure? (banner)
  "Did this raise happen INSTEAD of running the code, rather than while running it?"
  (any? *compile-failures* (fn (name) (includes? (or banner "") name))))

(defn- error-note (reply)
  "The note for a reply that raised or timed out, or nil when it did neither.

A raise keeps the verdict colour it is owed — the code ran and blew up. A COMPILE failure
does not: it is `:broken`, in the pending voice, because the code never ran and because
for most of the keystrokes it takes to write a `defmodule` it cannot be compiled.

Its message is dropped, too, and that is the point of telling them apart. Elixir's compile
banner is `** (CompileError) /tmp/bedit-elixir-agent-5d60b4d9.exs: cannot compile file
(errors have been logged)` — a path into the agent's own scratch file and a sentence that
says the real errors went somewhere else. As ghost text beside your code it is pure noise
at full width. `does not compile` is the whole of what it actually tells you; the count is
on the mode line, and the detail is one keystroke away in the echo row.

Its own rather than `liveeval/error-note`'s, for one more word: the timeout advice has to
name the command that restarts THIS session."
  (cond
    (get reply :timeout)
      {:kind :fail
       :error? true
       :text "timed out — still running? (M-x elixir-playground-restart)"}
    (not (get reply :ok))
      (let (banner (get reply :error "error"))
        (if (compile-failure? banner)
          {:kind :broken :error? true :text "does not compile"}
          {:kind :fail :error? true :text banner}))
    else nil))

(defn- def-hints (reply)
  "One `{:offset :text}` per function a `defmodule` defined — `bar/0 : integer()` against
the `def` that declares it — or `()` for a form that defined nothing.

This is why the reply carries `defs`: each definition knows its own line, so its note goes
there rather than every name piling onto the `defmodule` line, and there is room on it for
the TYPE — which the BEAM has for ordinary code with no `@spec` written anywhere, because
the compiler infers one (`bar/0 :: integer()`).

`:offset` is the line within the form, not in the buffer: the child was sent one form and
counts from its first line. `playground-core` (`pg-place-rows`) puts it where the form is."
  (let (defs (get reply :defs))
    (if (empty? defs)
      '()
      (map defs
        (fn (definition)
          (let (inferred (get definition :type)
                function-name (get definition :name))
            {:offset (math/max 0 (dec (or (get definition :line) 1)))
             :text (if (and (string? inferred) (not (= inferred "")))
                     (str function-name " : " inferred)
                     function-name)}))))))

;; ---- `dbg`, against the steps it is about -------------------------------------------
;; `dbg/2` on a pipeline is the best thing in Elixir's debugging toolbox because it
;; decomposes: it reports the value AFTER EVERY STEP, not just the answer. The pane shows
;; that block in full — and the block is a table of contents for code that is right there
;; on screen, so reading it means looking down a list of steps in one pane and matching
;; them by eye to the same steps in another.
;;
;; Each step's value belongs against the step. `dbg`'s own output makes that placement
;; possible without asking the child for anything new: every line it prints is the step's
;; SOURCE followed by `#=>` and the value, and the form's source is right here.

(def *dbg-arrow* " #=> ")

(defn dbg-step-pairs (dbg)
  "`([source value] …)` for each step in a `dbg` block, in order — `()` for a block that
has none.

A line `dbg` printed is `<the step's source> #=> <its value>`. A line without the arrow is
not a step (a `dbg` of something that does not decompose prints the value alone) and is
left to the pane."
  (seq/keep (string/split (string/trim-right (or dbg "")) "\n")
    (fn (line)
      (let (i (index-of line *dbg-arrow*))
        ;; `index-of` answers -1 for "not found", and -1 is TRUTHY here — only nil and
        ;; false are falsy — so the miss has to be tested for, not merely relied on
        (when (>= i 0)
          [(string/trim (string/substring line 0 i))
            (string/trim (string/substring line (+ i (string/length *dbg-arrow*))))])))))

(defn- dbg-offset-from (lines source from)
  ;; The first line at or after `from` whose text IS this step's source, or nil.
  ;;
  ;; Searched FORWARD from the last step's line rather than from the top, because a
  ;; pipeline may apply the same step twice (`|> Enum.reverse() … |> Enum.reverse()`) and
  ;; matching both to the first occurrence would stack two values on one line and leave
  ;; the other bare. `dbg` reports steps in source order, so in-order scanning pairs them
  ;; the way a reader does.
  (let (hit (seq/find (drop (seq/enumerate lines) from)
              (fn ([_ text]) (= (string/trim text) source))))
    (when hit (first hit))))

(defn dbg-hints (reply src)
  "One `{:offset :text}` per `dbg` step — `#=> [\"foo\", \"bar\", \"zar\"]` against the line
of the pipeline that produced it — or `()` when the form called no `dbg` or its steps do
not match the source.

A step whose source cannot be found on a line of its own is DROPPED rather than guessed at:
a pipeline written on one line has every step's source inside that line and no line equal
to any of them, and a value placed against the wrong step is worse than one only in the
pane, which still has the whole block."
  (let (lines (string/split (or src "") "\n"))
    (second (fold (dbg-step-pairs (get reply :dbg))
              [0 '()]
              (fn (acc pair)
                (let ([from hints] acc
                      [source value] pair
                      at (dbg-offset-from lines source from))
                  (if (nil? at)
                    acc
                    [(inc at) (append hints (list {:offset at :text (str "#=> " value)}))])))))))

(defn dbg-lines (reply)
  "The `dbg` block for the pane — `()` when the form called none.

`dbg/2` is the best thing in Elixir's debugging toolbox, and its output is the wrong shape
for ghost text: a piped expression decomposes into one line per step, which is a paragraph
next to a form and a sentence in a pane. So it goes where the cascade goes. Indented under
a heading of its own, because it answers a different question from the cascade — `dbg` is
what YOU asked to see, the cascade is everything that happened."
  (let (dbg (get reply :dbg ""))
    (if (= (string/trim dbg) "")
      '()
      (cons "what dbg showed:"
        (map (string/split (string/trim-right dbg) "\n") (fn (line) (str "  " line)))))))

(defn note-of (reply src)
  "The ghost-text note for one reply — `=> 120` with what it printed, what it cost and what
it left running, plus the term's type as the `:hint` anchored at the form.

`src` is what places the per-line notes: a `dbg` step names its own source, and finding
that source among the form's lines is what turns a block in the pane into a value against
the step it belongs to (see [[dbg-hints]]). The type itself comes back on the reply, because
only the BEAM can see what a term is — which is the one thing Brood derives from the
checker instead."
  (or (error-note reply)
    (let (hint (type-hint reply)
          defs (def-hints reply)
          steps (dbg-hints reply src)
          note {:kind :info
                :text (str "=> "
                        (get reply :value)
                        (liveeval/printed-note reply)
                        (liveeval/slow-note reply)
                        (liveeval/proc-note reply))}
          ;; The form's own type sits at its opening line and a `dbg` step's value at its
          ;; step: both are short, and both are ABOUT the line they sit on.
          ;;
          ;; A lone type keeps the SINGULAR `:hint`, which is not a shorthand — that is the
          ;; channel that rejoins the answer when the two would land on the same cell
          ;; (`eolnotes/set-note`). Only a form with per-step text needs the plural one.
          ;;
          ;; A signature is neither: `foo/2 : (float() or integer(), binary()) ->
          ;; dynamic(float() or integer())` against an already-indented `def` has a couple
          ;; of dozen columns to live in, so the half that identifies the function is the
          ;; half that gets cut. It takes a row of its OWN, above the `def`, which is where
          ;; a signature goes in every language that writes one down.
          with-eol (cond
                     (not (empty? steps))
                       (assoc note :hints (if hint (cons {:offset 0 :text hint} steps) steps))
                     hint (assoc note :hint hint)
                     else note))
      (if (empty? defs) with-eol (assoc with-eol :inlays defs)))))

(defn report-text (reply src)
  "The pane's body for one reply — what it answered, what `dbg` showed, what it printed,
what it cost, and the cascade of everything it called.

`liveeval`'s report with two things a language computes for itself: the term's type on the
value line, and the `dbg` block under it."
  (let (dbg (dbg-lines reply)
        ;; a `dbg` block explains how the evaluation ran, so liveeval's "nothing of yours
        ;; ran" line would contradict the steps printed right above it
        base (liveeval/report-text reply nil (not (empty? dbg)))
        hint (type-hint reply)
        lines (string/split base "\n")
        ;; the first line is the `=> value`; the type belongs beside it, as it does in the
        ;; note
        head (if (or (nil? hint) (not (get reply :ok)))
               (first lines)
               (str (first lines) "   " hint)))
    (string/join (append (list head) (if (empty? dbg) '() (cons "" dbg)) (rest lines))
      "\n")))

(defn send-eval (id src timeout-ms)
  "Put one form on the Elixir session's wire. The agent traces the modules the session has
defined for the duration, so the reply carries the cascade the pane shows."
  (elixir-eval id src timeout-ms))

(def- *effectful-calls*
  ;; What reaches outside the session when an Elixir form runs: the file system, the OS, and
  ;; a Repo's writes — the database the playground's node is STARTED against. Matched as
  ;; text, so a mention in a string or a comment holds the form too: the safe direction.
  ["File.write"
    "File.rm" "File.rename" "File.cp" "File.mkdir" "File.touch" "File.ln" "System.cmd"
    "System.shell" "System.halt" "System.stop" ":os.cmd" "Port.open" "Repo.insert" "Repo.update"
    "Repo.delete" "Repo.query" "Ecto.Adapters.SQL.query"])

(defn held-reason (src)
  "Why the Elixir form `src` must not run as you type — `\"runs File.write\"` — or nil when it
may (issues.md S5). A `defmodule` defines, and runs nothing in its functions' bodies, so it is
never held."
  (when (not (string/starts-with? (string/trim-left src) "defmodule"))
    (let (hits (seq/filter *effectful-calls* (fn (call) (includes? src call))))
      (when (not (empty? hits)) (str "runs " (string/join hits ", "))))))

(def *spec*
  {:key :elixir-playground
   :buffer elixir-playground/*buffer-name*
   :spy elixir-playground/*spy-spec*
   :type :elixir-playground
   :timeout-ms elixir-sandbox/*elixir-default-timeout-ms*
   :quiet-ms playground-core/*quiet-ms*
   :restart "M-x elixir-playground-restart"
   :spawn-failed-message "could not start the Elixir session (is `elixir` on PATH?)"
   :forms-of 'elixir-playground/forms-of
   :parse-state 'elixir-playground/parse-state
   :deps-of 'elixir-playground/deps-of
   :namespace-form? 'elixir-playground/namespace-form?
   :note-of 'elixir-playground/note-of
   ;; a form that writes files or the database is not run as you type — C-c C-c runs it
   :held? 'elixir-playground/held-reason
   :eval 'elixir-playground/send-eval
   :start 'elixir-playground/start-session
   :running? 'elixir-sandbox/elixir-running?
   :reset 'elixir-sandbox/elixir-reset
   :welcome elixir-playground/*welcome*
   :open-message 'elixir-playground/open-message
   :restart-message "restarting the Elixir session…"
   ;; a `dbg` step and a traced return are the same idea — a value coming back out — so
   ;; they read in the same accent
   :spy-faces [[:prefix "What ran" :dim]
                [:prefix "what dbg showed" :dim]
                [:prefix liveeval/*untraced-note* :aside]
                [:includes "#=>" :value]
                [:trimmed-prefix "= " :value]]})
;; No `:in-image`: an Elixir session IS a child process, so there is no in-image answer to
;; fall back to when the editor is headless. A launch with no loop to deliver replies to
;; therefore sends nothing and stamps nothing, which is the honest outcome — the Brood
;; playground's in-image path exists only because Brood can evaluate Brood.

;; ---- the buffer ---------------------------------------------------------------------------

(defn elixir-playground-live-buffer? (m)
  "Is *Elixir Playground* on screen — i.e. does it still want a session? One of the
`sandbox-events` client hooks."
  (playground-core/live-buffer? *spec* m))

(defn start-session (m)
  "Start the Elixir session in this project (or re-root it there)."
  (elixir-start (projects/root-of m)))

(defn open-message (m booting?)
  "What opening the playground says. A cold `mix run` compiles the project before it
answers anything, and a buffer that sits there showing nothing for thirty seconds reads as
broken — so a boot says what it is waiting for."
  (cond
    (and booting? (elixir-project? (projects/root-of m)))
      "Elixir playground — starting your project (this compiles the first time)…"
    booting? "Elixir playground — starting an Elixir session…"
    else "Elixir playground — type Elixir; it runs as you stop typing"))

;; ---- the eval-on-type triple (the model's timers call these) --------------------------------

;; the Elixir playground evaluates as you type, closes its quiet window on a pause, and hears
;; its session's events — every hook, in one registration. Its session is a DIFFERENT one
;; from the Brood playground's, whose child is a BEAM node rather than a Brood runtime — same
;; hooks, same discipline.
(playground-core/register-client {:timer :elixir-playground-eval
                                  :stale? 'elixir-playground/ed-elixir-playground-stale?
                                  :launch 'elixir-playground/ed-elixir-playground-launch
                                  :reanchor 'elixir-playground/ed-elixir-playground-reanchor
                                  :quiet-timer :elixir-playground-quiet
                                  :quiet-spec 'elixir-playground/quiet-timer
                                  :quiet-fire 'elixir-playground/quiet-reveal
                                  :session :elixir-sandbox
                                  :live? 'elixir-playground/elixir-playground-live-buffer?
                                  :ready 'elixir-playground/elixir-playground-ready
                                  :reply 'elixir-playground/elixir-playground-reply
                                  :down 'elixir-playground/elixir-playground-down})
(defn ed-elixir-playground-stale? (m) (playground-core/ed-stale? *spec* m))
(defn ed-elixir-playground-reanchor (m) (playground-core/ed-reanchor *spec* m))
(defn ed-elixir-playground-launch (m) (playground-core/ed-launch *spec* m))

;; the quiet window closing on a pause — see playground-core's quiet window
(defn quiet-timer (m) (playground-core/quiet-timer *spec* m))
(defn quiet-reveal (m) (playground-core/reveal-quiet *spec* m))

;; ---- the session client hooks ---------------------------------------------------------------

(defn elixir-playground-ready (m gen banner)
  "The agent announced itself. Beyond the shared bookkeeping this says so out loud, because
the wait was long enough to need explaining: in a mix project the boot compiled the whole
project, and the buffer sat showing nothing while it did.

And it says WHICH session you got. An application is entitled to refuse to start — a
pending migration, a database that is down, a startup task that raises — and the retry that
follows runs `mix run --no-start`, which still compiles the project and loads your modules
but supervises nothing. `Repo.all(User)` working and `Repo.all(User)` raising are different
tools, and the difference must not be something a reader discovers by trying it.

It also says so when the Elixir that came up is older than bedit expects. That is worth a
sentence rather than a silence for the same reason: the agent degrades (no dbg stream) and
keeps working, so without being told you would just find one feature missing and no
explanation of why."
  (let (m1 (playground-core/sandbox-ready *spec* m gen)
        stale (elixir-sandbox/version-notice banner))
    (cond
      (not (playground-core/live-buffer? *spec* m1)) m1
      stale (message m1 stale)
      (elixir-sandbox/app-started? banner)
        (message m1
          (str "Elixir session ready — " (elixir-sandbox/app-started? banner) " is running"))
      (elixir-sandbox/elixir-project? (projects/root-of m1))
        (message m1
          "Elixir session ready — your application is NOT started (see *Messages*); modules are loaded")
      else (message m1 "Elixir session ready"))))

(defn elixir-playground-reply (m reply gen) (playground-core/sandbox-reply *spec* m reply gen))
(defn elixir-playground-down (m code) (playground-core/sandbox-down *spec* m code))

;; ---- the pane follows the cursor ---------------------------------------------------------------

(defn elixir-playground-on-move (m) (playground-core/on-move *spec* m))

;; ---- the modes ---------------------------------------------------------------------------------

;; Stacks over the real elixir-mode, so the buffer is an Elixir file first: tree-sitter
;; highlighting, the `do`/`end` indenter, the `C-M-*` structural motions and `beginning-of-defun`
;; all come for free. A playground where RET did not indent would be a worse place to try the
;; language than the file you already had open.
(def elixir-playground-mode-layer
  {:name 'elixir-playground
   :keymap (editor/keymap/keymap-bind {}
             [:ctrl-c :ctrl-c]
             'elixir-playground/cmd-elixir-playground-run-held)
   :on-move 'elixir-playground/elixir-playground-on-move
   ;; the count of forms that cannot run yet — see `playground-core/modeline` for why it
   ;; is a count on the bar and not a verdict at the form
   :modeline 'playground-core/modeline
   :hooks {:on-close '(elixir-playground/elixir-playground-on-close)}})

(register-type-layers :elixir-playground
  (list 'elixir-playground/elixir-playground-mode-layer
    'lang-scripts/elixir-mode-layer 'modes/prog-mode-layer 'modes/text-mode-layer))

(defn spy-fontify (src)
  "The spy pane's colouring — the spec's `:spy-faces`, painted by `playground-core`."
  (playground-core/spy-fontify *spec* src))

(def elixir-playground-spy-layer
  {:name 'elixir-playground-spy :no-line-numbers true :fontify 'elixir-playground/spy-fontify})

(register-type-layers :elixir-playground-spy
  (list 'elixir-playground/elixir-playground-spy-layer
    'modes/special-mode-layer 'modes/text-mode-layer))

(defn elixir-playground-on-close (buffer)
  "The `:on-close` hook: killing the playground takes its pane with it (`aside/close-with`).
The session is deliberately NOT stopped — `sandbox-events` is the only place that can see
whether every client is gone, and in a mix project restarting one costs a compile."
  (aside/close-with buffer *spy-spec*))

;; ---- the commands -------------------------------------------------------------------------------

(defn- grammar-installed? ()
  "Can the editor parse Elixir at all? Everything here reads the tree-sitter grammar — how
the buffer splits into forms, whether a form is finished, where the cursor is — so without
it the playground would open a buffer that never evaluates anything and never says why."
  ;; check-allow :discarded-catch — the error IS the answer to "is the grammar loaded?"
  (check-allow :discarded-catch (try (do (%tree-sitter-kids "" :elixir 0) true) (catch _ false))))

(defcommand cmd-elixir-playground
  (m key)
  "Open the Elixir playground (M-x elixir-playground, C-c p e): a free-text
`*Elixir Playground*` buffer whose top-level expressions evaluate as you settle typing,
results as ghost text, and an *Elixir Playground Spy* pane showing what each one called.

In a mix project the session runs inside YOUR application — compiled and started — so the
buffer can call your own contexts and query your Repo. That costs a compile on the first
open, which is why it says so and then says when it is ready.

Running it again switches to the buffer you already have and brings the pane back if you
closed it, on the form the cursor is in."
  (let (missing (elixir-sandbox/missing-tool (projects/root-of m)))
    (cond
      (not (grammar-installed?))
        (message m
          "no Elixir tree-sitter grammar — M-x grammar-list shows how to install one")
      missing (message m (str missing))
      else (playground-core/open *spec* m))))

(defcommand cmd-elixir-playground-run-held
  (m key)
  "Run the held form at point (C-c C-c in the Elixir playground): one that writes files or
the database, which is not run as you type. Edit it afterwards and it is held again."
  (playground-core/pg-release-at-point *spec* m))

(defcommand cmd-elixir-playground-restart
  (m key)
  "Restart the Elixir session (M-x elixir-playground-restart): a fresh VM — every module and
binding the buffer defined is gone — and the whole buffer re-evaluates against it once the
agent announces ready.

Also the retry path when the session gave up or never started, which is why it starts a dead
one rather than resetting it: a reset on a worker that is not running is a silent no-op, and
a silent no-op is the wrong answer to \"please try again\". In a mix project this recompiles,
so it is a real pause and never something the editor does on its own."
  (playground-core/restart *spec* m))
