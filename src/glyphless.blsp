(defmodule glyphless
  "The invisible format characters made visible (Emacs's `glyphless-char-display`, its
`hex-code` method): a zero width space, a word joiner, a BOM in mid-text, a tag character —
and the bidi controls a \"Trojan Source\" attack hides in, which Emacs's
`highlight-confusing-reorderings` points at.

Brood lays each one out as its `<200b>` escape when `*glyphless-display*` is `:hex-code`
(brood ADR-556) — the view, the row tables, the wrap and the clip all measure through that one
layout, which `conventions/with-cell-layout` binds from the init file's `:glyphless-chars`. So
the escape is already on screen and the caret, a click and a wrap already agree with it; what
this module adds is its FACE: highlight ranges over each glyphless character, dim like Emacs's
`escape-glyph` for most, a warning for a bidi control. The view tiles them under the region and
the search hits, which keep their background over an escape.

A BOM at the START of a file is not in the buffer: the visit takes it off and remembers it as
`:bom true` (std's `editor/buffer-file/file-text-decode`), a save writes it back, and M-x
describe-indentation says when it disagrees with `.editorconfig`'s charset — Emacs's
`utf-8-with-signature`. Only a U+FEFF elsewhere in the text is a character of the buffer, and
that one shows as `<feff>`. ZWJ and ZWNJ are never shown (brood ADR-556: they join
emoji and Persian or Indic letters, and the class is decided per character).

A NO-BREAK SPACE (U+00A0, U+202F) is laid out as a space, not an escape, and gets a face here
too: underlined in the escape colour (Emacs's `nobreak-char-display`), unless init.blsp's
`:nobreak-char-display` is false."
  (:use editor/buffer) ; buffer-rope
  (:use model :only [register-highlight-source]) ; a pane's ranges
  (:use memo) ; defmemo — asked every frame, recomputed only when the text or the window moves
  (:use theme)) ; the palette the faces are formulas over

;; Emacs's `escape-glyph`: the escape reads as furniture, not as text
(theme/defchrome face-glyphless {:fg *peach* :bg (theme/mix *overlay0* *base* 0.18)})
;; a bidi control reorders what is shown around it: marked as a hazard
(theme/defchrome face-glyphless-bidi {:fg *base* :bg *red*})

(defn bidi-control? (character)
  "Whether the one-character string `character` is a bidi formatting character — the
embeddings and overrides U+202A–202E, the isolates U+2066–2069, the marks U+200E / U+200F and
U+061C: the ones that reorder the text shown around them.

    (glyphless/bidi-control? \"\\u{202e}\")   ;=> true
    (glyphless/bidi-control? \"\\u{200b}\")   ;=> false"
  (let (code (or (first (string/->codepoints character)) 0))
    (or (and (>= code 0x202A) (<= code 0x202E))
      (and (>= code 0x2066) (<= code 0x2069))
      (= code 0x200E)
      (= code 0x200F)
      (= code 0x061C))))

(defn text-ranges (text base faces)
  "The highlight ranges `[from to face]` of the glyphless characters of `text`, whose first
character is at buffer offset `base`: each one's own range, in `(second faces)` for a bidi
control ([[bidi-control?]]) and `(first faces)` otherwise.

    (glyphless/text-ranges \"a\\u{200b}b\" 10 [:dim :hazard])   ;=> ([11 12 :dim])"
  (let ([plain bidi] faces)
    (map (string/glyphless-indices text)
      (fn (index)
        [(+ base index)
          (+ base index 1)
          (if (bidi-control? (string/substring text index (inc index))) bidi plain)]))))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as unknown;
;; the store only ever holds what the body built, a list of ranges.
(check-allow :trusted
  (defmemo ranges-at 4 (rope windows faces)
    "[[ranges]] over each char range `[from to]` of `windows`, remembered on what it reads
(`faces` too, so a theme switch recomputes)."
    (mapcat windows (fn ([from to]) (text-ranges (text/slice rope from to) from faces)))))

(defn ranges (buf top rows &optional (clip nil))
  "The glyphless highlight ranges `[from to face]` of `buf`'s lines `top` through `top +
rows`, nothing when the editor hides them (`*glyphless-chars*` `:hidden`). A long
line is read only over the window of it the pane shows (`clip`, `spancache/ed-visible-windows`),
so a one-line multi-megabyte file costs its window."
  (let (rope (buffer-rope buf))
    (windows-ranges rope (spancache/ed-visible-windows rope top rows clip))))

(defn- windows-ranges (rope windows)
  ;; [[ranges]] over windows already found
  (if (= *glyphless-chars* :hidden)
    '()
    (ranges-at rope windows [face-glyphless face-glyphless-bidi])))

;; ---- no-break spaces (Emacs's `nobreak-char-display`) ----------------------------------
;; A no-break space lays out as a plain space — it is not glyphless, so brood shows it as one
;; cell — and so passes for a space where a word must not break (or where a paste smuggled one
;; into code). Emacs's default `nobreak-char-display` t gives it the `nobreak-space` face:
;; the escape colour, underlined. On by default; init.blsp's `:nobreak-char-display` false
;; turns it off.

(theme/defchrome face-nobreak-space
  {:fg *peach* :underline true :bg (theme/mix *overlay0* *base* 0.12)})

(defn nobreak-text-ranges (text base face)
  "The highlight ranges `[from to face]` of the no-break spaces of `text` (U+00A0, U+202F),
whose first character is at buffer offset `base`. One native search rather than a lookup per
character: it runs over every window of text that changed, every frame, and a terminal's
screen changes every frame.

    (glyphless/nobreak-text-ranges \"a\\u{a0}b\" 10 :nb)   ;=> ([11 12 :nb])"
  (map (regex/find-all text "[\u{a0}\u{202f}]")
    (fn (found) [(+ base (:start found)) (+ base (:end found)) face])))

;; check-allow: as `ranges-at` above — the store only ever holds what the body built
(check-allow :trusted
  (defmemo nobreak-ranges-at 4 (rope windows face)
    "[[nobreak-text-ranges]] over each char range `[from to]` of `windows`, remembered on what
it reads (`face` too, so a theme switch recomputes)."
    (mapcat windows
      (fn ([from to]) (nobreak-text-ranges (text/slice rope from to) from face)))))

(defn nobreak-shown? (m)
  "Whether no-break spaces are marked: init.blsp's `:nobreak-char-display`, true unless it
says false."
  (not (= false (:nobreak-char-display m))))

;; ---- words that mix scripts (homoglyphs) ------------------------------------------------
;; A Cyrillic `а` in `pаypal` passes for a Latin `a` (Emacs's textsec, VS Code's ambiguous
;; characters). A WORD that mixes scripts the way no real text does (brood's
;; `string/mixed-script?`, UTS #39) has its odd characters out — the ones not in the word's
;; most common script — marked in the hazard face a bidi control gets. Prose in two languages
;; is two sets of words, so it is never marked; a line of plain ASCII is skipped at once.

(defn- majority-script (characters)
  ;; the script most of `characters` (one-character strings) are written in
  (first (last (seq/sort-by (seq/frequencies (mapcat characters string/scripts)) second))))

(defn mixed-script-text-ranges (text base face)
  "The highlight ranges `[from to face]` of the characters that make a word of `text` mix
scripts (`string/mixed-script?`) — each character outside the word's most common script —
whose first character is at buffer offset `base`.

    (glyphless/mixed-script-text-ranges \"see p\\u{430}ypal\" 10 :hazard)   ;=> ([15 16 :hazard])
    (glyphless/mixed-script-text-ranges \"Привет world\" 0 :hazard)   ;=> ()"
  (if (not (regex/match? text "[^\\x00-\\x7f]"))
    '()
    ;; only a word holding a non-ASCII LETTER can mix scripts: a line's box drawing or a
    ;; spinner glyph (a terminal program's chrome) makes no plain word worth asking about
    (mapcat (seq/filter (regex/find-all text "\\w*[^\\W\\x00-\\x7f]\\w*")
              (fn (word) (string/mixed-script? (:text word))))
      (fn (word)
        (let (characters (vec (string/->list (:text word)))
              usual (majority-script characters))
          (seq/keep (range (count characters))
            (fn (index)
              (let (scripts (string/scripts (nth characters index)))
                (when (and (not (empty? scripts)) (not (includes? scripts usual)))
                  [(+ base (:start word) index) (+ base (:start word) index 1) face])))))))))

;; check-allow: as `ranges-at` above — the store only ever holds what the body built
(check-allow :trusted
  (defmemo mixed-script-ranges-at 4 (rope windows face)
    "[[mixed-script-text-ranges]] over each char range `[from to]` of `windows`, remembered on
what it reads."
    (mapcat windows
      (fn ([from to]) (mixed-script-text-ranges (text/slice rope from to) from face)))))

(defn mixed-script-shown? (m)
  "Whether words that mix scripts are marked: init.blsp's `:mixed-script-warning`, true unless
it says false."
  (not (= false (:mixed-script-warning m))))

(defn highlight-source (m pane buf context)
  "The registry row: [[ranges]], the no-break spaces when they are marked ([[nobreak-shown?]])
and the words that mix scripts ([[mixed-script-shown?]]) — a so-long buffer's line read over the
window the pane shows."
  ;; the visible windows found ONCE for the three checks: finding them is most of a warm paint's
  ;; cost here, each check's own answer being remembered on them
  (let (clip (when (solong/so-long? buf) (spancache/ed-fontify-clip pane buf))
        rope (buffer-rope buf)
        windows (spancache/ed-visible-windows rope (:top context) (:rows context) clip))
    (append (windows-ranges rope windows)
      (if (nobreak-shown? m) (nobreak-ranges-at rope windows face-nobreak-space) '())
      (if (mixed-script-shown? m) (mixed-script-ranges-at rope windows face-glyphless-bidi) '()))))

(defn highlight-deps (m pane buf)
  "What [[highlight-source]] reads off the model: the no-break and mixed-script switches. (The
glyphless display setting is in the pane's cell layout key.)"
  [(nobreak-shown? m) (mixed-script-shown? m)])

(register-highlight-source :glyphless
  {:rank 20 :run 'glyphless/highlight-source :deps 'glyphless/highlight-deps})

;; the init file's switch for this feature, declared beside it (config's registry)
(settings/define config/*settings*
  :mixed-script-warning {:default true
   :type 'bool
   :model-key :mixed-script-warning
   :commented? true
   :doc (str "mark the odd letters out of a word that mixes scripts the way a homoglyph does — a\n"
          "Cyrillic a inside a Latin word (Unicode TR39, brood's string/mixed-script?); false\n"
          "turns it off")})
