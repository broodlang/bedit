(defmodule languages/java
  "Java: a tree-sitter mode over tree-sitter-java."
  (:use languages/core))

;; ---- Java (tree-sitter-java, Emacs's java-ts-mode) --------------------------------------
;; A type's name, a primitive and an annotation are specials; a method or constructor's name
;; is a definition, and a called one — `greet(…)`, and `println` in `System.out.println(…)` —
;; a function, both the invocation's `name`. A string colours its quotes and text rather than
;; itself, so an embedded template's `\{…}` stays code; a text block (`"""`) is the same node.
;; The keywords are anonymous tokens the keyword rule colours unnamed.
(def java-face-table
  (merge
    {:line_comment :syntax/comment
     :block_comment :syntax/comment
     :string_fragment :syntax/string
     :multiline_string_fragment :syntax/string
     :escape_sequence :syntax/string
     {:parent :string_literal :kind (keyword "\"")} :syntax/string
     {:parent :string_literal :kind (keyword "\"\"\"")} :syntax/string
     {:parent :string_interpolation :kind (keyword "\\{")} :syntax/special
     {:parent :string_interpolation :kind (keyword "}")} :syntax/special
     :character_literal :syntax/string
     :decimal_integer_literal :syntax/number
     :hex_integer_literal :syntax/number
     :octal_integer_literal :syntax/number
     :binary_integer_literal :syntax/number
     :decimal_floating_point_literal :syntax/number
     :hex_floating_point_literal :syntax/number
     :true :syntax/constant
     :false :syntax/constant
     :null_literal :syntax/constant
     {:parent :enum_constant :field :name} :syntax/constant
     ;; named nodes, so the anonymous-keyword rule never sees them
     :this :syntax/keyword
     :super :syntax/keyword
     :type_identifier :syntax/special
     :integral_type :syntax/special
     :floating_point_type :syntax/special
     :boolean_type :syntax/special
     :void_type :syntax/special
     :marker_annotation :syntax/special
     {:parent :annotation :kind (keyword "@")} :syntax/special
     {:parent :method_invocation :field :name} :syntax/function}
    (field-faces [:annotation
                   :class_declaration :interface_declaration :enum_declaration :record_declaration
                   :annotation_type_declaration]
      :name :syntax/special)
    (field-faces [:method_declaration :constructor_declaration :compact_constructor_declaration]
      :name :syntax/definition)))

;; google-java-format's AOSP style: four columns, K&R braces. A `case` sits one deeper than
;; its `switch`, its statements one deeper again (the group is a bracket that opens on the
;; `case` line); an arrow case's block is a bracket of its own. A text block's lines are its
;; value. The formatter's +8 continuation of a wrapped expression is not a level the tree
;; opens, so it is not answered here.
(def java-indent-spec
  {:width 4
   :brackets #{:class_body
               :interface_body :enum_body :annotation_type_body :block
               :constructor_body :switch_block :switch_block_statement_group :argument_list
               :formal_parameters :array_initializer
               :element_value_array_initializer :annotation_argument_list :module_body}
   :opens #{"{" "(" "["}
   :verbatim #{:string_literal}})

;; a package, an import, a type or its annotation, a comment or a closing brace starts at
;; column 0; a block comment or a text block above may hold anything there
(def java-restart-rule
  {:item-start "^((package|import|module|open|public|protected|private|abstract|final|sealed|non-sealed|static|strictfp|class|interface|enum|record)\\b|@|//|\\})"
   :opaque [*block-comment-opaque* *triple-quote-opaque*]})

(deflanguage java
  {:lang :java
   :lsp {:servers [{:name "jdtls"
                    :extensions ["java"]
                    :commands [["jdtls" []]]
                    :root-markers ["pom.xml" "build.gradle" "build.gradle.kts" "settings.gradle"]}]}
   :pairs *quote-pairs*
   :strings (assoc *c-strings*
              :strings [{:open "\"\"\"" :multiline true} {:open "\""} {:open "'"}])
   :pattern "\\.java$"
   :faces java-face-table
   :indent java-indent-spec
   :restart java-restart-rule
   ;; `--aosp` is the four-column style this mode indents to; the default is Google's two
   :format ["google-java-format" "--aosp" "--replace"]
   :definitions {:kinds #{:class_declaration
                          :interface_declaration :enum_declaration
                          :record_declaration :annotation_type_declaration
                          :method_declaration :constructor_declaration
                          :compact_constructor_declaration}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-java"
             :revision "e10607b45ff745f5f876bfa3e94fbcc6b44bdc11"
             :fingerprint "6153010350396567cd27afcc2b348fd07eb71164cdfef46900a8de736e1f5f30"}
   :comment "// "})
