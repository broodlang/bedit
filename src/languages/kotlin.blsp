(defmodule languages/kotlin
  "Kotlin: a tree-sitter mode over fwcd/tree-sitter-kotlin."
  (:use languages/core))

;; ---- Kotlin (fwcd/tree-sitter-kotlin, Emacs's kotlin-ts-mode) ---------------------------
;; The grammar has almost no fields, so names are told apart by their parent: a function's
;; name is the `simple_identifier` directly under its declaration, a call's the one directly
;; under the call — or, for `obj.method()`, the suffix of the navigation the call applies.
;; A class, object or type's name is a `type_identifier`, a special. A soft keyword used as
;; a name (`value`, `data`, `get`) is a `simple_identifier` holding the keyword's token, kept
;; out of the keyword rule by the plain variable face.
;;
;; A string's quotes are not nodes, so the string is painted whole and its templates
;; (`$name`, `${…}`) are injected back as Kotlin: the code inside keeps its own colours.
(def- kotlin-soft-keywords
  ["expect"
    "data" "inner" "value" "actual" "set" "get" "override" "suspend" "annotation" "sealed"
    "lateinit" "tailrec" "operator" "infix" "inline" "external" "public"])

(def kotlin-face-table
  (merge (into {}
           (map kotlin-soft-keywords
             (fn (word) [{:parent :simple_identifier :kind (keyword word)} :syntax/variable])))
    {:line_comment :syntax/comment
     :multiline_comment :syntax/comment
     :shebang_line :syntax/comment
     :string_literal :syntax/string
     :character_literal :syntax/string
     :integer_literal :syntax/number
     :long_literal :syntax/number
     :hex_literal :syntax/number
     :bin_literal :syntax/number
     :unsigned_literal :syntax/number
     :real_literal :syntax/number
     :boolean_literal :syntax/constant
     :null_literal :syntax/constant
     {:parent :enum_entry :kind :simple_identifier} :syntax/constant
     :type_identifier :syntax/special
     {:parent :annotation :kind (keyword "@")} :syntax/special
     {:parent :file_annotation :kind (keyword "@")} :syntax/special
     {:parent :function_declaration :kind :simple_identifier} :syntax/definition
     {:parent :call_expression :kind :simple_identifier} :syntax/function
     {:kind :simple_identifier
      :parent {:kind :navigation_suffix
               :parent {:kind :navigation_expression :parent :call_expression}}} :syntax/function}))

(def- kotlin-string-templates
  [{:content :interpolated_expression :lang :kotlin}
    {:content :interpolated_identifier :lang :kotlin}])

;; ktfmt's `--kotlinlang-style`: four columns, continuation four. Braces mostly have no node of
;; their own, so the node around them is the bracket: a class or function body, a lambda, an
;; `if`/`for`/`when` branch's body, a `when`. A `try`'s body belongs to the `try` itself, so the
;; `try` is the bracket and its `catch` and `finally` are not: their bodies sit inside the `try`,
;; and their `} catch (…) {` line closes it. A property is a bracket, for the value ktfmt breaks
;; onto the next line after `=`; a navigation is one, for a chain broken before its `.call()`,
;; and so is a call, so a trailing lambda on a `.forEach {` line of such a chain nests under it.
;; A lambda with its parameters on the `{` line (`{ item ->`) HANGS: what follows its `{` is a
;; header, not a first item, so its body goes one level in (`:hanging`, brood ADR-758; a brood
;; before it aligns the body under the parameters).
(def kotlin-indent-spec
  {:width 4
   :brackets #{:class_body
               :enum_class_body :function_body :lambda_literal :control_structure_body
               :when_expression :try_expression :anonymous_initializer :getter
               :setter :value_arguments :function_value_parameters :primary_constructor
               :collection_literal :indexing_suffix :type_arguments :type_parameters
               :parenthesized_expression :property_declaration
               :navigation_expression :call_expression}
   :hanging #{:lambda_literal}
   :opens #{"{" "(" "[" "->"}
   :verbatim #{:string_literal}})

;; a package, an import, a declaration or its annotation, a comment or a closing brace starts
;; at column 0; a block comment or a raw string above may hold anything there
(def kotlin-restart-rule
  {:item-start "^((package|import|public|private|internal|protected|open|abstract|sealed|final|data|enum|inline|value|annotation|inner|class|interface|object|fun|val|var|typealias|const|suspend|override|expect|actual|tailrec|operator|infix)\\b|@|//|\\})"
   :opaque [*block-comment-opaque* *triple-quote-opaque*]})

(deflanguage kotlin
  {:lang :kotlin
   :lsp {:id "kotlin"
         :servers [{:name "kotlin-language-server"
                    :commands [["kotlin-lsp" ["--stdio"]] ["kotlin-language-server" []]]
                    :root-markers ["settings.gradle.kts"
                                    "settings.gradle" "build.gradle.kts" "pom.xml"]}]}
   :pairs *quote-pairs*
   :strings (assoc *c-strings*
              :strings [{:open "\"\"\"" :multiline true :raw true} {:open "\""} {:open "'"}])
   :pattern "\\.(kt|kts)$"
   :names ["kt" "kts"]
   :faces kotlin-face-table
   :injections kotlin-string-templates
   :indent kotlin-indent-spec
   :restart kotlin-restart-rule
   :format [["ktfmt" "--kotlinlang-style"] ["ktlint" "-F"]]
   :definitions {:kinds #{:class_declaration
                          :object_declaration :companion_object
                          :function_declaration :secondary_constructor}}
   :grammar {:url "https://github.com/fwcd/tree-sitter-kotlin"
             :revision "d6af96d2e23ef0a8ff5ab512864378cf08fba311"
             :fingerprint "c515ca321f5a9693f0d8fb964738ce8b94ce16dbc1f10e4f20d2a180e14531d1"}
   :comment "// "})
