(defmodule languages/julia
  "Julia: a tree-sitter mode over tree-sitter-julia, its blocks closed by `end`."
  (:use languages))

;; ---- Julia (tree-sitter-julia, Emacs's julia-ts-mode) -----------------------------------
;; The grammar has almost no fields, so names are told apart by position: a function's or a
;; macro's name is the first identifier of the call in its `signature` (behind a `where` or a
;; return type too), and a one-line `f(x) = …`'s the first of the call on the assignment's
;; left; both are definitions. A called name is a function, and so is the method of
;; `Base.print(…)`. A module's, a struct's and an abstract type's name, a type annotation's
;; type, a type parameter and a macro are specials. A string is painted whole — its closing
;; `"""` is no node of its own, so it could not be coloured otherwise — and its `$name` and
;; `$(…)` are injected back as Julia, so the code inside keeps its own colours. A raw or
;; prefixed string and a command are painted whole too. `function`, `end`, `struct`, `do` and
;; the rest are anonymous tokens the keyword rule colours.
(def- julia-signature-call
  [{:kind :call_expression :parent :signature}
    {:kind :call_expression :parent {:kind :where_expression :nth 0 :parent :signature}}
    {:kind :call_expression :parent {:kind :typed_expression :nth 0 :parent :signature}}
    {:kind :call_expression :nth 0 :parent :assignment}])

(def julia-face-table
  (merge (into {}
           (map julia-signature-call
             (fn (call) [{:kind :identifier :nth 0 :parent call} :syntax/definition])))
    {:line_comment :syntax/comment
     :block_comment :syntax/comment
     :string_literal :syntax/string
     {:parent :interpolation_expression :kind (keyword "$")} :syntax/special
     :escape_sequence :syntax/string
     :prefixed_string_literal :syntax/string
     :command_literal :syntax/string
     :prefixed_command_literal :syntax/string
     :character_literal :syntax/string
     :integer_literal :syntax/number
     :float_literal :syntax/number
     :boolean_literal :syntax/constant
     :quote_expression :syntax/constant
     {:kind :identifier :text #{"nothing" "missing" "Inf" "NaN"}} :syntax/constant
     :break_statement :syntax/keyword
     :continue_statement :syntax/keyword
     ;; a module's closing `end` seen from a window cut inside its unindented body, which no
     ;; `module` opens: the stray word is still the keyword (the restart, `julia-restart-rule`)
     {:kind :identifier :text "end" :parent :source_file} :syntax/keyword
     :macro_identifier :syntax/special
     {:parent :module_definition :field :name} :syntax/special
     {:parent :type_head :kind :identifier} :syntax/special
     {:kind :identifier :parent {:kind :binary_expression :parent :type_head}} :syntax/special
     {:kind :identifier :nth 0 :parent :parametrized_type_expression} :syntax/special
     {:parent :curly_expression :kind :identifier} :syntax/special
     {:kind :identifier :nth 1 :parent :typed_expression} :syntax/special
     {:parent :unary_typed_expression :kind :identifier} :syntax/special
     {:kind :identifier :nth 0 :parent :call_expression} :syntax/function
     {:kind :identifier :nth 0 :parent :broadcast_call_expression} :syntax/function
     {:kind :identifier
      :nth 1
      :parent {:kind :field_expression :nth 0 :parent :call_expression}} :syntax/function}))

(def- julia-string-interpolations [{:content :string_interpolation :lang :julia}])

;; JuliaFormatter's defaults: four columns, and a module's body NOT indented
;; (`indent_submodule = false`), so the indent counts the constructs rather than their
;; `block`s: each opens a level on the lines after its first, and the `end`, `elseif`,
;; `else`, `catch` and `finally` that continue or close it back out of it. A clause is not a
;; level of its own — its body is its statement's.
(def julia-indent-spec
  {:width 4
   :brackets #{:function_definition
               :macro_definition :struct_definition :if_statement :for_statement
               :while_statement :let_statement :do_clause :try_statement
               :quote_statement :compound_statement :argument_list :vector_expression
               :tuple_expression :parenthesized_expression :curly_expression :matrix_expression
               :comprehension_expression}
   :dedent {"end" 1 "elseif" 1 "else" 1 "catch" 1 "finally" 1}
   ;; the keyword blocks, for a half-typed buffer whose parse is broken (brood ADR-762)
   :pairs {"function" "end"
           "macro" "end"
           "struct" "end"
           "module" "end"
           "if" "end"
           "for" "end"
           "while" "end"
           "let" "end"
           "try" "end"
           "do" "end"
           "begin" "end"
           "quote" "end"}
   :opens #{"(" "[" "{"}
   :verbatim #{:string_literal :prefixed_string_literal :block_comment}})

;; a module, a definition, a using, an import, an export, a const, a docstring, a macro call or
;; a comment starts at column 0 — not an `end`, where a window would open on a stray closer (a
;; module's, inside whose unindented body every cut lies, still paints as the keyword: the face
;; table's stray `end`); a triple-quoted string or a block comment above
;; may hold anything there
(def julia-restart-rule
  {:item-start "^((module|baremodule|function|macro|struct|mutable|abstract|primitive|using|import|export|const)\\b|@|#|\"\"\")"
   :opaque [*triple-quote-opaque* {:open "#=" :close "=#"}]})

(deflanguage julia
  {:lang :julia
   :lsp {:id "julia"
         :servers [{:name "julia"
                    :commands [["julia"
                                 ["--startup-file=no"
                                   "--history-file=no" "-e" "using LanguageServer; runserver()"]]]
                    :root-markers ["Project.toml" "JuliaProject.toml"]}]}
   :pairs *quote-pairs*
   :strings {:strings [{:open "\"\"\"" :multiline true} {:open "\"" :multiline true}]
             :char-literal "'"
             :comments ["#"]
             :block-comments [["#=" "=#"]]}
   :pattern "\\.jl$"
   :names ["jl"]
   :interpreters ["julia"]
   :faces julia-face-table
   :injections julia-string-interpolations
   :indent julia-indent-spec
   :restart julia-restart-rule
   :electric-indent "^(end|else|elseif|catch|finally)$"
   ;; JuliaFormatter runs from Julia (`format_file`), not a command line, so none here
   :definitions {:kinds #{:function_definition
                          :macro_definition :struct_definition
                          :abstract_definition :module_definition}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-julia"
             :revision "e0f9dcd180fdcfcfa8d79a3531e11d99e79321d3"
             :fingerprint "1f4da722f9b3546e74899d86faebae725bbe1198f14c704fc3907ea884045a0a"}
   :comment "# "})
