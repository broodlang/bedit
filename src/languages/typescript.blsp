(defmodule languages/typescript
  "TypeScript: JavaScript's spec (`languages/javascript`) over tree-sitter-typescript; TSX extends it."
  (:use languages/core))

;; ---- TypeScript (tree-sitter-typescript's `typescript` grammar) ------------------------------

(def ts-face-table
  (merge languages/javascript/js-face-table
    {:type_identifier :syntax/special
     :predefined_type :syntax/special
     :literal_type :syntax/special}))

;; TypeScript's grammar has no JSX — naming its nodes there named nothing the grammar has
;; (`grammarcheck` found them) — so plain TypeScript drops them and TSX puts them back
(def ts-indent-spec
  (assoc languages/javascript/js-indent-spec
    :brackets
      (into (set/difference (get languages/javascript/js-indent-spec :brackets)
              languages/javascript/jsx-brackets)
        #{:interface_body :enum_body :object_type :type_arguments :type_parameters})))

(def ts-definitions
  {:kinds (into (get languages/javascript/js-definitions :kinds)
            #{:interface_declaration
              :type_alias_declaration :enum_declaration :abstract_class_declaration :module})})

;; TypeScript is JavaScript's spec with its own grammar, faces, indent and definitions; TSX is
;; TypeScript's with the JSX grammar — the formatter, restart rule and comment come along
(deflanguage typescript
  (merge languages/javascript/javascript-spec
    {:lang :typescript
     :lsp {:ids {"ts" "typescript" "mts" "typescript" "cts" "typescript"}
           :servers [{:name "typescript"
                      :extensions ["ts" "mts" "cts"]
                      :commands [["typescript-language-server" ["--stdio"]]]
                      :root-markers ["tsconfig.json" "jsconfig.json" "package.json"]
                      :shared true}]}
     :pattern "\\.(ts|mts|cts)$"
     :names ["ts" "mts" "cts"]
     ;; node, deno and bun scripts are JavaScript's: TypeScript claims no `#!` name
     :interpreters []
     :faces ts-face-table
     :indent ts-indent-spec
     :definitions ts-definitions
     :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript"
               :subdir "typescript"
               :revision "75b3874edb2dc714fb1fd77a32013d0f8699989f"
               :fingerprint "0e9b9ffa6fbab47b509a6434eab282d6b65c7e5d10b568273fe747eefe8c6f04"}}))
