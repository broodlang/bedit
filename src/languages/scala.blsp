(defmodule languages/scala
  "Scala: a tree-sitter mode over tree-sitter-scala, Scala 3's indentation-based bodies too."
  (:use languages/core))

;; ---- Scala (tree-sitter-scala, Emacs's scala-ts-mode) -----------------------------------
;; A class, object, trait or enum's name is a special, as is every type; a `def`'s name is a
;; definition, and a called one — `greet(…)`, and `println` in `Console.println(…)` — a
;; function, as is a string's interpolator (`s"…"`). `this` and `super` are identifiers in
;; this grammar, so they are named by their text. An interpolated string's text is not a node,
;; so the string is painted whole and its `$name` and `${…}` are injected back as Scala.
(def scala-face-table
  (merge {:comment :syntax/comment
          :block_comment :syntax/comment
          :string :syntax/string
          :interpolated_string :syntax/string
          :character_literal :syntax/string
          :integer_literal :syntax/number
          :floating_point_literal :syntax/number
          :boolean_literal :syntax/constant
          :null_literal :syntax/constant
          {:kind :identifier :text #{"this" "super"}} :syntax/keyword
          :type_identifier :syntax/special
          {:parent :annotation :kind (keyword "@")} :syntax/special
          {:parent :call_expression :field :function :kind :identifier} :syntax/function
          {:parent :generic_function :field :function :kind :identifier} :syntax/function
          {:parent :interpolated_string_expression :field :interpolator} :syntax/function}
    (field-faces [:simple_enum_case :full_enum_case] :name :syntax/constant)
    (field-faces [:class_definition :object_definition :trait_definition :enum_definition]
      :name :syntax/special)
    (field-faces [:function_definition :function_declaration :given_definition]
      :name :syntax/definition)
    (method-call-faces [{:kind :identifier :field :field :of :field_expression}])))

(def- scala-string-templates
  [{:content {:kind :block :parent :interpolation} :lang :scala}
    {:content {:kind :identifier :parent :interpolation} :lang :scala}])

;; scalafmt's defaults: two columns; a call's continued arguments one level in, a definition's
;; parameters two (`continuationIndent.defnSite = 4`) — the parameter list is a bracket and each
;; parameter a block, which always counts. A body after `=` or `=>` on the next line is an
;; `indented_block`, which begins at that body (Scala 3's braceless bodies are the same node),
;; so it is a block too; a `case`'s statements are its clause's. A lambda with its parameter
;; on the `{` line (`{ item =>`) HANGS (brood ADR-758): its body goes one level in, and the
;; `indented_block` holding that body shares the brace's level rather than adding one.
(def scala-indent-spec
  {:width 2
   :blocks #{:indented_block :indented_cases :parameter :class_parameter}
   :brackets #{:template_body
               :enum_body :block :case_block :case_clause :arguments :parameters
               :class_parameters :type_parameters :type_arguments :parenthesized_expression
               :tuple_expression :enumerators}
   :hanging #{:block}
   :opens #{"{" "(" "[" "=" "=>"}
   :verbatim #{:string :interpolated_string}})

;; a package, an import, a definition or its annotation, a comment or a closing brace starts at
;; column 0; a block comment or a triple-quoted string above may hold anything there
(def scala-restart-rule
  {:item-start "^((package|import|export|object|class|trait|enum|case|abstract|sealed|final|implicit|lazy|private|protected|override|def|val|var|type|given|extension|opaque|inline|open|transparent)\\b|@|//|\\})"
   :opaque [*block-comment-opaque* *triple-quote-opaque*]})

(deflanguage scala
  {:lang :scala
   :lsp {:ids {"scala" "scala" "sc" "scala" "sbt" "scala"}
         :servers [{:name "metals"
                    :extensions ["scala" "sc" "sbt"]
                    :commands [["metals" []]]
                    :root-markers ["build.sbt" "build.sc" "build.mill" "project.scala"]}]}
   :pairs *quote-pairs*
   ;; C's comments; `'x'` is a character, `'sym` a symbol
   :strings (assoc *c-strings*
              :strings [{:open "\"\"\"" :multiline true :raw true} {:open "\""}]
              :char-literal "'")
   :pattern "\\.(scala|sc|sbt)$"
   :names ["sc" "sbt"]
   :faces scala-face-table
   :injections scala-string-templates
   :indent scala-indent-spec
   :restart scala-restart-rule
   :format ["scalafmt"]
   :definitions {:kinds #{:class_definition
                          :object_definition :trait_definition :enum_definition :function_definition
                          :given_definition :extension_definition}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-scala"
             :revision "91cdff7829b1e49567379aa0c2200cf2366faed1"
             :fingerprint "cca1f1bb930f29cd11779c9b624f0ea51721554eff62755dfc8634364acfa631"}
   :comment "// "})
