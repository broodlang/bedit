(defmodule languages/scheme
  "Scheme and Racket: `deflisp` over Scheme's special forms, indented by the elisp / Common Lisp
rule (special forms +2, calls aligned under the first argument, `lisp-indent-with`)."
  (:use languages :only [deflisp head-set lisp-indent-with]))

(def scheme-special-forms
  (head-set ["define"
              "define-syntax" "define-record-type" "define-values" "define-macro" "define-module"
              "lambda" "λ" "case-lambda" "let" "let*" "letrec" "letrec*" "let-values" "let*-values"
              "let-syntax" "letrec-syntax" "named-lambda" "if" "when" "unless" "cond" "case" "and"
              "or" "not" "do" "begin" "delay" "force" "set!" "quote" "quasiquote" "unquote"
              "syntax-rules" "syntax-case" "guard" "dynamic-wind" "call/cc"
              "call-with-current-continuation" "parameterize" "assert" "import" "export" "library"
              "require" "provide" "module" "struct" "match" "for" "for/list" "for/fold"
              "define-struct" "else"]))

(def scheme-indents
  ;; Emacs's `scheme-indent-function` properties: `if`, `and` and `or` align as calls though
  ;; they colour as keywords, and the first N arguments of a head with distinguished ones sit
  ;; +4 on a line of their own, its body +2
  {"if" :call
   "and" :call
   "or" :call
   "case" 1
   "do" 2
   "lambda" 1
   "let*" 1
   "letrec" 1
   "letrec*" 1
   "let-values" 1
   "let*-values" 1
   "when" 1
   "unless" 1
   "parameterize" 1
   "syntax-rules" 1
   "syntax-case" 2
   "guard" 1
   "call-with-values" 1
   "dynamic-wind" 3})

(defn scheme-indent (text bol)
  "The Scheme / Racket `:indent` service: the Lisp rule over `scheme-special-forms`, refined by
`scheme-indents`."
  (lisp-indent-with scheme-special-forms text bol scheme-indents))

(deflisp scheme
  {:pattern "\\.(scm|ss|sld|sls|rkt|rktl)$"
   :specials languages/scheme/scheme-special-forms
   :indent 'languages/scheme/scheme-indent
   :names ["racket" "scm" "rkt" "guile"]
   :interpreters ["guile" "racket" "chez" "scheme" "csi"]
   :comment ";; "})
