(defmodule languages/cpp
  "C++: a tree-sitter mode over tree-sitter-cpp, C's spec (`languages/c`) extended."
  (:use languages))

;; ---- C++ (tree-sitter-cpp, Emacs's c++-ts-mode) ----------------------------------------
;; The grammar extends C's, and so does the mode: C's spec is the base — its pairs, strings,
;; formatter and comment, and its tables extended. A type, a literal, a directive and a call
;; colour the same. C++ adds a qualified name — `Foo::bar()` called or defined, and `std::`
;; itself — a template's name, an in-class method's name, `this`, `auto` and a raw string. The
;; keywords (`class`, `template`, `namespace`, …) are anonymous tokens the keyword rule
;; colours unnamed. `.h` stays C, as in Emacs.
(def cpp-face-table
  (merge languages/c/c-face-table
    {:raw_string_literal :syntax/string
     :this :syntax/keyword
     :auto :syntax/special
     :namespace_identifier :syntax/special
     ;; a template's name, and `obj.get<T>()`'s `get`
     {:parent :template_function :field :name} :syntax/function
     {:parent :template_method :field :name} :syntax/function
     ;; `void Foo::bar()`'s `bar`, a method declared in its class, and a destructor
     {:kind :identifier :field :name :parent {:kind :qualified_identifier :field :declarator}} :syntax/definition
     {:parent :function_declarator :field :declarator :kind :field_identifier} :syntax/definition
     {:parent :function_declarator :field :declarator :kind :destructor_name} :syntax/definition}
    ;; `std::sort(…)`'s `sort`
    (method-call-faces [{:kind :identifier :field :name :of :qualified_identifier}])))

;; C's layout, and a class's body one level in — a template's lists are brackets too. A
;; namespace's body and an `extern "C"` block (a `declaration_list`) stay at column 0, as
;; clang-format's LLVM, Google and Mozilla styles all write them. An access specifier
;; (`public:`) sits at its class's own level, as `case` sits at its switch's.
(def cpp-indent-spec
  (assoc languages/c/c-indent-spec
    :brackets
      (into (get languages/c/c-indent-spec :brackets)
        #{:template_argument_list :template_parameter_list})
    :dedent (into (get languages/c/c-indent-spec :dedent) #{"public" "private" "protected"})))

;; C's item start but an access label (`public:` at column 0 is inside a class: a window cut
;; there loses the class) or a line comment (clang-format puts one above an access label at the
;; label's column 0, inside the class) — and a block comment or a raw string, `R"(…)"`, spans lines
(def cpp-restart-rule
  (assoc languages/c/c-restart-rule
    :item-start
      {:match (:item-start languages/c/c-restart-rule)
       :except "^((public|private|protected)\\s*:|//)"}
    :opaque [*block-comment-opaque* {:open "R\"[^(\\s]*\\(" :close "\\)[^)\\s]*\""}]))

(deflanguage cpp
  (merge languages/c/c-spec
    {:lang :cpp
     ;; clangd, as C's: one server per project serves both
     :lsp {:id "cpp"
           :servers [{:name "clangd"
                      :commands [["clangd" []]]
                      :root-markers ["compile_commands.json" ".clangd" "CMakeLists.txt" "Makefile"]}]}
     :pattern "\\.(cc|cpp|cxx|c\\+\\+|hh|hpp|hxx|h\\+\\+|ipp|tpp|inl)$"
     :names ["c++" "cxx" "cc" "hpp"]
     :faces cpp-face-table
     :indent cpp-indent-spec
     :restart cpp-restart-rule
     ;; `case` / `default` as C's, and an access label backs out of its class body as they do
     :electric-indent "^(case\\b.*|default|public|private|protected)\\s*:$"
     ;; Emacs c++-ts-mode's defun types: C's, and a class's and a namespace's bodies hold
     ;; definitions
     :definitions (update (get languages/c/c-spec :definitions)
                    :kinds into
                    #{:class_specifier :namespace_definition :template_declaration})
     :grammar {:url "https://github.com/tree-sitter/tree-sitter-cpp"
               :revision "c009222808634c1014f82438d4883753516a2c24"
               :fingerprint "f1f2774f70d2419edee6a27e02b67623e6d7cb4ef43fa8d9288783a156533de6"}}))
