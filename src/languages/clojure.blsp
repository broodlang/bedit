(defmodule languages/clojure
  "Clojure, ClojureScript, EDN and Babashka: `deflisp` over Clojure's special forms. Brood's
indent rule (body +2, `let`-family bindings aligned) is Clojure's own convention."
  (:use languages :only [deflisp head-set]))

(def clojure-special-forms
  (head-set ["def"
              "defn" "defn-" "defmacro" "defmulti" "defmethod" "defprotocol" "defrecord" "deftype"
              "defonce" "definterface" "ns" "fn" "let" "letfn" "if" "if-let" "if-not" "if-some"
              "when" "when-let" "when-not" "when-some" "cond" "condp" "case" "do" "loop" "recur"
              "for" "doseq" "dotimes" "while" "try" "catch" "finally" "throw" "quote" "var" "set!"
              "binding" "with-open" "with-redefs" "and" "or" "not" "->" "->>" "as->" "some->"
              "some->>" "cond->" "cond->>" "comment" "import" "require" "use" "declare" "delay"
              "future" "lazy-seq" "reify" "proxy" "extend-protocol" "extend-type"]))

(deflisp clojure
  {:pattern "\\.(clj|cljs|cljc|cljx|edn|bb)$"
   :specials languages/clojure/clojure-special-forms
   :comment ";; "
   ;; a Babashka script: `#!/usr/bin/env bb`
   :interpreters ["bb"]
   :names ["clj" "cljs" "cljc" "clojurescript" "edn"]
   ;; clojure-lsp serves Clojure, ClojureScript, EDN and Babashka alike, from the project's
   ;; deps.edn, Leiningen, Babashka or shadow-cljs file
   :lsp {:id "clojure"
         :servers [{:name "clojure-lsp"
                    :commands [["clojure-lsp" []]]
                    :root-markers ["deps.edn" "project.clj" "bb.edn" "shadow-cljs.edn"]}]}})
