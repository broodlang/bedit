(defmodule languages/heex
  "HEEx: a tree-sitter mode over tree-sitter-heex, for Phoenix templates (and Elixir's `~H`)."
  (:use languages))

;; ---- HEEx: Phoenix templates, in `.heex` files and inside Elixir's `~H` ------------------
;; A modest table: tags, components and slots by name, attributes, strings, comments, and
;; the delimiters of embedded Elixir (`{…}`, `<%= … %>`) — the Elixir inside is injected
;; (`heex-injections`) in a template file, and stays plain inside Elixir's `~H`,
;; since injections do not nest (brood ADR-489).
(def heex-face-table
  {:tag_name :syntax/keyword
   :component_name :syntax/function
   :slot_name :syntax/function
   :attribute_name :syntax/special
   :quoted_attribute_value :syntax/string
   :comment :syntax/comment
   {:parent :expression :kind (keyword "{")} :syntax/special
   {:parent :expression :kind (keyword "}")} :syntax/special
   {:parent :directive :kind (keyword "<%")} :syntax/special
   {:parent :directive :kind (keyword "<%=")} :syntax/special
   {:parent :directive :kind (keyword "%>")} :syntax/special})

;; the Elixir in a `{…}` and a `<%= … %>` is Elixir — a block's `<%= if … do %>`, `<% else %>` and
;; `<% end %>` each a fragment of one, which the Elixir grammar colours as far as it parses
(def heex-injections
  [{:content :expression_value :lang :elixir}
    {:content :partial_expression_value :lang :elixir}
    {:content :ending_expression_value :lang :elixir}])

;; a tag, component or slot is one level, and a line opening with `</` backs out of it, as
;; JSX's does (`js-indent-spec`) — only `)]}` close by themselves
(def heex-indent-spec
  {:width 2
   :brackets #{:tag :component :slot}
   :dedent #{"</"}
   :opens #{}
   ;; `<%= if … do %>`, `<% else %>` and `<% end %>` are SIBLING directives, so no node encloses
   ;; the block between them: the keyword pairs open its level (brood ADR-767). The grammar
   ;; spells the `end` as a named leaf, so its kind is the closer
   :pairs {"do" "ending_expression_value"}
   ;; `<% else %>` re-opens its `do` — a directive's word, never a line of text starting "else" —
   ;; and a `case`'s `<% 1 -> %>` opens a clause the next one, or the `end`, closes
   :middles #{"else"}
   :clauses #{"->"}
   :token-blocks true})

(deflanguage heex
  {:lang :heex
   ;; Expert, Elixir's server: a template is part of the project it builds
   :lsp {:id "phoenix-heex"
         :servers [{:name "expert"
                    :commands [["expert" ["--stdio"]]]
                    :root-markers ["mix.lock" "mix.exs"]}]}
   ;; Emacs heex-ts-mode's: an `.eex` and a LiveView `.leex` template are the same `<%= … %>` in
   ;; HTML, which the HEEx grammar parses
   :pattern "\\.[hl]?eex$"
   :faces heex-face-table
   :injections heex-injections
   :indent heex-indent-spec
   ;; a closing tag leaves its element as it is typed, as `}` leaves a block, and a directive's
   ;; `end`, `else` or clause `->` leaves its `do` or clause
   :electric-indent ["^</" "^<%-?\\s*(end|else)\\b" "^<%.*->"]
   ;; a block comment only, as HTML's: HEEx's own `<%!-- … --%>`, which M-; writes and HTML's
   ;; `<!-- -->` would leave in the rendered page
   :comment-block ["<%!-- " " --%>"]
   :grammar {:url "https://github.com/phoenixframework/tree-sitter-heex"
             :revision "5842537f734d7c12685bf27d6005313e3e5a47a0"
             :fingerprint "855c9be034fb996defef1bf4769c69a0840771801381736985ef9a73f9cfdd92"}})
