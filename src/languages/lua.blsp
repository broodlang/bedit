(defmodule languages/lua
  "Lua: a tree-sitter mode over tree-sitter-lua, its blocks closed by `end`."
  (:use languages))

;; ---- Lua (tree-sitter-grammars/tree-sitter-lua, Emacs's lua-ts-mode) --------------------
;; A function's name is a definition — `f`, the `greet` of `M.greet` and the `shout` of
;; `Greeter:shout` — and a called one a function, by the same three shapes under a call's
;; `name`. A string is painted whole (Lua has no interpolation), long brackets too. The
;; keywords — `function`, `local`, `then`, `end`, `until` — are anonymous tokens the keyword
;; rule colours unnamed; `break` is a named node, so it is listed.
(def lua-face-table
  {:comment :syntax/comment
   :hash_bang_line :syntax/comment
   :string :syntax/string
   :number :syntax/number
   :true :syntax/constant
   :false :syntax/constant
   :nil :syntax/constant
   :vararg_expression :syntax/constant
   :break_statement :syntax/keyword
   {:kind :identifier :text #{"self"}} :syntax/keyword
   {:parent :function_declaration :field :name :kind :identifier} :syntax/definition
   {:kind :identifier
    :field :field
    :parent {:kind :dot_index_expression :field :name :parent :function_declaration}} :syntax/definition
   {:kind :identifier
    :field :method
    :parent {:kind :method_index_expression :field :name :parent :function_declaration}} :syntax/definition
   {:parent :function_call :field :name :kind :identifier} :syntax/function
   {:kind :identifier
    :field :field
    :parent {:kind :dot_index_expression :field :name :parent :function_call}} :syntax/function
   {:kind :identifier
    :field :method
    :parent {:kind :method_index_expression :field :name :parent :function_call}} :syntax/function})

;; StyLua's layout, at two spaces: every body is a `block` that begins at its first statement
;; and stops before the `end`, `else`, `elseif` or `until` that follows it, so those lines are
;; already outside it and back out nothing. A table, an argument list and a parameter list are
;; brackets.
(def lua-indent-spec
  {:width 2
   :blocks #{:block}
   :brackets #{:table_constructor :arguments :parameters :parenthesized_expression}
   :dedent {"end" 0 "else" 0 "elseif" 0 "until" 0}
   :opens #{"then" "do" "else" "repeat" "{" "(" "["}
   :verbatim #{:string :comment}})

;; a local, a function, a return or a comment starts at column 0 — not the `end` closing one,
;; which a window cut there reads as a stray word; a long string or a block
;; comment above may hold anything there
(def lua-restart-rule
  {:item-start "^((local|function|return)\\b|--)"
   :opaque [{:open "\\[=*\\[" :close "\\]=*\\]"}]})

(deflanguage lua
  {:lang :lua
   :lsp {:id "lua"
         :servers [{:name "lua-language-server"
                    :commands [["lua-language-server" []]]
                    :root-markers [".luarc.json" ".luarc.jsonc" ".stylua.toml" "stylua.toml"]}]}
   :pairs *quote-pairs*
   :strings {:strings [{:open "\""} {:open "'"}]
             :comments ["--"]
             :block-comments [["--[[" "]]"]]}
   :pattern "\\.lua$"
   :interpreters ["lua" "luajit"]
   :faces lua-face-table
   :indent lua-indent-spec
   :restart lua-restart-rule
   :electric-indent "^(end|else|elseif|until)$"
   :format ["stylua"]
   :definitions {:kinds #{:function_declaration}}
   :grammar {:url "https://github.com/tree-sitter-grammars/tree-sitter-lua"
             :revision "10fe0054734eec83049514ea2e718b2a56acd0c9"
             :fingerprint "52f74f851da38b94070ab8ece35f1085914498605862236c400517a34ceb5c0f"}
   :comment "-- "})
