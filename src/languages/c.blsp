(defmodule languages/c
  "C: a tree-sitter mode over tree-sitter-c; C++ extends its spec (`languages/cpp`)."
  (:use languages))

;; ---- C (tree-sitter-c, Emacs's c-ts-mode) -----------------------------------------------

(def c-face-table
  (merge
    {:comment :syntax/comment
     :string_literal :syntax/string
     :system_lib_string :syntax/string
     :char_literal :syntax/string
     :number_literal :syntax/number
     :true :syntax/constant
     :false :syntax/constant
     :null :syntax/constant
     :primitive_type :syntax/special
     :type_identifier :syntax/special
     ;; a directive the grammar does not know
     :preproc_directive :syntax/keyword
     ;; the name a function declarator declares (brood ADR-486) — `area` in `static int
     ;; area(…)`, a prototype's too
     {:parent :function_declarator :field :declarator :kind :identifier} :syntax/definition}
    ;; a called function, and a call through a struct's function pointer (`ops->open(f)`),
    ;; not a field read (ADR-487)
    (call-faces [{:kind :field_identifier :field :field :of :field_expression}])
    ;; `#include`, `#define`, … are ANONYMOUS tokens beginning with `#`, which the keyword
    ;; rule (a token beginning with a letter) cannot see — so they are named here by kind
    (token-faces ["#include"
                   "#define" "#if" "#ifdef" "#ifndef" "#elif" "#elifdef" "#elifndef" "#else"
                   "#endif"]
      :syntax/keyword)))

;; Four columns (K&R and most C; clang-format's LLVM default is two), and a `case` at the
;; `switch`'s level with its statements one deeper — the switch body is a block like any
;; other, and `case` / `default` back out of it.
(def c-indent-spec
  {:width 4
   :brackets #{:compound_statement
               :field_declaration_list :enumerator_list :initializer_list :argument_list
               :parameter_list :parenthesized_expression}
   :dedent #{"case" "default"}})

;; a column-0 line in C that is not code is inside a block comment; a declaration starts
;; with a word, a preprocessor line with `#`
(def c-restart-rule
  {:item-start "^([A-Za-z_#]|//|\\})"
   :opaque *block-comment-opaque*})

(deflanguage c
  {:lang :c
   :lsp {:id "c"
         :servers [{:name "clangd"
                    :commands [["clangd" []]]
                    :runs-project-code false
                    :root-markers ["compile_commands.json" ".clangd" "CMakeLists.txt" "Makefile"]}]}
   :pairs *quote-pairs*
   :strings *c-strings*
   :pattern "\\.[ch]$"
   :names ["h"]
   :faces c-face-table
   :indent c-indent-spec
   :restart c-restart-rule
   :electric-indent *case-label-electric*
   :format ["clang-format" "-i"]
   :definitions {:kinds #{:function_definition :struct_specifier :enum_specifier :union_specifier}
                 :name-fields #{:declarator :name}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-c"
             :revision "b780e47fc780ddc8da13afa35a3f4ed5c157823d"
             :fingerprint "1b3241a110c726dfd0b176b11aff60ec2a13640be4d695e6c2dfe278e9de5cbc"}
   ;; the characters besides letters and digits Emacs's mode puts in a word (brood ADR-774)
   :word-chars "$"
   :comment "// "})
