(defmodule languages/r
  "R: a tree-sitter mode over r-lib/tree-sitter-r."
  (:use languages/core))

;; ---- R (r-lib/tree-sitter-r, Emacs's r-ts-mode in ESS) ----------------------------------
;; A called function is a function — `f(…)`, and the `median` of `stats::median(…)`, whose
;; package is a special. R defines a function by assigning one (`greet <- function(…)`), and a
;; selector cannot yet say "the left side of an assignment whose right side is a function", so
;; the name it defines is left plain rather than every assigned name taking the definition
;; face. `function`, `if`, `else`, `for`, `in`, `while` and `repeat` are anonymous tokens the
;; keyword rule colours; `next` and `break` are named nodes, so they are listed.
(def r-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :complex :syntax/number
   :true :syntax/constant
   :false :syntax/constant
   :null :syntax/constant
   :na :syntax/constant
   :inf :syntax/constant
   :nan :syntax/constant
   :dots :syntax/constant
   :dot_dot_i :syntax/constant
   :next :syntax/keyword
   :break :syntax/keyword
   {:parent :call :field :function :kind :identifier} :syntax/function
   {:kind :identifier
    :field :rhs
    :parent {:kind :namespace_operator :field :function :parent :call}} :syntax/function
   {:parent :namespace_operator :field :lhs} :syntax/special})

;; The tidyverse style (styler): two columns. A body, an argument list and a parameter list
;; are brackets, and so is a binary operator, for the continuation of a pipe broken after its
;; `|>` or `%>%`; an assignment whose value opens a bracket on the same line counts once.
(def r-indent-spec
  {:width 2
   :brackets #{:braced_expression
               :arguments :parameters :parenthesized_expression :binary_operator}
   :opens #{"{" "(" "[" "|>" "%>%" "+"}
   :verbatim #{:string}})

;; an assignment, a library call, a comment or a closing brace starts at column 0; R strings
;; may span lines, and a raw string `r"(…)"` may hold anything — an `r` that ENDS a word
;; (`library("dplyr")`) is no raw string, and one closes at its bracket and quote
(def r-restart-rule
  {:item-start "^([A-Za-z.][A-Za-z0-9._]*\\s*(<-|=)|library\\b|#|\\})"
   :opaque [{:open "(^|[^A-Za-z0-9._])[rR]['\"]-*[(\\[{]" :close "[)\\]}]-*['\"]"}]})

(deflanguage r
  {:lang :r
   :lsp {:id "r"
         :servers [{:name "r-languageserver"
                    :commands [["R" ["--no-echo" "-e" "languageserver::run()"]]]
                    :root-markers ["DESCRIPTION" ".Rproj.user" "renv.lock"]}]}
   :pairs *quote-pairs*
   :strings (assoc *hash-strings*
              :strings [{:open "\"" :multiline true} {:open "'" :multiline true}])
   :pattern "\\.[rR]$"
   :interpreters ["Rscript"]
   :faces r-face-table
   :indent r-indent-spec
   ;; the indent spec's brackets without `binary_operator`, which it indents a continued
   ;; pipe (`|>`, `%>%`, `+`) by: a continuation is no block to hide
   :folds #{:braced_expression :arguments :parameters :parenthesized_expression}
   :restart r-restart-rule
   ;; styler formats from R itself (`styler::style_file`), not a command line, so none here
   :definitions {:kinds #{:function_definition}}
   :grammar {:url "https://github.com/r-lib/tree-sitter-r"
             :revision "58a22794466c0fc15b0d3b40531db751593721e8"
             :fingerprint "b0ad153de33f28458bdf28449fe96f00a7a696994f93825bed91fbdbfbeee32c"}
   :comment "# "})
