;; src/languages/lex-dotenv.blsp — lexical .env (dotenv) highlighting: each line is a `#` comment, a
;; blank, or a `KEY=value` assignment (optionally `export`-prefixed, the value optionally
;; quoted). An `editor/lexer` grammar of line rules, as the other config formats are
;; (`languages/lex-configs`); the faces are the shared `:syntax/*` ones, so a theme recolours them.

(defmodule languages/lex-dotenv
  "Lexical highlighting for `.env` (dotenv) files, as a pure function over a source
string — `(env-spans src)` returns `[start end face]` colour spans in the
`highlight-spans` shape (ascending, non-overlapping, end-exclusive), feeding the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Per line: a `#`
comment, an optional leading `export` keyword, the `KEY` of a `KEY=value` assignment, and a
quoted value string — each a line rule of one `editor/lexer` grammar."
  (:use editor/lexer)
  (:use editor/face))

;; the faces each role paints, for a caller (a test) that compares spans
(defn env-face-comment () (face :syntax/comment))
(defn env-face-export () (face :syntax/keyword))
(defn env-face-key () (face :syntax/definition))
(defn env-face-string () (face :syntax/string))

;; A key is letters, digits, `_` and `.`; only a value that BEGINS with a quote is a string, to
;; its closing quote or the line's end. A `#` opens a comment only as a line's first ink:
;; `URL=a#b` is a value.
(def- key-pattern "[A-Za-z0-9_.]+")

(def env-grammar
  (lexer-grammar {:line [["^\\s*(#.*)" :comment]
                          ["^\\s*(export)\\s" :keyword]
                          [(str "^\\s*(?:export\\s+)?(" key-pattern ")=") :definition]
                          [(str "^\\s*(?:export\\s+)?" key-pattern "=(\"[^\"]*\"?|'[^']*'?)")
                            :string]]}))

(defn env-spans (src)
  "Lexically tokenize dotenv `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive) — in the `highlight-spans` shape, so it feeds the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Covers `#`
comments, the `export` keyword, the `KEY` of an assignment, and quoted values. Spans
are ascending and non-overlapping; unquoted values carry no span (the default face).

    (count (languages/lex-dotenv/env-spans \"export A=\\\"b\\\"\"))   ;=> 3"
  (lexer-spans env-grammar src))
(sig env-spans (string -> any))

(defn env-line-lexer ()
  "`env-spans` as an `editor/highlight` stateless line lexer (brood ADR-471) — env-mode's
`:line-lexer`.

    (:stateless? (languages/lex-dotenv/env-line-lexer))   ;=> true"
  (editor/line-cache/stateless-lexer env-spans))
