(defmodule languages/lisps
  "The machinery every s-expression dialect other than Brood is declared with — `deflisp` (a
special-form set and a file pattern over Brood's own reader, lexer and structural motions),
`head-set`, and `lisp-indent-with` (Emacs's Lisp indent rule) — for the dialects, each its own
module: `languages/elisp`, `languages/common-lisp`, `languages/clojure`, `languages/scheme`,
`languages/fennel`, `languages/wos`. What is dialect-specific is a set of special forms and,
where the dialect indents like Emacs rather than like Brood, its `lisp-indent-with` rule.")
;; sexp, model, reflect, editor/highlight, languages/core and brood-mode are referenced qualified below —
;; each `mod/name` auto-loads its module.

(def *lisp-strings*
  ;; every Lisp's strings and comments (`stringstate`): `"` strings span lines, `;` comments
  {:strings [{:open "\"" :multiline true}] :comments [";"]})

(defn head-set (names)
  "A dialect's special forms as the `{head true}` map `editor/highlight` and `lisp-indent-with`
read.

    (languages/lisps/head-set [\"if\"])   ;=> {\"if\" true}"
  (into {} (map names (fn (name) [name true]))))

(def deflisp-kind
  ;; what `deflisp` takes (`languages/core/check-spec`): the facts every language macro registers,
  ;; its special forms, and its `:indent` service when it is not Brood's
  {:macro 'deflisp
   :stack :prog
   :keys (into languages/core/*registration-keys* #{:specials :indent :docs})})

(defmacro deflisp (name spec)
  "Declare an s-expression language mode from ONE spec, and register it — the sibling of
`deflanguage` for the OTHER parser family.

    (deflisp elisp
      {:pattern \"[.]el$\"
       :specials elisp-special-forms
       :comment \";; \"})

A Lisp needs no grammar. `languages/brood` was never tree-sitter-backed: structural motion
comes from `std/sexp`, which is delimiter matching and knows nothing of any dialect, and
`editor/highlight` is a generic Lisp lexer — parens, `;` comments, `\"` strings, numbers —
with exactly one dialect-specific decision, whether a head symbol is a special form. So a
second Lisp is that set plus a file pattern.

`structural/ed-structural` picks its backend by the presence of `:ts-lang`; a mode without
one gets the sexp motions, which is why every `C-M-*` key works here without being
mentioned.

A docstring is told from a string value by Brood's doc-carrying heads unless the dialect names
its own in `:docs` (head → `:fn`, `:head` or the docstring's place after the head; brood ADR-764):
elisp documents a `defun` after its arglist and a `defvar` third, after its value.

Indentation defaults to Brood's (`languages/brood/brood-indent`): body +2, `let`-family bindings
aligned. A dialect that indents differently supplies `:indent` (a service symbol) — elisp does,
because Emacs aligns a plain call's arguments under the first argument where Brood indents +2,
and a config file is full of exactly that.

The facts every language macro takes mean what they mean in `deflanguage` and are registered by
the same path (`languages/core/register-language`): `:interpreters` (`#!/usr/bin/env bb` opens
Clojure), `:names` (the words a Markdown fence names the dialect by, `elisp` `emacs-lisp`),
`:lsp` (Clojure's clojure-lsp), `:snippets` and `:type`. Any other key raises at load
(`languages/core/check-spec`).

Every dialect gets paredit's keys (`languages/brood/brood-keymap`) and the structural edits on
M-x (`languages/brood/lisp-structural-commands`), and nothing that evaluates: only Brood is Brood.
The generated names are qualified by the module the macro expands in (`reflect/current-ns`), so a
package can declare a Lisp too; the spec is evaluated once, into `<name>-spec`."
  (let (base (->string name)
        generated (fn (suffix) (symbol (str base suffix)))
        qualified (fn (suffix) (symbol (str (reflect/current-ns) "/" base suffix)))
        spec-ref (qualified "-spec"))
    `(do
       (def ~(generated "-spec") ~spec)
       (languages/core/check-spec languages/lisps/deflisp-kind '~name ~spec-ref)
       (defn ~(generated "-fontify") (text)
         (editor/highlight/highlight-spans text (get ~spec-ref :specials) (get ~spec-ref :docs)))
       (defn ~(generated "-line-lexer") ()
         (editor/highlight/lisp-line-lexer (get ~spec-ref :specials)
           {:rainbow theme/*rainbow-delimiters* :docs (get ~spec-ref :docs)}))
       (def ~(generated "-mode-layer")
         {:name '~name
          :file-pattern (get ~spec-ref :pattern)
          :keymap languages/brood/brood-keymap
          :commands languages/brood/lisp-structural-commands
          :fontify '~(qualified "-fontify")
          :fontify-restart 'editor/highlight/safe-restart
          :line-lexer '~(qualified "-line-lexer")
          :bracket-match 'editor/highlight/bracket-match
          :fold-extent 'codefold/form-fold-extent
          :breadcrumbs 'languages/crumbs/form-crumbs
          :indent (get ~spec-ref :indent 'languages/brood/brood-indent)
          :indent-width 2
          :comment-syntax (get ~spec-ref :comment)
          ;; the dialect's built-in snippet templates (`snippet/mode-snippets`)
          :snippets (get ~spec-ref :snippets)
          ;; a one-line docstring continues at column 0 (M-q, auto-fill)
          :fill-prefixes 'fill/docstring-fill-prefixes
          ;; an opener always pairs, as paredit's does: a Lisp keeps its parens balanced
          :electric-pair-inhibit :never
          ;; strings span lines, `;` comments (`stringstate`)
          :string-syntax languages/lisps/*lisp-strings*})
       (languages/core/register-language languages/lisps/deflisp-kind
         '~name '~spec-ref '~(qualified "-mode-layer")))))

(defn- head-of (slice node)
  ;; the head symbol of a list node in `slice`, or nil: a list whose first form is not a symbol
  ;; or a keyword (a `cond` clause, a data list) has none
  (let (first-form (first (sexp/forms-of node)))
    (when (and (= (:kind node) :list) first-form (contains? #{:symbol :keyword} (:kind first-form)))
      (languages/brood/brood-head-text slice first-form))))

(defn lisp-indent-with (specials text bol &optional (indents {}))
  "Emacs's Lisp indent rule for the line at `bol` of `text`, given the dialect's
`specials` (head → true): a special form's body +2, a plain call's arguments under its
first argument, a call whose head is alone on its line one past the open paren, and a vector,
a map or a list with no head symbol (a `cond` clause, a data list) under its first element.
Shared by every dialect but Brood — which set decides is the one thing a dialect must say.

`indents` refines the rule per head, as Emacs's `lisp-indent-function` property does: N, the
first N arguments distinguished — +4 on a line of their own, the body after them +2 (`if-let`'s
is 2); `:call`, aligned as a call though the head colours as a special form (Scheme's `if`);
or a function given `{:slice :node :forms :open-column}` that answers the column (Common Lisp's
`loop`). `text` is a string or the buffer's rope: only the top-level form up to `bol` is read
from a rope (brood ADR-488).

    (languages/lisps/lisp-indent-with {} \"(foo a\\nb)\" 7)   ;=> 5
    (languages/lisps/lisp-indent-with {} \"(if-let x\\ny)\" 10 {\"if-let\" 2})   ;=> 4"
  (let (form-start (reflect/scan-form-start text bol)
        start (textpos/ed-line-start-offset text form-start)
        slice (text/slice text start bol)
        slice-length (count slice))
    (if (= slice-length 0)
      0
      (let (cst (sexp/tree slice)
            node (sexp/enclosing cst (dec slice-length))
            kind (:kind node))
        (if (= kind :root)
          0
          (let (open-column (textpos/ed-column-at slice (:start node))
                ;; an unclosed list ends in an empty error node, which is no argument
                forms (seq/reject (sexp/forms-of node) (fn (form) (= (:kind form) :error)))
                column-of (fn (form) (textpos/ed-column-at slice (:start form)))
                head (head-of slice node)
                rule (when head (get indents head (when (= true (get specials head)) :body))))
            (cond
              (empty? forms) (+ open-column (if (= kind :list) 2 1))
              ;; a vector, a map, a clause or a data list: under its first element
              (nil? head) (column-of (first forms))
              (fn? rule) (rule {:slice slice :node node :forms forms :open-column open-column})
              ;; distinguished arguments: those before the line count
              (int? rule) (+ open-column (if (< (dec (count forms)) rule) 4 2))
              ;; a special form: body +2
              (= rule :body) (+ open-column 2)
              ;; a call with arguments on the head's line: align under the first argument
              (>= (count forms) 2) (column-of (second forms))
              ;; a call whose head is alone on its line
              else (+ open-column 1))))))))
