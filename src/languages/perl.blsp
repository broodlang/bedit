(defmodule languages/perl
  "Perl: a tree-sitter mode over tree-sitter-perl."
  (:use languages))

;; ---- Perl (tree-sitter-perl/tree-sitter-perl, its `release` branch) ---------------------
;; A sub's name is a definition and a called function — `foo(…)`, `print …`, and the method
;; of `$obj->m(…)` — a function; a package's name, in `package` and `use`, a special. A sigil
;; and its variable are left plain, as perl-ts-mode's variables are. A string, a regex, a `qw`
;; list and a heredoc's body are painted whole, and the variables an interpolating one holds
;; are injected back as Perl, so `"hi $who"`'s `$who` stays code. POD and everything after
;; `__END__` are comments.
(def perl-face-table
  {:comment :syntax/comment
   :pod :syntax/comment
   :data_section :syntax/comment
   :eof_marker :syntax/special
   :string_literal :syntax/string
   :interpolated_string_literal :syntax/string
   :quoted_word_list :syntax/string
   :command_string :syntax/string
   :heredoc_token :syntax/string
   :heredoc_content :syntax/string
   :quoted_regexp :syntax/string
   :match_regexp :syntax/string
   :substitution_regexp :syntax/string
   :transliteration_expression :syntax/string
   :number :syntax/number
   :version :syntax/number
   :autoquoted_bareword :syntax/constant
   {:parent :package_statement :field :name} :syntax/special
   {:parent :use_statement :field :module} :syntax/special
   {:parent :require_expression :kind :bareword} :syntax/special
   {:parent :method_call_expression :field :invocant :kind :bareword} :syntax/special
   {:parent :subroutine_declaration_statement :field :name} :syntax/definition
   {:parent :method_declaration_statement :field :name} :syntax/definition
   :function :syntax/function
   {:parent :method_call_expression :field :method} :syntax/function})

;; the variables inside an interpolating string or heredoc: Perl again, so they keep their own
;; (plain) colours rather than the string's
(def- perl-interpolations
  (into []
    (for (parent [:string_content :heredoc_content]
           kind
           [:scalar
             :array :hash_element_expression :array_element_expression :scalar_deref_expression
             :array_deref_expression])
      {:content {:kind kind :parent parent} :lang :perl})))

;; perltidy's defaults: four columns, the brace on the line that opens it, `}` and `elsif`/
;; `else` on lines of their own (no cuddled else). Every brace is a `block` or an anonymous
;; hash, every list a parenthesized expression or an anonymous array. A heredoc's body and POD
;; are content, kept where they are written.
(def perl-indent-spec
  {:width 4
   :brackets #{:block
               :anonymous_hash_expression :anonymous_array_expression
               :parenthesized_expression :hash_element_expression :array_element_expression}
   :opens #{"{" "(" "["}
   :verbatim #{:pod :data_section}
   ;; a heredoc body begins AT its first content line, which is content too (brood ADR-758)
   :verbatim-from-start #{:heredoc_content}})

;; a package, a use, a sub, a declaration, a comment or a closing brace starts at column 0; a
;; heredoc or POD above may hold anything there
(def perl-restart-rule
  {:item-start "^((package|use|no|require|sub|my|our|BEGIN|END)\\b|#|\\})"
   ;; a heredoc closes on a word it chose, so it counts as open; POD opens at a command other
   ;; than `=cut` (which would otherwise re-open it) and closes at `=cut`
   :opaque [{:open "<<[~\"'A-Za-z_]"}
             {:open "(^|\n)=(pod|head[1-6]|over|item|back|begin|end|for|encoding)\\b"
              :close "\n=cut\\b"}]})

(deflanguage perl
  {:lang :perl
   :lsp {:id "perl"
         :servers [{:name "perlnavigator"
                    :commands [["perlnavigator" ["--stdio"]]]
                    :root-markers ["cpanfile" "Makefile.PL" "Build.PL" "dist.ini"]}]}
   :pairs *quote-pairs*
   :strings (assoc *hash-strings*
              :strings [{:open "\"" :multiline true} {:open "'" :multiline true :raw true}])
   :pattern "\\.(pl|pm|t)$"
   :names ["pl" "pm"]
   :interpreters ["perl"]
   :faces perl-face-table
   :injections perl-interpolations
   :indent perl-indent-spec
   :restart perl-restart-rule
   ;; `-b -bext=/`: format the file in place and keep no backup
   :format ["perltidy" "-b" "-bext=/"]
   :definitions {:kinds #{:subroutine_declaration_statement
                          :method_declaration_statement :package_statement}}
   ;; main carries no generated parser; `release` is the branch that does
   :grammar {:url "https://github.com/tree-sitter-perl/tree-sitter-perl"
             :revision "19422548269fb18266a63662704caf2307ecf854"
             :fingerprint "3cf9cc862bffcdfaf4a9eb7222c38542a1641827ea795f19a1088acea618cdbe"}
   :comment "# "})
