(defmodule languages/crumbs
  "Breadcrumbs for code (Emacs's breadcrumb-mode): the header line names the definitions point
is inside — `XB.Probe › run` — as Org's names the headings. A tree-sitter mode reads them off
the held parse (each `deflanguage` names a `:breadcrumbs` service that calls this): the chain
of nodes around point, kept to the ones the language declares definitions
(its MODE's, [[buffer-definitions]]), each named by the word its parse says fills its name field (on a
runtime whose nodes carry fields, brood ADR-759), else the first word on its line that is not a keyword
(`def`, `pub fn`, `class`…). A Lisp names the top-level form point is in. With no current parse
(a large file catching up), no crumbs — never a parse on the frame."
  (:use editor/buffer)) ; the rope and point

(def *keywords*
  ;; the words before a definition's name, in the languages bedit parses
  #{"def"
    "defp" "defmacro" "defmacrop" "defmodule" "defprotocol" "defimpl" "defstruct" "defdelegate"
    "defguard" "defn" "defn-" "class" "module" "fn" "function" "func" "pub" "async" "static"
    "export" "default" "struct" "impl" "trait" "enum" "type" "interface" "abstract" "public"
    "private" "protected" "override" "self" "const" "let" "var" "unsafe" "extern" "mod" "for"
    "crate" "get" "set" "fun" "sub" "local" "object" "val" "package" "resource" "data" "*"})

(defn definition-name (head)
  "The name a definition's first line `head` gives it: its first word that is not a keyword.

    (languages/crumbs/definition-name \"  pub async fn fetch(url: &str) {\")   ;=> \"fetch\"
    (languages/crumbs/definition-name \"defmodule XB.Probe do\")   ;=> \"XB.Probe\""
  (seq/find (map (regex/find-all head "[A-Za-z_*][A-Za-z0-9_.!?*-]*") (fn (found) (:text found)))
    (fn (word) (not (contains? *keywords* word)))))

(defn- same-node? (a b)
  (and (= (:start a) (:start b)) (= (:end a) (:end b)) (= (:kind a) (:kind b))))

(defn- name-below? (chain definition name-fields)
  ;; whether `chain` (root first) runs from `definition` down to its last node through
  ;; `name-fields` only, at least one step
  (let (found (seq/find (seq/enumerate chain) (fn ([_ node]) (same-node? node definition))))
    (when found
      (let (below (seq/subvec chain (inc (first found)) (count chain)))
        (and (not (empty? below)) (every? below (fn (node) (contains? name-fields (:field node)))))))))

(defn- name-field-word (rope lang tree definition words name-fields)
  ;; the first of `words` (regex matches over the definition's first line, which begins at its
  ;; start) that the parse says is `definition`'s NAME: the chain at the word runs from the
  ;; definition down to it through `name-fields` only (`:name`; C's declarator nests it). nil
  ;; when none is, or when the runtime's nodes carry no fields (a brood before ADR-759)
  (fold words
    nil
    (fn (found word)
      (or found
        (let (chain (vec (editor/treesit/node-chain rope
                           lang
                           (+ (:start definition) (:start word))
                           tree)))
          (when (name-below? chain definition name-fields) (:text word)))))))

(defn node-name (rope lang tree definitions node)
  "The name of the definition `node` (a chain node of the held parse `tree` of `rope`): the word
on its first line that fills its name field — `main` in `public static void main(`, `Name` in Go's
`func (r *Rec) Name()` — read from the parse, the fields `(:name-fields definitions)` (default
`#{:name}`) leading down to it; else, on a runtime whose nodes carry no fields, [[definition-name]]."
  (let (line (text/char->line rope (:start node))
        line-end (if (< (inc line) (text/line-count rope))
                   (text/after-line->char rope line)
                   (count rope))
        head (text/slice rope (:start node) line-end)
        words (regex/find-all head "[A-Za-z_*][A-Za-z0-9_.!?*-]*"))
    (or (name-field-word rope lang tree node words (or (:name-fields definitions) #{:name}))
      (definition-name head))))

(defn- definition? (node definitions rope)
  ;; whether chain `node` is a definition: its kind is one the language declares, or it is a
  ;; call whose callee is (Elixir's `def`, a call)
  (or (contains? (or (:kinds definitions) #{}) (:kind node))
    (and (= (:kind node) :call)
      (let (callee (first (regex/find-all (text/slice rope
                                            (:start node)
                                            (math/min (:end node) (+ (:start node) 32)))
                            "^[A-Za-z_][A-Za-z0-9_]*")))
        (and callee (contains? (or (:calls definitions) #{}) (:text callee)))))))

(defn lang-definitions (lang)
  "What a definition is in the grammar `lang` when no mode says: the `:definitions` of the spec of
the mode named after it, else of any registered spec that parses with it (as
`modes/language-faces` finds a table), else what std declares for it (`editor/treesit/definitions`:
Ruby's, Elixir's), else `{}`."
  (let (own (registry/lookup :languages/specs lang)
        spec-ref (or own
                   (seq/find (vals (registry/entries :languages/specs))
                     (fn (candidate) (= (get (reflect/eval candidate) :lang) lang))))
        declared (when spec-ref (get (reflect/eval spec-ref) :definitions)))
    (if (map? declared) declared (editor/treesit/definitions lang))))

(defn buffer-definitions (buffer &optional (lang nil))
  "What `buffer`'s MODE takes a definition to be: its layer's `:ts-definitions` (a
`deflanguage`'s `:definitions`), else what its grammar — `lang`, or its mode's `:ts-lang` —
has ([[lang-definitions]]). By mode first, so a second mode over one grammar — a package's —
never changes the first one's."
  (or (model/ed-mode-service buffer :ts-definitions)
    (let (grammar (or lang (model/ed-mode-service buffer :ts-lang)))
      (if grammar (lang-definitions grammar) {}))))

(defn defun-edge (rope lang definitions point edge &optional (tree nil))
  "The `edge` (`:start` or `:end`) of the definition around `point` in `rope`'s `lang` parse — the
deepest node `definitions` ([[buffer-definitions]]) calls one, else the outermost container
around point (a top-level form), else `point` itself: what C-M-a and C-M-e move to. `tree` is a
held parse of exactly `rope`, read instead of parsing it."
  (let (chain (seq/filter (editor/treesit/node-chain rope lang point tree)
                (fn (node) (and (:container node) (< (:start node) point) (< point (:end node)))))
        defuns (seq/filter chain (fn (node) (definition? node definitions rope))))
    (cond
      (not (empty? defuns)) (get (last defuns) edge)
      (not (empty? chain)) (get (first chain) edge)
      else point)))

(defn tree-crumbs (lang buffer tree)
  "The definitions point of `buffer` is inside, outermost first, by name — from `tree`, a held
parse of exactly `buffer`'s text in `lang`; `()` without one."
  (if (nil? tree)
    '()
    (let (rope (buffer-rope buffer)
          definitions (buffer-definitions buffer lang)
          chain (editor/treesit/node-chain rope lang (buffer-point buffer) tree))
      (seq/keep chain
        (fn (node)
          (when (definition? node definitions rope) (node-name rope lang tree definitions node)))))))

(defn form-crumbs (buffer &optional (tree nil))
  "A Lisp mode's `:breadcrumbs`: the name of the top-level form point is in (`(defn run …` gives
`run`), or `()` outside one."
  (let (rope (buffer-rope buffer)
        point (buffer-point buffer)
        start (reflect/scan-form-start rope point)
        end (reflect/scan-form-end rope start 1))
    (if (or (> point end) (not (= (text/slice rope start (math/min (inc start) (count rope))) "(")))
      '()
      (let (line (text/char->line rope start)
            line-end (if (< (inc line) (text/line-count rope))
                       (text/after-line->char rope line)
                       (count rope))
            head (text/slice rope (inc start) line-end)
            name (definition-name head))
        (if name (list name) '())))))

;; ---- every definition in a buffer (M-g i without a server) ---------------------------

(defn tree-definitions (lang buffer tree)
  "`[[label offset] …]` for every definition in `buffer`, top to bottom — `label` its path of
names (`Cart.total`, as `M-g i` lists a server's symbols), `offset` where it starts — read from
`tree`, a held parse of `buffer`'s text in `lang`: each line's chain at its first ink names the
definitions starting on that line and the ones around them."
  (let (rope (buffer-rope buffer)
        definitions (buffer-definitions buffer lang)
        name-at (fn (node) (node-name rope lang tree definitions node)))
    (seq/keep (range 0 (text/line-count rope))
      (fn (line)
        (let (line-start (text/line->char rope line)
              first-ink (text/skip-forward rope line-start " \t" true))
          (when (< first-ink (count rope))
            (let (chain (seq/filter (editor/treesit/node-chain rope lang first-ink tree)
                          (fn (node) (definition? node definitions rope)))
                  here (seq/find chain (fn (node) (= (text/char->line rope (:start node)) line))))
              (when here
                (let (path (seq/keep (seq/take-while chain (fn (node) (not (= node here)))) name-at)
                      name (name-at here))
                  (when name [(string/join (append path (list name)) ".") (:start here)]))))))))))

(defn form-definitions (buffer)
  "`[[label offset] …]` for a Lisp buffer's top-level forms that name something — `(defn total`
lists `total` — top to bottom."
  (let (rope (buffer-rope buffer))
    (seq/keep (range 0 (text/line-count rope))
      (fn (line)
        (let (start (text/line->char rope line))
          (when (= (text/slice rope start (math/min (inc start) (count rope))) "(")
            (let (line-end (if (< (inc line) (text/line-count rope))
                             (text/after-line->char rope line)
                             (count rope))
                  head (text/slice rope (inc start) line-end)
                  words (regex/find-all head "[^\\s()\\[\\]{}\"]+"))
              ;; only a form whose head defines (`def…`): a bare call at the top names nothing
              (when (and (>= (count words) 2) (string/starts-with? (:text (first words)) "def"))
                [(:text (second words)) start]))))))))
