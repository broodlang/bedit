(defmodule languages/fennel
  "Fennel: `deflisp` over its special forms; Brood's indent rule is Fennel's own convention."
  (:use languages/lisps :only [deflisp head-set]))

(def fennel-special-forms
  (head-set ["fn"
              "lambda" "λ" "local" "var" "global" "let" "set" "tset" "if" "when" "each" "for"
              "while" "do" "match" "case" "macro" "macros" "import-macros" "require-macros"
              "eval-compiler" "values" "not" "and" "or" "->" "->>" "-?>" "-?>>" "doto" "collect"
              "icollect" "accumulate" "faccumulate" "fcollect" "with-open" "pick-values" "pick-args"
              "comment" "lua" "quote" "hashfn" "partial"]))

(deflisp fennel
  {:pattern "\\.fnl$"
   :specials languages/fennel/fennel-special-forms
   :comment ";; "})
