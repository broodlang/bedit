(defmodule languages/tsx
  "TSX: TypeScript's spec (`languages/typescript`) over tree-sitter-typescript's `tsx` grammar, JSX put back."
  (:use languages))

;; ---- TSX (tree-sitter-typescript's `tsx` grammar) ------------------------------------------

(def tsx-indent-spec
  (assoc languages/typescript/ts-indent-spec
    :brackets
      (into (get languages/typescript/ts-indent-spec :brackets) languages/javascript/jsx-brackets)))

(deflanguage tsx
  (merge languages/typescript/typescript-spec
    {:lang :tsx
     :lsp {:id "typescriptreact"
           :servers [{:name "typescript"
                      :commands [["typescript-language-server" ["--stdio"]]]
                      :root-markers ["tsconfig.json" "jsconfig.json" "package.json"]
                      :shared true}]}
     :pattern "\\.tsx$"
     ;; TypeScript's names are not TSX's
     :names []
     :indent tsx-indent-spec
     :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript"
               :subdir "tsx"
               :revision "75b3874edb2dc714fb1fd77a32013d0f8699989f"
               :fingerprint "6cf509e3db5f0618e73debada04c2f2b511d34bc6437f0aa76909caa7beb03a1"}}))
