(defmodule languages/toml
  "TOML: a tree-sitter mode over tree-sitter-toml, lexed while the grammar is missing."
  (:use languages))

;; TOML's strings (`stringstate`): a single-quoted one is literal, raw
(def *toml-strings*
  {:strings [{:open "\"\"\"" :multiline true}
              {:open "'''" :multiline true :raw true}
              {:open "\""}
              {:open "'" :raw true}]
   :comments ["#"]})

;; TOML (tree-sitter-grammars/tree-sitter-toml): a table's header — its brackets and its
;; name — is a definition (`:syntax/definition`), as the lexer paints it, and a key a
;; symbol (`:syntax/symbol`, brood ADR-616); a dotted key is painted whole. A table's pairs are its children, so a table is a
;; DEFINITION: C-M-a goes to the `[header]` point is under. Entries are not indented under a
;; header (taplo's default): only an array or an inline table spanning lines opens a level,
;; and a multi-line string is content.
(def toml-face-table
  {{:parent :table :kind :bare_key} :syntax/definition
   {:parent :table :kind :dotted_key} :syntax/definition
   {:parent :table :kind :quoted_key} :syntax/definition
   {:parent :table :kind (keyword "[")} :syntax/definition
   {:parent :table :kind (keyword "]")} :syntax/definition
   {:parent :table_array_element :kind :bare_key} :syntax/definition
   {:parent :table_array_element :kind :dotted_key} :syntax/definition
   {:parent :table_array_element :kind :quoted_key} :syntax/definition
   (keyword "[[") :syntax/definition
   (keyword "]]") :syntax/definition
   {:parent :pair :kind :bare_key} :syntax/symbol
   {:parent :pair :kind :dotted_key} :syntax/symbol
   {:parent :pair :kind :quoted_key} :syntax/symbol
   :string :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :offset_date_time :syntax/number
   :local_date_time :syntax/number
   :local_date :syntax/number
   :local_time :syntax/number
   :boolean :syntax/constant
   :comment :syntax/comment})

(def toml-indent-spec
  {:width 2
   :brackets #{:array :inline_table}
   :opens #{"[" "{"}
   :verbatim #{:string}})

(deflanguage toml
  {:lang :toml
   :pairs *quote-pairs*
   :strings *toml-strings*
   :pattern "\\.toml$|(^|/)(Cargo|Pipfile|poetry)\\.lock$"
   :faces toml-face-table
   :indent toml-indent-spec
   ;; paired triple quotes, Python's case: a column-0 line inside one is text
   :heredocs *triple-quote-heredocs*
   :format ["taplo" "format"]
   :definitions {:kinds #{:table :table_array_element}}
   :grammar {:url "https://github.com/tree-sitter-grammars/tree-sitter-toml"
             :revision "64b56832c2cffe41758f28e05c756a3a98d16f41"
             :fingerprint "45b23763cea7284b45cabed097ca023d78dc949efed1a10c310896e814593ea9"}
   :fallback 'languages/lex-configs/toml
   ;; the characters besides letters and digits Emacs's mode puts in a word (brood ADR-774)
   :word-chars "$%"
   :comment "# "})
