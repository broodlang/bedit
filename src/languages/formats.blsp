(defmodule languages/formats
  "The line-lexed formats with no grammar: env, Makefile, INI, git's commit messages, ignore and
attributes files — each a `deflexer` over a lexer of `languages/lex-*`. Mail (mbox, .eml) is `mail`'s."
  (:use languages/core))

;; .env and its variants (.env.local, .env.production, …): the leading-dot name carries no
;; extension, so anchor on `.env` with an optional `.suffix`
(deflexer env
  {:pattern "(^|/)\\.env(\\.[^/]+)?$"
   :pairs *quote-pairs*
   :strings *hash-strings*
   :lexer 'languages/lex-dotenv/env
   :comment "# "})

;; ---- the configuration formats: tables over std's `editor/lexer` ---------------------
;; Fontify-only layers like env-mode; the lexing is `languages/lex-configs`'. JSON, YAML and TOML are
;; parsed modes (`languages/json`, `languages/yaml`, `languages/toml`), which keep these lexers
;; as their `:fallback`s.
;; The `:file-pattern` matches the file's basename, so the extensionless names
;; (`Makefile`, `COMMIT_EDITMSG`, `.gitconfig`) trigger too. Line-oriented: each is a
;; `:line-lexer` (brood ADR-471) — stateless but for the commit message, which carries whether
;; its subject has been seen — so the pane keeps each line's spans and a keystroke lexes the
;; line it changed; the long-line slice path
;; restarts at the viewport's own line (`editor/highlight/line-restart`).

(deflexer makefile
  {:pattern "(^|/)(GNUmakefile|Makefile|makefile)$|\\.(mk|make)$"
   :lexer 'languages/lex-configs/makefile
   :comment "# "
   ;; a recipe line MUST start with a tab
   :indent-tabs true
   :indent-width :tab})

(deflexer ini
  {:pattern "\\.(ini|cfg|conf|properties|gitconfig|gitmodules|editorconfig|npmrc|service|desktop)$|(^|/)\\.(gitconfig|gitmodules|editorconfig|npmrc|hgrc)$"
   :lexer 'languages/lex-configs/ini
   :comment "# "})

(deflexer gitcommit
  {:pattern "(^|/)(COMMIT_EDITMSG|MERGE_MSG|TAG_EDITMSG|SQUASH_MSG|NOTES_EDITMSG)$"
   :lexer 'languages/lex-configs/gitcommit
   ;; a commit message is prose: completion on demand, as in any text
   :completion-auto false})

;; git's pattern files, Emacs's git-modes (`languages/lex-gitignore`): an ignore file — git's, and
;; the tools' that copy its syntax — and `.gitattributes`. `.gitconfig` and `.gitmodules`
;; are INI's, above.
(deflexer gitignore
  {:pattern "(^|/)\\.(gitignore|npmignore|prettierignore|eslintignore|stylelintignore|ignore|rgignore|fdignore|helmignore|gcloudignore|vscodeignore)$|[.]dockerignore$"
   :lexer 'languages/lex-gitignore/gitignore
   :comment "# "})

(deflexer gitattributes
  {:pattern "(^|/)\\.gitattributes$"
   :lexer 'languages/lex-gitignore/gitattributes
   :comment "# "})
