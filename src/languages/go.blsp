(defmodule languages/go
  "Go: a tree-sitter mode over tree-sitter-go, gofmt's tabs and its `case` layout."
  (:use languages))

;; Go's strings: a backtick opens a raw string that may span lines (`stringstate`)
(def *go-strings*
  (assoc *c-strings* :strings [{:open "\""} {:open "'"} {:open "`" :multiline true :raw true}]))

;; ---- Go (tree-sitter-go, Emacs's go-ts-mode) ----------------------------------------------

(def go-face-table
  (merge
    {:comment :syntax/comment
     :interpreted_string_literal :syntax/string
     :raw_string_literal :syntax/string
     :rune_literal :syntax/string
     :int_literal :syntax/number
     :float_literal :syntax/number
     :imaginary_literal :syntax/number
     :true :syntax/constant
     :false :syntax/constant
     :nil :syntax/constant
     :iota :syntax/constant
     :type_identifier :syntax/special
     ;; a defined function or method (brood ADR-486)
     {:parent :function_declaration :field :name} :syntax/definition
     {:parent :method_declaration :field :name} :syntax/definition}
    ;; a called function, and a selector call's name — `fmt.Println`'s `Println`, told from
    ;; `p.X` by its grandparent (ADR-487)
    (call-faces [{:kind :field_identifier :field :field :of :selector_expression}])))

;; gofmt's layout: tabs, and a `case` at the `switch`'s own level with its statements one
;; deeper. A switch carries its braces itself (there is no body node), so the switch IS the
;; bracket — its statements one deeper — and a `case` / `default` line backs out of it.
(def go-indent-spec
  {:width 8
   :brackets #{:block
               :field_declaration_list :interface_type :literal_value :argument_list
               :parameter_list :import_spec_list :var_spec_list :const_declaration
               :type_declaration :parenthesized_expression
               :expression_switch_statement :type_switch_statement :select_statement}
   :dedent #{"case" "default"}})

(def go-restart-rule
  {:item-start "^((func|type|var|const|import|package)\\b|//|\\})"
   ;; a block comment or a raw string — `…` spans lines
   :opaque [*block-comment-opaque* *backtick-opaque*]})

(deflanguage go
  {:lang :go
   :lsp {:id "go"
         :servers [{:name "gopls"
                    :commands [["gopls" []]]
                    :root-markers ["go.work" "go.mod"]
                    :shared true}]}
   :pairs *backtick-pairs*
   :strings *go-strings*
   :pattern "\\.go$"
   :names ["golang"]
   :faces go-face-table
   :indent go-indent-spec
   :indent-tabs true
   ;; a level is one tab, as wide as the tab width (gofmt)
   :indent-width :tab
   :restart go-restart-rule
   :electric-indent *case-label-electric*
   :format ["gofmt" "-w"]
   :definitions {:kinds #{:function_declaration :method_declaration :type_declaration}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-go"
             :revision "2346a3ab1bb3857b48b29d779a1ef9799a248cd7"
             :fingerprint "37bb2024a28e64b32aaf4fe0fbb0c74e316d2b563022750785011f45bcc11424"}
   :comment "// "})
