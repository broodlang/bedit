(defmodule languages/php
  "PHP: a tree-sitter mode over tree-sitter-php, the HTML around it injected."
  (:use languages))

;; ---- PHP (tree-sitter-php's `php` grammar, Emacs's php-ts-mode) --------------------------
;; The file is HTML with PHP inside `<?php … ?>`: the text outside is the grammar's `text`,
;; injected as HTML, and the tags themselves are specials. A class, interface, trait or enum's
;; name and every type are specials; a function or method's name is a definition, and a called
;; one — `f()`, `$obj->m()`, `$obj?->m()`, `Cls::m()` — a function. A `$variable` is left plain,
;; as php-ts-mode leaves it with no variable face. A single-quoted string is painted whole; a
;; double-quoted one and a heredoc colour their text and quotes rather than themselves, so an
;; embedded `{$expr}` or `$name` stays code.
(def php-face-table
  (merge {:comment :syntax/comment
          :string :syntax/string
          :string_content :syntax/string
          :escape_sequence :syntax/string
          {:parent :encapsed_string :kind (keyword "\"")} :syntax/string
          :heredoc_start :syntax/string
          :heredoc_end :syntax/string
          {:parent :heredoc :kind (keyword "<<<")} :syntax/string
          {:parent :nowdoc :kind (keyword "<<<")} :syntax/string
          :nowdoc_string :syntax/string
          :integer :syntax/number
          :float :syntax/number
          :boolean :syntax/constant
          :null :syntax/constant
          {:parent :const_element :kind :name} :syntax/constant
          {:parent :enum_case :field :name} :syntax/constant
          :php_tag :syntax/special
          :php_end_tag :syntax/special
          :primitive_type :syntax/special
          :cast_type :syntax/special
          :named_type :syntax/special
          :namespace_name :syntax/special
          {:parent :namespace_use_clause :kind :qualified_name} :syntax/special
          {:parent :base_clause :kind :name} :syntax/special
          {:parent :base_clause :kind :qualified_name} :syntax/special
          {:parent :class_interface_clause :kind :name} :syntax/special
          {:parent :class_interface_clause :kind :qualified_name} :syntax/special
          {:parent :object_creation_expression :kind :name} :syntax/special
          {:parent :object_creation_expression :kind :qualified_name} :syntax/special
          {:parent :scoped_call_expression :field :scope :kind :name} :syntax/special
          {:parent :class_constant_access_expression :nth 0 :kind :name} :syntax/special
          {:parent :attribute :kind :name} :syntax/special
          {:parent :function_call_expression :field :function} :syntax/function}
    (field-faces [:class_declaration :interface_declaration :trait_declaration :enum_declaration]
      :name :syntax/special)
    (field-faces [:method_declaration :function_definition] :name :syntax/definition)
    ;; `$obj->m()`, `$obj?->m()` and `Cls::m()`'s `m`
    (field-faces [:member_call_expression :nullsafe_member_call_expression :scoped_call_expression]
      :name :syntax/function)))

;; the HTML around the PHP: each stretch of `text` outside `<?php … ?>`
(def php-injections [{:content :text :lang :html}])

;; PSR-12: four columns; a class's and a function's brace on a line of its own, a control
;; structure's on the same line. A `case`'s statements sit one deeper than the `case` (the
;; case is a bracket that opens on its own line). A heredoc's lines, a block comment's and the
;; HTML outside the PHP are content, kept where they are written.
(def php-indent-spec
  {:width 4
   :brackets #{:compound_statement
               :declaration_list :enum_declaration_list :switch_block :case_statement
               :default_statement :match_block :arguments :formal_parameters
               :array_creation_expression :parenthesized_expression :attribute_group}
   :opens #{"{" "(" "[" ":"}
   :verbatim #{:heredoc :nowdoc :comment :text}})

;; a `<?php` tag or a top-level declaration at column 0. The grammar reads everything before a
;; `<?php` as HTML text, so a window cut at a `function` is re-read after the `<?php` still open
;; above it (`php-resume`) — and one cut in the HTML between `?>` and the next tag is HTML. A
;; block comment or a heredoc above may hold a line that is no declaration
(def php-restart-rule
  {:item-start "^(<\\?php|(namespace|use|interface|trait|enum|function)\\b|((abstract|final|readonly)\\s+)*class\\b)"
   :opaque [*block-comment-opaque* {:open "<<<"}]})

;; the PHP a window may begin inside: a `<?php` still open above it is re-read first, which the
;; restart, seeing only the lead-in (`spancache/ed-fontify-backscan` lines), cannot find itself
(def php-resume [{:open "(?i)<\\?php" :close "\\?>"}])

(deflanguage php
  {:lang :php
   :lsp {:id "php"
         :servers [{:name "php"
                    :commands [["intelephense" ["--stdio"]] ["phpactor" ["language-server"]]]
                    :root-markers ["composer.json"]}]}
   :pairs *quote-pairs*
   ;; `#` comments too, but `#[` opens an attribute, so only `//` is told to the string scan
   :strings (assoc *c-strings* :strings [{:open "\"" :multiline true} {:open "'" :multiline true}])
   :pattern "\\.(php|phtml)$"
   :names ["phtml"]
   :interpreters ["php"]
   :faces php-face-table
   :injections php-injections
   :indent php-indent-spec
   :restart php-restart-rule
   :resume php-resume
   :electric-indent *case-label-electric*
   :format ["php-cs-fixer" "fix" "--quiet"]
   :definitions {:kinds #{:class_declaration
                          :interface_declaration :trait_declaration
                          :enum_declaration :method_declaration :function_definition}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-php"
             :subdir "php"
             :revision "58d5643086ae60e93a3746cca648363ee97c8761"
             :fingerprint "5d98555757befd6c3a91932c98bcafeadb121da8587f46908f6ee395535687ee"}
   :comment "// "})
