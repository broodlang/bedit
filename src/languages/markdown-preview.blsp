(defmodule languages/markdown-preview
  "The **markdown preview** — the document you are writing, rendered, in a pane beside it.

`C-c C-p` (M-x markdown-preview) in a `.md` buffer opens `*Markdown Preview*` to the
right: the text the markup describes — headings underlined, paragraphs re-flowed to the
pane's width, bullets, quotes, code — with the faces carried as data, since the markers a
lexer would read are exactly what is gone (`languages/markdown/markdown-render`, whose
`:spans` the pane paints through `:face-spans`). The command toggles: run it again and the
pane goes.

**It follows you, on two clocks.** Every move of point (`:on-move`, layers §7 — not every
event: the wheel over the preview scrolls it and stays scrolled) keeps the rendered line
of the cursor's source line in view (`aside/scroll-to-line`; nothing
re-renders — `:lines` from the last render answers where a source line landed). The
RENDER runs on the idle beat (`:on-idle`), once typing settles, and only when the text or
the pane's width changed since the last one: a whole-document render on every key would
make typing jitter. And it runs in a TASK
(`launch`): the rope is captured, the text built and rendered off the loop, and the answer
folded in when it lands (`apply-render`), so a long document never pauses the editor.
A third follower keeps it level with the document's SCROLL: when the source pane scrolls —
the wheel, `C-v`, `C-l` — the preview puts the rendered line of the source's first line at
its own top (`follow-scroll`, a post-step), as markdown-mode's live preview syncs its window
to the source's.

**It can open on its own.** With init.blsp's `:markdown-preview true`, the idle beat in a
markdown buffer opens it (`markdown-on-idle`) — unless you closed it, which latches until
`C-c C-p` (Emacs's `markdown-live-preview-mode` turned on per buffer by a hook).

**The pane is an `aside`**: shown beside the page, refreshed in place keeping its scroll
(`:keep-scroll` — the follow places it), latched closed when you close it, brought back
only by the command. Killing the markdown buffer takes the preview with it
(`:on-close`), because a preview of nothing is a corpse on screen. Where it opens and how
wide it is are the `:display-buffer` rules' (see `aside`).

**State**, under the model's `:mdpreview` map: `aside`'s `:aside-shown?`/`:aside-closed?`,
plus `:rope` (the text last rendered — O(1) to compare, so \"did it change?\" is free),
`:width` (the columns it was rendered to) and `:render` (the last `markdown-render`
result, for `:lines`), `:pending` (`{:rope :width}` of a render in flight), `:source-view`
(`[rope top]` of the source pane after the last event, for `follow-scroll`); and the
model's `:mdpreview-proc`, that render's task."
  (:use model) ; ed-current-buf / message
  (:use interactive) ; defcommand
  (:use aside) ; the pane discipline: refresh / reopen / scroll-to-line / pane-of
  (:use editor/buffer) ; buffer-rope / buffer-text / buffer-current-line
  (:use languages/markdown) ; markdown-render / markdown-rendered-line
  (:use task) ; task — the idle beat's render runs off the loop
  (:use modes :only [register-special-type])) ; the preview's own buffer type
(def *buffer-name* "*Markdown Preview*")

(def *spec*
  {:key :mdpreview :buffer languages/markdown-preview/*buffer-name* :type :markdown-preview})

(sig pane-width (model -> int))
(defn pane-width (m)
  "The columns the preview should render to: the pane's width less its scrollbar column,
or 72 (a comfortable reading width) with no pane to measure — headless, where the pane is
never laid out. The command opens the pane BEFORE the first render so it is measured."
  (let (pane (aside/pane-of *spec* m))
    (if (nil? pane)
      72
      (let ([_ _ w _] (:rect pane)) (math/max 10 (- w 2))))))

(sig fresh? (model buffer -> bool))
(defn fresh? (m buffer)
  "Whether the last render is of `buffer`'s text at the pane's current width — nothing to do."
  (and (= (map/get-in m [:mdpreview :rope]) (buffer-rope buffer))
    (= (map/get-in m [:mdpreview :width]) (pane-width m))))

(defn- remember-and-refresh (m rendered force)
  "Remember `rendered` — `{:rope :width :render}`, a render of that text at that width — and
put it in the pane (opening one with `force`, else only refreshing one already up)."
  (aside/refresh *spec*
    (assoc m :mdpreview (merge (:mdpreview m) rendered))
    (:render rendered)
    force
    {:keep-scroll true}))

(sig show (model map -> model))
(defn- show (m rendered)
  "Put `rendered` in an open pane (never opening one), remember it, and keep the cursor's
line in view."
  (let (refreshed (remember-and-refresh m rendered false))
    (follow refreshed (ed-current-buf refreshed))))

(sig render (model buffer bool -> model))
(defn render (m buffer force)
  "Render `buffer` into the pane (opening it with `force`, else only refreshing one already
up) and remember what was rendered, then keep the cursor's line in view. On the loop: what
the command does, because you asked and are waiting; the idle beat renders in a task
(`launch`)."
  (let (width (pane-width m)
        rendered {:rope (buffer-rope buffer)
                  :width width
                  :render (markdown-render (buffer-text buffer) width)})
    (follow (remember-and-refresh m rendered force) buffer)))

(sig launch (model buffer -> model))
(defn launch (m buffer)
  "Render `buffer` OFF the loop: a task over the rope (captured, not flattened here — the text
is built in the task) at the pane's width, its answer folded in by `apply-render`. A render
already in flight is left to land; its fold launches the next one if the text moved on
meanwhile. Headless there is no loop to answer to, so it renders in place.

The render reads the whole document, so on the loop it would pause every idle beat of a
long file."
  (cond
    (:mdpreview-proc m) m
    (ed-headless?) (render m buffer false)
    else
    ;; the rope rides INTO the task in its closure, but a rope cannot travel in a
    ;; message, so the answer is the render alone: what it is of stays here, under
    ;; `:pending`, until it lands
      (let (rope (buffer-rope buffer)
            width (pane-width m)
            job (task (fn () (markdown-render (text/->string rope) width))))
        (-> m
          (assoc :mdpreview-proc job)
          (map/assoc-in [:mdpreview :pending] {:rope rope :width width})))))

(sig apply-render (model any -> model))
(defn apply-render (m result)
  "A finished off-loop render (`launch`): `result` is the `markdown-render` of the text and
width `launch` left under `:pending`, shown when it is one (a failed task leaves the last
render up), the slot cleared — and, when the current buffer is still a markdown buffer
whose text or pane width moved on while the task ran, the next render launched, since no
later beat is promised to ask."
  (let (pending (map/get-in m [:mdpreview :pending])
        cleared (-> m
                  (dissoc :mdpreview-proc)
                  (assoc :mdpreview (dissoc (or (:mdpreview m) {}) :pending)))
        shown (if (and (map? result) pending) (show cleared (assoc pending :render result)) cleared)
        buffer (ed-current-buf shown))
    (if (and (map? result)
          (= (ed-buf-mode-name buffer) "markdown")
          (aside/open? *spec* shown)
          (not (fresh? shown buffer)))
      (launch shown buffer)
      shown)))

(sig follow (model buffer -> model))
(defn follow (m buffer)
  "Scroll the preview so the rendered line of `buffer`'s cursor line is in view — from the
last render's `:lines`, no re-render. A no-op when the pane is not up or the render is of
some other text (the idle beat will replace it, and follow then)."
  (let (rendered (map/get-in m [:mdpreview :render]))
    (if (or (nil? rendered)
          (not (aside/open? *spec* m))
          (not (= (map/get-in m [:mdpreview :rope]) (buffer-rope buffer))))
      m
      (aside/scroll-to-line *spec* m (markdown-rendered-line rendered (buffer-current-line buffer))))))

;; ---- the hooks on markdown-mode -------------------------------------------------

(defn markdown-on-move (m)
  "markdown-mode's `:on-move`: keep the preview following the cursor. Runs only when point
or the text moved (layers §7) — never on the wheel scrolling the preview itself, which
would snap the pane straight back. Follows only; the render is the idle beat's."
  (follow m (ed-current-buf m)))

(defn- open-pane (m)
  "The preview pane opened (empty) and scrolled to its top — before the first render, so the
render is to the width of the pane it lands in."
  (aside/scroll-to-line *spec* (aside/refresh *spec* m "" true) 0))

(defn markdown-on-idle (m)
  "markdown-mode's `:on-idle`: re-render an open preview once typing settles, if the
text or the pane's width moved since the last render. With `:markdown-preview` on in
init.blsp (`:markdown-preview-auto` on the model) it OPENS one too — unless the reader
closed it, which latches until `C-c C-p`."
  (let (buffer (ed-current-buf m))
    (cond
      (aside/open? *spec* m) (if (fresh? m buffer) m (launch m buffer))
      (and (= true (:markdown-preview-auto m)) (not (aside/closed? *spec* m)))
        (launch (open-pane m) buffer)
      else m)))

(defn follow-scroll (m)
  "The post-step that keeps an open preview level with the source's SCROLL: when the
selected pane — a markdown buffer whose text is the one rendered — has a new top line (the
wheel, `C-v`, `C-l`, a line typed at the bottom), the rendered line of that top line becomes
the preview's top, and then the cursor's rendered line is kept in view as [[follow]] keeps
it. A move of point inside the window leaves the preview to `:on-move`'s follow. Free when
no preview is up: a comparison of two values otherwise."
  (if (not (aside/open? *spec* m))
    m
    (let (buffer (ed-current-buf m)
          view [(buffer-rope buffer) (ed-current-top m)]
          before (map/get-in m [:mdpreview :source-view])
          rendered (map/get-in m [:mdpreview :render])
          remembered (map/assoc-in m [:mdpreview :source-view] view))
      (if (and (= (ed-buf-mode-name buffer) "markdown")
            (not (nil? before))
            (not (nil? rendered))
            (= (map/get-in m [:mdpreview :rope]) (first view))
            (not (= (second before) (second view))))
        (aside/scroll-to-line *spec*
          (aside/scroll-top-to *spec* remembered (markdown-rendered-line rendered (second view)))
          (markdown-rendered-line rendered (buffer-current-line buffer)))
        remembered))))

;; After every event an open preview follows the source's scroll — a comparison of three
;; values when nothing scrolled. Registered here, so it exists exactly when a pane can.
(register-post-step :mdpreview-scroll {:rank 25 :run 'languages/markdown-preview/follow-scroll})

(defn markdown-on-close (buffer)
  "markdown-mode's `:on-close`: killing the buffer takes its preview with it
(`aside/close-with`)."
  (aside/close-with buffer *spec*))

;; ---- the command ----------------------------------------------------------------

(defcommand cmd-markdown-preview
  (m key)
  "Toggle the markdown preview (C-c C-p, M-x markdown-preview): open `*Markdown Preview*`
beside this buffer, rendered and following the cursor — or, when it is up, close it.
Opening clears the latch a closed pane leaves, because this is you asking."
  (aside/toggle *spec*
    m
    (fn (cleared)
      ;; open first, render second: the pane has to exist to be measured, and a render at a
      ;; guessed width would be redone by the next idle beat anyway
      (let (opened (open-pane cleared))
        (message (render opened (ed-current-buf opened) false)
          "markdown preview — follows the cursor; C-c C-p closes it")))
    "markdown preview closed"))

;; ---- registration ---------------------------------------------------------------
;; the idle beat's render lands here; a failed one (`:failed`) leaves the last render up
(register-task-reply :mdpreview-proc 'languages/markdown-preview/apply-render :failed nil)

;; The preview pane itself: read-only rendered text, no line numbers (it is not a file),
;; its faces served from the buffer's `:face-spans` data rather than a `:fontify` lexer.
(def markdown-preview-layer {:name 'markdown-preview :no-line-numbers true})

(register-special-type :markdown-preview 'languages/markdown-preview/markdown-preview-layer)
