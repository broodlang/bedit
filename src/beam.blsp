(defmodule beam
  "**The editor as `:observer`** — what is actually running in the BEAM node bedit is
attached to (`M-x beam-processes`, `C-c b p`).

`M-x list-processes` already shows this runtime's own processes: id, name, status, mailbox
backlog, memory, reductions and reductions/second, read-only, `g` to refresh and `k` to
kill. This is the same buffer, the same columns and the same keys for the OTHER runtime —
the one your application is running in — answered by the agent `elixir-sandbox` already
keeps there.

**The same session as the playground's, deliberately.** The value of observing from inside
the node is that it is YOUR node: `mix run` compiled and started your application, so what
this lists is your supervision tree, your Ecto pool, your LiveView processes. A second
agent would be a second VM and would show you nothing you care about.

**REDS/S is the column worth the round trip.** Reductions are the scheduler's own measure
of work done, so a single snapshot says only how much a process has done since it started —
which tells you almost nothing. The DIFFERENCE between two snapshots is who is busy *now*,
which is the question you open a process list to ask. So the list keeps the previous
snapshot on the model and rates the next one against it (`commands/ed-rate-procs`, shared
with the native list): `-` on the first show, a real rate on every `g` after.

Sorted by that rate, then by reductions — a runaway process sorts itself to the top, where
in pid order it would be one of four hundred rows."
  (:use model) ; message / ed-current-buf / ed-headless? / ed-buffer-index-by-name
  (:use commands) ; ed-show-named / ed-rate-procs — the shared snapshot rating
  (:use interactive) ; defcommand — M-x beam-processes
  (:use editor/buffer) ; buffer-line-at / buffer-current-line — the row under point
  (:use editor/keymap) ; keymap-bind — the buffer's own keys
  (:use editor/layers) ; register-type-layers
  (:use elixir-sandbox)) ; elixir-start / elixir-observe / elixir-available?
;; modes and projects are referenced qualified below — each `mod/name` auto-loads its module.

(def *buffer-name* "*BEAM Processes*")
(def *spy-buffer* "*BEAM Spy*") ; the debugger's stream
(def *debug-buffer* "*BEAM Debug*") ; …and its queue of stopped processes
(def *state-key* :beam) ; where the pending request and the last snapshot live on the model
;; ---- the rows -----------------------------------------------------------------------

(defn- clip (s n)
  "`s` cut to `n` characters. A module name in a real application is routinely longer than
its column, and a row that wraps stops being a row."
  (let (s (str s))
    (if (> (string/length s) n) (string/substring s 0 n) s)))

(defn- beam-row (p)
  "One `*BEAM Processes*` row. The PID stays flush-left, because that is what the kill key
parses back out of the line — there is no side table to go stale.

CURRENT is the column the native list has no equivalent of and the one that pays for
itself: a process sitting in `GenServer.loop/3` is idle, and one sitting in your own
`MyApp.Worker.crunch/2` is the thing you were looking for."
  (str (string/pad-right (get p :pid "-") 16)
    " "
    (string/pad-right (clip (get p :name "-") 22) 22)
    " "
    (string/pad-right (get p :status "-") 9)
    " "
    (string/pad-left (str (get p :mailbox 0)) 7)
    " "
    (string/pad-left (humanize/byte-size (get p :memory 0)) 8)
    " "
    (string/pad-left (str (get p :reductions 0)) 12)
    " "
    (string/pad-left (let (r (get p :reds-rate)) (if (nil? r) "-" (str r))) 8)
    " "
    (string/pad-left (str (get p :monitored_by 0)) 4)
    " "
    (clip (get p :current "-") 40)))

(defn- beam-header ()
  (str (string/pad-right "PID" 16)
    " "
    (string/pad-right "NAME" 22)
    " "
    (string/pad-right "STATUS" 9)
    " "
    (string/pad-left "MAILBOX" 7)
    " "
    (string/pad-left "MEM" 8)
    " "
    (string/pad-left "REDS" 12)
    " "
    (string/pad-left "REDS/S" 8)
    " "
    (string/pad-left "MON" 4)
    " "
    "CURRENT"))

(defn- beam-busiest (rows)
  "Busiest first: by reductions/second where there is one, else by total reductions.

Order is the whole usefulness of this list. A node runs hundreds of processes and all but a
handful are parked in a receive; pid order buries the one that is spinning somewhere in the
middle, and nothing about the columns tells you where to look."
  (reverse (sort-by rows (fn (p) [(or (get p :reds-rate) 0) (get p :reductions 0)]))))

(defn beam-text (rows)
  "The `*BEAM Processes*` buffer text for an already-rated snapshot."
  (if (empty? rows)
    (str (beam-header) "\n\n  (waiting for the node…)\n")
    (str (beam-header) "\n" (string/join (map (beam-busiest rows) beam-row) "\n") "\n")))

;; ---- the supervision tree ---------------------------------------------------------------

(defn app-tree-row (r)
  "One `*BEAM Applications*` row, indented by its `:depth`.

The tree arrives FLAT with a depth on each node rather than pre-drawn, so this can indent
it, and something else could sort or filter it. A supervisor is marked, because the shape
of a tree is which of its nodes have children."
  (str (string/pad-right (str (string/repeat "  " (get r :depth 0))
                           (if (get r :supervisor) "▾ " "· ")
                           (clip (get r :name "-") 40))
         46)
    " "
    (string/pad-right (get r :pid "-") 16)
    " "
    (string/pad-left (humanize/byte-size (get r :memory 0)) 9)
    " "
    (string/pad-left (str (get r :mailbox 0)) 7)))

(defn apps-text (apps)
  "The `*BEAM Applications*` buffer: each started application, then its supervision tree.

An application with no tree still gets its heading — a library application (`:logger`'s
dependencies, `:crypto`) has none, and omitting it would read as the list being incomplete
rather than as that being what a library application is."
  (if (empty? apps)
    "  (waiting for the node…)\n"
    (string/join (map apps
                   (fn (a)
                     (str (get a :app "?")
                       "  "
                       (get a :vsn "")
                       "\n"
                       (if (empty? (get a :tree []))
                         "  (no supervision tree — a library application)\n"
                         (str (string/join (map (get a :tree) app-tree-row) "\n") "\n")))))
      "\n")))

;; ---- ETS ---------------------------------------------------------------------------------

(defn- ets-row (t)
  (str (string/pad-right (clip (get t :name "-") 34) 34)
    " "
    (string/pad-left (str (get t :size 0)) 10)
    " "
    (string/pad-left (humanize/byte-size (get t :memory 0)) 10)
    " "
    (string/pad-right (clip (get t :owner "-") 24) 24)
    " "
    (string/pad-right (get t :type "-") 12)
    " "
    (get t :protection "-")))

(defn- ets-header ()
  (str (string/pad-right "TABLE" 34)
    " "
    (string/pad-left "SIZE" 10)
    " "
    (string/pad-left "MEM" 10)
    " "
    (string/pad-right "OWNER" 24)
    " "
    (string/pad-right "TYPE" 12)
    " "
    "ACCESS"))

(defn ets-text (tables)
  "The `*BEAM ETS*` buffer — biggest first, because the question you open it to ask is
which table is holding the memory."
  (if (empty? tables)
    (str (ets-header) "\n\n  (waiting for the node…)\n")
    (str (ets-header)
      "\n"
      (string/join (map (reverse (sort-by tables (fn (t) (get t :memory 0)))) ets-row) "\n")
      "\n")))

;; ---- the views ----------------------------------------------------------------------------
;; Three observations, one mechanism. A view is a row here: what to ask the node for, which
;; buffer it fills, and how its rows become text. The request, the reply fold and the
;; refresh key are written against these fields, so a fourth observation (ports, timers,
;; the memory breakdown) is an entry rather than another command with its own plumbing.

(def *views*
  {:processes {:what "processes" :buffer "*BEAM Processes*" :key :processes :type :beam-menu}
   :applications {:what "applications"
                  :buffer "*BEAM Applications*"
                  :key :applications
                  :type :beam-apps-menu}
   :ets {:what "ets" :buffer "*BEAM ETS*" :key :tables :type :beam-ets-menu}})

;; ---- auto-refresh: a live view is one that stays live -------------------------------
;; A process list is a measurement, and a measurement you have to keep asking for is a
;; snapshot pretending to be a monitor. REDS/S in particular is a rate between two
;; snapshots — press `g` once and every row reads `-`; press it twice, slowly, and the
;; rate is averaged over however long you took to press it again. On a timer the column
;; finally means what it says.
;;
;; Three rules keep it from being a nuisance, and they are the whole design:
;;   * only while the buffer is ON SCREEN (`ed-buffer-displayed?`) — a buried observer
;;     costs the node a round trip per tick for nothing;
;;   * never while a request is already in flight, so a slow node makes the list lag
;;     rather than queue;
;;   * refilled in place, keeping your line and your pane (`beam-refill`).

(def *refresh-ms* 2000)
;; How often a displayed view re-asks the node. Two seconds: fast enough that REDS/S is a
;; live reading, slow enough that it is one round trip per tick over an already-open
;; session. `nil` (or `M-x beam-auto-refresh`) turns it off.

(def *auto-refresh* true)
;; The default for new sessions; `:beam-auto-refresh` on the model is the live toggle.

(defn auto-refresh? (m)
  "Whether the views should re-ask on a timer — the model's toggle, defaulting to
`*auto-refresh*`, and off entirely when `*refresh-ms*` is not a number."
  (and (int? *refresh-ms*) (get m :beam-auto-refresh *auto-refresh*)))

(defn view-of (m)
  "The view the CURRENT buffer is, or `:processes` when it is none of them — which is what
`g` refreshes and what a reply fills."
  (let (nm (buffer-name (ed-current-buf m)))
    (or (first (seq/find (%map-pairs *views*) (fn ([_ v]) (= (get v :buffer) nm)))) :processes)))

;; ---- asking the node ------------------------------------------------------------------

(defn- beam-snapshot-reds (rows)
  ;; pid -> reductions, for rating the NEXT snapshot against this one
  (reduce rows {} (fn (acc p) (assoc acc (get p :pid) (get p :reductions 0)))))

(defn beam-live-buffer? (m)
  "Is ANY of the node's buffers on screen — i.e. does this client still want a session? One
of the `sandbox-events` client hooks. Any of them, because they are one client: the
supervision tree and the ETS list are the same node seen from a different angle, and
closing the process list should not take the session out from under them."
  (any?
    (append (map (%map-pairs *views*) (fn ([_ v]) (get v :buffer)))
      ;; …and the debugger's two, which are NOT views (they are pushed to, not asked
      ;; for) but are just as much somebody watching. Left out, a trace running with
      ;; only *BEAM Spy* open answered \"nobody is watching\" the moment the node
      ;; hiccuped, and the session was shut down out from under it.
      [*spy-buffer* *debug-buffer*])
    (fn (nm) (not (nil? (ed-buffer-index-by-name m nm))))))

(defn beam-request (m &optional (view :processes))
  "Ask the node for a fresh snapshot of `view`, remembering the request id AND which view it
was for, so the reply fills the right buffer and can be told from the playground's.

Answers the model unchanged when the session is not running — the reply would never come,
and a request recorded as pending that cannot be answered is a buffer that never refreshes."
  (let (id (sandbox/sandbox-next-id m)
        sent (elixir-observe id (get-in *views* [view :what] "processes")))
    (if (not sent)
      m
      (assoc-in (assoc-in (sandbox/sandbox-ids-used m (inc id)) [*state-key* :pending] id)
        [*state-key* :view]
        view))))

(defn beam-show (m rows)
  "Render the process `rows`, rated against the previous snapshot, and record this one for
the next rating. Only the process list is rated — a rate is a difference between two
readings of the same counter, and neither a supervision tree nor a table list has one."
  (let (at (os/now)
        prev (get-in m [*state-key* :snapshot])
        rated (ed-rate-procs (get prev :reds) (get prev :at) rows at :pid)
        m1 (if (ed-buffer-displayed? m *buffer-name*)
             (beam-refill m *buffer-name* (beam-text rated) :beam-menu)
             (ed-show-named m *buffer-name* (beam-text rated) :beam-menu)))
    (assoc-in m1 [*state-key* :snapshot] {:at at :reds (beam-snapshot-reds rows)})))

(defn displayed-view (m)
  "The view whose buffer is on screen, or nil — the one the refresh timer should ask about.
The SELECTED buffer's view wins when it is one of them, so with the process list and the
ETS table side by side the timer follows the one you are reading."
  (let (mine (seq/filter (%map-pairs *views*)
               (fn ([_ v]) (ed-buffer-displayed? m (get v :buffer))))
        here (buffer-name (ed-current-buf m))
        sel (seq/find mine (fn ([_ v]) (= (get v :buffer) here))))
    (cond
      sel (first sel)
      (empty? mine) nil
      :else (first (first mine)))))

(defn beam-tick (m)
  "The refresh timer fired: re-ask the node about whichever view is on screen.

Silent about everything that could go wrong — no displayed view, auto-refresh off, a
request already in flight, no session. A timer that reports its own no-ops fills the echo
area with news of nothing happening."
  (if (or (not (auto-refresh? m)) (not (nil? (get-in m [*state-key* :pending]))))
    m
    (let (view (displayed-view m))
      (if (nil? view) m (beam-request m view)))))

(defcommand cmd-beam-auto-refresh
  (m key)
  "Toggle the BEAM views' auto-refresh (M-x beam-auto-refresh, or `a` in one of them).

Off, `g` is the only thing that moves them — which is what you want while you are reading
a row carefully, or attached to a node over a link you would rather not poll."
  (let (on (not (auto-refresh? m)))
    (message (assoc m :beam-auto-refresh on)
      (if on
        (str "BEAM auto-refresh on (every " (math/quot *refresh-ms* 1000) "s)")
        "BEAM auto-refresh off — g to refresh"))))

(defn beam-refill (m nm text type)
  "Put `text` in the buffer named `nm`, KEEPING the reader's line, and without touching the
layout or the selection.

`ed-show-named` is wrong for a refresh. It re-displays the buffer, which selects it — fine
when you pressed `g`, wrong when a timer fired while you were typing in another pane, and
it rebuilds the buffer from scratch so point returns to line 0. Watching the busiest
process on row 40 means nothing if every refresh throws you back to the top.

So: `ed-upsert-named` for the text (pool only — layout and selection untouched), and the
line restored, clamped to the new length. The LINE, not the character offset: these are
tables that re-sort on every snapshot, and a row number is the only thing that survives a
re-sort meaningfully — the same choice `top` on a process list makes."
  (let (idx (ed-buffer-index-by-name m nm)
        line (if (nil? idx) 0 (buffer-current-line (ed-buf-at m idx)))
        m1 (ed-upsert-named m nm text type)
        i2 (ed-buffer-index-by-name m1 nm))
    (if (nil? i2)
      m1
      (let (buf (ed-buf-at m1 i2)
            want (math/max 0 (math/min line (dec (buffer-line-count buf)))))
        (update m1
          :buffers assoc
          i2
          (goto-char buf (text/line->char (buffer-rope buf) want)))))))

(defn beam-show-view (m view reply)
  "Render an arrived observation into the buffer its view names.

A view buffer already on screen is REFILLED in place (`beam-refill`) rather than
re-displayed: the reply may be the answer to a `g` you pressed, or to the refresh timer
firing while you were somewhere else entirely, and only one of those should move you."
  (let (spec (get *views* view)
        rows (or (get reply (get spec :key)) [])
        nm (get spec :buffer)
        show (fn (mm text)
               (if (ed-buffer-displayed? mm nm)
                 (beam-refill mm nm text (get spec :type))
                 (ed-show-named mm nm text (get spec :type)))))
    (case view
      :processes (beam-show m rows)
      :applications (show m (apps-text rows))
      :ets (show m (ets-text rows))
      m)))

;; ---- the session client hooks (registered in `sandbox-events/*clients*`) ----------------

(defn beam-ready (m gen banner)
  "The agent announced itself: ask it what is running, so a buffer opened during a compile
fills in the moment the node is up rather than waiting for a keypress.

Unless one is already on its way. A request sent before the banner QUEUES in the worker and
flushes the moment the child is up, so on a first open both would be in flight and the
earlier answer would be thrown away for no reason."
  (let (was (attached-node m)
        ;; A ready banner means a NEW child, whatever brought it about — a watchdog
        ;; respawn, a crash, `M-x elixir-playground-restart`. It has never heard of the node
        ;; you were attached to, so the attachment is gone and the chip must stop claiming
        ;; it. This is the reliable place to notice: a successful respawn emits no `:down`
        ;; at all (`evalsession/session-respawn`), only the banner from the child that
        ;; replaced the old one.
        m1 (assoc-in (assoc-in m [*state-key* :gen] gen) [*state-key* :attached] nil)
        m2 (if was (message m1 (str "a fresh node — no longer attached to " was)) m1))
    (cond
      (not (beam-live-buffer? m2)) m2
      (get-in m2 [*state-key* :pending]) m2
      else (beam-request m2))))

(defn- beam-kill-reply (m reply)
  "Report what a kill actually did, then re-read the list. The reply is an ordinary
evaluation's, so `:ok false` is the node refusing — a pid that no longer exists, an
expression it could not parse."
  (let ([_ pid] (get-in m [*state-key* :killing])
        m1 (assoc-in m [*state-key* :killing] nil))
    (if (get reply :ok)
      (message (beam-request m1) (str "killed " pid))
      (message m1 (str "could not kill " pid ": " (get reply :error "unknown error"))))))

(defn beam-reply (m reply gen)
  "One reply. Anything this buffer did not ask for is somebody else's — the playground's
evaluation, a straggler from a superseded child — and is left alone, which is the rule that
lets one session serve several clients with no owner tag on the wire.

Every branch clears the id it matched: it is the last thing that will ever be said about
that request, and an id left pending that can never be answered is a buffer that never
refreshes again."
  (let (pending (get-in m [*state-key* :pending])
        killing (first (or (get-in m [*state-key* :killing]) [nil nil]))
        tracing (get-in m [*state-key* :tracing]))
    (cond
      ;; a streamed trace entry — its id is the STREAM this editor chose, not a request
      ;; anything is waiting on, which is how an open-ended trace avoids the watchdog
      (and (get reply :more) (get reply :spy) (= (get reply :id) (stream-id m)))
        (spy-append m (get reply :spy))
      (and tracing (= tracing (get reply :id))) (beam-trace-reply m reply)
      (attach/pending? m :elixir reply) (attach/reply m :elixir reply)
      (and killing (= killing (get reply :id))) (beam-kill-reply m reply)
      (nil? pending) m
      (not (= pending (get reply :id))) m
      ;; A restart answers everything in flight `{:timeout true}` before respawning, so this
      ;; is the ordinary path through `M-x elixir-playground-restart` and not a fault worth
      ;; a sentence. Forget the id and say nothing; the ready that follows asks again.
      (get reply :timeout) (assoc-in m [*state-key* :pending] nil)
      (not (get reply :ok))
        (message (assoc-in m [*state-key* :pending] nil)
          (str "the node could not be observed: " (get reply :error "unknown error")))
      ;; The buffer may have been killed while this was in flight, and `ed-show-named`
      ;; would bring it back — a window reopening on its own, a quarter second after the
      ;; reader closed it. The snapshot is still worth keeping for the next open.
      (not (beam-live-buffer? m)) (assoc-in m [*state-key* :pending] nil)
      else
        (beam-show-view (assoc-in m [*state-key* :pending] nil)
          (get-in m [*state-key* :view] :processes)
          reply))))

(defn beam-down (m code)
  "The child went away. Whatever else this means, it means the ATTACHMENT is gone: the
respawn that follows is a fresh VM that has never heard of the node you were on.

Cleared here rather than left for the next attach, because the alternative is the one
failure this feature must not have — the chip still naming a node while your evaluations
quietly run locally again. Not re-attached either: silently reconnecting to somebody's
production node after a crash is worse than making you ask twice."
  (let (was (attached-node m)
        ;; …and the DEBUGGER state with it. A tracer dies with the VM that held it, so a
        ;; stream id that can never fire again, and a queue of processes stopped in a node
        ;; that no longer exists, are both lies — and `r` on one of those rows would ask a
        ;; fresh node to resume a pid it has never seen.
        m1 (assoc-in (assoc-in (assoc-in (attach/forget m :elixir) [*state-key* :stream] nil)
                       [*state-key* :tracing]
                       nil)
             [*state-key* :stopped]
             (quote ())))
    (cond
      was (message m1 (str "the node went away — no longer attached to " was))
      (not (beam-live-buffer? m1)) m1
      else
        (message m1
          (if (= code :spawn-failed)
            "could not start the Elixir session (is `elixir` on PATH?)"
            "the Elixir node went away — M-x elixir-playground-restart")))))

;; ---- the buffer's own keys -------------------------------------------------------------

(def beam-menu-keymap
  (-> {}
    ;; `g` to refresh and `k` to kill, the same two keys the native process list uses —
    ;; a reader who has used one already knows this one.
    (keymap-bind ["g"] 'beam/cmd-beam-refresh)
    ;; `a` toggles the refresh timer — off while you read a row closely, or over a link
    ;; you would rather not poll
    (keymap-bind ["a"] 'beam/cmd-beam-auto-refresh)
    (keymap-bind ["k"] 'beam/cmd-beam-kill)
    (keymap-bind ["d"] 'beam/cmd-beam-kill)
    (keymap-bind ["x"] 'beam/cmd-beam-kill)))

(def beam-menu-layer
  {:name 'beam-menu
   :keymap beam/beam-menu-keymap
   :commands '("beam-refresh" "beam-auto-refresh" "beam-kill")
   :no-line-numbers true})

(register-type-layers :beam-menu
  (list 'beam/beam-menu-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; The other two views get `g` but not `k`: a supervision tree and a table list are things
;; to READ, and killing a supervised process from a tree view would be asking the
;; supervisor to put it back — a confusing way to do nothing.
(def beam-read-keymap
  (-> {}
    (keymap-bind ["g"] 'beam/cmd-beam-refresh)
    (keymap-bind ["a"] 'beam/cmd-beam-auto-refresh)))

(def beam-read-layer
  {:name 'beam-read
   :keymap beam/beam-read-keymap
   :commands '("beam-refresh" "beam-auto-refresh")
   :no-line-numbers true})

(register-type-layers :beam-apps-menu
  (list 'beam/beam-read-layer 'modes/special-mode-layer 'modes/text-mode-layer))

(register-type-layers :beam-ets-menu
  (list 'beam/beam-read-layer 'modes/special-mode-layer 'modes/text-mode-layer))

(defn beam-kill-expr (pid)
  "The expression that kills the process a row names.

`inspect` prints a pid as `#PID<0.42.0>` and `:erlang.list_to_pid/1` wants `<0.42.0>` —
the `#PID` is Elixir's own decoration, not part of the term's textual form — so the prefix
has to come off. Sent as a charlist sigil rather than a single-quoted literal, which is
deprecated and warns on every kill.

This is a function so it can be asserted on: it is a string built for another language's
parser, and nothing in the editor could have told us it was wrong."
  (str "Process.exit(:erlang.list_to_pid(~c\""
    (if (string/starts-with? pid "#PID") (string/substring pid 4 (string/length pid)) pid)
    "\"), :kill)"))

(defn- beam-pid-at-point (m)
  "The pid printed at the start of the current line, or nil when point is not on a row.
Parsed back out of the LINE rather than kept in a side table, so it cannot go stale against
a buffer that has since been refreshed."
  (let (buf (ed-current-buf m)
        line (string/trim (buffer-line-at buf (buffer-current-line buf))))
    (when (string/starts-with? line "#PID<") (first (string/split line " ")))))

;; ---- the commands ------------------------------------------------------------------------

(defn- beam-open (m view waiting)
  "Open `view`'s buffer empty and ask the node to fill it — the one path behind all three
observations.

Shown at once rather than when the reply lands: a command that waited would block the
editor for as long as a cold `mix` compile takes, and the buffer saying it is waiting is a
better answer than the editor appearing to have ignored the key."
  (let (root (or (:project-root m) (projects/project-root (file/cwd)))
        spec (get *views* view)
        missing (missing-tool root))
    (cond
      missing (message m (str missing " — there is no node to observe"))
      (ed-headless?)
        (message m (str (get spec :buffer) " needs a running editor to receive the node's reply"))
      else
        (do
          (sandbox-events/ensure) ; the UiEvent impls live there; loading it IS registering them
          (elixir-start root)
          (message (beam-request (ed-show-named m (get spec :buffer) waiting (get spec :type)) view)
            (str "asking the node…"))))))

(defcommand cmd-beam-processes
  (m key)
  "What is running in the BEAM node (M-x beam-processes, C-c b p): every process in the VM
your application is running in — name, status, mailbox backlog, memory, reductions,
reductions per second, and what each one is executing right now.

Busiest first, so a process that is spinning sorts itself to the top. `g` refreshes (and
only the second reading can show a rate, since a rate is a difference); `k` kills the
process on the current line.

The node is the playground's — `mix run` in your project root, application started — so
this is your own application and not a demonstration."
  (beam-open m :processes (beam-text (or (get-in m [*state-key* :rows]) []))))

(defcommand cmd-beam-applications
  (m key)
  "The node's supervision tree (M-x beam-applications, C-c b s): every started application
and, under it, the processes its supervisors are supervising — indented by depth, with a
mark on the ones that are themselves supervisors.

This is the shape of your system rather than a list of its parts. A process list tells you
`MyApp.Worker` is busy; this tells you whose child it is, and therefore what restarting it
would take down with it.

`g` refreshes. A library application (`:crypto`, most of `:logger`'s dependencies) has no
tree, and says so rather than being left out."
  (beam-open m :applications (apps-text [])))

(defcommand cmd-beam-ets
  (m key)
  "The node's ETS tables (M-x beam-ets, C-c b e): name, row count, memory, owner, type and
access.

Biggest first, because the question you open it to ask is which table is holding the
memory — an ETS table is the usual answer to \"the node's RSS keeps climbing\", and it is
invisible from a process list since the memory belongs to the table rather than to the
process that made it.

`g` refreshes."
  (beam-open m :ets (ets-text [])))

(defcommand cmd-beam-refresh
  (m key)
  "Ask the node for a fresh snapshot of whichever of its buffers you are in (`g`).

For the process list the second and later readings carry REDS/S — who is busy *now* —
because a rate is a difference and the first reading has nothing to differ from."
  (message (beam-request m (view-of m)) "refreshing…"))

(defcommand cmd-beam-kill
  (m key)
  "Kill the process on the current line (`k`, `d`, `x`) — `Process.exit(pid, :kill)` in the
node — then refresh.

Evaluated in the session like any other expression, which is the honest implementation: the
agent has no privileged kill, and a process list that could reach further into the node than
the playground beside it would be a second, quieter API to audit."
  (let (pid (beam-pid-at-point m))
    (if (nil? pid)
      (message m "not on a process line")
      ;; Pended, so the outcome is REPORTED. Announcing the kill here and refreshing would
      ;; say "killed …" whether or not anything died — and the first version of this
      ;; command could not kill anything at all, because the expression it sent was
      ;; malformed and nothing was listening for the error it came back with.
      (let (id (sandbox/sandbox-next-id m)
            sent (elixir-eval id (beam-kill-expr pid) 5000))
        (if (not sent)
          (message m "the node is not running")
          (message (assoc-in (sandbox/sandbox-ids-used m (inc id)) [*state-key* :killing] [id pid])
            (str "killing " pid "…")))))))

;; ---- attaching to a node that is already running ----------------------------------------
;;
;; Everything above observes the node bedit started. `M-x beam-attach` points the same
;; session at one it did not: your `iex -S mix phx.server`, a release on this machine, or —
;; over an SSH tunnel — one that is not. The process list, the playground and the spy pane
;; all follow, because they all speak to the one agent and the agent is what moves.
;;
;; It is guarded, and the guards are the feature rather than paperwork around it:
;;
;;   * the node is TYPED, never discovered. A list of reachable nodes with RET to attach is
;;     one keystroke from evaluating on production.
;;   * the cookie is ASKED FOR. `~/.erlang.cookie` is offered as the default because it is
;;     usually right, but reading a credential on someone's behalf without their saying so
;;     is how you find out afterwards which machine you connected to.
;;   * the mode line NAMES the node while you are attached (`statusbar`'s `beam` segment),
;;     because the whole risk here is forgetting.

;; The attachment itself is `attach`'s — one implementation for both languages. See that
;; module for why it had to become one: this was two copies, and the second was written
;; without a fix the first had already been given.

(defn attached-node (m)
  "The node the Elixir session is routed to, or nil for its own."
  (attach/attached-node m :elixir))

(defcommand cmd-beam-attach
  (m key)
  "Attach the Elixir session to a node that is already running (M-x beam-attach): prompts
for the node name, then for its cookie.

After it, `M-x beam-processes` lists THAT node's processes and the playground evaluates
THERE — which is the point, and is also why the mode line says so for as long as it lasts.
`M-x beam-detach` goes back.

The node is typed rather than picked from a list on purpose: a menu of reachable nodes is
one keystroke away from evaluating on production."
  (attach/prompt m :elixir))

(defcommand cmd-beam-detach
  (m key)
  "Route the Elixir session back to bedit's own node (M-x beam-detach, C-c b d)."
  (attach/detach m :elixir))

;; ---- the debugger: watch a function, or stop on it ----------------------------------------
;; Brood's side of the editor has had this for a while (`src/debugger.blsp`): a *Spy* stream
;; of calls and returns, and a *Debug* queue of processes stopped at a breakpoint. These are
;; the same two things for the BEAM, over the two primitives that give them:
;; `:erlang.trace_pattern` on a named function, and `:erlang.suspend_process` on whoever
;; calls it.
;;
;; The entries arrive on a STREAM id rather than as the trace request's reply. A trace is
;; open-ended, and an inflight request with no answer for a quiet minute is exactly what the
;; session's watchdog exists to kill.

(def *spy-cap* 500) ; the tail worth keeping — a traced hot path produces thousands
(defn spy-row (e)
  "One traced call or return. A break is marked, because a row that STOPPED something reads
differently from one that merely watched it go past."
  (str (string/pad-right (case (get e :kind) "enter" "→" "exit" "←" "break" "■" "·") 2)
    " "
    (string/pad-right (get e :pid "-") 16)
    " "
    (string/pad-right (clip (get e :fn "-") 40) 40)
    " "
    (clip (or (get e :args) (get e :value) "") 60)))

(defn spy-text (entries)
  (if (empty? entries)
    "  (tracing — nothing has called it yet)\n"
    (str (string/join (map entries spy-row) "\n") "\n")))

(defn stopped-text (stopped)
  "The *BEAM Debug* queue: every process a breakpoint has stopped, newest first.

A stopped process stays stopped until you say otherwise, which is the whole point and also
the hazard — so the buffer says what `r` does, in it, rather than leaving that to a manual."
  (if (empty? stopped)
    "  (nothing stopped — M-x beam-break sets a breakpoint)\n"
    (str "  r resumes the process on this line · g refreshes\n\n"
      (string/join (map stopped
                     (fn (s)
                       (str "  " (string/pad-right (get s :pid "-") 16) "  " (get s :fn "-"))))
        "\n")
      "\n")))

(defn spy-append (m e)
  "Fold one streamed trace entry: into the tail, into the buffer, and — when it STOPPED a
process — into the queue of things waiting for you."
  (let (entries (take (cons e (get-in m [*state-key* :spy] '())) *spy-cap*)
        stopped (if (get e :stopped)
                  (cons {:pid (get e :pid) :fn (get e :fn)} (get-in m [*state-key* :stopped] '()))
                  (get-in m [*state-key* :stopped] '()))
        m1 (assoc-in (assoc-in m [*state-key* :spy] entries) [*state-key* :stopped] stopped)
        m2 (if (nil? (ed-buffer-index-by-name m1 *spy-buffer*))
             m1
             (ed-show-named m1 *spy-buffer* (spy-text (reverse entries)) :beam-spy-menu)))
    (if (or (not (get e :stopped)) (nil? (ed-buffer-index-by-name m2 *debug-buffer*)))
      m2
      (ed-show-named m2 *debug-buffer* (stopped-text stopped) :beam-debug-menu))))

(defn stream-id (m)
  "The id this editor's trace entries arrive on."
  (get-in m [*state-key* :stream]))

(defn- beam-ask-trace (m spec mode)
  (let (id (sandbox/sandbox-next-id m)
        stream (inc id)
        sent (elixir-sandbox/elixir-trace id stream spec mode))
    (if (not sent)
      (message m "the node is not running — M-x beam-processes starts one")
      (message (assoc-in (assoc-in (sandbox/sandbox-ids-used m (+ id 2)) [*state-key* :tracing] id)
                 [*state-key* :stream]
                 stream)
        (str (if (= mode "break") "breaking on " "tracing ") spec "…")))))

(defn- beam-trace-reply (m reply)
  "Report what a trace request did. `functions: 0` never reaches here — the agent answers
that as an error, because a trace that matched nothing looks exactly like a trace that is
simply quiet."
  (let (m1 (assoc-in m [*state-key* :tracing] nil))
    (if (not (get reply :ok))
      (message (assoc-in m1 [*state-key* :stream] nil)
        (str "could not trace: " (get reply :error "unknown error")))
      (message m1
        (str "watching " (get reply :traced) " — " (get reply :functions 0) " function(s)")))))

(defcommand cmd-beam-trace
  (m key)
  "Watch a function in the running node (M-x beam-trace, C-c b t): every call and every
return, streamed into *BEAM Spy* as it happens.

`Mod.fun/arity` for one clause set, `Mod.fun` for every arity, `Mod` for everything it
exports. This is the BEAM's own tracer, so it sees calls your code makes to itself — not
just the ones you put a print in.

`M-x beam-untrace` stops it. One trace at a time, deliberately: a second would silently
replace the first, and the buffer gives you no way to tell which rows came from which."
  (if (not (elixir-running?))
    (message m "no node to trace — M-x beam-processes starts one")
    (assoc (ed-show-named m *spy-buffer* (spy-text '()) :beam-spy-menu)
      :minibuffer
        {:edit (ed-mb-edit "Trace (Mod.fun/arity): " "")
         :on-complete (fn (m1 spec)
                        (if (= (string/trim spec) "")
                          (message m1 "nothing named")
                          (beam-ask-trace m1 (string/trim spec) "trace")))})))

(defcommand cmd-beam-break
  (m key)
  "STOP the node on a function (M-x beam-break, C-c b B): whoever calls it is suspended
where it stands, and listed in *BEAM Debug* until you resume it.

This is a real breakpoint in a running system, so it is also a real hazard: a suspended
process holds whatever it holds — a database connection, a lock, a GenServer's mailbox
filling behind it — for as long as you leave it there. The buffer lists what is stopped and
`r` resumes the one on the line.

What it cannot show you is local variables: the BEAM does not expose them without running
the module interpreted (`:int`). What it does show is where the process is and what started
it, which is most of what a stack trace is for."
  (if (not (elixir-running?))
    (message m "no node to break in — M-x beam-processes starts one")
    (assoc (ed-show-named (ed-show-named m *spy-buffer* (spy-text '()) :beam-spy-menu)
             *debug-buffer*
             (stopped-text '())
             :beam-debug-menu)
      :minibuffer
        {:edit (ed-mb-edit "Break on (Mod.fun/arity): " "")
         :on-complete (fn (m1 spec)
                        (if (= (string/trim spec) "")
                          (message m1 "nothing named")
                          (beam-ask-trace m1 (string/trim spec) "break")))})))

(defcommand cmd-beam-untrace
  (m key)
  "Stop tracing (M-x beam-untrace). Anything already stopped stays stopped — resume it from
*BEAM Debug* — because dropping the trace is not the same as letting those processes go,
and guessing which you meant would be the wrong kind of helpful."
  (let (id (sandbox/sandbox-next-id m)
        sent (elixir-sandbox/elixir-untrace id))
    (if (not sent)
      (message m "the node is not running")
      (message (assoc-in (sandbox/sandbox-ids-used m (inc id)) [*state-key* :stream] nil)
        "stopped tracing"))))

(defcommand cmd-beam-resume
  (m key)
  "Resume the stopped process on this line (`r` in *BEAM Debug*)."
  (let (pid (beam-pid-at-point m))
    (if (nil? pid)
      (message m "not on a stopped process")
      (let (id (sandbox/sandbox-next-id m)
            sent (elixir-sandbox/elixir-resume id pid)
            left (seq/reject (get-in m [*state-key* :stopped] '())
                   (fn (s) (= (get s :pid) pid))))
        (if (not sent)
          (message m "the node is not running")
          (message (ed-show-named (assoc-in (sandbox/sandbox-ids-used m (inc id))
                                    [*state-key* :stopped]
                                    left)
                     *debug-buffer*
                     (stopped-text left)
                     :beam-debug-menu)
            (str "resumed " pid)))))))

(def beam-spy-keymap (-> {} (keymap-bind ["g"] 'beam/cmd-beam-untrace)))

(def beam-spy-layer
  {:name 'beam-spy
   :keymap beam/beam-spy-keymap
   :commands '("beam-untrace")
   :no-line-numbers true})

(def beam-debug-keymap
  (-> {}
    (keymap-bind ["r"] 'beam/cmd-beam-resume)
    (keymap-bind ["g"] 'beam/cmd-beam-refresh)))

(def beam-debug-layer
  {:name 'beam-debug
   :keymap beam/beam-debug-keymap
   :commands '("beam-resume" "beam-refresh")
   :no-line-numbers true})

(register-type-layers :beam-spy-menu
  (list 'beam/beam-spy-layer 'modes/special-mode-layer 'modes/text-mode-layer))

(register-type-layers :beam-debug-menu
  (list 'beam/beam-debug-layer 'modes/special-mode-layer 'modes/text-mode-layer))
