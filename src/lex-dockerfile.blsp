;; src/lex-dockerfile.blsp — lexical Dockerfile highlighting, the fallback docker-mode
;; stands on while the tree-sitter grammar is missing: a `#` comment line, or an
;; instruction line whose leading word is a Dockerfile instruction (FROM, RUN, …; matched
;; case-insensitively) plus any quoted strings in its arguments. The faces are the shared
;; `:syntax/*` ones, so a theme recolours them.

(defmodule lex-dockerfile
  "Lexical Dockerfile highlighting, as a pure function over a source string —
`(dockerfile-spans src)` returns `[start end face]` colour spans in the
`highlight-spans` shape (ascending, non-overlapping, end-exclusive), feeding the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Per line it
classifies a `#` comment, a leading instruction keyword (FROM/RUN/CMD/…, matched
case-insensitively), and quoted-string arguments. Pure, so independently testable."
  (:use editor/face))

;; ---- faces: the shared `:syntax/*` registry, resolved as a line is lexed --------------

(defn dk-face-comment () (face :syntax/comment))
(defn dk-face-instruction () (face :syntax/keyword))
(defn dk-face-string () (face :syntax/string))

;; The Dockerfile instruction set (uppercased; the leading word is matched against
;; this after `upper`-casing, so lowercase / mixed case still highlights).
(def- dk-instructions
  (list "FROM"
    "RUN" "CMD" "LABEL" "MAINTAINER" "EXPOSE" "ENV" "ADD" "COPY" "ENTRYPOINT" "VOLUME" "USER"
    "WORKDIR" "ARG" "ONBUILD" "STOPSIGNAL" "HEALTHCHECK" "SHELL"))

;; ---- scanning helpers -------------------------------------------------------

(defn- dk-word-end (line start line-length)
  "The offset just past the non-whitespace run starting at `start`."
  (math/min line-length (string/span-until line start " \t")))
(sig dk-word-end (string int int -> int))

(defn- dk-strings (line base index line-length acc)
  "Tail-recursive scan of `[index, line-length)` for `\"…\"` / `'…'` runs (offsets shifted
by `base`), each consumed whole so spans stay non-overlapping; returns them ascending."
  (let (quote-char (when (< index line-length) (string/char-at line index)))
    (cond
      (nil? quote-char) (reverse acc)
      (or (= quote-char "\"") (= quote-char "'"))
        (let (close (index-of line quote-char (inc index))
              string-end (if (< close 0) line-length (inc close)))
          (dk-strings line
            base
            string-end
            line-length
            (cons [(+ base index) (+ base string-end) (dk-face-string)] acc)))
      else (dk-strings line base (inc index) line-length acc))))
(sig dk-strings (string int int int list -> list))

;; ---- per-line spans -----------------------------------------------------------

(defn- dk-line-spans (line base)
  "The spans for one `line` starting at offset `base`: a `#` comment whole, else a
leading instruction keyword (when the first word is one) plus quoted-string args."
  (let (line-length (count line) lead (string/span line 0 " \t"))
    (cond
      (>= lead line-length) '()
      (= (string/char-at line lead) "#")
        (list [(+ base lead) (+ base line-length) (dk-face-comment)])
      else
        (let (word-end (dk-word-end line lead line-length)
              word (string/substring line lead word-end))
          (if (includes? dk-instructions (string/upper word))
            (cons [(+ base lead) (+ base word-end) (dk-face-instruction)]
              (dk-strings line base word-end line-length '()))
            (dk-strings line base lead line-length '()))))))
(sig dk-line-spans (string int -> list))

(defn dockerfile-spans (src)
  "Lexically tokenize Dockerfile `src` into a list of `[start end face]` colour spans
(character offsets, end-exclusive) — in the `highlight-spans` shape, so it feeds the
editor's `:fontify` service and the shared `fontify-runs` tiler unchanged. Covers `#`
comments, leading instruction keywords (case-insensitive), and quoted strings. Spans
are ascending and non-overlapping; everything else carries the default face."
  (editor/lexer/lexer-walk-lines src dk-line-spans))
(sig dockerfile-spans (string -> any))

(defn dockerfile-line-lexer ()
  "`dockerfile-spans` as an `editor/highlight` stateless line lexer (brood ADR-471) —
docker-mode's `:line-lexer`.

    (:stateless? (lex-dockerfile/dockerfile-line-lexer))   ;=> true"
  (editor/line-cache/stateless-lexer dockerfile-spans))
