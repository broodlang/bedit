(defmodule linecache
  "The line-state highlight cache each pool buffer with a LINE LEXER keeps (brood ADR-471),
so a lexer mode colours its band from the lines it already lexed instead of re-lexing a
lead-in above the band on every keystroke.

A mode offers one through its `:line-lexer` service: a function of no arguments that builds
an `editor/highlight` line lexer — `line-lexer` for one that carries state from line to line
(markdown's open fence, org's `#+BEGIN_` block), `stateless-lexer` or
`editor/lexer/lexer-line-lexer` for one whose lines colour on their own (the `lex-*` table
formats, shell, dotenv, Dockerfile). It is a builder rather than the lexer itself because a
lexer resolves its faces when it is built: the cache rebuilds it — and starts its lines over —
when the builder or the live `:syntax/*` faces change (or the rainbow switch, `theme/*rainbow-delimiters*`).

The model's `:line-caches` maps a pool index to `{:stamp :lexer :cache}`: what the lexer was
built from, the lexer, and the `line-cache` value threaded through `line-cache-update`.
`panes/ed-refresh-spans` threads it while it refreshes the bands; `pool/ed-kill-at` drops a
killed buffer's (`ed-drop-line-cache-slot`). Keyed by pool index, the way `:syntax-trees` is.
A key that ever names a different document than its cache was built from costs a re-lex and
is never wrong: `line-cache-update` finds the change between ANY two ropes."
  (:use editor/buffer) ; buffer-rope
  (:use editor/highlight) ; line-cache / line-cache-update
  (:use model)) ; ed-mode-service

(def- *stamp-faces*
  ;; the faces a built lexer may have resolved: every `editor/lexer` role's, and the error
  ;; face org paints a TODO in and its heading levels. Markdown's faces are constants and
  ;; need none.
  [:syntax/comment
    :syntax/string :syntax/doc :syntax/number :syntax/keyword :syntax/special :syntax/function
    :syntax/error :org/level-1 :org/level-2 :org/level-3 :org/level-4 :syntax/delimiter-1
    :syntax/delimiter-2 :syntax/delimiter-3 :syntax/delimiter-4 :syntax/delimiter-5
    :syntax/delimiter-6 :syntax/delimiter-7 :syntax/delimiter-8 :syntax/delimiter-9])

(defn- face-stamp ()
  ;; the faces, and whether the Lisp lexers paint brackets by depth — a lexer is built with it
  (cons theme/*rainbow-delimiters* (map *stamp-faces* editor/face/face)))

(defn buffer-line-lexer (buf)
  "The `:line-lexer` builder `buf`'s mode offers, or nil when it colours some other way (a
tree-sitter grammar, brood-mode's reader, a whole-slice `:fontify`)."
  (ed-mode-service buf :line-lexer))

(defn line-band (caches idx buf builder lo hi)
  "`[caches' spans]`: the absolute `[start end face]` spans of lines `[lo, hi)` of `buf` (pool
buffer `idx`) from its line cache in `caches` (the model's `:line-caches`), lexed by the lexer
`builder` makes, and the caches with that buffer's entry brought up to `buf`'s rope. Only the
lines an edit touched are lexed again (`editor/highlight/line-cache-update`), and what the edit
touched comes from the buffer's splice log ([[model/ed-edit-range]]) rather than a compare
of the cached rope with the current one.

A mode's `:line-band-pass`, `(pass rope spans)`, then sees the band: what spans several
lines and so cannot be a line's own colour — markdown's fences, coloured as their language
over the whole fence (brood ADR-489) — is done there. It is not kept in the line cache, whose
lines stay the lexer's."
  (let (held (get caches idx)
        stamp [builder (face-stamp)]
        reuse? (and held (= (:stamp held) stamp))
        lexer (if reuse? (:lexer held) (builder))
        prior (if reuse? (:cache held) (line-cache))
        cached-rope (:rope prior)
        [cache spans] (line-cache-update prior
                        lexer
                        (buffer-rope buf)
                        lo
                        hi
                        (when cached-rope (ed-edit-range buf cached-rope)))
        pass (ed-mode-service buf :line-band-pass))
    [(assoc caches idx {:stamp stamp :lexer lexer :cache cache})
      (if pass (pass (buffer-rope buf) spans) spans)]))

(defn line-band-now (m idx buf builder lo hi)
  "The spans of `line-band` without keeping the cache it built — the view's uncached frame,
which cannot write the model. Exact, and as cheap as the held cache lets it be."
  (second (line-band (or (:line-caches m) {}) idx buf builder lo hi)))

(defn ed-drop-line-cache-slot (m killed)
  "Drop pool slot `killed`'s line cache ahead of its removal from the pool, and shift the
entries above it down one — mirroring the pool shift, as `syntaxtree/ed-drop-syntax-tree-slot`
does for `:syntax-trees`."
  (let (caches (:line-caches m))
    (if (nil? caches)
      m
      (assoc m
        :line-caches
          (fold (%map-pairs (dissoc caches killed))
            {}
            (fn (acc [index entry])
              (assoc acc (if (> index killed) (dec index) index) entry)))))))

(defn sweep-line-caches (caches pool-size)
  "`caches` without the entries whose index fell off the end of a pool of `pool-size`
buffers — `caches` itself, the same value, when none did."
  (if (every? (keys caches) (fn (index) (< index pool-size)))
    caches
    (fold (%map-pairs caches)
      {}
      (fn (acc [index entry]) (if (< index pool-size) (assoc acc index entry) acc)))))
