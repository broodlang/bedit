(defmodule isearch
  "Incremental search (`C-s` / `C-r`) and query-replace (`M-%`) — modal mini-loops
that run *beside* the keymap, like the completion popup (`complete`). When `:isearch`
(or `:query-replace`) is set on the model, `input/ed-update` routes keys here instead
of dispatching them; the search consumes printable chars (extend), `C-s`/`C-r`
(repeat), `Backspace`, `Enter`/`Esc` (exit), and `C-g` (abort), and any *other* key
exits the search and is then dispatched normally (Emacs isearch).

The match is highlighted by setting the buffer's point + mark around it, so the
existing region reverse-video draws it — no view change. Search itself rides on the
`std/buffer` primitives `buffer-search-forward` / `buffer-search-backward` (the
language gap this feature closed; see CLAUDE.md's prime directive). Pure
data→data over the model apart from reading the buffer."
  (:use editor/buffer)  ; buffer-search-forward/backward, push-mark, goto-char, point/length
  (:use model))  ; ed-current-buf / ed-set-buf

;; The transient face the view paints over the current match (model `:overlays`,
;; rendered by `view/ed-hl-ranges`) — distinct from the region, and it never touches
;; the user's mark.
(def ed-face-isearch {:bg :yellow :fg :black})

;; ---- prompt -----------------------------------------------------------------

(defn isearch--prompt (dir string failing? wrapped?)
  "The echo-area label for an isearch state: `I-search: foo`, with a `Failing ` /
`Wrapped ` prefix and a ` backward` infix as the state dictates."
  (str (cond wrapped? "Wrapped " failing? "Failing " else "")
    "I-search"
    (if (= dir :backward) " backward" "")
    ": "
    string))

;; ---- search core ------------------------------------------------------------

(defn isearch--find (buf dir string from)
  "The match start for `string` in `dir` relative to char offset `from`, or nil:
forward = first occurrence at/after `from`; backward = last occurrence before `from`."
  (if (= dir :forward)
    (buffer-search-forward buf string from)
    (buffer-search-backward buf string from)))

(defn isearch--show (m is dir start)
  "Highlight the match at `start` (length from `is`'s string) with a transient overlay
and move **point** there — its end for a forward search, its start for a backward one.
The match shows via `:overlays` (the view's `ed-face-isearch`), so the user's mark is
left untouched. Records the match on `:isearch`."
  (let (buf (ed-current-buf m)
        end (+ start (string-length (get is :string)))
        point (if (= dir :forward) end start))
    (assoc (ed-set-buf m (goto-char buf point))
      :overlays
      [{:start start :end end :face ed-face-isearch}]
      :echo
      (isearch--prompt dir (get is :string) false (get is :wrapped))
      :isearch
      (assoc is :match start :dir dir))))

(defn isearch--land (m is string dir from wrapped?)
  "Re-search `string` in `dir` from `from` and update the model: an empty string
resets to the origin (no match); a hit highlights it; a miss is a failing state that
leaves point where it was."
  (let (buf (ed-current-buf m)
        is2 (assoc is :string string :wrapped wrapped? :dir dir))
    (cond
      (= string "") (assoc m
                      :echo
                      (isearch--prompt dir "" false false)
                      :overlays
                      nil
                      :isearch
                      (assoc is2 :match nil :wrapped false))
      else (let (start (isearch--find buf dir string from))
             (if (nil? start)
               (assoc m
                 :echo
                 (isearch--prompt dir string true wrapped?)
                 :overlays
                 nil
                 :isearch
                 (assoc is2 :match nil))
               (isearch--show m is2 dir start))))))

;; ---- the key handlers -------------------------------------------------------

(defn isearch--extend (m is ch)
  "Add a typed char to the search string and re-search, anchored on the current hit so
the match grows in place: forward from the match start, backward from the match *end*
(so the new char extends the hit leftward rather than jumping to an earlier one). With
no match yet, search from the origin."
  (let (dir (get is :dir)
        match (get is :match)
        from (cond
               (nil? match) (get is :origin)
               (= dir :forward) match
               else (+ match (string-length (get is :string)))))
    ; backward: the match end
    (isearch--land m is (str (get is :string) ch) dir from false)))

(defn isearch--backspace (m is)
  "Drop the last char of the search string and re-search from the origin."
  (let (s (get is :string))
    (isearch--land m
      is
      (if (= s "") "" (substring s 0 (dec (string-length s))))
      (get is :dir)
      (get is :origin)
      false)))

(defn isearch--repeat (m is dir)
  "Find the next match in `dir` (`C-s` / `C-r`): from just past the current match
forward, or just before it backward; wrapping once around the buffer on a miss. An
empty search string reuses the last search (`:isearch-last`)."
  (let (s (get is :string))
    (if (= s "")
      (let (last (or (get m :isearch-last) ""))
        (if (= last "")
          (assoc m :echo (isearch--prompt dir "" false false) :isearch (assoc is :dir dir))
          (isearch--land m is last dir (get is :origin) false)))
      (let (buf (ed-current-buf m)
            match (get is :match)
            len (buffer-length buf)
            from (cond
                   (nil? match) (if (= dir :forward) 0 len)
                   ; failing → wrap
                   (= dir :forward) (+ match (string-length s))
                   ; past this hit (no overlap)
                   else match)
            start (isearch--find buf dir s from))
        (if (not (nil? start))
          (isearch--show m (assoc is :wrapped (nil? match) :dir dir) dir start)
          ;; miss — try once from the far end (wrap)
          (let (wstart (isearch--find buf dir s (if (= dir :forward) 0 len)))
            (if (nil? wstart)
              (assoc m
                :echo
                (isearch--prompt dir s true (get is :wrapped))
                :overlays
                nil
                :isearch
                (assoc is :match nil :dir dir))
              (isearch--show m (assoc is :wrapped true :dir dir) dir wstart))))))))

(defn isearch-exit (m)
  "Finish the search: leave point at the match, push the *origin* onto the mark ring
(so the search start is one `C-u C-SPC` away), remember the search string, and clear
the search state. A no-op if no search is active."
  (let (is (get m :isearch))
    (if (nil? is)
      m
      (let (buf (ed-current-buf m)
            p (buffer-point buf)
            ;; push origin onto the mark ring, then restore point to the match, no region
            b2 (clear-mark (goto-char (push-mark (goto-char buf (get is :origin))) p)))
        (assoc (ed-set-buf m b2)
          :isearch
          nil
          :overlays
          nil
          :isearch-last
          (if (= (get is :string) "") (get m :isearch-last) (get is :string))
          :echo
          "")))))

(defn isearch-abort (m)
  "Abort the search (`C-g`): return point to where it started, drop any region, clear
the search state."
  (let (is (get m :isearch))
    (if (nil? is)
      m
      (assoc (ed-set-buf m (clear-mark (goto-char (ed-current-buf m) (get is :origin))))
        :isearch
        nil
        :overlays
        nil
        :echo
        "quit"))))

;; ---- entry points -----------------------------------------------------------

(def *isearch-keys* [:backspace :ctrl-s :ctrl-r :enter :escape :ctrl-g])

(defn isearch-control-key? (input)
  "Whether an active isearch consumes `input`: a printable char (extends the search)
or one of its control keys. Any other key exits the search and is dispatched normally."
  (or (string? input) (includes? *isearch-keys* input)))

(defn isearch-start (m dir)
  "Begin an incremental search in `dir` (`:forward` / `:backward`) from point."
  (let (p (buffer-point (ed-current-buf m)))
    (assoc m
      :echo
      (isearch--prompt dir "" false false)
      :isearch
      {:dir dir :string "" :origin p :match nil :wrapped false})))

(defn isearch-handle (m input)
  "Fold one isearch control key into the search (gated by `isearch-control-key?`):
printable chars extend, `C-s`/`C-r` repeat, `Backspace` shortens, `Enter`/`Esc` exit,
`C-g` aborts."
  (let (is (get m :isearch))
    (cond
      (string? input) (isearch--extend m is input)
      (= input :backspace) (isearch--backspace m is)
      (= input :ctrl-s) (isearch--repeat m is :forward)
      (= input :ctrl-r) (isearch--repeat m is :backward)
      (or (= input :enter) (= input :escape)) (isearch-exit m)
      (= input :ctrl-g) (isearch-abort m)
      else m)))

;; ---- query-replace (M-%) ----------------------------------------------------
;; A second modal mini-loop, sharing the search core. `:query-replace` carries
;; `{:from :to :match :count}`; each match is highlighted with a transient overlay
;; and the user answers y/n/!/./q. Two minibuffer prompts (from, then to) precede it
;; — see `commands/cmd-query-replace`.

(defn qr--prompt (qr)
  "The echo-area prompt for a query-replace at a match."
  (str "Query replacing " (get qr :from) " with " (get qr :to) ": (y/n/!/./q)"))

(defn qr-finish (m)
  "End query-replace: clear the state + the match overlay, and report the count."
  (let (qr (get m :query-replace)
        n (get qr :count))
    (assoc m
      :query-replace
      nil
      :overlays
      nil
      :echo
      (str "Replaced " n " occurrence" (if (= n 1) "" "s")))))

(defn qr--goto (m pos)
  "Highlight the next match of `:from` at or after `pos` (a transient overlay, point
at its start), or finish if there is none."
  (let (qr (get m :query-replace)
        buf (ed-current-buf m)
        start (buffer-search-forward buf (get qr :from) pos))
    (if (nil? start)
      (qr-finish m)
      (assoc (ed-set-buf m (goto-char buf start))
        :overlays
        [{:start start :end (+ start (string-length (get qr :from))) :face ed-face-isearch}]
        :echo
        (qr--prompt qr)
        :query-replace
        (assoc qr :match start)))))

(defn qr--replace (m)
  "Replace the current match with `:to`; return `[model' next-search-pos]` (the model
with its count bumped, point just past the inserted text)."
  (let (qr (get m :query-replace)
        buf (ed-current-buf m)
        start (get qr :match)
        buf2 (replace-region buf start (+ start (string-length (get qr :from))) (get qr :to))
        nextpos (+ start (string-length (get qr :to))))
    [(assoc (ed-set-buf m buf2)
       :status
       "modified"
       :query-replace
       (assoc qr :count (inc (get qr :count)))) nextpos]))

(defn qr--all (m)
  "Replace the current match and every subsequent one, then finish (`!`)."
  (if (nil? (get (get m :query-replace) :match))
    (qr-finish m)
    (let ([m2 pos] (qr--replace m)
          m3 (qr--goto m2 pos))
      (if (nil? (get m3 :query-replace)) m3 (qr--all m3)))))

(def *qr-keys* ["y" "n" " " "!" "." "q"])

(defn qr-control-key? (input)
  "Whether an active query-replace consumes `input`: an answer key (y/n/space/!/./q)
or Enter/Esc/C-g/Delete. Any other key finishes the replace and is dispatched normally."
  (or (and (string? input) (includes? *qr-keys* input))
    (includes? [:enter :escape :ctrl-g :delete] input)))

(defn qr-start (m from to)
  "Begin query-replace of `from` → `to` from point; jump to the first match."
  (if (= from "")
    (message m "(nothing to replace)")
    (qr--goto (assoc m :query-replace {:from from :to to :match nil :count 0})
      (buffer-point (ed-current-buf m)))))

(defn qr-handle (m input)
  "Fold one query-replace answer key: y/space replace+advance, n/Delete skip, ! all,
. replace-one-and-stop, q/Enter/Esc/C-g stop."
  (let (qr (get m :query-replace))
    (cond
      (or (= input "y") (= input " ")) (let ([m2 pos] (qr--replace m)) (qr--goto m2 pos))
      (or (= input "n") (= input :delete)) (qr--goto m
                                             (+ (get qr :match) (string-length (get qr :from))))
      (= input "!") (qr--all m)
      (= input ".") (let ([m2 _] (qr--replace m)) (qr-finish m2))
      else (qr-finish m))))  ; q / Enter / Esc / C-g
