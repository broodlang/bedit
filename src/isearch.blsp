(defmodule isearch
  "Incremental search (`C-s` / `C-r`) and query-replace (`M-%`) — modal mini-loops
that run *beside* the keymap, like the completion popup (`complete`). When `:isearch`
(or `:query-replace`) is set on the model, `input/ed-update` routes keys here instead
of dispatching them; the search consumes printable chars (extend), `C-s`/`C-r`
(repeat), `Backspace`, `Enter`/`Esc` (exit), and `C-g` (abort), and any *other* key
exits the search and is then dispatched normally (Emacs isearch).

The match is highlighted by setting the buffer's point + mark around it, so the
existing region reverse-video draws it — no view change. Search itself rides on the
`std/buffer` primitives `buffer-search-forward` / `buffer-search-backward` (the
language gap this feature closed; see CLAUDE.md's prime directive). Pure
data→data over the model apart from reading the buffer."
  (:use editor/buffer) ; buffer-search-forward/backward, push-mark, goto-char, point/length
  (:use theme) ; face-isearch — the match highlight (src/theme.blsp)
  (:use model)) ; ed-current-buf / ed-set-buf
;; The match highlight is the theme's `face-isearch`, read when the overlay is made (not
;; copied at load, which kept the old palette's yellow after a theme switch) — distinct
;; from the region, and it never touches the user's mark.

;; ---- prompt -----------------------------------------------------------------

(defn- isearch-prompt (dir string failing? wrapped?)
  "The echo-area label for an isearch state: `I-search: foo`, with a `Failing ` /
`Wrapped ` prefix and a ` backward` infix as the state dictates."
  (str (cond wrapped? "Wrapped " failing? "Failing " else "")
    "I-search"
    (if (= dir :backward) " backward" "")
    ": "
    string))

;; ---- search core ------------------------------------------------------------

;; ---- case: fold, unless you typed a capital ---------------------------------
;; Emacs' rule, and it is two settings working together. `case-fold-search` is `t`, so
;; search ignores case; and `search-upper-case` is `'not-yanks`, so isearch turns folding
;; OFF the moment the pattern contains an upper-case letter (`isearch-no-upper-case-p`).
;;
;; The effect is that you never think about it. `foo` finds `Foo` and `FOO`; `Foo` finds
;; only `Foo`. Asking for case is typing it, which is the one gesture that cannot be
;; ambiguous — where a toggle is a mode you have to remember you are in.

(defn search-fold? (pattern)
  "Should a search for `pattern` ignore case? Yes unless the pattern contains a character
with an upper-case form — `string/has-upper?`, which answers no for a digit, a bracket or
CJK, since those are not a decision about case."
  (not (string/has-upper? pattern)))

(defn- isearch-find (buf dir string from)
  "The match start for `string` in `dir` relative to char offset `from`, or nil:
forward = first occurrence at/after `from`; backward = last occurrence before `from`.
Case-folded unless `string` says otherwise ([[search-fold?]])."
  (let (fold? (search-fold? string))
    (if (= dir :forward)
      (buffer-search-forward buf string from fold?)
      (buffer-search-backward buf string from fold?))))

(defn- isearch-show (m is dir start)
  "Highlight the match at `start` (length from `is`'s string) with a transient overlay
and move **point** there — its end for a forward search, its start for a backward one.
The match shows via `:overlays` (the view's `face-isearch`), so the user's mark is
left untouched. Records the match on `:isearch`."
  (let (buf (ed-current-buf m)
        end (+ start (string/length (:string is)))
        point (if (= dir :forward) end start))
    (assoc (ed-set-buf m (goto-char buf point))
      :overlays [{:start start :end end :face face-isearch}]
      :echo (isearch-prompt dir (:string is) false (:wrapped is))
      :isearch (assoc is :match start :dir dir))))

(defn- isearch-land (m is string dir from wrapped?)
  "Re-search `string` in `dir` from `from` and update the model: an empty string
resets to the origin (no match); a hit highlights it; a miss is a failing state that
leaves point where it was."
  (let (buf (ed-current-buf m)
        is2 (assoc is :string string :wrapped wrapped? :dir dir))
    (cond
      (= string "")
        (assoc m
          :echo (isearch-prompt dir "" false false)
          :overlays nil
          :isearch (assoc is2 :match nil :wrapped false))
      else
        (let (start (isearch-find buf dir string from))
          (if (nil? start)
            (assoc m
              :echo (isearch-prompt dir string true wrapped?)
              :overlays nil
              :isearch (assoc is2 :match nil))
            (isearch-show m is2 dir start))))))

;; ---- the key handlers -------------------------------------------------------

(defn- isearch-extend (m is ch)
  "Add a typed char to the search string and re-search, anchored on the current hit so
the match grows in place: forward from the match start, backward from the match *end*
(so the new char extends the hit leftward rather than jumping to an earlier one). With
no match yet, search from the origin."
  (let (dir (:dir is)
        match (:match is)
        from (cond
               (nil? match) (:origin is)
               (= dir :forward) match
               else (+ match (string/length (:string is)))))
    ; backward: the match end
    (isearch-land m is (str (:string is) ch) dir from false)))

(defn- isearch-yank (m is text)
  "Extend the search string with `text` (a paste) and re-search, anchored like a typed
char; nothing happens for an empty `text`."
  (if (or (nil? text) (= text ""))
    m
    (isearch-extend m is text)))

(defn- isearch-yank-kill (m is)
  "C-y: paste the kill ring's head (the OS clipboard adopted first) into the search —
Emacs `isearch-yank-kill`."
  (let ([m1 text] (ed-kill-head m))
    (if (nil? text) (message m1 "kill ring is empty") (isearch-yank m1 is text))))

(defn- isearch-yank-word (m is)
  "C-w: pull the next word of the buffer — from the end of the current match (or point,
before any match) to the end of the word after it — into the search string, so a search
grows by the text under the cursor: Emacs `isearch-yank-word-or-char`."
  (let (buf (ed-current-buf m)
        match (:match is)
        end (if (nil? match) (:origin is) (+ match (string/length (:string is))))
        after (buffer-point (forward-word (goto-char buf end)))
        text (text/slice (buffer-rope buf) end after))
    (isearch-yank m is text)))

(defn- isearch-backspace (m is)
  "Drop the last char of the search string and re-search from the origin."
  (let (s (:string is))
    (isearch-land m
      is
      (if (= s "") "" (string/substring s 0 (dec (string/length s))))
      (:dir is)
      (:origin is)
      false)))

(defn- isearch-repeat (m is dir)
  "Find the next match in `dir` (`C-s` / `C-r`): from just past the current match
forward, or just before it backward; wrapping once around the buffer on a miss. An
empty search string reuses the last search (`:isearch-last`)."
  (let (s (:string is))
    (if (= s "")
      (let (last (or (:isearch-last m) ""))
        (if (= last "")
          (assoc m :echo (isearch-prompt dir "" false false) :isearch (assoc is :dir dir))
          (isearch-land m is last dir (:origin is) false)))
      (let (buf (ed-current-buf m)
            match (:match is)
            len (buffer-length buf)
            from (cond
                   (nil? match) (if (= dir :forward) 0 len)
                   ; failing → wrap
                   (= dir :forward) (+ match (string/length s))
                   ; past this hit (no overlap)
                   else match)
            start (isearch-find buf dir s from))
        (if start
          (isearch-show m (assoc is :wrapped (nil? match) :dir dir) dir start)
          ;; miss — try once from the far end (wrap)
          (let (wstart (isearch-find buf dir s (if (= dir :forward) 0 len)))
            (if (nil? wstart)
              (assoc m
                :echo (isearch-prompt dir s true (:wrapped is))
                :overlays nil
                :isearch (assoc is :match nil :dir dir))
              (isearch-show m (assoc is :wrapped true :dir dir) dir wstart))))))))

(defn isearch-exit (m)
  "Finish the search: leave point at the match, push the *origin* onto the mark ring
(so the search start is one `C-u C-SPC` away), remember the search string, and clear
the search state. A no-op if no search is active."
  (let (is (:isearch m))
    (if (nil? is)
      m
      (let (buf (ed-current-buf m)
            p (buffer-point buf)
            ;; push origin onto the mark ring, then restore point to the match, no region
            b2 (clear-mark (goto-char (push-mark (goto-char buf (:origin is))) p)))
        (assoc (ed-set-buf m b2)
          :isearch nil
          :overlays nil
          :isearch-last (if (= (:string is) "") (:isearch-last m) (:string is))
          :echo "")))))

(defn isearch-abort (m)
  "Abort the search (`C-g`): return point to where it started, drop any region, clear
the search state."
  (let (is (:isearch m))
    (if (nil? is)
      m
      (assoc (ed-set-buf m (clear-mark (goto-char (ed-current-buf m) (:origin is))))
        :isearch nil
        :overlays nil
        :echo "quit"))))

;; ---- entry points -----------------------------------------------------------

(def *isearch-keys* [:backspace :ctrl-s :ctrl-r :enter :escape :ctrl-g :ctrl-y :ctrl-w])

(defn isearch-control-key? (input)
  "Whether an active isearch consumes `input`: a printable char (extends the search)
or one of its control keys. Any other key exits the search and is dispatched normally."
  (or (string? input) (includes? *isearch-keys* input)))

(defn isearch-start (m dir)
  "Begin an incremental search in `dir` (`:forward` / `:backward`) from point."
  (let (p (buffer-point (ed-current-buf m)))
    (assoc m
      :echo (isearch-prompt dir "" false false)
      :isearch {:dir dir :string "" :origin p :match nil :wrapped false})))

(defn isearch-handle (m input)
  "Fold one isearch control key into the search (gated by `isearch-control-key?`):
printable chars extend, `C-s`/`C-r` repeat, `C-y` pastes the kill ring, `C-w` pulls in the next word of the
buffer, `Backspace` shortens, `Enter`/`Esc` exit, `C-g` aborts."
  (let (is (:isearch m))
    (cond
      (string? input) (isearch-extend m is input)
      (= input :backspace) (isearch-backspace m is)
      (= input :ctrl-s) (isearch-repeat m is :forward)
      (= input :ctrl-r) (isearch-repeat m is :backward)
      (= input :ctrl-y) (isearch-yank-kill m is)
      (= input :ctrl-w) (isearch-yank-word m is)
      (or (= input :enter) (= input :escape)) (isearch-exit m)
      (= input :ctrl-g) (isearch-abort m)
      else m)))

;; ---- query-replace (M-%) ----------------------------------------------------
;; A second modal mini-loop, sharing the search core. `:query-replace` carries
;; `{:from :to :match :count}`; each match is highlighted with a transient overlay
;; and the user answers y/n/!/./q. Two minibuffer prompts (from, then to) precede it
;; — see `commands/cmd-query-replace`.

;; The query-replace state, as the commands below read it. `:match` is nil between the
;; start and the first `qr-goto`; every replace runs at a match, and `qr-match` says so.
(deftype qr (record &open :from string :to string :match (or nil int) :count int))
(sig qr-state (model -> qr))
(defn- qr-state (m)
  "The query-replace in progress — which there is, for every key `qr-key` folds."
  (or (:query-replace m) (error "no query-replace in progress")))
(sig qr-match (qr -> int))
(defn- qr-match (qr)
  "The current match's start — set by `qr-goto` before any replace can run."
  (or (:match qr) (error "query-replace is not at a match")))

(defn- qr-prompt (qr)
  "The echo-area prompt for a query-replace at a match."
  (str "Query replacing " (:from qr) " with " (:to qr) ": (y/n/!/./q)"))

(defn qr-finish (m)
  "End query-replace: clear the state + the match overlay, and report the count."
  (let (qr (qr-state m)
        n (:count qr))
    (assoc m
      :query-replace nil
      :overlays nil
      :echo (str "Replaced " n " occurrence" (if (= n 1) "" "s")))))

(sig qr-goto (model int -> model))
(defn- qr-goto (m pos)
  "Highlight the next match of `:from` at or after `pos` (a transient overlay, point
at its start), or finish if there is none."
  (let (qr (qr-state m)
        buf (ed-current-buf m)
        start (buffer-search-forward buf (:from qr) pos (search-fold? (:from qr))))
    (if (nil? start)
      (qr-finish m)
      (assoc (ed-set-buf m (goto-char buf start))
        :overlays [{:start start :end (+ start (string/length (:from qr))) :face face-isearch}]
        :echo (qr-prompt qr)
        :query-replace (assoc qr :match start)))))

(defn replacement-for (matched to fold?)
  "The text to put in place of `matched`, given the replacement `to`.

Emacs' `case-replace`, and the half of case-insensitive replace that is easy to forget:
if the search ignored case then the text you matched may be capitalised differently from
what you typed, and copying the replacement in verbatim would change the case of prose you
never meant to touch. Replacing `foo` with `bar` across `Foo is FOO` should give
`Bar is BAR`, not `bar is bar`.

Only when the pattern of the MATCH is unambiguous — all upper, or capitalised — and only
when the replacement was typed in lower case, which is the signal that no particular case
was intended. Anything else is left exactly as written: `fooBar` typed as a replacement is
a name, not a sentence."
  (cond
    (not fold?) to
    (not (= to (string/fold-case to))) to
    (= matched "") to
    ;; ALL CAPS in, all caps out — but only when there is a letter to be sure about, so
    ;; `---` does not count as upper case
    (and (= matched (string/upper matched)) (not (= matched (string/fold-case matched))))
      (string/upper to)
    ;; Capitalised in, capitalised out
    (and (= (string/char-at matched 0) (string/upper (string/char-at matched 0)))
      (not (= (string/char-at matched 0) (string/fold-case (string/char-at matched 0)))))
      (str (string/upper (string/char-at to 0)) (string/substring to 1))
    else to))

(sig qr-replace (model -> (tuple model int)))
(defn- qr-replace (m)
  "Replace the current match with `:to` — case-adjusted to the text it is replacing when
the search folded ([[replacement-for]]) — and return `[model' next-search-pos]` (the model
with its count bumped, point just past the inserted text). A buffer that refuses the edit
(read-only) ends the replace there."
  (let (qr (qr-state m)
        start (qr-match qr)
        end (+ start (string/length (:from qr)))
        matched (text/slice (buffer-rope (ed-current-buf m)) start end)
        to (replacement-for matched (:to qr) (search-fold? (:from qr)))
        [m2 replaced?] (ed-try-edit m (fn (b) (replace-region b start end to))))
    (if replaced?
      [(assoc m2 :query-replace (assoc qr :count (inc (:count qr)))) (+ start (string/length to))]
      [(assoc m2 :query-replace (assoc qr :match nil)) (buffer-length (ed-current-buf m2))])))

(defn- qr-matches (buf from pos acc)
  "Every match of `from` at or after `pos`, non-overlapping, as a reversed list of starts
— the matches `!` will replace, found before any of them is."
  (let (start (buffer-search-forward buf from pos (search-fold? from)))
    (if (nil? start)
      acc
      (qr-matches buf from (+ start (math/max 1 (string/length from))) (cons start acc)))))

(defn- qr-replace-at (buf from to starts)
  "`buf` with the match at each of `starts` (ascending, found in `buf` before any edit)
replaced by `to`, case-adjusted per match. Front to back, each start shifted by what the
replacements before it added or removed, so point ends after the last one."
  (let (n (string/length from)
        fold? (search-fold? from))
    (first (fold starts
             [buf 0]
             (fn (acc start)
               (let ([b shift] acc
                     at (+ start shift)
                     matched (text/slice (buffer-rope b) at (+ at n))
                     replacement (replacement-for matched to fold?))
                 [(replace-region b at (+ at n) replacement)
                   (+ shift (- (string/length replacement) n))]))))))

(defn- qr-all (m)
  "Replace the current match and every one after it, then finish (`!`). All of them are
ONE edit in one `undo-group`, so a single undo puts every occurrence back — never the
2×N steps of replacing them one by one."
  (let (qr (qr-state m)
        match (:match qr))
    (if (nil? match)
      (qr-finish m)
      (let (starts (reverse (qr-matches (ed-current-buf m) (:from qr) match '()))
            [m2 replaced?] (ed-try-edit m
                             (fn (b)
                               (undo-group b (fn (g) (qr-replace-at g (:from qr) (:to qr) starts))))))
        (qr-finish (if replaced?
                     (assoc m2 :query-replace (assoc qr :count (+ (:count qr) (count starts))))
                     (assoc m2 :query-replace qr)))))))

(def *qr-keys* ["y" "n" " " "!" "." "q"])

(defn qr-control-key? (input)
  "Whether an active query-replace consumes `input`: an answer key (y/n/space/!/./q)
or Enter/Esc/C-g/Delete. Any other key finishes the replace and is dispatched normally."
  (or (and (string? input) (includes? *qr-keys* input))
    (includes? [:enter :escape :ctrl-g :delete] input)))

(defn qr-start (m from to)
  "Begin query-replace of `from` → `to` from point; jump to the first match."
  (if (= from "")
    (message m "(nothing to replace)")
    (qr-goto (assoc m :query-replace {:from from :to to :match nil :count 0})
      (buffer-point (ed-current-buf m)))))

(defn qr-handle (m input)
  "Fold one query-replace answer key: y/space replace+advance, n/Delete skip, ! all,
. replace-one-and-stop, q/Enter/Esc/C-g stop."
  (let (qr (qr-state m))
    (cond
      (or (= input "y") (= input " ")) (let ([m2 pos] (qr-replace m)) (qr-goto m2 pos))
      (or (= input "n") (= input :delete))
        (qr-goto m
          (+ (qr-match qr) (string/length (:from qr))))
      (= input "!") (qr-all m)
      (= input ".") (let ([m2 _] (qr-replace m)) (qr-finish m2))
      else (qr-finish m)))) ; q / Enter / Esc / C-g
;; ---- the non-interactive replace family (M-x) --------------------------------
;; `query-replace` (M-%) asks at every match; these do not ask at all, which is the whole
;; point of them — `replace-string` over a region you have just selected, `flush-lines` to
;; drop the noise out of a log, `how-many` to answer "is it worth a rename". Emacs binds
;; none of them to a key either; they live on M-x and are reached by name.
;;
;; All five work FROM POINT to the end (Emacs's rule), or over the region when one is
;; active — so "just this function" is a selection away, and the whole buffer is `M-<`
;; first. Each reports what it did, because a replace that silently matched nothing is
;; indistinguishable from one that silently did the wrong thing.

;; The three below are PURE text transforms. Their model-side wrappers (the commands, the
;; region span, the undo-grouped edit) live in `commands`, which already uses this module —
;; so they cannot live here without a cycle, and the split is the right one anyway: what
;; the text becomes is testable without a model.

(sig replace-all-in (string string string bool -> (tuple string int)))
(defn replace-all-in (text from to regexp?)
  "`[text' count]` — every occurrence of `from` in `text` replaced by `to`.

Literal replace is NOT regex with the pattern escaped: `replace-string` is the command you
reach for precisely when the text has `.` and `(` in it, and quietly treating those as a
pattern is the kind of surprise that eats a file. `regex/replace` expands `$1`…`$9` in the
replacement, which is what `replace-regexp` is for."
  (if (= from "")
    [text 0]
    (if regexp?
      [(regex/replace from text to) (count (regex/find-all from text))]
      ;; the literal count is the split count less one — `split` on a 2-occurrence
      ;; needle yields 3 pieces — and `max 0` so a needle absent entirely reads 0
      [(string/replace text from to) (math/max 0 (dec (count (string/split text from))))])))

(sig filter-lines (string string bool -> (tuple string int)))
(defn filter-lines (text pattern keep?)
  "`[text' dropped]` — `text` with the lines matching `pattern` kept (`keep?`) or removed.

A trailing newline is preserved when the input had one: these run over the tail of a
buffer, and silently eating the final newline is a diff nobody asked for."
  (let (nl? (string/ends-with? text "\n")
        body (if nl? (string/substring text 0 (dec (string/length text))) text)
        lines (string/split body "\n")
        hit? (fn (l) (not (nil? (regex/find pattern l))))
        kept (seq/filter lines (fn (l) (if keep? (hit? l) (not (hit? l)))))
        out (string/join kept "\n"))
    [(if (and nl? (not (empty? kept))) (str out "\n") out) (- (count lines) (count kept))]))

(defn count-matches-in (text pattern)
  "How many non-overlapping matches of `pattern` are in `text`."
  (count (regex/find-all pattern text)))
