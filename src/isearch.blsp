(defmodule isearch
  "Incremental search (`C-s` / `C-r`, `C-M-s` / `C-M-r` by regexp, `M-s w` by words): a modal
mini-loop that runs *beside* the keymap, like the completion popup (`complete`). When
`:isearch` is set on the model, `input/ed-update` routes keys here instead of dispatching
them; the search consumes printable chars (extend), `C-s`/`C-r` (repeat), `Backspace`, `M-r` / `M-c` / `M-s w` (the
regexp, case and word toggles), `Enter`/`Esc` (exit), and `C-g` (abort), and any *other* key
exits the search and is then dispatched normally (Emacs isearch).

The match is a transient overlay (`face-isearch`); every OTHER match in the window is lit too
(`face-isearch-lazy`, Emacs's lazy highlight, [[lazy-ranges]]), and the prompt counts them —
`3/17 I-search: foo` (Emacs 27's `isearch-lazy-count`). The count is never taken on a key: it
runs in slices on a timer of its own once typing pauses ([[isearch-count-step]]), so a 50 MB
buffer types as fast as a small one and says `?/N+` while it is still counting.

A literal search rides `std/buffer`'s `buffer-search-forward` / `-backward`; a regexp or
word search, `std/regex`'s rope search (`regex/rope-find`, brood ADR-540) — both read the
rope in place, never flattening the buffer. Pure data→data over the model apart from
reading the buffer."
  (:use editor/buffer) ; buffer-search-forward/backward, push-mark, goto-char, point/length
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use theme) ; face-isearch / face-isearch-lazy — the match highlights (src/theme.blsp)
  (:use memo) ; defmemo — the window's lazy highlight, asked every frame
  (:use clipboard)
  (:use minibuffer :only [ed-mb-edit]) ; M-e edits the search string
  (:use interactive :only [run-command]) ; M-% hands the search to query-replace by name
  (:use model)) ; ed-current-buf / ed-set-buf / register-timer-client
;; The match highlight is the theme's `face-isearch`, read when the overlay is made (not
;; copied at load, which kept the old palette's yellow after a theme switch) — distinct
;; from the region, and it never touches the user's mark.

;; ---- case: fold, unless you typed a capital ---------------------------------
;; Emacs' rule, and it is two settings working together. `case-fold-search` is `t`, so
;; search ignores case; and `search-upper-case` is `'not-yanks`, so isearch turns folding
;; OFF the moment the pattern contains an upper-case letter (`isearch-no-upper-case-p`).
;;
;; The effect is that you never think about it. `foo` finds `Foo` and `FOO`; `Foo` finds
;; only `Foo`. Asking for case is typing it, which is the one gesture that cannot be
;; ambiguous — where a toggle is a mode you have to remember you are in. The toggle is there
;; anyway (M-c, Emacs's `isearch-toggle-case-fold`) for the search the rule gets wrong:
;; `foo` that must not find `Foo`.

(defn search-fold? (pattern)
  "Should a search for `pattern` ignore case? Yes unless the pattern contains a character
with an upper-case form — `string/has-upper?`, which answers no for a digit, a bracket or
CJK, since those are not a decision about case."
  (not (string/has-upper? pattern)))

(defn regexp-fold? (pattern)
  "[[search-fold?]] for a regexp: the letter after a backslash is syntax, not a decision
about case — `\\W` and `\\S` are classes — so it does not count (Emacs's
`isearch-no-upper-case-p` with its regexp flag)."
  (search-fold? (regex/replace pattern "\\\\." "")))

;; ---- what is being searched for ---------------------------------------------
;; A search state `is` is `{:dir :string :origin :match :match-end :wrapped :mode :case …}`.
;; `:mode` is `:literal` (C-s), `:regexp` (C-M-s, M-r) or `:word` (M-s w — the words typed,
;; whatever lies between them in the buffer); `:case` is nil (the rule above) or the M-c
;; override, `:fold` / `:sensitive`.

(defn- isearch-mode (is)
  "The search's kind: `:literal`, `:regexp` or `:word`."
  (or (:mode is) :literal))

(defn- isearch-fold? (is)
  "Does this search ignore case — the M-c override, else the rule for its kind."
  (case (:case is)
    :fold true
    :sensitive false
    (if (= (isearch-mode is) :regexp)
      (regexp-fold? (:string is))
      (search-fold? (:string is)))))

(defn word-search-regexp (string)
  "The pattern a word search for `string` runs: its words in order, anything but word
characters between them, starting at a word boundary — Emacs's `word-search-regexp` in its
LAX form (no boundary after the last word, so the word being typed matches as it grows). Nil
when `string` has no words.

    (isearch/word-search-regexp \"foo  bar\")   ;=> \"\\\\bfoo\\\\W+bar\""
  (let (words (seq/filter (regex/split string "\\W+") (fn (word) (not (= word "")))))
    (if (empty? words)
      nil
      (str "\\b" (string/join (map words regex/escape) "\\W+")))))

(defn- isearch-pattern (is)
  "The search as a regexp (Brood's dialect) — what the count and the lazy highlight run, and
what a regexp or word search searches for. Nil when there is nothing to search for."
  (let (string (:string is))
    (cond
      (= string "") nil
      (= (isearch-mode is) :regexp) string
      (= (isearch-mode is) :word) (word-search-regexp string)
      (= (isearch-mode is) :symbol) (str "\\b" (regex/escape string) "\\b")
      else (regex/escape string))))

(defn- isearch-incomplete? (is)
  "Is this a regexp search whose pattern is still being typed — an open group or set, a
trailing backslash? It is not searched then (Emacs's `[incomplete input]`)."
  (and (= (isearch-mode is) :regexp) (regex/incomplete? (:string is))))

;; ---- the prompt --------------------------------------------------------------

(defn- isearch-prompt (is)
  "The echo-area label for a search state, worded as Emacs's `isearch-message-prefix` words
it: `I-search: foo`, after `Failing ` and `Wrapped ` / `Overwrapped ` (wrapped round and past
where it started), `case-sensitive ` when a failing search was not folding, the kind
(`Regexp I-search`, `Word I-search`) and ` backward`; then ` [incomplete input]` while a
regexp is unfinished, or a toggle's momentary note (` [case sensitive]`)."
  (let (string (:string is)
        match (:match is)
        failing? (and (not (= string "")) (nil? match) (not (:incomplete is)))
        backward? (= (:dir is) :backward)
        point (if backward? match (:match-end is))
        over? (and (int? point) (if backward? (< point (:origin is)) (> point (:origin is))))
        words (str (if failing? "failing " "")
                (cond
                  (not (:wrapped is)) ""
                  over? "overwrapped "
                  else "wrapped ")
                (if (and failing? (not (isearch-fold? is))) "case-sensitive " "")
                (case (isearch-mode is)
                  :regexp "regexp "
                  :word "word "
                  :symbol "symbol "
                  "")
                "I-search"
                (if backward? " backward" "")))
    (str (string/upper (string/substring words 0 1))
      (string/substring words 1)
      ": "
      string
      (cond
        (:incomplete is) " [incomplete input]"
        (:note is) (str " [" (:note is) "]")
        else ""))))

;; ---- the search core ----------------------------------------------------------

(defn- isearch-find (is buf dir from)
  "`[start end]` of the match for `is` in `dir` from char offset `from`, or nil. A literal
search or a regexp or word one: forward the first match at/after `from`, backward the one
starting last while ENDING by `from` — Emacs's `search-backward` and `re-search-backward`,
which is what makes C-r land on the matches the count numbered going forward. A regexp may
match EMPTY (`x*`), and the search stops there as Emacs's does ([[isearch-repeat]] steps
off it).

Within `is`'s `:bounds` (a narrowed pane's restriction): a match that starts before them or
ends past them is no match, as Emacs's search stops at the accessible portion."
  (let (found (isearch-find-anywhere is buf dir from)
        [lo hi] (or (:bounds is) [0 (buffer-length buf)]))
    (when (and found (>= (first found) lo) (<= (second found) hi)) found)))

(defn- isearch-find-anywhere (is buf dir from)
  "[[isearch-find]] over the whole buffer."
  (let (string (:string is)
        fold? (isearch-fold? is))
    (if (= (isearch-mode is) :literal)
      (let (start (if (= dir :forward)
                    (buffer-search-forward buf string from fold?)
                    (buffer-search-backward buf string (- (inc from) (string/length string)) fold?)))
        (when start [start (+ start (string/length string))]))
      (let (pattern (isearch-pattern is)
            found (cond
                    (nil? pattern) nil
                    (= dir :forward)
                      (regex/rope-find (buffer-rope buf) pattern from {:fold? fold? :empty? true})
                    else
                      (regex/rope-find-backward (buffer-rope buf)
                        pattern
                        from
                        {:fold? fold? :empty? true})))
        (when found [(:start found) (:end found)])))))

(defn- isearch-show (m is dir start end)
  "Highlight the match `[start end)` with a transient overlay and move **point** there — its
end for a forward search, its start for a backward one. The match shows via `:overlays`
(the view's `face-isearch`), so the user's mark is left untouched. Records the match on
`:isearch`."
  (let (buf (ed-current-buf m)
        point (if (= dir :forward) end start))
    (assoc (ed-set-buf m (goto-char buf point))
      :overlays [{:start start :end end :face face-isearch}]
      :isearch (assoc is :match start :match-end end :dir dir :failed nil :incomplete false))))

;; A miss is remembered as what it proves: no occurrence of the string in `dir` from `from`,
;; in that exact text. Typing on into a failing search can then never match either — every
;; occurrence of `foo` + `d` starts with an occurrence of `foo`, and an extra character can
;; only turn case folding OFF (an upper-case letter), never on — so the next search is
;; skipped. It is the one isearch key that cost more than the frame: a failing search reads
;; the whole rest of the buffer, ~9 ms on a 44k-line file, and it did that again for every
;; character typed after the first miss. The rope is part of the proof, so an edit that
;; lands mid-search (a revert, a collaborator) searches afresh. LITERAL only: a regexp that
;; fails can match once it grows (`fo` → `fo|ba`), and so can a word search.
(defn- isearch-known-miss? (is buf string dir from)
  "Does the search state `is` already prove that extending its string finds nothing in `dir`
from `from` in `buf`'s text — `string` being its string extended?"
  (let (failed (:failed is))
    (and failed
      (= (isearch-mode is) :literal)
      (nil? (:case is))
      (string/starts-with? string (:string is))
      (= (:from failed) from)
      (= (:dir failed) dir)
      (= (:rope failed) (buffer-rope buf)))))

(defn- isearch-land (m is string dir from wrapped? &optional (stay nil))
  "Re-search `string` in `dir` from `from` and update the model: an empty string resets to
the origin (no match); an unfinished regexp keeps the match it had; a hit highlights it; a
miss is a failing state that leaves point where it was. `stay` (a search growing backward)
is the current match's start, kept when the grown pattern still matches there — Emacs's
`looking-at` before it searches back."
  (let (buf (ed-current-buf m)
        is2 (assoc is :string string :wrapped wrapped? :dir dir :failed nil :incomplete false))
    (cond
      (= string "")
        (assoc m :overlays nil :isearch (assoc is2 :match nil :match-end nil :wrapped false))
      (isearch-incomplete? is2)
        (assoc m :isearch (assoc is2 :incomplete true :wrapped (:wrapped is)))
      else
        (let (here (when (and (int? stay) (= dir :backward))
                     (isearch-find is2 buf :forward stay))
              found (cond
                      (and here (= (first here) stay)) here
                      (isearch-known-miss? is buf string dir from) nil
                      else (isearch-find is2 buf dir from)))
          ;; a miss fails (`ed-ding`): Emacs's failing search rings the bell, which is what
          ;; ends a keyboard macro searching on past the last match
          (if (nil? found)
            (assoc (ed-ding m)
              :overlays nil
              ;; what the miss PROVES, for the next key (`isearch-known-miss?`)
              :isearch
                (assoc is2
                  :match nil
                  :match-end nil
                  :failed {:from from :dir dir :rope (buffer-rope buf)}))
            (isearch-show m is2 dir (first found) (second found)))))))

(defn- isearch-from (is)
  "Where a search re-run in place starts: the current match (its start forward, its end
backward, so it can find that match again), or the origin with no match."
  (let (match (:match is))
    (cond
      (nil? match) (:origin is)
      (= (:dir is) :forward) match
      else (:match-end is))))

;; ---- the key handlers -------------------------------------------------------

;; DEL walks BACK through the search, the way Emacs's `isearch-delete-char` does: every
;; step that changed it — a typed char, a paste, a C-s or C-r, a toggle — pushes the state it
;; replaced (point included) onto `:history`, and DEL pops one — so after three C-s's, DEL
;; steps back through the three matches rather than searching again from the origin.

(defn- isearch-remember (m is)
  "`is` with the state it is about to replace pushed onto its `:history`."
  (assoc is
    :history
      (cons (assoc (dissoc is :history :note) :point (buffer-point (ed-current-buf m)))
        (or (:history is) '()))))

(defn- isearch-extend (m is ch)
  "Add a typed char to the search string and re-search, anchored on the current hit so
the match grows in place: forward from the match start; backward, kept where it is when the
grown string still matches there, else searched back from just past the match's end (Emacs's
`isearch-search-and-update`, so a match one character longer is in reach). With no match
yet, search from the origin."
  (let (match (:match is)
        from (cond
               (nil? match) (:origin is)
               (= (:dir is) :forward) match
               else (math/min (buffer-length (ed-current-buf m)) (inc (:match-end is)))))
    (isearch-land m
      (isearch-remember m is)
      (str (:string is) ch)
      (:dir is)
      from
      (:wrapped is)
      match)))

(defn- isearch-yank (m is text)
  "Extend the search string with `text` (a paste) and re-search, anchored like a typed
char; nothing happens for an empty `text`. A regexp search takes the text literally
(Emacs's `isearch-yank-string` quotes it)."
  (cond
    (or (nil? text) (= text "")) m
    (= (isearch-mode is) :regexp) (isearch-extend m is (regex/escape text))
    else (isearch-extend m is text)))

(defn- isearch-yank-kill (m is)
  "C-y: paste the kill ring's head (the OS clipboard adopted first) into the search —
Emacs `isearch-yank-kill`."
  (let ([m1 text] (ed-kill-head m))
    (if (nil? text) (message m1 "kill ring is empty") (isearch-yank m1 is text))))

(defn- isearch-yank-word (m is)
  "C-w: pull the next word of the buffer — from the end of the current match (or point,
before any match) to the end of the word after it — into the search string, so a search
grows by the text under the cursor: Emacs `isearch-yank-word-or-char`."
  (let (buf (ed-current-buf m)
        match (:match is)
        end (if (nil? match) (:origin is) (:match-end is))
        after (buffer-point (forward-word (goto-char buf end)))
        text (text/slice (buffer-rope buf) end after))
    (isearch-yank m is text)))

(defn- isearch-backspace (m is)
  "DEL: undo the last step of the search — the char or paste that extended it, the C-s /
C-r that moved it, the toggle that changed it — back to the match and point it had before.
At the start of the search there is nothing to undo."
  (let (history (or (:history is) '()))
    (if (empty? history)
      m
      (let (prev (dissoc (assoc (first history) :history (rest history)) :point)
            m1 (ed-set-buf m (goto-char (ed-current-buf m) (:point (first history)))))
        (if (nil? (:match prev))
          (assoc m1 :overlays nil :isearch prev)
          (isearch-show m1 prev (:dir prev) (:match prev) (:match-end prev)))))))

(defn- isearch-last-key (is)
  "Where this kind of search remembers its last string: a regexp's apart from a string's,
as Emacs keeps `regexp-search-ring` apart from `search-ring`."
  (if (= (isearch-mode is) :regexp) :isearch-last-regexp :isearch-last))

(defn- isearch-repeat (m is0 dir)
  "Find the next match in `dir` (`C-s` / `C-r`), as Emacs does:

  - from just past the current match forward, or just before it backward;
  - the first key in the OTHER direction turns round on the current match rather than
    jumping to the next one (C-s then C-r leaves you on the same `foo`, point at its start);
  - a miss FAILS in place — `Failing I-search`, point where it was — and only the next key
    wraps round the buffer (`Wrapped I-search`). Wrapping on the first miss moved the reader
    without telling them they had passed the last match;
  - on an EMPTY match (a regexp like `x*`) the search steps one character on before it
    looks again, failing at the buffer's edge (Emacs's `isearch-repeat`), so it advances.

An empty search string reuses the last search of its kind (`:isearch-last`)."
  (let (is (isearch-remember m is0)
        s (:string is))
    (if (= s "")
      (let (last (or (get m (isearch-last-key is)) ""))
        (if (= last "")
          (assoc m :isearch (assoc is :dir dir))
          (isearch-land m is last dir (:origin is) false)))
      (let (buf (ed-current-buf m)
            match (:match is)
            len (buffer-length buf))
        (if (and (int? match) (not (= dir (:dir is))))
          (isearch-show m (assoc is :dir dir) dir match (:match-end is))
          (let (empty-match? (and (int? match) (= match (:match-end is)))
                from (cond
                       ;; failing: this key wraps — to the narrowing's edge in a narrowed pane
                       (nil? match)
                         (let ([lo hi] (or (:bounds is) [0 len])) (if (= dir :forward) lo hi))
                       ;; an empty match: one character on, or nowhere at the edge
                       (and empty-match? (= dir :forward)) (if (< match len) (inc match) nil)
                       empty-match? (if (> match 0) (dec match) nil)
                       ;; past this hit (no overlap)
                       (= dir :forward) (:match-end is)
                       else match)
                found (when (int? from) (isearch-find is buf dir from)))
            (if found
              (isearch-show m
                ;; wrapped stays wrapped for the rest of the search, as Emacs's `isearch-wrapped`
                (assoc is :wrapped (or (= true (:wrapped is)) (nil? match)) :dir dir)
                dir
                (first found)
                (second found))
              (let (failed (assoc (ed-ding m)
                             :isearch (assoc is :match nil :match-end nil :dir dir)))
                ;; the first miss past a match keeps that match on screen; a miss with
                ;; nothing matched clears it
                (if (int? match) failed (assoc failed :overlays nil))))))))))

(defn- isearch-toggle (m is what)
  "M-r / M-s w / M-c: flip the search to or from a regexp search (`:regexp`), a word search
(`:word`), or its case folding (`:case`), and search again in place — the current match
kept when it still matches. DEL undoes the toggle."
  (let (is1 (dissoc (isearch-remember m is) :failed)
        is2 (case what
              :regexp (assoc is1 :mode (if (= (isearch-mode is1) :regexp) :literal :regexp))
              :word (assoc is1 :mode (if (= (isearch-mode is1) :word) :literal :word))
              (let (fold? (not (isearch-fold? is1)))
                ;; the momentary note Emacs's M-c shows (`isearch--momentary-message`),
                ;; gone at the next key
                (assoc is1
                  :case (if fold? :fold :sensitive)
                  :note (if fold? "case insensitive" "case sensitive")))))
    (isearch-land m is2 (:string is2) (:dir is2) (isearch-from is2) (:wrapped is2) (:match is2))))

;; ---- the match count and the lazy highlight -----------------------------------
;; Emacs 27's `isearch-lazy-count` puts `3/17` before the prompt, and `lazy-highlight` lights
;; every other match in the window. Both come from ONE description of the search, kept on
;; the model as `:isearch-lazy` `{:pattern :fold?}` — the search as a regexp, whatever its
;; kind — which the view reads for the window ([[lazy-ranges]]) and the count reads for the
;; buffer.
;;
;; The count is the part that could freeze the editor: it reads the WHOLE buffer, and a key
;; must not. So it is never taken on a key. A timer of its own ([[isearch-count-timer]]) arms
;; once typing pauses and counts a slice at a time ([[isearch-count-step]]): `regex/rope-count`
;; over `*isearch-count-slice*` characters, as many slices as `*isearch-count-budget-ms*`
;; allows, then the loop takes the next key before the next turn of the timer. The slices
;; add up to exactly the whole count (brood ADR-540), and the prompt says `?/N+` until the
;; last one. Each slice is kept (`[from n]`), so the ORDINAL of the match you are on is the
;; slices before it plus a count of at most one slice — the same bound — rather than a
;; recount from the top.

(defdyn *isearch-count-slice* 262144) ; characters per slice of the count
(defdyn *isearch-count-budget-ms* 3) ; how long one turn of the count timer may count
(defdyn *isearch-count-delay-ms* 100) ; the pause before a count starts (Emacs waits too)

(defn- isearch-lazy-spec (m is)
  "The search as `{:pattern :fold?}`, or nil when there is nothing to search for. An
unfinished regexp keeps the one it had, so the highlights do not blink while a group is
typed."
  (cond
    (:incomplete is) (:isearch-lazy m)
    (isearch-pattern is) {:pattern (isearch-pattern is) :fold? (isearch-fold? is)}
    else nil))

(defn- isearch-count-key (m)
  "What the count in progress counts — `[pattern fold? rope [lo hi]]` — or nil when no search is
active. The rope is part of it: an edit makes it a different count. `[lo hi]` is what the
search may match in: a narrowed pane's restriction (the search's `:bounds`), else the buffer."
  (let (lazy (:isearch-lazy m)
        is (:isearch m))
    (when (and is lazy)
      (let (buf (ed-current-buf m))
        [(:pattern lazy)
          (:fold? lazy)
          (buffer-rope buf)
          (or (:bounds is) [0 (buffer-length buf)])]))))

(defn- isearch-count-current (m)
  "The count kept on the model when it is of the current search, else nil."
  (let (count (:isearch-count m)
        key (isearch-count-key m))
    (when (and key count (= (:key count) key)) count)))

(defn- isearch-count-index (is count)
  "The ordinal of the current match among all of them — the matches starting before it,
plus one — 0 when there is no current match or it is empty (the count, like Emacs's, holds
no empty match), nil when the count has not reached it yet. The kept slices give the matches
before the slice it is in; one bounded count gives the rest."
  (let (at (:match is)
        frontier (:resume count))
    (cond
      (or (nil? at) (= at (:match-end is))) 0
      (and (not (nil? frontier)) (>= at frontier)) nil
      else
        (let ([pattern fold? rope [lo _]] (:key count)
              [before from _] (fold (:slices count)
                                [0 lo 0]
                                ;; the last slice starting at or before the match, and the
                                ;; matches in the slices before it
                                (fn ([before chosen total] [slice-from n])
                                  (if (<= slice-from at)
                                    [total slice-from (+ total n)]
                                    [before chosen total]))))
          (+ before 1 (first (regex/rope-count rope pattern from at {:fold? fold?})))))))

(defn- isearch-count-prefix (m is)
  "The count before the prompt: `3/17 `, `0/17 ` with no current match (Emacs's), `3/17+ `
while the count is still going and `?/17+ ` when it has not reached the match, nothing before
it starts."
  (let (count (isearch-count-current m))
    (if (or (nil? count) (= (:string is) ""))
      ""
      (let (index (isearch-count-index is count))
        (str (if (nil? index) "?" index)
          "/"
          (:total count)
          (if (nil? (:resume count)) "" "+")
          " ")))))

(defn- isearch-refresh (m)
  "The echo area and the lazy-highlight description, recomputed from the search state —
what every key and every slice of the count ends with."
  (let (is (:isearch m))
    (if (nil? is)
      m
      (let (m1 (assoc m :isearch-lazy (isearch-lazy-spec m is)))
        (assoc m1 :echo (str (isearch-count-prefix m1 is) (isearch-prompt is)))))))

(defn isearch-count-due? (m)
  "Is there counting left to do for the search in progress?"
  (let (key (isearch-count-key m)
        count (isearch-count-current m))
    (and (not (nil? key)) (or (nil? count) (not (nil? (:resume count)))))))

(defn isearch-count-timer (m)
  "The count's timer, for `model/register-timer-client`: an idle one-shot while there is
counting to do — `*isearch-count-delay-ms*` after the last key before the count starts, at
once (the next turn) while it is going; nil otherwise."
  (when (isearch-count-due? m)
    {:after (if (nil? (isearch-count-current m)) *isearch-count-delay-ms* 1) :idle? true}))

(defn- crossing-end (pattern rope from hi fold?)
  "1 when the last match starting in `[from hi)` runs past `hi` (a narrowing's end, which a
search cannot cross), else 0. Looked for among the matches in the last few thousand characters
before `hi`: a match longer than that is not looked for."
  (if (>= hi (count rope))
    0
    (let (spans (regex/rope-spans rope pattern (math/max from (- hi 4096)) hi {:fold? fold?}))
      (if (and (not (empty? spans)) (> (second (last spans)) hi)) 1 0))))

(defn isearch-count-step (m)
  "One turn of the count: slices of `*isearch-count-slice*` characters counted until
`*isearch-count-budget-ms*` has gone (at least one), kept on `:isearch-count`
`{:key :slices :resume :total}`, and the prompt redrawn. A no-op with no search."
  (let (key (isearch-count-key m))
    (if (nil? key)
      m
      (let ([pattern fold? rope [lo hi]] key
            start (or (isearch-count-current m) {:key key :slices [] :resume lo :total 0})
            deadline (+ (os/now) *isearch-count-budget-ms*))
        (letrec (slice (fn (count)
                         (let (from (:resume count)
                               [n reached] (regex/rope-count rope
                                             pattern
                                             from
                                             (math/min hi (+ from *isearch-count-slice*))
                                             {:fold? fold?})
                               ;; a narrowed search ends at its restriction, not the buffer's end
                               resume (when (and reached (< reached hi)) reached)
                               ;; and C-s cannot reach a match running past that end, so it is
                               ;; not counted either
                               counted (if (nil? resume)
                                         (- n (crossing-end pattern rope from hi fold?))
                                         n)
                               next {:key key
                                     :slices (conj (:slices count) [from counted])
                                     :resume resume
                                     :total (+ (:total count) counted)})
                           (if (or (nil? resume) (>= (os/now) deadline)) next (slice next)))))
          (isearch-refresh (assoc m :isearch-count (if (nil? (:resume start)) start (slice start)))))))))

(register-timer-client :isearch-count 'isearch/isearch-count-timer 'isearch/isearch-count-step)

(check-allow :trusted
  (defmemo lazy-ranges-at 4 (rope windows lazy face)
    "[[lazy-ranges]] over each char range `[from to]` of `windows`, remembered on what it
reads (the face too, so a theme switch recomputes). A replace confined to the region names
it as the description's `:within [low high]`: only the matches inside it are lit."
    (let ([low high] (or (:within lazy) [0 nil]))
      (mapcat windows
        (fn ([from to])
          (let (spans (regex/rope-spans rope (:pattern lazy) from to {:fold? (:fold? lazy)}))
            (for (span spans
                   :when (and (>= (first span) low) (or (nil? high) (<= (second span) high))))
              [(first span) (second span) face])))))))

(sig lazy-ranges (model any int int any &optional any -> any))
(defn lazy-ranges (m buf top rows selected? &optional (clip nil))
  "The lazy highlight: every match of the search in progress (or the query-replace) on the
window's lines `top` through `top + rows`, as highlight ranges `[from to face-isearch-lazy]`
— Emacs's `lazy-highlight`, in the selected window. The current match's own overlay is
painted over its range. The cost is the window, not the buffer: a long line is searched only
over the part the pane shows of it (`clip`, `spancache/ed-visible-windows`), so a one-line multi-megabyte
file costs its window too."
  (let (lazy (:isearch-lazy m))
    ;; only while a search or a replace is on: a left-over description paints nothing
    (if (or (nil? lazy)
          (not selected?)
          (and (nil? (:isearch m)) (nil? (:query-replace m)) (nil? (:query-replace-preview m))))
      '()
      (let (rope (buffer-rope buf))
        (lazy-ranges-at rope
          (spancache/ed-visible-windows rope top rows clip)
          lazy
          face-isearch-lazy)))))

(defn highlight-source (m pane buf context)
  "The registry row: [[lazy-ranges]], a long line only over the window of it the pane shows, as
the colouring reads it."
  (lazy-ranges m
    buf
    (:top context)
    (:rows context)
    (:selected pane)
    (when (:isearch-lazy m) (spancache/ed-fontify-clip pane buf))))

(defn highlight-deps (m pane buf)
  "What [[highlight-source]] reads off the model: the description, and whether a search, a
replace or a replace's preview is on."
  [(:isearch-lazy m) (nil? (:isearch m)) (nil? (:query-replace m)) (:query-replace-preview m)])

(register-highlight-source :isearch
  {:rank 50 :run 'isearch/highlight-source :deps 'isearch/highlight-deps})

;; ---- leaving, and starting ----------------------------------------------------

(defn isearch-exit (m)
  "Finish the search: leave point at the match, push the *origin* onto the mark ring
(so the search start is one `C-u C-SPC` away), remember the search string, and clear
the search state. A no-op if no search is active."
  (let (is (:isearch m))
    (if (nil? is)
      m
      (let (buf (ed-current-buf m)
            p (buffer-point buf)
            ;; push origin onto the mark ring, then restore point to the match, no region
            b2 (clear-mark (goto-char (push-mark (goto-char buf (:origin is))) p))
            last-key (isearch-last-key is))
        (assoc (ed-set-buf m b2)
          :isearch nil
          :isearch-lazy nil
          :isearch-count nil
          :overlays nil
          last-key (if (= (:string is) "") (get m last-key) (:string is))
          (isearch-ring-key is) (ring-with (get m (isearch-ring-key is)) (:string is))
          :echo "")))))

(defn- isearch-trim-failing (m is)
  "The search `is` (failing) with characters taken off the end of its string until what is left
matches again, or nothing is left — what Emacs's first C-g in a failing search shows."
  (let (string (:string is)
        shorter (string/substring string 0 (dec (string/length string)))
        landed (isearch-land m
                 (dissoc is :failed)
                 shorter
                 (:dir is)
                 (:from (:failed is))
                 (:wrapped is)))
    (if (or (= shorter "") (int? (map/get-in landed [:isearch :match])))
      landed
      (isearch-trim-failing landed (:isearch landed)))))

(defn isearch-abort (m)
  "C-g in a search. In a FAILING one, Emacs's: the characters that do not match are taken back
([[isearch-trim-failing]]), and the search goes on from the last match — the whole search was
thrown away. Otherwise abort: point back where it started, any region dropped, the search
state cleared."
  (let (is (:isearch m))
    (cond
      (nil? is) m
      (and (:failed is) (not (= (:string is) "")))
        (isearch-refresh (dissoc (isearch-trim-failing m is) :command-failed))
      else
        (assoc (ed-set-buf m (clear-mark (goto-char (ed-current-buf m) (:origin is))))
          :isearch nil
          :isearch-lazy nil
          :isearch-count nil
          :overlays nil
          :echo "quit"))))

;; ---- entry points -----------------------------------------------------------

(def *isearch-keys*
  [:backspace
    :ctrl-s :ctrl-r
    :ctrl-meta-s :ctrl-meta-r
    :enter :escape
    :ctrl-g :ctrl-y
    :ctrl-w :alt-r
    :alt-c :alt-s
    :alt-p :alt-n
    :alt-e (keyword "alt-%")
    (keyword "ctrl-meta-%")])

(defn isearch-control-key? (input)
  "Whether an active isearch consumes `input`: a printable char (extends the search)
or one of its control keys. Any other key exits the search and is dispatched normally."
  (or (string? input) (includes? *isearch-keys* input)))

(defn isearch-start (m dir &optional (mode :literal))
  "Begin an incremental search in `dir` (`:forward` / `:backward`) from point — a `mode`
`:literal` (C-s), `:regexp` (C-M-s) or `:word` (M-s w) search, within the selected pane's
narrowing (`model/ed-accessible`)."
  (let (p (buffer-point (ed-current-buf m)))
    (isearch-refresh
      (assoc m
        :isearch-count nil
        ;; `:bounds`: a narrowed pane's restriction, which no match may leave
        :isearch
          {:dir dir
           :string ""
           :origin p
           :match nil
           :wrapped false
           :mode mode
           :bounds (ed-accessible m)}))))

(defn- isearch-meta-s (m is input)
  "The key after `M-s` inside a search: `w` toggles a word search, `r` a regexp search, `c`
case folding (Emacs's `M-s` search map); any other key is handled as itself."
  (let (is1 (dissoc is :meta-s)
        m1 (assoc m :isearch is1))
    (case input
      "w" (isearch-toggle m1 is1 :word)
      "r" (isearch-toggle m1 is1 :regexp)
      "c" (isearch-toggle m1 is1 :case)
      "." (isearch-start-symbol (assoc m1 :isearch nil))
      (isearch-dispatch m1 is1 input))))

;; ---- the search ring (M-p / M-n), M-e, and M-% from a search -------------------
;; Emacs keeps the searches you finished (`search-ring`, a regexp's apart in
;; `regexp-search-ring`); M-p / M-n inside a search step through them, M-e edits the string in
;; the minibuffer, and M-% / C-M-% turn the search into a query-replace of what it found.

(def *isearch-ring-max* 16)

(defn- isearch-ring-key (is)
  ;; where this kind of search's ring lives on the model
  (if (= (isearch-mode is) :regexp) :isearch-ring-regexp :isearch-ring))

(defn- ring-with (ring string)
  ;; `ring` (newest first) with `string` at its head, once, at most `*isearch-ring-max*` long
  (if (= string "")
    ring
    (take (into [string] (seq/reject (or ring []) (fn (old) (= old string)))) *isearch-ring-max*)))

(defn- isearch-ring-step (m is step)
  "M-p (`step` 1, older) / M-n (`step` -1, newer): the search string becomes that entry of the
ring and is searched again from where the search began. Past either end it dings."
  (let (ring (or (get m (isearch-ring-key is)) [])
        index (+ (if (nil? (:ring-index is)) -1 (:ring-index is)) step))
    (if (or (< index 0) (>= index (count ring)))
      (ed-ding (assoc m :isearch is))
      (isearch-land m
        (assoc (isearch-remember m is) :ring-index index)
        (nth ring index)
        (:dir is)
        (:origin is)
        false))))

(defn- isearch-edit-string (m is)
  "M-e: the search string edited in the minibuffer; RET searches again with the edited string
from where the search began, C-g goes back to the search as it was. The search is set aside
while the minibuffer reads (`:isearch-edited`), since it would take the keys."
  (assoc m
    :isearch nil
    :isearch-edited is
    :minibuffer
      {:edit (ed-mb-edit (str (isearch-prompt (assoc is :string "" :match nil :wrapped false)))
               (:string is))
       :on-complete (fn (mm string)
                      (isearch-refresh (isearch-land (assoc mm :isearch is :isearch-edited nil)
                                         (isearch-remember mm is)
                                         string
                                         (:dir is)
                                         (:origin is)
                                         false)))
       :on-abort (fn (mm) (isearch-refresh (assoc mm :isearch is :isearch-edited nil)))}))

(defn- isearch-query-replace (m is regexp?)
  "M-% / C-M-% in a search: the search ends at its match and a query-replace of its string
starts there, asking only for the replacement — Emacs's `isearch-query-replace`. A word search
replaces its words as the regexp it ran; C-M-% replaces a literal search's text as a regexp."
  (let (pattern (isearch-pattern is)
        from (if (or regexp? (= (isearch-mode is) :literal)) (:string is) pattern)
        at (or (:match is) (:origin is))
        exited (isearch-exit (assoc m :isearch is)))
    (if (= (:string is) "")
      exited
      (run-command (ed-set-buf (assoc exited
                                 :query-replace-seed
                                   {:from from
                                    :regexp? (or regexp? (= (isearch-mode is) :word))})
                     (goto-char (ed-current-buf exited) at))
        (if (or regexp? (= (isearch-mode is) :word)) "query-replace-regexp" "query-replace")
        (fn (mm name) (message mm (str name " is not loaded")))))))

(defn- symbol-start (buf symbol)
  ;; where the symbol around point starts: the last start of `symbol` at or before point
  ;; whose span covers point
  (let (point (buffer-point buf)
        from (math/max 0 (- point (string/length symbol))))
    (or (buffer-search-forward buf symbol from false) point)))

(defn isearch-start-symbol (m)
  "M-s . (Emacs's isearch-forward-symbol-at-point): a search for the symbol at point, whole
symbols only, starting at it — the next C-s goes to its next use."
  (let (symbol (complete-words/complete-symbol-around-point (ed-current-buf m)))
    (if (nil? symbol)
      (ed-ding (message m "No symbol at point"))
      (let (started (isearch-start m :forward :symbol)
            buf (ed-current-buf started))
        (isearch-refresh (isearch-land started
                           (:isearch started)
                           symbol
                           :forward (symbol-start buf symbol)
                           false))))))

(defn- isearch-dispatch (m is input)
  "One isearch control key, folded into the search."
  (cond
    (:note is) (isearch-dispatch m (dissoc is :note) input)
    (:meta-s is) (isearch-meta-s m is input)
    (string? input) (isearch-extend m is input)
    (= input :backspace) (isearch-backspace m is)
    ;; C-M-s / C-M-r repeat too, as in Emacs's isearch-mode-map (they began the search)
    (or (= input :ctrl-s) (= input :ctrl-meta-s)) (isearch-repeat m is :forward)
    (or (= input :ctrl-r) (= input :ctrl-meta-r)) (isearch-repeat m is :backward)
    (= input :ctrl-y) (isearch-yank-kill m is)
    (= input :ctrl-w) (isearch-yank-word m is)
    (= input :alt-r) (isearch-toggle m is :regexp)
    (= input :alt-c) (isearch-toggle m is :case)
    (= input :alt-s) (assoc m :isearch (assoc is :meta-s true))
    (= input :alt-p) (isearch-ring-step m is 1)
    (= input :alt-n) (isearch-ring-step m is -1)
    (= input :alt-e) (isearch-edit-string m is)
    (= input (keyword "alt-%")) (isearch-query-replace m is false)
    (= input (keyword "ctrl-meta-%")) (isearch-query-replace m is true)
    (or (= input :enter) (= input :escape)) (isearch-exit m)
    (= input :ctrl-g) (isearch-abort m)
    else m))

(defn isearch-handle (m input)
  "Fold one isearch control key into the search (gated by `isearch-control-key?`):
printable chars extend, `C-s`/`C-r` repeat, `C-y` pastes the kill ring, `C-w` pulls in the
next word of the buffer, `M-r` / `M-c` / `M-s w` toggle a regexp search, case folding and a
word search, `Backspace` steps back, `Enter`/`Esc` exit, `C-g` aborts."
  (isearch-refresh (isearch-dispatch m (:isearch m) input)))

(defrecord isearch-overlay ())
(impl Overlay
  isearch-overlay
  (overlay-active? (_ m) (:isearch m))
  (overlay-owns? (_ m input) (isearch-control-key? input))
  (overlay-handle (_ m input) (isearch-handle m input))
  (overlay-exit (_ m) (isearch-exit m)))

(register-overlay :isearch 50 (isearch-overlay))
