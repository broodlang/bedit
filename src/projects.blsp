(defmodule projects
  "Project awareness for the editor: find the **project root** (the nearest ancestor
directory holding `project.blsp`) and list **every file under it** (recursively,
skipping VCS/build dirs). Pure editor *policy* over the filesystem primitives
(`cwd` / `dir?` / `list-dir` / `file-exists?` + `path-join` / `parent-dir`) — this is
the editor's view of a project (find-file-in-project), distinct from the build tool's
`std/project` (which loads/checks sources). Deliberately a different module name from
std `project` to avoid the clash.")

(defn project-root (dir)
  "The project root for `dir`: the nearest ancestor (including `dir` itself) that
contains a `project.blsp`, or nil if there is none up to the filesystem top.
Tail-recursive (the `:else` self-call is in tail position)."
  (cond
    (file-exists? (path-join dir "project.blsp")) dir
    (= dir (parent-dir dir)) nil
    :else (project-root (parent-dir dir))))

(def *project-ignore-dirs*
  ;; directory names the file walk never descends into
  (list ".git" "target" "_build" "deps" "node_modules" ".brood"))

(defn project--ignored? (name) (includes? *project-ignore-dirs* name))

(defn project--rel (rel name)
  "Append entry `name` to the root-relative dir path `rel` (\"\" = the root itself)."
  (if (= rel "") name (str rel "/" name)))

(defn project--classify (abs rel st name)
  "Fold step: sort entry `name` (under absolute dir `abs`, relative dir `rel`) into
`st` = `[subdirs files]` of root-relative paths; ignored dir names are dropped."
  (let (subdirs (first st)
        files (second st)
        childrel (project--rel rel name))
    (cond
      (project--ignored? name) st
      (dir? (path-join abs name)) [(cons childrel subdirs) files]
      :else [subdirs (cons childrel files)])))

(defn project--walk (root pending acc)
  "Tail-recursive worklist walk: `pending` is a list of root-relative dir paths still
to visit (\"\" = the root); collect root-relative file paths into `acc`. O(1) stack
regardless of tree depth. A directory that can't be listed is treated as empty."
  (if (empty? pending)
    (sort acc)
    (let (rel (first pending)
          abs (if (= rel "") root (path-join root rel))
          entries (try (list-dir abs) (catch e ()))
          step (fold (fn (st name) (project--classify abs rel st name)) [() ()] entries))
      (project--walk root (append (rest pending) (first step)) (append acc (second step))))))

(defn project-files (root)
  "Every file under `root` as sorted root-relative paths (VCS/build dirs skipped);
`()` when `root` is nil."
  (if (nil? root) '() (project--walk root (list "") '())))

(defn project-matches (prefix files)
  "The `files` whose root-relative path starts with `prefix` — the live find-file
candidate set."
  (filter (fn (f) (starts-with? f prefix)) files))

(defn project-name (root)
  "The project's display name: the last path segment of `root` (its directory name),
or `\"\"` when `root` is nil."
  (if (nil? root) "" (last (string-split root "/"))))
