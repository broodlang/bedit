(defmodule projects
  "Project awareness for the editor: find the **project root** (the nearest ancestor
directory holding `project.blsp`) and list **every file under it** (recursively,
skipping VCS/build dirs). Pure editor *policy* over the filesystem primitives
(`cwd` / `dir?` / `list-dir` / `file-exists?` + `path-join` / `parent-dir`) — this is
the editor's view of a project (find-file-in-project), distinct from the build tool's
`std/project` (which loads/checks sources). Deliberately a different module name from
std `project` to avoid the clash.")

(def *project-markers*
  ;; A directory is a project root if it holds any of these. A Brood manifest
  ;; first, then a VCS root — so *any* repository opens as a project, not only a
  ;; Brood one. `.git` matches both a normal repo (a dir) and a worktree/submodule
  ;; (a file), since `file-exists?` is true for either. Edit this list to taste.
  (list "project.blsp" ".git"))

(defn project--marked? (dir)
  "True if `dir` holds any `*project-markers*` entry — i.e. is a project root."
  (not (empty? (filter (fn (marker) (file-exists? (path-join dir marker))) *project-markers*))))

(defn project-root (dir)
  "The project root for `dir`: the nearest ancestor (including `dir` itself) that is
a project root (holds a `*project-markers*` entry — `project.blsp` or `.git`), or nil
if there is none up to the filesystem top. Tail-recursive (the `:else` self-call is
in tail position)."
  (cond
    (project--marked? dir) dir
    (= dir (parent-dir dir)) nil
    :else (project-root (parent-dir dir))))

(defn file-display-name (path &optional root)
  "The buffer label to show for file `path`: its path **relative to the project**
when it sits inside one (so a project file reads as e.g. `src/view.blsp`), else just
its **basename** (a file outside any project is its filename). The project `root` is
optional — omit it (or pass nil) and the current project (`(project-root (cwd))`) is
resolved; pass it (e.g. the model's cached `:project-root`) to avoid re-resolving or
to honour an override. When there's no project at all, the basename. The one naming
policy for opened files — used by the CLI arg, C-x C-f, and project find-file alike."
  (let (r (or root (project-root (cwd)))
        prefix (and r (str r "/")))
    (if (and prefix (starts-with? path prefix))
      (substring path (string-length prefix))
      (path-basename path))))

(def *project-ignore-dirs*
  ;; directory names the file walk never descends into
  (list ".git" "target" "_build" "deps" "node_modules" ".brood"))

(defn project--ignored? (name) (includes? *project-ignore-dirs* name))

(defn project--rel (rel name)
  "Append entry `name` to the root-relative dir path `rel` (\"\" = the root itself)."
  (if (= rel "") name (str rel "/" name)))

(defn project--classify (abs rel st name)
  "Fold step: sort entry `name` (under absolute dir `abs`, relative dir `rel`) into
`st` = `[subdirs files]` of root-relative paths; ignored dir names are dropped."
  (let (subdirs (first st)
        files (second st)
        childrel (project--rel rel name))
    (cond
      (project--ignored? name) st
      (dir? (path-join abs name)) [(cons childrel subdirs) files]
      :else [subdirs (cons childrel files)])))

(defn project--walk (root pending acc)
  "Tail-recursive worklist walk: `pending` is a list of root-relative dir paths still
to visit (\"\" = the root); collect root-relative file paths into `acc`. O(1) stack
regardless of tree depth. A directory that can't be listed is treated as empty."
  (if (empty? pending)
    (sort acc)
    (let (rel (first pending)
          abs (if (= rel "") root (path-join root rel))
          entries (try (list-dir abs) (catch e ()))
          step (fold (fn (st name) (project--classify abs rel st name)) [() ()] entries))
      (project--walk root (append (rest pending) (first step)) (append acc (second step))))))

(defn project-files (root)
  "Every file under `root` as sorted root-relative paths (VCS/build dirs skipped);
`()` when `root` is nil."
  (if (nil? root) '() (project--walk root (list "") '())))

(defn project-matches (prefix files)
  "The `files` whose root-relative path starts with `prefix` — the live find-file
candidate set."
  (filter (fn (f) (starts-with? f prefix)) files))

(defn project-name (root)
  "The project's display name: the last path segment of `root` (its directory name),
or `\"\"` when `root` is nil."
  (if (nil? root) "" (last (string-split root "/"))))

;; ---- known projects (a persisted cache, kept out of the user's files) -------
;; Discovered project roots are remembered in ~/.cache/brood/projects.blsp (XDG cache,
;; honouring $XDG_CACHE_HOME) so `C-c p p` can switch between them. This is a *cache* —
;; auto-discovered, regenerable, most-recently-used first — deliberately under the cache
;; dir, separate from the user's own config/files. The read/write are path-parameterised
;; (`projects--read` / `projects--write!` / `projects--remember`) so the policy is
;; testable without touching the real cache; the public `known-projects` /
;; `remember-project!` close over the default path.

(defn projects--cache-dir ()
  "The editor's cache directory: `$XDG_CACHE_HOME/brood` or `~/.cache/brood`."
  (str (or (getenv "XDG_CACHE_HOME") (str (getenv "HOME") "/.cache")) "/brood"))

(defn projects-file ()
  "Path of the known-projects cache file."
  (path-join (projects--cache-dir) "projects.blsp"))

(defn projects--read (file)
  "The project roots stored in `file` (a vector of paths), or `[]` when it's missing /
unreadable / not a vector — never throws."
  (if (file-exists? file)
    (try (let (v (read-string (slurp file))) (if (vector? v) v [])) (catch e []))
    []))

(defn projects--write! (file roots)
  "Write `roots` (a vector of paths) to `file` as a re-readable literal, creating its
directory. Best-effort: a write failure is swallowed. Returns `roots`."
  (try (do (make-dir (parent-dir file)) (spit file (pr-str roots))) (catch e nil))
  roots)

(defn projects--remember (file root)
  "Move `root` to the front of `file`'s project list (dedup), write it back, and return
the updated vector — most-recently-used first."
  (projects--write! file (into [root] (filter (fn (p) (not (= p root))) (projects--read file)))))

(defn known-projects ()
  "The remembered project roots that still exist (most-recently-used first), or `[]`."
  (filter (fn (p) (dir? p)) (projects--read (projects-file))))

(defn remember-project! (root)
  "Record project `root` as known (most-recently-used), persisting it. Best-effort; a
nil/blank root is ignored. Returns `root`."
  (when (and (string? root) (not (= root ""))) (projects--remember (projects-file) root))
  root)
