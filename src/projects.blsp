(defmodule projects
  "Project awareness for the editor: find the **project root** (the nearest ancestor
directory holding a `*project-markers*` entry or a VCS checkout's top) and list **every file
under it** (the VCS's list, else a bounded walk skipping VCS/build dirs) — the editor's view
of a project (find-file-in-project), distinct from the build tool's `std/project` (which
loads/checks sources), and named apart from it. Also the editor's persisted state under
`editor-state-dir`: known projects, recent files and commands, per-project recency and
frequency, bookmarks."
  (:use config-paths)) ; config-dir — the one config folder the editor's state/ lives under
(defdyn *project-markers*
  ;; A directory is a project root if it holds any of these: a VCS checkout's top — so
  ;; *any* repository or working copy opens as a project, not only a Brood one — plus every
  ;; toolchain's manifest, so an Elixir or Rust checkout inside a monorepo is its own
  ;; project the way it is to `mix` or `cargo`. `.git` matches both a normal repo (a dir)
  ;; and a worktree/submodule (a file), since `file-exists?` is true for either; `.mur` is
  ;; a mur working copy.
  ;;
  ;; Derived rather than written out again: the manifests from `toolchain/*toolchains*`, so
  ;; adding a language is one edit. A VCS checkout's top is a root too, asked of std's `vcs`
  ;; when the question is put (`project-marked?`), so a backend a package registers after
  ;; this module loaded — mur's, which bedit registers — is one without an edit here. Rows marked `:root? false` are
  ;; excluded: a `Makefile` describes what a directory can do, not that it is the top of
  ;; anything. Edit this list (or the toolchain table) to taste.
  (into [".git"]
    (mapcat (seq/filter toolchain/*toolchains* (fn (row) (not (= false (get row :root?)))))
      (fn (row) (get row :markers)))))

(def *project-search-depth* 64)
;; How many ancestor levels `project-root` climbs before giving up (the file's own
;; directory is level 0). Bounds the walk so a file deep under a non-project tree doesn't
;; stat its way to `/` every visit — and guards against a pathological/looping path. 64 is
;; far deeper than any real source tree; lower it (or redefine live) to taste.

(def *project-files-max* 50000)
;; A hard cap on how many directory entries `project-files` will visit. The file walk
;; follows directories naively, and a **symlink cycle** (e.g. `a/loop -> ..`) or a root
;; that's accidentally huge (a remembered `$HOME`, `/`, …) would otherwise walk forever and
;; hang/OOM the editor. Past this many entries the walk stops with what it has — far more
;; than any real project, so legitimate trees are unaffected.

(defn- project-marked? (dir)
  "True if `dir` holds any `*project-markers*` entry, or a registered VCS's marker (std's
`vcs/backends`: `.git`, `.mur`) — i.e. is a project root."
  (or (any? *project-markers* (fn (marker) (file/exists? (path/join dir marker))))
    (any? (vcs/backends) (fn (backend) (file/exists? (path/join dir (:marker (second backend))))))))

(defn project-path (dir)
  "`dir` in the one spelling a project is known by: absolute, with no `.`, `..` or trailing
`/`, so `~/src/x`, `~/src/x/` and `~/src/x/.` are one project.

    (projects/project-path \"/a/b/./\")   ;=> \"/a/b\""
  (path/normalize (path/absolute dir)))

(defn- root-above (dir limit)
  ;; the walk up from `dir`, already in `project-path` form
  (cond
    (project-marked? dir) dir
    (<= limit 0) nil ; give up — too far up
    (= dir (path/dirname dir)) nil ; reached the filesystem top
    else (root-above (path/dirname dir) (dec limit))))

(defn project-root (dir &optional (limit *project-search-depth*))
  "The project root for `dir`: the nearest ancestor (including `dir` itself) that holds a
`*project-markers*` entry or is a VCS checkout's top ([[project-marked?]]), found by walking **backwards** up the
tree, in `project-path` form whatever spelling `dir` came in. `nil` if there's none within
`limit` ancestor levels, or up to the filesystem top — and for a directory on another machine
(`/ssh:…`, `sshpath`), which is never walked on the local disk."
  (if (sshpath/remote? dir) nil (root-above (project-path dir) limit)))

;; The memo behind `project-root-cached`: directory -> `[root-or-nil found-at-ms]`. A table,
;; not model state, because its callers ask from wherever they are (an idle job, a task) and
;; the answer is a fact about the disk, not about any one model.
(def- *project-root-memo* (table/new))

(def *project-root-memo-ms* 10000)
;; How long `project-root-cached` trusts an answer. A marker file appearing (a `git init`,
;; a fresh `project.blsp`) or vanishing is rare and a human act, so a few seconds of a stale
;; answer is the whole cost of the memo; the hot callers ask on every pause in typing.

(def *project-root-memo-max* 256)
;; Directories the memo holds before it starts over — an editor visits a handful; this only
;; bounds a session that walks a great many.

(defn project-root-cached (dir &optional (max-age-ms *project-root-memo-ms*))
  "[[project-root]] of `dir`, memoised per directory for `max-age-ms` (default
[[*project-root-memo-ms*]]) — for
the callers that ask on every pause (the diagnostics launch), where the walk is a
`file/exists?` per marker per ancestor every time.

The invalidation is time, not events: nothing tells the editor that a marker appeared, and
statting the ancestors to find out would be the walk itself. So an answer is trusted for a
few seconds, a project created meanwhile is found once it expires, and a command that must
see the disk as it is now calls [[project-root]]. A nil answer (no project) is remembered
too — that is the walk that climbs all the way up."
  (let (now (os/now)
        hit (table/get *project-root-memo* dir))
    (if (and hit (< (- now (second hit)) max-age-ms))
      (first hit)
      (let (root (project-root dir))
        (when (>= (count *project-root-memo*) *project-root-memo-max*)
          (doseq (entry (table/snapshot *project-root-memo*))
            (table/delete *project-root-memo* (first entry))))
        (table/put *project-root-memo* dir [root now])
        root))))

(defn root-of (m)
  "The project a command acting on model `m` is about: the model's `:project-root`, else
the project the editor was started in (`project-root` of the cwd), else nil — one spelling,
so two sessions of one project are rooted in one place."
  (or (:project-root m) (project-root (file/cwd))))

(defn file-display-name (path &optional root)
  "The buffer label to show for file `path`: its path **relative to the project**
when it sits inside one (so a project file reads as e.g. `src/view.blsp`), else just
its **basename** (a file outside any project is its filename). The project `root` is
optional — omit it (or pass nil) and the current project (`(project-root (file/cwd))`) is
resolved; pass it (e.g. the model's cached `:project-root`) to avoid re-resolving or
to honour an override. When there's no project at all, the basename. The one naming
policy for opened files — used by the CLI arg, C-x C-f, and project find-file alike."
  (or (path-under (or root (project-root (file/cwd))) path) (path/basename path)))

;; ---- a path inside a root: the ONE prefix test ----------------------------------------
;; A directory, not a string prefix: `/p/app` does not hold `/p/app-legacy/x`.

(sig path-under ((or nil string) (or nil string) -> (or nil string)))
(defn path-under (root path)
  "`path` relative to directory `root` when it lies under it, else nil (nil for a nil
`root` or `path` too).

    (projects/path-under \"/p/app\" \"/p/app/src/x.ex\")   ;=> \"src/x.ex\"
    (projects/path-under \"/p/app\" \"/p/app-legacy/x\")   ;=> nil"
  (when (and (string? root) (string? path))
    (let (prefix (filename/as-dir root))
      (when (string/starts-with? path prefix)
        (string/substring path (count prefix) (count path))))))

(sig project-relative ((or nil string) any -> any))
(defn project-relative (root path)
  "`path` relative to `root` when it lies under it, else `path` unchanged — a label or a
command argument that may name a file outside the project."
  (or (path-under root path) path))

(defn path-within? (path root)
  "True when `path` is directory `root` itself or lies under it; false for a nil either."
  (and (string? path) (string? root) (or (= path root) (not (nil? (path-under root path))))))

(def *project-ignore-dirs*
  ;; directory names the file walk never descends into
  (list ".git" ".mur" "target" "_build" "deps" "node_modules" ".brood"))

(defn- project-ignored? (name) (includes? *project-ignore-dirs* name))

(defn- project-rel (rel name)
  "Append entry `name` to the root-relative dir path `rel` (\"\" = the root itself)."
  (if (= rel "") name (str rel "/" name)))

(defn- project-classify (absolute rel sorted name)
  "Fold step: sort entry `name` (under absolute dir `absolute`, relative dir `rel`) into
`sorted` = `[subdirs files]` of root-relative paths; ignored dir names are dropped."
  (let (subdirs (first sorted)
        files (second sorted)
        child (project-rel rel name))
    (cond
      (project-ignored? name) sorted
      (file/dir? (path/join absolute name)) [(cons child subdirs) files]
      else [subdirs (cons child files)])))

(defn- project-walk (root pending acc seen entry-limit)
  "Tail-recursive worklist walk: `pending` is a list of root-relative dir paths still
to visit (\"\" = the root); collect root-relative file paths into `acc`. O(1) stack
regardless of tree depth. A directory that can't be listed is treated as empty. Each
step prepends this dir's subdirs/files (the *small* lists) onto `pending`/`acc` rather
than appending the growing accumulator — O(1) per item, so the whole walk is O(files)
not O(files²). Traversal becomes depth-first and `acc` ends unordered; the final `sort`
fixes the order, so neither matters. `seen` counts directory entries processed so far;
once it reaches `entry-limit` the walk stops between directories — a hard bound against a symlink
cycle (which would loop forever) or an accidentally enormous root (which would OOM)."
  (if (or (empty? pending) (>= seen entry-limit))
    (sort acc)
    (let (rel (first pending)
          absolute (if (= rel "") root (path/join root rel))
          entries (try
                    (file/ls absolute)
                    (catch e
                      (do
                        (log/warn (str "project walk: cannot list " absolute ": " (error-message e)))
                        ())))
          step (fold entries [() ()] (fn (sorted name) (project-classify absolute rel sorted name))))
      ;; `append` shares its LAST list and copies only the small head, so each step is
      ;; O(head), not O(files). Order is irrelevant: the final `sort` fixes it.
      (project-walk root
        (append (first step) (rest pending))
        (append (second step) acc)
        (+ seen (count entries))
        entry-limit))))

(defn- project-vcs-files (root)
  "Project files as the version control lists them — git's tracked and untracked-but-not-
ignored files, mur's `mur files` — as sorted root-relative paths (std's `vcs/files`). Fast
(the VCS does the walk) and correct (it honours `.gitignore`, nested ignores and the global
excludes), so a repo's build/coverage/vendor output never floods find-file. Only when `root`
IS the checkout's top: a project in a subdirectory of a repository would get paths relative
to the repository, not to itself. `nil` otherwise, or when the VCS cannot answer — then the
caller falls back to the manual walk. (Emacs `project.el` lists a VC project the same way.)"
  (let (where (vcs/locate root))
    (if (and where (= (:root where) root)) (vcs/files root) nil)))

(defn project-files (root &optional (entry-limit *project-files-max*))
  "Every project file as sorted root-relative paths; `()` when `root` is nil. A **checkout** (git, mur)
is listed by its version control (honouring `.gitignore` — `project-vcs-files`); otherwise a
manual recursive walk skipping VCS/build dirs, bounded by `entry-limit` entries (default
`*project-files-max*`) so a symlink cycle or huge root can't hang the editor."
  (if (nil? root)
    '()
    (or (project-vcs-files root)
      (project-walk root (list "") '() 0 entry-limit))))

(defn project-matches (prefix files)
  "The `files` whose root-relative path starts with `prefix` — the live find-file
candidate set."
  (seq/filter files (fn (file) (string/starts-with? file prefix))))

(defn project-name (root)
  "The project's display name: the last path segment of `root` (its directory name),
or `\"\"` when `root` is nil."
  (if (nil? root) "" (last (string/split root "/"))))

;; ---- the editor's auto-generated state (one bedit folder) --------------
;; ALL of the editor's generated data — known projects, recent files, per-project recency,
;; bookmarks — lives under one dedicated folder, `~/.config/bedit/state/` (honouring
;; $XDG_CONFIG_HOME), kept separate from the user's hand-edited `init.blsp` and never under
;; the Brood language's own `brood` dirs. Regenerable, most-recently-used first. The
;; read/write helpers are path-parameterised, so the policy is testable without touching the
;; real state; the public `known-projects` / `remember-project!` close over the default path.

(defn editor-state-dir ()
  "The editor's auto-generated state folder — `$XDG_CONFIG_HOME/bedit/state` (else
`~/.config/bedit/state`). The single home for every generated file (known projects,
recent files, per-project recency, bookmarks), never loose beside the user's `init.blsp`.
A `state` subdirectory of `config-paths/config-dir` — the app's folder is named in exactly one
place (`config-paths/*app-id*`), the same string its desktop entry is named after."
  (path/join (config-paths/config-dir) "state"))

(defn projects-file ()
  "Path of the known-projects cache file."
  (path/join (editor-state-dir) "projects.blsp"))

;; ---- the shared persistence layer (one read / write / MRU for ALL generated state) ----
;; Every persisted file in the editor — known projects, recent files, per-project recency,
;; bookmarks, the bshell history — is a single re-readable Brood literal. These three helpers
;; are the *only* code that touches such a file, so the policy lives in exactly one place:
;; tolerant reads (a corrupt file → `[]`, never a crash) and **atomic** writes (so a partial
;; write can never silently truncate the cache). Path-parameterised, so each caller closes
;; over its own file and the policy stays testable without the real state dir.

(defn persist-read-value (file default)
  "The value stored in `file`, or `default` when it's missing, unreadable, or not a single
re-readable form — never throws. Any shape: the MRU caches store vectors, the tutorial's
progress stores a map. A leading `;;` header is skipped by the reader, so a file written for
humans to read (and delete) round-trips fine."
  (if (file/exists? file)
    (try (reflect/read-string (file/slurp file)) (catch _e default))
    default))

(defn persist-read (file)
  "The value stored in `file` (a vector), or `[]` when it's missing / unreadable / not a
vector — never throws. A corrupt or half-written file reads as `[]` instead of crashing.
The vector-shaped reader the MRU caches use; `persist-read-value` is the general one."
  (let (value (persist-read-value file []))
    (if (vector? value) value [])))

(defn persist-write! (file value &optional (header nil))
  "Write `value` to `file` as a re-readable literal, **atomically**: write a sibling `.tmp`
then `rename-file` over the target, so a crash or partial write can never leave a truncated
file that the next `persist-read` would silently lose (then clobber). Creates the directory.
Best-effort — a failure is swallowed. Returns `value`.

`header` is an optional comment line for a file a person might open (the tutorial's
progress says what it is and that deleting it is safe). It is `;;` prose, so the reader
skips it and the round trip is unaffected."
  (if (config-paths/test-forbidden-path? file)
    (log/warn (str "a test tried to write the user's own " file "; refused"))
    (try
      (let (tmp (str file ".tmp"))
        (file/mkdir (path/dirname file))
        (file/spit tmp (str (if (nil? header) "" (str ";; " header "\n")) (pr-str value) "\n"))
        (file/rename tmp file))
      (catch e (log/warn (str "could not persist " file ": " (error-message e))))))
  value)

(defn persist-mru (file entry same? &optional (cap nil))
  "Write `entry` to the front of `file`'s vector, dropping any existing entry `same?` (a
predicate) matches (dedup), capped to `cap` items (nil = unbounded). Returns the new vector.
The most-recently-used write behind known projects, recentf, bookmarks, and bshell history."
  (let (kept (into [entry] (seq/reject (persist-read file) same?)))
    (persist-write! file (if (nil? cap) kept (into [] (take kept cap))))))

(defn- projects-remember (file root)
  "Move `root` to the front of `file`'s project list (dedup), write it back, and return
the updated vector — most-recently-used first."
  (persist-mru file root (fn (known) (= known root))))

(def *known-projects-max* 50)

(defn- live-projects (roots)
  ;; `roots` in `project-path` form, each once (its most recent place kept), the ones whose
  ;; directory is gone dropped
  (seq/distinct (map (seq/filter roots (fn (root) (and (string? root) (file/dir? root))))
                  project-path)))

(defn known-projects ()
  "The remembered project roots that still exist (most-recently-used first), each once
whatever spelling it was saved under, or `[]`."
  (live-projects (persist-read (projects-file))))

(defn- projects-remember-live! (file root)
  "Move `root` to the front of `file`'s project list, dropping it elsewhere (dedup) **and**
dropping any entry whose directory no longer exists (self-healing), capped at
`*known-projects-max*`. Write it back; return the new vector. Path-parameterised so the
prune/cap policy is testable without the real cache."
  (persist-write! file
    (into []
      (take (live-projects (cons (project-path root) (persist-read file))) *known-projects-max*))))

(defn remember-project! (root)
  "Record project `root` as known (most-recently-used), persisting it. Prunes entries whose
directory no longer exists (the cache self-heals) and caps the list at `*known-projects-max*`,
so it can't accumulate dead paths forever. Best-effort; a nil/blank root is ignored. Returns
`root`."
  (when (and (string? root) (not (= root ""))) (projects-remember-live! (projects-file) root))
  root)

;; ---- recent files (recentf — the same cache mechanism as known projects) ----
;; Opened files are remembered most-recently-first under the state dir (capped), so find-file
;; can float the last-used entries to the top of a directory listing. Reuses the shared
;; `persist-*` layer; capped so the cache can't grow forever.

(def *recent-files-max* 200)

(defn recent-files-file ()
  "Path of the recent-files cache file."
  (path/join (editor-state-dir) "recent-files.blsp"))

(defn- recent-remember (file path)
  "Move `path` to the front of `file`'s recent-files list (dedup), capped at
`*recent-files-max*`; write it back; return the updated vector — most-recent first."
  (persist-mru file path (fn (known) (= known path)) *recent-files-max*))

(defn recent-files ()
  "The remembered recently-opened file paths that still exist (most-recent first), or `[]`
— deleted files are filtered out, so they never resurface in find-file (mirrors how
`known-projects` drops vanished roots)."
  (seq/filter (persist-read (recent-files-file)) file/exists?))

(defn remember-file! (path)
  "Record `path` as recently opened (most-recent first), persisting it. Best-effort; a
nil/blank path is ignored. Returns `path`."
  (when (and (string? path) (not (= path ""))) (recent-remember (recent-files-file) path))
  path)

;; ---- recent commands (M-x history — the exact same recentf mechanism) --------
;; Commands run via M-x are remembered most-recently-first under the state dir (capped,
;; persisted across restarts), so `M-x` floats the last-used commands to the top via the
;; shared `float-recent`. Structurally identical to recentf above — one persisted cache, one
;; `persist-mru` write — just keyed to command names instead of file paths.

(def *recent-commands-max* 50)

(defn recent-commands-file ()
  "Path of the recent-commands (M-x history) cache file."
  (path/join (editor-state-dir) "recent-commands.blsp"))

(defn recent-commands ()
  "The remembered recently-run M-x command names (most-recent first), or `[]`."
  (persist-read (recent-commands-file)))

(defn remember-command! (name)
  "Record M-x command `name` as recently run (most-recent first, deduped, capped, persisted).
Best-effort; a nil/blank name is ignored. Returns `name`."
  (when (and (string? name) (not (= name "")))
    (persist-mru (recent-commands-file) name (fn (known) (= known name)) *recent-commands-max*))
  name)

;; ---- per-project recency + the default project-file sort --------------------
;; "Last access" is the EDITOR's own per-project history (filesystem atime is unreliable —
;; `noatime`/`relatime` mounts don't update it), persisted one file per project under a
;; dedicated **auto-generated** folder, kept separate from the user's hand-edited
;; `init.blsp`. `sort-project-files` is the default find-file-in-project order: the files
;; you've visited most recently (per project) first, then everything else by last-written
;; time (mtime). `ed-find-file` records each visit.

(def *project-recent-max* 100)

(defn- project-state-file (folder root)
  "The path of project `root`'s file in the state folder's `folder`: one file per project,
named by the root with slashes encoded (`/` → `%`) so each project keeps its own."
  (path/join (path/join (editor-state-dir) folder) (str (string/replace root "/" "%") ".blsp")))

(defn- project-recent-file (root)
  "The path of project `root`'s recent-file list, under the state folder's `recent/` dir."
  (project-state-file "recent" root))

(defn project-recent (root)
  "The project's recently-visited files (root-relative paths, most-recent first), or `[]`."
  (if (nil? root) [] (persist-read (project-recent-file root))))

(defn remember-project-file! (root rel)
  "Record root-relative file `rel` as visited in project `root`: the most-recently-visited
(dedup, capped) AND one more visit in its count (`project-frequency`), both persisted.
Best-effort; a nil/blank root or file is ignored. Returns `rel`."
  (when (and (string? root) (string? rel) (not (= rel "")))
    (persist-mru (project-recent-file root) rel (fn (known) (= known rel)) *project-recent-max*)
    (persist-count (project-frequency-file root) rel *project-frequency-max*))
  rel)

;; ---- frecency: what you open often and lately ranks higher ---------------------
;; Recency alone forgets the file you open every day the moment you open three others;
;; frequency alone never lets a new file in. prescient keeps both, and so does this: each
;; project counts its visits beside its recent list, and a completion over the project ranks
;; by its fuzzy score PLUS both (`history-boost`, handed to std's `fuzzy` as `:boost`). A
;; boost reorders matches and never admits a non-match, so typing still decides what is
;; listed; history only decides between the files that fit.

(def *project-frequency-max* 500)

(defn- project-frequency-file (root)
  "The path of project `root`'s visit counts, under the state folder's `frequency/` dir."
  (project-state-file "frequency" root))

(defn persist-count (file entry &optional (cap nil))
  "Add one to `entry`'s count in `file`'s `{entry count}` map and write it back; past `cap`
entries the least-counted are dropped, so the file cannot grow forever. Returns the new map.
The counting twin of `persist-mru`, path-parameterised the same way."
  (let (stored (persist-read-value file {})
        counts (if (map? stored) stored {})
        bumped (assoc counts entry (inc (get counts entry 0)))
        kept (if (or (nil? cap) (<= (count bumped) cap))
               bumped
               (into {} (take (seq/sort-by bumped (fn ([_ visits]) (- 0 visits))) cap))))
    (persist-write! file kept)))

(defn project-frequency (root)
  "Project `root`'s `{rel visits}` map, or `{}`."
  (if (nil? root)
    {}
    (let (stored (persist-read-value (project-frequency-file root) {}))
      (if (map? stored) stored {}))))

(def *history-recency-boost* 24) ; what the most recent entry adds; one less per place after
(def *history-recency-floor* 4) ; what any entry still in the history adds
(def *history-visit-boost* 2) ; what each counted visit adds …
(def *history-visit-cap* 10) ; … up to this many visits

(defn history-boost (recent &optional (frequency {}))
  "The `{entry boost}` a history earns in a fuzzy ranking: an entry of `recent` (most recent
first) adds `*history-recency-boost*` less its place, never below `*history-recency-floor*`,
and each visit `frequency` counts adds `*history-visit-boost*`, up to `*history-visit-cap*`
visits. Sized against the score of one well-matched term (a word-start run scores about
7 a char): enough to put a file you use first among the ones that match about as well,
not enough to lift a scattered match over the file you named.

    (projects/history-boost [\"a\" \"b\"] {\"b\" 3 \"c\" 20})   ;=> {\"a\" 24 \"b\" 29 \"c\" 20}"
  (let (by-recency (fold (seq/enumerate recent)
                     {}
                     (fn (acc [place entry])
                       (assoc acc
                         entry (math/max *history-recency-floor* (- *history-recency-boost* place))))))
    (fold frequency
      by-recency
      (fn (acc [entry visits])
        (assoc acc
          entry
            (+ (get acc entry 0) (* *history-visit-boost* (math/min visits *history-visit-cap*))))))))

(defn project-file-boost (root)
  "The frecency boost for project `root`'s files: its recent list and its visit counts
(`history-boost`)."
  (history-boost (project-recent root) (project-frequency root)))

(sig recent-partition (seqable seqable -> (tuple any any)))
(defn recent-partition (candidates recent)
  "`[present rest]`: the entries of `recent` (most-recent first) that are still in `candidates`,
and the `candidates` that are not among them, each in its given order. The split both recency
orders are built from — `float-recent` appends the two, `project-files-order` re-sorts the
second half by mtime.

Both membership tests go through sets, and neither set is built unless it is needed: a
project with nothing remembered floats nothing without hashing every candidate."
  (let (present (if (empty? recent)
                  '()
                  (let (candidate-set (into #{} candidates))
                    (seq/filter recent (fn (entry) (contains? candidate-set entry)))))
        present-set (if (empty? present) nil (into #{} present)))
    [present
      (if (nil? present-set)
        candidates
        (seq/reject candidates (fn (candidate) (contains? present-set candidate))))]))

(defn float-recent (candidates recent)
  "The shared recency-ordering core: `candidates` with the entries present in `recent` (a
most-recent-first list) floated to the front **in recency order**, then the remaining `candidates`
in their given order. The single seam every completion floats its recents through — find-file
(`mincomplete/ed-sort-candidates`), project find-file (`sort-project-files`), and `M-x`
(`commands/cmd-execute-extended-command`) all order through this, so \"recent-first\" behaves
identically everywhere (the recentf model, generalised). Pure — recent lists come from the
persisted `recent-*` caches (`recent-files` / `recent-commands` / `project-recent`)."
  (let ([present rest] (recent-partition candidates recent))
    (append present rest)))

(defn- project-files-order (recent files mtime-of)
  "Pure: order `files` (root-relative) by `recent` (recency, still-present) first, then the
rest by `mtime-of` (a `rel -> epoch-ms` fn) descending. The orderable core of
`sort-project-files`, so it's unit-testable without the filesystem."
  (let ([present rest] (recent-partition files recent)
        decorated (map rest (fn (file) [file (mtime-of file)])))
    (append present (map (sort decorated (fn (left right) (> (second left) (second right)))) first))))

(defn sort-project-files (root files)
  "Project `files` (root-relative) in find-file order: the editor's recorded **recency** per
project first (`project-recent` — the files you've actually visited), then the rest in path
order (already sorted by `project-files`). No per-file mtime stat: that is a syscall per file
on every open, and recency is the signal that matters. (`project-files-order` keeps the
mtime-orderable core for callers that want it.)"
  (float-recent files (project-recent root)))

;; ---- bookmarks (named file positions, persisted — like recentf) -------------
;; A bookmark is `{:name :file :pos}`; the set is a vector kept in the state dir's
;; bookmarks.blsp (most-recent first, deduped by name), via the shared `persist-*` layer.

(defn bookmarks-file ()
  "Path of the bookmarks cache file."
  (path/join (editor-state-dir) "bookmarks.blsp"))

(defn- bookmarks-set (file name target pos)
  "Add/replace bookmark `name` → `{:file :pos}` at the front of `file`'s list (dedup by
name); write it back; return the updated vector."
  (persist-mru file {:name name :file target :pos pos} (fn (bookmark) (= (:name bookmark) name))))

(defn bookmarks () (persist-read (bookmarks-file)))
(defn bookmark-names () (map (bookmarks) :name))
(defn bookmark-get (name) (seq/find (bookmarks) (fn (bookmark) (= (:name bookmark) name))))
(defn bookmark-set! (name target pos) (bookmarks-set (bookmarks-file) name target pos))
