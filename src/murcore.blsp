(defmodule murcore
  "The ground the mur porcelain stands on: running the `mur` client in a working copy
(`mur-mur`), reading what it answers for programs (`mur-json` over its `--json`), finding
the working copy a buffer is about (`mur-resolve-root`), and the seam every command that
changes it goes through — `mur-do` runs it journalled and refreshes *mur-status*,
`mur-launch` runs one that talks to the forge OFF the loop. Both journal into the shared
process log (`$`, `vcsproc`), beside git's.

mur is the version control of Murmuration (`mur.fly.dev`): a CHANGE is one piece of work,
each `mur save` a VERSION of it sent to the forge, `mur land` puts it on TRUNK. Nothing
here knows about the status buffer: refreshing it reaches `murstatus` by name."
  (:use ownership :only []) ; its registrations are claimed at load
  (:use model) ; message
  (:use vcscore) ; vcs-checkout — the working copy a buffer is in
  (:use vcsproc)) ; vcs-run / vcs-launch / vcs-report-cmd — the process log and the off-loop runner
;; `theme` (a project source module, loaded with the image) provides the *blue* / *yellow* /
;; *red* / *green* / *subtext* / *overlay0* dynamic-var colour globals this file reads bare.

;; ---- faces -----------------------------------------------------------------------

(theme/defchrome mur-face-section {:fg *blue* :bold true}) ; a *mur-status* section heading
(theme/defchrome mur-face-id {:fg *yellow*}) ; a change or snapshot ID
(theme/defchrome mur-face-title {:bold true}) ; what a change is for
(theme/defchrome mur-face-label {:fg *subtext*}) ; a header line's label (`Change:`)
(theme/defchrome mur-face-note {:fg *subtext* :italic true}) ; an explanation, a hint
(theme/defchrome mur-face-clash {:fg *red* :bold true}) ; a clash left to settle
(theme/defchrome mur-face-changed {:fg *yellow*}) ; a file changed since the last save
(theme/defchrome mur-face-saved {:fg *green*}) ; saved and sent: nothing waits
(theme/defchrome mur-face-unsent {:fg *blue*}) ; saved here, not on the forge yet
(theme/defchrome mur-face-dim {:fg *overlay0*}) ; claimed by no change

;; ---- running mur ------------------------------------------------------------------

(def *mur-seat* "bedit")
;; The seat (`MUR_RUNNER`) every mur command the editor runs speaks as — the porcelain's and
;; the `vcs` row's the change gutter reads through. With no terminal, mur would otherwise call
;; the editor `person`, the one seat every terminal-less process shares: a script's or an
;; agent's tool call `mur change 2` would then move *mur-status*, and the gutter could read a
;; different change's last save than the status shows.

(defn mur-env ()
  "The environment every mur the editor runs gets: its seat, and no colour codes in what it
prints (mur colours its diff only at a terminal, but say so rather than rely on it)."
  {"NO_COLOR" "1" "MUR_RUNNER" *mur-seat*})

(defdyn *mur-program* nil)
;; The `mur` to run in place of the one looked for: a test's stand-in, or a build of mur that
;; is not installed (a worktree's `target/debug/mur`). nil looks for it (`mur-program`).

(defn mur-program ()
  "Where the `mur` client is: `*mur-program*` when it is bound, else on `PATH`, else where
its installs put it (`~/.local/bin` from the forge's install script, `~/.cargo/bin` from
`make install` in mur) — a desktop launch often has neither on `PATH`. On Windows each is
`mur.exe`: `os/which` applies PATHEXT to a path as to a name. nil when it is not installed."
  (or *mur-program*
    (os/which "mur")
    (when-let (home (path/home))
      (seq/find [(path/join home ".local/bin/mur") (path/join home ".cargo/bin/mur")]
        (fn (candidate) (os/which candidate))))))

(defn mur-mur (root args &optional (opts {}))
  "Run the `mur` client in working copy `root` with `args`: `{:exit :stdout :stderr}`. When
mur is not installed the result says so, as a failed command, rather than raising — the
message names where it was looked for. `opts` go to `os/cmd` (`:timeout-ms`, `:stdin`)."
  (let (program (mur-program))
    (if (nil? program)
      {:exit 127
       :stdout ""
       :stderr "mur is not installed: not on PATH, nor in ~/.local/bin or ~/.cargo/bin (mur.fly.dev/install.sh)"}
      (check-allow :discarded-catch
        (try
          (os/cmd program args (assoc opts :cwd root :env (merge (mur-env) (get opts :env {}))))
          (catch e {:exit 126 :stdout "" :stderr (str "mur could not run: " (error-message e))}))))))
(defn mur-decode (r)
  "The JSON a successful mur result `r` printed, decoded (keyword keys) — nil when it failed
or printed something that is not JSON (a client older than its `--json`).

    (murcore/mur-decode {:exit 0 :stdout \"[1]\"})   ;=> [1]
    (murcore/mur-decode {:exit 0 :stdout \"prose\"})   ;=> nil"
  (if (= (:exit r) 0)
    ;; text that is not JSON is an answer here (an older client), not a fault
    (check-allow :discarded-catch (try (json/decode (:stdout r "")) (catch _ nil)))
    nil))

(defn mur-json (root args &optional (opts {}))
  "What `mur args` answers as JSON, decoded ([[mur-decode]]) — nil when mur failed, is not
installed, or printed something that is not JSON. `opts` as [[mur-mur]]'s (`:timeout-ms`
for one that reads the forge)."
  (mur-decode (mur-mur root args opts)))

(defn mur-resolve-root (m)
  "The mur working copy the current buffer is about — the one a follow-up was asked in when
one is running (`vcsproc/vcs-pinned-root`, so an answer that lands after a switch to another
buffer still acts here), else a mur buffer's own, else the one its directory is in — or nil."
  (let (pinned (vcs-pinned-root m)
        where (if (and pinned (= (vcs/kind pinned) :mur))
                {:kind :mur :root pinned}
                (vcs-checkout m)))
    (if (= (:kind where) :mur) (:root where) nil)))

;; check-allow: `then` is an opaque caller-supplied `(model root) -> model`; the declaration
;; is the contract.
(check-allow :trusted
  (sig mur-with-root (model fn -> model))
  (defn mur-with-root (m then)
    "`(then model root)` with the working copy the buffer is about ([[mur-resolve-root]]) — or
say there is none."
    (let (root (mur-resolve-root m))
      (if (nil? root) (message m "not in a mur working copy") (then m root)))))

(defn mur-short (id)
  "The start of a change or snapshot ID as mur's commands show it: its first twelve
characters.

    (murcore/mur-short \"0ec8927f51595d56ebc1dceee9ba7d85\")   ;=> \"0ec8927f5159\""
  (if (string? id) (string/substring id 0 (math/min 12 (string/length id))) ""))

;; ---- running a command, journalled ---------------------------------------------------

;; check-allow: the function is fetched by name, so the checker cannot see its result; it is
;; `mur-refresh`'s own `model -> model` contract.
(check-allow :trusted
  (sig mur-refresh-status (model -> model))
  (defn mur-refresh-status (m)
    "Refresh the *mur-status* of the working copy the buffer is about (`mur-resolve-root`,
which a follow-up's pin decides) when it is open — `murstatus/mur-refresh`, reached LATE, by
name: the status buffer stands on this module, so this module cannot `:use` it back. Another
working copy's status is left alone."
    (if (nil? (vcs-status-index m :mur-status (mur-resolve-root m)))
      m
      (murstatus/mur-refresh m))))

(defn mur-refresh-if-open (m _r)
  "Refresh the working copy's *mur-status* when it is open — the usual `then` for a launched
mur command."
  (mur-refresh-status m))

(defn mur-do (m verb args)
  "Run `mur args` (logged) in the working copy the buffer is about, then refresh
*mur-status* and say what mur said — its first line on success, the failure and where the
rest is (`$`) otherwise. For a command that stays on this machine (claim, restore, settle,
change to a change here); one that talks to the forge goes through `mur-launch`. The
command runs OFF the loop, queued behind any still running (`vcsproc/vcs-run-queued`)."
  (mur-with-root m
    (fn (m1 root)
      (vcs-run-queued m1
        "mur"
        root
        args
        (fn (dir arguments) (mur-mur dir arguments))
        (fn (m2 r) (vcs-report-cmd (mur-refresh-status m2) verb r))))))

;; check-allow: `then` is an opaque caller-supplied `(model result) -> model`; the
;; declaration is the contract (ADR-341's `:trusted`).
(check-allow :trusted
  (sig mur-launch (model string seqable &optional any -> model))
  (defn mur-launch (m verb args &optional (then mur-refresh-if-open))
    "Run `mur args` in the working copy OFF the loop (`vcsproc/vcs-launch`) and report when it
lands, then run `then` — by default refreshing *mur-status*. For what talks to the forge:
save, land, update, sync, and anything that reads it."
    (mur-with-root m
      (fn (m1 root)
        (vcs-launch m1 "mur" verb root args (fn (dir arguments) (mur-mur dir arguments)) then)))))

;; ---- mur as a `vcs` backend --------------------------------------------------------
;; std's `vcs` answers the questions every tool asks of a checkout — its files, what the work
;; changed, a file's text before the edit — for git, and for any VCS whose package registers a
;; row. mur's is here: bedit is the package that knows mur. Rank 10, before git's 20: a
;; directory holding both is a clone made a mur working copy (`mur init` in it), and mur is
;; what the work goes through now. The hooks are symbols called late, so a redefinition takes
;; effect on the next call.

(defn- mur-lines (root args)
  (let (r (mur-mur root args))
    (if (= (:exit r) 0) (sort (seq/reject (string/split (:stdout r) "\n") empty?)) nil)))

(defn mur-vcs-files (root)
  "The files of the working copy at `root`, root-relative and sorted (`mur files`: not
ignored, or tracked); nil when mur cannot answer."
  (mur-lines root ["files"]))

(defn mur-vcs-changed (root)
  "The files the change adds or modifies against trunk, saved or not (`mur files --changed`)."
  (mur-lines root ["files" "--changed"]))

(defn mur-vcs-base-text (root path)
  "The text of `path` (absolute) as `mur status` and `mur diff` compare it — the change's last
save, else trunk (`mur cat`); nil for a file neither has (a new one)."
  (let (r (mur-mur root ["cat" path])) (if (= (:exit r) 0) (:stdout r) nil)))

(defn mur-vcs-id (root)
  "`{:id <snapshot> :dirty? <files changed since>}` from `mur id`, which marks a changed tree
with a trailing `+`."
  (let (r (mur-mur root ["id"])
        text (if (= (:exit r) 0) (string/trim (:stdout r)) ""))
    (if (= text "") nil {:id (string/drop-suffix text "+") :dirty? (string/ends-with? text "+")})))

(ownership/claim! :vcs/backends
  :mur {:rank 10
   :marker ".mur"
   ;; ROOTED symbols — a project module's globals live under the project's name — called late
   :files 'bedit/murcore/mur-vcs-files
   :changed 'bedit/murcore/mur-vcs-changed
   :base-text 'bedit/murcore/mur-vcs-base-text
   :id 'bedit/murcore/mur-vcs-id})
