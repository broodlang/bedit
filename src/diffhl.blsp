(defmodule diffhl
  "diff-hl-style change gutter: per-line indicators (added / modified / deleted against what
the version control compares the file with — git's HEAD, mur's last save), painted as a
coloured bar in the left of the line-number gutter. The per-line status is computed by
std's `diff/line-status` of the buffer's text against that base text (`vcs/base-text`, std's,
whichever VCS the file is in) and cached on
the buffer under `:vcs-line-status` (a `{0-based-line -> :added|:modified|:deleted}` map), so
the gutter cell — which sees only the buffer — can paint it without the model. The model-level
recompute (off the loop, re-armed on edit/save) is `ed-launch-diffhl`, below: an idle-beat job
this module registers when it loads (`model/register-idle-job`). The module is deferred: the
gutter paint (`modes/line-number-cell`) loads it, and until something has there are no bars to
recompute.

`vcs/base-text` shells out (a subprocess); it and `diffhl-status-map` are unit-tested against
real git without the editor (tests/diffhl_test.blsp)."
  (:use editor/buffer) ; buffer-file / buffer-rope
  (:use editor/buffer-file)
  (:use model) ; ed-current-buf / ed-set-buf / ed-buf-at / ed-headless? / the registries
  (:use interactive) ; defcommand — C-x v ] / [
  (:use task) ; task — the diff runs off the loop
  (:use theme :only [*green* *red* *yellow*])) ; the palette the faces are drawn from
;; `theme` (a project source module, loaded with the image) provides the *green* /
;; *yellow* / *red* dynamic-var colour globals this file reads bare.

;; ---- faces + bars -----------------------------------------------------------

(theme/defchrome face-diff-added {:fg *green*})
(theme/defchrome face-diff-modified {:fg *yellow*})
(theme/defchrome face-diff-deleted {:fg *red*})

(defn bar-face (status)
  "The face for a line's change `status` bar, or nil for an unchanged line."
  (cond
    (= status :added) face-diff-added
    (= status :modified) face-diff-modified
    (= status :deleted) face-diff-deleted
    else nil))

(defn bar-chunk (status)
  "The gutter change-bar CHUNK for a line's change `status`: `[:bar colour]` for a present
add/modify — the renderer lowers it to a solid full-height rule (a GUI `frect`, or `▌` in
the terminal), since a `▌` glyph reads as a dashed bar at the editor's 1.4 line-height — a
thin `▁` underbar glyph at a deletion marker, and a blank otherwise. `colour` is the diff
face's foreground hex."
  (cond
    (nil? status) [" " nil]
    (= status :deleted) ["▁" face-diff-deleted]
    else [:bar (:fg (bar-face status))]))

;; ---- the line diff → per-line status map (std's `diff/line-status`) ----------
;; The diff is the runtime's own (brood ADR-468): a Myers line diff with git's
;; indent-heuristic compaction, so an inserted or deleted line lands at the boundary a
;; reader expects — adding a line inside a run of closing parens or blank lines marks the
;; line you typed, as `git diff` does — with no subprocess. It reads strings or ropes, so
;; the task never flattens the buffer.

(defn- diffhl-status-map (head text)
  "A `{0-based-buffer-line -> :added|:modified|:deleted}` map for `text` (a string or rope)
against `head`. A lone trailing-newline difference is no change, and every line against an
EMPTY base is `:added`. Plain data in, plain map out — safe to run inside a spawned worker."
  (diff/line-status head text))

;; ---- the base text, remembered while the commit it came from stands ------------------
;; The base text only changes when a commit, checkout or reset moves HEAD, so a pause after
;; an edit need not run `git show HEAD:path` again. The base is kept with an IDENTITY of what
;; it was read from, and read again only when that identity changes. For git the identity is
;; read off `.git` with plain file reads, no subprocess: HEAD's content, and the commit the
;; branch it names points at. A VCS with no identity here (mur's last save) answers nil, and
;; nil never matches: its base is read every time.

(defn- diffhl-read-line (file)
  "The trimmed first contents of `file`, or nil when it cannot be read."
  ;; a missing or unreadable file is an answer here (no such ref), not a fault
  (check-allow :discarded-catch
    (try
      (let (s (file/slurp file)) (if (string? s) (string/trim s) nil))
      (catch _ nil))))

(defn- diffhl-git-dir (root)
  "The git directory of the checkout at `root`: `.git` itself, or where a worktree's or
submodule's `.git` FILE points (`gitdir: …`)."
  (let (dot (path/join root ".git"))
    (if (file/dir? dot)
      dot
      (let (line (diffhl-read-line dot))
        (when (and line (string/starts-with? line "gitdir: "))
          (path/absolute (string/substring line 8) root))))))

(defn diffhl-base-identity (path)
  "What the base text of the file at `path` was read from, as plain data that is equal
exactly while that base stands — or nil when it cannot be told without asking the VCS.

For a git checkout: `[path HEAD's-content the-commit]`. A branch HEAD (`ref: refs/heads/x`)
names its ref, whose file holds the commit, in the git directory or (a worktree's) the common
one; a ref only in `packed-refs` is identified by that file's mtime, which a rewrite moves. A
commit, checkout, reset or rebase changes one of those, and nothing else changes what
`HEAD:path` says."
  (let (where (vcs/locate (path/dirname (path/absolute path)))
        git-dir (when (and where (= (:kind where) :git)) (diffhl-git-dir (:root where))))
    (when (string? git-dir)
      (let (head (diffhl-read-line (path/join git-dir "HEAD")))
        (cond
          (nil? head) nil
          (not (string/starts-with? head "ref: ")) [path head]
          else
            (let (ref (string/substring head 5)
                  common-line (diffhl-read-line (path/join git-dir "commondir"))
                  common (if (string? common-line) (path/absolute common-line git-dir) git-dir)
                  commit (or (diffhl-read-line (path/join git-dir ref))
                           (diffhl-read-line (path/join common ref)))
                  packed (path/join common "packed-refs"))
              (cond
                commit [path head commit]
                (file/exists? packed) [path head :packed (file/mtime packed)]
                else nil)))))))

(defn diffhl-base (path cached)
  "The base text of the file at `path` as `{:identity :text}` — `cached` (a previous answer
for this path, or nil) when its identity still holds ([[diffhl-base-identity]]), else read
afresh through `vcs/base-text`. `:text` is nil for a file new to its checkout or in none."
  (let (base-identity (diffhl-base-identity path))
    (if (and base-identity cached (= base-identity (:identity cached)))
      cached
      {:identity base-identity
       ;; a CRLF file is held with bare newlines and no byte-order mark (std's
       ;; `file-text-decode`), so its base is too
       :text (let (text (vcs/base-text path)) (when (string? text) (:text (file-text-decode text))))})))

(defn diffhl-compute (path text cached-base &optional coded)
  "`{:status :base}` for the file at `path` given its current `text` (a
string or rope): the per-line `{0-based-line -> :added|:modified|:deleted}` map (empty when
the file is new or in no checkout) and the base text it was diffed against
([[diffhl-base]], reusing `cached-base` while its identity holds), for the caller to keep for
the next pause.

**Plain data in, plain data out**, so it runs inside a spawned task. The diff itself is
[[diffhl-status-map]] — base text and current text in, marks out — the one place a different
line diff plugs in. `coded` is `[coding eol bom]` for a file not in UTF-8: the base came through
a program's output, so `text` is compared as that shows it (`charset/tool-view`)."
  (let (base (diffhl-base path cached-base)
        head (:text base))
    {:status (if (nil? head)
               {}
               (diffhl-status-map head
                 (if (nil? coded)
                   text
                   (let ([coding eol bom] coded)
                     (charset/tool-view (if (string? text) text (text/->string text))
                       coding eol bom)))))
     :base base}))

(defn diffhl-status (path text)
  "The `{0-based-line -> :added|:modified|:deleted}` diff map for the file at `path`
(vs its base text — git's HEAD, mur's last save) given its current `text` — an empty map
when the file is new or in no checkout. [[diffhl-compute]] with nothing remembered."
  (:status (diffhl-compute path text nil)))

(def *diffhl-bases-max* 32)
;; Files whose base text the model remembers (`:diffhl-bases`) before it starts over — the
;; files you are moving between; each entry is one file's text at HEAD.

(defn- ed-remember-base (m path base)
  "`m` remembering `base` as `path`'s base text (`:diffhl-bases`), bounded by
[[*diffhl-bases-max*]]. A base with no identity is not kept: it could never be reused."
  (if (or (nil? path) (nil? (:identity base)))
    m
    (let (bases (or (:diffhl-bases m) {})
          bases (if (and (>= (count bases) *diffhl-bases-max*) (not (contains? bases path)))
                  {}
                  bases))
      (assoc m :diffhl-bases (assoc bases path base)))))

;; ---- diff-hl annotation, off the loop (mirrors the diagnostics pair) ---------
;; Diffing a buffer against its base text is `std/diff` over the whole file. On a large
;; file that is seconds of work — far too slow for the per-event loop, where no key, not
;; even C-g, is read until it returns. So the diff runs in a spawned task, exactly like the
;; advisory diagnostics check: launch on the idle beat, fold the result back on its reply.

(defn ed-diffhl-stale? (m)
  "True when the current buffer wants a diff-hl recompute: diff-hl is on (`:diff-hl?`,
default true), it's a file buffer, and its **rope differs from the one the cached gutter was
computed for** — its first view (no annotation at all), or any edit since. An O(1)
rope-handle compare (`annotation`'s `:stale?`), so plain motion costs nothing but a text change
re-arms the diff, so the change bars follow edits instead of freezing at their old lines until
a save. No size cap — the recompute runs OFF the loop (`ed-launch-diffhl`)."
  (and (:diff-hl? m true)
    (let (b (ed-current-buf m))
      ;; a file on another machine (`/ssh:…`) has no base text here: no gutter
      (and (buffer-file b)
        (not (sshpath/remote? (buffer-file b)))
        (let (a (editor/buffer/annotation b :vcs-line-status))
          (or (nil? a) (:stale? a)))))))

(defn- diffhl-job (path rope cached-base coded)
  "One recompute, as a task runs it: [[diffhl-compute]] over `rope` itself (the diff
reads a rope, so nothing flattens it), answering the `path` too so the fold knows whose base
text it is remembering."
  (assoc (diffhl-compute path rope cached-base coded) :path path))

(defn ed-launch-diffhl (m)
  "Recompute the current buffer's diff-hl gutter when stale, OFF THE LOOP — mirroring
`ed-launch-diag`. Reading the base text + the line diff is tens of ms on a normal file but scales
with the file size (~45ms on an 848KB / 12k-line doc, seconds on a huge one) — too much for the
per-event loop — so it runs in a spawned task (std/task): record the task handle on
`:diffhl-proc` and the rope it is diffing on `:diffhl-checking`, so a stale reply can't clobber
a newer cache. Fires on the idle beat, gated on an in-flight check. Headless → synchronous.
The task-reply contract is pinned by tests/diffhl_async_test.blsp."
  (let (b (ed-current-buf m)
        path (buffer-file b)
        coded (when (:coding b) [(:coding b) (buffer-eol b) (buffer-bom? b)]))
    (cond
      (not (ed-diffhl-stale? m)) m
      (:diffhl-proc m) m
      ;; `ed-diffhl-stale?` already said it is a file buffer; this says so to the checker
      (nil? path) m
      (ed-headless?)
        (ed-apply-diffhl (assoc m :diffhl-checking (buffer-rope b))
          (diffhl-job path (buffer-rope b) (get (:diffhl-bases m) path) coded))
      else
        (let (rope (buffer-rope b)
              cached (get (:diffhl-bases m) path)
              ;; the task captures the rope and flattens it there: the loop builds no text
              job (task (fn () (diffhl-job path rope cached coded))))
          (assoc m :diffhl-proc job :diffhl-checking rope)))))

(sig ed-apply-diffhl (model any -> model))
(defn ed-apply-diffhl (m result)
  "Fold a finished diff-hl compute's `result` (`{:status :base :path}` from [[diffhl-job]];
nil/() on error/timeout) into the buffer it was diffed for — located by the rope it carried
(`:diffhl-checking`), so a buffer switch mid-flight still stamps the RIGHT buffer — with the
rope + line count, remember the base text it read (`:diffhl-bases`, so the next pause need
not read it again while HEAD stands), and clear the in-flight handle. A buffer edited since
the launch has no matching rope, so its stale result is dropped and `ed-diffhl-stale?`
re-fires next idle tick. Mirrors `ed-apply-diag`."
  (let (rope (:diffhl-checking m)
        m1 (dissoc m :diffhl-proc :diffhl-checking)
        m2 (if (map? result) (ed-remember-base m1 (:path result) (:base result)) m1)
        idx (seq/index-where (:buffers m2) (fn (b) (= (buffer-rope b) rope))))
    (if (< idx 0)
      m2
      ;; stamp the result onto the buffer we diffed (found BY ROPE, so a mid-flight
      ;; buffer switch still lands on the right one) — one annotation, stamped with the
      ;; text it describes (std `annotate`): the bars draw only while positionally
      ;; current, which blanks them the moment a line is inserted rather than drawing
      ;; every bar one line off
      (update m2
        :buffers assoc
        idx
        (editor/buffer/annotate (ed-buf-at m2 idx)
          :vcs-line-status (or (and (map? result) (:status result)) {}))))))

(defn ed-quit-diffhl (m)
  "C-g killed a diff-hl recompute (`:on-quit`): forget the rope it was diffing, and re-stamp
the current buffer's bars against its CURRENT text, so the idle beat treats the gutter as
current and does not relaunch the diff just killed (keeping any existing bars; none if there
were none). It re-arms on the next edit, because that is what makes the annotation stale
again."
  (let (b (ed-current-buf m))
    ;; `:value`, NOT `annotation-value`: the current-only accessor returns nil exactly when
    ;; a line was inserted (which is why a diff was in flight), so it would DISCARD the bars
    ;; this exists to keep.
    (dissoc (ed-set-buf m
              (editor/buffer/annotate b
                :vcs-line-status (or (:value (editor/buffer/annotation b :vcs-line-status)) {})))
      :diffhl-checking)))

;; ---- registration ---------------------------------------------------------------

(register-task-reply :diffhl-proc
  'diffhl/ed-apply-diffhl
  '()
  nil
  {:cancel-on-quit? true :on-quit 'diffhl/ed-quit-diffhl})

(register-idle-job :diffhl
  {:order 80 :run 'diffhl/ed-launch-diffhl :stale? 'diffhl/ed-diffhl-stale?})

;; ---- moving between the changes (diff-hl's C-x v [ / ]) ------------------------------
;; The bars already say where the changes are, whichever VCS made them, so walking them needs
;; no VCS at all: a hunk starts where a marked line follows an unmarked one (or one of another
;; kind — an addition right after a modification is its own change).

(defn diffhl-hunk-starts (status -> (list int))
  "The 0-based lines where a change starts in a `{line -> :added|:modified|:deleted}` status
map, ascending. Pure.

    (diffhl/diffhl-hunk-starts {2 :added 3 :added 7 :modified 9 :deleted})   ;=> (2 7 9)"
  (let (lines (sort (keys (or status {}))))
    (seq/filter lines (fn (l) (not (= (get status (dec l)) (get status l)))))))

(defn- diffhl-jump (m forward?)
  "Point to the next (or previous) change's first line in the current buffer, or say there
is none that way."
  (let (b (ed-current-buf m)
        status (editor/buffer/annotation-value b :vcs-line-status)
        here (buffer-current-line b)
        starts (diffhl-hunk-starts status)
        target (if forward?
                 (seq/find starts (fn (l) (> l here)))
                 (last (seq/filter starts (fn (l) (< l here))))))
    (cond
      (nil? status)
        (message m
          "no change marks here yet (a file the version control does not track, or not yet read)")
      (nil? target) (message m (if forward? "no more changes below" "no more changes above"))
      else (ed-set-buf m (pool/ed-goto-line b (inc target))))))

(defcommand cmd-diffhl-next-hunk
  (m key)
  "Go to the next change in this file (C-x v ]) — the next bar in the gutter, whichever
version control drew it."
  (diffhl-jump m true))

(defcommand cmd-diffhl-previous-hunk
  (m key)
  "Go to the previous change in this file (C-x v [)."
  (diffhl-jump m false))
