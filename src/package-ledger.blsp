(defmodule package-ledger
  "What a loaded package did to the image, kept so it can all be taken back: every global it
defined or redefined (a per-global STACK, two packages patching one function coming off in
either order), every bedit registry row it claimed (`ownership`), every std registry entry
its loads wrote directly, its modules, its ability impls. [[note-loaded]] records a load,
[[retire-package]] undoes one in the one order that leaves nothing pointing at a name about
to go. Nothing here reaches the network, a buffer or the model; `packages` drives it."
  (:use package-store :only [package-dir source-files package-modules package-settings]))

(defn- global-namespace (global)
  ;; everything before the last `/` of a global's name, nil for a root name
  (let (parts (string/split (->string global) "/"))
    (when (> (count parts) 1) (string/join (take parts (dec (count parts))) "/"))))

(defn- exact (global)
  ;; `global` behind the root escape: the global of exactly that name, never the project's
  ;; module of the same short name (a package module `org` beside bedit's `org`)
  (symbol (str "/" global)))

(defn- sited-under? (global prefix)
  ;; whether `global`'s definition was last loaded from a file under `prefix`
  (let (site (reflect/source-location (exact global)))
    (and (vector? site) (string/starts-with? (str (first site)) prefix))))

(defn- global-value (global)
  (check-allow :discarded-catch (try (reflect/eval (exact global)) (catch _ nil))))

(defn- define-global (global value site)
  ;; `global` bound to `value` again, by exactly that name: its module apart from bedit's of
  ;; the same short name (brood ADR-604), so a package's `org/f` is never bedit's `bedit/org/f`;
  ;; and read as defined at `site` again (`[file line col]`, nil for none — brood ADR-606), so
  ;; C-h f and M-. on a restored core function go to bedit's source, not the package's
  (let (namespace (global-namespace global))
    (reflect/with-modules-apart (if namespace [namespace] [])
      (fn () (reflect/eval (list 'def (exact global) (list 'quote value)))))
    (reflect/set-source-location (exact global) site)))

(defn- undefine-global (global)
  ;; `global` removed (`reflect/undef`, brood ADR-391); false when it cannot be
  (check-allow :discarded-catch (try (reflect/undef (exact global)) (catch _ false))))

;; ---- the globals a package's code defined ------------------------------------------
;; A package's load binds names: its own functions, and maybe a name the editor or another
;; package already had — a core function it patches (`(defn bedit/keyhelp/ed-key-label …)`, or
;; `(defn keyhelp/ed-key-label …)`, which roots to the same global inside project bedit),
;; another package's function, a root name a second package's loose file defines too. So each
;; global a package's load bound keeps a STACK, as a registry row does (`ownership`):
;; `:packages/definitions` global -> `{:base {:present? :value :site} :stack [{:package :value
;; :site} …]}` — what the global held before any package, then each package's binding in load order, the
;; live one last. A package updated pushes its new binding on top. Retiring a package splices
;; its layer out: the live one gives the global back to the layer below it, else to the base,
;; else removes it; a lower one leaves the live binding alone. So removing A while B's patch of
;; A's function is live keeps B's, and removing B then removes the function (A's is gone) —
;; never A's old body. Emacs's `unload-feature` restores a function the same way.
;;
;; What a load bound is read from the runtime (`reflect/rebound-since`, brood ADR-603), and what
;; each of those globals held before it from the table as it stood before the load
;; (`reflect/global-values`, `reflect/source-locations`, brood ADR-606) — by the exact global,
;; however the package spelled the name or whichever macro generated it. A global put back
;; reads as defined where its value was again.

(defn values-before ()
  "What a package's load is compared against: `{:generation :values :sites}` — the runtime's
generation, and every global a load can rebind with its value and where it was defined (std's reserved names are not
among them: a `def` of one is refused). The registries a package may write directly are std's
and bedit's, read off the same table where they are rebindable, else by name."
  (let (values (reflect/global-values))
    {:generation (reflect/generation)
     :sites (reflect/source-locations)
     :values (fold (%registry-names)
               values
               (fn (with-registries global)
                 (if (contains? with-registries global)
                   with-registries
                   (assoc with-registries global (global-value global)))))}))

(defn- note-definitions (name before)
  ;; each global the load bound in the package's files gets this package's layer on top (its
  ;; earlier one gone), the stack's base what the global held before
  (let (prefix (str (package-dir name) "/"))
    (doseq (global (reflect/rebound-since (:generation before)))
      ;; `bound?` asks the global table by exactly this name
      (when (and (bound? global) (sited-under? global prefix))
        (let (present? (contains? (:values before) global)
              record (registry/lookup :packages/definitions
                       global
                       {:base {:present? present?
                               :value (get (:values before) global)
                               :site (get (:sites before) global)}
                        :stack []})
              others (into [] (seq/reject (:stack record) (fn (layer) (= (:package layer) name)))))
          (registry/put :packages/definitions
            global
            (assoc record
              :stack
                (conj others
                  {:package name
                   :value (global-value global)
                   :site (reflect/source-location (exact global))}))))))))

(defn plugin-definitions (name)
  "Every global package `name`'s code bound that it still has a layer in — its own functions,
and a name it patched — sorted."
  (vec (sort (seq/keep (registry/entries :packages/definitions)
               (fn ([global record])
                 (when (any? (:stack record) (fn (layer) (= (:package layer) name))) global))))))

(defn- retire-layer (name global record)
  "Package `name`'s layer out of `global`'s stack (`record`), the global put right: true when
its binding changed."
  (let (stack (:stack record)
        kept (into [] (seq/reject stack (fn (layer) (= (:package layer) name))))
        base (:base record)
        live? (= (:package (last stack)) name))
    (if (empty? kept)
      (registry/remove :packages/definitions global)
      (registry/put :packages/definitions global (assoc record :stack kept)))
    (cond
      (not live?) false
      (not (empty? kept)) (do (define-global global (:value (last kept)) (:site (last kept))) true)
      (:present? base) (do (define-global global (:value base) (:site base)) true)
      else (= true (undefine-global global)))))

(defn- retire-definitions (name)
  "Take package `name`'s layer out of every global it bound ([[note-definitions]]): where it
was the live binding the layer below it is bound again — another package's, or what the
global held before any package — or, with none, the global is removed (`reflect/undef`, brood
ADR-391); where it was not live it is left alone. Then any global of one of its own modules
still sited in its files (one its code defined at run time) is removed too. Answers how many
globals changed. What an update does BEFORE loading the new version, so a function the new
version dropped is gone rather than callable with the old body, and what a remove does so the
removed package's code stops running."
  (let (prefix (str (package-dir name) "/")
        modules (package-modules name)
        module-prefixes (map (seq modules) (fn (module) (str module "/")))
        changed (count (seq/filter (registry/entries :packages/definitions)
                         (fn ([global record])
                           (and (any? (:stack record) (fn (layer) (= (:package layer) name)))
                             (retire-layer name global record)))))
        ;; only what was bound since the package loaded (brood ADR-603), not every global
        own (seq/filter (reflect/rebound-since (registry/lookup :packages/loaded-at name 0))
              (fn (global)
                (let (spelled (->string global))
                  (and (any? module-prefixes (fn (module) (string/starts-with? spelled module)))
                    (bound? global)
                    (contains? modules (global-namespace global))
                    (nil? (registry/lookup :packages/definitions global))
                    (sited-under? global prefix)
                    (= true (undefine-global global)))))))
    (+ changed (count own))))

;; ---- registrations the package made ----------------------------------------------

(defn claimant-file (name)
  "What a registration made while package `name` is applied, outside a load of one of its
files, is claimed for (`ownership/*claimant*`): a file under its directory."
  (path/join (package-dir name) "project.blsp"))

(defn release-registrations (name)
  "Take back every registry entry package `name` made through bedit's registries — its idle
jobs, task replies, event, down and timer handlers, exit queries, post-steps, mode line chips,
commands, modes, file types, settings and themes, at load or as its code ran
(`ownership/release-under!`) — and answer the `[kind key]`s released. An entry it replaced
comes back."
  (ownership/release-under! (package-dir name)))

(defn- adopt-settings (name before)
  "Claim for package `name` the settings its sources declare ([[package-settings]]) that its
load wrote — `settings/define` writes std's registry directly — over what the registry held
`before` the load, so they leave init.blsp's settings with the package."
  (doseq (setting (package-settings name))
    (when (not (= (get before setting) (registry/lookup config/*settings* setting)))
      (ownership/adopt! config/*settings*
        setting
        (claimant-file name)
        (contains? before setting)
        (get before setting)))))

;; A package may write std's registries DIRECTLY — `editor/layers/register-type-layers`,
;; `register-system-layer`, a `registry/put` of its own — past bedit's claims. The kernel
;; records who made each registry write a load made (`registry/written-by`, brood ADR-582): a
;; module, or a file without a `defmodule` by its absolute path. So what the package's loads
;; wrote is known ([[package-writers]]), and retiring it takes each write back
;; (`registry/retract`) — or, where the write REPLACED an entry, puts back what was there.
;;
;; Two packages may write the same entry, so each map entry a package wrote keeps a STACK,
;; as a redefined global does: `:packages/std-layers` `[global path]` -> `{:base {:present?
;; :value} :stack [{:package :value :writer} …]}` — the entry from before any package, then
;; each package's write in load order, the live one last. Retiring a package splices its
;; layer out: the live one gives the entry back to the nearest layer below it (crediting that
;; layer's writer) or to the base, a lower one leaves the live write alone — so removing A
;; then B never puts back A's value, written by a package that is gone. Every put-back and
;; take-back is conditional on the entry still being the package's (`registry/restore` and
;; `registry/retract` check the writer under the registry lock), so an entry something else
;; wrote since is left as it is.

(defn- path-present? (table path)
  (let (head (first path)
        more (rest path))
    (and (map? table)
      (contains? table head)
      (or (empty? more) (and (map? (get table head)) (contains? (get table head) (first more)))))))

(defn package-writers (name)
  "Who package `name`'s loads are credited to in the registries' writer journal: its modules
(symbols) and its source files by absolute path (strings — a file without a `defmodule`
credits itself) — those of the version that loaded, kept when it did, and those on disk now."
  (into (registry/lookup :packages/writers name #{})
    (append (map (package-modules name) symbol) (map (source-files name) path/absolute))))

(defn- note-std-writes (name before)
  ;; each map entry the package's loads wrote gets this package's layer on top of its stack
  ;; (its earlier one gone), the stack's base what the entry held in `before`
  (doseq (write (registry/written-by (package-writers name)))
    (when (:path write)
      (let (key [(:global write) (:path write)]
            prior (get before (:global write))
            present? (path-present? prior (:path write))
            record (registry/lookup :packages/std-layers
                     key
                     {:base {:present? present?
                             :value (when present? (map/get-in prior (:path write)))}
                      :stack []})
            others (into [] (seq/reject (:stack record) (fn (layer) (= (:package layer) name)))))
        (registry/put :packages/std-layers
          key
          (assoc record
            :stack (conj others {:package name :value (:value write) :writer (:writer write)})))))))

(defn- unstack-std-writes (name)
  ;; package `name`'s layer out of every entry's stack; where it was the live write, the
  ;; entry goes back to the layer below it, or the base, or goes
  (doseq ([key record] (registry/entries :packages/std-layers))
    (let (stack (:stack record)
          mine (seq/find stack (fn (layer) (= (:package layer) name))))
      (when mine
        (let (kept (into [] (seq/reject stack (fn (layer) (= (:package layer) name))))
              [global path] key
              write {:global global :path path :writer (:writer mine)}
              base (:base record))
          (if (empty? kept)
            (registry/remove :packages/std-layers key)
            (registry/put :packages/std-layers key (assoc record :stack kept)))
          (when (= (:package (last stack)) name)
            (cond
              (not (empty? kept))
                (registry/restore write (:value (last kept)) (:writer (last kept)))
              (:present? base) (registry/restore write (:value base))
              else (registry/retract write))))))))

(defn- retract-std-writes (name)
  "Take back every std registry write package `name`'s loads made that is still its own — a
map entry goes back to what it held before ([[unstack-std-writes]]), a list member and an
entry it wrote after it loaded go — and answer the writes that were live."
  (let (writers (package-writers name)
        writes (registry/written-by writers))
    (unstack-std-writes name)
    ;; the same list, not a second scan of every registry: a retract applies only while the
    ;; entry is still credited to the write's writer, so one the unstacking gave back to
    ;; another layer or to its base is left as it now is
    (doseq (write writes) (registry/retract write))
    (registry/remove :packages/writers name)
    writes))

;; ---- the backstop: rows that still name the package ------------------------------
;; A row registered where neither a load nor a dispatch could attribute it (a hook called
;; straight through `reflect/call-if-bound`) is found by what it NAMES: a hook symbol in one of
;; the package's namespaces, a function defined there — an anonymous `fn` too, by the module it
;; was written in (`reflect/fn-module`, brood ADR-596) — a name its files first defined.
;; Retiring the package drops every such row from bedit's registries and std's. (A row its
;; timer or a process it started registers is the package's already: such a process acts for
;; it, and the kernel credits its writes to the package — `retract-std-writes` takes them.)

(defn- function-name (value)
  ;; the qualified name a named function prints with (`#<fn pkg/f>`), else nil
  (let (printed (pr-str value))
    (when (and (string/starts-with? printed "#<fn ") (string/ends-with? printed ">"))
      (symbol (string/substring printed 5 (dec (count printed)))))))

(defn- names-package? (value namespaces defined)
  "Whether `value` mentions, at any depth, a symbol or a function of the package: in one of
`namespaces` (strings) or among the globals it first `defined` (a set) — a function by its
name, or an anonymous one by the module it was written in."
  (let (ours? (fn (candidate)
                (or (contains? defined candidate)
                  (contains? namespaces (ownership/symbol-namespace candidate)))))
    (letrec (walk (fn (stack)
                    (if (empty? stack)
                      false
                      (let (item (first stack)
                            more (rest stack))
                        (cond
                          (symbol? item) (or (ours? item) (walk more))
                          ;; a named function by its name; an anonymous one by the module
                          ;; it was written in (brood ADR-596), since it prints `#<fn>`
                          (fn? item)
                            (let (named (function-name item)
                                  module (ownership/code-namespace item))
                              (or (and named (ours? named))
                                (contains? namespaces module)
                                (walk more)))
                          (map? item) (walk (append (keys item) (vals item) more))
                          (or (vector? item) (list? item) (set? item))
                            (walk (append (vec item) more))
                          else (walk more))))))
      (walk (list value)))))

(defn- drop-references (name)
  "Drop every registry row — bedit's and `editor/layers`' — that still names package `name`,
and answer the buffer types it took away."
  (let (namespaces (into (package-modules name) (registry/lookup :packages/modules name #{}))
        defined (first-defined name)
        ours? (fn (value) (names-package? value namespaces defined))
        ;; A table is walked entry by entry only when its printed form could name the
        ;; package at all — one of its namespaces, a name it defined, or a function, which
        ;; prints `#<fn>` and is told by its module — so the backstop costs a print of each
        ;; table, not a walk of every entry of every registry
        needles (append (map (seq namespaces) (fn (namespace) (str namespace "/")))
                  (map (seq defined) ->string)
                  ["#<fn"])
        worth-walking? (fn (value)
                         (let (text (pr-str value))
                           (any? needles (fn (needle) (includes? text needle)))))
        bookkeeping #{"ownership" "packages"})
    (doseq ([id table] registry/*registries*)
      (when (and (not (and (keyword? id) (contains? bookkeeping (ownership/symbol-namespace id))))
              (worth-walking? table))
        (doseq ([key entry] table) (when (ours? entry) (ownership/drop-entry! id key)))))
    (doseq (system-layer editor/layers/*system-layers*)
      (when (ours? system-layer) (editor/layers/unregister-system-layer system-layer)))
    (doseq (rule editor/layers/*auto-type-by-file*)
      (when (ours? (:match rule)) (editor/layers/unregister-file-type (:match rule) (:type rule))))
    (into #{}
      (seq/keep editor/layers/*type-layers*
        (fn ([type layers])
          (when (ours? layers) (ownership/drop-entry! :modes/type-layers type) type))))))

;; ---- retiring a package -----------------------------------------------------------

(defn- first-defined (name)
  ;; the globals package `name` brought into the image: nothing held them before a package,
  ;; and its layer is the first
  (into #{}
    (seq/keep (registry/entries :packages/definitions)
      (fn ([global record])
        (when (and (not (:present? (:base record))) (= (:package (first (:stack record))) name))
          global)))))

(defn note-loaded (name before settings-before)
  "Record what package `name`'s load did, against `before` it ([[values-before]]): the globals
it bound ([[note-definitions]]), the std registry entries it wrote with what they held, its
settings, its modules — and its namespaces, so its commands and hooks register for it as they
run (`ownership/own-namespace!`)."
  (let (modules (package-modules name))
    (note-definitions name before)
    ;; the generation it first loaded at: what it binds later is found from there
    (when (nil? (registry/lookup :packages/loaded-at name))
      (registry/put :packages/loaded-at name (:generation before)))
    (registry/put :packages/writers name (package-writers name))
    (registry/put :packages/modules
      name
      (into (registry/lookup :packages/modules name #{}) modules))
    (note-std-writes name (:values before))
    (adopt-settings name settings-before)
    (doseq (module modules) (ownership/own-namespace! module (claimant-file name)))))

(defn- retract-impls (name)
  ;; the ability impls package `name`'s modules registered, taken back — the tier below each
  ;; winning again (brood ADR-603); `reflect/undef` retires only the impls of a type it removes
  (count (seq/filter (registry/impls-by (into #{}
                                          (map (seq (registry/lookup :packages/modules
                                                      name
                                                      (package-modules name)))
                                            symbol)))
           registry/retract-impl)))

(defn retire-package (name)
  "Take package `name` out of the live editor, in the one order that leaves nothing pointing
at a name about to go: its bedit registrations back ([[release-registrations]]), the std
registry entries its loads wrote directly back ([[retract-std-writes]]), any row still
naming it dropped ([[drop-references]]), the ability impls its modules registered taken back
([[retract-impls]]), then every global it bound given back to the layer below or removed
([[retire-definitions]]). The image half of [[remove!]] and [[update-plugin!]], which put
the open buffers right ([[ed-settle-package-buffers]]) with the buffer types it answers.
Answers `{:released :restored :retired :types}` — `:restored` the impls taken back,
`:retired` the globals put right."
  (let (released (release-registrations name)
        std-writes (retract-std-writes name)
        dropped-types (drop-references name)
        restored (retract-impls name)
        retired (retire-definitions name)
        types (into dropped-types
                (append (seq/keep released (fn ([kind key]) (when (= kind :modes/type-layers) key)))
                  (seq/keep std-writes
                    (fn (write)
                      (when (and (= (:global write) 'editor/layers/*type-layers*) (:path write))
                        (first (:path write))))))))
    ;; the namespaces its loaded versions declared, not only the files on disk now: an update
    ;; that renamed a module leaves no entry for the old one
    (doseq (module (into (package-modules name) (registry/lookup :packages/modules name #{})))
      (ownership/disown-namespace! module))
    (registry/remove :packages/modules name)
    (registry/remove :packages/loaded-at name)
    (registry/remove :packages/contributions name)
    {:released (count released) :restored restored :retired retired :types types}))
