(defmodule tutor
  "The interactive Brood tutorial (`C-h t`, `M-x tutorial`) — vimtutor's shape,
alive: a wizard of lessons (`tutor-lessons`, content only) rendered into one
editable *Tutorial* buffer where prose explains and ╭─ boxes are PLAYGROUNDS.
Whatever you type in a box evaluates as you settle (the `:tutor-eval` idle timer,
~250ms) in the persistent OS-process sandbox (`sandbox` → std's `eval-server`,
ADR-198), never in the editor's own image — so a lesson can `def` freely, loop
forever, or throw, and the editor only ever learns the reply. Feedback lands as
margin marks (· result, ✓ exercise passed, ✗ not yet — `modes/gutter-mark-for`),
ghost text at the end of the box's last form, and the echo line for the full
story.

Everything derives from the buffer TEXT through one pure parser (`tutor-regions`):
the fontifier colours prose/borders and delegates box innards to the brood
highlighter; the `:post-key` guard vetoes any keystroke that changed the text
OUTSIDE the boxes (compare against the render's stashed skeleton — the model is
immutable, so a veto is returning the pre-key model); the evaluator re-sends every
complete box top-to-bottom (defs persist in the sandbox session, so order stays
deterministic and a respawn heals itself); notes anchor on each box's last
top-level form via `sexp/top-level-forms`. Exercise expectations (`:expect`) live
in lesson DATA keyed by box order — never in the buffer, so they can't be edited
away. Headless (tests, no `:editor` process) the eval falls back to std's
`eval-capturing` in-image, synchronously — the diag-fallback discipline."
  (:use editor/buffer)
  (:use model)
  (:use commands) ; ed-show-named / ed-apply / ed-edit / ed-switch-to-named
  (:use interactive) ; defcommand — the M-x registry
  (:use editor/keymap)
  (:use editor/layers)
  (:use tutor-lessons) ; the content: the `tutor-lessons` vector
  (:use sandbox)) ; the eval sandbox client + its event records
(require 'tutor-workings) ; the *Workings* pane: its cache, its body text, its open/close
(require 'projects) ; persist-read-value / persist-write! — the editor's own state files
(require 'sexp) ; top-level-forms — note anchoring
(require 'eval-server) ; eval-capturing — the headless/sync fallback
(require 'modes) ; fontify-line-faces (report-buffer line roles) + the brood indenter
(require 'editor/formbuf) ; form buffers: the region algebra + the guard policies
(require 'template) ; {{key}} holes — lesson prose renders per keybinding profile
(require 'config) ; config-dir — where progress is remembered between sessions
(def *tutor-buffer-name* "*Tutorial*")
(def *tutor-eval-timeout-ms* 2000)
(def *tutor-box-width* 66)
(def *tutor-slow-ms* 150) ; past this, a result shows how long it took
(def *tutor-box-margin* "  ") ; breathing room between a box's edge and its code
;; ---- the key vocabulary: ASKED, not hardcoded ---------------------------------
;; Lesson prose/titles/hints are TEMPLATES ({{kf}}, {{kill-line}} … — std/template)
;; rendered against a vocabulary. The KEY entries are derived from the live keymaps
;; (`model/ed-command-keys` over `keymaps/profile-keymap` → std's `keymap-where-is`),
;; so the tutorial teaches what the user's editor actually does — including their own
;; rebindings from `init.blsp`, not just emacs-vs-vim. Each spec carries a fallback
;; for a key a profile expresses as *grammar* rather than a binding: vim routes
;; h/j/k/l/w/b through ONE command (`cmd-vim-motion`), so there is no per-key command
;; to look up and the literal is the honest answer.
;;
;; The PROSE entries below are what genuinely differs in shape between the two
;; models (vim's counts and operators vs Emacs's kill ring), which no amount of
;; key lookup can derive — that difference is editorial, so it stays written out.

(def- tutor-emacs-key-specs
  {:kf ['commands/cmd-forward-char "C-f"]
   :kb ['commands/cmd-backward-char "C-b"]
   :kn ['commands/cmd-next-line "C-n"]
   :kp ['commands/cmd-previous-line "C-p"]
   :kbol ['commands/cmd-beginning-of-line "C-a"]
   :keol ['commands/cmd-end-of-line "C-e"]
   :kwf ['commands/cmd-forward-word "M-f"]
   :kwb ['commands/cmd-backward-word "M-b"]
   :kbs ['commands/cmd-beginning-of-buffer "M-<"]
   :kbe ['commands/cmd-end-of-buffer "M->"]
   :kundo ['commands/cmd-undo "C-/"]
   :ksearch ['commands/cmd-isearch-forward "C-s"]
   :krsearch ['commands/cmd-isearch-backward "C-r"]
   ;; the command prompt is a binding too — M-x here, `:` under vim (which has no
   ;; M-x at all). Deriving it is what keeps "how do I switch back" truthful.
   :kcmd ['commands/cmd-execute-extended-command "M-x"]})

;; vim expresses motion as grammar (one `cmd-vim-motion` for every motion key), so
;; these are literals by nature — the lookup would be ambiguous, not stale.
(def- tutor-vim-key-specs
  {:kf [nil "l"]
   :kb [nil "h"]
   :kn [nil "j"]
   :kp [nil "k"]
   :kbol [nil "0"]
   :keol [nil "$"]
   :kwf [nil "w"]
   :kwb [nil "b"]
   :kbs ['commands/cmd-vim-goto-first-line "gg"]
   :kbe ['commands/cmd-vim-goto-last-line "G"]
   :kundo ['commands/cmd-undo "u"]
   :ksearch ['commands/cmd-isearch-forward "/"]
   :krsearch ['commands/cmd-isearch-backward "?"]
   :kcmd ['commands/cmd-execute-extended-command ":"]})

;; The tutorial's OWN keys (box hops, lesson nav) are looked up in its buffer keymap
;; — one place binds them, and the footer/prose can't drift from it.
(def- tutor-own-key-specs
  {:next-box ['tutor/cmd-tutorial-next-playground "M-n"]
   :prev-box ['tutor/cmd-tutorial-prev-playground "M-p"]
   :reset-box ['tutor/cmd-tutorial-reset-playground "C-c C-r"]
   :next-lesson ['tutor/cmd-tutorial-next "C-c C-n"]
   :prev-lesson ['tutor/cmd-tutorial-prev "C-c C-p"]
   :up ['tutor/cmd-tutorial-up "C-c C-u"]
   :last-page ['tutor/cmd-tutorial-last "C-c C-l"]
   :contents ['tutor/cmd-tutorial-contents "C-c C-t"]
   :answer-key ['tutor/cmd-tutorial-show-answer "C-c C-a"]
   ;; the workings pane follows the cursor on its own; this is how you get it back
   ;; after closing it (and how to open it on a box that has not run yet)
   :workings ['tutor/cmd-tutorial-workings "C-c C-w"]})

(defn- tutor-prose
  (profile)
  ;; the editorially-different half: shapes, not keys
  (if (= profile :vim)
    {:profile-name "vim"
     :insert-hint "Vim note: a box is edited in INSERT mode — i enters it, ESC leaves."
     :move-line "{{kb}} / {{kf}} back and forward a character, {{kn}} / {{kp}} down and up a line"
     :paging-line "and a COUNT multiplies any motion: 10{{kn}} leaps ten lines down,"
     :paging-line2 "5{{kwf}} five words forward. Home row all the way."
     :kill-line "dd deletes the whole line (into the register), p puts it back,"
     :kill-line2 "y is the copy operator (yy copies the line), and {{kundo}} undoes —"
     :practice-kill "Practice — dd this line, p it back, {{kundo}} until it's pristine"
     :kill-hint "dd on that line removes it whole — line and newline together"
     :motion-keys ":h :j :k :l"}
    {:profile-name "emacs"
     :insert-hint ""
     :move-line "{{kf}} / {{kb}} forward and back a character, {{kn}} / {{kp}} next and previous line"
     :paging-line "and C-v / M-v page down and up. C-l recenters the view on the"
     :paging-line2 "cursor. Home row all the way."
     :kill-line "C-k kills to the end of the line (into the kill ring), C-y yanks it"
     :kill-line2 "back, M-w copies a C-SPC-marked region, and {{kundo}} undoes —"
     :practice-kill "Practice — C-k this line, C-y it back, {{kundo}} until it's pristine"
     :kill-hint "{{kn}} to that line, {{kbol}}, then C-k twice — the text, then the newline"
     :motion-keys ":ctrl-f :ctrl-b :ctrl-n :ctrl-p"}))

(defn- tutor-keyset
  (profile)
  "The render vocabulary for `profile`: keys ASKED of the live keymaps (so a
rebinding shows through), the tutorial's own keys asked of its buffer keymap, and
the editorially-different prose. Prose entries may themselves carry `{{key}}`
holes — they're rendered against the derived keys first, so one key name is
written in exactly one place."
  (let (keys (merge (ed-command-keys (keymaps/profile-keymap profile)
                      (if (= profile :vim) tutor-vim-key-specs tutor-emacs-key-specs))
               (ed-command-keys tutor/tutor-keymap tutor-own-key-specs))
        prose (tutor-prose profile))
    ;; resolve keys inside the prose entries, then hand the union to the lessons
    (merge keys
      (fold (fn (acc kv)
              (let ([k v] kv)
                (assoc acc k (if (string? v) (template/render v keys) v))))
        {}
        prose))))

(defn- tutor-render-str
  (s keyset)
  (if (string? s) (template/render s keyset) s))

;; ---- sections & subsections: the course is walked one GROUP at a time ---------
;; A lesson carries `:section` and optionally `:subsection`; `tutor-sections`
;; (content) is the ordered registry. The unit the user actually walks is a GROUP —
;; a subsection when the section has them, the section otherwise — and numbering,
;; "what's next", the hub and progress all derive from that one notion, so a long
;; topic reads as a few short walks without any special-casing.

(defn- tutor-group-of
  (idx)
  "The group a lesson belongs to: `[section-id subsection-id]` (subsection nil when
the section isn't split)."
  (let (l (nth tutor-lessons idx)) [(:section l) (:subsection l)]))

(defn- tutor-group-indices
  (group)
  "The global lesson indices in `group`, in order."
  (let ([sid sub] group)
    (keep (fn (kv)
            (let ([i l] kv)
              (when (and (= (:section l) sid) (= (:subsection l) sub)) i)))
      (enumerate tutor-lessons))))

(defn- tutor-section
  (sid)
  (or (find (fn (s) (= (:id s) sid)) tutor-sections) {:id sid :title (str sid)}))

(defn- tutor-subsection
  (sid sub)
  (when sub
    (find (fn (x) (= (:id x) sub)) (or (:subsections (tutor-section sid)) []))))

(defn- tutor-group-title
  (group)
  "The name of the walk the user is on — the subsection's title when there is one."
  (let ([sid sub] group
        x (tutor-subsection sid sub))
    (if x (:title x) (:title (tutor-section sid)))))

(defn- tutor-group-position
  (idx)
  "`[position count]` of lesson `idx` within its own group (1-based)."
  (let (idxs (tutor-group-indices (tutor-group-of idx)))
    [(inc (index-of idxs idx)) (count idxs)]))

(defn- tutor-group-last?
  (idx)
  (let ([pos n] (tutor-group-position idx)) (= pos n)))

(defn- tutor-groups
  ()
  "Every walkable group, in course order, as hub entries: `{:group :title :blurb
:sub?}` — plus a `:header?` entry for a section that is split (its own line names
the topic; its subsections are the entries beneath it). The ONE source of truth
shared by the hub renderer and the line→group resolver."
  (mapcat (fn (sec)
            (let (subs (or (:subsections sec) []))
              (if (empty? subs)
                (list {:group [(:id sec) nil] :title (:title sec) :blurb (:blurb sec) :sub? false})
                (cons {:header? true :title (:title sec) :blurb (:blurb sec)}
                  (map (fn (x)
                         {:group [(:id sec) (:id x)]
                          :title (:title x)
                          :blurb (:blurb x)
                          :sub? true})
                    subs)))))
    tutor-sections))

(defn- tutor-group-passed
  (m group)
  "`[passed total]` exercises for `group` — `passed` from the session's remembered
solves (`:tutor-passed`), so hub progress survives leaving a lesson."
  (let (idxs (tutor-group-indices group)
        total (fold (fn (acc i)
                      (+ acc (count (filter :expect (or (:playgrounds (nth tutor-lessons i)) [])))))
                0 idxs)
        passed (count (filter (fn (key) (member? (first key) idxs))
                        (or (get-in m [:tutor :passed]) []))))
    [passed total]))

;; ---- the lesson render (pure: lesson index -> buffer text) -------------------

(defn- tutor-heading
  (idx title)
  ;; the product name, then the breadcrumb: a lesson should say what it belongs to, not
  ;; just where it sits ("Brood Tutorial · Navigation — 1/3: Moving around")
  (let ([pos n] (tutor-group-position idx)
        [sid sub] (tutor-group-of idx)
        crumb (if sub
                (str (:title (tutor-section sid)) " › " (tutor-group-title [sid sub]))
                (:title (tutor-section sid)))
        label (str "━━ Brood Tutorial · " crumb " — " pos "/" n ": " title " "))
    (str label (string-repeat "━" (max 2 (- *tutor-box-width* (display-width label)))))))

;; A box's RULE character says what is inside it: a solid `─` for Brood code, a dashed
;; `┄` for plain text. That distinction has to be legible from the buffer text alone,
;; because `:fontify` is a text-only service and the region parser has no lesson data —
;; so it rides on the rule rather than on a field only the model can see. Both still
;; open with `╭` and close with `╰`, so region parsing is untouched.
(def *tutor-rule-code* "─")
(def *tutor-rule-text* "┄")

(defn- tutor-rule (kind) (if (= kind :text) *tutor-rule-text* *tutor-rule-code*))

(defn- tutor-open-line
  (title &optional (kind :code))
  (let (rule (tutor-rule kind)
        head (str "╭" rule " " title " "))
    (str head (string-repeat rule (max 2 (- *tutor-box-width* (display-width head)))))))

(defn- tutor-close-line
  (&optional (kind :code))
  (str "╰" (string-repeat (tutor-rule kind) (dec *tutor-box-width*))))

(def- tutor-footer-template
  ;; `{{contents}}` is not listed: `{{up}}` already lands on the contents page, and the
  ;; line has to stay inside the box width
  "  [ {{next-box}}/{{prev-box}} box · {{next-lesson}}/{{prev-lesson}} lesson · {{up}} up · {{last-page}} back · {{answer-key}} answer ]")

(defn- tutor-margined
  (code)
  "Box code with the left margin on every line — the code is still ordinary,
editable, evaluable Brood (the reader ignores leading whitespace)."
  (join "\n" (map (fn (l) (str tutor/*tutor-box-margin* l)) (string-split code "\n"))))

(defn- tutor-playground-lines
  (pg)
  (let (kind (:kind pg :code))
    (append (list (tutor-open-line (:title pg "Try it") kind))
      (append (string-split (tutor-margined (:code pg)) "\n")
        (list (tutor-close-line kind) "")))))

(defn- tutor-rendered-playgrounds
  (lesson keyset)
  ;; the lesson's playgrounds with every templated string rendered for the profile
  (map
    (fn (pg)
      (-> pg
        (assoc :title (tutor-render-str (:title pg "Try it") keyset))
        (assoc :code (tutor-render-str (:code pg) keyset))
        (assoc :hint (tutor-render-str (:hint pg) keyset))
        (assoc :answer (tutor-render-str (:answer pg) keyset))
        (assoc :kind (:kind pg :code))
        ;; a prose ANSWER may name a key or the profile too ("my keys are emacs"),
        ;; so the expectation renders with everything else — an unrendered `{{…}}`
        ;; here would be an exercise that can never be solved
        (assoc :expect
          (if (get-in pg [:expect :text])
            (assoc (:expect pg)
              :text (tutor-render-str (get-in pg [:expect :text]) keyset))
            (:expect pg)))))
    (or (:playgrounds lesson) [])))

(defn tutor-lesson-text (idx profile)
  "The full *Tutorial* buffer text for lesson `idx` under keybinding `profile` —
prose indented two spaces (so no prose line can imitate a box delimiter at column
0), playground code margined inside its ╭─/╰ box, every `{{key}}` hole rendered
for the profile's real bindings."
  (let (lesson (nth tutor-lessons idx)
        keyset (tutor-keyset profile))
    (join "\n"
      (append (list (tutor-heading idx (:title lesson)) "")
        (append (map (fn (l) (if (= l "") "" (str "  " (tutor-render-str l keyset))))
                  (:body lesson))
          (append (cons ""
                    (mapcat tutor-playground-lines
                      (tutor-rendered-playgrounds lesson keyset)))
            (list (template/render tutor-footer-template keyset) "")))))))

;; ---- the contents page: the hub between sections -------------------------------
;; Rendered into the SAME *Tutorial* buffer — it simply has no ╭─ boxes, so the box
;; parser finds nothing, the guard makes the whole page read-only for free, and the
;; evaluator has nothing to run. Each section line is a link: the `:line-loc`
;; service gives it the pointer cursor + hover underline (the affordance the results
;; buffers use), RET and click enter that section.

(def *tutor-contents-marker* "▸ ") ; marks a clickable entry (indent varies by depth)
(defn- tutor-contents-entry-lines
  (m e)
  ;; one hub entry: a split section's own header (names the topic, enters nothing),
  ;; else a clickable ▸ line with its lesson count and progress, plus its blurb
  (if (:header? e)
    (list (str "  " (:title e)) (str "      " (:blurb e)) "")
    (let ([passed total] (tutor-group-passed m (:group e))
          done (and (> total 0) (= passed total))
          tick (cond done " ✓" (> passed 0) (str " " passed "/" total) else "")
          n (count (tutor-group-indices (:group e)))
          pad (if (:sub? e) "    " "  "))
      (list (str pad
              tutor/*tutor-contents-marker*
              (:title e)
              "  ("
              n
              (if (= n 1) " lesson" " lessons")
              ")"
              tick)
        (str pad "    " (:blurb e))
        ""))))

(defn- tutor-contents-text
  (m banner)
  (let (lines (mapcat (fn (e) (tutor-contents-entry-lines m e)) (tutor-groups)))
    (join "\n"
      (append (list (str "━━ Brood Tutorial — contents "
                      (string-repeat "━" (max 2 (- *tutor-box-width* 28))))
                "")
        (append (if (= banner "") (list) (list (str "  " banner) ""))
          (append (list "  Pick where to go next — RET (or click) on a ▸ entry:" "")
            (append lines
              (list "  [ RET enter · C-c C-t back to contents any time ]" ""))))))))

(defn- tutor-contents-title-at
  (buf line0)
  ;; the GROUP whose ▸ entry line this exactly is, or nil — matched by title against
  ;; the same `tutor-groups` list the renderer used, so the two can't disagree
  (let (text (editor/buffer/buffer-line-at buf line0)
        at (index-of text tutor/*tutor-contents-marker*))
    (when (>= at 0)
      (let (after (substring text
                    (+ at (string-length tutor/*tutor-contents-marker*))
                    (string-length text))
            title (trim (first (string-split after "  (")))
            hit (find (fn (e) (and (:group e) (= (:title e) title))) (tutor-groups)))
        (:group hit)))))

(defn tutor-contents-section-at (buf line0)
  "The GROUP a contents-page line belongs to — `[section subsection]`, or nil. The
`:line-loc` service behind the pointer cursor, hover underline, RET and click. An
entry is two lines tall on screen (▸ title + blurb), so landing anywhere in it
works (`results/line-link-loc` walks up for the same reason); a split section's own
header line names no group — you enter its subsections, not the section."
  (or (tutor-contents-title-at buf line0)
    (when (> line0 0) (tutor-contents-title-at buf (dec line0)))))

(defn- tutor-install-page
  (m text contents? tutor-fields)
  "Install a rendered page into *Tutorial*: show `text`, re-stash EVERY buffer field
the rebuild wipes, and merge `tutor-fields` onto the model's `:tutor` map. Callers
park point themselves — that is the only part that differs between pages.

One place does the re-stash because `ed-show-named` rebuilds the buffer and drops its
custom fields, and all three renderers (a lesson, the hub, a profile re-render) need
the same three back. When each did it inline the profile re-render forgot
`:tutor-contents?`, and the hub started behaving like a lesson: RET fell through to
newline-and-indent, and the guard offered to send you to a box the page does not have."
  (let (m1 (ed-show-named m tutor/*tutor-buffer-name* text :tutor)
        m2 (tutor-bufset m1
             {:tutor-skeleton (tutor-skeleton text)
              :tutor-contents? contents?
              :tutor-profile (:profile m :emacs)}))
    ;; The workings cache is keyed by box index WITHIN THE PAGE, so it cannot outlive the
    ;; page: box 2 of the lesson you just left is not box 2 of this one. Cleared here, in
    ;; the one place every render passes through — the next idle launch would clear it
    ;; too, but a keystroke lands first (M-n straight after C-c C-n), and showing the
    ;; previous lesson's call tree for this box is the exact confusion the pane exists to
    ;; avoid. The pane's visibility goes with it (`tutor-workings/*unshown*`, defined with
    ;; the rest of the pane's state below), so it is free to open once on the new page and a
    ;; pane the reader closed there stays closed.
    (update m2
      :tutor
      merge
      (merge (assoc tutor-workings/*unshown* :workings {}) tutor-fields))))

(defn- tutor-show-contents
  (m &optional (banner ""))
  "Render the contents hub into *Tutorial* (`banner` is an optional one-line note,
e.g. a group-complete message) and park point on the first ▸ entry."
  (let (text (tutor-contents-text m banner)
        m1 (tutor-install-page m text true {:pending {}})
        first-line (find (fn (i) (tutor-contents-section-at (ed-current-buf m1) i))
                     (range (buffer-line-count (ed-current-buf m1)))))
    (ed-apply m1 (fn (b) (if first-line (commands/ed-goto-line b (inc first-line)) b)))))

(defn tutor-contents? (m)
  (:tutor-contents? (ed-current-buf m)))

;; ---- the box syntax: ONE place names the delimiters ---------------------------
;; The region algebra itself is `std/editor/formbuf` (form buffers: generated text
;; with editable regions — a shell's input line, a commit message's help block, a
;; rebase todo). All this module owns is the delimiter choice and the two accessors
;; the guard needs.

(def *tutor-open* "╭") ; a box opens on a line starting with this…
(def *tutor-close* "╰") ; …and closes on the next line starting with this
(defn tutor-regions (text)
  "The playground regions of `text` — `{:start :end :open-line :close-line :kind}` per
box, in order (`formbuf/delimited-regions`, plus the kind read off each opening line's
rule character).

The kind is attached HERE rather than offered as a `(text region)` lookup so that no
consumer can forget to ask and none pays to ask twice: the fontifier, the indenter and
the checker filter all need it, and each was re-splitting the whole buffer per box to
get it. One split per parse, and a region now carries everything about itself."
  (let (lines (string-split text "\n")
        text-rule (str tutor/*tutor-open* tutor/*tutor-rule-text*))
    (map (fn (r)
           (assoc r
             :kind (if (starts-with? (nth lines (:open-line r 0) "") text-rule) :text :code)))
      (editor/formbuf/delimited-regions text tutor/*tutor-open* tutor/*tutor-close*))))

(defn tutor-skeleton (text)
  "Everything of `text` OUTSIDE the boxes — what the render stashes and the guard
compares against (`formbuf/skeleton`)."
  (editor/formbuf/skeleton text (tutor-regions text)))

(defn- tutor-region-at
  (regions pos)
  "The box whose content span contains `pos` (boundaries inclusive), or nil."
  (editor/formbuf/region-at regions pos))

(defn- tutor-box-at-point
  (m)
  "The index of the box the cursor is in, or nil (prose, or another buffer). The tutorial owns
the box parser, so it answers this and hands the index to `tutor-workings` — that is the
boundary that keeps the pane module from needing anything back."
  (let (b (ed-current-buf m))
    (when (tutor-buffer? b)
      (editor/formbuf/region-index (tutor-regions (buffer-text b)) (buffer-point b)))))

(defn- tutor-line-of
  (text pos)
  ;; 0-based line of char offset `pos` (clamped) — newlines before it.
  (dec (count (string-split (substring text 0 (min pos (string-length text))) "\n"))))

;; ---- buffer plumbing ----------------------------------------------------------

(defn tutor-buffer? (b) (= (buffer-name b) tutor/*tutor-buffer-name*))

(defn- tutor-bufset-buf
  (m f)
  "Apply `f` to the *Tutorial* pool buffer (wherever it lives) — the buffer-shaped
sibling of `tutor-bufset`, for the std buffer API (`annotate`)."
  (let (i (ed-buffer-index-by-name m tutor/*tutor-buffer-name*))
    (if (nil? i) m (update m :buffers assoc i (f (nth (:buffers m) i))))))

(defn- tutor-bufset
  (m kvs)
  "Merge fields `kvs` onto the *Tutorial* pool buffer (wherever it lives)."
  (let (i (ed-buffer-index-by-name m tutor/*tutor-buffer-name*))
    (if (nil? i) m (update m :buffers assoc i (merge (nth (:buffers m) i) kvs)))))

;; ---- feedback notes -----------------------------------------------------------
;; One annotation drives all three feedback channels: `:eol-notes` (see
;; `results/eol-notes`) is `{region-idx -> {:line n :kind … :text …}}` — the gutter
;; draws the kind at `:line`, the view ghosts the text past that line's end, and the
;; echo shows it in full when point is there. Keyed by REGION, not by line: every
;; launch rebuilds the map, so an edit that shifts lines can never strand an entry at
;; a wrong line. std's `annotate` stamps the rope + line count it describes, which is
;; what dims a note on an edit and blanks it once lines move.

(defn- tutor-note-anchor
  (text region)
  "The 0-based line to hang `region`'s note on: for a code box the last line of its
last top-level form (via `sexp/top-level-forms` — error-tolerant), for a prose box
simply its last line.

Prose is not parsed to find this. Reading English through the s-expression reader to
decide where a note goes happens to work while the sentences contain no brackets or
quotes, and stops being predictable the moment the reader types one — and readers type
whatever they like into a prose box. There are no forms in there to anchor to anyway."
  (let (last-in-region (max (:start region) (dec (:end region))))
    (if (= (:kind region) :text)
      (tutor-line-of text last-in-region)
      (let (src (substring text (:start region) (:end region))
            forms (sexp/top-level-forms src)
            pos (if (empty? forms)
                  last-in-region
                  (min last-in-region
                    (+ (:start region) (max 0 (dec (get (last forms) :end)))))))
        (tutor-line-of text pos)))))

(defn- tutor-slow-note
  (reply)
  ;; how long it took, once that's worth knowing — a box you can feel waiting
  (let (ms (get reply :ms 0))
    (if (>= ms *tutor-slow-ms*) (str "  (" ms "ms)") "")))

(defn- tutor-proc-note
  (reply)
  ;; concurrency has no return value to look at: say what the evaluation LEFT
  ;; RUNNING (`:procs` from the eval server). Silent when nothing survived, so it
  ;; only speaks up on the lessons where processes are the point.
  (let (alive (get-in reply [:procs :alive] 0))
    (cond
      (= alive 0) ""
      (= alive 1) "  ⚙ 1 process still running"
      else (str "  ⚙ " alive " processes still running"))))

(defn- tutor-normalize-answer
  (s)
  ;; Compare what the reader SEES. The box margin, a stray double space left behind by
  ;; a deleted word, trailing whitespace — none of those are part of a prose answer, so
  ;; each line collapses to its words. Line breaks stay significant: removing a line is
  ;; a real edit and an exercise may ask for it.
  (trim (join "\n"
          (map (fn (line) (join " " (filter (fn (w) (not= w "")) (string-split line " "))))
            (string-split (or s "") "\n")))))

(defn- tutor-hint-suffix
  (pg)
  ;; a miss earns the lesson's hint, in one voice for both kinds of box
  (if (:hint pg) (str "   — hint: " (:hint pg)) ""))

(defn- tutor-text-verdict
  (pg src)
  "The note for a TEXT box, or nil for a practice box with nothing to check.

A prose box has no value to evaluate, so its exercise is checked against the text
itself (`:expect {:text …}`) — which makes the check pure and instant: no sandbox
round trip, the ✓ lands on the same keystroke."
  (let (want (get-in pg [:expect :text])
        hint (tutor-hint-suffix pg))
    (cond
      (nil? want) nil
      (= (tutor-normalize-answer src) (tutor-normalize-answer want))
        {:kind :pass :text "✓ that's it"}
      else {:kind :fail :text (str "✗ not yet" hint)})))

(defn- tutor-verdict
  (pg reply)
  "The note for playground data `pg` answered by `reply` (a decoded eval-server
reply map): plain result `·`, exercise `✓`/`✗` (with the hint on a miss), error /
timeout `✗`. A slow evaluation carries its duration and one that left processes
running says so — the two things a value alone can't tell you."
  (let (expect (get-in pg [:expect :value])
        hint (tutor-hint-suffix pg)
        extra (str (tutor-slow-note reply) (tutor-proc-note reply)))
    (cond
      ;; `:error?` marks "the code ran and blew up" as opposed to "it ran fine but gave
      ;; the wrong answer" — the checker's advisory is redundant on the former (it would
      ;; repeat the error) and useful on the latter (it may explain the wrong answer).
      (get reply :timeout)
        {:kind :fail
         :error? true
         :text "✗ timed out — still running? (C-c C-k restarts the sandbox)"}
      (not (get reply :ok)) {:kind :fail :error? true :text (str "✗ " (get reply :error "error"))}
      (nil? expect)
        {:kind :info
         :text (str "=> "
                 (get reply :value)
                 (if (= (get reply :output "") "")
                   ""
                   (str "   (printed: " (trim (get reply :output)) ")"))
                 extra)}
      (= expect (get reply :value)) {:kind :pass :text (str "✓ " (get reply :value) extra)}
      else {:kind :fail :text (str "✗ expected " expect ", got " (get reply :value) hint extra)})))

(defn- tutor-set-note
  (m region-idx note)
  "Store `note` (`:kind`/`:text`) for playground `region-idx` on the *Tutorial*
buffer, anchored (`:line`, always recomputed from the current text) on the box's
last form; stamps the rope/count it belongs to."
  (let (i (ed-buffer-index-by-name m tutor/*tutor-buffer-name*))
    (if (nil? i)
      m
      (let (b (nth (:buffers m) i)
            text (buffer-text b)
            regions (tutor-regions text)
            r (nth regions region-idx nil))
        (if (nil? r)
          m
          ;; ONE generic annotation (std `annotate` stamps the rope + line count it
          ;; describes): `:eol-notes` is owner-keyed with `:line` inside, and the
          ;; gutter / ghost text / echo all read it through `results/eol-notes`
          (tutor-bufset-buf m
            (fn (bb)
              (editor/buffer/annotate bb
                :eol-notes
                (assoc (or (results/eol-notes-any bb) {})
                  region-idx (assoc note :line (tutor-note-anchor text r)))))))))))

;; ---- eval-on-type: the stale? / launch / apply triple ---------------------------

(defn ed-tutor-stale? (m)
  "O(1): the selected buffer is the tutorial and its rope moved since the last
launch — arms the `:tutor-eval` idle timer (`model/ed-sync-timers`)."
  (let (b (ed-current-buf m))
    (and (tutor-buffer? b)
      (not= (buffer-rope b) (:tutor-eval-rope b)))))

(defn- tutor-parse-state
  (src)
  ;; :blank | [:incomplete reason] (mid-typing) | [:err msg] | :ok
  ;;
  ;; E0002 is the reader saying "this could still become valid" — an unclosed list, an
  ;; unterminated string. That is the state EVERY box passes through on the way to being
  ;; typed, so it must not read as a mistake; but it must not read as NOTHING either —
  ;; silence there is what made a stale `=>` look current. The reason travels with the
  ;; state ("unterminated string") and is shown in the pending voice, so the line always
  ;; says something true about the text as it stands. E0001 ("unexpected ')'") is a real
  ;; error — no further typing fixes it — and reports as one.
  (cond
    (= (trim src) "") :blank
    else
      (try
        (do (read-all src) :ok)
        (catch e
          (if (and (map? e) (= (:code e) "E0002"))
            [:incomplete (error-message e)]
            [:err (error-message e)])))))

(defn- tutor-live? () (not (nil? (whereis :editor))))

(defn- tutor-playgrounds
  (m)
  "The current lesson's playgrounds, template-rendered for the active profile —
titles, code templates and hints all speak the user's keys."
  (tutor-rendered-playgrounds (nth tutor-lessons (get-in m [:tutor :lesson] 0))
    (tutor-keyset (:profile m :emacs))))

;; ---- which names a box traces ---------------------------------------------------
;; The pane shows the workings of the box you are IN, so every box has to be traced,
;; not just the ones a lesson thought to name. The list is derived from the box's own
;; source: what it DEFINES (`(defn double …)`) and what it CALLS (`(double 21)` — the
;; interesting case, where the function came from a box further up). A lesson's own
;; `:trace` still rides along, for a name the source never mentions.
;;
;; Over-naming is free and deliberate: the sandbox installs each trace inside a `try`
;; and skips whatever it cannot wrap (`eval-server-try-traces`) — a builtin, a macro,
;; a reserved prelude name (ADR-166), a name that isn't defined yet. So the rule is
;; "offer everything plausible and let the tracer choose", not "predict what is
;; traceable" — the editor would only ever be guessing at the sandbox's global table.

(defn- tutor-call-heads
  (form)
  "Every symbol used as a call head anywhere in `form`, outermost first.

Structurally, not semantically: a `let`'s binding list and a QUOTED form contribute their
heads too (`'(secret-fn 1)` offers `secret-fn`), because this walks shape and does not
evaluate. Harmless by design — the tracer skips a name it cannot wrap, and a name that IS
a live function is one the box mentions, so tracing it tells the reader something true.
Not worth a resolver here: only the sandbox knows its own global table."
  (if (not (pair? form))
    '()
    (let (head (first form)
          inner (fold (fn (acc f) (append acc (tutor-call-heads f))) '() (rest form)))
      (if (symbol? head) (cons head inner) inner))))

(defn- tutor-defined-names
  (form)
  "The name a top-level definition binds — `(defn f …)` / `(def f …)` → `f`, else nil.
A box's own function is the one thing it is guaranteed to be worth tracing."
  (when (and (pair? form)
          (member? (first form) ['def 'defn 'defmacro 'defdyn])
          (symbol? (second form)))
    (second form)))

(defn- tutor-trace-names
  (pg src)
  "The fn-name strings to boundary-trace for one box: what `src` defines, what it
calls, and the lesson's explicit `:trace` — deduped, special forms dropped (they are
syntax, never functions). `src` that doesn't parse contributes nothing; the box is
mid-typing and has no verdict yet either."
  (let (forms (try (read-all src) (catch _ '()))
        defined (filter (fn (s) (not (nil? s))) (map tutor-defined-names forms))
        called (fold (fn (acc f) (append acc (tutor-call-heads f))) '() forms)
        specials (special-forms)
        names (filter (fn (s) (not (member? s specials)))
                (map name (append defined called))))
    (into [] (distinct (append (into [] (or (:trace pg) [])) names)))))

(defn- tutor-progress-file
  ()
  "Where solved exercises are remembered between sessions:
`~/.config/bedit/tutor-progress.blsp` (XDG-aware, via `config/config-dir`).

Beside `init.blsp` rather than in a cache: this is the reader's own record of what
they worked through, small, and worth surviving a reinstall. It is DATA — a printed
map — never eval'd, exactly as `init.blsp` is read rather than executed."
  (path-join (config/config-dir) "tutor-progress.blsp"))

(defn- tutor-persist?
  (m)
  "Whether this model may touch the reader's progress file on disk: the `:recent-files`
flag, which only `main` sets — the same gate recentf, bookmarks and the project cache use.

NOT `tutor-live?` (a `:editor` process exists). That is a PROCESS-global fact, and a
full `nest test` run is one image: the first suite that registers `:editor` for its own
reasons (sandbox, gitdiff, web-logging tests all do) leaves it registered, and from then
on every tutor test that evaluates a passing answer wrote into
`~/.config/bedit/tutor-progress.blsp` — silently rewriting the developer's real
record with whatever the suite had just solved. A MODEL flag cannot leak that way: a test
model comes from `ed-init` and simply doesn't have it."
  (:recent-files m))

(defn- tutor-load-progress
  (m &optional (file (tutor-progress-file)))
  "The saved `:passed` set, or an empty one. Any failure — no file, unreadable,
corrupt — is an empty set: progress is a nicety and must never stop the tutorial
opening.

Reads nothing unless `m` is the live editor's model (`tutor-persist?`): a test must
never inherit a developer's real progress, and the first version of this did exactly
that. `file` is a parameter for the same reason `config`'s read/ensure take one — so a
test drives the real code against a temp path instead of asserting things about the
developer's home directory (an assertion that is false the moment they use the tutorial)."
  (if (not (tutor-persist? m))
    #{}
    ;; `projects/persist-read-value` is the editor's one reader for its own state files:
    ;; never throws, `default` on anything unreadable, and the counterpart of the ATOMIC
    ;; write below. Rolling its own `slurp` + `read-all` here was the same code minus the
    ;; care.
    (let (data (projects/persist-read-value file {}))
      (if (map? data) (into #{} (or (:passed data) [])) #{}))))

(defn- tutor-save-progress
  (m &optional (file (tutor-progress-file)))
  "Write the session's solved set out, best-effort. Returns `m` untouched — saving is a
side effect of making progress, never something that can fail the command that caused
it, so a read-only home directory costs you persistence and nothing else.

Writes only for the live editor's model (`tutor-persist?`) — see there for why the
gate is a model flag and not the `:editor` process. `file` is a parameter so a test can
drive the real write against a temp path (the `config` idiom)."
  (do
    (when (tutor-persist? m)
      ;; ATOMIC, via the shared layer (`projects/persist-write!`): a plain `spit` can leave a
      ;; truncated file if the editor dies mid-write, and the next read would take that as
      ;; "nothing solved" and then overwrite it. Progress is small and cheap to write; losing
      ;; it to a crash is not cheap for the reader who earned it.
      (projects/persist-write! file
        {:passed (into [] (or (get-in m [:tutor :passed]) #{}))}
        "bedit — tutorial progress. Data, not code: safe to delete."))
    m))

(defn- tutor-remember-pass
  (m region-idx pg note)
  ;; A solved exercise is remembered on the MODEL as `[lesson-idx region-idx]`, so
  ;; the contents page can show real progress after you leave the lesson (the notes
  ;; live on the buffer and are rebuilt every eval). Passes only ever accumulate.
  (if (and (:expect pg) (= (:kind note) :pass))
    (tutor-save-progress (update m
                           :tutor
                           update
                           :passed
                           (fn (st) (conj (or st #{}) [(get-in m [:tutor :lesson] 0) region-idx]))))
    m))

(defn- tutor-apply-verdict
  (m region-idx pg reply)
  ;; a completed evaluation lands three places: the box's note, the session's
  ;; passed-set (contents progress), and — when traced — the workings pane
  (let (note (tutor-verdict pg reply))
    (let (m1 (tutor-remember-pass (tutor-set-note m region-idx note) region-idx pg note))
      (tutor-workings/show m1 region-idx (tutor-box-at-point m1) reply))))

(defn- tutor-region-srcs
  (text regions)
  "`{region-idx -> source}` for `regions` — what each box currently holds."
  (fold (fn (acc ir)
          (let ([i r] ir) (assoc acc i (substring text (:start r) (:end r)))))
    {}
    (enumerate regions)))

(defn- tutor-first-changed
  (srcs old-srcs n)
  "The index of the FIRST box whose source differs from what was last evaluated (a
box never evaluated counts as changed), or nil when nothing changed. The boxes
share one session and defs flow DOWNWARD, so this is where re-evaluation has to
start: everything above it is unaffected by the edit, everything below it may
depend on what just changed."
  (find (fn (i) (not= (get srcs i) (get old-srcs i))) (range n)))

(defn- tutor-box-spans
  (text regions)
  "Per box: `{:src :from-line :buffer-line :lines}` — its source, where it starts in the
combined session source, where it starts in the BUFFER, and how many lines it has. The
map a warning uses to travel from the combined source back to the page."
  (let (r (fold (fn (acc region)
                  (let ([from spans] acc
                        src (substring text (:start region) (:end region))
                        n (count (string-split src "\n")))
                    [(+ from n)
                      (cons {:src src
                             :from-line from
                             :buffer-line (tutor-line-of text (:start region))
                             :lines n}
                        spans)]))
            [1 '()]
            regions)
        [_ spans] r)
    (reverse spans)))

(defn- tutor-warning-line
  (spans wline)
  ;; the buffer line a combined-source warning line belongs to, or nil
  (let (hit (find (fn (sp)
                    (and (>= wline (:from-line sp))
                      (< wline (+ (:from-line sp) (:lines sp)))))
              spans))
    (when hit (+ (:buffer-line hit) (- wline (:from-line hit))))))

(defn- tutor-session-warnings
  (text regions)
  "The advisory type-checker's warnings for the lesson, as notes anchored on the line
each warning is ABOUT — `{[:warn line] {:line :kind :text}}`.

Checked over the boxes JOINED IN ORDER, because that is the session the sandbox builds:
box 2's `(double 21)` is correct precisely because box 1 defined `double`, and checking
each box alone reported `unbound symbol: double` on working code. A warning that cries
wolf is worse than no warning at all, so the checker gets the same context the evaluator
has, and the result is mapped back to the box it came from.

This is what a runtime error cannot tell you: `(defn f (x) (* 2 x \"d\"))` stays silent
until something calls `f`, while the checker knows at the definition. Pure and in-image
(`check-string-structured`, the service brood-mode already uses) — no sandbox round-trip."
  (let (spans (tutor-box-spans text regions)
        combined (join "\n" (map :src spans))
        warns (or (try (check-string-structured combined) (catch _ nil)) ()))
    (fold
      (fn (acc w)
        ;; A diagnostic with no :line cannot be placed, and `(or … 1)` placed it on
        ;; line 1 anyway — which is the FIRST box, so `fac: recursive call in
        ;; non-tail position` was painted on a `countdown` four lines above where
        ;; `fac` is defined. A warning pointing at innocent code is worse than a
        ;; warning you never saw. (`check-string-structured` returns nil :line for
        ;; some diagnostics, and returns this one three times over — both are
        ;; Brood-side bugs; this only stops the editor from lying about them.)
        (let (line (when (:line w) (tutor-warning-line spans (:line w))))
          (if (nil? line)
            acc
            (assoc acc
              [:warn line] {:line line :kind :warn :text (str "⚠ " (:message w))}))))
      {}
      warns)))

(defn- tutor-message-of
  (text)
  "The MESSAGE inside a note's text, with the leading verdict glyph and any `=> ` value
prefix stripped, so two notes that say the same thing in different voices compare equal.
`\"✗ unbound symbol: asfd\"` and `\"⚠ unbound symbol: asfd\"` both reduce to
`\"unbound symbol: asfd\"`."
  (trim (fold (fn (s glyph) (replace s glyph "")) (or text "") ["⚠" "✗" "✓" "•" "⋯" "=>"])))

(defn- tutor-warning-echoes?
  (note w)
  "True when `w` (a checker warning) would only repeat what `note` (the runtime's verdict)
already says on that line — either message containing the other, once both are reduced to
their `tutor-message-of` text. Containment rather than equality because the two sides
word the same fault at different lengths: the runtime says `unbound symbol: asfd`, the
checker `unbound symbol: asfd (did you mean …)`. An empty message never echoes."
  (let (a (tutor-message-of (:text note))
        b (tutor-message-of (:text w)))
    (and (not (empty? a))
      (not (empty? b))
      (or (includes? a b) (includes? b a)))))

(defn- tutor-merge-warning
  (notes w)
  "Place one warning, or decide it has nothing to add.

**The runtime outranks the checker.** The runtime is ground truth — it says what this
code actually did — while the checker only predicts. So an advisory earns its space
only when it tells you something the result doesn't, and it is dropped in two cases:

  - the line reports a runtime **error** (`:error?`) — the code got as far as failing,
    so whatever the checker predicted about it is now history. `✗ unbound symbol: asfd`
    beside `⚠ unbound symbol: asfd` is noise, and noise beside an error is the worst
    place for it.
  - the note **already says it** (`tutor-warning-echoes?`) — same complaint, different
    glyph, regardless of whether the note was an error.

The case worth keeping is the inverse: a line that *succeeded* but whose checker
warning is about code that hasn't run yet — `(defn dbl (x) (* 2 x \"d\"))` evaluates
fine and reports `=> dbl`, and the ⚠ is the only thing telling you the call below will
blow up. Prediction is exactly what the checker is for when there is no runtime answer.

A surviving warning goes in as a FIELD (`:warn`) on the line's note, composed by the
renderers at paint time — a field rather than appended text because re-running the
checker must overwrite, not accumulate (appending added another identical ⚠ every
debounce beat). A line with no note at all gets a standalone warning."
  (let (hit (find (fn (kv) (= (:line (second kv)) (:line w))) notes))
    (cond
      (nil? hit) (assoc notes [:warn (:line w)] w)
      (:error? (second hit)) notes ; the runtime already failed here
      (tutor-warning-echoes? (second hit) w) notes ; …or already said this exact thing
      else (let ([k note] hit) (assoc notes k (assoc note :warn (:text w)))))))

(defn- tutor-with-warnings
  (m)
  "Add the checker's warnings for every box to the buffer's notes — beside a result on
the same line, on their own line otherwise."
  (let (i (ed-buffer-index-by-name m tutor/*tutor-buffer-name*))
    (if (nil? i)
      m
      (let (b (nth (:buffers m) i)
            text (buffer-text b)
            ;; drop last round's warnings — both the standalone ones and the `:warn`
            ;; fields attached to results — since they are recomputed from the current text
            notes (fold (fn (acc kv)
                          (let ([k v] kv)
                            (if (and (vector? k) (= (first k) :warn))
                              acc
                              (assoc acc k (dissoc v :warn)))))
                    {}
                    (or (results/eol-notes-any b) {}))
            warns (tutor-session-warnings text
                    (filter (fn (r) (= (:kind r) :code)) (tutor-regions text)))
            merged (fold (fn (acc kv) (tutor-merge-warning acc (second kv))) notes warns))
        (tutor-bufset-buf m
          (fn (bb) (editor/buffer/annotate bb :eol-notes merged)))))))

(defn ed-tutor-launch (m)
  "Debounce landed: re-evaluate the current lesson's playgrounds FROM THE EDITED BOX
DOWNWARD, in order.

Why that range and not one box or all of them: the boxes share one sandbox session
and definitions flow downward (lesson 7's box 1 defines `double`, box 2 calls it).
Evaluating only the box you touched would leave a *dependent* box below it showing a
result computed from the old definition — a stale ✓ that looks current. Evaluating
every box instead re-ran work that provably can't have changed: lesson 12's try-box
is `(countdown 1000000)`, so typing in the exercise beneath it re-ran a million tail
calls every beat, and the process lessons spawn a process per box per round. Boxes
ABOVE the edit cannot depend on text below them, so they keep their notes
(re-anchored, since lines may have shifted).

Incomplete boxes (reader E0002: mid-form) say nothing and carry their previous note;
a real syntax error fails locally without a round-trip. A box with lesson `:trace`
names ships them with the request; the reply's `:spy` feeds the workings pane. The
notes map is REBUILT each launch, so an entry can never survive at a shifted line.
Stashes `:tutor-eval-rope` (timer disarms until the text moves) and `:tutor-srcs`
(what each box was evaluated with — the change detector above).

The one thing this gives up: a box that depends on a LATER box (writing `(f 1)`
above `f`'s definition) no longer re-resolves on its own — touch it and it will.
Reading order is dependency order here, which is what a tutorial should teach."
  (let (b (ed-current-buf m))
    (if (not (tutor-buffer? b))
      m
      (let (text (buffer-text b)
            rope (buffer-rope b)
            regions (tutor-regions text)
            pgs (tutor-playgrounds m)
            live (tutor-live?)
            old-notes (or (results/eol-notes-any b) {})
            old-srcs (or (:tutor-srcs b) {})
            srcs (tutor-region-srcs text regions)
            from (tutor-first-changed srcs old-srcs (count regions))
            start-id (get-in m [:tutor :next-id] 1)
            ;; Drop the cached workings of every box being re-sent BEFORE anything is
            ;; evaluated: their old cascades describe code that no longer exists, and a
            ;; headless (synchronous) launch applies its verdicts inside the fold below —
            ;; forgetting afterwards would erase the very entries it just produced.
            m0 (tutor-workings/forget (tutor-bufset-buf (tutor-bufset m {:tutor-eval-rope rope})
                                        (fn (bb) (editor/buffer/annotate bb :eol-notes {})))
                 from)
            ;; nothing in any box changed (an edit the guard reverted, whitespace the
            ;; parser ignores): re-anchor every note and send nothing
            result (if (nil? from)
                     [(fold (fn (mm kv)
                              (let ([i note] kv) (tutor-set-note mm i (dissoc note :line))))
                        m0 old-notes)
                       start-id
                       {}]
                     (fold
                       (fn (acc ir)
                         (let ([m1 next-id pending] acc
                               [i r] ir
                               src (get srcs i)
                               pg (nth pgs i {})
                               old (get old-notes i)
                               state (cond
                                       (< i from) :carry
                                       ;; prose: never parsed, never sent to the sandbox
                                       (= (:kind pg) :text) :text
                                       else (tutor-parse-state src)))
                           (match state
                             ;; a prose box answers locally and instantly, or says nothing
                             (:text
                               (let (note (tutor-text-verdict pg src))
                                 (if (nil? note)
                                   acc
                                   ;; a solved prose exercise counts on the contents
                                   ;; page exactly like an evaluated one — same
                                   ;; bookkeeping, just no round trip to get there
                                   [(tutor-remember-pass (tutor-set-note m1 i note) i pg note)
                                     next-id pending])))
                             ;; above the edit: unaffected, so keep the verdict as it is
                             (:carry (if old
                                       [(tutor-set-note m1 i (dissoc old :line)) next-id pending]
                                       acc))
                             (:blank (if old
                                       [(tutor-set-note m1 i (dissoc old :line)) next-id pending]
                                       acc))
                             ;; Mid-form. Two things must NOT happen here: re-stamping the
                             ;; previous verdict (which left a confident `=> "hi"` beside
                             ;; a `(str "hi` that can no longer produce it — the same
                             ;; "stale verdict looking current" the `:ok` branch refuses
                             ;; to show), and showing nothing at all (indistinguishable
                             ;; from "no feedback yet"). Say what the reader is waiting
                             ;; for, in the pending voice — dim, never a verdict colour,
                             ;; because a form you are still typing is not a mistake.
                             ([:incomplete reason] [(tutor-set-note m1
                                                      i
                                                      {:kind :incomplete :text (str "⋯ " reason)})
                                                     next-id pending])
                             ([:err msg] [(tutor-set-note m1 i {:kind :fail :text (str "✗ " msg)})
                                           next-id pending])
                             (:ok
                               (if live
                                 (do
                                   (sandbox-eval next-id
                                     src
                                     tutor/*tutor-eval-timeout-ms*
                                     (tutor-trace-names pg src))
                                   ;; show it as in flight straight away: with a
                                   ;; `receive` in the box a reply can be hundreds of
                                   ;; ms away, and a stale verdict sitting there
                                   ;; looking current is the wrong thing to show
                                   [(tutor-set-note m1 i {:kind :running :text "⋯ evaluating…"})
                                     (inc next-id)
                                     (assoc pending next-id {:region i :rope rope})])
                                 ;; HEADLESS (tests, batch): the eval runs IN THIS IMAGE, and
                                 ;; it installs NO traces — not the derived list, not even
                                 ;; the lesson's own `:trace`. Instrumentation rebinds
                                 ;; globals, and here the globals are the running editor's,
                                 ;; shared by every test process in the run: a `trace-fn`
                                 ;; here shows up as `[reload] arity changed` churn, and two
                                 ;; tests evaluating the same lesson concurrently are the
                                 ;; "concurrent writers" case wholesale global rebinding is
                                 ;; documented not to survive (ADR-017). Tracing belongs to
                                 ;; the sandbox, a throwaway image built for it. So the
                                 ;; headless path yields verdicts (values, ✓/✗) but no
                                 ;; cascade — the pane's own behaviour is tested from
                                 ;; synthetic replies, and end to end by the pty drive.
                                 [(tutor-apply-verdict m1
                                    i
                                    pg
                                    (eval-server/eval-capturing src nil))
                                   next-id pending])))))
                       ;; Seed with the in-flight entries of the boxes we are NOT
                       ;; re-sending (those above the edit): their replies are still
                       ;; coming, and dropping them from `:pending` would strand the
                       ;; `⋯ evaluating…` note the carry branch re-stamps.
                       [m0
                         start-id
                         (into {}
                           (filter (fn (kv)
                                     (< (:region (second kv)) from))
                             (or (get-in m [:tutor :pending]) {})))]
                       (enumerate regions)))
            [m2 next-id pending] result
            ;; remember what each box was evaluated with — only the boxes we actually
            ;; sent (or resolved locally); a carried box keeps its previous stamp
            m3 (tutor-bufset m2
                 {:tutor-srcs (if (nil? from)
                                old-srcs
                                (fold (fn (acc i) (assoc acc i (get srcs i)))
                                  old-srcs
                                  (range from (count regions))))}))
        ;; Re-render the pane for the box at point (the stale cascades of the re-sent
        ;; boxes are already gone — see `m0`), so it says `⋯ has not run yet` until the
        ;; reply lands rather than showing the version you just edited away.
        ;;
        ;; A lesson where ANY box has workings gets the pane opened, even when the box
        ;; you happen to be in has none: on a lesson built around watching code run, the
        ;; pane has to be there to be noticed. It still shows the box at point — the
        ;; reader moves and it follows — rather than whichever box traced last.
        ;;
        ;; Only ONCE per page, though: `:workings-region` unset means the pane has not
        ;; been shown on this page yet (`tutor-install-page` clears it), so a pane the
        ;; reader closed is not dragged back by the next thing they type. C-c C-w is the
        ;; way back after that, which is the point of having the command.
        (let (m4 (tutor-with-warnings (update m3 :tutor merge {:next-id next-id :pending pending})))
          (tutor-workings/refresh m4
            (tutor-box-at-point m4)
            (and (nil? (get-in m4 [:tutor :workings-region])) (tutor-workings/on-page? m4))))))))

(defn tutor-apply-reply (m reply)
  "Fold one sandbox reply into the model: unknown id or a rope that moved since
the send → dropped (the next idle beat re-evaluates); else the verdict lands as
the box's note (and its trace, if any, as the workings pane)."
  (let (id (get reply :id)
        pend (get-in m [:tutor :pending id]))
    (if (nil? pend)
      m
      (let (m1 (update m :tutor update :pending dissoc id)
            i (ed-buffer-index-by-name m1 tutor/*tutor-buffer-name*)
            b (when i (nth (:buffers m1) i)))
        (if (or (nil? b) (not= (buffer-rope b) (:rope pend)))
          m1
          (tutor-with-warnings (tutor-apply-verdict m1
                                 (:region pend)
                                 (nth (tutor-playgrounds m1) (:region pend) {})
                                 reply)))))))

;; ---- the sandbox events fold in here (the records live consumer-blind in sandbox) --

(defn tutor-sandbox-ready (m gen)
  "The child announced itself (first boot or a reset): remember its generation, drop
stale pending, and clear BOTH eval stashes so the next idle beat re-evaluates the
whole lesson against the fresh session. `:tutor-srcs` matters as much as
`:tutor-eval-rope` — it is what `tutor-first-changed` compares against, so leaving
it behind made a restart re-send *nothing*: the session was empty but every box
looked evaluated, and the next keystroke hit `unbound symbol` for a def that was
never replayed."
  (update (tutor-bufset m {:tutor-eval-rope nil :tutor-srcs {}})
    :tutor
    merge
    {:sandbox-gen gen :sandbox-ready true :pending {}}))

(impl UiEvent
  sandbox/sandbox-ready-event
  (ui-event-fold [e m textrows cols rows]
    (tutor-sandbox-ready m (sandbox-ready-event-gen e))))

(impl UiEvent
  sandbox/sandbox-reply-event
  ;; replies stamped by a superseded child (pre-reset stragglers) are dropped;
  ;; the worker answers its own inflight ids `{:timeout true}` BEFORE bumping gen,
  ;; so those arrive with the current gen and land as ✗ timed out.
  (ui-event-fold [e m textrows cols rows]
    (if (= (sandbox-reply-event-gen e) (get-in m [:tutor :sandbox-gen]))
      (tutor-apply-reply m (sandbox-reply-event-reply e))
      m)))

(impl UiEvent
  sandbox/sandbox-down-event
  ;; the child (or the whole worker) went away. Policy by code:
  ;;   tutorial buffer gone  → the user is done — stop the loop for good (belt for
  ;;                           the :on-close hook; a respawn must not outlive the UI)
  ;;   :gave-up / :spawn-failed → the worker already stopped itself — say so once,
  ;;                           and how to retry
  ;;   anything else         → an ordinary restart (killed externally, crashed late)
  (ui-event-fold [e m textrows cols rows]
    (let (code (sandbox-down-event-code e)
          m1 (update m :tutor merge {:sandbox-ready false}))
      (cond
        (nil? (ed-buffer-index-by-name m1 tutor/*tutor-buffer-name*)) (do (sandbox-shutdown) m1)
        (= code :gave-up)
          (message m1 "tutorial sandbox keeps dying — C-c C-k retries, *Messages* may say why")
        (= code :spawn-failed)
          (message m1 "could not start the tutorial sandbox (is `nest` on PATH?) — C-c C-k retries")
        else (message m1 "tutorial sandbox restarting…")))))

;; ---- the :post-key prose guard -------------------------------------------------

(defn tutor-post-key (m-before m key)
  "The tutor layer's `:post-key` guard (layers §7) — `formbuf/guard-veto` over the
box regions: an event that damaged the PROSE (the text outside the boxes no longer
matches the skeleton the render stashed) is undone by returning the pre-event model,
which is what immutability makes free. Lesson navigation re-renders AND re-stashes,
so it passes; damage that arrived some other way never bricks later keystrokes
(guard-veto's was-intact-before rule). A profile switch is handled first: the page
re-renders for the new keys instead of being compared against the old skeleton."
  (let (b (ed-current-buf m))
    (cond
      (not (tutor-buffer? b)) m
      (not= (:tutor-profile b) (:profile m :emacs)) (tutor-rerender-for-profile m)
      else
        (tutor-follow-workings (editor/formbuf/guard-veto m-before
                                 m
                                 (fn (mm) (buffer-text (ed-current-buf mm)))
                                 (fn (mm) (:tutor-skeleton (ed-current-buf mm)))
                                 (fn (mm)
                                   (message mm
                                     "read-only prose — edit inside a ╭─ box (M-n jumps to one)"))
                                 tutor/tutor-regions)))))

(defn- tutor-follow-workings
  (m)
  "The `:post-key` half of the pane: answer which box the cursor is in and let
`tutor-workings/follow` decide what the pane should do about it. One region lookup on the
hot path; the pane only touches the buffer when the box actually changed."
  (tutor-workings/follow m (tutor-box-at-point m)))

;; ---- rendering a lesson into the pool -------------------------------------------

(defn- tutor-page-of
  (m)
  "The page currently on screen, as a value: `[:contents]` or `[:lesson n]`. What the
back stack remembers."
  (if (tutor-contents? m) [:contents] [:lesson (get-in m [:tutor :lesson] 0)]))

(def *tutor-history-limit* 50)

(defn- tutor-push-history
  (m)
  "Remember the page we are LEAVING, so `cmd-tutorial-back` can return to it.

Called from the navigation commands rather than from `tutor-show`, deliberately: the
tutorial re-renders itself on every profile switch and on every group-complete banner,
and pushing there would fill the stack with pages you never went to."
  ;; most-recent-FIRST: `conj` prepends on a list, so push/peek/pop are conj/first/rest
  ;; and the cap drops the oldest pages by construction
  (let (page (tutor-page-of m)
        stack (get-in m [:tutor :history] '()))
    (assoc-in m
      [:tutor :history]
      (take *tutor-history-limit* (conj stack page)))))

(defn- tutor-goto-page
  (m page)
  (match page
    ([:contents] (tutor-show-contents m ""))
    ([:lesson n] (tutor-show m n))
    (_ m)))

(defn- tutor-show
  (m idx)
  "Render lesson `idx` into *Tutorial* (creating or replacing it), re-stash the
buffer fields the upsert wiped (the git-status discipline), park point in the
first box, and remember the lesson on the model. The fresh buffer has no
`:tutor-eval-rope`, so the idle beat evaluates the templates straight away —
every box shows its result before you've touched it."
  (let (n (count tutor-lessons)
        i (max 0 (min (dec n) idx))
        text (tutor-lesson-text i (:profile m :emacs))
        m1 (tutor-install-page m text false {:lesson i :pending {}})
        first-region (first (tutor-regions text)))
    (ed-apply m1
      (fn (b)
        (goto-char b
          (if first-region
            (min (+ (:start first-region)
                   (string-length tutor/*tutor-box-margin*))
              (:end first-region))
            0))))))

(defn- tutor-splice-boxes
  (new-text old-text)
  "`new-text` with `old-text`'s box CONTENTS carried over by index — a re-render that
keeps the user's code (`formbuf/splice`)."
  (editor/formbuf/splice new-text old-text tutor/tutor-regions))

(defn- tutor-rerender-for-profile
  (m)
  "The keybinding profile changed while the tutorial is open: re-render the current
lesson's prose for the new keys IN PLACE, keeping the user's box contents (spliced
back in) and the cursor's box. Notes clear; the next idle beat re-evaluates."
  (let (b (ed-current-buf m)
        old-text (buffer-text b)
        old-regions (tutor-regions old-text)
        p (buffer-point b)
        cur (tutor-region-at old-regions p)
        cur-idx (when cur (index-of old-regions cur))
        off (if cur (- p (:start cur)) 0)
        i (get-in m [:tutor :lesson] 0)
        profile (:profile m :emacs)
        ;; on the hub there are no boxes to keep — just re-render it for the new keys
        contents? (tutor-contents? m)
        text (if contents?
               (tutor-contents-text m "")
               (tutor-splice-boxes (tutor-lesson-text i profile) old-text))
        m1 (tutor-install-page m text contents? {:pending {}})
        regions (tutor-regions text)
        target (if cur-idx (nth regions cur-idx nil) (first regions)))
    (ed-apply m1
      (fn (bb)
        (goto-char bb
          (if target
            (min (+ (:start target) off) (:end target))
            0))))))

;; ---- commands -------------------------------------------------------------------

(defcommand cmd-tutorial
  (m key)
  "Open the interactive Brood tutorial (`C-h t`): resume where it stands if the buffer
is already in the pool, else start at the first lesson. The keybinding choice is the
tutorial's FIRST LESSON rather than a prompt in front of it — a modal question before
anything is on screen asks you to decide with no context, and the lesson can *show*
both profiles and let you switch in place (every page re-renders for the keys you
pick). The eval sandbox starts spawning here, so its boot hides behind reading."
  (do
    (when (tutor-live?) (sandbox-start))
    (if (ed-buffer-index-by-name m tutor/*tutor-buffer-name*)
      (ed-switch-to-named m tutor/*tutor-buffer-name*)
      ;; Read the saved solves back in on the way in, so the contents page shows what
      ;; you did last time. Merged with whatever this session already holds rather
      ;; than replacing it: reopening the tutorial mid-session must not forget the
      ;; exercise you solved five minutes ago.
      (let (saved (tutor-load-progress m)
            ;; assoc-in, not update: on the very first open there is no `:tutor` map
            ;; yet, and `update` on a missing key hands `assoc` a nil
            m1 (assoc-in m
                 [:tutor :passed]
                 (into (or (get-in m [:tutor :passed]) #{}) saved)))
        (tutor-show m1 (get-in m1 [:tutor :lesson] 0))))))

(defn- tutor-group-done-note
  (m idx)
  ;; the reward for finishing a group, said in passing rather than by stopping you
  (let (group (tutor-group-of idx)
        [passed total] (tutor-group-passed m group))
    (str "✓ "
      (tutor-group-title group)
      " complete"
      (if (> total 0) (str " — " passed "/" total " exercises solved") "")
      " · C-c C-u for the contents")))

(defcommand cmd-tutorial-next
  (m key)
  "The next lesson (C-c C-n) — Emacs Info's `n`: it follows the whole course in order
and keeps going across a section boundary into the next section's first lesson.

It used to stop at a section's last lesson and put you on the contents hub to choose
what was next. That reads as a wall: the common case is simply to carry on, and being
asked to pick every few lessons interrupts the one thing a tutorial is for. Finishing a
group is still marked — the completion and your score go to the echo line — and the
hierarchy is still there whenever you want it, one C-c C-u away.

At the very last lesson there is nowhere to go, and it says so."
  (let (cur (get-in m [:tutor :lesson] 0))
    (cond
      (tutor-contents? m) (message m "you're on the contents page — RET enters a section")
      (>= (inc cur) (count tutor-lessons))
        (message m "that's the end of the course — C-c C-u for the contents")
      else
        (let (crossing (tutor-group-last? cur)
              m1 (tutor-show (tutor-push-history m) (inc cur)))
          (if crossing (message m1 (tutor-group-done-note m cur)) m1)))))

(defcommand cmd-tutorial-prev
  (m key)
  "The previous lesson (C-c C-p) — Emacs Info's `p`, the mirror of C-c C-n: it steps
back through the course in order, across section boundaries, and stops at the first
lesson. From the contents hub it returns to the lesson you were last reading.

This is the SEQUENTIAL neighbour, not where you came from — that is C-c C-l (Info's
`l`), which retraces your actual path including jumps made from the hub."
  (let (cur (get-in m [:tutor :lesson] 0))
    (cond
      (tutor-contents? m) (tutor-show (tutor-push-history m) cur)
      (= cur 0) (message m "that's the first lesson — C-c C-u for the contents")
      else (tutor-show (tutor-push-history m) (dec cur)))))

(defcommand cmd-tutorial-last
  (m key)
  "Back to the page you were last on (C-c C-l) — Emacs Info's `l`. Retraces your actual
path, so a jump made from the contents hub comes back to the hub, which sequential
C-c C-p would never do. Empty history falls back to the previous lesson."
  (let (stack (get-in m [:tutor :history] '()))
    (if (empty? stack)
      (cmd-tutorial-prev m key)
      (tutor-goto-page (assoc-in m [:tutor :history] (rest stack)) (first stack)))))

(defcommand cmd-tutorial-up
  (m key)
  "Up one level (C-c C-u) — Emacs Info's `u`: from a lesson to the contents, with point
already on the entry for the group you were in, so the hierarchy is one key away and
you land looking at where you were rather than at the top of a list.

The contents page is the top; there is nowhere above it."
  (if (tutor-contents? m)
    (message m "the contents page is the top level")
    (let (group (tutor-group-of (get-in m [:tutor :lesson] 0))
          hub (tutor-show-contents (tutor-push-history m) "")
          buf (ed-current-buf hub)
          line (find (fn (i) (= (tutor-contents-section-at buf i) group))
                 (range (buffer-line-count buf))))
      (if (nil? line) hub (ed-apply hub (fn (b) (commands/ed-goto-line b (inc line))))))))

(defcommand cmd-tutorial-contents
  (m key)
  "Show the contents hub (C-c C-t) — the section index, with what you've solved so
far. Available from any lesson; C-c C-u gets here too, landing on the entry for the
group you were in."
  (tutor-show-contents (tutor-push-history m) ""))

(defcommand cmd-tutorial-enter-section
  (m key)
  "Enter the section named on the contents line at point (RET or click): its first
lesson. A line that names no section is left alone."
  (let (b (ed-current-buf m)
        group (tutor-contents-section-at b (buffer-current-line b))
        idxs (when group (tutor-group-indices group))
        m (if group (tutor-push-history m) m))
    (cond
      (and (nil? group) (tutor-contents? m)) (message m "put the cursor on a ▸ entry and press RET")
      (or (nil? group) (empty? idxs)) m
      else (tutor-show m (first idxs)))))

(defcommand cmd-tutorial-newline
  (m key)
  "RET in the tutorial: on the contents page it enters the section at point; inside
a lesson it's an ordinary auto-indenting newline (a motion under a modal profile's
command state — `commands/ed-vim-command-mode?`)."
  (if (tutor-contents? m)
    (cmd-tutorial-enter-section m key)
    (cmd-newline-and-indent m key)))

(defn- tutor-hop
  (m regions target)
  "Jump to box `target`, remembering the cursor offset in the box being left and
restoring the offset last used in the one being entered — each box keeps its own
point across hops (`:tutor-box-points`, region-idx → offset-in-box; narrowing's
per-view point, without the narrowing). Offsets clamp to the box's current size,
so an edited/reset box can't strand the cursor outside itself."
  (let (b (ed-current-buf m)
        p (buffer-point b)
        cur (tutor-region-at regions p)
        mem (or (:tutor-box-points b) {})
        mem2 (if cur (assoc mem (index-of regions cur) (- p (:start cur))) mem)
        off (min (get mem2
                   (index-of regions target)
                   (string-length tutor/*tutor-box-margin*))
              ; first visit: land past the margin
              (- (:end target) (:start target)))
        m1 (tutor-bufset m {:tutor-box-points mem2}))
    (ed-apply m1 (fn (bb) (goto-char bb (+ (:start target) off))))))

(defcommand cmd-tutorial-next-playground
  (m key)
  "Jump to the next playground box (M-n), wrapping — each box remembers where
your cursor was in it."
  (let (b (ed-current-buf m)
        regions (tutor-regions (buffer-text b))
        p (buffer-point b)
        nxt (or (find (fn (r) (> (:start r) p)) regions) (first regions)))
    (if (nil? nxt)
      m
      (tutor-hop m regions nxt))))

(defcommand cmd-tutorial-prev-playground
  (m key)
  "Jump to the previous playground box (M-p / S-TAB), wrapping — each box
remembers where your cursor was in it."
  (let (b (ed-current-buf m)
        regions (tutor-regions (buffer-text b))
        p (buffer-point b)
        prev (or (last (filter (fn (r) (< (:end r) p)) regions)) (last regions)))
    (if (nil? prev)
      m
      (tutor-hop m regions prev))))

(defn- tutor-sexp-in-box
  (m f)
  ;; Structural motion, BOUNDED to the box at point: `sexp/point-*` parses the text it
  ;; is given, and a tutorial buffer is mostly prose — parsing the whole thing walks a
  ;; garbage CST and lands anywhere (often outside the box). So run it on the box's own
  ;; text and shift the answer back, exactly as bshell scopes its Brood services to the
  ;; input line. Outside a box there is no code to move over, so point stays put.
  (let (b (ed-current-buf m)
        text (buffer-text b)
        r (tutor-region-at (tutor-regions text) (buffer-point b)))
    (if (nil? r)
      m
      (let (src (substring text (:start r) (:end r))
            rel (- (buffer-point b) (:start r))
            moved (f src rel)
            target (min (:end r) (max (:start r) (+ (:start r) moved))))
        (ed-apply m (fn (bb) (goto-char bb target)))))))

(defcommand cmd-tutorial-forward-sexp
  (m key)
  "C-M-f in the tutorial: forward over one form, WITHIN the box (the surrounding prose
isn't code). Extends the selection like any motion when a mark is set."
  (tutor-sexp-in-box m sexp/point-forward))

(defcommand cmd-tutorial-backward-sexp
  (m key)
  "C-M-b in the tutorial: backward over one form, within the box."
  (tutor-sexp-in-box m sexp/point-backward))

(defcommand cmd-tutorial-tab
  (m key)
  "TAB in the tutorial: inside a CODE box it indents (and completes a symbol) exactly
like every other Brood buffer — deterministic, because navigation lives on M-n / M-p /
S-TAB. Inside a PROSE box it only indents. Outside any box there is nothing to indent,
so it points you at the keys that move. Under a modal profile's command state it hops
boxes instead — nothing types in vim normal mode (`commands/ed-vim-command-mode?`).

Why prose must not complete: `cmd-indent-or-complete` finishes the symbol at point when
the line is already indented, and in an English box EVERY word is a symbol to that code.
Pressing TAB after `No` in \"Nothing in this box\" opened a completion popup, and a second
TAB accepted a candidate — so TAB silently typed the letters that finish some other word
in the buffer. There is no vocabulary to complete against in prose, and the reader is
mid-exercise: the edit lands in the very text their answer is checked against."
  (let (b (ed-current-buf m)
        region (tutor-region-at (tutor-regions (buffer-text b)) (buffer-point b)))
    (cond
      (ed-vim-command-mode? m) (cmd-tutorial-next-playground m key)
      (nil? region) (message m "TAB indents box code — M-n / M-p hop between boxes")
      (= (:kind region) :text)
        (ed-edit m
          (fn (bb)
            (ed-reindent-line bb
              (tutor-indent (buffer-text bb) (buffer-point (beginning-of-line bb))))))
      else (cmd-indent-or-complete m key))))

(defcommand cmd-tutorial-workings
  (m key)
  "Bring back the *Workings* pane for the box at point (C-c C-w).

The pane is an ordinary buffer in an ordinary pane, so `C-x 0` closes it like any
other — and then nothing else reopens it, because a closed pane is a choice the
following keystroke must not undo. This is the way back. It is also how to open it
the first time on a box you have not typed in yet: the pane says what it is waiting
for instead of appearing only once a reply has landed."
  (if (not (tutor-buffer? (ed-current-buf m)))
    (message m "the workings pane belongs to the tutorial (C-h t opens it)")
    ;; Clearing the latch is the whole job of this command: asking for the pane back is
    ;; the one thing that outranks having closed it. `:workings-region` goes too, or the
    ;; "was shown on this page and is gone now" inference in `tutor-workings/refresh`
    ;; would re-latch on the spot and the command could never win.
    (message (let (m1 (update m :tutor merge tutor-workings/*unshown*))
               (tutor-workings/refresh m1 (tutor-box-at-point m1) true))
      (let (i (tutor-box-at-point m))
        (if (nil? i)
          "the workings follow the box your cursor is in — M-n jumps to one"
          (str "the workings of box " (inc i)))))))

(defcommand cmd-tutorial-show-answer
  (m key)
  "Write the idiomatic solution into the box at point (C-c C-a), for the exercises
where knowing the answer is not the same as knowing how it is usually written.

It REPLACES the box rather than printing the answer somewhere, so the idle beat
evaluates it and you watch it produce the result — the same feedback loop as your own
attempt. C-c C-r puts the template back if you would rather keep trying.

Only exercises that ship an `:answer` have one: it is for the lessons where the
obvious solution and the idiomatic one differ (rebuilding a record versus `update`),
not a way to skip the course."
  (let (b (ed-current-buf m)
        text (buffer-text b)
        regions (tutor-regions text)
        r (tutor-region-at regions (buffer-point b))
        i (when r (index-of regions r))
        pg (when i (nth (tutor-playgrounds m) i nil)))
    (cond
      (nil? pg) (message m "point is not in a playground box")
      (nil? (:answer pg)) (message m "no worked answer for this box — C-c C-r resets it")
      else
        (message (ed-edit m
                   (fn (bb)
                     (insert (delete-region (assoc (goto-char bb (:start r)) :mark (:end r)))
                       (tutor-margined (:answer pg)))))
          "the idiomatic answer — C-c C-r puts your box back"))))

(defcommand cmd-tutorial-reset-playground
  (m key)
  "Restore the playground box at point to the lesson's template (C-c C-r)."
  (let (b (ed-current-buf m)
        text (buffer-text b)
        regions (tutor-regions text)
        r (tutor-region-at regions (buffer-point b))
        i (when r (index-of regions r))
        pg (when i (nth (tutor-playgrounds m) i nil)))
    (if (nil? pg)
      (message m "point is not in a playground box")
      (ed-edit m
        (fn (bb)
          (insert (delete-region (assoc (goto-char bb (:start r)) :mark (:end r)))
            (tutor-margined (:code pg))))))))

(defcommand cmd-tutorial-restart-sandbox
  (m key)
  "Respawn the eval sandbox (C-c C-k): a fresh image — session defs are gone, and
the whole lesson re-evaluates against it once it announces ready. Also the retry
path when the worker itself gave up or failed to spawn: a dead worker is started
anew, not reset (reset on a dead worker was a silent no-op)."
  (do
    (when (tutor-live?)
      (if (sandbox-running?) (sandbox-reset) (sandbox-start)))
    (message m "restarting the tutorial sandbox…")))

(defn tutor-on-close (buf)
  "The tutor layer's `:on-close` hook (fired by `commands/cmd-kill-buffer` via
`close-context`): the tutorial buffer is going away — shut the sandbox worker and its child
runtime down with it, and ask for the *Workings* pane to go too. Reopening the tutorial
spawns a fresh pair.

The pane is a view of the tutorial's boxes and says nothing without them, so leaving it
behind was leaving a corpse on screen. `request-close` NAMES it rather than closing it: a
hook is handed only its own buffer, and it is the app that knows the buffer pool."
  (do
    (sandbox-shutdown)
    (editor/layers/request-close buf tutor-workings/*buffer-name*)))

;; ---- indent: the brood indenter, floored at the box margin ------------------------

(defn tutor-indent (text bol)
  "The tutor `:indent` service: brood-mode's sexp indenter, floored at the box
margin inside a code box — TAB/RET keep code off the box's left edge instead of
flattening the margin away.

A PROSE box has no sexp structure to follow, so it indents to the margin flat.
Running the Lisp indenter over English invents columns from whatever brackets and
quotes the sentence happens to contain — a line ending in a question mark or an
apostrophe would drift."
  (let (region (tutor-region-at (tutor-regions text) bol)
        margin (string-length tutor/*tutor-box-margin*))
    (cond
      (nil? region) (modes/brood-indent text bol)
      (= (:kind region) :text) margin
      else (max margin (modes/brood-indent text bol)))))

;; ---- fontify ---------------------------------------------------------------------

(defn- tutor-line-face
  (line)
  ;; whole-line roles OUTSIDE the boxes; box content is brood-highlighted below.
  (cond
    (starts-with? line "━") {:fg *mauve* :bold true}
    (starts-with? line "╭") {:fg *overlay0*}
    (starts-with? line "╰") {:fg *overlay0*}
    (starts-with? (trim line) "[ C-c") {:fg *subtext*}
    else nil))

(defn tutor-fontify (src)
  "The tutor `:fontify` service: heading/border/footer lines by role
(`modes/fontify-line-faces`), and each playground's content delegated to the
brood highlighter with its spans shifted into place. Pure over the text — the
band cache applies unchanged."
  (append (modes/fontify-line-faces src tutor/tutor-line-face)
    ;; only CODE boxes go through the Brood highlighter — running it over prose paints
    ;; stray keyword/string faces on ordinary words (`:` and `"` occur in English too)
    (mapcat (fn (r)
              (if (= (:kind r) :text)
                '()
                (let (spans (editor/highlight/highlight-spans (substring src (:start r) (:end r))))
                  (map (fn (s) (let ([a b f] s) [(+ a (:start r)) (+ b (:start r)) f])) spans))))
      (tutor-regions src))))

;; ---- the modeline chip (the first user of the layer :modeline seam) ---------------

(defn tutor-modeline (m buf)
  "The tutor layer's `:modeline` service (`model/ed-layer-modeline-segments`):
`Navigation 2/3 · ✓ 1/2 · sandbox ●` — the section and position within it, the
exercises passed of those with an expectation, and the sandbox state (● ready ·
○ starting; absent headless). On the contents hub it names the hub instead."
  (let (inflight (count (or (get-in m [:tutor :pending]) {}))
        running (if (> inflight 0) (str " · ⋯ " inflight " evaluating") "")
        sandbox (if (tutor-live?)
                  (str " · sandbox " (if (get-in m [:tutor :sandbox-ready]) "●" "○"))
                  ""))
    (if (:tutor-contents? buf)
      (str "Tutorial contents" running sandbox)
      ;; NB the raw lesson data, NOT `tutor-playgrounds`: this runs on EVERY frame
      ;; (it's a `:modeline` service), and the templated version derives the whole key
      ;; vocabulary from the keymaps — ~4ms per frame, 13x a plain buffer's render.
      ;; The count of expectations is profile-independent, so the raw data is right
      ;; as well as cheap.
      (let (lesson (get-in m [:tutor :lesson] 0)
            [pos n] (tutor-group-position lesson)
            pgs (or (:playgrounds (nth tutor-lessons lesson)) [])
            expected (count (filter :expect pgs))
            passed (count (filter (fn (kv) (= (:kind (second kv)) :pass))
                            (or (results/eol-notes buf) {}))))
        (str (tutor-group-title (tutor-group-of lesson))
          " "
          pos
          "/"
          n
          (if (> expected 0) (str " · ✓ " (min passed expected) "/" expected) "")
          running
          sandbox)))))

;; ---- the mode layer ---------------------------------------------------------------

(def tutor-keymap
  (-> {}
    (keymap-bind [:ctrl-c :ctrl-n] 'tutor/cmd-tutorial-next)
    (keymap-bind [:ctrl-c :ctrl-p] 'tutor/cmd-tutorial-prev)
    (keymap-bind [:ctrl-c :ctrl-u] 'tutor/cmd-tutorial-up) ; Info's `u` — up a level
    (keymap-bind [:ctrl-c :ctrl-l] 'tutor/cmd-tutorial-last) ; Info's `l` — where you were
    (keymap-bind [:ctrl-c :ctrl-a] 'tutor/cmd-tutorial-show-answer) ; the worked answer
    (keymap-bind [:ctrl-c :ctrl-r] 'tutor/cmd-tutorial-reset-playground)
    (keymap-bind [:ctrl-c :ctrl-k] 'tutor/cmd-tutorial-restart-sandbox)
    (keymap-bind [:tab] 'tutor/cmd-tutorial-tab) ; indent in a box, like every .blsp buffer
    (keymap-bind [:alt-n] 'tutor/cmd-tutorial-next-playground) ; M-n — next box
    (keymap-bind [:alt-p] 'tutor/cmd-tutorial-prev-playground) ; M-p — previous box
    (keymap-bind [:back-tab] 'tutor/cmd-tutorial-prev-playground) ; S-TAB — previous box too
    (keymap-bind [:ctrl-c :ctrl-t] 'tutor/cmd-tutorial-contents) ; the section hub
    (keymap-bind [:ctrl-c :ctrl-w] 'tutor/cmd-tutorial-workings) ; the workings pane, back
    ;; structural motion scoped to the box (the prose around it isn't Brood)
    (keymap-bind [:ctrl-meta-f] 'tutor/cmd-tutorial-forward-sexp)
    (keymap-bind [:ctrl-meta-b] 'tutor/cmd-tutorial-backward-sexp)
    ;; RET: enter a section on the contents page, else an auto-indenting newline
    (keymap-bind [:enter] 'tutor/cmd-tutorial-newline)))

(defn tutor-eval-scope (buf)
  "The tutor `:eval-scope` service: the CODE BOX point is in, as `[start end]`, or nil
anywhere else.

Without it `C-x C-e` read the buffer from position 0, hit the page's prose, and
answered \"no complete form before point\" while point sat at the end of a working
form — the same whole-buffer-parse mistake the sexp motions avoid by scoping to the
box. A prose box returns nil too: there is nothing in it to evaluate, so the ordinary
message is the honest answer."
  (let (r (tutor-region-at (tutor-regions (buffer-text buf)) (buffer-point buf)))
    (when (and r (= (:kind r) :code)) [(:start r) (:end r)])))

(def tutor-mode-layer
  {:name 'tutor
   :keymap tutor/tutor-keymap
   :fontify 'tutor/tutor-fontify
   :indent 'tutor/tutor-indent ; the brood indenter, floored at the box margin
   :post-key 'tutor/tutor-post-key ; the prose guard (layers §7)
   :eval-scope 'tutor/tutor-eval-scope ; C-x C-e reads the BOX, not the whole page
   :modeline 'tutor/tutor-modeline ; Navigation 2/3 · ✓ 1/2 · sandbox ●
   ;; the contents page's section lines are links (pointer cursor + hover underline
   ;; + click), the same affordance the results buffers get
   :line-loc 'tutor/tutor-contents-section-at
   :on-click 'tutor/cmd-tutorial-enter-section
   ;; kill the buffer → kill the sandbox, and take the *Workings* pane with it
   :hooks {:on-close '(tutor/tutor-on-close)}
   :commands '("tutorial-next" "tutorial-prev"
                "tutorial-up" "tutorial-last" "tutorial-show-answer" "tutorial-contents"
                "tutorial-next-playground" "tutorial-prev-playground" "tutorial-reset-playground"
                "tutorial-restart-sandbox" "tutorial-forward-sexp" "tutorial-backward-sexp")})

;; prog-mode in the stack: the C-M-f/C-M-b structural motions the search lesson
;; teaches work inside the boxes (the tutor's :parser is Brood's, like any .blsp)
(register-type-layers :tutor
  (list 'tutor/tutor-mode-layer 'modes/prog-mode-layer 'modes/text-mode-layer))

;; ---- the workings buffer's own (read-only) mode ------------------------------------

(defn- tutor-workings-line-face
  (line)
  (cond
    (starts-with? line "The workings") {:fg *subtext*}
    (starts-with? (triml line) "= ") {:fg *teal*}
    else nil))

(defn tutor-workings-fontify (src)
  (modes/fontify-line-faces src tutor/tutor-workings-line-face))

(def tutor-workings-layer
  {:name 'tutor-workings
   :no-line-numbers true
   :fontify 'tutor/tutor-workings-fontify})

(register-type-layers :tutor-workings
  (list 'tutor/tutor-workings-layer 'modes/special-mode-layer 'modes/text-mode-layer))
