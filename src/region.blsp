(defmodule region
  "The mark and the region: set and exchange the mark, the mark commands (word, paragraph, defun,
whole buffer), popping back to a jump, narrowing a pane to a region (C-x n), and
`ed-active-region` — the region when one is active, what a replace or a command over the region
reads."
  (:use editor/buffer)
  (:use bufferops)
  (:use interactive)
  (:use pool)
  (:use model))

;; ---- the active region ---------------------------------------------------------------

(defn ed-active-region (m)
  "The current buffer's region as `[low high]` when one is active and not empty, else nil —
Emacs's `use-region-p`, what decides whether a replace is confined to the region."
  (buffer-active-region (ed-current-buf m)))

(defn buffer-active-region (buffer)
  "`buffer`'s region as `[low high]` when one is active and not empty, else nil — the
[[ed-active-region]] of a buffer that may not be the current one."
  (let (bounds (buffer-region-bounds buffer))
    (when (and bounds (< (first bounds) (second bounds))) bounds)))

;; What a command that needs the region says without one.
(def *no-region-message* "no region (set the mark with C-SPC first)")

(defn ed-with-region (m region then)
  "`(then region)` when `region` — what a command read of the current buffer's region: its
text, its bounds, its mark — is there; else the model saying there is no region
([[*no-region-message*]]). Every command that needs a region starts here."
  (if (nil? region) (message m *no-region-message*) (then region)))

;; ---- the mark (C-SPC · C-x C-x · M-@ · M-h · C-M-h · C-x h) ---------------------------

(defcommand cmd-set-mark
  (m key)
  "Set the mark at point and push it onto the mark ring (C-SPC) — point and mark
delimit the region. With a prefix argument (`C-u C-SPC`), instead pop the mark ring,
moving point to a previous mark."
  (if (nil? (current-prefix-arg m))
    (message (ed-apply m push-mark) "mark set")
    (message (ed-apply m pop-mark) "mark popped")))

;; ---- rectangle-mark-mode (C-x SPC) ---------------------------------------------------
;; Emacs's `rectangle-mark-mode`: the region is the BLOCK between point and mark taken as
;; line/column corners, painted as one (`region-ranges`), and C-w / M-w / C-y act on
;; it with the C-x r rectangle ops (`killing`). The flag is `:rectangle-mark` on the buffer;
;; it means nothing without a mark (`bufferops/rectangle-mark-active?`), and a post-step drops
;; it once the mark goes (C-g, a kill), so the next region starts as a plain one.

(defcommand cmd-rectangle-mark-mode
  (m key)
  "Toggle rectangle-mark-mode (C-x SPC, Emacs's): the region becomes the rectangle between
point and mark, painted as a block, and C-w / M-w / C-y kill, copy and yank it as one. Turned
on with no mark, it sets the mark at point. A C-M-drag with the mouse selects one too."
  (let (buf (ed-current-buf m))
    (if (rectangle-mark-active? buf)
      (message (ed-set-buf m (dissoc buf :rectangle-mark)) "Rectangle-Mark mode disabled")
      (message (ed-set-buf m
                 (assoc (if (nil? (buffer-mark buf)) (push-mark buf) buf) :rectangle-mark true))
        "Rectangle-Mark mode enabled"))))

(defn drop-stale-rectangle (m)
  "The post-step: the current buffer's `:rectangle-mark` dropped once its mark is gone, so a
region set later is a plain one again."
  (let (buf (ed-current-buf m))
    (if (and buf (:rectangle-mark buf) (nil? (buffer-mark buf)))
      (ed-set-buf m (dissoc buf :rectangle-mark))
      m)))

(register-post-step :rectangle-mark {:rank 40 :run 'region/drop-stale-rectangle})

(defn- ed-mark-region (m start end)
  "Activate the region between `start` and `end` (point at `start`, mark at `end`) — the
Emacs convention for the `mark-*` commands: point lands at the start of what's marked."
  (ed-set-buf m (assoc (ed-current-buf m) :point start :mark end)))

(defcommand cmd-mark-whole-buffer
  (m key)
  "Select the whole accessible buffer (C-x h): point at its start, mark at its end — in a
narrowed pane, just the narrowing ([[ed-accessible]]), as Emacs's `mark-whole-buffer`."
  (let ([lo hi] (ed-accessible m)) (ed-mark-region m lo hi)))

(defcommand cmd-exchange-point-and-mark
  (m key)
  "Swap point and mark (C-x C-x), so the cursor jumps to the other end of the region.
A no-op (with a note) when no mark is set."
  (let (b (ed-current-buf m) mk (buffer-mark b))
    (if (nil? mk)
      (message m "no mark set")
      (ed-set-buf m (assoc b :point mk :mark (buffer-point b))))))

(defcommand cmd-mark-word
  (m key)
  "Set the mark at the end of the next word, leaving point (Emacs `mark-word`, M-@).
Repeated, it extends the region by another word; under a negative argument it marks the
*previous* word instead (the registered inverse). Same repeat-extends machinery as
`mark-sexp` — see `ed-mark-by`."
  (structural/ed-mark-by m 'region/cmd-mark-word forward-word))

;; `mark-word`'s negative-argument direction — a plain `defn`, like `cmd-mark-sexp-backward`.
(defn cmd-mark-word-backward (m key)
  (structural/ed-mark-by m 'region/cmd-mark-word-backward backward-word))

(defcommand cmd-mark-paragraph
  (m key)
  "Mark the paragraph around point (M-h): point at its start, mark at its end."
  (let (b (ed-current-buf m)
        start (buffer-point (backward-paragraph b))
        end (buffer-point (forward-paragraph (goto-char b start))))
    (ed-mark-region m start end)))

(defcommand cmd-mark-defun
  (m key)
  "Mark the top-level form around point (C-M-h): point at its start, mark at its end —
the defun as the buffer's mode sees one (`ed-defun-bounds`)."
  (structural/ed-with-held-tree m
    (fn (m held)
      (let ([start end] (structural/ed-defun-bounds (ed-current-buf m) key held))
        (ed-mark-region m start end)))))

;; ---- back to the last jump (M-,) -----------------------------------------------------

(defcommand cmd-pop-jump
  (m key)
  "Go back to where the last jump left (M-, — Emacs's `xref-go-back`): a definition, a
reference, a live-search hit."
  (ed-pop-jump m))

;; ---- narrowing: focus a pane on a region (C-x n n/d/p/w) ----------------------
;; Emacs narrowing conflates "restrict what's editable" with "hide the rest" and makes it
;; BUFFER-GLOBAL and modal — every window narrows, and you forget it is on (the classic
;; "where did my file go?"). bedit already has the editable half — `editor/buffer`'s
;; `narrow-to`/`read-only?`, the tutorial's prose, the shell prompt — so narrowing here is
;; the OTHER half: a PER-PANE focus (`:restrict` on the pane, `model/ed-set-restrict`).
;; One pane focuses a defun while another shows the whole file; the restriction is visible
;; (the pane draws only the slice) and local, so there is no hidden mode to forget. Point is
;; confined to it (`model/ed-clamp-restriction`, per key), which is what makes the pane feel
;; like a small buffer.

(defn- ed-narrow-between (m start end)
  "Narrow the selected pane to `[start end]`, drop the mark, and put point at the top of the
region — the shared tail of every narrowing command."
  (let (narrowed (ed-set-restrict m start end))
    (ed-set-buf narrowed (assoc (goto-char (ed-current-buf narrowed) start) :mark nil))))

(defcommand cmd-narrow-to-region
  (m key)
  "Focus this pane on the region (C-x n n): only the lines point↔mark covers stay in view
and point is confined to them. Other panes on the buffer are unaffected. C-x n w widens."
  (ed-with-region m
    (buffer-region-bounds (ed-current-buf m))
    (fn ([lo hi]) (message (ed-narrow-between m lo hi) "Narrowed to region — C-x n w widens"))))

(defcommand cmd-narrow-to-defun
  (m key)
  "Focus this pane on the top-level form around point (C-x n d) — the defun as the buffer's
mode sees one (`ed-defun-bounds`). C-x n w widens."
  (structural/ed-with-held-tree m
    (fn (m held)
      (let ([start end] (structural/ed-defun-bounds (ed-current-buf m) key held))
        (message (ed-narrow-between m start end) "Narrowed to defun — C-x n w widens")))))

(defcommand cmd-narrow-to-paragraph
  (m key)
  "Focus this pane on the paragraph around point (C-x n p). C-x n w widens."
  (let (b (ed-current-buf m)
        start (buffer-point (backward-paragraph b))
        end (buffer-point (forward-paragraph (goto-char b start))))
    (message (ed-narrow-between m start end) "Narrowed to paragraph — C-x n w widens")))

(defcommand cmd-widen
  (m key)
  "Widen the selected pane — undo narrowing, so the whole buffer is in view again (C-x n w)."
  (if (nil? (ed-selected-restrict m))
    (message m "not narrowed")
    (message (ed-clear-restrict m) "Widened")))

;; ---- what the core must know of these commands -------------------------------------

;; a guest may run every one of them (`guest`)
(declare-trait :guest
  '(region/cmd-exchange-point-and-mark region/cmd-mark-defun
     region/cmd-mark-paragraph region/cmd-mark-whole-buffer region/cmd-mark-word
     region/cmd-mark-word-backward region/cmd-narrow-to-defun region/cmd-narrow-to-paragraph
     region/cmd-narrow-to-region region/cmd-pop-jump region/cmd-set-mark region/cmd-widen))

(register-inverse 'region/cmd-mark-word 'region/cmd-mark-word-backward)
(register-prefix-consuming 'region/cmd-set-mark)

;; ---- the region as the view paints it -------------------------------------------

(defn region-ranges (m pane buf context)
  "The highlight source's run: the active region as `[from to face-region]` — a `:bg` tint,
so syntax colours show through — or, a rectangle (C-x SPC, C-M-drag), its block on each line.
Painted in every pane showing the buffer, over the other sources (rank 100)."
  (let (bounds (buffer-region-bounds buf))
    (cond
      (nil? bounds) '()
      (rectangle-mark-active? buf)
        (map (rectangle-ranges buf) (fn ([from to]) [from to theme/face-region]))
      else (list [(first bounds) (second bounds) theme/face-region]))))

(register-highlight-source :region {:rank 100 :run 'region/region-ranges})
