;; WHERE A SLOW TURN'S TIME WENT. The watchdog (brood ADR-490) says which input a slow turn of
;; the loop was folding, or that the view was slow, and how long it took — not where the time
;; went. A turn's update and its view each fill a table of this loop's own (`begin!`): the
;; update's stages (`stage!`), every hook it called (`note!` — post-steps, timers, chips:
;; whatever `model/ed-call-hook` and `model/ed-call-deferred` run) and every group of view
;; sources it ran (`timed-each` — the highlight sources, the pane layers, the frame overlays,
;; each group one part, its sources named only when the group was slow), each by name with its
;; time and calls. A phase that took longer than the watchdog's line leaves its breakdown
;; behind (`finish!`), and the slow-turn log takes it with the report
;; (`slowlog/ed-ev-ui-slow`): `update 64 ms: post-steps 51 · bedit-agent/chip/tick 44 ×3`.
;;
;; A table, not the model: hooks run deep inside model functions that answer other things
;; (a chip's segment, a highlight source's ranges), and the time is spent there. Each loop —
;; a second frame has its own — keys its table by its pid. Costs two clock reads and one table
;; tally a hook call (`[ns calls]`, brood ADR-742), and a clock read a source in a group of them (`timed-each`).

(defmodule turnprofile
  "Where a slow turn of the editor loop spent its time: the update's stages and every hook it
called, kept for the slow-turn log.")

;; The watchdog's line (brood's `editor/ui/*slow-ms*`): a phase slower than this keeps its
;; breakdown. A test binds it to make every frame slow.
(defdyn *slow-ns* (* 50 1000000))

;; How many of a phase's costliest parts a slow report keeps.
(def *kept-parts* 12)

(defn- table-of (pid)
  ;; the table `pid`'s loop is filling now, or nil before its first turn
  (registry/lookup :turnprofile/current pid))

(defn- cpu-us ()
  ;; the CPU time this process has used, in microseconds (what the watchdog's trace reads)
  (or (:cpu-us (%process-info (self))) 0))

(defn begin! ()
  "Start this loop's next phase (an update or a view) with an empty table, noting the CPU time
the loop has used so far: a slow phase says how much of its time the loop RAN ([[finish!]])."
  (let (old (table-of (self))
        counts (table/new))
    (when old (table/drop old))
    (table/put counts [:cpu-start] (cpu-us))
    (registry/put :turnprofile/current (self) counts)))

(defn note! (name ns)
  "Add `ns` nanoseconds and one call to `name` in this loop's phase, when one is being kept."
  (let (counts (table-of (self)))
    ;; one tally `[ns calls]` a part: both fields under one lock and one key (brood ADR-742)
    (when counts (table/tally counts name [ns 1]))))

;; ---- a group of view sources, one part ------------------------------------------------
;; The view runs its sources by the table (the highlight sources, the pane layers, the frame
;; overlays — `sources/run`), a dozen groups a frame, most of them a few microseconds.
;; A part per source (two clock reads and a table write) was 3-5% of a frame, so a
;; group is timed as a whole, with a clock read per source:
;; - under `*group-note-ns*` it is not noted at all: the report rounds to a tenth of a
;;   millisecond, so it would read 0.0 among the parts of a phase that took 50;
;; - past it, it is one part under the group's name;
;; - past `*group-detail-ns*`, each of its sources is a part under its own name as well, so a
;;   slow report still says which one it was.
(defdyn *group-note-ns* 50000) ; a test binds it to tell the two lines apart on a busy machine
(defdyn *group-detail-ns* 1000000)

(defn- each-timed (items call before results times)
  ;; tail-recursive: `[results times ended]`, the first two reversed — each item's time runs
  ;; from the clock read that ended the item before it, so a group costs one read an item
  (if (empty? items)
    [results times before]
    (let (value (call (first items))
          after (os/now-ns))
      (each-timed (rest items) call after (cons value results) (cons (- after before) times)))))

(defn- note-group! (counts group items name-of total times)
  ;; a group past the note line as one part, and past the detail line each item too
  (table/tally counts group [total 1])
  (when (> total *group-detail-ns*)
    (fold (seq/zip items times) nil (fn (_ [item ns]) (note! (name-of item) ns)))))

(defn timed-each (group items name-of call)
  "`(call item)` for each of `items`, in order, as a list — timed as ONE part named `group` (and
each item under `(name-of item)` when the group was slow; see the comment above). With no
phase being kept (a test, a script) it is `map`."
  (let (counts (table-of (self)))
    (if (nil? counts)
      (map items call)
      (let (started (os/now-ns)
            [results times ended] (each-timed items call started '() '())
            total (- ended started))
        (when (> total *group-note-ns*)
          (note-group! counts group items name-of total (reverse times)))
        (reverse results)))))

(defn stage! (name ns)
  "Note one of the update's own stages (`fold`, `post-steps`): told apart from a hook's name."
  (note! (str "stage " name) ns))

(defn- parts (counts)
  ;; `[[name ms calls] …]`, costliest first, at most `*kept-parts*` — every part is a tally
  ;; `[ns calls]` ([[note!]]); the table's other row, `[:cpu-start]`, is a plain number
  (let (named (seq/filter (vec (table/snapshot counts)) (fn ([_ tally]) (vector? tally))))
    (vec (take (map (seq/sort-by named (fn ([_ [ns _]]) (- ns)))
                 (fn ([name [ns calls]])
                   [(->string name) (/ (math/round (/ ns 100000)) 10.0) calls]))
           *kept-parts*))))

(defn finish! (phase ns &optional (context nil))
  "End this loop's `phase` (`\"update\"`, `\"view\"`) after `ns` nanoseconds: past the watchdog's
line its breakdown is kept for the slow-turn report ([[take-breakdown]]), led by what `(context)`
says the turn was in (`*agent: x* agent-chat 412300 chars`) — asked only for a slow one."
  ;; first, how much of the phase the loop spent RUNNING, and how much it did not run at all —
  ;; waiting for a scheduler thread, or blocked: cheap code that took long is the second
  (let (counts (table-of (self)))
    (when counts
      (let (ran-ns (* 1000 (- (cpu-us) (or (table/get counts [:cpu-start]) (cpu-us))))
            waited-ns (math/max 0 (- ns ran-ns))
            ms (fn (n) (/ (math/round (/ n 100000)) 10.0)))
        (remember! phase ns ran-ns)
        (when (> ns *slow-ns*)
          (registry/put :turnprofile/slow
            [(self) phase]
            ;; the context is a description, asked of a model that may be the broken one the
            ;; turn just survived (a render error's): it must never raise into the frame
            (vec (append (if (nil? context)
                           []
                           [[(str "in "
                               (check-allow :discarded-catch
                                 (try (context) (catch e (str "? (" (error-message e) ")")))))
                              nil 1]])
                   [["loop ran" (ms ran-ns) 1] ["loop did not run" (ms waited-ns) 1]]
                   (parts counts)))))))))

;; ---- every recent turn, slow or not -------------------------------------------------------
;; A key that takes 40 ms is never a slow turn, so the report above never sees it. The last
;; `*recent-turns*` phases are kept as `[phase ns ran-ns]`, for M-x latency to set beside the
;; window's key→paint: what the turns cost, and how much of it the loop ran.

(def *recent-turns* 64)

(defn- recent-table ()
  ;; this loop's ring of recent phases, made the first time it is asked for
  (or (registry/lookup :turnprofile/recent (self))
    (let (made (table/new)) (registry/put :turnprofile/recent (self) made) made)))

(defn- remember! (phase ns ran-ns)
  (let (ring (recent-table)
        kept (or (table/get ring :turns) []))
    (table/put ring
      :turns (conj (if (>= (count kept) *recent-turns*) (vec (rest kept)) kept) [phase ns ran-ns]))))

(defn recent-turns ()
  "This loop's last phases, oldest first, as `[phase ns ran-ns]`: an update or a view, how long
it took and how much of that the loop ran."
  (or (table/get (recent-table) :turns) []))

(defn take-breakdown (phase)
  "The breakdown this loop's last slow `phase` left (`[[name ms calls] …]`), taken — nil when
none is waiting."
  (let (key [(self) phase]
        kept (registry/lookup :turnprofile/slow key))
    (when kept (registry/remove :turnprofile/slow key))
    kept))

(defn parts-line (parts)
  "A breakdown as one line: `stage post-steps 51 ms · bedit-agent/chip/tick 44 ms ×3`.

    (turnprofile/parts-line [[\"stage fold\" 3.2 1] [\"git/tick\" 40 3]])   ;=> \"stage fold 3.2 ms · git/tick 40 ms ×3\""
  (string/join (map parts
                 (fn ([name ms calls])
                   (if (nil? ms) name (str name " " ms " ms" (if (> calls 1) (str " ×" calls) "")))))
    " · "))
