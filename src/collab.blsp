(defmodule collab
  "Back a POOL buffer with a shared buffer PROCESS — the seam that lets remote participants
see each other's edits while each keeps their **own** cursor (the 'everyone their own caret'
mode, vs `editor/serve/serve-shared`, which fans ONE model + ONE cursor to all clients).

The editor already gives two *local* panes on one pooled buffer this exact split: content
lives on the pooled buffer value (`model/ed-set-buf` writes it back so every view sees the
edit) while point/mark are per-pane (`model/ed-with-window-point`). This module lifts that one
level — the pooled buffer's *content* is made authoritative in a **buffer process**
(`std/editor/buffer` spawn/subscribe/push) — so panes in *different runtimes* (remote clients)
share it too. Point stays per-pane, so cursors stay independent.

Per client model:

  :shared  {pool-index {:proc <pid> :version N}}   ; which pooled slots are process-backed

Each client `subscribe-buffer`s the process, so every edit anyone makes is serialized by the
process and pushed back as `[:buffer-updated proc version text]`, folded via
`ed-apply-buffer-update` into that slot's CONTENT — leaving every pane's window-local point
alone (cursors stay independent). Local edits go through `collab-edit`, which expresses the
change as a **positional splice** (`replace-region` at absolute offsets) sent to the process:
it applies at the right place regardless of where other participants' points sit, and — in the
v1 serialized regime (each keystroke round-trips before the next; see
`docs/remote-multiplayer-plan.md` §1.4) — two participants' edits both survive with no CRDT.

v1 limitations, on purpose: a push rebuilds the client's buffer from text, so undo history and
client-side markers are transient on a shared buffer (the process is the source of truth).
Simultaneous edits computed against the same base (true concurrency, not round-tripped) need
OT/CRDT — deferred to v2."
  (:use editor/buffer)  ; spawn/subscribe/buffer-edit/replace-region/make-buffer/buffer-text …
  (:use model))         ; ed-init / ed-current-buf / ed-set-buf / ed-buf-at / ed-stamp …

;; ---- the single positional splice diff (candidate for std/string; see module doc) ----

(defn collab--prefix-len (a b i)
  "The length of the common prefix of strings `a` and `b`, scanning from index `i`."
  (if (and (< i (string-length a)) (< i (string-length b))
        (= (char-at a i) (char-at b i)))
    (collab--prefix-len a b (inc i))
    i))

(defn collab--suffix-len (a b limit k)
  "The length of the common suffix of `a` and `b`, capped at `limit` (so it never overlaps a
prefix already counted). Scans inward from the end, `k` chars matched so far."
  (if (and (< k limit)
        (= (char-at a (- (string-length a) 1 k))
          (char-at b (- (string-length b) 1 k))))
    (collab--suffix-len a b limit (inc k))
    k))

(defn collab-splice (old new)
  "The single positional splice `[lo hi repl]` that turns string `old` into `new`: replace
`old[lo, hi)` with `repl`. `lo`/`hi` bound the minimal changed span (shared prefix + suffix
trimmed off), so `(replace-region buf lo hi repl)` reproduces `new`. Equal strings give a
no-op `[n n \"\"]`. This is the whole edit expressed positionally, so it lands correctly at the
process no matter where other participants' points are."
  (let (lo (collab--prefix-len old new 0)
        maxsuf (min (- (string-length old) lo) (- (string-length new) lo))
        suf (collab--suffix-len old new maxsuf 0)
        hi (- (string-length old) suf))
    [lo hi (substring new lo (- (string-length new) suf))]))

(defn collab-splice-noop? (splice)
  "True when `splice` (`[lo hi repl]`) changes nothing — an empty range and empty replacement.
A pure-movement command (point moved, text unchanged) yields this, so no edit is sent."
  (let ([lo hi repl] splice)
    (and (= lo hi) (= repl ""))))

;; ---- the model <-> shared-process link --------------------------------------

(defn collab-shared? (m &optional i)
  "Whether pool slot `i` (default the current buffer's) is backed by a shared buffer process."
  (let (idx (or i (ed-current-index m)))
    (not (nil? (get-in m [:shared idx])))))

;; ---- presence: who's on the buffer, and where --------------------------------
;; Each participant plants a MARKER keyed by its session pid in the shared buffer
;; process — markers are adjusted inside the process's edit primitives, so a cursor
;; stays on its logical spot while others type around it — and registers its display
;; name under `:participants` on the shared buffer value. The subscription projection
;; (`collab--proj`) carries text + markers + names in every push, so every client
;; always knows where everyone is; the buffer process deletes a dead subscriber's
;; pid-keyed marker (std/editor/buffer), so a crashed/detached participant's caret
;; vanishes instead of ghosting.

(defn collab--proj (b)
  "The presence subscription projection: `[text markers participants]` — the document,
every participant's cursor marker (pid → offset), and the pid → name registry."
  [(buffer-text b) (buffer-markers b) (get b :participants {})])

(defn collab--view-parts (view)
  "Normalize a push `view` to `{:text :splice :cursors :names}`. Three wire shapes:
the presence triple `[text markers names]` (closure edits and the seed), a DELTA map
`{:splice [lo hi repl]? :markers … :participants …}` (structured `buffer-splice` /
`buffer-marker-move` ops — O(change), the document never ships), or a bare text string
(plain projections, tests)."
  (cond
    (map? view) {:text nil
                 :splice (get view :splice)
                 :cursors (or (get view :markers) {})
                 :names (or (get view :participants) {})}
    (vector? view) {:text (nth view 0) :splice nil :cursors (nth view 1) :names (nth view 2)}
    :else {:text view :splice nil :cursors {} :names {}}))

(defn collab-share-slot (m i proc)
  "Back pool slot `i` with buffer process `proc`: subscribe this model's process for
presence pushes (`collab--proj`), announce ourselves — a cursor marker keyed by our pid
(so the process cleans it up if we die) and our name (`:participant`, else \"guest\",
upgraded later by `collab-set-name` when the attach identity arrives) — and record the
link (version -1, so the seed push always applies and syncs the slot to the process's
current text). Returns the model."
  (let (me (self)
        name (or (get m :participant) "guest"))
    (do (subscribe-buffer proc collab--proj)
      (buffer-edit proc (fn (b) (assoc (buffer-marker-set b me 0)
                                  :participants (assoc (get b :participants {}) me name)))
        me)
      (assoc-in m [:shared i] {:proc proc :version -1 :me me}))))

(defn collab-set-name (m name)
  "Record this session's participant `name` (the attach identity — `bedit --attach ed
--as alice`, delivered as a `[:client-opts …]` event) and announce it on every shared
slot's process, so other participants' name tags and join/leave echoes show the real
name instead of \"guest\". A no-op for a nil/empty name."
  (if (or (nil? name) (= name ""))
    m
    (do
      (doseq (kv (map-pairs (or (get m :shared) {})))
        (let (sh (second kv)
              proc (get sh :proc)
              me (get sh :me))
          (when me
            (buffer-edit proc (fn (b) (assoc b :participants
                                        (assoc (get b :participants {}) me name)))
              me))))
      (assoc m :participant name))))

(defn collab-sync-point (m)
  "After an event folds: if the CURRENT buffer is shared and its point moved since the
last sync, move this participant's cursor marker in the shared process (between syncs
the marker is edit-adjusted there, so it stays honest under others' edits); likewise
the SELECTION anchor — while a region is active our mark rides along as the
`[me :mark]` marker (deleted when the region drops), so others render our selection in
our colour. Marker moves are structured deltas (`buffer-marker-move` — no text on the
wire). A no-op on unshared buffers and unmoved point/mark, so the every-event path
pays nothing."
  (let (i (ed-current-index m)
        sh (get-in m [:shared i]))
    (if (nil? sh)
      m
      (let (me (get sh :me)
            buf (ed-current-buf m)
            pt (buffer-point buf)
            mk (buffer-mark buf)
            m1 (if (or (nil? me) (= pt (get sh :sent-point)))
                 m
                 (do (buffer-marker-move (get sh :proc) me pt me)
                   (assoc-in m [:shared i :sent-point] pt))))
        (cond
          (nil? me) m1
          (= mk (get-in m1 [:shared i :sent-mark])) m1
          (nil? mk)
          (do (buffer-edit (get sh :proc) (fn (b) (buffer-marker-delete b [me :mark])) me)
            (assoc-in m1 [:shared i :sent-mark] nil))
          :else
          (do (buffer-marker-move (get sh :proc) [me :mark] mk me)
            (assoc-in m1 [:shared i :sent-mark] mk)))))))

;; ---- follow: ride another participant's caret (the pairing mode) -------------
;; `collab-follow` pins your point (and view) to another participant's cursor: every
;; push that moves their marker moves you too — the old one-cursor `--shared`
;; experience, but opt-in, per-person, and reversible. Any point-moving input of your
;; OWN breaks it (you took the wheel); the followed participant leaving breaks it too.

(defn collab-participants (m &optional i)
  "The OTHER participants on slot `i` (default: the current buffer's): `{pid name}`
for every remote cursor, named from the registry (\"guest\" when unnamed)."
  (let (idx (or i (ed-current-index m))
        sh (get-in m [:shared idx])
        names (or (get sh :names) {}))
    (fold (fn (acc kv) (assoc acc (first kv) (get names (first kv) "guest")))
      {} (map-pairs (or (get sh :cursors) {})))))

(defn collab-follow (m pid name)
  "Start following participant `pid`/`name`: point and view ride their caret from the
next push on (see `collab-follow-jump`)."
  (message (assoc m :follow {:pid pid :name name})
    (str "following " name " — any move of your own stops")))

(defn collab-unfollow (m &optional reason)
  "Stop following (a no-op when not). `reason` overrides the default echo."
  (if (nil? (get m :follow))
    m
    (message (dissoc m :follow)
      (or reason (str "stopped following " (get-in m [:follow :name]))))))

(defn collab-follow-jump (m textrows)
  "While following: put point on the followed participant's cursor and keep it on
screen (called from the `:buffer-updated` handler, where the viewport height is known).
A no-op when not following, when their cursor isn't on the current slot, or when point
is already there."
  (let (f (get m :follow))
    (if (nil? f)
      m
      (let (i (ed-current-index m)
            pos (get-in m [:shared i :cursors (get f :pid)]))
        (cond
          (nil? pos) m
          (= pos (buffer-point (ed-current-buf m))) m
          :else (ed-scroll (ed-set-buf m (goto-char (ed-current-buf m) pos)) textrows))))))

(defn collab-follow-step (before after input)
  "Break the follow when the USER moved point — a real key/mouse (`ed-real-input?`)
that changed it means they took the wheel. Movement caused by pushes / the follow jump
/ timers never breaks it. The `ed-update-collab` loop hook."
  (if (and (get after :follow)
        (ed-real-input? input)
        (not (= (buffer-point (ed-current-buf before)) (buffer-point (ed-current-buf after)))))
    (collab-unfollow after)
    after))

(defn collab--presence-echo (m old-cursors cursors names)
  "Echo presence churn between two pushes: a participant key newly in `cursors`
announces \"NAME joined\", one gone announces \"NAME left\" (its name survives in the
`:participants` registry, so leavers are named too). One message per push — churn
beyond that is vanishingly rare. Unchanged sets echo nothing."
  (let (joined (filter (fn (k) (not (contains? old-cursors k))) (keys cursors))
        left (filter (fn (k) (not (contains? cursors k))) (keys old-cursors)))
    (cond
      (not (empty? joined)) (message m (str (get names (first joined) "guest") " joined"))
      (not (empty? left)) (message m (str (get names (first left) "guest") " left"))
      :else m)))

(defn collab-slot-for-proc (m proc)
  "The pool index whose shared link points at buffer process `proc`, or nil if none does."
  (let (hit (find (fn (kv) (= (get (second kv) :proc) proc))
              (map-pairs (or (get m :shared) {}))))
    (if hit (first hit) nil)))

(defn ed-apply-buffer-update (m proc version view &optional origin)
  "Fold a `[:buffer-updated proc version view origin]` push into the model. `view` is
the presence triple `[text cursors names]` (or a bare text string — see
`collab--view-parts`): the slot's content is rebuilt from `text` when it actually
changed (a cursor-only push touches no buffer — cheap, and local undo state survives),
other participants' cursors/names land on the slot (`:cursors`, `:names` — own pid
excluded), presence churn is echoed (`collab--presence-echo`, suppressed on the seed:
finding people already here isn't news the same way), and the version advances.

**Echo suppression**: a push whose `origin` is OUR OWN pid is our edit coming back —
the local model already applied it (and may be ahead of it, mid-fast-typing), so the
content is never rebuilt from it: just the version bump + cursors. Without this, your
own round-trip briefly clobbers newer local keystrokes (a visible flicker) before the
next push reconverges.

**Deltas**: a splice view applies `replace-region` to the slot's buffer in place —
O(change), the rope survives — but ONLY while we have no edit of our own in flight
(`:pending` = splices sent, not yet echoed): a foreign splice racing our in-flight one
was computed against text we've diverged from, so that rare collision resyncs from the
process (`buffer-query`, the always-correct fallback). Cursor-only deltas touch no
content at all.

Every pane's window-local point is untouched — it lives on the pane, not the buffer —
so cursors stay independent and simply clamp into the new text on render. Ignores a
stale/duplicate `version`; a no-op when no slot links to `proc`."
  (let (i (collab-slot-for-proc m proc))
    (if (or (nil? i) (<= version (or (get-in m [:shared i :version]) -1)))
      m
      (let (vp (collab--view-parts view)
            text (get vp :text)
            splice (get vp :splice)
            raw (get vp :cursors)
            names (get vp :names)
            sh (get-in m [:shared i])
            me (get sh :me)
            ;; plain pid keys are cursors; [pid :mark] vector keys are selection anchors
            cursors (fold (fn (acc kv) (if (vector? (first kv)) acc (assoc acc (first kv) (second kv))))
                      {} (map-pairs raw))
            marks (fold (fn (acc kv)
                          (let (k (first kv))
                            (if (and (vector? k) (= (nth k 1 nil) :mark) (not (= (first k) me)))
                              (assoc acc (first k) (second kv))
                              acc)))
                    {} (map-pairs raw))
            own? (and (not (nil? origin)) (= origin me))
            pending (or (get sh :pending) 0)
            others (if (nil? me) cursors (dissoc cursors me))
            seed? (= (or (get sh :version) -1) -1)
            m1 (if seed? m (collab--presence-echo m (or (get sh :cursors) {}) others
                             (merge (or (get sh :names) {}) names)))
            ;; the participant we were following left → stop (their caret is gone)
            m1b (let (f (get m1 :follow))
                  (if (and f (contains? (or (get sh :cursors) {}) (get f :pid))
                        (not (contains? others (get f :pid))))
                    (collab-unfollow m1 (str (get f :name) " left — stopped following"))
                    m1))
            m2 (assoc m1b :shared (assoc (get m1b :shared) i
                                    (merge sh {:version version
                                               :cursors others
                                               :marks marks
                                               :names names
                                               ;; our own splice came home — one less in flight
                                               :pending (if (and own? splice) (max 0 (dec pending)) pending)})))
            old (ed-buf-at m2 i))
        (cond
          ;; our own edit coming back — the local model already applied it (echo suppression)
          own? m2
          ;; a foreign DELTA, no divergence risk → apply the splice in place (O(change))
          (and splice (= pending 0))
          (let ([lo hi repl] splice)
            (assoc m2 :buffers (assoc (get m2 :buffers) i (replace-region old lo hi repl))))
          ;; a foreign delta while our own edit is in flight → we may have diverged; the
          ;; rare collision resyncs the whole slot from the process (always correct)
          splice
          (let (t (buffer-query proc buffer-text))
            (assoc (assoc-in m2 [:shared i :pending] 0)
              :buffers (assoc (get m2 :buffers) i
                         (ed-stamp (make-buffer t (buffer-name old) (buffer-file old))))))
          ;; a full-text view (closure edits / the seed): rebuild only on real change
          (or (nil? text) (= text (buffer-text old))) m2
          :else
          (assoc m2 :buffers (assoc (get m2 :buffers) i
                               (ed-stamp (make-buffer text (buffer-name old) (buffer-file old))))))))))

(defn collab-edit (m op)
  "Apply edit `op` (a `buffer -> buffer` transform, as commands produce) to the current buffer.
When the buffer is process-backed, express the change as a positional splice (`collab-splice`)
and send it to the process (`buffer-edit` + `replace-region`); the process serializes it and
pushes the result to every subscriber (including us), so all clients — each with their own
cursor — converge. The local pane is updated at once (the caret responds without a round-trip;
the push then reconciles the content). When the buffer isn't shared, this is exactly
`ed-set-buf` with `op` applied — so a command may call `collab-edit` unconditionally."
  (let (buf (ed-current-buf m)
        nb (op buf))
    (if (collab-shared? m)
      (let (i (ed-current-index m)
            sh (get-in m [:shared i])
            proc (get sh :proc)
            splice (collab-splice (buffer-text buf) (buffer-text nb))
            [lo hi repl] splice)
        (if (collab-splice-noop? splice)
          (ed-set-buf m nb)
          (do (buffer-splice proc lo hi repl (get sh :me))
            (assoc-in (ed-set-buf m nb) [:shared i :pending]
              (inc (or (get sh :pending) 0))))))
      (ed-set-buf m nb))))

(defn collab-propagate (before after)
  "The command-agnostic counterpart to `collab-edit`: after a command folds an event in, push
each shared slot's text change to its process so other participants see it. For every
process-backed slot whose text differs between `before` and `after`, send the positional splice
(`collab-splice`) as a structured `buffer-splice` (a DELTA on the wire — the process pushes
`[lo hi repl]`, not the document) tagged with our pid, and count it in the slot's `:pending`
(in flight until its echo returns — the divergence guard `ed-apply-buffer-update` uses).
Returns `after` with those counts. This lets the ordinary editing commands stay `model ->
model` with no knowledge of sharing — the `ui-run` loop calls this once per event. (Use
*either* this loop-level hook *or* explicit `collab-edit` call sites, not both on the same
edit, or the splice sends twice.)"
  (fold
    (fn (acc kv)
      (let (i (first kv)
            sh (second kv)
            proc (get sh :proc)
            me (get sh :me))
        (if (not (and (< i (count (get before :buffers))) (< i (count (get acc :buffers)))))
          acc
          (let (splice (collab-splice (buffer-text (ed-buf-at before i))
                         (buffer-text (ed-buf-at acc i))))
            (if (collab-splice-noop? splice)
              acc
              (let ([lo hi repl] splice)
                (buffer-splice proc lo hi repl me)
                (assoc-in acc [:shared i :pending] (inc (or (get-in acc [:shared i :pending]) 0)))))))))
    after
    (map-pairs (or (get after :shared) {}))))

(defn collab-unshare (m i)
  "Drop the shared link on pool slot `i`: withdraw our presence (delete our cursor marker
and name — the graceful counterpart of the buffer process's dead-subscriber cleanup) and
unsubscribe this model's process (its content stops tracking; the local copy is kept as
an ordinary buffer). A no-op when the slot isn't shared."
  (let (sh (get-in m [:shared i])
        proc (get sh :proc)
        me (get sh :me))
    (if (nil? proc)
      m
      (do (when me
            (buffer-edit proc (fn (b) (assoc (buffer-marker-delete b me)
                                        :participants (dissoc (get b :participants {}) me)))
              me))
        (unsubscribe-buffer proc)
        (assoc m :shared (dissoc (get m :shared) i))))))
