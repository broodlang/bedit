(defmodule murstatus
  "C-x g in a mur working copy: *mur-status*, a section buffer (Magit's feel, mur's model).
The change you are on — what it is for, where it stands, its versions and whether the forge
has them — then the clashes left to settle, the files changed since the last save (TAB shows
each one's diff), edits no change has claimed, the other changes open in this working copy,
and trunk's newest snapshots.

The keys are mur's verbs, acting on what is at point where that means something:
`c` says what a change is for (a fresh one once this one holds files) · `r` renames it ·
`s` saves (the file at point, or every file) · `l` lands · `u` updates onto the latest trunk
· `y` syncs what the forge lacks · `S` settles the clash at point · `k` restores the file at
point · `a` claims it · `x` drops the change · RET visits (a file, a clash at its line, a
change here goes to it, a snapshot shows) · `d` the diff · `L` trunk's log · `V` the
versions · `!` any mur command. The forge's side — `o` the change's page, `O` the open
changes, `C` checks, `D` discussion, `R` reviews — is `murforge`'s.

Collected OFF the loop (three subprocesses: status, diff, and the forge's log), like
*git-status*."
  (:use minibuffer)
  (:use model) ; message / ed-buffer-index-by-name / ed-current-index / ed-headless? / register-task-reply
  (:use pool) ; ed-pop-to-file / ed-show-named
  (:use editor/buffer) ; buffer-file / buffer-text
  (:use editor/keymap :only [keymap-bind]) ; the *mur-status* keymap
  (:use editor/layers :only [register-type-layers]) ; its buffer types
  (:use section) ; section — the tree
  (:use sectionbuf) ; sb-show / sb-at / sb-rows / sb-line / sb-ctx / sb-keymap
  (:use interactive) ; defcommand
  (:use task) ; task — the collection, off the loop
  (:use vcsproc) ; vcs-confirm / vcs-show-report / the diff faces
  (:use murcore) ; mur-mur / mur-json / mur-do / mur-launch / the faces
  (:use murbar)) ; mur-summary-of / mur-state-words — the header says what the mode line says

;; ---- collecting, off the loop -----------------------------------------------------

(def *mur-log-count* 10) ; trunk's newest snapshots the status lists
(def *mur-log-timeout-ms* 4000) ; how long the status waits for the forge's log before going without

(defn mur-collect-status (root)
  "What *mur-status* shows of working copy `root` from this machine alone: `{:root :status
:error :diff}` — `mur status --json` (nil, with `:error` saying why, when mur cannot answer)
and `mur diff`'s text. Trunk's log, which asks the forge, is [[mur-collect-log]]."
  (let (r (mur-mur root ["status" "--json"])
        status (mur-decode r))
    {:root root
     :status status
     :error (cond
              (map? status) nil
              ;; a client from before `--json` prints its prose and succeeds
              (= (:exit r) 0)
                "this mur client answers without --json: update it (mur.fly.dev/install.sh, or make install in mur)"
              else (string/trim (str (:stderr r "") (:stdout r ""))))
     :diff (if (map? status) (:stdout (mur-mur root ["diff"])) "")}))

;; ---- the diff, per file ----------------------------------------------------------

(defn mur-split-diff (text)
  "`mur diff`'s text as `{path parsed-file}`: each file parsed by std's `diff` (its hunks, each
body line knowing the file line it is), under the path its `--- path` header names — taken
from the header itself, since mur prints paths with no `a/`/`b/` to strip. Pure.

    (count (:hunks (get (murstatus/mur-split-diff \"--- a\\n+++ a\\n@@ -1 +1 @@\\n-x\\n+y\") \"a\")))   ;=> 1"
  (fold (diff/parse-unified (or text ""))
    {}
    (fn (acc file)
      (let (header (seq/find (or (:headers file) []) (fn (line) (string/starts-with? line "--- "))))
        (if (nil? header) acc (assoc acc (string/substring header 4 (string/length header)) file))))))

;; ---- the tree ----------------------------------------------------------------------

(defn- mur-count-heading (title items) (str title " (" (count items) ")"))

(defn- mur-head-lines (status)
  "The block at the top: the change, where it stands, the project, trunk, and anything that
holds the work back (a refused send, a trunk move waiting, a merge under way)."
  (let (unsent (or (:unsent status) 0)
        summary (murbar/mur-summary-of status))
    (seq/reject [(str "Change:   "
                   (mur-short (:change status))
                   "  "
                   (or (:title status) "(not said what it is for yet)"))
                  (str "State:    "
                    (murbar/mur-state-words summary)
                    (if (> unsent 0) (str ", " unsent " not on the forge yet (y sends)") ""))
                  (str "Project:  " (or (:project status) "?") "  " (or (:url status) ""))
                  (str "Trunk:    " (mur-short (:base status)) "  (where this change starts)")
                  (if (:onto status) (str "Onto:     " (mur-short (:onto status))) nil)
                  (if (:pending_trunk_move status)
                    "Waiting:  a trunk move to settle with the forge (y)"
                    nil)
                  (:blocked status)]
      nil?)))

(defn- mur-clash-section (clash)
  (section :clash
    clash
    (if (:whole clash)
      (str (:path clash) "  (the whole file)")
      (str (:path clash) ":" (:line clash)))))

(defn- mur-file-section (file diffs painted)
  "A changed file, folded: its hunks (`vcsproc/vcs-hunk-sections`) under it, as git's are —
painted when its path is in `painted`, the buffer's budget (`diffpaint/paint-keys`)."
  (let (parsed (get diffs (:path file)))
    (section :file
      file
      (str (string/pad-right (:status file) 10) " " (:path file))
      (if (nil? parsed)
        []
        (into []
          (vcsproc/vcs-hunk-sections parsed {:path (:path file)} (contains? painted (:path file)))))
      {:key (:path file) :hidden true})))

(defn- mur-here-section (entry)
  (section :here
    entry
    (str (if (:yours entry) "* " "  ")
      (string/pad-right (str (:number entry)) 3)
      (mur-short (:change entry))
      "  "
      (or (:title entry) "(not said what it is for yet)")
      (let (who (append (if (:yours entry) ["you"] []) (or (:others entry) []))
            files (:claimed entry 0)
            detail (append who (if (> files 0) [(str files (if (= files 1) " file" " files"))] [])))
        (if (empty? detail) "" (str "  (" (string/join detail ", ") ")"))))
    []
    {:key (:change entry)}))

(defn- mur-snapshot-section (snapshot)
  (section :snapshot
    snapshot
    (str (mur-short (:snapshot snapshot))
      "  "
      (:title snapshot)
      "  — "
      (:author snapshot)
      (if (:base snapshot) "  ← this change starts here" ""))
    []
    {:key (:snapshot snapshot)}))

(defn- mur-group (type title items build)
  "A top-level section of `items` (each through `build`), or nil when there are none."
  (if (empty? items)
    nil
    (section type
      title
      (mur-count-heading title items)
      (into [] (map items build))
      {:separator true})))

(defn mur-status-tree (collected)
  "PURE: the *mur-status* section tree from a `mur-collect-status` answer."
  (let (status (:status collected))
    (if (not (map? status))
      (section :root
        nil
        nil
        [(section :head
           nil
           nil
           ["mur cannot read this working copy:"
             ""
             (or (:error collected) "no answer")
             ""
             "(g tries again; $ shows what ran)"])])
      (let (diffs (mur-split-diff (:diff collected))
            against (if (= (:against status) "trunk") "trunk" "the last save")
            files (or (:files status) [])
            painted (diffpaint/paint-keys (seq/keep files
                                            (fn (f)
                                              (let (parsed (get diffs (:path f)))
                                                (when (map? parsed) [(:path f) parsed])))))
            others (murbar/mur-other-changes (:here status)))
        (section :root
          nil
          nil
          (seq/reject [(section :head nil nil (into (mur-head-lines status) [""]))
                        (mur-group :clashes
                          "Clashes to settle"
                          (or (:clashes status) [])
                          mur-clash-section)
                        (mur-group :changed
                          (str "Changed since " against)
                          files
                          (fn (f) (mur-file-section f diffs painted)))
                        (mur-group :unclaimed
                          "Edited here, claimed by no change"
                          (or (:unclaimed status) [])
                          (fn (p) (section :unclaimed p p)))
                        (mur-group :here
                          "Changes here"
                          (if (empty? others)
                            []
                            (seq/filter (or (:here status) [])
                              (fn (entry) (or (:yours entry) (includes? others entry)))))
                          mur-here-section)
                        (mur-group :trunk "Trunk" (or (:log collected) []) mur-snapshot-section)]
            nil?))))))

;; ---- the faces: a line coloured by what it IS --------------------------------------

(defn- mur-span (from to face) (if (or (nil? face) (>= from to)) nil [from to face]))

(defn mur-status-bands (row line)
  "The *mur-status* `:section-bands` service: a hunk's heading bar and its added and removed
lines tinted across the pane, as git's are."
  (when (= (:type row) :hunk) (vcs-hunk-band row line)))

(defn mur-status-faces (row line)
  "The *mur-status* `:section-faces` service: the faces of `line`, which `row` says is."
  (let (type (:type row)
        n (string/length line))
    (seq/reject
      (cond
        (= type :head)
          (if (and (> n 10) (= (string/substring line 8 10) "  "))
            [(mur-span 0 9 mur-face-label)
              (if (string/starts-with? line "Change:")
                (mur-span 10 (math/min n 22) mur-face-id)
                (if (string/starts-with? line "Trunk:")
                  (mur-span 10 (math/min n 22) mur-face-id)
                  nil))
              (if (string/starts-with? line "Change:") (mur-span 24 n mur-face-title) nil)]
            [])
        ;; a hunk, heading and body, painted as every VCS's hunks are
        (= type :hunk) (vcs-hunk-spans row line)
        (not (:heading? row))
          (if (string/starts-with? line "@@")
            [(mur-span 0 n vcs-face-hunk)]
            [(mur-span 0 n (vcs-diff-line-face line))])
        (contains? #{:clashes :changed :unclaimed :here :trunk} type)
          (let (i (index-of line " ("))
            (if (< i 0)
              [(mur-span 0 n mur-face-section)]
              [(mur-span 0 i mur-face-section) (mur-span (inc i) n mur-face-note)]))
        (= type :clash) [(mur-span 0 n mur-face-clash)]
        (= type :file)
          (let (status (:status (:value row)))
            [(mur-span 0
               10
               (cond
                 (= status "added") vcs-face-add
                 (= status "removed") vcs-face-del
                 else mur-face-changed))])
        (= type :unclaimed) [(mur-span 0 n mur-face-dim)]
        (= type :here) [(mur-span 5 (math/min n 17) mur-face-id)]
        (= type :snapshot) [(mur-span 0 (math/min n 12) mur-face-id)]
        else [])
      nil?)))

;; ---- showing it --------------------------------------------------------------------

(defn- mur-first-line (rows)
  "Where point goes on a first open: the first changed file, else the top."
  (let (i (seq/index-where rows (fn (row) (and (:heading? row) (= (:type row) :file)))))
    (if (>= i 0) (inc i) 1)))

(defn- mur-render-status (m root collected line action &optional (tree nil))
  "PURE: fold a collection into working copy `root`'s *mur-status* — its `tree` when the
task built it already, else built here. The collection rides on the buffer (`:ctx`), so the
forge's log, which lands after it, can redraw its own section of the same view. One buffer
per working copy (`*mur-status: name*`, `vcsproc/vcs-status-name`)."
  (let (fresh? (nil? (map/get-in (mur-status-buf m root) [:section-tree])))
    (sb-show m
      (vcs-status-name m "mur-status" :mur-status root)
      (or tree (mur-status-tree collected))
      :mur-status {:action action
       :ctx {:root root :collected collected}
       :line (if (and (nil? line) fresh?) mur-first-line line)})))

(defn- mur-status-buf (m root)
  "Working copy `root`'s *mur-status* buffer, or nil."
  (let (i (vcs-status-index m :mur-status root)) (when i (ed-buf-at m i))))

(defn- mur-status-collected (m root)
  "The collection `root`'s *mur-status* shows now (on its buffer), or nil when it is not open."
  (map/get-in (mur-status-buf m root) [:section-ctx :collected]))

(defn- mur-status-focus (m root)
  "`:here` when the reader is looking at `root`'s *mur-status* (or it is not open yet), else
`:none` ([[vcsproc/vcs-status-focus]])."
  (vcs-status-focus m :mur-status root))

(defn mur-collect-log (root)
  "Trunk's newest snapshots for *mur-status* (`mur log --json`): the forge's, so asked
separately from the rest and bounded — offline, nil, and the status shows without them."
  (mur-json root ["log" "-n" (str *mur-log-count*) "--json"] {:timeout-ms *mur-log-timeout-ms*}))

(defn mur-show-status (m root &optional (line nil) (action nil))
  "Show or refresh `root`'s *mur-status*, collecting OFF the loop in two steps: the
working copy (status and diff, this machine only) lands first and is shown at once, beside
the reader on a first open; trunk's log, which asks the forge, fills in when it arrives — a
refresh keeps the log it had meanwhile. Headless collects both inline. One collection runs at
a time; another working copy's asked for meanwhile waits for it (`vcs-status-defer`)."
  (let (root (vcs-clean-root root)
        act (or action (mur-status-focus m root)))
    (cond
      (ed-headless?)
        (mur-render-status m
          root
          (assoc (mur-collect-status root) :log (mur-collect-log root))
          line
          act)
      (and (:mur-status-proc m) (not (vcs-same-root? root (:mur-status-root m))))
        (vcs-status-defer (vcs-status-show-now m "mur-status" :mur-status root act)
          :mur-status-waiting root
          {:line line :action (vcs-status-landing act)})
      else
        (let (log (:log (mur-status-collected m root))
              ;; the tree too, under the log on screen now — painting its hunks is work the
              ;; loop need not wait for
              job (task (fn ()
                          (let (collected (mur-collect-status root))
                            {:collected collected
                             :log log
                             :tree (mur-status-tree (assoc collected :log log))}))
                    {:timeout *vcs-op-timeout-ms*}))
          (assoc (vcs-status-show-now m "mur-status" :mur-status root act)
            :mur-status-proc job
            :mur-status-root root
            :mur-status-line line
            :mur-status-action (vcs-status-landing act))))))

(defn- mur-launch-waiting (m root request)
  ;; a status that waited for another working copy's to land, launched now
  (mur-show-status m
    root
    (:line request)
    (if (= :here (mur-status-focus m root)) (:action request) :none)))

(register-task-reply :mur-status-proc 'murstatus/mur-apply-show-status nil "mur status")
(defn mur-apply-show-status (m answer)
  "Fold the working copy's collection (`{:collected :log :tree}`, the tree built under
`:log`) into the buffer, then ask the forge for trunk's log. A nil answer (the task errored or timed out) says so rather than rendering an empty change.
Where it lands is decided NOW: `:here` was the reader's place when the refresh started, and
if they have since moved, landing it there would drag them back."
  (let (collected (:collected answer)
        root (:mur-status-root m)
        line (:mur-status-line m)
        action (:mur-status-action m :none)
        m1 (dissoc m :mur-status-proc :mur-status-root :mur-status-line :mur-status-action)
        ;; the log it had, until the forge answers again
        log (:log (mur-status-collected m1 root))
        shown (assoc collected :log log))
    (vcs-status-next
      (if (nil? answer)
        (message m1 "mur status: no answer (timed out)")
        (mur-launch-log
          (mur-render-status m1
            root
            shown
            line
            (if (= :here (mur-status-focus m1 root)) action :none)
            ;; built under the log there was then; one that has landed since
            ;; is drawn in by building again
            (if (= log (:log answer)) (:tree answer) nil))
          root))
      :mur-status-waiting mur-launch-waiting)))

(defn- mur-launch-log (m root)
  "Ask the forge for trunk's log off the loop. An ask already out for the same working copy
covers this one; one out for another leaves this working copy's asked for next
(`:mur-log-next`)."
  (cond
    (and (:mur-log-proc m) (vcs-same-root? root (:mur-log-root m))) m
    (:mur-log-proc m) (assoc m :mur-log-next root)
    else
      (assoc m
        :mur-log-proc (task (fn () (mur-collect-log root)) {:timeout vcsproc/*vcs-op-timeout-ms*})
        :mur-log-root root)))

(register-task-reply :mur-log-proc 'murstatus/mur-apply-log nil nil)
(defn mur-apply-log (m log)
  "Fold trunk's log into its working copy's *mur-status* — the same view, re-rendered in
place and quietly (point kept, no pane moved) — when that status is still open. Then ask for
the log another working copy's status was left waiting for."
  (let (root (:mur-log-root m)
        next-root (:mur-log-next m)
        m1 (dissoc m :mur-log-proc :mur-log-root :mur-log-next)
        collected (mur-status-collected m1 root)
        landed (if (or (nil? collected) (nil? log))
                 m1
                 (mur-splice-log m1 root (assoc collected :log log))))
    (if (nil? next-root) landed (mur-launch-log landed next-root))))

(defn- mur-splice-log (m root collected)
  "*mur-status* with its Trunk section redrawn from `collected` (which carries the log) and
the collection kept on the buffer — the section alone, spliced in place (`sb-splice`), since
nothing else changed. A status that had no Trunk section yet is rendered whole."
  (let (i (or (vcs-status-index m :mur-status root) (error (str "no *mur-status* for " root)))
        b (ed-buf-at m i)
        tree (:section-tree b)
        id [[:root nil] [:trunk "Trunk"]]
        fresh (when (and tree (section-at tree id))
                (mur-group :trunk "Trunk" (or (:log collected) []) mur-snapshot-section)))
    (if (nil? fresh)
      (mur-render-status m root collected nil (mur-status-focus m root))
      (let (spliced (sb-splice m i id (section-replace tree id fresh) (or (:section-vis b) {})))
        (ed-set-buf-at spliced
          i
          (assoc (ed-buf-at spliced i) :section-ctx (assoc (:section-ctx b) :collected collected)))))))

(defn mur-refresh (m)
  "Refresh the *mur-status* of the working copy the buffer is about (`mur-resolve-root`) when
it is open — in place, point kept on the line it was on."
  (let (root (mur-resolve-root m))
    (if (nil? (vcs-status-index m :mur-status root)) m (mur-show-status m root nil nil))))

;; ---- what is at point --------------------------------------------------------------

(defn- mur-file-at (m)
  "The file a command at point is about, as a path relative to the working copy: in
*mur-status* the changed file point is on (its heading or a line of its diff), an unclaimed
one or a clash's; in a file buffer, that file. nil elsewhere — then a command acts on the
whole change."
  (let (file (sb-ancestor m :file)
        row (sb-at m)
        visited (buffer-file (ed-current-buf m))
        root (mur-resolve-root m))
    (cond
      file (:path (:value file))
      (and row (= (:type row) :unclaimed)) (:value row)
      (and row (= (:type row) :clash)) (:path (:value row))
      else (projects/path-under root visited))))

(defn- mur-diff-line-number (m)
  "The file line a diff line at point stands for (`vcsproc/vcs-hunk-line`: the line it is, or
sits at when removed; a hunk's heading its first line); nil off a hunk."
  (let (hunk (sb-ancestor m :hunk))
    (if (nil? hunk) nil (vcsproc/vcs-hunk-line (sb-at m) (:value hunk)))))

;; ---- commands ----------------------------------------------------------------------

(defcommand cmd-mur-status
  (m key)
  "The status of the mur working copy this buffer is in (C-x g): the change you are on,
what changed since its last save, the clashes to settle, the other changes here."
  (mur-with-root m (fn (mm root) (mur-show-status mm root nil :pop))))

(defcommand cmd-mur-refresh
  (m key)
  "Read the working copy again (g)."
  (mur-refresh m))

(defcommand cmd-mur-visit
  (m key)
  "Visit what is at point (RET): a diff line opens its file at that line, a file opens it,
a clash opens at its line, a change here goes to it (`mur change N`), a snapshot shows what
it changed."
  (let (row (sb-at m)
        root (mur-resolve-root m)
        type (and row (:type row)))
    (cond
      (or (nil? row) (nil? root)) m
      (= type :clash)
        (pool/ed-pop-to-file m
          (path/join root (:path (:value row)))
          (math/max 1 (:line (:value row) 1)))
      (= type :here)
        (if (:yours (:value row))
          (message m "already on this change")
          (mur-do m "change" ["change" (str (:number (:value row)))]))
      (= type :snapshot)
        (mur-show-text m root "show" ["show" (:snapshot (:value row))] "*mur-show*")
      (= type :unclaimed) (pool/ed-pop-to-file m (path/join root (:value row)) 1)
      (not (nil? (sb-ancestor m :file)))
        (let (path (mur-file-at m))
          (if (= (:status (:value (sb-ancestor m :file))) "removed")
            (message m (str path " is removed in the working files"))
            (pool/ed-pop-to-file m (path/join root path) (or (mur-diff-line-number m) 1))))
      else (sb-toggle m))))

(defn- mur-ask-words (m prompt initial then)
  "A free-text prompt whose non-blank answer, trimmed, goes to `(then model words)`."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit prompt initial)
       :on-complete (fn (mm text)
                      (let (words (string/trim text))
                        (if (= words "") (message mm "nothing said") (then mm words))))}))

(defcommand cmd-mur-change
  (m key)
  "Say what you are about to do (c): the change you are on takes the words while it holds no
files yet, else a fresh change starts and the one you were on stays open here. The forge
lists it as open at once."
  (mur-with-root m
    (fn (mm _root)
      (mur-ask-words mm
        "What is the change for: "
        ""
        (fn (answered words) (mur-launch answered "change" ["change" "-m" words]))))))

(defcommand cmd-mur-rename
  (m key)
  "Say again what the change you are on is for (r)."
  (mur-with-root m
    (fn (mm _root)
      (mur-ask-words mm
        "The change is for: "
        ""
        (fn (answered words) (mur-launch answered "rename" ["change" "--rename" words]))))))

(defcommand cmd-mur-save
  (m key)
  "Save the change's next version and send it to the forge (s): the file at point (claimed
for the change first), or every file the change has when point is on none."
  (let (path (mur-file-at m))
    (mur-launch m "save" (if (nil? path) ["save"] ["save" path]))))

(defcommand cmd-mur-land
  (m key)
  "Land the change on trunk (l): what changed since the last save is saved first, the change
is brought onto the latest trunk, and everyone gets it with their next update. Asks first."
  (vcs-confirm m
    "Land this change on trunk, for everyone?"
    (fn (mm) (mur-launch mm "land" ["land"]))))

(defcommand cmd-mur-update
  (m key)
  "Bring the change onto the latest trunk (u); where you and trunk changed the same lines it
stops, and the clashes are listed to settle."
  (mur-launch m "update" ["update"]))

(defcommand cmd-mur-sync
  (m key)
  "Send what the forge lacks (y): versions saved while it could not be reached."
  (mur-launch m "sync" ["sync"]))

(defcommand cmd-mur-settle
  (m key)
  "Settle the clashes of the file at point's clash (S) — mur settles a FILE's clashes one way:
keep yours (m), trunk's (t) or both (b). A whole-file clash (one side removed it, or it is
not text) takes yours, trunk's, or the file as you fixed it by hand (k). To settle one clash
of several differently, edit those lines: that settles it too."
  (let (row (sb-at m))
    (if (or (nil? row) (not (= (:type row) :clash)))
      (message m "not on a clash (the Clashes section lists them)")
      (let (path (:path (:value row))
            whole? (:whole (:value row)))
        (ed-read-char m
          (if whole?
            (str "Settle " path ": [m]ine, [t]runk's, or [k]eep it as it is now? ")
            (str "Settle every clash in " path ": [m]ine, [t]runk's, [b]oth? "))
          (fn (mm c)
            (let (side (get (if whole?
                              {"m" "mine" "t" "trunk" "k" "keep"}
                              {"m" "mine" "t" "trunk" "b" "both"})
                         c))
              (if (nil? side) (message mm "cancelled") (mur-do mm "settle" ["settle" side path])))))))))

(defcommand cmd-mur-restore
  (m key)
  "Put the file at point back as the last save has it (k), throwing away its edits since.
Asks first, naming the file: what is thrown away is saved nowhere."
  (let (path (mur-file-at m))
    (if (nil? path)
      (message m "not on a file")
      (vcs-confirm m
        (str "Throw away your edits to " path " since the last save?")
        (fn (mm) (mur-do mm "restore" ["restore" path]))))))

(defcommand cmd-mur-claim
  (m key)
  "Claim the file at point for the change you are on (a), so no other change here takes it."
  (let (path (mur-file-at m))
    (if (nil? path) (message m "not on a file") (mur-do m "claim" ["claim" path]))))

(defcommand cmd-mur-drop
  (m key)
  "Drop the change (x): it is no longer open, its files go back as trunk has them, and a
fresh change starts. Asks first."
  (vcs-confirm m
    "Drop this change? Its files go back as trunk has them."
    (fn (mm) (mur-launch mm "drop" ["drop"]))))

(defn mur-show-text (m root verb args buffer)
  "Run `mur args` in working copy `root` OFF the loop and show what it printed in the
read-only report `buffer` (beside the status) — for what reads the forge (checks,
discussion, the log) as well as what does not."
  (vcs-pinned m
    root
    (fn (pinned)
      (mur-launch pinned
        verb
        args
        (fn (mm r)
          (if (= (:exit r) 0)
            (vcs-show-report mm buffer (string/trimr (:stdout r "")) :mur-text {:action :pop})
            mm))))))

(defcommand cmd-mur-diff
  (m key)
  "The diff of the file at point, or of every changed file (d), in *mur-diff*."
  (let (path (mur-file-at m))
    (mur-with-root m
      (fn (mm root)
        (mur-show-text mm root "diff" (if (nil? path) ["diff"] ["diff" path]) "*mur-diff*")))))

(defcommand cmd-mur-diff-file
  (m key)
  "This file's changes since the change's last save (C-x v =), in *mur-diff*."
  (let (file (buffer-file (ed-current-buf m)))
    (mur-with-root m
      (fn (mm root)
        (if (nil? file)
          (message mm "no file to diff")
          (mur-show-text mm root "diff" ["diff" file] "*mur-diff*"))))))

(defcommand cmd-mur-log
  (m key)
  "Trunk's history (L), newest first, in *mur-log*."
  (mur-with-root m (fn (mm root) (mur-show-text mm root "log" ["log" "-n" "50"] "*mur-log*"))))

(defcommand cmd-mur-log-file
  (m key)
  "This file's history on trunk (C-x v l): only the snapshots that changed it."
  (mur-with-root m
    (fn (mm root)
      (let (path (mur-file-at mm)
            file (if (nil? path) (buffer-file (ed-current-buf mm)) (path/join root path)))
        (if (nil? file)
          (message mm "no file here to log")
          (mur-show-text mm root "log" ["log" "-n" "50" file] "*mur-log*"))))))

(defcommand cmd-mur-versions
  (m key)
  "The change you are on and its versions (V)."
  (mur-with-root m
    (fn (mm root) (mur-show-text mm root "versions" ["versions"] "*mur-versions*"))))

(defcommand cmd-mur-run-command
  (m key)
  "Run any mur command in this working copy (!) and show what it printed — the line split
into words as a shell would (`os/shell-split`: `comment -m 'two words'`), run as an argv."
  (mur-with-root m
    (fn (mm root)
      (mur-ask-words mm
        "mur "
        ""
        (fn (answered words)
          (mur-show-text answered
            root
            (str "mur " words)
            (os/shell-split words)
            "*mur-output*"))))))

;; ---- the buffer types --------------------------------------------------------------

(def mur-status-keymap
  (-> (sb-keymap)
    (keymap-bind [:enter] 'murstatus/cmd-mur-visit)
    (keymap-bind ["g"] 'murstatus/cmd-mur-refresh)
    (keymap-bind ["q"] 'vcsproc/cmd-vcs-quit)
    (keymap-bind ["$"] 'vcsproc/cmd-vcs-process)
    (keymap-bind ["?"] 'mur/cmd-mur-dispatch)
    (keymap-bind ["c"] 'murstatus/cmd-mur-change)
    (keymap-bind ["r"] 'murstatus/cmd-mur-rename)
    (keymap-bind ["s"] 'murstatus/cmd-mur-save)
    (keymap-bind ["l"] 'murstatus/cmd-mur-land)
    (keymap-bind ["u"] 'murstatus/cmd-mur-update)
    (keymap-bind ["y"] 'murstatus/cmd-mur-sync)
    (keymap-bind ["S"] 'murstatus/cmd-mur-settle)
    (keymap-bind ["k"] 'murstatus/cmd-mur-restore)
    (keymap-bind ["a"] 'murstatus/cmd-mur-claim)
    (keymap-bind ["x"] 'murstatus/cmd-mur-drop)
    (keymap-bind ["d"] 'murstatus/cmd-mur-diff)
    (keymap-bind ["L"] 'murstatus/cmd-mur-log)
    (keymap-bind ["V"] 'murstatus/cmd-mur-versions)
    (keymap-bind ["!"] 'murstatus/cmd-mur-run-command)
    ;; the forge's side (murforge)
    (keymap-bind ["o"] 'murforge/cmd-mur-browse)
    (keymap-bind ["O"] 'murforge/cmd-mur-open-changes)
    (keymap-bind ["C"] 'murforge/cmd-mur-checks)
    (keymap-bind ["D"] 'murforge/cmd-mur-discussion)
    (keymap-bind ["R"] 'murforge/cmd-mur-reviews)))

(def mur-status-mode-layer
  {:name 'mur-status
   :doc "The mur change you are on: c says what it is for, s saves, l lands, u updates; ? every verb."
   :keymap murstatus/mur-status-keymap
   ;; a hunk's code wraps and a heading keeps to one row ending in `…`, as in git's buffers
   ;; (the line kinds sectionbuf marks); a line of no kind wraps
   :long-lines :wrap
   ;; buffer-local M-x names: the ones that only mean something with a status under them
   :commands '("mur-refresh" "mur-visit"
                "mur-settle" "mur-restore" "mur-claim" "mur-diff")
   :section-faces 'murstatus/mur-status-faces
   :section-bands 'murstatus/mur-status-bands})

(register-type-layers :mur-status
  (list 'murstatus/mur-status-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; *mur-diff* / *mur-log* / *mur-output* / a forge read — plain text: q quits, $ the log, a
;; diff in one is coloured by its text
(def mur-text-keymap
  (-> {}
    (keymap-bind ["q"] 'vcsproc/cmd-vcs-quit)
    (keymap-bind ["$"] 'vcsproc/cmd-vcs-process)))

(def mur-text-mode-layer
  {:name 'mur-text
   :keymap murstatus/mur-text-keymap
   :commands '()
   :fontify 'vcsproc/vcs-diff-fontify})

(register-type-layers :mur-text
  (list 'murstatus/mur-text-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
