(defmodule pulse
  "A brief flash on the line point lands on after a JUMP (Emacs's pulsar): another window,
another buffer, or point moved `*jump-lines*` lines or more by one key command — which is
what `other-window`, recenter, imenu, xref, goto-line and a page scroll all do, the commands
pulsar pulses for. Typing never pulses (it moves a line at a time), and nor does the mouse:
a jump is a KEY command's, told apart by `:command-count`, which only a key command
advances.

A post-step row notices the jump and records `:pulse` — the buffer, the line and a `:level`
from 1 — and a timer row fades the level to nothing over `*pulse-ms*` while one is showing.
The view (`view/ed-pane-pulse`) lays a translucent band over the line at that level. On with
the init file's `:pulse` (the model's `:pulse-on`)."
  (:use editor/buffer) ; buffer-current-line
  (:use model) ; ed-current-buf / ed-current-pane / register-post-step / register-timer-client
  (:use theme)) ; the palette the pulse face is a formula over

(theme/defchrome face-pulse {:bg *blue*}) ; the flash (pulsar's `pulsar-generic`)

(def *pulse-ms* 400) ; how long the flash takes to fade
(def *pulse-tick-ms* 40) ; how often it steps while it fades
(def *jump-lines* 5) ; a move of this many lines or more in one command is a jump

(defn- where (m)
  ;; `[buffer-index line]` of the selected pane — what a jump changes
  [(:buffer (ed-current-pane m)) (buffer-current-line (ed-current-buf m))])

(defn- jumped? (before after)
  (or (not (= (first before) (first after)))
    (>= (math/abs (- (second after) (second before))) *jump-lines*)))

(defn note-jump (m)
  "The post-step row: when a key command ran since the last step (`:command-count` moved)
and it JUMPED (`jumped?`), start a pulse on the line point is on. Remembers where point is
either way, so the next command is measured from there — after a mouse click too. O(1), and
the model unchanged when nothing moved."
  (if (not (:pulse-on m))
    m
    (let (count (:command-count m)
          here (where m)
          seen (:pulse-seen m))
      (cond
        (= [count here] seen) m
        (and seen (not (= count (first seen))) (jumped? (second seen) here))
          (assoc m
            :pulse-seen [count here]
            :pulse {:buffer (first here) :line (second here) :level 1.0})
        else (assoc m :pulse-seen [count here])))))

(defn timer-spec (m)
  "The fade's timer while a pulse is showing, else none."
  (when (:pulse m) {:every *pulse-tick-ms*}))

(defn fade (m)
  "One step of the fade: the level down by a tick's share, the pulse gone at nothing."
  (let (pulse (:pulse m))
    (if (nil? pulse)
      m
      (let (level (- (:level pulse) (/ (* 1.0 *pulse-tick-ms*) *pulse-ms*)))
        (if (<= level 0.0) (dissoc m :pulse) (assoc m :pulse (assoc pulse :level level)))))))

(register-post-step :pulse {:order 90 :run 'pulse/note-jump})
(register-timer-client :pulse 'pulse/timer-spec 'pulse/fade)
