(defmodule savehist
  "Minibuffer history across sessions (Emacs's `savehist-mode`): what each prompt was
answered with, newest first, so `M-p` / `↑` at `Find file:` offers the files you named last
time too. Keyed by the prompt's text.

Off until `activate!` (`main` calls it when the init file's `:savehist` is on): before that
every prompt starts with no history and nothing is written, so a test — or a second editor
that never asked for it — neither reads nor clobbers the user's file. The answers live in
`*histories*` while the editor runs and are written through the shared persistence layer
(`projects/persist-write!`) on every answer."
  (:use projects)) ; editor-state-dir + persist-read-value / persist-write!

(def *history-max* 100) ; answers kept per prompt, newest first
(def *prompts-max* 200) ; prompts kept at all — a prompt whose text names a file is one of many

;; prompt text -> list of answers, newest first; nil until `activate!`
(def *histories* nil)

(defn history-key (prompt)
  "The key a prompt's history is kept under: its text without the part that changes from one
asking to the next — `Switch to buffer (default *scratch*): ` and `Switch to buffer: ` share
one history — and without trailing space.

    (savehist/history-key \"Switch to buffer (default a.txt): \")   ;=> \"Switch to buffer:\""
  (string/trim (regex/replace " *\\(default [^)]*\\)" prompt "")))

(defn secret-prompt? (prompt)
  "True when `prompt` asks for a credential — a password, passphrase, cookie, token or
secret — whose answer is never written to disk, whatever its prompt was marked."
  (regex/match? "pass(word|phrase)|cookie|token|secret|\\bpin\\b" (string/lower prompt)))

(defn histories-file ()
  "Where the histories are kept: `minibuffer-history.blsp` in the editor's state folder."
  (path/join (editor-state-dir) "minibuffer-history.blsp"))

(defn activate! (&optional (file nil))
  "Turn history keeping on: read the saved histories (from `file`, by default
`histories-file`) — a missing or unreadable file is no history yet."
  (let (saved (persist-read-value (or file (histories-file)) {}))
    (def *histories*
      (if (map? saved)
        (into {}
          (seq/filter (map saved
                        (fn ([prompt answers]) [prompt (seq/filter (seq answers) string?)]))
            (fn ([prompt _]) (string? prompt))))
        {}))
    nil))

(defn active? () "True once `activate!` has run." (map? *histories*))

(defn history-for (prompt)
  "The answers `prompt` was given, newest first — a list, the shape the minibuffer's line
editor recalls from (kept under its `history-key`). Empty while history keeping is off."
  (if (and (active?) (string? prompt))
    (apply list (get *histories* (history-key prompt) '()))
    '()))

(defn remember! (prompt answer &optional (file nil))
  "Record `answer` to `prompt` at the head of its history (a repeat of the newest is not
recorded twice; an older copy moves up), keep it under `*history-max*`, and write the
histories out (`prompt` kept under its `history-key`). A no-op while history keeping is off,
for a blank answer, and for a prompt asking for a credential (`secret-prompt?`)."
  (when (and (active?)
          (string? prompt)
          (string? answer)
          (not (string/blank? answer))
          (not (secret-prompt? prompt)))
    (let (prompt (history-key prompt)
          current (if (map? *histories*) *histories* {})
          kept (cons answer (seq/reject (get current prompt '()) (fn (old) (= old answer))))
          updated (assoc current prompt (apply list (take kept *history-max*)))
          ;; past the cap one other prompt goes (which one is the map's order — a map keeps
          ;; no recency, and a cap this size is only reached by prompts naming files)
          bounded (if (> (count updated) *prompts-max*)
                    (dissoc updated (seq/find (keys updated) (fn (key) (not (= key prompt)))))
                    updated))
      (def *histories* bounded)
      (persist-write! (or file (histories-file))
        (into {} (map bounded (fn ([key answers]) [key (vec answers)])))
        "minibuffer history (savehist) — safe to delete")))
  answer)
