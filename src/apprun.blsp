(defmodule apprun
  "Run the project from the editor (C-c r) — `nest run` in a dedicated subprocess,
with debug taps wrapped around it. A generated script boots the app exactly as
`nest run` does (`project/run-project`), after installing two image-wide taps:

  - `*spy-sink*` — every `(spy …)` / `trace-fn` entry anywhere in the app (any
    process: the root `def` is ambient) streams out as a JSON line;
  - a stats heartbeat — process count + total memory, every few seconds, so a leak
    or a spawn storm is visible as a trend while the app runs.

The `*Run*` buffer shows the app's own stdout/stderr as-is, spy traffic coloured
like `*Spy*`, dim `·` heartbeat lines, and an exit footer; error locations
(`file:line[:col]:`) are jumpable with RET. The editor side is the same shape as
testrun/compile: a `:apprun` process owns the proc handle, line-buffers stdout,
and forwards `UiEvent` records the loop folds."
  (:use model)  ; UiEvent + message / ed-append-named / ed-buf-at
  (:use interactive)  ; defcommand
  (:use commands)  ; ed-show-named-aside / ed-find-file / ed-apply / ed-goto-line
  (:use editor/keymap)  ; keymap-bind — the *Run* keys
  (:use editor/layers)  ; register-type-layers — the :run-log buffer type
  (:use json))  ; json-parse — decode the taps' event lines

(require 'debugger)  ; debugger-spy-tap-form — the shared spy tap the script splices in
(require 'procstream)  ; the shared streaming-subprocess worker (:apprun rides it)

(def *run-buffer* "*Run*")
(def *apprun-script-path* "/tmp/myedit-apprun.blsp")
(def *apprun-stats-ms* 5000)  ; the heartbeat period

;; ---- the async events (UiEvent records — see model.blsp) --------------------

(defrecord apprun-output-event (text gen))  ; one line of the app's own stdout/stderr
(defrecord apprun-spy-event (entry gen))  ; a spy/trace-fn entry: {:kind :form :value :fn :args :depth}
(defrecord apprun-stats-event (stats gen))  ; the heartbeat: {:procs :memory :uptime-ms}
(defrecord apprun-done-event (code gen))  ; the app exited

;; ---- the generated wrapper script ----------------------------------------------
;; Quoted forms, pr-str'd (the testrun pattern). The taps go in BEFORE run-project
;; boots the app, as root `def`s — ambient, so every process the app spawns streams
;; through them.

(def apprun--script-forms
  (list
    '(require 'project)
    '(require 'json)
    ;; every spy/trace-fn entry, anywhere in the app -> one JSON line — the shared
    ;; debugger tap
    debugger/debugger-spy-tap-form
    ;; the stats heartbeat: a tiny sibling process, hibernating between beats
    (list 'def 'apprun--stats-ms *apprun-stats-ms*)
    '(defn apprun--beat (started)
       (do
         (receive (after apprun--stats-ms nil))
         (let (infos (keep process-info (list-processes)))
           (println (json/json-encode
                      {:event "stats"
                       :procs (count infos)
                       :memory (fold (fn (acc p) (+ acc (or (get p :memory) 0))) 0 infos)
                       :uptime-ms (- (now) started)})))
         (apprun--beat started)))
    '(spawn (apprun--beat (now)))
    '(project/run-project '())))

(defn apprun--script-source ()
  (join "\n" (map pr-str apprun--script-forms)))

;; ---- the runner process ----------------------------------------------------------

(defn apprun--editor () (whereis :editor))

(defn apprun--decode-line (line)
  "Classify one stdout line — `[:spy m]` / `[:stats m]` / `[:output s]` / `[:drop]` —
salvaging a JSON line another process's unflushed `print` may have prefixed (the
testrun--decode-line shape; the shared decoder is a fold-up candidate)."
  (let (parsed (ed-json-event-line line)
        event (when parsed (get parsed :event)))
    (cond
      (= event "spy") [:spy parsed]
      (= event "stats") [:stats parsed]
      (= (trim line) "") [:drop]
      else [:output line])))

(defn apprun--dispatch-line (line gen)
  (let (kv (apprun--decode-line line))
    (case (first kv)
      :spy (send (apprun--editor) (apprun-spy-event (second kv) gen))
      :stats (send (apprun--editor) (apprun-stats-event (second kv) gen))
      :output (send (apprun--editor) (apprun-output-event (second kv) gen))
      nil)))

(defn apprun--handlers ()
  "The `procstream` handlers (each takes the run token): stdout decodes into
spy/stats/output events, stderr forwards as plain output, the exit becomes done."
  {:on-line apprun--dispatch-line
   :on-err-line (fn (line gen) (send (apprun--editor) (apprun-output-event line gen)))
   :on-done (fn (code gen) (send (apprun--editor) (apprun-done-event code gen)))})

;; ---- rendering + folds -------------------------------------------------------------

(defn apprun-bytes-human (n)
  (cond
    (>= n 1048576) (str (quot n 1048576) "." (quot (rem (quot n 1024) 1024) 102) " MB")
    (>= n 1024) (str (quot n 1024) " KB")
    else (str n " B")))

(defn apprun-stats-line (s)
  "The one-line stats rendering (the chip tooltip's first line)."
  (str (get s :procs) " procs · " (apprun-bytes-human (or (get s :memory) 0))
    " · up " (quot (or (get s :uptime-ms) 0) 1000) "s"))

(defn apprun--current? (m gen)
  "Whether `gen` is the running app's generation — a superseded run's straggler is
dropped."
  (= gen (get-in m [:apprun :gen])))

(impl UiEvent apprun-output-event
  (ui-event-fold [e m textrows cols rows]
    (if (apprun--current? m (apprun-output-event-gen e))
      (ed-append-named m *run-buffer* (str (apprun-output-event-text e) "\n"))
      m)))

(impl UiEvent apprun-spy-event
  (ui-event-fold [e m textrows cols rows]
    (if (apprun--current? m (apprun-spy-event-gen e))
      (ed-append-named m *run-buffer*
        (str "~ " (let (sp (apprun-spy-event-entry e))
                    (debugger/debugger-spy-body (get sp :kind) (get sp :form) (get sp :value)
                      (get sp :fn) (get sp :args)))
          "\n"))
      m)))

(impl UiEvent apprun-stats-event
  ;; model-only: the statusbar chip renders the stats live and its hover carries the
  ;; detail (current + peak) — *Run* stays the app's OWN output, never the taps'.
  ;; Peaks make a leak/spawn-storm visible even if you look after it settled.
  (ui-event-fold [e m textrows cols rows]
    (if (not (apprun--current? m (apprun-stats-event-gen e)))
      m
      (let (s (apprun-stats-event-stats e)
            peak (get-in m [:apprun :peak] {}))
        (update m :apprun assoc
          :stats s
          :peak {:procs (max (or (get s :procs) 0) (or (get peak :procs) 0))
                 :memory (max (or (get s :memory) 0) (or (get peak :memory) 0))})))))

(impl UiEvent apprun-done-event
  ;; drop :apprun so the statusbar chip disappears with the app. A stale-gen done
  ;; (an old run exiting just as a new one starts) must NOT clear the new run's chip.
  (ui-event-fold [e m textrows cols rows]
    (if (not (apprun--current? m (apprun-done-event-gen e)))
      m
      (let (code (apprun-done-event-code e))
        (message (ed-append-named (dissoc m :apprun) *run-buffer*
                   (str "\n[app exited " (if (nil? code) "killed" code) "]\n"))
          (str "app exited " (if (nil? code) "(killed)" code)))))))

;; ---- the commands -------------------------------------------------------------------

(defcommand cmd-run-project
  (m key)
  "Run the project's entry point (C-c r r): `nest run` in a dedicated subprocess with
the debug taps installed — app output, coloured spy/trace traffic and a stats
heartbeat stream into *Run*."
  (spit *apprun-script-path* (apprun--script-source))
  (let (root (or (:project-root m) (cwd))
        proc (spawn :apprun (procstream/procstream-loop (apprun--handlers)))
        gen (inc (or (get-in m [:apprun :gen]) 0)))
    (send proc [:run "nest" ["run" *apprun-script-path*] root gen])
    (ed-show-named-aside
      (message (assoc m :apprun {:root root :gen gen}) (str "running project in " root "…"))
      *run-buffer*
      (str "-*- run: " root " -*-\n\n")
      :run-log)))

(defcommand cmd-run-show
  (m key)
  "Switch to the *Run* buffer (the statusbar chip's click)."
  (ed-switch-to-named m *run-buffer*))

(defcommand cmd-run-stop
  (m key)
  "Stop the running app (C-c r k). Keys off the model's `:apprun` (a live run), not
the worker's mere existence — the worker idles alive between runs. `[:shutdown]`
fires the done event, so the chip clears and *Run* gets its footer."
  (if (nil? (:apprun m))
    (message m "nothing is running")
    (do (send (whereis :apprun) [:shutdown])
      m)))

;; ---- the :run-log buffer type ---------------------------------------------------

(def run-log-keymap
  ;; RET/click jump comes from the shared location-jump layer in the type stack
  (-> {}
    (keymap-bind ["k"] 'apprun/cmd-run-stop)))

(def run-face-spy {:fg *teal*})
(def run-face-error {:fg *red* :bold true})
(def run-face-header {:fg *subtext* :bold true})

(defn apprun--line-face (line)
  (cond
    (starts-with? line "~ ") run-face-spy
    (starts-with? line "-*-") run-face-header
    (starts-with? line "[app exited") run-face-header
    (or (includes? line "error") (not (nil? (loc-at-line line)))) run-face-error
    else nil))

(defn run-log-fontify (src)
  "The *Run* `:fontify`: role colour per line with `file:line` locations as
underlined links — the shared results styling (`modes/fontify-results`)."
  (modes/fontify-results src apprun--line-face))

(def run-log-mode-layer
  {:name 'run-log
   :keymap apprun/run-log-keymap
   :fontify 'apprun/run-log-fontify
   :commands '("run-stop")})

(register-type-layers :run-log
  (list 'apprun/run-log-mode-layer 'modes/location-jump-layer
    'modes/special-mode-layer 'modes/text-mode-layer))
