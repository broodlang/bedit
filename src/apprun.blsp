(defmodule apprun
  "Run the project from the editor (C-c r) — `nest run` in a dedicated subprocess,
with debug taps wrapped around it. A generated script boots the app exactly as
`nest run` does (`project-run/run`), after installing two image-wide taps:

  - `*spy-sink*` — every `(debug/spy …)` / `trace-fn` entry anywhere in the app (any
    process: the root `def` is ambient) streams out as a JSON line;
  - a stats heartbeat — process count · reductions · uptime, on the statusbar chip
    (not the buffer); a leak/spawn-storm shows as a trend (current + peak on hover).

A margin breakpoint on the edited project's code (which lives in THIS run's image,
not the editor's) is applied here: the run's `:run-breaks` are `trace-fn`'d after
the project loads, so each breakpointed call streams into *Run* like a spy entry.

The `*Run*` buffer shows the app's own stdout/stderr as-is, spy/trace traffic
coloured like `*Spy*`, and an exit footer; error locations are jumpable with RET.
The editor side is testrun/compile's shape: a `:apprun` process (via `procstream`)
owns the proc handle, line-buffers stdout, and forwards `UiEvent` records the loop
folds; the statusbar chip shows live telemetry."
  (:use statusbar :only []) ; its chip registers at load, after statusbar is there
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use model) ; UiEvent + message / ed-append-named / ed-buf-at
  (:use interactive) ; defcommand
  (:use pool) ; ed-show-named-aside / ed-find-file / ed-goto-line
  (:use results) ; ed-append-follow / loc-at-line — the results-buffer abstraction
  (:use editor/keymap)) ; keymap-bind — the *Run* keys
(def *run-buffer* "*Run*")
;; unguessable, per editor process — see sandbox.blsp on why a fixed /tmp name is
;; both a collision between two editors and a symlink hazard. `.blsp`, because in a
;; project `nest run` takes any other file for a DOCUMENT to open: the run launched the
;; project's own `:main` (a second editor, for bedit) instead of this script
(def *apprun-script-path* (str (path/temp "bedit-apprun-") ".blsp"))
(def *apprun-stats-ms* 2000) ; the heartbeat period (fast enough to feel live)
;; ---- the async events (UiEvent records — see model.blsp) --------------------

(defrecord apprun-output-event (text spans gen)) ; one line of the app's own stdout/stderr, ANSI-decoded, its colours as `spans`
(defrecord apprun-spy-event (entry gen)) ; a spy/trace-fn entry: {:kind :form :value :fn :args :depth}
(defrecord apprun-stats-event (stats gen)) ; the heartbeat: {:procs :memory :uptime-ms}
(defrecord apprun-done-event (code gen)) ; the app exited
;; ---- the generated wrapper script ----------------------------------------------
;; Quoted forms, pr-str'd (the testrun pattern). The taps go in BEFORE project-run/run
;; boots the app, as root `def`s — ambient, so every process the app spawns streams
;; through them.

(defn- apprun-run-forms (run-breaks)
  "The forms that RUN the project. With no run breakpoints it's just
`project-run/run`. With them, it replicates its flow but installs a
trace on each breakpointed symbol AFTER the project's sources are loaded (so the code
is bound) and BEFORE the entry runs. Crucially the startup image is built FIRST (see
below), so `project-run/run`'s own load is a no-op and does not wipe the traces. Each
traced call then streams into *Run* via the spy tap."
  (if (empty? run-breaks)
    (list '(project-run/run '()))
    ;; `require` only the module each breakpointed symbol lives in (derived from the
    ;; qualified name: `web/errors/error-node` -> module `web/errors`), then trace it.
    ;; `require` pulls each module's deps in declared order, so no "qualified reference
    ;; to unloaded module" warning flood — unlike force-loading every source file.
    (append
      (list '(project/load-config)
        '(let (root (project/find-root (file/cwd)))
           (when root
             (project/setup root)
             ;; Load the sources / build the startup image NOW, before the traces below:
             ;; `project-run/run` (the last form) reloads sources on a COLD run to build
             ;; the image (ADR-218), rebinding the project's fns to their clean source and
             ;; wiping a trace installed first. With the image built here, its cold check
             ;; skips that reload and the traces survive. A trace is a runtime-only
             ;; rebinding installed after this load, so it is never snapshotted.
             (when (nil? (project-image/setup-lazy-image root))
               (project-image/load-sources-cached root)))))
      (map run-breaks
        (fn (sym)
          (let (parts (string/split (str sym) "/")
                module (symbol (string/join (take parts (dec (count parts))) "/")))
            `(do
               (check-allow :discarded-catch (try (require-one (quote ~module)) (catch error nil)))
               (when (bound? (quote ~sym)) (debug/trace-fn (quote ~sym)))))))
      (list '(project-run/run '())))))

(defn- apprun-script-forms (run-breaks)
  (append
    (list
      ;; every spy/trace-fn entry, anywhere in the app -> one JSON line — the shared
      ;; debugger tap
      debugger/debugger-spy-tap-form
      ;; the stats heartbeat: a tiny sibling process, hibernating between beats
      (list 'def 'apprun-stats-ms *apprun-stats-ms*)
      '(defn- apprun-emit-stats (started)
         (let (infos (seq/keep (proc/list) proc/info))
           (io/puts
             (json/encode
               {:event "stats"
                :procs (count infos)
                ;; reductions (work done) is the reliable live signal; :memory
                ;; only updates at a process's last receive, so it reads 0 for a
                ;; process that hasn't received yet
                :reductions (fold infos 0 (fn (acc p) (+ acc (or (get p :reductions) 0))))
                :memory (fold infos 0 (fn (acc p) (+ acc (or (get p :memory) 0))))
                :uptime-ms (- (os/now) started)}))))
      '(defn- apprun-beat (started)
         (do
           ;; emit at once, then every interval: telemetry shows even for an app that
           ;; exits before the first interval
           (apprun-emit-stats started)
           (receive (after apprun-stats-ms nil))
           (apprun-beat started)))
      '(spawn (apprun-beat (os/now))))
    (apprun-run-forms run-breaks)))

(defn- apprun-script-source (run-breaks)
  (string/join (map (apprun-script-forms run-breaks) pr-str) "\n"))

;; ---- the runner process ----------------------------------------------------------

(defn- apprun-decode-line (line)
  "Classify one stdout line — `[:spy m]` / `[:stats m]` / `[:output s]` / `[:drop]` —
salvaging a JSON line another process's unflushed `print` may have prefixed
(`model/ed-json-event-line`, as `testadapter/brood-decode-line` does)."
  (let (parsed (ed-json-event-line line)
        event (when parsed (get parsed :event)))
    (cond
      (= event "spy") [:spy parsed]
      (= event "stats") [:stats parsed]
      (= (string/trim line) "") [:drop]
      else [:output line])))

(defn- apprun-dispatch-line (line spans generation)
  ;; the event a decoded stdout line becomes, or nil for one to drop
  (let ([kind value] (apprun-decode-line line))
    (case kind
      :spy (apprun-spy-event value generation)
      :stats (apprun-stats-event value generation)
      :output (apprun-output-event value spans generation)
      nil)))

(defn- apprun-handlers ()
  "The `procstream` handlers (each builds the event for a line and the run token; the
worker delivers it to the loop that started the run): stdout decodes into
spy/stats/output events, stderr forwards as plain output, the exit becomes done. A line
arrives ANSI-decoded (procstream), its colours beside it as `spans`, which *Run* paints."
  {:on-line apprun-dispatch-line
   :on-err-line apprun-output-event
   :on-done apprun-done-event})

;; ---- rendering + folds -------------------------------------------------------------

(defn- apprun-current? (m generation)
  "Whether `generation` is the running app's generation — a superseded run's straggler is
dropped."
  (= generation (map/get-in m [:apprun :gen])))

(impl UiEvent
  apprun-output-event
  (ui-event-fold (event m textrows columns rows)
    (if (apprun-current? m (apprun-output-event-gen event))
      (ed-append-follow m
        *run-buffer*
        (str (apprun-output-event-text event) "\n")
        columns
        rows
        (apprun-output-event-spans event))
      m)))

(impl UiEvent
  apprun-spy-event
  (ui-event-fold (event m textrows columns rows)
    (if (apprun-current? m (apprun-spy-event-gen event))
      (ed-append-follow m
        *run-buffer*
        (str "~ "
          (let (entry (apprun-spy-event-entry event))
            (debugger/debugger-spy-body (get entry :kind)
              (get entry :form)
              (get entry :value)
              (get entry :fn)
              (get entry :args)))
          "\n")
        columns
        rows)
      m)))

(impl UiEvent
  apprun-stats-event
  ;; model-only: the statusbar chip renders the stats live and its hover carries the
  ;; detail (current + peak) — *Run* stays the app's OWN output, never the taps'.
  ;; Peaks make a leak/spawn-storm visible even if you look after it settled.
  (ui-event-fold (event m textrows columns rows)
    (if (not (apprun-current? m (apprun-stats-event-gen event)))
      m
      (let (stats (apprun-stats-event-stats event)
            peak (map/get-in m [:apprun :peak] {})
            higher (fn (key) (math/max (or (get stats key) 0) (or (get peak key) 0))))
        (update m
          :apprun assoc
          :stats stats
          :peak {:procs (higher :procs) :memory (higher :memory) :reductions (higher :reductions)})))))

(impl UiEvent
  apprun-done-event
  ;; drop :apprun so the statusbar chip disappears with the app. A stale-gen done
  ;; (an old run exiting just as a new one starts) must NOT clear the new run's chip.
  (ui-event-fold (event m textrows columns rows)
    (if (not (apprun-current? m (apprun-done-event-gen event)))
      m
      (let (code (apprun-done-event-code event))
        (message (ed-append-follow (dissoc m :apprun)
                   *run-buffer*
                   (str "\n[app exited " (if (nil? code) "killed" code) "]\n")
                   columns
                   rows)
          (str "app exited " (if (nil? code) "(killed)" code)))))))

;; ---- the commands -------------------------------------------------------------------

(defcommand cmd-run-project
  (m key)
  "Run the project's entry point (C-c r r).

In a Brood project this is `nest run` in a dedicated subprocess with the debug taps
installed — app output, coloured spy/trace traffic and a stats heartbeat stream into
*Run*. Those taps are Brood seams with no equivalent elsewhere, so another toolchain
runs its own command (`mix run`, `cargo run`, `npm start`) in *compilation*, where
the error patterns still make `C-x \`` work over anything it prints. The command
comes from `toolchain/*toolchains*`, so a project that starts some other way — a
Phoenix app wanting `mix phx.server` — is one edit there rather than a branch here."
  (if (not (toolchain/brood? m))
    (let (cmd (toolchain/run-command m))
      (if (nil? cmd)
        (message m (str "no run command for a " (toolchain/name-of m) " project"))
        (compile/compile-run m cmd)))
    (apprun-start-native m)))

(defn- apprun-start-native (m)
  ;; C-c r in a Brood project: the generated script under `nest run`, streamed into *Run*
  (let (run-breaks (or (:run-breaks m) '()))
    (file/spit *apprun-script-path* (apprun-script-source run-breaks))
    (let (root (or (:project-root m) (file/cwd))
          proc (spawn :apprun (procstream/procstream-loop (apprun-handlers)))
          generation (inc (or (map/get-in m [:apprun :gen]) 0)))
      (send proc
        [:run "nest" ["run" *apprun-script-path*] {:cwd root} generation (ed-loop-address)])
      (ed-show-named-aside (message (assoc m :apprun {:root root :gen generation})
                             (str "running project in "
                               root
                               "…"
                               (if (empty? run-breaks)
                                 ""
                                 (str " (" (count run-breaks) " breakpoint(s) traced)"))))
        *run-buffer*
        (str "-*- run: " root " -*-\n\n")
        :run-log))))

(defcommand cmd-run-show
  (m key)
  "Switch to the *Run* buffer (the statusbar chip's click)."
  (ed-switch-to-named m *run-buffer*))

(defcommand cmd-run-stop
  (m key)
  "Stop the running app (C-c r k). Keys off the model's `:apprun` (a live run), not
the worker's mere existence — the worker idles alive between runs. `[:shutdown]`
fires the done event, so the chip clears and *Run* gets its footer."
  (if (nil? (:apprun m))
    (message m "nothing is running")
    (do
      (send :apprun [:shutdown])
      m)))

(defn apprun-live (m)
  "The app C-x C-c would kill (`model/register-exit-query`): `:apprun` is a live run, dropped
when its exit folds in."
  (if-let (run (:apprun m)) [(str *run-buffer* ": the app in " (path/basename (:root run)))] []))

(register-exit-query :apprun 'apprun/apprun-live)

;; ---- the :run-log buffer type ---------------------------------------------------

(def run-log-keymap
  ;; RET/click jump comes from the shared location-jump layer in the type stack
  (-> {}
    (keymap-bind ["k"] 'apprun/cmd-run-stop)))

(theme/defchrome run-face-spy {:fg *teal*})
(theme/defchrome run-face-error {:fg *red* :bold true})
(theme/defchrome run-face-header {:fg *subtext* :bold true})

(defn- apprun-line-face (line)
  (cond
    (string/starts-with? line "~ ") run-face-spy
    (string/starts-with? line "-*-") run-face-header
    (string/starts-with? line "[app exited") run-face-header
    (or (includes? line "error") (not (nil? (loc-at-line line)))) run-face-error
    else nil))

(defn run-log-fontify (src)
  "The *Run* `:fontify`: teal spy traffic, red error locations (role colour per
line). Clickability is the pointer/hover the view draws from `:line-loc`."
  (modes/fontify-line-faces src apprun-line-face))

(def run-log-mode-layer
  {:name 'run-log
   :writable :toggle
   :keymap apprun/run-log-keymap
   :fontify 'apprun/run-log-fontify
   :commands (modes/layer-commands apprun/run-log-keymap)})

(modes/register-special-type :run-log 'apprun/run-log-mode-layer 'results/location-jump-layer)

;; ---- the mode-line chip ------------------------------------------------------

(defn- apprun-label (m)
  "The app-run telemetry chip: `▶ 18p · 2.1M reds · 12s` while a C-c r app runs (procs ·
reductions · uptime, live per heartbeat), `▶ running` before the first reading, `\"\"`
when no app is running (`:apprun` is dropped on exit). Click opens *Run*."
  (if (nil? (:apprun m))
    ""
    (let (stats (map/get-in m [:apprun :stats]))
      (if (nil? stats)
        "▶ running"
        (str "▶ "
          (:procs stats)
          "p · "
          (ed-reds-human (or (:reductions stats) 0))
          " reds"
          " · "
          (math/quot (or (:uptime-ms stats) 0) 1000)
          "s")))))

(defn apprun-segment (m pane buffer)
  "The live app-run chip (C-c r): procs + reductions, refreshed by the heartbeat; click opens
*Run*. Present only while an app runs (`:apprun` is dropped on exit)."
  (statusbar/seg :apprun
    (apprun-label m)
    {:sep "  —  "
     :face {:fg *teal*}
     :on-click 'apprun/cmd-run-show
     :tooltip (fn (mm)
                (let (stats (map/get-in mm [:apprun :stats])
                      peak (map/get-in mm [:apprun :peak]))
                  [(str "app running · "
                     (:procs stats)
                     " procs · "
                     (ed-reds-human (or (:reductions stats) 0))
                     " reductions · up "
                     (math/quot (or (:uptime-ms stats) 0) 1000)
                     "s")
                    (str "memory " (humanize/byte-size (or (:memory stats) 0)) " (at last receive)")
                    (str "peak "
                      (or (:procs peak) 0)
                      " procs · "
                      (ed-reds-human (or (:reductions peak) 0))
                      " reds")
                    "click for *Run*"]))}))

(statusbar/register-modeline-segment :apprun 50 'apprun/apprun-segment)

(defn ed-reds-human (n)
  "A reduction count short (`1.2M` / `194k` / `42`) — the app-run telemetry's work
metric."
  (cond
    (>= n 1000000) (str (math/quot n 1000000) "." (math/quot (math/rem n 1000000) 100000) "M")
    (>= n 1000) (str (math/quot n 1000) "k")
    else (str n)))
