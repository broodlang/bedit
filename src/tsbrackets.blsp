(defmodule tsbrackets
  "Bracket matching (show-paren) for a tree-sitter language — the `:bracket-match` service
every `deflanguage` mode gets, and `:bracket-match-tree`, its form over the buffer's held tree.

brood-mode matches brackets with its reader (`editor/highlight/bracket-match`), which reads
no other language. Matching characters would be wrong where it matters
most — a `(` in a string, a `}` in a comment, bash's `case` arm `1)`, which opens nothing —
so a bracket here is a DELIMITER TOKEN of the parse: an anonymous leaf (`(`, `{`, `$(`,
`%{`, `[[`) that ends with an opener or begins with a closer. Its partner is the matching
token under the same parent node, which is how every grammar writes a delimited
construct: the `arguments` node is `( … )`, the `block` node `{ … }`.

Nearly every pair is the parent's first and last token, which two chain queries confirm
(`%tree-sitter-tree-chain`, O(depth)) whatever the size of what lies between. A pair in the
middle of its parent — HCL's `resource \"x\" \"y\" { … }`, bash's `name() { … }` — is found by
walking the parent's children, anonymous tokens included (`node-children` with `all?`), each
candidate confirmed by its chain — no length limit, as the walk reads no text between them.
A token whose partner is missing is `:unmatched`
only when the parse holds an error; in a tree without one, a lone `)` is the grammar's own
use of the character (a `case` arm) and matches nothing.

A match is `[opener closer]` (the offsets to paint, the opener's first), `[at :unmatched]`,
or nil away from a bracket — `editor/highlight/bracket-match`'s shape, so the view paints
either alike.")

(def- closer-of {"(" ")" "[" "]" "{" "}"})
(def- opener-of {")" "(" "]" "[" "}" "{"})

(defn or-nil (thunk)
  "`(thunk)`, or nil when it raises — how a tree-sitter call says a language has no loaded
grammar (or a tree handle is gone). Shared with `syntaxtree`'s tree API; here because this
module stands on nothing, and `syntaxtree` stands on the model, which reaches this one."
  ;; the error IS the answer: a language without a loaded grammar has no parse
  (check-allow :discarded-catch
    (try (thunk) (catch _ nil))))

(defn- same-node? (a b)
  (and (= (:kind a) (:kind b)) (= (:start a) (:start b)) (= (:end a) (:end b))))

(defn- delimiter-in (chain)
  "The delimiter a chain ends at: `[leaf parent]`, where `parent` is the node the leaf
delimits — above any wrapper node of the leaf's own extent (HCL's `block_start` around its
`{`) — or nil when the chain does not end at an anonymous leaf with a parent."
  (let (leaf (last chain))
    (when (and leaf (not (:named leaf)) (not (:container leaf)))
      (letrec (outermost (fn (i)
                           (let (above (when (> i 0) (nth chain (dec i))))
                             (if (and above
                                   (= (:start above) (:start leaf))
                                   (= (:end above) (:end leaf)))
                               (outermost (dec i))
                               i))))
        (let (top (outermost (dec (count chain))))
          (when (> top 0) [leaf (nth chain (dec top))]))))))

(defn- reader-text (reader from to) ((:slice reader) from to))

(defn- token-at (reader offset)
  "The delimiter whose bracket character sits at `offset`: `{:at :char :leaf :parent :open?}`,
or nil when the character there is not a bracket or not a delimiter token."
  (when (and (>= offset 0) (< offset (:length reader)))
    (let (character (reader-text reader offset (inc offset)))
      (when (or (contains? closer-of character) (contains? opener-of character))
        (let (found (delimiter-in ((:chain reader) offset)))
          (when found
            (let ([leaf parent] found
                  text (reader-text reader (:start leaf) (:end leaf))
                  open? (contains? closer-of character))
              ;; an opener ends its token (`$(`), a closer begins its own (`))`)
              (when (if open? (= offset (dec (:end leaf))) (= offset (:start leaf)))
                {:at offset :char character :leaf leaf :parent parent :open? open? :text text}))))))))

(defn- partner? (reader token candidate-offset)
  "Whether `candidate-offset` holds the bracket that pairs with `token`: the matching character
on a delimiter token of the same parent."
  (let (found (token-at reader candidate-offset))
    (and found
      (not (= (:open? found) (:open? token)))
      (= (:char found)
        (if (:open? token) (get closer-of (:char token)) (get opener-of (:char token))))
      (same-node? (:parent found) (:parent token)))))

(defn- edge-partner (reader token)
  "The partner when it is the parent's last token (for an opener) or first (for a closer):
the shape nearly every delimited node has. Nil otherwise."
  (let (parent (:parent token))
    (if (:open? token)
      (let (found (delimiter-in ((:chain reader) (dec (:end parent)))))
        (when found
          (let (at (:start (first found)))
            (when (partner? reader token at) at))))
      (let (found (delimiter-in ((:chain reader) (:start parent))))
        (when found
          (let (at (dec (:end (first found))))
            (when (partner? reader token at) at)))))))

(defn- bracket-at? (reader offset character)
  (and (>= offset 0)
    (< offset (:length reader))
    (= (reader-text reader offset (inc offset)) character)))

(defn- scan-partner (reader token)
  "The partner found among the parent's own children — its anonymous tokens included — walking
away from `token` and counting nested pairs of the same bracket; nil when there is none. One
child list is read, so a pair far apart in one parent (a long HCL block, a long bash
function) costs its sibling count, never the text between."
  (let (parent (:parent token)
        open? (:open? token)
        leaf (:leaf token)
        ;; a probe the parent strictly contains, and no container child of it does: just
        ;; past an opener, or at a closer's start
        children (or ((:kids reader) (if open? (:end leaf) (:start leaf))) [])
        ;; the token's own child: the leaf itself, or the one-char wrapper `delimiter-in`
        ;; lifts (HCL's `block_start` around its `{`)
        at (seq/index-where children
             (fn (child) (and (= (:start child) (:start leaf)) (= (:end child) (:end leaf)))))
        ahead (cond
                (< at 0) []
                open? (drop children (inc at))
                else (reverse (take children at)))
        same (:char token)
        other (if open? (get closer-of same) (get opener-of same))
        ;; one child: `[:halt offset]` at the partner, else `[:cont depth]`. An opener ends
        ;; its token (`$(`) and a closer begins its own (`))`); a container longer than a
        ;; character (`body`) is never a delimiter
        step (fn (depth child)
               (let (closer-at (:start child)
                     opener-at (dec (:end child))
                     other-at (if open? closer-at opener-at)
                     same-at (if open? opener-at closer-at))
                 (cond
                   (and (:container child) (> (- (:end child) (:start child)) 1)) [:cont depth]
                   (and (bracket-at? reader other-at other) (partner? reader token other-at))
                     (if (= depth 0) [:halt other-at] [:cont (dec depth)])
                   (and (bracket-at? reader same-at same)
                     (let (found (token-at reader same-at))
                       (and found (same-node? (:parent found) parent))))
                     [:cont (inc depth)]
                   else [:cont depth]))))
    (letrec (walk (fn (children depth)
                    (if (empty? children)
                      nil
                      (let ([verdict value] (step depth (first children)))
                        (if (= verdict :halt) value (walk (rest children) value))))))
      (walk ahead 0))))

(defn- adjacent-token (reader pos)
  "The delimiter show-paren matches at cursor `pos`, in Emacs's order (std's
`editor/highlight/bracket-match` keeps the same one): point just OUTSIDE a pair first — a
closer just left of the cursor, else an opener under it — then just inside one — an opener
just left, else a closer under it. So the cursor on the inner `(` of `((x) y)` lights the
inner pair."
  (let (before (token-at reader (dec pos))
        after (token-at reader pos))
    (cond
      (and before (not (:open? before))) before
      (and after (:open? after)) after
      else (or before after))))

(defn- match-with (reader pos)
  (let (token (adjacent-token reader pos))
    (when token
      (let (partner (or (edge-partner reader token) (scan-partner reader token)))
        (cond
          (not (nil? partner)) (if (:open? token) [(:at token) partner] [partner (:at token)])
          ;; no partner: a broken parse is missing one; an intact one used the character
          ;; alone, as bash's `case` arm does
          (:broken (first ((:chain reader) (:at token)))) [(:at token) :unmatched]
          else nil)))))

(defn match-text (text lang pos)
  "The bracket pair at `pos` in the string `text` parsed as tree-sitter language `lang` —
the `:bracket-match` service's body, over the window of text the view hands it: `[opener
closer]`, `[at :unmatched]`, or nil (also when `lang` has no grammar loaded).

    (tsbrackets/match-text \"f(\\\")\\\")\" :python 1)   ;~> [1 6] — with the :python grammar installed"
  (or-nil (fn ()
            (match-with {:chain (fn (offset) (%tree-sitter-chain text lang offset))
                         :kids (fn (offset) (%tree-sitter-kids text lang offset true))
                         :slice (fn (from to) (string/substring text from to))
                         :length (string/length text)}
              pos))))

(defn match-tree (tree rope pos)
  "`match-text` over a held tree (`syntaxtree`) of exactly `rope`, with `pos` in the whole
document: no parse, and only the characters it inspects are read from the rope — the
`:bracket-match-tree` service. Nil for a gone handle."
  (or-nil (fn ()
            (match-with {:chain (fn (offset) (or (%tree-sitter-tree-chain tree offset) []))
                         :kids (fn (offset) (%tree-sitter-tree-kids tree offset true))
                         :slice (fn (from to) (text/slice rope from to))
                         :length (count rope)}
              pos))))
