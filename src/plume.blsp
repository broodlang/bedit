(defmodule plume
  "**Plume** — the editor's minibuffer completion UI. One layer where Emacs needs three
packages: it's *Vertico* (the vertical candidate list), *Marginalia* (the per-row
annotations — a file's permission/size/mtime 'plumage') and the *N/M* counter, all owned
here and built on the shared primitives in `completion` (ranking + the floating card the
in-buffer `complete` popup also uses). The prompt drives it by declaring a `:category`
(`:file`, `:buffer`, `:command`, …) on its minibuffer; `view` renders the list with this
module's annotations + counter.

**The override seam (ricing, like the rest of the editor).** Annotators are kept in
`*plume-annotators*` as **quoted symbols** resolved with `eval` at render time (late
binding — the keymap pattern), so redefining a single annotator (`(defn plume/plume-file-
annotation …)`) or swapping a registry entry re-skins a *running* editor on its next
frame. Faces are `theme/face-plume-*`; the column formatters are plain `defn`s. Redefine
any of them live with `C-x C-e`. No package soup, no per-package config — one named layer."
  (:use completion)) ; the shared ranking / window helpers / `perms-string` Plume builds on
;; ---- look (redefine to rice Plume) ------------------------------------------
;; The candidate list itself now renders through the shared `ui-list` widget
;; (src/ui-kit.blsp) via `view/ed-mb-candidates-ops`, styled by the ui-ctx palette
;; (theme roles) — so Plume's row/selection/marginalia colours are the same semantic
;; roles as the completion popup and the context menu. This layer keeps the ranking,
;; the marginalia annotators + column formatters, and the N/M counter.

(def *plume-inset* 2) ; columns of margin each side of the inset candidate list (the pill floats inside)
;; ---- the annotator registry (the override seam) -----------------------------

(def *plume-annotators*
  ;; completion category -> a `(value mb) -> annotation-string|nil` fn, as a quoted symbol.
  ;; Add/replace an entry (or redefine the named fn) live to change a category's marginalia.
  {:file 'plume/plume-file-annotation})

(defn plume-annotation (mb value)
  "The marginalia annotation for candidate `value` in minibuffer `mb` (keyed by its
`:category` through `*plume-annotators*`), or nil when the category has no annotator or
the annotator declines. `mb` is threaded through so an annotator can read prompt context
(e.g. `:anno-base`, the directory a relative candidate is resolved against)."
  (let (sym (get *plume-annotators* (:category mb)))
    (when sym ((eval sym) value mb))))

;; ---- the :file annotator's column formatters --------------------------------

(defn plume-hsize (n div suffix)
  "Round `n/div` to one decimal — or a bare integer at ≥ 10 units — with `suffix`
(`1456/1024` → `1.4k`, `12·1024` → `12k`). Pure integer math, no float formatting."
  (let (tenths (quot (+ (* n 10) (quot div 2)) div))
    (if (>= tenths 100)
      (str (quot tenths 10) suffix)
      (str (quot tenths 10) "." (rem tenths 10) suffix))))

(defn plume-human-size (n)
  "A short human-readable byte count (`ls -h` style, lowercase units): bytes under 1k,
else k/m/g to one decimal (`1456` → `1.4k`); `?` when unknown."
  (cond
    (nil? n) "?"
    (< n 1024) (str n)
    (< n 1048576) (plume-hsize n 1024 "k")
    (< n 1073741824) (plume-hsize n 1048576 "m")
    :else (plume-hsize n 1073741824 "g")))

(defn plume-reltime (ms now-ms)
  "A short relative time — `1h 41m ago` / `27m 11s ago` / `3d ago` — from epoch-ms `ms`
to `now-ms`; `\"\"` when `ms` is nil."
  (if (nil? ms)
    ""
    (let (s (quot (max 0 (- now-ms ms)) 1000))
      (cond
        (< s 60) (str s "s ago")
        (< s 3600) (str (quot s 60) "m " (rem s 60) "s ago")
        (< s 86400) (str (quot s 3600) "h " (quot (rem s 3600) 60) "m ago")
        (< s 2592000) (str (quot s 86400) "d ago")
        :else (str (quot s 2592000) "mo ago")))))

(defn plume-file-annotation (value mb)
  "The `:file` category annotator: `<perms>  <size>  <relative-mtime>` for candidate
`value`, via one `file-stat` (the perms column shared with dired through
`completion/perms-string`). `value` is resolved to a path against the prompt's
`:anno-base` (a relative candidate's directory) when it isn't absolute; a trailing `/`
(a directory marker) is dropped. `\"\"` when the file is gone. Redefine this (or swap the
`:file` entry of `*plume-annotators*`) to change the columns — the marginalia seam."
  (let (raw (if (string/ends-with? value "/")
              (string/substring value 0 (dec (string/length value)))
              value)
        base (:anno-base mb)
        path (cond
               (string/starts-with? raw "/") raw
               (nil? base) raw
               :else (str base "/" raw))
        st (file/stat path))
    (if (nil? st)
      ""
      (str (perms-string st)
        "  "
        (string/pad-left (plume-human-size (:size st)) 6)
        "  "
        (plume-reltime (:mtime st) (os/now))))))

;; ---- the annotated row renderer + the counter -------------------------------

(defn plume-annot-width (annots)
  "The marginalia column width: the widest annotation, clamped to [0, 40] (0 ⇒ no column)."
  (min 40 (fold (fn (w s) (max w (string/length s))) 0 annots)))

(defn plume-clip (s w)
  "Clip `s` to width `w`, keeping the **tail** behind a leading `…` (a long path keeps its
filename, not just the directory prefix). Unchanged when it already fits. Public: the
view's `ui-list` row builder clips candidate labels through it."
  (if (> (string/length s) w)
    (str "…" (string/substring s (- (+ (string/length s) 1) w) (string/length s)))
    s))

(defn plume-count-label (sel total)
  "The `N/M` candidate counter for the prompt line (1-based `sel`); `\"\"` when there are no
candidates."
  (if (= total 0) "" (str (inc sel) "/" total " ")))
