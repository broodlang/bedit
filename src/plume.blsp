(defmodule plume
  "**Plume** — the editor's minibuffer completion UI. One layer where Emacs needs three
packages: it's *Vertico* (the vertical candidate list), *Marginalia* (the per-row
annotations — a file's permission/size/mtime 'plumage') and the *N/M* counter, all owned
here and built on the shared primitives in `completion` (ranking + the floating card the
in-buffer completion popup also uses). The prompt drives it by declaring a `:category`
(`:file`, `:buffer`, `:command`, …) on its minibuffer; `echoarea` renders the list with this
module's annotations + counter.

**The override seam (ricing, like the rest of the editor).** Annotators are kept in
`*plume-annotators*` as **quoted symbols** resolved with `reflect/eval` at render time (late
binding — the keymap pattern), so redefining a single annotator (`(defn plume/plume-file-
annotation …)`) or swapping a registry entry re-skins a *running* editor on its next
frame. Its rows are styled by the ui-kit roles (`theme/ui-ctx`); the column formatters are plain `defn`s. Redefine
any of them live with `C-x C-e`. No package soup, no per-package config — one named layer."
  (:use fileperm)) ; `perms-string` — the `:file` marginalia's permission column
;; ---- look (redefine to rice Plume) ------------------------------------------
;; The candidate list renders through the shared `ui-list` widget
;; (src/ui-kit.blsp) via `echoarea/ed-mb-candidates-ops`, styled by the ui-ctx palette
;; (theme roles) — so Plume's row/selection/marginalia colours are the same semantic
;; roles as the completion popup and the context menu. This layer keeps the ranking,
;; the marginalia annotators + column formatters, and the N/M counter.

;; columns of margin each side of the candidate list: none, so it lines up with the prompt (Vertico)
(def *plume-inset* (ui-kit/ui-space-cells :flush))
;; ---- the annotator registry (the override seam) -----------------------------

(def *plume-annotators*
  ;; completion category -> a `(value mb) -> annotation` fn, as a quoted symbol: the annotation
  ;; is a vector of FIELDS (columns, `plume-columns`), a string (one field), or nil.
  ;; Add/replace an entry (or redefine the named fn) live to change a category's marginalia.
  {:file 'plume/plume-file-annotation
   :command 'plume/plume-command-annotation})

(defn plume-annotation (mb value)
  "The marginalia annotation for candidate `value` in minibuffer `mb` (keyed by its
`:category` through `*plume-annotators*`), or nil when the category has no annotator or
the annotator declines. `mb` is threaded through so an annotator can read prompt context
(e.g. `:anno-base`, the directory a relative candidate is resolved against)."
  (let (sym (get *plume-annotators* (:category mb)))
    (when sym ((reflect/eval sym) value mb))))

;; ---- the :file annotator's column formatters --------------------------------

(defn plume-human-size (n)
  "A short human-readable byte count for the size column — `humanize/byte-size-short`
(`ls -h` spelling: `1456` → `1.4k`), plus this column's own answer for a size nobody
knows: `?` rather than a number, since the annotator runs on whatever `file/stat`
returned."
  (if (nil? n) "?" (humanize/byte-size-short n)))

(sig plume-reltime ((or nil int) int -> string))
(defn plume-reltime (ms now-ms)
  "A short relative time — `1h 41m ago` / `27m 11s ago` / `3d ago` — from epoch-ms `ms`
to `now-ms`; `\"\"` when `ms` is nil."
  (if (nil? ms)
    ""
    (let (s (math/quot (math/max 0 (- now-ms ms)) 1000))
      (cond
        (< s 60) (str s "s ago")
        (< s 3600) (str (math/quot s 60) "m " (math/rem s 60) "s ago")
        (< s 86400) (str (math/quot s 3600) "h " (math/quot (math/rem s 3600) 60) "m ago")
        (< s 2592000) (str (math/quot s 86400) "d ago")
        else (str (math/quot s 2592000) "mo ago")))))

(defn plume-file-annotation (value mb)
  "The `:file` category annotator: `[perms size relative-mtime]` for candidate
`value`, via one `file-stat` (the perms column shared with dired through
`fileperm/perms-string`). `value` is resolved to a file by the prompt's `:path-of` when it
has one (a path prompt's `~/…` and `$$` spelling), else against its `:anno-base` (a
relative candidate's directory) when it isn't absolute; a trailing `/`
(a directory marker) is dropped. Three fields; none when the file is gone. Redefine this (or swap the
`:file` entry of `*plume-annotators*`) to change the columns — the marginalia seam."
  (let (raw (if (string/ends-with? value "/")
              (string/substring value 0 (dec (string/length value)))
              value)
        base (:anno-base mb)
        ;; a path prompt says which file its candidate names (`~`, `$$`); else relative to the base
        path (cond
               (:path-of mb) ((:path-of mb) raw)
               (or (nil? base) (path/absolute? raw)) raw
               else (str base "/" raw))
        st (file/stat path))
    (if (nil? st)
      []
      [(perms-string st)
        (string/pad-left (plume-human-size (:size st)) 6)
        (plume-reltime (:mtime st) (os/now))])))

;; ---- the :command annotator: key · contract · doc ----------------------------

(defn- plume-contract-label (sym)
  "A command's declared CONTRACT, compact: `(model any -> model)` shown as `model any → model`
— the `sig` `defcommand` declares, read back as written (`reflect/declared-signature`), so
a command whose author narrowed or widened it shows that. Nil when nothing is declared
(a deferred command whose module has not loaded, or a plain `defn`)."
  (let (s (check-allow :discarded-catch (try (reflect/declared-signature sym) (catch _ nil))))
    (if (nil? s)
      nil
      (let (inner (if (and (string/starts-with? s "(") (string/ends-with? s ")"))
                    (string/substring s 1 (dec (string/length s)))
                    s))
        (string/replace inner "->" "→")))))

(def *command-contract* "model any → model") ; what every `defcommand` declares

(defn plume-command-annotation (value mb)
  "The `:command` category annotator (M-x): `[key contract doc]` for command name `value` —
the key the live keymap binds it to (`:anno-keymap` on the prompt), its declared contract
([[plume-contract-label]]) and the first line of its docstring, each blank when there is
none. The contract shows only when it is not `*command-contract*`: every `defcommand`
declares that one, so on every row it said nothing, and the one row that differs — a
command redefined live to claim something else (`C-x C-e` on a `defcommand` re-checks the
body and says so in *Messages*) — is the one worth seeing."
  ;; `:anno-keys` is the prompt's precomputed `{command-tail -> key-sequence}`
  ;; (`keyhelp/ed-key-table`) — a map lookup. Asking the keymap per row instead walked the
  ;; whole thing twice per row per frame: 48 ms a keystroke in `M-x`, for fifteen rows.
  ;; `:anno-keymap` remains the fallback for a prompt that did not build a table.
  (let (sym (interactive/command-sym value)
        km (:anno-keymap mb)
        table (:anno-keys mb)
        key (cond
              (nil? sym) nil
              table
                (let (seq (get table (keyhelp/ed-command-tail sym)))
                  (when seq (keyhelp/ed-keys-label seq)))
              (nil? km) nil
              else (keyhelp/ed-where-is-named km sym))
        contract (if (nil? sym) nil (plume-contract-label sym))
        doc (if (nil? sym) nil (keyhelp/ed-doc sym)))
    (if (nil? sym)
      []
      [(or key "")
        (if (or (nil? contract) (= contract *command-contract*)) "" contract)
        (if (nil? doc) "" (keyhelp/ed-first-line doc))])))

;; ---- the annotated row renderer + the counter -------------------------------

(sig plume-annot-room (int -> int))
(defn plume-annot-room (cols)
  "The most cells the marginalia may take in a `cols`-wide list: 40, or half the window when
that is wider — a command's (key, contract, doc) wants the room, and a wide window has it,
while the candidate label always keeps at least half."
  (math/max 40 (math/quot cols 2)))

(defn- annotation-fields (annotation)
  ;; an annotator's answer as its fields: a vector as it is, a string one field, nil none
  (cond
    (vector? annotation) annotation
    (string? annotation) [annotation]
    else []))

(sig fit-cells (string int -> string))
(defn- fit-cells (s width)
  ;; `s` cut to `width` display cells, its last kept cell an ellipsis, then padded to `width`
  (string/pad-right-cells (if (> (string/display-width s) width)
                            (str (string/clip-cells s (if (> width 0) (dec width) 0)) "…")
                            s)
    width))

(sig room-for-last (int int -> int))
(defn- room-for-last (widest room)
  ;; the last column's width: its widest field, within `room`, never negative
  (math/max 0 (math/min widest room)))

(sig plume-columns (any int -> any))
(defn plume-columns (annotations room)
  "The marginalia of a list's rows laid out as COLUMNS, as Marginalia lays them: each
annotation a vector of fields (a string is one, nil none), every field padded to the widest
of its column across `annotations`, two spaces between, and the LAST column (a docstring, a
date) cut with `…` to what is left of `room` display cells. A column no row fills is
dropped. Every row comes back the same width, so a right-aligned key slot starts them all at
one column; each is `\"\"` when no row has a field.

    (plume/plume-columns [[\"C-x l\" \"Toggle\"] [\"\" \"Pick a theme\"]] 40)   ;=> (\"C-x l  Toggle      \" \"       Pick a theme\")"
  (let (rows (map annotations annotation-fields)
        widths (vec (map (range (fold rows 0 (fn (n row) (math/max n (count row)))))
                      (fn (index)
                        (fold rows
                          0
                          (fn (w row) (math/max w (string/display-width (nth row index ""))))))))
        columns (seq/filter (range (count widths)) (fn (index) (> (nth widths index 0) 0))))
    (if (empty? columns)
      (map rows (fn (_) ""))
      (let (lead (take columns (dec (count columns)))
            final (last columns)
            final-width (room-for-last (nth widths final 0)
                          (- room (fold lead 0 (fn (w index) (+ w (nth widths index 0) 2))))))
        (map rows
          (fn (row)
            (str (string/join (map lead
                                (fn (index)
                                  (str (fit-cells (nth row index "") (nth widths index 0)) "  ")))
                   "")
              (fit-cells (nth row final "") final-width))))))))

(sig plume-clip (string int -> string))
(defn plume-clip (s w)
  "Clip `s` to width `w`, keeping the **tail** behind a leading `…` (a long path keeps its
filename, not just the directory prefix). Unchanged when it already fits. Public: the
view's `ui-list` row builder clips candidate labels through it."
  (if (> (string/length s) w)
    (str "…" (string/substring s (- (+ (string/length s) 1) w) (string/length s)))
    s))

(defn plume-marks (query value label &optional (options nil))
  "Where `query` matched `value`, as `[index term]` pairs into `label` — the text the row
SHOWS for it, which a prompt's `:label-fn` may have cut down (find-file shows a path's
basename): `fuzzy/match` scores the whole value, and each term's positions are moved onto
the label, the ones outside it dropped. `[]` when the query does not match, has no terms, or
the label is not part of the value. `options` are the prompt's ranking options
(`minibuffer/mb-rank-options`): a path prompt's `:category :file` puts the match on the file name,
as the ranking did. An excluding `!` term marks nothing; a literal one marks its run.

    (plume/plume-marks \"ex lim\" \"lib/limits.ex\" \"limits.ex\")   ;=> [[7 0] [8 0] [0 1] [1 1] [2 1]]"
  (let (found (if (string? value) (fuzzy/match value query options) nil)
        offset (cond
                 (not (string? label)) -1
                 (= label value) 0
                 (string/ends-with? value label) (- (string/length value) (string/length label))
                 else (index-of value label))
        size (if (string? label) (string/length label) 0))
    (if (or (nil? found) (< offset 0))
      []
      (fold (seq/enumerate (:terms found))
        []
        (fn (acc [term positions])
          (fold positions
            acc
            (fn (marks position)
              (let (index (- position offset))
                (if (and (>= index 0) (< index size)) (conj marks [index term]) marks)))))))))

(defn plume-clip-marks (s w marks)
  "`marks` (`[index term]` into `s`) as they fall in `(plume-clip s w)` — shifted past the
cut and the leading `…`, the ones the cut removed dropped. Unchanged when `s` already fits.

    (plume/plume-clip-marks \"lib/limits.ex\" 6 [[0 1] [11 0]])   ;=> [[4 0]]"
  (let (size (string/length s))
    (if (<= size w)
      marks
      (let (cut (- (+ size 1) w))
        (fold marks
          []
          (fn (acc [index term]) (if (>= index cut) (conj acc [(inc (- index cut)) term]) acc)))))))

(defn plume-count-label (sel total)
  "The `N/M` candidate counter for the prompt line (1-based `sel`); `*/M` while the prompt
itself is selected (`sel` -1), as Vertico shows it; `\"\"` when there are no candidates."
  (cond
    (= total 0) ""
    (< sel 0) (str "*/" total " ")
    else (str (inc sel) "/" total " ")))
