(defmodule popups
  "The `:popup` panel style: floating cards over the text, for those who want them back
(`:panel-style :popup` in the init file). Completion's candidates are Corfu's card at the
completion (`complete-card`), a hover's help a tooltip card by the hovered cell. It draws those
two kinds; a key panel — a transient menu, which-key, the context menu — stays in the echo area,
drawn by the editor's own `:echo` style (`panel`). Also the shape a package copies to register a
style of its own."
  (:use panel :only [register-panel-style panel-kind])
  (:use panes :only [ed-card-stage]) ; what a floating card covers
  (:use theme) ; the tooltip faces
  (:use ui-kit :only [ui-tooltip-area]) ; where a tooltip goes, the one floating-card rule
  (:use editor/display :only [tooltip]))

(defn tooltip-card-ops (anchor-row anchor-col lines stage columns rows gui?)
  "A tooltip card of `lines` for cell `(anchor-row, anchor-col)`, placed by the one
floating-card rule (`ui-kit/ui-tooltip-area`: above the anchor, else below it, `:card-gap`
off the chrome around `stage`) and drawn by `display/tooltip` — handed the anchor just
under the placed rect, which its own on-screen clamp then leaves where it is."
  (let ([column row _ height] (ui-tooltip-area anchor-row anchor-col lines stage columns rows))
    (tooltip (+ row height)
      column
      lines
      face-tooltip
      face-tooltip-fg
      columns
      rows
      gui?
      {:border face-tooltip-border})))

(defn popup-rows (_panel _columns _rows)
  "The rows of the echo area the `:popup` style takes: none, its cards float over the text."
  0)

(defn popup-paint (panel m columns rows)
  "The `:popup` style's drawing of `panel`: the completion card for a `:list`, as `{:ops
:zones}`; a tooltip card about the hovered cell for a `:text`, kept off the chrome of the pane
it is in."
  (case (panel-kind panel)
    :list (complete-card/complete-popup-widget m columns rows)
    :text
      (let ([row column] (:anchor panel))
        (vec (or (tooltip-card-ops row
                   column
                   (:lines panel)
                   (ed-card-stage m columns rows (or (:stage-cell panel) [row column]))
                   columns
                   rows
                   (:gui m))
               [])))
    []))

(register-panel-style :popup
  {:kinds #{:list :text} :rows 'popups/popup-rows :paint 'popups/popup-paint})
