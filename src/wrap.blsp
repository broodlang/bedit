;; wrap.blsp — visual lines: where a buffer line breaks into screen rows.
;;
;; `visual-line-mode` (Emacs): a long line is shown on as many rows as it needs, broken at
;; word boundaries, instead of scrolling sideways. Everything that maps a screen row to a
;; buffer position — the view painting a row, the cursor's row, a click, the scroll clamp
;; — has to agree on WHERE the breaks fall, so the break rule lives here, once, as a pure
;; function of the line's text and the width, and the row↔line owner (`panes`) and the
;; scroll (`model`) both ask it. Measured in display cells (`string/display-width`, so a
;; tab or a wide glyph counts what it paints), with tab stops the LINE's (ADR-342).
;;
;;
;; A segment is `[from to]` — char offsets into the line, `to` exclusive, the newline
;; never included — and a line is a vector of them: one when it fits, `[[0 0]]` when empty.
;; A line that is not wrapped (truncated or scrolled — see "long lines" below) is ONE
;; segment over the whole line with a clip beside it, `[0 len [cut ellipsis]]`.
;;
;; ---- what a row costs: the window, never the line ------------------------------------
;; A minified file or a log can hold a line of a megabyte, and every keystroke asks for its
;; rows several times over (the row table, the scroll clamp, the cursor's row). So nothing
;; here reads a whole line to lay out one row:
;;
;;   - a row is decided from a WINDOW of the line, the chars from its start on, a little more
;;     than two rows' worth — sliced from the rope where the line lives, never the line as a
;;     string. Where the row ends depends on those chars and on its start column (a tab spans
;;     to the line's stop), nothing else: whether the rest of the line fits is whether the
;;     row's measure reaches the line's end.
;;   - one row of a truncated or scrolled line is the same window, cut.
;;   - a WRAPPED long line's rows are kept (`*line-layouts*`, below) and an edit inside it
;;     lays out again only from just above the edit to where the new rows fall back into
;;     step with the old ones.
(defmodule wrap
  "Where a buffer line falls on screen rows: wrapped into `[from to]` segments at most `w`
cells wide (`visual-line-mode`, breaking after the last space that fits, else mid-word), or
kept to ONE row cut at the pane's edge — with an ellipsis (`truncate-lines`) or without (a
line that scrolls sideways). Per line (`line-policy`). The one place the rows are decided,
so the view, the cursor, the mouse and the scroll agree."
  (:use editor/buffer) ; buffer-rope — a line's text for `line-segments`
  (:use memo)) ; defmemo — the row table is asked for over and over while nothing changes

;; A LINE SOURCE is `[text start length]`: the line is `length` chars of `text` (a rope or a
;; string — `text/slice` reads either) from char `start`, its newline not counted.
(def- *window-slack* 16) ; chars a row's window holds past two rows' worth of cells

(sig source-piece ((tuple any int int) int int -> string))
(defn- source-piece (source from to)
  ;; chars `[from, to)` of the line `source` holds
  (let ([text start _] source) (text/slice text (+ start from) (+ start to))))

(sig break-in ((tuple any int int) int int int int -> int))
(defn- break-in (source from col w span)
  "The char offset (in the line) where the row starting at `from` (display column `col`)
ends, read from a window of `span` chars from `from`: at the last place Unicode lets a
line break (UAX #14, brood's `string/break-opportunities`: after a space or a hyphen, between two
CJK characters, never before closing punctuation) among the chars that fit in `w` cells, else at
the last char that fits (a word longer than the row breaks mid-word), at least one char on (a glyph wider than the row still advances), and the line's
length when the rest of it fits. A window whose every char fits stops short of the line only
when it holds zero-width chars; it is widened and asked again."
  (let (len (nth source 2)
        end (math/min len (+ from span))
        window (source-piece source from end)
        hard (string/width->index window w col))
    (cond
      (and (>= hard (- end from)) (< end len)) (break-in source from col w (* 2 span))
      (>= (+ from hard) len) len
      else
        (let (hard (if (<= hard 0) 1 hard)
              ;; the last break the cut allows — a space stays on the row, the next starts clean
              allowed (seq/take-while (string/break-opportunities window)
                        (fn (at) (<= at hard))))
          (+ from (if (empty? allowed) hard (last allowed)))))))

(sig break-at ((tuple any int int) int int int -> int))
(defn- break-at (source from col w)
  ;; `break-in` over a window of two rows' worth of cells and some slack
  (break-in source from col w (+ (* 2 w) *window-slack*)))

;; A layout is `[segs cols tab-row]`: the row segments, the display column each row starts
;; on, and the index of the last row holding a tab (-1: none) — the one thing that makes a
;; row's break depend on where it starts (`relayout-step`).
;;
;; A line's DECOR is what its rows show besides its chars, which the breaks must leave room
;; for: `{:prefix :inline}` — the cells of blank a continuation row starts with (the wrap
;; prefix) and the inline annotations, `[[column width …] …]` ascending — or nil.

(sig decor-prefix (any -> int))
(defn- decor-prefix (decor)
  ;; the continuation rows' prefix in `decor`, 0 for none
  (let (prefix (get decor :prefix)) (if (int? prefix) prefix 0)))

(sig inline-cells (any int int int -> int))
(defn- inline-cells (inline from to len)
  "The cells the `inline` annotations take on a row of chars `[from, to)` of a `len`-char
line: those anchored in it, and on the line's last row those at its end."
  (fold (or inline [])
    0
    (fn (acc annotation)
      (let (column (first annotation)
            width (second annotation))
        (if (and (int? column)
              (int? width)
              (>= column from)
              (or (< column to) (and (= to len) (= column len))))
          (+ acc width)
          acc)))))

(sig row-break ((tuple any int int) int int int any bool -> int))
(defn- row-break (source from col w decor first?)
  "Where the row of `source` starting at char `from` (column `col`) ends at width `w`: the
line's first row has the whole width, a continuation row the width less the decor's prefix,
and a row with inline annotations on it less their cells. Laid out once without them and,
when some fall on the row, once more in the room they leave — the second row may hold fewer
of them, so it can come out a little short, never too long."
  (let (room (if first? w (math/max 1 (- w (decor-prefix decor))))
        to (break-at source from col room)
        inline (get decor :inline))
    (if (empty? inline)
      to
      (let (taken (inline-cells inline from to (nth source 2)))
        (if (= taken 0) to (break-at source from col (math/max 1 (- room taken))))))))

(sig layout-step
  ((tuple any int int) int int int any vector vector int -> (tuple vector vector int)))
(defn- layout-step (source from col w decor segs cols tab-row)
  "Tail-recursive: the layout of `source` from char `from` (display column `col`) on, its
rows conj'ed onto `segs`, their columns onto `cols`, `tab-row` the last so far with a tab."
  (if (>= from (nth source 2))
    [segs cols tab-row]
    (let (to (row-break source from col w decor (empty? segs))
          piece (source-piece source from to))
      (layout-step source
        to
        (+ col (string/display-width piece col))
        w
        decor
        (conj segs [from to])
        (conj cols col)
        (if (includes? piece "\t") (count segs) tab-row)))))

(sig layout ((tuple any int int) int &optional any -> (tuple vector vector int)))
(defn- layout (source w &optional (decor nil))
  "The layout of the whole line `source` holds at width `w` (`[segs cols tab-row]`), its rows
leaving room for `decor`. `[[0 len]]` its one row when `w` is 0 (no width, no wrapping),
`[[0 0]]` for an empty line."
  (if (or (<= w 0) (= (nth source 2) 0))
    [[[0 (nth source 2)]] [0] -1]
    (layout-step source 0 0 w decor [] [] -1)))

(defn segments (text w)
  "The `[from to]` row segments of `text` (one line, no newline) at most `w` cells wide:
`[[0 len]]` when it fits (or `w` is 0 — no width, no wrapping), `[[0 0]]` for an empty line.
A row is what `break-at` says.

    (wrap/segments \"the quick brown fox\" 10)   ;=> [[0 10] [10 19]]"
  (first (layout [text 0 (string/length text)] w)))

;; ---- a line's text: the ONE place a line's newline is dropped --------------------------

(sig strip-newline (string -> string))
(defn strip-newline (text)
  "`text` without a single trailing newline — a line as `text/line` / `buffer-line-at` read
it, its `\\n` dropped."
  (if (string/ends-with? text "\n") (string/substring text 0 (dec (string/length text))) text))

(sig rope-line-text (any int -> string))
(defn rope-line-text (rope line)
  "Line `line` of `rope` without its newline — one line read in place, for a walk over a
few lines of a large document that must not flatten the whole of it."
  (strip-newline (text/line rope line)))

(sig rope-line-or-empty (any int -> string))
(defn rope-line-or-empty (rope line)
  "Line `line` (0-based) of `rope`, its trailing newline KEPT; `\"\"` for a line that isn't
there — a line named by something that may be stale (a language server, a note's anchor)."
  (if (and (>= line 0) (< line (text/line-count rope))) (text/line rope line) ""))

(sig line-text (buffer int -> string))
(defn line-text (buf line)
  "Buffer line `line`'s text without its newline — the text its segments index into."
  (rope-line-text (buffer-rope buf) line))

;; ---- long lines: wrap, truncate or scroll, per line ---------------------------------
;; A line too long for its pane is shown one of three ways (`scroll/ed-long-lines` decides
;; which, per buffer and per line):
;;
;;   :wrap      on as many rows as it needs, broken after words (`segments` above)
;;   :truncate  on ONE row, cut where the pane ends with an ellipsis in its last cells —
;;              Emacs's `truncate-lines` with the fringe's `$` made visible text
;;   :scroll    on ONE row, cut at the pane's edge with no mark — the line scrolls sideways
;;
;; A one-row line is a segment that still covers the whole line, `[0 len]`, so everything
;; that asks which row a column is on (`row-of`, the cursor, C-n) reads it as the line's
;; only row. What the row SHOWS rides beside it as a CLIP, `[cut ellipsis]`: the chars
;; `[from, cut)` are painted and `ellipsis` after them in the row's last cells (`""` for a
;; scrolled line, whose edge simply clips). A row whose text fits carries no clip.
;;
;; The row table carries the clip as a row's fifth field (`[line from to nil clip]`), which
;; only the painter and a click read. Which lines are which comes in with the rest of the
;; row extras, under `:long-lines` (`scroll/ed-long-lines-spec`):
;; `{:policy :kinds :kind-policies :ellipsis}` — the policy of a line with no kind, a vector
;; of each line's KIND (a section heading, a section body — `:line-kinds` on the buffer)
;; and the policy each kind takes. Data, not a function, so the memoised table below keys
;; on it like any other input — cut to the lines the table can reach (`:kinds-from`, the
;; line its first entry is; `kinds-window`), since a memo's key is a deep copy compared
;; element by element and a 150,000-line buffer's kinds are 150,000 entries.

(sig line-policy (map (or nil int) -> keyword))
(defn line-policy (extras line)
  "How line `line` shows when it is too long for its row — `:wrap`, `:truncate` or
`:scroll` — by the `:long-lines` spec in the row `extras`: the policy its kind takes when it
has one, else the spec's own (scrolling for one that names none). A nil `line` asks for the
spec's own, the policy of a line with no kind. `:wrap` with no spec, the rule the row table
was first built for.

    (wrap/line-policy {:long-lines {:policy :scroll :kinds [:heading] :kind-policies {:heading :truncate}}} 0)   ;=> :truncate
    (wrap/line-policy {:long-lines {:policy :scroll :kinds [:heading] :kind-policies {:heading :truncate}}} 1)   ;=> :scroll"
  (let (spec (get extras :long-lines))
    (if (nil? spec)
      :wrap (let (kinds (:kinds spec)
            at (when (int? line) (- line (or (:kinds-from spec) 0)))
            kind (when (and (vector? kinds) (int? at) (>= at 0)) (nth kinds at nil))
            policy (or (when kind (get (or (:kind-policies spec) {}) kind)) (:policy spec)))
        ;; the setting and the facets are data: a value that is not a policy reads as scrolling
        (if (keyword? policy) policy :scroll)))))

(sig source-one-row-in ((tuple any int int) int string int -> vector))
(defn- source-one-row-in (source w ellipsis span)
  "`one-row` of the line `source` holds from its start, read from a window of `span` chars:
widened when every char of it fits and the line goes on (zero-width chars)."
  (let (len (nth source 2)
        end (math/min len span)
        window (source-piece source 0 end)
        ;; the char at cell `w` — the window's end when all of it fits
        fits (string/width->index window w))
    (cond
      (<= w 0) [0 len]
      (and (>= fits end) (< end len)) (source-one-row-in source w ellipsis (* 2 span))
      (>= fits len) [0 len]
      else
        (let (ellipsis-cells (string/display-width ellipsis)
              room? (> w ellipsis-cells)
              avail (if room? (- w ellipsis-cells) w))
          [0 len [(string/width->index window avail) (if room? ellipsis "")]]))))

(sig source-one-row ((tuple any int int) int string -> vector))
(defn- source-one-row (source w ellipsis)
  ;; `source-one-row-in` over a window of two rows' worth of cells and some slack
  (source-one-row-in source w ellipsis (+ (* 2 w) *window-slack*)))

(sig one-row (string int int string -> vector))
(defn one-row (text from-cell w ellipsis)
  "The ONE row `text` shows from display cell `from-cell` on in a `w`-cell row:
`[from len]` when the rest fits, else `[from len [cut ellipsis]]` — the chars `[from, cut)`
fit in the cells the `ellipsis` leaves, and it is painted after them. The cut never splits
a glyph (a wide one that would straddle it is left for the next scroll), and a row too
narrow to hold the ellipsis and a character keeps the cells for text and shows none.

From the line's start it reads a window of the line, not the line (`source-one-row`); from
a later cell (point's line scrolled sideways, `follow-point`) it measures up to that cell.

    (wrap/one-row \"abcdefgh\" 0 5 \"…\")   ;=> [0 8 [4 \"…\"]]
    (wrap/one-row \"abcdefgh\" 4 5 \"…\")   ;=> [4 8]
    (wrap/one-row \"ab日本cd\" 0 4 \"…\")   ;=> [0 6 [2 \"…\"]]"
  (if (<= from-cell 0)
    (source-one-row [text 0 (string/length text)] w ellipsis)
    (let (len (string/length text)
          from (string/width->index text from-cell)
          from-col (if (= from 0) 0 (string/display-width (string/substring text 0 from)))
          window (string/substring text from len))
      (if (or (<= w 0) (>= (string/width->index window w from-col) (- len from)))
        [from len]
        (let (ellipsis-cells (string/display-width ellipsis)
              room? (> w ellipsis-cells)
              avail (if room? (- w ellipsis-cells) w)
              cut (+ from (string/width->index window avail from-col)))
          [from len [(if (< cut from) from cut) (if room? ellipsis "")]])))))

;; The mark beside a wrapped row that its line continues past (Emacs's right fringe arrow,
;; painted in the pane's scrollbar column), and the one in the gutter of the rows that
;; continue it (the left fringe's).
(def continuation-mark "↩")
(def continued-mark "↪")

;; ---- a wrapped long line's rows, kept across edits -----------------------------------
;; Laying a wrapped line out costs a window per row, so a megabyte line is thousands of
;; windows — fine once, not once per keystroke. A line of `*layout-min-chars*` or more keeps
;; its layout in `*line-layouts*` (the last few, newest first): `[segs cols tab-row]`, each row's
;; segment, the display column it starts on and the last row with a tab, beside the rope and
;; where the line sat in it.
;;
;; Asked again with a NEW rope, an entry is checked against it by `text/changed-range` (where
;; the two texts differ, native) rather than thrown away:
;;
;;   - the edit was elsewhere (after the line, or before it with the line merely moved) —
;;     the rows stand as they were;
;;   - the edit was inside the line — the rows are laid out again from TWO rows above the
;;     row it touched (a row's break looks no further than its window, and the row two above
;;     an edit ends before the edit's row begins — so everything above that is untouched, with
;;     a row to spare), and only until a new row starts where an old one did, shifted by what
;;     the edit added, at a column the same distance from a tab stop (or with no tab after
;;     it, the one glyph whose width depends on its column): from there the text is
;;     the old text and the rows are the old rows, shifted. Typing in the middle of a
;;     megabyte line lays out two or three rows.
;;
;; Correct against a full layout by construction, and tested that way (wrap_test's "kept
;; layout" cases). Process-wide like `defmemo`'s store: a race between two processes costs a
;; layout, never a wrong one, since every entry is checked against the text it is asked for.
(def- *layout-min-chars* 4096) ; a line this long keeps its layout; a shorter one is cheap to redo
(def- *layout-capacity* 4)
(defn- layout-tab-width ()
  "The tab stops the layout below is measured by: `*tab-width*` (brood ADR-537), which
[[rows-from]] binds to the buffer's own (`conventions/tab-width`). A kept layout's key is the
whole cell layout (`conventions/cell-layout-key`: the tab width AND how glyphless characters
show), so a buffer laid out under another of either is laid out again."
  *tab-width*)
(def *line-layouts* '()) ; `{:rope :start :length :w :cell-layout :layout}`, newest first

(sig segment-index (vector int -> int))
(defn- segment-index (segs at)
  ;; the last row of `segs` whose start is at or before char `at` (0 when none is), by halving
  (letrec (go (fn (low high)
                (if (>= low high)
                  low
                  (let (middle (math/quot (+ low high 1) 2))
                    (if (<= (first (nth segs middle)) at) (go middle high) (go low (dec middle)))))))
    (go 0 (dec (count segs)))))

(sig relayout-step
  ((tuple any int int) int
    int
    int
    int
    int
    int
    (tuple vector vector int)
    vector
    vector
    int
    ->
    (tuple vector vector int)))
(defn- relayout-step (source from col w prefix edit-end delta old segs cols tab-row)
  "Tail-recursive: the layout of `source` with the rows from `from` (column `col`) on laid
out onto `segs` / `cols` / `tab-row` — until a row starts at or past `edit-end` exactly where
an `old` row did (shifted by `delta`), and from there the old rows, shifted. The old rows
are those rows only when the text after is measured the same: the new start column is the
old one plus a whole number of tab stops, or no old row from there on holds a tab (a tab is
the one glyph whose width depends on its column)."
  (if (>= from (nth source 2))
    [segs cols tab-row]
    (let ([old-segs old-cols old-tab-row] old
          j (when (>= from edit-end)
              (let (k (segment-index old-segs (- from delta)))
                (when (= (first (nth old-segs k)) (- from delta)) k)))
          moved (when (int? j) (- col (nth old-cols j))))
      (if (and (int? j)
            (int? moved)
            (or (= (math/mod moved (layout-tab-width)) 0) (< old-tab-row j)))
        [(into segs
           (map (seq/subvec old-segs j (count old-segs))
             (fn ([from to]) [(+ from delta) (+ to delta)])))
          (into cols (map (seq/subvec old-cols j (count old-cols)) (fn (c) (+ c moved))))
          (if (< old-tab-row j) tab-row (+ (- old-tab-row j) (count segs)))]
        (let (to (row-break source from col w {:prefix prefix} (empty? segs))
              piece (source-piece source from to))
          (relayout-step source
            to
            (+ col (string/display-width piece col))
            w
            prefix
            edit-end
            delta
            old
            (conj segs [from to])
            (conj cols col)
            (if (includes? piece "\t") (count segs) tab-row)))))))

(defn- relayout (source old at edit-end delta w prefix)
  "The layout of the line `source` holds, from its `old` one and an edit that replaced the
line's chars from `at` with ones ending at `edit-end` (`delta` more chars), its continuation
rows `prefix` cells narrower."
  (let ([old-segs old-cols old-tab-row] old
        r (math/max 0 (- (segment-index old-segs at) 2))
        ;; the rows kept above `r` may hold a tab; which is the last of them is not kept, so
        ;; the row just above stands for it — at worst a resync later is passed up
        [segs cols tab-row] (relayout-step source
                              (first (nth old-segs r))
                              (nth old-cols r)
                              w
                              prefix
                              edit-end
                              delta
                              [old-segs old-cols old-tab-row]
                              (seq/subvec old-segs 0 r)
                              (seq/subvec old-cols 0 r)
                              (math/min old-tab-row (dec r))))
    (if (empty? segs) [[[0 0]] [0] -1] [segs cols tab-row])))

(defn- layout-from-entry (entry rope start len w prefix)
  "The layout of the line `[start, start + len)` of `rope` at width `w` (its continuation rows
`prefix` cells narrower) from a kept `entry` — its own when the line is untouched, laid out
again from the edit when the edit is inside it — or nil when the entry is of another line,
another width or prefix, or an edit it cannot follow."
  (let (old (:rope entry)
        old-start (:start entry)
        old-len (:length entry)
        same? (and (= old-start start) (= old-len len)))
    (cond
      (not (and (= (:w entry) w)
             (= (:prefix entry) prefix)
             (= (:cell-layout entry) (conventions/cell-layout-key))))
        nil
      (= old rope) (when same? (:layout entry))
      else
        (let (change (text/changed-range old rope)
              [changed old-end new-end] (or change [0 0 0]))
          (if (or (nil? change)
                (not (and (int? changed)
                       (int? old-end)
                       (int? new-end)
                       (int? old-start)
                       (int? old-len))))
            (when same? (:layout entry))
            (let (delta (- new-end old-end))
              (cond
                ;; after the line's newline: the line is as it was
                (> changed (+ old-start old-len)) (when same? (:layout entry))
                ;; before the newline above it: the line only moved
                (< old-end old-start)
                  (when (and (= start (+ old-start delta)) (= len old-len)) (:layout entry))
                ;; inside it
                (and (>= changed old-start)
                  (<= old-end (+ old-start old-len))
                  (= start old-start)
                  (= len (+ old-len delta)))
                  (let (at (- changed old-start)
                        edit-end (- new-end old-start))
                    ;; ints by construction; the guard is what tells the checker so
                    (when (and (int? at) (int? edit-end) (int? delta))
                      (relayout [rope start len] (:layout entry) at edit-end delta w prefix)))
                else nil)))))))

(sig kept-layout ((tuple any int int) int int -> any))
(defn- kept-layout (source w prefix)
  "`layout` of the long line `source` holds (a rope's), its continuation rows `prefix` cells
narrower, from `*line-layouts*` when an entry there can answer (`layout-from-entry`), else
laid out whole — and kept either way."
  (let ([rope start len] source
        exact (seq/find *line-layouts*
                (fn (entry)
                  (and (= (:w entry) w)
                    (= (:prefix entry) prefix)
                    (= (:cell-layout entry) (conventions/cell-layout-key))
                    (= (:start entry) start)
                    (= (:length entry) len)
                    (= (:rope entry) rope)))))
    (if exact
      (:layout exact)
      (let (found (reduce *line-layouts*
                    nil
                    (fn (acc entry)
                      (if (nil? acc) (layout-from-entry entry rope start len w prefix) acc)))
            result (or found (layout source w {:prefix prefix})))
        (def *line-layouts*
          (take (cons {:rope rope
                       :start start
                       :length len
                       :w w
                       :prefix prefix
                       :cell-layout (conventions/cell-layout-key)
                       :layout result}
                  *line-layouts*)
            *layout-capacity*))
        result))))

(sig rope-line-source (any int -> (tuple any int int)))
(defn- rope-line-source (rope line)
  "Line `line` of `rope` as a line source, `[rope start length]` — its newline not counted,
none of its text read."
  (let (lines (text/line-count rope))
    (if (>= line lines)
      [rope (count rope) 0]
      (let (start (text/line->char rope line)
            next (if (< (inc line) lines) (text/line->char rope (inc line)) (count rope))
            newline? (and (> next start) (= (text/slice rope (dec next) next) "\n")))
        [rope start (- next start (if newline? 1 0))]))))

;; ---- the wrap prefix: a continuation row starts under its line's text -----------------
;; Emacs's `wrap-prefix` (adaptive-wrap, visual-line-mode's indent): a wrapped line's second
;; and later rows start not at the edge but under where its first row's text starts, so an
;; indented line or a list item stays visibly one block. The style is per mode
;; (`scroll/ed-wrap-prefix-spec`): `:indent` — under the line's leading whitespace, for code;
;; `:adaptive` — under its fill prefix (`string/fill-prefixes`: a list item hangs under its
;; text, a quote or a comment under its marker), for prose. Measured in cells from the line's
;; first window (never the whole line), and dropped when it would take more than half the
;; row: a line indented that deep wraps from the edge, as adaptive-wrap clamps it.

(sig line-prefix ((tuple any int int) int any any -> int))
(defn- line-prefix (source w style markers)
  "The cells of blank a continuation row of the line `source` holds starts with, at width
`w` under wrap-prefix `style` (`:indent` / `:adaptive`; anything else none) — 0 when it
would take more than half the row."
  (let (window (source-piece source 0 (math/min (nth source 2) (+ w *window-slack*)))
        cells (case style
                :indent
                  (string/display-width (string/substring window
                                          0
                                          (- (string/length window)
                                            (string/length (string/trim-left window)))))
                :adaptive (string/display-width (second (string/fill-prefixes window markers)))
                0))
    (if (> (* 2 cells) w) 0 cells)))

(sig segment-display (int int int any -> (or nil map)))
(defn- segment-display (k from to decor)
  "What row `k` (chars `[from, to)`) of a line with `decor` shows besides its chars —
`{:prefix :inline}`, only what it has — or nil: a continuation row's prefix, and the inline
annotations anchored on the row ([[inline-cells]]'s rule)."
  (let (prefix (if (> k 0) (decor-prefix decor) 0)
        len (get decor :length)
        inline (into []
                 (seq/filter (or (get decor :inline) [])
                   (fn (annotation)
                     (let (column (first annotation))
                       (and (int? column)
                         (>= column from)
                         (or (< column to) (and (= to len) (= column len))))))))
        with-prefix (if (> prefix 0) {:prefix prefix} nil))
    (if (empty? inline) with-prefix (assoc (or with-prefix {}) :inline inline))))

(defn- decorate-segments (segs decor)
  ;; `segs` with each row's display as a fourth field (its clip third, nil when none)
  (if (nil? decor)
    segs
    (into []
      (map (seq/enumerate segs)
        (fn ([k seg])
          (let (display (segment-display k (first seg) (second seg) decor))
            (if (nil? display) seg [(first seg) (second seg) (nth seg 2 nil) display])))))))

(sig one-row-decorated ((tuple any int int) int string any -> vector))
(defn- one-row-decorated (source w ellipsis inline)
  "The ONE row of the line `source` holds (`source-one-row`), cut in the room its `inline`
annotations before the cut leave."
  (let (row (source-one-row source w ellipsis)
        clip (nth row 2 nil)
        len (nth source 2)
        taken (if (empty? inline) 0 (inline-cells inline 0 (if clip (first clip) len) len)))
    (if (= taken 0) row (source-one-row source (if (> w taken) (- w taken) 1) ellipsis))))

(defn- source-segments (source w policy ellipsis &optional (spec nil))
  "The row segments of the line `source` holds under long-line `policy`: wrapped (a long
rope line's kept, `kept-layout`), or its one row. `spec` is what its rows show besides its
chars — `{:style :markers :inline}`, the wrap-prefix style and the line's inline annotations
— and a row that shows any of it carries its display as a fourth field (`[from to clip
display]`, `row-cell`'s `{:prefix :inline}`)."
  (let (len (nth source 2)
        inline (or (get spec :inline) []))
    (case policy
      :truncate
        (decorate-segments [(one-row-decorated source w ellipsis inline)]
          (when (not (empty? inline)) {:inline inline :length len}))
      :scroll
        (decorate-segments [(one-row-decorated source w "" inline)]
          (when (not (empty? inline)) {:inline inline :length len}))
      (let (single? (or (<= w 0)
                      (= len 0)
                      (>= (row-break source 0 0 w {:inline inline} true) len))
            prefix (if single? 0 (line-prefix source w (get spec :style) (get spec :markers)))
            decor (when (or (> prefix 0) (not (empty? inline)))
                    {:prefix prefix :inline inline :length len})
            segs (cond
                   single? [[0 len]]
                   (or (not (empty? inline)) (< len *layout-min-chars*) (string? (first source)))
                     (first (layout source w decor))
                   ;; a kept layout comes back out of `*line-layouts*`, which the checker reads
                   ;; as unknown: it is `layout`'s `[segs cols]` by construction, and the guard
                   ;; says so
                   else
                     (let (kept (first (kept-layout source w prefix)))
                       (if (vector? kept) kept [[0 0]]))))
        (decorate-segments segs decor)))))

(defn segments-for (text w policy &optional (ellipsis "…"))
  "The row segments of one line `text` in a `w`-cell row under long-line `policy`: its
wrapped `segments` for `:wrap`, else its ONE row (`one-row`) — ending in `ellipsis` for
`:truncate`, clipped at the edge for `:scroll`.

    (wrap/segments-for \"the quick brown fox\" 10 :truncate)   ;=> [[0 19 [9 \"…\"]]]
    (wrap/segments-for \"the quick brown fox\" 10 :scroll)   ;=> [[0 19 [10 \"\"]]]"
  (source-segments [text 0 (string/length text)] w policy ellipsis))

(sig follow-point (vector buffer int &optional int -> vector))
;; check-allow: `with-cell-layout` runs its body in a thunk whose result the checker does not
;; carry; the body is `follow-point-at`, which answers the table
(check-allow :trusted
  (defn follow-point (rows buf w &optional (margin 8))
    "[[follow-point-at]] with a tab spanning to `buf`'s stops (`conventions/with-cell-layout`)."
    (conventions/with-cell-layout buf (fn () (follow-point-at rows buf w margin)))))

(sig follow-point-at (vector buffer int int -> vector))
(defn- follow-point-at (rows buf w margin)
  "`rows` (a pane's row table, `w` cells wide) with point's line scrolled sideways when it
is a CLIPPED row and point sits at or past the cut — so point is never hidden behind an
ellipsis. Only that row moves (Emacs's `auto-hscroll-mode` `current-line`): it is shown from
the cell that leaves point `margin` cells clear of the right edge, and clipped again from
there. Every other row, and a table without that row, comes back as it was.

The table is memoised without point (`rows-from`), so this is applied after it, and costs a
scan of the rows for one that is clipped."
  (let (line (buffer-current-line buf)
        k (seq/index-where rows
            (fn (row) (and (= (first row) line) (nil? (nth row 3 nil)) (nth row 4 nil)))))
    (if (< k 0)
      rows
      (let (col (buffer-column buf)
            clip (nth (nth rows k) 4)
            [cut ellipsis] clip)
        (if (< col cut)
          rows
          (let (text (line-text buf line)
                point-cell (string/display-width (string/substring text 0 col))
                avail (math/max 1 (- w (string/display-width ellipsis)))
                slack (math/max 0 (math/min margin (math/quot (dec avail) 2)))
                shown (one-row text (math/max 0 (+ (- point-cell avail) 1 slack)) w ellipsis)
                shown-clip (nth shown 2 nil)
                display (row-display (nth rows k)))
            (assoc rows
              k
                (cond
                  display [line (first shown) (second shown) nil shown-clip display]
                  (nil? shown-clip) [line (first shown) (second shown) nil]
                  else [line (first shown) (second shown) nil shown-clip]))))))))

(defn- rope-line-segments (rope line w &optional (extras {}))
  "The row segments of line `line` of `rope`, `w` cells wide, under the line's policy in the
row `extras` (`line-policy`) — read from the rope a window at a time, never the whole line
(`source-segments`)."
  (let (prefix-spec (get extras :wrap-prefix)
        inline (get (get extras :inline) line))
    (source-segments (rope-line-source rope line)
      w
      (line-policy extras line)
      (or (get (get extras :long-lines) :ellipsis) "…")
      (when (or prefix-spec inline)
        {:style (get prefix-spec :style) :markers (get prefix-spec :markers) :inline inline}))))

(defn line-segments (buf line w &optional (extras {}))
  "The row segments of buffer line `line` (its text without the newline), `w` cells wide:
wrapped, or one row, as its policy in the row `extras` says (`rope-line-segments`). A tab
spans to the BUFFER's stops, as in every function here that is handed the buffer
(`conventions/with-cell-layout`)."
  (conventions/with-cell-layout buf
    (fn () (rope-line-segments (buffer-rope buf) line w (or extras {})))))

;; ---- inlay rows: a screen row that is not buffer text -------------------------------
;; A row need not show text the buffer contains. An INLAY row carries derived text of its
;; own — a signature above the `def` it describes, a diagnostic too long for the end of its
;; line — and occupies a row like any other: the cursor steps over it, the scroll counts it,
;; a click on it lands on the line it belongs to.
;;
;; They live in the row table rather than being painted over the text because every
;; row↔line question in the editor reads that table. A note drawn "between" two rows
;; without being IN the table is a note the cursor walks through and the scroll clamp
;; cannot see.
;;
;; A line's inlays come BEFORE its text rows: they describe the line below them, the way a
;; type signature sits above its definition.

;; ---- hidden lines: a fold's body takes no rows ---------------------------------------
;; The same map carries the lines a FOLD hides (src/folds.blsp), under `:hidden` beside the
;; line-keyed inlays — `scroll/ed-row-extras` builds it. A hidden line has no rows at all: no
;; inlays, no segments. Because every row↔line question reads this table, that one rule is
;; what hides a fold's body from the view, the cursor, the scroll clamp and the mouse.

(defn hidden? (extras line)
  "Whether a fold hides `line` — `extras` is the row-extras map (`scroll/ed-row-extras`)."
  (contains? (get extras :hidden #{}) line))

(sig rope-line-rows (any int int map -> int))
(defn- rope-line-rows (rope line w extras)
  ;; the rows line `line` takes: its inlays and its segments, none when it is hidden
  (if (hidden? extras line)
    0
    (+ (count (rope-line-segments rope line w extras)) (count (get extras line [])))))

(sig line-rows (buffer int int map -> int))
;; check-allow: `with-cell-layout` runs its body in a thunk whose result the checker does not
;; carry; the body is `rope-line-rows`, which answers an int
(check-allow :trusted
  (defn line-rows (buf line w extras)
    "The screen rows buffer line `line` takes at width `w`: its inlay rows and its wrapped
segments — none at all when a fold hides it. What a walk up or down the lines counts."
    (conventions/with-cell-layout buf (fn () (rope-line-rows (buffer-rope buf) line w extras)))))

(defn- segment-entry (line seg)
  ;; a text row's entry from one of its line's segments: a clipped row keeps its clip as a
  ;; fifth field, for the painter and a click, and a row showing a prefix or inline text its
  ;; display as a sixth (`row-cell`)
  (let (clip (nth seg 2 nil)
        display (nth seg 3 nil))
    (cond
      display [line (first seg) (second seg) nil clip display]
      clip [line (first seg) (second seg) nil clip]
      else [line (first seg) (second seg) nil])))

(defn- rope-line-entries (rope line w extras)
  ;; `line-row-entries` over the rope, under the caller's cell layout
  (into [] (map (rope-line-segments rope line w extras) (fn (seg) (segment-entry line seg)))))

(defn- inlay-rows (texts line limit acc)
  "`acc` plus inlay rows `[line 0 nil text]`, one per text of `texts`, up to `limit`."
  (fold texts acc (fn (a text) (if (>= (count a) limit) a (conj a [line 0 nil text])))))

(sig rows-step (any int int int int map int vector -> vector))
(defn- rows-step (rope n line w limit inlays skip acc)
  "Tail-recursive: `acc` plus the rows of `line` and the lines after it, up to `limit` — the
first `skip` of `line`'s own rows left out (a pane started part-way down its top line)."
  (if (or (>= line n) (>= (count acc) limit))
    acc
    (rows-step rope
      n
      (inc line)
      w
      limit
      inlays
      0
      (if (hidden? inlays line)
        acc
        (let (texts (get inlays line [])
              with-inlays (inlay-rows (drop texts skip) line limit acc)
              segs (rope-line-segments rope line w inlays)
              ;; the rows above the pane's start, and past what the table has room for, are
              ;; never built: a wrapped megabyte line has thousands
              from (math/min (count segs) (math/max 0 (- skip (count texts))))
              room (math/max 0 (- limit (count with-inlays)))
              to (math/min (count segs) (+ from room)))
          (fold (seq/subvec segs from to)
            with-inlays
            (fn (a seg) (conj a (segment-entry line seg)))))))))

;; The row table is memoised (`defmemo`, std/memo) on `[rope top skip w limit inlays]`: it is
;; asked from the pure `view`, from three hit-test sites in `panes`, and from
;; `input/ed-point-into-view`, so there is no model to hang a cache on — and the table is a
;; pure function of those.
;;
;; Worth a cache because it is neither cheap nor asked once: building one measured **1.7 ms**
;; on a 2,374-line markdown file, and a single turn asks for it at least twice. Markdown WRAPS
;; by default, so that was most of what moving the cursor cost in any prose buffer —
;; `update :ctrl-n` read 4.2 ms there against 0.9 ms in a buffer that does not wrap.
;;
;; Note what is NOT in the key: point. A cursor move re-reads the table rather than rebuilding
;; it, which is the whole point of caching this rather than the pane's view of it — and why
;; the memoised function takes the ROPE, not the buffer. Matched by `=`, not hashed: a rope
;; hashes by its whole text.

;; `cell-layout` (`conventions/cell-layout-key`: the tab width and the glyphless display) is
;; in the key though the body reads them as dynvars: M-x reload-config with a new tab width or
;; `:glyphless-chars` must lay the same rope out again, not hand back the old table
(defn- kinds-window (extras top reach)
  "`extras` with its `:long-lines` kinds (a vector parallel to the buffer's lines) cut to the
lines a table from `top` can reach — `reach` rows' worth, each line taking one row at least,
plus every line a fold hides, which takes none — and `:kinds-from` saying which line the cut
starts at (`line-policy` reads it). The extras as they are when the kinds are already that
short. What `rope-rows` is keyed on: its store is a deep copy, compared element by element on
every lookup, so a key must be the size of the window, never of the buffer."
  (let (spec (get extras :long-lines)
        kinds (get spec :kinds)
        n (if (vector? kinds) (count kinds) 0)
        from (math/min top n)
        to (math/min n (+ top reach (count (or (get extras :hidden) #{})))))
    (if (or (not (vector? kinds)) (and (= from 0) (= to n)))
      extras
      (assoc extras :long-lines (assoc spec :kinds (seq/subvec kinds from to) :kinds-from from)))))

(defmemo rope-rows 8 (rope top skip w limit inlays cell-layout)
  "The row table for `rows-from`, memoised on exactly what it depends on."
  (rows-step rope (text/line-count rope) top w limit inlays skip []))

(sig rows-from
  (buffer int
    int
    int
    &optional
    map
    int
    ->
    (vector (or (tuple int int (or nil int) (or nil string))
              (tuple int int int nil vector)
              (tuple int int int nil (or nil vector) map)))))
;; check-allow: the cache only ever holds what `rows-step` built, so a hit has the declared
;; shape by construction — but it comes back out of the memo's store, which the checker
;; reads as unknown.
(check-allow :trusted
  (defn rows-from (buf top w limit &optional (inlays {}) (skip 0))
    "The first `limit` screen rows from buffer line `top` down, each
`[line from to inlay]` (and a fifth field, the CLIP, on a row cut short — see
`one-row` — and a sixth, its DISPLAY, on a row with a wrap prefix or inline text — see
`row-cell`) — a line's inlay rows, then its text segments in order, then the
next line's — stopping at the buffer's end. What a `w`-wide, `limit`-tall pane shows; the
row↔line owner's table. Memoised on its inputs — see `rope-rows`.

With `skip`, the first `skip` rows of line `top` (its inlay rows, then its segments) are left
out: a pane started part-way down a wrapped line asks for the rows from its start, and the
rows above it are never built.

`inlay` is nil for a row of the buffer's own text, and the derived text to paint for an
INLAY row (`{line -> [text …]}` in `inlays`, keyed by the line each sits above). A reader
of this table that cares about the line's TEXT — where a column sits, which rows a
region fills — must skip the inlay rows; `panes/ed-rows-line-rows` is that filter, and
everything in the editor goes through it. A tab spans to the BUFFER's stops
(`conventions/tab-width`, bound as `*tab-width*` — brood ADR-537)."
    (conventions/with-cell-layout buf
      (fn ()
        (rope-rows (buffer-rope buf)
          (math/max 0 top)
          (math/max 0 skip)
          w
          limit
          (kinds-window (or inlays {}) (math/max 0 top) (+ limit (math/max 0 skip) 1))
          (conventions/cell-layout-key))))))

(sig row-of (any int -> int))
(defn row-of (segs col)
  "Which of a line's `segs` holds char column `col`: the segment whose `[from to)` spans
it, or the last one for a column at the end (point after the last char sits on the last
row, and an empty line's point on its one row). Found by halving: the segments tile the
line in order, so the one holding `col` is the last that starts at or before it — a
megabyte line wraps into thousands of rows.

    (wrap/row-of [[0 10] [10 19]] 10)   ;=> 1"
  (if (empty? segs) 0 (segment-index (if (vector? segs) segs (vec segs)) col)))

;; ---- a row's cells: THE row↔column conversion -----------------------------------------
;; Every question "which screen cell is char column C of this row on?" and its inverse
;; "which char is under cell X of this row?" is answered by `row-cell` and `row-column`,
;; and by nothing else. A ROW ENTRY is a row of the table — `[line from to inlay clip
;; display]`, the trailing fields optional — or one an unwrapped pane stands for,
;; `[line hscroll nil nil]` (`to` nil: the row runs to the line's end). What sits on a row
;; besides its chars is in `display`, `{:prefix :inline}`:
;;
;;   :prefix  cells of blank before the row's first char (a wrapped line's continuation
;;            row starts under its indentation — `wrap-prefix`)
;;   :inline  `[[column width text face] …]`, ascending: virtual text painted just before
;;            char `column`, `width` cells wide — never in the buffer (`inlinetext`)
;;
;; A position AT an inline annotation's column is painted after it (the char there is), so
;; the cursor never sits inside one and text typed there appears where the cursor is.

(sig row-display (any -> (or nil map)))
(defn row-display (row)
  "What row entry `row` shows besides its chars — `{:prefix :inline}` — or nil."
  (let (display (nth row 5 nil)) (if (map? display) display nil)))

(sig row-prefix (any -> int))
(defn row-prefix (row)
  "The blank cells before row entry `row`'s first char (0 for most rows)."
  (let (prefix (get (row-display row) :prefix)) (if (int? prefix) prefix 0)))

(defn row-inline (row)
  "The inline annotations painted on row entry `row`, `[[column width text face] …]`
ascending by column — `[]` for none."
  (let (inline (get (row-display row) :inline)) (if (vector? inline) inline [])))

(defn- row-inline-from (row start)
  ;; the row's inline annotations at or after char `start` — a row shown from part-way along
  ;; its line (`follow-point`) leaves the ones before it off the left edge
  (seq/filter (row-inline row) (fn (annotation) (>= (first annotation) start))))

(sig rope-line-length (any int -> int))
(defn- rope-line-length (rope line)
  ;; the chars of line `line` of `rope`, its newline not counted
  (nth (rope-line-source rope line) 2))

(sig cells-from-bol (any int int int -> int))
(defn- cells-from-bol (rope bol from to)
  ;; the cells of chars `[from, to)` of the line at `bol`, both ends measured from the
  ;; line's start (a tab spans to the LINE's stop — ADR-342)
  (cond
    (>= from to) 0
    (= from 0) (string/display-width (text/slice rope bol (+ bol to)))
    else
      (- (string/display-width (text/slice rope bol (+ bol to)))
        (string/display-width (text/slice rope bol (+ bol from))))))

(sig clamp-int (int int int -> int))
(defn- clamp-int (low high value)
  ;; `value` held within `[low, high]` — `if`s, so the checker keeps the int
  (cond
    (< value low) low
    (> value high) high
    else value))

(sig row-int (any int -> int))
(defn- row-int (row index)
  ;; field `index` of row entry `row` as an int (0 when it is not one): a row is untyped data
  (let (value (nth row index nil)) (if (int? value) value 0)))

(sig row-cell (any any int -> int))
(defn row-cell (rope row column)
  "The cell, counted from the text area's left edge, that char column `column` of row entry
`row`'s line is painted at: the row's prefix, the cells of its chars from its first to
`column` (measured on the line's tab stops), and every inline annotation at or before
`column` (a position at an annotation's column is painted after it). A column left of the
row's first char is its first; past the line's end, its end. THE row → cell conversion: the
caret, a remote caret, a fold's ellipsis, the region's end-of-line band, a note's place, a
C-n goal column and avy's labels all ask here.

    (wrap/row-cell (text/string-> \"abcdef\") [0 2 nil nil] 5)   ;=> 3"
  (let (line (row-int row 0)
        bol (text/line->char rope line)
        len (rope-line-length rope line)
        start (clamp-int 0 len (row-int row 1))
        at (clamp-int start len column)
        inline (fold (row-inline-from row start)
                 0
                 (fn (acc annotation)
                   (let (column (first annotation)
                         width (second annotation))
                     (if (and (int? column) (int? width) (<= column at)) (+ acc width) acc)))))
    (+ (row-prefix row) (cells-from-bol rope bol start at) inline)))

(sig index-at-cell (any int int int int -> int))
(defn- index-at-cell (rope bol from to cells)
  ;; the char of `[from, to)` on the line at `bol` whose cell holds `cells` (counted from
  ;; `from`'s), `to` when it is past them — measured as the row is painted
  (if (>= from to)
    from
    (+ from
      (string/width->index (text/slice rope (+ bol from) (+ bol to))
        (if (< cells 0) 0 cells)
        (cells-from-bol rope bol 0 from)))))

(sig row-column-walk (any int int int int int any -> int))
(defn- row-column-walk (rope bol end target position x annotations)
  "Tail-recursive: the char under cell `target` of a row whose chars run from `position`
(cell `x`) to `end`, with `annotations` (`[column width …]`, ascending) still ahead."
  (if (empty? annotations)
    (index-at-cell rope bol position end (- target x))
    (let (annotation (first annotations)
          anchor (first annotation)
          width (second annotation)
          column (clamp-int position end (if (int? anchor) anchor end))
          span (cells-from-bol rope bol position column)
          wide (if (int? width) width 0))
      (cond
        (< target (+ x span)) (index-at-cell rope bol position column (- target x))
        (< target (+ x span wide)) column
        else (row-column-walk rope bol end target column (+ x span wide) (rest annotations))))))

(sig row-column (any any number &optional bool -> int))
(defn row-column (rope row cell &optional (clicked false))
  "The char column of row entry `row`'s line under cell `cell` (counted from the text area's
left edge) — [[row-cell]]'s inverse, by the same measure: the row's prefix lands on its
first char, a cell on an inline annotation on the annotation's column (its anchor), a wide
glyph's second cell before it. Clamped to the row: past its text, its last position (on a
row its line continues past, the char before the next row's first). With `clicked`, a cell
past a CUT row's cut (its clip) is the line's end — the ellipsis is not a char, and the
chars behind it were not on screen to be clicked; without it (a C-n goal column) the cell
reads the line on past the cut, as Emacs's truncated lines keep the column. THE cell → char
conversion: a click, a drag, a hover, C-n's goal column.

    (wrap/row-column (text/string-> \"abcdef\") [0 2 nil nil] 3)   ;=> 5"
  (let (line (row-int row 0)
        to (nth row 2 nil)
        clip (nth row 4 nil)
        bol (text/line->char rope line)
        len (rope-line-length rope line)
        start (clamp-int 0 len (row-int row 1))
        end (if (int? to) (clamp-int start len to) len)
        last (if (< end len) (clamp-int start end (dec end)) end)
        floored (math/floor cell)
        target (- (if (int? floored) floored 0) (row-prefix row))
        found (row-column-walk rope bol end target start 0 (row-inline-from row start))
        column (if (< found last) found last)
        cut (when (vector? clip) (first clip)))
    (if (and clicked (int? cut) (>= column cut)) len column)))

(defn line-row-entries (buf line w &optional (extras {}))
  "The row entries of buffer line `line`'s TEXT at text width `w` (`[line from to nil clip
display]`, no inlay rows), as the row table holds them — or, when `w` is 0 (no wrapping),
its one whole row `[line 0 nil nil]`. What a walk by screen rows off the visible table asks
(C-n's goal column, the wheel carrying point, C-v)."
  (if (<= w 0)
    [[line 0 nil nil]]
    (conventions/with-cell-layout buf
      (fn () (rope-line-entries (buffer-rope buf) line w (or extras {}))))))

(sig row-entry-of (any int -> any))
(defn row-entry-of (entries column)
  "Which of a line's row `entries` ([[line-row-entries]]) holds char column `column` —
[[row-of]] over their segments."
  (nth entries (row-of (map entries (fn (entry) [(second entry) (nth entry 2)])) column)))

(sig row-count-step (any int int int map int int -> int))
(defn- row-count-step (rope line to-line w inlays limit acc)
  ;; tail-recursive: `acc` plus the rows of `[line, to-line)`, stopping once past `limit`
  ;; (-1: no limit)
  (if (or (>= line to-line) (and (>= limit 0) (> acc limit)))
    acc
    (row-count-step rope
      (inc line)
      to-line
      w
      inlays
      limit
      (+ acc (rope-line-rows rope line w inlays)))))

(sig row-count (buffer int int int &optional map int -> int))
;; check-allow: the body runs inside `with-cell-layout`, whose thunk's result the checker does
;; not carry; it is `row-count-step`'s int
(check-allow :trusted
  (defn row-count (buf from-line to-line w &optional (inlays {}) (limit nil))
    "How many screen rows the lines `[from-line, to-line)` take at width `w` — what the
scroll clamp asks to keep point on screen through wrapped lines above it. With `limit`,
counting stops at the first total past it: the clamp only needs to know point is below the
screen, and `M->` in a 6,000-line markdown file counted every row above it (56 ms) to learn
that. A tab spans to the buffer's stops (`conventions/with-cell-layout`).

Counts INLAY rows too. It has to: they occupy rows, so a clamp that did not count them
would put point exactly as many rows off the bottom as there were inlays above it — the
one bug an inlay is otherwise invisible enough to cause and hard to attribute."
    (row-count-at buf from-line to-line w inlays limit)))

(defn- row-count-at (buf from-line to-line w inlays limit)
  ;; `row-count`'s body, at `buf`'s tab width
  (conventions/with-cell-layout buf
    (fn ()
      (row-count-step (buffer-rope buf)
        (math/max 0 from-line)
        (math/max 0 to-line)
        w
        (or inlays {})
        (if (int? limit) limit -1)
        0))))

(defn raw-inlays (buf)
  "The inlay annotation as stored, or `{}` when it no longer describes the text."
  ;; `{owner-key -> [{:line :text} …]}`. Keyed by owner for the
  ;; same reason the notes are — a producer rebuilds ITS rows without touching a sibling's.
  (let (a (editor/buffer/annotation buf :inlay-lines))
    (if (and a (:current? a)) (or (:value a) {}) {})))

(defn inlay-lines (buf)
  "`{0-based line -> [text …]}` — the derived rows to show ABOVE each line, or `{}` when
the buffer has none or they no longer describe the text.

An inlay is what a note becomes when it will not fit at the end of its line. A type
signature is the case that forced it: `foo/2 : (float() or integer(), binary()) ->
dynamic(float() or integer())` against a `def` that is already indented leaves a couple of
dozen columns, so the half that identifies the function is the half that gets cut. Above
the `def`, on a row of its own, it has the whole width — which is where a signature goes in
every language that writes one down.

A buffer annotation like every other derived text, so it dims and blanks by the same rule;
`wrap/rows-from` turns it into rows and `panes/ed-rows-line-rows` keeps it out of the
answers that are about the line's own text.

Flattened from the per-owner store and ordered by line, so two producers can put rows above
the same line and the reader sees one list."
  (fold (%map-pairs (raw-inlays buf))
    {}
    (fn (acc kv)
      (let ([_ entries] kv)
        ;; filtered BEFORE the sort: `sort-by` reads the key from every element, so one bad
        ;; entry raises there rather than at the fold that guards for it
        (fold (seq/sort-by (seq/filter (if (or (vector? entries) (list? entries)) entries []) map?)
                :line)
          acc
          (fn (a e)
            ;; an annotation is DATA, and this is read while painting a frame: an entry
            ;; that is not a `{:line :text}` is skipped rather than raised on, because the
            ;; cost of being wrong here is the whole window, not one missing row
            (let (line (when (map? e) (:line e)))
              (if (int? line)
                (assoc a line (into [] (append (get a line []) [(:text e)])))
                a))))))))
