(defmodule frames
  "Frames — a second OS window over the same buffers (Emacs `C-x 5 2` / `C-x 5 o` / `C-x
5 0`), `docs/frames-plan.md`. A frame is a PROCESS with its own window and its own
`ui-run` (layout, minibuffer, mode line all its own) whose pool slots are linked to the
same buffer processes as every other frame's: the hosted flip (`hosted.blsp`) already
backs every buffer with a process, and `std/editor/buffer-registry` names them — the one
process for `*scratch*`, shared by whichever frame asks. A buffer opened in one frame
appears in the others (`[:registry-added …]`), a kill removes it everywhere
(`[:registry-removed …]`), an edit lands in every frame through its process — the collab
session with no network. The primary (the window `main` opened, the `:editor` process)
keeps the frame list and the services; a frame that closes just leaves its loop."
  (:use model) ; ed-init / ed-buf-at / ed-stamp / message — the model a frame runs
  (:use hosted) ; ed-host-slot / ed-unhost-slot / hosted-share-slot — linking a slot to a process
  (:use interactive) ; defcommand
  (:use editor/buffer) ; make-buffer / buffer-name
  (:use editor/buffer-server)
  (:use editor/layers) ; set-buffer-type — a joining frame types its copy from the entry's meta
  (:use editor/ui) ; ui-run — a frame's own loop
  (:use editor/frontend) ; gui-display — a frame's own window
  (:use editor/buffer-registry)) ; registry-start / -watch / -entries — one process per document
;; ---- the registry on the model ------------------------------------------------

(defn frames-registry-start (m &optional (owner nil))
  "Start the buffer registry for this editor and watch it: `:buffer-reg` on the model,
which `hosted-share-slot` then hosts every slot through, and `[:registry-…]` events for
this process. `main` calls it beside the hosted flip; a frame inherits the pid.

The window's registry is the runtime's, under the well-known name `:buffer-registry`. A
served session's is its own (`owner`, the session — brood's `editor/serve/served-session`):
it lives as long as the session, not the loop (brood ADR-593), so a restarted loop adopts
its buffers, and it takes no name — there is one per session, and a guest's must not be
found by another's."
  (let (registry (registry-start (if (nil? owner) {} {:owner owner})))
    (registry-watch registry (self))
    ;; a well-known name, like `:editor`: a tool, a mirror or a probe finds the editor's
    ;; buffers here without going through a frame
    (when (nil? owner) (proc/register :buffer-registry registry))
    (assoc m :buffer-reg registry)))

;; ---- registry events: buffers appearing and vanishing in other frames ----------

(defn frames-slot-from-entry (name proc meta dir)
  "A pool buffer for another frame's `name`: empty, typed and placed from the registry
`meta` (its `:file` / `:type` / `:dir`, else `dir`, the `:eol` / `:bom` its file is written
with, and the repo a section buffer shows), stamped for the pool (`ed-stamp`).
The seed push fills the text once the slot is linked to `proc`."
  (let (raw (make-buffer "" name (:file meta))
        typed (if (nil? (:type meta)) raw (set-buffer-type raw (:type meta)))
        stamped (ed-stamp (frames-with-coding typed meta))
        ;; so-long's state, as the frame that opened it found it (`hosted-meta`)
        long (solong/so-long-carried stamped (:so-long meta))
        ;; a file edited as root stays one (sudoedit): saved through sudo from here too
        sudoed (if (= true (:sudo meta)) (assoc long :sudo true :sudo-user (:sudo-user meta)) long)
        ;; a file on another machine stays one (sshedit): saved through ssh from here too
        remote (if (= true (:ssh meta)) (assoc sudoed :ssh true) sudoed)
        ;; a section buffer stays its repo's (`vcsproc/vcs-status-index` finds a status by it);
        ;; its tree is drawn again when it is next refreshed here
        rooted (if (nil? (:section-root meta))
                 remote
                 (assoc remote :section-ctx {:root (:section-root meta)})))
    (if (nil? (:dir rooted)) (assoc rooted :dir (or (:dir meta) dir)) rooted)))

(sig frames-adopt (model string string pid map -> model))
(defn frames-adopt (m key name proc meta)
  "Fold a registry entry into this frame's pool: a document this frame does not have
(no slot with `hosted-key` = `key`) is appended as a slot linked to `proc` (the seed push
fills it); one it has but whose link points elsewhere — its process died and another frame
re-shared first, or this frame is not yet linked — is relinked to `proc`; one already on
`proc` is left alone (our own share echoing back). The layout is untouched: a buffer opened
in another frame does not steal this one's pane."
  (let (index (hosted-index-by-key m key))
    (cond
      (nil? index)
        (let (buffers (into (:buffers m)
                        [(frames-slot-from-entry name proc meta (:dir (ed-current-buf m)))])
              slot (dec (count buffers)))
          (map/update-in (ed-host-slot (assoc m :buffers buffers) slot proc)
            [:hosted slot]
            (fn (link) (assoc link :registry? true))))
      (= (map/get-in m [:hosted index :proc]) proc) m
      else
        (map/update-in (ed-host-slot (ed-unhost-slot m index false) index proc)
          [:hosted index]
          (fn (link) (assoc link :registry? true))))))

(defn ed-ev-registry-added (m input textrows cols rows)
  "`[:registry-added key name proc meta]`: another frame (or this one, echoing) shared a
buffer — adopt it (`frames-adopt`). The buffer this frame was opened to show and did not
find yet (`:frame-show`) is shown as it arrives."
  (let ([_ key name proc meta] input
        adopted (frames-adopt m key name proc meta)
        index (when (= name (:frame-show m)) (ed-buffer-index-by-name adopted name)))
    (if (nil? index)
      adopted
      (dissoc (ed-show-index adopted index) :frame-show))))

(defn ed-ev-registry-renamed (m input textrows cols rows)
  "`[:registry-renamed old-key key name meta]`: a frame wrote a shared buffer to another
file (`C-x C-w`), or its file's coding changed (a revert that found the byte-order mark or
the CRLF line endings gone — `hosted/hosted-sync-coding`, the key unchanged). This frame's copy
takes the new name, file, `:eol` and `:bom` — it is the same document and the same process,
so nothing is relinked. Our own rekey echoing back finds the slot already so and changes
nothing."
  (let ([_ old-key _ name meta] input
        index (hosted-index-by-key m old-key))
    (if (nil? index)
      m
      ;; and in the mode the new name asks for, as the frame that renamed it chose
      (let (old (ed-buf-at m index))
        (ed-set-buf-at m
          index
          (pool/ed-retype-for-file (frames-with-coding (assoc old :name name :file (:file meta))
                                     meta)
            (buffer-file old)))))))

(defn- frames-with-coding (buffer meta)
  "`buffer` writing its file as registry `meta` says: `:eol :crlf` or none, `:bom true` or none, its
`:coding` or none."
  (let (with-eol (if (= (:eol meta) :crlf) (assoc buffer :eol :crlf) (dissoc buffer :eol)))
    (charset/with-coding (if (= true (:bom meta)) (assoc with-eol :bom true) (dissoc with-eol :bom))
      (:coding meta))))

(defn ed-ev-registry-removed (m input textrows cols rows)
  "`[:registry-removed key reason]`: a buffer was killed in another frame (`:killed`) —
drop this frame's slot without asking the registry again (`:drop-local-only`, read by
`hosted-drop-slot`), through the full kill path (`pool/ed-kill-buffer-at`: the mode's
`:on-close`, the pane re-point). A `:died` needs nothing here: this frame's own monitor
`[:down]` re-shares from its cache (`hosted-rehost`)."
  (let ([_ key reason] input
        index (hosted-index-by-key m key))
    (if (or (not (= reason :killed)) (nil? index))
      m
      ((reflect/eval 'pool/ed-kill-buffer-at) (assoc m :drop-local-only true) index))))

;; ---- a frame: its process, window and model -------------------------------------

(sig frames-adopt-registry (model pid -> model))
(defn frames-adopt-registry (m registry)
  "`m` hosting through registry `registry` (`:buffer-reg`, `:host-buffers?`) with every buffer
in it adopted as a linked slot ([[frames-adopt]]), and the registry watched — a fresh frame,
or a served session's loop restarted over the buffers its dead one left (`remote`)."
  (let (m1 (assoc m :buffer-reg registry :host-buffers? true)
        ;; watched BEFORE the entries are read: a buffer shared in between arrives as a
        ;; `[:registry-added …]` (adopting it twice is a no-op), where reading first lost it
        _ (registry-watch registry (self))
        entries (registry-entries registry))
    (fold (if (vector? entries) entries [])
      m1
      (fn (acc entry)
        (frames-adopt acc (:key entry) (:name entry) (:proc entry) (or (:meta entry) {}))))))

(sig frames-seed-model (pid string map &optional any -> model))
(defn frames-seed-model (registry show live &optional (layout nil))
  "A fresh frame's model: `ed-init` on a scratch, every registry entry adopted as a linked
slot, `show` (the buffer the frame was opened on) selected, the live flags `live` merged
(the primary's `:gui` / `:os-clipboard` / `:recent-files` / `:project-root` / `:hl-line` …),
the registry watched, and `:frame? true` — a frame's quit is a frame quit. With `layout` (a
deleted frame's panes by buffer NAME, [[frames-closed-record]]) the panes are laid out as
they were ([[frames-restore-layout]])."
  (let (fresh (merge (ed-init (make-buffer "" "*scratch*")) live)
        adopted (assoc (frames-adopt-registry fresh registry) :frame? true)
        index (ed-buffer-index-by-name adopted show))
    ;; a buffer the registry has not shared yet (a report a `display-buffer` rule sent here as
    ;; it was made) is shown when it arrives (`ed-ev-registry-added`)
    (cond
      (nil? index) (assoc adopted :frame-show show)
      (nil? layout) (assoc (ed-show-index adopted index) :status (str "editing " show))
      else (frames-restore-layout (ed-show-index adopted index) layout index))))

;; ---- a deleted frame, and undeleting it (Emacs 29's `undelete-frame`) ----------------
;; A frame that closes tells the primary what it showed — its panes, each naming its buffer
;; by NAME, since pool indices are each frame's own — and the primary keeps the last
;; [[*deleted-frames-max*]] of them (Emacs's `undelete-frame-mode` keeps 16). C-x 5 u opens
;; the newest again: a new frame process over the same registry, its panes on the same
;; buffers, scrolled where they were. A buffer killed since leaves its pane on the frame's
;; selected buffer. The window's size and position are the window manager's, not kept.

(def *deleted-frames-max* 16)

(defn frames-closed-record (m)
  "What a closing frame `m` leaves for C-x 5 u: `{:show :layout}` — the selected buffer's
name, and the pane tree with each pane's pool index replaced by its buffer's name
(`:buffer-name`), its scroll and point kept."
  {:show (buffer-name (ed-current-buf m))
   :layout (editor/pane/pane-map (:layout m)
             (fn (payload)
               (let (index (:buffer payload))
                 (assoc (dissoc payload :buffer)
                   :buffer-name
                     (when (and (int? index) (< index (count (:buffers m))))
                       (buffer-name (ed-buf-at m index)))))))})

(defn frames-restore-layout (m layout fallback)
  "`m` with the pane tree `layout` (as [[frames-closed-record]] names it) as its layout: each
pane on the pool buffer of its `:buffer-name`, else on pool index `fallback` at its top, the
pane selected as it was."
  (assoc m
    :layout
      (editor/pane/pane-map layout
        (fn (saved)
          (let (index (ed-buffer-index-by-name m (or (:buffer-name saved) ""))
                payload (dissoc saved :buffer-name))
            (if (nil? index)
              (assoc (dissoc payload :point :mark) :buffer fallback :top 0)
              (assoc payload :buffer index)))))))

(defn frames-remember-deleted (m record)
  "The primary `m` keeping a deleted frame's `record` for C-x 5 u, newest first, capped at
[[*deleted-frames-max*]]."
  (assoc m
    :deleted-frames (vec (take (cons record (or (:deleted-frames m) [])) *deleted-frames-max*))))

(defn frames-take-deleted (m)
  "`[m' record]`: the newest deleted frame's record taken off the primary `m`'s list, or
`[m nil]` when no frame was deleted."
  (let (deleted (or (:deleted-frames m) []))
    (if (empty? deleted)
      [m nil]
      [(assoc m :deleted-frames (vec (rest deleted))) (first deleted)])))

(defn frames-leave (m)
  "A frame `m` closing (C-x 5 0, C-x C-c in a frame, its window's X): what it showed sent to
the primary for C-x 5 u ([[frames-closed-record]]), and its loop ended."
  (do
    (when-let (primary (proc/whereis :editor))
      (when (not (= primary (self))) (send primary [:frame-deleted (frames-closed-record m)])))
    (assoc m :done true)))

(defn ed-ev-frame-deleted (m input textrows cols rows)
  "`[:frame-deleted record]` from a frame that closed: kept for C-x 5 u."
  (frames-remember-deleted m (second input)))

(def *frame-live-keys*
  ;; the primary's model keys a frame inherits — the live-editor flags `main` sets, not
  ;; its buffers, layout or transient state
  [:gui
    :terminal :os-clipboard :kill-agent :recent-files :project-root :hl-line :cursor :profile :theme
    ;; what init.blsp said when it was applied, so C-h v in a new frame can say what it says now
    :init-config])

(defn frames-live-of (m)
  "The live-editor flags of model `m` a fresh loop over the same buffers carries — a frame
opened from it, or the primary restarted after its loop died (`lifeline`): the
[[*frame-live-keys*]] that are set."
  (fold *frame-live-keys* {} (fn (acc key) (if (nil? (get m key)) acc (assoc acc key (get m key))))))

(defn- frames-main (registry show live opts layout)
  "The body of a frame process: open its window (this process polls it — the runtime
routes a window's input to the process that opened it), run `ui-run` on the seed model
with the editor's own view and update, and leave. Everything the frame links to
(`:hosted`) is unsubscribed when the loop ends; the buffer processes live on."
  (let (display (gui-display opts))
    (try
      (let (m (assoc (frames-seed-model registry show live layout) :window (:window display)))
        (log/info (str "frame "
                    (:window display)
                    " opened on "
                    show
                    " with "
                    (count (:buffers m))
                    " buffers"))
        ;; this frame's loop must keep answering too (brood ADR-517)
        (proc/flag :responsive true)
        (ui-run m
          (reflect/eval 'view/ed-view)
          (reflect/eval 'input/ed-update)
          display)
        ;; the loop is over: drop every link, so the processes stop pushing to a dead mailbox
        (doseq (link (vals (or (:hosted m) {}))) (unsubscribe-buffer (:proc link))))
      ;; a frame that dies says why on stderr — a spawned process's crash is otherwise silent
      (catch e
        (do (log/warn (str "frame failed: " (error-message e))) ((get display :leave)) (throw e))))))

(sig frames-spawn (model map &optional any any -> model))
(defn frames-spawn (m opts &optional (name nil) (layout nil))
  "Open a new frame on the buffer named `name`, the current buffer by default: spawn its
process (`frames-main`), monitor it and record it in `:frames` (`{pid → window title}`), so the
primary can raise, list and close it. `opts` are the window options (`:app-id` / `:title`)."
  (let (registry (:buffer-reg m)
        show (or name (buffer-name (ed-current-buf m)))
        live (frames-live-of m)
        pid (spawn (frames-main registry show live opts layout)))
    (monitor pid)
    (message (assoc m :frames (conj (or (:frames m) []) pid))
      (str "frame opened on " show))))

(sig frames-forget (model pid -> model))
(defn frames-forget (m pid)
  "A frame process ended: drop `pid` from `:frames`."
  (assoc m :frames (into [] (seq/reject (or (:frames m) []) (fn (frame) (= frame pid))))))

(sig frames-down (model any any -> model))
(defn frames-down (m pid reason)
  "The down handler: a monitored process that was one of this primary's frames is forgotten;
any other pid is not ours."
  (if (frames-frame-pid? m pid) (frames-forget m pid) m))

(sig frames-frame-pid? (model pid -> bool))
(defn frames-frame-pid? (m pid)
  "Whether `pid` is one of this primary's frames."
  (includes? (or (:frames m) []) pid))

(sig frames-close-all (model -> model))
(defn frames-close-all (m)
  "End every frame process (their windows close with them) — the primary's quit."
  (do
    (doseq (frame (or (:frames m) [])) (exit frame :kill))
    (assoc m :frames [])))

;; ---- the commands (C-x 5 …) --------------------------------------------------------

(defcommand cmd-make-frame
  (m key)
  "Open a second window on the current buffer (C-x 5 2, Emacs `make-frame`): a new frame
process with its own layout, sharing every buffer with this one through the buffer
registry. Only the primary opens frames (a frame asks the primary); without a registry —
a headless or test model — it says so, as does an editor in the terminal (`bedit -nw`), which
has the one screen."
  (cond
    (:terminal m) (message m "a terminal has one frame (bedit -nw) — C-x 2 / C-x 3 split it")
    (nil? (:buffer-reg m)) (message m "frames need the live editor (no buffer registry)")
    (:frame? m) (do (send :editor [:make-frame]) (message m "asked the primary for a frame"))
    else (frames-spawn m (assoc (config/window-options (config/peek-init)) :title *app-name*))))

(defcommand cmd-suspend-frame
  (m key)
  "Suspend the editor (C-z, C-x C-z — Emacs `suspend-frame`): in a terminal (`bedit -nw`) give
it back to the shell and stop, as any job's C-z does — `fg` brings the editor back, the
screen painted whole (`term/suspend`, brood ADR-586); in a window, iconify it. Where nothing
could continue it — started as `gnome-terminal -- bedit -nw`, `ssh host bedit -nw`, `exec` —
it does not stop, and says so: stopped there it would stay frozen with its unsaved text."
  (cond
    (:terminal m)
      (if (= (term/suspend) :no-job-control)
        (message m "cannot suspend: no job control (nothing here could bring the editor back)")
        m)
    (:window m) (do (theme/gui-only gui/minimize (:window m)) m)
    else (message m "nothing to suspend: no terminal or window")))

;; check-allow: `cmd-quit` is resolved late (`reflect/eval`), so its result is unknown to the
;; checker; it answers a model
(check-allow :trusted
  (defcommand cmd-delete-frame
    (m key)
    "Close this frame (C-x 5 0, Emacs `delete-frame`): a frame just leaves its loop — the
buffers live on in the registry, the other frames keep them. On the primary, with no other
frame open, this is `C-x C-c`; with frames open the primary cannot be deleted (close the
others first, or quit). A frame closed is kept for C-x 5 u ([[cmd-undelete-frame]])."
    (cond
      (:frame? m) (frames-leave m)
      (empty? (or (:frames m) [])) ((reflect/eval 'lifecycle/cmd-quit) m key)
      else
        (message m
          (str (count (:frames m))
            " other frame(s) open — close them first, or C-x C-c to quit all")))))

(defn frames-undelete-show (m record)
  "The buffer an undeleted frame opens on: the one `record` had selected, else the first of its
panes' buffers still open in the primary `m`, else `m`'s current buffer — a frame opened on a
buffer killed since would wait for it for ever."
  (let (panes (map (editor/pane/pane-leaf-paths (:layout record))
                (fn (path) (:buffer-name (editor/pane/pane-payload-at (:layout record) path))))
        open? (fn (name) (and (string? name) (not (nil? (ed-buffer-index-by-name m name))))))
    (or (seq/find (cons (:show record) panes) open?) (buffer-name (ed-current-buf m)))))

(defcommand cmd-undelete-frame
  (m key)
  "Open the frame closed last again (C-x 5 u, Emacs 29's `undelete-frame`): a new frame on the
buffers it showed, laid out as it was, each pane scrolled where it was; repeated, the one closed
before it, back to the last 16. A buffer killed since leaves its pane on another. A frame asks
the primary, which keeps the closed frames."
  (cond
    (:terminal m) (message m "a terminal has one frame (bedit -nw)")
    (nil? (:buffer-reg m)) (message m "frames need the live editor (no buffer registry)")
    (:frame? m)
      (do (send :editor [:undelete-frame]) (message m "asked the primary to undelete a frame"))
    else
      (let ([taken record] (frames-take-deleted m))
        (if (nil? record)
          (message m "no deleted frame to undelete")
          (frames-spawn taken
            (assoc (config/window-options (config/peek-init)) :title *app-name*)
            (frames-undelete-show taken record)
            (:layout record))))))
(defcommand cmd-other-frame
  (m key)
  "Raise the next frame's window (C-x 5 o, Emacs `other-frame`). The primary raises its
first frame; a frame asks the primary to raise the one after it (or the primary itself)."
  (cond
    (:frame? m) (do (send :editor [:other-frame (self)]) m)
    (empty? (or (:frames m) [])) (message m "no other frame")
    else (do (send (first (:frames m)) :focus) m)))

(defn frames-spawn-showing (m name)
  "Open a new frame showing the buffer named `name` — a `:display-buffer` rule's `:new-frame`
(`pool/ed-display-buffer`). A frame asks the primary, which owns the frames, as C-x 5 2 does."
  (if (:frame? m)
    (do
      (send :editor [:make-frame name])
      (message m (str "asked the primary for a frame on " name)))
    (frames-spawn m (assoc (config/window-options (config/peek-init)) :title *app-name*) name)))

(defn ed-ev-make-frame (m input textrows cols rows)
  "`[:make-frame]` from a frame: the primary opens one — on the buffer it names
(`[:make-frame name]`), else on the current one."
  (let (name (when (> (count input) 1) (second input)))
    (if (nil? name) (cmd-make-frame m nil) (frames-spawn-showing m name))))

(defn ed-ev-other-frame (m input textrows cols rows)
  "`[:other-frame from]` from frame `from`: raise the frame after it, the primary itself
after the last."
  (let (frames (or (:frames m) [])
        from (index-of frames (nth input 1))
        next (if (and (>= from 0) (< (inc from) (count frames))) (nth frames (inc from)) nil))
    (do
      (if (nil? next) (send (self) :focus) (send next :focus))
      m)))

(defn ed-ev-undelete-frame (m input textrows cols rows)
  "`[:undelete-frame]` from a frame: the primary opens the frame closed last again."
  (cmd-undelete-frame m nil))

;; ---- registration: the inbound events this module owns -----------------------------
;; Buffers appearing / vanishing / renamed in another frame, and a frame's requests to the
;; primary. Registered at load (`model/register-event-handler`), and safe to be: a
;; `[:registry-…]` event only reaches a loop that `frames-registry-start` subscribed, and
;; `[:make-frame]` / `[:other-frame …]` only come from a frame this module opened — this
;; module is loaded before any of them can be sent.
(register-event-handler :registry-added 'frames/ed-ev-registry-added)
(register-event-handler :registry-removed 'frames/ed-ev-registry-removed)
(register-event-handler :registry-renamed 'frames/ed-ev-registry-renamed)
(register-event-handler :make-frame 'frames/ed-ev-make-frame)
(register-event-handler :other-frame 'frames/ed-ev-other-frame)
(register-event-handler :frame-deleted 'frames/ed-ev-frame-deleted)
(register-event-handler :undelete-frame 'frames/ed-ev-undelete-frame)
(register-down-handler :frames 'frames/frames-down)
(register-presenter :new-frame 'frames/frames-spawn-showing)
