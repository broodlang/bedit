(defmodule about
  "What am I running? — bedit's version, the Brood runtime under it, and when this
build was made, in the four places a user asks:

  - `M-x version`      — one line in the echo area (Emacs's `M-x emacs-version`)
  - `bedit --version`  — the same line on stdout, for a bug report or a script
  - `C-h C-a`          — an `*About bedit*` buffer with the full block
  - the welcome scratch — a line under the banner, seen on every cold start

**None of these facts is computed here.** They all come from `project/build-info`,
which reads them from the manifest `nest release` stamped into the bundle (`:version`,
`:built-at`, `:built-with`) or, running from source, from the on-disk `project.blsp`
plus the git HEAD commit — so the editor never carries a hardcoded copy of its own
version to go stale. (It carried exactly one: `packages/*bedit-version*` said `0.2.0`
against a manifest that had reached `0.4.1`, and every plugin `:enhances` constraint was
being checked against it. It now reads [[bedit-version]].)

Named `about`, not `version`: std ships a `version` module (`version/newer?`, which
`packages` uses to decide a plugin is out of date), and a project module of that name
shadows it — the same dodge `complete-at-point` makes around std's `tool/complete`.

This module deliberately depends on almost nothing — `commands/ed-show-named` is
referenced qualified rather than `(:use)`d — so `packages` can ask it for the version
without dragging the command layer into its load."
  (:use model) ; message — the echo-area line
  (:use interactive)) ; defcommand — define + register for M-x
;; ---- the facts ---------------------------------------------------------------

(def *started-at*
  ;; When this editor process started, near enough: the moment this module first loaded.
  ;; `main` loads it while building the welcome buffer, so on the editor's own path that is
  ;; startup to within a few milliseconds. Not `main`'s own clock, because `--version` and a
  ;; headless `M-x version` have no `main` to have run — and a fact every surface can ask for
  ;; unconditionally beats one that is present on some paths and nil on others.
  (os/now))

(defn info (&optional (bi nil))
  "This build's `project/build-info` map — bedit's version and build stamp, the runtime's
version/build-id/features, and whether we are a `nest release` bundle or a source run."
  (or bi (project/build-info)))

(defn- brood-sha (build-id)
  ;; `system/build-id` is "<version>+<git-sha>+<binary-stamp>"; the middle field is the
  ;; only half worth showing a human — the third is a hex nanosecond mtime.
  (let (parts (if (nil? build-id) nil (string/split build-id "+")))
    (if (and parts (> (count parts) 1)) (second parts) nil)))

(defn- stamp-text (ms)
  ;; An instant as `2026-08-29 14:03 UTC`, or "" when there isn't one.
  (if (nil? ms) "" (str (datetime/format (datetime/epoch-ms-> ms) "%Y-%m-%d %H:%M") " UTC")))

(defn- duration-text (ms)
  ;; A span as `3h 12m` / `12m` / `48s` — the coarsest unit that still says something. An
  ;; uptime to the second is noise after the first minute and wrong by the time you read it.
  ;;
  ;; `math/floor` on every division, not `/`: Brood's `/` is exact, so `(/ 2683 1000)` is the
  ;; RATIO 2683/1000 and an uptime rendered straight from it reads `up 2683/125s`.
  (let (secs (math/floor (/ ms 1000))
        mins (math/floor (/ secs 60))
        hours (math/floor (/ mins 60)))
    (cond
      (< secs 60) (str secs "s")
      (< mins 60) (str mins "m")
      else (str hours "h " (- mins (* hours 60)) "m"))))

(defn bedit-version (&optional (bi nil))
  "bedit's own version string (the manifest's `:version`), or `\"0.0.0\"` if the manifest
could not be read — a floor rather than nil, so a version *comparison* (a plugin's
`:enhances` constraint) always has something to compare and simply fails closed."
  (or (get (info bi) :app-version) "0.0.0"))

(defn brood-text (&optional (bi nil))
  "The Brood runtime as `\"0.16.0 (d0a85717)\"` — version plus the git sha out of
`system/build-id`, dropping its binary-mtime field (`\"0.16.0\"` alone if unavailable)."
  (let (i (info bi)
        sha (brood-sha (get i :build-id)))
    (str (get i :brood-version) (if sha (str " (" sha ")") ""))))

(defn facts (&optional (bi nil))
  "**Every** fact the version surfaces know, as one flat map of ready-to-print strings —
the single field a display format draws from.

    {:bedit \"0.4.1\" :brood \"0.16.0 (d0a85717)\" :brood-version \"0.16.0\"
     :brood-sha \"d0a85717\" :build-id \"0.16.0+d0a85717+18f2…\"
     :built \"2026-08-29 14:03 UTC\" :built-by \"…\" :commit \"a5e2405\"
     :source? true :bundled? false :modules \"\" :features \"gui jit\"
     :started \"2026-08-29 09:12 UTC\" :uptime \"3h 12m\"
     :runtime-built \"2026-08-20 11:02 UTC\" :config \"/home/…/init.blsp\"}

Strings throughout, and `\"\"` rather than nil for anything this build hasn't got — a format
string is substituted into, not branched on, so an absent fact has to render as nothing
rather than as `nil` or a hole. [[render]] is what turns this into a line; the point of the
split is that a user's own format can reach any of these without new code here."
  (let (i (info bi)
        features (get i :features)
        modules (get i :module-count)
        now (os/now))
    {:bedit (bedit-version i)
     :brood (brood-text i)
     :brood-version (or (get i :brood-version) "")
     :brood-sha (or (brood-sha (get i :build-id)) "")
     :build-id (or (get i :build-id) "")
     :built (project/build-stamp-text i)
     :built-at (or (get i :built-at) "")
     :built-by (or (get i :built-with) "")
     :commit (or (get i :commit) "")
     :source? (not (get i :bundled?))
     :bundled? (= (get i :bundled?) true)
     :modules (if modules (str modules) "")
     :features (if (empty? features) "" (string/join (map features ->string) " "))
     :started (stamp-text *started-at*)
     :started-at *started-at*
     :uptime (duration-text (- now *started-at*))
     :runtime-built (stamp-text (get i :brood-built-at))
     :config (config/init-file)}))

;; ---- the display, which the user chooses --------------------------------------

(def *default-format*
  ;; The built-in one-liner. `{{key}}` names a key of [[facts]] — std/template, the same
  ;; syntax the tutorial's prose uses, so there is one templating convention here.
  "bedit {{bedit}} · started {{started}} · built {{built}} · brood {{brood}}")

(defn render (fmt &optional (fs nil))
  "Render version `fmt` against [[facts]] and return the line.

`fmt` may be a **template string** (`{{bedit}} on {{brood}}`), a **symbol** naming a
function of the facts map — resolved late, so it can be one you `defn` and redefine live
with C-x C-e — or nil for [[*default-format*]]. Name the symbol as the function is actually
bound: bare for one defined at root (what C-x C-e in a scratch buffer gives you), qualified
(`mymod/fmt`) for one inside a module. A symbol that names
nothing, or a formatter that throws, falls back to the default rather than leaving the user
with no version at all: this is the surface people reach for when something is already
wrong."
  (let (facts-map (or fs (facts))
        default (fn () (template/render *default-format* facts-map)))
    (cond
      (nil? fmt) (default)
      (string? fmt) (try (template/render fmt facts-map) (catch _ (default)))
      (symbol? fmt)
        (if (bound? fmt)
          (try (->string ((reflect/eval fmt) facts-map)) (catch _ (default)))
          (default))
      else (default))))

(defn configured-format ()
  "The `:version-format` from `~/.config/bedit/init.blsp`, or nil for the default.

Read straight from the file rather than threaded off the model, because the two callers that
matter have no model: `bedit --version` runs before anything opens. Reads without
`ensure-init!` — printing a version should not create a config file as a side effect."
  (try
    (:version-format (config/peek-init))
    (catch e (do (log/warn (str "init: unreadable config: " (error-message e))) nil))))

(defn version-line (&optional (bi nil))
  "The one-line answer — what `M-x version` echoes and `bedit --version` prints, in whatever
shape the init file's `:version-format` asks for:

    bedit 0.4.1 · started 2026-08-29 09:12 UTC · built 2026-08-29 06:57 UTC (a5e2405, from source) · brood 0.16.0 (7a3b2917)"
  (render (configured-format) (facts bi)))

;; ---- the *About bedit* block --------------------------------------------------

(defn text (&optional (bi nil))
  "The `*About bedit*` buffer's text: every fact [[facts]] holds, one labelled row each —
including the ones that only matter when something is wrong (the build features, so
`gui`/`jit` present or absent is a fact rather than a guess; a bundle's module count; where
the init file the editor actually read lives).

Unlike [[version-line]] this is NOT user-formatted. A one-line summary is a matter of taste
and worth configuring; the full dump is what you paste into a bug report, and it should look
the same in every report."
  (let (f (facts bi)
        row (fn (label key)
              (let (v (get f key ""))
                (if (= v "") "" (str (string/pad-right label 14) v "\n")))))
    (str "bedit "
      (:bedit f)
      "\n\n"
      (row "built" :built)
      (row "built by" :built-by)
      (row "started" :started)
      (row "uptime" :uptime)
      (row "brood" :brood)
      (row "runtime built" :runtime-built)
      (row "build id" :build-id)
      (row "modules" :modules)
      (str (string/pad-right "features" 14)
        (let (v (:features f)) (if (= v "") "(none)" v))
        "\n")
      (row "config" :config))))

;; ---- the CLI surface ----------------------------------------------------------

(defn version-arg? (args)
  "True when the CLI arguments ask for the version — `--version` or `-V`, the two spellings
every tool answers to.

`main` checks this before anything else, because `bedit --version` has to work with no
display: the machine where someone writes a bug report is exactly the machine where the
window won't open."
  (any? args (fn (a) (includes? ["--version" "-V"] (->string a)))))

;; ---- the commands -------------------------------------------------------------

(defcommand cmd-version
  (m key)
  "Show bedit's version, the Brood runtime under it, and this build's date in the echo
area (M-x version — Emacs's `emacs-version`)."
  (message m (version-line)))

(defcommand cmd-about
  (m key)
  "Open the `*About bedit*` buffer (C-h C-a — Emacs's `about-emacs`): version, build date,
runtime, build features and the init-file path, as a buffer you can copy out of."
  (commands/ed-show-named m "*About bedit*" (text)))
