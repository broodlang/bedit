(defmodule view
  "The editor's view: a pure `(model cols rows) -> render frame`, built from
`std/display.blsp` ops. The bottom two rows are reserved, Emacs-style: a
reverse-video **mode line** (buffer name · status · line:col · which buffer) at
`rows-2`, and the **echo area / minibuffer** at `rows-1`. The text body fills the
remaining `rows-2` rows, offset by the active buffer's `:top` scroll position, and
the region (between point and mark) is drawn reverse-video. No window, no state:
testable as plain data."
  (:use buffer)   ; line text / point + column / region bounds, read to lay out the frame
  (:use model)    ; current-buffer accessors
  (:use complete) ; the completion popup overlay
  (:use display)) ; clear / text / cursor / frame render ops

(defn ed-fit (s w)
  "Clip string `s` to `w` columns (long lines don't wrap — v1 has no h-scroll)."
  (if (> (string-length s) w) (substring s 0 w) s))

(defn ed-spaces (n) (apply str (map (fn (i) " ") (range (max 0 n)))))

(defn ed-fit-pad (s w)
  "Clip or space-pad `s` to *exactly* `w` columns — for a full-width bar (the mode
line) that spans the window, so it visibly grows/shrinks on a horizontal resize."
  (if (> (string-length s) w)
    (substring s 0 w)
    (str s (ed-spaces (- w (string-length s))))))

(defn ed-line-text (buf line)
  "Line `line`'s text without its trailing newline (`buffer-line-at` keeps it)."
  (let (lt (buffer-line-at buf line))
    (if (ends-with? lt "\n") (substring lt 0 (dec (string-length lt))) lt)))

(defn ed-line-ops (buf line top cols bounds)
  "Render op(s) for one buffer line at its screen row. With no active region
(`bounds` nil) that's a single `text` op; when the region `[lo hi]` covers part of
this line, the line is split into up to three ops — pre, the reverse-video region,
post."
  (let (row (- line top)
        vis (ed-fit (ed-line-text buf line) cols))
    (if (nil? bounds)
      [(text row 0 vis)]
      (let (line-start (rope-line->char (buffer-rope buf) line)
            [lo hi] bounds
            n (string-length vis)
            rlo (max 0 (min n (- lo line-start)))
            rhi (max 0 (min n (- hi line-start))))
        (if (>= rlo rhi)
          [(text row 0 vis)]
          (concat
            (if (> rlo 0) [(text row 0 (substring vis 0 rlo))] [])
            [(text row rlo (substring vis rlo rhi) {:reverse true})]
            (if (< rhi n) [(text row rhi (substring vis rhi n))] [])))))))

(defn ed-visible-lines (buf top textrows cols bounds)
  "`text` render ops for the lines visible in a `textrows`-tall window starting at
line `top`, each clipped to `cols` and positioned at its screen row, with the
region (if `bounds` is set) highlighted."
  (let (last-line (min (dec (buffer-line-count buf)) (dec (+ top textrows))))
    (mapcat (fn (line) (ed-line-ops buf line top cols bounds))
      (range top (inc last-line)))))

(defn ed-status-line (m cols rows)
  "The reverse-video mode line (row `rows-2`): the buffer name, the status, the
`line:col` at point, which buffer of how many, then the key hints."
  (let (buf (ed-current-buf m)
        pos (str (inc (buffer-current-line buf)) ":" (buffer-column buf)))
    (text (- rows 2)
      0
      (ed-fit-pad (str " " (buffer-name buf) "  —  " (get m :status) "  —  " pos
                       "  —  buf " (inc (get m :current)) "/" (count (get m :buffers))
                       "  —  C-x C-s save · C-x b switch · C-x C-c quit") cols)
      {:reverse true})))

(defn ed-echo-line (m cols rows)
  "The bottom row (`rows-1`): the active minibuffer prompt + input if one is open,
else the latest `message`."
  (let (mb (get m :minibuffer))
    (text (dec rows) 0
      (ed-fit (if (nil? mb) (get m :echo) (str (get mb :prompt) (get mb :input))) cols))))

(defn ed-cursor (m cols rows)
  "Place the cursor: at the end of the minibuffer input when one is open, else at
the active buffer's point (screen coords, offset by its `:top`)."
  (let (mb (get m :minibuffer))
    (if (nil? mb)
      (let (buf (ed-current-buf m))
        ;; clamp the column to the window — a long line clips, so the cursor
        ;; must stay on-screen rather than running off the right edge.
        (cursor (- (buffer-current-line buf) (ed-current-top m))
                (min (dec cols) (buffer-column buf))))
      (cursor (dec rows)
        (min (dec cols) (+ (string-length (get mb :prompt)) (string-length (get mb :input))))))))

(defn ed-view (m cols rows)
  "ui-run view (pure): clear, draw the visible buffer lines (region highlighted),
the mode line, the echo area / minibuffer, and place the cursor. The text body is
`rows-2` tall — the bottom two rows are the mode line and echo area."
  (let (buf (ed-current-buf m)
        top (ed-current-top m)
        textrows (- rows 2))
    (apply frame
      (concat [(clear)]
        (ed-visible-lines buf top textrows cols (buffer-region-bounds buf))
        [(ed-status-line m cols rows)
         (ed-echo-line m cols rows)]
        (complete-popup-ops m cols rows)   ; overlays the buffer body when open
        [(ed-cursor m cols rows)]))))
