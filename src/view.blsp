(defmodule view
  "The editor's view: a pure `(model cols rows) -> render frame`, built from
`std/display.blsp` ops. The bottom row is the **echo area / minibuffer**; the rows
above it are the **pane layout** (`std/pane.blsp`): the model's `:layout` tree
is laid out into that body rect, giving one or more panes (each a buffer in its own
sub-rect) separated by dividers. Each pane reserves its bottom row for a reverse-video
**mode line** (buffer name · mode · line:col; the selected pane also shows the status).
Within a pane the buffer is offset to the pane's origin, clipped to its
width, scrolled by the pane's `:top`, and the region (point↔mark) is reverse-video.
No pane IO, no state: testable as plain data.

A single pane fills the whole body, so the lone-pane layout is identical to the
old full-screen one (mode line at `rows-2`, echo at `rows-1`)."
  (:use editor/buffer) ; line text / point + column / region bounds, read to lay out the frame
  (:use model) ; current-buffer accessors, pane buffer + mode name
  (:use panes) ; ed-body-layout — the :layout tree -> pane rects + divider rects
  (:use complete-at-point) ; the completion popup overlay
  (:use completion) ; the shared vertical-menu renderer + faces
  (:use plume) ; the minibuffer completion UI — marginalia annotations + the N/M counter
  (:use projects) ; project-name — the bracketed project label on the mode line
  (:use editor/highlight) ; fontify-runs — the shared span+overlay -> [substring face] tiler
  (:use theme) ; the curated palette + semantic chrome faces (src/theme.blsp)
  (:use statusbar) ; the status-bar segment model + layout + zones + hover tooltip
  (:use ui-kit) ; the widget kit (ui-panel / ui-list) — the context menu is one list
  (:use editor/ui) ; ui-memo — memoised view fragments, one per visible line (ADR-336)
  (:use editor/display)) ; clear / text / cursor / frame / zone-at render ops
;; results/eol-notes and results/eol-note-at (the shared end-of-line annotation) are
;; referenced qualified below — each `mod/name` auto-loads its module.
(sig ed-fit (string int -> string))
(defn ed-fit (s w)
  "Clip string `s` to `w` columns (long lines don't wrap — v1 has no h-scroll)."
  (if (> (string/length s) w) (string/substring s 0 w) s))

(defn ed-fit-pad (s w)
  "Clip or space-pad `s` to *exactly* `w` columns — for a full-width bar (a mode
line) that spans its pane, so it visibly grows/shrinks on a horizontal resize.
Clip first (`ed-fit`), then prelude `pad-right` brings it up to width."
  (string/pad-right (ed-fit s w) w))

(sig ed-line-text (buffer int -> string))
(defn ed-line-text (buf line)
  "Line `line`'s text without its trailing newline (`buffer-line-at` keeps it)."
  (ed-strip-newline (buffer-line-at buf line)))

;; ---- syntax highlighting: tile precomputed spans onto a visible line --------
;; A language mode may supply a `:fontify` service (`text -> [start end face]`
;; spans, the `highlight-spans` shape). When it does, each visible line is painted
;; as coloured `[substring face]` chunks — with the active region's `:reverse` and
;; any bracket-match `overrides` merged into the per-char face — instead of plain
;; text. Spans are lexed ONCE per frame (in `ed-pane-ops`) and tiled here, so the
;; buffer isn't re-lexed per visible line. The view never names a language: it asks
;; the buffer's mode for these services (`ed-mode-service`, src/model.blsp).

;; The chrome faces are the theme's (src/theme.blsp) — kept under these `ed-face-*`
;; names so call sites and tests don't move. The selection is now a background
;; *tint* (`face-region`, a `:bg` only) rather than reverse-video, so syntax
;; colours stay visible under it; `face-hl-line` is a soft surface band, not the
;; old (unresolvable) `:bright-black`.
(def ed-face-bracket-match face-bracket-match) ; the far end of the matched pair
(def ed-face-bracket-here face-bracket-here) ; the pair's end at point
(def ed-face-bracket-error face-bracket-error) ; a lone unmatched bracket
(def ed-face-region face-region) ; the active region (point↔mark)
(def ed-face-hl-line face-hl-line) ; the current line (selected pane, no region)
(defn- ed-line-chunks (vis base spans hl-ranges overrides)
  "`[substring face]` chunks tiling visible substring `vis` (its first char at buffer
offset `base`), via `highlight/fontify-runs`: the lexer `spans` coloured, with the
region/overlay `hl-ranges` (`[lo hi face]`) and the bracket/diagnostic `overrides`
(`[pos face]`, each the one-char range `[pos (inc pos) face]`) merged on top. Overrides
are ordered before `hl-ranges`, so a region/overlay face wins — the old
span→override→hl merge order."
  (fontify-runs vis
    base
    spans
    (append (map overrides (fn (o) (let ([p f] o) [p (inc p) f]))) hl-ranges)))

(defn- ed-fit-cells (s w)
  "Clip `s` to `w` display cells — the tab-free, width-aware clip a laid-out chunk needs
(`ed-fit` clips by character, before layout)."
  (if (> (string/display-width s) w) (string/substring s 0 (string/width->index s w)) s))

(defn- ed-chunks->ops-impl (row x col limit chunks acc)
  "Tail-recursive: `text` ops for `[substring face]` `chunks` laid left-to-right from
screen column `x`, where `col` is the LINE column the next chunk starts at (its tab stops
are the line's, not the chunk's — ADR-342) and `limit` the screen column past which
nothing is painted. Each chunk's tabs are expanded at its column (`string/expand-tabs`)
and it advances `x` by its cell width, so a wide glyph or a tab pushes what follows."
  (if (or (empty? chunks) (>= x limit))
    (reverse acc)
    (let ([s f] (first chunks)
          expanded (ed-fit-cells (string/expand-tabs s col) (- limit x))
          cells (string/display-width expanded))
      (ed-chunks->ops-impl row
        (+ x cells)
        (+ col (string/display-width s col))
        limit
        (rest chunks)
        (cons (if (nil? f) (text row x expanded) (text row x expanded f)) acc)))))

(sig ed-chunks->ops (int int list &optional int int -> list))
(defn ed-chunks->ops (row x chunks &optional (col 0) (limit 100000))
  "`text` ops for `[substring face]` `chunks`, starting at screen column `x` on `row`;
`col` is the line column the first chunk starts at (0 unless the view is h-scrolled) and
`limit` the screen column to clip at."
  (ed-chunks->ops-impl row x col limit chunks '()))

(def ed-bracket-scan 4000) ; max chars each side of point the bracket matcher scans
(def *bracket-cache* nil)
; [rope point result] — one-entry cache. The rope identity changes on every edit and the
; point changes on every cursor move, so this is correct: it hits on idle frames, ticks,
; and blink events where neither changed, and misses (recomputes) after any edit or motion.

(defn ed-bracket-overrides (buf)
  "`[pos face]` overrides for the bracket pair adjacent to point, via `buf`'s mode
`:bracket-match` service: the matched pair in the match face, a lone unmatched bracket
in the error face, or `()` when there's no service or no bracket at point. The match is
sought within a `ed-bracket-scan`-char window each side of point (not the whole
buffer), so a deep point in a large file costs O(window), not O(point); a partner
beyond the window is treated as not found, and a window-clipped `:unmatched` is
suppressed (no false red) rather than scanning the rest of the buffer."
  (let (bm (ed-mode-service buf :bracket-match))
    (if (nil? bm)
      '()
      (let (rope (buffer-rope buf)
            pt (buffer-point buf)
            c *bracket-cache*)
        (if (and c (= (nth c 0) rope) (= (nth c 1) pt))
          (nth c 2)
          (let (n (buffer-length buf)
                lo (math/max 0 (- pt ed-bracket-scan))
                hi (math/min n (+ pt ed-bracket-scan))
                clipped (or (> lo 0) (< hi n))
                r (bm (text/slice rope lo hi) (- pt lo))
                result (cond
                         (nil? r) '()
                         (= (second r) :unmatched)
                           (if clipped '() (list [(+ lo (first r)) ed-face-bracket-error]))
                         ;; The two ends get DIFFERENT faces, so the solid block always
                         ;; means "the other end": the bracket at point (the one just left
                         ;; of the cursor, else under it — the matcher's own adjacency
                         ;; rule) takes an underline accent the cursor sits on, its partner
                         ;; the block. One glance answers which end of the pair you are at.
                         :else
                           (let (relpt (- pt lo)
                                 a (first r)
                                 b (second r)
                                 adj (if (or (= a (dec relpt)) (= a relpt)) a b)
                                 far (if (= adj a) b a))
                             (list [(+ lo adj) ed-face-bracket-here]
                               [(+ lo far) ed-face-bracket-match]))))
            (def *bracket-cache* [rope pt result])
            result))))))

(def ed-face-diagnostic {:underline true}) ; merged onto the token's syntax face
(defn- ed-word-end (text i)
  (if (and (< i (string/length text)) (complete-word-char? (string/char-at text i)))
    (ed-word-end text (inc i))
    i))

(defn- ed-diag-span-end (text off)
  "End offset (exclusive) of the run to underline at `off`: the word at `off` if it's
on a word char, else just that one cell (so a diagnostic on a delimiter marks 1 col)."
  (if (and (< off (string/length text)) (complete-word-char? (string/char-at text off)))
    (ed-word-end text off)
    (inc off)))

(sig ed-diagnostic-overrides (model buffer int int -> any))
(defn ed-diagnostic-overrides (m buf top vrows)
  "`[pos ed-face-diagnostic]` overrides underlining each diagnostic's token on the
`vrows` lines from `top` — the pane's viewport — from the model's line index
(`:diag-by-line`, `model/ed-diag-index`); `()` when there are none. Per VISIBLE line, not
per diagnostic: this runs every frame, and a large file's checker output (thousands of
findings) must cost the frame nothing beyond the lines on screen. Reads only each such
line's text (`buffer-line-at`), never the whole buffer; the word a diagnostic marks never
crosses a newline, so the per-line span end matches the old whole-text one. Lines past
EOF (stale between rechecks) are skipped, so a deleted line can't index out of range."
  (let (index (or (:diag-by-line m) {})
        n (buffer-line-count buf)
        end (math/min n (+ top vrows)))
    (if (empty? index)
      '()
      (mapcat (range (math/max 0 top) (math/max 0 end))
        (fn (line)
          (let (ds (get index line))
            (if (nil? ds)
              '()
              (let (bol (text/line->char (buffer-rope buf) line)
                    lt (buffer-line-at buf line))
                (mapcat (seq/keep ds (fn (d) (:col d)))
                  (fn (col)
                    (let (col0 (dec col)
                          end (ed-diag-span-end lt col0))
                      (map (range col0 end) (fn (p) [(+ bol p) ed-face-diagnostic])))))))))))))

;; ---- highlight ranges: the region + transient overlays ----------------------

(defn ed-hl-ranges (m buf selected?)
  "The highlight ranges `[lo hi face]` to paint over `buf` in a pane: the active region
(point↔mark, a `:bg` tint); and the model's transient `:overlays` (isearch / query-replace
matches), gated to the selected pane. Order is priority (the tiler merges later-wins):
region then overlays. (The hl-line current-line highlight is NOT a char range — it's a
full-width `rect` band painted by `ed-hl-line-band`, so it covers the whole line, not just
its text.)"
  (let (region-b (buffer-region-bounds buf)
        region (when region-b (list [(first region-b) (second region-b) ed-face-region]))
        overlays (if selected?
                   (map (or (:overlays m) '()) (fn (o) [(:start o) (:end o) (:face o)]))
                   '()))
    (append region overlays)))

(defn- ed-hl-line-band (m pane buf top x y w gw text-h rows hscroll)
  "The hl-line current-line highlight as `rect` bands behind the line at point: a 1-row
band per row the line occupies (`ed-rows-line-rows` — one for
an unwrapped line, every continuation row of a wrapped one, as Emacs highlights the whole
logical line), spanning the pane's **text** area — from the text column (past the gutter
`gw`, edit margin included) to the right edge — so the highlight starts at the cursor and
never reaches into the gutter/fringe left of it (Emacs `hl-line-mode`, sans the fringe).
Painted only on the selected pane with `:hl-line` on and **no** active region, and only
for rows on screen. `()` otherwise. Pane-body coords (the region's, for a zoomed pane);
drawn before the text so it sits behind it."
  (if (and (:hl-line m) (:selected pane) (nil? (buffer-region-bounds buf)))
    (let (vrows (math/max 1 text-h))
      (seq/keep (ed-rows-line-rows rows top (buffer-current-line buf) hscroll)
        (fn ([k from to])
          (when (and (>= k 0) (< k vrows))
            (rect (+ y k) (+ x gw) (math/max 0 (- w gw 1)) 1 ed-face-hl-line)))))
    '()))

(sig ed-region-eol-bands (buffer int int int int int int int (or nil vector) -> list))
(defn- ed-region-eol-bands (buf top text-h x y w gw hscroll rows)
  "Region-selection bands filling each fully-selected line's end-of-text → right-edge gap,
so an empty or short line whose newline lies inside the region shows the selection through
end-of-line (Emacs region highlighting). The char-range region tint (`ed-hl-ranges`) only
paints actual text; this is its full-width counterpart — the same relationship
`ed-hl-line-band` has to the per-line cursor. `()` when no region is active. Coords mirror
`ed-pane-body-ops`: pane-body cells, the text `gw` in from `x`. The band sits on the line's LAST row (`ed-rows-line-rows`), after that row's text."
  (let (region-b (buffer-region-bounds buf))
    (if (nil? region-b)
      '()
      (let (rope (buffer-rope buf)
            lo (first region-b)
            hi (second region-b)
            n-lines (buffer-line-count buf)
            vh (math/max 1 text-h)
            tw (math/max 1 (- (dec w) gw)) ; text width (past the gutter)
            text-x (+ x gw) ; col where the text starts
            last-line (math/min (dec n-lines) (dec (+ top vh))))
        (fold (range top (inc last-line))
          '()
          (fn (acc line)
            (let (bol (text/line->char rope line)
                  line-len (string/length (ed-line-text buf line))
                  eol (+ bol line-len)
                  ;; the newline ending this line is selected → fill to the edge
                  newline-selected (and (< line (dec n-lines)) (<= lo eol) (< eol hi))
                  last-row (last (ed-rows-line-rows rows top line hscroll)))
              (if (or (not newline-selected) (nil? last-row) (>= (first last-row) vh))
                acc
                (let ([k row-from _] last-row
                      from (+ bol (math/min row-from line-len))
                      ;; the row's text width, measured from the LINE's column (its tabs)
                      endcol (- (string/display-width (text/slice rope bol eol))
                               (string/display-width (text/slice rope bol from)))
                      bw (- tw endcol))
                  (if (<= bw 0)
                    acc
                    (cons (rect (+ y k) (+ text-x endcol) bw 1 ed-face-region) acc)))))))))))

;; ---- one pane's body (a buffer clipped into a sub-rect at origin x,y) -------
;; Render ops carry absolute screen coordinates, so a pane simply offsets every
;; op by its rect's origin `(x, y)` and clips text to its width `w`.

(sig ed-slice-ops (buffer int int int int any any any int (or nil int) -> any))
(defn ed-slice-ops (buf line row x w hl-ranges spans overrides from to)
  "Render op(s) for the chars `[from, to)` of buffer `line` on screen row `row`, in a
text area starting at column `x` and `w` wide — `to` nil for the rest of the line. The
one row painter: an unwrapped pane's row is `[hscroll, len)` of its line, a wrapped
pane's a segment of it. With neither `:fontify` `spans` nor any highlight range it's a
single plain `text` op; otherwise coloured `[substring face]` chunks (the syntax spans +
highlight ranges + bracket `overrides` merged), tiled from the slice's absolute `base`
offset. Tabs are expanded to the LINE's stops (ADR-342): the slice is laid out from the
display column its first character sits at (`from-col`), so a chunk mid-line tabs where
the whole line would, and the frontend never sees a raw tab."
  (let (full (ed-line-text buf line)
        len (string/length full)
        h (math/min from len)
        end (if (nil? to) len (math/min to len))
        from-col (if (= h 0) 0 (string/display-width (string/substring full 0 h)))
        vis (ed-fit (string/substring full h (math/max h end)) w)
        base (+ (text/line->char (buffer-rope buf) line) h))
    (if (and (nil? spans) (empty? hl-ranges))
      [(text row x (ed-fit-cells (string/expand-tabs vis from-col) w))]
      (ed-chunks->ops row
        x
        (ed-line-chunks vis base (or spans '()) hl-ranges overrides)
        from-col
        (+ x w)))))

(sig ed-line-ops (buffer int int int int int any any any int -> any))
(defn ed-line-ops (buf line top x y w hl-ranges spans overrides hscroll)
  "Render op(s) for buffer `line` at its screen row `y + (line - top)` inside a pane whose
text area starts at column `x`, width `w`, scrolled `hscroll` characters left — the
unwrapped pane's row: `ed-slice-ops` over `[hscroll, end)` (long lines scroll, not wrap)."
  (ed-slice-ops buf line (+ y (- line top)) x w hl-ranges spans overrides hscroll nil))

(sig ed-visible-lines (buffer int int int int int any any any int -> any))
(defn ed-visible-lines
  (buf top textrows x y w hl-ranges spans overrides hscroll &optional (memo? false) (rows nil))
  "`text` ops for the rows of a `textrows`-tall pane whose text area starts at `(x, y)`
and is `w` wide: one buffer line per row from line `top`, scrolled `hscroll` columns
left — or, with a row table `rows` (`panes/ed-pane-rows`, a wrapped buffer), one
`[line from to]` segment per row. `hl-ranges` `[lo hi face]` highlight the
region/overlays, `spans` syntax-colour (with `overrides`).

With `memo?`, each row is a memoised fragment (`editor/ui/ui-memo`, ADR-336) keyed by
its screen cell `[:line x row]`: its ops are reused from the previous turn while the
rope, the line, the slice, the width, the span band and the highlights are `=` — all of
them values the model keeps between turns, so a cursor blink, a mouse move or a motion
that touches no bracket re-renders no line at all. Off (the default) outside the loop
and for a scaled pane, whose ops are transformed after this."
  (let (rope (buffer-rope buf)
        row-op (fn (k line from to)
                 (if memo?
                   (ui-memo [:line x (+ y k)]
                     [rope line w from to spans hl-ranges overrides]
                     (fn () (ed-slice-ops buf line (+ y k) x w hl-ranges spans overrides from to)))
                   (ed-slice-ops buf line (+ y k) x w hl-ranges spans overrides from to))))
    (if (nil? rows)
      (let (last-line (math/min (dec (buffer-line-count buf)) (dec (+ top textrows))))
        (mapcat (range top (inc last-line))
          (fn (line) (row-op (- line top) line hscroll nil))))
      (mapcat (range (math/min textrows (count rows)))
        (fn (k) (let ([line from to] (nth rows k)) (row-op k line from to)))))))

;; ---- a pane: its buffer body + its mode line --------------------------------

;; `ed-pane-buf` / `ed-zoom-ratio` live in `panes` (this module `(:use panes)`).

(defn- ed-apprun-label (m)
  "The app-run telemetry chip: `▶ 18p · 1.0 MB · 12s` while a C-c r app runs (procs ·
memory · uptime, live per heartbeat), `▶ running` before the first reading, `\"\"`
when no app is running (`:apprun` is dropped on exit). Click opens *Run*."
  (if (nil? (:apprun m))
    ""
    (let (s (get-in m [:apprun :stats]))
      (if (nil? s)
        "▶ running"
        (str "▶ "
          (:procs s)
          "p · "
          (ed-reds-human (or (:reductions s) 0))
          " reds"
          " · "
          (math/quot (or (:uptime-ms s) 0) 1000)
          "s")))))

(defn- ed-diag-label (m)
  "`  ⚠N` when the model carries N cached diagnostics, else `\"\"` — appended to the
selected pane's mode line so the warning count is always visible."
  (let (n (count (or (:diagnostics m) '())))
    (if (= n 0) "" (str "  ⚠" n))))

(defn- ed-project-label (m)
  "`  [name]` of the model's current project (`:project-root`'s directory name), or
`\"\"` when there is none — shown on the selected pane's mode line."
  (let (root (:project-root m))
    (if (nil? root) "" (str "  [" (project-name root) "]"))))

(defn- ed-edit-state-label (m)
  "The typing-mode name for the modal `:edit-state` — `NORMAL` / `INSERT` /
`VISUAL` — spelled out on the selected pane's mode line, or `\"\"` under the Emacs
profile (which has no modal state). Named rather than abbreviated (`<N>`): which
mode you're in decides what every key does, so it's the one thing on the bar that
should never need decoding."
  (cond
    (= (:edit-state m) :insert) "INSERT"
    (= (:edit-state m) :visual) "VISUAL"
    (= (:edit-state m) :normal) "NORMAL"
    :else ""))

(defn- ed-edit-state-face (m)
  "The mode chip's colour: insert green (you are typing — the state where keys go
into the buffer), visual mauve (a region is live), normal the plain bar colour."
  (cond
    (= (:edit-state m) :insert) {:fg *green* :bold true}
    (= (:edit-state m) :visual) {:fg *mauve* :bold true}
    :else {:fg *subtext* :bold true}))

(sig ed-scroll-pct (int int int -> string))
(defn ed-scroll-pct (top vrows linecount)
  "Emacs-style scroll-position label for the mode line: `All` when the whole buffer
fits, `Top` at the start, `Bot` when the last line shows, else `NN%` — the fraction of
lines scrolled above the window."
  (cond
    (and (= top 0) (>= (+ top vrows) linecount)) "All"
    (= top 0) "Top"
    (>= (+ top vrows) linecount) "Bot"
    :else (str (math/quot (* 100 top) (math/max 1 (- linecount vrows))) "%")))

(defn- ed-layer-segments (m buf)
  "The buffer's layer `:modeline` contributions (`model/ed-layer-modeline-segments`) lifted
into segments via `statusbar/coerce-seg` — a layer may return a `seg` map or a bare string
(auto id + a `—` separator), so per-buffer mode chrome keeps working alongside the git
segments. `map` over the contributions with their index gives each string a stable id."
  (let (raw (ed-layer-modeline-segments m buf))
    (map (range (count raw)) (fn (i) (coerce-seg (nth raw i) i)))))

(defn- ed-presence-label (m pane)
  "The modeline presence chip for a SHARED buffer: who else is here, by name, plus the
follow target while following ('shared: alice, bob → alice'). \"\" on an unshared
buffer, so the segment is dropped — gated on the slot's `:shared?` flag, NOT mere
hostedness: under the every-buffer flip every live slot is process-backed, but only
collab-shared ones have presence. A registry-hosted slot (`:registry?` — a buffer shared
with another FRAME of this editor) is not a collaboration either: no chip."
  (let (bi (get-in pane [:payload :buffer])
        sh (get-in m [:hosted bi]))
    (if (or (nil? (:shared? sh)) (:registry? sh))
      ""
      (let (names (or (:names sh) {})
            cursors (or (:cursors sh) {})
            who (map (%map-pairs cursors) (fn (kv) (get names (first kv) "guest")))
            f (:follow m))
        (str "  —  shared: "
          (if (empty? who) "just you" (string/join who ", "))
          (if f (str " → " (:name f)) ""))))))

;; The findings chip's three readers. They live here, off the buffer's own annotation,
;; rather than in `diagnostics` — the bar is drawn every frame and must not load a deferred
;; module to do it (the same rule the attached-node chip follows). `diagnostics` owns the
;; PANE; the count is just a read of what the margin already shows.

(defn ed-diagnostics-counts (buf)
  "`[errors warnings]` for `buf` — what its findings are, by severity."
  (let (ds (mapcat (%map-pairs (results/diagnostic-lines buf)) (fn ([_ v]) v)))
    [(count (seq/filter ds results/diagnostic-error?))
      (count (seq/reject ds results/diagnostic-error?))]))

(defn ed-diagnostics-label (buf)
  "The findings chip — `✗ 2 ⚠ 5`, either half dropped when it is zero, `\"\"` when clean."
  (let ([errors warnings] (ed-diagnostics-counts buf))
    (string/trim
      (str (if (> errors 0) (str "✗ " errors " ") "")
        (if (> warnings 0) (str "⚠ " warnings) "")))))

(defn ed-diagnostics-face (buf)
  "Red when something will not compile, amber when it is only advice — the margin's colours."
  (let ([errors _] (ed-diagnostics-counts buf))
    (if (> errors 0) {:fg *red* :bold true} {:fg *yellow*})))

(defn ed-diagnostics-tooltip (buf)
  "The chip's hover: the counts spelled out, and what a click does."
  (let ([errors warnings] (ed-diagnostics-counts buf))
    [(str errors " " (if (= errors 1) "error" "errors") ", " warnings
       " " (if (= warnings 1) "warning" "warnings"))
      "click for the list (C-c !)"]))

(defn ed-beam-node (m)
  "The node one of bedit's sessions is attached to, or nil when they are all on their own.

Asked of `attach`, whose table of sessions is the one place that knows which they are —
a chip that quietly stopped naming a third language's node would be the same failure this
feature exists to prevent. Safe from the view, which is drawn every frame: the table is
plain data and its backends are symbols resolved only when one is actually asked to
attach, so nothing here loads a BEAM agent."
  (attach/any-attached m))

(defn ed-beam-node-label (m)
  "The attached-node chip, or `\"\"` when this editor is on its own runtime."
  (let (node (ed-beam-node m)) (if (nil? node) "" (str "⇄ " node))))

(sig ed-statusbar-segments (model pane buffer -> any))
(defn ed-statusbar-segments (m pane buf)
  "The ordered status-bar segments for `pane`: an always-on left group (buffer name, mode,
scroll %, line:col), then — on the **selected** pane only — the model status, the modal edit
state, the project, the diagnostic count, the cached git segments (`:git-segments`, built off
the loop by the idle beat), and the buffer's layer segments. The one list both
`ed-pane-modeline` (render) and `ed-modeline-segment-at` (mouse hit-test) build from, so a
segment is clickable/hoverable exactly where it's drawn."
  (let (sel (:selected pane)
        h (nth (:rect pane) 3)
        pos (str (inc (buffer-current-line buf)) ":" (buffer-column buf))
        pct (ed-scroll-pct (ed-pane-top pane buf) (math/max 1 (dec h)) (buffer-line-count buf))
        ;; a narrowed pane says so, on the pane itself (narrowing is per-pane) — visible,
        ;; which is the whole point of it not being a hidden buffer-global mode
        narrow? (not (nil? (get-in pane [:payload :restrict])))
        core (append
               (list (seg :name (str "  " (if (read-only? buf) "RO " "") (buffer-name buf)))
                 ; leading pad
                 (seg :mode (str "(" (ed-buf-mode-name buf) ")") {:sep "  "})
                 (seg :scroll pct {:sep "  —  "})
                 (seg :pos pos {:sep "  "}))
               (if narrow? (list (seg :narrow "⊸ Narrowed" {:sep "  —  "})) '())
               ;; a wrapping buffer says so too (visual-line-mode is per buffer)
               (if (ed-wrap? buf) (list (seg :wrap "↩ Wrap" {:sep "  "})) '())
               ;; a zoomed pane shows its size as a chip, and the chip is the way back: one
               ;; click and the pane is at the window's size again (`C-x C-0` from the keys).
               ;; On the pane itself — a zoom is per pane, like the narrowing above — so a
               ;; split reads which side is zoomed, and the click lands on that side
               (let (zoom (get-in pane [:payload :zoom]))
                 (if (nil? zoom)
                   '()
                   (list (seg :zoom
                           (str "⌕ " (:px zoom) "px")
                           {:sep "  —  "
                            :face {:fg *peach*}
                            :on-click 'appearance/cmd-text-scale-reset
                            :cursor :pointer
                            :tooltip (fn (mm)
                                       [(str "zoomed to " (:px zoom) " px — this pane only")
                                         "click for 100% (C-x C-0) · Ctrl+wheel / C-x C-= C-- to step"])})))))
        ;; the non-interactive extras reuse the existing label helpers (which bake their own
        ;; leading separator), so they need no `:sep`; empty ones are dropped.
        extras (seq/filter
                 (list (seg :status (if (= "" (:status m)) "" (str "  —  " (:status m))))
                   ;; the typing-mode chip (vim): NORMAL / INSERT / VISUAL, coloured
                   ;; by state — insert is green so "I am typing into the buffer" is
                   ;; readable at a glance, not decoded from a letter
                   (seg :edit-state
                     (ed-edit-state-label m)
                     {:sep "  —  "
                      :face (ed-edit-state-face m)
                      :tooltip (fn (mm)
                                 (list (str "typing mode: " (ed-edit-state-label mm))
                                   "i / a / o enter INSERT · ESC returns to NORMAL"
                                   "v enters VISUAL · C-x v v leaves vim for emacs keys"))})
                   (seg :project (ed-project-label m))
                   (seg :presence (ed-presence-label m pane))
                   (seg :diag (ed-diag-label m))
                   ;; the live app-run chip (C-c r): procs + memory, refreshed by the
                   ;; heartbeat; click opens *Run*. Present only while an app runs
                   ;; (`:apprun` is dropped on exit), so apprun is loaded by then.
                   (seg :apprun
                     (ed-apprun-label m)
                     {:sep "  —  "
                      :face {:fg *teal*}
                      :on-click 'apprun/cmd-run-show
                      :tooltip (fn (mm)
                                 (let (s (get-in mm [:apprun :stats])
                                       p (get-in mm [:apprun :peak]))
                                   [(str "app running · "
                                      (:procs s)
                                      " procs · "
                                      (ed-reds-human (or (:reductions s) 0))
                                      " reductions · up "
                                      (math/quot (or (:uptime-ms s) 0) 1000)
                                      "s")
                                     (str "memory "
                                       (humanize/byte-size (or (:memory s) 0))
                                       " (at last receive)")
                                     (str "peak "
                                       (or (:procs p) 0)
                                       " procs · "
                                       (ed-reds-human (or (:reductions p) 0))
                                       " reds")
                                     "click for *Run*"]))})
                   ;; FINDINGS: `✗ 2 ⚠ 5`, clickable. The margin can only mark lines that
                   ;; are on screen, so a file with one error forty lines down looks exactly
                   ;; like a clean one; the count is the part of the answer that does not fit
                   ;; in a margin. Read through `results/diagnostic-lines` — the same
                   ;; annotation the margin reads, so the bar and the marks cannot disagree —
                   ;; which is also why this needs nothing from the deferred `diagnostics`
                   ;; module to DRAW. Only the click loads it.
                   (seg :diagnostics
                     (ed-diagnostics-label buf)
                     {:sep "  —  "
                      :face (ed-diagnostics-face buf)
                      :on-click 'diagnostics/cmd-diagnostics
                      :tooltip (fn (_) (ed-diagnostics-tooltip buf))})
                   ;; ATTACHED: the node every Elixir evaluation is now going to. Red, and
                   ;; on the bar of whatever you are editing rather than only in the
                   ;; *BEAM Processes* buffer, because the whole risk of the feature is
                   ;; forgetting you are on somebody else's VM.
                   (seg :beam-node
                     (ed-beam-node-label m)
                     {:sep "  —  "
                      :face {:fg *red* :bold true}
                      :on-click 'beam/cmd-beam-detach
                      :tooltip (fn (mm)
                                 [(str "attached to " (or (ed-beam-node mm) "?"))
                                   "every Elixir evaluation and observation runs THERE"
                                   "click to detach (M-x beam-detach)"])}))
                 (fn (s) (not (= "" (:text s))))))
    (if sel
      (append core extras (or (:git-segments m) '()) (ed-layer-segments m buf))
      core)))

(defn ed-pane-modeline (m pane buf)
  "A pane's mode line as render ops: a solid bar on the bottom row of its rect, laid out from
its **segments** (`ed-statusbar-segments`) by `statusbar/statusbar-layout` — buffer name ·
mode · scroll% · line:col, plus the selected pane's status / diagnostics / git. The selected
pane's bar is `face-modeline` (a raised surface), an unselected pane's the dimmer
`face-modeline-inactive`; the segment under the pointer (`:hover`, on whichever pane's bar
holds it) gets a subtle hover pill. Thin **top + bottom hairlines** (`face-border`, GUI only) rule the bar off
as a distinct band — dark-UI chrome is anchored by a 1px border, not a shadow (docs/ui-chrome.md)."
  (let ([x y w h] (:rect pane)
        sel (:selected pane)
        row (+ y (dec h))
        base (if sel face-modeline face-modeline-inactive)
        ;; the hover pill on THIS bar only when the pointer is on it: the hover names its cell,
        ;; and a chip id (`:zoom`) repeats across a split's bars
        hover (:hover m)
        hovered-id (if (and hover (= (:row hover) row) (>= (:col hover) x) (< (:col hover) (+ x w)))
                     (:id hover)
                     nil)
        segments (ed-statusbar-segments m pane buf)
        ;; the memo's deps are the segments WITHOUT their closures (a `:tooltip` fn, an
        ;; `:on-click` fn are fresh objects every turn and never `=`): what the LAYOUT
        ;; reads is id, text, face and separator — the zones and tooltips are recomputed
        ;; from the live segments at hit-test time, not from these ops
        seg-deps (map segments (fn (s) [(:id s) (:text s) (:face s) (:sep s) (:cursor s)]))
        gui? (:gui m))
    ;; The layout is a memoised fragment (ADR-336) of the segments and the bar's
    ;; geometry: the segments are plain data rebuilt each turn and `=` across turns until
    ;; something on the bar changes, so the layout — the expensive half — is reused.
    (ui-memo [:modeline x row]
      [seg-deps x row w base hovered-id gui?]
      (fn ()
        (append (:ops (statusbar-layout segments x row w base hovered-id gui?))
          ;; top + bottom hairlines frame the bar as a distinct band (GUI only); both sit
          ;; flush on the row's edges — not over the text — so the labels keep their full
          ;; height.
          (if gui?
            [(frect (* 1.0 x) (* 1.0 row) (* 1.0 w) *modeline-hairline* face-border)
              ; top edge
              (frect (* 1.0 x)
                (- (* 1.0 (inc row)) *modeline-hairline*)
                (* 1.0 w)
                *modeline-hairline*
                face-border)] ; bottom edge
            []))))))

;; ---- status-bar hit-testing + hover tooltip (the mouse side) ----------------
;; The mouse handler recomputes the *selected* pane's segment layout — the same one the view
;; drew — and hit-tests the pointer against its zones, exactly as `ed-menu-hit` recomputes the
;; menu card's rect. So a segment is hoverable / clickable precisely where its glyphs are.

(defn ed-modeline-pane-at (m cols rows col row)
  "The pane whose MODE LINE holds screen cell `[col row]`, or nil. Every pane's bar is live,
not just the selected one's: the per-pane chips (a zoom, a narrowing) sit on the pane they
describe, so their click must land there."
  (seq/find (:panes (ed-body-layout m cols rows))
    (fn (p)
      (let ([x y w ph] (:rect p))
        (and (= row (+ y (dec ph))) (>= col x) (< col (+ x w)))))))

(defn ed-modeline-segment-at (m cols rows col row)
  "The status-bar segment under screen cell `[col row]` on whichever pane's mode line holds
it, or nil (no mode line there, or a gap between segments). What hover (`:move`) and click
hit-test against — the caller reads the returned segment's `:on-click` / `:tooltip`."
  (let (pane (ed-modeline-pane-at m cols rows col row))
    (if (nil? pane)
      nil
      (let ([x y w ph] (:rect pane)
            buf (ed-pane-buf m pane)
            segs (ed-statusbar-segments m pane buf)
            laid (statusbar-layout segs x (+ y (dec ph)) w face-modeline nil (:gui m))
            z (zone-at (:zones laid) col row))
        (if (nil? z) nil (seg-by-id segs (:id z)))))))

(defn ed-modeline-click (m cols rows col row)
  "If a status-bar segment with an `:on-click` command sits under press `[col row]`, run that
command (resolved late via `reflect/eval`, like a keymap binding — `(m key) -> m`) and return the new
model; else nil. The mouse handler tries this before its normal left-press handling, so a
click on the branch / git indicator opens `*git-status*` instead of moving point. The pane
under the click is SELECTED first, so a command that acts on the current pane (the zoom
chip's `text-scale-reset`) acts on the one whose bar was clicked."
  (let (s (ed-modeline-segment-at m cols rows col row))
    (if (and s (:on-click s))
      ((reflect/eval (:on-click s))
        (dissoc (ed-select-pane-at m cols rows row col) :hover) ; dismiss the tooltip as the click fires
        :mouse)
      nil)))

(defn ed-modeline-hover (m cols rows col row)
  "Fold a bare pointer move over the status bar into `:hover` (`{:id :col :row}`, read by the
renderer to draw the hover pill + tooltip): set it to the segment under `[col row]`, or clear
it when the pointer is off any segment. Never touches scroll — a hover must not snap the view
back to point (the GUI emits a `:move` per cell crossed)."
  (let (s (ed-modeline-segment-at m cols rows col row))
    (cond
      (and s (seg-interactive? s)) (assoc m :hover {:id (:id s) :col col :row row})
      (:hover m) (dissoc m :hover)
      :else m)))

(sig ed-results-link-at (map int int int int -> (or nil vector)))
(defn ed-results-link-at (m cols rows row col)
  "A left-click hit-test for the RESULTS-buffer link-only-click rule: `[:link loc]`
when cell `(row,col)` is on a clickable line of a results buffer (its mode has
`:line-loc` and that line resolves), `[:inert]` when a results buffer but a non-link
line (so the click does NOTHING), or `nil` for an ordinary buffer/pane (normal
click). Same `:line-loc` predicate as the pointer cursor + underline, so the click
matches exactly what reads as a link."
  (let (pane (ed-pane-at m cols rows row col))
    (if (nil? pane)
      nil
      (let (buf (ed-pane-buf m pane)
            svc (ed-mode-service buf :line-loc))
        (if (nil? svc)
          nil
          (let ([px py pw ph] (:rect pane)
                line0 (ed-pane-line-at pane buf row)
                in-text (and line0 (< row (+ py (dec ph))))
                loc (when in-text (svc buf line0)))
            (if (nil? loc) [:inert] [:link loc])))))))

(sig ed-link-hover (map int int int int -> map))
(defn ed-link-hover (m cols rows col row)
  "Fold a bare pointer move into `:link-hover` (`{:buffer <pool idx> :line <0-based>}`)
when the cell is over a clickable line of a results buffer (its mode has `:line-loc`
and resolves that line), else clear it. Drives the subtle hover highlight + the
pointer cursor's per-line target; never touches scroll."
  (let (pane (ed-pane-at m cols rows row col))
    (if (nil? pane)
      (if (:link-hover m) (dissoc m :link-hover) m)
      (let (buf (ed-pane-buf m pane)
            svc (ed-mode-service buf :line-loc)
            [px py pw ph] (:rect pane)
            line0 (ed-pane-line-at pane buf row)
            in-text (and line0 (< row (+ py (dec ph)))))
        (if (and svc in-text (svc buf line0))
          (assoc m :link-hover {:buffer (get-in pane [:payload :buffer]) :line line0})
          (if (:link-hover m) (dissoc m :link-hover) m))))))

(defn ed-modeline-tooltip-ops (m cols rows)
  "The hovered status-bar segment's tooltip as render ops, or `()` — a small bordered card
floated just above the selected pane's mode line at the hover column. Reads `:hover`
(`{:id :col :row}`, set by the mouse handler); resolves the segment's `:tooltip` against `m`."
  (let (hover (:hover m))
    (if (nil? hover)
      '()
      ;; the hovered pane's bar (the hover names its own cell), the selected one's failing that
      (let (pane (or (ed-modeline-pane-at m cols rows (:col hover) (:row hover))
                   (ed-selected-pane (:panes (ed-body-layout m cols rows))))
            [x y w ph] (:rect pane)
            mrow (+ y (dec ph))
            buf (ed-pane-buf m pane)
            segs (ed-statusbar-segments m pane buf)
            ops (statusbar-tooltip-ops segs (:id hover) m (:col hover) mrow cols rows (:gui m)))
        (or ops '())))))

;; `ed-gutter-shown?` / `ed-gutter-width` (the gutter *geometry*) live in `panes`
;; alongside the rest of the pane-layout geometry — both the view and mouse
;; hit-testing need them, and `view` already `(:use panes)`. Only the gutter
;; *rendering* (`ed-gutter-ops`, below) stays here.

;; How many of the gutter's trailing columns the recessed surface leaves *unpainted*, so the
;; cell's separator space falls on the edit background — a slight light gap between the line
;; number and the text (not a heavy dark band). The gutter cell already reserves that space.
(def *gutter-edit-margin* 1)

(def- ed-gutter-bar-width 0.28) ; the change-bar's width in cells (a thin diff-hl rule)
(defn- ed-gutter-line-ops (row bx result gui?)
  "Render ops for one gutter cell `result`: its chunks (normalised via
`model/gutter-cell-chunks`) laid left-to-right from column `bx` — so a gutter can carry a
change bar *and* the dim line number in one cell (diff-hl). A `[:bar colour]` chunk is a git
change bar: in the GUI a thin **full-cell-height** `frect` (a CONTINUOUS solid rule — a
half-block glyph leaves a gap at the 1.4 line-height, reading as a dashed TUI bar), in the
terminal the `▌` half-block. Other chunks are `[text face]`. The web mirror decodes the same
chunks (`web-gutter-html`)."
  (reverse (second (fold (gutter-cell-chunks result)
                     [bx '()]
                     (fn (st chunk)
                       (let (col (first st) ops (second st) [t f] chunk)
                         (if (= t :bar)
                           [(+ col 1)
                             (cons (if gui?
                                     (frect (+ col 0.0)
                                       (+ row 0.0)
                                       ed-gutter-bar-width
                                       1.0
                                       {:bg f})
                                     (text row col "▌" {:fg f}))
                               ops)]
                           [(+ col (string/length t)) (cons (text row col t f) ops)])))))))

(defn ed-gutter-ops (cells bx by gui? &optional (memo? false))
  "Render ops for prebuilt gutter `cells` (one `[text face]` / `[:bar colour]` chunk list
per visible line, from `panes/ed-pane-gutter-cells` — cached across frames, since typing
never changes them), placed at column `bx`, rows from `by`. `gui?` picks the change bar's
rendering (frect vs `▌`). `()` when `cells` is nil (gutter hidden / no service). With
`memo?` the ops are a memoised fragment (ADR-336) — off for a scaled pane, whose ops
are transformed after this."
  (if (nil? cells)
    '()
    ;; A memoised fragment (ADR-336): `cells` is the model's cached vector, the same
    ;; object turn after turn, so the ops are reused until the gutter itself changes.
    (ui-memo (if memo? [:gutter bx by] nil)
      [cells bx by gui?]
      (fn ()
        ;; cons each line's ops + reverse once, NOT `append acc` (which recopies the
        ;; accumulator every visible line — O(rows²) per frame in the gutter).
        (reverse (first (fold cells
                          ['() by]
                          (fn (acc cell)
                            (let ([ops row] acc)
                              [(fold (ed-gutter-line-ops row bx cell gui?)
                                 ops
                                 (fn (a op) (cons op a)))
                                (inc row)])))))))))

;; ---- per-pane scrollbar (rightmost column) ----------------------------------

(def ed-face-scrollbar-thumb face-scrollbar-thumb)

;; A smooth, native-style overlay scrollbar: a rounded `frect` *pill* drawn at sub-cell
;; pixel precision (so its height/position track the scroll fraction continuously, not
;; quantised to whole rows) and alpha-blended at the model's fade `opacity` — hidden at
;; rest, fading in on scroll and out after (`model/ed-scrollbar-wake`). No track.
(defdyn *scrollbar-width* 0.5) ; thumb width in cells (≈ half a cell, a slim modern bar)
(def *scrollbar-pad* 0.12) ; gap from the pane's right edge, in cells
(def *scrollbar-min-thumb* 1.5) ; min thumb height in cells, so it stays grabbable
(defn ed-scrollbar-ops (buf top vh sx sy opacity &optional (track nil))
  "An overlay scrollbar thumb hugging the right edge of column `sx`, over the `track` rows
(the pane's; `vh` when not given) from `sy`: a single rounded `frect` pill sized by the
visible fraction (`vh` lines in view over `buffer-line-count`) and positioned by `top`,
both in **fractional cells** so it moves smoothly. The two heights differ for a zoomed
pane, whose page is fewer, bigger lines than it has window rows. Drawn alpha-blended at `opacity` (0..1) from the fade state
(`model/ed-scrollbar-opacity`). Hidden (`()`) when the buffer fits — nothing to scroll —
or when fully faded out. The reserved column stays regardless (text width already
excludes it), so showing/hiding never reflows text. Hit-testing shares the column
predicate (`panes/ed-scrollbar-hit?`)."
  (let (line-count (buffer-line-count buf))
    (if (or (<= line-count vh) (<= opacity 0.0))
      '()
      (let (total (math/max 1 line-count)
            track (or track vh)
            thumb-h (math/max *scrollbar-min-thumb* (/ (* 1.0 track vh) total))
            maxstart (math/max 0.0 (- track thumb-h))
            denom (math/max 1 (- total vh))
            thumb-y (math/min maxstart (* maxstart (/ (* 1.0 top) denom)))
            ;; hug the right edge: the pill's right side sits `*scrollbar-pad*` cells
            ;; inside the pane edge (sx+1), with the pill `*scrollbar-width*` cells wide.
            x (- (+ sx 1) *scrollbar-width* *scrollbar-pad*))
        [(frect x
           (+ sy thumb-y)
           *scrollbar-width*
           thumb-h
           ed-face-scrollbar-thumb
           opacity
           (/ *scrollbar-width* 2))]))))

(defn- ed-row-cells (cells rows top)
  "The gutter `cells` (one per buffer line from `top`) re-keyed per ROW of a wrapped
pane's table: a line's first row gets its cell, a continuation row an empty one (no
number, as Emacs shows none on a continuation line). `cells` itself when `rows` is nil."
  (if (or (nil? rows) (nil? cells))
    cells
    (into []
      (map rows
        (fn ([line from to])
          (if (and (= from 0) (< (- line top) (count cells))) (nth cells (- line top)) '()))))))

(sig ed-pane-body-ops
  (buffer any int int int int int int any any any int bool (or nil vector) -> any))
(defn- ed-pane-body-ops
  (buf cells top text-h x y w gw hl-ranges spans overrides hscroll gui? rows)
  "The pane's body ops — its optional gutter (`cells`, prebuilt/cached chunk lists) plus
visible buffer lines (or, with a row table `rows`, its wrapped rows) — rendered into the
rect at `[x y]`, `w` wide less the gutter and the scrollbar column. For a zoomed buffer
the rect is the REGION's (origin 0,0, its own cells — `ed-pane-ops` wraps the result in a
`cell-region`), so this never knows about zoom at all."
  (let (cells (ed-row-cells cells rows top))
    (append (ed-gutter-ops cells x y gui? true)
      (ed-visible-lines buf
        top
        text-h
        (+ x gw)
        y
        (math/max 1 (- w gw 1))
        hl-ranges
        spans
        overrides
        hscroll
        true
        rows))))

;; ---- link affordance: pointer cursor + subtle hover over clickable rows ------
;; A results buffer (one whose mode provides a `:line-loc` service — *Tests* / *Run*
;; / *compilation* / *Occur* / *git-status*) makes its actionable rows FEEL like
;; links, universally and with no visible link text: every line that resolves to a
;; source location gets a `:pointer` cursor-zone (the hand), and the one under the
;; pointer (`:link-hover`) a subtle surface highlight. The location itself is off in
;; `:line-loc` (text-parsed or stored), never shown. Click-to-visit is the mode's
;; `:on-click` (`cmd-visit-location`); this is purely the affordance.

(def ed-face-link-hover {:underline true}) ; a hovered link row: a proper font underscore
(defn- ed-link-hover-range (m pane buf)
  "The `[lo hi {:underline true}]` range underlining the hovered clickable line's
TEXT — a proper font underscore (the renderer tucks it under the glyphs by font
metrics), merged into the text like a diagnostic underline. `()` unless this pane
holds the hovered link line."
  (let (hover (:link-hover m))
    (if (or (nil? hover) (not (= (:buffer hover) (get-in pane [:payload :buffer]))))
      '()
      (let (line0 (:line hover))
        (if (>= line0 (buffer-line-count buf))
          '()
          (let (bol (text/line->char (buffer-rope buf) line0)
                line (ed-line-text buf line0)
                ;; underline ONLY the text — skip the leading indent and any trailing
                ;; whitespace, so an indented row underscores its glyphs, not the tab
                indent (- (string/length line) (string/length (string/triml line)))
                end (string/length (string/trimr line)))
            (if (<= end indent) '() (list [(+ bol indent) (+ bol end) ed-face-link-hover]))))))))

(sig ed-pane-link-ops (map pane buffer int int int int int int (or nil vector) int -> any))
(defn- ed-pane-link-ops (m pane buf top text-h x y w gw rows hscroll)
  "The pointer-cursor zones for the pane's clickable visible lines — a `:pointer`
cursor-zone over each row of each line whose `:line-loc` resolves (`ed-rows-line-rows`),
so it reads as a link. (The hover underscore is a text-merged range,
`ed-link-hover-range`, not a zone.) Empty unless the buffer's mode offers `:line-loc`
(ordinary buffers cost one lookup)."
  (let (svc (ed-mode-service buf :line-loc))
    (if (nil? svc)
      '()
      (let (cw (math/max 1 (- w gw))
            col (+ x gw)
            vrows (math/max 1 text-h)
            last-line (math/min (dec (buffer-line-count buf)) (dec (+ top vrows))))
        (mapcat (range top (inc last-line))
          (fn (line0)
            (if (svc buf line0)
              (seq/keep (ed-rows-line-rows rows top line0 hscroll)
                (fn ([k f t]) (when (< k vrows) (cursor-zone col (+ y k) cw 1 :pointer))))
              '())))))))

;; ---- end-of-line notes: derived text shown AT a line -------------------------
;; A buffer may carry `:eol-notes` (see `results/eol-notes`) — derived text anchored
;; to lines, e.g. the tutorial's per-box verdicts. THREE renderers share that one
;; annotation: the margin glyph (modes/gutter-mark-for), the echo row when point is
;; on the line (ed-eol-note-on-line), and here — eros-style ghost text two cells
;; past the line's end: `=> 42` muted, `✓ 42` green, `✗ …` red, `⋯` pending, all
;; dimmed once the text moves and blanked once lines shift (std `annotate` owns that
;; currency). Pure ops over existing `text` — no new display primitive (the
;; keep-the-surface-small rule).

(def *eol-note-max-cols* 64)
;; A ghost note is a GLANCE, not the report. A checker message can run to a couple of
;; hundred columns (`+: expected number, got failure (#failure{:message "…"})`), and drawn
;; from the end of an already-indented line it walked off to the right edge, where the only
;; readable part was the half nobody needed. Capped here, ellipsised by `ui-clip`, and the
;; whole thing is still one keystroke away: the echo row (`results/eol-note-at`) prints the
;; full text whenever point is on the line.

(def face-completion-preview
  ;; The inline completion preview: the SAME dim as a pending note, and not italic. It is
  ;; text you are about to write rather than a remark about your code, so it should read as
  ;; your own line continuing in a lighter hand — italics would make it a different kind of
  ;; thing sitting in the middle of an identifier.
  {:fg *overlay0*})

(defn ed-preview-op (m buf pane-selected? row col avail)
  "The one op for the inline completion preview — the top candidate's remainder painted
immediately after the cursor — or nil.

Painted only for the selected pane, and only while the cached preview still describes the
buffer as it stands (`:completion-preview-at`, the point-and-rope it was computed for).
That guard is the whole difference between a suggestion and a lie: the preview is computed
on the idle beat, so between the keystroke and the recompute the cached one describes text
that has already moved on, and painting it there would put somebody else's word after your
cursor."
  (let (pv (:completion-preview m))
    (when (and pane-selected?
            pv
            (nil? (:minibuffer m))
            (= (:completion-preview-at m) [(buffer-point buf) (buffer-rope buf)])
            (> avail 0))
      (text row col (ui-clip (:text pv) avail) face-completion-preview))))

(defn- ed-eol-note-face (kind stale)
  (cond
    ;; no-answer-yet reads as pending (dim, italic), never as a stale verdict — whether
    ;; the sandbox is still working (:running) or the form isn't finished (:incomplete)
    (results/note-pending? kind) {:fg *overlay0* :italic true}
    (= kind :warn) {:fg *yellow*}
    ;; a derived type sitting at the code it describes — dim and italic, the inlay-hint
    ;; voice, so it never competes with the answer below it for being read first
    (= kind :hint) {:fg *overlay0* :italic true}
    stale {:fg *overlay0*}
    (= kind :pass) {:fg *green*}
    (= kind :fail) {:fg *red*}
    else {:fg *subtext*}))

(sig ed-eol-note-row-ops (any int any int int int int int int -> any))
(defn- ed-eol-note-avail (note room)
  "The columns `note` may take of the `room` left on its row.

A result or a derived type is a GLANCE — a remark about code you can already read — and
capping it at [[*eol-note-max-cols*]] is what keeps the right of the screen legible.

A FAILURE is not a remark, it is the answer, and the cap cost exactly the half worth having:
`** (FunctionClauseError) no function clause matching in String.upcase/1` cut at 64 columns
keeps the words every raise shares and drops the function that raised. So a raise takes the
whole row. It still ends at the pane edge — the full text is one keystroke away in the echo
row, and in `*Diagnostics*` (C-c !), which is where a message too long for any row belongs."
  (if (= (:kind note) :fail) room (math/min room *eol-note-max-cols*)))

(defn- ed-eol-note-row-ops (notes row stale from-col x y gw hcol tw)
  "Ghost-text ops for the notes anchored on ONE line, on screen row `row`, laid out left
to right from the line's display column `from-col` — `hcol` columns of the line sit left
of the row's first cell — each keeping its own face, none painting over another.

A line can carry several (`results/notes-on-line`), and drawing them all at one column is
not a near-miss: `=> bar` and `=> 42` at the same cell render as unreadable mush, which is
what this fold exists to make unrepresentable. Each note advances the column past what it
drew; one that no longer fits is dropped, and so is everything after it."
  (second (fold notes
            [from-col '()]
            (fn (acc note) (ed-eol-note-row-step acc note row stale x y gw hcol tw)))))

;; The fold step above, as a function so its accumulator has a declared shape: `[col ops]`
;; — the next free column and the ops so far. A lambda's accumulator no `sig` can reach.
(sig ed-eol-note-row-step
  ((tuple int list) any int bool int int int int int -> (tuple int list)))
(defn- ed-eol-note-row-step (acc note row stale x y gw hcol tw)
  (let ([col ops] acc
        body (results/note-text note)
        at (- col hcol)
        avail (ed-eol-note-avail note (- tw at 1)))
    (if (or (< at 0) (<= avail 3))
      acc
      [(+ col (string/display-width body) 2)
        (append ops
          (list (text row
                  (+ x gw at)
                  (ui-clip body avail)
                  (ed-eol-note-face (if (:warn note) :warn (:kind note)) stale))))])))

(defn- ed-diag-notes (m buf top text-h)
  "The advisory checker's cached diagnostics as end-of-line notes on the `text-h` lines
from `top`, keyed by 0-based line — `{line (⚠-note …)}` — for `buf` ONLY when it is the
very rope the diagnostics were computed from (`:diag-rope`), so a warning can never sit on
a line the text has moved out from under; `{}` otherwise. Per VISIBLE line off the model's
index (`:diag-by-line`), like `ed-diagnostic-overrides`: this runs every frame. The
gutter's ⚠ was easy to miss beside a live buffer's own ·/✓ marks, and the type note beside
a form said `: bool` about `(< number)` while the checker knew the argument could not be
ordered; the message belongs on the line, in the note's voice."
  (let (index (or (:diag-by-line m) {}))
    (if (or (empty? index) (nil? (:diag-rope m)) (not (= (buffer-rope buf) (:diag-rope m))))
      {}
      (fold (range (math/max 0 top) (math/max 0 (+ top text-h)))
        {}
        (fn (acc line)
          (let (ds (get index line))
            (if (nil? ds)
              acc
              (assoc acc
                line (map ds (fn (d) {:kind :warn :warn true :text (str "⚠ " (:message d))}))))))))))

(sig ed-eol-note-ops (buffer int int int int int int int &optional map (or nil vector) -> any))
(defn- ed-eol-note-ops (buf top text-h x y w gw hscroll &optional (diag {}) (rows nil))
  "Ghost-text ops for the pane's visible end-of-line notes — `results/eol-notes`,
one annotation lookup on a buffer that has none. A note is owner-keyed with its
anchor line inside (`:line`), so it can never be stranded at a line the text moved
out from under. Iterated by LINE rather than by note, because a line may carry more
than one and they have to be placed relative to each other
(`ed-eol-note-row-ops`). A note sits after the line's LAST row (`ed-rows-line-rows` —
a wrapped line's last segment), its columns following that row's start like the body
text; clipped to the pane's text width, and a line too full to fit at least a few cells
drops its note rather than overpaint. Whoever annotates gets this rendering for
free: the tutorial's verdicts today, inline eval results / inlay hints / blame next."
  (let (notes (results/eol-notes buf)
        has-notes (not (or (nil? notes) (empty? notes))))
    (if (and (not has-notes) (empty? diag))
      '()
      (let (stale (if has-notes (results/eol-notes-stale? buf) false)
            tw (math/max 1 (- w gw))
            n-lines (buffer-line-count buf))
        (mapcat (seq/filter (seq/distinct (append (if has-notes (results/note-lines buf) '())
                                            (keys diag)))
                  (fn (line) (and (>= line top) (< line (+ top text-h)) (< line n-lines))))
          (fn (line)
            (let (last-row (last (ed-rows-line-rows rows top line hscroll)))
              (if (or (nil? last-row) (>= (first last-row) text-h))
                '()
                (let ([k from _] last-row
                      lt (ed-line-text buf line)
                      ;; the columns of the line left of this row: its hscroll, or a wrapped
                      ;; row's segment start measured on the line's stops (tabs)
                      hcol (if (nil? rows)
                             hscroll
                             (string/display-width (string/substring lt
                                                     0
                                                     (math/min from (string/length lt))))))
                  (ed-eol-note-row-ops (append (if has-notes (results/notes-on-line buf line) '())
                                         (get diag line '()))
                    (+ y k)
                    stale
                    (+ (string/display-width lt) 2)
                    x
                    y
                    gw
                    hcol
                    tw))))))))))

(sig ed-pane-ops (model pane -> any))
(defn ed-pane-ops (m pane)
  "All render ops for one pane: a full-width hl-line band behind the text, an optional
left line-number gutter, its visible buffer lines inside the rect above its mode line, a
1-column scrollbar on the right edge (the selected pane's only), plus the mode line. Lines are syntax-coloured when
the buffer's mode offers a `:fontify` service (spans served from the model's cross-frame
`:span-cache` via `ed-pane-spans`, so plain motion re-lexes nothing), region-highlighted,
and — in the selected pane — the bracket pair at point is marked. The body (gutter +
lines) is `ed-pane-body-ops`; the band, scrollbar and base-chrome mode line wrap it.

A ZOOMED pane (`appearance/zoom-of` on its payload — Ctrl+wheel, `C-x C-=`) is painted at
its own font size inside a `cell-region` (brood ADR-363): every body op is laid out in the
REGION's cells — origin 0,0, `ed-pane-cols` wide, `ed-pane-vrows` tall — and the region
places them in the pane's rect at `px`. The mode line and the scrollbar are outside it, in
the window's cells, so a zoom moves nothing but this pane's text. Unzoomed there is no region and the
body is laid out straight into the rect, exactly as before — so every op-level test holds.

When a trackpad gesture is in progress, the pane carries a `:scroll-frac` ∈ [0, 1) from
`ed-smooth-scroll-pane`. We collect all scrollable ops (bands, gutter, body, cursor) into
a `scroll-region` block — a scoped, self-resetting primitive (ADR-114), inside the cell
region when there is one (its offset is then in the region's cells, as it should be). The
scrollbar and mode line (fixed chrome) are emitted outside both so they never shift. When
frac = 0 the ops are emitted flat (no region wrapper) for test-compatibility and zero overhead."
  (let ([x y w h] (:rect pane)
        buf (ed-pane-buf m pane)
        top (ed-pane-top pane buf)
        hscroll (ed-pane-hscroll pane)
        scroll-frac (ed-pane-scroll-frac pane)
        zoom (get-in pane [:payload :zoom])
        gw (ed-gutter-width buf (ed-gutter-shown? buf pane))
        ;; the body's frame: the pane's rect, or — zoomed — the region's own cell space,
        ;; whose width and height are the columns and rows that fit at that size
        bx (if (nil? zoom) x 0)
        by (if (nil? zoom) y 0)
        bw (if (nil? zoom) w (inc (ed-pane-cols pane buf))) ; `w` counts the scrollbar column
        tw (math/max 1 (- (dec bw) gw))
        text-h (if (nil? zoom) (math/max 0 (dec h)) (ed-pane-vrows pane buf))
        ;; Discard stale scroll-frac when the buffer fits entirely in the viewport or
        ;; top is already at/past the scroll limit (e.g. after a git-refresh shrinks the
        ;; buffer). Without this clamp the stale frac triggers render-h = inc(text-h),
        ;; requesting rope lines past EOF and crashing the renderer.
        scroll-frac (if (>= top (ed-max-top buf (math/max 1 text-h) (ed-pane-text-cols pane buf)))
                      0.0
                      scroll-frac)
        ;; render one extra row when smoothly scrolling so the partial-line gap at the
        ;; bottom is filled (the mode line's rect, outside the scroll-region, covers overflow)
        render-h (if (> scroll-frac 0.001) (inc text-h) text-h)
        ;; a narrowed pane draws only the lines in its restriction — cap the rendered rows
        ;; at the restriction's last line (the rest of the pane stays blank: the focus look).
        ;; `top` is already clamped into the restriction by `ed-pane-top`.
        restrict (get-in pane [:payload :restrict])
        render-h (if (nil? restrict)
                   render-h
                   (let ([_ rbot] (ed-restrict-lines buf restrict))
                     (math/max 1 (math/min render-h (- (inc rbot) top)))))
        spans (ed-pane-spans m pane buf top (ed-pane-vrows pane buf))
        ;; the row table of a wrapped buffer (`panes/ed-pane-rows`; nil unwrapped): every
        ;; line→row question below goes through it, so the text, the cursor, the bands and
        ;; the notes land on the same rows
        rows (ed-pane-rows pane buf)
        overrides (if (:selected pane)
                    (append (ed-bracket-overrides buf) (ed-diagnostic-overrides m buf top render-h))
                    '())
        hl-ranges (append (ed-hl-ranges m buf (:selected pane))
                    ;; other participants' selections, tinted in their colour
                    (ed-remote-selection-ranges m pane)
                    ;; the hovered clickable row's underscore (a proper font underline)
                    (ed-link-hover-range m pane buf))
        ;; cursor op: only for the selected pane, only when no minibuffer is open,
        ;; only on the blink-on phase, and only when the cursor's row is within the
        ;; visible viewport (`ed-rows-offset-row`: `[k from]`, nil off-screen — the row
        ;; the text was painted on, wrapped or not). Emitted INSIDE the scroll-region so
        ;; it tracks the fractional scroll offset along with the text and hl-line band
        ;; — keeping all three in the same coordinate frame at all times. The Rust
        ;; renderer clips the cursor cell to [oy, fb_h) so a partially-visible cursor
        ;; at the viewport top appears correctly clipped rather than disappearing.
        point-row (ed-rows-offset-row rows
                    top
                    (buffer-current-line buf)
                    (buffer-column buf)
                    hscroll
                    (math/max 1 text-h))
        cursor-op (when (and (:selected pane)
                          (nil? (:minibuffer m))
                          (or (:blink-on? m) (:held-key m))
                          point-row)
                    (let ([k from] point-row)
                      (cursor (+ by k)
                        (+ bx gw (math/max 0 (math/min (dec tw) (ed-visual-column-from buf from))))
                        (ed-cursor-style m))))
        ;; the inline completion preview, at the cursor's own cell — same row and column
        ;; the caret is on, so it reads as the line continuing
        preview-op (when point-row
                     (let ([k from] point-row
                           vc (math/max 0 (math/min (dec tw) (ed-visual-column-from buf from))))
                       (ed-preview-op m buf (:selected pane) (+ by k) (+ bx gw vc) (- tw vc))))
        ;; all ops that belong inside the scroll-region (shifted by frac × cell_h)
        scrollable (into []
                     (append
                       ;; the line-number gutter gets its own recessed surface
                       (ed-hl-line-band m pane buf top bx by bw gw text-h rows hscroll)
                       (if (> gw 0)
                         [(rect by bx (math/max 0 (- gw *gutter-edit-margin*)) text-h face-gutter-bg)]
                         [])
                       (ed-region-eol-bands buf top text-h bx by bw gw hscroll rows)
                       ;; link affordance (results buffers): the hovered row's subtle
                       ;; highlight goes UNDER the text (like the hl-line band); the
                       ;; pointer-cursor zones draw nothing, so their order is free
                       (ed-pane-link-ops m pane buf top text-h bx by bw gw rows hscroll)
                       (ed-pane-body-ops buf
                         ;; cached across frames — typing never changes the gutter
                         (ed-pane-gutter-cells m pane buf top render-h gw)
                         top
                         render-h
                         bx
                         by
                         bw
                         gw
                         hl-ranges
                         spans
                         overrides
                         hscroll
                         (:gui m)
                         rows)
                       ;; end-of-line notes: ghost text past a line's end (`=> 42` /
                       ;; ✓ / ✗ / ⋯) — one annotation lookup on ordinary buffers
                       (ed-eol-note-ops buf
                         top
                         render-h
                         bx
                         by
                         bw
                         gw
                         hscroll
                         (ed-diag-notes m buf top render-h)
                         rows)
                       ;; other participants' carets + name tags (collab presence) — drawn
                       ;; over the text, under our own cursor
                       (ed-remote-cursor-ops m pane buf top bx by bw gw text-h hscroll rows)
                       ;; before the caret, so a block cursor sits ON the preview's first
                       ;; character rather than under it
                       (if preview-op [preview-op] [])
                       (if cursor-op [cursor-op] [])))
        ;; scrollable region: flat when frac ≈ 0 (no overhead, tests see top-level ops),
        ;; wrapped in a scroll-region when frac > 0 (self-resetting, no sentinel needed)
        scrolled (if (> scroll-frac 0.001)
                   [(scroll-region scroll-frac scrollable)]
                   scrollable))
    (append
      ;; a zoomed pane's body lives in its cell region: the pane's rect less the
      ;; scrollbar column and the mode line row, painted at the pane's size
      (if (nil? zoom)
        scrolled
        [(cell-region x y (math/max 1 (dec w)) (math/max 0 (dec h)) (:px zoom) (into [] scrolled))])
      ;; fixed chrome: scrollbar + mode line, always outside the scroll-region. The
      ;; scrollbar is the SELECTED pane's only — the fade is one model-wide budget, so
      ;; drawing it everywhere lit every pane's bar on any scroll, including panes nothing
      ;; had touched. It says where you are, and you are in one pane (the same `:selected`
      ;; test the cursor, hl-line and bracket overrides use).
      (if (:selected pane)
        (ed-scrollbar-ops buf top text-h (+ x (dec w)) y (ed-scrollbar-opacity m) (math/max 0 (dec h)))
        '())
      (ed-pane-modeline m pane buf))))

;; ---- remote participant carets (collab presence) ----------------------------
;; On a shared buffer (`--serve --collab`), the model's `:hosted` slot carries every
;; OTHER participant's cursor (`:cursors` — pid → offset, edit-adjusted markers pushed
;; by the buffer process) and name (`:names`). Each renders as a coloured caret bar at
;; its cell plus a small name tag on the row above (Google-Docs / Live Share style),
;; colour stable per name.

(def- ed-participant-palette
  ;; caret/tag accents for remote participants — the theme's accent hues
  [*blue* *green* *peach* *mauve* *red* *teal* *yellow*])

(defn- ed-participant-color (name)
  "A stable accent colour for participant `name` (a char-code hash into the palette)."
  (nth ed-participant-palette
    (math/mod (fold (string/->list (or name "guest")) 0 (fn (acc c) (+ acc (string/char->int c))))
      (count ed-participant-palette))))

(defn- ed-remote-selection-ranges (m pane)
  "`[lo hi face]` highlight ranges for OTHER participants' active selections on
`pane`'s buffer (cursor ↔ mark, tinted in the owner's colour) — appended to the
pane's highlight ranges, so they paint through the ordinary run tiler. `()` when the
buffer isn't shared or no one has a region."
  (let (bi (get-in pane [:payload :buffer])
        sh (get-in m [:hosted bi])
        marks (or (:marks sh) {}))
    (if (empty? marks)
      '()
      (let (cursors (or (:cursors sh) {})
            names (or (:names sh) {}))
        (mapcat (%map-pairs marks)
          (fn (kv)
            (let (pid (first kv)
                  mk (second kv)
                  cur (get cursors pid))
              (if (nil? cur)
                '()
                (list [(math/min cur mk)
                        (math/max cur mk)
                        {:bg (ed-participant-color (get names pid "guest"))}])))))))))

(defn- ed-remote-cursor-ops (m pane buf top x y w gw text-h hscroll rows)
  "Render ops for the other participants' carets on `pane`'s buffer: for each remote
cursor within the viewport, a coloured caret bar at its cell (a sub-cell `frect` in
the GUI, a filled cell in the terminal). The owner's NAME shows only while their
caret recently moved (`:tag-ttl`, re-armed per push and ticked down on the blink
beat) — and quietly: small dim text in their colour on the row above, no box. `()`
when the pane's buffer isn't a shared slot or no one else is on it — every ordinary
pane pays one map lookup."
  (let (bi (get-in pane [:payload :buffer])
        sh (get-in m [:hosted bi])
        cursors (or (:cursors sh) {}))
    (if (empty? cursors)
      '()
      (let (rope (buffer-rope buf)
            len (buffer-length buf)
            nlines (buffer-line-count buf)
            vrows (math/max 1 text-h)
            tw (math/max 1 (- w gw))
            names (or (:names sh) {})
            ttls (or (:tag-ttl sh) {}))
        (mapcat (%map-pairs cursors)
          (fn (kv)
            (let (pos (math/max 0 (math/min (second kv) len))
                  line (math/min (text/char->line rope pos) (dec nlines))
                  ; the EOF phantom-line clamp, as ed-visual-column
                  bol (text/line->char rope line)
                  ;; the row the caret's char is painted on (`ed-rows-offset-row`: nil off-screen)
                  at (ed-rows-offset-row rows top line (- pos bol) hscroll vrows)
                  row (if at (first at) -1)
                  from (if at (second at) 0)
                  colc (- (string/display-width (text/slice rope bol pos))
                         (string/display-width (text/slice rope
                                                 bol
                                                 (+ bol (math/min from (- pos bol)))))))
              (if (or (< row 0) (>= row vrows) (< colc 0) (>= colc tw))
                '()
                (let (name (get names (first kv) "guest")
                      color (ed-participant-color name)
                      cy (+ y row)
                      cx (+ x gw colc)
                      bar (if (:gui m)
                            (frect (* 1.0 cx) (* 1.0 cy) 0.16 1.0 {:bg color} 0.9)
                            (rect cy cx 1 1 {:bg color})))
                  (if (> (or (get ttls (first kv)) 0) 0)
                    ;; freshly moved → the quiet tag: dim coloured text, no box, above
                    ;; the caret (below it on the top row), clamped into the pane
                    (let (tag-row (if (> row 0) (dec cy) (inc cy))
                          tag-col (math/max x (math/min cx (- (+ x w) (string/length name)))))
                      (list bar (text tag-row tag-col name {:fg color})))
                    (list bar)))))))))))

;; ---- dividers (the 1-cell lines between panes) ------------------------------

(def *hairline* 0.05) ; chrome border thickness in cells (a crisp sub-px hairline) — docs/ui-chrome.md
(def *modeline-hairline* 0.035) ; the status-bar rules — a hair finer than a pane divider (two of them, so lighter)
(defn ed-divider-ops (d gui?)
  "Render ops drawing divider `d`: a **hairline** border (thin `frect` centred in the reserved
1-cell seam) in the GUI — a crisp ≈1px line, not a stack of `│`/`─` box-drawing glyphs (ASCII
art) nor a heavy full-cell block; the terminal (no sub-cell `frect`) falls back to a solid
`rect` bar. Plus a `cursor-zone` over the seam so the GUI shows a resize cursor on hover/drag
(`:col-resize` ↔ / `:row-resize` ↕; the terminal ignores the zone). ADR-080."
  (let ([x y w h] (:rect d)
        col? (= (:dir d) :col)
        off (- 0.5 (/ *hairline* 2)))
    ; centre the hairline in the 1-cell seam
    [(if gui?
       (if col?
         (frect (+ x off) (* 1.0 y) *hairline* (* 1.0 h) face-border)
         (frect (* 1.0 x) (+ y off) (* 1.0 w) *hairline* face-border))
       (rect y x w h face-border))
      (cursor-zone x y w h (if col? :col-resize :row-resize))]))

;; ---- the minibuffer / echo area + the cursor --------------------------------

(defn ed-mb-candidates (mb)
  "A ` {a b c}` label of the matching candidates for a minibuffer that carries a candidate
source (`:rank-source` or `:candidates-fn`), narrowing live as you type; `\"\"` for a
prompt without one. Shown after the input so you see what completion will offer."
  (if (not (mb-source? mb))
    ""
    (let (cs (mb-candidates mb))
      ; memoized on the input text (model/mb-candidates)
      (if (empty? cs) "   {no match}" (str "   {" (string/join cs " ") "}")))))

(defn ed-diagnostic-on-line (m buf)
  "The `\"warning: …\"` text of the first cached diagnostic on `buf`'s current line
(a diagnostic's 1-based `:line` maps to the 0-based buffer line), or nil."
  (let (hit (first (get (or (:diag-by-line m) {}) (buffer-current-line buf) '())))
    (when hit (str "warning: " (:message hit)))))

(defn ed-eol-note-on-line (buf)
  "The end-of-line note on `buf`'s current line, in full — the echo-row seat of the
feedback (the gutter shows the glyph, the ghost text may be clipped; here the whole
text fits). Silent once the note is stale: an edited line's old result shouldn't
keep talking."
  (when (not (results/eol-notes-stale? buf))
    (results/eol-note-at buf (buffer-current-line buf))))

(defn ed-echo-or-eldoc (m)
  "The echo-row text when no minibuffer is open, by precedence: the latest explicit
`message`; else a **diagnostic on the current line**; else the tutorial note on the
current line (the full verdict/hint for the box at point); else the model's cached
`:eldoc` hint (the current buffer mode's signature for point, e.g. `(map coll f)`,
refreshed by `model/ed-post-step` once per event); else `\"\"`."
  (let (echo (:echo m))
    (if (not (= echo ""))
      echo
      (let (buf (ed-current-buf m)
            diag (ed-diagnostic-on-line m buf))
        ;; the eldoc hint is cached on the model by `ed-post-step` (computed once per
        ;; event, not re-derived here every frame) — just paint it.
        (or diag (ed-eol-note-on-line buf) (:eldoc m) "")))))

(defn ed-echo-line (m cols rows)
  "The bottom row (`rows-1`): the active minibuffer prompt + input if one is open,
else the latest `message` — or, when idle, the current mode's eldoc hint. A Vertico
prompt shows its candidates as the vertical list above (`ed-mb-candidates-ops`); a
plain prompt (find-file) keeps the inline ` {a b c}` here."
  ;; The prompt sits just below the mode line, at the top of the minibuffer region; the
  ;; Plume candidate list (if any) fills the rows below it (`ed-mb-candidates-ops`). With no
  ;; list the region is one row, so this lands on the last row as before.
  (let (mb (:minibuffer m))
    (text (- rows (ed-echo-rows m rows))
      0
      (ed-fit
        (if (nil? mb)
          (ed-echo-or-eldoc m)
          (let (sel? (:accept-selection mb)
                ;; a Plume prompt leads with the `N/M` candidate counter
                counter (if sel? (plume-count-label (mb-sel mb) (count (mb-candidates mb))) ""))
            (str counter
              (mb-prompt mb)
              (mb-text mb)
              (if sel? "" (ed-mb-candidates mb)))))
        cols))))

(def ed-plume-style
  ;; the minibuffer list rows: painted by role (ui-ctx palette), a rounded selection pill
  ;; (GUI) / bar (terminal) inset in the row — the same ui-list widget as the popup + menu.
  {:fg :on-surface :bg :surface :radius *completion-card-radius*})

(sig ed-mb-candidates-ops (map int int -> any))
(defn ed-mb-candidates-ops (m cols rows)
  "Plume's vertical candidate list for a minibuffer with `:accept-selection`: the fuzzy
candidates drawn in the rows just above the prompt as a windowed `ui-list` (src/ui-kit.blsp)
INSET by `*plume-inset*`, the `:sel` row a rounded selection pill, each row carrying its
category's marginalia (`plume-annotation`) in the widget's right-aligned `:key` slot when
the prompt declares one. `[]` for no minibuffer, a plain prompt, or no candidates."
  (let (mb (:minibuffer m))
    (if (or (nil? mb) (not (:accept-selection mb)))
      []
      (let (cands (mb-candidates mb))
        (if (empty? cands)
          []
          (let (vis (dec (ed-echo-rows m rows)) ; reserved rows minus the prompt
                sel (mb-sel mb)
                total (count cands)
                wstart (completion-window-start total sel vis)
                ;; the selected candidate's *value* indexes into `cands` (what accept
                ;; opens); a prompt may supply `:label-fn` to show each candidate
                ;; differently (find-file shows a path's basename, not its full path).
                labelf (or (:label-fn mb) (fn (c) c))
                values (take (drop cands wstart) vis)
                window (map values labelf)
                ;; Plume marginalia: a per-category annotation for each visible candidate
                ;; value; nil (no :key) when the prompt's category has no annotator.
                annots (map values (fn (v) (or (plume-annotation mb v) "")))
                aw (plume-annot-width annots cols)
                inset *plume-inset*
                inner-w (math/max 1 (- cols (* 2 inset)))
                ;; the label fits before the right-aligned marginalia (1 lead + 1 gap + aw)
                lab-w (math/max 1 (- inner-w 2 (if (= aw 0) 0 (inc aw))))
                ;; pad each annotation to the column width so the widget's right-aligned
                ;; :key slot puts EVERY row's marginalia at the same left column (perms /
                ;; size / mtime line up) — right-aligning by raw length would ragged them.
                rowvals (map (range (count window))
                          (fn (i)
                            (let (an (nth annots i))
                              {:label (plume-clip (nth window i) lab-w)
                               :key (if (= an "") nil (string/pad-right an aw))
                               :enabled true})))
                ;; the list fills the bottom `vis` rows, inset, just below the prompt
                row0 (- rows vis)
                widget (ui-list {:items rowvals
                                 :selected sel
                                 :base wstart
                                 :row (fn (it i sel?) it)
                                 :tag :plume-pick
                                 :style ed-plume-style}))
            (:ops (widget [inset row0 inner-w vis] (ui-ctx (:gui m))))))))))

;; `ed-selected-pane` lives in `panes` (this module `(:use panes)`).

(defn ed-visual-column (buf)
  "The cursor's *display* column on its line: the cell width (`display-width`) of the
line text from its start to point — so a wide glyph (emoji, CJK) or anything else
that isn't one cell per character advances the cursor by its real on-screen width,
keeping the block cursor over the character it edits. The width-aware counterpart to
`buffer-column` (which counts characters); the GUI grid advances by the same measure."
  (let (rope (buffer-rope buf)
        ;; Clamp to the last real line: point at EOF after a trailing newline reports
        ;; `buffer-current-line` = line-count (a phantom line the rope doesn't materialise),
        ;; which `text/line->char` rejects. A reused/regenerated report pane can leave point
        ;; there; the cursor render must never throw (it'd blank the whole frame), so pin it
        ;; to the last line's start rather than out of bounds.
        line (math/min (buffer-current-line buf) (dec (buffer-line-count buf)))
        bol (text/line->char rope line))
    (string/display-width (text/slice rope bol (buffer-point buf)))))

(sig ed-visual-column-from (buffer int -> int))
(defn ed-visual-column-from (buf hscroll)
  "The cursor's display column within a view scrolled `hscroll` characters left: the
cell width of the current line from char column `hscroll` to point (0 when point is left
of `hscroll`). The horizontal-scroll counterpart of `ed-visual-column`. Measured from the
LINE's start in both halves — a tab's width is a function of its line column (ADR-342),
so the width of `[hscroll, point)` is the width to point less the width to `hscroll`, not
the width of the slice on its own."
  (let (rope (buffer-rope buf)
        ;; Same EOF-phantom-line clamp as `ed-visual-column` — never index past the rope.
        line (math/min (buffer-current-line buf) (dec (buffer-line-count buf)))
        bol (text/line->char rope line)
        from (+ bol hscroll)
        p (buffer-point buf))
    (cond
      (>= from p) 0
      (= hscroll 0) (string/display-width (text/slice rope bol p))
      :else
        (- (string/display-width (text/slice rope bol p))
          (string/display-width (text/slice rope bol from))))))

;; ---- the right-click context menu, as a ui-kit widget -----------------------
;; The menu is ONE `ui-list` inside a `ui-panel` (src/ui-kit.blsp). The widget emits its
;; paint AND its click zones in one pass, so the view renders `:ops` and the click hit-test
;; (input/ed-menu-mouse-*) reads `:zones` from the SAME widget — no parallel geometry to
;; drift. Styling is by role (`ui-ctx`, in theme.blsp, supplies the palette).

(defn- ed-menu-rowfn (it i sel?)
  "A menu item → a `ui-list` row: label + shortcut key + enabled + the divider-above flag."
  {:label (:label it) :key (:key it) :enabled (:enabled it) :sep (:sep it)})

(def ed-menu-style
  ;; A popup card: raised surface, a hairline, one cell of padding on EVERY edge.
  ;; The vertical pad matters as much as the horizontal one here: the card is rounded
  ;; (`:radius`) and the selected row is a full-width pill, so with no top/bottom pad
  ;; the highlight ran into the rounded corner and the hairline — the first and last
  ;; items looked clipped. One row of breathing space above and below fixes it.
  ;;
  ;; `:inset 2` / `:gap 3` are what make it read as a menu rather than a list that
  ;; happens to be floating. A context menu is a handful of short rows with a shortcut
  ;; column, so it can afford room; the kit's default of one cell each side is tuned for
  ;; Plume, where the marginalia column IS the width and every cell spent on margin is a
  ;; cell taken off the candidate. Three cells between the label and its key stops
  ;; `Select All` and `C-x h` from reading as one run-on string.
  {:fg :on-surface
   :bg :surface
   :border :hairline
   :pad [1 1 1 1]
   :radius 0.5
   :inset 2
   :gap 3
   ;; The shortcut column is a reminder, not content — a weight below a disabled label,
   ;; so `Cut` greyed out because there is no selection cannot be confused with `C-w`
   ;; greyed out because it is a hint.
   :key-fg :faint})

(defn ed-menu-widget (m cols rows)
  "The context menu as a widget: a `ui-list` of the items in a `ui-panel`, sized and
clamped on-screen. Returns `{:ops :zones :area}` — the ops the view paints, the zones the
click hit-tests, and the clamped card rect (so a click inside the card but off an item
keeps the menu open). `{:ops [] :zones [] :area nil}` when no menu is open."
  (let (menu (:menu m))
    (if (nil? menu)
      {:ops [] :zones [] :area nil}
      (let (items (:items menu)
            ;; measured WITH the style the rows are rendered with, so the width reserved
            ;; and the inset actually used cannot disagree
            meas (ui-list-measure items ed-menu-rowfn (:sel menu) ed-menu-style)
            ;; the card's outer size = the rows plus the style's padding on each edge
            ;; (`ui-panel` renders the body into the PADDED inner rect, so the caller
            ;; owns the outer size — a vertical pad the area didn't account for would
            ;; simply clip the last row)
            area (ui-clamp [(:col menu) (:row menu) (+ (:w meas) 2) (+ (:h meas) 2)] cols rows)
            ctx (ui-ctx (:gui m))
            res (ui-panel area
                  ctx
                  ed-menu-style
                  (ui-list {:items items
                            :selected (:sel menu)
                            :row ed-menu-rowfn
                            :tag :menu-run
                            :style ed-menu-style})))
        (assoc res :area area)))))

(defn ed-menu-ops (m cols rows)
  "Render ops for the open context menu (`[]` when none) — the widget's `:ops`."
  (:ops (ed-menu-widget m cols rows)))

(defn ed-menu-hit (m cols rows col row)
  "Classify a click over the open menu via the widget's zones: `[:run i]` on an enabled
item, `:inside` when inside the card but off an item (a divider / disabled row / padding —
the menu stays open), or nil when outside (dismiss). One widget drives both this and the
render, so the click can't disagree with what's drawn."
  (let (w (ed-menu-widget m cols rows)
        z (zone-at (:zones w) col row))
    (cond
      (not (nil? z)) [:run (second (:id z))] ; z's :id is [:menu-run i]
      (let (a (:area w)) (and a (ui-in-rect? a col row))) :inside
      else nil)))

(defn- ed-cursor-style (m)
  "The caret shape. Vim insert mode is always a thin `:bar` (it signals you're inserting);
Vim normal/visual is always a `:block` over the character it acts on. Everywhere else
(the non-modal Emacs profile, every buffer alike) it's the model's configured
`:cursor-style` — `:block` by default (`(config :cursor :bar)` in init.blsp switches to a
bar). So the caret is consistent across buffers, wide by default, and user-configurable."
  (cond
    (= (:edit-state m) :insert) :bar
    (includes? (list :normal :visual) (:edit-state m)) :block
    :else (or (:cursor-style m) :block)))

(defn ed-cursor (m panes cols rows)
  "Place the MINIBUFFER's caret: at its point (prompt + `:point`). A buffer pane's caret is
not placed here — it is one of that pane's own ops (`ed-pane-ops`), inside its scroll and
cell regions so it moves with the text and is drawn at the pane's size. Its shape is the
configurable `ed-cursor-style` (a `:block` box by default, a `:bar` thin caret on the
cell's left edge — display.blsp; Vim insert always bar, normal/visual always block). Nil
with no minibuffer open."
  (let (mb (:minibuffer m))
    (if (nil? mb)
      nil
      ;; The prompt is the first row of the echo area (just below the mode line), not the
      ;; last screen row — the Plume list fills the rows below it. The caret sits after the
      ;; `N/M ` counter (when a selection prompt) + the prompt + the line editor's point.
      (let (counter (if (:accept-selection mb)
                      (string/length (plume-count-label (mb-sel mb) (count (mb-candidates mb))))
                      0))
        ;; the minibuffer caret is the SAME shape as every buffer (`ed-cursor-style`):
        ;; the configurable block by default, not a special-case bar.
        (cursor (- rows (ed-echo-rows m rows))
          (math/min (dec cols) (+ counter (string/length (mb-prompt mb)) (mb-point mb)))
          (ed-cursor-style m))))))

(defn- ed-which-key-rows (km)
  "Sorted `\"<key>   <command>\"` rows for the entries of pending sub-keymap `km`, the key
column padded to a common width so the command column lines up across rows."
  (let (pairs (%map-pairs km)
        kw (fold pairs 0 (fn (w p) (math/max w (string/length (ed-key-label (first p)))))))
    (sort (map pairs
            (fn (p)
              (str (string/pad-right (ed-key-label (first p)) kw)
                "   "
                (ed-cmd-label (second p))))))))

(defn- ed-which-key-columns (items vis cols)
  "`items` laid out down-then-across in columns of `vis` rows, as `vis` (or fewer) row
strings — each column padded to its widest entry plus a gap, columns added while they
fit in `cols` (Emacs which-key's grid). A prefix with more continuations than one column
holds (`C-x` has 30+) shows them all instead of the first `vis`."
  (let (n (count items)
        vis (math/max 1 vis)
        ncols (math/quot (+ n (dec vis)) vis)
        column (fn (c) (take (drop items (* c vis)) vis))
        step (fn (c rows used)
               (if (>= c ncols)
                 rows
                 (let (col (column c)
                       w (fold col 0 (fn (acc s) (math/max acc (string/display-width s))))
                       gap (if (= c 0) 0 3)
                       width (+ used gap w))
                   (if (and (> c 0) (> width cols))
                     rows ; no room for another column
                     (step (inc c)
                       (map (range (count rows))
                         (fn (i)
                           (let (cell (nth col i ""))
                             (if (= c 0)
                               (string/pad-right cell w)
                               (str (string/pad-right (nth rows i "") used)
                                 (string/pad-right "" gap)
                                 (string/pad-right cell w))))))
                       width))))))
    (map (step 0 (map (range (math/min vis n)) (fn (_) "")) 0) string/trimr)))

(defn ed-which-key-ops (m cols rows)
  "When a prefix chord has been pending past the which-key delay (`:which-key` set by
`model/ed-which-key-reveal`) and no minibuffer/menu is open, the bottom echo area shows
the available next keys and the command each runs (Emacs which-key) — a full-width grid
(`ed-which-key-columns`: down, then across) below the mode line + the pending-chord echo
row, the same shape as Plume's candidate list. `[]` otherwise, so a fast chord (C-x C-f) completes before the panel ever shows."
  (let (km (:pending m))
    (if (or (nil? km) (not (:which-key m)) (:minibuffer m) (:menu m))
      []
      (let (vis (dec (ed-echo-rows m rows)) ; reserved rows minus the echo row
            window (ed-which-key-columns (ed-which-key-rows km) vis cols)
            row0 (- rows vis))
        ; fills the bottom rows, below the echo row
        (if (empty? window)
          []
          ;; the same `ui-list` widget as Plume, full-width with NO selection (`:selected nil`
          ;; ⇒ no pill) — each row is a whole `"<key>   <command>"` label, no marginalia.
          (let (widget (ui-list {:items window
                                 :selected nil
                                 :row (fn (s i sel?) {:label s :enabled true})
                                 :tag :which-key
                                 :style ed-plume-style}))
            (:ops (widget [0 row0 cols vis] (ui-ctx (:gui m))))))))))

(defn ed-view (m cols rows)
  "ui-run view (pure): lay the pane tree into the body (everything above the echo
row), paint each pane (buffer body + its mode line) and the dividers between them,
then the echo area / minibuffer, the completion popup (if open), and the cursor at
the selected pane. A single pane fills the body — identical to the old full-screen
layout."
  ;; Guard rendering: a bug in any view helper would otherwise throw out of
  ;; `ui-run` (which restores the screen and re-raises — killing the editor). On a
  ;; render error, paint a minimal frame with the message on the echo row so the
  ;; window stays alive and you can read it / quit / fix it live.
  (try
    (let (lc (get m :_lc)
          layout (if (and lc (= (nth lc 0) cols) (= (nth lc 1) rows))
                   (nth lc 2)
                   (ed-body-layout m cols rows))
          panes (:panes layout))
      (apply frame
        (append [(clear)]
          (mapcat panes (fn (p) (ed-pane-ops m p)))
          (mapcat (:dividers layout) (fn (d) (ed-divider-ops d (:gui m))))
          [(ed-echo-line m cols rows)]
          (ed-mb-candidates-ops m cols rows) ; the Vertico minibuffer list (above the prompt)
          (ed-which-key-ops m cols rows) ; the which-key panel while a prefix chord is pending
          (complete-popup-ops m cols rows) ; overlays the buffer body when open
          (ed-menu-ops m cols rows) ; the right-click Copy/Cut/Paste menu, on top
          (ed-modeline-tooltip-ops m cols rows) ; the hovered status-bar segment's tooltip
          ;; The caret blinks (ADR-102): the idle `:cursor-blink` timer toggles `:blink-on?`,
          ;; and dropping the op on the off-phase hides it — in the minibuffer too, so the
          ;; caret is consistent everywhere (typing resets it solid via `ed-real-input?`,
          ;; then it blinks at rest). Kept solid only while a key is repeating (the point is
          ;; actively moving, so blinking would strobe).
          ;; Buffer pane cursor is inside each pane's scroll-region (see ed-pane-ops).
          ;; Only the minibuffer cursor is emitted here — it lives in the fixed echo row.
          (if (and (:minibuffer m) (or (:blink-on? m) (:held-key m)))
            [(ed-cursor m panes cols rows)]
            []))))
    (catch e
      ;; Also log to the console: the echo-row message scrolls past / vanishes on quit,
      ;; so a render bug leaves no trace without this. stderr survives the session.
      (do
        (io/puts (str "render error: " (error-message e)))
        ;; Dump the model state that provoked it — but only from **raw** fields, never via the
        ;; `ed-current-*` helpers: those traverse `:layout`, which may itself be the corrupt
        ;; thing that threw (an empty/half-built model), and traversing it can run away instead
        ;; of failing cleanly. Each field is `get`-only + the whole dump is guarded, so the
        ;; handler always returns a frame. `layout=` shows every pane's `:buffer`/`:top`; cross
        ;; it against `pool=` (name:line-count per pool buffer) to find an out-of-range scroll.
        (try
          (io/puts (str "  view-rows="
                     (:view-rows m)
                     " | pool=["
                     (string/join (map (or (:buffers m) '())
                                    (fn (b) (str (buffer-name b) ":" (buffer-line-count b) "L")))
                       ", ")
                     "]"
                     " | layout="
                     (str (:layout m))))
          (catch e2 (io/puts "  (state dump unavailable)")))
        (frame (clear)
          (text (dec rows) 0 (ed-fit (str "render error: " (error-message e)) cols))
          (cursor (dec rows) 0))))))
