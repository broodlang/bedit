(defmodule view
  "The editor's view: a pure `(model cols rows) -> render frame`, built from
`std/display.blsp` ops. The bottom two rows are reserved, Emacs-style: a
reverse-video **mode line** (status) at `rows-2`, and the **echo area** (the
latest `message`) at `rows-1`. The text body fills the remaining `rows-2` rows,
offset by the model's `:top` scroll position. No window, no state: testable as
plain data."
  (:use buffer)   ; line text / point + column, read to lay out the frame
  (:use display)) ; clear / text / cursor / frame render ops

(defn ed-fit (s w)
  "Clip string `s` to `w` columns (long lines don't wrap — v1 has no h-scroll)."
  (if (> (string-length s) w) (substring s 0 w) s))

(defn ed-line-text (buf line)
  "Line `line`'s text without its trailing newline (`buffer-line-at` keeps it)."
  (let (lt (buffer-line-at buf line))
    (if (ends-with? lt "\n") (substring lt 0 (dec (string-length lt))) lt)))

(defn ed-visible-lines (buf top textrows cols)
  "`text` render ops for the lines visible in a `textrows`-tall window starting
at line `top` — one op per line, clipped to `cols`, positioned at its screen row."
  (let (last-line (min (dec (buffer-line-count buf)) (dec (+ top textrows))))
    (map (fn (line) (text (- line top) 0 (ed-fit (ed-line-text buf line) cols)))
      (range top (inc last-line)))))

(defn ed-status-line (m cols rows)
  "The reverse-video mode line (row `rows-2`): a message, then `line:col` at the
buffer point, then the key hints."
  (let (buf (get m :buf)
        pos (str (inc (buffer-current-line buf)) ":" (buffer-column buf)))
    (text (- rows 2)
      0
      (ed-fit (str " " (get m :status) "  —  " pos "  —  C-x C-s save · C-x C-c quit") cols)
      {:reverse true})))

(defn ed-echo-line (m cols rows)
  "The echo area (the bottom row, `rows-1`): the latest `message`, plain."
  (text (dec rows) 0 (ed-fit (get m :echo) cols)))

(defn ed-view (m cols rows)
  "ui-run view (pure): clear, draw the visible buffer lines, the mode line, the
echo area, and place the cursor at the buffer point (screen coords, offset by
`:top`). The text body is `rows-2` tall — the bottom two rows are the mode line
and echo area."
  (let (buf (get m :buf)
        top (get m :top)
        textrows (- rows 2))
    (apply frame
      (concat [(clear)]
        (ed-visible-lines buf top textrows cols)
        [(ed-status-line m cols rows)
         (ed-echo-line m cols rows)
         (cursor (- (buffer-current-line buf) top) (buffer-column buf))]))))
