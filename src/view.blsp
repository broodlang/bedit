(defmodule view
  "The editor's view: a pure `(model cols rows) -> render frame`, built from
`std/display.blsp` ops. The bottom row is the **echo area / minibuffer**; the rows
above it are the **pane layout** (`std/pane.blsp`): the model's `:layout` tree
is laid out into that body rect, giving one or more panes (each a buffer in its own
sub-rect) separated by dividers. Each pane reserves its bottom row for a reverse-video
**mode line** (buffer name · mode · line:col; the selected pane also shows the status).
Within a pane the buffer is offset to the pane's origin, clipped to its
width, scrolled by the pane's `:top`, and the region (point↔mark) is reverse-video.
No pane IO, no state: testable as plain data.

A single pane fills the whole body, so the lone-pane layout is identical to the
old full-screen one (mode line at `rows-2`, echo at `rows-1`)."
  (:use editor/buffer)  ; line text / point + column / region bounds, read to lay out the frame
  (:use model)  ; current-buffer accessors, pane buffer + mode name
  (:use panes)  ; ed-body-layout — the :layout tree -> pane rects + divider rects
  (:use complete)  ; the completion popup overlay
  (:use completion)  ; the shared vertical-menu renderer (Vertico-style minibuffer list)
  (:use projects)  ; project-name — the bracketed project label on the mode line
  (:use editor/highlight)  ; fontify-runs — the shared span+overlay -> [substring face] tiler
  (:use theme)  ; the curated palette + semantic chrome faces (src/theme.blsp)
  (:use editor/display))  ; clear / text / cursor / frame render ops

(defn ed-fit (s w)
  "Clip string `s` to `w` columns (long lines don't wrap — v1 has no h-scroll)."
  (if (> (string-length s) w) (substring s 0 w) s))

(defn ed-fit-pad (s w)
  "Clip or space-pad `s` to *exactly* `w` columns — for a full-width bar (a mode
line) that spans its pane, so it visibly grows/shrinks on a horizontal resize.
Clip first (`ed-fit`), then prelude `pad-right` brings it up to width."
  (pad-right (ed-fit s w) w))

(defn ed-line-text (buf line)
  "Line `line`'s text without its trailing newline (`buffer-line-at` keeps it)."
  (ed-strip-newline (buffer-line-at buf line)))

;; ---- syntax highlighting: tile precomputed spans onto a visible line --------
;; A language mode may supply a `:fontify` service (`text -> [start end face]`
;; spans, the `highlight-spans` shape). When it does, each visible line is painted
;; as coloured `[substring face]` chunks — with the active region's `:reverse` and
;; any bracket-match `overrides` merged into the per-char face — instead of plain
;; text. Spans are lexed ONCE per frame (in `ed-pane-ops`) and tiled here, so the
;; buffer isn't re-lexed per visible line. The view never names a language: it asks
;; the buffer's mode for these services (`ed-mode-service`, src/model.blsp).

;; The chrome faces are the theme's (src/theme.blsp) — kept under these `ed-face-*`
;; names so call sites and tests don't move. The selection is now a background
;; *tint* (`face-region`, a `:bg` only) rather than reverse-video, so syntax
;; colours stay visible under it; `face-hl-line` is a soft surface band, not the
;; old (unresolvable) `:bright-black`.
(def ed-face-bracket-match face-bracket-match)  ; the matched bracket pair
(def ed-face-bracket-error face-bracket-error)  ; a lone unmatched bracket
(def ed-face-region face-region)  ; the active region (point↔mark)
(def ed-face-hl-line face-hl-line)  ; the current line (selected pane, no region)

(defn ed--line-chunks (vis base spans hl-ranges overrides)
  "`[substring face]` chunks tiling visible substring `vis` (its first char at buffer
offset `base`), via `highlight/fontify-runs`: the lexer `spans` coloured, with the
region/overlay `hl-ranges` (`[lo hi face]`) and the bracket/diagnostic `overrides`
(`[pos face]`, each the one-char range `[pos (inc pos) face]`) merged on top. Overrides
are ordered before `hl-ranges`, so a region/overlay face wins — the old
span→override→hl merge order."
  (fontify-runs vis
    base
    spans
    (concat (map (fn (o) (let ([p f] o) [p (inc p) f])) overrides) hl-ranges)))

(defn ed--chunks->ops (row x chunks acc)
  "Tail-recursive: `text` ops for `[substring face]` `chunks` laid left-to-right from
column `x` at screen `row`."
  (if (empty? chunks)
    (reverse acc)
    (let ([s f] (first chunks))
      (ed--chunks->ops row
        (+ x (string-length s))
        (rest chunks)
        (cons (if (nil? f) (text row x s) (text row x s f)) acc)))))

(defn ed-chunks->ops (row x chunks)
  "`text` ops for `[substring face]` `chunks`, starting at column `x` on screen `row`."
  (ed--chunks->ops row x chunks '()))

(def ed-bracket-scan 4000)  ; max chars each side of point the bracket matcher scans

(defn ed-bracket-overrides (buf)
  "`[pos face]` overrides for the bracket pair adjacent to point, via `buf`'s mode
`:bracket-match` service: the matched pair in the match face, a lone unmatched bracket
in the error face, or `()` when there's no service or no bracket at point. The match is
sought within a `ed-bracket-scan`-char window each side of point (not the whole
buffer), so a deep point in a large file costs O(window), not O(point); a partner
beyond the window is treated as not found, and a window-clipped `:unmatched` is
suppressed (no false red) rather than scanning the rest of the buffer."
  (let (bm (ed-mode-service buf :bracket-match))
    (if (nil? bm)
      '()
      (let (n (buffer-length buf)
            pt (buffer-point buf)
            lo (max 0 (- pt ed-bracket-scan))
            hi (min n (+ pt ed-bracket-scan))
            clipped (or (> lo 0) (< hi n))
            r (bm (rope-slice (buffer-rope buf) lo hi) (- pt lo)))
        (cond
          (nil? r) '()
          (= (second r) :unmatched) (if clipped '() (list [(+ lo (first r)) ed-face-bracket-error]))
          :else (list [(+ lo (first r)) ed-face-bracket-match]
                  [(+ lo (second r)) ed-face-bracket-match]))))))

(def ed-face-diagnostic {:underline true})  ; merged onto the token's syntax face

(defn ed--word-end (text i)
  (if (and (< i (string-length text)) (complete-word-char? (char-at text i)))
    (ed--word-end text (inc i))
    i))

(defn ed--diag-span-end (text off)
  "End offset (exclusive) of the run to underline at `off`: the word at `off` if it's
on a word char, else just that one cell (so a diagnostic on a delimiter marks 1 col)."
  (if (and (< off (string-length text)) (complete-word-char? (char-at text off)))
    (ed--word-end text off)
    (inc off)))

(defn ed-diagnostic-overrides (m buf)
  "`[pos ed-face-diagnostic]` overrides underlining each diagnostic's token, from the
model's cached `:diagnostics` (1-based `{:line :col}`); `()` when there are none. Reads
only **each diagnostic's own line** (`buffer-line-at`), not the whole buffer — so this
runs every frame without materialising the full text of a large file (the word a
diagnostic marks never crosses a newline, so the per-line span end matches the old
whole-text one). Diagnostics on a line past EOF (stale between rechecks) are dropped, so
a deleted line can't index out of range mid-edit."
  (let (n (buffer-line-count buf))
    (mapcat (fn (d)
              (let (line (dec (get d :line))
                    col0 (dec (get d :col))
                    bol (rope-line->char (buffer-rope buf) line)
                    lt (buffer-line-at buf line)
                    end (ed--diag-span-end lt col0))
                (map (fn (p) [(+ bol p) ed-face-diagnostic]) (range col0 end))))
      (filter (fn (d) (and (get d :line) (get d :col) (< (dec (get d :line)) n)))
        (or (get m :diagnostics) '())))))

;; ---- highlight ranges: the region + transient overlays ----------------------

(defn ed--hl-line-range (buf)
  "A `[bol next-bol ed-face-hl-line]` range over the current line (its newline included,
so the band reads to the line end), for the hl-line current-line highlight."
  (let (rope (buffer-rope buf)
        cl (buffer-current-line buf)
        bol (rope-line->char rope cl)
        eol (if (< (inc cl) (buffer-line-count buf))
              (rope-line->char rope (inc cl))
              (buffer-length buf)))
    [bol eol ed-face-hl-line]))

(defn ed-hl-ranges (m buf selected?)
  "The highlight ranges `[lo hi face]` to paint over `buf` in a pane: the active region
(point↔mark, `:reverse`); the model's transient `:overlays` (isearch / query-replace
matches); and — when the model opts in (`:hl-line`, set by the live editor) on the
selected pane with **no** active region — a subtle current-line background (hl-line).
Order is priority (the tiler merges later-wins): hl-line lowest,
then region, then overlays. Overlays/hl-line are gated to the selected pane so a split
showing another buffer never highlights stray offsets."
  (let (region-b (buffer-region-bounds buf)
        hl-line (if (and (get m :hl-line) selected? (nil? region-b))
                  (list (ed--hl-line-range buf))
                  '())
        region (if (nil? region-b) '() (list [(first region-b) (second region-b) ed-face-region]))
        overlays (if selected?
                   (map (fn (o) [(get o :start) (get o :end) (get o :face)])
                     (or (get m :overlays) '()))
                   '()))
    (concat hl-line region overlays)))

;; ---- one pane's body (a buffer clipped into a sub-rect at origin x,y) -------
;; Render ops carry absolute screen coordinates, so a pane simply offsets every
;; op by its rect's origin `(x, y)` and clips text to its width `w`.

(defn ed-line-ops (buf line top x y w hl-ranges spans overrides hscroll)
  "Render op(s) for buffer `line` at its screen row inside a pane whose text area
starts at column `x`, row `y`, width `w`, scrolled `hscroll` columns left. The visible
text is the line's slice `[hscroll, hscroll+w)` (long lines scroll, not wrap). With
neither `:fontify` `spans` nor any highlight range it's a single plain `text` op;
otherwise it's coloured `[substring face]` chunks (the syntax spans + highlight ranges +
bracket `overrides` merged), tiled from the visible slice's absolute `base` offset."
  (let (row (+ y (- line top))
        full (ed-line-text buf line)
        h (min hscroll (string-length full))
        vis (ed-fit (substring full h (string-length full)) w)
        base (+ (rope-line->char (buffer-rope buf) line) h))
    (if (and (nil? spans) (empty? hl-ranges))
      [(text row x vis)]
      (ed-chunks->ops row x (ed--line-chunks vis base (or spans '()) hl-ranges overrides)))))

(defn ed-visible-lines (buf top textrows x y w hl-ranges spans overrides hscroll)
  "`text` ops for the lines visible in a `textrows`-tall pane whose text area starts
at `(x, y)`, is `w` wide and scrolled `hscroll` columns left, from line `top`; `hl-ranges`
`[lo hi face]` highlight the region/overlays, `spans` syntax-colour (with `overrides`)."
  (let (last-line (min (dec (buffer-line-count buf)) (dec (+ top textrows))))
    (mapcat (fn (line) (ed-line-ops buf line top x y w hl-ranges spans overrides hscroll))
      (range top (inc last-line)))))

;; ---- a pane: its buffer body + its mode line --------------------------------

(defn ed-pane-buf (m pane)
  "The buffer shown in `pane` (its payload's `:buffer` index into the pool)."
  (ed-buf-at m (get (get pane :payload) :buffer)))

(defn ed--diag-label (m)
  "`  ⚠N` when the model carries N cached diagnostics, else `\"\"` — appended to the
selected pane's mode line so the warning count is always visible."
  (let (n (count (or (get m :diagnostics) '())))
    (if (= n 0) "" (str "  ⚠" n))))

(defn ed--project-label (m)
  "`  [name]` of the model's current project (`:project-root`'s directory name), or
`\"\"` when there is none — shown on the selected pane's mode line."
  (let (root (get m :project-root))
    (if (nil? root) "" (str "  [" (project-name root) "]"))))

(defn ed-scroll-pct (top vrows linecount)
  "Emacs-style scroll-position label for the mode line: `All` when the whole buffer
fits, `Top` at the start, `Bot` when the last line shows, else `NN%` — the fraction of
lines scrolled above the window."
  (cond
    (and (= top 0) (>= (+ top vrows) linecount)) "All"
    (= top 0) "Top"
    (>= (+ top vrows) linecount) "Bot"
    :else (str (quot (* 100 top) (max 1 (- linecount vrows))) "%")))

(defn ed-pane-modeline (m pane buf)
  "A pane's mode line — a solid bar on the bottom row of its rect: ` name (mode)  —
SCROLL%  line:col`; the selected pane also shows the model status and the diagnostic
count. The selected pane's bar is `face-modeline` (a raised surface), an unselected
pane's the dimmer `face-modeline-inactive` — solid panels rather than the old
reverse-video, so a split reads which pane is active at a glance. The scroll indicator
(Top/Bot/All/NN%) tracks the pane's `:top` against its height, like Emacs."
  (let ([x y w h] (get pane :rect)
        sel (get pane :selected)
        pos (str (inc (buffer-current-line buf)) ":" (buffer-column buf))
        pct (ed-scroll-pct (ed-pane-top pane buf) (max 1 (dec h)) (buffer-line-count buf))
        label (str " "
                (if (read-only? buf) "RO " "")
                (buffer-name buf)
                "  ("
                (ed-buf-mode-name buf)
                ")  —  "
                pct
                "  "
                pos
                (if sel (str "  —  " (get m :status)) "")
                (if sel (ed--project-label m) "")
                (if sel (ed--diag-label m) "")))
    (text (+ y (dec h)) x (ed-fit-pad label w) (if sel face-modeline face-modeline-inactive))))

(defn ed--scale-op (op x y s)
  "Re-anchor a virtual-coords (origin 0,0) `text` op into a pane at screen `(x, y)`,
scaled by `s`: it lands `s` cells apart and the glyphs draw `s`× larger via the
kernel's `:scale` face attribute (ADR-079; the terminal renders it 1×). Non-text ops
pass through unchanged."
  (if (= (first op) :text)
    (text (+ y (* (nth op 1) s))
      (+ x (* (nth op 2) s))
      (nth op 3)
      (assoc (or (nth op 4 nil) {}) :scale s))
    op))

;; `ed-gutter-shown?` / `ed-gutter-width` (the gutter *geometry*) live in `panes`
;; alongside the rest of the pane-layout geometry — both the view and mouse
;; hit-testing need them, and `view` already `(:use panes)`. Only the gutter
;; *rendering* (`ed-gutter-ops`, below) stays here.

(defn ed-gutter-ops (buf top vh bx by gw)
  "Gutter cells for the up-to-`vh` visible lines from `top`, via the buffer mode's
`:gutter-cell` service (`[text face]` per 0-based line), placed at column `bx` (rows
from `by`, total width `gw`). `()` when `gw` is 0 or the mode offers no gutter."
  (let (cell (ed-mode-service buf :gutter-cell))
    (if (or (<= gw 0) (nil? cell))
      '()
      (let (last-line (min (dec (buffer-line-count buf)) (dec (+ top vh))))
        (map (fn (line)
               (let ([txt face] (cell buf line gw))
                 (text (+ by (- line top)) bx txt face)))
          (range top (inc last-line)))))))

;; ---- per-pane scrollbar (rightmost column) ----------------------------------

(def ed-face-scrollbar-track face-scrollbar-track)
(def ed-face-scrollbar-thumb face-scrollbar-thumb)

(defn ed-scrollbar-ops (buf top vh sx sy)
  "A 1-column vertical scrollbar at column `sx`, rows `sy`..`sy+vh-1`: a `█` thumb sized
by the visible fraction (`vh` rows over `buffer-line-count`) and positioned by `top`,
on a `│` track. **Drawn only when the buffer doesn't fit** (`line-count > vh`); with the
whole buffer on screen there's nothing to scroll, so it's hidden (`()`). The reserved
column stays (the text width already excludes it), so a buffer growing/shrinking past the
viewport shows/hides the bar without reflowing text. Hit-testing shares the predicate
(`panes/ed-scrollbar-hit?`)."
  (let (line-count (buffer-line-count buf))
    (if (<= line-count vh)
      '()
      (let (total (max 1 line-count)
            thumb-h (max 1 (min vh (quot (* vh vh) total)))
            maxstart (max 0 (- vh thumb-h))
            denom (max 1 (- total vh))
            thumb-y (min maxstart (quot (* maxstart top) denom)))
        (map (fn (r)
               (let (on (and (>= r thumb-y) (< r (+ thumb-y thumb-h))))
                 (text (+ sy r)
                   sx
                   (if on "█" "│")
                   (if on ed-face-scrollbar-thumb ed-face-scrollbar-track))))
          (range 0 vh))))))

(defn ed-pane-ops (m pane)
  "All render ops for one pane: an optional left line-number gutter, its visible
buffer lines inside the rect above its mode line, a 1-column scrollbar on the right
edge, plus the mode line. Lines are
syntax-coloured when the buffer's mode offers a `:fontify` service (spans served from
the model's cross-frame `:span-cache` via `ed-pane-spans`, so plain motion re-lexes
nothing), region-highlighted, and — in the selected pane — the bracket pair at
point is marked. The text area is the rect minus the bottom mode-line row and the
gutter. A pane with `:line-numbers` shows the gutter (toggle per-pane, ADR-006 policy
in `ed-toggle-line-numbers`). A pane with font scale `s>1` (Ctrl+wheel zoom) renders
its body (gutter + lines) into a virtual `vw×vh` area, then scales every op `s`× and
re-anchors it — so the gutter magnifies in lock-step; the mode line stays base chrome."
  (let ([x y w h] (get pane :rect)
        buf (ed-pane-buf m pane)
        top (ed-pane-top pane buf)
        hscroll (ed-pane-hscroll pane)
        s (max 1 (or (get (get pane :payload) :scale) 1))
        gw (ed-gutter-width buf (ed-gutter-shown? buf pane))
        text-h (max 0 (dec h))
        spans (ed-pane-spans m pane buf top (ed-pane-vrows pane))
        overrides (if (get pane :selected)
                    (concat (ed-bracket-overrides buf) (ed-diagnostic-overrides m buf))
                    '())
        hl-ranges (ed-hl-ranges m buf (get pane :selected)))
    (if (= s 1)
      (concat (ed-gutter-ops buf top text-h x y gw)
        (ed-visible-lines buf
          top
          text-h
          (+ x gw)
          y
          (max 1 (- w gw 1))
          hl-ranges
          spans
          overrides
          hscroll)
        (ed-scrollbar-ops buf top text-h (+ x (dec w)) y)
        [(ed-pane-modeline m pane buf)])
      (let (vh (max 1 (quot text-h s))
            vw (max 1 (quot (dec w) s))
            body (concat (ed-gutter-ops buf top vh 0 0 gw)
                   (ed-visible-lines buf
                     top
                     vh
                     gw
                     0
                     (max 1 (- vw gw))
                     hl-ranges
                     spans
                     overrides
                     hscroll)))
        (concat (map (fn (op) (ed--scale-op op x y s)) body)
          (ed-scrollbar-ops buf top text-h (+ x (dec w)) y)
          [(ed-pane-modeline m pane buf)])))))

;; ---- dividers (the 1-cell lines between panes) ------------------------------

(defn ed-divider-ops (d)
  "Render ops drawing divider `d`: a vertical `│` column for a `:col` split, a
horizontal `─` row for a `:row` split, plus a `cursor-zone` over it so the GUI shows
a resize cursor on hover/drag (`:col-resize` ↔ / `:row-resize` ↕; the terminal
ignores the zone). ADR-080."
  (let ([x y w h] (get d :rect)
        col? (= (get d :dir) :col)
        line (if col?
               (map (fn (r) (text (+ y r) x "│")) (range h))
               [(text y x (apply str (map (fn (i) "─") (range w))))]))
    (concat line [(cursor-zone x y w h (if col? :col-resize :row-resize))])))

;; ---- the minibuffer / echo area + the cursor --------------------------------

(defn ed-mb-candidates (mb)
  "A ` {a b c}` label of the matching candidates for a minibuffer that carries a candidate
source (`:rank-source` or `:candidates-fn`), narrowing live as you type; `\"\"` for a
prompt without one. Shown after the input so you see what completion will offer."
  (if (not (mb-source? mb))
    ""
    (let (cs (mb-candidates mb))
      ; memoized on the input text (model/mb-candidates)
      (if (empty? cs) "   {no match}" (str "   {" (join " " cs) "}")))))

(defn ed-diagnostic-on-line (m buf)
  "The `\"warning: …\"` text of the first cached diagnostic on `buf`'s current line
(a diagnostic's 1-based `:line` maps to the 0-based buffer line), or nil."
  (let (cur (buffer-current-line buf)
        hit (first (filter (fn (d) (and (get d :line) (= (dec (get d :line)) cur)))
                     (or (get m :diagnostics) '()))))
    (if (nil? hit) nil (str "warning: " (get hit :message)))))

(defn ed-echo-or-eldoc (m)
  "The echo-row text when no minibuffer is open, by precedence: the latest explicit
`message`; else a **diagnostic on the current line**; else the model's cached `:eldoc`
hint (the current buffer mode's signature for point, e.g. `(map f coll)`, refreshed by
`model/ed-post-step` once per event); else `\"\"`."
  (let (echo (get m :echo))
    (if (not (= echo ""))
      echo
      (let (buf (ed-current-buf m)
            diag (ed-diagnostic-on-line m buf))
        (if (not (nil? diag))
          diag
          ;; the eldoc hint is cached on the model by `ed-post-step` (computed once per
          ;; event, not re-derived here every frame) — just paint it.
          (or (get m :eldoc) ""))))))

(defn ed-echo-line (m cols rows)
  "The bottom row (`rows-1`): the active minibuffer prompt + input if one is open,
else the latest `message` — or, when idle, the current mode's eldoc hint. A Vertico
prompt shows its candidates as the vertical list above (`ed-mb-candidates-ops`); a
plain prompt (find-file) keeps the inline ` {a b c}` here."
  (let (mb (get m :minibuffer))
    (text (dec rows)
      0
      (ed-fit (if (nil? mb)
                (ed-echo-or-eldoc m)
                (str (mb-prompt mb)
                  (mb-text mb)
                  (if (get mb :accept-selection) "" (ed-mb-candidates mb))))
        cols))))

(defn ed-mb-candidates-ops (m cols rows)
  "The Vertico-style vertical candidate list for a minibuffer with `:accept-selection`:
the fuzzy candidates drawn in the rows just above the prompt, the `:sel` row
highlighted. `[]` for no minibuffer, a plain prompt, or no candidates."
  (let (mb (get m :minibuffer))
    (if (or (nil? mb) (not (get mb :accept-selection)))
      []
      (let (cands (mb-candidates mb))
        (if (empty? cands)
          []
          (let (sel (mb-sel mb)
                total (count cands)
                ;; leave the mode line (rows-2) and the prompt (rows-1) visible: the
                ;; list fills the `vis` rows just ABOVE the mode line.
                vis (max 1 (min *completion-max* total (- rows 4)))  ; -2 for the box frame
                wstart (completion-window-start total sel vis)
                ;; the selected candidate's *value* indexes into `cands` (what accept
                ;; opens); a prompt may supply `:label-fn` to show each candidate
                ;; differently (find-file shows a path's basename, not its full path).
                labelf (or (get mb :label-fn) (fn (c) c))
                window (map labelf (take vis (drop wstart cands)))
                w (completion-menu-width window)
                ;; the (vis+2)-tall box sits just above the mode line (rows-2)
                row0 (max 0 (- (- rows 2) (+ vis 2))))
            (completion-menu-ops window wstart sel row0 0 w)))))))

(defn ed-selected-pane (panes)
  "The pane flagged `:selected` (where the cursor goes), or the first as a fallback."
  (let (sel (filter (fn (p) (get p :selected)) panes))
    (if (empty? sel) (first panes) (first sel))))

(defn ed-visual-column (buf)
  "The cursor's *display* column on its line: the cell width (`display-width`) of the
line text from its start to point — so a wide glyph (emoji, CJK) or anything else
that isn't one cell per character advances the cursor by its real on-screen width,
keeping the block cursor over the character it edits. The width-aware counterpart to
`buffer-column` (which counts characters); the GUI grid advances by the same measure."
  (let (rope (buffer-rope buf)
        bol (rope-line->char rope (buffer-current-line buf)))
    (display-width (rope-slice rope bol (buffer-point buf)))))

(defn ed-visual-column-from (buf hscroll)
  "The cursor's display column within a view scrolled `hscroll` columns left: the cell
width of the current line from char column `hscroll` to point (0 when point is left of
`hscroll`). The horizontal-scroll counterpart of `ed-visual-column`."
  (let (rope (buffer-rope buf)
        from (+ (rope-line->char rope (buffer-current-line buf)) hscroll)
        p (buffer-point buf))
    (if (>= from p) 0 (display-width (rope-slice rope from p)))))

;; ---- the right-click context menu (Copy / Cut / Paste) ----------------------
;; Rendered through the shared `completion-menu-ops` (the same bordered box as the
;; autocomplete popup and the minibuffer list), so it reads as a floating menu rather
;; than reverse-video text and looks identical to the rest. Reads only labels off the
;; model (`:menu`), so the view stays independent of the command layer that builds it.

(defn ed-menu-ops (m cols rows)
  "Render ops for the open context menu (`[]` when none): its item labels as a bordered
box at the menu's anchor, clamped to stay on screen, the `:sel` row highlighted — via the
shared completion menu renderer."
  (let (menu (get m :menu))
    (if (nil? menu)
      []
      (let (labels (map (fn (it) (get it :label)) (get menu :items))
            ;; same rect the click hit-test (commands/ed-menu-hit) uses, so they agree
            [mr mc w n] (completion-box-rect (get menu :row) (get menu :col) labels cols rows)
            sel (get menu :sel))
        (completion-menu-ops labels 0 sel mr mc w)))))

(defn ed-cursor (m panes cols rows)
  "Place the cursor: at the minibuffer's point (prompt + `:point`) when one is open,
else at the selected pane's buffer point, in that pane's screen coords (offset by the
pane origin and the pane's `:top`, column clamped to the pane width). Drawn as a
`:bar` insertion caret (a thin line on the cell's left edge — display.blsp) rather
than the terminal-style block, so it reads as a modern GUI editor."
  (let (mb (get m :minibuffer))
    (if (nil? mb)
      (let (pane (ed-selected-pane panes)
            [x y w h] (get pane :rect)
            buf (ed-pane-buf m pane)
            top (ed-pane-top pane buf)
            hscroll (ed-pane-hscroll pane)
            s (max 1 (or (get (get pane :payload) :scale) 1))
            gw (ed-gutter-width buf (ed-gutter-shown? buf pane))
            vw (max 1 (quot w s))
            tw (max 1 (- vw gw)))
        ; text columns after the gutter
        ;; In a zoomed pane each char is s×s cells; the cursor lands at the scaled
        ;; top-left of its cell, past the gutter, the column offset by `hscroll` (long
        ;; lines scroll sideways) and clamped to the text width.
        (cursor (+ y (* (- (buffer-current-line buf) top) s))
          (+ x (* (+ gw (max 0 (min (dec tw) (ed-visual-column-from buf hscroll)))) s))
          :bar))
      (cursor (dec rows)
        ;; prompt width + the line editor's point
        (min (dec cols) (+ (string-length (mb-prompt mb)) (mb-point mb)))
        :bar))))

(defn ed--which-key-rows (km)
  "Sorted `\"<key>   <command>\"` rows for the entries of pending sub-keymap `km`."
  (sort (map (fn (p) (str (ed-key-label (first p)) "   " (ed-cmd-label (second p))))
          (map-pairs km))))

(defn ed-which-key-ops (m cols rows)
  "When a prefix chord has been pending past the which-key delay (`:which-key` set by
`model/ed-which-key-reveal`) and no minibuffer/menu is open, a bottom bordered panel
listing the available next keys and the command each runs (Emacs which-key). `[]`
otherwise — so a fast chord (C-x C-f) completes before the panel ever shows."
  (let (km (get m :pending))
    (if (or (nil? km) (not (get m :which-key)) (get m :minibuffer) (get m :menu))
      []
      (let (labels (ed--which-key-rows km))
        (if (empty? labels)
          []
          (let (vis (max 1 (min (count labels) (- rows 4)))
                window (take vis labels)
                w (completion-menu-width labels)
                row0 (max 0 (- (- rows 2) (+ vis 2))))
            (completion-menu-ops window 0 -1 row0 0 w)))))))  ; selected = -1 → no highlight

(defn ed-view (m cols rows)
  "ui-run view (pure): lay the pane tree into the body (everything above the echo
row), paint each pane (buffer body + its mode line) and the dividers between them,
then the echo area / minibuffer, the completion popup (if open), and the cursor at
the selected pane. A single pane fills the body — identical to the old full-screen
layout."
  ;; Guard rendering: a bug in any view helper would otherwise throw out of
  ;; `ui-run` (which restores the screen and re-raises — killing the editor). On a
  ;; render error, paint a minimal frame with the message on the echo row so the
  ;; window stays alive and you can read it / quit / fix it live.
  (try
    (let (layout (ed-body-layout m cols rows)
          panes (get layout :panes))
      (apply frame
        (concat [(clear)]
          (mapcat (fn (p) (ed-pane-ops m p)) panes)
          (mapcat (fn (d) (ed-divider-ops d)) (get layout :dividers))
          [(ed-echo-line m cols rows)]
          (ed-mb-candidates-ops m cols rows)  ; the Vertico minibuffer list (above the prompt)
          (ed-which-key-ops m cols rows)  ; the which-key panel while a prefix chord is pending
          (complete-popup-ops m cols rows)  ; overlays the buffer body when open
          (ed-menu-ops m cols rows)  ; the right-click Copy/Cut/Paste menu, on top
          ;; The caret blinks (ADR-101): the idle `:cursor-blink` timer toggles `:blink-on?`,
          ;; and dropping the op on the off-phase hides it. Kept solid while a minibuffer is
          ;; open or a key is repeating (point is actively moving — Emacs does the same).
          (if (or (get m :blink-on?) (get m :minibuffer) (get m :held-key))
            [(ed-cursor m panes cols rows)]
            []))))
    (catch e
      ;; Also log to the console: the echo-row message scrolls past / vanishes on quit,
      ;; so a render bug leaves no trace without this. stderr survives the session.
      (do
        (eprintln (str "render error: " (error-message e)))
        (frame (clear)
          (text (dec rows) 0 (ed-fit (str "render error: " (error-message e)) cols))
          (cursor (dec rows) 0))))))
