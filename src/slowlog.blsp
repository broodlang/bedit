(defmodule slowlog
  "The SLOW-TURN LOG: every turn of the editor loop the watchdog reports slow (brood
ADR-490), kept across sessions, and M-x slow-turns, which ranks what they were folding.

A report always lands in `*Messages*` (`slow update 73ms on [:timer :idle]`), but that
buffer dies with the session; the log is what answers \"what makes the editor feel slow in a
normal day\". Once `activate!` has run (`main` calls it), each
report is also appended to `slow-turns.blsp` in the editor's state folder, one re-readable
map per line, the file rotated to `slow-turns.old.blsp` at [[*slow-log-max-bytes*]]. Before
that nothing is written, so a test that folds a `[:ui-slow …]` event never touches the
user's file.

The same file keeps KEY-TO-PAINT latency as a distribution (brood ADR-612): the window counts
every key's input→present time into a histogram, and the idle beat appends what it counted
since the last record ([[flush-latency]]) as a `{:kind :latency :key h}` line once enough
keys have come, and quitting appends the rest. M-x slow-turns heads its report with the p50,
p99 and p99.9 over every session recorded ([[latency-text]]), and M-x latency gives this
session's. Only the plumbing is tested here, with made-up histograms: measuring is for CI
or a machine set aside for it, never a desktop someone is working at."
  (:use model) ; ed-append-named, register-event-handler, message
  (:use projects) ; editor-state-dir
  (:use pool) ; ed-display-buffer — the report buffer
  (:use theme :only [gui-only]) ; the window's latency histogram, nil without a window
  (:use interactive)) ; defcommand

(def *slow-log-max-bytes* 262144) ; one generation is rotated out past this

;; where reports are appended; nil until `activate!`
(def *slow-log-file* nil)

(defn slow-log-file ()
  "Where slow turns are kept: `slow-turns.blsp` in the editor's state folder."
  (path/join (editor-state-dir) "slow-turns.blsp"))

(defn- rotated (file)
  "The previous generation of `file`: `slow-turns.old.blsp` beside `slow-turns.blsp`."
  (regex/replace file "\\.blsp$" ".old.blsp"))

(defn activate! (&optional (file nil))
  "Start keeping slow turns, in `file` (by default [[slow-log-file]]), creating its folder."
  (let (target (or file (slow-log-file))
        dir (path/dirname target))
    (when (not (file/exists? dir)) (file/mkdir dir))
    (def *slow-log-file* target)
    nil))

(defn deactivate! ()
  "Stop keeping slow turns: nothing is written until the next [[activate!]]."
  (def *slow-log-file* nil)
  nil)

(defn record! (report)
  "Append `report` (`{:phase :tag :ms …}`) with the time it was made, as one line, when the
log is active; rotate the file first once it has outgrown [[*slow-log-max-bytes*]].
Best-effort: a write that fails loses one report, never the turn."
  ;; a report that cannot be written (a full disk, a folder removed under us) is lost alone:
  ;; the turn it describes has already happened, and the next report tries again
  (when *slow-log-file*
    (check-allow :discarded-catch
      (try
        (do
          (when (> (or (file/size *slow-log-file*) 0) *slow-log-max-bytes*)
            (file/rename *slow-log-file* (rotated *slow-log-file*)))
          (file/spit-append *slow-log-file* (str (pr-str (assoc report :at (os/now))) "\n")))
        (catch _ nil))))
  nil)

(defn read-reports (file)
  "The reports kept in `file` and its previous generation, oldest first; a line that does not
read back as a map is skipped, so a torn last line costs that one report."
  (fold [(rotated file) file]
    []
    (fn (acc path)
      (into acc
        (if (file/exists? path)
          (seq/keep (string/split (file/slurp path) "\n")
            ;; a line that does not read (torn by a crash mid-write) is skipped: nil is the answer
            (fn (line)
              (let (form (check-allow :discarded-catch
                           (try (reflect/read-string line) (catch _ nil))))
                (when (map? form) form))))
          [])))))

(defn- whole-ms (ms)
  ;; a report's milliseconds as a whole number: the watchdog measures floats, and a line
  ;; written before a field existed has none (0)
  (if (number? ms) (math/round ms) 0))

(defn gc-heavy? (gc-ms ms)
  "Whether a turn (or a cause's turns) of `ms` was MOSTLY garbage collection — `gc-ms`, the
watchdog's `:gc-ms`, at least half of it: fixed by what the loop keeps alive, not by the code
that ran.

    (slowlog/gc-heavy? 60 100)   ;=> true
    (slowlog/gc-heavy? 10 100)   ;=> false"
  (and (> gc-ms 0) (>= (* 2 gc-ms) ms)))

(defn- gc-note (gc-ms ms)
  ;; what a turn's GC share adds to its line: nothing without any, `mostly GC` past half
  (cond
    (= gc-ms 0) ""
    (gc-heavy? gc-ms ms) (str " (gc " gc-ms " ms, mostly GC)")
    else (str " (gc " gc-ms " ms)")))

(defn summary-lines (reports)
  "One line per CAUSE (a report's phase and tag) in `reports`, the costliest first: how many
times it was slow, the time it took in all, its worst, how much of that was garbage
collection (the watchdog's `:gc-ms`; `mostly GC` past half, so a turn the collector made slow
is told from a slow fold), and how many of those turns were stopped by the loop's ceiling
rather than finishing.

    (slowlog/summary-lines [{:phase \"update\" :tag :lsp :ms 80} {:phase \"update\" :tag :lsp :ms 120}])   ;=> [\"  200 ms total    2×  worst 120 ms   update :lsp\"]
    (slowlog/summary-lines [{:phase \"view\" :tag :view :ms 90.4 :gc-ms 61.2}])   ;=> [\"   90 ms total    1×  worst 90 ms   view :view   (gc 61 ms, mostly GC)\"]"
  (let (groups (seq/group-by reports
                 (fn (report)
                   [(:phase report)
                     (if (string? (:tag report)) (:tag report) (pr-str (:tag report)))]))
        rows (map (seq groups)
               (fn ([[phase tag] group])
                 (let (times (map group (fn (report) (whole-ms (:ms report))))
                       stopped (count (seq/filter group :interrupted)))
                   {:total (reduce times 0 +)
                    :gc (reduce (map group (fn (report) (whole-ms (:gc-ms report)))) 0 +)
                    :count (count group)
                    :worst (reduce times 0 math/max)
                    :stopped stopped
                    :what (str phase " " tag)}))))
    (vec (map (sort rows (fn (left right) (> (:total left) (:total right))))
           (fn (row)
             (string/format "%5d ms total  %3d×  worst %d ms   %s%s%s"
               (:total row)
               (:count row)
               (:worst row)
               (:what row)
               (let (note (gc-note (:gc row) (:total row))) (if (= note "") "" (str "  " note)))
               (if (> (:stopped row) 0) (str "   (" (:stopped row) " stopped)") "")))))))

;; ---- key-to-paint latency, as a distribution (brood ADR-612) -----------------------
;; The window counts every key's input→present time into a histogram (`gui/latency-histogram`).
;; The idle beat records what it counted since the last record once [[*latency-flush-keys*]]
;; have come — a line per few hundred keys, never one per key — and quitting records the
;; rest. The model remembers the reading it last recorded up to (`:latency-recorded`, with
;; the window it came from, so a new window — another loop after a crash — starts over).

(def *latency-flush-keys* 200) ; keys counted before the idle beat records them

(defn latency-reports (reports)
  "The key-latency records among `reports` (`{:kind :latency :key h}`)."
  (seq/filter reports (fn (report) (= (:kind report) :latency))))

(defn slow-reports (reports)
  "The slow-turn reports among `reports` — everything but the latency records."
  (seq/reject reports (fn (report) (= (:kind report) :latency))))

(defn recorded-latency (reports)
  "Every key-latency record in `reports` merged into one histogram (`gui/latency-merge`), or
nil when there is none."
  (let (records (latency-reports reports))
    (when (not (empty? records))
      (fold records nil (fn (acc record) (gui/latency-merge acc (:key record)))))))

(defn percentile-line (histogram)
  "One line for `histogram` (`gui/latency-histogram`'s shape): its p50, p99, p99.9 and worst
in milliseconds, and how many keys it counts.

    (slowlog/percentile-line {:count 1000 :max-us 40000 :buckets {2047 980 8191 15 40959 5}})   ;=> \"p50 2.0 ms · p99 8.2 ms · p99.9 40.0 ms · worst 40.0 ms (1000 keys)\"
    (slowlog/percentile-line nil)   ;=> \"no keys timed yet\""
  (let (percentiles (gui/latency-percentiles (or histogram {})))
    (if (= (:count percentiles) 0)
      "no keys timed yet"
      (string/format "p50 %.1f ms · p99 %.1f ms · p99.9 %.1f ms · worst %.1f ms (%d %s)"
        (:p50 percentiles)
        (:p99 percentiles)
        (:p999 percentiles)
        (:max percentiles)
        (:count percentiles)
        (if (= (:count percentiles) 1) "key" "keys")))))

(defn latency-text (reports)
  "The key-to-paint section of `*Slow turns*`: the distribution over every session `reports`
recorded, or nothing when none has been."
  (let (histogram (recorded-latency reports))
    (if (nil? histogram)
      ""
      (str "Key to paint, every session recorded: " (percentile-line histogram) "\n\n"))))

(defn- window-latency (m)
  ;; this window's key histogram, or nil without a window of our own (a test, a terminal,
  ;; a served session) or once it has closed
  (let (window (:window m))
    (when window
      (check-allow :discarded-catch
        (try (:key (gui-only gui/latency-histogram window)) (catch _ nil))))))

(defn latency-due (m now &optional (least *latency-flush-keys*))
  "What to record of `now` (this window's key histogram): what it counted since the model's
`:latency-recorded` reading of the same window (all of it after a new window), when that is at
least `least` keys — else nil.

    (slowlog/latency-due {} {:count 3 :max-us 900 :buckets {911 3}} 2)   ;=> {:count 3 :max-us 900 :buckets {911 3}}
    (slowlog/latency-due {} {:count 1 :max-us 900 :buckets {911 1}} 2)   ;=> nil"
  (let ([window before] (or (:latency-recorded m) [nil nil])
        before (when (and (= window (:window m)) before (<= (:count before) (:count now))) before)
        fresh (when now (gui/latency-since now before)))
    (when (and fresh (> (:count fresh) 0) (>= (:count fresh) least)) fresh)))

(defn record-latency (m now &optional (least *latency-flush-keys*))
  "Record what `now` counted since the last record ([[latency-due]]) as a `{:kind :latency
:key h}` line ([[record!]]) and remember `now` as recorded; `m` unchanged when too few keys
have come or the log is off."
  (let (fresh (when *slow-log-file* (latency-due m now least)))
    (if (nil? fresh)
      m
      (do
        (record! {:kind :latency :key fresh})
        (assoc m :latency-recorded [(:window m) now])))))

(defn flush-latency (m &optional (least *latency-flush-keys*))
  "The idle beat's row, and what quitting calls with `least` 1: record this window's keys
since the last record ([[record-latency]]). O(1) without a window or with the log off."
  (if (or (nil? *slow-log-file*) (nil? (:window m))) m (record-latency m (window-latency m) least)))

(register-idle-job :key-latency {:order 140 :run 'slowlog/flush-latency})

(defn report-text (reports)
  "The `*Slow turns*` buffer's text for `reports` — the key-to-paint distribution
([[latency-text]]) above the slow turns ranked by cause."
  (let (slow (slow-reports reports))
    (str (latency-text reports)
      (if (empty? slow)
        "No slow turns recorded yet. The watchdog reports a turn of the editor loop that took\nlonger than its threshold; each is kept here across sessions.\n"
        (str "Slow turns of the editor loop, by what they were folding, costliest first ("
          (count slow)
          " recorded):\n\n"
          (string/join (summary-lines slow) "\n")
          "\n")))))

(defn ed-ev-ui-slow (m input textrows cols rows)
  "A slow turn the watchdog reported ([[model/ed-report-slow]]): kept in the log
([[record!]]) and appended to `*Messages*` — `slow update 73ms (gc 40 ms, mostly GC) on
[:timer :idle]`, the GC share when the watchdog measured one (`:gc-ms`) — and not echoed: the
reader is in the middle of something, and the line is for whoever goes looking for why a key
felt late.

An INTERRUPTED turn (brood ADR-491) says so: `interrupted update 2000ms on
:lsp-diagnostics`. One the reader stopped — a command (`:input` true), by C-g — also echoes
`Quit`, as Emacs does; a background event the loop's ceiling stopped stays in the log, since
nobody asked for it and an echo would interrupt whatever they are reading."
  (let (report (nth input 1)
        {:keys [phase tag interrupted]} report
        ms (whole-ms (:ms report))
        _ (record! report)
        logged (ed-append-named m
                 "*Messages*"
                 (str (if interrupted "interrupted " "slow ")
                   phase
                   " "
                   ms
                   "ms"
                   (gc-note (whole-ms (:gc-ms report)) ms)
                   " on "
                   (pr-str tag))))
    (if (and interrupted (:input report)) (assoc logged :echo "Quit") logged)))

(register-event-handler :ui-slow 'slowlog/ed-ev-ui-slow)

(defn ed-ev-blocking-call (m input textrows cols rows)
  "A native call that held the loop (brood ADR-517: the loop runs `(proc/flag :responsive
true)`, so an `os/cmd` it makes is reported after the wait): kept in the log under the
`blocking` phase, the command as its cause, and appended to `*Messages*` — `blocked 41ms on
os/cmd git status`. Each one is a call that belongs off the loop, in a task."
  (let ({:keys [native detail ms]} (nth input 1)
        _ (record! {:phase "blocking" :tag (str native " " detail) :ms ms}))
    (ed-append-named m "*Messages*" (str "blocked " ms "ms on " native " " detail))))

(register-event-handler :blocking-call 'slowlog/ed-ev-blocking-call)

(defn responsive! ()
  "Mark the calling process — the editor loop — as one that must keep answering (brood
ADR-517), so a native call that blocks it is reported as a `[:blocking-call …]` event."
  (proc/flag :responsive true)
  nil)

(defcommand cmd-slow-turns
  (m key)
  "Show `*Slow turns*`: key-to-paint latency over every session recorded (p50, p99, p99.9,
worst), then every slow turn of the editor loop kept across sessions, grouped by what it was
folding (a key, a timer, an event), costliest first (M-x slow-turns). This session's keys
are recorded first, so the distribution includes them."
  (let (recorded (flush-latency m 1))
    (ed-display-buffer recorded
      "*Slow turns*"
      (report-text (if *slow-log-file* (read-reports *slow-log-file*) [])))))
