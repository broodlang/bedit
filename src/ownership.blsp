(defmodule ownership
  "Who registered each entry of the editor's registries, so a package's can be taken back.

A feature registers its rows when its module LOADS — an idle job, an event handler, a mode
line chip, an M-x command, a mode, a theme (`model/register-idle-job`,
`statusbar/register-modeline-segment`, …). A package does the same, and removing or updating
it must take its rows back with its globals — a row naming a function no longer defined is
an idle job raising on every beat, a chip skipped every frame, a file type whose layers
would not resolve.

So every registry write goes through [[claim!]], which records the FILE whose load made it
(`reflect/current-file`) — or, outside a load, the [[*claimant*]] a caller bound (the package
manager binds the package while it applies a package's contribution). The rows a package
made are then the ones claimed from a file under its directory, and [[release-under!]] takes
them all back in ONE call before its globals go. A claim is a STACK over the entry that was
there before it: a package that replaced a core row (a theme of the same name, its own
handler for a tag) gives the core row back when it goes, not a hole.

A registry is named by a KIND. A kind that is a `std/registry` id needs nothing declared; one
kept elsewhere (the theme list, `editor/layers`' type table) says how to read, write and
remove an entry with [[define-kind]].")

;; The file a registration made OUTSIDE a module load is claimed for: the package manager
;; binds a file under the package's directory while it applies the package's contribution
;; (its themes are registered by the manager, not by the package's own load).
(defdyn *claimant* nil)

;; :ownership/claims  [kind key] -> {:stack [{:file :entry} …] :base-present? :base}
;;   the top of `:stack` (its last element) is the entry the registry holds now; `:base` is
;;   what it held before the first claim (absent when `:base-present?` is false)
;; :ownership/kinds   kind -> {:lookup :write :remove}, symbols called late

(defn define-kind (kind lookup write remove)
  "Declare a registry kept outside `std/registry`: `lookup` is a `(key) -> [present? entry]`
function, `write` a `(key entry)` and `remove` a `(key)` one. A kind nothing declared is a
`std/registry` id."
  (registry/put :ownership/kinds kind {:lookup lookup :write write :remove remove}))

(defn- kind-lookup (kind key)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared
      ((:lookup declared) key)
      (let (table (registry/entries kind)) [(contains? table key) (get table key)]))))

(defn- kind-write (kind key entry)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared ((:write declared) key entry) (registry/put kind key entry))))

(defn- kind-remove (kind key)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared ((:remove declared) key) (registry/remove kind key))))

(defn with-claimant (file thunk)
  "Call `thunk` with what it registers outside a module load claimed for `file` — a file
under a package's directory while the package manager applies that package."
  (binding (*claimant* file) (thunk)))

;; ---- run time: code a package's namespace runs -----------------------------------
;; A registration made OUTSIDE any load — a package's command or hook registering a row when
;; it runs — has no file to be claimed for. The package manager records which namespaces are
;; a package's (`:ownership/namespaces`, namespace -> claimant file), and the command
;; dispatch runs a command under the claimant of its symbol's namespace
;; ([[with-symbol-claimant]]), so what the command registers is the package's too.

(defn own-namespace! (namespace file)
  "Record that code in `namespace` (a string) runs for `file`: what it registers outside a
load, under [[with-symbol-claimant]], is claimed for `file`."
  (registry/put :ownership/namespaces namespace file))

(defn disown-namespace! (namespace)
  "Forget [[own-namespace!]]'s record for `namespace`."
  (registry/remove :ownership/namespaces namespace))

(defn symbol-namespace (sym)
  "Everything before the last `/` of `sym`'s name, nil for a root name.

    (ownership/symbol-namespace 'git/cmd-status)   ;=> \"git\""
  (let (parts (string/split (->string sym) "/"))
    (when (> (count parts) 1) (string/join (take parts (dec (count parts))) "/"))))

(defn code-namespace (code)
  "The namespace (a string) code `code` is in: a symbol's ([[symbol-namespace]]), a function's
module — an anonymous `fn` too (`reflect/fn-module`, brood ADR-596) — else nil.

    (ownership/code-namespace 'git/cmd-status)   ;=> \"git\""
  (cond
    (symbol? code) (symbol-namespace code)
    (fn? code) (let (module (reflect/fn-module code)) (when module (->string module)))
    else nil))

(defn with-symbol-claimant (sym thunk)
  "Call `thunk` — running the command or hook `sym` names (a symbol, or the function itself)
— with what it registers claimed for the package whose namespace it is in, when it is one.
The package's module is the run's acting writer too (`registry/with-acting-writer`, brood
ADR-596), so what it writes into std's registries is the package's, and so is everything a
process it starts registers — a timer's, a worker's. With no package namespace recorded it
is a plain call: the editor without packages pays one map read."
  (let (owners (registry/entries :ownership/namespaces))
    (if (empty? owners)
      (thunk)
      (let (namespace (code-namespace sym))
        (if (nil? namespace)
          (thunk)
          (let (file (get owners namespace))
            (if (nil? file)
              (thunk)
              (binding (*claimant* file) (registry/with-acting-writer (symbol namespace) thunk)))))))))

(defn- acting-claimant ()
  ;; the package whose code started this process — its load, a command, a timer — when the
  ;; registration comes from a process of its own (brood ADR-596): a module by its recorded
  ;; namespace, a file without a `defmodule` by its path
  (let (writer (registry/acting-writer))
    (cond
      (symbol? writer) (get (registry/entries :ownership/namespaces) (->string writer))
      (string? writer) writer
      else nil)))

(defn current-claimant ()
  "The file a registration made now is claimed for: the one being loaded, else the bound
[[*claimant*]], else the package whose code started this process (its acting writer, brood
ADR-596) — a timer or a worker it spawned — else nil (a registration at run time that no
file owns)."
  (or (reflect/current-file) *claimant* (acting-claimant)))

(defn- push-claim (kind key entry file)
  "Record that `file` claims `entry` under `[kind key]` — on top of what was there, replacing
its own earlier claim — without writing the registry."
  (let (claim-key [kind key]
        record (or (registry/lookup :ownership/claims claim-key)
                 (let ([present? value] (kind-lookup kind key))
                   {:stack [] :base-present? present? :base value}))
        others (into [] (seq/reject (:stack record) (fn (layer) (= (:file layer) file)))))
    (registry/put :ownership/claims
      claim-key
      (assoc record :stack (conj others {:file file :entry entry})))
    ;; indexed by file, so taking a package's claims back reads its own, not every claim
    ;; (a key a claim no longer holds is checked against the record when it is read)
    (registry/put :ownership/by-file
      file
      (conj (registry/lookup :ownership/by-file file #{}) claim-key))))

(defn- claim-keys-under (prefix)
  ;; every claim key a file under `prefix` claimed at some point — a superset, from the index
  (into #{}
    (mapcat (seq/filter (registry/entries :ownership/by-file) (fn ([file _]) (under? file prefix)))
      (fn ([_ keys]) (seq keys)))))

(defn- forget-files-under! (prefix)
  ;; the index entries of the files under `prefix`, once their claims are taken back
  (doseq ([file _] (registry/entries :ownership/by-file))
    (when (under? file prefix) (registry/remove :ownership/by-file file))))

(defn claim! (kind key entry)
  "Register `entry` under `key` in the registry `kind` — replacing what is there — and record
who did ([[current-claimant]]). A registration no file owns clears the record: the entry is
nobody's to take back. Returns `entry`."
  (let (file (current-claimant))
    (if (nil? file)
      (registry/remove :ownership/claims [kind key])
      (push-claim kind key entry file))
    (kind-write kind key entry)
    entry))

(defn adopt! (kind key file base-present? base)
  "Record that `file` claims what `[kind key]` holds NOW — written by code that does not go
through [[claim!]] (std's `settings/define`) — over `base`, what it held before (absent when
`base-present?` is false). A key that holds nothing is not adopted."
  (let ([present? value] (kind-lookup kind key))
    (when present?
      (when (nil? (registry/lookup :ownership/claims [kind key]))
        (registry/put :ownership/claims
          [kind key]
          {:stack [] :base-present? base-present? :base base}))
      (push-claim kind key value file))))

(defn unclaim! (kind key)
  "Remove `key` from the registry `kind` outright, with every claim on it — an explicit
unregistration (a theme taken out of the picker by name)."
  (registry/remove :ownership/claims [kind key])
  (kind-remove kind key))

(defn drop-entry! (kind key)
  "Take `key` out of the registry `kind` whoever wrote it — the backstop for a row nothing
claimed: the entry from before the first claim comes back when there is one, else the entry
goes."
  (let (record (registry/lookup :ownership/claims [kind key]))
    (registry/remove :ownership/claims [kind key])
    (if (and record (:base-present? record))
      (kind-write kind key (:base record))
      (kind-remove kind key))))

(defn- under? (file prefix)
  (and (string? file) (string/starts-with? file prefix)))

(defn claims-under (directory)
  "Every `[kind key]` a file under `directory` claims, sorted — what [[release-under!]] would
take back."
  (let (prefix (str directory "/"))
    (vec (sort (seq/filter (claim-keys-under prefix)
                 (fn (claim-key)
                   (let (record (registry/lookup :ownership/claims claim-key))
                     (and record (any? (:stack record) (fn (layer) (under? (:file layer) prefix)))))))))))

(defn release-under! (directory)
  "Take back every registry entry a file under `directory` claimed — a package's, before its
globals are retired — and answer the `[kind key]`s released. Where another claim or the
entry from before the first one is left, that is what the registry holds again; where none
is, the entry goes."
  (let (prefix (str directory "/")
        released (vec (seq/keep (claim-keys-under prefix)
                        (fn (claim-key) (release-claim claim-key prefix)))))
    (forget-files-under! prefix)
    released))

(defn- release-claim (claim-key prefix)
  ;; the claims files under `prefix` hold on `claim-key` taken back — the registry left with
  ;; the claim below them, else the entry from before the first claim, else nothing — and
  ;; `claim-key` answered; nil when none of its claims is theirs
  (let (record (or (registry/lookup :ownership/claims claim-key) {:stack []})
        stack (:stack record)
        kept (into [] (seq/reject stack (fn (layer) (under? (:file layer) prefix))))
        [kind key] claim-key)
    (when (< (count kept) (count stack))
      (cond
        (not (empty? kept))
          (do
            (registry/put :ownership/claims claim-key (assoc record :stack kept))
            (when (not (= (last kept) (last stack))) (kind-write kind key (:entry (last kept)))))
        (:base-present? record)
          (do (registry/remove :ownership/claims claim-key) (kind-write kind key (:base record)))
        else (do (registry/remove :ownership/claims claim-key) (kind-remove kind key)))
      claim-key)))
