(defmodule attach
  "**Which runtime is my code running in?** — one answer, for every session the editor
keeps.

bedit can point an evaluation session at a process it did not start: the Elixir agent at a
BEAM node (`Node.connect`), the Brood sandbox at a peer (`node/connect`). Those are one
feature, so they are one implementation — one reply fold, one `attached-node`, one prompt
flow — and a rule such as \"an attachment must not outlive the child that held it\" holds for
every language at once: a chip naming a node while evaluation has quietly gone back to
running locally is the one failure the feature exists to prevent.

A language is a row in [[*targets*]]: which session, where its state lives, how to ask it
to attach, and what to do once it has."
  (:use statusbar :only []) ; its chip registers at load, after statusbar is there
  (:use minibuffer)
  (:use model) ; message / ed-mb-edit — the prompt and the echo
  (:use theme :only [*red*])) ; the palette the faces are drawn from
;; The backends are referenced through their rows' symbols, resolved late: both are
;; DEFERRED modules, and naming them eagerly would load a BEAM agent into an editor that
;; never opens an Elixir file.

(defdyn *targets*
  ;; One row per session that can be pointed somewhere else.
  ;;
  ;;   :state-key  where this session's attachment lives on the model
  ;;   :attach / :detach   (id …) -> accepted? — the backend's request
  ;;   :runtime    what to call the thing it goes back to, in a sentence
  ;;   :needs      the sentence when there is no session to attach at all
  ;;   :after      (m) -> m, run once an attach succeeds (refresh what is on screen)
  {:elixir {:state-key :beam
            :attach 'elixir-sandbox/elixir-attach
            :detach 'elixir-sandbox/elixir-detach
            :running? 'elixir-sandbox/elixir-running?
            :cookie 'elixir-sandbox/default-cookie
            :runtime "node"
            :needs "no Elixir session to attach — M-x elixir-playground starts one"
            :after 'beam/beam-request}
   :brood {:state-key :sandbox
           :attach 'sandbox/sandbox-attach
           :detach 'sandbox/sandbox-detach
           :running? 'sandbox/sandbox-running?
           :runtime "runtime"
           :needs "no Brood session to attach — open a playground or evaluate something first"
           :after nil}})

(defn- call (target key args fallback)
  (let (hook (map/get-in *targets* [target key]))
    (if (or (nil? hook) (not (bound? hook))) fallback (apply (reflect/eval hook) args))))

(defn- state-key (target) (map/get-in *targets* [target :state-key]))

(defn attached-node (m target)
  "The node `target`'s session is routed to, or nil for its own."
  (map/get-in m [(state-key target) :attached]))

(defn any-attached (m)
  "The node ANY session is attached to, or nil when they are all at home — what the mode
line reads. One chip, because the question it answers (\"is what I evaluate running
somewhere else?\") has one answer whichever language asked it."
  (first (seq/keep (keys *targets*) (fn (target) (attached-node m target)))))

(defn forget (m target)
  "Drop `target`'s attachment — what a session's death means, whatever else it means.

The respawn that follows is a fresh runtime that has never heard of the node you were on,
so the alternative is a chip naming a node while your evaluations quietly run locally
again. Not re-attached either: silently reconnecting to somebody's production node after a
crash is worse than making you ask twice."
  (map/assoc-in (map/assoc-in m [(state-key target) :attached] nil)
    [(state-key target) :attaching]
    nil))

(defn pending? (m target reply)
  "Is `reply` the answer to an attach/detach this editor asked `target` for?"
  (let (id (map/get-in m [(state-key target) :attaching]))
    (and id (= id (get reply :id)))))

(defn reply (m target answer)
  "Fold the `answer`. Reported rather than assumed: an attach that silently did not happen
leaves you evaluating locally while believing you are not."
  (let (answered (map/assoc-in m [(state-key target) :attaching] nil)
        node (get answer :node))
    (cond
      (not (get answer :ok))
        (message (forget answered target)
          (str "could not attach: " (get answer :error "unknown error")))
      (nil? node)
        (message (forget answered target)
          (str "detached — back on bedit's own " (map/get-in *targets* [target :runtime])))
      else
        (let (attached (map/assoc-in answered [(state-key target) :attached] node))
          (message (call target :after (list attached) attached)
            (str "attached to " node " — every evaluation now runs THERE"))))))

(defn- ask (m target verb args note)
  ;; The request id comes from `session`'s shared id space, resolved at CALL time for the
  ;; same reason the backends are: a bare `session/…` reference in this module's body would
  ;; load the session layer (and the supervision it names) when `attach` loads, and
  ;; `attach` is on the mode line's path — so every editor that never evaluates anything
  ;; would pay for it. Nothing here runs until you have actually asked to attach.
  (let (next-id (reflect/eval 'session/next-id)
        ids-used (reflect/eval 'session/ids-used)
        id (next-id m)
        sent (call target verb (cons id args) false))
    (if (not sent)
      (message m "the session is not running")
      (message (map/assoc-in (ids-used m (inc id)) [(state-key target) :attaching] id) note))))

(defn prompt (m target)
  "The two-step attach prompt: the node, then its cookie.

The node is TYPED, never picked from a list of what is reachable — that menu is one
keystroke from evaluating on production. The cookie is asked for rather than read on your
behalf, because a credential used without being asked for is how you find out afterwards
which machine you connected to."
  (if (not (call target :running? '() false))
    (message m (map/get-in *targets* [target :needs]))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Attach to node: " "")
         :on-complete (fn (m1 spec)
                        (let (spec (string/trim spec))
                          (if (= spec "")
                            (message m1 "no node named")
                            (assoc m1
                              :minibuffer
                                {:edit (ed-mb-edit (str "Cookie for " spec ": ")
                                         (default-cookie target))
                                 ;; a credential: never kept in the prompt history (savehist)
                                 :no-history true
                                 :on-complete (fn (m2 cookie)
                                                (ask m2
                                                  target
                                                  :attach (list spec (string/trim cookie))
                                                  (str "connecting to " spec "…")))}))))})))

(defn detach (m target)
  "Route `target`'s session back to bedit's own runtime."
  (if (nil? (attached-node m target))
    (message m "not attached to anything")
    (ask m target :detach '() "detaching…")))

(defn default-cookie (target)
  "The cookie offered as the prompt's default: the BEAM's `~/.erlang.cookie` where there is
one, and nothing for Brood (whose `node/connect` authenticates with the runtime's own).

OFFERED, never used silently — see [[prompt]].

Through [[call]] like every other backend hook: a bare qualified reference to
`elixir-sandbox/default-cookie` would LOAD the module, and `attach` is reached from the mode
line, so it would put a BEAM agent into the startup of every editor that never opens an Elixir
file. Only a session that is already running gets this far ([[prompt]] checks `:running?`
first), so by the time it is asked the module is loaded and the late lookup finds it."
  (or (call target :cookie '() nil) ""))

;; ---- the mode-line chip ------------------------------------------------------
;; ATTACHED: the node every evaluation is now going to. Red, and on the bar of whatever you
;; are editing rather than only in the *BEAM Processes* buffer, because the whole risk of
;; the feature is forgetting you are on somebody else's VM. Registered here, where the
;; attachment lives: no session can be attached before this module has loaded.

(defn ed-beam-node (m)
  "The node one of bedit's sessions is attached to, or nil when they are all on their own.

Asked of [[any-attached]], whose table of sessions is the one place that knows which they
are — a chip that quietly stopped naming a third language's node would be the same failure
this feature exists to prevent. Safe from the mode line, which is drawn every frame: the
table is plain data and its backends are symbols resolved only when one is actually asked
to attach, so nothing here loads a BEAM agent."
  (any-attached m))

(defn ed-beam-node-label (m)
  "The attached-node chip, or `\"\"` when this editor is on its own runtime."
  (let (node (ed-beam-node m)) (if (nil? node) "" (str "⇄ " node))))

(defn attached-segment (m pane buf)
  "The attached-node chip: red, click to detach."
  (statusbar/seg :beam-node
    (ed-beam-node-label m)
    {:sep "  —  "
     :face {:fg *red* :bold true}
     :on-click 'beam/cmd-beam-detach
     :tooltip (fn (mm)
                [(str "attached to " (or (ed-beam-node mm) "?"))
                  "every Elixir evaluation and observation runs THERE"
                  "click to detach (M-x beam-detach)"])}))

(statusbar/register-modeline-segment :beam-node 70 'attach/attached-segment)
