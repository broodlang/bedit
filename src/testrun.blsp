(defmodule testrun
  "Native test runs — the editor hooks straight into std's test framework, but in a
DEDICATED `nest` subprocess, never in its own image: the runner's `%isolate` restores
the whole global table and kills every pid that appeared during a run (correct for a
test image, catastrophic for a live editor), so 'native' means the same runtime in
its own OS process.

The subprocess runs a generated Brood script (`testrun-script-source`, written to
/tmp per run) that replicates `nest test`'s own bootstrap and installs a
`*test-report-sink*` — std's structured per-test reporting seam, handed each result
in the worker as it finishes — that prints one JSON object per line, then the
`run-tests-structured` summary map. (A defdyn seam, added for exactly this: the
runner fns ship in the binary, so ADR-166 reserves their names against advice.)
The editor side is compile.blsp's proven shape: the shared
`procstream` worker owns the proc handle and line-buffers stdout; testrun supplies
the handlers that JSON-decode each line and forward `UiEvent` records the loop folds
into `*Tests*` — pass/fail rows stream in live, failures carry `file:line:col`, and
RET/click jumps to them (the shared location-jump layer).

Test prints from the suite itself interleave with the JSON on stdout; anything that
doesn't parse as a tagged object is forwarded verbatim (`test-output-event`), so a
suite's own output is visible rather than lost."
  (:use editor/buffer) ; buffer-file / buffer-rope / buffer-line-count — the marks + jump
  (:use model) ; UiEvent + message / ed-append-named / ed-buf-at
  (:use interactive) ; defcommand
  (:use commands) ; ed-show-named / ed-find-file / ed-apply / ed-goto-line
  (:use results) ; ed-append-follow / loc-at-line / default-line-loc — the results-buffer abstraction
  (:use editor/keymap) ; keymap-bind — the *Tests* keys
  (:use editor/layers)) ; register-type-layers — the :test-menu buffer type
(def *tests-buffer* "*Tests*")

;; ---- the async events (UiEvent records — see model.blsp) --------------------

(defrecord test-result-event (result gen)) ; one finished test; `gen` = the run it belongs to
(defrecord test-summary-event (summary gen)) ; the run's structured summary map
(defrecord test-output-event (text gen)) ; a non-JSON stdout line (the suite's own prints)
(defrecord test-line-event (line gen)) ; one RAW stdout line, decoded in the fold
(defrecord test-done-event (code gen)) ; the runner subprocess exited
;; ---- the generated runner script ---------------------------------------------
;; Built as quoted FORMS and pr-str'd — no string escaping, and the per-run spec
;; list is spliced in as data (no argv contract with `nest run` needed). `specs` is
;; a list of `{:file abs-path :line n-or-nil}`; empty means the whole project suite.

(defn- testrun-script-forms (specs)
  (list
    ;; nest test's own single-file bootstrap: project image first, so cross-module
    ;; names resolve when a test file loads (each `mod/name` auto-loads its module).
    '(project/load-config)
    '(let (root (project/find-root (file/cwd)))
       (when root
         (project/setup root)
         (project/load-sources root)))
    ;; a modest parallel batch: the editor may live in a small container, and
    ;; `nest run` sets no test memory ceiling (that's `nest test`'s ADR-043 default)
    '(def *parallel-batch* 2)
    ;; spy in test code streams out too — the shared debugger tap
    debugger/debugger-spy-tap-form
    ;; the streaming seam: `*test-report-sink*` (a defdyn, so a root-rebinding `def`
    ;; installs it image-wide — `trace-result` itself is a reserved name, ADR-166)
    ;; is handed each finished result in the worker — emit one JSON line per test
    '(def *test-report-sink*
       (fn (r)
         (io/puts (json/encode {:event "test"
                                :group (test/r-group r)
                                :name (test/r-name r)
                                :passed (not (test/r-failed? r))
                                :skipped (test/r-skipped? r)
                                :ms (test/r-ms r)
                                :where (test/r-where r)
                                :failures (or (map (test/r-fails r)
                                                (fn (f) {:loc (first f) :details (second f)}))
                                            [])}))))
    (list 'testrun-go (list 'quote specs))))

(def- testrun-main-form
  ;; the driver, quoted whole: load the named files (registering their units), then
  ;; run structured — line-filtered when any spec carries a line — and print the
  ;; summary as the final JSON line. No specs = the whole project suite.
  '(defn testrun-go (specs)
     (let (summary (if (empty? specs)
                     (project-run/run-tests-structured)
                     (do
                       (doseq (s specs) (reflect/load (get s :file)))
                       (let (lines (seq/keep specs
                                     (fn (s)
                                       (when (get s :line) [(get s :file) (get s :line)]))))
                         (if (empty? lines)
                           (test/run-tests-structured)
                           (test/run-tests-structured :filter {:lines lines}))))))
       (io/puts (json/encode (assoc summary :event "summary"))))))

(defn- testrun-script-source (specs)
  (string/join (map (cons testrun-main-form (testrun-script-forms specs)) pr-str) "\n"))

;; unguessable, per editor process — see sandbox.blsp on why a fixed /tmp name is
;; both a collision between two editors and a symlink hazard
(def *testrun-script-path* (path/temp "bedit-test-events-"))

;; ---- the runner process (compile.blsp's shape: own the proc, stream, forward) --

(defn- testrun-handlers ()
  "The `procstream` handlers (each takes the run token): every stdout line is
forwarded RAW, stderr as plain output, the exit as the done event.

Decoding used to happen here, in the worker, because Brood's runner emits one
self-contained JSON object per line and a stateless fn could classify it. ExUnit
cannot be read that way — a test's verdict arrives after its line — so the decoder
needs state, and these handlers are plain fns captured at spawn with nowhere to keep
any. The state lives in the model instead, which is where a TEA program keeps state,
and both runners now take the same route: raw line in, `testadapter` events out."
  {:on-line (fn (line gen) (send :editor (test-line-event line gen)))
   :on-err-line (fn (line gen) (send :editor (test-output-event line gen)))
   :on-done (fn (code gen) (send :editor (test-done-event code gen)))})

(defn- testrun-clear-marks (m)
  "Drop every buffer's test verdict marks (per-test + describe rollup) — a fresh
run's verdicts replace the last run's."
  (assoc m
    :buffers
      (into []
        (map (:buffers m) (fn (b) (dissoc b :test-marks :describe-marks :line-links))))))

(defn- testrun-invocation (m specs)
  "`[prog argv adapter-id]` for this project's test run.

Brood's is generated: a script is written to a temp path and booted by `nest run`,
because the editor needs `*test-report-sink*` installed inside the image and there
is no flag for that. Every other toolchain names a program and its arguments in
`toolchain/*toolchains*` and is read back through its adapter — the only reason this
function has two arms rather than one table lookup."
  (if (toolchain/brood? m)
    (do
      (file/spit *testrun-script-path* (testrun-script-source specs))
      ["nest" ["run" *testrun-script-path*] :brood])
    (let (inv (toolchain/test-invocation m specs))
      (when inv [(first inv) (second inv) (toolchain/adapter-id m)]))))

(defn testrun-start (m specs root label)
  "Start a test run: (re)start the `:testrun` worker on this project's runner, reset
the *Tests* buffer (and every buffer's old verdict marks), and remember the
invocation for `g`/rerun. The runner differs per toolchain; everything after the
first decoded line does not."
  (let (inv (testrun-invocation m specs)
        [prog argv adapter-id] (or inv ["" [] nil])
        proc (spawn :testrun (procstream/procstream-loop (testrun-handlers)))
        ;; a fresh run generation — events tagged with an older gen (a superseded
        ;; run's in-flight stragglers) are dropped by the folds
        gen (inc (or (get-in m [:testrun :gen]) 0))
        ;; the runner reads FILES — a spec'd buffer with unsaved edits tests the
        ;; saved content, and the echo should say so rather than let it surprise
        unsaved? (any? specs
                   (fn (spec)
                     (let (i (testrun-buffer-for m (get spec :file)))
                       (and i (:modified (ed-buf-at m i)))))))
    (send proc [:run prog argv root gen])
    (ed-show-named-aside (message (assoc (testrun-clear-marks m)
                                    :testrun
                                      {:specs specs
                                       :root root
                                       :label label
                                       :gen gen
                                       :passed 0
                                       :failed 0
                                       :last-group nil
                                       :adapter-id adapter-id
                                       :decoder (testadapter/init (testadapter/for-toolchain adapter-id))})
                           (str "testing "
                             label
                             "…"
                             (if unsaved? "  (unsaved changes — testing the file as saved)" "")))
      *tests-buffer*
      (tests-header label "cold")
      :test-menu)))

(defn tests-header (label mode)
  "The `*Tests*` banner: what was run, and by WHICH runner.

Saying which is not decoration. The two runners differ in ways a reader has to be able to
account for — one starts a runtime and one reuses a session — and when the warm one was
silently testing the code it booted with, the only symptom was a verdict that disagreed
with the file on screen, with nothing anywhere to suggest where to look. A word in the
banner is the cheapest possible answer to \"which of these am I reading?\"."
  (str "-*- tests: " label (if mode (str "  ·  " mode) "") " -*-\n\n"))

;; ---- rendering + folds ----------------------------------------------------------

(defn- testrun-loc-line (f)
  "One failure line, `file:line:col: first-detail` (the compile-error shape RET
parses), then the remaining details indented."
  (let (loc (get f :loc)
        details (or (get f :details) '())
        head (if (nil? loc)
               "    (no location)"
               (str "    " (nth loc 0) ":" (nth loc 1) ":" (nth loc 2) ":"))
        first-detail (or (first details) ""))
    (string/join (cons (str head " " first-detail) (map (rest details) (fn (d) (str "        " d))))
      "\n")))

(defn- testrun-where->loc (where)
  "Parse a `relpath:line` `:where` into a `{:file :line :col}` loc, or nil."
  (when (and where (not (= where "")))
    (let (parts (string/split where ":")
          ln (string/->number (last parts)))
      (when (int? ln)
        {:file (string/join (take parts (dec (count parts))) ":") :line ln :col 1}))))

(defn- testrun-describe-loc (m r)
  "The `{:file :line}` loc of `r`'s describe head — the `(describe …)` line resolved
via the open source buffer when possible, else the test's own `:where` (still inside
the describe). Makes the header a jump target (off-text)."
  (let (base (testrun-where->loc (get r :where)))
    (if (nil? base)
      nil
      (let (idx (testrun-buffer-for m (:file base)))
        (if (nil? idx)
          base
          (let (dh (testrun-describe-head-line (ed-buf-at m idx) (dec (:line base))))
            (if (nil? dh) base (assoc base :line (inc dh)))))))))

(defn testrun-group-header (group)
  "The *Tests* header line for a describe `group` — just the group name, bold and
un-indented; its tests indent under it. Clickable via the off-text `:line-links`
store (a describe header links to its source), not visible link text."
  (if (= group "") "(top level)" group))

(defn- testrun-append-link (m text loc cols rows)
  "Append `text` (one logical line, +failure lines) to *Tests* — following the tail in
any pane at its bottom (`ed-append-follow`) — and, when `loc` is non-nil, record the LINE
the row lands on in the buffer's `:line-links` map — the off-text jump target the
pointer/hover and click read (`:line-loc`), so the visible row stays clean (no file path).
The line is the one CONTAINING the pre-append end offset (`text/char->line`) — exact,
unlike a line-count guess that a trailing newline throws off by one (which stranded links
on blank rows)."
  (let (idx0 (ed-buffer-index-by-name m *tests-buffer*)
        start-off (if (nil? idx0) 0 (buffer-length (ed-buf-at m idx0)))
        m1 (ed-append-follow m *tests-buffer* (str text "\n") cols rows))
    (if (nil? loc)
      m1
      (let (idx (ed-buffer-index-by-name! m1 *tests-buffer*) ; `ed-append-follow` just made it
            b (ed-buf-at m1 idx)
            landed (text/char->line (buffer-rope b) start-off))
        (update m1
          :buffers assoc
          idx
          (assoc b :line-links (assoc (or (:line-links b) {}) (math/max 0 landed) loc)))))))

(defn testrun-result-lines (r)
  "The *Tests* lines for one finished test: an indented ✓/✗ row under its describe
header (+ failure locations under a failing one). The row carries its declaration
site (`:where`) at the end, so the rows themselves are jump targets through the
shared location parser — RET or click any row to visit its test."
  (let (mark (cond (get r :skipped) "·" (get r :passed) "✓" else "✗")
        row (str "  " mark " " (get r :name) "  (" (get r :ms) " ms)"))
    (if (get r :passed)
      row
      (string/join (cons row (map (get r :failures) testrun-loc-line)) "\n"))))

(defn- testrun-path-suffix? (path relpath)
  "Whether `relpath` matches `path` at a component boundary (so `foo_test.blsp`
matches `a/foo_test.blsp` but not `xfoo_test.blsp`) — the std `test-path-suffix?`
discipline, avoiding a wrong-buffer mark on a coincidental suffix."
  (or (= path relpath)
    (string/ends-with? path (str "/" relpath))))

(defn- testrun-buffer-for (m relpath)
  "The pool index of the open buffer backing `relpath` (a run-root-relative test
file), or nil — matched at a path-component boundary."
  (first (seq/keep (range (count (:buffers m)))
           (fn (i)
             (let (f (buffer-file (ed-buf-at m i)))
               (when (and f (testrun-path-suffix? f relpath)) i))))))

(sig testrun-test-head-line (buffer int -> int))
(defn- testrun-test-head-line (b line0)
  "The 0-based `(test …)` head line at or above `line0` — the framework's `:where`
points at the test's FIRST BODY FORM (its position varies with formatting: the line
below the head, or the same line for a one-liner), so the ✓/✗ mark resolves upward
to the `(test`/`(describe` head it belongs to."
  (cond
    (< line0 0) line0
    else
      (let (t (string/triml (buffer-line-at b line0)))
        (if (or (string/starts-with? t "(test ")
              (string/starts-with? t "(test\"")
              (string/starts-with? t "(describe"))
          line0
          (testrun-test-head-line b (dec line0))))))

(sig testrun-describe-head-line (buffer int -> (or nil int)))
(defn- testrun-describe-head-line (b line0)
  "The 0-based `(describe …)` head at or above `line0`, or nil — the enclosing block
of the test at `line0`."
  (cond
    (< line0 0) nil
    (string/starts-with? (string/triml (buffer-line-at b line0)) "(describe") line0
    else (testrun-describe-head-line b (dec line0))))

(defn- testrun-describe-test-total (b describe-line)
  "How many `(test …)` forms sit syntactically under the describe at `describe-line`
— counted from its body to the next top-level form (a `(` at column 0). Lets the
rollup tell 'all ran' from 'some ran' (a line-filtered single-test run)."
  (letrec (go (fn (i n)
                (if (>= i (buffer-line-count b))
                  n
                  (let (raw (buffer-line-at b i)
                        t (string/triml raw))
                    (cond
                      (string/starts-with? raw "(") n ; the next top-level form ends the block
                      (or (string/starts-with? t "(test ") (string/starts-with? t "(test\""))
                        (go (inc i) (inc n))
                      else (go (inc i) n))))))
    (go (inc describe-line) 0)))

(defn- testrun-bump-describe (b describe-line verdict)
  "Accumulate one child verdict into the describe's rollup tally (`:describe-marks
{line {:pass :fail :skip :total}}`) — `:total` computed once from the buffer."
  (let (marks (or (editor/buffer/annotation-value b :describe-marks) {})
        cur (or (get marks describe-line)
              {:pass 0 :fail 0 :skip 0 :total (testrun-describe-test-total b describe-line)})
        slot (cond (= verdict :skipped) :skip verdict :pass else :fail))
    (editor/buffer/annotate b :describe-marks (assoc marks describe-line (update cur slot inc)))))

(defn- testrun-annotate (m r)
  "Stamp a finished test's verdict into its buffer's margin (`:test-marks
{0-based-line passed?}`, drawn by `modes/gutter-mark-for`): ✓/✗/· on the test's
`(test …)` head line (`testrun-test-head-line` resolves it from `:where`, which
points at the first body form) AND rolled up onto the enclosing `(describe …)` head
(`:describe-marks` — ✓ all-pass, a mixed icon on any failure, a partial icon when
only some of the describe's tests ran). Dimmed by the gutter once the buffer is
edited. A test with no recorded position, or whose file isn't open, marks nothing."
  (let (where (or (get r :where) ""))
    (if (= where "")
      m
      (let (parts (string/split where ":")
            line (string/->number (last parts))
            relpath (string/join (take parts (dec (count parts))) ":")
            idx (when (int? line) (testrun-buffer-for m relpath)))
        ;; `idx` is only set when `line` parsed, but that implication crosses two
        ;; bindings — test both, so the `(dec line)` below reads as guarded where it is.
        (if (and (int? line) idx)
          (let (b (ed-buf-at m idx)
                ;; Where the mark goes depends on what the runner's line MEANS. Brood
                ;; reports the first body form, so resolve upward to the `(test …)`
                ;; head; ExUnit reports the declaration line itself, and resolving
                ;; upward would search for Brood syntax it will never find, walk off
                ;; the top of the file, and pile every verdict onto line 0.
                head (if (= :head
                           (testadapter/where-points-at (testadapter/for-toolchain (get-in m
                                                                                     [:testrun
                                                                                       :adapter-id]))))
                       (math/max 0 (dec line))
                       (math/max 0 (testrun-test-head-line b (dec line))))
                verdict (cond (get r :skipped) :skipped (get r :passed) true else false)
                desc (testrun-describe-head-line b head)
                ;; one annotation, stamped with the text it describes (std's
                ;; `annotate` owns the currency/staleness pairing)
                b1 (editor/buffer/annotate b
                     :test-marks (assoc (or (editor/buffer/annotation-value b :test-marks) {}) head verdict))
                b2 (if (nil? desc) b1 (testrun-bump-describe b1 desc verdict)))
            (update m :buffers assoc idx b2))
          m)))))

(defn- testrun-current? (m gen)
  "Whether `gen` is the run the model is currently showing — a straggler from a
superseded run (rapid re-runs) is dropped so it can't corrupt the fresh report."
  (= gen (get-in m [:testrun :gen])))

(defn- testrun-apply-result (m r cols rows)
  ;; A finished test streams into *Tests* — under a describe HEADER emitted the first
  ;; time a group is seen (its tests indent below it) — AND stamps its ✓/✗ into the
  ;; test file's margin; failures bump the model's count so the summary echo can say
  ;; "3 failed" before the summary lands.
  ;;
  ;; A plain function, not the event fold itself, because the same result arrives two
  ;; ways: as a `test-result-event` (what the tests send), and out of `testadapter`
  ;; when a raw line is decoded. Whichever runner produced it, this is what it means.
  (let (group (or (get r :group) "")
        key (if (get r :passed) :passed :failed)
        m1 (update-in m [:testrun key] (fn (n) (inc (or n 0))))
        ;; a header line when the group changes (arrival order; a re-header on
        ;; interleaved parallel groups is informative, not wrong)
        m2 (if (= group (get-in m1 [:testrun :last-group]))
             m1
             (testrun-append-link (assoc-in m1 [:testrun :last-group] group)
               (testrun-group-header group)
               (testrun-describe-loc m1 r)
               cols
               rows)))
    (testrun-annotate (testrun-append-link m2
                        (testrun-result-lines r)
                        (testrun-where->loc (get r :where))
                        cols
                        rows)
      r)))

(impl UiEvent
  test-result-event
  (ui-event-fold [e m textrows cols rows]
    (if (not (testrun-current? m (test-result-event-gen e)))
      m
      (testrun-apply-result m (test-result-event-result e) cols rows))))

(defn- testrun-apply-summary (m s cols rows)
  (let (line (str "\n"
               (get s :total)
               " tests, "
               (get s :passed)
               " passed, "
               (get s :failed)
               " failed ("
               (get s :ms)
               " ms)\n"))
    (message (ed-append-follow m *tests-buffer* line cols rows)
      (str "tests: "
        (get s :passed)
        "/"
        (get s :total)
        " passed"
        (if (> (get s :failed) 0) (str ", " (get s :failed) " FAILED") "")))))

(impl UiEvent
  test-summary-event
  (ui-event-fold [e m textrows cols rows]
    (if (not (testrun-current? m (test-summary-event-gen e)))
      m
      (testrun-apply-summary m (test-summary-event-summary e) cols rows))))

(defn- testrun-apply-output (m text cols rows)
  (ed-append-follow m *tests-buffer* (str "  | " text "\n") cols rows))

(impl UiEvent
  test-output-event
  (ui-event-fold [e m textrows cols rows]
    (if (not (testrun-current? m (test-output-event-gen e)))
      m
      (testrun-apply-output m (test-output-event-text e) cols rows))))

;; ---- one raw line, whichever runner produced it ------------------------------
;; The join between the two runners. A line arrives, the run's adapter decodes it
;; into zero or more events in the shared vocabulary, and each is applied by the same
;; function a `test-result-event` would reach. The decoder's state rides on the model
;; between lines, which is what lets an adapter hold a test back until it knows
;; whether it passed.

(defn- testrun-apply-event (m ev cols rows)
  (case (first ev)
    :test (testrun-apply-result m (second ev) cols rows)
    :summary (testrun-apply-summary m (second ev) cols rows)
    ;; a spy entry from test code: rendered like *Run*'s (the shared renderer)
    :spy
      (testrun-apply-output m
        (str "~ "
          (debugger/debugger-spy-body (get (second ev) :kind)
            (get (second ev) :form)
            (get (second ev) :value)
            (get (second ev) :fn)
            (get (second ev) :args)))
        cols
        rows)
    :output (testrun-apply-output m (second ev) cols rows)
    m))

(defn- testrun-fold-line (m line cols rows)
  "Decode one stdout line with this run's adapter and apply what it yields."
  (let (adapter (testadapter/for-toolchain (get-in m [:testrun :adapter-id])))
    (if (nil? adapter)
      m
      (let ([state events] (testadapter/decode adapter (get-in m [:testrun :decoder]) line))
        (fold events
          (assoc-in m [:testrun :decoder] state)
          (fn (acc ev) (testrun-apply-event acc ev cols rows)))))))

(impl UiEvent
  test-line-event
  (ui-event-fold [e m textrows cols rows]
    (if (not (testrun-current? m (test-line-event-gen e)))
      m
      (testrun-fold-line m (test-line-event-line e) cols rows))))

(impl UiEvent
  test-done-event
  ;; Non-zero exit with no summary = the run itself broke (a load error, a crash) —
  ;; say so; a clean exit already reported via the summary.
  (ui-event-fold [e m textrows cols rows]
    (let (code (test-done-event-code e))
      (if (and (testrun-current? m (test-done-event-gen e)) code (not (= code 0)))
        (message (ed-append-named m *tests-buffer* (str "\n[runner exited " code "]\n"))
          (str "test runner exited " code " — see " *tests-buffer*))
        m))))

;; ---- the warm node: the same suite, without the VM boot ---------------------------
;; An Elixir run costs a VM start and a compile before its first verdict — a second and a
;; half in a small project, fifteen in a Phoenix one — and you pay it again every time you
;; press the key, for a suite you are running every few seconds while you fix one test.
;;
;; `elixir-test` keeps a `MIX_ENV=test` node up (see that module for why it is a SECOND
;; node and not the playground's). When it is up and ready, `C-c t` sends it the files and
;; the verdicts stream back as `:more` replies, one per test. Everything downstream is
;; unchanged: the same `testadapter` vocabulary, the same rows, the same margin marks, the
;; same RET.
;;
;; The cold runner is never removed and never slower: a run with no warm node uses it AND
;; starts one, so the first `C-c t` in a project behaves exactly as it always did and every
;; one after it is fast.

(defdyn *warm-tests* true)
;; Whether `C-c t` may keep a test session warm at all. Set false on a machine where a
;; resident runtime per project is not a trade worth making — the cold runner is what you
;; get, which is what every other editor gives you.

(defdyn *warm-backends*
  ;; One row per language that has a warm test session. A LANGUAGE IS A ROW: everything
  ;; below is written against these fields, so the next one (a warm pytest, a cargo-test
  ;; watcher) is an entry here rather than another branch.
  ;;
  ;;   :adapter   the `testadapter` id this applies to (`toolchain/adapter-id`)
  ;;   :session   the `evalsession` name — what its events are scoped by
  ;;   :applies?  (m root) -> is this project actually one? (tools present, markers right)
  ;;   :specs     (m specs) -> the run request's payload, in the backend's own spelling
  ;;   :running? / :start / :run / :stop / :reset — the backend's client API
  ;;   :restart   what to tell the reader to run when the session has to be replaced
  ;;
  ;; Symbols, resolved at call time: every backend here is a DEFERRED module, and naming
  ;; them eagerly would load a BEAM agent into an editor that never opens an Elixir file.
  [{:adapter :exunit
    :session :elixir-test
    :applies? 'testrun/warm-elixir-applies?
    :specs 'testrun/warm-elixir-specs
    :running? 'elixir-test/elixir-test-running?
    :start 'elixir-test/elixir-test-start
    :run 'elixir-test/elixir-test-run
    :stop 'elixir-test/elixir-test-stop
    :reset 'elixir-test/elixir-test-reset
    :restart "M-x elixir-test-restart"}
    {:adapter :brood
     :session :brood-test
     :applies? 'testrun/warm-brood-applies?
     :specs 'testrun/warm-brood-specs
     :running? 'brood-test/brood-test-running?
     :start 'brood-test/brood-test-start
     :run 'brood-test/brood-test-run
     :stop 'brood-test/brood-test-stop
     :reset 'brood-test/brood-test-reset
     :restart "M-x brood-test-restart"}])

(defn- warm-call (backend key args fallback)
  ;; Call one of a backend's late-bound hooks, or answer `fallback` when its module is not
  ;; loaded — the keymap idiom. A backend nothing has touched is not a backend yet.
  (let (sym (get backend key))
    (if (or (nil? sym) (not (bound? sym))) fallback (apply (reflect/eval sym) args))))

(defn warm-elixir-applies? (m root)
  "A mix project, with the tools to start a test node in it."
  (and (nil? (elixir-sandbox/missing-tool root)) (elixir-sandbox/elixir-project? root)))

(defn warm-brood-applies? (m root)
  "A Brood project. Nothing else to check: the child is the same runtime bedit is running
under, so if the editor started, something can host the session."
  (not (nil? root)))

(defn- warm-relative (root file)
  "`file` relative to the project root when it is inside it, else unchanged."
  (if (and root file (string/starts-with? file (str root "/")))
    (string/substring file (string/length (str root "/")))
    (or file "")))

(defn warm-elixir-specs (m specs)
  "`[\"path\"]` / `[\"path:line\"]`, project-relative — how ExUnit addresses a test and how
`mix test` is spelled on a command line. The whole suite is `test`, ExUnit's own default
directory, rather than an empty list."
  (let (root (testrun-root m))
    (if (empty? specs)
      ["test"]
      (into []
        (map specs
          (fn (s)
            (let (rel (warm-relative root (get s :file)))
              (if (get s :line) (str rel ":" (get s :line)) rel))))))))

(defn warm-brood-specs (m specs)
  "`[[file line-or-nil] …]` — what `eval-server`'s TEST request carries. ABSOLUTE paths,
because the child resolves `reflect/load` against its own working directory and a relative
path that happens to work is a coincidence rather than a contract. Empty means the whole
project suite."
  (into [] (map specs (fn (s) [(get s :file) (get s :line)]))))

(defn warm-backend (m)
  "The warm test backend for this project, or nil when it has none — no row for its
toolchain, the tools missing, or warm sessions switched off."
  (if (not *warm-tests*)
    nil
    (let (id (toolchain/adapter-id m)
          root (testrun-root m)
          row (seq/find *warm-backends* (fn (b) (= (get b :adapter) id))))
      (when (and row (warm-call row :applies? (list m root) false)) row))))

(defn warm-ready? (m)
  "Whether this project's warm session is up AND past its own boot — the only state in
which sending it a run beats starting a cold one. A worker that is merely alive would QUEUE
the request behind that boot, which is the cold wait with none of the cold feedback."
  (let (backend (warm-backend m))
    (and backend
      (get-in m [:warm-tests (get backend :session) :ready])
      (warm-call backend :running? '() false))))

(defn- warm-prime (m)
  "Start this project's test session in the background if it could have one and has not got
one yet. Called on a COLD run, never on opening a file: a resident runtime per project is a
real commitment, and asking for a test run at least once is the signal that you want it."
  (let (backend (warm-backend m))
    (if (or (nil? backend) (ed-headless?) (warm-call backend :running? '() false))
      m
      (do (warm-call backend :start (list (testrun-root m)) nil) m))))

(defn testrun-start-warm (m specs root label)
  "Run `specs` in the warm test node. Same model state as a cold run — the generation, the
counters, the cleared marks, the *Tests* buffer — so everything downstream cannot tell the
two apart, which is the point.

Falls back to the cold runner when the session declines the request: a backend's `:run`
answers false when its session is not running, and a run that was never accepted must not
be left looking like one in progress."
  (let (backend (warm-backend m)
        id (inc (or (:warm-test-id m) 0))
        sent? (and backend
                (warm-call backend :run (list id (warm-call backend :specs (list m specs) [])) false)))
    (if (not sent?)
      (testrun-start m specs root label)
      (ed-show-named-aside (message (assoc (testrun-clear-marks m)
                                      :warm-test-id id
                                      :testrun
                                        {:specs specs
                                         :root root
                                         :label label
                                         :gen (inc (or (get-in m [:testrun :gen]) 0))
                                         :warm-id id
                                         :warm-session (get backend :session)
                                         :warm-restart (get backend :restart)
                                         :passed 0
                                         :failed 0
                                         :last-group nil
                                         :adapter-id (get backend :adapter)
                                         :decoder nil})
                             (str "testing " label "… (warm)"))
        *tests-buffer*
        (tests-header label (str "warm · " (->string (get backend :session))))
        :test-menu))))

(defn- warm-current? (m reply)
  "Whether `reply` belongs to the run the model is showing. Matched on the request id
rather than the generation: the node answers the question it was asked, and a reply from a
superseded run is one the reader has already moved past."
  (= (get reply :id) (get-in m [:testrun :warm-id])))

(defn- warm-summary (s)
  "A session's summary in the vocabulary `testrun-apply-summary` reads. A backend reports
what it counted; `passed` is worked out here rather than in each session, so two runners'
summaries cannot drift — except where a backend reports it itself (Brood's runner does),
which is believed."
  (let (total (or (get s :total) 0)
        failed (or (get s :failed) 0)
        skipped (or (get s :skipped) 0))
    {:total total
     :failed failed
     :passed (or (get s :passed) (- total failed skipped))
     :ms (or (get s :ms) 0)
     :reloaded (or (get s :reloaded) 0)}))

(defn- warm-reload-note (summary)
  "The line that says this run had to pick the project up first, or `\"\"` when the session
was already current.

Worth a line because the one thing a warm runner must never let you wonder is whether the
answer is about the code in front of you. It now always is — the session reloads what
moved before it runs — and saying so is how that becomes something you can see rather than
something you have to trust."
  (let (n (get summary :reloaded 0))
    (if (= n 0)
      ""
      (str "  (reloaded " n " source" (if (= n 1) "" "s") " first)\n"))))

(defn testrun-warm-reply (m reply cols rows)
  "Fold one reply from a warm session: a `:more` chunk is one finished test, and the final
one is the summary (or the reason there is not going to be one)."
  (let (restart (get-in m [:testrun :warm-restart] "the restart command for this language"))
    (cond
      (not (warm-current? m reply)) m
      ;; a chunk is one finished test, or one `spy` entry from inside one — the same two
      ;; things the cold runner's stdout carries, through the same `testrun-apply-event`
      (and (get reply :more) (get reply :spy))
        (testrun-apply-event m [:spy (get reply :spy)] cols rows)
      (get reply :more) (testrun-apply-event m [:test (get reply :test)] cols rows)
      (get reply :ok)
        (let (summary (warm-summary (get reply :summary {})))
          (testrun-apply-summary (ed-append-named m *tests-buffer* (warm-reload-note summary))
            summary
            cols
            rows))
      ;; You asked for this one. `cmd-test-stop` normally forgets the run before its
      ;; replies land, so this is the ordering where they beat it — and a run you stopped
      ;; must not be reported as a run that failed.
      (get reply :stopped) (message m "test run stopped")
      ;; `{:timeout true}` is the session's own answer for a child that stopped talking
      (get reply :timeout)
        (message (ed-append-named m *tests-buffer* "\n[the test session stopped answering]\n")
          (str "test session stopped answering — " restart))
      else
        (message (ed-append-named m
                   *tests-buffer*
                   (str "\n[" (or (get reply :error) "the run failed") "]\n"))
          (str "tests: " (or (get reply :error) "the run failed"))))))

;; ---- the warm node's client hooks (registered in `sandbox-events/*clients*`) ----------
;; A row in that list, like the playground and the process list, rather than `UiEvent`
;; impls of its own. It had its own impls while each session carried its own event records;
;; once the session's NAME started riding on the event there was nothing left for a private
;; vocabulary to distinguish, and one router serves every session the editor keeps.

(defn warm-live-of? (session m)
  "Does anything still want `session`? `*Tests*` has to exist — it is what a run fills — AND
this project has to be one that session serves.

Both halves matter. The buffer alone kept the WRONG session alive: with `*Tests*` open, an
editor that had run an Elixir suite and then moved to a Brood project answered \"yes,
somebody is watching\" for the Elixir node, so its death was followed by a respawn — which
in a mix project recompiles the whole thing, in the background, for a project the reader
has left."
  (and (not (nil? (ed-buffer-index-by-name m *tests-buffer*)))
    (= session (get (warm-backend m) :session))))

(defn warm-live-elixir? (m) (warm-live-of? :elixir-test m))
(defn warm-live-brood? (m) (warm-live-of? :brood-test m))

(defn warm-ready-of (session m gen)
  "`session` announced itself: it is past its own boot and will answer at once, which is the
only state in which sending it a run beats starting a cold one. Keyed BY SESSION, because
an editor open on a Brood project and an Elixir one at the same time has two of these and
neither is evidence about the other."
  (assoc-in m [:warm-tests session :ready] gen))

(defn warm-down-of (session m)
  "`session` went away. A respawn usually follows, but until its banner lands nothing may be
sent to it — so the next run takes the cold path rather than queueing behind a boot it
cannot see."
  (assoc-in m [:warm-tests session :ready] nil))

(defn warm-reply (m reply gen)
  "One reply from a warm session, with the frame the loop put on the model (`:frame`) — a
streaming buffer follows its own tail only in a pane already at the bottom, and that is a
question about panes rather than about the reply. Shared by every session: a run's id says
which one it belongs to, and only one runs at a time."
  (let ([cols rows] (or (:frame m) [80 24]))
    (testrun-warm-reply m reply cols rows)))

;; One pair of one-liners per session rather than a session argument on every hook in the
;; router: the two rows in `sandbox-events/*clients*` name these, and the shape underneath
;; is shared. Two lines per language is cheaper than four arities across six clients.
(defn warm-ready-elixir (m gen banner) (warm-ready-of :elixir-test m gen))
(defn warm-down-elixir (m code) (warm-down-of :elixir-test m))
(defn warm-ready-brood (m gen banner) (warm-ready-of :brood-test m gen))
(defn warm-down-brood (m code) (warm-down-of :brood-test m))

;; ---- the commands ----------------------------------------------------------------

(defn- testrun-root (m)
  (or (:project-root m) (file/cwd)))

;; ---- the three scopes, one route --------------------------------------------
;; `C-c t f` / `C-c t t` / `C-c t p` mean the same thing in every project. Where a
;; toolchain has an ADAPTER (`testadapter`) its runner streams into *Tests* exactly
;; as Brood's does — ✓/✗ rows, margin verdicts, live counters, RET to jump. Where it
;; only has a shell command, the run goes to the compilation buffer, which needs no
;; knowledge of its output format and still gives `C-x \`` over the failures. Where
;; it has neither, the editor says so instead of guessing.

(defn- testrun-go (m specs label fallback)
  (cond
    ;; a session that is up and past its boot answers at once — the same rows, without the
    ;; runtime start (see the warm-session section above; `warm-ready?` asks the backend)
    (warm-ready? m) (testrun-start-warm m specs (testrun-root m) label)
    ;; …and a cold run in a project that could have one starts it, so this is the last slow
    ;; run rather than every run
    (toolchain/adapter-id m) (warm-prime (testrun-start m specs (testrun-root m) label))
    (nil? fallback) (message m (str "no test command for a " (toolchain/name-of m) " project"))
    else (compile/compile-run m fallback)))

(defcommand cmd-test-file
  (m key)
  "Run the current file's tests (C-c t f) — `nest test <file>`, `mix test <file>`, or
whatever this project's toolchain scopes a file with."
  (let (file (buffer-file (ed-current-buf m)))
    (if (nil? file)
      (message m "buffer has no file to test")
      (testrun-go m
        (list {:file file :line nil})
        (path/basename file)
        (toolchain/test-file-command m file)))))

(defcommand cmd-test-at-point
  (m key)
  "Run the test under point (C-c t t): the framework's own FILE:LINE resolution — the
last test declared at or before this line. `mix test path:12` and `nest test path:12`
address a test the same way; a toolchain that addresses tests by name instead (cargo)
falls back to running the whole file, which is nearer the ask than running everything."
  (let (buf (ed-current-buf m)
        file (buffer-file buf))
    (if (nil? file)
      (message m "buffer has no file to test")
      (let (line (inc (buffer-current-line buf)))
        (testrun-go m
          (list {:file file :line line})
          (str (path/basename file) ":" line)
          (toolchain/test-at-point-command m file line))))))

(defcommand cmd-test-project
  (m key)
  "Run the whole project suite (C-c t p), streamed per-test into *Tests*.
(On a memory-tight machine prefer file/at-point scope; the native runner already
lowers the parallel batch.)"
  (testrun-go m '() "project suite" (toolchain/test-command m)))

(defcommand cmd-test-rerun
  (m key)
  "Re-run the last test invocation (C-c t r, or `g` in *Tests*)."
  (let (last-run (:testrun m))
    (if (nil? last-run)
      (message m "no test run to repeat")
      (testrun-start m (:specs last-run) (:root last-run) (:label last-run)))))

(defcommand cmd-test-stop
  (m key)
  "Stop a running test suite (C-c t k) — kills the runner subprocess (an infinite
loop in a test, a slow suite). A no-op when nothing is running.

A warm run is stopped by asking the node to abandon it rather than by killing anything: the
node is the expensive thing and the run inside it is not, so ending the run must not cost
the compile that made it fast."
  (let (warm (get-in m [:testrun :warm-id])
        proc (proc/whereis :testrun))
    (cond
      warm
        (let (id (inc (or (:warm-test-id m) 0))
              backend (warm-backend m))
          ;; ASK the session to abandon it — both backends can, and neither is killed for
          ;; it: the session is the expensive thing and the run inside it is not, so ending
          ;; a run must not cost the boot that made it fast.
          (warm-call backend :stop (list id) false)
          ;; …and forget it here too. Its stragglers are already on the way, and a verdict
          ;; for a run you stopped should not keep filling the buffer.
          (message (assoc (update m :testrun dissoc :warm-id) :warm-test-id id)
            "test run stopped"))
      (nil? proc) (message m "no test run in progress")
      else
        (do
          (send proc [:shutdown])
          (message m "test run stopped")))))

(defn- warm-restart (m)
  "Restart (or first start) this project's warm test session, forgetting that it was ready.

Rarely what you want: a run already picks up changed sources by itself (Brood reloads what
moved, the Elixir node recompiles), so this is for what that cannot reach — a changed
`project.blsp` or `mix.exs`, a dependency, a `config/` the environment was built from."
  (let (backend (warm-backend m))
    (cond
      (nil? backend) (message m "no warm test session for this project")
      (not (warm-call backend :running? '() false))
        (do
          (warm-call backend :start (list (testrun-root m)) nil)
          (message (warm-down-of (get backend :session) m) "starting the test session…"))
      else
        (do
          (warm-call backend :reset '() nil)
          (message (warm-down-of (get backend :session) m) "restarting the test session…")))))

(defcommand cmd-test-restart
  (m key)
  "Replace this project's warm test session (C-c t R): a fresh runtime, the project loaded
or compiled again.

Rare by design. A run already picks up what you changed — Brood reloads the sources whose
mtime moved, the Elixir node recompiles — so this is for what that cannot reach: a changed
`mix.exs` or `project.blsp`, a `config/` the environment was built from, a dependency.

One command for every language, because \"replace the session\" is the same request
whichever runtime is holding it; the backend row says how."
  (warm-restart m))

;; The old names, kept as aliases: they are what the docstrings and the wedged-session
;; message have been telling people to run.
(defcommand cmd-elixir-test-restart (m key) "Alias for `test-restart`." (warm-restart m))

(defcommand cmd-brood-test-restart (m key) "Alias for `test-restart`." (warm-restart m))

;; ---- the :test-menu buffer type ----------------------------------------------

(def test-menu-keymap
  ;; RET/click jump comes from the shared location-jump layer in the type stack
  (-> {}
    (keymap-bind ["g"] 'testrun/cmd-test-rerun)))

;; faces by row role (theme's ambient colour roles)
(def test-face-pass {:fg *green*})
(def test-face-fail {:fg *red* :bold true})
(def test-face-skip {:fg *yellow*})
(def test-face-loc {:fg *blue*}) ; a jumpable file:line:col row
(def test-face-output {:fg *subtext* :italic true}) ; the suite's own prints
(def test-face-spy {:fg *teal*}) ; spy traffic from inside a test
(def test-face-header {:fg *subtext* :bold true})
(def test-face-group {:fg *mauve* :bold true}) ; a describe header line
(def test-face-timing {:fg *overlay0*}) ; the dim "(N ms)" tail
(def test-face-name-fail {:fg *red*}) ; a failing test's name
(defn- testrun-line-face (line)
  (let (t (string/triml line))
    (cond
      (string/starts-with? t "✓") test-face-pass
      (string/starts-with? t "✗") test-face-fail
      (string/starts-with? t "·") test-face-skip
      (string/starts-with? t "|") (if (includes? line "| ~ ") test-face-spy test-face-output)
      (string/starts-with? t "-*-") test-face-header
      (not (nil? (loc-at-line line))) test-face-loc
      ;; a describe header: un-indented, not the banner, names no location — the
      ;; group name the tests indent under
      (and (not (= t "")) (not (string/starts-with? line " "))) test-face-group
      else nil)))

(defn- testrun-row-spans (line off)
  "Spans for a test row `  MARK name  (N ms)`: colour the ✓/✗/· mark by verdict,
leave the name readable (red only when it failed), and DIM the `(N ms)` tail — so a
passing suite reads calm and a failure pops (the mocha look)."
  (let (t (string/triml line)
        len (string/length line)
        indent (- len (string/length t))
        mark (string/substring t 0 1)
        mark-face (cond
                    (= mark "✓") test-face-pass
                    (= mark "✗") test-face-fail
                    (= mark "·") test-face-skip
                    else nil)
        timing (string/last-index-of line "(")
        name-start (math/min len (+ indent 2))
        name-end (if (and (>= timing 0) (> timing name-start)) timing len))
    (seq/reject (list (when mark-face [(+ off indent) (+ off indent 1) mark-face])
                  (when (and (= mark "✗") (< name-start name-end))
                    [(+ off name-start) (+ off name-end) test-face-name-fail])
                  (when (and (>= timing 0) (> timing name-start))
                    [(+ off timing) (+ off len) test-face-timing]))
      nil?)))

(defn- testrun-line-spans (line off)
  "Spans for one *Tests* line: a test row is mark/name/timing (`testrun-row-spans`);
every other line takes its whole-line role face (`testrun-line-face`)."
  (let (t (string/triml line))
    (if (or (string/starts-with? t "✓") (string/starts-with? t "✗") (string/starts-with? t "·"))
      (testrun-row-spans line off)
      (let (face (testrun-line-face line))
        (if (nil? face) '() (list [off (+ off (string/length line)) face]))))))

(defn testrun-fontify (src)
  "The *Tests* `:fontify`: per-part colour — the ✓/✗/· mark by verdict, the name
readable (red on failure), the `(N ms)` dim, group headers mauve, output dim.
Clickability is the pointer cursor + font underline the view draws from `:line-loc`.

Spans are `cons`'d onto a list (O(1) each) and `reverse`d once — NOT accumulated with
`append`/`conj`, both of which recopy the whole accumulator per line and make this O(n²)
in the window height. A live test run re-fontifies the visible window on every streamed
append, so a linear fontify is what keeps a long *Tests* run from lagging as it fills."
  (let (result (fold (string/split src "\n")
                 [(list) 0]
                 (fn (acc line)
                   (let (spans (nth acc 0)
                         off (nth acc 1))
                     [(fold (testrun-line-spans line off) spans (fn (s span) (cons span s)))
                       (+ off (string/length line) 1)]))))
    (reverse (nth result 0))))

(def test-menu-mode-layer
  ;; :line-loc is the SHARED `results/line-links-loc` — it reads the off-text `:line-links`
  ;; this module stores per row (`testrun-append-link`), the exact mechanism *git-status* now
  ;; reuses. A failure-detail line with no stored link falls back to the text parse.
  {:name 'test-menu
   :keymap testrun/test-menu-keymap
   :fontify 'testrun/testrun-fontify
   :line-loc 'results/line-links-loc
   :commands '("test-rerun")})

;; :test-menu stacks the jump/rerun keys over special-mode (read-only, no gutter)
;; over text-mode — the process list's shape.
(register-type-layers :test-menu
  (list 'testrun/test-menu-mode-layer
    'results/location-jump-layer 'modes/special-mode-layer 'modes/text-mode-layer))
