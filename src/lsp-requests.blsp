(defmodule lsp-requests
  "The LSP request-kind vocabulary: one record per request the editor can make, tied
together by the sealed `LspRequest` ability. Both halves of the async round-trip
dispatch on the SAME record: the connection process shapes the raw server result
(`lsp-request-shape`, impls in `lsp` beside the shaping helpers) and the editor loop
folds the arrived payload into the model (`lsp-request-fold`, impls in `commands`
beside the model helpers). One vocabulary, checked exhaustive (`:sealed`) — the old
keyword pair drifted (`:symbols` vs `:imenu`, `:formatting` vs `:format`) precisely
because nothing tied the two sides together. Lives apart from `lsp` so `commands`
can register its fold impls at load time while `lsp` itself stays deferred
(`require`d on first use).")

;; The kinds. A pending lookup is one of these records with request context merged
;; on (records are open maps): the rope guard + origin buffer for the mutating
;; kinds, the rename's origin, …
(defrecord lsp-completion ()) ; textDocument/completion — the bounded-wait Tab source
(defrecord lsp-symbols ()) ; textDocument/documentSymbol — imenu
(defrecord lsp-definition ()) ; textDocument/definition — M-.
(defrecord lsp-references ()) ; textDocument/references
(defrecord lsp-hover ()) ; textDocument/hover — the docs-at-point lookup
(defrecord lsp-formatting ()) ; textDocument/formatting — C-c C-f
(defrecord lsp-rename ()) ; textDocument/rename — C-c C-r
(defability LspRequest
  "An LSP request kind. `lsp-request-shape` turns a raw server `result` into the
`[reply-tag value]` the connection sends its waiter; `lsp-request-fold` folds an
arrived reply's payload into the editor model. Deliberately NOT `:sealed`, though
the kind set is closed: the exhaustiveness check is per-file, and this ability's
impls live by design in two later-loaded modules (`lsp` / `commands`), so sealing
it here can only produce false 'no impl' warnings. (A project-scope sealed check
is the missing Brood piece; see CLAUDE.md's prime directive.)"
  (lsp-request-shape [self result] :-> any)
  (lsp-request-fold [self model payload] :-> any))
