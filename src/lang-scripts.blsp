(defmodule lang-scripts
  "Ruby, Elixir, HEEx and Python: tree-sitter modes, each a `deflanguage` spec."
  (:use language-core))

;; ---- ruby-mode / elixir-mode: tree-sitter-backed language modes -------------
;; A `.rb`/`.ex` buffer gets syntax colouring AND structural navigation from a tree-sitter
;; grammar via `editor/treesit` — the foreign-language analogue of brood-mode's
;; `highlight`+`sexp`. Because the parse yields the SAME positioned-node shape Brood's
;; reader does, the editor's `:fontify` service and the `C-M-f/b/u/d/a` structural commands
;; run over a Ruby or Elixir tree unchanged — the modes are pure data: a face table, a
;; `:ts-lang`, and an indent spec naming the node kinds that open a level
;; (`elixir-indent-spec`), which `editor/treesit/indent-column` walks the tree with.
;;
;; `:fontify-restart` says where the windowed lead-in may be CUT. Without one the mode
;; parses the whole lead-in every keystroke — 245 lines for a 44-row viewport, five times
;; what is on screen. Elixir's counts paired heredoc markers (`editor/treesit/column0-restart`);
;; Ruby's heredoc terminator is arbitrary text (`<<~EOS`), so it has a guard of its own
;; (`ruby-fontify-restart`, below).

;; (The `C-M-*` structural motions come from the shared `prog-mode-layer` — ruby and
;; elixir stack it via `register-prog-mode`, and the commands dispatch on `:ts-lang`.)

;; Per-language face tables name only the *named* nodes to colour, by kind or by a kind in
;; its context (`{:parent … :field … :nth …}`, brood ADR-486); keywords (anonymous
;; alphabetic tokens — `def`/`end`/`do`/`fn`/…) come free, and the table is passed straight
;; to `editor/treesit/fontify`. Refine one by inspecting `(%tree-sitter-parse …)` — and a
;; field name by trying a `{:field …}` selector against `%tree-sitter-spans`.
;; ---- indentation for the tree-sitter modes ----------------------------------
;; `editor/treesit/indent-column` is the mechanism (walk the tree, count enclosing blocks);
;; these four entries are the whole per-language policy. The kinds were read off real parses
;; rather than guessed, and each spec is checked line-for-line against hand-written source —
;; every line of a sample module must re-indent to the column it already has.
;;
;; `:dedent-levels` differs because the grammars do: Elixir's `do_block` spans its own `end`,
;; so a closing line measured at the line start is still inside the block and backs out one;
;; Ruby's `body_statement` stops before `end`, so the closer is already outside and backs out
;; none.

(def elixir-indent-spec
  {:width 2
   :blocks #{:do_block :body} ; `do … end`, and a `->` clause's body
   ;; The bracketed openers — a multi-line list/map/tuple/binary/`fn` indents its
   ;; contents exactly as a block does, but must NOT indent its own opening line, which
   ;; is what `:brackets` means. `:arguments` is deliberately absent: Elixir does not add
   ;; a level for a call's argument list when the last argument is an `fn`, which is the
   ;; common shape (`Enum.reduce(xs, %{}, fn … end)`), and counting it put every such
   ;; clause one level too deep.
   :brackets #{:anonymous_function :list :map :tuple :bitstring}
   ;; keywords only; the closing delimiters decide for themselves
   :dedent #{"end" "else" "catch" "rescue" "after"}
   :dedent-levels 1})

(def ruby-indent-spec
  {:width 2
   ;; a method/class body, an if/else arm, and a BRACE block's body — `{ |x| … }` spanning
   ;; lines indents its contents like any block, and `:block_body` is the kind the grammar
   ;; gives it. Without it every multi-line `{ |t| … }` body sat a level too shallow, which
   ;; is 44 of the 46 lines the Ruby stdlib disagreed with.
   :blocks #{:body_statement :then :else :block_body}
   ;; the bracketed openers, which must not indent their own opening line
   :brackets #{:array :hash :argument_list}
   ;; Per token, because the grammar disagrees per token: a `body_statement` stops before
   ;; its `end`, so `end` is already outside it and backs out nothing — but it SPANS its
   ;; own `ensure`/`rescue`/`else`, so those must back out one. A single `:dedent-levels`
   ;; cannot say both, and with one number Ruby's `ensure` sat a level too deep in every
   ;; method that had one.
   ;; Keywords only — a closing delimiter decides for itself (see `ts-dedent-levels`),
   ;; because the same `}` closes a hash whose node encloses the closing line AND a
   ;; `{ |x| … }` block whose body ended before it. Read off the grammar, one token at a
   ;; time, against the Ruby stdlib:
   ;;   `end`                  a `body_statement` stops before it — already outside
   ;;   `else` `elsif` `when`  the arm ends before the keyword — already outside
   ;;   `rescue` `ensure`      children of the `body_statement`, which SPANS them
   :dedent {"end" 0 "else" 0 "elsif" 0 "when" 0 "rescue" 1 "ensure" 1}})

(def ruby-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :heredoc_body :syntax/string
   :regex :syntax/string
   :simple_symbol :syntax/constant
   :hash_key_symbol :syntax/constant
   :delimited_symbol :syntax/constant
   :integer :syntax/number
   :float :syntax/number
   :constant :syntax/special
   :instance_variable :syntax/function
   :global_variable :syntax/function
   :class_variable :syntax/function
   ;; a call's method (`foo(x)`, `s.bar`, `puts`) and a definition's name: Ruby has no
   ;; field access, so every `x.y` IS a call and colouring its method never lies
   {:parent :call :field :method :kind :identifier} :syntax/function
   {:parent :method :field :name} :syntax/definition
   {:parent :singleton_method :field :name} :syntax/definition})

;; ---- ruby's fontify restart ---------------------------------------------------
;; Elixir decides restart safety by counting PAIRED heredoc markers; Ruby has no pair to
;; count — `<<~EOS` ends at a line holding whatever identifier the opener named. So Ruby
;; asks a weaker question with a safe answer: is there any heredoc opener, or any `=begin`
;; block comment, above the candidate at all? If so it declines and keeps the full lead-in.
;; Over-declining costs speed in files that open a heredoc near the viewport and nothing
;; else; guessing would colour heredoc prose as code.
;;
;; Bare `<<EOS` is recognised by the uppercase/underscore that conventionally follows,
;; because `<<` alone is `Array#<<` and left-shift — searching for it would decline
;; everywhere and buy nothing.

(defn- ruby-upper? (character)
  ;; an uppercase ASCII letter, tested by case-folding (Brood's `<` is numeric-only)
  (and (not (= (string/upper character) (string/lower character)))
    (= character (string/upper character))))

(sig ruby-heredoc-open-at? (string int -> bool))
(defn- ruby-heredoc-open-at? (source offset)
  ;; `offset` is where a `<<` starts — does it open a heredoc rather than shift or append?
  (let (after (+ offset 2))
    (and (< after (count source))
      (let (character (string/char-at source after))
        (or (= character "~")
          (= character "-")
          (= character "'")
          (= character "\"")
          (= character "_")
          (ruby-upper? character))))))

(defn- ruby-heredoc-above? (source upto from)
  ;; any heredoc opener in `source` before `upto`
  (let (offset (index-of source "<<" from))
    (cond
      (or (< offset 0) (>= offset upto)) false
      (ruby-heredoc-open-at? source offset) true
      else (ruby-heredoc-above? source upto (+ offset 2)))))

(defn- ruby-block-comment-above? (source upto)
  ;; `=begin` / `=end` are column-0 only, so a newline-prefixed match (or offset 0) is one
  (or (string/starts-with? source "=begin")
    (let (offset (index-of source "\n=begin")) (and (>= offset 0) (< offset upto)))))

(defn ruby-fontify-restart (source position)
  "Ruby's `:fontify-restart`: the previous column-0 line, unless a heredoc or `=begin` block
opens above it in this window — in which case keep the whole lead-in."
  (let (candidate (editor/treesit/column0-before source position))
    (if (or (ruby-heredoc-above? source candidate 0) (ruby-block-comment-above? source candidate))
      0
      candidate)))

(deflanguage ruby
  {:lang :ruby
   :pairs *backtick-pairs*
   :strings *ruby-strings*
   :pattern "\\.rb$"
   :faces ruby-face-table
   :indent ruby-indent-spec
   ;; the words that close or continue a block reindent their line as they are typed
   :electric-indent "^(end|else|elsif|when|rescue|ensure)$"
   ;; its own: a heredoc terminator is arbitrary text, and `=begin` blocks count too
   :restart 'lang-scripts/ruby-fontify-restart
   ;; the community standard, and what a Ruby project has if it has anything
   :format ["rubocop" "-a" "--stderr" "--format" "quiet"]
   :comment "# "})

;; Elixir: def/defmodule/if/case are macros, parsed as calls, so only their TEXT tells
;; them from `foo(x)`: a call target named one of `elixir-keyword-calls` takes the keyword
;; colour (brood ADR-487), as `do`/`end`/`fn`/`when`/… do. Module aliases read as `:special`,
;; an atom (`:ok`, `do:`) as a constant (`:syntax/constant`, brood ADR-616). A call's name — the
;; identifier in its `target` field — is a function: `foo(x)`. The name a `def` defines is a
;; DEFINITION (`:syntax/definition`): `def main(x)` is a call inside a call, told from
;; `foo(bar(x))` by what its `arguments` come right after — an identifier reading `def`
;; (`:after`, brood ADR-614). A REMOTE call's name is a function too — `Enum.map`'s `map`,
;; `:lists.reverse`'s `reverse` — when what is before the dot is a module (an alias or an atom:
;; the right side's `:after`), so every call head reads alike. After a variable the right side is
;; left alone: `user.name` is a map's field, parsed as the same call-of-a-dot as `mod.fun()`, and
;; only the value tells them apart.
(def- elixir-keyword-calls
  #{"def"
    "defp" "defmodule" "defmacro" "defmacrop" "defstruct" "defprotocol" "defimpl" "defdelegate"
    "defguard" "defguardp" "defexception" "defoverridable" "if" "unless" "case" "cond" "with" "for"
    "receive" "try" "quote" "unquote" "use" "import" "alias" "require"})

;; the heads whose first argument names what they define
(def- elixir-definers
  #{"def" "defp" "defmacro" "defmacrop" "defguard" "defguardp" "defdelegate"})

;; where that first argument sits: `def main(x)`, `def main, do: …` / `def main do`, and each
;; with a guard (`def main(x) when …`, whose call is the `when`'s left side)
(def- elixir-definition-selectors
  (let (definer-arguments {:kind :arguments :after {:text elixir-definers}}
        guarded {:kind :binary_operator :nth 0 :parent definer-arguments})
    [{:kind :identifier :field :target :parent {:kind :call :nth 0 :parent definer-arguments}}
      {:kind :identifier :nth 0 :parent definer-arguments}
      {:kind :identifier :field :target :parent {:kind :call :field :left :parent guarded}}
      {:kind :identifier :field :left :parent guarded}]))

(def elixir-face-table
  ;; a definition's name `:syntax/definition`, beside the table's other entries
  (into (into {} (map elixir-definition-selectors (fn (selector) [selector :syntax/definition])))
    {{:parent :call :field :target :kind :identifier} :syntax/function
     ;; a remote call's name, after a module: `Enum.map(…)`, `IO.puts "x"`, `:lists.reverse(…)`
     {:kind :identifier
      :field :right
      :after {:kind :alias}
      :parent {:kind :dot :field :target :parent :call}} :syntax/function
     {:kind :identifier
      :field :right
      :after {:kind :atom}
      :parent {:kind :dot :field :target :parent :call}} :syntax/function
     {:parent :call :field :target :kind :identifier :text elixir-keyword-calls} :syntax/keyword
     :comment :syntax/comment
     :string :syntax/string
     :charlist :syntax/string
     :sigil :syntax/string
     :integer :syntax/number
     :float :syntax/number
     :atom :syntax/constant
     :alias :syntax/special
     :keyword :syntax/constant}))

;; ---- HEEx: Phoenix templates, in `.heex` files and inside Elixir's `~H` ------------------
;; A modest table: tags, components and slots by name, attributes, strings, comments, and
;; the delimiters of embedded Elixir (`{…}`, `<%= … %>`) — the Elixir inside stays plain,
;; since injections do not nest (brood ADR-489).
(def heex-face-table
  {:tag_name :syntax/keyword
   :component_name :syntax/function
   :slot_name :syntax/function
   :attribute_name :syntax/special
   :quoted_attribute_value :syntax/string
   :comment :syntax/comment
   {:parent :expression :kind (keyword "{")} :syntax/special
   {:parent :expression :kind (keyword "}")} :syntax/special
   {:parent :directive :kind (keyword "<%")} :syntax/special
   {:parent :directive :kind (keyword "<%=")} :syntax/special
   {:parent :directive :kind (keyword "%>")} :syntax/special})

;; a tag, component or slot is one level, and a line opening with `</` backs out of it, as
;; JSX's does (`js-indent-spec`) — only `)]}` close by themselves
(def heex-indent-spec
  {:width 2 :blocks #{} :brackets #{:tag :component :slot} :dedent #{"</"} :opens #{}})

(deflanguage heex
  {:lang :heex
   :pattern "\\.heex$"
   :faces heex-face-table
   :indent heex-indent-spec
   :grammar {:url "https://github.com/phoenixframework/tree-sitter-heex"
             :revision "5842537f734d7c12685bf27d6005313e3e5a47a0"
             :fingerprint "855c9be034fb996defef1bf4769c69a0840771801381736985ef9a73f9cfdd92"}})

;; `~H"""…"""` in an Elixir file is HEEx: the sigil's content, named by its sigil letter
(def elixir-injections
  [{:content {:kind :quoted_content :parent :sigil} :lang-from :sigil_name :aliases {"H" :heex}}])

(deflanguage elixir
  {:lang :elixir
   :pairs *quote-pairs*
   :strings *elixir-strings*
   :pattern "\\.(ex|exs)$"
   :faces elixir-face-table
   :indent elixir-indent-spec
   :electric-indent "^(end|else|rescue|catch|after)$"
   :heredocs *triple-quote-heredocs*
   :injections elixir-injections
   :format ["mix" "format"]
   ;; the runtime is built with an Elixir grammar; this is the one a user's grammar
   ;; directory overrides it with (M-x grammar-update), at the revision the tables fit
   :grammar {:url "https://github.com/elixir-lang/tree-sitter-elixir"
             :revision "4b0c7118760af58a2e7081bbc8396e136f820b37"
             :fingerprint "197f0015e41d0669c27b96b8b2bb7863f375ea977753b15c640a57b49419e7b4"}
   :comment "# "})

;; ---- python-mode: a language the runtime was never built with ---------------
;; The proof that a language is a data entry rather than a build: nothing in Brood knows
;; Python. Drop `libtree-sitter-python.so` into `~/.config/bedit/grammars/` and everything
;; below — colouring, the `C-M-*` structural motions, indentation — comes from these three
;; definitions. Without the grammar the mode still registers and simply cannot parse.
;;
;; Python indents by four, and every level is the same `:block` node, so it needs no dedent
;; set at all: `else:` sits in the `if`'s own block chain, not inside the arm it follows.
(def python-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :string_content :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :true :syntax/constant
   :false :syntax/constant
   :none :syntax/constant
   ;; a called name (`print(x)`), a method call's (`s.bar()`: the attribute of an
   ;; `attribute` that is a call's function, brood ADR-487 — `p.x` stays uncoloured) and a
   ;; defined one
   {:field :function :kind :identifier} :syntax/function
   {:kind :identifier :field :attribute :parent {:kind :attribute :field :function}} :syntax/function
   {:parent :function_definition :field :name} :syntax/definition
   {:parent :class_definition :field :name} :syntax/special})

(def python-indent-spec
  {:width 4
   :blocks #{:block} ; every suite is a `block`; `else:` sits in the `if`'s own chain
   ;; the bracketed literals and call arguments — a multi-line one indents (or aligns)
   ;; its contents, and must not indent its own opening line
   :brackets #{:list :dictionary :set :tuple :argument_list :parameters :parenthesized_expression}
   ;; Nothing to declare: `else:`/`elif:`/`except:` are children of the statement rather
   ;; than of its block, so they already measure at the outer level, and the closing
   ;; delimiters decide for themselves.
   :dedent #{}})

(deflanguage python
  {:lang :python
   :pairs *python-pairs*
   :strings *python-strings*
   :pattern "\\.py$"
   :faces python-face-table
   :indent python-indent-spec
   ;; a clause that continues its statement dedents once its colon is typed
   :electric-indent "^(else|finally|(elif|except)\\b.*):$"
   ;; PEP 8's line length
   :fill-column 79
   ;; paired triple quotes, exactly Elixir's case
   :heredocs *triple-quote-heredocs*
   :format ["black" "-q"]
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-python"
             :revision "26855eabccb19c6abf499fbc5b8dc7cc9ab8bc64"
             :fingerprint "b8c1141915364fbe8c2d4a78194bebebc32d300b9dcde0ef4b0fee3501e15be9"}
   :definitions {:kinds #{:function_definition :class_definition}}
   :comment "# "})
