(defmodule shell-command
  "Emacs `shell-command` and `shell-command-on-region` (M-! / M-|): one `sh -c` in the
buffer's default directory, run off the loop as a `std/task`, its output in the echo area
(one line) or `*Shell Command Output*` beside the buffer; `C-u M-|` replaces the region
with it. Not a shell BUFFER — that is `shells/bshell`.

Loaded with the image (`main`): `C-u M-|` must find the command registered as
prefix-consuming before its module has ever run, or the prefix would repeat it instead."
  (:use editor/buffer) ; buffer-region-bounds / buffer-rope / replace-region — the piped region
  (:use minibuffer)
  (:use model) ; message / ed-edit / ed-mb-edit / ed-headless? / register-task-reply
  (:use pool) ; ed-default-dir / ed-show-named-aside — where it runs and where output goes
  (:use interactive) ; defcommand / current-prefix-arg / register-prefix-consuming
  (:use processes :only [add-output-faces]) ; a command's output colours (processes/decode-output) as faces
  (:use task :only [task])) ; task — the command runs off the loop

;; ---- one-off shell commands (M-! / M-|) --------------------------------------
;; `M-!` runs one and shows its output; `M-|` pipes the region through one, in the buffer's
;; directory, off the loop. A command that keeps running is what `C-c r` and the shell are for.
(def *shell-command-timeout-ms* 120000)
;; A shell command gets two minutes before the task is killed and reported as a timeout.
;; `M-! sleep 600` is a typo, not an instruction to make the editor unusable for ten
;; minutes, and an unbounded slot is one that never frees.

(defn- ed-shell-command (dir cmd stdin)
  "`{:exit :stdout :stderr}` of `cmd` through the platform's shell (`os/shell`: `sh -c`, or
`cmd.exe /c` on Windows) in `dir`, fed `stdin` (nil for none), killed —
with everything it started — after `*shell-command-timeout-ms*`. The one place M-! and M-|
run a command, so the timeout reaches the OS process, not only the task waiting on it."
  (os/shell-cmd cmd {:cwd dir :stdin stdin :timeout-ms *shell-command-timeout-ms*}))

;; check-allow: `then` is a caller-supplied `(model result) -> model`, so the checker
;; cannot see the last branch's result (ADR-341's `:trusted`, as `vc/gitcore/git-launch-op`).
(check-allow :trusted
  (sig ed-shell-launch (model string any any -> model))
  (defn ed-shell-launch (m cmd stdin then)
    "Run `sh -c cmd` OFF the loop and hand the result to `then` (`(model result) -> model`):
how long a command takes is not knowable in advance (`M-! make`, a `grep -r` over a monorepo,
a command waiting on a lock), so none runs on the dispatch path.

One at a time, like every other off-loop job here: a second while one runs is refused
rather than queued. Headless runs it inline, so tests and `--headless` are unchanged."
    (cond
      (:shell-proc m) (message m "a shell command is already running")
      ;; a buffer on another machine (`/ssh:…`): its directory does not exist here
      (sshpath/remote? (ed-default-dir m))
        (message m "shell command: this buffer is on another machine — M-! runs on this one")
      (ed-headless?) (then m (ed-shell-command (ed-default-dir m) cmd stdin))
      else
        (let (dir (ed-default-dir m)
              job (task (fn () (ed-shell-command dir cmd stdin))
                    {:timeout *shell-command-timeout-ms*}))
          (assoc (message m (str "running: " cmd))
            :shell-proc job
            :shell-then then
            :shell-cmd cmd)))))

(defn ed-shell-live (m)
  "The M-! command C-x C-c would kill (`model/register-exit-query`), while its task runs."
  (if (:shell-proc m) [(str "shell command: " (:shell-cmd m "?"))] []))

(check-allow :trusted
  ;; M-! / M-| — a shell command is arbitrarily long, so it is a task like the rest, and C-g
  ;; stops it: `task/cancel` kills the task's process, and an `os/cmd` waiting in a killed
  ;; process kills its command's whole process group (brood ADR-514) — so `M-! sleep 600`
  ;; is gone when C-g says so, not still running behind a freed slot
  (register-task-reply :shell-proc
    'shell-command/ed-apply-shell
    nil
    "shell"
    {:cancel-on-quit? true :on-quit 'shell-command/ed-shell-quit})
  (register-exit-query :shell-command 'shell-command/ed-shell-live)
  (sig ed-apply-shell (model any -> model))
  (defn ed-apply-shell (m result)
    "Fold a finished `ed-shell-launch`. A nil `result` is the task having errored or timed out,
said as such rather than reported as a command that succeeded with no output."
    (let (then (:shell-then m)
          cmd (:shell-cmd m "the command")
          finished (dissoc m :shell-proc :shell-then :shell-cmd))
      (cond
        (nil? result)
          (message finished
            (str cmd " failed or timed out after " *shell-command-timeout-ms* "ms"))
        (nil? then) finished
        else (then finished result)))))

(defn ed-shell-quit (m)
  "C-g's clean-up for M-! / M-| (`:on-quit`; the task, and with it the command, already
killed): forget what was to be done with its output, and leave C-g a note that it stopped."
  (ed-quit-note (dissoc m :shell-then :shell-cmd) (str (:shell-cmd m "shell command") " stopped")))

(defn- shell-output (result)
  "A result's output as `[text spans]`: stdout then stderr, each decoded with its own
ANSI decoder (`processes/decode-output`), so no escape shows and the colours are kept, and its
carriage returns done — a progress counter shows where it ended (`processes/output-carriage`)."
  (let ([_ out out-spans] (processes/decode-output (processes/output-decoder)
                            (or (:stdout result) ""))
        [_ err err-spans] (processes/decode-output (processes/output-decoder)
                            (or (:stderr result) ""))
        [text spans] (processes/continue-partial-output [out out-spans] err err-spans)
        [_ kept kept-spans] (processes/output-carriage text spans))
    [kept kept-spans]))

(defn- ed-shell-show (m cmd result)
  "Show a shell command's result the Emacs way: one output line in the echo area, more in
`*Shell Command Output*` beside the buffer, its ANSI colours as faces; a failure's stderr
joins the output."
  (let ([out spans] (shell-output result)
        trimmed (string/trim out)
        lines (string/split trimmed "\n"))
    (cond
      (= trimmed "")
        (message m
          (str "(shell command "
            (if (= (:exit result) 0) "succeeded" (str "failed: " (:exit result)))
            " with no output)"))
      (= (count lines) 1) (message m trimmed)
      else
        (let (shown (ed-show-named-aside m "*Shell Command Output*" out :special)
              index (ed-buffer-index-by-name shown "*Shell Command Output*"))
          (if (nil? index)
            shown
            (ed-set-buf-at shown index (add-output-faces (ed-buf-at shown index) spans 0)))))))

(defn- read-shell-command (m prompt run)
  "Ask for a shell command at `prompt`, then `(run model command)` — or say there was none."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit prompt "")
       :on-complete (fn (mm command)
                      (if (= (string/trim command) "") (message mm "no command") (run mm command)))}))

(defcommand cmd-shell-command
  (m key)
  "Run a shell command and show its output (M-!, Emacs `shell-command`): one line of
output goes to the echo area, more to `*Shell Command Output*` in a side pane. Runs
`sh -c` in the buffer's directory, off the loop; C-g stops it."
  (read-shell-command m
    "Shell command: "
    (fn (mm command)
      (ed-shell-launch mm command nil (fn (done result) (ed-shell-show done command result))))))

(defn- region-unchanged? (buffer target)
  "Whether `buffer` still holds the piped region of `target` (`{:lo :hi :input}`) where it was
when the command started."
  (let ({:keys [lo hi input]} target)
    (and (<= hi (buffer-length buffer)) (= (text/slice (buffer-rope buffer) lo hi) input))))

(defn- shell-region-result (m command result target replace?)
  "What M-| does with a finished command: a successful `C-u M-|` REPLACES the region it was
given — in the buffer it came from (`target`'s `:name`), whichever buffer is current now — and
only while that region still holds the text that was piped, as it was; a buffer killed or
edited there meanwhile is said, and the output shown instead. Anything else is shown like
`M-!`."
  (if (not (and replace? (= (:exit result) 0)))
    (ed-shell-show m command result)
    (let (name (:name target)
          index (ed-buffer-index-by-name m name))
      (cond
        (nil? index)
          (message (ed-shell-show m command result)
            (str name " is gone; its output is shown instead"))
        (not (region-unchanged? (ed-buf-at m index) target))
          (message (ed-shell-show m command result)
            (str "the region in " name " changed while `" command "` ran; left as it is"))
        else
          (message (ed-update-named m
                     name
                     (fn (buffer)
                       (replace-region buffer (:lo target) (:hi target) (:stdout result))))
            (str "region replaced by `" command "`"))))))

(defcommand cmd-shell-command-on-region
  (m key)
  "Pipe the region through a shell command (M-|, Emacs `shell-command-on-region`): the
region is the command's stdin; the output is shown like `M-!` — or, with a prefix
argument (`C-u M-|`), REPLACES the region (the `sort`/`fmt`/`jq .` idiom) in the buffer it
came from, once the command is done."
  (let (buffer (ed-current-buf m)
        bounds (buffer-region-bounds buffer)
        replace? (not (nil? (current-prefix-arg m))))
    (if (nil? bounds)
      (message m "no region (set the mark first)")
      (let ([lo hi] bounds
            input (text/slice (buffer-rope buffer) lo hi)
            target {:name (buffer-name buffer) :lo lo :hi hi :input input})
        (read-shell-command m
          (if replace? "Shell command on region (replace): " "Shell command on region: ")
          (fn (mm command)
            (ed-shell-launch mm
              command
              input
              (fn (done result) (shell-region-result done command result target replace?)))))))))
(register-prefix-consuming 'shell-command/cmd-shell-command-on-region)
