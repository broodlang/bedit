(defmodule lifecycle
  "The file and session commands: writing and reverting a file, reloading the config, and
quitting, with its questions: each unsaved buffer (`map-y-or-n-p`, Emacs's) and what is still
running (`model/register-exit-query`)."
  (:use editor/buffer)
  (:use editor/buffer-file)
  (:use interactive) ; defcommand
  (:use model)
  (:use minibuffer)
  (:use autorevert :only [ed-revert-at])
  (:use projects :only [recent-files])
  (:use file-save :only [ed-save-buf-at ed-save-pending? ed-when-saves-land ed-write-buf-as])
  (:use pool)) ; find-file, the path prompt

(defn ed-no-write-refusal (buffer verb)
  "Why `buffer` must not be written to its file, as the echo-area line — or nil when it may be.
Asks the buffer's MODE (its `:no-write` facet, `{:what :why}`), so a buffer whose text is a
RENDERING of the file rather than the file — a hex view of a binary — refuses C-x C-s and
C-x C-w alike without either command naming it. `verb` is the refused action (`saved` /
`written`)."
  (let (refusal (ed-mode-service buffer :no-write))
    (when refusal (str (:what refusal) " is not " verb " (" (:why refusal) ")"))))

(defcommand cmd-write-file
  (m key)
  "Write the buffer to a path read in the minibuffer (C-x C-w); the buffer is then backed
by that path (future C-x C-s saves there). Uses the same shared path prompt as find-file /
dired (`ed-path-prompt`) — prefilled with the current file's path (else the current dir).
A buffer whose mode refuses writing (`ed-no-write-refusal` — a hex view) is refused."
  (if-let (refusal (ed-no-write-refusal (ed-current-buf m) "written"))
    (message m refusal)
    (ed-ask-path m "Write file: " ed-write-file-answered)))

(defn- ed-ask-path (m prompt on-complete)
  ;; the path prompt C-x C-w and rename-visited-file share: prefilled with the current file's
  ;; path, else the current directory; a NEW name, so Enter takes the line as typed
  (assoc m
    :minibuffer
      (ed-path-prompt prompt
        (or (buffer-file (ed-current-buf m)) (ed-default-dir-input m))
        (if (:recent-files m) (recent-files) [])
        on-complete
        {:new-name true})))

(defn- ed-write-file-answered (m path)
  ;; C-x C-w answered with `path`: into a directory under the file's name (else the buffer's),
  ;; as Emacs's write-file; a path a file handler claims is that handler's to write; a local
  ;; file already there, not this buffer's own, asked about first
  (let (buffer (ed-current-buf m)
        target (ed-into-dir path (path/basename (or (buffer-file buffer) (buffer-name buffer))))
        handler (ed-path-handler target))
    (cond
      handler (ed-handler-call handler :write-file m m target)
      (= target (buffer-file buffer)) (ed-write-file-to m target)
      else (ed-confirm-overwrite m target (fn (answered) (ed-write-file-to answered target))))))

(defn- ed-write-file-to (m path)
  "C-x C-w to plain `path`: the buffer written there OFF the loop, as a save is
(`file-save/ed-write-buf-as`), and backed by it once the write lands — no longer its file
handler's, if it was. A write that fails leaves it visiting what it did."
  ;; once the text has landed in `path`, the buffer visits it, no longer its file handler's
  (ed-write-buf-as m
    (ed-current-index m)
    path
    (fn (landed index) (ed-visit-moved landed index path true))))

;; ---- rename the visited file (Emacs 29's `rename-visited-file`) ---------------------

(defcommand cmd-rename-visited-file
  (m key)
  "Rename the current buffer's file and visit it under the new name (M-x rename-visited-file,
Emacs 29's): asked with the path prompt, prefilled with the file. The file is moved on disk
(`file/move`, across filesystems too) OFF the loop, then the buffer follows it as C-x C-w's
does (`pool/ed-visit-moved`: its name, its mode when the new name asks for another, its sidecar,
another frame's copy, the recent files); its unsaved edits stay unsaved. A directory as the
answer takes the file into it under its name. An existing file is never replaced, nor one
another buffer visits. A file not yet on disk is only renamed in the editor; a buffer with no
file is written, as C-x C-w writes it. A file reached through a file handler (another machine,
root) is renamed by the handler's `:rename-file` when it has one, and refused otherwise."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer)
        handler (ed-buffer-handler buffer))
    (cond
      (nil? file) (ed-ask-path m "Rename visited file to: " ed-write-file-answered)
      (and handler (nil? (:rename-file handler)))
        (message m (str "cannot rename " file " from here: its file handler offers no rename"))
      else
        (ed-ask-path m
          "Rename visited file to: "
          (fn (answered path) (ed-rename-visited answered (ed-current-index answered) path))))))

(defn- rename-target (handler from to)
  ;; where renaming `from` to the answer `to` goes: into `to` when it is a local directory
  (if handler to (path/normalize (ed-into-dir to (path/basename from)))))

(defn ed-rename-visited (m index to)
  "`m` with pool buffer `index`'s file renamed to `to` ([[cmd-rename-visited-file]]) — or the
reason it is not, said."
  (let (buffer (ed-buf-at m index)
        from (or (buffer-file buffer) "")
        handler (ed-buffer-handler buffer)
        target (rename-target handler from to)
        visitor (ed-buffer-index-by-file m target))
    (cond
      (string/blank? from) (message m (str (buffer-name buffer) " visits no file"))
      (= target from) (message m (str (buffer-name buffer) " already visits " from))
      (not (= handler (ed-path-handler target)))
        (message m (str "cannot rename " from " to " target ": not the same kind of file"))
      visitor
        (message m
          (str "cannot rename to "
            target
            ": buffer "
            (buffer-name (ed-buf-at m visitor))
            " visits it"))
      (and (nil? handler) (file/exists? target))
        (message m (str "cannot rename to " target ": it exists"))
      (:rename-proc m) (message m "a rename is still running — try again when it lands")
      ;; never written: nothing on disk to move, the buffer just takes the new name
      (and (nil? handler) (not (file/exists? from)))
        (message (ed-file-moved m from target) (str "now visiting " target " (not yet saved)"))
      else
        (let (job {:from from :to target}
              work (fn () (rename-work handler from target)))
          (if (ed-headless?)
            (ed-rename-landed (assoc m :rename-job job) (work))
            (assoc (message m (str "Renaming " from "…"))
              :rename-proc (task/task work)
              :rename-job job))))))

(defn rename-work (handler from to)
  "What a rename's task does: `from` moved to `to` — by `handler`'s `:rename-file` for a file it
owns, else `file/move` — answering `{:to where-it-went}` or `{:error reason}`. Never raises."
  (try
    (let (went (if (nil? handler)
                 (file/move from to)
                 (ed-handler-call handler :rename-file nil from to false)))
      {:to (if (string? went) went to)})
    (catch failure {:error (error-message failure)})))

(defn ed-rename-landed (m answer)
  "Fold a rename's `answer` ([[rename-work]]'s; nil when its task failed): every buffer visiting
the old file follows it (`pool/ed-file-moved`), or the failure is said and the buffer left as it
was."
  (let (job (:rename-job m)
        rest-m (dissoc m :rename-proc :rename-job))
    (cond
      (nil? job) rest-m
      (or (nil? answer) (:error answer))
        (message rest-m
          (str "rename failed: "
            (or (:error answer) "it did not finish")
            " — "
            (:from job)
            " is unchanged"))
      else
        (message (ed-file-moved rest-m (:from job) (:to answer))
          (str "renamed " (:from job) " to " (:to answer))))))

(register-task-reply :rename-proc 'lifecycle/ed-rename-landed nil "renaming")

(defcommand cmd-revert-buffer
  (m key)
  "Re-read the current buffer from its file on disk, discarding unsaved changes
(M-x revert-buffer). Point stays on its line; the revert is one undoable edit, so C-/
brings back what was discarded."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer))
    (if (nil? file)
      (message m "no file to revert")
      (if (ed-buffer-handler buffer)
        (ed-revert-handled m (ed-current-index m) nil)
        (try
          (message (ed-revert-at m (ed-current-index m)) (str "reverted " file))
          (catch failure (message m (str "revert failed: " (error-message failure)))))))))

;; ---- reload the user config (M-x reload-config) -----------------------------
;; `~/.config/bedit/init.blsp` is read as DATA at startup (config/init-config),
;; not eval'd — so eval-buffer on it reports "unbound symbol: config" (the `(config …)`
;; form is a DSL, not a call). This command is the live way to apply edits to it without
;; restarting: re-read the file and re-seed the model-level settings via the same
;; `config/apply-to-model` `main` uses, surfacing any value typo in the echo area.

(defcommand cmd-reload-config
  (m key)
  "Re-read ~/.config/bedit/init.blsp and apply it to the running editor (M-x
reload-config). The live alternative to restarting — init.blsp is data (read, not eval'd),
so it can't be applied with eval-buffer. The window's text settings and its `:font` are
applied too; a font that is not installed, or a theme that does not exist, is said in the
echo area and *Messages*."
  (let (config (config/init-config)
        warnings (config/init-warnings config)
        applied (config/apply-to-model m config)
        ;; the window-side keys too (:text-aa / :line-height / :ligatures), so a reload re-skins the window
        _ (config/apply-window! config)
        ;; and the font, which says when the one named is not installed
        font-warning (startup/register-font (config/setting config :font))
        theme-warning (themes/theme-from-config! config))
    (doseq (warning (seq/reject [font-warning theme-warning] nil?)) (log/warn warning))
    (message applied
      (let (problem (or (first warnings) font-warning theme-warning))
        (if (nil? problem) "config reloaded" (str "config reloaded (" problem ")"))))))

;; ---- files + quit -----------------------------------------------------------

(defn- ed-quit-now (m)
  "End the loop — and, on the primary, every open frame with it (`frames/frames-close-all`;
a frame's own quit is just its loop, see `frames/cmd-delete-frame`)."
  (assoc (if (or (:frame? m) (empty? (or (:frames m) [])))
           m
           ((reflect/eval 'frames/frames-close-all) m))
    :done true))

;; ---- map-y-or-n-p: ask about each of a list, y / n / ! / q ------------------
;; Emacs's `map-y-or-n-p`, and the loop the quit and `save-some-buffers` both ask with.
;;
;; Not a modal overlay: each answer is an `ed-read-char` continuation, so the loop stays
;; LIVE between questions — the editor still repaints, timers still fire, and a long list
;; does not freeze anything. It also means the recursion costs no stack: each step returns
;; to the loop and the next is entered from the keypress.

;; check-allow: `on-yes` and `on-done` are caller-supplied, so the checker cannot see what
;; the last step returns (ADR-341's `:trusted`, as `git-launch-op`).
(check-allow :trusted
  (sig ed-map-y-or-n (model seqable fn fn fn -> model))
  (defn ed-map-y-or-n (m items label on-yes on-done)
    "Ask about each of `items` in turn — `y` yes, `n` no, `!` yes to this and all the rest,
`q` stop asking — then hand the model and the number accepted to `on-done`.

`label` is `(item) -> string`, the question without its key hint. `on-yes` is
`(model item) -> model`, applied only to the accepted ones. `C-g`/Esc abandons the whole
run (`ed-read-char` catches them before the continuation), which is what a reader pressing
it means and why they are not listed as answers."
    (ed-map-y-or-n-step m (vec items) 0 0 label on-yes on-done)))

(defn- ed-map-y-or-n-step (m items index accepted label on-yes on-done)
  (if (>= index (count items))
    (on-done m accepted)
    (let (item (nth items index)
          next (fn (answered now-accepted)
                 (ed-map-y-or-n-step answered items (inc index) now-accepted label on-yes on-done)))
      (ed-read-char m
        (str (label item) " (y, n, !, q)")
        (fn (answered key)
          (cond
            (or (ed-yes-key? key) (= key " ")) (next (on-yes answered item) (inc accepted))
            ;; `!` — this one and every one after, without asking again. Folded rather
            ;; than looped through the prompt, so it is one step however many remain.
            (= key "!")
              (let (rest-items (drop items index))
                (on-done (fold rest-items
                           answered
                           (fn (saved pending-item) (on-yes saved pending-item)))
                  (+ accepted (count rest-items))))
            (= key "q") (on-done answered accepted)
            ;; anything else is "no" — Emacs treats an unrecognised key as no rather than
            ;; re-asking, and re-asking is how you get stuck in a prompt you cannot leave
            else (next answered accepted)))))))

(defn ed-unsaved-file-indices (m)
  "The pool indices of the modified file buffers a quit or C-x s asks about: every one
(`pool/ed-modified-file-indices`) but those whose save is already out or waiting
(`file-save/ed-save-pending?`), which the questions would only ask again — the quit waits for
them, and asks about one whose write failed."
  (seq/reject (ed-modified-file-indices m)
    (fn (index)
      (let (buffer (ed-buf-at m index))
        (and (nil? (ed-buffer-handler buffer)) (ed-save-pending? m (buffer-file buffer)))))))

(defcommand cmd-save-some-buffers
  (m key)
  "Save each modified file buffer, asking about each (C-x s, Emacs `save-some-buffers`)."
  (let (pending (ed-unsaved-file-indices m)
        files (map pending (fn (index) (buffer-file (ed-buf-at m index)))))
    (if (empty? pending)
      (message m "(no changes need saving)")
      ;; a run starts with an empty queue: one abandoned (C-g) must not be saved by this one
      (ed-map-y-or-n (dissoc m :deferred-saves :superseded)
        pending
        (fn (index) (str "Save file " (buffer-file (ed-buf-at m index)) "?"))
        (fn (answered index) (ed-save-or-queue answered index))
        (fn (answered accepted)
          ;; a file changed on disk is asked about on its own; the ones a file handler saves
          ;; later go after every question
          (ed-ask-superseded (dissoc answered :superseded)
            (or (:superseded answered) [])
            0
            (fn (asked declined)
              (ed-run-deferred-saves (dissoc asked :deferred-saves)
                (:deferred-saves asked)
                ;; the count is said once every write has landed, and counts what did
                (fn (deferred)
                  (ed-when-saves-land deferred
                    (fn (landed) (ed-say-saved landed files (- accepted declined)))))))))))))

(defn- ed-say-saved (m files meant)
  "C-x s's last word, once its writes have landed: how many of `files` (the ones it asked about)
are saved now, against the `meant` the answers asked for — a write that failed said, not
counted."
  (let (saved (count (seq/filter files
                       (fn (file)
                         (let (index (ed-buffer-index-by-file m file))
                           (and index (not (buffer-modified? (ed-buf-at m index))))))))
        failed (- meant saved))
    (message m
      (cond
        (> failed 0)
          (str "saved "
            (ed-count-noun saved "buffer")
            "; "
            failed
            " not saved (see *Messages*)")
        (= saved 0) "(no buffers saved)"
        else (str "saved " (ed-count-noun saved "buffer"))))))

(defn ed-live-processes-prompt (live)
  "The question C-x C-c asks when `live` (lines from `model/ed-live-processes`) is not
empty: Emacs's `Active processes exist; kill them and exit anyway?`, naming them — the
first two, and how many more — since a prompt that does not say WHICH is answered blind."
  (let (shown (take live 2)
        more (- (count live) (count shown)))
    (str (if (= (count live) 1) "Still running: " "Still running — ")
      (string/join shown "; ")
      (if (> more 0) (str "; and " more " more") "")
      ". Kill and exit anyway? (y or n)")))

(defn- ed-quit-confirm-processes (m)
  "The last question before quitting: when a feature has work running that quitting kills
(`model/ed-live-processes` — a compile, a test run, the app, a terminal's program, a push),
ask; with none, quit."
  (let (live (ed-live-processes m))
    (if (empty? live)
      (ed-quit-now m)
      (ed-confirm m (ed-live-processes-prompt live) ed-quit-now "quit canceled"))))

(defn- ed-quit-ask (m pending save-all?)
  "Emacs `save-buffers-kill-terminal`: ask about each modified file buffer
(`ed-map-y-or-n`), then — if anything is still modified — `Modified buffers exist; exit
anyway?`, then — if anything is still running — whether to kill it
(`ed-quit-confirm-processes`). `C-g` / Esc at any prompt cancels the quit.

`save-all?` skips the asking about buffers (the `!` answer, and the caller that already
knows); the running processes are still asked about."
  (let (after-saves (fn (asked)
                      (if (empty? (ed-modified-file-indices asked))
                        (ed-quit-confirm-processes asked)
                        (ed-confirm asked
                          "Modified buffers exist; exit anyway? (y or n)" ed-quit-confirm-processes
                          "quit canceled")))
        ;; a save that lands later waits until every question is answered, and the quit goes
        ;; on when the last has landed — or stops, saying why, when one fails or is cancelled
        finish (fn (asked _)
                 ;; a file changed on disk is asked about on its own first
                 (ed-ask-superseded (dissoc asked :superseded)
                   (or (:superseded asked) [])
                   0
                   (fn (confirmed _)
                     (ed-run-deferred-saves (dissoc confirmed :deferred-saves)
                       (:deferred-saves confirmed)
                       ;; and every plain write still out, so the quit never cuts one off
                       (fn (deferred) (ed-when-saves-land deferred after-saves))
                       " — quit canceled"))))
        save (fn (asked index) (ed-save-or-queue asked index)))
    (if save-all?
      (finish (fold pending m save) 0)
      (ed-map-y-or-n m
        pending
        (fn (index) (str "Save file " (buffer-file (ed-buf-at m index)) "?"))
        save
        finish))))

(defn- ed-save-or-queue (m index)
  "Save pool buffer `index` now — or, when its file handler's save lands later, queue it on
`:deferred-saves` for after the questions: it may ask for a password, and a masked prompt must
not open between two y-or-n questions. A buffer whose FILE changed on disk since it was visited
or saved is not written here at all: it is set aside on `:superseded` and asked about on its
own once the questions are done ([[ed-ask-superseded]]) — a `y` or a `!` to \"Save file X?\"
is no answer to \"overwrite what another program wrote there?\", which C-x C-s asks too."
  (let (buffer (ed-buf-at m index)
        handler (ed-buffer-handler buffer)
        entry (when handler (ed-handler-call handler :later-entry nil buffer)))
    (cond
      (and (nil? handler)
        (not (ed-save-pending? m (buffer-file buffer)))
        (buffer-file-changed? buffer))
        (assoc m :superseded (conj (or (:superseded m) []) index))
      (nil? entry) (ed-save-buf-at m index)
      else
        (map/assoc-in m
          [:deferred-saves (:name handler)]
          (conj (or (map/get-in m [:deferred-saves (:name handler)]) []) entry)))))

;; check-allow: `then` is a continuation; it answers a model
(check-allow :trusted
  (defn ed-ask-superseded (m indices declined then)
    "Ask about each pool buffer in `indices` — set aside by [[ed-save-or-queue]] because its
file changed on disk since it was visited or saved — on its own, naming the overwrite: `y`
writes this buffer over the file, anything else leaves the file as it is. Then
`(then m declined)`, `declined` counting the ones left unsaved."
    (if (empty? indices)
      (then m declined)
      (let (index (first indices)
            file (buffer-file (ed-buf-at m index)))
        (ed-read-char m
          (str file
            " changed on disk since it was visited or saved. Overwrite it with this buffer? (y or n)")
          (fn (answered key)
            (if (ed-yes-key? key)
              (ed-ask-superseded (ed-save-buf-at answered index) (rest indices) declined then)
              (ed-ask-superseded answered (rest indices) (inc declined) then))))))))
;; check-allow: `then` is a continuation and the handlers' saves are resolved late; each
;; answers a model
(check-allow :trusted
  (defn- ed-run-deferred-saves (m queued then &optional (abandon-note nil))
    ;; `queued`, `:deferred-saves`' `{handler-name entries}`, each handler's in turn, then
    ;; `(then m)`. A handler taken away since the question is passed over.
    (if (empty? queued)
      (then m)
      (let ([name entries] (first queued)
            handler (registry/lookup :model/file-handlers name)
            next (fn (saved) (ed-run-deferred-saves saved (rest queued) then abandon-note)))
        (if (nil? handler)
          (next m)
          (ed-handler-call handler :save-all m m entries next abandon-note))))))

(defcommand cmd-quit
  (m key)
  "Quit the editor (C-x C-c, and the window's X button, delivered as `:close` — the
model claims it with `:close-is-input?` so it lands here rather than quitting the loop
outright). With unsaved changes to a file it asks first, buffer by buffer, the way Emacs's
`save-buffers-kill-terminal` does (`ed-quit-ask`); then, with a compile, a test run, the
app, a terminal's program or a push still running, whether to kill them (Emacs's \"Active
processes exist\"); with neither it quits at once — and the primary takes every open frame
with it. In a FRAME (`:frame?`) this is `delete-frame`: the
frame closes, the editor and its buffers stay (Emacs closes an emacsclient frame the same
way). ESC is *not* quit (it's `keyboard-escape-quit`; see `modes`)."
  ;; save-place: every file's point, for the next session (live editor only; a secondary
  ;; frame closing leaves the buffers open, so it has nothing to remember yet)
  (when (and (:save-place m) (not (:frame? m))) (saveplace/remember-places! (:buffers m)))
  ;; the session: its files and layout, reopened by the next start in this project
  (when (not (:frame? m)) (lastsession/save! m))
  ;; the keys this window timed since the slow-turn log last recorded them (brood ADR-612)
  (let (m (slowlog/flush-latency m 1))
    (if (:frame? m)
      (frames/frames-leave m)
      (ed-quit-ask (dissoc m :deferred-saves :superseded) (ed-unsaved-file-indices m) false))))

(defcommand cmd-save
  (m key)
  "Write the current buffer to its file (C-x C-s); report the outcome in the echo
area. Leaves the buffer unmodified and deletes the `#filename#` auto-save
sidecar on success (`ed-save-buf-at`). A no-op-with-message if the buffer has no
backing file.

With format-on-save on (and a formatter for this language) the write is a format
(`formatter/on-save`, which saves first itself) — but only once the file is known to be
ours to write: the \"changed on disk\" question comes FIRST, so a format never overwrites
another writer's changes unasked."
  (let (buffer (ed-current-buf m)
        write (fn (saving)
                (or (formatter/on-save saving) (ed-save-buf-at saving (ed-current-index saving))))
        ;; a hex view names its file so the mode line and C-x C-j know it, but its TEXT
        ;; is a rendering of the bytes: writing it would replace the binary with a dump.
        ;; The mode says so (`:no-write`), so this command never names one.
        refusal (ed-no-write-refusal buffer "saved"))
    (cond
      refusal (message m refusal)
      (nil? (buffer-file buffer))
        (message m "no file to save (C-x C-f to open one, or run: nest run -- <path>)")
      ;; another writer changed the file since this buffer last agreed with it: saving
      ;; would overwrite their work, so ask (Emacs: \"has changed since visited or saved\").
      ;; Not while this buffer's own write is out: that write is what moved the file
      (and (not (and (nil? (ed-buffer-handler buffer)) (ed-save-pending? m (buffer-file buffer))))
        (buffer-file-changed? buffer))
        (ed-confirm m
          (str (buffer-file buffer) " has changed since visited or saved. Save anyway? (y or n)")
          write
          "save canceled (M-x revert-buffer to reload the disk version)")
      else (write m))))

;; a guest may run these (src/guest.blsp)
(interactive/declare-trait :guest
  '(lifecycle/cmd-quit lifecycle/cmd-revert-buffer
     lifecycle/cmd-save lifecycle/cmd-save-some-buffers))
