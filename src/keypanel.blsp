(defmodule keypanel
  "The KEY PANEL: what the keys do here, shown while you choose one — a transient menu (git's
push, embark's actions) and which-key's continuations of a pending prefix. One shape of data,
one place that decides how it looks.

A PANEL is data, `{:title :groups :layout :page :page-hint}`: its groups are `keycolumns`
groups (`{:title :rows}`, each row an entry `{:key :text}`); `:layout` is `:balanced` (whole
groups packed side by side, Magit's transient) or `:flow` (one run of lines read down then
across, a group running on into the next column, which-key's); `:page` turns a panel wider than
the frame, `:page-hint` says which keys turn it. A feature that has a panel to show registers a
SOURCE ([[register-panel-source]]); the first source with an answer is shown.

How a panel looks is a STYLE ([[register-panel-style]]), chosen by the `:key-panel` setting.
The editor's own, `:echo`, is Emacs's: a flat strip the full width of the frame at the bottom,
in the echo area below the mode line — where which-key's side window and Magit's transient
buffer sit — with no card. A package registers another style and the setting names it; the
sources never know which one draws them."
  (:use model :only [register-frame-overlay])
  (:use theme) ; ui-ctx — the palette as the kit's roles
  (:use ui-kit :only [ui-face ui-clip])
  (:use editor/display :only [text]))

;; ---- the registries --------------------------------------------------------------------------

(defn register-panel-source (name row)
  "Add the panel source `name`: `{:rank n :when key :run 'sym}`. `(sym m rows)` answers the panel
to show, or nil — `rows` the most lines a column may take. `:when` names a model key that must be
set before the source is asked, so a feature that is not in use is never loaded to say so (the
transient's `:transient`, which-key's `:which-key`). Lowest `:rank` first."
  (sources/register :keypanel/sources name row))

(defn register-panel-style (name row)
  "Add the panel style `name`: `{:rows 'rows-fn :paint 'paint-fn}`. `(rows-fn panel rows)` is how
many rows of the echo area, below its message row, the style takes for `panel` in a frame `rows`
tall (0 for a style that draws over the text instead); `(paint-fn panel m columns rows)` its
render ops. The `:key-panel` setting names the style in use."
  (sources/register :keypanel/styles name row))

(settings/define config/*settings*
  :key-panel {:default :echo
   :type 'keyword
   :model-key :key-panel
   :commented? true
   :doc (str "how a key panel (a transient menu, which-key) is shown: :echo, a flat strip in the\n"
          "echo area as Emacs shows them, or a style a package registers (keypanel/register-panel-style)")})

;; ---- which panel, drawn how ------------------------------------------------------------------

(def panel-max-rows
  ;; the most lines a panel's column takes, as the minibuffer's list (Emacs vertico-count)
  10)

(sig column-limit (int -> int))
(defn- column-limit (rows)
  ;; the lines a column may take in a frame `rows` tall: the cap, leaving a pane room above
  (math/max 1 (math/min panel-max-rows (- rows 6))))

(defn ed-key-panel (m rows)
  "The panel to show for `m` in a frame `rows` tall, or nil: the first source with one, none
while a prompt lists candidates (its list owns the echo area)."
  (let (minibuffer (:minibuffer m))
    (when (not (and minibuffer (:accept-selection minibuffer)))
      (fold (sources/rows :keypanel/sources)
        nil
        (fn (found row)
          (or found
            (when (or (nil? (:when row)) (get m (:when row)))
              (reflect/call-if-bound (:run row) nil m (column-limit rows)))))))))

(defn- style-of (m)
  ;; the style row the `:key-panel` setting names, the editor's own when it names none there is
  (let (rows (into {} (map (registry/ranked :keypanel/styles) (fn ([name row]) [name row]))))
    (or (get rows (get m :key-panel :echo)) (get rows :echo))))

(sig panel-rows (map int -> int))
(defn panel-rows (m rows)
  "How many rows of the echo area, below its message row, the key panel takes in a frame `rows`
tall — 0 when there is none."
  (let (panel (ed-key-panel m rows))
    (if (nil? panel)
      0
      (math/max 0
        (let (wanted (reflect/call-if-bound (:rows (style-of m)) 0 panel rows))
          (math/min (- rows 4) (if (int? wanted) wanted 0)))))))

(defn ed-key-panel-ops (m columns rows)
  "The key panel's render ops, drawn by the style in use; `[]` when there is none."
  (let (panel (ed-key-panel m rows))
    (if (nil? panel)
      []
      (or (reflect/call-if-bound (:paint (style-of m)) [] panel m columns rows) []))))

;; ---- the layout every style may share --------------------------------------------------------
;; A panel's height never depends on the frame's width: the echo area is reserved before the
;; columns are known. So the lines are packed into columns of a fixed height and a panel wider
;; than the frame is paged, as which-key pages.

(defn- with-key-widths (groups)
  ;; each entry carrying its group's key column width, so a column of several groups aligns each
  ;; group's descriptions on its own keys
  (map groups
    (fn (group)
      (let (width (keycolumns/key-width (:rows group)))
        (assoc group :rows (map (:rows group) (fn (entry) (assoc entry :key-width width))))))))

(sig panel-height (map int -> int))
(defn panel-height (panel rows)
  "The lines a column of `panel` takes in a frame `rows` tall: the tallest group (`:balanced`) or
every line (`:flow`), capped."
  (let (groups (:groups panel)
        wanted (if (= (:layout panel) :flow)
                 (count (keycolumns/flow-lines groups 1000000))
                 (fold groups
                   0
                   (fn (most group) (math/max most (count (keycolumns/group-lines group)))))))
    (math/max 1 (math/min (column-limit rows) wanted))))

(defn panel-columns (panel height)
  "`panel`'s lines as columns of at most `height` lines, each a vector of `keycolumns` lines:
whole groups packed in order (`:balanced`), or one run read down then across (`:flow`)."
  (let (groups (vec (with-key-widths (:groups panel))))
    (if (= (:layout panel) :flow)
      (map (seq/chunk-every (keycolumns/flow-lines groups height) height) vec)
      (map (keycolumns/balanced-columns groups (count groups)) keycolumns/column-lines))))

(defn- line-width (line)
  (case (first line)
    :heading (string/display-width (second line))
    :row
      (let (entry (second line))
        (+ (:key-width entry) keycolumns/key-gap (string/display-width (:text entry))))
    0))

(defn- column-width (lines) (fold lines 0 (fn (widest line) (math/max widest (line-width line)))))

(defn panel-pages (columns available)
  "`columns` split into pages of the columns that fit side by side in `available` cells,
[[keycolumns/column-gap]] apart; a column wider than that is a page of its own."
  (fold columns
    []
    (fn (pages lines)
      (let (width (column-width lines)
            page (last pages)
            used (if (nil? page)
                   0
                   (+ (fold page 0 (fn (sum column) (+ sum (column-width column))))
                     (* keycolumns/column-gap (count page)))))
        (if (and (not (nil? page)) (<= (+ used width) available))
          (assoc pages (dec (count pages)) (conj page lines))
          (conj pages [lines]))))))

;; ---- :echo — the editor's own: a flat strip in the echo area ---------------------------------

(defn echo-rows (panel rows)
  "The rows the `:echo` style takes for `panel`: a column's height, plus a title row when the panel
has a title. (A panel that pages in a narrow frame shows its count on that row; one with no title
then takes its first line's row.)"
  (+ (panel-height panel rows) (if (string/blank? (or (:title panel) "")) 0 1)))

(defn echo-faces (gui?)
  "The `:echo` style's faces, by role: Magit's transient — a key in the accent colour, bold, a
heading bold and muted, a title bold."
  (let (theme (:theme (ui-ctx gui?)))
    {:title (ui-face theme {:fg :on-surface :bold true})
     :heading (ui-face theme {:fg :muted :bold true})
     :key (ui-face theme {:fg :accent :bold true})
     :text (ui-face theme {:fg :on-surface})
     :hint (ui-face theme {:fg :faint})}))

;; check-allow: the positions are cell counts — a column's widths summed from its entries' key
;; widths, which ride on the entries as data — that the checker reads back as `number`
(check-allow :type-mismatch
  (defn- line-ops (line row x room faces)
    ;; one line of a column at `row`, column `x`, in `room` cells
    (case (first line)
      :heading [(text row x (ui-clip (second line) room) (:heading faces))]
      :row
        (let (entry (second line)
              after (+ (:key-width entry) keycolumns/key-gap))
          [(text row x (ui-clip (:key entry) room) (:key faces))
            (text row (+ x after) (ui-clip (:text entry) (math/max 0 (- room after))) (:text faces))])
      [])))

(defn echo-paint (panel m columns rows)
  "The `:echo` style: `panel` as a flat strip across the bottom of the frame, below the echo
area's message row — its title (and its page count, right-aligned) on the first row, then its
columns side by side."
  (let (faces (echo-faces (:gui m))
        height (panel-height panel rows)
        pages (panel-pages (panel-columns panel height) columns)
        index (math/mod (or (:page panel) 0) (count pages))
        page (nth pages index)
        titled? (not (string/blank? (or (:title panel) "")))
        top (- rows height (if titled? 1 0))
        hint (when (> (count pages) 1)
               (str "page "
                 (inc index)
                 "/"
                 (count pages)
                 (if (:page-hint panel) (str " · " (:page-hint panel)) "")))
        title-ops (append (if titled?
                            [(text top 0 (ui-clip (:title panel) columns) (:title faces))]
                            [])
                    (if hint
                      [(text top
                         (math/max 0 (- columns (string/display-width hint)))
                         hint
                         (:hint faces))]
                      []))
        first-row (if titled? (inc top) top)
        [_ ops] (fold page
                  [0 []]
                  (fn ([x ops] lines)
                    [(+ x (column-width lines) keycolumns/column-gap)
                      (into ops
                        (mapcat (seq/enumerate lines)
                          (fn ([index line])
                            (line-ops line (+ first-row index) x (math/max 0 (- columns x)) faces))))])))
    (into (vec title-ops) ops)))

(register-panel-style :echo {:rows 'keypanel/echo-rows :paint 'keypanel/echo-paint})
(register-frame-overlay :key-panel {:rank 30 :run 'keypanel/ed-key-panel-ops})
