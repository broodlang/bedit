(defmodule keymaps
  "Keybinding **profiles** — the editor's top-level \"do the keys feel like Emacs or
Vim?\" choice, expressed entirely as `std/layers` (no kernel surface; we keep the core
thin and add features as layers/modules).

The insight: a profile is just *which keybinding layers sit on the MODEL scope*. A
buffer carries its **mode** layers (brood/text — language services + mode-specific
keys); the model carries its **profile** layers (the universal bindings). Dispatch
composes the two (`input/ed-active-keymap` → `scope-keymap (list buffer model)`), the
buffer winning. Swapping the profile is swapping the model's base layer — the buffer's
mode is untouched.

Modal editing (Vim's normal/insert/visual) needs no new primitive either: each state is
a layer the mode-transition commands push/pop on the model with `activate-layer` /
`deactivate-layer`. Insert mode is the insert layer at highest precedence; `Esc`
deactivates it. The stack already does this.

Both profiles bind to the SAME `(model key) -> model` command pool in `commands` —
Vim's `h`/`x`/`dd` reuse `cmd-backward-char` / `cmd-delete-char` / `cmd-kill-whole-line`.
The only profile-specific commands are the mode transitions (`commands/cmd-vim-*`) and the grammar (`vim/cmd-vim-*`).

    (ed-set-profile m :vim)    ; install vim-normal on the model, start in :normal
    (ed-set-profile m :emacs)  ; back to the Emacs bindings

Command values in the keymaps are quoted, fully-qualified symbols resolved with
`(reflect/eval sym)` at dispatch (late binding — rebinding a key or redefining a command
hot-swaps live), so this module needs no `(:use commands)`."
  (:use editor/keymap)) ; keymap-bind — build the keymaps as data
;; editor/layers/scope-keymap (compose a profile's keymap for help text) is referenced
;; qualified below and auto-loads.

;; ============================================================================
;; The Emacs profile — the universal bindings (was `modes/global-keymap`).
;; ============================================================================
;; The editor's default. These are the bindings that used to be pinned to every
;; buffer as the `global` system layer; they now live on the model scope so a second
;; profile (vim) can replace them without re-seeding every buffer.

(def emacs-keymap
  (-> {}
    ;; movement — arrows + the Emacs C-/M- equivalents
    (keymap-bind [:left] 'commands/cmd-backward-char)
    (keymap-bind [:ctrl-b] 'commands/cmd-backward-char)
    (keymap-bind [:right] 'commands/cmd-forward-char)
    (keymap-bind [:ctrl-f] 'commands/cmd-forward-char)
    (keymap-bind [:up] 'commands/cmd-previous-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)
    (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
    (keymap-bind [:home] 'commands/cmd-beginning-of-line)
    (keymap-bind [:ctrl-a] 'commands/cmd-beginning-of-line)
    (keymap-bind [:end] 'commands/cmd-end-of-line)
    (keymap-bind [:ctrl-e] 'commands/cmd-end-of-line)
    ;; shift-select — Shift+arrows / Home / End extend the region (Emacs shift-select)
    (keymap-bind [:shift-up] 'commands/cmd-shift-motion)
    (keymap-bind [:shift-down] 'commands/cmd-shift-motion)
    (keymap-bind [:shift-left] 'commands/cmd-shift-motion)
    (keymap-bind [:shift-right] 'commands/cmd-shift-motion)
    (keymap-bind [:shift-home] 'commands/cmd-shift-motion)
    (keymap-bind [:shift-end] 'commands/cmd-shift-motion)
    ;; Ctrl + arrows — the word/paragraph motions Emacs puts there (a named key carries its
    ;; modifiers in its name, ADR-328: `:ctrl-left`, not a plain `:left` with Ctrl lost)
    (keymap-bind [:ctrl-left] 'commands/cmd-backward-word)
    (keymap-bind [:ctrl-right] 'commands/cmd-forward-word)
    (keymap-bind [:ctrl-up] 'commands/cmd-backward-paragraph)
    (keymap-bind [:ctrl-down] 'commands/cmd-forward-paragraph)
    ;; Meta + arrows — select the pane in that direction (windmove)
    (keymap-bind [:alt-left] 'commands/cmd-windmove-left)
    (keymap-bind [:alt-right] 'commands/cmd-windmove-right)
    (keymap-bind [:alt-up] 'commands/cmd-windmove-up)
    (keymap-bind [:alt-down] 'commands/cmd-windmove-down)
    ;; Ctrl+Shift + arrows — MOVE this window in that direction (buffer-move)
    (keymap-bind [:ctrl-shift-left] 'commands/cmd-swap-pane-left)
    (keymap-bind [:ctrl-shift-right] 'commands/cmd-swap-pane-right)
    (keymap-bind [:ctrl-shift-up] 'commands/cmd-swap-pane-up)
    (keymap-bind [:ctrl-shift-down] 'commands/cmd-swap-pane-down)
    (keymap-bind [:alt-f] 'commands/cmd-forward-word)
    (keymap-bind [:alt-b] 'commands/cmd-backward-word)
    (keymap-bind [(keyword "alt-<")] 'commands/cmd-beginning-of-buffer) ; M-<
    (keymap-bind [(keyword "alt->")] 'commands/cmd-end-of-buffer) ; M->
    ;; M-m — first non-whitespace char of the line (back-to-indentation)
    (keymap-bind [:alt-m] 'commands/cmd-back-to-indentation) ; M-m
    ;; paragraph motion — M-{ / M-}
    (keymap-bind [(keyword "alt-{")] 'commands/cmd-backward-paragraph) ; M-{
    (keymap-bind [(keyword "alt-}")] 'commands/cmd-forward-paragraph) ; M-}
    ;; sentence motion — M-a / M-e, and M-k / C-x DEL to kill one
    (keymap-bind [:alt-a] 'commands/cmd-backward-sentence) ; M-a
    (keymap-bind [:alt-e] 'commands/cmd-forward-sentence) ; M-e
    (keymap-bind [:alt-k] 'commands/cmd-kill-sentence) ; M-k
    (keymap-bind [:ctrl-x :backspace] 'commands/cmd-backward-kill-sentence) ; C-x DEL
    ;; screenful scrolling — C-v / M-v + the PageDown / PageUp keys
    (keymap-bind [:ctrl-v] 'commands/cmd-scroll-up)
    (keymap-bind [:page-down] 'commands/cmd-scroll-up)
    (keymap-bind [:alt-v] 'commands/cmd-scroll-down)
    (keymap-bind [:page-up] 'commands/cmd-scroll-down)
    ;; recenter (C-l) + move point to window top/middle/bottom (M-r) — both cycle
    (keymap-bind [:ctrl-l] 'commands/cmd-recenter)
    (keymap-bind [:alt-r] 'commands/cmd-move-to-window-line)
    ;; TAB indents the line (sexp-aware in brood-mode), and completes when the line
    ;; is already indented and point is on a symbol (Emacs tab-always-indent =
    ;; 'complete); C-M-i always completes.
    (keymap-bind [:tab] 'commands/cmd-indent-or-complete)
    (keymap-bind [:ctrl-meta-i] 'complete-at-point/cmd-complete)
    ;; Shift-TAB (arrives as :back-tab) dedents the line or region
    (keymap-bind [:back-tab] 'commands/cmd-dedent)
    ;; M-x — run any interactive command by name
    (keymap-bind [:alt-x] 'commands/cmd-execute-extended-command)
    ;; incremental search — C-s forward, C-r backward (modal; see src/isearch.blsp)
    (keymap-bind [:ctrl-s] 'commands/cmd-isearch-forward)
    (keymap-bind [:ctrl-r] 'commands/cmd-isearch-backward)
    ;; M-s — the search prefix (Emacs search-map): M-s s fuzzy line search (consult-line
    ;; style; the Vertico list), M-s o occur (matching lines in a read-only *Occur* buffer).
    (keymap-bind [:alt-s "s"] 'commands/cmd-fuzzy-find-line)
    (keymap-bind [:alt-s "o"] 'commands/cmd-occur)
    ;; M-% — query-replace (prompts, then the y/n/!/./q loop)
    (keymap-bind [(keyword "alt-%")] 'commands/cmd-query-replace)
    ;; editing
    (keymap-bind [:enter] 'commands/cmd-newline)
    (keymap-bind [:backspace] 'commands/cmd-delete-backward)
    (keymap-bind [:delete] 'commands/cmd-delete-char)
    (keymap-bind [:ctrl-d] 'commands/cmd-delete-char)
    (keymap-bind [:ctrl-backspace] 'commands/cmd-backward-kill-word)
    (keymap-bind [:ctrl-delete] 'commands/cmd-kill-word)
    ;; open lines — C-o keeps point, M-o below, M-O above
    (keymap-bind [:ctrl-o] 'commands/cmd-open-line)
    (keymap-bind [:alt-o] 'commands/cmd-open-line-below)
    (keymap-bind [(keyword "alt-O")] 'commands/cmd-open-line-above)
    ;; kill (→ kill ring; yank with C-y)
    (keymap-bind [:ctrl-k] 'commands/cmd-kill-line)
    (keymap-bind [:alt-d] 'commands/cmd-kill-word)
    (keymap-bind [(keyword "alt-backspace")] 'commands/cmd-backward-kill-word)
    ;; C-S-backspace kills the whole line (Emacs `kill-whole-line`). Key encoding is
    ;; a best-guess (ROADMAP caveat) — rebindable live; also reachable via M-x.
    (keymap-bind [(keyword "ctrl-shift-backspace")] 'commands/cmd-kill-whole-line)
    ;; transpose / duplicate / join
    (keymap-bind [:ctrl-t] 'commands/cmd-transpose-chars)
    ;; dired, the Emacs way: C-x d prompts for a directory (`dired`); C-x C-j jumps to the
    ;; current file's directory with point on the file (`dired-jump`) — and so does C-x j,
    ;; a bedit convenience. C-x C-d (Emacs `list-directory`) prompts too. `duplicate-line`
    ;; used to sit on C-x d; it is M-x duplicate-line now.
    (keymap-bind [:ctrl-x "d"] 'dired/cmd-dired)
    (keymap-bind [:ctrl-x :ctrl-d] 'dired/cmd-dired)
    (keymap-bind [:ctrl-x :ctrl-j] 'dired/cmd-dired-jump)
    (keymap-bind [:ctrl-x "j"] 'dired/cmd-dired-jump)
    (keymap-bind [(keyword "alt-^")] 'commands/cmd-join-line)
    ;; case (M-u / M-l / M-c)
    (keymap-bind [:alt-u] 'commands/cmd-upcase-word)
    (keymap-bind [:alt-l] 'commands/cmd-downcase-word)
    (keymap-bind [:alt-c] 'commands/cmd-capitalize-word)
    ;; comment / uncomment the line or region (mode-aware via :comment-syntax)
    (keymap-bind [(keyword "alt-;")] 'commands/cmd-comment-dwim)
    ;; M-SPC cycles (one space → none → what was there), as it does in Emacs 29+;
    ;; `just-one-space` is still a command, it just no longer owns the key
    (keymap-bind [(keyword "alt- ")] 'commands/cmd-cycle-spacing) ; M-SPC
    (keymap-bind [(keyword "alt-\\")] 'commands/cmd-delete-horizontal-space) ; M-\
    (keymap-bind [:alt-t] 'commands/cmd-transpose-words) ; M-t
    (keymap-bind [:alt-z] 'commands/cmd-zap-to-char) ; M-z
    (keymap-bind [:alt-q] 'commands/cmd-fill-paragraph) ; M-q
    ;; keyboard macros (C-x ( record, C-x ) end, C-x e execute)
    (keymap-bind [:ctrl-x "("] 'commands/cmd-start-kbd-macro)
    (keymap-bind [:ctrl-x ")"] 'commands/cmd-end-kbd-macro)
    (keymap-bind [:ctrl-x "e"] 'commands/cmd-execute-kbd-macro)
    ;; repeat last command (C-x z); tap z to keep repeating
    (keymap-bind [:ctrl-x "z"] 'commands/cmd-repeat)
    ;; compilation
    (keymap-bind [:ctrl-x "`"] 'compile/cmd-next-error)
    ;; C-x r register prefix
    (keymap-bind [:ctrl-x "r" " "] 'commands/cmd-point-to-register)
    (keymap-bind [:ctrl-x "r" "j"] 'commands/cmd-jump-to-register)
    (keymap-bind [:ctrl-x "r" "s"] 'commands/cmd-copy-to-register)
    (keymap-bind [:ctrl-x "r" "i"] 'commands/cmd-insert-register)
    (keymap-bind [:ctrl-x "r" "m"] 'commands/cmd-bookmark-set)
    (keymap-bind [:ctrl-x "r" "b"] 'commands/cmd-bookmark-jump)
    ;; rectangles share the C-x r prefix with registers/bookmarks (Emacs), by suffix
    (keymap-bind [:ctrl-x "r" "k"] 'commands/cmd-kill-rectangle)
    (keymap-bind [:ctrl-x "r" (keyword "alt-w")] 'commands/cmd-copy-rectangle-as-kill)
    (keymap-bind [:ctrl-x "r" "d"] 'commands/cmd-delete-rectangle)
    (keymap-bind [:ctrl-x "r" "y"] 'commands/cmd-yank-rectangle)
    (keymap-bind [:ctrl-x "r" "o"] 'commands/cmd-open-rectangle)
    (keymap-bind [:ctrl-x "r" "c"] 'commands/cmd-clear-rectangle)
    (keymap-bind [:ctrl-x "r" "t"] 'commands/cmd-string-rectangle)
    ;; undo / redo — redo on C-? (Emacs 28 `undo-redo`); M-/ is dabbrev, as in Emacs
    (keymap-bind [:ctrl-/] 'commands/cmd-undo)
    (keymap-bind [:ctrl-?] 'commands/cmd-redo)
    (keymap-bind [:alt-/] 'commands/cmd-dabbrev-expand)
    ;; the everyday tail: buffer list, shell commands, line utilities, count, insert-file
    (keymap-bind [:ctrl-x :ctrl-b] 'commands/cmd-list-buffers)
    ;; frames (C-x 5 …): a second window on the same buffers (src/frames.blsp)
    ;; C-x 4 — the other-window prefix (Emacs): open into ANOTHER pane, not this one
    (keymap-bind [:ctrl-x "s"] 'commands/cmd-save-some-buffers) ; C-x s — save each, asking
    (keymap-bind [:ctrl-x "="] 'commands/cmd-what-cursor-position) ; C-x = — what is this character
    (keymap-bind [:ctrl-meta-backslash] 'commands/cmd-indent-region) ; C-M-\ — reindent the region
    (keymap-bind [:ctrl-x "4" "f"] 'commands/cmd-find-file-other-window)
    (keymap-bind [:ctrl-x "4" :ctrl-f] 'commands/cmd-find-file-other-window)
    (keymap-bind [:ctrl-x "4" "b"] 'commands/cmd-switch-buffer-other-window)
    (keymap-bind [:ctrl-x "4" "d"] 'commands/cmd-dired-other-window)
    (keymap-bind [:ctrl-x "4" "0"] 'commands/cmd-kill-buffer-and-window)
    (keymap-bind [:ctrl-x "5" "2"] 'frames/cmd-make-frame)
    (keymap-bind [:ctrl-x "5" "0"] 'frames/cmd-delete-frame)
    (keymap-bind [:ctrl-x "5" "o"] 'frames/cmd-other-frame)
    (keymap-bind [:alt-!] 'commands/cmd-shell-command)
    (keymap-bind [:alt-|] 'commands/cmd-shell-command-on-region)
    (keymap-bind [:ctrl-x :ctrl-o] 'commands/cmd-delete-blank-lines)
    (keymap-bind [:alt-=] 'commands/cmd-count-words)
    (keymap-bind [:ctrl-x "i"] 'commands/cmd-insert-file)
    ;; region / kill ring — C-SPC arrives as the keyword named "ctrl- "
    (keymap-bind [(keyword "ctrl- ")] 'commands/cmd-set-mark)
    ;; select / mark regions — C-x h whole buffer, M-h paragraph, C-M-h defun,
    ;; C-x C-x exchange point and mark
    (keymap-bind [:ctrl-x "h"] 'commands/cmd-mark-whole-buffer)
    (keymap-bind [:alt-h] 'commands/cmd-mark-paragraph)
    (keymap-bind [(keyword "alt-@")] 'commands/cmd-mark-word) ; M-@ mark-word
    (keymap-bind [:ctrl-meta-h] 'commands/cmd-mark-defun)
    (keymap-bind [:ctrl-x :ctrl-x] 'commands/cmd-exchange-point-and-mark)
    (keymap-bind [:ctrl-w] 'commands/cmd-kill-region)
    (keymap-bind [:alt-w] 'commands/cmd-copy-region)
    (keymap-bind [:ctrl-y] 'commands/cmd-yank)
    (keymap-bind [:alt-y] 'commands/cmd-yank-pop)
    ;; C-u — universal/numeric prefix argument (C-u N <cmd> runs <cmd> N times)
    (keymap-bind [:ctrl-u] 'commands/cmd-universal-argument)
    ;; M-- / C-- / C-M-- — negative argument: the next command runs in reverse (or |N|
    ;; times). All three are `negative-argument` in Emacs; C-M-- is the one you reach for
    ;; mid-sexp-navigation (Ctrl+Meta already held for C-M-f/b), so it must be bound too.
    (keymap-bind [(keyword "alt--")] 'commands/cmd-negative-argument)
    (keymap-bind [(keyword "ctrl--")] 'commands/cmd-negative-argument)
    (keymap-bind [(keyword "ctrl-meta--")] 'commands/cmd-negative-argument)
    ;; C-g — interrupt a running eval (kill its process), else a no-op quit
    (keymap-bind [:ctrl-g] 'commands/cmd-keyboard-quit)
    ;; ESC is `keyboard-escape-quit`, NOT exit (Emacs: a valid command — cancel /
    ;; abort, like C-g). A transient overlay (minibuffer / isearch / completion)
    ;; consumes ESC itself to abort; outside one it's a harmless cancel. The editor
    ;; quits via C-x C-c, or the window's X button (delivered as `:close`, which the
    ;; model claims (`:close-is-input?`) so it runs `cmd-quit` too — never `:escape`).
    (keymap-bind [:escape] 'commands/cmd-keyboard-quit)
    ;; the C-x prefix
    (keymap-bind [:ctrl-x :ctrl-c] 'commands/cmd-quit)
    (keymap-bind [:ctrl-x :ctrl-s] 'commands/cmd-save)
    (keymap-bind [:ctrl-x :ctrl-w] 'commands/cmd-write-file)
    (keymap-bind [:ctrl-x :ctrl-q] 'commands/cmd-toggle-read-only)
    (keymap-bind [:ctrl-x :ctrl-u] 'commands/cmd-upcase-region)
    (keymap-bind [:ctrl-x :ctrl-l] 'commands/cmd-downcase-region)
    (keymap-bind [:ctrl-x :ctrl-t] 'commands/cmd-transpose-lines)
    (keymap-bind [:ctrl-x :ctrl-e] 'commands/cmd-eval-last-sexp)
    (keymap-bind [:ctrl-x :ctrl-f] 'commands/cmd-find-file)
    (keymap-bind [:ctrl-x :ctrl-r] 'commands/cmd-recentf) ; recent files
    (keymap-bind [:alt-g "g"] 'commands/cmd-goto-line) ; M-g g
    (keymap-bind [:alt-g :alt-g] 'commands/cmd-goto-line) ; M-g M-g — the Emacs spelling most hands use
    (keymap-bind [:alt-g "c"] 'commands/cmd-goto-char) ; M-g c — jump to a character offset
    (keymap-bind [:alt-g "i"] 'lsp-commands/cmd-imenu) ; M-g i — jump to a symbol (LSP imenu)
    ;; M-g n / M-g p — the compilation error walk (C-x ` is next-error's other Emacs key)
    (keymap-bind [:alt-g "n"] 'compile/cmd-next-error)
    (keymap-bind [:alt-g "p"] 'compile/cmd-previous-error)
    (keymap-bind [(keyword "alt-.")] 'lsp-commands/cmd-goto-definition) ; M-. goto-definition
    (keymap-bind [(keyword "alt-,")] 'lsp-commands/cmd-lsp-pop-marker) ; M-, pop back
    (keymap-bind [(keyword "alt-?")] 'lsp-commands/cmd-find-references) ; M-? find-references
    (keymap-bind [:ctrl-c :ctrl-d] 'lsp-commands/cmd-lsp-hover) ; C-c C-d hover docs
    (keymap-bind [:ctrl-c :ctrl-a] 'lsp-commands/cmd-lsp-code-action) ; C-c C-a the fix-it list
    (keymap-bind [:ctrl-c :ctrl-s] 'lsp-commands/cmd-lsp-signature-help) ; C-c C-s argument hints
    (keymap-bind [:ctrl-c :ctrl-r] 'lsp-commands/cmd-lsp-rename) ; C-c C-r rename
    (keymap-bind [:ctrl-c :ctrl-f] 'lsp-commands/cmd-lsp-format-buffer) ; C-c C-f format buffer
    (keymap-bind [:ctrl-c "!"] 'diagnostics/cmd-diagnostics) ; C-c ! the warning/error list
    ;; C-c g — git about THIS file (magit's file dispatch): diff, log, blame, stage,
    ;; unstage, discard, without opening the status buffer
    (keymap-bind [:ctrl-c "g"] 'git/cmd-git-file-menu)
    ;; C-c ^ — resolve the merge conflict at point, in the file (Emacs's smerge-mode)
    (keymap-bind [:ctrl-c "^" "n"] 'smerge/cmd-smerge-next) ; the next conflict
    (keymap-bind [:ctrl-c "^" "p"] 'smerge/cmd-smerge-prev) ; the previous one
    (keymap-bind [:ctrl-c "^" "u"] 'smerge/cmd-smerge-keep-upper) ; keep what was here
    (keymap-bind [:ctrl-c "^" "l"] 'smerge/cmd-smerge-keep-lower) ; keep what came in
    (keymap-bind [:ctrl-c "^" "a"] 'smerge/cmd-smerge-keep-all) ; keep both
    (keymap-bind [:ctrl-c "^" "b"] 'smerge/cmd-smerge-keep-base) ; keep the base (diff3)
    ;; C-c d — the debug session (src/debugger.blsp; the module loads deferred, so
    ;; these resolve on first use a moment after startup, like C-x g's git)
    (keymap-bind [:ctrl-c "d" "s"] 'debugger/cmd-debug-session) ; toggle the session
    (keymap-bind [:ctrl-c "d" "t"] 'debugger/cmd-debug-trace-fn) ; trace a function
    (keymap-bind [:ctrl-c "d" "b"] 'debugger/cmd-debug-break-fn) ; break on a function
    (keymap-bind [:ctrl-c "d" "u"] 'debugger/cmd-debug-untrace-fn) ; untrace one
    (keymap-bind [:ctrl-c "d" "d"] 'debugger/cmd-debug-buffer) ; the *Debug* queue
    (keymap-bind [:ctrl-c "d" "r"] 'debugger/cmd-debug-resume-all) ; release everything
    ;; C-c t — native test runs (src/testrun.blsp; deferred like the debugger)
    (keymap-bind [:ctrl-c "t" "t"] 'testrun/cmd-test-at-point) ; the test under point
    (keymap-bind [:ctrl-c "t" "f"] 'testrun/cmd-test-file) ; the current test file
    (keymap-bind [:ctrl-c "t" "p"] 'testrun/cmd-test-project) ; the whole suite
    (keymap-bind [:ctrl-c "t" "r"] 'testrun/cmd-test-rerun) ; repeat the last run
    (keymap-bind [:ctrl-c "t" "k"] 'testrun/cmd-test-stop) ; stop a running suite
    ;; C-c t R — replace the warm session. Rare by design: a run already picks up changed
    ;; sources by itself, so this is for what that cannot reach (mix.exs, config/, a dep).
    (keymap-bind [:ctrl-c "t" "R"] 'testrun/cmd-test-restart)
    ;; C-c r — run the project with debug taps (src/apprun.blsp; deferred)
    (keymap-bind [:ctrl-c "r" "r"] 'apprun/cmd-run-project) ; nest run + spy/stats taps
    (keymap-bind [:ctrl-c "r" "k"] 'apprun/cmd-run-stop) ; stop the running app
    (keymap-bind [:ctrl-h "k"] 'commands/cmd-describe-key) ; C-h k describe-key
    (keymap-bind [:ctrl-h "f"] 'commands/cmd-describe-function) ; C-h f describe-function
    (keymap-bind [:ctrl-h "b"] 'help/cmd-describe-bindings) ; C-h b — every key in force, by layer
    (keymap-bind [:ctrl-h "m"] 'help/cmd-describe-mode) ; C-h m — the layers active in this buffer
    (keymap-bind [:ctrl-h "w"] 'help/cmd-where-is) ; C-h w — the keys that run a command
    (keymap-bind [:ctrl-h "a"] 'help/cmd-apropos-command) ; C-h a — commands matching a pattern
    (keymap-bind [:ctrl-h "l"] 'help/cmd-view-lossage) ; C-h l — the keys you last pressed
    (keymap-bind [:ctrl-h "?"] 'help/cmd-help-for-help) ; C-h ? — the help map itself
    (keymap-bind [:ctrl-h :ctrl-h] 'help/cmd-help-for-help) ; C-h C-h — same, Emacs's other spelling
    (keymap-bind [:ctrl-h "t"] 'tutor/cmd-tutorial) ; C-h t — the interactive bedit tutorial (Emacs help-with-tutorial)
    (keymap-bind [:ctrl-h :ctrl-a] 'about/cmd-about) ; C-h C-a — *About bedit* (Emacs about-emacs)
    ;; C-c p p — the Brood playground (a scratch buffer that runs); running it again
    ;; reopens its spy pane, so there is one command rather than two
    (keymap-bind [:ctrl-c "p" "p"] 'playground/cmd-brood-playground)
    ;; the same surface for the other language the editor can run — `e` for Elixir, beside
    ;; `p` for the playground you are already in
    (keymap-bind [:ctrl-c "p" "e"] 'elixir-playground/cmd-elixir-playground)
    ;; what is running in the node the playground evaluates in — `b` for BEAM
    (keymap-bind [:ctrl-c "b" "p"] 'beam/cmd-beam-processes)
    (keymap-bind [:ctrl-c "b" "s"] 'beam/cmd-beam-applications) ; C-c b s — the supervision tree
    (keymap-bind [:ctrl-c "b" "e"] 'beam/cmd-beam-ets) ; C-c b e — the ETS tables
    (keymap-bind [:ctrl-c "b" "a"] 'beam/cmd-beam-attach) ; C-c b a — attach to a running node
    (keymap-bind [:ctrl-c "b" "d"] 'beam/cmd-beam-detach) ; C-c b d — back to bedit's own
    ;; the same pair for the BROOD session: its child is an ordinary Brood runtime, so a
    ;; peer that has called `node/serve-spawns` can be evaluated in exactly as a BEAM node can
    (keymap-bind [:ctrl-c "b" "A"] 'playground/cmd-brood-attach)
    (keymap-bind [:ctrl-c "b" "D"] 'playground/cmd-brood-detach)
    ;; the debugger: watch a function, or stop the node on it
    (keymap-bind [:ctrl-c "b" "t"] 'beam/cmd-beam-trace)
    (keymap-bind [:ctrl-c "b" "B"] 'beam/cmd-beam-break)
    (keymap-bind [:ctrl-x "b"] 'commands/cmd-switch-buffer)
    (keymap-bind [:ctrl-x "k"] 'commands/cmd-kill-buffer)
    (keymap-bind [:ctrl-x "g"] 'git/cmd-git-status) ; C-x g — git status
    (keymap-bind [:ctrl-x "P"] 'packages/cmd-package-list) ; C-x P — the *Packages* browser (install/update/remove bedit plugins)
    (keymap-bind [:ctrl-x "f"] 'collab-commands/cmd-share-follow) ; C-x f — ride a participant's caret (toggle)
    (keymap-bind [:ctrl-x "F"] 'collab-commands/cmd-share-mirror) ; C-x F — mirror their whole view (toggle)
    (keymap-bind [:ctrl-x :alt-g] 'git/cmd-git-dispatch) ; C-x M-g — every git menu, from anywhere (Magit)
    (keymap-bind [:ctrl-x "v" "="] 'gitview/cmd-vc-diff) ; C-x v = — diff current file vs HEAD
    (keymap-bind [:ctrl-x "v" "b"] 'gitview/cmd-git-blame) ; C-x v b — who last touched each line
    (keymap-bind [:ctrl-x "v" "l"] 'gitview/cmd-git-log-file) ; C-x v l — this file's history
    ;; the C-x p project prefix — C-x p f find-file, p switch project, d dired, e shell
    ;; (Emacs), r the project's own REPL (iex -S mix, nest repl, …) under a pty
    (keymap-bind [:ctrl-x "p" "f"] 'commands/cmd-project-find-file)
    (keymap-bind [:ctrl-x "p" "p"] 'commands/cmd-project-switch)
    (keymap-bind [:ctrl-x "p" "d"] 'commands/cmd-project-dired)
    (keymap-bind [:ctrl-x "p" "g"] 'project-search/cmd-project-find-regexp) ; C-x p g — search the project (Emacs)
    (keymap-bind [:ctrl-x "p" "e"] 'bshell/cmd-project-bshell)
    (keymap-bind [:ctrl-x "p" "r"] 'term/cmd-project-repl)
    (keymap-bind [:ctrl-x "p" "t"] 'term/cmd-term)
    (keymap-bind [:ctrl-x "p" "k"] 'commands/cmd-project-kill-buffers) ; C-x p k — close the project
    (keymap-bind [:ctrl-x "u"] 'commands/cmd-undo)
    ;; narrowing — a PER-PANE focus (C-x n n/d/p), C-x n w widens
    (keymap-bind [:ctrl-x "n" "n"] 'commands/cmd-narrow-to-region)
    (keymap-bind [:ctrl-x "n" "d"] 'commands/cmd-narrow-to-defun)
    (keymap-bind [:ctrl-x "n" "p"] 'commands/cmd-narrow-to-paragraph)
    (keymap-bind [:ctrl-x "n" "w"] 'commands/cmd-widen)
    (keymap-bind [:ctrl-x :right] 'commands/cmd-next-buffer)
    (keymap-bind [:ctrl-x :left] 'commands/cmd-previous-buffer)
    ;; panes — Emacs C-x 2/3/0/1/o
    (keymap-bind [:ctrl-x "2"] 'commands/cmd-split-pane-below)
    (keymap-bind [:ctrl-x "3"] 'commands/cmd-split-pane-right)
    (keymap-bind [:ctrl-x "0"] 'commands/cmd-delete-pane)
    (keymap-bind [:ctrl-x "1"] 'commands/cmd-delete-other-panes)
    (keymap-bind [:ctrl-x "o"] 'commands/cmd-other-pane)
    (keymap-bind [:ctrl-x "l"] 'commands/cmd-toggle-line-numbers)
    ;; the per-buffer zoom, Emacs's text-scale-adjust keys: C-x C-= / C-x C-+ bigger,
    ;; C-x C-- smaller, C-x C-0 back to the window's size (Ctrl+wheel is the same step)
    (keymap-bind [:ctrl-x :ctrl-=] 'appearance/cmd-text-scale-increase)
    (keymap-bind [:ctrl-x :ctrl-+] 'appearance/cmd-text-scale-increase)
    (keymap-bind [:ctrl-x :ctrl--] 'appearance/cmd-text-scale-decrease)
    (keymap-bind [:ctrl-x :ctrl-0] 'appearance/cmd-text-scale-reset)
    (keymap-bind [:ctrl-x "w"] 'commands/cmd-buffer-server-start)
    ;; switch keybinding profile live — M-x emacs-mode / vim-mode also do this
    (keymap-bind [:ctrl-x "v" "v"] 'commands/cmd-vim-mode)))

;; The Emacs profile layer: marked `:system` so it never shows as "the mode" (the mode
;; line names the buffer's major mode — brood/text — not the profile).
(def emacs-profile-layer
  {:name 'emacs
   :system true
   :doc "The Emacs keybinding profile — the global map every buffer sits on."
   :keymap keymaps/emacs-keymap})

;; ============================================================================
;; The Vim profile — modal: normal / insert / visual, each a keymap layer.
;; ============================================================================
;; A modal state is ONE keybinding layer on the model (the transitions below swap it).
;; The states are *mutually exclusive*, not stacked: insert mode must NOT keep normal's
;; letter bindings, or `h` in insert mode would move instead of self-inserting. So
;; `vim-set-state` SETS `:layers` to a single layer rather than pushing one on.
;;
;; All bind the SAME `commands/cmd-*` pool as Emacs; the Vim-specific commands are the
;; mode transitions and the grammar engine (`vim/cmd-vim-*`). Bindings here are just
;; the surface — hjkl/w/b/e/0/^/$/gg/G motion, d/c/y operators with counts + text objects
;; (`d2w`, `ciw`, `dd`), x/D/p/u edits, `.` repeat, i/a/o/I/A/O insert entry, v visual,
;; /·? search, `:` as an ex stand-in (opens M-x). The grammar logic lives in `commands`
;; (it reuses the editing/kill-ring command pool); see the "Vim grammar" section there.

;; The motions + counts, shared by normal and visual. Each key routes through the one
;; grammar command (`cmd-vim-motion`, operator- and count-aware; `*vim-motions*` in
;; `commands` maps the key to its buffer op); digits accumulate a count. In visual mode
;; there's no pending operator, so a motion simply moves point and the region (point↔mark)
;; follows. Factored so normal and visual share exactly one motion definition.
(defn vim-with-motions (km)
  "Add the shared Vim motion + count keys to keymap `km`."
  (-> km
    (keymap-bind ["h"] 'vim/cmd-vim-motion)
    (keymap-bind ["l"] 'vim/cmd-vim-motion)
    (keymap-bind ["j"] 'vim/cmd-vim-motion)
    (keymap-bind ["k"] 'vim/cmd-vim-motion)
    (keymap-bind ["w"] 'vim/cmd-vim-motion)
    (keymap-bind ["b"] 'vim/cmd-vim-motion)
    (keymap-bind ["e"] 'vim/cmd-vim-motion)
    (keymap-bind ["^"] 'vim/cmd-vim-motion)
    (keymap-bind ["$"] 'vim/cmd-vim-motion)
    (keymap-bind [:left] 'vim/cmd-vim-motion)
    (keymap-bind [:right] 'vim/cmd-vim-motion)
    (keymap-bind [:up] 'vim/cmd-vim-motion)
    (keymap-bind [:down] 'vim/cmd-vim-motion)
    ;; RET is a motion in normal/visual (vim: down a line) — so it never types, and a
    ;; plain buffer behaves like a mode buffer (whose RET is guarded in the command)
    (keymap-bind [:enter] 'commands/cmd-next-line)
    (keymap-bind ["G"] 'vim/cmd-vim-goto-last-line)
    (keymap-bind ["g" "g"] 'vim/cmd-vim-goto-first-line)
    (keymap-bind ["1"] 'vim/cmd-vim-digit)
    (keymap-bind ["2"] 'vim/cmd-vim-digit)
    (keymap-bind ["3"] 'vim/cmd-vim-digit)
    (keymap-bind ["4"] 'vim/cmd-vim-digit)
    (keymap-bind ["5"] 'vim/cmd-vim-digit)
    (keymap-bind ["6"] 'vim/cmd-vim-digit)
    (keymap-bind ["7"] 'vim/cmd-vim-digit)
    (keymap-bind ["8"] 'vim/cmd-vim-digit)
    (keymap-bind ["9"] 'vim/cmd-vim-digit)
    (keymap-bind ["0"] 'vim/cmd-vim-zero))) ; `0`: count digit mid-count, else BOL motion
;; Normal mode: the shared motions/counts, plus operators (d/c/y wait for a motion or text
;; object; dd/cc/yy = linewise), edits, search, `:` (ex stand-in) and insert/visual entry.
(def vim-normal-keymap
  (-> (vim-with-motions {})
    ;; operators — d/c/y wait for a motion or text object (dd/cc/yy = linewise)
    (keymap-bind ["d"] 'vim/cmd-vim-operator)
    (keymap-bind ["c"] 'vim/cmd-vim-operator)
    (keymap-bind ["y"] 'vim/cmd-vim-operator)
    ;; edits
    (keymap-bind ["x"] 'vim/cmd-vim-delete-char)
    (keymap-bind ["D"] 'commands/cmd-kill-line)
    (keymap-bind ["p"] 'commands/cmd-yank)
    (keymap-bind ["u"] 'commands/cmd-undo)
    (keymap-bind ["."] 'vim/cmd-vim-dot) ; repeat the last change
    ;; search — the modal isearch mini-loop (/ forward, ? backward)
    (keymap-bind ["/"] 'commands/cmd-isearch-forward)
    (keymap-bind ["?"] 'commands/cmd-isearch-backward)
    ;; `:` opens the M-x command prompt — an ex-line stand-in (`:w`→`save`, `:emacs-mode`)
    (keymap-bind [":"] 'commands/cmd-execute-extended-command)
    ;; enter insert / visual (i/a double as text-object prefixes when an operator pends)
    (keymap-bind ["i"] 'vim/cmd-vim-insert)
    (keymap-bind ["I"] 'commands/cmd-vim-insert-bol)
    (keymap-bind ["a"] 'vim/cmd-vim-append)
    (keymap-bind ["A"] 'commands/cmd-vim-append-eol)
    (keymap-bind ["o"] 'commands/cmd-vim-open-below)
    (keymap-bind ["O"] 'commands/cmd-vim-open-above)
    (keymap-bind ["v"] 'commands/cmd-vim-visual)
    ;; Esc clears a half-entered count/operator; back to the Emacs profile via C-x v v
    (keymap-bind [:escape] 'commands/cmd-vim-normal)
    (keymap-bind [:ctrl-x "v" "v"] 'commands/cmd-emacs-mode)))

;; Insert mode: keys self-insert (the dispatch fallback); only the essential editing
;; keys and Esc are bound. NB on a `.blsp` buffer the brood-mode layer still composes
;; on top, so RET there is `cmd-newline-and-indent` and the paredit chords still work.
(def vim-insert-keymap
  (-> {}
    (keymap-bind [:escape] 'commands/cmd-vim-normal)
    (keymap-bind [:enter] 'commands/cmd-newline)
    (keymap-bind [:backspace] 'commands/cmd-delete-backward)
    (keymap-bind [:delete] 'commands/cmd-delete-char)
    (keymap-bind [:tab] 'commands/cmd-indent-or-complete)
    (keymap-bind [:left] 'commands/cmd-backward-char)
    (keymap-bind [:right] 'commands/cmd-forward-char)
    (keymap-bind [:up] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)))

;; Visual mode: the shared motions (extending the point↔mark selection) plus the
;; act-on-region keys (y copy, d/x kill — each returns to normal).
(def vim-visual-keymap
  (-> (vim-with-motions {})
    (keymap-bind [:escape] 'commands/cmd-vim-normal)
    (keymap-bind ["v"] 'commands/cmd-vim-normal)
    (keymap-bind ["y"] 'commands/cmd-vim-visual-yank)
    (keymap-bind ["d"] 'commands/cmd-vim-visual-delete)
    (keymap-bind ["x"] 'commands/cmd-vim-visual-delete)))

(def vim-normal-layer
  {:name 'vim-normal
   :system true
   :doc "Vim normal mode — motions and operators; i/a/o start insert."
   :keymap keymaps/vim-normal-keymap})
(def vim-insert-layer
  {:name 'vim-insert
   :system true
   :doc "Vim insert mode — Esc returns to normal."
   :keymap keymaps/vim-insert-keymap})
(def vim-visual-layer
  {:name 'vim-visual
   :system true
   :doc "Vim visual mode — the selection; d/y act on it."
   :keymap keymaps/vim-visual-keymap})

;; ---- Vim modal state transitions (a state = the one keybinding layer on the model) --

(defn vim-set-state (m state layer-ref)
  "Set Vim's modal `state`: install the single keybinding `layer-ref` on the model
(states are mutually exclusive — see the section note), record `:edit-state` and
`:profile :vim`, and clear any half-entered grammar command (`:vim-pending`). The buffer
keeps point/mark, so a transition never moves text."
  (assoc m :layers (list layer-ref) :edit-state state :profile :vim :vim-pending nil))

(defn vim-to-normal (m)
  "Enter Vim normal mode (motion + operators)."
  (vim-set-state m :normal 'keymaps/vim-normal-layer))

(defn vim-to-insert (m)
  "Enter Vim insert mode (keys self-insert; Esc → normal)."
  (vim-set-state m :insert 'keymaps/vim-insert-layer))

(defn vim-to-visual (m)
  "Enter Vim visual mode (motions extend the point↔mark selection)."
  (vim-set-state m :visual 'keymaps/vim-visual-layer))

;; ============================================================================
;; Profiles registry + the model-scope profile API.
;; ============================================================================
;; A profile maps a name to the layer refs installed on the MODEL scope. It's a data
;; registry — the profile analogue of the layer system's `register-type-layers` /
;; `register-system-layer` — so adding a profile is one `register-profile` call (and the
;; seam by which a future `vim` module could register itself without `keymaps` naming it).

(defonce *profiles* {}) ; profile name -> model-scope keybinding layer refs (register-profile fills it; defonce so a reload keeps profiles other modules registered)
(defn register-profile (name refs)
  "Register keybinding profile `name` as the model-scope layer `refs` it installs. Rebinds
the registry, hot-swapping on the next `ed-set-profile`. Idempotent re-register is fine."
  (def *profiles* (assoc *profiles* name refs)))

(register-profile :emacs (list 'keymaps/emacs-profile-layer))
(register-profile :vim (list 'keymaps/vim-normal-layer)) ; insert/visual are swapped in by vim-to-*
(defn profile-layers (profile)
  "The model-scope keybinding layer refs for `profile` (`:emacs` / `:vim`), or the
emacs set when `profile` is unknown."
  (or (get *profiles* profile) (:emacs *profiles*)))

(defn profile-keymap (profile)
  "The composed keymap `profile` installs on the model scope — the pure, model-free
answer to \"what keys does this profile give you\". Feeds key-accurate help text
(`model/ed-where-is` / `ed-command-keys`) without needing a live editor, so a
tutorial or a describe-mode page can render either profile's keys on demand."
  (editor/layers/scope-keymap (list {:layers (profile-layers profile)})))

(defn ed-set-profile (m profile)
  "Switch the editor's keybinding profile: install `profile`'s base layers on the
MODEL scope (dispatch composes them under the buffer's mode layers, buffer winning —
`input/ed-active-keymap`), record `:profile`, and reset modal state (Vim starts in
`:normal`; Emacs has none). Drops any pushed insert/visual layer by replacing
`:layers` wholesale."
  (assoc m
    :layers (profile-layers profile)
    :profile profile
    :edit-state (if (= profile :vim) :normal nil)
    :vim-pending nil))

(defn ed-ensure-profile (m)
  "Seed the model-scope profile if absent — the Emacs profile by default. The
model-scope analogue of `init-buffer-layers`; dispatch calls it so even a hand-built
model gets a profile lazily."
  (if (nil? (:profile m)) (ed-set-profile m :emacs) m))

;; ---- M-x knows about deferred features -----------------------------------------------
;; `defcommand` registers at module LOAD, so `M-x` only ever offered what happened to be in
;; memory: `M-x git-status` worked because an eager module mentions `git/…` somewhere, and
;; `M-x package-list` did not, for no reason a reader could see. A keymap names its commands
;; by SYMBOL precisely so it can name one whose module is unloaded — so the keymaps are the
;; complete list, and declaring them costs no load.
;;
;; Derived, never maintained: bind a command to a key and `M-x` knows it. `interactive`
;; loads the module on first run and dispatches to the real registration.
(doseq (profile [:emacs :vim])
  (doseq (command (editor/keymap/keymap-commands (profile-keymap profile)))
    (interactive/register-deferred command)))
