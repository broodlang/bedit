(defmodule web
  "Serve the selected pane's buffer over HTTP — a **live** mirror of what you're
editing, viewable in a browser (M-x buffer-server-start, C-x w). The page opens an
`EventSource('/events')` and the editor *pushes* every edit and cursor move down
that stream (Server-Sent Events); a few lines of JavaScript swap the updated region
into the DOM. No polling, no flicker.

Nothing here is a Brood gap: the server stack ships in `std` — `http`
(`serve-loop` / `stream-response` / `router`) and `sse` (`sse/headers` /
`sse/emit`) over `tcp` over green processes. The one real constraint is that a
buffer's rope is **process-local**: a spawned HTTP worker can't read the editor's
live buffer. So the editor pushes plain-data snapshots (`web-snapshot` — strings/
ints, freely copied between processes) and the server only ever renders those.

Three kinds of process back a running server:

  - the **publisher / fan-out hub** (`web-pub-loop`): holds the latest snapshot and
    the set of open SSE connections; `[:put snapshot]` updates and broadcasts a frame,
    `[:subscribe]`/`[:unsubscribe]` manage connections, `[:get]` serves the initial
    page. The bridge across the process-local-rope boundary.
  - the **accept loop** (`web-serve-proc`): owns the listening socket, `serve-loop`s.
  - one **SSE worker** per open browser tab (`web-sse-serve`): the sole writer to
    its own socket — the publisher hands it frames as messages, it writes them out.

The idle beat calls `web-publish!` when an event marked the mirror dirty (`ed-web-dirty?` —
the idle job this module registers at load, debounced so a blink tick or a burst of keys is
one snapshot); the OS-assigned port comes back as a `web-port-event` message, which folds
itself in (a `UiEvent` record)."
  (:use model) ; ed-current-buf / ed-buf-mode-name / ed-mode-service (the mode's :fontify)
  (:use editor/buffer) ; buffer-text / -name / -current-line / -column / -file / -line-count / -region-bounds
  (:use editor/highlight) ; fontify-runs — the shared span+overlay -> [substring face] tiler
  (:use sse) ; sse/headers / sse/emit — server-side event-stream framing
  (:use http)) ; listen / serve-loop / router / stream-response / ok
;; ---- the snapshot (plain data — what crosses the process boundary) ----------

(defn- web-gutter-window (buffer top last-line)
  "A plain-data snapshot of the gutter for just the visible lines `top`..`last-line`:
`{:width w :cells ([text face]…)}` (cells indexed from 0, matching the windowed text),
or nil when the mode offers no gutter. The services are functions (they can't cross to
the worker process), so the gutter is materialised to data here — like `:spans`. Only
the visible cells, so a huge buffer doesn't render every line every publish."
  (let (width-of (ed-mode-service buffer :gutter-width)
        cell (ed-mode-service buffer :gutter-cell)
        width (if (nil? width-of) 0 (width-of buffer)))
    (if (or (= width 0) (nil? cell))
      nil
      {:width width
       :cells (map (range top (inc last-line)) (fn (line) (cell buffer line width)))})))

(defn- web-shift-region (region delta size)
  "The `[lo hi]` selection shifted by `-delta` into window-local coordinates and clamped
to `[0, size]`, or nil when unset or outside the window."
  (if (nil? region)
    nil
    (let ([lo hi] region
          from (- lo delta)
          to (- hi delta))
      (if (or (>= from size) (<= to 0)) nil [(math/max 0 from) (math/min size to)]))))

(sig web-snapshot (model -> any))
(defn web-snapshot (m)
  "A plain-data snapshot of the selected pane's **visible window** for the browser —
only the on-screen lines, never the whole buffer (so a large file doesn't lock the
editor on every publish). Carries name, mode, the windowed `:text`, the cursor as an
absolute `:line` (for the header) plus a window-local `:cur-row` (for the cursor-line
highlight) and `:col`, backing `:file`, total `:lines`, the window-local `:region`
selection, the modeline `:status`, `:spans` — the mode's `:fontify` over the visible
slice (window-local offsets) — and `:gutter`, the visible line-number cells. Plain data
throughout, so it copies cleanly to the publisher."
  (let (buffer (ed-current-buf m)
        rope (buffer-rope buffer)
        line-count (buffer-line-count buffer)
        view-rows (math/max 1 (or (:view-rows m) 40))
        top (math/min (ed-current-top m) (math/max 0 (dec line-count)))
        last-line (math/min (dec line-count) (dec (+ top view-rows)))
        win-start (text/line->char rope top)
        win-end (if (>= (inc last-line) line-count)
                  (buffer-length buffer)
                  (dec (text/line->char rope (inc last-line)))) ; drop the trailing newline
        text (text/slice rope win-start (math/max win-start win-end))
        ;; the buffer mode's syntax lexer, or nil
        fontify (ed-mode-service buffer :fontify))
    {:name (buffer-name buffer)
     :mode (ed-buf-mode-name buffer)
     :text text
     :line (buffer-current-line buffer) ; absolute cursor line (header pos)
     :cur-row (- (buffer-current-line buffer) top) ; window-local row (cursor-line highlight)
     :col (buffer-column buffer)
     :file (buffer-file buffer) ; backing path, or nil
     :lines line-count ; total line count
     :region (web-shift-region (buffer-region-bounds buffer) win-start (count text))
     :status (:status m) ; the modeline status (e.g. "modified")
     :spans (if (nil? fontify) '() (fontify text)) ; window-local [start end face] spans
     :gutter (web-gutter-window buffer top last-line)}))

;; ---- rendering a snapshot to HTML -------------------------------------------

(def *web-css*
  "html{background:#1e1e2e;color:#cdd6f4;font:14px/1.5 ui-monospace,Menlo,Consolas,monospace}
body{margin:0}
header{position:sticky;top:0;background:#181825;padding:.5rem 1rem;border-bottom:1px solid #313244;color:#a6adc8}
header .mode{color:#89b4fa}
header .status{color:#f9e2af}
header .pos{float:right;color:#6c7086}
pre{margin:0;padding:.5rem 1rem;white-space:pre;tab-size:4}
.gutter{color:#6c7086;user-select:none}
.cur-line{background:#2a2b3c;display:inline-block;min-width:100%}
.cursor{display:inline-block;width:0;border-left:2px solid #f38ba8;height:1.2em;vertical-align:text-bottom;animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}")

;; The page script: subscribe to the push stream and swap the live region in on each
;; frame (EventSource reconnects on its own if the connection drops), and capture every
;; keystroke back to POST /input — so the browser is a read-write remote frontend, not
;; just a viewer. Bare modifier presses are skipped; `preventDefault` keeps the browser's
;; own chords (Ctrl-F find, Ctrl-S save, Space scroll) from stealing keys from the editor.
;; Every request carries the page's own `?token=` back (see `web-handler`): the page
;; learned it from the URL it was opened with, which is the only way anything can.
(def *web-js*
  "const q='?token='+encodeURIComponent(new URLSearchParams(location.search).get('token')||'');
const es=new EventSource('/events'+q);es.onmessage=e=>{document.getElementById('app').innerHTML=e.data};
addEventListener('keydown',e=>{const k=e.key;if(k==='Shift'||k==='Control'||k==='Alt'||k==='Meta')return;e.preventDefault();fetch('/input'+q,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({k:k,ctrl:e.ctrlKey,alt:e.altKey,shift:e.shiftKey})});});")

(defn- web-escape (text)
  "HTML-escape the three markup-significant characters in `text`."
  (string/replace (string/replace (string/replace text "&" "&amp;") "<" "&lt;") ">" "&gt;"))

;; ---- faces -> inline CSS (mirror the native view's syntax colours) ----------

;; Named lexer-face colours (highlight.blsp's `:fg` keywords) -> catppuccin hex,
;; so the browser mirror matches the editor's own palette.
(defdyn *web-colors*
  {:dark-grey "#6c7086"
   :grey "#9399b2"
   :green "#a6e3a1"
   :yellow "#f9e2af"
   :magenta "#f5c2e7"
   :blue "#89b4fa"
   :cyan "#94e2d5"
   :red "#f38ba8"
   :white "#cdd6f4"})

(defn- web-face-style (face)
  "Inline CSS for a `display.blsp`-style face map (`{:fg :green :bold true}` …): its
`:fg` mapped through `*web-colors*`, plus `:bold`/`:italic`, and `:reverse` rendered
as a selection background (what the active region carries). \"\" when nothing renders."
  (str (let (color (get *web-colors* (:fg face))) (if (nil? color) "" (str "color:" color ";")))
    (if (:bold face) "font-weight:bold;" "")
    (if (:italic face) "font-style:italic;" "")
    (if (:reverse face) "background:#45475a;" "")))

;; ---- [substring face] runs (from the shared tiler) -> HTML -------------------
;; `highlight/fontify-runs` does the offset/merge/coalesce — the same primitive the
;; native view renders. Web only turns each `[substring face]` run into an inline-
;; styled `<span>`; the region is just one `[lo hi face]` overlay range.

(defn- web-region-ranges (region)
  "The active selection as a `fontify-runs` overlay channel: a single `[lo hi
{:reverse true}]` range, or `()` when nothing is marked."
  (if (nil? region) '() (let ([lo hi] region) (list [lo hi {:reverse true}]))))

(defn- web-span (text class style)
  "Escaped `text` wrapped in a `<span>` carrying the optional `class` and inline `style`
attributes (each omitted when `\"\"`). Returns bare escaped text when neither applies, so
an unstyled, unclassed run adds no markup."
  (let (escaped (web-escape text)
        class-attribute (if (= "" class) "" (str " class=\"" class "\""))
        style-attribute (if (= "" style) "" (str " style=\"" style "\"")))
    (if (and (= "" class) (= "" style))
      escaped
      (str "<span" class-attribute style-attribute ">" escaped "</span>"))))

(defn- web-chunk-html (run)
  "One `[substring face]` run as escaped HTML: a styled `<span>` when the face renders
to CSS, plain escaped text otherwise."
  (let ([text face] run
        style (if (nil? face) "" (web-face-style face)))
    (web-span text "" style)))

(defn- web-run-html (text base spans region)
  "A run of buffer `text` (its first char at offset `base`) as faced HTML: the mode's
`spans` syntax-coloured, the active `region` shaded. The offset/merge/coalesce is
`highlight/fontify-runs`; this only emits each resulting run's `<span>`."
  (string/join (map (fontify-runs text base spans (web-region-ranges region)) web-chunk-html) ""))

(defn- web-gutter-chunk (chunk)
  "One gutter chunk as a non-selectable `<span>`: a `[:bar colour]` git change bar renders a
coloured `▌` (the mirror is a monospace text view — no sub-cell frect), other chunks are
`[text face]`."
  (let ([text face] chunk)
    (if (= text :bar)
      (web-span "▌" "gutter" (str "color:" face))
      (web-span text "gutter" (web-face-style face)))))

(defn- web-gutter-html (gutter idx)
  "The materialised `:gutter` cell for 0-based line `idx` as non-selectable `<span>`(s), or
\"\" when there's no gutter. A cell is one or more `[text face]` chunks (a **file** buffer
carries a diff-hl change bar chunk *and* the dim line number) — normalised via the shared
`model/gutter-cell-chunks`, the same decoder the native view uses, so the two renderers stay in
lock-step. The cell text is already padded, so it tiles fixed-width inside the `<pre>`."
  (if (nil? gutter)
    ""
    (string/join (map (gutter-cell-chunks (nth (:cells gutter) idx)) web-gutter-chunk) "")))

;; `cur-line`/`cur-col` are nil when the buffer has no cursor to draw (a mirror of a buffer
;; that is not selected): `(or int nil)`, or the runtime contract (ADR-380) refuses it.
(sig web-line-html (string int int any any (or int nil) (or int nil) any -> string))
(defn- web-line-html (line base idx spans region cur-line cur-col gutter)
  "One buffer line (first char at offset `base`, line number `idx`) as faced HTML: the
optional `gutter` cell, then the text. The cursor's line is wrapped in `.cur-line` with
a `.cursor` caret spliced in at `cur-col` — splitting the line there so faces and the
region still paint on both sides."
  (str (web-gutter-html gutter idx)
    (if (= idx cur-line)
      ;; `cur-col` is nil exactly when `cur-line` is (no cursor), which this branch already
      ;; excludes; the `or` says so to the checker, which cannot see the two travel together.
      (let (column (math/min (or cur-col 0) (count line))
            before (string/substring line 0 column)
            after (string/substring line column (count line)))
        (str "<span class=\"cur-line\">"
          (web-run-html before base spans region)
          "<span class=\"cursor\"></span>"
          (web-run-html after (+ base column) spans region)
          "</span>"))
      (web-run-html line base spans region))))

(defn- web-lines (lines idx base spans region cur-line cur-col gutter acc)
  "Tail-recursive walk over `lines`, threading each line's buffer start-offset `base`
(+1 per stripped newline) and accumulating its `web-line-html`."
  (if (empty? lines)
    (string/join (reverse acc) "\n")
    (web-lines (rest lines)
      (inc idx)
      (+ base (count (first lines)) 1)
      spans
      region
      cur-line
      cur-col
      gutter
      (cons (web-line-html (first lines) base idx spans region cur-line cur-col gutter) acc))))

(defn- web-lines-html (snapshot)
  "The buffer's lines as faced HTML joined by real newlines (the `<pre>` body): the
optional line-number `:gutter`, the mode's `:spans` syntax-coloured, the active
`:region` shaded, the cursor line marked."
  (web-lines (string/split (:text snapshot) "\n")
    0
    0
    (:spans snapshot)
    (:region snapshot)
    (:cur-row snapshot)
    (:col snapshot)
    (:gutter snapshot)
    '()))

(defn web-render-app (snapshot)
  "The **live region** the browser swaps in on each update: the sticky header
(`name (mode)  line:col`) over a `<pre>` of the text with the cursor line
highlighted and a caret at point. Rendered into the initial page (inside `#app`)
*and* pushed verbatim down the SSE stream. It keeps real newlines (the `<pre>`);
`sse/emit`/`sse/frame` `data:`-prefix every line so they round-trip to the browser."
  (str "<header>"
    (web-escape (:name snapshot))
    " <span class=\"mode\">("
    (web-escape (:mode snapshot))
    ")</span>"
    (let (status (:status snapshot))
      (if (or (nil? status) (= "" status))
        ""
        (str " <span class=\"status\">" (web-escape status) "</span>")))
    "<span class=\"pos\">"
    (inc (:line snapshot))
    ":"
    (:col snapshot)
    " · "
    (:lines snapshot)
    "L</span></header>"
    "<pre>"
    (web-lines-html snapshot)
    "</pre>"))

(defn web-render-page (snapshot)
  "The full HTML document: the CSS, the live region inside `#app`, and the script
that opens an `EventSource` to `/events` and replaces `#app` on every pushed frame.
No meta-refresh — updates arrive over SSE."
  (str "<!doctype html><html><head><meta charset=\"utf-8\">"
    "<title>"
    (web-escape (:name snapshot))
    " — bedit</title>"
    "<style>"
    *web-css*
    "</style></head><body>"
    "<div id=\"app\">"
    (web-render-app snapshot)
    "</div>"
    "<script>"
    *web-js*
    "</script></body></html>"))

;; ---- the publisher / fan-out hub --------------------------------------------

(defn web-pub-loop (snapshot subscribers)
  "The publisher: holds the latest snapshot and `subscribers`, the list of open SSE-worker
pids. `[:put s]` updates the snapshot and broadcasts a `[:frame s]` to every
subscriber; `[:subscribe pid]` adds one (seeding it with the current frame so a new
tab paints immediately); `[:unsubscribe pid]` drops one; `[:get pid]` replies
`[:snap snapshot]` (the initial full-page render); `[:shutdown]` tells every worker to
close, then ends. Workers — never the publisher — write their own sockets, so
frames travel as messages: one writer per socket, no interleaved bytes.

Every subscriber is MONITORED: a worker that crashes (a socket error mid-write) never sends
`[:unsubscribe]`, and its `[:down]` drops it instead."
  (receive
    ([:put fresh] (do
                    (doseq (pid subscribers) (send pid [:frame fresh]))
                    (web-pub-loop fresh subscribers)))
    ([:subscribe pid] (do
                        (monitor pid)
                        (send pid [:frame snapshot])
                        (web-pub-loop snapshot (cons pid subscribers))))
    ([:unsubscribe pid] (web-pub-loop snapshot (seq/reject subscribers (fn (other) (= other pid)))))
    ([:down _ pid _] (web-pub-loop snapshot (seq/reject subscribers (fn (other) (= other pid)))))
    ([:count from] (do (send from [:count (count subscribers)]) (web-pub-loop snapshot subscribers)))
    ([:get pid] (do (send pid [:snap snapshot]) (web-pub-loop snapshot subscribers)))
    ([:shutdown] (doseq (pid subscribers) (send pid [:close])))))

;; ---- one SSE worker per open browser tab ------------------------------------

(def *web-sse-keepalive-ms* 25000)

(defn- web-sse-loop (socket pub)
  "An open SSE connection's pump. Writes each `[:frame snapshot]` the publisher fans out
(this worker is the sole writer to its socket `socket`); drops out on `[:tcp-closed]`
(the browser left) or `[:close]` (the server is shutting down), unsubscribing first;
sends a comment line when idle to hold the connection open.

Rendering is done **outside** the socket-write guard and its failure is treated
differently from a write failure: a *rendering* bug must not masquerade as a dead socket. A throw from
`web-render-app` is **logged and the frame skipped**, keeping the browser subscribed so it
recovers on the next good frame; only a genuine `sse/emit` *write* failure means the socket
is dead — then unsubscribe and end the worker."
  (receive
    ([:frame fresh]
      (let (rendered (try
                       [:html (web-render-app fresh)]
                       (catch e
                         (do
                           (io/puts (str "web: skipped a frame, render failed: " (error-message e)))
                           :render-failed))))
        (cond
          (= rendered :render-failed) (web-sse-loop socket pub) ; render bug: log + skip, stay connected
          ;; a failed emit means the socket is gone — the error is the disconnect signal
          (check-allow :discarded-catch
            (try (do (sse/emit socket (second rendered)) true) (catch _e false)))
            (web-sse-loop socket pub)
          else (send pub [:unsubscribe (self)])))) ; dead socket: the browser is gone
    ([:tcp-closed ^socket] (send pub [:unsubscribe (self)]))
    ([:tcp ^socket _] (web-sse-loop socket pub))
    ([:close] (tcp/close socket))
    (after *web-sse-keepalive-ms*
      ;; a keepalive that cannot be sent is how a vanished browser is detected
      (if (check-allow :discarded-catch
            (try (do (tcp/send socket ": keep\n\n") true) (catch _e false)))
        (web-sse-loop socket pub)
        (send pub [:unsubscribe (self)])))))

(defn- web-sse-serve (socket pub)
  "Serve `/events`: the connection's worker (it already owns `socket` — `stream-response`
has sent the head) subscribes itself to the publisher and pumps frames until the
browser disconnects. Owning `socket`'s reader, its `web-sse-loop` sees `[:tcp-closed]`."
  (send pub [:subscribe (self)])
  (web-sse-loop socket pub))

;; ---- remote input: a browser key event -> the editor's key token ------------
;; The web page is a *frontend*, so it must produce the SAME key-token vocabulary the
;; native GUI frontend does (`crates/lisp/src/gui.rs` `key_message` / `translate_key`).
;; Then a remote key dispatches through the identical keymap as a local one, and nothing
;; in `input`/`commands` needs to know it came over the wire. The page JS ships the raw
;; browser fields (`{:k :ctrl :alt :shift}`); the mapping lives here, in Brood, so the
;; vocabulary is unit-tested (tests/web_input_test.blsp) rather than buried in JavaScript.

(def *web-named-keys*
  ;; browser `KeyboardEvent.key` -> the editor's base named-key token (gui.rs `Named` arms)
  {"Enter" "enter"
   "Escape" "escape"
   "Backspace" "backspace"
   "Tab" "tab"
   "Delete" "delete"
   "Home" "home"
   "End" "end"
   "PageUp" "page-up"
   "PageDown" "page-down"
   "ArrowUp" "up"
   "ArrowDown" "down"
   "ArrowLeft" "left"
   "ArrowRight" "right"})

(defn- web-named-token (base shift)
  "A named key as its token keyword, encoding Shift the way the native frontend does:
`shift-<motion>` on the arrows / Home / End, `back-tab` on Shift+Tab, else the bare name."
  (keyword (cond
             (and shift (includes? ["up" "down" "left" "right" "home" "end"] base))
               (str "shift-" base)
             (and shift (= base "tab")) "back-tab"
             else base)))

(defn- web-chord-char (k ctrl alt shift)
  "The base char of a Ctrl/Alt chord, cased as the native frontend cases it: Ctrl (and
Ctrl+Alt) is case-INsensitive → lower; Meta (Alt) is case-sensitive → upper under Shift,
else lower. Casing is a no-op on punctuation, so shifted glyphs (`>`/`{`/`%`) pass through."
  (cond
    ctrl (string/lower k)
    (and alt shift) (string/upper k)
    alt (string/lower k)
    else k))

(defn web-key->token (k ctrl alt shift)
  "Map a browser key event to the editor's key token: a 1-char string for a plain
printable key (`\"a\"`, `\">\"`, `\" \"`), a `:ctrl-`/`:alt-`/`:ctrl-meta-` keyword for a
chord, or a named-key keyword (`:enter`, `:up`, `:back-tab`). nil for a key we don't
translate (a bare modifier, an F-key) so the caller drops it. Mirrors gui.rs so a web key
dispatches exactly like a local one."
  (let (named (get *web-named-keys* k))
    (cond
      (not (nil? named)) (web-named-token named shift)
      (and (= 1 (count k)) (or ctrl alt))
        (keyword (str (cond (and ctrl alt) "ctrl-meta-" ctrl "ctrl-" else "alt-")
                   (web-chord-char k ctrl alt shift)))
      (= 1 (count k)) k
      else nil)))

(defn- web-handle-input (editor request)
  "POST /input: decode the browser key event from the JSON body, translate it to the
editor's key token, and — when it maps to one — `send` it to the `editor` process. The
ui-run loop polls its mailbox for input (that's how the `web-port-event` already arrives), so a
bare token dispatches through the keymap exactly as a locally-typed key, with no change to
`input`/`commands`. Always replies 204 (the page ignores the body). A malformed body parses
to nil and is ignored — a bad key can never disrupt the editor."
  (let (body (string/bytes-> (or (:body request) #b""))
        event (try
                (json/decode body)
                (catch e
                  (do (log/warn (str "web: ignored a malformed key event: " (error-message e))) nil))))
    (when (map? event)
      ;; json-parse keys objects by keyword (`:k`, not `"k"`) — see std/json.
      (let (token (web-key->token (:k event "") (:ctrl event) (:alt event) (:shift event)))
        (when (not (nil? token)) (send editor token))))
    (response 204 {} "")))

;; ---- the HTTP handler (routes the page + the event stream) ------------------

(defn web-handler (pub editor token)
  "The server's handler: `/` renders the current snapshot as the full page; `/events`
is the long-lived SSE stream the page subscribes to (a `stream-response`, so the socket
stays open and `web-sse-serve` pumps it); `/input` accepts a browser key event (POST)
and forwards it to the `editor` process as a key token — the read-write half that makes
the mirror a real remote frontend. All close over `pub`/`editor`.

Every route is behind std's `loopback-only` and `require-token`. `/input` types into the
editor — M-x, `C-x C-e`, a shell command — and a 127.0.0.1 socket is reachable from every
page the user has open: a cross-site `text/plain` POST needs no preflight, and DNS
rebinding reads `/` and `/events` too. `token` is minted per server and handed out only
in the URL the editor echoes."
  (loopback-only (require-token token
                   (router {"/" (fn (_request)
                                  (send pub [:get (self)])
                                  (receive
                                    ([:snap s] (ok (web-render-page s)))
                                    (after 1000 (text-response "bedit: no snapshot"))))
                            "/events" (fn (_request)
                                        (stream-response 200
                                          (sse/headers)
                                          (fn (socket) (web-sse-serve socket pub))))
                            "/input" (fn (request)
                                       (if (= (:method request) "POST")
                                         (web-handle-input editor request)
                                         (response 405 {} "")))}))))

(defn web-url (server)
  "The address to open a running server `server` at — its bound port and the token every
request must carry — or nil while the port is not yet known."
  (when (:port server) (str "http://localhost:" (:port server) "/?token=" (:token server))))

;; ---- the server process -----------------------------------------------------

(defrecord web-port-event (port)) ; the server's OS-assigned bound port, once listening
(impl UiEvent
  web-port-event
  ;; Record the bound port on `:server` and echo the URL — guarded against a stop
  ;; that raced ahead of the bind.
  (ui-event-fold (e m textrows cols rows)
    (if (:server m)
      (let (m2 (update m :server assoc :port (web-port-event-port e)))
        (message m2 (str "serving selected buffer on " (web-url (:server m2)))))
      m)))

(defn web-serve-proc (port pub reply-to token)
  "The accept loop: bind a listener (falling back to an OS-assigned port if `port`
is taken), tell `reply-to` the bound port (a `web-port-event`), then `serve-loop`
forever. Must own the listener it serves, so the `listen` happens here — not in
the editor process — which is why the port comes back as a message."
  (let (listener (try (listen port) (catch _ (listen 0)))
        bound (tcp/local-port listener))
    (send reply-to (web-port-event bound))
    (serve-loop listener (web-handler pub reply-to token))))

;; ---- lifecycle (called from the commands, in the editor process) ------------

(defn web-start (m port)
  "Spawn the publisher (seeded with the current snapshot, no subscribers yet) and the
accept loop, trying `port` first. Returns `{:pub :proc :port :token}` for the model's
`:server` field; `:port` is nil until the `web-port-event` reply arrives. `(self)` is
captured here (the editor process) so the server can report its bound port back.
`:token` is this server's secret (see `web-handler`); `web-url` puts it in the link."
  (let (me (self)
        token (random-token)
        seed (web-snapshot m)
        pub (spawn (web-pub-loop seed '()))
        proc (spawn (web-serve-proc port pub me token)))
    {:pub pub :proc proc :port nil :token token}))

(defn web-stop! (server)
  "Stop a running server: ask the publisher to close every open SSE connection and
exit (`[:shutdown]`), then kill the accept loop (which drops the listener).
Idempotent — `send`/`exit` no-op on dead pids."
  (when server
    (send (:pub server) [:shutdown])
    (exit (:proc server) :kill))
  nil)

(defn web-publish! (m)
  "If a server is running, push the current snapshot to its publisher; return `m`
unchanged — what the idle beat's [[web-publish-dirty]] calls, so the browser mirrors edits
*and* cursor motion. A failure (a torn-down publisher, or a `web-snapshot` that throws on a
corrupt buffer state) can never disrupt editing — but it is **logged**, not swallowed: a
swallowed snapshot error would freeze the mirror on its last frame with no trace of why. The
log carries the selected buffer's name/line-count/point so the offending state is
diagnosable."
  (let (server (:server m))
    (when server
      (try
        (send (:pub server) [:put (web-snapshot m)])
        (catch e
          ;; Log why the mirror couldn't update — guarded, so a corrupt buffer can't make the
          ;; diagnostic itself throw out of the publish (which must never disrupt editing).
          (io/puts (try
                     (let (buffer (ed-current-buf m))
                       (str "web-publish: mirror update skipped (buffer "
                         (buffer-name buffer)
                         ", lines="
                         (buffer-line-count buffer)
                         ", point="
                         (buffer-point buffer)
                         "): "
                         (error-message e)))
                     (catch _ (str "web-publish: mirror update skipped: " (error-message e))))))))
    m))

(defn ed-web-dirty? (m)
  "True when a web mirror is running (`:server`) and has an unpublished edit/move
(`:web-dirty`) — so the idle beat should push a fresh snapshot. Set on real input by
[[web-mark-dirty]], cleared by the publish ([[web-publish-dirty]])."
  (and (:server m) (:web-dirty m)))

(defn web-mark-dirty (m input)
  "The input step: while a web mirror is running, a real keystroke or click marks the snapshot
dirty, so the idle beat republishes it once (off the hot key path). Timer and system events do
not, so the mirror refreshes only after actual edits and moves."
  (if (and (:server m) (ed-real-input? input)) (assoc m :web-dirty true) m))

(defn web-publish-dirty (m)
  "The idle beat's web-mirror job: push a fresh snapshot iff an edit or move marked the
mirror dirty ([[ed-web-dirty?]]), clearing the mark — so a burst of keys is one snapshot."
  (if (ed-web-dirty? m) (web-publish! (dissoc m :web-dirty)) m))

;; LAST on the beat, so the snapshot shows everything the other jobs changed. Registered at load: the
;; mirror cannot be dirty before `C-x w` has loaded this module and started a server.
(register-idle-job :web-mirror
  {:order 140 :run 'web/web-publish-dirty :stale? 'web/ed-web-dirty?})

;; Before the timers are reconciled, so a real key arms the beat that publishes.
(register-input-step :web-mirror 'web/web-mark-dirty)
