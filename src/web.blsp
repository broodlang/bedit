(defmodule web
  "Serve the selected pane's buffer over HTTP — a **live** mirror of what you're
editing, viewable in a browser (M-x serve-buffer, C-x w). The page opens an
`EventSource('/events')` and the editor *pushes* every edit and cursor move down
that stream (Server-Sent Events); a few lines of JavaScript swap the updated region
into the DOM. No polling, no flicker.

Nothing here is a Brood gap: the server stack ships in `std` — `http`
(`serve-loop` / `stream-response` / `router`) and `sse` (`sse-headers` /
`sse-send`) over `tcp` over green processes. The one real constraint is that a
buffer's rope is **process-local**: a spawned HTTP worker can't read the editor's
live buffer. So the editor pushes plain-data snapshots (`web-snapshot` — strings/
ints, freely copied between processes) and the server only ever renders those.

Three kinds of process back a running server:

  - the **publisher / fan-out hub** (`web-pub-loop`): holds the latest snapshot and
    the set of open SSE connections; `[:put snap]` updates and broadcasts a frame,
    `[:subscribe]`/`[:unsubscribe]` manage connections, `[:get]` serves the initial
    page. The bridge across the process-local-rope boundary.
  - the **accept loop** (`web-serve-proc`): owns the listening socket, `serve-loop`s.
  - one **SSE worker** per open browser tab (`web--sse-serve`): the sole writer to
    its own socket — the publisher hands it frames as messages, it writes them out.

`ed-update` calls `web-publish!` once per event while a server is running (the hook
that makes it live); the OS-assigned port comes back as a `[:web-port n]` message
folded in by the loop's event registry (see `input`)."
  (:use model)  ; ed-current-buf / ed-buf-mode-name / ed-mode-service (the mode's :fontify)
  (:use buffer)  ; buffer-text / -name / -current-line / -column / -file / -line-count / -region-bounds
  (:use highlight)  ; fontify-runs — the shared span+overlay -> [substring face] tiler
  (:use sse)  ; sse-headers / sse-send — server-side event-stream framing
  (:use http))  ; http-listen / serve-loop / router / stream-response / ok

;; ---- the snapshot (plain data — what crosses the process boundary) ----------

(defn web--gutter-snapshot (buf)
  "A plain-data snapshot of the buffer's left gutter: `{:width w :cells ([text face]…)}`
materialised by calling the mode's `:gutter-width` / `:gutter-cell` services for every
line, or nil when the mode offers no gutter. The services are functions (they can't
cross to the worker process), so the gutter content is rendered to data here, in the
editor process — exactly like `:spans`."
  (let (gwfn (ed-mode-service buf :gutter-width)
        cell (ed-mode-service buf :gutter-cell)
        gw (if (nil? gwfn) 0 (gwfn buf)))
    (if (or (= gw 0) (nil? cell))
      nil
      {:width gw
       :cells (map (fn (i) (cell buf i gw)) (range (buffer-line-count buf)))})))

(defn web-snapshot (m)
  "A plain-data snapshot of the selected pane's buffer for the browser: name, mode,
full text, point (0-based `:line` / `:col` — the modeline convention), backing
`:file`, total `:lines`, the `:region` selection `[lo hi]` (or nil), the modeline
`:status`, `:spans` — the buffer mode's syntax-highlight spans (`[start end face]`,
reusing its `:fontify` service; empty when the mode offers none) — and `:gutter`, the
materialised line-number gutter (`web--gutter-snapshot`, nil when the mode offers
none). Plain data throughout (vectors / maps / scalars), so it copies cleanly to the
publisher."
  (let (buf (ed-current-buf m)
        text (buffer-text buf)
        fontify (ed-mode-service buf :fontify))  ; the buffer mode's syntax lexer, or nil
    {:name (buffer-name buf)
     :mode (ed-buf-mode-name buf)
     :text text
     :line (buffer-current-line buf)
     :col (buffer-column buf)
     :file (buffer-file buf)                 ; backing path, or nil
     :lines (buffer-line-count buf)          ; total line count
     :region (buffer-region-bounds buf)      ; [lo hi] selection, or nil
     :status (get m :status)                 ; the modeline status (e.g. "modified")
     :spans (if (nil? fontify) '() (fontify text))  ; [start end face] syntax spans
     :gutter (web--gutter-snapshot buf)}))   ; {:width :cells} line-number gutter, or nil

;; ---- rendering a snapshot to HTML -------------------------------------------

(def *web-css*
  "html{background:#1e1e2e;color:#cdd6f4;font:14px/1.5 ui-monospace,Menlo,Consolas,monospace}
body{margin:0}
header{position:sticky;top:0;background:#181825;padding:.5rem 1rem;border-bottom:1px solid #313244;color:#a6adc8}
header .mode{color:#89b4fa}
header .status{color:#f9e2af}
header .pos{float:right;color:#6c7086}
pre{margin:0;padding:.5rem 1rem;white-space:pre;tab-size:4}
.gutter{color:#6c7086;user-select:none}
.cur-line{background:#2a2b3c;display:inline-block;min-width:100%}
.cursor{display:inline-block;width:0;border-left:2px solid #f38ba8;height:1.2em;vertical-align:text-bottom;animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}")

;; The page script: subscribe to the push stream and swap the live region in on
;; each frame. EventSource reconnects on its own if the connection drops.
(def *web-js*
  "const es=new EventSource('/events');es.onmessage=e=>{document.getElementById('app').innerHTML=e.data};")

(defn web--escape (s)
  "HTML-escape the three markup-significant characters in `s`."
  (replace (replace (replace s "&" "&amp;") "<" "&lt;") ">" "&gt;"))

;; ---- faces -> inline CSS (mirror the native view's syntax colours) ----------

;; Named lexer-face colours (highlight.blsp's `:fg` keywords) -> catppuccin hex,
;; so the browser mirror matches the editor's own palette.
(def *web-colors*
  {:dark-grey "#6c7086" :grey "#9399b2" :green "#a6e3a1" :yellow "#f9e2af"
   :magenta "#f5c2e7" :blue "#89b4fa" :cyan "#94e2d5" :red "#f38ba8"
   :white "#cdd6f4"})

(defn web--face-style (face)
  "Inline CSS for a `display.blsp`-style face map (`{:fg :green :bold true}` …): its
`:fg` mapped through `*web-colors*`, plus `:bold`/`:italic`, and `:reverse` rendered
as a selection background (what the active region carries). \"\" when nothing renders."
  (str
    (let (col (get *web-colors* (get face :fg))) (if (nil? col) "" (str "color:" col ";")))
    (if (get face :bold) "font-weight:bold;" "")
    (if (get face :italic) "font-style:italic;" "")
    (if (get face :reverse) "background:#45475a;" "")))

;; ---- [substring face] runs (from the shared tiler) -> HTML -------------------
;; `highlight/fontify-runs` does the offset/merge/coalesce — the same primitive the
;; native view renders. Web only turns each `[substring face]` run into an inline-
;; styled `<span>`; the region is just one `[lo hi face]` overlay range.

(defn web--region-ranges (region)
  "The active selection as a `fontify-runs` overlay channel: a single `[lo hi
{:reverse true}]` range, or `()` when nothing is marked."
  (if (nil? region) '() (let ([lo hi] region) (list [lo hi {:reverse true}]))))

(defn web--chunk-html (run)
  "One `[substring face]` run as escaped HTML: a styled `<span>` when the face renders
to CSS, plain escaped text otherwise."
  (let ([s f] run
        txt (web--escape s)
        style (if (nil? f) "" (web--face-style f)))
    (if (= "" style) txt (str "<span style=\"" style "\">" txt "</span>"))))

(defn web--run-html (s base spans region)
  "A run of buffer text `s` (its first char at offset `base`) as faced HTML: the mode's
`spans` syntax-coloured, the active `region` shaded. The offset/merge/coalesce is
`highlight/fontify-runs`; this only emits each resulting run's `<span>`."
  (join "" (map web--chunk-html (fontify-runs s base spans (web--region-ranges region)))))

(defn web--gutter-html (gutter idx)
  "The materialised `:gutter` cell for 0-based line `idx` as a non-selectable `<span>`
(its `[text face]` from the snapshot), or \"\" when there's no gutter. The cell text is
already padded to the gutter width, so it tiles fixed-width inside the `<pre>`."
  (if (nil? gutter)
    ""
    (let ([txt face] (nth (get gutter :cells) idx)
          style (web--face-style face))
      (str "<span class=\"gutter\""
        (if (= "" style) "" (str " style=\"" style "\""))
        ">" (web--escape txt) "</span>"))))

(defn web--line-html (line base idx spans region cur-line cur-col gutter)
  "One buffer line (first char at offset `base`, line number `idx`) as faced HTML: the
optional `gutter` cell, then the text. The cursor's line is wrapped in `.cur-line` with
a `.cursor` caret spliced in at `cur-col` — splitting the line there so faces and the
region still paint on both sides."
  (str (web--gutter-html gutter idx)
    (if (= idx cur-line)
      (let (n (min cur-col (string-length line))
            before (substring line 0 n)
            after (substring line n (string-length line)))
        (str "<span class=\"cur-line\">"
          (web--run-html before base spans region)
          "<span class=\"cursor\"></span>"
          (web--run-html after (+ base n) spans region)
          "</span>"))
      (web--run-html line base spans region))))

(defn web--lines (lines idx base spans region cur-line cur-col gutter acc)
  "Tail-recursive walk over `lines`, threading each line's buffer start-offset `base`
(+1 per stripped newline) and accumulating its `web--line-html`."
  (if (empty? lines)
    (join "\n" (reverse acc))
    (web--lines (rest lines) (inc idx) (+ base (string-length (first lines)) 1)
      spans region cur-line cur-col gutter
      (cons (web--line-html (first lines) base idx spans region cur-line cur-col gutter) acc))))

(defn web--lines-html (snap)
  "The buffer's lines as faced HTML joined by real newlines (the `<pre>` body): the
optional line-number `:gutter`, the mode's `:spans` syntax-coloured, the active
`:region` shaded, the cursor line marked."
  (web--lines (string-split (get snap :text) "\n") 0 0
    (get snap :spans) (get snap :region) (get snap :line) (get snap :col)
    (get snap :gutter) '()))

(defn web-render-app (snap)
  "The **live region** the browser swaps in on each update: the sticky header
(`name (mode)  line:col`) over a `<pre>` of the text with the cursor line
highlighted and a caret at point. Rendered into the initial page (inside `#app`)
*and* pushed verbatim down the SSE stream. It keeps real newlines (the `<pre>`);
`sse-send`/`sse-frame` `data:`-prefix every line so they round-trip to the browser."
  (str "<header>" (web--escape (get snap :name))
    " <span class=\"mode\">(" (web--escape (get snap :mode)) ")</span>"
    (let (st (get snap :status))
      (if (or (nil? st) (= "" st)) "" (str " <span class=\"status\">" (web--escape st) "</span>")))
    "<span class=\"pos\">" (inc (get snap :line)) ":" (get snap :col)
    " · " (get snap :lines) "L</span></header>"
    "<pre>" (web--lines-html snap) "</pre>"))

(defn web-render-page (snap)
  "The full HTML document: the CSS, the live region inside `#app`, and the script
that opens an `EventSource` to `/events` and replaces `#app` on every pushed frame.
No meta-refresh — updates arrive over SSE."
  (str "<!doctype html><html><head><meta charset=\"utf-8\">"
    "<title>" (web--escape (get snap :name)) " — myedit</title>"
    "<style>" *web-css* "</style></head><body>"
    "<div id=\"app\">" (web-render-app snap) "</div>"
    "<script>" *web-js* "</script></body></html>"))

;; ---- the publisher / fan-out hub --------------------------------------------

(defn web-pub-loop (snap subs)
  "The publisher: holds the latest snapshot and `subs`, the list of open SSE-worker
pids. `[:put s]` updates the snapshot and broadcasts a `[:frame s]` to every
subscriber; `[:subscribe pid]` adds one (seeding it with the current frame so a new
tab paints immediately); `[:unsubscribe pid]` drops one; `[:get pid]` replies
`[:snap snap]` (the initial full-page render); `[:shutdown]` tells every worker to
close, then ends. Workers — never the publisher — write their own sockets, so
frames travel as messages: one writer per socket, no interleaved bytes."
  (receive
    ([:put s] (do (doseq (pid subs) (send pid [:frame s])) (web-pub-loop s subs)))
    ([:subscribe pid] (do (send pid [:frame snap]) (web-pub-loop snap (cons pid subs))))
    ([:unsubscribe pid] (web-pub-loop snap (remove (fn (p) (= p pid)) subs)))
    ([:get pid] (do (send pid [:snap snap]) (web-pub-loop snap subs)))
    ([:shutdown] (doseq (pid subs) (send pid [:close])))))

;; ---- one SSE worker per open browser tab ------------------------------------

(def *web-sse-keepalive-ms* 25000)

(defn web--sse-loop (c pub)
  "An open SSE connection's pump. Writes each `[:frame snap]` the publisher fans out
(this worker is the sole writer to its socket `c`); drops out on `[:tcp-closed]`
(the browser left) or `[:close]` (the server is shutting down), unsubscribing first;
sends a comment line when idle to hold the connection open. A failed write means a
dead socket — unsubscribe and end the worker."
  (receive
    ([:frame s]
      (if (try (do (sse-send c (web-render-app s)) true) (catch e false))
        (web--sse-loop c pub)
        (send pub [:unsubscribe (self)])))
    ([:tcp-closed ~c] (send pub [:unsubscribe (self)]))
    ([:tcp ~c d] (web--sse-loop c pub))
    ([:close] (tcp-close c))
    (after *web-sse-keepalive-ms*
      (if (try (do (tcp-send c ": keep\n\n") true) (catch e false))
        (web--sse-loop c pub)
        (send pub [:unsubscribe (self)])))))

(defn web--sse-serve (c pub)
  "Serve `/events`: the connection's worker (it already owns `c` — `stream-response`
has sent the head) subscribes itself to the publisher and pumps frames until the
browser disconnects. Owning `c`'s reader, its `web--sse-loop` sees `[:tcp-closed]`."
  (send pub [:subscribe (self)])
  (web--sse-loop c pub))

;; ---- the HTTP handler (routes the page + the event stream) ------------------

(defn web-handler (pub)
  "The server's handler: `/` renders the current snapshot as the full page;
`/events` is the long-lived SSE stream the page subscribes to (a `stream-response`,
so the socket stays open and `web--sse-serve` pumps it). Both close over `pub`."
  (router
    {"/" (fn (req)
           (send pub [:get (self)])
           (receive
             ([:snap s] (ok (web-render-page s)))
             (after 1000 (text-response "myedit: no snapshot"))))
     "/events" (fn (req)
                 (stream-response 200 (sse-headers)
                   (fn (c) (web--sse-serve c pub))))}))

;; ---- the server process -----------------------------------------------------

(defn web-serve-proc (port pub reply-to)
  "The accept loop: bind a listener (falling back to an OS-assigned port if `port`
is taken), tell `reply-to` the bound port (`[:web-port n]`), then `serve-loop`
forever. Must own the listener it serves, so the `http-listen` happens here — not in
the editor process — which is why the port comes back as a message."
  (let (ls (try (http-listen port) (catch e (http-listen 0)))
        bound (tcp-local-port ls))
    (send reply-to [:web-port bound])
    (serve-loop ls (web-handler pub))))

;; ---- lifecycle (called from the commands, in the editor process) ------------

(defn web-start (m port)
  "Spawn the publisher (seeded with the current snapshot, no subscribers yet) and the
accept loop, trying `port` first. Returns `{:pub :proc :port}` for the model's
`:server` field; `:port` is nil until the `[:web-port n]` reply arrives. `(self)` is
captured here (the editor process) so the server can report its bound port back."
  (let (me (self)
        seed (web-snapshot m)
        pub (spawn (web-pub-loop seed '()))
        proc (spawn (web-serve-proc port pub me)))
    {:pub pub :proc proc :port nil}))

(defn web-stop! (srv)
  "Stop a running server: ask the publisher to close every open SSE connection and
exit (`[:shutdown]`), then kill the accept loop (which drops the listener).
Idempotent — `send`/`exit` no-op on dead pids."
  (when srv
    (send (get srv :pub) [:shutdown])
    (exit (get srv :proc) :kill))
  nil)

(defn web-publish! (m)
  "If a server is running, push the current snapshot to its publisher; return `m`
unchanged. The per-event hook `ed-update` calls so the browser mirrors edits *and*
cursor motion live. Send failures (e.g. a torn-down publisher) are swallowed so a
publish can never disrupt editing."
  (let (srv (get m :server))
    (when srv
      (try (send (get srv :pub) [:put (web-snapshot m)]) (catch e nil)))
    m))
