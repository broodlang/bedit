(defmodule gitview
  "The git buffers that SHOW something — a commit, a diff, a log, blame, the refs, a file as
it was — each a section buffer (`sectionbuf`), so they fold and walk the way *git-status*
does and every one of them can be acted on, not just read.

Magit's point: a log is a list of COMMITS, not lines of text,
so RET shows one, `A` cherry-picks the one under point and `r i` rebases from it; a commit
is a list of FILES and HUNKS, so RET on a `+` line goes to the line it became, `a` applies
the hunk to your work tree and `v` reverses it; a diff of your unstaged work can be staged
from where you are reading it.

Every view keeps what it needs to rebuild itself on its buffer (`:section-ctx`: the repo,
the revision, the arguments, and a `:reload`), so `g` re-runs it and a stage from inside it
refreshes it."
  (:use editor/keymap :only [keymap-bind]) ; the mode keymap below
  (:use editor/layers :only [register-type-layers]) ; the buffer type below
  (:use model) ; ed-current-buf / ed-buf-at / ed-set-buf-at / message / ed-apply
  (:use pool) ; ed-display-buffer / ed-pop-to-file
  (:use interactive) ; defcommand
  (:use transient) ; ed-transient-args — a view opened from a menu takes its flags
  (:use editor/buffer) ; buffer-file / buffer-current-line / buffer-name / make-buffer
  (:use editor/buffer-file)
  (:use section) ; section — the trees
  (:use gitcore) ; git-read / git-do / git-resolve-root
  (:use gitsection) ; the section builders, what is at point, the common keymap
  (:use gitpick)) ; git-pick-commit / git-with-ref
;; ---- diffs as sections ----------------------------------------------------------

(def- gv-header-labels
  ;; What happened to a file in a diff, by the first of its header lines that says so, in
  ;; the words the status uses (`git-entry-label`), so `git-label-faces` colours them
  [["new file mode" "new file"]
    ["deleted file mode" "deleted"]
    ["rename from" "renamed"]
    ["copy from" "copied"]
    ["old mode" "mode"]])

(defn- gv-file-label (file)
  "What happened to a file in a diff, from its header lines — Magit's words."
  (let (h (:headers file [])
        hit (seq/find gv-header-labels
              (fn (row) (any? h (fn (l) (string/starts-with? l (first row)))))))
    (if (nil? hit) "modified" (second hit))))

(defn- gv-file-section (f lst paint?)
  "The section for one parsed diff file `f` in list `lst`: its heading (the label, the
path, `old -> new` for a rename), its hunks — painted when `paint?` — or a binary file's
`Binary files …` line."
  (let (old (:old-path f)
        new (:new-path f)
        path (or new old "?")
        orig (if (and old new (not (= old new))) old nil)
        label (gv-file-label f))
    (section :file
      {:path path :orig-path orig :section lst :x (if (= label "new file") "A" "M")}
      (git-file-line label path orig)
      (if (empty? (:hunks f))
        (seq/filter (:headers f []) (fn (l) (string/starts-with? l "Binary files")))
        (vcsproc/vcs-hunk-sections f {:path path :section lst} paint?))
      {:key path})))

(defn gv-file-sections (files lst)
  "The file sections of a parsed diff (`diff/parse-unified`), open by default — a commit is
read file by file. `lst` is the working-tree list the diff is OF (`:unstaged`, `:staged`)
or nil for a diff of history, which is what lets `s` / `u` / `k` act on it the way they
act on the same hunk in *git-status*. The first few thousand lines are painted
(`diffpaint/paint-keys`), the rest keep the plain +/- colours."
  (let (files (into [] files)
        painted (diffpaint/paint-keys (map (range (count files)) (fn (i) [i (nth files i)]))))
    (into []
      (map (range (count files)) (fn (i) (gv-file-section (nth files i) lst (contains? painted i)))))))

(defn- gv-empty (text)
  "A one-line note section, for a view with nothing in it."
  (section :note nil text))

;; ---- showing a view OFF the loop -------------------------------------------------
;; Blame on a long file, `git show` of a large commit, a log of a busy repo: each takes as
;; long as git takes, and parsing and painting what it printed (`diffpaint`) more. So every
;; view runs its git call AND builds its tree in a task — plain data in and out — and the
;; editor never waits on it. Its buffer is shown AT ONCE, Magit-style: a `Loading…` line, or
;; the contents it already has when the reader refreshes the view they are looking at (`g`,
;; `+`), because a flash back to `Loading…` on every refresh is worse than a stale moment.
;; The finished tree is folded into the buffer when the answer lands.
;;
;; One request in flight PER VIEW (a slot each, below): a commit opened from a log that is
;; still loading must not drop the log, but a second blame asked for before the first landed
;; replaces it — the reader has moved on, so the first is cancelled. An answer is folded only
;; into the buffer it was asked for: the buffer carries its request's handle (`:git-view-token`)
;; until the answer lands, so one for a buffer the reader killed, or that a newer request
;; re-pointed, is dropped. C-g cancels every view in flight (only `git` READS run here, with
;; optional locks off, so killing one leaves nothing half-done) and says so in the buffer.
;; Headless takes the same path with the build run inline.

(def- gv-view-slots
  ;; the model field each view parks its in-flight task on
  [:git-revision-proc
    :git-diff-proc :git-log-proc :git-reflog-proc :git-blame-proc :git-refs-proc :git-blob-proc])

(def- gv-loading-text "Loading…\n")

(defn- gv-git (root args)
  "`git args` in `root` for a view: a read (`git-read`), so it writes no index — a view
cancelled mid-run, or one refreshed while you commit, leaves no `index.lock` behind."
  (git-read root args))

(defn- gv-tree-answer (root args tree-of)
  "Run in a view's task: `git args` in `root` as a `gv-launch` answer — the section tree
`(tree-of stdout)` builds from what git printed, or git's no."
  (let (r (gv-git root args))
    (if (= (:exit r) 0) {:tree (tree-of (:stdout r ""))} {:failed r})))

(defn- gv-ctx-of (opts old)
  "The `:section-ctx` a view's buffer carries while it loads: the new request's (so `g` retries
it), else the one it had."
  (if (contains? opts :ctx) (:ctx opts) (and old (:section-ctx old))))

(defn- gv-placeholder? (buf)
  ;; whether `buf` still shows only the `Loading…` placeholder — length first, so a real
  ;; view is never read whole for it
  (and (= (buffer-length buf) (count gv-loading-text))
    (= (buffer-text buf) gv-loading-text)))

(defn- gv-open (m spec token)
  "Show the view's buffer NOW, carrying `token`: a `Loading…` placeholder (read-only, in the
view's type, keeping the folds and the ctx so `g` on it retries), or — a refresh of the view
the reader is in — the contents it has. `[model kept?]`."
  (let (name (:name spec)
        opts (:opts spec {})
        i (ed-buffer-index-by-name m name)
        old (if (nil? i) nil (ed-buf-at m i))
        action (:action opts :here)
        ;; a refresh keeps the contents the reader is looking at — but not a placeholder's:
        ;; `g` pressed before a view landed is a fresh open, or a failed retry would leave
        ;; `Loading…` there for good (gv-note leaves a kept buffer alone)
        kept? (and (not (nil? old))
                (= i (ed-current-index m))
                (= action :here)
                (not (gv-placeholder? old)))
        m1 (if kept? m (ed-display-buffer m name gv-loading-text (:type spec) {:action action}))
        j (ed-buffer-index-by-name! m1 name)
        placed (ed-buf-at m1 j)
        ;; a placeholder is read-only like the view it stands for, whatever its mode
        fresh (if kept?
                placed
                (merge (assoc (set-read-only placed true)
                         :section-ctx (gv-ctx-of opts old)
                         :section-vis (and old (:section-vis old)))
                  (:props spec {}))))
    [(ed-set-buf-at m1 j (assoc fresh :git-view-token token)) kept?]))

(defn- gv-buffer-ours (m pending token)
  "The pool index of `pending`'s buffer when it is still the one request `token` opened, else
nil — killed, or re-pointed by a newer request."
  (let (i (ed-buffer-index-by-name m (:name pending)))
    (if (and i (= (:git-view-token (ed-buf-at m i)) token)) i nil)))

(defn- gv-note (m pending text)
  "Say `text` in `pending`'s placeholder in place of `Loading…` — a failure, a cancel — so no
buffer is left loading forever. The ctx stays, so `g` asks again. A buffer that kept its
contents (a refresh) keeps them; one that is no longer this request's is left alone."
  (let (i (if (:name pending) (gv-buffer-ours m pending (:token pending)) nil))
    (if (or (nil? i) (:kept? pending))
      m
      (let (b (ed-buf-at m i)
            m1 (ed-display-buffer m
                 (:name pending)
                 (str text "\n")
                 (:type pending)
                 {:action (if (= i (ed-current-index m)) :here :none)})
            j (ed-buffer-index-by-name! m1 (:name pending)))
        (ed-set-buf-at m1
          j
          (merge (assoc (set-read-only (ed-buf-at m1 j) true) :section-ctx (:section-ctx b))
            (:props pending {})))))))

(defn- gv-release (m slot reason)
  "Free view `slot`, its buffer saying `reason` (`: replaced by a newer request`) in place of
`Loading…`."
  (let (pending (vcsproc/vcs-job-pending m :git-view-pending slot))
    (vcsproc/vcs-job-forget (gv-note m pending (str (:verb pending) reason)) :git-view-pending slot)))

(defn gv-launch (m spec)
  "Run a view off the loop. `spec`: `:slot` (one of `gv-view-slots`), `:name` / `:type` / `:opts`
of the section buffer it fills (`sectionbuf/sb-show`'s; no `:name` when it is not known until
git answers — the version before this one), `:props` set on the placeholder, `:root`, `:verb`
(what a failure is reported as), and `:build`: `() -> answer`, run in the task —
- `{:tree t}` the view's section tree
- `{:text s :blob {:root :path :rev}}` a file as it was at a revision
- `{:failed result :verb v}` git said no (`:verb` overriding the spec's)

The request in flight on the slot is cancelled; its buffer says so unless this request takes
it over (names the same buffer)."
  (let (slot (:slot spec)
        free (vcsproc/vcs-job-supersede m
               :git-view-pending slot
               (fn (pending) (= (:name pending) (:name spec)))
               (fn (mm s) (gv-release mm s ": replaced by a newer request")))
        handle (vcsproc/vcs-job-handle (:build spec) *git-op-timeout-ms*)
        [opened kept?] (if (:name spec)
                         (gv-open free spec handle)
                         [(message free (str (:verb spec) "…")) false])
        pending {:name (:name spec)
                 :type (:type spec)
                 :opts (:opts spec {})
                 :props (:props spec {})
                 :root (:root spec)
                 :verb (:verb spec)
                 :kept? kept?
                 :token handle
                 :from (ed-current-index m)})
    (vcsproc/vcs-job-register opened
      :git-view-pending slot
      handle
      pending
      (:build spec)
      gv-apply-view)))

(doseq (slot gv-view-slots)
  (register-task-reply slot
    'gitview/gv-apply-view
    nil
    "git"
    {:folds-event? true :cancel-on-quit? true :on-quit 'gitview/gv-quit}))

(defn gv-apply-view (m event)
  "Fold a view's answer — the whole `[:task-done handle answer]` / `[:task-error …]` /
`[:task-timeout …]` event, since the handle says which view it is — into the buffer it was
asked for. One whose buffer has been killed or re-pointed since is dropped; a failure or
timeout is said in the buffer and the echo area."
  (let (handle (nth event 1)
        slot (vcsproc/vcs-job-slot m gv-view-slots handle)
        pending (if (nil? slot) nil (vcsproc/vcs-job-pending m :git-view-pending slot))
        m1 (if (nil? slot) m (vcsproc/vcs-job-forget m :git-view-pending slot)))
    (cond
      (nil? pending) m1
      (and (:name pending) (nil? (gv-buffer-ours m1 pending handle))) m1
      (not (= (first event) :task-done))
        (let (text (str (:verb pending) " failed or timed out"))
          (message (gv-note m1 pending text) text))
      else (gv-land m1 pending (nth event 2)))))

(defn gv-quit (m)
  "C-g's clean-up for the views (`:on-quit`): every view whose task it just cancelled says so
in its buffer, rather than reading `Loading…` for ever."
  (vcsproc/vcs-job-quit m
    :git-view-pending (fn (mm slot) (gv-release mm slot ": cancelled — g to retry"))))

(defn- gv-action (m pending)
  "Where a landing view goes: its buffer in place — selected when the reader is on it, else
quietly where it is shown (`:none`) — or, with no placeholder, where it was asked for, beside
the reader when they have moved on since."
  (let (i (if (:name pending) (ed-buffer-index-by-name m (:name pending)) nil)
        asked (:action (:opts pending) :here))
    (cond
      (not (nil? i)) (if (= i (ed-current-index m)) :here :none)
      (= (ed-current-index m) (:from pending)) asked
      else :display)))

(defn- gv-land (m pending answer)
  "Show a view's finished `answer` (see `gv-launch`)."
  (cond
    (nil? answer)
      (let (text (str (:verb pending) " returned nothing")) (message (gv-note m pending text) text))
    (:failed answer)
      (let (r (:failed answer)
            verb (or (:verb answer) (:verb pending)))
        (vcsproc/vcs-report-cmd (gv-note m
                                  pending
                                  (str verb " failed: " (first (vcsproc/vcs-summary r))))
          verb r))
    (:blob answer) (gv-land-blob m pending (:blob answer) (:text answer))
    else
      (sectionbuf/sb-show (assoc m :git-root (:root pending))
        (:name pending)
        (:tree answer)
        (:type pending)
        (assoc (:opts pending) :action (gv-action m pending)))))

(defn- gv-blob-type (root path)
  "The buffer type `path` (relative to `root`) opens in — its own mode, so an old version is
coloured like the file."
  (editor/layers/buffer-type-for (assoc (make-buffer "" path) :file (path/join root path))))

(defn- gv-land-blob (m pending blob text)
  "Show `text`, `blob`'s file (`{:root :path :rev}`) as it was at its revision: read-only, and
remembering where it came from so the time machine (`C-x v t`) entered from it steps through its file."
  (let (name (gv-blob-name (:path blob) (:rev blob))
        m1 (ed-display-buffer m
             name
             text
             (gv-blob-type (:root blob) (:path blob))
             {:action (gv-action m pending)})
        i (ed-buffer-index-by-name! m1 name))
    (ed-set-buf-at m1 i (assoc (set-read-only (ed-buf-at m1 i) true) :blob blob))))

;; ---- a commit: *git-revision* ----------------------------------------------------

(def- gv-show-format
  ;; What sits above the diff: the full hash, who, when, the refs pointing at it, then the
  ;; raw message. `%B` is the message as written, so its first line is the summary.
  "--format=commit %H%nAuthor: %an <%ae>%nDate:   %ad%nRefs:   %D%n%n%B%n")

(defn gv-parse-show (stdout)
  "Split `git show` output into `{:meta :message :files}`: the header lines, the message
lines, and the diff parsed by `diff/parse-unified` (which skips everything above the first
file)."
  (let (lines (string/split (or stdout "") "\n")
        head (seq/take-while lines (fn (l) (not (string/starts-with? l "diff "))))
        meta (seq/take-while head (fn (l) (not (= l ""))))
        message (drop head (inc (count meta))))
    {:meta (seq/reject meta (fn (l) (= l "Refs:   ")))
     :message (reverse (seq/drop-while (reverse message) string/blank?))
     :files (diff/parse-unified stdout)}))

(defn gv-revision-tree (rev shown)
  "The *git-revision* tree for a parsed `git show` (`gv-parse-show`): the header, the
message with its summary as the heading, then the files."
  (let (msg (:message shown))
    (section :revision
      rev
      nil
      (into [(section :meta nil nil (into [] (:meta shown)) {:separator true})
              (section :message
                rev
                (if (empty? msg) "(no message)" (first msg))
                (into [] (rest msg))
                {:separator true})]
        (let (fs (gv-file-sections (:files shown) nil))
          (if (empty? fs) [(gv-empty "(no changes)")] fs))))))

(defn git-show-revision (m root rev &optional (action :pop))
  "Show commit `rev` of `root` in *git-revision* — its message, then every file and hunk as
sections. A stash is a commit too; `--diff-merges=first-parent` shows it (and any merge) as
the change it made, rather than as a combined diff nobody can read."
  (cond
    (nil? root) (message m "not in a git repository")
    (or (nil? rev) (= rev "")) (message m "no commit here")
    else
      (gv-launch m
        {:slot :git-revision-proc
         :name "*git-revision*"
         :type :git-revision
         :opts {:action action
                :ctx {:root root :rev rev :reload 'gitview/git-revision-reload}
                :line 1
                :vis {}}
         :root root
         :verb (str "git show " rev)
         :build (fn ()
                  (gv-tree-answer root
                    ["show"
                      "--no-color" "--no-ext-diff" "--diff-merges=first-parent" gv-show-format rev]
                    (fn (out) (gv-revision-tree rev (gv-parse-show out)))))})))

(defn git-revision-reload (m)
  "*git-revision*'s `:reload`: show the same commit again."
  (let (c (sectionbuf/sb-ctx m)) (git-show-revision m (:root c) (:rev c) :here)))

(defcommand cmd-git-show-commit
  (m key)
  "Show a commit (d c) — the one at point, or one you pick."
  (git-pick-commit m "Show commit: " (fn (mm c) (git-show-revision mm (git-resolve-root mm) c))))

;; ---- a diff: *git-diff* ---------------------------------------------------------

(defn gv-diff-tree (stdout lst title)
  "The *git-diff* tree for `git diff` output: a title line, then the files."
  (let (fs (gv-file-sections (diff/parse-unified stdout) lst))
    (section :diff
      nil
      nil
      (into [(section :meta nil nil [title] {:separator true})]
        (if (empty? fs) [(gv-empty "(no changes)")] fs)))))

(defn- gv-launch-diff (m root args lst opts)
  "Run `git diff args` in `root` off the loop into *git-diff*, with sectionbuf `opts`."
  (gv-launch m
    {:slot :git-diff-proc
     :name "*git-diff*"
     :type :git-diff
     :opts opts
     :root root
     :verb "git diff"
     :build (fn ()
              (let (full (append ["diff" "--no-color" "--no-ext-diff"] args)
                    r (gv-git root full))
                (if (>= (:exit r) 2)
                  {:failed r}
                  {:tree (gv-diff-tree (:stdout r "") lst (string/join (into ["git"] full) " "))})))}))

(defn git-show-diff (m root args lst &optional (action :pop))
  "Show `git diff args` of `root` in *git-diff*, as files and hunks. `lst` names the
working-tree list it is a diff OF (`:unstaged` / `:staged`, nil for history), so `s` /
`u` / `k` work on it as they do in *git-status*. `+` / `-` widen and narrow the context."
  (if (nil? root)
    (message m "not in a git repository")
    (gv-launch-diff m
      root
      args
      lst
      {:action action
       :ctx {:root root :args args :section lst :reload 'gitview/git-diff-reload}
       :line 1})))

(defn git-diff-reload (m)
  "*git-diff*'s `:reload`: the same diff again, point kept."
  (let (c (sectionbuf/sb-ctx m))
    (gv-launch-diff m (:root c) (:args c) (:section c) {:action :here})))

(defn- gv-diff-args (m extra)
  "The diff menu's flags, then `extra`."
  (append (transient/ed-transient-args m) extra))

(defcommand cmd-git-diff-unstaged
  (m key)
  "Everything not yet staged (d u) — stage from here with `s`."
  (git-show-diff m (git-resolve-root m) (gv-diff-args m []) :unstaged))

(defcommand cmd-git-diff-staged
  (m key)
  "Everything staged, against HEAD (d s) — unstage from here with `u`."
  (git-show-diff m (git-resolve-root m) (gv-diff-args m ["--cached"]) :staged))

(defcommand cmd-git-diff-worktree
  (m key)
  "The work tree against HEAD, staged or not (d w)."
  (git-show-diff m (git-resolve-root m) (gv-diff-args m ["HEAD"]) nil))

(defcommand cmd-git-diff-range
  (m key)
  "A diff between two revisions (d r): `main..feature`, `HEAD~3`, `v1.0...HEAD`."
  (let (args (transient/ed-transient-args m))
    (git-with-range m
      "Diff range: "
      ""
      (fn (mm range) (git-show-diff mm (git-resolve-root mm) (append args [range]) nil)))))

(def- gv-list-diff-args
  ;; What `git diff` needs to show a working-tree list: the index against HEAD for
  ;; `Staged changes`, the work tree against the index for `Unstaged changes`.
  {:staged ["--cached"] :unstaged []})

(defcommand cmd-git-diff
  (m key)
  "The diff of what is at point (d d): a file or hunk in its list, a list's heading its
whole list, a commit its change; elsewhere, everything unstaged."
  (let (root (git-resolve-root m)
        row (git-row-at m)
        heading (if (nil? row) nil (:type row))
        f (git-file-at m)
        section (if (nil? f) nil (:section f))
        commit (git-commit-at-point m)
        args (transient/ed-transient-args m))
    (cond
      (nil? root) (message m "not in a git repository")
      (contains? gv-list-diff-args heading)
        (git-show-diff m root (append args (get gv-list-diff-args heading)) heading)
      (contains? gv-list-diff-args section)
        (git-show-diff m
          root
          (append args (get gv-list-diff-args section) ["--" (:path f)])
          section)
      (= section :untracked)
        (git-show-diff m root ["--no-index" "--" "/dev/null" (:path f)] :untracked)
      (not (nil? commit)) (git-show-revision m root commit)
      else (git-show-diff m root args :unstaged))))

(defcommand cmd-git-diff-file
  (m key)
  "This file's changes against HEAD, in *git-diff* beside it (C-x v =)."
  (let (file (buffer-file (ed-current-buf m))
        root (git-resolve-root m))
    (cond
      (nil? file) (message m "no file to diff")
      (nil? root) (message m "not in a git repository")
      else (git-show-diff m root ["HEAD" "--" file] nil))))

(defn- gv-unified? (arg)
  "Whether diff argument `arg` sets the context (`--unified=N`)."
  (string/starts-with? arg "--unified="))

(defn- gv-context-lines (args)
  "The lines of context diff `args` ask for (`--unified=N`), else git's default of 3."
  (let (given (seq/find args gv-unified?)
        n (if (nil? given) nil (string/->number (string/substring given 10 (count given)))))
    (if (int? n) n 3)))

(defn- gv-context (m delta)
  "Widen or narrow the current diff's context by `delta` lines and show it again."
  (let (c (sectionbuf/sb-ctx m)
        args (:args c [])
        next (math/max 0 (+ (gv-context-lines args) delta)))
    (if (or (nil? c) (nil? (:reload c)) (not (= (buffer-name (ed-current-buf m)) "*git-diff*")))
      (message m "not in a diff")
      (message (git-show-diff m
                 (:root c)
                 (into [(str "--unified=" next)] (seq/reject args gv-unified?))
                 (:section c)
                 :here)
        (str next " lines of context")))))

(defcommand cmd-git-diff-more-context
  (m key)
  "Show more context around each hunk (+)."
  (gv-context m 1))
(defcommand cmd-git-diff-less-context
  (m key)
  "Show less context around each hunk (-)."
  (gv-context m -1))

;; ---- applying a change from history: `a` and `v` --------------------------------

(defn- gv-patch-at (m reverse?)
  "The patch at point as `[label patch]`: the region's lines within one hunk, or the hunk."
  (let (hunk (git-hunk-at m)
        rows (sectionbuf/sb-region-rows m)
        lines (if (nil? rows)
                '()
                (seq/reject (map (seq/filter rows (fn (r) (and r (= (:type r) :hunk)))) :line) nil?)))
    (cond
      (nil? hunk) nil
      (not (empty? lines))
        (let (patch (git-lines-patch hunk lines reverse?)) (if (nil? patch) nil ["lines" patch]))
      else ["hunk" (git-hunk-patch hunk)])))

(defcommand cmd-git-apply
  (m key)
  "Apply what is at point to the work tree (a): a hunk or the region's lines of one — from
a commit, a stash, any diff — or a stash's whole change, or a commit's (without
committing it)."
  (let (row (git-row-at m)
        p (gv-patch-at m false))
    (cond
      (not (nil? p))
        (git-do-hunk (ed-apply m clear-mark) (str "apply " (first p)) (second p) false false)
      (and row (= (:type row) :stash))
        (git-do m "stash apply" ["stash" "apply" (:ref (:value row))])
      (not (nil? (git-commit-at-point m)))
        (git-do m "cherry-pick --no-commit" ["cherry-pick" "--no-commit" (git-commit-at-point m)])
      else (message m "nothing to apply here"))))

(defcommand cmd-git-reverse
  (m key)
  "Reverse what is at point in the work tree (v): a hunk or the region's lines, or a
commit's whole change (a revert, not committed)."
  (let (p (gv-patch-at m true))
    (cond
      (not (nil? p))
        (vcsproc/vcs-confirm m
          (str "Reverse this " (first p) " in the work tree?")
          (fn (mm)
            (git-do-hunk (ed-apply mm clear-mark) (str "reverse " (first p)) (second p) false true)))
      (not (nil? (git-commit-at-point m)))
        (git-do m "revert --no-commit" ["revert" "--no-commit" (git-commit-at-point m)])
      else (message m "nothing to reverse here"))))

;; ---- a log: *git-log* --------------------------------------------------------------

(def *git-log-limit* 256)
;; How many commits a log shows before `+` asks for more. Magit's default is 256 too: enough
;; to be the history you are asking about, few enough to render in a blink.

(defn- gv-log-commit (c)
  "One commit's line in a log, as Magit's: the graph, the hash, the ref labels and the
subject. Who and when are not in the text — they are the mode's right margin
(`gitsection/git-section-margin`), so they stay at the window's edge however long the
subject, and the subject is what the edge cuts."
  (section :commit
    c
    (str (:graph c "") (:hash c) " " (git-refs-text (:refs c)) (:subject c ""))
    []
    {:key (:hash c)}))

(defn gv-log-tree (commits heading)
  "The *git-log* tree: `heading` (`Commits in main`), then a commit section per commit; a
line of graph with no commit on it is a plain line."
  (section :log
    nil
    heading
    (into [] (map commits (fn (c) (if (nil? (:hash c)) (:graph c "") (gv-log-commit c)))))))

(defn- gv-log-revisions (args)
  "The revisions log `args` name — every argument before `--` that is not a flag."
  (seq/reject (seq/take-while args (fn (a) (not (= a "--")))) (fn (a) (string/starts-with? a "-"))))

(defn- gv-log-heading (root args)
  "What a log is OF, as Magit heads one: `Commits in main`, `Commits in origin/x`, or the
refs a `--branches` / `--all` log covers; a file's history names the file."
  (let (revisions (gv-log-revisions args)
        dashes (index-of args "--")
        file (if (>= dashes 0) (nth args (inc dashes) nil) nil)
        refs (cond
               (includes? args "--all") "every ref"
               (and (includes? args "--branches") (includes? args "--remotes")) "every branch"
               (includes? args "--branches") "every local branch"
               (not (empty? revisions)) (string/join revisions " ")
               else (or (git-current-branch root) "HEAD")))
    (str "Commits in " refs (if (nil? file) "" (str " touching " file)))))

(defn- gv-limited? (args)
  "Whether log `args` already cap how many commits it shows (`-n…` / `--max-count…`)."
  (any? args (fn (a) (or (string/starts-with? a "-n") (string/starts-with? a "--max-count")))))

(defn git-show-log (m root args title &optional (limit nil) (action :pop))
  "Show `git log args` of `root` as *git-log* — up to `limit` commits (`*git-log-limit*`),
graph drawn when the args ask for it, the refs decorated in full so each label can be told
for what it is (`gitsection/git-ref-labels`). Point starts on the newest commit."
  (if (nil? root)
    (message m "not in a git repository")
    (let (n (or limit *git-log-limit*))
      (gv-launch m
        {:slot :git-log-proc
         :name "*git-log*"
         :type :git-log
         :opts {:action action
                :line 2
                :vis {}
                :ctx {:root root :args args :title title :limit n :reload 'gitview/git-log-reload}}
         :root root
         :verb title
         :build (fn ()
                  (gv-tree-answer root
                    (append ["log" "--no-color" git-log-format "--decorate=full"]
                      (if (gv-limited? args) [] [(str "-n" n)])
                      args)
                    (fn (out) (gv-log-tree (git-parse-log out) (gv-log-heading root args)))))}))))

(defn git-log-reload (m)
  "*git-log*'s `:reload`: the same log again."
  (let (c (sectionbuf/sb-ctx m)) (git-show-log m (:root c) (:args c) (:title c) (:limit c) :here)))

(defn- gv-log-of (m extra)
  "The log of the refs `extra` names (`--branches`, `--all`), with the log menu's arguments."
  (git-show-log m
    (git-resolve-root m)
    (append (transient/ed-transient-args m) extra)
    (string/join (append ["git log"] extra) " ")))

(defcommand cmd-git-log
  (m key)
  "The log of the current branch (l l), with the log menu's arguments."
  (git-show-log m (git-resolve-root m) (transient/ed-transient-args m) "git log"))

(defcommand cmd-git-log-other
  (m key)
  "The log of a branch or revision you pick (l o)."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Log of: "
      :branches (fn (mm ref) (git-show-log mm (git-resolve-root mm) (append args [ref]) (str "git log " ref))))))

(defcommand cmd-git-log-local
  (m key)
  "The log of every local branch (l L)."
  (gv-log-of m ["--branches"]))

(defcommand cmd-git-log-branches
  (m key)
  "The log of every branch, local and remote (l b)."
  (gv-log-of m ["--branches" "--remotes"]))

(defcommand cmd-git-log-all
  (m key)
  "The log of every ref (l a)."
  (gv-log-of m ["--all"]))

(defcommand cmd-git-log-file
  (m key)
  "The history of the file at point, or of this buffer's file (l f, C-x v l) — following
renames."
  (let (f (git-file-at m)
        root (git-resolve-root m)
        path (or (if f (:path f) nil) (buffer-file (ed-current-buf m))))
    (if (nil? path)
      (message m "no file here to log")
      (git-show-log m
        root
        (append (transient/ed-transient-args m) ["--follow" "--" path])
        (str "git log " path)))))

(defcommand cmd-git-log-more
  (m key)
  "Show twice as many commits (+)."
  (let (c (sectionbuf/sb-ctx m))
    (if (nil? (:limit c))
      (message m "not in a log")
      (git-show-log m (:root c) (:args c) (:title c) (* 2 (:limit c)) :here))))

(defcommand cmd-git-log-show
  (m key)
  "Show the commit at point (RET), selecting it."
  (git-show-revision m (git-resolve-root m) (git-commit-at-point m) :pop))

(defcommand cmd-git-log-peek
  (m key)
  "Show the commit at point beside the log without leaving it (SPC)."
  (git-show-revision m (git-resolve-root m) (git-commit-at-point m) :display))

;; ---- the reflog --------------------------------------------------------------------

(defn- gv-here-or-pop (m name)
  "`:here` when the reader is already in buffer `name` (a refresh), else `:pop`."
  (if (= (buffer-name (ed-current-buf m)) name) :here :pop))

(defcommand cmd-git-reflog
  (m key)
  "Where HEAD has been (l r), newest first, as commits you can show, reset to or pick —
the thing you want after a reset you regret, and the reason a `--hard` is survivable."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (gv-launch m
        {:slot :git-reflog-proc
         :name "*git-reflog*"
         :type :git-log
         :opts {:action (gv-here-or-pop m "*git-reflog*")
                :line 2
                :vis {}
                :ctx {:root root :reload 'gitview/git-reflog-reload}}
         :root root
         :verb "git reflog"
         :build (fn ()
                  (gv-tree-answer root
                    ["reflog" "--no-color" "-n" "100" "--format=%h%x00%gd%x00%gs%x00%an%x00%ar"]
                    (fn (out) (gv-log-tree (git-parse-log out) "Reflog for HEAD"))))}))))

(defn git-reflog-reload (m) "*git-reflog*'s `:reload`." (cmd-git-reflog m nil))

;; ---- blame: *git-blame* -------------------------------------------------------------
;; Who last touched each line, as CHUNKS: a heading per run of lines one commit wrote
;; (hash, author, age, summary) with the lines under it. RET on a heading shows the commit,
;; RET on a line goes to it in the file, `b` blames the version before that commit — how you
;; walk back past a reformat to the change that actually mattered.

(defn- gv-hex40? (s)
  "Whether `s` starts with a 40-character hash then a space — a porcelain group header."
  (and (> (count s) 41)
    (= (string/char-at s 40) " ")
    (not (any? (range 40) (fn (i) (< (index-of "0123456789abcdef" (string/char-at s i)) 0))))))

(defn- gv-blame-step (st line)
  "One line of `git blame --porcelain` folded into the parse: a group header names the
commit (and the final line number) of the lines that follow, a `key value` line describes
that commit, a TAB line is one of the file's lines."
  (cond
    (string/starts-with? line "\t")
      (assoc st
        :entries
          (cons {:hash (:cur st) :final (:final st) :text (string/substring line 1 (count line))}
            (:entries st)))
    (gv-hex40? line)
      (let (parts (string/split line " ")
            final (string/->number (nth parts 2 "0")))
        (assoc st :cur (first parts) :final (if (int? final) final 0)))
    (nil? (:cur st)) st
    else (let ([key value] (git-split-word line)) (map/assoc-in st [:commits (:cur st) key] value))))

(defn- gv-blame-chunk (commits run)
  "The chunk for `run`, consecutive lines from one commit, with what `commits` says of it."
  (let (hash (:hash (first run))
        commit (get commits hash {}))
    {:hash hash
     :author (get commit "author" "")
     :time (get commit "author-time" "")
     :summary (get commit "summary" "")
     :previous (get commit "previous" nil)
     :lines (into [] run)}))

(defn gv-parse-blame (stdout)
  "Parse `git blame --porcelain` into chunks `[{:hash :author :time :summary :previous
:lines [{:final :text}]}]`, a chunk per run of consecutive lines from one commit."
  (let (parsed (fold (string/split (or stdout "") "\n")
                 {:commits {} :cur nil :final 0 :entries '()}
                 gv-blame-step))
    (map (seq/chunk-by (reverse (:entries parsed)) :hash)
      (fn (run) (gv-blame-chunk (:commits parsed) run)))))

(defn- gv-age (epoch)
  "How long ago an epoch-seconds string was, as `3 days ago`."
  (let (t (string/->number (or epoch "")))
    (if (not (int? t)) "" (str (humanize/duration (math/max 0 (- (os/now) (* 1000 t)))) " ago"))))

(defn- gv-blame-section (chunk i)
  "The section for blame `chunk`, the `i`th: a heading of short hash, author, age and
summary, the chunk's lines under it."
  (let (hash (str (:hash chunk))
        short (string/substring hash 0 (math/min 8 (count hash))))
    (section :blame
      {:hash short
       :full (:hash chunk)
       :previous (:previous chunk)
       :first (:final (first (:lines chunk)))}
      (str short " " (:author chunk) " " (gv-age (:time chunk)) "  " (:summary chunk))
      (into [] (map (:lines chunk) :text))
      {:key i})))

(defn gv-blame-tree (chunks)
  "The *git-blame* tree: a section per chunk, its lines as the body."
  (section :blame-file
    nil
    nil
    (into [] (map (range (count chunks)) (fn (i) (gv-blame-section (nth chunks i) i))))))

(defn- gv-blame-row-line (row)
  "The file line a *git-blame* body row shows: its chunk's first line plus its offset."
  (+ (:first (:value row)) (:line row)))

(defn- gv-blame-line-of (line)
  "A `(rows -> 1-based row)` placing point on the body row that shows file `line`, else on
the first row."
  (fn (rows)
    (let (i (seq/index-where rows
              (fn (row)
                (and row
                  (= (:type row) :blame)
                  (not (:heading? row))
                  (= line (gv-blame-row-line row))))))
      (if (< i 0) 1 (inc i)))))

(defn git-show-blame (m root path rev line)
  "Blame `path` (relative to `root`) at `rev` (nil: the work tree) in *git-blame*, point on
the chunk holding `line`."
  (gv-launch m
    {:slot :git-blame-proc
     :name "*git-blame*"
     :type :git-blame
     :opts {:action (gv-here-or-pop m "*git-blame*")
            :vis {}
            :ctx {:root root :path path :rev rev :reload 'gitview/git-blame-reload}
            :line (gv-blame-line-of line)}
     :root root
     :verb "blame"
     :build (fn ()
              (gv-tree-answer root
                (append ["blame" "--porcelain" "-w"] (if rev [rev] []) ["--" path])
                (fn (out) (gv-blame-tree (gv-parse-blame out)))))}))

(defn git-blame-reload (m)
  "*git-blame*'s `:reload`."
  (let (c (sectionbuf/sb-ctx m)) (git-show-blame m (:root c) (:path c) (:rev c) 1)))

(defcommand cmd-git-blame
  (m key)
  "Who last touched each line of this file (C-x v b), as chunks — RET shows a chunk's
commit, `b` blames the version before it."
  (let (buf (ed-current-buf m)
        file (buffer-file buf)
        root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? file) (message m "this buffer is not a file")
      else
        (git-show-blame m
          root
          (projects/project-relative root file)
          nil
          (inc (buffer-current-line buf))))))

(defcommand cmd-git-blame-previous
  (m key)
  "Blame the file as it was just before the chunk at point's commit (b) — past a reformat
or a rename to the change behind it."
  (let (row (sectionbuf/sb-ancestor m :blame)
        c (sectionbuf/sb-ctx m))
    (cond
      (nil? row) (message m "not on a chunk")
      (nil? (:previous (:value row)))
        (message m "this chunk's commit has no parent — it is where the line began")
      else
        (let (parts (string/split (:previous (:value row)) " "))
          (git-show-blame m (:root c) (string/join (rest parts) " ") (first parts) 1)))))

(defcommand cmd-git-blame-visit
  (m key)
  "RET in *git-blame*: on a chunk's heading, show its commit; on a line, go to it in the
file (the work tree's version when blaming the work tree)."
  (let (row (git-row-at m)
        c (sectionbuf/sb-ctx m))
    (cond
      (nil? row) m
      (:heading? row) (git-show-revision m (:root c) (:full (:value row)))
      else
        (pool/ed-pop-to-file m
          (path/join (:root c) (:path c))
          (gv-blame-row-line row)))))

;; ---- the refs: *git-refs* (y) ----------------------------------------------------------

(defn gv-parse-refs (stdout)
  "Parse `git for-each-ref` (our NUL format) into `{:name :full :hash :upstream :head?
:subject}` rows."
  (seq/filter (map (seq/reject (string/split (or stdout "") "\n") empty?)
                (fn (line)
                  (let (p (string/split line (string/int->char 0)))
                    (if (< (count p) 6)
                      nil
                      {:full (str (nth p 0))
                       :name (str (nth p 1))
                       :hash (str (nth p 2))
                       :upstream (str (nth p 3))
                       :head? (= (nth p 4) "*")
                       :subject (str (nth p 5))}))))
    (fn (r) (and r (not (string/ends-with? (:full r) "/HEAD"))))))

(defn- gv-ref-section (r kind width)
  "One ref's line: a star on the checked-out branch, the name padded to `width`, the hash,
the upstream in brackets when it has one, the subject."
  (section :ref
    {:name (:name r) :kind kind :remote? (= kind :remote)}
    (str (if (:head? r) "* " "  ")
      (string/pad-right (str (:name r)) width)
      " "
      (:hash r)
      " "
      (if (= (:upstream r "") "") "" (str "[" (:upstream r) "] "))
      (:subject r))
    []
    {:key (:full r)}))

(defn- gv-refs-group (group width)
  "The section for one `{:title :refs :kind :key}` group, or nil when it has no refs."
  (let (refs (:refs group))
    (if (empty? refs)
      nil
      (section :refs-group
        (:key group)
        (str (:title group) " (" (count refs) ")")
        (into [] (map refs (fn (r) (gv-ref-section r (:kind group) width))))
        {:separator true}))))

(defn- gv-refs-under (refs prefix)
  "The refs whose full name starts with `prefix` (`refs/heads/`, `refs/tags/`)."
  (seq/filter refs (fn (r) (string/starts-with? (str (:full r)) prefix))))

(defn- gv-remote-of (r)
  "The remote a remote-tracking ref belongs to — the first part of `origin/feature`."
  (first (string/split (str (:name r)) "/")))

(defn- gv-refs-groups (refs)
  "The *git-refs* groups in order: local branches, then each remote's (sorted by remote
name), then the tags."
  (let (remote (gv-refs-under refs "refs/remotes/"))
    (append [{:title "Branches" :refs (gv-refs-under refs "refs/heads/") :kind :local :key :local}]
      (map (sort (into [] (into #{} (map remote gv-remote-of))))
        (fn (name)
          {:title (str "Remote " name)
           :refs (seq/filter remote (fn (r) (string/starts-with? (str (:name r)) (str name "/"))))
           :kind :remote
           :key name}))
      [{:title "Tags" :refs (gv-refs-under refs "refs/tags/") :kind :tag :key :tags}])))

(defn gv-refs-tree (refs)
  "The *git-refs* tree: local branches (the checked-out one starred), each remote's, tags."
  (let (width (reduce (cons 8 (map refs (fn (r) (count (str (:name r)))))) math/max))
    (section :refs
      nil
      nil
      (seq/reject (into [] (map (gv-refs-groups refs) (fn (group) (gv-refs-group group width))))
        nil?))))

(def- gv-refs-argv
  ;; Every branch, remote branch and tag, newest first, one NUL-separated row each in the
  ;; shape `gv-parse-refs` reads
  ["for-each-ref"
    "--sort=-committerdate"
    "--format=%(refname)%00%(refname:short)%00%(objectname:short)%00%(upstream:short)%00%(HEAD)%00%(contents:subject)"
    "refs/heads" "refs/remotes" "refs/tags"])

(defcommand cmd-git-refs
  (m key)
  "Every branch, remote branch and tag (y) — RET shows one's log, `b` checks it out, `k`
deletes it."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (gv-launch m
        {:slot :git-refs-proc
         :name "*git-refs*"
         :type :git-refs
         :opts {:action (gv-here-or-pop m "*git-refs*")
                :ctx {:root root :reload 'gitview/git-refs-reload}}
         :root root
         :verb "git for-each-ref"
         :build (fn ()
                  (gv-tree-answer root
                    gv-refs-argv
                    (fn (out) (gv-refs-tree (gv-parse-refs out)))))}))))

(defn git-refs-reload (m) "*git-refs*'s `:reload`." (cmd-git-refs m nil))

(defcommand cmd-git-refs-visit
  (m key)
  "RET in *git-refs*: the log of the ref at point."
  (let (row (git-row-at m))
    (if (and row (= (:type row) :ref))
      (git-show-log m
        (git-resolve-root m)
        [(:name (:value row))]
        (str "git log " (:name (:value row))))
      (sectionbuf/sb-toggle m))))

;; ---- a file as it was: find-file at a revision, and stepping through its history -------

(defn- gv-blob-name (path rev)
  "The buffer name of `path` at `rev` — Magit's `file.~rev~`."
  (str (path/basename path) ".~" rev "~"))

(defn- gv-blob-answer (root path rev)
  "Run in a view's task: `path` at `rev` as a `gv-launch` answer — its text, or git's no."
  (let (r (gv-git root ["show" (str rev ":" path)]))
    (if (not (= (:exit r) 0))
      {:failed r :verb (str "git show " rev ":" path)}
      ;; decoded as a file read is (brood ADR-563): a leading byte-order mark off the text, CRLF
      ;; lines bare, so a revision reads as the file does
      {:text (:text (file-text-decode (:stdout r ""))) :blob {:root root :path path :rev rev}})))

(defn git-show-blob (m root path rev)
  "Open `path` (relative to `root`) as it was at `rev`: read-only, in the file's own mode so
it is coloured like the file, remembering where it came from so the time machine (`C-x v t`,
`C-c g p`) entered from it steps through that file's history."
  (gv-launch m
    {:slot :git-blob-proc
     :name (gv-blob-name path rev)
     :type (gv-blob-type root path)
     :opts {:action :here}
     ;; the placeholder already knows which file it is a version of
     :props {:blob {:root root :path path :rev rev}}
     :root root
     :verb (str "git show " rev ":" path)
     :build (fn () (gv-blob-answer root path rev))}))

(defn- gv-blob-origin (m)
  "`{:root :path :rev}` for the current buffer: a blob buffer's own, or the work-tree file
(rev nil)."
  (let (b (ed-current-buf m))
    (or (:blob b)
      (let (root (git-resolve-root m) file (buffer-file b))
        (if (or (nil? root) (nil? file))
          nil
          {:root root :path (projects/project-relative root file) :rev nil})))))

(defcommand cmd-git-find-file
  (m key)
  "Open this file as it was at a revision you pick (C-c g f)."
  (let (o (gv-blob-origin m))
    (if (nil? o)
      (message m "this buffer is not a file in a git repository")
      (git-with-ref m
        "Find file at revision: "
        :branches (fn (mm rev) (git-show-blob mm (:root o) (:path o) rev))))))

;; ---- the time machine's git side (vcscore's `:file-history` / `:file-at`) --------------
;; The time machine itself (src/timemachine.blsp) names no VCS: it asks the checkout's row
;; for a file's history and for one revision of it, both in its task. These are git's
;; answers — plain data in and out, so they run off the loop as they are.

(def- gv-history-separator (string/int->char 30)) ; between commits (ASCII record separator)
(def- gv-field-separator (string/int->char 31)) ; between a commit's fields (unit separator)

(def- gv-history-format
  ;; full and short hash, author and address, date, age, subject, body — then `--name-only`
  ;; prints the path the file had in that commit, which is how a rename is followed back
  (str "--format="
    "%x1e%H%x1f%h%x1f%an%x1f%ae%x1f%ad%x1f%ar%x1f%s%x1f%b%x1f"))

(defn- gv-history-revision (record)
  "One `gv-history-format` record as a revision, its `:path` nil when git printed none (a
merge `--name-only` lists nothing for)."
  (let (fields (string/split record gv-field-separator))
    (if (< (count fields) 9)
      nil
      {:hash (nth fields 0)
       :short (nth fields 1)
       :author (nth fields 2)
       :email (nth fields 3)
       :date (nth fields 4)
       :age (nth fields 5)
       :subject (nth fields 6)
       :body (string/trim (nth fields 7))
       :path (first (seq/reject (map (string/split (nth fields 8) "\n") string/trim) empty?))})))

(defn gv-parse-file-history (stdout path)
  "`git log --follow --name-only` in `gv-history-format` as revisions, newest first. A
revision git named no path for (a merge) has the path of the one after it — the file's
name does not change in a commit that does not touch it — and the newest falls back to
`path`.

    (count (gitview/gv-parse-file-history \"\" \"f\"))   ;=> 0"
  (let (parsed (seq/keep (seq/reject (string/split (or stdout "") gv-history-separator)
                           string/blank?)
                 gv-history-revision))
    (nth (fold parsed
           [[] path]
           (fn (acc revision)
             (let ([kept newer-path] acc
                   named (or (:path revision) newer-path))
               [(conj kept (assoc revision :path named)) named])))
      0)))

(defn- gv-branch-of (ref)
  "The branch a ref names, `origin/` taken off: `origin/main` is `main`."
  (string/drop-prefix ref "origin/"))

(defn- gv-default-branch (root)
  "The repository's default branch: what `origin/HEAD` points at, else a local `main` or
`master` — nil when there is none of them."
  (let (remote-head (git-output root ["symbolic-ref" "-q" "--short" "refs/remotes/origin/HEAD"]))
    (if (not (= remote-head ""))
      remote-head
      (seq/find ["main" "master"]
        (fn (name)
          (= 0 (:exit (gv-git root ["rev-parse" "-q" "--verify" (str "refs/heads/" name)]))))))))

(defn- gv-branch-base (root)
  "The ref \"what this branch changed\" is measured from: the upstream when it tracks ANOTHER
branch (`git branch -u origin/main`), else the default branch, else — on the default branch
itself — its upstream, so what is not pushed yet. nil when there is nothing to measure from."
  (let (current (git-current-branch root)
        upstream (git-upstream root)
        default (gv-default-branch root)
        other? (fn (ref) (and ref (not (= (gv-branch-of ref) current)))))
    (cond
      (nil? current) nil
      (other? upstream) upstream
      (other? default) default
      else upstream)))

(defn gv-branch-scope (root)
  "`{:base ref :hashes #{full-hash}}`: the commits on HEAD that are not on the branch base
(`gv-branch-base`), since their merge base — what this branch changed. nil without a base."
  (let (base (gv-branch-base root)
        fork (if (nil? base) "" (git-output root ["merge-base" "HEAD" base])))
    (if (= fork "")
      nil
      {:base base :hashes (into #{} (git-lines root ["rev-list" (str fork "..HEAD")]))})))

(defn git-file-history (root path start)
  "The time machine's `:file-history` for git: `{:revisions [...] :branch {:base :hashes}
:start hash}`, the revisions of `path` (relative to `root`) newest first, following renames —
each `{:hash :short :author :email :date :age :subject :body :path}`, `:path` the file's name
in that commit — or `{:failed result}`. `start` (a revision, or nil) names the version the
reader came from (`C-c g f`); `:start` is the commit that gave the file that version, the
newest touching it at or before `start`. Subprocesses: run off the loop."
  (let (r (gv-git root
            ["log"
              "--follow" "--name-only" "--no-color" "--date=format:%Y-%m-%d %H:%M" gv-history-format
              "--" path])
        from (if (nil? start) "" (git-output root ["log" "-1" "--format=%H" start "--" path])))
    (if (not (= (:exit r) 0))
      {:failed r}
      {:revisions (gv-parse-file-history (:stdout r "") path)
       :branch (gv-branch-scope root)
       :start (if (= from "") nil from)})))

(defn git-file-revision (root revision)
  "The time machine's `:file-at` for git: `{:text :diff}` — the file as `revision` (a
`git-file-history` one) has it, and that commit's unified diff of it against its first
parent (a rename shown as one) — or `{:failed result}`. Subprocesses: run off the loop."
  (let (hash (:hash revision)
        path (:path revision)
        shown (gv-git root ["show" (str hash ":" path)]))
    (if (not (= (:exit shown) 0))
      {:failed shown}
      (let (diff (gv-git root
                   ["log"
                     "-1" "-p" "-M" "--follow" "--format=" "--no-color" "--no-ext-diff"
                     "--diff-merges=first-parent" hash "--" path]))
        ;; the revision decoded as a file read is (ADR-563), so a byte-order mark is no change
        {:text (:text (file-text-decode (:stdout shown "")))
         :diff (if (= (:exit diff) 0) (:stdout diff "") "")}))))

;; The git VIEWS (src/gitview.blsp): a commit, a diff, a log, blame, the refs — section
;; buffers with the common keys, plus each one's own.
(def git-revision-keymap (gitsection/git-common-keymap))

(def git-diff-keymap
  (-> (gitsection/git-common-keymap)
    (keymap-bind ["+"] 'gitview/cmd-git-diff-more-context) ; + / - — more or less context
    (keymap-bind ["-"] 'gitview/cmd-git-diff-less-context)))

(def git-log-keymap
  (-> (gitsection/git-common-keymap)
    (keymap-bind [:enter] 'gitview/cmd-git-log-show) ; RET — the commit at point
    (keymap-bind [" "] 'gitview/cmd-git-log-peek) ; SPC — show it beside the log, staying here
    (keymap-bind ["+"] 'gitview/cmd-git-log-more))) ; + — twice as many commits
(def git-blame-keymap
  (-> (gitsection/git-common-keymap)
    (keymap-bind [:enter] 'gitview/cmd-git-blame-visit) ; RET — the chunk's commit, or the line
    (keymap-bind ["b"] 'gitview/cmd-git-blame-previous))) ; b — blame the version before
(def git-refs-keymap
  (-> (gitsection/git-common-keymap)
    (keymap-bind [:enter] 'gitview/cmd-git-refs-visit) ; RET — the log of the ref at point
    (keymap-bind ["k"] 'gitrefs/cmd-git-branch-delete))) ; k — delete the ref at point
(defn- git-view-layer (name doc keymap)
  "A git view's layer: its keymap, the shared section faces and line backgrounds, no
mode-local M-x names."
  {:name name
   :doc doc
   ;; Magit's views are special-mode: C-x C-q flips the flag, the keys stay
   :writable :toggle
   :keymap keymap
   :commands '()
   :section-faces 'gitsection/git-section-faces
   :section-bands 'gitsection/git-section-bands})

(def git-revision-mode-layer
  ;; a diff's code wraps rather than scroll the pane sideways (the tint of a wrapped line
  ;; covers every row of it) and its headings end in `…` — the `:long-lines` setting's
  ;; section kinds; M-x visual-line-mode / toggle-truncate-lines override it per buffer
  (assoc (git-view-layer 'git-revision
           "A commit: RET goes to a line, a applies a hunk, v reverses it."
           gitview/git-revision-keymap)
    :long-lines :wrap))
(def git-diff-mode-layer
  (assoc (git-view-layer 'git-diff
           "A diff: s/u/k as in the status buffer; + / - more or less context."
           gitview/git-diff-keymap)
    :long-lines :wrap))
(def git-log-mode-layer
  ;; the author and age in the right margin, as Magit's log keeps them
  (assoc (git-view-layer 'git-log
           "A log: RET shows a commit, SPC peeks, + shows more; A / V / X / r act on it."
           gitview/git-log-keymap)
    :section-margin 'gitsection/git-section-margin))
(def git-blame-mode-layer
  (git-view-layer 'git-blame
    "Blame: RET shows a chunk's commit or goes to a line; b blames the version before."
    gitview/git-blame-keymap))
(def git-refs-mode-layer
  (git-view-layer 'git-refs
    "Branches and tags: RET logs one, b checks out, k deletes." gitview/git-refs-keymap))

(register-type-layers :git-revision
  (list 'gitview/git-revision-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
(register-type-layers :git-diff
  (list 'gitview/git-diff-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
(register-type-layers :git-log
  (list 'gitview/git-log-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
(register-type-layers :git-blame
  (list 'gitview/git-blame-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
(register-type-layers :git-refs
  (list 'gitview/git-refs-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
