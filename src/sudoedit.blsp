(defmodule sudoedit
  "Editing a file as root — Emacs's TRAMP `/sudo::` method and `sudo-edit` — over brood's
`sudo` (ADR-588), which reads and writes a file through `sudo` and keeps no password.

  - `C-x C-f /sudo::/etc/hosts` opens the file as root ([[ed-sudo-find-file]]); `/sudo:USER@:PATH`
    as another user. Only this machine: a remote host is refused, with the reason.
  - `M-x sudo-edit` reopens the current file as root, its unsaved text kept ([[cmd-sudo-edit]]);
    in a buffer with no file it prompts for one, as Emacs's does.
  - The buffer REMEMBERS it is a sudo buffer (`:sudo`, `:sudo-user`): C-x C-s writes it
    through sudo, in place, keeping the file's owner and mode (it is the buffer's file handler,
    `model/register-file-handler`), and the mode line says `# root` on it ([[sudo-segment]]).
  - A password, when sudo wants one, is read with the masked prompt (`passwd/ed-read-passwd`)
    and handed to sudo for one validation — never kept: sudo's own timestamp lets the next
    open or save go without asking, as a `sudo` in a shell does.
  - Every sudo call runs OFF the loop, one at a time, on `remotejob`'s queue (`:sudo-proc`; a
    password typed or a job launched while another runs waits its turn on `:sudo-waiting`,
    never dropped): an open shows a `Loading…` buffer at once, a save leaves the buffer modified until its write lands, C-g
    stops either, and C-x C-c asks about one still running. C-x C-c and C-x s save the root
    files they were told to after their questions, password and all, and quit (or report)
    when the last has landed ([[ed-sudo-save-all]]).
  - Its auto-save sidecar is PRIVATE (`sidecar/ed-auto-save-path`): the editor's state folder,
    never beside a root-owned file. Auto-revert leaves it alone, as Emacs's leaves a remote file.

Named to dodge std's `sudo`, as formatter dodges `format`."
  (:use statusbar :only []) ; its chip registers at load, after statusbar is there
  (:use editor/buffer) ; buffer-file / buffer-text / replace-region / mark-buffer-saved
  (:use editor/buffer-file) ; buffer-from-file
  (:use model) ; message / ed-buf-at / ed-current-buf / ed-buffer-index-by-file
  (:use pool) ; ed-open-buffer / ed-kill-buffer-at / ed-find-file-prompt / ed-default-dir
  (:use file-save) ; ed-save-buf-at / ed-save-prepare / ed-save-landed
  (:use remotejob :only []) ; the one-job-at-a-time queue sshedit shares (called qualified)
  (:use sidecar) ; ed-recovery-note — the private sidecar's
  (:use autorevert) ; ed-revert-at
  (:use projects) ; file-display-name
  (:use theme) ; *red*
  (:use interactive)) ; defcommand

;; ---- the path: TRAMP's sudo method ------------------------------------------------
;; Read by `sidecar/parse-sudo-path`: a sidecar is named for its TRAMP path, and sidecar
;; stands below this module.

(defn local-host? (host)
  "Whether `host` (a TRAMP path's host part) names THIS machine: empty, `localhost`, or this
machine's name. A remote host would need TRAMP's ssh, which bedit does not have.

    (sudoedit/local-host? \"\")   ;=> true
    (sudoedit/local-host? \"elsewhere.example\")   ;=> false"
  (or (= host "") (= host "localhost") (= host (os/hostname))))

(defn sudo-spec (path &optional (user "root"))
  "The TRAMP path that opens `path` as `user`: `/sudo::PATH` for root.

    (sudoedit/sudo-spec \"/etc/hosts\")   ;=> \"/sudo::/etc/hosts\"
    (sudoedit/sudo-spec \"/srv/a\" \"www\")   ;=> \"/sudo:www@:/srv/a\""
  (if (= user "root") (str "/sudo::" path) (str "/sudo:" user "@:" path)))

;; ---- off the loop: one sudo job at a time -----------------------------------------------
;; Every sudo call is a process that may wait — on the disk, on PAM, on a password check that
;; sleeps two seconds after a wrong one — so none runs on the editor's loop: an open or a save
;; is a JOB on `remotejob`'s queue (`:sudo-proc`, one at a time), folded back by
;; [[ed-apply-sudo]]. The job asks sudo first whether a password is needed (`sudo -n -v`, which
;; never prompts); when one is, the masked prompt opens and the job runs again with it. C-g
;; stops a job in flight ([[ed-sudo-quit]]); C-x C-c names one still running ([[ed-sudo-live]]).

(def *sudo-timeout-ms* 60000)
;; How long one sudo call may take before its task is killed and the job said to have failed:
;; a wedged PAM module must not hold the slot for ever.

(defn- password-prompt (_job)
  ;; sudo asks for the INVOKING user's password, whoever the file is opened as
  (str "[sudo] password for " (or (os/user-name) "you") ": "))

(defn sudo-work (job password)
  "What sudo `job` does, in its task: `{:needs-password true}` when sudo wants a password and
`password` is nil; else `{:bytes …}` for an open (the file's BYTES — nothing lost to a text
decode — nil when it does not exist, or sudo's failure) and `{:written …}` for a save (true,
or the failure).

    (:needs-password (sudoedit/sudo-work {:kind :open :path \"/etc/hosts\" :user \"root\"} nil))   ;~> true when sudo has no cached credential"
  (let (opts {:user (:user job) :password password})
    (if (and (nil? password) (sudo/password-required? {:user (:user job)}))
      {:needs-password true}
      (if (= (:kind job) :save)
        {:written (sudo/write (:path job) (:content job) opts)}
        {:bytes (sudo/read-bytes (:path job) opts)}))))

(defn- job-doing (job)
  (str (case (:kind job) :open "opening " :revert "reverting " "saving ")
    (:path job)
    " as "
    (:user job)))

(def- jobs
  ;; the sudo method on `remotejob`'s queue
  {:name "sudo"
   :prefix "sudo: "
   :proc :sudo-proc
   :job :sudo-job
   :waiting :sudo-waiting
   :loading :sudo-loading
   :target :path
   :same [:kind :path :user]
   :work (fn (job password) (sudo-work job password))
   :fold (fn (m answer) (ed-apply-sudo m answer))
   :timeout-ms *sudo-timeout-ms*
   :doing (fn (job) (job-doing job))
   :prompt (fn (job) (password-prompt job))})

(defn- sudo-launch (m job password)
  ;; `job` run off the loop with `password` (nil: ask sudo whether one is needed)
  (remotejob/launch jobs m job password))

(defn- index-where (m pred)
  ;; the pool index of the first buffer `pred` holds for, or nil
  (let (index (seq/index-where (:buffers m) pred)) (if (< index 0) nil index)))

(defn- plain-buffer-index (m path)
  ;; the buffer visiting `path` plainly — not through sudo — or nil
  (index-where m (fn (buffer) (and (= (buffer-file buffer) path) (not (= true (:sudo buffer)))))))

(defn- drop-placeholder (m path) (remotejob/drop-placeholder jobs m path))

(defn sudo-buffer-index (m path &optional (user nil))
  "The pool index of the buffer editing `path` through sudo — as `user` when one is named, as
anyone otherwise — or nil. A file is one buffer per user it is edited as: `/sudo::/x` and
`/sudo:www@:/x` are two."
  (index-where m
    (fn (buffer)
      (and (= true (:sudo buffer))
        (= (buffer-file buffer) path)
        (or (nil? user) (= user (buffer-sudo-user buffer)))))))

(defn- sudo-failed (m job reason) (remotejob/failed jobs m job reason))

(defn ed-sudo-run-waiting (m)
  "A post-step: the first job on the sudo queue taken up once no sudo command runs — launched,
or its password asked for once the prompt is free too (`remotejob/run-waiting`)."
  (remotejob/run-waiting jobs m))

(register-post-step :sudo-ask {:order 80 :run 'sudoedit/ed-sudo-run-waiting})

;; ---- opening ----------------------------------------------------------------------

(defn sudo-buffer (path user text)
  "A buffer visiting `path` as `user` (root unless named): `text` its contents as read
through sudo — nil for a file that does not exist yet — and `:sudo` set, so a save writes it
through sudo.

    (:sudo (sudoedit/sudo-buffer \"/etc/hosts\" \"root\" \"127.0.0.1 localhost\\n\"))   ;=> true"
  (assoc (if (nil? text) (make-buffer "" (path/basename path) path) (buffer-from-file path text))
    :sudo true
    :sudo-user user))

(defn loading-buffer (path)
  "The buffer an open of `path` as root shows until its text lands: `Loading…`, read-only,
with no file of its own (so no other buffer or frame takes it for the file) — `:sudo-loading`
names the path.

    (:sudo-loading (sudoedit/loading-buffer \"/etc/hosts\"))   ;=> \"/etc/hosts\""
  (file-loading-buffer path (str (path/basename path) " <sudo: loading>") :sudo-loading))

(defn- carry-text (buffer old)
  "`buffer` holding `old`'s unsaved text when `old` is modified — what `sudo-edit` keeps of the
buffer it replaces — at `old`'s point. One edit over the file's text, so the buffer is
modified and C-/ goes back to the file's."
  (if (and old (buffer-modified? old))
    (let (text (buffer-text old))
      (goto-char (replace-region buffer 0 (buffer-length buffer) text)
        (math/min (buffer-point old) (count text))))
    (if old (goto-char buffer (math/min (buffer-point old) (buffer-length buffer))) buffer)))

(defn- sudo-opened (m job text coding)
  "An open's text has landed: the file in a sudo buffer, shown where the `Loading…` one was
selected, which goes — as does a buffer already visiting the file plainly, whose unsaved text
the new one keeps. Then the job's continuation."
  (let (path (:path job)
        user (:user job)
        ;; the PLAIN buffer visiting the file, whose unsaved text the new one keeps
        old-index (plain-buffer-index m path)
        old (when old-index (ed-buf-at m old-index))
        buffer (assoc (charset/with-coding (carry-text (sudo-buffer path user text) old) coding)
                 :name (file-display-name path (:project-root m)))
        opened (ed-open-buffer m buffer)
        without-placeholder (drop-placeholder opened path)
        ;; one buffer per file: the plain one goes, found again (the pool moved)
        plain (plain-buffer-index without-placeholder path)
        replaced (if (nil? plain) without-placeholder (ed-kill-buffer-at without-placeholder plain))
        shown (let (index (sudo-buffer-index replaced path user))
                (if (nil? index) replaced (ed-select replaced index))))
    ((remotejob/then-of job) (message shown
                               (or (ed-recovery-note path user)
                                 (str (if (nil? text) "new file " "opened ") path " as " user))))))

(defn- sudo-open-bytes (m job bytes)
  "An open's bytes have landed: nil (no file yet) or text in any coding (`charset/detect`) opens
as an editable sudo buffer ([[sudo-opened]]); a binary opens as the read-only hex view a plain
find-file gives one (`hexl/ed-open-binary`) — never as text with its undecodable bytes
replaced, which a save would write back over the file. A refusal is said."
  (if (failure? bytes)
    (sudo-failed m job (error-message bytes))
    (let (read (if bytes
                 (charset/detect bytes (editorconfig/declared-charset (:path job)))
                 {:text nil}))
      (if (nil? read)
        (let (shown (hexl/ed-open-binary (drop-placeholder m (:path job))
                      (:path job)
                      (:project-root m)
                      bytes))
          ((remotejob/then-of job) (message shown
                                     (str "opened "
                                       (:path job)
                                       " as hex — not text, so read-only"))))
        (sudo-opened m job (:text read) (:coding read))))))

;; check-allow: `then` is the caller's continuation (`identity`, or recover-session's), whose
;; result the checker cannot see; every caller hands one that answers a model
(check-allow :trusted
  (defn ed-sudo-find-file (m spec &optional (then identity))
    "Open the TRAMP sudo path `spec` (`/sudo::/etc/hosts`): the file as root (or the user it
names), OFF the loop — a `Loading…` buffer shown at once, the file's text when sudo answers,
the password asked for first when sudo wants one — then `(then m)` on the model with it open.
A buffer already visiting the file as root is selected; one visiting it plainly is replaced
([[sudo-opened]]). A remote host, or a spec that is not one, is said."
    (let (parts (parse-sudo-path spec))
      (cond
        (nil? parts) (message m (str "not a sudo path: " spec " (/sudo::PATH)"))
        (not (local-host? (:host parts)))
          (message m
            (str "sudo: only this machine (/sudo::PATH) — " (:host parts) " would need ssh"))
        (string/blank? (:path parts)) (message m "sudo: which file? (/sudo::PATH)")
        (:sudo-proc m) (message m "sudo: another sudo command is still running")
        else
          (let (path (path/normalize (path/absolute (:path parts)))
                user (:user parts)
                index (sudo-buffer-index m path user))
            (if index
              (then (ed-select m index))
              (sudo-launch (ed-open-buffer m (loading-buffer path))
                {:kind :open :path path :user user :then then}
                nil)))))))
(sig ed-sudo-find-file (model string &optional any -> model))

;; ---- saving -----------------------------------------------------------------------

(defn- sudo-saved (m job)
  "A save's write has landed: its buffer marked saved as of the text written
(`file-save/ed-save-landed` — still modified if it was edited meanwhile), then the continuation."
  (let (index (sudo-buffer-index m (:path job) (:user job))
        saved (if (nil? index)
                (message m (str "saved " (:path job) " as " (:user job)))
                (ed-save-landed m index (:rope job) (str " as " (:user job)))))
    ((remotejob/then-of job) saved)))

;; check-allow: `then` is a continuation (the quit's, C-x s's), whose result the checker cannot
;; see; every caller hands one that answers a model
(check-allow :trusted
  (defn ed-sudo-save (m i &optional (then nil) (abandon-note nil))
    "Save pool buffer `i`, a sudo buffer, through sudo OFF the loop — the password asked for
first when sudo wants one (`remotejob/save`). It stays modified until the write lands, and a
write that fails leaves it so and says why. `then` runs on the model once the write has landed
(the quit continues there); `abandon-note` follows the reason when it does not
(\" — quit canceled\")."
    (remotejob/save jobs
      m
      i
      then
      abandon-note
      (fn (prepared buffer) {:path (buffer-file prepared) :user (buffer-sudo-user buffer)}))))
(sig ed-sudo-save (model int &optional any any -> model))

;; check-allow: as above — `then` is the caller's
(check-allow :trusted
  (defn ed-sudo-save-all (m paths then &optional (abandon-note nil))
    "Save every sudo buffer in `paths` (`[file user]` pairs) in turn — one sudo job at a time, each
asking for the password when sudo wants one — then `(then m)`. One that fails, or whose prompt
or task is cancelled, stops the run there, saying why with `abandon-note`: what C-x C-c and
C-x s do with the sudo buffers they were told to save."
    (remotejob/save-all m
      paths
      then
      abandon-note
      (fn (mm entry) (sudo-buffer-index mm (first entry) (second entry)))
      ed-sudo-save)))
(sig ed-sudo-save-all (model seqable any &optional any -> model))

;; ---- the job's fold, its C-g, its exit question --------------------------------------

(defn- sudo-reverted (m job bytes)
  "A revert's bytes have landed ([[ed-sudo-revert]]): the buffer holds the file as it is, read
in the job's `:coding`, one undoable edit, or the hex view for `:hex`. Another file or a refusal
is said, the buffer left as it was."
  (let (i (sudo-buffer-index m (:path job) (:user job))
        coding (:coding job)
        text (when (and (bytes? bytes) (not (= coding :hex)))
               (charset/decode bytes (or coding :utf-8))))
    (cond
      (nil? i) m
      (failure? bytes) (sudo-failed m job (str "revert failed: " (error-message bytes)))
      (not (bytes? bytes)) (sudo-failed m job (str (:path job) " is gone"))
      (= coding :hex) (ed-show-as-hex m i bytes)
      (nil? text) (message m (str (:path job) " is not " (charset/label coding)))
      else
        (message (ed-revert-at (ed-set-buf-at m i (charset/with-coding (ed-buf-at m i) coding))
                   i text)
          (str "reverted " (:path job))))))

(defn ed-sudo-revert (m i coding)
  "Read pool buffer `i`, a sudo buffer, again through sudo, OFF the loop: the file in `coding`
(nil for the one it has, `:hex` for the hex view) replaces its text, one undoable edit. What
M-x revert-buffer and C-x RET r do for a file only root can read."
  (let (buffer (ed-buf-at m i))
    (sudo-launch m
      {:kind :revert
       :path (buffer-file buffer)
       :user (buffer-sudo-user buffer)
       :coding (or coding (:coding buffer))}
      nil)))

(defn- sudo-answer (m job answer)
  ;; a landed job's answer read the sudo way (`remotejob/landed` took the common cases)
  (cond
    (:needs-password answer) (remotejob/ask jobs m job)
    (= (:kind job) :open) (sudo-open-bytes m job (:bytes answer))
    (= (:kind job) :revert) (sudo-reverted m job (:bytes answer))
    (failure? (:written answer))
      (sudo-failed m job (str "save failed: " (error-message (:written answer))))
    else (sudo-saved m job)))

(defn ed-apply-sudo (m answer)
  "Fold a finished sudo job's `answer` ([[sudo-work]]; nil when its task failed or timed
out): ask for the password it needs, open the file, mark the save landed — or say why not."
  (remotejob/landed jobs m answer sudo-answer))

(defn ed-sudo-quit (m)
  "C-g's clean-up for a sudo job (its task already killed): an open's `Loading…` buffer goes,
a save's buffer stays modified, and C-g says what stopped."
  (remotejob/quit jobs m))

(defn ed-sudo-live (m)
  "The sudo jobs C-x C-c would stop (`model/register-exit-query`): the one running, and those
waiting their turn."
  (remotejob/live jobs m))

(register-task-reply :sudo-proc
  'sudoedit/ed-apply-sudo
  nil
  "sudo"
  {:cancel-on-quit? true :on-quit 'sudoedit/ed-sudo-quit})
(register-exit-query :sudo 'sudoedit/ed-sudo-live)

;; ---- the command ------------------------------------------------------------------

(defcommand cmd-sudo-edit
  (m key)
  "Reopen the current file as root (Emacs `sudo-edit`): read through sudo — the password
asked for when sudo wants one, and never kept — its unsaved text carried over, and saved
through sudo from then on. In a buffer with no file, prompt for one, starting at `/sudo::`
and the buffer's directory. A buffer already edited as root says so."
  (let (buffer (ed-current-buf m)
        path (buffer-file buffer))
    (cond
      (= true (:sudo buffer))
        (message m (str (buffer-name buffer) " is already edited as " (buffer-sudo-user buffer)))
      (nil? path)
        (assoc m :minibuffer (ed-find-file-prompt (sudo-spec (ed-default-dir-input m)) []))
      else (ed-sudo-find-file m (sudo-spec path)))))

;; ---- the file handler --------------------------------------------------------------

(defn sudo-path-file (spec)
  "The file a TRAMP sudo path names, after the method's second colon, so a file opened as root
is asked about by its size as a plain one is.

    (sudoedit/sudo-path-file \"/sudo::/etc/hosts\")   ;=> \"/etc/hosts\"
    (sudoedit/sudo-path-file \"/sudo:www@:/srv/a\")   ;=> \"/srv/a\""
  (or (:path (parse-sudo-path spec)) spec))

(sig ed-sudo-write-file (model string -> model))
(defn ed-sudo-write-file (m spec)
  "C-x C-w to a TRAMP sudo path (`/sudo::/etc/motd`): the buffer becomes a sudo buffer backed by
that file and is saved through sudo, the password asked for when sudo wants one."
  (let (parts (parse-sudo-path spec))
    (if (or (nil? parts) (not (local-host? (:host parts))) (string/blank? (:path parts)))
      (message m (str "write failed: not a sudo path on this machine: " spec " (/sudo::PATH)"))
      (let (path (path/normalize (path/absolute (:path parts)))
            old (ed-current-buf m)
            old-key (hosted/hosted-key old)
            retargeted (assoc old
                         :file path
                         :sudo true
                         :sudo-user (:user parts)
                         :name (file-display-name path (ed-project-root m)))
            index (ed-current-index m)
            rekeyed (hosted/hosted-rekey-slot (dissoc (ed-set-buf m retargeted) :status)
                      index old-key))
        (do (ed-forget-auto-save old) (ed-save-buf-at rekeyed index))))))

(defn sudo-later-entry (buffer)
  "What a quit keeps of sudo `buffer` to save it after the questions: `[file user]`, for
[[ed-sudo-save-all]]."
  [(buffer-file buffer) (buffer-sudo-user buffer)])

(register-file-handler :sudo
  {:order 10
   :prefix "/sudo:"
   :mark :sudo
   :buffer-keys [:sudo :sudo-user]
   :denied-hint " — M-x sudo-edit to save it as root"
   :file-of 'sudoedit/sudo-path-file
   :find-file 'sudoedit/ed-sudo-find-file
   :write-file 'sudoedit/ed-sudo-write-file
   :save 'sudoedit/ed-sudo-save
   :revert 'sudoedit/ed-sudo-revert
   :later-entry 'sudoedit/sudo-later-entry
   :save-all 'sudoedit/ed-sudo-save-all})

;; ---- a kill ------------------------------------------------------------------------

(defn ed-sudo-cancel-killed (m killed)
  "`m` with the open behind a killed `Loading…` buffer cancelled: its task stopped, so no
buffer appears after all. Any other kill leaves it as it is."
  (remotejob/cancel-killed jobs m killed))

(register-slot-keeper :sudo-open {:order 25 :drop 'sudoedit/ed-sudo-cancel-killed})

;; ---- the mode line ----------------------------------------------------------------

(defn sudo-segment (m pane buffer)
  "The `# root` chip on a sudo buffer's mode line — Emacs shows the TRAMP prefix there — red,
as a reminder that a save writes as root; nil on any other buffer."
  (when (= true (:sudo buffer))
    (statusbar/seg :sudo
      (str "# " (buffer-sudo-user buffer))
      {:sep "  —  "
       :face {:fg *red* :bold true}
       :tooltip (fn (_mm)
                  [(str "editing " (buffer-file buffer) " as " (buffer-sudo-user buffer))
                    "C-x C-s writes it through sudo; the password is never kept"])})))

(statusbar/register-modeline-segment :sudo 30 'sudoedit/sudo-segment)
