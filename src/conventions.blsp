(defmodule conventions
  "The layout CONVENTIONS a buffer is edited with — indent width, tab width, tabs or spaces
(Emacs `indent-tabs-mode`), fill column — resolved per buffer, and what a save does for a
file whose `.editorconfig` asks (trailing whitespace, the final newline).

Each value is the first of, most specific first:

  1. the buffer's own (`:conventions` on the buffer — M-x set-fill-column)
  2. the file's `.editorconfig` (`editorconfig`), read when the buffer was made
  3. the project's directory-local settings (`.bedit-locals.blsp`, `dirlocals`, Emacs's
     `.dir-locals.el`): its entry for the buffer's mode, else its `:default` or bare
     value ([[dir-local]])
  4. the user's init.blsp entry for the buffer's MODE (`:indent-width {python 4}`), the
     most specific layer in its stack winning, as [[mode-key]] finds it — so
     `prog` reaches every code mode, as a `prog-mode-hook` does
  5. the mode's own convention, a facet on its layer (`:indent-width 4` on python-mode,
     declared once in its `deflanguage` spec; `:indent-tabs true` on Go and Makefiles)
  6. the user's `:default` (or a bare value) for the setting
  7. Emacs's defaults: an indent of 2, a tab of 8, spaces, a fill column of 70

`.editorconfig` beats the user's per-mode setting because it is the PROJECT's statement of
how its files are laid out, and a contributor editing someone else's repository should
write what it says whatever their own taste — Emacs's editorconfig package applies it after
the mode hooks for the same reason. `:editorconfig false` in init.blsp turns it off.

An indent width may be `:tab`: one level is one tab, as wide as the tab width (Go, Makefiles,
EditorConfig's `indent_size = tab`)."
  (:use editor/buffer) ; buffer-rope / replace-region / amalgamate-undo — the save fix-ups
  ;; a buffer's layer stack — and nothing of the editor's own: `scroll`, `wrap`, `panes` and
  ;; the view read this module, so it reads none of them
  (:use editor/layers :only [active-layers layer-facet]))

(def *builtin-defaults*
  ;; Emacs's: `standard-indent` is 4 there, but bedit's text and Lisp buffers have always
  ;; indented by 2, and a language that wants more says so
  {:indent-width 2 :tab-width 8 :indent-tabs false :fill-column 70})

(defdyn *user-settings* {})
;; The init file's `:indent-width` / `:tab-width` / `:indent-tabs` / `:fill-column`, each a
;; value or a per-mode map; re-bound by `config/apply-to-model` (`set-user-settings`) the way
;; `scroll` holds `:long-lines`, since the indent commands have a buffer and no model.

(defdyn *indent-width* nil)
;; The indent width a tree-sitter indenter counts a level as, bound by
;; `indent/ed-indent-target` around the `:indent` service call; nil leaves the language's
;; own `:width`. A dynamic rather than an argument because the `:indent` service contract is
;; `(text bol)` and the Lisp indenters, which are structural, take nothing more.

(defn with-indent-width (width thunk)
  "`(thunk)`, with a tree-sitter indenter counting a level as `width` columns
(`*indent-width*`) — `indent/ed-indent-target` around its `:indent` service call."
  (binding (*indent-width* width) (thunk)))

(defn bound-indent-width ()
  "The indent width [[with-indent-width]] bound, or nil outside one — what a generated
`deflanguage` indenter counts a level as (`language-core/spec-indent`)."
  *indent-width*)

(defn set-user-settings (settings)
  "Make `settings` — `{:indent-width :tab-width :indent-tabs :fill-column :editorconfig}` from
init.blsp — the user's. `config/apply-to-model` calls it at startup and on M-x reload-config."
  ;; `defdyn`, not `def`: a `def` over a dynamic variable makes it a plain global, which a
  ;; `binding` (a test's) can no longer rebind
  (defdyn *user-settings* (dissoc settings :editorconfig))
  (editorconfig/set-enabled (not (= false (:editorconfig settings))))
  nil)

(defn mode-key (setting buf)
  "The key of the per-mode map `setting` that names the most specific mode in `buf`'s layer
stack (`:elixir` before `:prog` before `:text`), as the map spells it (keyword or bare
symbol), or nil when it names none of them — how every per-mode init.blsp setting reaches a
buffer (`scroll/ed-mode-key` is this). A language mode stacks over `prog`, which stacks over
`text`, so one entry for `prog` reaches every code mode the way Emacs's `prog-mode-hook`
does, and an entry for the language itself still wins."
  (let (names (map (seq/filter (active-layers buf) (fn (layer) (not (:system layer))))
                (fn (layer) (->string (:name layer)))))
    (first (seq/keep names
             (fn (name)
               (cond
                 (contains? setting (keyword name)) (keyword name)
                 (contains? setting (symbol name)) (symbol name)
                 else nil))))))

(defn dir-local (buf key)
  "`[true value]` when `buf`'s directory-local settings (`:dir-locals`, stamped from its
project's `.bedit-locals.blsp` by `dirlocals`) give setting `key` a value for it — the entry
for its most specific mode ([[mode-key]]), else the map's `:default`, else a bare value — and
nil when they give none. A directory file says what the PROJECT wants, so it sits above
init.blsp's per-mode entry, as Emacs's dir-locals do over a mode hook."
  (let (setting (get (get buf :dir-locals) key))
    (cond
      (nil? setting) nil
      (map? setting)
        (let (entry (mode-key setting buf))
          (cond
            (not (nil? entry)) [true (get setting entry)]
            (contains? setting :default) [true (get setting :default)]
            else nil))
      else [true setting])))

(defn- mode-value (buf key)
  ;; the most specific layer's facet `key` — the mode's convention (never a service symbol)
  (layer-facet buf key))

(defn- user-value (key buf)
  ;; `[found? value]`: the user's entry for `buf`'s mode, else nil
  (let (setting (get *user-settings* key))
    (when (map? setting)
      (let (entry (mode-key setting buf)) (when entry [true (get setting entry)])))))

(defn- user-default (key)
  (let (setting (get *user-settings* key))
    (cond
      (nil? setting) nil
      (map? setting) (get setting :default)
      else setting)))

(defn- resolved (buffer key)
  ;; `[source value]`: the first source, by the precedence the module describes, that has a
  ;; value for convention `key` in `buffer`
  (let (user (user-value key buffer)
        local (dir-local buffer key)
        candidates [[:buffer (get (:conventions buffer) key)]
                     [:editorconfig (get (:editorconfig buffer) key)]
                     [:dir-locals (when local (second local))]
                     [:user-mode (when user (second user))]
                     [:mode (mode-value buffer key)]
                     [:user-default (user-default key)]])
    (or (seq/find candidates (fn ([_ value]) (not (nil? value))))
      [:builtin (get *builtin-defaults* key)])))

(defn setting (buffer key)
  "The value of convention `key` (`:indent-width` `:tab-width` `:indent-tabs` `:fill-column`)
for `buffer`, by the precedence the module describes. An `:indent-width` may come back `:tab`
here; [[indent-width]] resolves it."
  (second (resolved buffer key)))

(defn source (buffer key)
  "Where `buffer`'s convention `key` comes from: `:buffer`, `:editorconfig`, `:dir-locals`
(the project's `.bedit-locals.blsp`), `:user-mode` (the user's entry for its mode), `:mode`, `:user-default` or `:builtin` — for describing it."
  (first (resolved buffer key)))

(def *max-tab-width*
  ;; the widest tab stop brood's cell layout accepts (`MAX_TAB_WIDTH`): past it every measure
  ;; raises, so a wider one from a setting or an .editorconfig is clamped here
  1024)

(defn tab-width (buf)
  "The columns a tab spans in `buf` (Emacs `tab-width`): at least 1, at most
`*max-tab-width*` — an `.editorconfig`'s `tab_width = 2000` is 1024, not a raised render."
  (let (width (setting buf :tab-width))
    (if (and (int? width) (> width 0)) (math/min width *max-tab-width*) 8)))

(defdyn *glyphless-chars* :hex-code)
;; How the editor shows a GLYPHLESS character — a zero width space, a bidi control, a BOM in
;; mid-text (brood ADR-556): `:hex-code`, as a `<200b>` escape (Emacs's
;; `glyphless-char-display` hex-code), or `:hidden`. The init file's `:glyphless-chars`,
;; re-bound by `config/apply-to-model` ([[set-glyphless-chars]]); bound as brood's
;; `*glyphless-display*` wherever a buffer is measured ([[with-cell-layout]]). A `defdyn`, as
;; `*user-settings*` is, so a test binds it rather than setting what every test reads.

(defn set-glyphless-chars (how)
  "Make `how` — `:hex-code` or `:hidden`, init.blsp's `:glyphless-chars` — the way every
buffer shows its glyphless characters. Anything else is `:hex-code`. nil."
  ;; `defdyn`, not `def`, for the reason `set-user-settings` gives
  (defdyn *glyphless-chars* (if (= how :hidden) :hidden :hex-code))
  nil)

(defn with-cell-layout (buf thunk)
  "`(thunk)` with `buf`'s cell layout in force: brood's `*tab-width*` (ADR-537) bound to its
[[tab-width]] and `*glyphless-display*` (ADR-556) to [[*glyphless-chars*]], so every cell
measure inside it — a row table, a column, a goal column, a clip — lays a tab out at the
buffer's stops and a zero width space as its `<200b>`, as the view paints them."
  (binding (*tab-width* (tab-width buf) *glyphless-display* *glyphless-chars*) (thunk)))

(defn cell-layout-key ()
  "The cell layout in force, as ONE value: `[*tab-width* *glyphless-display*]`, what
[[with-cell-layout]] binds. Every memo of a cell measure (a row table, a row's facts, point's
cell, a visual column) keys on it, so a new tab width OR a flip of `:glyphless-chars` on the
same rope lays the text out again rather than handing back the old answer — and a parameter
added to the layout later goes in here, not into each memo's key."
  [*tab-width* *glyphless-display*])

(defn indent-width (buf)
  "The columns one indent level is in `buf` — what TAB indents by, Shift-TAB dedents by — a
`:tab` width being the tab width."
  (let (width (setting buf :indent-width))
    (cond
      (= width :tab) (tab-width buf)
      (and (int? width) (> width 0)) width
      else 2)))

(defn indent-tabs? (buf)
  "True when indentation in `buf` is written with tabs (Emacs `indent-tabs-mode`)."
  (= true (setting buf :indent-tabs)))

(defn fill-column (buf)
  "The column `buf`'s text is filled to (M-q; Emacs `fill-column`)."
  (let (column (setting buf :fill-column)) (if (and (int? column) (> column 0)) column 70)))

(defn indentation (buf column)
  "The leading whitespace that reaches `column` in `buf`: spaces, or — when it indents with
tabs — tabs of its tab width, then spaces for the rest."
  (if (indent-tabs? buf)
    (let (width (tab-width buf))
      (str (string/repeat "\t" (math/quot column width))
        (string/repeat " " (math/mod column width))))
    (string/repeat " " column)))

(defn with-buffer-setting (buf key value)
  "`buf` with its own convention `key` set to `value` (nil clears it) — above every other
source until the buffer is killed."
  (let (own (or (:conventions buf) {}))
    (assoc buf :conventions (if (nil? value) (dissoc own key) (assoc own key value)))))

;; ---- what a save does --------------------------------------------------------------------

(defn- trailing-run (rope line)
  ;; `[from to]`: the spaces and tabs ending `line`, before its `\r\n` or `\n`; nil for none
  (let (start (text/line->char rope line)
        body (string/drop-suffix (string/drop-suffix (text/line rope line) "\n") "\r")
        end (+ start (count body))
        found (regex/find body "[ \t]+$"))
    (when found [(- end (count (:text found))) end])))

(defn- trim-trailing (buf)
  ;; every line's trailing spaces and tabs removed, bottom up so the offsets above stay put,
  ;; as ONE undo step
  (let (rope (buffer-rope buf)
        runs (seq/keep (reverse (range (text/line-count rope)))
               (fn (line) (trailing-run rope line))))
    ;; `amalgamate-undo` marks the NEXT edit as joining the last, so it goes before every
    ;; edit but the first
    (fold runs
      buf
      (fn (acc [from to])
        (replace-region (if (= from (first (first runs))) acc (amalgamate-undo acc)) from to "")))))

(defn prepare-for-save (buf)
  "`buf` as its `.editorconfig` asks it to be written: trailing whitespace trimmed
(`trim_trailing_whitespace = true`) and a final newline added (`insert_final_newline = true`)
— edits on the buffer, as Emacs's before-save hook makes them, so what is on disk is what is
shown. Unchanged when the file asks for neither."
  (let (asks (or (:editorconfig buf) {})
        trimmed (if (= true (:trim-trailing-whitespace asks)) (trim-trailing buf) buf)
        length (count (buffer-rope trimmed)))
    (if (and (= true (:insert-final-newline asks))
          (> length 0)
          (not (= (text/slice (buffer-rope trimmed) (dec length) length) "\n")))
      (let (point (buffer-point trimmed)
            joined (if (= (buffer-rope trimmed) (buffer-rope buf))
                     trimmed
                     (amalgamate-undo trimmed)))
        (goto-char (replace-region joined length length "\n") point))
      trimmed)))

(defn summary (buf)
  "One line saying `buf`'s conventions and where each came from — M-x describe-indentation."
  (let (labels {:buffer "this buffer"
                :editorconfig ".editorconfig"
                :dir-locals (path/basename (or (:dir-locals-file buf) ".bedit-locals.blsp"))
                :user-mode "init.blsp, this mode"
                :mode "the mode"
                :user-default "init.blsp"
                :builtin "default"}
        from (fn (key) (get labels (source buf key))))
    (str "indent "
      (indent-width buf)
      " ("
      (from :indent-width)
      ") · "
      (if (indent-tabs? buf) "tabs" "spaces")
      " ("
      (from :indent-tabs)
      ") · "
      "tab "
      (tab-width buf)
      " ("
      (from :tab-width)
      ") · "
      "fill "
      (fill-column buf)
      " ("
      (from :fill-column)
      ")"
      ;; what .editorconfig asks for that this file is not, said rather than converted
      (string/join (map (seq/reject [(editorconfig/line-ending-note buf)
                                      (editorconfig/charset-note buf)]
                          nil?)
                     (fn (note) (str " · " note)))
        ""))))
