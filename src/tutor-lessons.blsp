(defmodule tutor-lessons
  "The Brood tutorial's CONTENT, nothing else: `tutor-lessons` is a vector of
lesson maps the machinery in `tutor` renders and checks. Grow the course by
editing this file only.

A lesson: `{:title str :body [line …] :playgrounds [pg …]}` — `:body` lines are
pre-wrapped prose (an empty string is a blank line). A playground:
`{:title str :code str}` plus, for an exercise, `:expect {:value <pr-str>}` (the
LAST form's value, as `pr-str` renders it — a string result is `\"\\\"hi\\\"\"`)
and an optional `:hint` shown on a miss; `:expect nil` means show-the-result-only.
`:trace [\"fn-name\" …]` boundary-traces those names in the sandbox and renders
the call/return cascade in the *Workings* side pane. Definitions persist down the
lesson (playgrounds re-evaluate top-to-bottom in one session), so a later
playground may call what an earlier one defined.")

(def tutor-sections
  ;; The course as SECTIONS, each optionally split into ordered SUBSECTIONS. The user
  ;; walks Navigation first, then chooses from the contents page
  ;; (`tutor/cmd-tutorial-contents`). `:id` matches each lesson's `:section`, and a
  ;; subsection's `:id` matches its `:subsection` — lessons are grouped by both, so a
  ;; long topic (the language) reads as a few short walks instead of one long one.
  [{:id :navigation :title "Navigation"
    :blurb "Move around like you mean it — keys, leaps, and search."}
   {:id :editing :title "Editing"
    :blurb "Change text, undo, and pick the keys you drive (emacs or vim)."}
   {:id :language :title "The Brood language (.blsp)"
    :blurb "The language itself: values, functions, data, and processes."
    :subsections [{:id :basics :title "Values & expressions"
                   :blurb "Numbers, strings, let, if — and lists vs vectors."}
                  {:id :functions :title "Functions & data"
                   :blurb "defn, immutability, map/filter/fold, recursion as the loop."}
                  {:id :matching :title "Pattern matching & errors"
                   :blurb "match on shape, destructuring, and try/catch."}
                  {:id :processes :title "Processes"
                   :blurb "spawn, send, receive — state that genuinely changes."}]}
   {:id :editor :title "The editor is Brood"
    :blurb "Evaluate in place, redefine the editor live, and where to go next."}])

(def tutor-lessons
  [;; ---- 1 · the choice that shapes everything after it ----------------------------
   {:title "Choose your keys"
    :section :navigation
    :body ["Welcome! This buffer is alive: everything inside a box is yours to"
           "edit — the prose around it is not. Two kinds of box, and the border"
           "tells you which: ┄ dashed holds plain TEXT, ─ solid holds real Brood"
           "that evaluates as you type. This section is all text; code starts once"
           "you can move around. A ✓ or ✗ in the margin marks an exercise either"
           "way, and the echo line says why."
           ""
           "First, the keys. You are driving the {{profile-name}} profile right now,"
           "and this whole course renders for whichever you pick:"
           ""
           "  · emacs — chords: C-f forward, C-k kill a line, M-x runs a command."
           "  · vim — modal: hjkl to move, i to insert, ESC back, : runs a command."
           ""
           "Switch with {{kcmd}} vim-mode or {{kcmd}} emacs-mode (C-x v v does either"
           "way). Do it now if you like: every lesson, this page included, re-renders"
           "its keys at once and keeps whatever you have typed in the boxes."
           ""
           "The tutorial's OWN keys never change — {{next-box}}/{{prev-box}} move"
           "between boxes, {{next-lesson}}/{{prev-lesson}} between lessons,"
           "{{contents}} opens the contents, {{reset-box}} resets a box."]
    :playgrounds [{:kind :text
                   :title "Try it — type in here, it is yours ({{profile-name}} keys)"
                   :code "Type anything. Change this line, add another.\nSwitch profiles while you are in here: what you\ntyped stays exactly where it is."}
                  {:kind :text
                   :title "Exercise — make this line read: my keys are {{profile-name}}"
                   :code "my keys are"
                   :expect {:text "my keys are {{profile-name}}"}
                   :hint "put the cursor at the end of the line and type the name"}]}

   ;; ---- 2 · the editor itself: moving around -----------------------------------
   {:title "Moving around"
    :section :navigation
    :body ["Now move around. The arrows always work; so do the {{profile-name}} keys:"
           "{{move-line}}."
           "M-n hops to the next box, M-p (or S-TAB) hops back — and the"
           "prose can't be edited, only the boxes can."
           "{{insert-hint}}"]
    :playgrounds [{:kind :text
                   :title "Practice — plain text, nothing to evaluate: just wander"
                   :code "Move through these lines with {{motion-keys}}.\nNothing in this box is code, so nothing is judged —\nit only cares that you can get around it.\nEnd of this line, then the start of the next one."}
                  {:kind :text
                   :title "Exercise — fix the typo: the fxo should be a fox"
                   :code "the quick brown fxo\njumps over the lazy dog"
                   :expect {:text "the quick brown fox\njumps over the lazy dog"}
                   :hint "{{kn}} down a line, {{keol}} to its end, then fix the two letters"}]}

   ;; ---- 2 · navigation: leaps ----------------------------------------------------
   {:title "Leaps and bounds"
    :section :navigation
    :body ["Bigger jumps: {{kwf}} / {{kwb}} move by WORD, {{kbol}} / {{keol}} to the"
           "line's start and end, {{kbs}} / {{kbe}} to the buffer's very top and bottom,"
           "{{paging-line}}"
           "{{paging-line2}}"]
    :playgrounds [{:kind :text
                   :title "Practice — leap word by word ({{kwf}} / {{kwb}}) along this line"
                   :code "leap over each word in turn then swing all the way back again"}
                  {:kind :text
                   :title "Exercise — delete the word DECOY, leave the rest as it reads"
                   :code "keep this DECOY line intact"
                   :expect {:text "keep this line intact"}
                   :hint "{{kwf}} until you are on it, then delete the word"}]}

   ;; ---- 3 · navigation: search ---------------------------------------------------
   {:title "Search is navigation"
    :section :navigation
    :body ["The fastest way anywhere is to SEARCH for it: {{ksearch}} starts an"
           "incremental search — every keystroke narrows, {{ksearch}} again jumps to"
           "the next match, RET lands the cursor there, C-g cancels back to"
           "where you started. {{krsearch}} searches backward."
           ""
           "Searching beats counting keystrokes: if you can see it, search for it."]
    :playgrounds [{:kind :text
                   :title "Practice — {{ksearch}} for a word you can see, then C-g back"
                   :code "haystack haystack haystack\nhaystack thimble haystack\nhaystack haystack haystack"}
                  {:kind :text
                   :title "Exercise — find the word needle and make it read found"
                   :code "haystack haystack haystack\nhaystack needle haystack\nhaystack haystack haystack"
                   :expect {:text "haystack haystack haystack\nhaystack found haystack\nhaystack haystack haystack"}
                   :hint "{{ksearch}} n e e d l e RET lands the cursor just after it"}]}

   ;; ---- 4 · the editor itself: editing ------------------------------------------
   {:title "Editing"
    :section :editing
    :body ["Everything you'd expect: type to insert, Backspace deletes,"
           "{{kill-line}}"
           "{{kill-line2}}"
           "as many steps as you like. RET auto-indents inside a box."
           "{{insert-hint}}"
           ""
           "If a box gets away from you, C-c C-r resets it to its template."]
    :playgrounds [{:kind :text
                   :title "{{practice-kill}}"
                   :code "kill this line\nbring it back with a yank\nthen undo the whole lot"}
                  {:kind :text
                   :title "Exercise — remove the DELETE ME line, keep the other two"
                   :code "first line stays\nDELETE ME\nlast line stays"
                   :expect {:text "first line stays\nlast line stays"}
                   :hint "{{kill-hint}}"}]}

   {:title "Undo only what you selected"
    :section :editing
    :body ["{{kundo}} undoes the last change. But select some lines first and it"
           "undoes only THOSE lines — the most recent change that touched them —"
           "and leaves every other edit standing. Emacs calls this undo-in-region;"
           "most editors can't do it at all."
           ""
           "Why this editor can: undo here keeps whole previous TEXTS, so the set of"
           "changes is just a line diff away. Undoing a selection means applying"
           "back only the diff hunks inside it — no per-edit bookkeeping needed."
           ""
           "Try it in the box: break line 1 AND line 3 (add junk to each). Then"
           "select just line 1 (C-SPC, then down a line) and press {{kundo}}."
           "Line 1 comes back; your line-3 damage stays. Press {{kundo}} again with"
           "the selection still live and it keeps peeling changes off those lines."]
    :playgrounds [{:kind :text
                   :title "Practice — break line 1 AND line 3, then undo only line 1"
                   :code "first line, damage me\nsecond line, leave me alone\nthird line, damage me too"}]}

   ;; ---- the bridge: the first CODE box, and the reason for it --------------------
   {:title "Moving by structure"
    :section :editing
    :body ["Everything so far was plain text. Here is the first box of real code —"
           "and the reason the editor cares about the difference."
           ""
           "In a Lisp the parentheses ARE the structure, so the cursor can move by"
           "structure instead of by character: C-M-f and C-M-b hop over a whole"
           "( ) form at a time, and C-M-u climbs out of the form you are inside."
           "One key steps over an argument however long it is."
           ""
           "This box is Brood, so it also evaluates as you type — the result"
           "appears at the end of the line. That is the next section's subject."]
    :playgrounds [{:title "Practice — C-M-f from the front, watch it leap whole forms"
                   :code "(list (list 1 2) [3 4] (str \"whole\" \"forms\") :done)"}
                  {:title "Exercise — {{ksearch}} needle RET, then make this give 42"
                   :code "(let (needle 39\n      basket [1 2])\n  (+ needle (count basket)))"
                   :expect {:value "42"}
                   :hint "needle is 39 and the basket holds 2 — {{keol}} on the needle line"}]}

   ;; ---- 5 · the editor itself: your keys -----------------------------------------
   {:title "Your keys, your editor"
    :section :editing
    :body ["You're driving the {{profile-name}} profile — every key this course"
           "teaches renders for it, live. {{kcmd}} opens the command prompt (type"
           "a name, RET): {{kcmd}} vim-mode switches to vim keys, {{kcmd}} emacs-mode"
           "back — and C-x v v toggles either way. Note the prompt key itself"
           "differs: M-x under emacs, : under vim, which is why it is written"
           "as {{kcmd}} here and not spelled out."
           ""
           "The moment you switch, THIS page (and every lesson) re-renders its"
           "keys for the other profile, keeping whatever you typed in the boxes."
           ""
           "The tutorial's own keys — M-n, M-p, TAB, C-c C-n, C-c C-r — live on"
           "this BUFFER's mode, not the profile, so they work under either."
           "Try it now: switch, watch the prose change, and switch back."]
    :playgrounds [{:title "Try it — whichever profile you're in, the box still evaluates"
                   :code "(str \"my keys, \" \"my editor\")"}]}

   ;; ---- 6 · values ----------------------------------------------------------------
   {:title "Values"
    :section :language
    :subsection :basics
    :body ["Now, Brood. Numbers, strings, keywords and booleans evaluate to"
           "themselves; a call is a parenthesised list, operator first: (+ 1 2)."]
    :playgrounds [{:title "Try it — edit the numbers, watch the result follow"
                   :code "(+ 1 2)"}
                  {:title "Exercise — make this evaluate to 42"
                   :code "(* 6 6)"
                   :expect {:value "42"}
                   :hint "six times seven"}]}

   ;; ---- 7 · expressions -----------------------------------------------------------
   {:title "Everything is an expression"
    :section :language
    :subsection :basics
    :body ["There are no statements: `if`, `let`, `do` are expressions with"
           "values. `let` binds names in a FLAT list — (let (a 1 b 2) …) — and"
           "each binding sees the ones before it."
           ""
           "Truthiness: only nil and false are falsy. 0, \"\" and [] are all"
           "true — but the empty LIST () is nil, so it is falsy. Test emptiness"
           "with (empty? x), never with a bare if."]
    :playgrounds [{:title "Try it"
                   :code "(let (x 10\n      y (* x 2))\n  (if (> y 15) :big :small))"}
                  {:title "Exercise — bind `name` so the greeting reads \"hello, brood\""
                   :code "(let (name \"world\")\n  (str \"hello, \" name))"
                   :expect {:value "\"hello, brood\""}
                   :hint "change what `name` is bound to"}]}

   ;; ---- 8 · lists and vectors -----------------------------------------------------
   {:title "Lists and vectors"
    :section :language
    :subsection :basics
    :body ["Lists ( ) are code — calling them is what evaluation is. Vectors"
           "[ ] are data: [1 2 3] evaluates to itself. Both are immutable and"
           "share one sequence API: first, rest, count, map, filter, fold."
           ""
           "conj adds at a collection's natural point: the front of a list,"
           "the end of a vector. It returns a NEW collection — nothing mutates."]
    :playgrounds [{:title "Try it"
                   :code "(let (v [1 2 3])\n  [(first v) (count v) (conj v 4)])"}
                  {:title "Exercise — produce [10 20 30 40] from the vector below"
                   :code "(conj [10 20 30] 4)"
                   :expect {:value "[10 20 30 40]"}
                   :hint "conj appends to a vector — what belongs at the end?"}]}

   ;; ---- 9 · functions (traced: the *Workings* pane debuts) ------------------------
   {:title "Functions"
    :section :language
    :subsection :functions
    :body ["defn defines a function; the last form's value is what it returns."
           "Parameter lists are ( ), not [ ] — code is lists, data is vectors."
           ""
           "A definition made in one box is callable in the boxes below it"
           "(the whole lesson shares one live session, top to bottom)."
           ""
           "These boxes are TRACED: the *Workings* pane beside shows every call"
           "and return as the sandbox ran it — watch it follow your edits."]
    :playgrounds [{:title "Try it — define…"
                   :code "(defn double (x) (* 2 x))"
                   :trace ["double"]}
                  {:title "…and call (this box sees `double` from the box above)"
                   :code "(double 21)"
                   :trace ["double"]}
                  {:title "Exercise — fix `triple` so the call below returns 42"
                   :code "(defn triple (x) (+ x 3))\n(triple 14)"
                   :expect {:value "42"}
                   :trace ["triple"]
                   :hint "triple means times three, not plus three"}]}

   ;; ---- 10 · immutability ----------------------------------------------------------
   {:title "Immutability"
    :section :language
    :subsection :functions
    :body ["Nothing mutates. assoc, dissoc, update, conj all return a fresh"
           "value; the original is untouched. There is no set! and no loops —"
           "changing state means computing a new value from the old one."
           ""
           "Maps are written {:key value …}, no commas. (:key m) reads a key"
           "— keywords are callable."]
    :playgrounds [{:title "Try it — the original map survives"
                   :code "(let (m {:name \"ada\" :age 36})\n  [(assoc m :age 37) m])"}
                  {:title "Exercise — read the :score of the player AFTER raising it to 100"
                   :code "(let (player {:name \"zed\" :score 40})\n  (:score player))"
                   :expect {:value "100"}
                   :hint "(:score (assoc player :score 100)) — assoc gives you the new map"}]}

   ;; ---- 11 · map, filter, fold -----------------------------------------------------
   {:title "map, filter, fold"
    :section :language
    :subsection :functions
    :body ["Iteration is a function you apply, not a loop you write:"
           "  (map f xs)      — transform every element"
           "  (filter p xs)   — keep the elements p likes"
           "  (fold f acc xs) — thread an accumulator through the sequence"
           ""
           "fold is the general one — map and filter could each be written"
           "with it. (range n) is the integers 0 … n-1."]
    :playgrounds [{:title "Try it"
                   :code "(->> (range 10)\n  (filter even?)\n  (map (fn (x) (* x x))))"}
                  {:title "Exercise — sum the squares of the even numbers below 10"
                   :code "(->> (range 10)\n  (filter even?)\n  (map (fn (x) (* x x)))\n  (fold + 0))"
                   :expect {:value "120"}
                   :hint "0² + 2² + 4² + 6² + 8² = 120 — this one may already pass; read it until you see why"}]}

   ;; ---- 12 · recursion (traced) ---------------------------------------------------
   {:title "Recursion is the loop"
    :section :language
    :subsection :functions
    :body ["Brood guarantees proper tail calls: a function calling itself in"
           "tail position runs in constant stack, forever if it likes. That is"
           "the loop. Multi-clause defn dispatches on the argument's shape —"
           "the base case is just another clause."
           ""
           "The exercise is traced: *Workings* shows the whole cascade of"
           "recursive calls unwinding back up — the shape of recursion itself."]
    :playgrounds [{:title "Try it — count down by matching on 0 (a million tail calls, O(1) stack)"
                   :code "(defn countdown\n  ((0) :liftoff)\n  ((n) (countdown (- n 1))))\n(countdown 1000000)"}
                  {:title "Exercise — finish factorial (5! is 120)"
                   :code "(defn fac\n  ((0) 1)\n  ((n) n))\n(fac 5)"
                   :expect {:value "120"}
                   :trace ["fac"]
                   :hint "the (n) clause should multiply n by the factorial of (n - 1)"}]}

   ;; ---- 13 · processes ------------------------------------------------------------
   ;; ---- pattern matching & errors (:language / :matching) --------------------------
   {:title "Matching on shape"
    :section :language
    :subsection :matching
    :body ["`match` picks a branch by the SHAPE of a value, binding as it goes."
           "A bare symbol BINDS (it doesn't compare) — to match a value you"
           "already have, pin it with ^. Vectors are the tagged-data idiom:"
           "[:circle 2] and [:rect 3 4] tell themselves apart."
           ""
           "`_` matches anything. Clauses are tried top to bottom."]
    :playgrounds [{:title "Try it — edit the shape and watch the branch change"
                   :code "(let (shape [:rect 3 4])\n  (match shape\n    ([:circle r] (* 3 r r))\n    ([:rect w h] (* w h))\n    (_ :unknown)))"}
                  {:title "Exercise — add a [:square s] clause so this gives 42… well, 49"
                   :code "(let (shape [:square 7])\n  (match shape\n    ([:rect w h] (* w h))\n    (_ :unknown)))"
                   :expect {:value "49"}
                   :hint "add ([:square s] (* s s)) above the _ clause"}]}

   {:title "Destructuring"
    :section :language
    :subsection :matching
    :body ["The same patterns work in `let` and in function parameters:"
           "(let ([x y] point) …) unpacks a 2-vector, {:keys [a b]} pulls"
           "keys out of a map, and (first & rest) splits a list."
           ""
           "Reach for it instead of a pile of `get` calls — the shape of the"
           "data shows up in the code that reads it."]
    :playgrounds [{:title "Try it"
                   :code "(let (point [3 4]\n      {:keys [name age]} {:name \"ada\" :age 36}\n      [x y] point)\n  [name age (+ x y)])"}
                  {:title "Exercise — destructure the map so this returns the score, 42"
                   :code "(let (player {:name \"zed\" :score 42})\n  0)"
                   :expect {:value "42"}
                   :hint "(let ({:keys [score]} player) score) — or just (:score player)"}]}

   {:title "When things go wrong"
    :section :language
    :subsection :matching
    :body ["`try` runs a body and `catch` takes ONE binder for whatever was"
           "thrown — never a type: (try (risky) (catch e …)). Use"
           "(error-message e) to read it, whatever shape it came in."
           ""
           "`throw` sends any value; `error` builds a message and throws it."
           "Brood's rule of thumb: throw for bugs, return a tagged vector"
           "([:ok v] / [:error e]) for outcomes a caller should branch on."]
    :playgrounds [{:title "Try it — a caught error is just a value again"
                   :code "(try\n  (error \"boom: \" 7)\n  (catch e (str \"caught -> \" (error-message e))))"}
                  {:title "Exercise — make the division safe, returning :nope instead of throwing"
                   :code "(defn safe-div (a b)\n  (/ a b))\n(safe-div 1 0)"
                   :expect {:value ":nope"}
                   :trace ["safe-div"]
                   :hint "wrap the body: (try (/ a b) (catch e :nope))"}]}

   {:title "Processes"
    :section :language
    :subsection :processes
    :body ["State that genuinely changes lives in a PROCESS. spawn starts one"
           "(each has its own heap), send posts it a message, receive pattern-"
           "matches the mailbox — Erlang's model, Brood's syntax."
           ""
           "An (after ms …) clause keeps a receive from waiting forever."]
    :playgrounds [{:title "Try it — round-trip a message"
                   :code "(let (me (self))\n  (spawn (send me [:pong 42]))\n  (receive\n    ([:pong x] x)\n    (after 500 :lost)))"}
                  {:title "Exercise — make the child reply with the DOUBLE of 21"
                   :code "(let (me (self))\n  (spawn (send me [:answer 21]))\n  (receive\n    ([:answer x] x)\n    (after 500 :lost)))"
                   :expect {:value "42"}
                   :hint "the child computes: send (* 2 21), or double x on receipt"}]}

   {:title "A process that remembers"
    :section :language
    :subsection :processes
    :body ["A process IS mutable state done safely: it loops, holding its"
           "state as an argument, and each message produces the NEXT state."
           "Nothing is shared, so nothing can race."
           ""
           "`receive` waits for a message; the loop calls itself in tail"
           "position, so it can run forever in constant stack."]
    :playgrounds [{:title "Try it — a counter process, asked twice"
                   :code "(defn counter (n)\n  (receive\n    ([:add k from] (do (send from (+ n k)) (counter (+ n k))))\n    (after 1000 n)))\n(let (me (self)\n      c (spawn (counter 0)))\n  (send c [:add 40 me])\n  (receive (a (do (send c [:add 2 me])\n                (receive (b [a b]))))))"}
                  {:title "Exercise — make the counter start at 40 so the answer is 42"
                   :code "(let (me (self)\n      c (spawn (counter 0)))\n  (send c [:add 2 me])\n  (receive (x x) (after 1000 :lost)))"
                   :expect {:value "42"}
                   :hint "(spawn (counter 40)) — the initial state is just an argument"}]}

   {:title "When a process dies"
    :section :language
    :subsection :processes
    :body ["Processes are allowed to crash — that's the point. `monitor`"
           "gives you a ref, and when the process dies you get"
           "[:down ref pid reason] in your mailbox: :normal for a clean"
           "exit, an error map for a crash."
           ""
           "Pin the ref with ^ref so you match YOUR monitor, not any other."
           "This is what supervisors are built from — about ten lines of Brood."]
    :playgrounds [{:title "Try it — watch a clean exit and a crash, told apart"
                   :code "(let (p (spawn :ok)\n      r (monitor p))\n  (receive\n    ([:down ^r _ reason] [:clean reason])\n    (after 500 :lost)))"}
                  {:title "Exercise — report the CRASH reason's kind instead of :lost"
                   :code "(let (p (spawn (error \"i fell over\"))\n      r (monitor p))\n  (receive\n    (:never :lost)\n    (after 500 :lost)))"
                   :expect {:value ":error"}
                   :hint "match ([:down ^r _ reason] (first reason)) — a crash reason is [:error msg]"}]}

   ;; ---- the editor is Brood (:editor) ----------------------------------------------
   {:title "Evaluate anything, anywhere"
    :section :editor
    :body ["The boxes in this tutorial are not special: ANY Brood buffer"
           "evaluates. Put the cursor after a form in a .blsp file and press"
           "C-x C-e — the result lands in the echo area. C-c C-t here, M-x"
           "eval-buffer for the whole file."
           ""
           "This editor is itself a Brood program: the commands you have been"
           "pressing are plain functions, and redefining one takes effect on"
           "the next keystroke. That is what the language is for."]
    :playgrounds [{:title "Try it — the editor's own vocabulary is right here"
                   :code "[(bound? 'commands/cmd-forward-char)\n  (bound? 'tutor/cmd-tutorial-next)\n  :the-editor-is-data]"}
                  {:title "Exercise — this page IS data: make the check below true"
                   :code "(> (count tutor-lessons/tutor-lessons) 5)"
                   :expect {:value "true"}
                   :hint "it already is — read it, then try (count tutor-lessons/tutor-sections)"}]}

   {:title "Where next"
    :section :editor
    :body ["You know the editor and the language. From here:"
           ""
           "· C-x C-e evaluates, M-x runs any command by name, C-h k tells"
           "  you what a key does, C-h f what a command does."
           "· C-c t runs the test suite, C-c r runs the project, C-x g opens"
           "  git — all of them Brood you can read and change."
           "· ~/.config/brood-edit/init.blsp is your own config, in Brood."
           ""
           "The box below reads the editor's live state. Change it, break it,"
           "and remember: this whole page is data in src/tutor-lessons.blsp."]
    :playgrounds [{:title "Try it — ask the running editor about itself"
                   :code "{:commands (count (interactive/command-names))\n :sections (count tutor-lessons/tutor-sections)\n :yours :now}"}]}
])
