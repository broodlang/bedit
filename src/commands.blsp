(defmodule commands
  "The editor's commands. Each is a global `(fn (model key) -> model)` resolved
by symbol at dispatch time (see `input`), so redefining one hot-swaps the key's
behaviour live — the late binding that makes a self-editing editor possible.
`key` is the triggering key event; most commands ignore it, `cmd-self-insert`
inserts it.

All editing/movement runs on the *current* buffer (the active entry in the
model's `:buffers`): movement applies a `buffer -> buffer` op through `ed-apply`
(no modified flag); edits go through `ed-edit` (marks the buffer modified). The
region/kill commands maintain the model's `:kill-ring`; the buffer commands move
between / open / kill buffers; `cmd-switch-buffer` / `cmd-find-file` open a
minibuffer prompt (see `input`). This is editor *policy* — the reusable buffer
model lives in `std/buffer.blsp`; keymaps in `input`."
  (:use editor/buffer) ; the buffer ops the commands drive (incl. undo/redo, word motion)
  (:use eval-command) ; last-sexp-source + eval-source — the async C-x C-e family
  (:use sexp) ; structural s-expression navigation (brood-mode commands)
  ;; NB: tree-sitter's structural motions (ruby/elixir-mode, ROADMAP §C) are deliberately
  ;; NOT `:use`d — see the `require` below.
  (:use interactive) ; defcommand — define + register an interactive command (M-x)
  (:use editor/pane) ; the pane-tree ops behind the split/other/delete commands
  (:use panes) ; ed-toggle-line-numbers — the line-number gutter toggle (C-x l)
  (:use complete-at-point) ; cmd-complete / complete-word-char? — TAB indent-or-complete
  (:use completion) ; perms-string / rwx — the dired `ls -l` permission columns
  (:use isearch) ; incremental search + query-replace (the modal mini-loops)
  (:use mincomplete) ; ed-complete-name / ed-complete-path — minibuffer prompt completion
  (:use collab) ; follow / participants / unfollow — the shared-session commands (C-x f)
  (:use projects) ; project-root / project-files — find-file-in-project (C-x p f)
  (:use task) ; task / cancel-task — the off-loop, cancellable, timeout-bounded async eval
  (:use io :exclude [inspect]) ; process-port — stream a spawned eval's output back to the editor
  ; web / lsp / proctree are deferred — required lazily inside their commands
  (:use keymaps) ; ed-set-profile + vim-to-* — the emacs/vim keybinding profiles
  (:use lsp-requests) ; the request-kind records + the LspRequest ability (fold impls below)
  (:use results) ; the results-buffer abstraction — line-loc vocabulary + ed-append-follow
  (:use model)) ; current-buffer accessors, the kill ring, message
;; Tree-sitter's structural motions (ruby/elixir-mode) are REQUIRED, not `:use`d. They
;; share several names with `sexp` — `point-defun-start`, `point-down`, … — and two `:use`s
;; of one name is a load error (E0099), so importing both put the whole editor one std
;; addition away from not loading at all. Every call here is qualified anyway
;; (`sexp/…` over Brood source; `editor/treesit/…` for a foreign language, whose signatures
;; take a `lang`), and a qualified call only needs the module loaded.
;; editor/treesit, theme (face-dired-* dired colours), datetime (epoch-ms-> / format)
;; and config (init-config / apply-to-model) are referenced qualified below and auto-load.
;; `modes` (a project source module, loaded with the image) provides
;; welcome-link-at / *welcome-links* — the welcome scratch's clickable link lines.

(defn ed-name-prompt (prompt names on-complete &optional (limit 20) (recent []))
  "A Vertico minibuffer spec that completes input against a fixed `names` list — Tab to
the common prefix, a fuzzy candidate list (top `limit`) — and runs `on-complete`
(`(model text) -> model`) on the accepted entry. The shared shape behind M-x,
switch-buffer, recentf, describe-function, and bookmark-jump. `recent` (a most-recent-first
list, default none) floats its entries to the top on empty input via the shared
`projects/float-recent` — the same recency any completion opts into (see `recent-commands`)."
  {:edit (ed-mb-edit prompt "")
   :on-complete on-complete
   :complete-fn (fn (t) (ed-complete-name t names))
   :rank-source (projects/float-recent names recent) ; recents first, then fuzzy-narrowed on typing
   :rank-cap limit
   :accept-selection true})

;; ---- movement (Emacs C-f/C-b/C-n/C-p/C-a/C-e/M-f/M-b + the arrow keys) -------

(defcommand cmd-forward-char (m key) (ed-apply m forward-char))
(defcommand cmd-backward-char (m key) (ed-apply m backward-char))
(defcommand cmd-next-line (m key) (ed-apply m forward-line))
(defcommand cmd-previous-line (m key) (ed-apply m backward-line))
(defcommand cmd-beginning-of-line (m key) (ed-apply m beginning-of-line))
(defcommand cmd-end-of-line (m key) (ed-apply m end-of-line))
(defcommand cmd-forward-word (m key) (ed-apply m forward-word))
(defcommand cmd-backward-word (m key) (ed-apply m backward-word))
(defcommand cmd-beginning-of-buffer (m key) (ed-apply m beginning-of-buffer)) ; M-<
(defcommand cmd-end-of-buffer (m key) (ed-apply m end-of-buffer)) ; M->
;; ---- structural s-expression motion (brood-mode: C-M-f/b/u/d/a) -------------
;; Each runs a `std/sexp` buffer command over the current buffer — navigation by
;; the parse-source CST, not characters. `std/sexp` parses through the kernel's
;; `parse-source-positioned` (positions tracked in Rust, one pass), so a re-parse
;; per move is cheap — no model-side caching needed. Bound only in `brood-mode`
;; (see `modes`).

;; Structural motion is mode-polymorphic: a tree-sitter-backed mode (ruby/elixir)
;; carries a `:ts-lang` facet and moves via `editor/treesit`'s pure
;; `(text lang point) -> point` motions; brood-mode (no `:ts-lang`) keeps the
;; `std/sexp` motions. Same keys (`C-M-f/b/u/d/a`), same commands — the buffer's
;; layer picks the backend (ROADMAP §C: the node abstraction lets the structural
;; commands run over a tree-sitter tree unchanged).
(defn- ed-structural (b key ts-point sexp-fn)
  (let (lang (ed-mode-service b :ts-lang))
    (if (nil? lang)
      (sexp-fn b key)
      (goto-char b (ts-point (buffer-text b) lang (:point b))))))

(defn- ed-defun-bounds (b key)
  "`[start end]` of the top-level form around point, as the buffer's MODE sees one — the
same beginning-/end-of-defun pair C-M-a / C-M-e move by (tree-sitter in a language mode,
the sexp parser in Brood), and the paragraph in a buffer that has neither (Emacs' own
fallback). `C-M-h` and `C-x n d` used to call the Brood parser on every buffer, marking
or narrowing to nonsense in Elixir, Ruby or Markdown."
  (if (or (ed-mode-service b :ts-lang) (= (editor/layers/buffer-type-for b) :brood))
    (let (s (ed-structural b key editor/treesit/point-defun-start sexp/beginning-of-defun)
          e (ed-structural s key editor/treesit/point-defun-end sexp/end-of-defun))
      [(buffer-point s) (buffer-point e)])
    (let (s (backward-paragraph b)) [(buffer-point s) (buffer-point (forward-paragraph s))])))

(defn- ed-structural-move (key ts-point sexp-fn)
  "The mode-polymorphic structural move as one `buffer -> buffer` op — `ts-point` for a
tree-sitter mode, `sexp-fn` for Brood. Naming the buffer op (rather than inlining the `fn`)
is what lets the motions, the structural KILLS (`ed-kill-span` wants a `buffer -> buffer`)
and `mark-sexp` all share a single definition of \"one sexp forward\"."
  (fn (b) (ed-structural b key ts-point sexp-fn)))

(defcommand cmd-forward-sexp
  (m key)
  "Forward over the next s-expression (C-M-f) — and out of the list when nothing follows
(paredit), which is why this is `sexp/forward-out` while the kills and marks below use
the strict `sexp/forward` (a kill at `(a b|)` must kill nothing, not the `)`)."
  (ed-apply m (ed-structural-move key editor/treesit/point-forward sexp/forward-out)))
(defcommand cmd-backward-sexp
  (m key)
  "Back over the previous s-expression (C-M-b) — and out before the open delimiter when
nothing precedes (paredit)."
  (ed-apply m (ed-structural-move key editor/treesit/point-backward sexp/backward-out)))
(defcommand cmd-forward-list
  (m key)
  "Forward over the next LIST, stepping past atom siblings rather than stopping at them
(C-M-n) — the \"jump the whole next block\" motion."
  (ed-apply m (ed-structural-move key editor/treesit/point-list-forward sexp/list-forward)))
(defcommand cmd-backward-list
  (m key)
  "Back over the previous LIST, stepping past atom siblings (C-M-p)."
  (ed-apply m (ed-structural-move key editor/treesit/point-list-backward sexp/list-backward)))
(defcommand cmd-backward-up-list
  (m key)
  "Out of the enclosing list backward, to before its opening delimiter (C-M-u)."
  (ed-apply m (ed-structural-move key editor/treesit/point-up sexp/up)))
(defcommand cmd-up-list
  (m key)
  "Out of the enclosing list forward, to past its closing delimiter (Emacs `up-list`) —
the mirror of `backward-up-list`, and the quick way out of a form you've finished."
  (ed-apply m (ed-structural-move key editor/treesit/point-up-forward sexp/up-forward)))
(defcommand cmd-down-list
  (m key)
  "Down into the next list, just past its opening delimiter (C-M-d)."
  (ed-apply m (ed-structural-move key editor/treesit/point-down sexp/down)))
(defcommand cmd-beginning-of-defun
  (m key)
  "To the start of the enclosing definition (C-M-a)."
  (ed-apply m (ed-structural-move key editor/treesit/point-defun-start sexp/beginning-of-defun)))
(defcommand cmd-end-of-defun
  (m key)
  "To the end of the enclosing definition (C-M-e) — the close of the very form
`beginning-of-defun` finds, so the pair brackets one defun."
  (ed-apply m (ed-structural-move key editor/treesit/point-defun-end sexp/end-of-defun)))

;; The structural kills: `ed-kill-span` over the same motions, so a killed sexp is
;; whatever `C-M-f`/`C-M-b` would have moved over — the whole form however many lines it
;; spans. Distinct from brood-mode's `C-k` (`cmd-sexp-kill`), which is paredit's
;; line-bounded kill: that one refuses to break the parens, these take a balanced form.
(defcommand cmd-kill-sexp
  (m key)
  "Kill the s-expression after point (C-M-k)."
  (ed-kill-span m (ed-structural-move key editor/treesit/point-forward sexp/forward)))
(defcommand cmd-backward-kill-sexp
  (m key)
  "Kill the s-expression before point (C-M-DEL)."
  (ed-kill-span m (ed-structural-move key editor/treesit/point-backward sexp/backward)))

;; ---- structural editing (brood-mode: paredit slurp/barf/raise/splice/wrap) ---
;; Each runs a `std/sexp` structural *edit* over the current buffer — a whole-buffer
;; splice the module computes from the CST (one undo unit), or a no-op when the op
;; doesn't apply (no sibling to slurp, top level for splice). Like the motions above
;; they go through `ed-apply`; the edits self-guard on read-only via `replace-region`.

(defcommand cmd-slurp-forward
  (m key)
  "Pull the form after the enclosing list inside it (paredit C-))."
  (ed-apply m (fn (b) (sexp/slurp-forward b key))))
(defcommand cmd-barf-forward
  (m key)
  "Expel the last form of the enclosing list (paredit C-})."
  (ed-apply m (fn (b) (sexp/barf-forward b key))))
(defcommand cmd-slurp-backward
  (m key)
  "Pull the form before the enclosing list inside it (paredit C-()."
  (ed-apply m (fn (b) (sexp/slurp-backward b key))))
(defcommand cmd-barf-backward
  (m key)
  "Expel the first form of the enclosing list (paredit C-{)."
  (ed-apply m (fn (b) (sexp/barf-backward b key))))
(defcommand cmd-raise-sexp
  (m key)
  "Replace the enclosing list with the form at point (paredit M-r)."
  (ed-apply m (fn (b) (sexp/raise b key))))
(defcommand cmd-splice-sexp
  (m key)
  "Remove the enclosing list's delimiters, keeping its contents (paredit C-M-s)."
  (ed-apply m (fn (b) (sexp/splice b key))))
(defcommand cmd-wrap-round
  (m key)
  "Wrap the form at point in a fresh (…), point landing just inside (paredit M-()."
  (ed-apply m (fn (b) (sexp/wrap-round b key))))
(defcommand cmd-transpose-sexps
  (m key)
  "Interchange the s-expressions either side of point, point landing past both (C-M-t).
Point inside a form counts as being before it, so the chord mid-symbol swaps that symbol
with its predecessor — as it does in Emacs."
  (ed-apply m (fn (b) (sexp/transpose b key))))

(defn- ed-mark-by (m self move)
  "Mark the span from point to where `move` (a `buffer -> buffer` point move) lands,
leaving point where it is and activating the region so it highlights. When the previous
command was `self`, extend from the existing mark instead of from point — the
repeat-extends mechanism: each press grows the region by one more unit."
  (let (b (ed-current-buf m)
        extending (and (= (:last-command m) self) (buffer-mark b))
        from (or (and extending (buffer-mark b)) (buffer-point b))
        target (buffer-point (move (goto-char b from))))
    (ed-set-buf m (assoc b :mark target))))

(defcommand cmd-mark-sexp
  (m key)
  "Set the mark at the end of the next s-expression, leaving point — activating the
region so it highlights (Emacs `mark-sexp`, C-M-SPC). Pressed repeatedly it extends the
region by one more sexp each time (the mark advances; point stays put). With a negative
argument (`M-- C-M-SPC` / `C-- C-M-SPC`) it marks the *previous* sexp instead, via the
registered inverse (`cmd-mark-sexp-backward`). Marks by the STRICT sexp motion (never
past the enclosing list, unlike `C-M-f`, which steps out); in a tree-sitter mode it marks
a tree-sitter node."
  (ed-mark-by m
    'commands/cmd-mark-sexp
    (ed-structural-move key editor/treesit/point-forward sexp/forward)))

;; The inverse `cmd-mark-sexp` flips to under a negative argument: marks the PREVIOUS
;; sexp (the mark moves back from point), extending backward on repeat. A plain `defn`
;; (not a `defcommand`) — it isn't a standalone Emacs command, just the negative-arg
;; target the dispatcher resolves via `command-inverse`.
(defn cmd-mark-sexp-backward (m key)
  (ed-mark-by m
    'commands/cmd-mark-sexp-backward
    (ed-structural-move key editor/treesit/point-backward sexp/backward)))

;; ---- indentation (TAB / RET; sexp-aware via the mode's :indent service) -----
;; The mechanism is language-neutral: `ed-indent-target` asks the buffer's mode for
;; an `:indent` service (brood-mode supplies a sexp-aware one — see `modes`), and
;; falls back to matching the previous line. `ed-reindent-line` rewrites the line's
;; leading whitespace, preserving point. Emacs feel: TAB indents-or-completes, and
;; (in brood-mode) RET indents the new line.

(defn- ed-ws-char? (c) "True for an indentation char (space or tab)." (or (= c " ") (= c "\t")))

(defn- ed-leading-ws* (text i n)
  (if (and (< i (string/length text)) (ed-ws-char? (string/char-at text i)))
    (ed-leading-ws* text (inc i) (inc n))
    n))
(sig ed-leading-ws (string int -> int))
(defn- ed-leading-ws (text bol)
  "The count of leading spaces/tabs on the line starting at offset `bol`."
  (ed-leading-ws* text bol 0))

(sig ed-fallback-indent (string int -> int))
(defn- ed-fallback-indent (text bol)
  "The simple, mode-less indent for the line at `bol`: the leading-whitespace width
of the previous non-blank line, or 0 at the top. Tail-recursive over blank lines."
  (if (<= bol 0)
    0
    (let (prev-bol (ed-line-start-offset text (dec bol))
          content-len (- (dec bol) prev-bol)
          ws (ed-leading-ws text prev-bol))
      (if (>= ws content-len)
        ; previous line is empty / all whitespace — skip it
        (ed-fallback-indent text prev-bol)
        ws))))

(defn ed-indent-target (buf)
  "The column the current line should indent to: the buffer mode's `:indent` service
applied to the line start, else the previous-line fallback."
  (let (text (buffer-text buf)
        bol (buffer-point (beginning-of-line buf))
        svc (ed-mode-service buf :indent))
    (if (nil? svc) (ed-fallback-indent text bol) (svc text bol))))

(sig ed-reindent-line (buffer int -> buffer))
(defn ed-reindent-line (buf target)
  "Reindent the current line of `buf` to `target` columns of leading spaces,
preserving point: from inside the old indentation point moves to the first non-blank
char; from the body it shifts by the indent delta."
  (let (text (buffer-text buf)
        p (buffer-point buf)
        bol (buffer-point (beginning-of-line buf))
        cur (ed-leading-ws text bol)
        within (<= (- p bol) cur)
        b1 (replace-region buf bol (+ bol cur) (string/repeat " " target))
        newp (if within (+ bol target) (+ p (- target cur))))
    (goto-char b1 newp)))

(defcommand cmd-indent-line
  (m key)
  "Reindent the current line to the column its mode dictates — sexp-aware in
brood-mode, the previous line elsewhere (`M-x indent-line`)."
  (ed-edit m (fn (b) (ed-reindent-line b (ed-indent-target b)))))

;; ---- region indent / dedent (TAB / Shift-TAB on a selection) ----------------

(def ed-tab-width 2) ; columns Shift-TAB removes per dedent (brood indents by 2)
(defn- ed-region-lines (buf)
  "`[first last]` (0-based, inclusive) — the lines the active region spans, or nil. The
last line holds the last *selected* char, so a region ending at a line start doesn't pull
in that next (empty) line."
  (let (bnds (buffer-region-bounds buf))
    (if (nil? bnds)
      nil
      (let (rope (buffer-rope buf) [lo hi] bnds)
        [(text/char->line rope lo) (text/char->line rope (math/max lo (dec hi)))]))))

(sig ed-reselect-lines (buffer int int -> buffer))
(defn ed-reselect-lines (buf first last)
  "Re-activate the region to fully cover lines `[first, last]` (mark at the first line's
start, point at the start of the line after the last), so repeated TAB / Shift-TAB keep
acting on the same block."
  (let (rope (buffer-rope buf)
        n (buffer-line-count buf)
        start (text/line->char rope first)
        end (if (< (inc last) n) (text/line->char rope (inc last)) (buffer-length buf)))
    (assoc buf :point end :mark start)))

(defn- ed-fold-region-lines (buf first last f)
  "Apply `(f buf ln)` down lines `first..last`, coalescing every line's edit into ONE
undo step (amalgamate after the first). Leaves point/mark wherever `f` left them — the
caller decides (TAB re-selects the block; `indent-sexp` restores point)."
  (fold (range first (inc last)) buf (fn (b ln) (f (if (= ln first) b (amalgamate-undo b)) ln))))

(defn- ed-map-region-lines (buf first last f)
  "`ed-fold-region-lines`, then re-select lines `first..last` so repeated TAB / Shift-TAB
keep acting on the same block."
  (ed-reselect-lines (ed-fold-region-lines buf first last f) first last))

(sig ed-reindent-line-at (buffer int -> buffer))
(defn ed-reindent-line-at (buf ln)
  "Reindent line `ln` to its mode column (positions point at the line first so the shared
`ed-reindent-line` acts on it).

A BLANK line is emptied rather than indented. `newline-and-indent` wants the opposite —
pressing RET puts you at the right column on a line that is empty precisely because you
are about to type there — but reindenting an existing blank line to its block level only
writes trailing whitespace onto it. Invisible on screen, and every one of them is a line
in the diff: reindenting a `mix.exs` rewrote all three of its blank lines and nothing
else. So the rule is per CALLER, not per line: the indenter answers what the column is,
and a bulk reindent declines to put anything on a line with nothing on it."
  (let (b (goto-char buf (text/line->char (buffer-rope buf) ln))
        rope (buffer-rope b)
        from (text/line->char rope ln)
        to (math/min (text/length rope) (text/line->char rope (inc ln)))
        line (text/slice rope from to))
    (if (= (string/trim line) "")
      (ed-reindent-line b 0)
      (ed-reindent-line b (ed-indent-target b)))))

(sig ed-dedent-line-at (buffer int int -> buffer))
(defn ed-dedent-line-at (buf ln width)
  "Remove up to `width` leading spaces/tabs from line `ln`; a no-op on a line with none."
  (let (rope (buffer-rope buf)
        bol (text/line->char rope ln)
        drop-n (math/min width (ed-leading-ws (buffer-text buf) bol)))
    (if (= drop-n 0) buf (replace-region buf bol (+ bol drop-n) ""))))

(defcommand cmd-dedent
  (m key)
  "Shift-TAB: dedent — remove up to a tab-width of leading whitespace from the current
line, or from every line of the active region (one undo step, keeping the region)."
  (let (buf (ed-current-buf m) rl (ed-region-lines buf))
    (if (nil? rl)
      (ed-edit m (fn (b) (ed-dedent-line-at b (buffer-current-line b) ed-tab-width)))
      (let ([first last] rl)
        (ed-edit m
          (fn (b)
            (ed-map-region-lines b
              first
              last
              (fn (bb ln) (ed-dedent-line-at bb ln ed-tab-width)))))))))

(defcommand cmd-indent-sexp
  (m key)
  "Reindent every line of the s-expression after point (C-M-q) as one undo step — the
whole-form counterpart of TAB's single line. Point returns to the indentation of the
form's first line (Emacs holds point with a marker; landing on the reindented text is the
useful equivalent). A no-op when no form follows point."
  (let (buf (ed-current-buf m)
        rope (buffer-rope buf)
        point (buffer-point buf)
        end (buffer-point ((ed-structural-move key editor/treesit/point-forward sexp/forward) buf))
        first (text/char->line rope point))
    (if (<= end point)
      m
      (let (last (text/char->line rope (dec end)))
        (ed-edit m
          (fn (b)
            (let (nb (ed-fold-region-lines b first last ed-reindent-line-at))
              (back-to-indentation (goto-char nb (text/line->char (buffer-rope nb) first))))))))))

(defn ed-vim-command-mode? (m)
  "True while a modal profile holds the keyboard in a COMMAND state — vim `:normal`
or `:visual`, where a plain key means a command and **nothing types**. The guard a
mode-local EDITING binding needs: a buffer's mode layer outranks the model's
profile (that's what makes modes work), so a mode that binds an editing key —
brood-mode's RET-inserts-and-indents, the tutorial's — would otherwise fire it in
normal mode and type behind the user's back. Emacs has no modal state, so this is
false there and the binding behaves exactly as before."
  (includes? [:normal :visual] (:edit-state m)))

(defcommand cmd-newline-and-indent
  (m key)
  "Enter in a structured mode: insert a newline, then indent the new line to its
mode's column (Emacs `newline-and-indent`). Under a modal profile's command state
RET is a **motion** (down a line, as in vim) rather than an edit — see
`ed-vim-command-mode?`: this command is bound by MODE layers (brood-mode, the
tutorial), which outrank the vim profile, so the check has to live here."
  (if (ed-vim-command-mode? m)
    (cmd-next-line m key)
    (ed-edit m
      (fn (b)
        (let (nb (insert b "\n"))
          (ed-reindent-line nb (ed-indent-target nb)))))))

(defcommand cmd-indent-or-complete
  (m key)
  "TAB: with an active region, reindent every line in it to its mode column (one undo,
keeping the region selected). Otherwise reindent the current line; if it's already at the
right indent and point sits on a symbol, complete instead (Emacs `tab-always-indent` =
`'complete`)."
  (let (buf (ed-current-buf m)
        rl (ed-region-lines buf))
    (if rl
      (let ([first last] rl)
        (ed-edit m (fn (b) (ed-map-region-lines b first last ed-reindent-line-at))))
      (let (text (buffer-text buf)
            bol (buffer-point (beginning-of-line buf))
            cur (ed-leading-ws text bol)
            p (buffer-point buf)
            target (ed-indent-target buf))
        (if (and (= cur target)
              (> p (+ bol cur))
              (complete-word-char? (string/char-at text (dec p))))
          (cmd-complete m key)
          (ed-edit m (fn (b) (ed-reindent-line b target))))))))

;; ---- screenful scrolling (C-v / M-v, PageDown / PageUp) ---------------------
;; A "page" is the viewport height less one line of overlap. `ed-update` stashes
;; the live viewport height on the model as `:view-rows`, so these stay correct
;; across a pane resize (10 is a fallback for a model built outside the loop).

(sig ed-page-step (model -> int))
(defn ed-page-step (m)
  "Lines a screenful scroll moves: the viewport height (`:view-rows`) less one
line of overlap; at least 1."
  (math/max 1 (dec (or (:view-rows m) 10))))

(sig ed-scroll-page (model int -> model))
(defn ed-scroll-page (m n)
  "Scroll the selected pane by `n` lines (negative = up), moving point with it so its
**screen row is preserved** (Emacs `scroll-preserve-screen-position`): point and `:top`
shift by the same amount (clamped at the buffer's last line), so the text under point
stays put on screen rather than the cursor jumping to an edge."
  (let (b (ed-current-buf m)
        l0 (buffer-current-line b)
        b2 (forward-line b n)
        dl (- (buffer-current-line b2) l0) ; actual lines moved (clamps near edges)
        top (ed-current-top m))
    (ed-set-top (ed-set-buf m b2) (math/max 0 (+ top dl)))))

(defcommand cmd-scroll-up
  (m key)
  "Scroll forward a screenful (C-v / PageDown): point and view move down together,
keeping a line of overlap and point's screen position. (Emacs `scroll-up-command`.)"
  (ed-scroll-page m (ed-page-step m)))

(defcommand cmd-scroll-down
  (m key)
  "Scroll back a screenful (M-v / PageUp): point and view move up together, keeping a
line of overlap and point's screen position. (Emacs `scroll-down-command`.)"
  (ed-scroll-page m (- (ed-page-step m))))

;; ---- recenter & window-line motion (C-l, M-r) -------------------------------
;; Both cycle on consecutive presses via `:last-command` (the Emacs mechanism). Their
;; targets respect the scroll margin so the post-command `ed-scroll` clamp leaves them
;; put (a "top" that sat at row 0 would otherwise be pulled back down by the margin).

(defn- ed-cycle-pos (m self field)
  "The next position 0/1/2 in a 3-way cycle for a repeated command: advance the stored
`field` when the previous command was `self` (a quoted command symbol), else restart 0."
  (let (pos (get m field 0))
    (if (and (= (:last-command m) self) (int? pos)) (math/mod (inc pos) 3) 0)))

(defcommand cmd-recenter
  (m key)
  "Scroll so point sits at the middle of the window, then the top, then the bottom on
successive presses (Emacs `recenter-top-bottom`, C-l). Targets honour the scroll
margin; the view moves, point does not."
  (let (rows (or (:view-rows m) 10)
        mgn (ed-margin rows)
        pos (ed-cycle-pos m 'commands/cmd-recenter :recenter-cycle)
        row (cond (= pos 0) (math/quot rows 2) (= pos 1) mgn :else (- rows 1 mgn))
        line (buffer-current-line (ed-current-buf m)))
    (assoc (ed-set-top m (math/max 0 (- line row))) :recenter-cycle pos)))

(defcommand cmd-move-to-window-line
  (m key)
  "Move point to the top visible line, then the middle, then the bottom on successive
presses (Emacs `move-to-window-line-top-bottom`, M-r). Targets honour the scroll
margin; point moves, the view does not."
  (let (rows (or (:view-rows m) 10)
        mgn (ed-margin rows)
        buf (ed-current-buf m)
        ;; the line the window's first row SHOWS (`panes/ed-pane-view-top`: the scroll
        ;; top plus one while a glide rests past half a cell) — the row→line geometry is
        ;; the pane's to answer, never re-derived from `:top` here
        vtop (ed-payload-view-top (ed-current-pane m) buf)
        last (math/max 0 (dec (buffer-line-count buf)))
        pos (ed-cycle-pos m 'commands/cmd-move-to-window-line :mwl-cycle)
        target (cond
                 (= pos 0) (+ vtop mgn)
                 (= pos 1) (+ vtop (math/quot rows 2))
                 :else (- (+ vtop rows) 1 mgn))
        line (math/min last (math/max vtop target)))
    (assoc (ed-set-buf m (forward-line buf (- line (buffer-current-line buf)))) :mwl-cycle pos)))

;; ---- paragraph / sentence / indentation motion (M-{ M-} · M-a M-e · M-m) -----
;; All three are `std/editor/buffer` primitives — the text-level motions live next to
;; `forward-word` in the toolkit, so these commands are one `ed-apply` each.

(defcommand cmd-forward-paragraph (m key) (ed-apply m forward-paragraph))
(defcommand cmd-backward-paragraph (m key) (ed-apply m backward-paragraph))
(defcommand cmd-forward-sentence
  (m key)
  "To the end of the sentence (M-e); the paragraph's end when none follows."
  (ed-apply m forward-sentence))
(defcommand cmd-backward-sentence
  (m key)
  "To the start of the sentence (M-a); the paragraph's start when none precedes."
  (ed-apply m backward-sentence))
(defcommand cmd-back-to-indentation
  (m key)
  "To the first non-whitespace character of the line, skipping its indent (M-m)."
  (ed-apply m back-to-indentation))

;; ---- editing ----------------------------------------------------------------

(defcommand cmd-self-insert
  (m key)
  "Insert the typed character `key` (a 1-char string) at point."
  (ed-edit m (fn (b) (insert b key))))

(defcommand cmd-close-delimiter
  (m key)
  "Type the closing delimiter `key` — or, when the one already at point closes the form you
are in, move over it instead of typing a second (`editor/highlight/closer-redundant?`).

Emacs's `electric-pair-mode` skip, and paredit's `close-round`: with point at `(+ 1 2|)`,
typing `)` gives you `(+ 1 2)|` rather than `(+ 1 2))`. The condition is about the enclosing
FORM, not the next character, which is what keeps it from eating a delimiter you meant — at
top level a stray `)` closes nothing and is typed, `[1 2|)` is a mismatch and is typed, and
inside a string or a comment a bracket is a character and is typed. Bound on brood-keymap
only: the scan reads Brood syntax (`;` comments, `\"` strings), which is not Ruby's."
  (let (b (ed-current-buf m))
    (if (and b (editor/highlight/closer-redundant? (buffer-text b) (buffer-point b) key))
      (ed-apply m (fn (bb) (goto-char bb (inc (buffer-point bb)))))
      (cmd-self-insert m key))))

;; ---- electric brackets (brood-mode) ------------------------------------------
;; Two behaviours behind the bracket keys, split the way Emacs splits them:
;;  - an opener typed over an ACTIVE REGION wraps the region (`sexp/wrap-region`) —
;;    always, since a selection plus a bracket has exactly one meaning;
;;  - otherwise, with `electric-pair-mode` on (the default), an opener types its pair
;;    and lands inside (`insert-pair`), a closer already there is stepped over
;;    (`cmd-close-delimiter`, above), and a backspace between an empty pair takes both
;;    (`delete-empty-pair`) — so what one key put there, one key takes away.
;; `M-x electric-pair-mode` toggles the second half; `(config :electric-pair false)`
;; starts with it off. The mechanism is std's (`sexp/wrap-region`, `editor/buffer`'s
;; `insert-pair` / `delete-empty-pair`); this is the policy.
(def *bracket-pairs* {"(" ")" "[" "]" "{" "}"})

;; Self-closing pairs — a delimiter whose opener and closer are the SAME character, so one
;; key both opens and (typed again) skips over the close. `"` is the one that earns this in
;; a Brood editor: it opens a string and lands you inside. `'` is deliberately NOT here —
;; in Brood `'` is the quote operator (`'foo`) and in prose an apostrophe (`don't`), so
;; auto-pairing it fights the writer; Emacs inhibits it heuristically for the same reason.
;; A different mode may bind `'` to `cmd-open-delimiter` where it is a real pair.
(def *self-pairs* {"\"" "\""})

(sig delim-close (string -> (or nil string)))
(defn delim-close (key)
  "The closer for opening delimiter `key` — a bracket (`(`→`)`) or a self-closing quote
(`\"`→`\"`), or nil for anything that is not an electric opener."
  (or (get *bracket-pairs* key) (get *self-pairs* key)))

(sig electric-pair? (model -> bool))
(defn electric-pair? (m)
  "Whether electric-pair-mode is on — the model's `:electric-pair?`, default true."
  (let (on (:electric-pair? m)) (if (nil? on) true (= on true))))

(defn- self-pair-should-open? (b key)
  "For a self-closing delimiter (`\"`): open a fresh pair only where a quote plausibly
STARTS one — at the buffer edge, after whitespace, or right after an opening bracket. After
a word or another quote it self-inserts instead, which is how you close a string you typed
by hand (`\"hello world|` + `\"` → `\"hello world\"`, not a new empty pair)."
  (let (before (buffer-char-before b))
    (or (nil? before)
      (string/blank? before)
      (not (nil? (get *bracket-pairs* before))))))

(defcommand cmd-open-delimiter
  (m key)
  "Type the opening delimiter `key`. Over an active region, wrap the region in the pair
(point lands inside the opener). For a self-closing quote already at point, step over it
(one `\"` closes the string rather than typing a second). Otherwise, with
electric-pair-mode on, type the pair and land between — a quote only where one plausibly
opens ([[self-pair-should-open?]]); else just the character. Bound to `(` `[` `{` `\"` on
brood-keymap."
  (let (close (delim-close key)
        b (ed-current-buf m)
        self? (= key close))
    (cond
      (nil? close) (cmd-self-insert m key)
      (buffer-region-bounds b) (ed-edit m (fn (bb) (sexp/wrap-region bb key close)))
      ;; a self-closing quote sitting at point: skip over it instead of doubling it
      (and self? (= (buffer-char-after b) key))
        (ed-apply m (fn (bb) (goto-char bb (inc (buffer-point bb)))))
      (and (electric-pair? m) (or (not self?) (self-pair-should-open? b key)))
        (ed-edit m (fn (bb) (insert-pair bb key close)))
      else (cmd-self-insert m key))))

(defcommand cmd-electric-backspace
  (m key)
  "Backspace — and, with electric-pair-mode on and point between an empty pair (`(|)`),
delete both delimiters. Bound to Backspace on brood-keymap; plain `cmd-delete-backward`
everywhere else."
  (if (electric-pair? m)
    (ed-edit m
      (fn (b)
        (let (before (buffer-char-before b))
          (if (nil? before)
            (delete-backward-char b)
            (let (close (delim-close before))
              (if (and close (= (buffer-char-after b) close))
                (delete-empty-pair b before close)
                (delete-backward-char b)))))))
    (cmd-delete-backward m key)))

(defcommand cmd-electric-pair-mode
  (m key)
  "Toggle electric-pair-mode: whether an opening bracket types its pair and a backspace
between an empty pair takes both. Wrapping a selection with a bracket is not affected —
that has one meaning either way."
  (let (on (not (electric-pair? m)))
    (message (assoc m :electric-pair? on)
      (if on "Electric pair mode enabled" "Electric pair mode disabled"))))

;; ---- rectangles (Emacs C-x r k/M-w/d/y/o/c/t) --------------------------------
;; The column-block editing ops of `editor/buffer` (`extract`/`delete`/`open`/`clear`/
;; `string`/`insert-rectangle`), wired to the `C-x r` prefix and a rectangle kill ring on
;; the model. A rectangle is point↔mark taken as two corners, so every one needs a mark.
;; The kill ring is ONE saved list of rows (`:rectangle-kill`), not the line kill ring: a
;; rectangle yank rebuilds the block, so its rows must stay a list, never flattened.

(defn- ed-rect-edit (m f)
  "Run rectangle op `f` (a `buffer -> buffer`) on the current buffer, or say there is no
region when no mark is set — every rectangle op needs two corners."
  (if (nil? (buffer-mark (ed-current-buf m))) (message m *no-region-message*) (ed-edit m f)))

(defcommand cmd-kill-rectangle
  (m key)
  "Kill the rectangle (C-x r k): save its rows to the rectangle kill ring and delete the
block, closing the gap. Yank it back with C-x r y."
  (if (nil? (buffer-mark (ed-current-buf m)))
    (message m *no-region-message*)
    (let (rows (extract-rectangle (ed-current-buf m)))
      (message (ed-edit (assoc m :rectangle-kill rows) delete-rectangle)
        (str "killed a " (count rows) "-row rectangle")))))

(defcommand cmd-copy-rectangle-as-kill
  (m key)
  "Copy the rectangle to the rectangle kill ring without deleting it (C-x r M-w)."
  (if (nil? (buffer-mark (ed-current-buf m)))
    (message m *no-region-message*)
    (let (rows (extract-rectangle (ed-current-buf m)))
      (message (assoc m :rectangle-kill rows) (str "copied a " (count rows) "-row rectangle")))))

(defcommand cmd-delete-rectangle
  (m key)
  "Delete the rectangle without saving it (C-x r d)."
  (ed-rect-edit m delete-rectangle))

(defcommand cmd-open-rectangle
  (m key)
  "Shift the rectangle's text right, blanking the block with spaces (C-x r o)."
  (ed-rect-edit m open-rectangle))

(defcommand cmd-clear-rectangle
  (m key)
  "Blank the rectangle in place, keeping following columns put (C-x r c)."
  (ed-rect-edit m clear-rectangle))

(defcommand cmd-yank-rectangle
  (m key)
  "Insert the last killed/copied rectangle as a block at point (C-x r y)."
  (let (rows (:rectangle-kill m))
    (if (or (nil? rows) (empty? rows))
      (message m "the rectangle kill ring is empty")
      (ed-edit m (fn (b) (insert-rectangle b rows))))))

(defcommand cmd-string-rectangle
  (m key)
  "Replace each line's block with a string read in the minibuffer (C-x r t)."
  (if (nil? (buffer-mark (ed-current-buf m)))
    (message m *no-region-message*)
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "String rectangle: " "")
         :on-complete (fn (mm t) (ed-edit mm (fn (b) (string-rectangle b t))))})))

(defcommand cmd-newline (m key) (ed-edit m (fn (b) (insert b "\n"))))
(defcommand cmd-delete-char (m key) (ed-edit m delete-char))
(defcommand cmd-delete-backward (m key) (ed-edit m delete-backward-char))

;; ---- line / word editing (open-line, kill-line/word, transpose, case) -------

;; ---- the kill ring (Emacs-style: coalesce consecutive kills; M-y yank-pops) --
;; The model tracks `:last-command`/`:this-command` (set by the dispatch loop, see
;; `input`) so a kill knows whether the *previous* command was also a kill (then it
;; appends to the head entry rather than starting a new one), and so M-y
;; (`cmd-yank-pop`) only fires right after a yank.
;; Commands whose consecutive use coalesces into one kill-ring entry (like Emacs).
;; Every command that kills, so consecutive kills coalesce into one entry (Emacs
;; `kill-append`). `cmd-copy-region` is here on purpose: Emacs's copy-region-as-kill appends
;; after a kill too. A kill command left off this list silently starts a new entry —
;; `M-k M-k` used to leave two sentences on the ring instead of one.
(def- ed-kill-commands
  '(commands/cmd-kill-region commands/cmd-copy-region
     commands/cmd-kill-line commands/cmd-kill-word commands/cmd-backward-kill-word
     commands/cmd-kill-whole-line commands/cmd-sexp-kill commands/cmd-kill-sentence
     commands/cmd-backward-kill-sentence commands/cmd-kill-sexp commands/cmd-backward-kill-sexp
     commands/cmd-zap-to-char))
(def- ed-yank-commands '(commands/cmd-yank commands/cmd-yank-pop))

;; Cap the ring like Emacs's `kill-ring-max` (default 60) so it can't grow forever.

(defn- ed-kill-command? (sym) (includes? ed-kill-commands sym))
(defn- ed-yank-command? (sym) (includes? ed-yank-commands sym))

(defn ed-push-kill (m text forward?)
  "Push killed `text` onto the kill ring. If the previous command was also a kill,
**append** to the current head entry instead of starting a new one — at the end for
a forward kill, the front for a backward kill (Emacs's consecutive-kill coalescing).
Otherwise cons a fresh entry. The new ring head is also mirrored to the OS clipboard
(`os/clipboard-set`, itself a no-op without a clipboard) so every kill / copy is system-wide — Emacs's
`interprogram-cut-function` / `select-enable-clipboard`; `cmd-yank` reads it back."
  (let (ring (:kill-ring m)
        coalesce? (and (ed-kill-command? (:last-command m)) (not (empty? ring)))
        head (if coalesce?
               (if forward? (str (first ring) text) (str text (first ring)))
               text)
        tail (if coalesce? (rest ring) ring))
    ;; `os/clipboard-set` is itself a no-op without a clipboard, so nothing here is guarded:
    ;; a stale name must raise, not leave every kill un-mirrored.
    (when (:os-clipboard m) (os/clipboard-set head))
    (assoc m :kill-ring (take (cons head tail) ed-kill-ring-max))))

(defn ed-drag-copy (m)
  "Emacs `mouse-drag-copy-region`: when a mouse drag-select ends with a real region,
copy it to the kill ring — and thus the OS clipboard (`ed-push-kill`) — WITHOUT clearing
it, so releasing a highlight makes it immediately paste-able in any buffer, read-only or
not. Silent (no echo — a drag shouldn't spam the echo area). A plain click selects
nothing, so it's a no-op. Coalescing is suppressed (`:last-command` cleared) so the
selection is its own entry, never appended to a prior kill."
  (let (text (buffer-region (ed-current-buf m)))
    (if (nil? text) m (ed-push-kill (assoc m :last-command nil) text true))))

(defn ed-kill-span (m move)
  "Kill from point to where `move` (a `buffer -> buffer` point move) lands: push
the spanned text onto the kill ring (coalescing with an adjacent kill) and delete
it. An empty span is a no-op. A buffer that refuses the delete (read-only) says so and
the kill ring is left alone — nothing was killed."
  (let (b (ed-current-buf m)
        p0 (buffer-point b)
        moved (move (set-mark b)) ; mark = point; point moves
        text (buffer-region moved))
    (if (or (nil? text) (= text ""))
      m
      (let ([m2 killed?] (ed-try-edit m (fn (_) (clear-mark (delete-region moved)))))
        (if killed? (ed-push-kill m2 text (> (buffer-point moved) p0)) m2)))))

(defn ed-capitalize (s)
  "`s` with its first character upper-cased and the rest lower-cased."
  (if (= s "")
    s
    (str (string/upper (string/substring s 0 1))
      (string/lower (string/substring s 1 (string/length s))))))

(defn ed-xform-word (m f)
  "Apply the string transform `f` to the word from point forward, leaving point
after it (M-u / M-l / M-c)."
  (let (b (ed-current-buf m)
        p (buffer-point b)
        e (buffer-point (forward-word b))
        word (buffer-region (assoc b :mark p :point e)))
    (if (or (nil? word) (= word ""))
      m
      (ed-edit m (fn (bb) (replace-region bb p e (f word)))))))

;; open lines — C-o keeps point, M-o opens below, M-O opens above
(defcommand cmd-open-line
  (m key)
  "Insert a newline after point, leaving point (C-o)."
  (ed-edit m (fn (b) (backward-char (insert b "\n")))))
(defcommand cmd-open-line-below
  (m key)
  "Open a new line below and move there (M-o)."
  (ed-edit m (fn (b) (insert (end-of-line b) "\n"))))
(defcommand cmd-open-line-above
  (m key)
  "Open a new line above and move there (M-O)."
  (ed-edit m (fn (b) (backward-line (insert (beginning-of-line b) "\n")))))

;; kill (into the kill ring)
(defcommand cmd-kill-line
  (m key)
  "Kill from point to end of line (C-k); at end of line, kill the newline."
  (ed-kill-span m (if (= (buffer-char-after (ed-current-buf m)) "\n") forward-char end-of-line)))
(defcommand cmd-sexp-kill
  (m key)
  "Structure-aware kill (paredit C-k): kill to end of line, but never past the
enclosing list's close delimiter, so it can't break the parens. Reuses the kill ring."
  (ed-kill-span m (fn (b) (goto-char b (sexp/point-kill-end (buffer-text b) (buffer-point b))))))
(defcommand cmd-kill-word (m key) "Kill the word after point (M-d)." (ed-kill-span m forward-word))
(defcommand cmd-backward-kill-word
  (m key)
  "Kill the word before point (M-DEL)."
  (ed-kill-span m backward-word))
(defcommand cmd-kill-sentence
  (m key)
  "Kill from point to the end of the sentence (M-k)."
  (ed-kill-span m forward-sentence))
(defcommand cmd-backward-kill-sentence
  (m key)
  "Kill from point back to the start of the sentence (C-x DEL)."
  (ed-kill-span m backward-sentence))
(defcommand cmd-kill-whole-line
  (m key)
  "Kill the whole current line, newline included."
  (ed-kill-span (ed-apply m beginning-of-line) (fn (b) (forward-char (end-of-line b)))))

;; transpose / duplicate / join
(defcommand cmd-transpose-chars
  (m key)
  "Swap the two characters around point and move forward (C-t). At the end of a line —
or of the buffer — there is no character after point worth swapping with, so it swaps the
two BEFORE point instead, as Emacs does: `ab|` becomes `ba|`, where swapping around point
dragged the newline into the line."
  (ed-edit m
    (fn (b)
      (let (p (buffer-point b)
            after (buffer-char-after b))
        (cond
          (and (or (nil? after) (= after "\n")) (>= p 2))
            (replace-region b
              (- p 2)
              p
              (str (buffer-char-before b) (text/slice (buffer-rope b) (- p 2) (dec p))))
          (and (>= p 1) (not (nil? after)))
            (replace-region b (dec p) (inc p) (str after (buffer-char-before b)))
          :else b)))))
(defn ed-transpose-words (b)
  "Swap the word before point with the word after it, leaving point after the second
(M-t). A no-op when point isn't between two words."
  (let (e2 (buffer-point (forward-word b))
        s2 (buffer-point (backward-word (goto-char b e2)))
        s1 (buffer-point (backward-word (goto-char b s2)))
        e1 (buffer-point (forward-word (goto-char b s1))))
    (if (and (>= s1 0) (< s1 e1) (<= e1 s2) (< s2 e2))
      (let (txt (buffer-text b))
        (goto-char (replace-region b
                     s1
                     e2
                     (str (string/substring txt s2 e2)
                       (string/substring txt e1 s2)
                       (string/substring txt s1 e1)))
          e2))
      b)))

(defn ed-transpose-lines (b)
  "Swap the current line with the previous one (C-x C-t), leaving point at the start of
the line AFTER the pair — so pressing it again drags the same line further down, as in
Emacs (leaving point on the pair made a second press swap them straight back). A no-op on
the first line."
  (let (cur (buffer-current-line b))
    (if (< cur 1)
      b
      (let (pv (ed-strip-newline (buffer-line-at b (dec cur)))
            cv (ed-strip-newline (buffer-line-at b cur))
            s0 (buffer-point (beginning-of-line (backward-line b))) ; start of the previous line
            span-end (+ s0 (string/length pv) 1 (string/length cv)))
        (forward-line (forward-line (goto-char (replace-region b s0 span-end (str cv "\n" pv)) s0)))))))

(defcommand cmd-transpose-words
  (m key)
  "Transpose the word before point with the one after it (M-t)."
  (ed-edit m ed-transpose-words))
(defcommand cmd-transpose-lines
  (m key)
  "Transpose the current line with the previous one (C-x C-t)."
  (ed-edit m ed-transpose-lines))

(defcommand cmd-duplicate-line
  (m key)
  "Duplicate the current line below it (M-x duplicate-line — C-x d is dired, as in Emacs)."
  (ed-edit m
    (fn (b)
      (let (lt (buffer-line-at b (buffer-current-line b)))
        (insert (beginning-of-line b) (if (string/ends-with? lt "\n") lt (str lt "\n")))))))
(defcommand cmd-join-line
  (m key)
  "Join this line to the one ABOVE, collapsing its indentation to a single space —
Emacs `delete-indentation` (M-^). With a region active, join every line in it, which
is how you pull a wrapped paragraph back onto one line in one stroke (Emacs 29).

This used to delete the newline at END of line, joining the NEXT line up into this one
— Vim's `J`, the opposite direction — so the line under point never moved. The seam
rule (one space, but none next to a delimiter) lives in `editor/buffer/join-line`."
  (let (b (ed-current-buf m) region-bounds (buffer-region-bounds b))
    (if (nil? region-bounds)
      (ed-edit m join-line)
      ;; bottom-up: joining shifts everything below the seam, so walking downward would
      ;; invalidate the line numbers we still have to visit
      (let ([first-line last-line] (region-line-range b))
        (ed-edit m
          (fn (bb)
            ;; `ed-goto-line-col` is 0-based, matching `region-line-range`; the 1-based
            ;; `ed-goto-line` would silently join one line short of the region's end
            (fold (reverse (range (inc first-line) (inc last-line)))
              bb
              (fn (acc line) (join-line (ed-goto-line-col acc line 0))))))))))

;; case
(defcommand cmd-upcase-word (m key) (ed-xform-word m string/upper))
(defcommand cmd-downcase-word (m key) (ed-xform-word m string/lower))
(defcommand cmd-capitalize-word (m key) (ed-xform-word m ed-capitalize))

;; ---- case the region (C-x C-u / C-x C-l) ------------------------------------

(def *no-region-message* "no region (set the mark with C-SPC first)")

(defn ed-xform-region (m f)
  "Apply string transform `f` to the active region in place; a no-op-with-message
when there's no region (the region case commands)."
  (let (b (ed-current-buf m) bounds (buffer-region-bounds b))
    (if (nil? bounds)
      (message m *no-region-message*)
      (let (txt (f (buffer-region b)))
        (ed-edit m (fn (bb) (replace-region bb (first bounds) (second bounds) txt)))))))

(defcommand cmd-upcase-region
  (m key)
  "Upper-case the region (C-x C-u)."
  (ed-xform-region m string/upper))
(defcommand cmd-downcase-region
  (m key)
  "Lower-case the region (C-x C-l)."
  (ed-xform-region m string/lower))

;; ---- whitespace around point (M-SPC / M-\) ----------------------------------

(defn ed-collapse-ws (m seq/keep)
  "Replace the run of spaces/tabs surrounding point with `keep` (`\" \"` for
just-one-space M-SPC, `\"\"` for delete-horizontal-space M-\\) — `editor/buffer`'s
`collapse-whitespace`, which `join-line` squeezes its seam with too."
  (ed-edit m (fn (b) (collapse-whitespace b seq/keep))))

(defcommand cmd-just-one-space
  (m key)
  "Collapse the whitespace around point to a single space (Emacs `just-one-space`;
M-SPC runs `cmd-cycle-spacing`, whose first press is exactly this)."
  (ed-collapse-ws m " "))

;; `cycle-spacing` — what M-SPC does in a modern Emacs (29 took the key from
;; `just-one-space`). One key, pressed repeatedly, walks the three answers you might
;; want for the gap you are standing in: ONE space, then NONE, then *what was there* —
;; so an over-eager squeeze is undone by pressing the same key again rather than by
;; remembering an undo. The cycle restarts wherever the previous command wasn't this one,
;; which is what makes it feel like a per-gap toggle instead of a global mode.
;;
;; The restore step is why this needs state: the original run and where point stood in it
;; are gone from the buffer after the first press. Both ride the model (`:cycle-spacing`),
;; keyed by the position the run starts at, so a stale stash can never apply to a
;; different gap.

(def- ed-cycle-spacing-phases [:one-space :none :restore])

(defn- ed-cycle-spacing-next (st lo)
  "The phase for this press: the one after `st`'s, or the first when there is no live
stash for the run at `lo` (a different gap, or a different command in between)."
  (if (or (nil? st) (not (= (:lo st) lo)))
    :one-space (let (i (index-of ed-cycle-spacing-phases (:phase st)))
      ;; past the end it starts over, so holding the key keeps cycling
      (nth ed-cycle-spacing-phases (math/rem (inc (or i 0)) (count ed-cycle-spacing-phases))))))

(defcommand cmd-cycle-spacing
  (m key)
  "Cycle the whitespace around point (M-SPC): one space, then none, then what was
there before you started — Emacs 29's `cycle-spacing`, which replaced `just-one-space`
on this key. Pressing any other command in between starts the cycle fresh.

The restore step puts the run back exactly, point included, so M-SPC is safe to lean
on: nothing you cycle through is lost."
  (let (b (ed-current-buf m)
        [lo hi] (editor/buffer/whitespace-run-at b)
        st (when (= (:last-command m) 'commands/cmd-cycle-spacing) (:cycle-spacing m))
        phase (ed-cycle-spacing-next st lo)
        ;; the run as it stood when the cycle began — captured on the first press,
        ;; carried unchanged after that (the buffer no longer holds it)
        orig (if (= phase :one-space)
               {:text (string/substring (buffer-text b) lo hi) :offset (- (buffer-point b) lo)}
               (:orig st))
        stash {:phase phase :lo lo :orig orig})
    (assoc (if (= phase :restore)
             ;; back to the original text AND the original point inside it
             (ed-edit m
               (fn (bb)
                 (let ([l h] (editor/buffer/whitespace-run-at bb)
                       o (or orig {:text "" :offset 0}) ; set on the first press; never absent here
                       restored (replace-region bb l h (:text o)))
                   (goto-char restored (+ l (:offset o))))))
             (ed-collapse-ws m (if (= phase :one-space) " " "")))
      :cycle-spacing stash)))
(defcommand cmd-delete-horizontal-space
  (m key)
  "Delete all whitespace around point (M-\\)."
  (ed-collapse-ws m ""))

;; (cycle-spacing's stash lives on the model as `:cycle-spacing`; nothing else reads it,
;; and `:last-command` is what decides whether it is still live.)

;; ---- fill-paragraph (M-q) ---------------------------------------------------
;; The line-breaking itself is `string/fill` — a general `string -> string`
;; word-wrap, no editor dependency, promoted out of here so the REPL / doc tools can
;; share it. This command is just the editor *policy*: find the paragraph, wrap it, put
;; it back (preserving the trailing blank-line separation).

(defdyn *fill-column* 70)

(defcommand cmd-fill-paragraph
  (m key)
  "Re-wrap the paragraph around point to `*fill-column*` (M-q), preserving the blank-line
separation after it. The paragraph's prefix — its indentation and a comment or quote marker
(`string/fill-prefix`) — is kept on every line: without it, `;; aa` / `;; bb` came back as
`;; aa ;; bb` and an indented paragraph lost its indentation."
  (ed-edit m
    (fn (b)
      (let (s (buffer-point (backward-paragraph b))
            e (buffer-point (forward-paragraph (goto-char b s)))
            para (buffer-region (assoc b :mark s :point e)))
        (if (or (nil? para) (= para ""))
          b
          (let (
                ;; the prefix as the paragraph's first non-blank line spells it
                first-line (first (seq/reject (string/split para "\n")
                                    (fn (l) (= (string/trim l) ""))))
                filled (string/fill para *fill-column* (string/fill-prefix (or first-line ""))))
            (replace-region b s e (if (string/ends-with? para "\n") (str filled "\n") filled))))))))

;; ---- read-only toggle / spit / revert (C-x C-q / C-x C-w / revert) ----

(defcommand cmd-toggle-read-only
  (m key)
  "Toggle the current buffer's read-only flag (C-x C-q)."
  (let (b (ed-current-buf m))
    (assoc (ed-set-buf m (set-read-only b (not (read-only? b))))
      :echo (if (read-only? b) "writable" "read-only")))) ; report the NEW state
(defcommand cmd-write-file
  (m key)
  "Write the buffer to a path read in the minibuffer (C-x C-w); the buffer is then backed
by that path (future C-x C-s saves there). Uses the same shared path prompt as find-file /
dired (`ed-path-prompt`) — prefilled with the current file's path (else the current dir).
A hex view is refused: its text renders the binary, it is not the binary."
  (if (= (editor/layers/buffer-type-for (ed-current-buf m)) :hexl)
    (message m "a hex view is not written (it renders the binary; edit the file itself)")
    (assoc m
      :minibuffer
        (ed-path-prompt "Write file: "
          (or (buffer-file (ed-current-buf m)) (str (ed-default-dir m) "/"))
          (if (:recent-files m) (recent-files) [])
          (fn (mm t)
            (let (path (path/absolute t)
                  old-file (buffer-file (ed-current-buf mm))
                  old-key (hosted/hosted-key (ed-current-buf mm)))
              (try
                (let (b (assoc (ed-current-buf mm)
                          :file path
                          :name (file-display-name path (ed-project-root mm))))
                  ;; keep what save-buffer returns: it is unmodified AND stamped with the
                  ;; new file's mtime (dropping it left a stale stamp -> a false
                  ;; "changed on disk" on the next save)
                  (let (b2 (save-buffer b)
                        as-path (when old-file (ed-auto-save-path old-file))
                        ;; a shared buffer is now a different document: the registry
                        ;; entry (and every other frame's copy) follows it
                        m2 (hosted/hosted-rekey-slot (dissoc (ed-set-buf mm b2) :status)
                             (ed-current-index mm)
                             old-key))
                    (when (and as-path (file/exists? as-path))
                      (try
                        (file/rm as-path)
                        (catch e
                          (log/warn (str "could not remove auto-save "
                                      as-path
                                      ": "
                                      (error-message e))))))
                    (message m2 (str "wrote " path))))
                (catch e (message mm (str "write failed: " (error-message e)))))))))))

(defcommand cmd-revert-buffer
  (m key)
  "Re-read the current buffer from its file on disk, discarding unsaved changes
(M-x revert-buffer). Point is kept (clamped to the new length); undo history resets."
  (let (b (ed-current-buf m) f (buffer-file b))
    (if (nil? f)
      (message m "no file to revert")
      (try
        (message (ed-revert-at m (ed-current-index m)) (str "reverted " f))
        (catch e (message m (str "revert failed: " (error-message e))))))))

;; ---- keyboard macros (C-x ( / C-x ) / C-x e) --------------------------------
;; Recording captures raw input events into `:macro-recording` (the capture happens in
;; `input/ed-update`, which sees every event); `:macro-last` holds the finished macro and
;; `:run-macro` asks `ed-update` to replay it by re-feeding the events. Emacs C-x (/)/e.

(defcommand cmd-start-kbd-macro
  (m key)
  "Start recording a keyboard macro (C-x (): subsequent keys are captured until C-x )."
  (assoc m :macro-recording [] :echo "Recording keyboard macro…"))

(defcommand cmd-end-kbd-macro
  (m key)
  "Finish recording the keyboard macro (C-x )); it becomes the last macro for C-x e."
  (let (rec (:macro-recording m))
    (if (nil? rec)
      (message m "not currently defining a keyboard macro")
      ;; drop the trailing `C-x )` that invoked this command (recorded before dispatch)
      (message (assoc (dissoc m :macro-recording)
                 :macro-last (take rec (math/max 0 (- (count rec) 2))))
        "Keyboard macro defined"))))

(defcommand cmd-execute-kbd-macro
  (m key)
  "Execute the last keyboard macro (C-x e); `ed-update` replays its events."
  (if (nil? (:macro-last m))
    (message m "no keyboard macro defined (record one with C-x ( … C-x ))")
    (assoc m :run-macro true)))

;; ---- zap-to-char (M-z) ------------------------------------------------------

(defcommand cmd-zap-to-char
  (m key)
  "Kill text from point up to and including the next occurrence of a typed character
(M-z). Reads the target char (ed-read-char); a no-op-with-message when it isn't found."
  (ed-read-char m
    "Zap to char: "
    (fn (mm ch)
      (if (not (string? ch))
        mm
        ;; the same case rule as search (`isearch/search-fold?`): `a` zaps to the next `a`
        ;; or `A`, and `A` zaps only to an `A`
        (let (found (buffer-search-forward (ed-current-buf mm)
                      ch
                      (buffer-point (ed-current-buf mm))
                      (isearch/search-fold? ch)))
          (if (nil? found)
            (message mm (str "not found: " ch))
            (ed-kill-span mm (fn (b) (goto-char b (inc found)))))))))) ; kill [point, found] to ring
;; ---- registers (C-x r SPC / j / s / i) --------------------------------------
;; A register is a single-character slot in the model's `:registers` map holding a
;; `Register` record — a saved point (`point-register`) or text (`text-register`).
;; The ability keeps the jump/insert commands closed over WHAT a register holds:
;; a new register kind (a rectangle, a window config, …) is a record + impl here,
;; not another branch in the commands. Each command reads the register name with
;; `ed-read-char`. Emacs C-x r SPC / j / s / i.

(defrecord point-register ((position int))) ; C-x r SPC — a saved buffer position
(defrecord text-register ((text string))) ; C-x r s — a saved region
(defability Register
  "What a register's held value can do: jump to it (C-x r j) or insert it (C-x r i).
A kind that can't do one says so in the echo area (`c` is the register's name)."
  (register-jump [self m c] :-> any)
  (register-insert [self m c] :-> any))

(impl Register
  point-register
  (register-jump [v m c]
    (ed-apply m (fn (b) (goto-char b (math/min (point-register-position v) (buffer-length b))))))
  (register-insert [v m c] (message m (str "register " c " holds no text"))))

(impl Register
  text-register
  (register-jump [v m c] (message m (str "register " c " holds no point")))
  (register-insert [v m c] (ed-edit m (fn (b) (insert b (text-register-text v))))))

(defn ed-set-register (m c v) (assoc m :registers (assoc (or (:registers m) {}) c v)))
(defn ed-get-register (m c) (get (or (:registers m) {}) c))

(defcommand cmd-point-to-register
  (m key)
  "Save point in a register (C-x r SPC <r>); C-x r j <r> later jumps back to it."
  (ed-read-char m
    "Point to register: "
    (fn (mm c)
      (message (ed-set-register mm c (point-register (buffer-point (ed-current-buf mm))))
        (str "Point saved in register " c)))))

(defcommand cmd-jump-to-register
  (m key)
  "Jump to the point saved in a register (C-x r j <r>)."
  (ed-read-char m
    "Jump to register: "
    (fn (mm c)
      (let (v (ed-get-register mm c))
        (if v
          (register-jump v mm c)
          (message mm (str "register " c " holds no point")))))))

(defcommand cmd-copy-to-register
  (m key)
  "Copy the region into a register (C-x r s <r>); C-x r i <r> inserts it later."
  (ed-read-char m
    "Copy to register: "
    (fn (mm c)
      (let (txt (buffer-region (ed-current-buf mm)))
        (if (nil? txt)
          (message mm *no-region-message*)
          (message (ed-set-register mm c (text-register txt))
            (str "Region saved in register " c)))))))

(defcommand cmd-insert-register
  (m key)
  "Insert a register's saved text at point (C-x r i <r>)."
  (ed-read-char m
    "Insert register: "
    (fn (mm c)
      (let (v (ed-get-register mm c))
        (if v
          (register-insert v mm c)
          (message mm (str "register " c " holds no text")))))))

;; ---- bookmarks (C-x r m set / C-x r b jump) ---------------------------------

(defcommand cmd-bookmark-set
  (m key)
  "Set a named bookmark at point in the current file (C-x r m); persisted across sessions."
  (let (b (ed-current-buf m) f (buffer-file b) p (buffer-point b))
    (if (nil? f)
      (message m "buffer has no file to bookmark")
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit "Set bookmark: " "")
           :on-complete (fn (mm t)
                          (do
                            (bookmark-set! t f p)
                            (message mm (str "Bookmark set: " t))))}))))

(defcommand cmd-bookmark-jump
  (m key)
  "Jump to a bookmark (C-x r b): prompt with completion, open its file and go to point."
  (let (names (into [] (bookmark-names)))
    (if (empty? names)
      (message m "no bookmarks yet (set one with C-x r m)")
      (assoc m
        :minibuffer
          (ed-name-prompt "Jump to bookmark: "
            names
            (fn (mm t)
              (let (bk (bookmark-get t))
                (if (nil? bk)
                  (message mm (str "no bookmark: " t))
                  (ed-apply (ed-find-file mm (:file bk))
                    (fn (bb) (goto-char bb (math/min (:pos bk) (buffer-length bb)))))))))))))

;; ---- occur (M-s o) ----------------------------------------------------------
;; List the current buffer's lines matching a string in a read-only *Occur* buffer;
;; RET on a result jumps to that line in the source. Reuses the *Process List* report
;; pattern (ed-show-named + a special read-only mode whose RET is bound — see modes).

(defn- ed-occur-matches (buf needle)
  "`[line0 text]` for each 0-based line of `buf` whose text contains `needle`."
  (seq/keep (range (buffer-line-count buf))
    (fn (ln)
      (let (txt (ed-strip-newline (buffer-line-at buf ln)))
        (if (>= (index-of txt needle 0) 0) [ln txt] nil)))))

(defn ed-occur-text (matches needle)
  "The *Occur* buffer text for `matches` of `needle`: a header line then `N: <line>`
rows (1-based source line numbers, which `cmd-occur-jump` parses back)."
  (str (count matches)
    " matches for \""
    needle
    "\":\n"
    (string/join (map matches (fn (e) (str (inc (first e)) ": " (second e)))) "\n")
    "\n"))

(defcommand cmd-occur
  (m key)
  "List the current buffer's lines matching a string in a read-only *Occur* buffer
(M-s o); RET on a result jumps to that line in the source buffer."
  (let (src (buffer-name (ed-current-buf m)))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Occur: " "")
         :on-complete (fn (mm t)
                        (if (= t "")
                          (message mm "empty pattern")
                          (let (matches (ed-occur-matches (ed-current-buf mm) t))
                            (if (empty? matches)
                              (message mm (str "no matches for \"" t "\""))
                              (ed-show-named (assoc mm :occur-source src)
                                "*Occur*"
                                (ed-occur-text matches t)
                                :occur)))))})))

(defcommand cmd-occur-jump
  (m key)
  "Jump to the source line named on the current *Occur* row (RET in *Occur*)."
  (let (ln (ed-leading-int (buffer-line-at (ed-current-buf m)
                             (buffer-current-line (ed-current-buf m))))
        src (:occur-source m))
    (cond
      (nil? ln) (message m "not on a match line")
      (nil? src) (message m "not on a match line")
      (nil? (ed-buffer-index-by-name m src)) (message m (str "source buffer gone: " src))
      else
        (ed-apply (ed-select m (ed-buffer-index-by-name! m src))
          (fn (b) (ed-goto-line b ln))))))

;; ---- reload the user config (M-x reload-config) -----------------------------
;; `~/.config/bedit/init.blsp` is read as DATA at startup (config/init-config),
;; not eval'd — so eval-buffer on it reports "unbound symbol: config" (the `(config …)`
;; form is a DSL, not a call). This command is the live way to apply edits to it without
;; restarting: re-read the file and re-seed the model-level settings via the same
;; `config/apply-to-model` `main` uses, surfacing any value typo in the echo area.

(defcommand cmd-reload-config
  (m key)
  "Re-read ~/.config/bedit/init.blsp and apply it to the running editor (M-x
reload-config). The live alternative to restarting — init.blsp is data (read, not eval'd),
so it can't be applied with eval-buffer."
  (let (cfg (config/init-config)
        warns (config/config-warnings cfg)
        m1 (config/apply-to-model m cfg)
        ;; the window-side keys too (:text-aa / :line-height), so a reload re-skins the window
        _ (config/apply-window! cfg))
    (message m1
      (if (empty? warns) "config reloaded" (str "config reloaded (" (first warns) ")")))))

;; ---- hexl: a binary file as a hex view ---------------------------------------
;; `find-file` on a file that is not UTF-8 (an ELF, a PNG, a .o) used to fail with
;; "stream did not contain valid UTF-8" and open nothing. Emacs opens it in
;; `hexl-mode`; so does this: a read-only `:hexl` buffer of xxd-style rows — offset,
;; sixteen bytes as hex pairs, the printable ASCII beside — capped at `*hexl-cap*`
;; bytes with a header saying so, because the rows are built in Brood and a
;; multi-megabyte object file is not what anyone reads by eye.

(defdyn *hexl-cap* 65536) ; bytes of a binary shown (4096 rows)
(sig *hexl-cap* int)
(def- hexl-row-bytes 16)

(defn- hexl-ascii (b)
  "The ASCII column's character for byte `b`: printable 7-bit as itself, else `.`."
  (if (and (>= b 32) (< b 127)) (string/codepoints-> (list b)) "."))

(defn hexl-row (b off n)
  "One xxd row for the `n` bytes of `b` from `off`: `00000010: 7f45 4c46 … |.ELF…|`.
Pure over the bytes value; the row is padded so the ASCII column lines up on a short
last row."
  (letrec (go (fn (j hex asc)
                (if (>= j hexl-row-bytes)
                  (str (string/format "%08x: " off) hex "  " (string/trimr asc))
                  (let (sep (if (and (> j 0) (= 0 (math/rem j 2))) " " "")
                        in? (< j n)
                        v (if in? (nth b (+ off j) 0) 0))
                    (go (inc j)
                      (str hex sep (if in? (string/format "%02x" v) "  "))
                      (str asc (if in? (hexl-ascii v) " ")))))))
    (go 0 "" "")))

(defn hexl-text (b)
  "The hex view of bytes `b`: a header line, then a row per sixteen bytes up to
`*hexl-cap*`."
  (let (total (count b)
        shown (math/min total *hexl-cap*)
        rows (math/quot (+ shown (dec hexl-row-bytes)) hexl-row-bytes)
        header (if (> total shown)
                 (str ";; binary file: " total " bytes — the first " shown " shown (read-only)")
                 (str ";; binary file: " total " bytes (read-only)")))
    (string/join (cons header
                   (map (range rows)
                     (fn (r)
                       (let (off (* r hexl-row-bytes))
                         (hexl-row b off (math/min hexl-row-bytes (- shown off)))))))
      "\n")))

;; The hex view's `:fontify` service: a row is `<8 hex offset>: <hex pairs>  <ascii>` —
;; the offset dim (a line number), the pairs in the text colour, a zero pair dimmer
;; still (padding reads as structure at a glance), the ASCII column as a string; the
;; header as a comment. Line-structural, so a windowed slice fontifies wherever it starts.

(def- hexl-hex-col 10) ; the first hex pair's column: 8 offset digits, `:`, a space
(def- hexl-ascii-col (+ hexl-hex-col 39 2)) ; 16 pairs + 7 group spaces, then two spaces
(sig hexl-ascii-col int)

(defn- hexl-pair-spans (lt off i n acc)
  "The dim spans over the zero pairs (`00`) of row `lt` between hex columns `i`..`n`."
  (if (>= i n)
    acc
    (let (pair (string/substring lt i (math/min n (+ i 2))))
      (hexl-pair-spans lt
        off
        ;; pairs sit at +0 and +2 of each `xxxx ` group of five columns
        (+ i (if (= 0 (math/rem (- i hexl-hex-col) 5)) 2 3))
        n
        (if (= pair "00") (cons [(+ off i) (+ off i 2) theme/face-dired-size] acc) acc)))))
(sig hexl-pair-spans (string int int int list -> list))

(defn- hexl-line-spans (lt off)
  "The spans for one hex-view line at absolute offset `off`."
  (let (n (string/length lt))
    (cond
      (string/starts-with? lt ";;") (list [off (+ off n) (editor/face/face :syntax/comment)])
      (and (>= n hexl-hex-col) (= (string/substring lt 8 9) ":"))
        (append (list [off (+ off 8) theme/face-dired-size])
          (reverse (hexl-pair-spans lt off hexl-hex-col (math/min n (- hexl-ascii-col 2)) '()))
          (if (> n hexl-ascii-col)
            (list [(+ off hexl-ascii-col) (+ off n) (editor/face/face :syntax/string)])
            '()))
      else '())))

(defn- hexl-spans-acc (lines off acc)
  (if (empty? lines)
    (reverse acc)
    (hexl-spans-acc (rest lines)
      (+ off (string/length (first lines)) 1)
      (fold (hexl-line-spans (first lines) off) acc (fn (a s) (cons s a))))))

(defn hexl-fontify (src)
  "The hex view's `:fontify` service: `[start end face]` spans for a slice `src` of a
`:hexl` buffer — offsets dim, zero bytes dimmer, the ASCII column as a string, the
header as a comment."
  (hexl-spans-acc (string/split src "\n") 0 '()))

(defn- ed-open-binary (m path root)
  "Open `path` (an existing file that is not UTF-8) as a `:hexl` buffer — Emacs
`hexl-mode`, read-only. Its `:file` is kept so the mode line names it and `C-x C-j`
lands in its directory, but there is no saving a hex view."
  (let (b (file/slurp-bytes path)
        m1 (ed-show-named m (file-display-name path root) (hexl-text b) :hexl))
    (message (ed-set-buf m1 (assoc (ed-current-buf m1) :file path :dir (path/dirname path)))
      (str "opened " path " as hex (binary, " (count b) " bytes)"))))

(defn- utf8-file? (path)
  "True when the bytes at `path` decode as UTF-8 — a text file `find-file-buffer` can read.
The decode failing IS the answer (a binary), so the error is the verdict, not a fault."
  (check-allow :discarded-catch
    (try (do (string/bytes-> (file/slurp-bytes path)) true) (catch e false))))

;; ---- dired lives in src/dired.blsp -----------------------------------------------
;; Dired builds on this module (the find-file prompt, the default directory, the line
;; motions), so this one reaches it at RUNTIME rather than through its header — a header
;; each way would be a cycle, which does not fail loudly: it leaves one module
;; half-initialised and breaks something unrelated.

;; check-allow: the listing comes back through `reflect/eval`, which the checker reads as
;; unknown; `dired/ed-show-dired` answers a model.
(check-allow :trusted
  (defn ed-open-dired (m dir)
    "Show the dired listing of `dir` (`dired/ed-show-dired`) — what opening a directory from
anywhere does. Loads `dired` on first use; by then this module has finished loading."
    (do (require-one 'dired) ((reflect/eval 'dired/ed-show-dired) m dir))))
(sig ed-open-dired (model string -> model))

;; ---- describe-key (C-h k) ---------------------------------------------------

(defcommand cmd-describe-key
  (m key)
  "Describe the next key sequence (C-h k): read a key (or chord) and report, in the echo
area, the command it runs and the first line of its docstring. Handled by the describe-key
transient (`input`); Esc/C-g aborts."
  (assoc (message m "Describe key: ") :describe-key {:pending nil :keys []}))

(defcommand cmd-describe-function
  (m key)
  "Describe a command by name (C-h f): prompt with completion over the M-x registry,
then show the first line of its docstring in the echo area."
  (let (names (command-names))
    (assoc m
      :minibuffer
        (ed-name-prompt "Describe command: "
          names
          (fn (mm t)
            (let (sym (command-sym t))
              (if (nil? sym)
                (message mm (str "no command: " t))
                (let (d (ed-doc sym))
                  (message mm (if d (str t " — " (ed-first-line d)) (str t " (no docstring)")))))))))))

;; ---- goto-line (M-g g) / recentf (C-x C-r) ----------------------------------

(defn- ed-parse-int (s)
  "Parse `s` as an integer, or nil if it isn't one."
  ;; `s` is what the user typed at the prompt — not reading as an integer is the answer
  (check-allow :discarded-catch
    (try (let (v (reflect/read-string s)) (if (int? v) v nil)) (catch e nil))))

(sig ed-goto-line (buffer int -> buffer))
(defn ed-goto-line (b n)
  "Move point to the start of (1-based) line `n`, clamped to the buffer's line range."
  (let (target (math/max 0 (math/min (dec n) (dec (buffer-line-count b)))))
    (fold (range target) (beginning-of-buffer b) (fn (bb _) (forward-line bb)))))

(sig ed-goto-line-col (buffer int int -> buffer))
(defn ed-goto-line-col (b line0 col)
  "Move point to 0-based `line0` / `col` (LSP coordinates), clamped to the buffer. Used by
imenu/xref jumps, which land on a symbol's start position."
  (let (rope (buffer-rope b)
        ln (math/max 0 (math/min line0 (dec (buffer-line-count b))))
        bol (text/line->char rope ln))
    (goto-char b (math/min (+ bol (math/max 0 col)) (buffer-length b)))))

(defcommand cmd-goto-line
  (m key)
  "Prompt for a line number and jump to it (M-g g)."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Goto line: " "")
       :on-complete (fn (mm t)
                      (let (n (ed-parse-int t))
                        (if (nil? n)
                          (message mm (str "not a line number: " t))
                          (ed-apply mm (fn (b) (ed-goto-line b n))))))}))

(defcommand cmd-goto-char
  (m key)
  "Prompt for a character offset and jump to it (M-g c). Clamped to the buffer."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Goto char: " "")
       :on-complete (fn (mm t)
                      (let (n (ed-parse-int t))
                        (if (nil? n)
                          (message mm (str "not a character offset: " t))
                          (ed-apply mm
                            (fn (b) (goto-char b (math/max 0 (math/min n (buffer-length b)))))))))}))

(defn- ed-recentf-prompt (m files)
  "The recentf minibuffer spec over `files` (full paths, most-recent first): a Vertico
list, fuzzy-narrowed, that opens the chosen file. A no-op-with-message when empty."
  (if (empty? files)
    (message m "no recent files yet")
    (assoc m
      :minibuffer (ed-name-prompt "Recent file: " files (fn (mm t) (ed-find-file mm t))))))

(defcommand cmd-recentf
  (m key)
  "Open a recently-visited file (C-x C-r): pick from the recentf list (most-recent
first, fuzzy-narrowed). The list is the persisted ~/.cache/brood/recent-files cache."
  (ed-recentf-prompt m (into [] (recent-files))))

;; ---- comment / uncomment (M-;) ----------------------------------------------
;; Language-neutral: the comment token comes from the buffer mode's `:comment-syntax`
;; service (brood-mode → `";; "`); a mode without one can't comment. DWIM toggle: if
;; every non-blank line in range is already commented, uncomment; else comment. Edits
;; are computed per line from the *current* buffer (commenting never adds/removes a
;; newline, so line numbers stay stable), so order doesn't matter.

(defn- ed-line-blank? (buf l) (string/blank? (buffer-line-at buf l)))

(defn- ed-line-commented? (buf l trimmed)
  "True if line `l` (after its indent) starts with the trimmed comment token."
  (let (text (buffer-text buf)
        bol (text/line->char (buffer-rope buf) l))
    (string/starts-with? (string/substring text (+ bol (ed-leading-ws text bol))) trimmed)))

(defn- ed-comment-line (buf l tok)
  "Insert comment token `tok` at the indent column of line `l`."
  (let (bol (text/line->char (buffer-rope buf) l))
    (insert (goto-char buf (+ bol (ed-leading-ws (buffer-text buf) bol))) tok)))

(defn- ed-uncomment-line (buf l tok trimmed)
  "Strip a leading comment token from line `l` — the full `tok` (with its space) when
present, else the trimmed token; a no-op if the line isn't commented."
  (let (text (buffer-text buf)
        bol (text/line->char (buffer-rope buf) l)
        at (+ bol (ed-leading-ws text bol))
        rest (string/substring text at)
        n (cond
            (string/starts-with? rest tok) (string/length tok)
            (string/starts-with? rest trimmed) (string/length trimmed)
            else 0))
    (if (= n 0) buf (replace-region buf at (+ at n) ""))))

(defn- ed-toggle-comment (buf tok)
  "Comment or uncomment the buffer's `region-line-range` with token `tok`, leaving
point at the start line's indent. DWIM: uncomment iff every non-blank line in range
is already commented, else comment. The per-line edit folds over `map-region-lines`."
  (let (trimmed (string/trimr tok)
        [sl el] (region-line-range buf)
        nonblank (seq/reject (range sl (inc el)) (fn (l) (ed-line-blank? buf l)))
        all-commented? (and (not (empty? nonblank))
                         (every? nonblank (fn (l) (ed-line-commented? buf l trimmed))))
        edited (map-region-lines buf
                 (fn (b l)
                   (cond
                     (ed-line-blank? b l) b
                     all-commented? (ed-uncomment-line b l tok trimmed)
                     else (ed-comment-line b l tok))))
        sbol (text/line->char (buffer-rope edited) sl))
    (goto-char edited (+ sbol (ed-leading-ws (buffer-text edited) sbol)))))

(defcommand cmd-comment-dwim
  (m key)
  "Comment or uncomment the region's lines (or the current line) — M-;. Toggles by
whether every non-blank line in range is already commented. The comment token comes
from the buffer mode's `:comment-syntax` service (brood-mode → `\";; \"`); a mode
that defines none (plain text) reports that it can't comment."
  (let (tok (ed-mode-service (ed-current-buf m) :comment-syntax))
    (if (nil? tok)
      (message m "no comment syntax for this mode")
      (ed-edit m (fn (b) (ed-toggle-comment b tok))))))

;; ---- incremental search (C-s / C-r) -----------------------------------------
;; Open the modal isearch loop; `input/ed-update` then routes keys to it (see
;; `isearch`). The work — searching, highlighting, wrap — lives in `src/isearch.blsp`.

(defcommand cmd-isearch-forward
  (m key)
  "Begin an incremental search forward (C-s)."
  (isearch-start m :forward))

(defcommand cmd-isearch-backward
  (m key)
  "Begin an incremental search backward (C-r)."
  (isearch-start m :backward))

(defcommand cmd-query-replace
  (m key)
  "Replace occurrences of one string with another from point, asking at each (M-%).
Prompts for the search string, then the replacement, then enters the y/n/!/./q loop
(see `isearch`)."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Query replace: " "")
       :on-complete (fn (mm from)
                      (if (= from "")
                        (message mm "(nothing to replace)")
                        (assoc mm
                          :minibuffer
                            {:edit (ed-mb-edit (str "Query replace " from " with: ") "")
                             :on-complete (fn (m2 to) (qr-start m2 from to))})))}))

;; ---- undo / redo ------------------------------------------------------------

(defn- ed-undo-step (m kind exhausted-msg status)
  "One step of the Emacs undo *tree* on the current buffer (`kind` = 'commands/cmd-undo
or 'commands/cmd-redo): continue the run while the previous command was the same `kind`,
else start a fresh run (`undo-start`) — which, after some undos, reverses direction (so
undo-after-a-break, or redo, walks the recorded undos forward). Reports `exhausted-msg`
when the run has nothing left."
  (let (b (ed-current-buf m)
        b1 (if (= (:last-command m) kind) b (undo-start b)))
    (if (empty? (:pending-undo b1))
      (message m exhausted-msg)
      (assoc (ed-set-buf m (undo-next b1)) :status status))))

(defcommand cmd-undo
  (m key)
  "Undo one change (C-/ , C-x u). Emacs-style tree: after undoing, run any other command
to break the chain and undo again — that undoes your undos (redo). No state is ever lost.

**With a region active this undoes only the selected lines** (Emacs
`undo-in-region`, `editor/buffer/undo-in-region`): the most recent change that touched
them is reverted and everything outside is left exactly as it is, with the region kept
so a repeat peels the next change off the same lines. Cheap here because undo is
snapshot-based — the change set is a line diff of the previous text, so the hunks
outside your selection are simply not applied."
  (let (b (ed-current-buf m))
    (if (nil? (buffer-region-bounds b))
      (ed-undo-step m 'commands/cmd-undo "No further undo" "undo")
      (let (undone (editor/buffer/undo-in-region b))
        (if (= (buffer-text undone) (buffer-text b))
          (message m "no change in the region to undo")
          (message (ed-set-buf m undone)
            "undid the region"))))))

(defcommand cmd-redo
  (m key)
  "Redo one undone change (M-/): walk the recorded undos forward without needing a
break. Repeated M-/ keeps redoing."
  (ed-undo-step m 'commands/cmd-redo "No further redo" "redo"))

(defcommand cmd-repeat
  (m key)
  "Re-run the last command (C-x z). After the first C-x z, tap `z` to keep repeating
— repeat-mode keeps the last-command pointing at the original command, not this one,
so `z` re-invokes the original rather than recursing."
  (let (to-repeat (:last-command m))
    (if (or (nil? to-repeat) (= to-repeat 'commands/cmd-repeat))
      (message m "No previous command to repeat")
      (let (result ((reflect/eval to-repeat) m key))
        (assoc result :this-command to-repeat)))))

;; ---- region / kill ring (C-SPC set mark · C-w kill · M-w copy · C-y yank) ----

(defcommand cmd-universal-argument
  (m key)
  "C-u — begin a numeric prefix argument (default 4; a further C-u multiplies it by 4,
digits set it). The next command runs that many times; `C-u C-SPC` pops the mark."
  (assoc m :prefix-arg {:count 4 :raw true} :echo "C-u-"))

(defcommand cmd-negative-argument
  (m key)
  "M-- / C-- — begin a *negative* prefix argument (Emacs `negative-argument`): the next
command runs in the opposite direction (its registered inverse), or `|N|` times. Digits
typed after it build `-N` (e.g. `M-- 3 C-f` moves back three chars)."
  (assoc m :prefix-arg {:count -1 :raw true} :echo "negative-argument -"))

;; The opposite-direction pairs a negative argument flips between (Emacs M-- / C--).
;; Registration is data — the symbols needn't be defined yet — so it reads cleanly here.
(register-inverse 'commands/cmd-forward-char 'commands/cmd-backward-char)
(register-inverse 'commands/cmd-forward-word 'commands/cmd-backward-word)
(register-inverse 'commands/cmd-next-line 'commands/cmd-previous-line)
(register-inverse 'commands/cmd-forward-sexp 'commands/cmd-backward-sexp)
(register-inverse 'commands/cmd-forward-list 'commands/cmd-backward-list)
(register-inverse 'commands/cmd-up-list 'commands/cmd-backward-up-list)
(register-inverse 'commands/cmd-end-of-defun 'commands/cmd-beginning-of-defun)
(register-inverse 'commands/cmd-kill-sexp 'commands/cmd-backward-kill-sexp)
(register-inverse 'commands/cmd-mark-sexp 'commands/cmd-mark-sexp-backward)
(register-inverse 'commands/cmd-mark-word 'commands/cmd-mark-word-backward)
(register-inverse 'commands/cmd-forward-paragraph 'commands/cmd-backward-paragraph)
(register-inverse 'commands/cmd-forward-sentence 'commands/cmd-backward-sentence)
(register-inverse 'commands/cmd-kill-sentence 'commands/cmd-backward-kill-sentence)
(register-inverse 'commands/cmd-delete-char 'commands/cmd-delete-backward)
(register-inverse 'commands/cmd-kill-word 'commands/cmd-backward-kill-word)
(register-inverse 'commands/cmd-scroll-up 'commands/cmd-scroll-down)

(defcommand cmd-set-mark
  (m key)
  "Set the mark at point and push it onto the mark ring (C-SPC) — point and mark
delimit the region. With a prefix argument (`C-u C-SPC`), instead pop the mark ring,
moving point to a previous mark."
  (if (nil? (current-prefix-arg m))
    (message (ed-apply m push-mark) "mark set")
    (message (ed-apply m pop-mark) "mark popped")))
;; set-mark reads the prefix arg itself (run once), so the dispatcher must not repeat it.
(register-prefix-consuming 'commands/cmd-set-mark)

(defn- ed-mark-region (m start end)
  "Activate the region between `start` and `end` (point at `start`, mark at `end`) — the
Emacs convention for the `mark-*` commands: point lands at the start of what's marked."
  (ed-set-buf m (assoc (ed-current-buf m) :point start :mark end)))

(defcommand cmd-mark-whole-buffer
  (m key)
  "Select the entire buffer (C-x h): point at the start, mark at the end."
  (ed-mark-region m 0 (buffer-length (ed-current-buf m))))

(defcommand cmd-exchange-point-and-mark
  (m key)
  "Swap point and mark (C-x C-x), so the cursor jumps to the other end of the region.
A no-op (with a note) when no mark is set."
  (let (b (ed-current-buf m) mk (buffer-mark b))
    (if (nil? mk)
      (message m "no mark set")
      (ed-set-buf m (assoc b :point mk :mark (buffer-point b))))))

(defcommand cmd-mark-word
  (m key)
  "Set the mark at the end of the next word, leaving point (Emacs `mark-word`, M-@).
Repeated, it extends the region by another word; under a negative argument it marks the
*previous* word instead (the registered inverse). Same repeat-extends machinery as
`mark-sexp` — see `ed-mark-by`."
  (ed-mark-by m 'commands/cmd-mark-word forward-word))

;; `mark-word`'s negative-argument direction — a plain `defn`, like `cmd-mark-sexp-backward`.
(defn cmd-mark-word-backward (m key)
  (ed-mark-by m 'commands/cmd-mark-word-backward backward-word))

(defcommand cmd-mark-paragraph
  (m key)
  "Mark the paragraph around point (M-h): point at its start, mark at its end."
  (let (b (ed-current-buf m)
        start (buffer-point (backward-paragraph b))
        end (buffer-point (forward-paragraph (goto-char b start))))
    (ed-mark-region m start end)))

(defcommand cmd-mark-defun
  (m key)
  "Mark the top-level form around point (C-M-h): point at its start, mark at its end —
the defun as the buffer's mode sees one (`ed-defun-bounds`)."
  (let ([start end] (ed-defun-bounds (ed-current-buf m) key)) (ed-mark-region m start end)))

;; ---- narrowing: focus a pane on a region (C-x n n/d/p/w) ----------------------
;; Emacs narrowing conflates "restrict what's editable" with "hide the rest" and makes it
;; BUFFER-GLOBAL and modal — every window narrows, and you forget it is on (the classic
;; "where did my file go?"). bedit already has the editable half — `editor/buffer`'s
;; `narrow-to`/`read-only?`, the tutorial's prose, the shell prompt — so narrowing here is
;; the OTHER half, and better: a PER-PANE focus (`:restrict` on the pane, `model/ed-set-restrict`).
;; One pane focuses a defun while another shows the whole file; the restriction is visible
;; (the pane draws only the slice) and local, so there is no hidden mode to forget. Point is
;; confined to it (`model/ed-clamp-restriction`, per key), which is what makes the pane feel
;; like a small buffer.

(defn- ed-narrow-between (m start end)
  "Narrow the selected pane to `[start end]`, drop the mark, and put point at the top of the
region — the shared tail of every narrowing command."
  (ed-set-buf (ed-set-restrict m start end)
    (assoc (goto-char (ed-current-buf m) start) :mark nil)))

(defcommand cmd-narrow-to-region
  (m key)
  "Focus this pane on the region (C-x n n): only the lines point↔mark covers stay in view
and point is confined to them. Other panes on the buffer are unaffected. C-x n w widens."
  (let (rb (buffer-region-bounds (ed-current-buf m)))
    (if (nil? rb)
      (message m *no-region-message*)
      (let ([lo hi] rb) (message (ed-narrow-between m lo hi) "Narrowed to region — C-x n w widens")))))

(defcommand cmd-narrow-to-defun
  (m key)
  "Focus this pane on the top-level form around point (C-x n d) — the defun as the buffer's
mode sees one (`ed-defun-bounds`). C-x n w widens."
  (let ([start end] (ed-defun-bounds (ed-current-buf m) key))
    (message (ed-narrow-between m start end) "Narrowed to defun — C-x n w widens")))

(defcommand cmd-narrow-to-paragraph
  (m key)
  "Focus this pane on the paragraph around point (C-x n p). C-x n w widens."
  (let (b (ed-current-buf m)
        start (buffer-point (backward-paragraph b))
        end (buffer-point (forward-paragraph (goto-char b start))))
    (message (ed-narrow-between m start end) "Narrowed to paragraph — C-x n w widens")))

(defcommand cmd-widen
  (m key)
  "Widen the selected pane — undo narrowing, so the whole buffer is in view again (C-x n w)."
  (if (nil? (ed-selected-restrict m))
    (message m "not narrowed")
    (message (ed-clear-restrict m) "Widened")))

;; ---- shift-select (Shift+arrows / Home / End extend the region) -------------
(def- ed-shift-motion-for
  {:shift-up cmd-previous-line
   :shift-down cmd-next-line
   :shift-left cmd-backward-char
   :shift-right cmd-forward-char
   :shift-home cmd-beginning-of-line
   :shift-end cmd-end-of-line})

(defn- ed-shift-move (m move-cmd key)
  "Start (or extend) a shift-selection: set the mark at point when no region is active
and flag `:shift-select`, then run the base motion `move-cmd`. point↔mark is the region;
a plain motion afterwards collapses it (`input/ed-shift-deactivate`)."
  (let (b (ed-current-buf m)
        m1 (if (or (:shift-select m) (buffer-mark b))
             (assoc m :shift-select true)
             (ed-set-buf (assoc m :shift-select true) (set-mark b))))
    (move-cmd m1 key)))

;; check-allow: `ed-shift-move` runs the motion command late (`reflect/eval`); the result is
;; the model every command answers
(check-allow :trusted
  (defcommand cmd-shift-motion
    (m key)
    "Shift + a motion key (arrows / Home / End): extend the region by the matching plain
motion (Emacs shift-select). Bound to every `:shift-*` key; `key` picks the motion."
    (let (move (get ed-shift-motion-for key))
      (if (nil? move) m (ed-shift-move m move key)))))

(defcommand cmd-kill-region
  (m key)
  "Delete the region and push its text onto the kill ring (C-w)."
  (let (text (buffer-region (ed-current-buf m)))
    (if (nil? text)
      (message m *no-region-message*)
      (ed-edit (ed-push-kill m text true) delete-region))))

(defn- ed-link-at-point (m)
  "The source location the current line of the current buffer links to (a results
buffer's `:line-loc`, resolved for indented detail lines like the click does), or nil
for an ordinary buffer / a non-link line."
  (let (buf (ed-current-buf m))
    (when (ed-mode-service buf :line-loc)
      (line-link-loc buf (buffer-current-line buf)))))

(defn- ed-link-abs-string (m loc)
  "Format `loc` as an absolute `path:line` — the paste-able jump target, the file made
absolute against the project root (or cwd) when it isn't already."
  (let (path (:file loc)
        resolved (if (string/starts-with? path "/")
                   path
                   (str (or (:project-root m) (file/cwd)) "/" path)))
    (str resolved ":" (:line loc))))

(defcommand cmd-copy-region
  (m key)
  "Push the region's text onto the kill ring without deleting it (M-w). With no region,
on a results buffer's link line it copies the whole link — the link's absolute
`path:line` — so Copy on a link grabs the link, matching the browser's 'copy link'."
  (let (buf (ed-current-buf m)
        text (buffer-region buf))
    (cond
      (not (nil? text)) (message (ed-apply (ed-push-kill m text true) clear-mark) "region copied")
      else
        (let (loc (ed-link-at-point m))
          (if (nil? loc)
            (message m "no region")
            (let (link (ed-link-abs-string m loc))
              (message (ed-push-kill m link true) (str "link copied: " link))))))))

(defcommand cmd-yank
  (m key)
  "Insert the most recently killed/copied text at point (C-y), recording the
inserted span + ring index in `:yank` so M-y (`cmd-yank-pop`) can replace it. First
adopts the OS clipboard if another app copied something newer (`ed-adopt-clipboard`).
A read-only buffer says so and records no span."
  (let ([m text] (ed-kill-head m))
    (if (nil? text)
      (message m "kill ring is empty")
      (let (start (buffer-point (ed-current-buf m))
            [m2 yanked?] (ed-try-edit m (fn (b) (insert b text))))
        (if yanked?
          (assoc m2 :yank {:start start :end (buffer-point (ed-current-buf m2)) :index 0})
          m2)))))

(defcommand cmd-yank-pop
  (m key)
  "Replace the text of the immediately-preceding yank with the next-older kill,
cycling the ring (M-y). Only valid right after a yank or yank-pop; otherwise it
reports that the previous command was not a yank. The swap is one `replace-region`, so
one undo takes the whole M-y back."
  (let (y (:yank m) ring (:kill-ring m))
    (if (or (nil? y) (not (ed-yank-command? (:last-command m))) (empty? ring))
      (message m "previous command was not a yank")
      (let (n (count ring)
            idx (let (i (inc (:index y))) (if (>= i n) 0 i))
            [m2 swapped?] (ed-try-edit m
                            (fn (b)
                              (clear-mark (replace-region b (:start y) (:end y) (nth ring idx))))))
        (if swapped?
          (assoc m2 :yank {:start (:start y) :end (buffer-point (ed-current-buf m2)) :index idx})
          m2)))))
;; ---- right-click context menu (a standard dropdown) -------------------------
;; A modal overlay on `:menu` listing actions that run the *same* commands as the
;; keyboard (so Copy is exactly M-w, Cut C-w, Paste C-y, Select All C-x h — and thus the
;; same OS-clipboard sync). Opened by a right-press (input/ed-ev-mouse), navigated by
;; arrows + Enter (the `:menu` overlay handler in input), hovered + clicked by the mouse.
;; Items are maps `{:label :key :run :enabled :sep}` — enabled/disabled computed when the
;; menu opens so it reflects the current region / clipboard, like a native menu. The view
;; renders from the item maps + the shared geometry (completion/context-menu-*); the `:run`
;; command fn is only read back here.

(defn ed-menu-items-for (m)
  "The context-menu items for the current model — each with its keyboard shortcut and
whether it applies now (`:enabled`; a disabled item renders dimmed and won't run). `:sep`
marks a divider drawn above the item (the group break before Select All). Copy is enabled
by a region OR a link under point; Cut by a region; Paste by a non-empty kill ring."
  (let (has-region (not (nil? (buffer-region (ed-current-buf m))))
        has-link (not (nil? (ed-link-at-point m)))
        has-clip (not (empty? (:kill-ring m))))
    (list {:label "Copy" :key "M-w" :run cmd-copy-region :enabled (or has-region has-link)}
      {:label "Cut" :key "C-w" :run cmd-kill-region :enabled has-region}
      {:label "Paste" :key "C-y" :run cmd-yank :enabled has-clip}
      {:label "Select All" :key "C-x h" :run cmd-mark-whole-buffer :enabled true :sep true})))

(defn- ed-menu-enabled (items)
  "The indices of the enabled items — navigation and the initial selection land only on
these (disabled items and the divider are skipped)."
  (seq/filter (range (count items)) (fn (i) (:enabled (nth items i)))))

(defn ed-open-menu (m row col)
  "Open the context menu anchored at screen cell `[row col]` (point and the region are
left untouched, so Copy/Cut act on the current selection). Selection starts on the first
enabled item."
  (let (items (ed-menu-items-for m)
        enabled (ed-menu-enabled items))
    (assoc m
      :menu
        {:row row
         :col col
         :items items
         :sel (if (empty? enabled) 0 (first enabled))})))

(defn ed-close-menu (m) "Dismiss the context menu." (dissoc m :menu))

(sig ed-menu-move (model int -> model))
(defn ed-menu-move (m d)
  "Move the selection by `d` among the ENABLED items, wrapping — disabled items and the
divider are skipped (arrow-key navigation)."
  (let (menu (:menu m)
        items (:items menu)
        enabled (ed-menu-enabled items))
    (if (empty? enabled)
      m
      ;; `index-of` answers -1 for "not found", never nil, so the `(or … 0)` this used to
      ;; spell could not fire: a selection that is no longer enabled left `pos` at -1, and
      ;; `M-<`'s `d` of -1 then wrapped to the second-from-last item instead of the first.
      (let (cur (:sel menu)
            at (index-of enabled cur)
            pos (if (>= at 0) at 0)
            nxt (nth enabled (math/mod (+ pos d) (count enabled))))
        (assoc m :menu (assoc menu :sel nxt))))))

(defn ed-menu-jump (m end)
  "Select the FIRST or LAST enabled item — M-< / M->, meaning the same ends here as in a
buffer, the minibuffer's candidate list and the completion popup."
  (let (menu (:menu m)
        enabled (ed-menu-enabled (:items menu)))
    (if (empty? enabled)
      m
      (assoc m :menu (assoc menu :sel (if (= end :first) (first enabled) (last enabled)))))))

(defn ed-menu-run (m)
  "Run the selected item's command (`key` = nil) with the menu closed — so the command
sees no `:menu` and its copy/cut/paste is the real edit. A disabled item is a no-op."
  (let (menu (:menu m)
        item (nth (:items menu) (:sel menu)))
    (if (:enabled item)
      ((:run item) (ed-close-menu m) nil)
      m)))

;; The click geometry + hit-test live in the view's ui-kit widget (view/ed-menu-hit reads
;; the widget's zones), so a click can't disagree with what's drawn. These are the pure
;; model ops the mouse dispatch (input/ed-menu-mouse-*) drives from that hit result.

(defn ed-menu-activate (m i)
  "Run item `i` — a click landed on it. Selects then runs; a disabled item is unreachable
(the widget emits no zone for it), so this only ever runs an enabled command."
  (ed-menu-run (assoc m :menu (assoc (:menu m) :sel i))))

(defn ed-menu-select (m i)
  "Hover-select item `i` (the pointer moved over it) without running it — the standard
dropdown's hover-follows-pointer."
  (assoc m :menu (assoc (:menu m) :sel i)))

;; ---- multiple buffers -------------------------------------------------------

;; Switching shows buffer `i` in the SELECTED pane (other panes keep their
;; buffers); `:status` is per-model, so reset it (else a stale "modified" from the
;; previous buffer would describe the new one).
(sig ed-select (model int -> model))
(defn ed-select (m i)
  (assoc (ed-show-index m i) :status ""))

(defcommand cmd-next-buffer
  (m key)
  "Show the next buffer in the selected pane (wraps)."
  (ed-select m (math/mod (inc (ed-current-index m)) (count (:buffers m)))))

(defcommand cmd-previous-buffer
  (m key)
  "Show the previous buffer in the selected pane (wraps)."
  (ed-select m
    (math/mod (+ (dec (ed-current-index m)) (count (:buffers m)))
      (count (:buffers m)))))

(defn ed-has-editable? (bufs)
  "Whether the pool `bufs` holds a buffer other than `*Messages*`."
  (any? bufs (fn (b) (not (= (buffer-name b) "*Messages*")))))

(defn- ed-remap (m killed target)
  "Re-point every pane after pool index `killed` was removed: a pane on
`killed` now shows `target`; panes above `killed` shift down one; below are
unchanged. (Routes through `ed-map-panes` over all leaf payloads.)"
  (ed-map-panes m
    (fn (w)
      (let (b (:buffer w))
        (assoc w :buffer (cond (< b killed) b (> b killed) (dec b) else target))))))

(defn- ed-kill-at (m killed-idx follow-companions?)
  "Kill pool buffer `killed-idx`: fire its mode layers' `:on-close`, unhost/unshare it,
remove it, and re-point the panes that showed it (appending a fresh `*scratch*` if the pool
would be left with nothing editable). The body of `cmd-kill-buffer`, factored out so the
companion sweep below can reuse the whole path rather than half of it.

With `follow-companions?` the buffers the closing mode NAMED (`layers/request-close`) are
killed too — a mode's own second window, like the tutorial's *Workings* pane, which means
nothing once the tutorial is gone. Their own `:on-close` fires (they may own workers), but
their requests are NOT followed: one level, so a pair of modes naming each other cannot
loop."
  (let (buf (nth (:buffers m) killed-idx)
        ;; The close hooks are effects (a mode kills the worker it spawned), but the closed
        ;; context is also DATA — the companion names it left on itself. A hook cannot close
        ;; them itself: it only ever sees its own buffer, and layers has no idea the app
        ;; keeps a pool. So it names them and we act, here, where the pool is.
        closed (try
                 (editor/layers/close-context buf)
                 (catch e (do (log/warn (str "close hook failed: " (error-message e))) nil)))
        companions (if follow-companions?
                     (try (editor/layers/close-requests closed) (catch _ (list)))
                     (list))
        ;; a collab-shared slot withdraws its presence first; a registry-hosted one (frames)
        ;; is dropped by `hosted-drop-slot` itself, which also removes it from the registry
        m0 (if (get-in m [:hosted killed-idx :collab?])
             (collab/collab-unshare m killed-idx) ; presence withdraw + unsubscribe
             m)
        m0 (hosted/hosted-drop-slot m0 killed-idx) ; stop-if-local + index remap
        removed (seq/remove-nth (:buffers m0) killed-idx)
        label (str "killed " (buffer-name buf))
        m1 (if (ed-has-editable? removed)
             ;; another editable buffer remains: the killed pane shows the buffer
             ;; that shifted into its slot (clamped to the last index).
             (message (ed-remap (assoc m0 :buffers removed)
                        killed-idx
                        (math/min killed-idx (dec (count removed))))
               label)
             ;; none left → append a fresh *scratch* and point the killed pane at it.
             (let (bufs (into removed [(ed-stamp (make-buffer ""))]))
               (message (ed-remap (assoc m0 :buffers bufs) killed-idx (count removed)) label))))
    ;; Then the companions, by NAME — indices have just shifted, so each is looked up
    ;; afresh; one that is already gone (or never existed) is simply skipped.
    ;;
    ;; The echo is re-stated at the end, naming what the reader actually killed. Each
    ;; companion kill echoes its own name as it goes, and the last one won: killing
    ;; *Tutorial* reported "killed *Workings*", which is not the buffer anyone asked about.
    (let ([m2 also] (fold companions
                      [m1 (list)]
                      (fn (acc nm)
                        (let ([mm killed] acc
                              i (ed-buffer-index-by-name mm nm))
                          (cond
                            (nil? i) acc
                            (= nm "*Messages*") acc
                            else [(ed-kill-at mm i false) (append killed (list nm))])))))
      (if (empty? also)
        m2
        (message m2 (str label " (with " (string/join also ", ") ")"))))))

(defcommand cmd-kill-buffer
  (m key)
  "Kill the current buffer (C-x k) — asking first when it holds unsaved changes to a
file. Refuses to kill `*Messages*`; if it would leave
no editable buffer, opens a fresh `*scratch*`. Panes showing the killed buffer are
re-pointed; indices above it shift down. A hosted slot is unhosted first — its
process stopped when locally owned, presence withdrawn when shared — and the
surviving hosted links are remapped with the pool (`hosted/hosted-drop-slot`).
The buffer's mode layers get their `:on-close` (via std's `close-context`) — the
async-cleanup seam where a mode kills a worker it owns (the tutorial's eval
sandbox; a natural home for bshell's shell process too) — and any companion buffers
that mode asked to take with it (`layers/request-close`) are killed as well."
  (let (buf (ed-current-buf m))
    (cond
      (= (buffer-name buf) "*Messages*") (message m "cannot kill *Messages*")
      ;; unsaved changes to a file: ask, as Emacs does, rather than drop them silently
      (and (buffer-modified? buf) (buffer-file buf))
        (ed-read-char m
          (str "Buffer " (buffer-name buf) " modified; kill anyway? (y or n)")
          (fn (mm k)
            (if (or (= k "y") (= k "Y"))
              (ed-kill-at mm (ed-current-index mm) true)
              (message mm "kill canceled"))))
      else (ed-kill-at m (ed-current-index m) true))))

(sig ed-kill-buffer-named (model string -> model))
(defn ed-kill-buffer-named (m nm)
  "Kill the pool buffer named `nm` — the full `ed-kill-at` path (its `:on-close`, the
pane re-point), companions not followed — or `m` unchanged when there is none. For a mode
closing a pane it owns (`aside/close`), which knows the pane by NAME and is not on it."
  (let (idx (ed-buffer-index-by-name m nm))
    (if (nil? idx) m (ed-kill-at m idx false))))

(defn ed-kill-buffer-at (m idx)
  "Kill pool buffer `idx` — the full `ed-kill-at` path, companions not followed. For a
caller that knows the buffer by its SLOT because a name would be ambiguous: another
frame's kill arrives keyed by document (`frames/ed-ev-registry-removed`), and two
buffers may share a display name."
  (ed-kill-at m idx false))

;; check-allow: the link's command is resolved late (`reflect/eval`), so its result is unknown
;; to the checker; every command answers a model
(check-allow :trusted
  (defcommand cmd-welcome-link
    (m key)
    "The welcome scratch's `:on-click`: a click that landed on a link line
(`modes/*welcome-links*` — the bedit tutorial, the Brood playground) runs that
line's command; a click anywhere else in the buffer is just a click. The targets
are deferred-loaded (~a second after startup), so a faster click gets told to try
again rather than an unbound error."
    (let (b (ed-current-buf m)
          line (buffer-line-at b (buffer-current-line b))
          link (modes/welcome-link-at line))
      (cond
        (nil? link) m
        (bound? (second link)) ((reflect/eval (second link)) m key)
        :else (message m "that one is still loading — one second, then click again")))))

(defn ed-open-buffer (m buf)
  "Add `buf` to the pool (mode-stamped, and carrying a `:dir`) and show it in the selected
pane. A buffer with no `:dir` of its own — a fileless one (scratch, *Occur*, …) — inherits
the **current** buffer's `:dir`, so it opens 'in' the directory/project you were in (Emacs
`default-directory` inheritance)."
  (let (stamped (ed-stamp buf)
        with-dir (if (nil? (:dir stamped))
                   (assoc stamped :dir (:dir (ed-current-buf m)))
                   stamped)
        bufs (into (:buffers m) [with-dir]))
    (ed-select (assoc m :buffers bufs) (dec (count bufs)))))

(defn ed-upsert-named (m nm text &optional (type nil))
  "Add or replace the pool buffer named `nm` holding `text` (stamped `type`, so a special mode
and its read-only `:activate` hook apply) **without** touching the layout or selection. The
pool-side half shared by `ed-show-named` (which then selects it) and `ed-show-named-aside`
(which shows it in a side pane). Look the buffer's index up afterwards with
`ed-buffer-index-by-name`. A fresh buffer inherits the current buffer's `:dir`; a re-show keeps
the existing one's."
  (let (idx (ed-buffer-index-by-name m nm)
        raw (make-buffer text nm)
        buf (if (nil? type) raw (editor/layers/set-buffer-type raw type)))
    (if (nil? idx)
      (assoc m
        :buffers
          (into (:buffers m)
            [(assoc (ed-stamp buf) :dir (:dir (ed-current-buf m)))]))
      (assoc m
        :buffers
          (assoc (:buffers m)
            idx
              (assoc (ed-stamp buf)
                :dir
                  (or (get (nth (:buffers m) idx) :dir)
                    (:dir (ed-current-buf m)))))))))

(defn- ed-other-pane-path (layout)
  "The path of the pane `C-x o` would move to from the selected one (the next leaf in traversal
order, wrapping) — where a side/preview buffer goes."
  (let (paths (pane-leaf-paths layout)
        i (index-of paths (pane-selected-path layout)))
    (nth paths (math/mod (inc i) (count paths)))))

(defn- ed-pane-showing (layout idx)
  "The path of the first pane already showing pool buffer `idx`, or nil — the reuse probe
behind `ed-display-buffer` (an existing window wins over a fresh split, like Emacs
`display-buffer`). Reads each pane's payload by path (`pane-payload-at`, std editor/pane)."
  (seq/find (pane-leaf-paths layout) (fn (p) (= idx (:buffer (pane-payload-at layout p))))))

(defn- ed-place-aside (layout idx)
  "Show buffer `idx` in a pane beside the selected one, returning `{:layout :path}`: split the
lone pane off (new pane on the right at `:path`), else re-point the next pane in traversal order.
Selection is left untouched — the caller decides whether to move onto `:path`."
  (if (= (pane-count layout) 1)
    {:layout (pane-split layout :col (ed-pane idx))
     :path (append (pane-selected-path layout) (list :b))}
    (let (p (ed-other-pane-path layout))
      {:layout (pane-update-path layout
                 p
                 (fn (w) (assoc w :buffer idx :top 0 :point nil :mark nil)))
       :path p})))

(defn ed-display-buffer (m nm text &optional (type nil) (opts {}))
  "The single place a command hands a report buffer to the window manager — an Emacs
`display-buffer`/`pop-to-buffer` analog, so callers say WHAT to show and HOW, never WHERE.
Upserts `nm`/`text`/`type` into the pool (stamping `type` so a special mode + its read-only
`:activate` hook apply, and re-apply on every re-show), then places it by `(:action opts)`:
  `:here`    — the selected pane, replacing it, and select it (the default).
  `:pop`     — another pane, moving selection there (Emacs `pop-to-buffer`).
  `:display` — another pane, selection left put — a preview (press-to-preview lists).
Reuse first: if some pane already shows `nm`, that pane is used in place — no new split —
matching `display-buffer`'s reuse rule. The reuse seam for generated/refreshable buffers
(*Process List*, *git-log*, *git-diff*, …).

Two more options shape a buffer that is RE-shown as it changes rather than regenerated:
`:spans` stamps `[start end face]` faces onto the buffer as data (`:face-spans`, for text
whose faces no lexer can recover — a rendered preview); `:keep-scroll` leaves a reused
pane's scroll where it was instead of returning it to the top, so a refresh under a
reader does not yank the view (the caller then places it — `mdpreview` follows the
cursor)."
  (let (action (:action opts :here)
        m1 (ed-upsert-named m nm text type)
        idx (ed-buffer-index-by-name! m1 nm) ; `ed-upsert-named` just put it there
        m1 (if (contains? opts :spans)
             (assoc m1
               :buffers
                 (assoc (:buffers m1) idx (assoc (ed-buf-at m1 idx) :face-spans (:spans opts))))
             m1)
        layout (:layout m1))
    (if (= action :here)
      (ed-select m1 idx)
      (let (existing (ed-pane-showing layout idx)
            placed (if (nil? existing) (ed-place-aside layout idx) {:layout layout :path existing})
            ;; Reset the target pane to the top of the (freshly regenerated) report, clearing any
            ;; stale scroll/point a reused pane carried from a previous, longer buffer — a shorter
            ;; refresh would otherwise render a point past the new end (out-of-bounds). A
            ;; `:keep-scroll` caller keeps the scroll (`ed-pane-top` clamps it into the buffer).
            reset (pane-update-path (:layout placed)
                    (:path placed)
                    (fn (w)
                      (if (:keep-scroll opts)
                        (assoc w :point nil :mark nil)
                        (assoc w :top 0 :point nil :mark nil))))
            m2 (assoc m1 :layout reset))
        (if (= action :pop)
          (assoc m2 :layout (pane-select-path (:layout m2) (:path placed)))
          m2)))))

(defn ed-show-named (m nm text &optional (type nil))
  "Show report buffer `nm`/`text`/`type` in the selected pane (replacing it) and select it —
the thin `ed-display-buffer` `:here` wrapper kept for existing callers."
  (ed-display-buffer m nm text type {:action :here}))

(defn ed-show-named-aside (m nm text &optional (type nil))
  "Show report buffer `nm`/`text`/`type` in a side / preview pane without moving selection —
the thin `ed-display-buffer` `:display` wrapper. Splits a lone pane off, else reuses the next
pane; if the buffer is already visible, that pane is refreshed in place (press-to-preview)."
  (ed-display-buffer m nm text type {:action :display}))

(defn ed-switch-to-named (m nm)
  "Switch to the buffer named `nm`, or report there's no such buffer."
  (let (idx (ed-buffer-index-by-name m nm))
    (if (nil? idx) (message m (str "no buffer named " nm)) (ed-select m idx))))

;; ---- visit-location: the shared report-row jump ------------------------------
;; The location vocabulary (parse a row → `{:file :line :col}`) and the read-only
;; navigable layer now live in `src/results.blsp` (the results-buffer abstraction).
;; The *command* stays here: it resolves the current row's location through the layer's
;; `:line-loc` service (`results/line-loc-service`) and hands it to `ed-pop-to-file`,
;; the pane/pool navigation below.

;; ---- next-error: jump to a source location from a results buffer -------------
;; The Emacs `next-error` / `display-buffer-other-window` discipline, as ONE
;; primitive every results buffer shares (*Tests* / *Run* / *compilation* / *Occur*
;; / *git-status*): a jump opens the source in a pane OTHER than the results pane —
;; the results stay visible — and moves selection there. A buffer computes its own
;; source location (the `:line-loc` mode service, or git's row→path) and hands it to
;; `ed-pop-to-file`; WHERE/HOW lives here, once.

(defn- ed-ensure-file-buffer (m path)
  "Ensure the (absolute) `path` is in the pool WITHOUT changing selection — returns
`[m idx]`. Reuses an open buffer for the file, else reads-or-news it (find-file
semantics: an existing file is read, a missing one starts a fresh backed buffer)."
  (let (idx (ed-buffer-index-by-file m path))
    (if idx
      [m idx]
      (let (root (or (project-root (path/dirname path)) (:project-root m))
            buf (ed-stamp (assoc (find-file-buffer path) :name (file-display-name path root)))
            with-dir (if (nil? (:dir buf)) (assoc buf :dir (:dir (ed-current-buf m))) buf)
            bufs (into (:buffers m) [with-dir]))
        [(assoc m :buffers bufs) (dec (count bufs))]))))

(defn ed-pop-to-index (m idx line)
  "Show pool buffer `idx` at (1-based) `line` in a pane OTHER than the current one, select
that pane and put point on the line — the placement half of [[ed-pop-to-file]], shared so a
location naming a BUFFER lands exactly where one naming a file does."
  (let (layout (:layout m)
        existing (ed-pane-showing layout idx)
        placed (if (nil? existing) (ed-place-aside layout idx) {:layout layout :path existing})
        m1 (assoc m :layout (pane-select-path (:layout placed) (:path placed))))
    ;; point moves; the loop's own scroll-clamp on the (now-selected) source pane
    ;; brings it on screen this tick, as with `cmd-goto-definition`.
    (ed-apply m1 (fn (b) (ed-goto-line b line)))))

(defn ed-pop-to-buffer-named (m nm line)
  "[[ed-pop-to-index]] for a buffer named rather than a file — what a location `{:buffer …}`
visits. A buffer that is no longer in the pool says so instead of jumping somewhere else."
  (let (idx (ed-buffer-index-by-name m nm))
    (if (nil? idx) (message m (str nm " is no longer open")) (ed-pop-to-index m idx line))))

(defn ed-pop-to-file (m path line)
  "Emacs `next-error` / `display-buffer-other-window`: show `path` at (1-based)
`line` in a pane OTHER than the current one — the results buffer stays visible —
select that pane, and put point on the line. Reuses a pane already showing the file;
splits a lone pane (the results buffer keeps the original). THE jump every
results-buffer 'visit source' routes through, so the behaviour is uniform."
  (if (string/blank? path)
    (message m "(no file)")
    (let ([m1 idx] (ed-ensure-file-buffer m (path/absolute path)))
      (ed-pop-to-index m1 idx line))))

(defcommand cmd-visit-location
  (m key)
  "Visit the source location named on the current report row (RET / mouse click —
`results/location-jump-layer`). Resolves the location of THIS line only (the mode's
`:line-loc`, default `loc-at-line`'s `file:line[:col]:`) — the same predicate that
paints the pointer cursor + underline, so a click navigates exactly where the row
reads as a link and a click on a non-link line does nothing. A relative path
resolves against the project root; a non-location line is silent on a click, says so
on RET."
  (let (buf (ed-current-buf m)
        loc ((line-loc-service buf) buf (buffer-current-line buf)))
    (cond
      (nil? loc) (if (= key :mouse) m (message m "not on a location line"))
      ;; a location may name a BUFFER instead of a file — a diagnostic on a scratch or
      ;; playground buffer has a line to visit and no path to resolve, and sending it
      ;; through the file branch would resolve its NAME against the project root and open
      ;; an empty file called `*Playground*`
      (:buffer loc) (ed-pop-to-buffer-named m (:buffer loc) (:line loc))
      else
        (let (path (:file loc)
              resolved (if (string/starts-with? path "/")
                         path
                         (str (or (:project-root m) (file/cwd)) "/" path)))
          ;; next-error discipline: source opens in another pane, results stay put
          (ed-pop-to-file m resolved (:line loc))))))

(defn ed-find-file (m path)
  "Open `path`: switch to it if already open, read it if it exists, else start a
fresh buffer backed by it (so Ctrl-S creates it). A relative or `~` path is resolved
to absolute (`path-absolute`) first, so the prompt can stay short/relative while the
buffer's `:file`, dedup, and project-relative name all key off a canonical path. A
directory opens in dired (Emacs `find-file` on a directory), a file that is not UTF-8 as
a hex view (`ed-open-binary`)."
  (cond
    (string/blank? path) (message m "(no file)")
    (file/dir? (path/absolute path)) (ed-open-dired m (path/absolute path))
    else
      (let (path (path/normalize (path/absolute path)) ; `./` and `..` collapsed: one spelling per file
            _ (when (:recent-files m) (remember-file! path)) ; recentf — live editor only
            ;; The project follows the file you visit (Emacs `default-directory`): resolve
            ;; the visited file's project root (`.git` / `project.blsp`) and make it the
            ;; model's `:project-root`, so the mode line, find-file-in-project, and the
            ;; project-relative name all track the buffer — not the dir the editor launched
            ;; in. Falls back to the model's existing `:project-root` when the file isn't in
            ;; a resolvable project (e.g. a virtual path). Record a freshly-resolved project
            ;; as known too (best-effort, live editor only).
            resolved (project-root (path/dirname path)) ; the visited file's real project, or nil
            root (or resolved (:project-root m))
            _ (when (and resolved (:recent-files m)) (remember-project! resolved))
            ;; record the visit in the project's per-project recent list (the "last access"
            ;; the default project-file sort orders by) — relative to the project root
            _ (when (and resolved (:recent-files m) (string/starts-with? path (str resolved "/")))
                (remember-project-file! resolved
                  (string/substring path (string/length (str resolved "/")))))
            m (if (nil? root) m (assoc m :project-root root))
            idx (ed-buffer-index-by-file m path))
        (if idx
          (ed-select m idx)
          ;; read-or-new (vim/emacs find-file) via the shared toolkit primitive; the
          ;; try guards a read error (e.g. a permission denial on an existing file). The
          ;; display name is project-relative inside a project, else the basename
          ;; (`file-display-name`) — `:file` keeps the full path for saving / dedup.
          ;; A file that exists but is not UTF-8 (an ELF, an image) opens as a hex view
          ;; (`ed-open-binary`, Emacs hexl-mode) instead of failing on the decode.
          (if (and (file/exists? path) (not (utf8-file? path)))
            (ed-open-binary m path root)
            (try
              (let (buf (assoc (find-file-buffer path)
                          :name (file-display-name path root)))
                (message (ed-open-buffer m buf)
                  (if (file/exists? path) (str "opened " path) (str "new file " path))))
              (catch e (message m (str "open failed: " (error-message e))))))))))
(sig ed-find-file (model string -> model))

;; ---- panes (tiled splits, Emacs C-x 2/3/0/1/o) ----------------------------
;; Operate on the model's `:layout` pane tree (std/pane). A split shows the
;; same buffer in the new pane (point/scroll independent); selection/edits follow
;; the selected pane.

(defn- ed-split (m dir)
  "Split the selected pane in `dir` (`:row` = top/bottom, `:col` = left/right); both panes show
the current buffer at the current point/mark AND the same scroll position, each then tracking
**independently** (window-point — `model/ed-with-window-point`). Snapshotting the point onto
BOTH panes is what stops a later move in one from dragging the other: a pane with no
window-point falls back to the shared buffer point, so the original pane needs its own
snapshot too, not just the new one.

The SCROLL is carried for the same reason Emacs's `C-x 2` shows you the same text twice. The
new pane used to start at `:top 0` while its point was wherever yours was — so it opened on
the top of the file with the cursor off screen, and the first key you pressed in it made the
viewport snap down to point. That reads as the pane jumping when you navigate to it; it is
really the pane having been wrong since it opened."
  (let (b (ed-current-buf m)
        pt (buffer-point b)
        mk (buffer-mark b)
        here (ed-current-pane m)
        anchored (pane-update-selected (:layout m) (fn (w) (assoc w :point pt :mark mk))))
    (assoc m
      :layout
        (pane-split anchored
          dir
          (assoc (ed-pane (ed-current-index m))
            :point pt
            :mark mk
            :top (get here :top 0)
            :hscroll (get here :hscroll 0)
            :scroll-frac (get here :scroll-frac 0.0))))))

(defcommand cmd-split-pane-below
  (m key)
  "Split the selected pane top/bottom; the new pane shows the same buffer, cursor independent (C-x 2)."
  (ed-split m :row))

(defcommand cmd-split-pane-right
  (m key)
  "Split the selected pane left/right; the new pane shows the same buffer, cursor independent (C-x 3)."
  (ed-split m :col))

(defcommand cmd-other-pane
  (m key)
  "Move selection to the next pane, wrapping (C-x o)."
  (assoc m :layout (pane-other (:layout m))))

(defcommand cmd-delete-pane
  (m key)
  "Delete the selected pane; its sibling fills the space (C-x 0)."
  (assoc m :layout (pane-delete (:layout m))))

(defcommand cmd-delete-other-panes
  (m key)
  "Collapse the layout to just the selected pane (C-x 1)."
  (assoc m :layout (pane-delete-others (:layout m))))

;; ---- moving panes around: windmove / buffer-move / transpose-frame ------------
;; The mechanism is `editor/pane` (`pane-neighbor`, `pane-swap`, `pane-rotate`,
;; `pane-transpose`, `pane-flip`); this is the policy — which key, what the echo says, and
;; that a swap FOLLOWS the buffer (you keep looking at what you were looking at, one pane
;; over), which is what makes `C-S-<arrow>` read as "move this window".

(def- ed-dir-name {:left "left" :right "right" :up "up" :down "down"})

(sig ed-neighbor-path (model keyword -> any))
(defn- ed-neighbor-path (m dir)
  "The path of the pane beside the selected one in `dir`, or nil at the edge (or before
any frame has laid the panes out — `ed-layout-now`)."
  (let (layout (ed-layout-now m))
    (if (nil? layout)
      nil
      (let (p (pane-neighbor layout (pane-selected-path (:layout m)) dir))
        (if (nil? p) nil (:path p))))))

(sig ed-windmove (model keyword -> model))
(defn ed-windmove (m dir)
  "Select the pane in direction `dir` (windmove), or say there is none."
  (let (to (ed-neighbor-path m dir))
    (if (nil? to)
      (message m (str "no window " (get ed-dir-name dir)))
      (assoc m :layout (pane-select-path (:layout m) to)))))

(sig ed-swap-pane (model keyword -> model))
(defn ed-swap-pane (m dir)
  "Move the selected pane's buffer into the pane in direction `dir`, taking that pane's
buffer in exchange, and follow it — selection ends up on the neighbour, still on your
buffer (`buffer-move`'s `buf-move-<dir>`). At the edge, says so."
  (let (to (ed-neighbor-path m dir))
    (if (nil? to)
      (message m (str "no window " (get ed-dir-name dir) " to swap with"))
      (let (here (pane-selected-path (:layout m)))
        (assoc m :layout (pane-select-path (pane-swap (:layout m) here to) to))))))

(defcommand cmd-windmove-left
  (m key)
  "Select the pane to the left (M-<left>)."
  (ed-windmove m :left))
(defcommand cmd-windmove-right
  (m key)
  "Select the pane to the right (M-<right>)."
  (ed-windmove m :right))
(defcommand cmd-windmove-up (m key) "Select the pane above (M-<up>)." (ed-windmove m :up))
(defcommand cmd-windmove-down (m key) "Select the pane below (M-<down>)." (ed-windmove m :down))

(defcommand cmd-swap-pane-left
  (m key)
  "Move this window left: swap its buffer with the pane to the left and follow it (C-S-<left>)."
  (ed-swap-pane m :left))
(defcommand cmd-swap-pane-right
  (m key)
  "Move this window right: swap its buffer with the pane to the right and follow it (C-S-<right>)."
  (ed-swap-pane m :right))
(defcommand cmd-swap-pane-up
  (m key)
  "Move this window up: swap its buffer with the pane above and follow it (C-S-<up>)."
  (ed-swap-pane m :up))
(defcommand cmd-swap-pane-down
  (m key)
  "Move this window down: swap its buffer with the pane below and follow it (C-S-<down>)."
  (ed-swap-pane m :down))

(defcommand cmd-rotate-panes
  (m key)
  "Rotate every pane's buffer one step forward through the layout (M-x rotate-windows;
`C-u N` for N steps, a negative argument turns the other way). Selection stays in
place, so the pane you are in shows the next buffer along."
  (message (assoc m :layout (pane-rotate (:layout m) 1)) "windows rotated"))

(defcommand cmd-rotate-panes-backward
  (m key)
  "Rotate every pane's buffer one step backward through the layout (M-x
rotate-windows-backward) — `rotate-windows` under a negative argument."
  (message (assoc m :layout (pane-rotate (:layout m) -1)) "windows rotated back"))
(register-inverse 'commands/cmd-rotate-panes 'commands/cmd-rotate-panes-backward)

(defcommand cmd-transpose-panes
  (m key)
  "Turn every split the other way — stacked panes become side by side and back
(M-x transpose-windows; `transpose-frame`)."
  (message (assoc m :layout (pane-transpose (:layout m))) "windows transposed"))

(defcommand cmd-flip-panes
  (m key)
  "Mirror the layout top-to-bottom (M-x flip-windows; `flip-frame`) — every stacked split's
panes exchange places, sizes kept."
  (message (assoc m :layout (pane-flip (:layout m) :row)) "windows flipped"))

(defcommand cmd-flop-panes
  (m key)
  "Mirror the layout left-to-right (M-x flop-windows; `flop-frame`) — every side-by-side
split's panes exchange places, sizes kept."
  (message (assoc m :layout (pane-flip (:layout m) :col)) "windows flopped"))

(defcommand cmd-toggle-line-numbers
  (m key)
  "Toggle the left line-number gutter on the selected pane (C-x l). Pane-local, so
one pane can show numbers while another doesn't."
  (ed-toggle-line-numbers m))

(defcommand cmd-visual-line-mode
  (m key)
  "Toggle visual-line-mode on the current buffer (M-x visual-line-mode): a long line
shows on as many rows as it needs, broken after words (`wrap/segments`), instead of
scrolling sideways — Emacs's `visual-line-mode`, per buffer. The horizontal scroll is
reset when it turns on (a wrapped buffer never scrolls sideways) and the mode line says
`Wrap`. `C-n`/`C-p` still move by logical line."
  (let (buf (ed-current-buf m)
        on? (not (ed-wrap? buf))
        m2 (ed-set-buf m (assoc buf :visual-line on?)))
    (message (if on? (ed-set-hscroll m2 0) m2)
      (if on? "visual-line-mode on: long lines wrap" "visual-line-mode off: long lines scroll"))))

;; ---- buffer/file prompts (open a minibuffer; see input/minibuffer-handle) ---

(defcommand cmd-switch-buffer
  (m key)
  "Prompt for a buffer to switch to (C-x b), the Emacs way: the default — named in the
prompt — is the buffer you were in BEFORE this one (`ed-other-buffer`), so `C-x b RET`
flips back and forth between two buffers; the candidates are every open buffer but this
one, most recently selected first (`ed-recent-buffers`); a typed name completes against
them."
  (let (cur (buffer-name (ed-current-buf m))
        dflt (ed-other-buffer m)
        names (seq/reject (ed-recent-buffers m) (fn (n) (= n cur)))
        prompt (if dflt (str "Switch to buffer (default " dflt "): ") "Switch to buffer: "))
    (assoc m
      :minibuffer
        (ed-name-prompt prompt
          names
          (fn (mm t)
            (let (target (if (string/blank? t) dflt t))
              (if (nil? target)
                (message mm "no other buffer")
                (ed-switch-to-named mm target))))
          20
          names))))

(defn ed-default-dir (m)
  "The current buffer's directory (Emacs `default-directory`) — its **`:dir`**: every buffer
carries one (a file's folder via `ed-stamp`, a Dired listing's dir, a shell's root, or
inherited by a fileless buffer from the one it was created in). Falls back to a visited
file's folder, then the working dir. The one place find-file, Dired, and `ed-project-root`
read — so every path/project input starts from where you *are*, uniformly across buffers."
  (let (b (ed-current-buf m))
    (or (:dir b)
      (let (f (buffer-file b)) (if (nil? f) (file/cwd) (path/dirname f))))))

(defn ed-path-prompt (prompt initial recent on-complete)
  "The shared path-completing minibuffer spec — the ONE shape every file/folder input uses
(find-file, dired): prefilled with `initial` (an absolute dir; `:word-mode :path` so
`C-w`/`M-DEL` walks **up** a component at a time, no `../`), a Plume candidate list of the
entries completing the typed path (recentf floated to the top via `recent`, basename
labels, perms/size/time marginalia), `Tab` to expand. `on-complete` is `(model text) ->
model` — what to do with the chosen path. Consistent across the board."
  {:edit (assoc (ed-mb-edit prompt initial) :word-mode :path)
   :complete-fn (fn (t) (ed-complete-path t))
   :candidates-fn (fn (t) (take (ed-sort-candidates (ed-path-candidates t) recent) 12))
   :label-fn path-label ; show basenames in the list, not the full absolute path
   :category :file ; marginalia: perms/size/mtime per row
   :accept-selection true
   :on-complete on-complete})

(defn- ed-find-file-prompt (initial recent &optional (open nil) (prompt nil))
  "The find-file prompt over `ed-path-prompt`: **selecting a directory re-opens the prompt
inside it** (descend, carrying the same `recent`); a file (or a typed path with no
candidate) is handed to `open` — `ed-find-file` by default, which opens it here.

`open` is a parameter so `C-x 4 f` is this same prompt with a different destination
(`ed-find-file-other-window`) rather than a second copy of the descend logic. WHERE a
buffer goes is the only thing the two commands disagree about; Emacs splits them into two
functions and bedit does not need to."
  (ed-path-prompt (or prompt "Find file: ")
    initial
    recent
    (fn (mm t)
      (if (string/ends-with? t "/")
        (assoc mm :minibuffer (ed-find-file-prompt t recent open prompt)) ; a directory → descend
        ((or open ed-find-file) mm t)))))

;; ---- C-x 4: the other-window prefix -----------------------------------------
;; Emacs's second-most-used prefix after C-x itself, and it was entirely absent. Every
;; piece it needs already existed: `ed-pop-to-file` / `ed-pop-to-index` are the
;; "other pane, select it, point on the line" placement that `next-error` and
;; goto-definition have used all along, and the prompts are the same ones `C-x C-f` and
;; `C-x b` open. This is the prefix wired onto them, not new machinery.

(defn ed-find-file-other-window (m path)
  "Open `path` in a pane OTHER than the current one and select it (`C-x 4 f`).

Goes through `ed-pop-to-file`, so it inherits the placement rule the results buffers
already follow: reuse a pane already showing the file, split a lone pane, otherwise take
the next one — Emacs `display-buffer`'s reuse-first order."
  (ed-pop-to-file m path 1))

(defcommand cmd-find-file-other-window
  (m key)
  "Find a file in the other window (C-x 4 f) — the `C-x C-f` prompt, opening into another
pane instead of replacing this one."
  (assoc m
    :minibuffer
      (ed-find-file-other-window-prompt (str (ed-default-dir m) "/")
        (if (:recent-files m) (recent-files) []))))

(defn- ed-find-file-other-window-prompt (initial recent)
  "`ed-find-file-prompt` pointed at the other window, with a prompt that says so."
  (ed-find-file-prompt initial recent ed-find-file-other-window "Find file other window: "))

(defcommand cmd-switch-buffer-other-window
  (m key)
  "Switch to a buffer in the other window (C-x 4 b) — the `C-x b` prompt, displaying into
another pane and selecting it."
  (let (cur (buffer-name (ed-current-buf m))
        names (seq/reject (ed-recent-buffers m) (fn (n) (= n cur))))
    (assoc m
      :minibuffer
        (ed-name-prompt "Switch to buffer other window: "
          names
          (fn (mm t)
            (if (string/blank? t)
              (message mm "no buffer")
              (ed-pop-to-buffer-named mm t 1)))))))

(defcommand cmd-dired-other-window
  (m key)
  "Open Dired in the other window (C-x 4 d) — on the current buffer's directory."
  (let (dir (ed-default-dir m)
        ;; dired's buffer is generated, so it has to exist before it can be popped to:
        ;; build it here (which selects it), then place it where `C-x 4` promised. The
        ;; two-step is what keeps `dired/ed-show-dired` the single owner of the listing.
        m1 (ed-open-dired m dir)
        nm (buffer-name (ed-current-buf m1)))
    (ed-pop-to-buffer-named (ed-show-index m1 (ed-current-index m)) nm 1)))

(defcommand cmd-kill-buffer-and-window
  (m key)
  "Kill this buffer and delete its pane (C-x 4 0) — the pair you almost always want after
reading something in a `C-x 4` pane, and two keystrokes with a buffer switch between them
when done as `C-x k` `C-x 0`."
  (let (doomed (buffer-name (ed-current-buf m))
        killed (cmd-kill-buffer m key)
        ;; Did the kill actually happen? Ask whether the buffer is GONE — not whether we
        ;; landed somewhere that looks like a refusal. `cmd-kill-buffer` can decline
        ;; (*Messages*) or ask first (unsaved changes, leaving a `:read-char` prompt), and
        ;; deleting the pane under either would answer a question not yet put to the
        ;; reader. Proxies for this are wrong in the obvious case: *Messages* is also
        ;; exactly where a SUCCESSFUL kill often leaves you, so "are we in *Messages*"
        ;; refused every ordinary kill.
        gone? (nil? (ed-buffer-index-by-name killed doomed)))
    (if (and gone? (nil? (:read-char killed)))
      (assoc killed :layout (pane-delete (:layout killed)))
      killed)))

(defcommand cmd-find-file
  (m key)
  "Prompt (minibuffer) for a file path to open (C-x C-f), completing against the
filesystem; prefilled with the working directory. The Vertico list shows each entry's
basename (relative to the folder you're in); Tab expands; Enter opens the selected file
or descends into a selected directory; deleting back (C-w) walks **up** the tree like
Emacs — no `../` needed. Last-used files (recentf) sort to the top, then by name."
  (assoc m
    :minibuffer
      (ed-find-file-prompt (str (ed-default-dir m) "/")
        ; the current buffer's dir, not the launch cwd
        (if (:recent-files m) (recent-files) [])))) ; recency only in the live editor
(defn ed-project-root (m)
  "The current project's root — resolved **live from the current buffer's directory**
(Emacs `project-current`/`default-directory`): the nearest ancestor of the buffer's file
holding a `*project-markers*` entry. So every project command (C-x p e/f/p/d) and Dired
acts on the project you're *visiting*, not where the editor launched. Falls back to the
model's cached `:project-root` (for a fileless buffer like *scratch*/*bshell*), then the
working dir. Nil when there's no project anywhere."
  (or (project-root (ed-default-dir m))
    (:project-root m)
    (project-root (file/cwd))))

(defn- ed-project-prompt (root files)
  "The find-file-in-project minibuffer spec over `files` (root-relative paths). Separate from
the command because the file list arrives LATE: the prompt opens over `()` and this same
shape is rebuilt around the real list when the walk lands (`ed-apply-project-scan`), so the
two can never describe different things."
  {:edit (assoc (ed-mb-edit "Find file in project: " "") :word-mode :path) ; M-b/M-f by folder
   :on-complete (fn (mm t)
                  ;; a Vertico selection is a real project file → open it; a
                  ;; typed string with no selection falls back to a prefix match.
                  (if (includes? files t)
                    (ed-find-file mm (path/join root t))
                    (let (ms (project-matches t files))
                      (if (empty? ms)
                        (message mm (str "no project file matching \"" t "\""))
                        (ed-find-file mm (path/join root (first ms)))))))
   ;; Tab completes the typed path one component at a time — the identical
   ;; `complete-prefix` action as find-file's Tab, over the project files that
   ;; start with what's typed (prefix, so Tab only ever extends, never shrinks).
   :complete-fn (fn (t) (complete-prefix t (project-matches t files)))
   ;; default order: most-recently-visited (per project) first, then by last-written
   :rank-source (sort-project-files root files) ; narrowed incrementally as you type
   :rank-cap 20
   :category :file ; marginalia per row …
   :anno-base root ; … the candidate is project-root-relative, so resolve from here
   :accept-selection true})

(defn ed-find-file-in-project (m root)
  "Open the find-file-in-project minibuffer over the files under `root` (recursive,
root-relative; Tab narrows, Enter opens the first match). The shared core of `C-x p f`
(root = the *current* project) and `C-x p p` (root = the *chosen* project) — so a switch
lists the files of the project it switched to, not wherever the current buffer sits."
  (if (nil? root)
    (message m "not in a project (no project.blsp found)")
    ;; Recording the project writes the on-disk cache, so it is gated on `:recent-files` —
    ;; the live-editor flag `main` sets, exactly as recentf, bookmarks and the tutorial's
    ;; progress are. Ungated, ANY model reached this: a pure model test would rewrite the
    ;; developer's real `~/.config/bedit/state/projects.blsp` with its /tmp fixtures,
    ;; which is why `panes_projects_test` used to save and restore that file by hand.
    (let (_ (when (:recent-files m) (remember-project! root)))
      (if (ed-headless?)
        (assoc m :minibuffer (ed-project-prompt root (project-files root)))
        ;; The prompt opens NOW and the list arrives when the walk does. `project-files` is
        ;; `git ls-files` in a subprocess — 35 ms on a 27,310-file project — and every
        ;; millisecond of it was spent between pressing `C-x p f` and the prompt appearing.
        (let (job (task (fn () (project-files root))))
          (assoc m
            :minibuffer (assoc (ed-project-prompt root '()) :scanning root)
            :project-scan job))))))

;; the project file walk, off the loop (`model/register-task-reply`)
(register-task-reply :project-scan 'commands/ed-apply-project-scan '() "scanning")
(defn ed-apply-project-scan (m files)
  "Fill the open find-file-in-project prompt with the files the walk found, keeping whatever
the reader has typed in the meantime. Dropped unless a prompt is still open and still waiting
(`:scanning`) — closing it, or opening another, must not be overwritten by a walk that was
already running."
  (let (mb (:minibuffer m)
        m1 (dissoc m :project-scan))
    (if (or (nil? mb) (nil? (:scanning mb)))
      m1
      (assoc m1
        :minibuffer (assoc (ed-project-prompt (:scanning mb) files) :edit (:edit mb) :sel 0)))))

(defcommand cmd-project-find-file
  (m key)
  "Find a file anywhere in the current project (C-x p f): a minibuffer completing over every
file under the project you're in. Reports when not in a project."
  (ed-find-file-in-project m (ed-project-root m)))

;; ---- C-x p p: pick a project, then say what to DO in it ---------------------
;; Emacs `project-switch-project` is two steps, and the second one is the part that makes it
;; a project switcher rather than a find-file with extra keys: having chosen a project it
;; shows `project-switch-commands` — a menu of what you might want to do there — and one
;; keystroke picks. bedit used to skip it and force find-file, which is only ever right when
;; find-file is what you wanted.

(def *project-switch-commands*
  ;; `[key label command-symbol]` per row — Emacs's `project-switch-commands` as DATA. The
  ;; symbol is resolved at the keystroke (`reflect/eval`), exactly like a keymap binding, so
  ;; a redefined command hot-swaps and a deferred module (git, bshell, compile) loads when
  ;; its row is chosen rather than at startup. Adding an entry is a row.
  [["f" "Find file" 'commands/cmd-project-find-file]
    ["g" "Find regexp" 'project-search/cmd-project-find-regexp]
    ["d" "Dired" 'commands/cmd-project-dired]
    ["v" "VC status" 'git/cmd-git-status]
    ["e" "Shell" 'bshell/cmd-project-bshell]
    ["r" "REPL" 'term/cmd-project-repl]
    ["t" "Terminal" 'term/cmd-term]
    ["c" "Compile" 'compile/cmd-compile]])

(defn project-switch-label ()
  "The dispatch menu as one echo-area line — `[f] Find file  [g] Find regexp  …`. Built from
`*project-switch-commands*`, so the menu can never disagree with what the keys do."
  (string/join (map *project-switch-commands* (fn ([key label _]) (str "[" key "] " label))) "  "))

(defn ed-project-switch-to (m root)
  "The model moved INTO project `root`: the current buffer's directory becomes the root and
`:project-root` is set, so every project command — which resolves the project live from the
buffer's directory (`ed-project-root`) — acts on the project just switched to rather than on
the one the buffer still sits in. Emacs binds `default-directory` around the dispatched
command for the same reason. Also records `root` as most-recently-used, gated on
`:recent-files` like every other on-disk cache write."
  (let (m1 (assoc m :project-root (if (:recent-files m) (remember-project! root) root)))
    (ed-set-buf m1 (assoc (ed-current-buf m1) :dir root))))

(defn ed-project-switch-dispatch (m root)
  "Show the `project-switch-commands` menu for `root` and route the next key through it: a
listed key runs its command with `root` in force, anything else (Esc, C-g, a key with no
row) cancels. One keystroke, no minibuffer — the Emacs shape."
  (ed-read-char (ed-project-switch-to m root)
    (str (path/basename root) " — " (project-switch-label))
    (fn (mm key)
      (let (row (seq/find *project-switch-commands* (fn ([k _ _]) (= k key))))
        (if (nil? row)
          (message mm (str "not a project command: " (ed-key-label key)))
          ((reflect/eval (nth row 2)) mm key))))))

(defcommand cmd-project-switch
  (m key)
  "Switch to a known project (C-x p p) — Emacs `project-switch-project`: pick a project root
(a Vertico list of every remembered one, most-recently-used first; Tab completes, and a
directory you type that is not on the list yet is accepted and remembered), then choose what
to do there from the dispatch menu — find file, find regexp, dired, VC status, shell, REPL,
compile. Projects are remembered as you open them."
  (let (projs (known-projects))
    (assoc m
      :minibuffer
        {:edit (assoc (ed-mb-edit "Switch to project: " "") :word-mode :path)
         :on-complete (fn (mm root)
                        (let (dir (path/absolute (string/trim root)))
                          (if (file/dir? dir)
                            (ed-project-switch-dispatch mm dir)
                            (message mm (str "no such directory: " dir)))))
         ;; Tab completes a typed PATH once it looks like one (so an unlisted project is
         ;; reachable by typing it), and otherwise the remembered roots.
         :complete-fn (fn (t)
                        (if (or (string/starts-with? t "/") (string/starts-with? t "~"))
                          (ed-complete-path t)
                          (ed-complete-name t projs)))
         :rank-source projs
         :rank-cap 20
         :category :file
         :accept-selection true})))

(defcommand cmd-project-dired
  (m key)
  "Open Dired on the current project's root (C-x p d, Emacs `project-dired`). The project
is the one the current buffer is in (`ed-project-root`), not where the editor launched."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project (no project.blsp found)")
      (ed-open-dired m root))))

;; ---- C-x p k: close the project ----------------------------------------------
;; Emacs `project-kill-buffers`. Finishing with a project means closing everything it
;; opened, and doing that one `C-x k` at a time over fifteen buffers is how you end up
;; with three projects' files in the pool and a switch-buffer list you cannot read.

(defn project-owns-buffer? (root buf)
  "Whether `buf` belongs to project `root` — its file is the root or sits under it.

Compared with a separator appended, which is the whole of the care needed here: a plain
prefix test makes `/src/app` own `/src/app-legacy/lib.ex`, and the buffer you did not mean
to kill is the one from the project you are still working in."
  (let (f (buffer-file buf))
    (and (string? f)
      (string? root)
      (or (= f root)
        (string/starts-with? f (if (string/ends-with? root "/") root (str root "/")))))))

(sig project-buffer-names (model string -> seqable))
(defn project-buffer-names (m root)
  "The names of every pool buffer belonging to project `root`, in pool order.

NAMES, not indices: killing shifts every index above the one killed, so a list of indices
is stale after the first kill. `ed-kill-buffer-named` looks its index up again each time."
  (into []
    (seq/keep (:buffers m)
      (fn (b) (if (project-owns-buffer? root b) (buffer-name b) nil)))))

(defn project-kill-named (m names)
  "Kill each of `names` in turn (`ed-kill-buffer-named`, so each `:on-close` runs and the
panes showing it are re-pointed). Tail-recursive over the list; a name already gone is a
no-op, which is what makes killing companions along the way safe."
  (fold names m (fn (acc nm) (ed-kill-buffer-named acc nm))))

(defcommand cmd-project-kill-buffers
  (m key)
  "Close every buffer belonging to the current project (C-x p k, Emacs
`project-kill-buffers`) — after asking, with the count of unsaved ones in the question.

One prompt, not one per buffer. Emacs asks again for each modified buffer, which for a
project you have finished with is fifteen keystrokes to say the same thing once; saying
how many are modified up front is the same consent, informed, in one key."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project")
      (let (names (project-buffer-names m root)
            dirty (count (seq/filter (:buffers m)
                           (fn (b) (and (project-owns-buffer? root b) (buffer-modified? b)))))
            label (path/basename root))
        (if (empty? names)
          (message m (str "no open buffers in " label))
          (ed-read-char m
            (str "Kill "
              (count names)
              " buffer"
              (if (= (count names) 1) "" "s")
              " in "
              label
              (if (> dirty 0) (str " (" dirty " unsaved)") "")
              "? (y or n) ")
            (fn (mm k)
              (if (or (= k "y") (= k "Y"))
                (message (project-kill-named mm names)
                  (str "killed " (count names) " buffer" (if (= (count names) 1) "" "s")))
                (message mm "kill canceled")))))))))

;; ---- the replace family (M-x) ------------------------------------------------
;; `query-replace` (M-%, `isearch`) asks at every match; these do not ask at all, which is
;; the point of them: `replace-string` over a region you just selected, `flush-lines` to
;; drop the noise out of a log, `how-many` to decide whether a rename is worth it. Emacs
;; puts none of them on a key either — they live on M-x and are reached by name.
;;
;; All of them act FROM POINT to the end (Emacs's rule) or over the REGION when one is
;; active, so "just this function" is a selection away and the whole buffer is `M-<`
;; first. Each reports what it did: a replace that silently matched nothing looks exactly
;; like one that silently did the wrong thing.
;;
;; The text transforms themselves are pure and live in `isearch` beside query-replace's,
;; so `replace-string` and `M-%` cannot disagree about what replacing means.

(defn ed-replace-span (m)
  "`[from to]` — what the replace commands act on: the active region, else point to the
end of the buffer."
  (let (buf (ed-current-buf m)
        rb (buffer-region-bounds buf))
    (if rb rb [(buffer-point buf) (buffer-length buf)])))

(defn ed-replace-in-span (m from to regexp? verb)
  "Replace throughout `ed-replace-span` and report the count — the body `replace-string`
and `replace-regexp` share."
  (if (= from "")
    (message m "(nothing to replace)")
    (let ([lo hi] (ed-replace-span m)
          before (text/slice (buffer-rope (ed-current-buf m)) lo hi)
          [after n] (isearch/replace-all-in before from to regexp?))
      (if (= n 0)
        (message m (str "no matches for `" from "`"))
        (message (ed-edit m (fn (b) (goto-char (replace-region b lo hi after) lo)))
          (str verb " " n " occurrence" (if (= n 1) "" "s")))))))

(defn- ed-filter-lines-in-span (m pattern keep? verb)
  "`flush-lines` / `keep-lines` over `ed-replace-span`, reporting how many lines went."
  (if (= pattern "")
    (message m "(no pattern)")
    (let ([lo hi] (ed-replace-span m)
          before (text/slice (buffer-rope (ed-current-buf m)) lo hi)
          [after dropped] (isearch/filter-lines before pattern keep?))
      (if (= dropped 0)
        (message m (str "no lines " verb))
        (message (ed-edit m (fn (b) (goto-char (replace-region b lo hi after) lo)))
          (str dropped " line" (if (= dropped 1) "" "s") " " verb))))))

(defn- ed-two-part-prompt (m first-prompt second-prompt then)
  "Ask two things in a row — `from`, then `to` — and hand both to `then`. The shape
`query-replace` already uses, named so the three commands that need it do not each
re-nest the minibuffer by hand."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit first-prompt "")
       :on-complete (fn (mm a)
                      (assoc mm
                        :minibuffer
                          {:edit (ed-mb-edit (second-prompt a) "")
                           :on-complete (fn (m2 b) (then m2 a b))}))}))

(defcommand cmd-replace-string
  (m key)
  "Replace every occurrence of a string, from point (M-x replace-string). LITERAL — the
text you type is the text it looks for, brackets and dots and all."
  (ed-two-part-prompt m
    "Replace string: "
    (fn (from) (str "Replace `" from "` with: "))
    (fn (mm from to) (ed-replace-in-span mm from to false "replaced"))))

(defcommand cmd-replace-regexp
  (m key)
  "Replace every match of a regexp, from point (M-x replace-regexp). `$1`…`$9` in the
replacement stand for the pattern's groups."
  (ed-two-part-prompt m
    "Replace regexp: "
    (fn (from) (str "Replace regexp `" from "` with: "))
    (fn (mm from to) (ed-replace-in-span mm from to true "replaced"))))

(defcommand cmd-flush-lines
  (m key)
  "Delete the lines matching a regexp, from point (M-x flush-lines)."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Flush lines matching: " "")
       :on-complete (fn (mm p) (ed-filter-lines-in-span mm p false "flushed"))}))

(defcommand cmd-keep-lines
  (m key)
  "Keep only the lines matching a regexp, from point (M-x keep-lines) — flush-lines'
opposite, and the one you want when the signal is rarer than the noise."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Keep lines matching: " "")
       :on-complete (fn (mm p) (ed-filter-lines-in-span mm p true "dropped"))}))

(defcommand cmd-how-many
  (m key)
  "Count the matches of a regexp from point (M-x how-many / count-matches) — the question
you ask before a rename, and the one that changes nothing."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "How many matches for regexp: " "")
       :on-complete (fn (mm p)
                      (if (= p "")
                        (message mm "(no pattern)")
                        (let ([lo hi] (ed-replace-span mm)
                              n (isearch/count-matches-in (text/slice (buffer-rope (ed-current-buf mm))
                                                            lo hi)
                                  p))
                          (message mm (str n " match" (if (= n 1) "" "es") " for `" p "`")))))}))

;; ---- the small daily set -----------------------------------------------------
;; Commands Emacs has had forever that bedit had not. Each is a few lines because the
;; primitives were all here — `ed-map-region-lines` for the line-wise ones,
;; `ed-replace-span` for the text-wise ones — which is the argument for having built
;; those seams rather than one-off loops.

(defcommand cmd-indent-region
  (m key)
  "Reindent every line of the region to its mode's column (C-M-\\). With no region, the
current line — the same rule `indent-line` follows, so the key does something sensible
either way rather than complaining about the selection you forgot to make."
  (let (rl (ed-region-lines (ed-current-buf m)))
    (if (nil? rl)
      (ed-edit m (fn (b) (ed-reindent-line-at b (buffer-current-line b))))
      (let ([first last] rl)
        (ed-edit m
          (fn (b) (ed-map-region-lines b first last (fn (bb ln) (ed-reindent-line-at bb ln)))))))))

(defn ed-untabify-text (text width)
  "`text` with each tab expanded to the spaces that reach the next `width` stop.

Column-aware, not a blind `\\t` -> N spaces: a tab advances to the next multiple of
`width`, so its expansion depends on where in the line it sits. Replacing each tab with a
fixed run is the version that silently shifts every line containing two of them."
  (string/join
    (map (string/split text "\n")
      (fn (line)
        (fold (string/->list line)
          ""
          (fn (acc ch)
            (if (= ch "\t")
              ;; the gap to the next stop, as an int the checker can see — `-` over two
              ;; ints still reads `number` to it, and `string/repeat` wants an int
              (let (gap (- width (math/mod (string/length acc) width))
                    n (if (int? gap) gap width))
                (str acc (string/repeat " " n)))
              (str acc ch))))))
    "\n"))

(defn ed-tabify-text (text width)
  "`text` with runs of spaces that span a tab stop replaced by tabs — LEADING whitespace
only.

Emacs tabifies the whole line by default and it is almost always wrong: spaces inside a
string literal or lining up a trailing comment are spaces on purpose, and turning them
into tabs changes what the file MEANS in the first case and how it looks everywhere. The
indentation is the part anyone wants converted."
  (string/join (map (string/split text "\n")
                 (fn (line)
                   (let (body (string/triml line)
                         lead (- (string/length line) (string/length body))
                         tabs (math/quot lead width)
                         rest (math/mod lead width))
                     (if (= tabs 0)
                       line
                       (str (string/repeat "\t" tabs) (string/repeat " " rest) body)))))
    "\n"))

(defn- ed-retab (m f verb)
  "Apply a whitespace transform over `ed-replace-span` and report."
  (let ([lo hi] (ed-replace-span m)
        before (text/slice (buffer-rope (ed-current-buf m)) lo hi)
        after (f before ed-tab-width))
    (if (= before after)
      (message m (str "nothing to " verb))
      (message (ed-edit m (fn (b) (goto-char (replace-region b lo hi after) lo)))
        (str verb "ed")))))

(defcommand cmd-untabify
  (m key)
  "Expand tabs to spaces over the region, or from point (M-x untabify)."
  (ed-retab m ed-untabify-text "untabify"))

(defcommand cmd-tabify
  (m key)
  "Turn leading spaces into tabs over the region, or from point (M-x tabify)."
  (ed-retab m ed-tabify-text "tabify"))

(defn ed-dedupe-lines (text)
  "`[text' dropped]` — `text` with CONSECUTIVE duplicate lines collapsed to one.

Consecutive, like `uniq` and like Emacs's own `delete-duplicate-lines` on a sorted
region. Global dedup would reorder nothing but would quietly delete a line far from the
one it matched, which is not something you can eyeball afterwards."
  (let (nl? (string/ends-with? text "\n")
        body (if nl? (string/substring text 0 (dec (string/length text))) text)
        lines (string/split body "\n")
        kept (fold lines
               []
               (fn (acc l) (if (= (last acc) l) acc (conj acc l))))
        out (string/join kept "\n"))
    [(if (and nl? (not (empty? kept))) (str out "\n") out) (- (count lines) (count kept))]))

(defcommand cmd-delete-duplicate-lines
  (m key)
  "Collapse consecutive duplicate lines over the region, or from point (M-x
delete-duplicate-lines)."
  (let ([lo hi] (ed-replace-span m)
        before (text/slice (buffer-rope (ed-current-buf m)) lo hi)
        [after dropped] (ed-dedupe-lines before))
    (if (= dropped 0)
      (message m "no duplicate lines")
      (message (ed-edit m (fn (b) (goto-char (replace-region b lo hi after) lo)))
        (str dropped " duplicate line" (if (= dropped 1) "" "s") " deleted")))))

(defn ed-reverse-lines (text)
  "`text` with its lines in the opposite order, keeping a trailing newline if there was one."
  (let (nl? (string/ends-with? text "\n")
        body (if nl? (string/substring text 0 (dec (string/length text))) text)
        out (string/join (reverse (string/split body "\n")) "\n"))
    (if nl? (str out "\n") out)))

(defcommand cmd-reverse-region
  (m key)
  "Reverse the order of the region's lines (M-x reverse-region)."
  (let (buf (ed-current-buf m)
        rb (buffer-region-bounds buf))
    (if (nil? rb)
      (message m "no region (set the mark first)")
      (let ([lo hi] rb
            before (text/slice (buffer-rope buf) lo hi))
        (message (ed-edit m
                   (fn (b) (goto-char (replace-region b lo hi (ed-reverse-lines before)) lo)))
          "region reversed")))))

(defn ed-cursor-position-text (buf)
  "The `C-x =` line: the character under point, its codepoint, and where point is.

`what-cursor-position` is the command you run when a file has something invisible in it —
a non-breaking space, a stray BOM, a tab you cannot tell from spaces — so the CODEPOINT
is the part that matters, not the character."
  (let (pos (buffer-point buf)
        len (buffer-length buf)
        line (inc (buffer-current-line buf))
        col (- pos (text/line->char (buffer-rope buf) (buffer-current-line buf)))
        ch (if (>= pos len) nil (text/slice (buffer-rope buf) pos (inc pos)))
        pct (if (= len 0) 100 (math/quot (* pos 100) len)))
    (str (if (nil? ch)
           "point at end of buffer"
           (str "char: "
             (if (= ch "\n") "\\n" ch)
             "  (U+"
             (string/upper (string/format "%04x" (first (string/->codepoints ch))))
             ")"))
      "   line " line " col " col "   point " pos " of " len " (" pct "%)")))

(defcommand cmd-what-cursor-position
  (m key)
  "Describe the character under point and where point is (C-x =)."
  (message m (ed-cursor-position-text (ed-current-buf m))))

;; ---- align-regexp ------------------------------------------------------------
;; Emacs `align-regexp`: line up a column across the region. The one command in this
;; batch with real work in it, because "line up on this" is under-specified until you say
;; WHICH occurrence and what to do with lines that have none.
;;
;; The rules here, all of which Emacs also settles and none of which is obvious:
;;   * the FIRST match on each line is the anchor. Aligning on a later one needs a more
;;     specific pattern, which you have to write anyway to say which you meant.
;;   * a line with no match is passed through untouched. It is a blank line, or a comment,
;;     or the one line that is not part of the table — and padding it to a column it has
;;     no field at would be inventing structure.
;;   * padding goes BEFORE the match, and existing space before it is collapsed first, so
;;     running the command twice is the same as running it once. An align that only ever
;;     adds is one you cannot re-run after an edit, which is when you want it most.

(defn align-column (lines pattern)
  "The column the matches should line up at: one past the widest prefix among the lines
that match, measured in DISPLAY cells so a tab or a wide glyph counts what it paints."
  (fold lines
    0
    (fn (acc line)
      (let (hit (regex/find pattern line))
        (if (nil? hit)
          acc
          (math/max acc
            (inc (string/display-width (string/trimr (string/substring line 0 (:start hit)))))))))))

(defn align-line (line pattern col)
  "`line` with its first match of `pattern` pushed out to display column `col`, or the
line unchanged when it does not match."
  (let (hit (regex/find pattern line))
    (if (nil? hit)
      line
      (let (before (string/trimr (string/substring line 0 (:start hit)))
            after (string/substring line (:start hit) (string/length line))
            pad (math/max 1 (- col (string/display-width before))))
        (str before (string/repeat " " pad) after)))))

(sig align-text (string string -> string))
(defn align-text (text pattern)
  "`text` with every line's first match of `pattern` aligned to a common column.

Idempotent: the prefix is right-trimmed before padding, so aligning an already-aligned
block changes nothing."
  (let (nl? (string/ends-with? text "\n")
        body (if nl? (string/substring text 0 (dec (string/length text))) text)
        lines (string/split body "\n")
        col (align-column lines pattern)
        out (string/join (map lines (fn (l) (align-line l pattern col))) "\n"))
    (if nl? (str out "\n") out)))

(defcommand cmd-align-regexp
  (m key)
  "Align the region's lines on a regexp (M-x align-regexp) — `=` to line up assignments,
`:` a map, `|` a table. The first match on each line is the anchor; a line that does not
match is left alone."
  (let (buf (ed-current-buf m)
        rb (buffer-region-bounds buf))
    (if (nil? rb)
      (message m "no region (set the mark first)")
      (let ([lo hi] rb)
        (assoc m
          :minibuffer
            {:edit (ed-mb-edit "Align regexp: " "")
             :on-complete (fn (mm p)
                            (if (= p "")
                              (message mm "(no pattern)")
                              (let (before (text/slice (buffer-rope (ed-current-buf mm)) lo hi)
                                    after (align-text before p))
                                (if (= before after)
                                  (message mm "already aligned")
                                  (message (ed-edit mm
                                             (fn (b) (goto-char (replace-region b lo hi after) lo)))
                                    (str "aligned on `" p "`"))))))})))))
;; ---- M-x: run any interactive command by name -------------------------------

(defcommand cmd-execute-extended-command
  (m key)
  "Prompt for an interactive command name and run it (M-x). Completes against the
commands relevant to the current buffer's active layers: global commands plus any
mode-specific ones the active layers expose via their `:commands` facet. Recently-run
commands appear first (most-recent at the top), then the alphabetical remainder — the
history is **persisted across restarts** via the same recentf mechanism (`recent-commands`
/ `remember-command!`), floated by the shared `projects/float-recent`."
  (let (buf (ed-current-buf m)
        active-cmds (apply append (ed-active-mode-commands buf))
        ;; a SET, not the list: `includes?` is O(n) and this rejects every command name
        ;; against every layer-owned one, which is a few hundred against a few hundred —
        ;; 26 ms to open M-x, all of it here
        owned (into #{} (ed-all-layer-commands))
        all-names (sort (append (seq/reject (interactive/command-names)
                                  (fn (n) (contains? owned n)))
                          active-cmds)))
    (assoc m
      :minibuffer
        (assoc (ed-name-prompt "M-x "
                 all-names
                 (fn (mm t)
                   ;; persist real commands as recent — live editor only (`:recent-files`), so tests
                   ;; and headless runs never write the shared cache (mirrors recentf's guard).
                   ;; Run after the command executes so a command that throws is not persisted.
                   (let (result (interactive/run-command mm
                                  t
                                  (fn (mmm nm) (message mmm (str "no command: " nm)))))
                     (do
                       (when (and (:recent-files mm) (interactive/command-sym t))
                         (remember-command! t))
                       result)))
                 15
                 (if (:recent-files m) (recent-commands) []))
          ; persisted M-x history, floated to the top
          ;; marginalia per row: the key bound to the command in THIS buffer's live keymap,
          ;; its declared contract, its docstring's first line (`plume/plume-command-annotation`)
          :category :command
          :anno-keys (ed-key-table (editor/layers/scope-keymap (list buf m)))))))

(defn ed-leading-int (line)
  "The leading integer of `line` (after trimming left whitespace), or nil when it doesn't
start with a digit. The shared `\"<n> …\"`-row parser: a `*Process List*` row's process id,
an `*Occur*` row's source line number, and a fuzzy line-search candidate's line number."
  (let (t (string/triml line)
        n (string/span t 0 "0123456789"))
    (if (= n 0)
      nil
      ;; The span is all digits, so this parse cannot fail — but `string/->number`
      ;; answers `number | failure`, and a failure is TRUTHY, so a caller's `(nil? ln)`
      ;; guard would let one through into `dec`/`goto-line`. Say nil, as promised.
      (let (v (string/->number (string/substring t 0 n)))
        (when (int? v) v)))))

;; ---- fuzzy in-buffer line search (M-s) --------------------------------------
;; The same Vertico minibuffer the other completers use, ranking the buffer's own lines
;; (consult-line / swiper style): you fuzzy-type, the list narrows, Enter jumps to the
;; selected line. Each candidate is "<n>: <text>" so accept can recover the line number
;; (and typing a bare number jumps straight to that line, like goto-line).

(defn ed-buffer-line-cands (buf)
  "Every non-blank line of `buf` as `\"<1-based n>: <text>\"` — the fuzzy line-search
candidates; the leading number lets accept jump back to the line."
  (let (n (buffer-line-count buf))
    (seq/keep (range n)
      (fn (i)
        (let (txt (ed-strip-newline (buffer-line-at buf i)))
          (if (= "" (string/trim txt)) nil (str (inc i) ": " txt)))))))

(defn ed-goto-line-cand (m cand)
  "Move point to the start of the line a fuzzy line-search candidate names; a candidate
with no leading number leaves point unmoved (`ed-scroll` after dispatch reveals it). The
candidate's leading number is parsed by the shared `ed-leading-int` (a `\"<n>: text\"`
row, like an *Occur* line)."
  (let (n (ed-leading-int cand))
    (if (nil? n)
      m
      (let (buf (ed-current-buf m)
            line (math/max 0 (math/min (dec (buffer-line-count buf)) (dec n)))
            bol (text/line->char (buffer-rope buf) line))
        (ed-set-buf m (goto-char buf bol))))))

(defcommand cmd-fuzzy-find-line
  (m key)
  "Fuzzy-search the current buffer's lines (M-s): a minibuffer listing every non-blank
line as `\"<n>: <text>\"`, fuzzy-ranked as you type — the same list + ↑/↓ navigation as
M-x and find-file. Enter jumps point to the selected line; a bare number jumps to it."
  (let (cands (ed-buffer-line-cands (ed-current-buf m)))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Find line: " "")
         :on-complete (fn (mm t) (ed-goto-line-cand mm t))
         :complete-fn (fn (t) t)
         :rank-source cands ; every buffer line, narrowed incrementally as you type
         :rank-cap 40
         :accept-selection true})))

;; ---- files + quit -----------------------------------------------------------

(sig ed-modified-file-indices (model -> list))
(defn ed-modified-file-indices (m)
  "The pool indices of the buffers with unsaved changes to a FILE, in pool order — what a
quit must ask about. A modified scratch or generated buffer has nowhere to be saved and is
not asked about (Emacs asks only for file-visiting buffers)."
  (seq/filter (range (count (:buffers m)))
    (fn (i) (let (b (ed-buf-at m i)) (and (buffer-modified? b) (not (nil? (buffer-file b))))))))

(defn- ed-quit-now (m)
  "End the loop — and, on the primary, every open frame with it (`frames/frames-close-all`;
a frame's own quit is just its loop, see `frames/cmd-delete-frame`)."
  (assoc (if (or (:frame? m) (empty? (or (:frames m) [])))
           m
           ((reflect/eval 'frames/frames-close-all) m))
    :done true))

;; ---- map-y-or-n-p: ask about each of a list, y / n / ! / q ------------------
;; Emacs's `map-y-or-n-p`, and the loop three commands here want. It existed already,
;; spelled out inside `ed-quit-ask`; `save-some-buffers` needed the same thing and that is
;; the moment to pull it up rather than write it twice.
;;
;; Not a modal overlay: each answer is an `ed-read-char` continuation, so the loop stays
;; LIVE between questions — the editor still repaints, timers still fire, and a long list
;; does not freeze anything. It also means the recursion costs no stack: each step returns
;; to the loop and the next is entered from the keypress.

;; check-allow: `on-yes` and `on-done` are caller-supplied, so the checker cannot see what
;; the last step returns (ADR-341's `:trusted`, as `git-launch-op`).
(check-allow :trusted
  (sig ed-map-y-or-n (model seqable fn fn fn -> model))
  (defn ed-map-y-or-n (m items label on-yes on-done)
    "Ask about each of `items` in turn — `y` yes, `n` no, `!` yes to this and all the rest,
`q` stop asking — then hand the model and the number accepted to `on-done`.

`label` is `(item) -> string`, the question without its key hint. `on-yes` is
`(model item) -> model`, applied only to the accepted ones. `C-g`/Esc abandons the whole
run (`ed-read-char` catches them before the continuation), which is what a reader pressing
it means and why they are not listed as answers."
    (ed-map-y-or-n-step m (vec items) 0 0 label on-yes on-done)))

(defn- ed-map-y-or-n-step (m items i accepted label on-yes on-done)
  (if (>= i (count items))
    (on-done m accepted)
    (let (item (nth items i)
          next (fn (mm acc) (ed-map-y-or-n-step mm items (inc i) acc label on-yes on-done)))
      (ed-read-char m
        (str (label item) " (y, n, !, q)")
        (fn (mm k)
          (cond
            (or (= k "y") (= k "Y") (= k " ")) (next (on-yes mm item) (inc accepted))
            ;; `!` — this one and every one after, without asking again. Folded rather
            ;; than looped through the prompt, so it is one step however many remain.
            (= k "!")
              (let (rest-items (drop items i))
                (on-done (fold rest-items mm (fn (acc it) (on-yes acc it)))
                  (+ accepted (count rest-items))))
            (= k "q") (on-done mm accepted)
            ;; anything else is "no" — Emacs treats an unrecognised key as no rather than
            ;; re-asking, and re-asking is how you get stuck in a prompt you cannot leave
            else (next mm accepted)))))))

(defcommand cmd-save-some-buffers
  (m key)
  "Save each modified file buffer, asking about each (C-x s, Emacs `save-some-buffers`)."
  (let (pending (ed-modified-file-indices m))
    (if (empty? pending)
      (message m "(no changes need saving)")
      (ed-map-y-or-n m
        pending
        (fn (i) (str "Save file " (buffer-file (ed-buf-at m i)) "?"))
        (fn (mm i) (ed-save-buf-at mm i))
        (fn (mm n)
          (message mm
            (if (= n 0)
              "(no buffers saved)"
              (str "saved " n " buffer" (if (= n 1) "" "s")))))))))

(defn- ed-quit-ask (m pending save-all?)
  "Emacs `save-buffers-kill-terminal`: ask about each modified file buffer
(`ed-map-y-or-n`), then — if anything is still modified — `Modified buffers exist; exit
anyway?`. `C-g` / Esc at any prompt cancels the quit.

`save-all?` skips the asking entirely (the `!` answer, and the caller that already knows)."
  (let (finish (fn (mm _)
                 (if (empty? (ed-modified-file-indices mm))
                   (ed-quit-now mm)
                   (ed-read-char mm
                     "Modified buffers exist; exit anyway? (y or n)"
                     (fn (m2 k)
                       (if (or (= k "y") (= k "Y"))
                         (ed-quit-now m2)
                         (message m2 "quit canceled")))))))
    (if save-all?
      (finish (fold pending m (fn (acc i) (ed-save-buf-at acc i))) 0)
      (ed-map-y-or-n m
        pending
        (fn (i) (str "Save file " (buffer-file (ed-buf-at m i)) "?"))
        (fn (mm i) (ed-save-buf-at mm i))
        finish))))

(defcommand cmd-quit
  (m key)
  "Quit the editor (C-x C-c, and the window's X button, delivered as `:close` — the
model claims it with `:close-is-input?` so it lands here rather than quitting the loop
outright). With unsaved changes to a file it asks first, buffer by buffer, the way Emacs's
`save-buffers-kill-terminal` does (`ed-quit-ask`); with none it quits at once — and the
primary takes every open frame with it. In a FRAME (`:frame?`) this is `delete-frame`: the
frame closes, the editor and its buffers stay (Emacs closes an emacsclient frame the same
way). ESC is *not* quit (it's `keyboard-escape-quit`; see `modes`)."
  (if (:frame? m)
    (assoc m :done true)
    (ed-quit-ask m (ed-modified-file-indices m) false)))

(sig ed-save-buf-at (model int -> model))
(defn ed-save-buf-at (m i)
  "Write pool buffer `i` to its file: the plain save every path shares — `C-x C-s` on the
current buffer, and `save-some-buffers` on any other at quit. The buffer comes back unmodified
(`save-buffer` sets its baseline) and its `#filename#` auto-save sidecar is deleted on success;
reports the outcome in the echo area either way. The diff-hl gutter is NOT recomputed
here: a save writes the working tree but touches neither the buffer text nor HEAD, so
the buffer-vs-HEAD diff is unchanged (and any prior edit already refreshed it via the
rope-keyed idle recompute). Leaving the cached `:git-line-status` in place keeps the bars
steady — dropping it made them blink off and back on each save."
  (let (buf (ed-buf-at m i))
    (try
      ;; `save-buffer` answers the buffer stamped with the file's new mtime, so the idle
      ;; beat's change check (`ed-revert-changed-files`) knows text and file agree again
      (let (saved (dissoc (save-buffer buf) :disk-warned)
            f (buffer-file buf)
            as-path (ed-auto-save-path f)
            m2 (dissoc (ed-set-buf-at m i saved) :status))
        (do
          (when (file/exists? as-path)
            (try
              (file/rm as-path)
              (catch e
                (log/warn (str "could not remove auto-save " as-path ": " (error-message e))))))
          ;; A HOSTED slot's buffer process owns the buffer's state, and it has to hear about
          ;; the save too. Only the pool copy used to be marked saved: the process went on
          ;; answering "modified", so another frame showed the buffer unsaved and the next
          ;; push could carry the flag back. Sent after every splice this slot already sent
          ;; (a mailbox is FIFO), so it marks exactly the text that was written; tagged as
          ;; ours so it folds back as an echo, not a foreign change.
          (let (proc (get-in m [:hosted i :proc]))
            (when proc
              (buffer-edit proc (fn (b) (mark-buffer-saved (buffer-stamp-file b))) (self))))
          (message m2 (str "saved " f))))
      (catch e (message m (str "save failed: " (error-message e)))))))

(defcommand cmd-save
  (m key)
  "Write the current buffer to its file (C-x C-s); report the outcome in the echo
area. Leaves the buffer unmodified and deletes the `#filename#` auto-save
sidecar on success (`ed-save-buf-at`). A no-op-with-message if the buffer has no
backing file.

With format-on-save on (and a formatter for this language) the write is a format
(`format/on-save`, which saves first itself) — but only once the file is known to be
ours to write: the \"changed on disk\" question comes FIRST. It used to come after, so
with format-on-save on, a save silently overwrote another writer's changes."
  (let (buf (ed-current-buf m)
        write (fn (mm) (or (format/on-save mm) (ed-save-buf-at mm (ed-current-index mm)))))
    (cond
      ;; a hex view names its file so the mode line and C-x C-j know it, but its TEXT
      ;; is a rendering of the bytes: writing it would replace the binary with a dump
      (= (editor/layers/buffer-type-for buf) :hexl)
        (message m "a hex view is not saved (it renders the binary; edit the file itself)")
      (nil? (buffer-file buf))
        (message m "no file to save (C-x C-f to open one, or run: nest run -- <path>)")
      ;; another writer changed the file since this buffer last agreed with it: saving
      ;; would overwrite their work, so ask (Emacs: \"has changed since visited or saved\")
      (buffer-file-changed? buf)
        (ed-read-char m
          (str (buffer-file buf) " has changed since visited or saved. Save anyway? (y or n)")
          (fn (mm k)
            (if (or (= k "y") (= k "Y"))
              (write mm)
              (message mm "save canceled (M-x revert-buffer to reload the disk version)"))))
      else (write m))))

;; ---- eval-in-buffer (the C-x C-e family, via std/eval-command) --------------
;; Thin `(model key) -> model` wrappers over `std/eval-command.blsp`, which does
;; the work (read + eval + value/output capture) as a pure `buffer -> message
;; string` and is shared with any editor. We just route the result to `message`.

(defdyn *eval-timeout-ms*
  ;; Optional safeguard: auto-kill a spawned eval after this many ms (nil = no limit).
  ;; Redefine to arm it — e.g. `(defdyn *eval-timeout-ms* 5000)` via C-x C-e.
  nil)

(defn ed-eval-async (m src timeout)
  "Evaluate Brood source string `src` off the editor's loop via `std/task`, so a
long-running or looping form never freezes the editor (`ui-run` is single-process —
a synchronous eval would block the loop). A still-running prior eval is cancelled
first; `task` returns a *handle* that tags its reply — `[:task-done <handle>
<message>]`, or `[:task-timeout <handle>]` past `timeout` (ms; nil = no limit) — so a
stale reply from a finished/cancelled eval can't clobber a newer one (`ed-update`
shows it only when the handle matches `:eval-proc`). Manual interrupt is C-g
(`cmd-keyboard-quit`). Returns the model with the handle on `:eval-proc` and an
`evaluating…` note. (Async delivery relies on the GUI display's mailbox-`receive`
poll; the eval runs in its own process while the editor stays live.)"
  (let (prev (:eval-proc m)
        ;; the loop this runs in — its output streams back here (nil in tests / headless)
        sink (or *ui-loop* (proc/whereis :editor))
        opts (if (and timeout (> timeout 0)) {:timeout timeout} {})
        ;; With a live editor, bind the eval's *out*/*err* to a process-port back to it,
        ;; so the form's output STREAMS into *Messages* as it's produced — a long or
        ;; looping form's prints appear immediately, not trapped in a capture buffer
        ;; until (if ever) it returns; the reply carries just the value. Without an
        ;; editor (tests / headless) capture + bundle output into the reply as before.
        thunk (if (nil? sink)
                (fn () (eval-source src))
                (fn ()
                  (binding (*out* (io/process-port sink) *err* (io/process-port sink))
                    (eval-source-value src))))
        job (task/latest prev thunk opts))
    ; supersede a still-running eval (std/task)
    (message (assoc m :eval-proc job) "evaluating…")))

(defcommand cmd-keyboard-quit
  (m key)
  "C-g / ESC (`keyboard-quit`): the universal cancel. Deactivates the region (clears the
mark), drops a half-typed chord (`:pending`) and any numeric prefix argument, and
**cancels every background worker in flight** — a running evaluation (C-x C-e), the
advisory diagnostics check, and the diff-hl annotation. `cancel-task` hard-kills each
worker process (`std/task`), so even a runaway loop or a pathologically slow diff dies;
an already-finished task is a harmless no-op (its reply is dropped because the handle is
cleared). This is the editor's guarantee that no background work can wedge it: slow work
runs off the loop (never on the per-key path), and this key kills it.

A cancelled diff-hl annotation is re-stamped against the current text, so the
idle beat treats the gutter as current and doesn't immediately relaunch the diff we just
killed; it re-arms on the next edit. Diagnostics, by contrast, recompute once typing settles."
  (let (eval-p (:eval-proc m)
        diag-p (:diag-proc m)
        gd-p (:gitdiff-proc m)
        eldoc-p (:eldoc-proc m)
        procs (seq/reject (list eval-p diag-p gd-p eldoc-p) nil?)
        b (ed-current-buf m)
        ;; a cancelled diff-hl recompute: re-stamp the bars annotation against the CURRENT
        ;; text so the idle beat treats the gutter as current and won't relaunch the diff we
        ;; just killed (keeping any existing bars; none if there were none). It re-arms on
        ;; the next edit, because that is what makes the annotation stale again.
        b1 (if gd-p
             ;; `:value`, NOT `annotation-value`: the current-only accessor returns nil
             ;; exactly when a line was inserted (which is why a diff was in flight), so
             ;; it would DISCARD the bars this branch exists to keep.
             (editor/buffer/annotate b
               :git-line-status (or (:value (editor/buffer/annotation b :git-line-status)) {}))
             b)
        m1 (dissoc (ed-set-buf m (clear-mark b1))
             :pending :prefix-arg :eval-proc :diag-proc :diag-checking :gitdiff-proc
             :gitdiff-checking :eldoc-proc :eldoc-checking :lsp-pending) ; in-flight LSP lookups: replies drop as stale
        _ (doseq (p procs) (cancel p)))
    (message m1 (if (empty? procs) "quit" "quit — interrupted background work"))))

(defn ed-eval-scope (buf)
  "`[text point]` for the code around point — the buffer's own text and point unless
its mode provides an `:eval-scope` service, which answers `[start end]` for a
sub-region instead.

Some buffers are only PARTLY code: a tutorial page is prose with playground boxes in
it, a shell buffer is a transcript with one live input line. `last-sexp-source` reads
from the start of whatever text it is given, so handed the whole buffer it throws on
the first English sentence and C-x C-e reports \"no complete form before point\" while
point sits inside a perfectly good form. The mode knows where its code lives; this asks
it, rather than teaching every eval command about every buffer type."
  (let (svc (ed-mode-service buf :eval-scope)
        span (when svc (svc buf)))
    (if (nil? span)
      [(buffer-text buf) (buffer-point buf)]
      (let ([start end] span
            point (buffer-point buf))
        [(string/substring (buffer-text buf) start end)
          (math/max 0 (- (math/min point end) start))]))))

(defcommand cmd-eval-last-sexp
  (m key)
  "C-x C-e — evaluate the last complete form ending at point (multi-line: reads every
form up to point, evals the last) in a separate process; its value + output land in
the echo area / *Messages* when it finishes, so a slow or looping form can't freeze
the editor."
  (let (buf (ed-current-buf m)
        [text point] (ed-eval-scope buf)
        src (last-sexp-source text point))
    (if (nil? src)
      (message m "no complete form before point")
      (ed-eval-async m src *eval-timeout-ms*))))

(defcommand cmd-eval-region
  (m key)
  "Evaluate the region (point↔mark) as Brood source in a separate process."
  (let (region (buffer-region (ed-current-buf m)))
    (if (nil? region)
      (message m *no-region-message*)
      (ed-eval-async m region *eval-timeout-ms*))))

(defcommand cmd-eval-buffer
  (m key)
  "Evaluate the whole buffer as Brood source in a separate process."
  (ed-eval-async m (buffer-text (ed-current-buf m)) *eval-timeout-ms*))

;; ---- serve the selected buffer over HTTP (the live web mirror, C-x w) -------

(defcommand cmd-buffer-server-start
  (m key)
  "Serve the selected pane's buffer over HTTP — a browser-viewable mirror that
auto-refreshes as you type (C-x w · M-x buffer-server-start). Tries port 5000, falling
back to an OS-assigned one; the URL appears in the echo area once the socket is
bound. Re-running reports the running server's URL rather than starting a second.
M-x buffer-server-stop tears it down. (The push/render lives in `web`.)"
  (let (srv (:server m))
    (if (nil? srv)
      (message (assoc m :server (web/web-start m 5000)) "starting web server…")
      (let (url (web/web-url srv))
        (message m (if (nil? url) "web server starting…" (str "already serving on " url)))))))

;; ---- major-mode commands (M-x text-mode / brood-mode) ----------------------
;; Like Emacs: each major mode is an interactive command that activates it on the
;; current buffer. `replace-base-layer` (via `ed-set-mode`) swaps the base layer
;; while leaving any minor-mode layers above untouched.

(defcommand cmd-text-mode
  (m key)
  "Activate text-mode on the current buffer — the plain editing base mode."
  (ed-set-mode m :fundamental))

(defcommand cmd-brood-mode
  (m key)
  "Activate brood-mode on the current buffer — sexp navigation, smart indentation,
syntax highlighting, eldoc, and completion for `.blsp` source."
  (ed-set-mode m :brood))

;; ---- keybinding profiles + Vim modal commands (M-x emacs-mode / vim-mode) ---
;; The profile is a MODEL-scope keybinding layer (src/keymaps.blsp), orthogonal to the
;; buffer's major mode above. `cmd-emacs-mode` / `cmd-vim-mode` swap it; the `cmd-vim-*`
;; below are the Vim mode transitions and the modal grammar — each reuses the shared
;; `(model key) -> model` command pool, so Vim is bindings + a little state machine.

(defcommand cmd-emacs-mode
  (m key)
  "Switch to the Emacs keybinding profile (the default chorded bindings)."
  (message (ed-set-profile m :emacs) "emacs mode"))

(defcommand cmd-vim-mode
  (m key)
  "Switch to the Vim keybinding profile (modal: normal/insert/visual), starting in
normal mode."
  (message (ed-set-profile m :vim) "vim mode (normal)"))

(defcommand cmd-vim-normal
  (m key)
  "Return to Vim normal mode, clearing any visual selection (Esc)."
  (vim-to-normal (ed-apply m clear-mark)))

(defcommand cmd-vim-insert-bol
  (m key)
  "Enter Vim insert mode at the first column (I)."
  (vim-to-insert (ed-apply m beginning-of-line)))

(defcommand cmd-vim-append-eol
  (m key)
  "Enter Vim insert mode at end of line (A)."
  (vim-to-insert (ed-apply m end-of-line)))

(defcommand cmd-vim-open-below
  (m key)
  "Open a new line below and enter insert mode (o)."
  (vim-to-insert (cmd-open-line-below m key)))

(defcommand cmd-vim-open-above
  (m key)
  "Open a new line above and enter insert mode (O)."
  (vim-to-insert (cmd-open-line-above m key)))

(defcommand cmd-vim-visual
  (m key)
  "Enter Vim visual mode, anchoring the selection at point (v) — motions then extend
the point↔mark region."
  (vim-to-visual (ed-apply m set-mark)))

(defn- ed-vim-visual-inclusive (m)
  "The model with the visual selection widened to include the character UNDER the
cursor — Vim's charwise selection is inclusive at both ends, Emacs's region is not.

Without this every visual operation was one character short: `v` then `d` deleted
nothing at all, and `v l l d` took two characters where Vim takes three. Only widen
forward selections (point past mark); a backward one already covers the cursor's
character, and never step over the end of the buffer."
  (let (b (ed-current-buf m)
        point (buffer-point b)
        mark (get b :mark))
    (if (and mark (>= point mark) (< point (buffer-length b)))
      (ed-set-buf m (goto-char b (inc point)))
      m)))

(defcommand cmd-vim-visual-yank
  (m key)
  "Copy the visual selection to the kill ring and return to normal mode (y)."
  (vim-to-normal (cmd-copy-region (ed-vim-visual-inclusive m) key)))

(defcommand cmd-vim-visual-delete
  (m key)
  "Kill the visual selection (to the kill ring) and return to normal mode (d / x)."
  (vim-to-normal (cmd-kill-region (ed-vim-visual-inclusive m) key)))

(defcommand cmd-buffer-server-stop
  (m key)
  "Stop the buffer web server started by `buffer-server-start` (M-x buffer-server-stop)."
  (let (srv (:server m))
    (if (nil? srv)
      (message m "no web server running")
      (do (web/web-stop! srv) (message (dissoc m :server) "web server stopped")))))

(defcommand cmd-reload-grammars
  (m key)
  "Re-read every tree-sitter grammar in `~/.config/bedit/grammars` (M-x reload-grammars).

The way to install or UPDATE one without restarting: rebuild a `libtree-sitter-<lang>.so`,
run this, and the next keystroke in a buffer of that language is parsed by the new grammar.
Loading a grammar again replaces the registered one and drops the parsers bound to the old
one, so there is no stale-parser window to think about.

Startup does the same scan, so this is only needed when the directory has changed since —
which, while you are building a grammar, is every couple of minutes."
  (let (loaded (modes/load-user-grammars))
    (message m
      (if (empty? loaded)
        (str "no grammars in " (modes/ts-grammar-dir))
        (str "loaded "
          (count loaded)
          " grammar(s): "
          (string/join (map loaded (fn (l) (->string l))) ", "))))))

;; ---- the everyday Emacs tail: buffer list, dabbrev, shell commands, line utilities --
;; The commands a user reaches for in the first hour that were not here: `C-x C-b`,
;; `M-/`, `M-!` / `M-|`, `C-x C-o`, `M-x sort-lines`, `M-x delete-trailing-whitespace`,
;; `M-=`, `C-x i`. Each is a `(model key) -> model` over the buffer primitives; the two
;; that run a program go through `os/cmd` in the buffer's `default-directory`.

(defn- ed-buffer-list-text (m)
  "The `*Buffer List*` rows: one per pool buffer — `*` when modified, `%` when read-only,
then name, size, mode and file (Emacs `list-buffers`, minus the columns nobody reads)."
  (let (rows (map (:buffers m)
               (fn (b)
                 (str "  "
                   (if (buffer-modified? b) "*" " ")
                   (if (read-only? b) "%" " ")
                   " "
                   (string/pad-right (buffer-name b) 24)
                   " "
                   (string/pad-left (str (buffer-length b)) 8)
                   "  "
                   (string/pad-right (ed-buf-mode-name b) 12)
                   " "
                   (or (buffer-file b) "")))))
    (str "  MR Buffer                       Size  Mode         File\n"
      (string/join rows "\n")
      "\n")))

(defn- ed-buffer-list-name-at (m)
  "The buffer named on the current `*Buffer List*` row: the name column, matched back
against the pool (a name can hold spaces, so the row is matched by prefix, longest first)."
  (let (line (buffer-line-at (ed-current-buf m) (buffer-current-line (ed-current-buf m)))
        body (if (>= (string/length line) 5) (string/substring line 5 (string/length line)) "")
        names (sort (map (:buffers m) buffer-name)
                (fn (a b) (> (string/length a) (string/length b)))))
    (seq/find names (fn (nm) (string/starts-with? body nm)))))

(defcommand cmd-list-buffers
  (m key)
  "List every open buffer in a read-only `*Buffer List*` (C-x C-b, Emacs `list-buffers`):
modified/read-only flags, name, size, mode and file. `RET` visits the buffer on the row,
`g` refreshes, `q` quits — the `:buffer-menu` mode's keys."
  (ed-show-named m "*Buffer List*" (ed-buffer-list-text m) :buffer-menu))

(defcommand cmd-buffer-menu-select
  (m key)
  "RET in `*Buffer List*`: switch to the buffer named on this row."
  (let (nm (ed-buffer-list-name-at m))
    (if (nil? nm) (message m "not on a buffer row") (ed-switch-to-named m nm))))

(defcommand cmd-buffer-menu-refresh
  (m key)
  "g in `*Buffer List*`: rebuild the listing."
  (cmd-list-buffers m key))

;; dabbrev-expand (M-/): complete the word before point from the words in the buffer,
;; nearest-before-point first, then after; a repeated M-/ tries the next candidate in
;; place of the last one — Emacs `dabbrev-expand`, without the other-buffer search.
(defn- ed-dabbrev-candidates (text prefix at)
  "The distinct words of `text` that start with `prefix` (and are longer than it), ordered
by distance from offset `at`: the nearest before point first, then the ones after."
  (let (words (ed-word-spans text) ; `[start end]` per word, in order
        before (reverse (seq/filter words (fn ([s e]) (< e at))))
        after (seq/filter words (fn ([s e]) (> s at)))
        pick (fn (spans)
               (seq/keep spans
                 (fn ([s e])
                   (let (w (string/substring text s e))
                     (when (and (> (string/length w) (string/length prefix))
                             (string/starts-with? w prefix))
                       w))))))
    (seq/distinct (append (pick before) (pick after)))))

(defn- ed-word-spans (text)
  "`[start end]` of every run of word characters in `text` (`complete-word-char?`)."
  (let (n (string/length text)
        step (fn (i start acc)
               (cond
                 (>= i n) (reverse (if start (cons [start n] acc) acc))
                 (complete-word-char? (string/char-at text i)) (step (inc i) (or start i) acc)
                 start (step (inc i) nil (cons [start i] acc))
                 else (step (inc i) nil acc))))
    (step 0 nil '())))

(defcommand cmd-dabbrev-expand
  (m key)
  "Expand the word before point to a word in the buffer that starts with it (M-/, Emacs
`dabbrev-expand`): the nearest one before point, then the ones after. Pressing M-/ again
right away replaces the expansion with the next candidate; anything else ends the cycle.
The state rides `:dabbrev` (`{:start :prefix :candidates :index}`) and is honoured only
while `:last-command` is this one."
  (let (buf (ed-current-buf m)
        p (buffer-point buf)
        st (:dabbrev m)
        again? (and st (= (:last-command m) 'commands/cmd-dabbrev-expand))
        text (buffer-text buf)
        start (if again? (:start st) (let (s (ed-word-start text p)) s))
        prefix (if again? (:prefix st) (string/substring text start p))
        cands (if again? (:candidates st) (ed-dabbrev-candidates text prefix start))
        index (if again? (inc (:index st)) 0))
    (cond
      (= prefix "") (message m "no word before point to expand")
      (empty? cands) (message m (str "no expansion for `" prefix "`"))
      (>= index (count cands))
      ;; the cycle is over: back to the prefix, as Emacs does, and start again next time
        (message (assoc (ed-edit m (fn (b) (replace-region b start p prefix))) :dabbrev nil)
          (str "no further expansions for `" prefix "`"))
      else
        (let (w (nth cands index))
          (assoc (ed-edit m (fn (b) (replace-region b start p w)))
            :dabbrev {:start start :prefix prefix :candidates cands :index index})))))

(defn- ed-word-start (text p)
  "The start of the run of word characters ending at `p` in `text` (`p` itself when the
char before it is not a word char)."
  (let (step (fn (i)
               (if (and (> i 0) (complete-word-char? (string/char-at text (dec i))))
                 (step (dec i))
                 i)))
    (step p)))

;; shell commands: `M-!` runs one and shows its output; `M-|` pipes the region through
;; one (`os/cmd` in the buffer's directory, off the loop), so a long-running command is
;; what `C-c r` / the bshell are for — these are for `ls`, `date`, `sort -u`.
(def *shell-command-timeout-ms* 120000)
;; A shell command gets two minutes before the task is killed and reported as a timeout.
;; `M-! sleep 600` is a typo, not an instruction to make the editor unusable for ten
;; minutes, and an unbounded slot is one that never frees.

(defn- ed-shell-command (dir cmd stdin)
  "`{:exit :stdout :stderr}` of `sh -c cmd` in `dir`, fed `stdin` (nil for none), killed —
with everything it started — after `*shell-command-timeout-ms*`. The one place M-! and M-|
run a command, so the timeout reaches the OS process: a timeout on the TASK alone ended the
green process and left `sleep 600` running."
  (os/cmd "sh" ["-c" cmd] {:cwd dir :stdin stdin :timeout-ms *shell-command-timeout-ms*}))

(defn ed-shell-run (m cmd stdin)
  "`{:exit :stdout :stderr}` of `sh -c cmd` in the buffer's default directory, with
`stdin` (nil for none). SYNCHRONOUS — the shared core, run inside a task by
`ed-shell-launch` and inline only when headless."
  (ed-shell-command (ed-default-dir m) cmd stdin))

;; check-allow: `then` is a caller-supplied `(model result) -> model`, so the checker
;; cannot see the last branch's result (ADR-341's `:trusted`, as `git/git-launch-op`).
(check-allow :trusted
  (sig ed-shell-launch (model string any any -> model))
  (defn ed-shell-launch (m cmd stdin then)
    "Run `sh -c cmd` OFF the loop and hand the result to `then` (`(model result) -> model`).

`M-!` used to run on the dispatch path, which is fine for `date` and a freeze for anything
else — and what counts as \"anything else\" is not knowable in advance: `M-! make`,
`M-! grep -r` over a monorepo, a command that waits on a lock. The docstring said
\"synchronous, so use `C-c r` for long ones\", which is a rule the editor was asking the
reader to enforce on its behalf.

One at a time, like every other off-loop job here: a second while one runs is refused
rather than queued. Headless runs it inline, so tests and `--headless` are unchanged."
    (cond
      (:shell-proc m) (message m "a shell command is already running")
      (ed-headless?) (then m (ed-shell-run m cmd stdin))
      :else
        (let (dir (ed-default-dir m)
              job (task (fn () (ed-shell-command dir cmd stdin))
                    {:timeout *shell-command-timeout-ms*}))
          (assoc (message m (str "running: " cmd))
            :shell-proc job
            :shell-then then
            :shell-cmd cmd)))))

(check-allow :trusted
  ;; M-! / M-| — a shell command is arbitrarily long, so it is a task like the rest
  (register-task-reply :shell-proc 'commands/ed-apply-shell nil "shell")
  (sig ed-apply-shell (model any -> model))
  (defn ed-apply-shell (m r)
    "Fold a finished `ed-shell-launch`. A nil `r` is the task having errored or timed out,
said as such rather than reported as a command that succeeded with no output."
    (let (then (:shell-then m)
          cmd (:shell-cmd m "the command")
          m1 (dissoc m :shell-proc :shell-then :shell-cmd))
      (cond
        (nil? r)
          (message m1
            (str cmd " failed or timed out after " *shell-command-timeout-ms* "ms"))
        (nil? then) m1
        :else (then m1 r)))))

(defn- ed-shell-show (m cmd r)
  "Show a shell command's result the Emacs way: one output line in the echo area, more in
`*Shell Command Output*` beside the buffer; a failure's stderr joins the output."
  (let (out (str (:stdout r) (if (= (:stderr r) "") "" (:stderr r)))
        trimmed (string/trim out)
        lines (string/split trimmed "\n"))
    (cond
      (= trimmed "")
        (message m
          (str "(shell command "
            (if (= (:exit r) 0) "succeeded" (str "failed: " (:exit r)))
            " with no output)"))
      (= (count lines) 1) (message m trimmed)
      else (ed-show-named-aside m "*Shell Command Output*" out :special))))

(defcommand cmd-shell-command
  (m key)
  "Run a shell command and show its output (M-!, Emacs `shell-command`): one line of
output goes to the echo area, more to `*Shell Command Output*` in a side pane. Runs
`sh -c` in the buffer's directory, synchronously."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Shell command: " "")
       :on-complete (fn (mm t)
                      (if (= (string/trim t) "")
                        (message mm "no command")
                        (ed-shell-launch mm t nil (fn (m2 r) (ed-shell-show m2 t r)))))}))

(defcommand cmd-shell-command-on-region
  (m key)
  "Pipe the region through a shell command (M-|, Emacs `shell-command-on-region`): the
region is the command's stdin; the output is shown like `M-!` — or, with a prefix
argument (`C-u M-|`), REPLACES the region (the `sort`/`fmt`/`jq .` idiom)."
  (let (buf (ed-current-buf m)
        rb (buffer-region-bounds buf)
        replace? (not (nil? (current-prefix-arg m))))
    (if (nil? rb)
      (message m "no region (set the mark first)")
      (let ([lo hi] rb
            input (text/slice (buffer-rope buf) lo hi))
        (assoc m
          :minibuffer
            {:edit (ed-mb-edit (if replace?
                                 "Shell command on region (replace): "
                                 "Shell command on region: ")
                     "")
             :on-complete (fn (mm t)
                            (if (= (string/trim t) "")
                              (message mm "no command")
                              (ed-shell-launch mm
                                t
                                input
                                (fn (m2 r)
                                  ;; the region's bounds were captured before the command
                                  ;; ran; the reply can land after an edit moved them, so
                                  ;; the replace is clamped to the text that is there now
                                  (if (and replace? (= (:exit r) 0))
                                    (message (ed-edit m2
                                               (fn (b)
                                                 (let (len (buffer-length b)
                                                       a (math/min lo len)
                                                       z (math/min hi len))
                                                   (replace-region b a z (:stdout r)))))
                                      (str "region replaced by `" t "`"))
                                    (ed-shell-show m2 t r))))))})))))
(register-prefix-consuming 'commands/cmd-shell-command-on-region)

;; line utilities
(defn- ed-blank-line? (buf line)
  "Whether buffer `line` holds only whitespace."
  (= "" (string/trim (buffer-line-at buf line))))

(defn- ed-blank-run (buf line dir)
  "The last line of the run of blank lines from `line` in direction `dir` (+1 down, -1
up), `line` itself when it is not blank or the run ends there."
  (let (n (buffer-line-count buf)
        step (fn (l)
               (let (next (+ l dir))
                 (if (and (>= next 0) (< next n) (ed-blank-line? buf next)) (step next) l))))
    (if (ed-blank-line? buf line) (step line) line)))

(defn- ed-delete-lines (buf from to)
  "Delete buffer lines `[from, to]` inclusive, with their newlines."
  (let (rope (buffer-rope buf)
        n (buffer-line-count buf)
        lo (text/line->char rope from)
        hi (if (< (inc to) n) (text/line->char rope (inc to)) (buffer-length buf)))
    (replace-region buf lo hi "")))

(defcommand cmd-delete-blank-lines
  (m key)
  "On a blank line, delete all surrounding blank lines, leaving just one; on an isolated
blank line, delete it; on a non-blank line, delete every blank line that follows it
(C-x C-o, Emacs `delete-blank-lines`)."
  (ed-edit m
    (fn (b)
      (let (line (buffer-current-line b))
        (if (ed-blank-line? b line)
          (let (first (ed-blank-run b line -1)
                last (ed-blank-run b line 1))
            (if (= first last)
              (ed-delete-lines b line line) ; isolated: gone
              ;; a run: keep one (the first), delete the rest, point on the survivor
              (goto-char (ed-delete-lines b (inc first) last)
                (text/line->char (buffer-rope b) first))))
          (let (n (buffer-line-count b)
                next (inc line))
            (if (and (< next n) (ed-blank-line? b next))
              (let (last (ed-blank-run b next 1)
                    p (buffer-point b))
                (goto-char (ed-delete-lines b next last) p))
              b)))))))

(defcommand cmd-sort-lines
  (m key)
  "Sort the lines of the region (or the current line's paragraph of one line — the
whole buffer when there is no region) alphabetically, in place (M-x sort-lines)."
  (ed-edit m
    (fn (b)
      (let (rope (buffer-rope b)
            rb (buffer-region-bounds b)
            [sl el] (if rb (region-line-range b) [0 (dec (buffer-line-count b))])
            lo (text/line->char rope sl)
            hi (if (< (inc el) (buffer-line-count b))
                 (text/line->char rope (inc el))
                 (buffer-length b))
            block (text/slice rope lo hi)
            trailing-nl (string/ends-with? block "\n")
            body (if trailing-nl (string/substring block 0 (dec (string/length block))) block)
            sorted (string/join (sort (string/split body "\n")) "\n"))
        (goto-char (replace-region b lo hi (if trailing-nl (str sorted "\n") sorted)) lo)))))

(defcommand cmd-delete-trailing-whitespace
  (m key)
  "Delete the spaces and tabs at the end of every line of the buffer (M-x
delete-trailing-whitespace)."
  (let (before (buffer-text (ed-current-buf m))
        after (string/join (map (string/split before "\n") string/trimr) "\n"))
    (if (= before after)
      (message m "no trailing whitespace")
      (message (ed-edit m
                 (fn (b)
                   (goto-char (replace-region b 0 (buffer-length b) after)
                     (math/min (buffer-point b) (string/length after)))))
        "trailing whitespace deleted"))))

(defcommand cmd-count-words
  (m key)
  "Report the lines, words and characters of the region, or of the whole buffer when there
is none (M-=, Emacs `count-words`)."
  (let (buf (ed-current-buf m)
        rb (buffer-region-bounds buf)
        text (if rb (text/slice (buffer-rope buf) (first rb) (second rb)) (buffer-text buf))
        lines (count (seq/filter (string/split text "\n") (fn (l) (not (= l "")))))
        words (count (ed-word-spans text)))
    (message m
      (str (if rb "Region" "Buffer")
        " has "
        lines
        " lines, "
        words
        " words, and "
        (string/length text)
        " characters"))))

(defcommand cmd-insert-file
  (m key)
  "Insert a file's contents at point (C-x i, Emacs `insert-file`), leaving point before the
text and the mark after it, so the inserted text is the region."
  (assoc m
    :minibuffer
      (ed-path-prompt "Insert file: "
        (str (ed-default-dir m) "/")
        []
        (fn (mm t)
          (if (or (not (file/exists? t)) (file/dir? t))
            (message mm (str "no such file: " t))
            (let (content (file/slurp t)
                  p (buffer-point (ed-current-buf mm)))
              ;; `insert` leaves point after the text: mark there, point back at the start
              (message (ed-edit mm (fn (b) (goto-char (set-mark (insert b content)) p)))
                (str "inserted " t))))))))
