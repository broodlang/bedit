(defmodule commands
  "The editor's commands. Each is a global `(fn (model key) -> model)` resolved
by symbol at dispatch time (see `input`), so redefining one hot-swaps the key's
behaviour live — the late binding that makes a self-editing editor possible.
`key` is the triggering key event; most commands ignore it, `cmd-self-insert`
inserts it.

All editing/movement runs on the *current* buffer (the active entry in the
model's `:buffers`): movement applies a `buffer -> buffer` op through `ed-apply`
(no modified flag); edits go through `ed-edit` (marks the buffer modified). The
region/kill commands maintain the model's `:kill-ring`; the buffer commands move
between / open / kill buffers; `cmd-switch-buffer` / `cmd-find-file` open a
minibuffer prompt (see `input`). This is editor *policy* — the reusable buffer
model lives in `std/buffer.blsp`; keymaps in `input`."
  (:use buffer)  ; the buffer ops the commands drive (incl. undo/redo, word motion)
  (:use eval-command)  ; last-sexp-source + eval-source — the async C-x C-e family
  (:use sexp)  ; structural s-expression navigation (brood-mode commands)
  (:use interactive)  ; defcommand — define + register an interactive command (M-x)
  (:use pane)  ; the pane-tree ops behind the split/other/delete commands
  (:use complete)  ; cmd-complete / complete-word-char? — TAB indent-or-complete
  (:use mincomplete)  ; ed-complete-name / ed-complete-path — minibuffer prompt completion
  (:use projects)  ; project-root / project-files — find-file-in-project (C-x p f)
  (:use model))  ; current-buffer accessors, the kill ring, message

;; ---- applying buffer ops to the current buffer ------------------------------

(defn ed-apply (m f)
  "Apply a pure `buffer -> buffer` op `f` to the current buffer (movement/undo:
no status change)."
  (ed-set-buf m (f (ed-current-buf m))))

(defn ed-edit (m f)
  "Apply a pure `buffer -> buffer` op `f` to the current buffer, marking it
modified (edits)."
  (assoc (ed-set-buf m (f (ed-current-buf m))) :status "modified"))

;; ---- movement (Emacs C-f/C-b/C-n/C-p/C-a/C-e/M-f/M-b + the arrow keys) -------

(defcommand cmd-forward-char (m key) (ed-apply m forward-char))
(defcommand cmd-backward-char (m key) (ed-apply m backward-char))
(defcommand cmd-next-line (m key) (ed-apply m forward-line))
(defcommand cmd-previous-line (m key) (ed-apply m backward-line))
(defcommand cmd-beginning-of-line (m key) (ed-apply m beginning-of-line))
(defcommand cmd-end-of-line (m key) (ed-apply m end-of-line))
(defcommand cmd-forward-word (m key) (ed-apply m forward-word))
(defcommand cmd-backward-word (m key) (ed-apply m backward-word))
(defcommand cmd-beginning-of-buffer (m key) (ed-apply m beginning-of-buffer))  ; M-<
(defcommand cmd-end-of-buffer (m key) (ed-apply m end-of-buffer))  ; M->

;; ---- structural s-expression motion (brood-mode: C-M-f/b/u/d/a) -------------
;; Each runs a `std/sexp` buffer command over the current buffer — navigation by
;; the parse-source CST, not characters. Bound only in `brood-mode` (see `modes`).

(defcommand cmd-forward-sexp (m key) (ed-apply m (fn (b) (sexp/forward b key))))
(defcommand cmd-backward-sexp (m key) (ed-apply m (fn (b) (sexp/backward b key))))
(defcommand cmd-up-list (m key) (ed-apply m (fn (b) (sexp/up b key))))
(defcommand cmd-down-list (m key) (ed-apply m (fn (b) (sexp/down b key))))
(defcommand cmd-beginning-of-defun (m key) (ed-apply m (fn (b) (sexp/beginning-of-defun b key))))

;; ---- indentation (TAB / RET; sexp-aware via the mode's :indent service) -----
;; The mechanism is language-neutral: `ed-indent-target` asks the buffer's mode for
;; an `:indent` service (brood-mode supplies a sexp-aware one — see `modes`), and
;; falls back to matching the previous line. `ed-reindent-line` rewrites the line's
;; leading whitespace, preserving point. Emacs feel: TAB indents-or-completes, and
;; (in brood-mode) RET indents the new line.

(defn ed--ws-char? (c) "True for an indentation char (space or tab)." (or (= c " ") (= c "\t")))

(defn ed--leading-ws* (text i n)
  (if (and (< i (string-length text)) (ed--ws-char? (char-at text i)))
    (ed--leading-ws* text (inc i) (inc n))
    n))
(defn ed--leading-ws (text bol)
  "The count of leading spaces/tabs on the line starting at offset `bol`."
  (ed--leading-ws* text bol 0))

(defn ed--fallback-indent (text bol)
  "The simple, mode-less indent for the line at `bol`: the leading-whitespace width
of the previous non-blank line, or 0 at the top. Tail-recursive over blank lines."
  (if (<= bol 0)
    0
    (let (prev-bol (ed-line-start-offset text (dec bol))
          content-len (- (dec bol) prev-bol)
          ws (ed--leading-ws text prev-bol))
      (if (>= ws content-len)
        ; previous line is empty / all whitespace — skip it
        (ed--fallback-indent text prev-bol)
        ws))))

(defn ed-indent-target (buf)
  "The column the current line should indent to: the buffer mode's `:indent` service
applied to the line start, else the previous-line fallback."
  (let (text (buffer-text buf)
        bol (buffer-point (beginning-of-line buf))
        svc (ed-mode-service buf :indent))
    (if (nil? svc) (ed--fallback-indent text bol) (svc text bol))))

(defn ed-reindent-line (buf target)
  "Reindent the current line of `buf` to `target` columns of leading spaces,
preserving point: from inside the old indentation point moves to the first non-blank
char; from the body it shifts by the indent delta."
  (let (text (buffer-text buf)
        p (buffer-point buf)
        bol (buffer-point (beginning-of-line buf))
        cur (ed--leading-ws text bol)
        within (<= (- p bol) cur)
        b1 (insert (delete-char (goto-char buf bol) cur) (string-repeat " " target))
        newp (if within (+ bol target) (+ p (- target cur))))
    (goto-char b1 newp)))

(defcommand cmd-indent-line
  (m key)
  "Reindent the current line to the column its mode dictates — sexp-aware in
brood-mode, the previous line elsewhere (`M-x indent-line`)."
  (ed-edit m (fn (b) (ed-reindent-line b (ed-indent-target b)))))

(defcommand cmd-newline-and-indent
  (m key)
  "Enter in a structured mode: insert a newline, then indent the new line to its
mode's column (Emacs `newline-and-indent`)."
  (ed-edit m
    (fn (b)
      (let (nb (insert b "\n"))
        (ed-reindent-line nb (ed-indent-target nb))))))

(defcommand cmd-indent-or-complete
  (m key)
  "TAB: reindent the current line; if it's already at the right indent and point
sits on a symbol, complete instead (Emacs `tab-always-indent` = `'complete`)."
  (let (buf (ed-current-buf m)
        text (buffer-text buf)
        bol (buffer-point (beginning-of-line buf))
        cur (ed--leading-ws text bol)
        p (buffer-point buf)
        target (ed-indent-target buf))
    (if (and (= cur target)
          (> p (+ bol cur))
          (complete-word-char? (char-at text (dec p))))
      (cmd-complete m key)
      (ed-edit m (fn (b) (ed-reindent-line b target))))))

;; ---- screenful scrolling (C-v / M-v, PageDown / PageUp) ---------------------
;; A "page" is the viewport height less one line of overlap. `ed-update` stashes
;; the live viewport height on the model as `:view-rows`, so these stay correct
;; across a pane resize (10 is a fallback for a model built outside the loop).

(defn ed-page-step (m)
  "Lines a screenful scroll moves: the viewport height (`:view-rows`) less one
line of overlap; at least 1."
  (max 1 (dec (or (get m :view-rows) 10))))

(defcommand cmd-scroll-up
  (m key)
  "Scroll forward a screenful (C-v / PageDown): move point down ~one viewport,
keeping a line of context. (Emacs `scroll-up-command` — the view scrolls up.)"
  (ed-apply m (fn (b) (forward-line b (ed-page-step m)))))

(defcommand cmd-scroll-down
  (m key)
  "Scroll back a screenful (M-v / PageUp): move point up ~one viewport, keeping a
line of context. (Emacs `scroll-down-command` — the view scrolls down.)"
  (ed-apply m (fn (b) (backward-line b (ed-page-step m)))))

;; ---- editing ----------------------------------------------------------------

(defcommand cmd-self-insert
  (m key)
  "Insert the typed character `key` (a 1-char string) at point."
  (ed-edit m (fn (b) (insert b key))))

(defcommand cmd-newline (m key) (ed-edit m (fn (b) (insert b "\n"))))
(defcommand cmd-delete-char (m key) (ed-edit m delete-char))
(defcommand cmd-delete-backward (m key) (ed-edit m delete-backward-char))

;; ---- line / word editing (open-line, kill-line/word, transpose, case) -------

;; ---- the kill ring (Emacs-style: coalesce consecutive kills; M-y yank-pops) --
;; The model tracks `:last-command`/`:this-command` (set by the dispatch loop, see
;; `input`) so a kill knows whether the *previous* command was also a kill (then it
;; appends to the head entry rather than starting a new one), and so M-y
;; (`cmd-yank-pop`) only fires right after a yank.

;; Commands whose consecutive use coalesces into one kill-ring entry (like Emacs).
(def ed--kill-commands
  '(commands/cmd-kill-region commands/cmd-copy-region
     commands/cmd-kill-line
     commands/cmd-kill-word
     commands/cmd-backward-kill-word
     commands/cmd-kill-whole-line))
(def ed--yank-commands '(commands/cmd-yank commands/cmd-yank-pop))

;; Cap the ring like Emacs's `kill-ring-max` (default 60) so it can't grow forever.
(def ed-kill-ring-max 60)

(defn ed--in? (sym syms) (some? (fn (s) (= s sym)) syms))
(defn ed--kill-command? (sym) (ed--in? sym ed--kill-commands))
(defn ed--yank-command? (sym) (ed--in? sym ed--yank-commands))

(defn ed-push-kill (m text forward?)
  "Push killed `text` onto the kill ring. If the previous command was also a kill,
**append** to the current head entry instead of starting a new one — at the end for
a forward kill, the front for a backward kill (Emacs's consecutive-kill coalescing).
Otherwise cons a fresh entry."
  (let (ring (get m :kill-ring))
    (assoc m
      :kill-ring
      (take ed-kill-ring-max
        (if (and (ed--kill-command? (get m :last-command)) (not (empty? ring)))
          (cons (if forward? (str (first ring) text) (str text (first ring))) (rest ring))
          (cons text ring))))))

(defn ed-kill-span (m move)
  "Kill from point to where `move` (a `buffer -> buffer` point move) lands: push
the spanned text onto the kill ring (coalescing with an adjacent kill) and delete
it. An empty span is a no-op."
  (let (b (ed-current-buf m)
         p0
         (buffer-point b)
         moved
         (move (set-mark b))  ; mark = point; point moves
         text
         (buffer-region moved))
    (if (or (nil? text) (= text ""))
      m
      (assoc (ed-set-buf (ed-push-kill m text (> (buffer-point moved) p0))
               (clear-mark (delete-region moved)))
        :status
        "modified"))))

(defn ed-capitalize (s)
  "`s` with its first character upper-cased and the rest lower-cased."
  (if (= s "") s (str (upper (substring s 0 1)) (lower (substring s 1 (string-length s))))))

(defn ed-xform-word (m f)
  "Apply the string transform `f` to the word from point forward, leaving point
after it (M-u / M-l / M-c)."
  (let (b (ed-current-buf m)
        p (buffer-point b)
        e (buffer-point (forward-word b))
        word (buffer-region (assoc b :mark p :point e)))
    (if (or (nil? word) (= word ""))
      m
      (ed-edit m (fn (bb) (insert (delete-region (assoc bb :mark p :point e)) (f word)))))))

;; open lines — C-o keeps point, M-o opens below, M-O opens above
(defcommand cmd-open-line
  (m key)
  "Insert a newline after point, leaving point (C-o)."
  (ed-edit m (fn (b) (backward-char (insert b "\n")))))
(defcommand cmd-open-line-below
  (m key)
  "Open a new line below and move there (M-o)."
  (ed-edit m (fn (b) (insert (end-of-line b) "\n"))))
(defcommand cmd-open-line-above
  (m key)
  "Open a new line above and move there (M-O)."
  (ed-edit m (fn (b) (backward-line (insert (beginning-of-line b) "\n")))))

;; kill (into the kill ring)
(defcommand cmd-kill-line
  (m key)
  "Kill from point to end of line (C-k); at end of line, kill the newline."
  (let (b (ed-current-buf m))
    (if (= (buffer-char-after b) "\n")
      (ed-edit (ed-push-kill m "\n" true) delete-char)
      (ed-kill-span m end-of-line))))
(defcommand cmd-kill-word (m key) "Kill the word after point (M-d)." (ed-kill-span m forward-word))
(defcommand cmd-backward-kill-word
  (m key)
  "Kill the word before point (M-DEL)."
  (ed-kill-span m backward-word))
(defcommand cmd-kill-whole-line
  (m key)
  "Kill the whole current line, newline included."
  (ed-kill-span (ed-apply m beginning-of-line) (fn (b) (forward-char (end-of-line b)))))

;; transpose / duplicate / join
(defcommand cmd-transpose-chars
  (m key)
  "Swap the two characters around point and move forward (C-t)."
  (ed-edit m
    (fn (b)
      (let (p (buffer-point b))
        (if (and (>= p 1) (< p (buffer-length b)))
          (insert (delete-char (goto-char b (dec p)) 2)
            (str (buffer-char-after b) (buffer-char-before b)))
          b)))))
(defcommand cmd-duplicate-line
  (m key)
  "Duplicate the current line below it (C-x d)."
  (ed-edit m
    (fn (b)
      (let (lt (buffer-line-at b (buffer-current-line b)))
        (insert (beginning-of-line b) (if (ends-with? lt "\n") lt (str lt "\n")))))))
(defcommand cmd-join-line
  (m key)
  "Join the next line onto this one — delete the newline at end of line (M-^)."
  (ed-edit m (fn (b) (delete-char (end-of-line b)))))

;; case
(defcommand cmd-upcase-word (m key) (ed-xform-word m upper))
(defcommand cmd-downcase-word (m key) (ed-xform-word m lower))
(defcommand cmd-capitalize-word (m key) (ed-xform-word m ed-capitalize))

;; ---- undo / redo ------------------------------------------------------------

(defcommand cmd-undo (m key) (assoc (ed-apply m undo) :status "undo"))
(defcommand cmd-redo (m key) (assoc (ed-apply m redo) :status "redo"))

;; ---- region / kill ring (C-SPC set mark · C-w kill · M-w copy · C-y yank) ----

(defcommand cmd-set-mark
  (m key)
  "Set the mark at point — point and mark delimit the region."
  (message (ed-apply m set-mark) "mark set"))

(defcommand cmd-kill-region
  (m key)
  "Delete the region and push its text onto the kill ring (C-w)."
  (let (text (buffer-region (ed-current-buf m)))
    (if (nil? text)
      (message m "no region (set the mark with C-SPC first)")
      (ed-edit (ed-push-kill m text true) delete-region))))

(defcommand cmd-copy-region
  (m key)
  "Push the region's text onto the kill ring without deleting it (M-w)."
  (let (text (buffer-region (ed-current-buf m)))
    (if (nil? text)
      (message m "no region")
      (message (ed-apply (ed-push-kill m text true) clear-mark) "region copied"))))

(defcommand cmd-yank
  (m key)
  "Insert the most recently killed/copied text at point (C-y), recording the
inserted span + ring index in `:yank` so M-y (`cmd-yank-pop`) can replace it."
  (let (ring (get m :kill-ring))
    (if (empty? ring)
      (message m "kill ring is empty")
      (let (b (ed-current-buf m)
            start (buffer-point b)
            b2 (insert b (first ring)))
        (assoc (ed-set-buf m b2)
          :status
          "modified"
          :yank
          {:start start :end (buffer-point b2) :index 0})))))

(defcommand cmd-yank-pop
  (m key)
  "Replace the text of the immediately-preceding yank with the next-older kill,
cycling the ring (M-y). Only valid right after a yank or yank-pop; otherwise it
reports that the previous command was not a yank."
  (let (y (get m :yank) ring (get m :kill-ring))
    (if (or (nil? y) (not (ed--yank-command? (get m :last-command))) (empty? ring))
      (message m "previous command was not a yank")
      (let (n (count ring)
             idx
             (let (i (inc (get y :index))) (if (>= i n) 0 i))
             text
             (nth ring idx)
             b
             (ed-current-buf m)
             ;; delete the previous yank's span [start,end] (point lands at start),
             ;; then insert the next entry there
             cleared
             (delete-region (assoc b :mark (get y :start) :point (get y :end)))
             b2
             (insert cleared text))
        (assoc (ed-set-buf m b2)
          :status
          "modified"
          :yank
          {:start (get y :start) :end (buffer-point b2) :index idx})))))

;; ---- multiple buffers -------------------------------------------------------

;; Switching shows buffer `i` in the SELECTED pane (other panes keep their
;; buffers); `:status` is per-model, so reset it (else a stale "modified" from the
;; previous buffer would describe the new one).
(defn ed-select (m i)
  (assoc (ed-show-index m i) :status ""))

(defcommand cmd-next-buffer
  (m key)
  "Show the next buffer in the selected pane (wraps)."
  (ed-select m (mod (inc (ed-current-index m)) (count (get m :buffers)))))

(defcommand cmd-previous-buffer
  (m key)
  "Show the previous buffer in the selected pane (wraps)."
  (ed-select m
    (mod (+ (dec (ed-current-index m)) (count (get m :buffers)))
      (count (get m :buffers)))))

(defn ed-has-editable? (bufs)
  "Whether the pool `bufs` holds a buffer other than `*Messages*`."
  (some? (fn (b) (not (= (buffer-name b) "*Messages*"))) bufs))

(defn ed--remap (m killed target)
  "Re-point every pane after pool index `killed` was removed: a pane on
`killed` now shows `target`; panes above `killed` shift down one; below are
unchanged. (Routes through `ed-map-panes` over all leaf payloads.)"
  (ed-map-panes m
    (fn (w)
      (let (b (get w :buffer))
        (assoc w :buffer (cond (< b killed) b (> b killed) (dec b) else target))))))

(defcommand cmd-kill-buffer
  (m key)
  "Kill the current buffer (C-x k). Refuses to kill `*Messages*`; if it would leave
no editable buffer, opens a fresh `*scratch*`. Panes showing the killed buffer are
re-pointed; indices above it shift down."
  (let (killed-idx (ed-current-index m)
        buf (ed-current-buf m))
    (if (= (buffer-name buf) "*Messages*")
      (message m "cannot kill *Messages*")
      (let (removed (ed-remove-nth (get m :buffers) killed-idx)
            label (str "killed " (buffer-name buf)))
        (if (ed-has-editable? removed)
          ;; another editable buffer remains: the killed pane shows the buffer
          ;; that shifted into its slot (clamped to the last index).
          (message (ed--remap (assoc m :buffers removed)
                     killed-idx
                     (min killed-idx (dec (count removed))))
            label)
          ;; none left → append a fresh *scratch* and point the killed pane at it.
          (let (bufs (into removed [(ed-stamp (make-buffer ""))]))
            (message (ed--remap (assoc m :buffers bufs) killed-idx (count removed)) label)))))))

(defn ed-open-buffer (m buf)
  "Add `buf` to the pool (mode-stamped) and show it in the selected pane."
  (let (bufs (into (get m :buffers) [(ed-stamp buf)]))
    (ed-select (assoc m :buffers bufs) (dec (count bufs)))))

(defn ed-switch-to-named (m nm)
  "Switch to the buffer named `nm`, or report there's no such buffer."
  (let (idx (ed-buffer-index-by-name m nm))
    (if (nil? idx) (message m (str "no buffer named " nm)) (ed-select m idx))))

(defn ed-find-file (m path)
  "Open `path`: switch to it if already open, read it if it exists, else start a
fresh buffer backed by it (so Ctrl-S creates it)."
  (if (blank? path)
    (message m "(no file)")
    (let (idx (ed-buffer-index-by-name m path))
      (cond
        (not (nil? idx)) (ed-select m idx)
        (file-exists? path) (try
                              (message (ed-open-buffer m (buffer-from-file path))
                                (str "opened " path))
                              (catch e
                                (message m (str "open failed: " (if (string? e) e (pr-str e))))))
        else (message (ed-open-buffer m (make-buffer "" path path)) (str "new file " path))))))

;; ---- panes (tiled splits, Emacs C-x 2/3/0/1/o) ----------------------------
;; Operate on the model's `:layout` pane tree (std/pane). A split shows the
;; same buffer in the new pane (point/scroll independent); selection/edits follow
;; the selected pane.

(defcommand cmd-split-pane-below
  (m key)
  "Split the selected pane top/bottom; the new pane shows the same buffer (C-x 2)."
  (assoc m :layout (pane-split (get m :layout) :row (ed-pane (ed-current-index m)))))

(defcommand cmd-split-pane-right
  (m key)
  "Split the selected pane left/right; the new pane shows the same buffer (C-x 3)."
  (assoc m :layout (pane-split (get m :layout) :col (ed-pane (ed-current-index m)))))

(defcommand cmd-other-pane
  (m key)
  "Move selection to the next pane, wrapping (C-x o)."
  (assoc m :layout (pane-other (get m :layout))))

(defcommand cmd-delete-pane
  (m key)
  "Delete the selected pane; its sibling fills the space (C-x 0)."
  (assoc m :layout (pane-delete (get m :layout))))

(defcommand cmd-delete-other-panes
  (m key)
  "Collapse the layout to just the selected pane (C-x 1)."
  (assoc m :layout (pane-delete-others (get m :layout))))

(defcommand cmd-toggle-line-numbers
  (m key)
  "Toggle the left line-number gutter on the selected pane (C-x l). Pane-local, so
one pane can show numbers while another doesn't."
  (ed-toggle-line-numbers m))

;; ---- buffer/file prompts (open a minibuffer; see input/minibuffer-handle) ---

(defcommand cmd-switch-buffer
  (m key)
  "Prompt (minibuffer) for a buffer name to switch to (C-x b), completing against
the open buffers."
  (let (names (map (fn (b) (buffer-name b)) (get m :buffers)))
    (assoc m
      :minibuffer
      {:edit (ed-mb-edit "Switch to buffer: " "")
       :on-complete (fn (mm t) (ed-switch-to-named mm t))
       :complete-fn (fn (t) (ed-complete-name t names))
       :candidates-fn (fn (t) (filter (fn (nm) (starts-with? nm t)) names))})))

(defcommand cmd-find-file
  (m key)
  "Prompt (minibuffer) for a file path to open (C-x C-f), completing against the
filesystem; prefilled with the working directory."
  (assoc m
    :minibuffer
    {:edit (ed-mb-edit "Find file: " (str (cwd) "/"))
     :on-complete (fn (mm t) (ed-find-file mm t))
     :complete-fn (fn (t) (ed-complete-path t))}))

(defn ed-project-root (m)
  "The current project's root: the value `main` cached on the model at startup
(`:project-root`), falling back to resolving it from the working dir (nearest
ancestor holding a `*project-markers*` entry) for a model built without one — e.g.
in tests. Nil when there's no project."
  (or (get m :project-root) (project-root (cwd))))

(defcommand cmd-project-find-file
  (m key)
  "Find a file anywhere in the current project (C-x p f): a minibuffer completing
over every file under the project root (recursive, root-relative). Tab narrows to
the common prefix; Enter opens the first match. Reports when not in a project."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project (no project.blsp found)")
      (let (files (project-files root))
        (assoc m
          :minibuffer
          {:edit (ed-mb-edit "Find file in project: " "")
           :on-complete (fn (mm t)
                          (let (ms (project-matches t files))
                            (if (empty? ms)
                              (message mm (str "no project file matching \"" t "\""))
                              (ed-find-file mm (path-join root (first ms))))))
           :complete-fn (fn (t) (ed-complete-name t files))
           :candidates-fn (fn (t) (project-matches t files))})))))

;; ---- M-x: run any interactive command by name -------------------------------

(defcommand cmd-execute-extended-command
  (m key)
  "Prompt for an interactive command name and run it (M-x). Completes against, and
shows, the registered commands (`defcommand`s); an unknown name is reported."
  (assoc m
    :minibuffer
    {:edit (ed-mb-edit "M-x " "")
     :on-complete (fn (mm t)
                    (interactive/run-command mm t (fn (mmm nm) (message mmm (str "no command: " nm)))))
     :complete-fn (fn (t) (ed-complete-name t (interactive/command-names)))
     :candidates-fn (fn (t)
                      (take 12 (filter (fn (nm) (starts-with? nm t)) (interactive/command-names))))}))

;; ---- files + quit -----------------------------------------------------------

(defcommand cmd-quit
  (m key)
  "Quit the editor (C-x C-c, or the pane close button → :escape)."
  (assoc m :done true))

(defcommand cmd-save
  (m key)
  "Write the current buffer to its file (C-x C-s); report the outcome in the echo
area. A no-op-with-message if the buffer has no backing file."
  (let (buf (ed-current-buf m))
    (if (nil? (buffer-file buf))
      (message m "no file to save (C-x C-f to open one, or run: nest run -- <path>)")
      (try
        (do (save-buffer buf) (message m (str "saved " (buffer-file buf))))
        (catch e (message m (str "save failed: " (if (string? e) e (pr-str e)))))))))

;; ---- eval-in-buffer (the C-x C-e family, via std/eval-command) --------------
;; Thin `(model key) -> model` wrappers over `std/eval-command.blsp`, which does
;; the work (read + eval + value/output capture) as a pure `buffer -> message
;; string` and is shared with any editor. We just route the result to `message`.

(def *eval-timeout-ms*
  ;; Optional safeguard: auto-kill a spawned eval after this many ms (nil = no limit).
  ;; Redefine to arm it — e.g. `(def *eval-timeout-ms* 5000)` via C-x C-e.
  nil)

(defn ed--spawn-watchdog (me job timeout)
  "Spawn a watchdog that, after `timeout` ms, hard-kills the eval `job` and reports a
timeout to the editor `me` (tagged with `job`'s pid, so a stale report is ignored)."
  (spawn (do
           (receive (after timeout nil))
           (exit job :kill)
           (send me [:eval-done job (str "eval timed out after " timeout "ms")]))))

(defn ed-eval-async (m src timeout)
  "Evaluate Brood source string `src` in a **spawned process**, so a long-running or
looping form never freezes the editor (`ui-run` is single-process — a synchronous
eval would block the loop). Safeguards: a still-running prior eval is cancelled
first; the worker tags its result with its own pid — `[:eval-done <pid> <message>]` —
so a stale watchdog (from a cancelled/finished eval) can't clobber a newer one
(`ed-update` shows it only when the pid matches `:eval-proc`); and with `timeout`
(ms, else nil) a watchdog kills the eval after that long. Manual interrupt is C-g
(`cmd-keyboard-quit`). Returns the model with the job on `:eval-proc` and an
`evaluating…` note. (Async delivery relies on the GUI display's mailbox-`receive`
poll; a runaway form runs in its own process while the editor stays live.)"
  (let (prev (get m :eval-proc)
         _
         (when (not (nil? prev)) (exit prev :kill))  ; cancel a still-running eval
         me
         (self)
         job
         (spawn (send me [:eval-done (self) (eval-source src)])))
    (when (and (not (nil? timeout)) (> timeout 0)) (ed--spawn-watchdog me job timeout))
    (message (assoc m :eval-proc job) "evaluating…")))

(defcommand cmd-keyboard-quit
  (m key)
  "C-g: interrupt a running evaluation (hard-kill its process) if one is in flight,
else the usual no-op quit. The kill is `(exit pid :kill)` — a runaway loop dies even
parked; if it had already finished, this is a harmless no-op."
  (let (p (get m :eval-proc))
    (if (nil? p)
      (message m "quit")
      (do (exit p :kill) (message (dissoc m :eval-proc) "eval interrupted")))))

(defcommand cmd-eval-last-sexp
  (m key)
  "C-x C-e — evaluate the last complete form ending at point (multi-line: reads every
form up to point, evals the last) in a separate process; its value + output land in
the echo area / *Messages* when it finishes, so a slow or looping form can't freeze
the editor."
  (let (buf (ed-current-buf m)
        src (last-sexp-source (buffer-text buf) (buffer-point buf)))
    (if (nil? src)
      (message m "no complete form before point")
      (ed-eval-async m src *eval-timeout-ms*))))

(defcommand cmd-eval-region
  (m key)
  "Evaluate the region (point↔mark) as Brood source in a separate process."
  (let (region (buffer-region (ed-current-buf m)))
    (if (nil? region)
      (message m "no region (set the mark first)")
      (ed-eval-async m region *eval-timeout-ms*))))

(defcommand cmd-eval-buffer
  (m key)
  "Evaluate the whole buffer as Brood source in a separate process."
  (ed-eval-async m (buffer-text (ed-current-buf m)) *eval-timeout-ms*))
