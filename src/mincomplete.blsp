(defmodule mincomplete
  "Pure completion helpers for the **minibuffer prompts** (`C-x C-f` find-file,
`C-x b` switch-buffer, `C-x p f` project find-file, `M-x`): complete a typed string
against a candidate set or the filesystem. Distinct from `complete` (the in-buffer
completion-at-point popup); these run on the prompt's text and close over the prompt's
candidate source (see the `:complete-fn`s in `commands`). Data→data and side-effect
free apart from `ed-complete-path` reading the filesystem, so they're unit-testable
without a window."
  (:use projects) ; float-recent — the one shared recency-ordering core
  (:use filename) ; substitute — what a typed path means (`~`, `$HOME`, a restarted `//`)
  (:use memo)) ; defmemo — a directory's listing, per state of the directory
;; ---- longest common prefix --------------------------------------------------

(sig lcp-len (string string int int -> int))
(defn- lcp-len (a b i n)
  (if (or (>= i n) (not (= (string/char-at a i) (string/char-at b i)))) i (lcp-len a b (inc i) n)))
(defn- lcp-2 (a b)
  (string/substring a 0 (lcp-len a b 0 (math/min (count a) (count b)))))
(defn lcp (strs)
  "The longest common prefix of a non-empty sequence of strings."
  (if (empty? strs) "" (fold (rest strs) (first strs) lcp-2)))

;; ---- the shared Tab action --------------------------------------------------
;; Every minibuffer find-prompt completes the same way: replace the typed text with
;; the **common prefix of its candidates** — the sole candidate returned whole, else
;; their longest common prefix, and the text unchanged when nothing matches. The only
;; thing that differs per prompt is *where the candidates come from* (live filesystem
;; entries for find-file, the project's file list for project find-file, a fixed name
;; list for switch-buffer / M-x) — so each `:complete-fn` is just `(complete-prefix t
;; (its-candidates t))` and Tab behaves identically across all of them.

(defn complete-prefix (text candidates)
  "Complete `text` to its `candidates`' common prefix: the sole candidate when there's
one, else their longest common prefix; `text` unchanged when `candidates` is empty. The
shared Tab action behind find-file, project find-file, switch-buffer and M-x."
  (cond
    (empty? candidates) text
    (= (count candidates) 1) (first candidates)
    else (lcp candidates)))

;; ---- filesystem path completion ---------------------------------------------

(sig ed-last-slash (string int -> int))
(defn- ed-last-slash (s i)
  (cond (< i 0) -1 (= (string/char-at s i) "/") i else (ed-last-slash s (dec i))))

(defn- ed-split-path (typed base)
  "Split the live part of `typed` — what follows a restarting `//` or `/~/`
(`filename/shadow-end`) — at its last `/`: the prefix to reattach, kept AS TYPED (`~/`,
`$HOME/`, a `$$` all stay as they are, so a candidate reads the way you wrote it), the
directory that prefix names (`filename/expand`: absolute, a relative one under `base`), and
the fragment being completed, read as a name (`$$` is `$`). With no `/`, the directory
is `base` (else `.`) and there is nothing to reattach. A remote path is
[[ed-split-remote]]'s."
  (if (sshpath/remote-start typed)
    (ed-split-remote typed)
    (let (live (string/substring typed (filename/shadow-end typed base) (count typed))
          i (ed-last-slash live (dec (count live))))
      (if (< i 0)
        {:dir (or base ".") :prefix "" :frag (filename/substitute live base)}
        (let (prefix (string/substring live 0 (inc i))
              dir (filename/expand prefix base))
          {:dir (if (sshpath/remote? dir) (sshpath/canonical dir) (without-trailing-slash dir))
           :prefix prefix
           :frag (filename/substitute (string/substring live (inc i) (count live)) base)})))))

(defn- ed-split-remote (typed)
  "[[ed-split-path]] for a typed REMOTE path (`/ssh:h:/etc/ng`): the path it means
(`filename/substitute`, its restarts applied) split at its last `/` — the prefix with the host
(`/ssh:h:/etc/`), the remote directory it names in its one spelling (`sshpath/canonical`, the
key its listing is kept under), the fragment. With no `/` after the host, the directory is the
remote home. While the host is still being typed, no directory (`:dir` nil)."
  (let (meant (filename/substitute typed)
        remote (filename/remote-split meant)
        path (when remote (:path remote)))
    (if (nil? path)
      {:dir nil :prefix typed :frag ""}
      (let (i (ed-last-slash path (dec (count path))))
        (if (< i 0)
          {:dir (sshpath/canonical (:prefix remote)) :prefix (:prefix remote) :frag path}
          (let (head (str (:prefix remote) (string/substring path 0 (inc i))))
            {:dir (sshpath/canonical head)
             :prefix (path/escape-env head)
             :frag (string/substring path (inc i) (count path))}))))))

(defn- remote-candidates (p names)
  "The entries in a remote directory's `names` (its cached listing, a directory's ending in `/`)
completing split-path `p`, spelled as candidates: the prefix with the host, the name escaped."
  (map (seq/filter names (fn (name) (string/starts-with? name (:frag p))))
    (fn (name) (str (:prefix p) (path/escape-env name)))))

(defn remote-listing-wanted? (text &optional base)
  "Whether completing path `text` needs a remote directory LISTED first: it names a directory on
another machine whose entries are not kept (`sshremote/cached-listing`). What makes the path
prompt ask off the loop (its `:async-when`) rather than on the key."
  (and (or (sshpath/remote? base) (includes? text sshpath/*prefix*))
    (let (dir (:dir (ed-split-path text base)))
      (and (sshpath/remote? dir) (nil? (sshremote/cached-listing dir))))))

(defn ed-remote-candidates-fetched (text recent n &optional base)
  "[[ed-path-candidates-top]] for `text` once its remote directory has been listed — the listing
fetched now (`sshremote/fetch-listing`). Blocks on the network: the path prompt runs it off the
loop (its `:async-source`)."
  (let (dir (:dir (ed-split-path text base)))
    (do
      (when (and (sshpath/remote? dir) (nil? (sshremote/cached-listing dir)))
        (sshremote/fetch-listing dir))
      (ed-path-candidates-top text recent n base))))

(defn- without-trailing-slash (dir)
  "`dir` without the `/` that ends it — except the root, which is only that."
  (if (and (> (count dir) 1) (string/ends-with? dir "/"))
    (string/substring dir 0 (dec (count dir)))
    dir))

(defn- ed-join (dir name)
  (cond (= dir "/") (str "/" name) (= dir ".") name else (str dir "/" name)))

(defn- ed-dir-matches (p)
  "The entries of split-path `p`'s directory whose names start with its fragment
(tolerating a non-existent directory). The shared core of path completion and the
live candidate list."
  (seq/filter (check-allow :discarded-catch (try (file/ls (:dir p)) (catch _e ())))
    (fn (nm) (string/starts-with? nm (:frag p)))))

(defn ed-complete-path (text &optional base)
  "Complete a filesystem `path` against the entries of its directory: the sole match (a
trailing `/` for a directory), else the longest common prefix; the unchanged `text` when
nothing matches. Tolerates a non-existent directory. The find-file Tab action — the same
`complete-prefix` core as project find-file, over `ed-path-candidates` (relative entries,
each already carrying the typed directory prefix and a dir's trailing `/`). A relative
`text` completes under `base` (else the working dir)."
  (complete-prefix text (ed-path-candidates text base)))

(defn- ed-cand-name (c)
  "The entry name of a path candidate for sorting — its trailing `/` (a directory marker)
dropped, so `src/` sorts as `src`."
  (if (string/ends-with? c "/") (string/substring c 0 (dec (count c))) c))

(defn ed-sort-candidates (cands recent)
  "Order find-file `cands` (full paths): the **last-used** ones first — those present in
`recent` (a list of full file paths, most-recent first), in that recency order — then the
rest **by name** (a directory's trailing `/` ignored). `recent` is empty → a pure name
sort. Directories never appear in `recent` (only opened files do), so they sort by name.
Floats through the shared `projects/float-recent` (over a name-sorted base), the same core
`M-x` and project find-file order through."
  (float-recent (seq/sort-by cands ed-cand-name) recent))

(defn path-label (path)
  "The display label for a path candidate: its last component, a directory's trailing
`/` kept — so the find-file Vertico list shows `src/` / `commands.blsp` (relative to the
folder being browsed) while the candidate's *value* stays the full path used to open it. A
candidate is in input spelling (`$` doubled, `path/escape-env`); the label is the name itself."
  (filename/unescape (if (string/ends-with? path "/")
                       (str (path/basename (string/substring path 0 (dec (count path))))
                         "/")
                       (path/basename path))))

(defn ed-path-candidates (text &optional base)
  "The directory entries that complete path `text` — each a **full path** (the typed
directory prefix + the entry name, a trailing `/` marking a directory), so the find-file
Vertico list can open the selected one directly. The live candidate list `C-x C-f` shows
as you type (shares `ed-dir-matches` with `ed-complete-path`). Each is spelled as you typed
the directory, the entry's name escaped (`path-candidate`), so putting one on the line, or
accepting it, reads back as that file. A relative `text` lists under `base`."
  (let (p (ed-split-path text base))
    (cond
      (nil? (:dir p)) ()
      ;; a remote directory completes from its kept listing, never the local disk
      (sshpath/remote? (:dir p)) (remote-candidates p (or (sshremote/cached-listing (:dir p)) []))
      else (map (ed-dir-matches p) (fn (nm) (path-candidate p nm))))))

;; ---- name completion (against a fixed candidate list) -----------------------

(defn ed-complete-name (text names)
  "Complete `text` against `names` (the sole match, else their common prefix) — the
`complete-prefix` core over the `names` that start with `text`."
  (complete-prefix text (seq/filter names (fn (nm) (string/starts-with? nm text)))))

;; ---- the live find-file list, without listing what is never shown -----------
;; `ed-path-candidates` builds EVERY entry completing the typed path — a `file/dir?` stat
;; for each — and the prompt then sorted them all to show twelve. On a directory like /tmp
;; (10k entries) that was ~200 ms a keystroke, re-done on every character typed after the
;; `/`, and a path typed in one burst could not keep up. So:
;;   - a directory's listing is read and sorted ONCE per state of the directory — memoised
;;     on its path and mtime (one `file/stat`, which an entry being added, removed or renamed
;;     changes), so typing within it never lists it again;
;;   - the entries matching the typed fragment are a contiguous run of that sorted listing,
;;     found by binary search rather than by filtering every name;
;;   - only the entries that will be SHOWN are stat'ed (`file/dir?`, for the trailing `/`).
;; The answer is the same list `(take (ed-sort-candidates (ed-path-candidates t) recent) n)`
;; gives: name order is the sort order with or without the `/`, and a recent file floats
;; exactly when it is one of the candidates.

(def- *listing-slack-ms* 1000)
;; A listing taken within this long of the directory's mtime is not trusted on the next
;; keystroke — the "racy" case git's index has: an entry added in the same clock tick as the
;; listing leaves the mtime unchanged, so the cache could never notice it. Such a directory
;; (one being written to right now) is simply listed again until it has been quiet a second.

(defn- read-listing (dir frag)
  "`dir`'s entries starting with `frag`, sorted, as a vector."
  (let (names (sort (seq/filter (check-allow :discarded-catch (try (file/ls dir) (catch _e ())))
                      (fn (nm) (string/starts-with? nm frag)))))
    (vec names)))

;; Keyed on the directory and its mtime, so an entry added, removed or renamed is a new key;
;; asked only once the directory has settled ([[current-listing]]), so a listing that could
;; miss an entry of the same clock tick is never remembered.
(defmemo settled-listing 4 (dir mtime)
  "`dir`'s whole listing, sorted, as it is at `mtime` — remembered for the last few
directories."
  (read-listing dir ""))

(defn- current-listing (dir frag)
  "`dir`'s listing — the remembered one while the directory is unchanged since it was read
(same mtime, read after it settled), else read now. Nil when `dir` does not exist.

A directory still being written to is read afresh for just the entries starting with `frag`
— sorting all of /tmp's 10k names on every keystroke to show twelve would cost more than
the listing it caches. Once it has settled the whole listing is read and remembered."
  (let (st (file/stat dir))
    (when st
      (if (> (os/now) (+ (:mtime st) *listing-slack-ms*))
        (settled-listing dir (:mtime st))
        (read-listing dir frag)))))

(sig first-at-or-after (any string int int -> int))
(defn- first-at-or-after (names frag lo hi)
  "The first index in sorted `names` (within [lo, hi)) whose name is not before `frag`."
  (if (>= lo hi)
    lo
    (let (mid (math/quot (+ lo hi) 2))
      (if (< (compare (nth names mid) frag) 0)
        (first-at-or-after names frag (inc mid) hi)
        (first-at-or-after names frag lo mid)))))

(defn- sorted-member? (names nm)
  "Is `nm` in the sorted vector `names`? A binary search — no set is kept beside the listing."
  (let (i (first-at-or-after names nm 0 (count names)))
    (and (< i (count names)) (= (nth names i) nm))))

(defn- path-candidate (p nm)
  "The candidate for entry `nm` of split-path `p`: the prefix as typed + the name in input
spelling (`path/escape-env` — a `$` in it doubled, so the line reads it back as this file),
a directory marked with `/`."
  (str (:prefix p) (path/escape-env nm) (if (file/dir? (ed-join (:dir p) nm)) "/" "")))

(defn- recent-candidate (p names r)
  "Recent path `r` (absolute) as a candidate of split-path `p` — spelled as `path-candidate`
spells it — when it is one: an entry of `p`'s directory (`names`, sorted) that starts with
the fragment, a directory exactly when `r` marks it with `/`. Nil otherwise."
  (let (under (if (= (:dir p) "/") "/" (str (:dir p) "/")))
    (when (string/starts-with? r under)
      (let (tail (string/substring r (count under) (count r))
            dir? (string/ends-with? tail "/")
            nm (if dir? (string/substring tail 0 (dec (count tail))) tail))
        (when (and (sorted-member? names nm)
                (string/starts-with? nm (:frag p))
                (= dir? (file/dir? (ed-join (:dir p) nm))))
          (path-candidate p nm))))))

(defn ed-path-candidates-top (text recent n &optional base)
  "The first `n` live find-file candidates for path `text` — the same list as
`(take (ed-sort-candidates (ed-path-candidates text) recent) n)`: the `recent` paths among
them first (most recent first), then the rest by name. Lists the directory once per change
to it and stats only the entries returned. In input spelling, like `ed-path-candidates`;
a relative `text` lists under `base`."
  (let (p (ed-split-path text base)
        remote? (sshpath/remote? (:dir p))
        listing (cond
                  (nil? (:dir p)) nil
                  remote? nil
                  else (current-listing (:dir p) (:frag p))))
    (cond
      (nil? (:dir p)) ()
      remote? (take (remote-candidates p (or (sshremote/cached-listing (:dir p)) [])) n)
      (nil? listing) ()
      else
        (let (names listing
              frag (:frag p)
              ;; the recent files among the candidates, spelled as the candidates are
              present (seq/keep recent (fn (r) (recent-candidate p names r)))
              present-set (into #{} present)
              total (count names)
              want (math/max 0 (- n (count present))))
          (letrec (walk (fn (i acc)
                          (if (or (>= (count acc) want)
                                (>= i total)
                                (not (string/starts-with? (nth names i) frag)))
                            (reverse acc)
                            (let (cand (path-candidate p (nth names i)))
                              (walk (inc i) (if (contains? present-set cand) acc (cons cand acc)))))))
            (take (append present (walk (first-at-or-after names frag 0 total) '())) n))))))
