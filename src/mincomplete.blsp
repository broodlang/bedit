(defmodule mincomplete
  "Pure completion helpers for the **minibuffer prompts** (`C-x C-f` find-file,
`C-x b` switch-buffer, `C-x p f` project find-file, `M-x`): complete a typed string
against a candidate set or the filesystem. Distinct from `complete` (the in-buffer
completion-at-point popup); these run on the prompt's text and close over the prompt's
candidate source (see the `:complete-fn`s in `commands`). Data→data and side-effect
free apart from `ed-complete-path` reading the filesystem, so they're unit-testable
without a window.")

;; ---- longest common prefix --------------------------------------------------

(defn lcp--len (a b i n)
  (if (or (>= i n) (not (= (char-at a i) (char-at b i)))) i (lcp--len a b (inc i) n)))
(defn lcp--2 (a b)
  (substring a 0 (lcp--len a b 0 (min (string-length a) (string-length b)))))
(defn lcp (strs)
  "The longest common prefix of a non-empty sequence of strings."
  (if (empty? strs) "" (fold lcp--2 (first strs) (rest strs))))

;; ---- filesystem path completion ---------------------------------------------

(defn ed--last-slash (s i)
  (cond (< i 0) -1 (= (char-at s i) "/") i else (ed--last-slash s (dec i))))

(defn ed--split-path (text)
  "Split `text` into the directory to list, the literal prefix to reattach, and
the fragment being completed. With no `/`, the directory is `.` and there's
nothing to reattach (relative to cwd)."
  (let (i (ed--last-slash text (dec (string-length text))))
    (if (< i 0)
      {:dir "." :prefix "" :frag text}
      {:dir (if (= i 0) "/" (substring text 0 i))
       :prefix (substring text 0 (inc i))
       :frag (substring text (inc i) (string-length text))})))

(defn ed--join (dir name)
  (cond (= dir "/") (str "/" name) (= dir ".") name else (str dir "/" name)))

(defn ed--dir-matches (p)
  "The entries of split-path `p`'s directory whose names start with its fragment
(tolerating a non-existent directory). The shared core of path completion and the
live candidate list."
  (filter (fn (nm) (starts-with? nm (get p :frag)))
    (try (list-dir (get p :dir)) (catch e ()))))

(defn ed-complete-path (text)
  "Complete a filesystem `path` against the entries of its directory: the sole
match (a trailing `/` for a directory), else the longest common prefix; the
unchanged `text` when nothing matches. Tolerates a non-existent directory."
  (let (p (ed--split-path text)
        matches (ed--dir-matches p))
    (cond
      (empty? matches) text
      (= (count matches) 1) (let (full (str (get p :prefix) (first matches)))
                              (if (dir? (ed--join (get p :dir) (first matches)))
                                (str full "/")
                                full))
      else (str (get p :prefix) (lcp matches)))))

(defn ed-path-candidates (text)
  "The directory-entry names that complete path `text` — each bare name, with a
trailing `/` marking a directory. The live candidate list `C-x C-f` shows as you
type (shares `ed--dir-matches` with `ed-complete-path`)."
  (let (p (ed--split-path text))
    (map (fn (nm) (if (dir? (ed--join (get p :dir) nm)) (str nm "/") nm))
      (ed--dir-matches p))))

;; ---- name completion (against a fixed candidate list) -----------------------

(defn ed-complete-name (text names)
  "Complete `text` against `names` (the sole match, else their common prefix)."
  (let (matches (filter (fn (nm) (starts-with? nm text)) names))
    (cond
      (empty? matches) text
      (= (count matches) 1) (first matches)
      else (lcp matches))))
