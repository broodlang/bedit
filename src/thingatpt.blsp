(defmodule thingatpt
  "What a line of text names at a column (Emacs's thingatpt, for what it reads): the token
around the column, a URL in it, a file it names that exists. Pure over a line and a directory,
so C-. (embark) and C-x C-f's M-n (find-file's default) read the same thing at point.")

(def- token-delimiters #{" " "\t" "\n" "\"" "'" "`" "(" ")" "[" "]" "{" "}" "<" ">" ","})

;; sentence punctuation, and the closers a URL is wrapped in (`<…>`, `[…]`, quotes) — not `)`,
;; which ends real URLs (Wikipedia's `…_(disambiguation)`)
(def- trailing-punctuation #{"." "," ";" ":" "!" "?" ">" "]" "\"" "'"})

(sig token-start (string int -> int))
(defn- token-start (line index)
  "Where the run of non-delimiter characters ending before `index` in `line` begins."
  (if (or (<= index 0) (contains? token-delimiters (string/char-at line (dec index))))
    index
    (token-start line (dec index))))

(sig token-end (string int int -> int))
(defn- token-end (line index size)
  "Where the run of non-delimiter characters starting at `index` in `line` ends."
  (if (or (>= index size) (contains? token-delimiters (string/char-at line index)))
    index
    (token-end line (inc index) size)))

(defn- without-trailing-punctuation (text)
  "`text` with the sentence punctuation a URL or path in prose is followed by dropped."
  (if (and (> (string/length text) 0)
        (contains? trailing-punctuation (string/char-at text (dec (string/length text)))))
    (without-trailing-punctuation (string/substring text 0 (dec (string/length text))))
    text))

(sig token-at (string int -> (or string nil)))
(defn token-at (line column)
  "The whitespace- and bracket-delimited run of `line` that `column` is in (or just after),
trailing punctuation dropped — the text a URL or a path at point is read from. Nil on a
delimiter.

    (thingatpt/token-at \"see (src/x.blsp:12), then\" 8)   ;=> \"src/x.blsp:12\""
  (let (size (string/length line)
        at (math/max 0 (math/min column size))
        text (without-trailing-punctuation (string/substring line
                                             (token-start line at)
                                             (token-end line at size))))
    (if (= text "") nil text)))

(defn url-in (text)
  "The URL `text` holds — from its `http://` / `https://` / `file://` scheme on — or nil.

    (thingatpt/url-in \"<https://brood.dev/docs>.\")   ;=> \"https://brood.dev/docs\""
  (let (starts (seq/reject (map ["https://" "http://" "file://"]
                             (fn (scheme) (index-of text scheme)))
                 (fn (index) (< index 0))))
    (when (not (empty? starts))
      (let (url (without-trailing-punctuation (string/substring text
                                                (reduce starts math/min)
                                                (string/length text))))
        (when (> (string/length url) 8) url)))))

(defn- without-location (text)
  "`text` without a compiler-style `:line` / `:line:col` suffix — `src/x.blsp:12:3` names
the file `src/x.blsp`."
  (let (cut (string/last-index-of text ":"))
    (if (and (> cut 0)
          (int? (string/->number (string/substring text (inc cut) (string/length text)))))
      (without-location (string/substring text 0 cut))
      text)))

(defn existing-file (text dir)
  "The absolute path `text` names when it is a file or directory that EXISTS — read
against `dir` when relative, `~` expanded, a `:line:col` suffix dropped — else nil. A
bare word is never a path: it has to hold a `/`, a `.` or start with `~`, so a symbol
that happens to name a file in the directory stays a symbol."
  (let (candidate (without-location text))
    (when (and (> (string/length candidate) 0)
            (or (includes? candidate "/")
              (includes? candidate ".")
              (string/starts-with? candidate "~")))
      (let (path (path/normalize (path/absolute candidate dir)))
        (when (file/exists? path) path)))))

(defn file-at (line column dir)
  "The existing file `line` names at `column` ([[existing-file]] of the [[token-at]] there, read
against `dir`), or nil — nor for a URL, which names no file here.

    (thingatpt/file-at \"see https://x.org/a.txt\" 6 \"/\")   ;=> nil"
  (when-let (token (token-at line column))
    (when (nil? (url-in token)) (existing-file token dir))))
