(defmodule interactive
  "The interactive-command mechanism, à la Emacs. `defcommand` defines an editor command — a
`(model key) -> model` function — and **registers it as interactive**, so it can be run by
name with `M-x` (`commands/cmd-execute-extended-command`). The `:interactive/commands`
registry maps a command's name (its function name minus a leading `cmd-`, e.g.
`cmd-kill-line` → `\"kill-line\"`) to the function.

Keymaps bind commands by *symbol* (late-bound) independently; this is the by-name path.
Beside it, what the dispatcher reads of a command it does not name: the prefix argument,
a command's negative-direction inverse, and its declared traits.

    (defcommand cmd-newline (m key) (ed-edit m (fn (b) (insert b \"\\n\"))))
    ;; now `M-x newline` runs it, and (command-names) lists it.")

;; ---- the M-x registry ------------------------------------------------------------
;; REGISTRIES every module `defcommand`s into at load, accumulating across the session — so
;; `std/registry` tables (brood ADR-412), not globals: loading a project can re-run this file
;; after other modules have registered, and a plain `def` here would reset the table and drop
;; every command registered before that moment.
;;
;; :interactive/commands      name (string) -> command fn
;; :interactive/command-syms  name (string) -> command symbol (for describe-function doc lookup)

(defn command-friendly-name (s)
  "A command's M-x name: its function name minus a leading `cmd-`."
  (if (string/starts-with? s "cmd-") (string/substring s 4 (count s)) s))

(defn register-command (sym fn)
  "Register `fn` as the interactive command named after `sym` (minus `cmd-`), keeping the
symbol too — QUALIFIED to the module registering it (`bedit/commands/cmd-find-file`), so
`describe-function`'s docstring, the M-x marginalia's declared contract and the key lookup
all find it whatever module defined the command. Re-registering replaces the entry."
  (let (nm (command-friendly-name (->string sym))
        ns (reflect/current-ns)
        qualified (if (or (nil? ns) (includes? (->string sym) "/"))
                    sym
                    (symbol (str ns "/" (->string sym)))))
    ;; claimed (`ownership`), so a package's commands leave M-x when it is removed or
    ;; updated past them — and a core command it replaced comes back
    (ownership/claim! :interactive/command-syms nm qualified)
    (ownership/claim! :interactive/commands nm fn)))

;; ---- deferred commands: named by a keymap, not yet loaded ---------------------
;; `defcommand` registers at MODULE LOAD, so a deferred feature's commands would not exist
;; for `M-x` until something else had loaded it. A keymap names its commands by SYMBOL,
;; late-bound, precisely so it can name a command whose module is not loaded — so the
;; keymaps hold the full list, and `keymaps` declares them here at startup
;; (`editor/keymap/keymap-commands`). A deferred entry is a name plus the symbol to load;
;; running it loads the module and then dispatches to the real registration.
;;
;; :interactive/deferred  name (string) -> command symbol, module not yet loaded

(defn- command-tail (sym)
  ;; the last segment of a possibly-qualified symbol: `playground/cmd-x` -> `cmd-x`
  (last (string/split (->string sym) "/")))

(defn command-module (sym)
  "The module a qualified command symbol lives in — everything before its last segment —
or nil for an unqualified one: what to `require-one` before calling a command whose module
may not have loaded.

    (interactive/command-module 'playground/cmd-x)   ;=> \"playground\""
  (ownership/symbol-namespace sym))

(defn register-deferred (sym)
  "Declare that `sym` names an interactive command whose module may not be loaded yet, so
`M-x` can offer it and load it on demand. A name already registered for real wins."
  (let (nm (command-friendly-name (command-tail sym)))
    (when (nil? (registry/lookup :interactive/commands nm))
      (ownership/claim! :interactive/deferred nm sym))
    nm))

(defn command-sym (nm)
  "The fully-qualified symbol of the interactive command named `nm`, or nil — including one
that is only declared (its module unloaded), so `describe-function` can find its docstring."
  (or (registry/lookup :interactive/command-syms nm) (registry/lookup :interactive/deferred nm)))

;; Memoised on the two registries' CONTENTS (`defmemo` compares with `=`, which is immediate
;; for the same map). M-x asks for this on every open, and merging, deduplicating and
;; sorting ~600 names was ~2 ms of each one while nothing had been registered since.
;; Registering or declaring a command makes a new map, so the next call misses and the list
;; is always the registries' current one.
(memo/defmemo sorted-command-names
  1
  (registered deferred)
  "The sorted, distinct names of the `registered` and `deferred` command registries."
  (sort (seq/distinct (append (keys registered) (keys deferred)))))

(defn command-names ()
  "All interactive command names, sorted — registered and declared-but-unloaded alike."
  (sorted-command-names (registry/entries :interactive/commands)
    (registry/entries :interactive/deferred)))

;; ---- the prefix argument (C-u N) -------------------------------------------
;; The numeric prefix a `C-u`/digit sequence builds lives on the model as
;; `:prefix-arg {:count N :raw bool}` (the dispatcher in `input` accumulates it).
;; `current-prefix-arg` is the clean read for commands — they never poke the model
;; field. By default the dispatcher *repeats* a command `:count` times; a command that
;; interprets the arg ITSELF (run once) registers via `register-prefix-consuming`,
;; declared next to the command rather than hardcoded in the dispatch loop.
;;
;; :interactive/prefix-consuming  command symbol -> true: reads the arg itself, runs once

;; check-allow: `:prefix-arg` is only ever built with an int `:count` (`input`, C-u, M--)
(check-allow :trusted
  (sig current-prefix-arg (any -> (or int nil)))
  (defn current-prefix-arg (m)
    "The numeric prefix argument a C-u/digit sequence built (Emacs `current-prefix-arg`),
or nil when none is active. `(or (current-prefix-arg m) 1)` is the repeat count; a
command branching on mere presence tests this for nil."
    (let (pa (:prefix-arg m)) (when pa (:count pa)))))

(defn register-prefix-consuming (sym)
  "Mark command `sym` as consuming the prefix argument itself — the dispatcher runs it
once (it reads `current-prefix-arg`) instead of repeating it N times."
  (ownership/claim! :interactive/prefix-consuming sym true))

(defn prefix-consuming? (sym)
  "Whether command `sym` consumes the prefix argument itself (vs. the repeat default)."
  (= true (registry/lookup :interactive/prefix-consuming sym)))

;; ---- command inverses (the negative-argument direction, Emacs M-- / C--) ----
;; A command and its opposite-direction twin register as inverses; when the numeric
;; prefix argument is NEGATIVE the dispatcher runs the inverse |N| times instead of the
;; command (so `C-- C-f` goes backward, `M-- 2 M-d` kills two words back). Direction
;; lives in the pairing, so individual commands need no sign handling.
;;
;; :interactive/inverses  command symbol -> its opposite-direction command symbol

(defn register-inverse (a b)
  "Register commands `a` and `b` as each other's inverse — the direction a negative
prefix argument flips to. Bidirectional."
  (do (ownership/claim! :interactive/inverses a b) (ownership/claim! :interactive/inverses b a)))

(defn command-inverse (sym)
  "The command registered as `sym`'s inverse (its negative-argument direction), or nil."
  (registry/lookup :interactive/inverses sym))

;; ---- command traits ---------------------------------------------------------------
;; What the rest of the editor must know about a command it does not name: that it types,
;; that it kills, that a guest may run it. Declared by the command's symbol, the one a keymap
;; holds, beside the command, so the core keeps no table of commands that a move leaves stale.
;;
;; :interactive/traits  [trait command symbol] -> true

(defn declare-trait (trait commands)
  "Give every command symbol in `commands` the `trait`."
  (doseq (command commands)
    (ownership/claim! :interactive/traits [trait command] true)))

(defn command-trait? (command trait)
  "Whether `command`, as a keymap names it, was declared to have `trait`."
  (= true (registry/lookup :interactive/traits [trait command])))

;; :interactive/repeat-maps  command symbol -> {key command symbol}
;; Emacs's `repeat-map` property: after one of the commands runs, a key of its map runs that
;; key's command, again and again, until any other key (`input`'s repeat overlay). The plain
;; `:repeat` trait is the one-key case: the key that ran the command, again.

(defn declare-repeat-map (repeat-keys commands)
  "Give every command symbol in `commands` the repeat map `repeat-keys`, `{key -> command
symbol}` (Emacs's `repeat-map`): after one of them runs, each key of the map runs its command."
  (doseq (command commands)
    (ownership/claim! :interactive/repeat-maps command repeat-keys)))

(defn command-repeat-map (command)
  "The repeat map `command` was declared with ([[declare-repeat-map]]), or nil."
  (registry/lookup :interactive/repeat-maps command))

(defn run-command (m nm fallback)
  "Run the interactive command named `nm` on model `m` (key = nil), or call
`(fallback m nm)` when there is no such command.

A name that is only DECLARED ([[register-deferred]]) loads its module first and then runs
the registration that appears — so a deferred feature is reachable by name on the first
call, without every such module being loaded at startup to make `M-x` honest."
  (let (f (registry/lookup :interactive/commands nm))
    (cond
      ;; a package's command runs under its package's claimant: what it registers goes
      ;; back with the package
      f
        (ownership/with-symbol-claimant (registry/lookup :interactive/command-syms nm)
          (fn () (f m nil)))
      else
      ;; a deferred one: its module — everything before the symbol's last segment — loaded
      ;; first
        (let (sym (registry/lookup :interactive/deferred nm)
              module (when sym (command-module sym)))
          (if (nil? module)
            (fallback m nm)
            (let (_ (try
                      (require-one (symbol module))
                      (catch e
                        (log/warn (str "could not load " module " for " nm ": " (error-message e)))))
                  loaded (registry/lookup :interactive/commands nm))
              (if loaded
                (ownership/with-symbol-claimant sym (fn () (loaded m nil)))
                (fallback m nm))))))))

(defmacro defcommand (cmd params & body)
  "Like `defn` for an editor command `(model key) -> model`, but also registers it
as **interactive** (runnable by `M-x`). The M-x name is the function name minus a
leading `cmd-`."
  ;; The contract, declared once for every command: `model -> model` (the key is whatever
  ;; the keymap hands over). `model` is bedit/model's `deftype`; the checker reads the
  ;; body against it, so a command that hands back something narrower is reported HERE,
  ;; at its definition, not at the next command that consumes its result.
  `(do
     (sig ~cmd (model any -> model))
     (defn ~cmd ~params ~@body)
     (interactive/register-command '~cmd ~cmd)))
