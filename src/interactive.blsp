(defmodule interactive
  "The interactive-command mechanism, à la Emacs. `defcommand` defines an editor
command — a
`(model key) -> model` function — and **registers it as interactive**, so it can be
run by name with `M-x` (see `commands/cmd-execute-extended-command`). The registry
`*commands*` maps a command's name (its function name minus a leading `cmd-`, e.g.
`cmd-kill-line` → `\"kill-line\"`) to the function.

Keymaps still bind commands by *symbol* (late-bound) independently; this is the
by-name path. Marking a function interactive is the one extra thing `defcommand`
does over `defn` — exactly the role Emacs's `(interactive)` plays.

    (defcommand cmd-newline (m key) (ed-edit m (fn (b) (insert b \"\\n\"))))
    ;; now `M-x newline` runs it, and (command-names) lists it.")

;; These are REGISTRIES: every module `defcommand`s into them at load, and they must
;; accumulate across the whole session — so `defonce`, not `def`. Loading a project re-runs
;; this file after other modules have already registered (a `require` cycle reached from two
;; directions; the loader says so: "macro defcommand redefined"), and a plain `def` here reset
;; the table to `{}` — silently dropping every command registered before that moment.
;;
;; What that looked like: `M-x package-list` and `M-x brood-playground` answered "no command"
;; while `M-x git-status` worked, and which ones survived depended only on whether their
;; module happened to load before or after the reload. The same hazard `editor/layers`
;; documents for its own three registries, in the same shape, with the same fix.
(defonce *commands* {}) ; name (string) -> command fn
(defonce *command-syms* {}) ; name (string) -> command symbol (for describe-function doc lookup)
(defn command-friendly-name (s)
  "A command's M-x name: its function name minus a leading `cmd-`."
  (if (string/starts-with? s "cmd-") (string/substring s 4 (string/length s)) s))

(defn register-command (sym fn)
  "Register `fn` as the interactive command named after `sym` (minus `cmd-`), keeping the
symbol too (for `describe-function`'s docstring lookup). Re-registering replaces the entry."
  (let (nm (command-friendly-name (->string sym)))
    (def *command-syms* (assoc *command-syms* nm sym))
    (def *commands* (assoc *commands* nm fn))))

;; ---- deferred commands: named by a keymap, not yet loaded ---------------------
;; `defcommand` registers at MODULE LOAD, so a deferred feature's commands did not exist for
;; `M-x` until something else had already loaded it — and what loaded the ones that worked
;; was incidental (a qualified reference from an eager module). `M-x package-list` and
;; `M-x brood-playground` therefore answered "no command", while `M-x git-status` worked,
;; for no reason a reader could see.
;;
;; A keymap names its commands by SYMBOL, late-bound, precisely so it can name a command
;; whose module is not loaded. So the keymaps already hold the full list — `keymaps`
;; harvests them at startup (`editor/keymap/keymap-commands`) and declares them here. A
;; deferred entry is a name plus the symbol to load; running it loads the module and then
;; dispatches to the real registration.
(defonce *deferred* {}) ; name (string) -> command symbol, module not yet loaded
(defn- command-tail (sym)
  ;; the last segment of a possibly-qualified symbol: `playground/cmd-x` -> `cmd-x`
  (last (string/split (->string sym) "/")))

(defn- command-module (sym)
  ;; everything before the last segment: `playground/cmd-x` -> `playground`, nil if unqualified
  (let (parts (string/split (->string sym) "/"))
    (if (< (count parts) 2) nil (string/join (take parts (dec (count parts))) "/"))))

(defn register-deferred (sym)
  "Declare that `sym` names an interactive command whose module may not be loaded yet, so
`M-x` can offer it and load it on demand. A name already registered for real wins."
  (let (nm (command-friendly-name (command-tail sym)))
    (when (nil? (get *commands* nm)) (def *deferred* (assoc *deferred* nm sym)))
    nm))

(defn command-sym (nm)
  "The fully-qualified symbol of the interactive command named `nm`, or nil — including one
that is only declared (its module unloaded), so `describe-function` can find its docstring."
  (or (get *command-syms* nm) (get *deferred* nm)))

(defn command-names ()
  "All interactive command names, sorted — registered and declared-but-unloaded alike."
  (sort (seq/distinct (append (keys *commands*) (keys *deferred*)))))

;; ---- the prefix argument (C-u N) -------------------------------------------
;; The numeric prefix a `C-u`/digit sequence builds lives on the model as
;; `:prefix-arg {:count N :raw bool}` (the dispatcher in `input` accumulates it).
;; `current-prefix-arg` is the clean read for commands — they never poke the model
;; field. By default the dispatcher *repeats* a command `:count` times; a command that
;; interprets the arg ITSELF (run once) registers via `register-prefix-consuming`,
;; declared next to the command rather than hardcoded in the dispatch loop. (The fuller
;; Emacs model — every command an interactive arg spec — can grow from this seam.)

(def *prefix-consuming* {}) ; command symbol -> true: reads the arg itself, runs once
(defn current-prefix-arg (m)
  "The numeric prefix argument a C-u/digit sequence built (Emacs `current-prefix-arg`),
or nil when none is active. `(or (current-prefix-arg m) 1)` is the repeat count; a
command branching on mere presence tests this for nil."
  (let (pa (:prefix-arg m)) (when pa (:count pa))))

(defn register-prefix-consuming (sym)
  "Mark command `sym` as consuming the prefix argument itself — the dispatcher runs it
once (it reads `current-prefix-arg`) instead of repeating it N times."
  (def *prefix-consuming* (assoc *prefix-consuming* sym true)))

(defn prefix-consuming? (sym)
  "Whether command `sym` consumes the prefix argument itself (vs. the repeat default)."
  (contains? *prefix-consuming* sym))

;; ---- command inverses (the negative-argument direction, Emacs M-- / C--) ----
;; A command and its opposite-direction twin register as inverses; when the numeric
;; prefix argument is NEGATIVE the dispatcher runs the inverse |N| times instead of the
;; command (so `C-- C-f` goes backward, `M-- 2 M-d` kills two words back). Direction
;; lives in the pairing, so individual commands need no sign handling.

(def *command-inverse* {}) ; command symbol -> its opposite-direction command symbol
(defn register-inverse (a b)
  "Register commands `a` and `b` as each other's inverse — the direction a negative
prefix argument flips to. Bidirectional."
  (def *command-inverse* (assoc (assoc *command-inverse* a b) b a)))

(defn command-inverse (sym)
  "The command registered as `sym`'s inverse (its negative-argument direction), or nil."
  (get *command-inverse* sym))

(defn run-command (m nm fallback)
  "Run the interactive command named `nm` on model `m` (key = nil), or call
`(fallback m nm)` when there is no such command.

A name that is only DECLARED ([[register-deferred]]) loads its module first and then runs
the registration that appears — so a deferred feature is reachable by name on the first
call, without every such module being loaded at startup to make `M-x` honest."
  (let (f (get *commands* nm))
    (cond
      f (f m nil)
      else
        (let (sym (get *deferred* nm)
              mod (when sym (command-module sym)))
          (if (nil? mod)
            (fallback m nm)
            (let (_ (try
                      (require-one (symbol mod))
                      (catch e
                        (log/warn (str "could not load " mod " for " nm ": " (error-message e)))))
                  loaded (get *commands* nm))
              (if loaded (loaded m nil) (fallback m nm))))))))

(defmacro defcommand (cmd params & body)
  "Like `defn` for an editor command `(model key) -> model`, but also registers it
as **interactive** (runnable by `M-x`). The M-x name is the function name minus a
leading `cmd-`."
  `(do
     (defn ~cmd ~params ~@body)
     (interactive/register-command '~cmd ~cmd)))
