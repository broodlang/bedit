(defmodule lsp-commands
  "The editor's side of a language server: jump to a definition and back, find references,
imenu, hover, signature help, code actions, rename, format — and the event folds that turn
the server's replies, notices, diagnostics and edits into the model. The connection itself
(the process, JSON-RPC, what to ask) is `lsp`; the request vocabulary both sides share is
`lsp-requests`, whose `LspRequest` fold impls live here.

Split out of `commands.blsp` (issues.md X1)."
  (:use model) ; message / ed-current-buf / ed-set-buf / the diagnostics cache
  (:use pool) ; ed-find-file / ed-select / ed-name-prompt — the prompts and jumps a lookup ends in
  (:use editor/buffer) ; points, lines and the edits a server's answer applies
  (:use interactive) ; defcommand — the LSP commands, on M-x
  (:use lsp-requests) ; the request-kind records + the LspRequest ability folded here
  (:use projects)) ; project-root — a server starts IN the project root
;; ---- imenu: jump to a symbol in the buffer via LSP documentSymbol (M-g i) ----

(defn- ed-lsp-ensure (m)
  "Ensure a language server is connected for the current buffer's file. Returns
`[m2 ready?]`: `ready?` is true when a LIVE connection is already on the model; false when
a server was just started (the caller should ask the user to retry once it initialises) or
there is nothing to start — no file, no server configured, the server not installed — with
an explanatory message already on `m2` (`ed-lsp-start` writes it)."
  (if (ed-lsp-live m)
    [m true]
    (let ([m2 conn] (ed-lsp-start (ed-lsp-drop-dead m)))
      (cond
        (nil? conn) [m2 false]
        ;; handed to a server already running for another project: it is ready now
        (not (empty? (map/get-in m2 [:lsp-servers conn :caps] {}))) [m2 true]
        ;; started, but the handshake has not finished: say so in the voice of the
        ;; feature that asked rather than reporting a connection it cannot use yet
        :else
          [(message m2
             (str "lsp: starting "
               (map/get-in m2 [:lsp-servers conn :command])
               " — run that again in a moment"))
            false]))))

(defn- ed-imenu-label (s)
  "The imenu candidate text for a symbol `{:name :kind …}` — its (qualified) name with a
short kind tag, e.g. `Foo.bar  (method)`."
  (str (:name s) "  (" (lsp/lsp-symbol-kind-name (:kind s)) ")"))

(defn- ed-imenu-find (labeled t)
  "The symbol whose label is `t` in the `[label sym]` pairs `labeled`, or nil."
  (let (hit (seq/find labeled (fn (p) (= (first p) t))))
    (when hit (second hit))))

(defn- ed-imenu-jump (m s)
  "Move point to symbol `s`'s position in the current buffer."
  (ed-apply m (fn (b) (ed-goto-line-col b (:line s) (:char s)))))

(defn- ed-imenu-prompt (m syms)
  "A Vertico minibuffer over the buffer's symbols `syms` (`{:name :kind :line :char}`).
Moving the selection **previews** — point jumps to that symbol live (`:on-preview`);
accepting keeps it; cancelling restores the point and scroll the prompt opened from
(`:on-abort`), so an aborted imenu leaves you exactly where you were."
  (let (labeled (map syms (fn (s) [(ed-imenu-label s) s]))
        labels (map labeled first)
        origin {:point (buffer-point (ed-current-buf m))
                :top (ed-current-top m)
                :top-row (ed-current-top-row m)})
    (assoc m
      :minibuffer
        (assoc (ed-name-prompt "Imenu: "
                 labels
                 (fn (mm t)
                   (let (s (ed-imenu-find labeled t))
                     (if (nil? s)
                       (message mm (str "imenu: no such symbol: " t))
                       (ed-imenu-jump mm s)))))
          :on-preview
            (fn (mm t)
              (let (s (ed-imenu-find labeled t))
                (if (nil? s) mm (ed-imenu-jump mm s))))
          :on-abort
            (fn (mm)
              (ed-set-start (ed-apply mm (fn (b) (goto-char b (:point origin))))
                (:top origin)
                (:top-row origin)))))))

(defcommand cmd-imenu
  (m key)
  "Jump to a symbol in the current buffer, picked from the language server's
`documentSymbol` list (M-g i). Starts the server on first use if one is configured for the
file type; symbols are nested-name-qualified (Emacs-style `Class.method`). Async — the
picker opens when the symbol list arrives."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (buf (ed-current-buf m2)
            file (buffer-file buf)
            conn (:conn (ed-lsp-for m2 :documentSymbolProvider)))
        (ed-lsp-ask-server m2
          conn
          (lsp-symbols)
          {:uri (lsp/lsp-path->uri file) :lang (lsp/lsp-language-id file)}
          nil
          "imenu: fetching symbols…")))))

;; ---- LSP navigation + edits: goto-def / back / references / hover / rename / format ----
;; All ASYNC (§E.2 — services never block the loop): a command registers a pending lookup
;; under a fresh corr (`ed-lsp-ask` → `:lsp-pending`) and fires the request; the conn's
;; tagged reply lands on the loop as an event (`ed-ev-lsp-reply`, registered in input.blsp)
;; and folds by corr — jump/show/apply happen when the answer ARRIVES, the echo says what's
;; in flight meanwhile, and C-g clears the table (a late reply drops as stale). Mutating
;; replies (format, rename) carry a rope guard: if the buffer changed while the server
;; worked, the edits are dropped with a message instead of applied against the wrong text.
;; `ed-lsp-here` packages the current buffer's (conn, uri, lang, line, char);
;; `ed-lsp-ensure` auto-starts the server on first use. Cross-file jumps open the target
;; with `ed-find-file` and push a marker (`:lsp-markers`) so M-, returns.

(defn- ed-lsp-ask (m kind fire &optional extra note)
  "Register a pending LSP lookup of `kind` (an `LspRequest` record, see `lsp-requests`)
under a fresh corr and `fire` it (a `(corr) -> nil` sender — in practice
[[ed-lsp-ask-server]]'s `lsp/lsp-ask-async`, with `(self)` as reply-to). `extra` merges context the fold will need onto the record
(a rope guard, the rename's origin); `note` is the in-flight echo — `:quiet` for a lookup
the reader did not ask for (the idle beat's signature help), which must not narrate itself
into the echo area every time point moves."
  (let (corr (ref))
    (fire corr)
    (let (m2 (assoc m :lsp-pending (assoc (:lsp-pending m {}) corr (merge kind (or extra {})))))
      (if (= note :quiet) m2 (message m2 (or note "lsp: resolving…"))))))

(defn- ed-lsp-ask-server (m conn kind request &optional extra note)
  "[[ed-lsp-ask]] with the sender every lookup uses: `kind` built from `request` and sent
to `conn` (`lsp/lsp-ask-async`), the reply coming back to this loop. `request` is
`{:uri :lang :line :char …}` — [[ed-lsp-here]]'s map serves as it is.

A request about the document (one with a `:uri`) syncs it first ([[ed-lsp-push-text]]):
the server must answer about the text on screen, and pushing it here — as the edits since
the last push, recorded on the model — is what lets the request itself carry no text.

The pending lookup remembers `conn`, so a server that dies takes its unanswered lookups with
it ([[ed-lsp-server-down]]) instead of leaving them until C-g. It remembers the `request`
and the text it was about too, so a server merged into another hands its lookups over
([[ed-lsp-reroute-pending]]) rather than dropping them."
  (let (about? (contains? request :uri)
        m (if about? (ed-lsp-push-text m) m)
        buf (ed-current-buf m))
    (ed-lsp-ask m
      kind
      (fn (corr) (lsp/lsp-ask-async conn kind corr (self) request))
      (merge (or extra {})
        {:conn conn
         ;; the bare kind and request, as sent: the lookup itself holds a rope, which no
         ;; message can carry
         :request-kind kind
         :request request
         :about (when about? [(buffer-file buf) (buffer-rope buf)])})
      note)))

(defn ed-ev-lsp-reply (m input textrows cols rows)
  "An LSP reply landing on the loop (`[:lsp-definition corr locs]`, `[:lsp-hover corr
s]`, …): fold its payload by corr against `:lsp-pending`; an unknown corr is a
stale/cancelled lookup (C-g, or a completion's bounded wait that already timed out)
and drops silently."
  (let (corr (nth input 1)
        pend (map/get-in m [:lsp-pending corr]))
    (if (nil? pend)
      m
      (lsp-request-fold pend
        (assoc m :lsp-pending (dissoc (:lsp-pending m) corr))
        (nth input 2)))))

(def *lsp-log-buffer*
  ;; where everything a language server says is kept, whole — lsp-mode's `*lsp-log*`,
  ;; eglot's events buffer. Never echoed by itself.
  "*lsp-log*")

(def *lsp-log-limit*
  ;; chars `*lsp-log*` keeps: Expert's Logger writes a line per file its indexer
  ;; touches, so a long session would otherwise grow the buffer without end
  2000000)

(defn- ed-lsp-echo (m notice)
  "Show one server `notice` the reader is meant to see ([[ed-ev-lsp-notices]]), unless it is
the line already on the echo area: a `showMessage` also goes to `*Messages*`, the way
Emacs's do; progress is transient — the echo area, not a `*Messages*` line per report."
  (let (echo (str "lsp: " (:line notice)))
    (cond
      ;; the same line again (a server repeating itself, a progress report that did not
      ;; change) — it is already in front of the reader
      (= (:echo m) echo) m
      (= (:channel notice) :show) (message m echo)
      :else (assoc m :echo echo))))

(defn ed-ev-lsp-notices (m input textrows cols rows)
  "What a language server SAID since its connection last flushed (`[:lsp-notices notices]`,
`lsp/lsp-notice` maps, oldest first): all of it appended, whole, to `*lsp-log*` in ONE
append; echoed only where `lsp/lsp-notice-echo?` says the reader is meant to see it —
progress, and a `showMessage`.

A batch, not a notice per event: Expert's indexer logs a line per file it touches, and
when each was its own event the loop ran a full turn per line — hundreds a second, with
the keys and clicks queued behind them, so the editor froze until indexing finished.

The log is never echoed. It once was, so Expert's startup could be watched, and that
also echoed its whole Logger: every `Could not expand alias: {:%, [line: 36, …` its
indexer hit, replacing whatever the reader was looking at, in whatever buffer. The startup
still shows — it arrives as progress (`window.workDoneProgress`)."
  (let (notices (nth input 1)
        logged (ed-append-named m
                 *lsp-log-buffer*
                 (string/join (map notices lsp/lsp-notice-log-line) "\n")
                 *lsp-log-limit*))
    (fold (seq/filter notices lsp/lsp-notice-echo?) logged ed-lsp-echo)))

(defn ed-lsp-merged-diags (m path)
  "Every diagnostic the servers published for `path`, in bedit's shape, one list: the
file's own servers in their order (main first), then any other publication kept for it."
  (let (published (map/get-in m [:lsp-diags path] {})
        ordered (map (lsp/lsp-server-entries m path) (fn (entry) (:key entry)))
        keys-in-order (append (seq/filter ordered (fn (key) (contains? published key)))
                        (seq/reject (keys published) (fn (key) (includes? ordered key)))))
    (fold keys-in-order [] (fn (merged key) (into merged (first (get published key)))))))

(defn ed-lsp-raw-diags (m path key)
  "The raw LSP diagnostics the server under `key` published for `path` — what a code
action request about them hands back."
  (second (map/get-in m [:lsp-diags path key] [[] []])))

(defn ed-lsp-show-diags (m path)
  "Show what the servers published for `path` ([[ed-lsp-merged-diags]]) on its buffer: the
full fold when it is the one on screen (the model's cache, which is about the buffer you are
looking at, and the line index), its margin marks when it is open elsewhere, nothing when it
is not open."
  (let (items (ed-lsp-merged-diags m path)
        buf (ed-current-buf m)
        idx (ed-buffer-index-by-file m path))
    (cond
      ;; `buffer-file` is `nil | string` — a scratch buffer has none, and nil never matches
      (= (buffer-file buf) path) (ed-set-diagnostics m items (buffer-rope buf))
      ;; a file that is OPEN but not in front of you still gets its margin marks. This arm
      ;; did not exist, and its absence is why a stale diagnostic could not clear: a server
      ;; retracts by publishing an empty list, and that retraction is overwhelmingly likely to
      ;; arrive after you have moved on from the edit that caused it.
      (not (nil? idx)) (ed-stamp-diagnostics-at m idx items)
      :else m)))

(defn ed-ev-lsp-diagnostics (m input textrows cols rows)
  "A language server publishing a file's diagnostics (`[:lsp-diagnostics path items raw conn]`)
— shown on that buffer, merged with what the file's other servers published (a main server
and an add-on both report on one file, and each publication replaces only its own).

This is what makes an LSP worth connecting for. bedit already renders diagnostics — the
underline on the token, the ⚠ note at the end of the line, the gutter mark — and until now
the only thing that ever produced them was the Brood checker, so every other language had
the whole apparatus and nothing to put in it.

An empty list is applied like any other: it is how a server says the file is clean now, and
ignoring it would leave the errors you just fixed sitting there.

Kept per file and server on `:lsp-diags` — `{path {conn [items raw]}}`, the raw objects
beside the rendered ones ([[ed-lsp-raw-diags]]): a quickfix is asked for by handing the
diagnostic back (see [[cmd-lsp-code-action]]), and bedit's flattened shape is not a thing a
server recognises. Kept only for a file that is OPEN: rust-analyzer publishes about its
whole workspace, and a server publishes again for a file when it is opened. Dropped from a
server no longer filed: a publication already queued when it was disconnected would
otherwise stay merged in for the rest of the session, with nothing able to replace it."
  (let (path (nth input 1)
        conn (nth input 4 nil)
        open? (not (nil? (ed-buffer-index-by-file m path))))
    (if (or (not open?) (and conn (not (contains? (or (:lsp-servers m) {}) conn))))
      m
      (ed-lsp-show-diags (map/assoc-in m [:lsp-diags path conn] [(nth input 2) (nth input 3 [])])
        path))))

(defn ed-ev-lsp-capabilities (m input textrows cols rows)
  "A connected server reporting what it can do (`[:lsp-capabilities caps conn]`), kept on
its own entry in `:lsp-servers` — the one whose connection `conn` sent it. A server that is
no longer filed (disconnected meanwhile) has nowhere to keep them, and they are dropped.

Worth keeping for one reason: it is the difference between \"this server does not offer
that\" and a command that appears to do nothing. Expert advertises code actions, hover,
definition and references and does NOT advertise signature help — so the argument hints
are silent in Elixir and loud in Rust, and only its own answer here can say which.

Also the moment a shared server can say it takes more projects, so it is when two started
together are folded into one ([[ed-lsp-merge-into-host]])."
  (let (conn (nth input 2 nil))
    (if (contains? (or (:lsp-servers m) {}) conn)
      (ed-lsp-merge-into-host (map/assoc-in m [:lsp-servers conn :caps] (nth input 1 {})) conn)
      m)))

(defn ed-ev-lsp-apply-edit (m input textrows cols rows)
  "A server asking to change files itself (`[:lsp-apply-edit wsedit]`) — what a code
action's `workspace/executeCommand` produces instead of carrying its edits inline.

Applied to whatever those files are, because that is the whole request: unlike a rename,
nothing here was computed against a buffer we can rope-guard — the action was chosen from
a list the server offered, and the server is the one that decided what it means. Files not
already open are opened to receive it, and every touched buffer is left modified for you
to read before saving."
  (let (wsedit (nth input 1)
        paths (keys wsedit))
    (if (empty? paths)
      m
      (message (fold paths m (fn (mm path) (ed-lsp-apply-file-edits mm path (get wsedit path))))
        (str "applied edits in " (count paths) " file(s)")))))

(defn- ed-lsp-here (m feature)
  "The LSP request context for the current buffer at point:
`{:conn :uri :lang :line :char}` (0-based line/char, LSP units), `:conn` the server to ask
for `feature` ([[ed-lsp-for]]). No text: the request is sent by [[ed-lsp-ask-server]],
which syncs the document first, incrementally."
  (let (buf (ed-current-buf m)
        file (buffer-file buf))
    {:conn (:conn (ed-lsp-for m feature))
     :uri (lsp/lsp-path->uri file)
     :lang (lsp/lsp-language-id file)
     :line (buffer-current-line buf)
     :char (buffer-column buf)}))

(defn- ed-lsp-push-marker (m)
  "Push the current location onto the LSP jump stack (`:lsp-markers`), so M-, can return."
  (let (b (ed-current-buf m))
    (assoc m
      :lsp-markers (cons {:buffer (buffer-name b) :point (buffer-point b)} (:lsp-markers m '())))))

(defn- ed-lsp-goto-loc (m loc)
  "Jump to LSP location `loc` (`{:path :line :char}`), opening its file if needed; pushes a
marker first so M-, returns to where the jump started."
  (let (m1 (ed-lsp-push-marker m)
        m2 (ed-find-file m1 (:path loc)))
    (ed-apply m2 (fn (b) (ed-goto-line-col b (:line loc) (:char loc))))))

(defn- ed-lsp-loc-label (m loc)
  "A `relpath:line` label for a location (project-relative when possible) for the
references/definition picker."
  (let (root (:project-root m)
        p (:path loc)
        rel (if (and root (string/starts-with? p (str root "/")))
              (string/substring p (string/length (str root "/")))
              p))
    (str rel ":" (+ 1 (:line loc)))))

(defn- ed-lsp-locations-prompt (m prompt locs)
  "A Vertico minibuffer over LSP `locs`; the chosen one opens its file and jumps (M-, returns)."
  (let (labeled (map locs (fn (l) [(ed-lsp-loc-label m l) l]))
        labels (map labeled first))
    (assoc m
      :minibuffer
        (ed-name-prompt prompt
          labels
          (fn (mm t)
            (let (hit (seq/find labeled (fn (p) (= (first p) t))))
              (if (nil? hit) (message mm "lsp: location gone") (ed-lsp-goto-loc mm (second hit)))))))))

(defn- ed-lsp-origin (m pend)
  "The pool index of the buffer a mutating LSP request was made FROM (`:buffer` in
`pend`), but only while its rope still matches the request-time `:rope` — nil when
the buffer is gone or has changed (the edits were computed against text that no
longer exists; applying them would land misaligned). The ORIGIN buffer, not the
current one: the user may have switched buffers while the server worked."
  (let (idx (ed-buffer-index-by-name m (:buffer pend)))
    (if (and idx (= (buffer-rope (ed-buf-at m idx)) (:rope pend)))
      idx
      nil)))

;; The fold half of the `LspRequest` ability (see `lsp-requests`): an arrived reply's
;; payload folds into the model per kind — the action half of the commands below,
;; unchanged from their synchronous days. Mutating kinds (formatting, rename) verify
;; the ORIGIN buffer (`ed-lsp-origin`, via the context merged onto the pending
;; record) still holds the rope the request was computed against, and apply to THAT
;; buffer — the user may be in another one by now. (Known limitation, as in most LSP
;; clients: a rename's edits to OTHER open files are guarded only by the origin
;; buffer; the LSP protocol's per-document versions would close that fully.) The ids
;; are written qualified — a bare id would qualify to THIS module.

(impl LspRequest
  lsp-requests/lsp-completion
  ;; a completion reply is awaited by its bounded synchronous wait (the Tab source),
  ;; never registered in `:lsp-pending` — folding is a no-op
  (lsp-request-fold (_ m payload) m))

(impl LspRequest
  lsp-requests/lsp-definition
  (lsp-request-fold (_ m payload)
    (cond
      (empty? payload) (message m "no definition found")
      (= (count payload) 1) (ed-lsp-goto-loc m (first payload))
      else (ed-lsp-locations-prompt m "Definition: " payload))))

(impl LspRequest
  lsp-requests/lsp-references
  (lsp-request-fold (_ m payload)
    (if (empty? payload)
      (message m "no references found")
      (ed-lsp-locations-prompt m "References: " payload))))

(impl LspRequest
  lsp-requests/lsp-hover
  (lsp-request-fold (_ m payload)
    (if (string/blank? payload) (message m "no hover info") (message m payload))))

(impl LspRequest
  lsp-requests/lsp-signature
  ;; The argument hint goes in the `:eldoc` slot, not the echo: `message` is what the
  ;; editor says to you and this is not the editor saying anything, it is the signature of
  ;; the call your cursor is in. The echo row shows it only when nothing louder is there
  ;; (`view/ed-echo-or-eldoc`), which is exactly the precedence it should have.
  ;;
  ;; Dropped unless point is still where the question was asked from: an answer about a
  ;; call you have already typed past is worse than no answer, because it reads as being
  ;; about the one you are in now. A blank payload is applied, not dropped — it is how the
  ;; server says "you are not inside a call any more", and keeping the old hint there
  ;; would leave a signature under a cursor that has left it.
  (lsp-request-fold (pend m payload)
    (let (buf (ed-current-buf m))
      (if (not (= [(buffer-point buf) (buffer-rope buf)] (:at pend)))
        m
        (assoc m :eldoc (if (string/blank? payload) nil payload))))))

(defn- ed-lsp-action-label (action n)
  "The picker label for a code `action` — its title, with its LSP `kind` after it and the
1-based ordinal `n` in front when the list needs it to tell two apart.

Titles are the server's prose and are not guaranteed distinct: Expert offers `Add alias`
once per candidate module. The picker matches the chosen row back to an action BY label,
so two identical rows would silently mean the first one."
  (str (if n (str n ". ") "")
    (:title action)
    (if (:kind action) (str "  [" (:kind action) "]") "")))

(defn- ed-lsp-action-rows (actions)
  "`[[label action] …]` for the code-action picker, numbering the rows only when two share
a title — an ordinal on every row would be noise on the common case of one or two."
  (let (titles (map actions :title)
        dup? (not (= (count (seq/distinct titles)) (count titles))))
    (into []
      (map (seq/enumerate actions)
        (fn ([i a]) [(ed-lsp-action-label a (when dup? (+ i 1))) a])))))

(defn- ed-lsp-run-action (m conn action)
  "Carry out one chosen code action: apply the edits it carries, and/or ask the server to
run the command it names. An action may be both (LSP allows it, and `organize imports`
often is), so neither arm excludes the other."
  (let (edit (:edit action)
        m1 (if (or (nil? edit) (empty? edit))
             m
             (message (fold (keys edit)
                        m
                        (fn (mm path) (ed-lsp-apply-file-edits mm path (get edit path))))
               (str (:title action) " — " (count (keys edit)) " file(s)"))))
    (if (nil? (:command action))
      m1
      (ed-lsp-ask-server m1
        conn
        (lsp-execute-command)
        {:command (:command action) :arguments (:arguments action)}
        nil
        (str (:title action) "…")))))

(impl LspRequest
  lsp-requests/lsp-code-actions
  ;; The picker rather than a straight apply, even for one action: a code action REWRITES
  ;; your file on the server's say-so, and "add missing import" and "delete this clause"
  ;; arrive through the same door. Reading the title first is the whole safety story.
  (lsp-request-fold (pend m payload)
    (if (empty? payload)
      (message m "lsp: no code actions here")
      (let (labeled (ed-lsp-action-rows payload)
            labels (map labeled first))
        (assoc m
          :minibuffer
            (ed-name-prompt "Code action: "
              labels
              (fn (mm t)
                (let (hit (seq/find labeled (fn (p) (= (first p) t))))
                  (if (nil? hit)
                    (message mm "lsp: action gone")
                    (ed-lsp-run-action mm (:conn pend) (second hit)))))))))))

(impl LspRequest
  lsp-requests/lsp-execute-command
  ;; Nothing to fold: the server answers `null` and sends its edits separately, as a
  ;; `workspace/applyEdit` request that lands on [[ed-ev-lsp-apply-edit]].
  (lsp-request-fold (_ m payload) (message m "lsp: action ran")))

(impl LspRequest
  lsp-requests/lsp-symbols
  (lsp-request-fold (_ m payload)
    (if (empty? payload)
      (message m "imenu: no symbols (is the server ready?)")
      (ed-imenu-prompt m payload))))

(impl LspRequest
  lsp-requests/lsp-formatting
  (lsp-request-fold (pend m payload)
    (let (idx (ed-lsp-origin m pend))
      (cond
        (empty? payload) (message m "lsp: no formatting changes")
        (nil? idx) (message m "lsp: buffer changed while formatting ran — dropped (re-run C-c C-f)")
        else
          (message (assoc m
                     :buffers
                       (assoc (:buffers m)
                         idx (ed-apply-text-edits (ed-buf-at m idx) payload)))
            "formatted")))))

(impl LspRequest
  lsp-requests/lsp-rename
  (lsp-request-fold (pend m payload)
    (cond
      (empty? payload) (message m "lsp: rename produced no changes")
      (nil? (ed-lsp-origin m pend))
        (message m "lsp: buffer changed while rename ran — dropped (re-run C-c C-r)")
      else (ed-lsp-apply-rename m pend payload))))

(defcommand cmd-goto-definition
  (m key)
  "Jump to the definition of the symbol at point (M-.); M-, returns. Picks among several
definitions via a minibuffer. Auto-starts the server on first use. Async — the jump
happens when the location arrives."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (cx (ed-lsp-here m2 :definitionProvider))
        (ed-lsp-ask-server m2
          (:conn cx)
          (lsp-definition)
          cx
          nil
          "resolving definition…")))))

(defcommand cmd-lsp-pop-marker
  (m key)
  "Return to the location before the last LSP jump (M-,)."
  (let (stack (:lsp-markers m '()))
    (if (empty? stack)
      (message m "no LSP jump to return from")
      (let (mk (first stack)
            m1 (assoc m :lsp-markers (rest stack))
            idx (ed-buffer-index-by-name m1 (:buffer mk)))
        (if (nil? idx)
          (message m1 (str "lsp: buffer gone: " (:buffer mk)))
          (ed-apply (ed-select m1 idx)
            (fn (b) (goto-char b (math/min (:point mk) (buffer-length b))))))))))

(defcommand cmd-find-references
  (m key)
  "List every reference to the symbol at point and jump to the chosen one (M-?).
Async — the picker opens when the list arrives."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (cx (ed-lsp-here m2 :referencesProvider))
        (ed-lsp-ask-server m2
          (:conn cx)
          (lsp-references)
          cx
          nil
          "finding references…")))))

(defn- ed-lsp-signature-ask (m note)
  "Fire a `textDocument/signatureHelp` for point and stamp the model with the position it
was asked from (`:signature-at`), so the same question is not asked twice and the answer
knows whether it is still about where the cursor is."
  (let (cx (ed-lsp-here m :signatureHelpProvider)
        buf (ed-current-buf m)
        at [(buffer-point buf) (buffer-rope buf)])
    (ed-lsp-ask-server (assoc m :signature-at at) (:conn cx) (lsp-signature) cx {:at at} note)))

(defn ed-signature-due? (m)
  "True when the LSP argument hint (`textDocument/signatureHelp`) is due a refresh: a LIVE
server that offers signature help, point or the text moved since the last ask
(`:signature-at`), and a buffer mode that does not answer for itself.

This is the idle job's `:stale?`, which is what keeps the beat ARMED — so it must be false
whenever the ask would not happen. When it only asked whether `:lsp` was set, a server that
had died, or one that never offered signature help, left it true for good: the beat fired
on every debounce forever, with nothing typed.

The mode's own `:eldoc` service wins where there is one, and not by seniority: it is
local, instant and always right about the language it was written for, whereas this costs
a round-trip. They share the `:eldoc` slot, so letting both write it would make the hint
depend on which reply landed last."
  (let (buf (ed-current-buf m))
    (and (ed-lsp-live m)
      (lsp/lsp-capable? (ed-lsp-caps m :signatureHelpProvider) :signatureHelpProvider)
      (nil? (ed-mode-service buf :eldoc))
      (not (= [(buffer-point buf) (buffer-rope buf)] (:signature-at m))))))

(defn ed-launch-signature (m)
  "The idle beat's argument hints: ask the connected language server what call point is
inside, and show its signature in the eldoc slot ([[ed-signature-due?]] decides when).

This is eglot's `eglot-signature-eldoc-function` and it is the feature that makes a server
worth having open while you TYPE rather than when you stop and ask a question — every
other LSP command here is one you invoke. Silent in every direction: it never starts a
server (`ed-lsp-autostart` owns that), never messages, and a server that does not offer
signature help is never asked — Expert is one, so in Elixir this costs exactly nothing."
  (if (or (ed-headless?) (not (ed-signature-due? m)) (nil? (buffer-file (ed-current-buf m))))
    m
    (ed-lsp-signature-ask m :quiet)))

(defcommand cmd-lsp-code-action
  (m key)
  "Offer the language server's fixes for the code at point and run the chosen one (C-c C-a).

Emacs' `eglot-code-actions`. The diagnostics on the current line go WITH the request —
that is how a server knows which quickfix you mean, and without them most servers answer
with their unconditional refactorings only, which reads as the fix for the error under
your cursor not existing."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (cx (ed-lsp-here m2 :codeActionProvider)
            file (buffer-file (ed-current-buf m2))
            offering (seq/filter (lsp/lsp-live-entries m2 file)
                       (fn (entry) (lsp/lsp-capable? (:caps entry) :codeActionProvider)))
            ;; the diagnostics at point that a server published itself: a quickfix is
            ;; asked of the server whose finding it fixes (ruff's, not pyright's)
            diags-of (fn (entry)
                       (lsp/lsp-diagnostics-at-line (ed-lsp-raw-diags m2 file (:key entry))
                         (:line cx)))
            ;; …else the first that offers them, else the main server, which has not said
            ;; yet what it offers when its caps are still empty, and may answer anyway
            entry (or (seq/find offering (fn (entry) (not (empty? (diags-of entry)))))
                    (first offering)
                    (ed-lsp-for m2 :codeActionProvider)))
        (cond
          (nil? entry) (message m2 "lsp: no server is running for this buffer")
          ;; said plainly once it HAS said, because the alternative is a key that appears
          ;; to do nothing
          (and (empty? offering) (not (empty? (or (:caps entry) {}))))
            (message m2 "lsp: this server does not offer code actions")
          else
            (ed-lsp-ask-server m2
              (:conn entry)
              (lsp-code-actions)
              (assoc cx :conn (:conn entry) :diags (diags-of entry))
              {:conn (:conn entry)}
              "code actions…"))))))

(defcommand cmd-lsp-signature-help
  (m key)
  "Show the signature of the call point is inside, in the echo area (C-c C-s).

Normally you never press this — the idle beat asks the same question as you type
(`ed-launch-signature`). It is here for the buffer whose mode answers eldoc itself, where
the automatic path stands back, and for asking again after a message has covered the hint."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (cond
      (not ready?) m2
      ;; said plainly, because the alternative is a key that appears to do nothing
      (not (lsp/lsp-capable? (ed-lsp-caps m2 :signatureHelpProvider) :signatureHelpProvider))
        (message m2 "lsp: this server does not offer signature help")
      else (ed-lsp-signature-ask m2 "signature…"))))

(defcommand cmd-lsp-hover
  (m key)
  "Show the type / signature / docs of the symbol at point in the echo area (C-c C-d).
Async — the docs show when they arrive."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (cx (ed-lsp-here m2 :hoverProvider))
        (ed-lsp-ask-server m2 (:conn cx) (lsp-hover) cx nil "hover…")))))

(sig ed-edit-offsets
  (buffer (record &open :start-line int :start-char int :end-line int :end-char int :text string)
    ->
    (record :start int :end int :text string)))
(defn- ed-edit-offsets (b e)
  "The char-offset form `{:start :end :text}` of normalised LSP edit `e` in buffer `b`
(offsets computed against the original buffer, clamped to its length)."
  (let (rope (buffer-rope b)
        len (buffer-length b)
        s (+ (text/line->char rope (:start-line e)) (:start-char e))
        en (+ (text/line->char rope (:end-line e)) (:end-char e)))
    {:start (math/min s len) :end (math/min en len) :text (:text e)}))

(defn- ed-apply-text-edits (b edits)
  "Apply LSP `edits` to buffer `b`. Offsets are resolved against the original buffer, then
applied last-position-first so each replace can't shift the offsets of edits still to come."
  (let (os (map edits (fn (e) (ed-edit-offsets b e)))
        sorted (sort os (fn (a c) (> (:start a) (:start c))))
        out (fold sorted b (fn (bb e) (replace-region bb (:start e) (:end e) (:text e)))))
    (goto-char out (math/min (buffer-point b) (buffer-length out)))))

(defcommand cmd-lsp-format-buffer
  (m key)
  "Format the current buffer via the language server (C-c C-f). Async, rope-guarded:
the edits apply when they arrive iff the buffer hasn't changed meanwhile."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (let (cx (ed-lsp-here m2 :documentFormattingProvider)
            b (ed-current-buf m2))
        (ed-lsp-ask-server m2
          (:conn cx)
          (lsp-formatting)
          cx
          {:rope (buffer-rope b) :buffer (buffer-name b)}
          "formatting…")))))

(defn- ed-lsp-apply-file-edits (m path edits)
  "Open `path` and apply `edits` to its buffer (left modified for the user to save)."
  (ed-apply (ed-find-file m path) (fn (b) (ed-apply-text-edits b edits))))

(defn- ed-lsp-apply-rename (m pend wsedit)
  "Apply an arrived rename's workspace edit across every affected file, returning to
the buffer/point the rename started in (`:buffer`/`:point` captured in `pend`)."
  (let (paths (keys wsedit)
        m2 (fold paths m (fn (mm path) (ed-lsp-apply-file-edits mm path (get wsedit path))))
        idx (ed-buffer-index-by-name m2 (:buffer pend))
        m3 (if (nil? idx)
             m2
             (ed-apply (ed-select m2 idx)
               (fn (b) (goto-char b (math/min (:point pend) (buffer-length b)))))))
    (message m3 (str "renamed in " (count paths) " file(s)"))))

(defn- ed-lsp-do-rename (m new-name)
  "Fire the rename request for the symbol at point → `new-name` (async); the workspace
edit applies when it arrives (`lsp-request-fold` on `lsp-rename`), rope-guarded against edits made
while the server worked, returning to the origin buffer/point."
  (let (cx (ed-lsp-here m :renameProvider)
        b (ed-current-buf m))
    (ed-lsp-ask-server m
      (:conn cx)
      (lsp-rename)
      (assoc cx :new-name new-name)
      {:rope (buffer-rope b) :buffer (buffer-name b) :point (buffer-point b)}
      "renaming…")))

(defcommand cmd-lsp-rename
  (m key)
  "Rename the symbol at point across the workspace (C-c C-r); prompts for the new name and
applies the edits to every affected file (left modified for you to save)."
  (let ([m2 ready?] (ed-lsp-ensure m))
    (if (not ready?)
      m2
      (assoc m2
        :minibuffer
          {:edit (ed-mb-edit "Rename to: " "")
           :on-complete (fn (mm new-name)
                          (if (string/blank? new-name)
                            (message mm "rename cancelled")
                            (ed-lsp-do-rename mm new-name)))}))))

;; ---- the connections: every server a file's type names, rooted where it says --------
;; `:lsp-servers` on the model is `{conn entry}`, an entry `{:spec :roots :conn :caps
;; :identity :command}` filed under its connection ([[lsp/lsp-server-entries]]): one
;; process, one entry, whichever projects it comes to serve. A file reaches every server its
;; extension names (`lsp/*lsp-server-specs*`), each rooted at the nearest folder holding that
;; server's root marker, so a `.py` buffer has pyright and ruff and a cargo workspace member
;; has the workspace's rust-analyzer. wos kernel source, which no server serves, reaches
;; none. A server that serves several projects (`:shared`) gets each further project as a
;; workspace folder rather than another process — only when it says it takes them, and only
;; for projects that pin the same toolchain ([[ed-lsp-identity]]).

(defn ed-lsp-server (m)
  "The main server entry for the current buffer's file (`{:key :conn :caps …}`), or nil."
  (lsp/lsp-server-entry m (buffer-file (ed-current-buf m))))

(defn ed-lsp-live (m)
  "The current buffer's first live LSP connection — the main server's while it runs — else
nil. A server that died leaves a pid on the model that every later request would send into
the void and then wait out its timeout, so liveness is asked here rather than in every
request site."
  (lsp/lsp-conn m (buffer-file (ed-current-buf m))))

(defn ed-lsp-for (m feature)
  "The live server entry to ask about the current buffer for `feature`
([[lsp/lsp-entry-for]]): the first that offers it, else the main one; nil with none."
  (lsp/lsp-entry-for m (buffer-file (ed-current-buf m)) feature))

(defn ed-lsp-caps (m &optional feature)
  "What the current buffer's server said it can do (`initialize`'s capabilities) — the one
asked for `feature` when given, else the main one; `{}` before it has said, or with none."
  (or (:caps (if feature (ed-lsp-for m feature) (ed-lsp-server m))) {}))

;; ---- where a server starts, and which projects can share one ----

(def *lsp-root-depth* 32)
;; How many folders above a file the root markers are looked for. Deep enough for any real
;; tree; a bound so a file in a deep non-project tree does not stat its way to `/`.

(def *lsp-toolchain-pins*
  ;; The files that pin a project's toolchain. Two projects share a server process only when
  ;; each of these reads the same for both: a shared process runs one toolchain, and a
  ;; project pinned to another would get its answers from the wrong compiler.
  [".tool-versions"
    ".mise.toml" "mise.toml" "rust-toolchain.toml" "rust-toolchain" ".ruby-version"
    ".python-version" ".nvmrc" ".node-version" ".go-version" ".terraform-version"
    ".opentofu-version"])

(defn- ed-lsp-home ()
  "The home folder without a trailing `/`, so it compares equal to a folder walked up to;
nil when `HOME` is unset."
  (let (home (os/env "HOME"))
    (cond
      (or (nil? home) (= home "") (= home "/")) nil
      (string/ends-with? home "/") (string/substring home 0 (dec (string/length home)))
      :else home)))

(defn ed-lsp-find-up (dir name stop &optional (depth *lsp-root-depth*))
  "The nearest folder from `dir` up that holds `name`, or nil — stopping before `stop` (a
folder, or nil for none) and after `depth` levels."
  (cond
    (or (<= depth 0) (= dir stop)) nil
    (lsp/lsp-marker-in? dir name) dir
    (= dir (path/dirname dir)) nil
    :else (ed-lsp-find-up (path/dirname dir) name stop (dec depth))))

(sig ed-lsp-root (map string -> string))
(defn ed-lsp-root (spec file)
  "The folder the server `spec` starts in for `file`: the nearest one holding its FIRST root
marker that any folder above the file holds — markers are tried in order, each up the whole
tree, so `Cargo.lock` (a cargo workspace's top) wins over a nearer member's `Cargo.toml`,
and a monorepo's `tsconfig.json` over a package's `package.json`. Never the home folder or
above: a stray `~/package.json` is no project. Else the file's project root, else its own
folder."
  (let (dir (path/dirname file)
        home (ed-lsp-home)
        found (fold (or (:root-markers spec) [])
                nil
                (fn (hit marker) (or hit (ed-lsp-find-up dir marker home)))))
    (if (string? found)
      found
      (let (project (project-root dir)) (if (string? project) project dir)))))

(defn ed-lsp-learn-roots (m file)
  "`m` with the project root of every server `file`'s type names recorded for its folder
(`:lsp-roots`, read by `lsp/lsp-known-root`) — the marker walk once per server and folder,
not on every idle beat. Knowing it is what keeps a nested project from being taken for part
of the running server around it."
  (if (not (string? file))
    m
    (fold (lsp/lsp-specs-for file)
      m
      (fn (acc spec)
        (if (lsp/lsp-known-root acc (:name spec) file)
          acc
          (map/assoc-in acc [:lsp-roots [(:name spec) (path/dirname file)]] (ed-lsp-root spec file)))))))

(defn ed-lsp-forget-roots (m file)
  "`m` without the roots learnt for `file`'s folder, so the next look walks the disk again —
`M-x lsp-connect`'s retry, after a `Cargo.toml` or `mix.exs` was added."
  (let (folder (when (string? file) (path/dirname file)))
    (assoc m
      :lsp-roots
        (into {}
          (seq/reject (%map-pairs (or (:lsp-roots m) {})) (fn ([key _]) (= (nth key 1) folder)))))))

(defn ed-lsp-pins (root)
  "What pins `root`'s toolchain: each `*lsp-toolchain-pins*` file found from `root` up,
mapped to its text (the nearest one, which is the one the version manager reads)."
  (fold *lsp-toolchain-pins*
    {}
    (fn (pins name)
      ;; home included: a global `~/.tool-versions` pins every project under it
      (let (found (ed-lsp-find-up root name nil))
        (if (nil? found) pins (assoc pins name (file/slurp (path/join found name))))))))

(defn ed-lsp-identity (command root)
  "What makes a server process for `root` the same as one for another project: the program
`command` resolves to and the toolchain pins over `root` ([[ed-lsp-pins]])."
  [(os/which command) (ed-lsp-pins root)])

(defn ed-lsp-command (spec)
  "The first of `spec`'s `[command args]` alternatives that is installed, or nil."
  (seq/find (:commands spec) (fn (choice) (not (nil? (os/which (first choice)))))))

(defn ed-lsp-share-host (m spec-name identity &optional (except nil))
  "A running server named `spec-name` that can take another project with this `identity`
(other than the connection `except`): alive, started for a project pinned the same way, and
saying it takes workspace folders. Only one whose capabilities have arrived can say so, so
two projects opened while the first server is still starting each get their own — until
the second says it too, when [[ed-lsp-merge-into-host]] folds them into one."
  (seq/find (vals (or (:lsp-servers m) {}))
    (fn (entry)
      (and (= (:spec entry) spec-name)
        (not (= (:conn entry) except))
        (= (:identity entry) identity)
        (proc/alive? (:conn entry))
        (lsp/lsp-folders-supported? (:caps entry))))))

;; ---- filing servers on the model ----

(defn- ed-lsp-drop-diags (m conn keep?)
  "`m` without what server `conn` published about the paths `keep?` rejects, each such path
shown again without it, so its marks leave the screen with the server."
  (let (diags (or (:lsp-diags m) {})
        gone (seq/filter (keys diags)
               (fn (path) (and (contains? (get diags path) conn) (not (keep? path))))))
    (fold gone
      m
      (fn (acc path)
        (let (left (dissoc (map/get-in acc [:lsp-diags path]) conn))
          (ed-lsp-show-diags (assoc acc
                               :lsp-diags
                                 (if (empty? left)
                                   (dissoc (:lsp-diags acc) path)
                                   (assoc (:lsp-diags acc) path left)))
            path))))))

(defn- ed-lsp-drop-synced (m conn keep?)
  "`m` without the record of what was pushed to server `conn` for the uris `keep?` rejects."
  (let (synced (or (:lsp-synced m) {}))
    (assoc m
      :lsp-synced
        (fold (keys synced)
          synced
          (fn (acc pushed)
            (if (and (= (first pushed) conn) (not (keep? (second pushed)))) (dissoc acc pushed) acc))))))

(defn ed-lsp-attach (m entry)
  "`m` with server `entry` filed under its connection — and anything recorded as pushed to
that connection forgotten, so nothing pushed before is a base."
  (ed-lsp-drop-synced (map/assoc-in m [:lsp-servers (:conn entry)] entry)
    (:conn entry)
    (fn (_) false)))

(defn ed-lsp-detach (m conn)
  "`m` without the server `conn`: its entry, what it was sent, and what it published (taken
off the screen)."
  (-> (assoc m :lsp-servers (dissoc (or (:lsp-servers m) {}) conn))
    (ed-lsp-drop-synced conn (fn (_) false))
    (ed-lsp-drop-diags conn (fn (_) false))))

(defn ed-lsp-release (m entry file)
  "Stop serving `file`'s project with `entry`'s server: a server serving several projects
drops that one (`workspace/didChangeWorkspaceFolders`), with what it was sent and published
about it, and keeps the rest; one serving only it, or one already dead, is shut down and
detached whole."
  (let (conn (:conn entry)
        root (lsp/lsp-entry-root entry file)
        roots (into [] (seq/reject (:roots entry) (fn (r) (= r root))))
        outside? (fn (path) (not (lsp/lsp-under? path root))))
    (if (or (empty? roots) (not (proc/alive? conn)))
      (do (lsp/lsp-shutdown conn) (ed-lsp-detach m conn))
      (do
        (lsp/lsp-remove-folder conn root)
        (-> (map/assoc-in m [:lsp-servers conn :roots] roots)
          (ed-lsp-drop-synced conn (fn (uri) (outside? (lsp/lsp-uri->path uri))))
          (ed-lsp-drop-diags conn outside?))))))

(defn- ed-lsp-drop-pending (m conn)
  "`[m2 dropped]`: `m` without the lookups waiting on server `conn`, and how many there were."
  (let (pending (or (:lsp-pending m) {})
        waiting (seq/filter (keys pending) (fn (corr) (= (:conn (get pending corr)) conn))))
    [(assoc m :lsp-pending (fold waiting pending dissoc)) (count waiting)]))

(defn- ed-lsp-reroute-pending (m conn host)
  "`[m2 dropped]`: the lookups waiting on server `conn` asked again of `host`, under the same
corr, so the answer folds as if `conn` had given it. The host has never seen the document,
so the request carries its whole text (the connection syncs it first). One whose buffer is
gone or has changed since it was asked is dropped and counted — its position is about text
that is no longer there — and so is one about no document (a command, which `conn` may
already have run)."
  (let (pending (or (:lsp-pending m) {})
        waiting (seq/filter (keys pending) (fn (corr) (= (:conn (get pending corr)) conn))))
    (fold waiting
      [m 0]
      (fn ([acc dropped] corr)
        (let (pend (get pending corr)
              [path rope] (or (:about pend) [nil nil])
              idx (when path (ed-buffer-index-by-file acc path))
              buf (when idx (ed-buf-at acc idx)))
          (if (and buf (= (buffer-rope buf) rope))
            (do
              (lsp/lsp-ask-async host
                (:request-kind pend)
                corr
                (self)
                (assoc (:request pend) :text (buffer-text buf)))
              [(map/assoc-in acc [:lsp-pending corr] (assoc pend :conn host)) dropped])
            [(assoc acc :lsp-pending (dissoc (:lsp-pending acc) corr)) (inc dropped)]))))))

(defn ed-lsp-merge-into-host (m conn)
  "Fold server `conn` into another running for a project pinned the same way, once both say
they take workspace folders: `conn`'s projects become the other's folders and `conn` stops.
Two projects opened while the first server was still starting each got a process of their
own; this makes them one, and so does a project connected by hand beside a running one.
`conn`'s documents go to the host on their next push (whole, as to any new server), its
findings leave with it until the host publishes, and a lookup it had not answered is asked
of the host instead ([[ed-lsp-reroute-pending]]) — or, when it no longer can be, dropped
and said, so it can be asked again. `m` unchanged when there is nothing to fold into."
  (let (entry (map/get-in m [:lsp-servers conn])
        host (when (and (:identity entry) (lsp/lsp-folders-supported? (:caps entry)))
               (ed-lsp-share-host m (:spec entry) (:identity entry) conn)))
    (if (nil? host)
      m
      ;; the folders first: the host answers a re-asked lookup about a file in them
      (let (_ (doseq (root (:roots entry)) (lsp/lsp-add-folder (:conn host) root))
            [m1 dropped] (ed-lsp-reroute-pending m conn (:conn host)))
        (lsp/lsp-shutdown conn)
        (message (map/assoc-in (ed-lsp-detach m1 conn)
                   [:lsp-servers (:conn host) :roots]
                   (into [] (append (:roots host) (:roots entry))))
          (str "lsp: one "
            (:command host)
            " now serves "
            (string/join (:roots entry) ", ")
            " too"
            (if (> dropped 0) " — ask that again" "")))))))

(defn ed-lsp-server-down (m pid reason)
  "A server's connection died (`model/register-down-handler`): everything it left is cleared
at once — its entry, what it was sent, its findings (off the screen), and the lookups waiting
on it, which would otherwise sit until C-g — and said once. Its projects count as tried, so
the idle beat does not respawn a server that cannot stay up; `M-x lsp-connect` is the retry.
A server the editor stopped itself is already gone from the model, and passes silently."
  (let (entry (map/get-in m [:lsp-servers pid]))
    (if (nil? entry)
      m
      (let ([m1 dropped] (ed-lsp-drop-pending m pid)
            tried (fold (:roots entry)
                    (or (:lsp-autostarted m1) #{})
                    (fn (acc root) (conj acc [(:spec entry) root]))))
        (message (assoc (ed-lsp-detach m1 pid) :lsp-autostarted tried)
          (str "lsp: "
            (or (:command entry) (:spec entry))
            " exited"
            (if (> dropped 0) ", and the lookup it was answering with it" "")
            " (M-x lsp-connect to start it again)"))))))

(defn ed-lsp-start-spec (m spec file root)
  "Start server `spec` for `file`'s project `root` — or, for a shared server, hand `root` to
one already serving a project pinned the same way. `[m2 conn line]`: the connection now
serving the file and what to say about it, or a nil conn and why not."
  (let (choice (ed-lsp-command spec))
    (if (nil? choice)
      [m
        nil
        (str (string/join (map (:commands spec) first) " / ") " is not installed (not on PATH)")]
      (let ([command args] choice
            identity (when (:shared spec) (ed-lsp-identity command root))
            host (when identity (ed-lsp-share-host m (:name spec) identity)))
        ;; …and the completion source, with the sync that lets its request carry no text:
        ;; run before the sources are asked, as the edits since the last push. Registering
        ;; is idempotent, and here rather than at load so a session with no server never
        ;; asks one on Tab.
        (complete-at-point/complete-add-source! 'lsp/lsp-complete-source)
        (complete-at-point/complete-add-prepare! 'lsp-commands/ed-lsp-push-text)
        (if host
          (do
            (lsp/lsp-add-folder (:conn host) root)
            [(map/assoc-in m [:lsp-servers (:conn host) :roots] (conj (:roots host) root))
              (:conn host)
              (str command " now serves " root " too")])
          (let (conn (lsp/lsp-connect command args (lsp/lsp-path->uri root)))
            ;; watched, so its death reaches [[ed-lsp-server-down]] the moment it happens
            (monitor conn)
            [(ed-lsp-attach m
               {:spec (:name spec)
                :roots [root]
                :conn conn
                :caps {}
                :identity identity
                :command command})
              conn
              (str command " connected for " root)]))))))

(defn- ed-lsp-unserved (m file)
  "The specs for `file` that no live server serves it with yet."
  (let (live (map (lsp/lsp-live-entries m file) (fn (entry) (:spec entry))))
    (seq/reject (lsp/lsp-specs-for file) (fn (spec) (includes? live (:name spec))))))

(defn ed-lsp-start (m)
  "Start every language server the current buffer's file type names that is not already
serving it, and register the completion source — `[m2 conn]`, `conn` the main connection
now serving the file, nil with an explanatory message on `m2` when nothing could start: the
buffer has no file, no server is configured for its extension, or none is installed.

Every message says `lsp:`, whichever feature asked — completion, imenu, goto, references,
hover and rename share these servers, and what went wrong is the server's, not theirs;
`imenu: expert is not installed` would read as a fact about imenu.

`os/which` asks before spawning: `os/spawn` raises when the binary is missing, inside the
connection PROCESS, and that answered a goto-definition with a crash trace."
  (let (file (buffer-file (ed-current-buf m))
        ;; first: which servers serve the file depends on its project root
        m (ed-lsp-learn-roots m file)
        specs (when file (ed-lsp-unserved m file)))
    (cond
      (nil? file) [(message m "lsp: the buffer has no file") nil]
      (empty? (lsp/lsp-specs-for file))
        [(message m (str "lsp: no server configured for ." (lsp/lsp-extension file))) nil]
      (empty? specs) [m (lsp/lsp-conn m file)]
      :else
        (let ([m2 lines] (fold specs
                           [m []]
                           (fn ([acc lines] spec)
                             (let ([started _ line] (ed-lsp-start-spec acc
                                                      spec
                                                      file
                                                      (lsp/lsp-known-root acc (:name spec) file)))
                               [started (conj lines line)]))))
          [(message m2 (str "lsp: " (string/join lines " · "))) (lsp/lsp-conn m2 file)]))))

(defn- ed-lsp-drop-dead (m)
  "`m` without the current buffer's servers whose process is gone — a dead pid is not a
connection, and keeping it would make every lookup report one."
  (fold (lsp/lsp-server-entries m (buffer-file (ed-current-buf m)))
    m
    (fn (acc entry) (if (proc/alive? (:conn entry)) acc (ed-lsp-detach acc (:conn entry))))))

(defcommand cmd-lsp-connect
  (m key)
  "Start the language servers for the current buffer's file type and turn their
completions on (M-x lsp-connect). Looks the file extension up in `lsp/*lsp-server-specs*`
(rust-analyzer, pyright and ruff, …), starts each for its own project root — or adds the
project to a running server that serves several — and registers `lsp-complete-source`, so
Tab also offers the servers' candidates. M-x lsp-disconnect stops them; M-x lsp-servers
lists what is running."
  (let (file (buffer-file (ed-current-buf m))
        ;; the roots looked for again: this is the retry, and a project marker may be new
        m1 (ed-lsp-learn-roots (ed-lsp-forget-roots (ed-lsp-drop-dead m) file) file))
    (if (and file (ed-lsp-live m1) (empty? (ed-lsp-unserved m1 file)))
      (message m1
        (str "lsp: "
          (string/join (map (lsp/lsp-live-entries m1 file) (fn (entry) (:command entry))) ", ")
          " already connected (M-x lsp-disconnect first)"))
      (let ([m2 _] (ed-lsp-start m1)) m2))))

(defcommand cmd-lsp-disconnect
  (m key)
  "Stop the current buffer's language servers (M-x lsp-disconnect): one that serves other
projects too keeps serving them. Other languages' servers keep running; the completion
source stays registered and asks nothing for a file with no server."
  (let (file (buffer-file (ed-current-buf m))
        entries (lsp/lsp-server-entries m file))
    (if (empty? entries)
      (message m "lsp: no server for this buffer")
      (message (fold entries m (fn (acc entry) (ed-lsp-release acc entry file)))
        (str "lsp: " (string/join (map entries (fn (entry) (:spec entry))) ", ") " disconnected")))))

(defn ed-lsp-servers-line (m)
  "The running servers in one line — `*brood-lsp ~/src/bedit · rust-analyzer ~/src/a,
~/src/b` — the current buffer's marked `*`, a dead one `(exited)`; `\"\"` when none."
  (let (mine (map (lsp/lsp-server-entries m (buffer-file (ed-current-buf m)))
               (fn (entry) (:conn entry)))
        home (ed-lsp-home)
        shown (fn (root)
                (if (and home (lsp/lsp-under? root home))
                  (str "~" (string/substring root (string/length home)))
                  root)))
    (string/join (map (seq/sort-by (vals (or (:lsp-servers m) {}))
                        (fn (entry) (str (:spec entry) " " (first (:roots entry)))))
                   (fn (entry)
                     (str (if (includes? mine (:conn entry)) "*" "")
                       (or (:command entry) (:spec entry))
                       " "
                       (string/join (map (:roots entry) shown) ", ")
                       (if (proc/alive? (:conn entry)) "" " (exited)"))))
      " · ")))

(defcommand cmd-lsp-servers
  (m key)
  "Say which language servers are running, the projects each serves, and which this buffer
uses, marked `*` (M-x lsp-servers — eglot's `eglot-list-connections`)."
  (let (line (ed-lsp-servers-line m))
    (message m (if (= line "") "lsp: no servers running" (str "lsp: " line)))))

(defdyn *lsp-autostart* true)
;; Whether opening a file whose language has an installed server starts it.
;;
;; It used to be that a server started on the first LOOKUP — the first `M-.`, hover or
;; rename — which was a fine rule while a server was only ever a lookup. Diagnostics
;; changed that: the underline on the mistake you just made is the thing you want without
;; asking, and a reader who never presses `M-.` in a file would never have seen one.
;;
;; `(defdyn *lsp-autostart* false)` in `init.blsp` turns it off, for a project where the
;; server's startup is heavy enough to want on demand — Expert compiles the whole mix
;; project before it answers anything, which is a real cost to pay unasked. The name is
;; bare, not `commands/…`: an earmuffed `defdyn` is ambient however deep the module.

(defn ed-lsp-close-gone (m)
  "`m` with every document pushed to a server whose buffer is no longer open closed on that
server (`didClose`) and forgotten — the record holds a whole buffer per document, which a
killed buffer would otherwise keep for the session, and the server keeps analysing a file
it was never told was closed."
  (let (open (into #{} (seq/keep (:buffers m) (fn (buf) (lsp/lsp-path->uri (buffer-file buf)))))
        synced (or (:lsp-synced m) {})
        gone (seq/reject (keys synced) (fn (pushed) (contains? open (second pushed)))))
    (if (empty? gone)
      m
      (do
        (doseq (pushed gone)
          (when (proc/alive? (first pushed)) (lsp/lsp-close (first pushed) (second pushed))))
        (assoc m :lsp-synced (fold gone synced dissoc))))))

(defn ed-lsp-push-text (m)
  "Tell each live server of the current buffer its text, once it has changed since the last
push — the idle beat's hook, beside the autostart.

**This is what makes diagnostics appear at all.** A server does not answer a question with
them: it PUSHES `publishDiagnostics` when it learns the text changed. Every other call into
`lsp` syncs the document on its way to asking something (`lsp-issue`), so the findings used
to arrive only for whatever version you happened to invoke a lookup on — and never while
typing, which is the only time they are worth having. The symptom was exact: imenu worked,
because asking for symbols synced the text on the way past, and the underline appeared once
and then never moved.

Gated on the rope, so an idle beat over an unchanged buffer sends nothing. And sent as the
EDITS since the last push when the server accepts ranged changes
(`lsp/lsp-incremental-sync?`): a full-text `didChange` is the whole document JSON-encoded
on the wire (341 ms for a 44k-line buffer) and re-read by the server, where a keystroke is
one small range. What was pushed is recorded per server and file under `:lsp-synced` —
`{[conn uri] {:buf :token}}`, the buffer the server now mirrors and the token naming it —
which is the base the next push diffs against (`lsp/lsp-content-changes`) and that the connection checks before
applying it (`lsp/lsp-sync-document`). The whole text goes instead for the first push, a
server that wants it, and a change the buffer's splice log cannot account for.

A file whose buffer is gone is closed on each server that had it (`didClose`) and
forgotten ([[ed-lsp-close-gone]]), so neither the server nor this record keeps it.

Also completion's prepare step (`complete-at-point/*completion-prepare*`) and the first
thing every lookup does ([[ed-lsp-ask-server]]), so the request after it carries no text."
  (let (m (ed-lsp-close-gone m)
        buf (ed-current-buf m)
        file (buffer-file buf)
        uri (when file (lsp/lsp-path->uri file)))
    ;; THIS buffer's servers, never another language's: a file no server is configured for
    ;; (wos kernel source) is pushed nowhere
    (fold (if (nil? file) [] (lsp/lsp-live-entries m file))
      m
      (fn (acc entry)
        (let (pushed [(:conn entry) uri]
              synced (map/get-in acc [:lsp-synced pushed]))
          (if (and synced (= (buffer-rope buf) (buffer-rope (:buf synced))))
            acc
            (let (token (ref)
                  changes (when (and synced (lsp/lsp-incremental-sync? (:caps entry)))
                            (lsp/lsp-content-changes (:buf synced) buf)))
              (lsp/lsp-sync (:conn entry)
                uri
                (lsp/lsp-language-id file)
                (if (nil? changes)
                  {:text (buffer-text buf) :token token}
                  {:changes changes :base (:token synced) :token token}))
              (assoc acc :lsp-synced (assoc (:lsp-synced acc {}) pushed {:buf buf :token token})))))))))

(defn ed-ev-lsp-resync (m input textrows cols rows)
  "A connection refusing an incremental sync for a uri (`[:lsp-resync uri conn]`) — its copy
is not the one the change was made against (a new connection, a full sync a direct request
made meanwhile). Forgetting what was pushed to that server for that uri makes the next push
send the whole text, which puts the two back in step."
  (assoc m :lsp-synced (dissoc (:lsp-synced m {}) [(nth input 2 nil) (nth input 1)])))

(defn- ed-lsp-autostart-spec (m spec file)
  "Autostart's step for one of the file's servers: nothing when one is serving it; said once
when the one that was has exited; otherwise started — once per server and folder, and once
per server and project root (`:lsp-autostarted`), so the `PATH` search runs once, not on
every idle beat. The root is the one [[ed-lsp-learn-roots]] found for the folder."
  (let (entry (seq/find (lsp/lsp-server-entries m file) (fn (entry) (= (:spec entry) (:name spec))))
        tried (fn (mm key) (update mm :lsp-autostarted (fn (started) (conj (or started #{}) key))))
        folder [(:name spec) (path/dirname file)])
    (cond
      (and entry (proc/alive? (:conn entry))) m
      ;; a connection this editor made, whose process is gone and whose death has not been
      ;; heard yet: cleared the way a heard one is
      entry (tried (ed-lsp-server-down m (:conn entry) nil) folder)
      (contains? (:lsp-autostarted m #{}) folder) m
      :else
        (let (root (lsp/lsp-known-root m (:name spec) file)
              project [(:name spec) root]
              m1 (tried (tried m folder) project))
          (cond
            (contains? (:lsp-autostarted m #{}) project) m1
            ;; not installed counts as the one try too
            (nil? (ed-lsp-command spec)) m1
            :else
              (let ([m2 _ line] (ed-lsp-start-spec m1 spec file root))
                (message m2 (str "lsp: " line))))))))

(defn ed-lsp-autostart (m)
  "Start the current buffer's language servers that are not running yet — the idle beat's
hook, so it happens once the buffer has settled rather than in the middle of opening it.

Silent about every reason not to: no file, no server configured for the extension, the
server not installed, one already serving it. A message for each of those would fire on
every idle beat in every buffer that has no server, which is most of them.

ONE try per server and project root (`:lsp-autostarted`). A server that dies — a rustup
`rust-analyzer` stub for a component that is not installed passes `os/which` and exits at
once — used to be respawned on every idle beat, a process every few hundred milliseconds
with nothing typed. Now its death is said once, and `M-x lsp-connect` is the retry."
  (let (file (buffer-file (ed-current-buf m)))
    (if (or (not *lsp-autostart*) (nil? file) (ed-headless?))
      m
      (fold (lsp/lsp-specs-for file)
        (ed-lsp-learn-roots m file)
        (fn (acc spec) (ed-lsp-autostart-spec acc spec file))))))

;; ---- registration: the events and idle-beat jobs this module owns ----------------
;; Registered at load, so neither the dispatcher's event table nor its idle beat names a
;; language server. Every `:lsp-…` event comes from a connection `ed-lsp-start` (here) made,
;; so none can arrive before these rows exist.

;; async LSP replies (corr-matched against :lsp-pending; stale ones drop) — the
;; navigation/edit commands fire and forget, the answer folds here on arrival.
;; `:lsp-completion` is only ever stale by the time it reaches the loop: completion's
;; bounded wait consumes the live ones.
(doseq (tag [:lsp-definition
              :lsp-references :lsp-hover :lsp-signature :lsp-code-actions
              :lsp-command-done :lsp-symbols :lsp-text-edits :lsp-workspace-edit :lsp-completion])
  (register-event-handler tag 'lsp-commands/ed-ev-lsp-reply))
;; not replies to anything — the server narrating its own startup, and telling us where
;; the errors are. Both were dropped on the floor once; the second is most of the reason to
;; run a language server at all.
(register-event-handler :lsp-notices 'lsp-commands/ed-ev-lsp-notices)
(register-event-handler :lsp-diagnostics 'lsp-commands/ed-ev-lsp-diagnostics)
;; …and the server asking to change files itself — a code action's command, whose edits
;; come back as a request TO us rather than as the reply to anything
(register-event-handler :lsp-apply-edit 'lsp-commands/ed-ev-lsp-apply-edit)
;; …and what it says it can do, so a command can say "this server does not offer that"
(register-event-handler :lsp-capabilities 'lsp-commands/ed-ev-lsp-capabilities)
;; …and a document whose incremental sync the connection had to refuse (see `ed-lsp-push-text`)
(register-event-handler :lsp-resync 'lsp-commands/ed-ev-lsp-resync)
;; …and a server dying, heard the moment it happens (see `ed-lsp-server-down`)
(register-down-handler :lsp 'lsp-commands/ed-lsp-server-down)

;; The idle beat: connect once the buffer has settled, push the text (which is what makes
;; the server publish diagnostics), then ask for the signature at point. The push follows
;; the autostart that connects it; the signature ask follows eldoc (order 40), whose
;; `:eldoc` slot it shares and which wins when the mode answers for itself.
(register-idle-job :lsp-autostart {:order 20 :run 'lsp-commands/ed-lsp-autostart})
(register-idle-job :lsp-push-text {:order 30 :run 'lsp-commands/ed-lsp-push-text})
(register-idle-job :lsp-signature
  {:order 50
   :run 'lsp-commands/ed-launch-signature
   :stale? 'lsp-commands/ed-signature-due?})
