(defmodule lsp-commands
  "The editor's side of a language server: jump to a definition and back, find references,
imenu, hover, signature help, code actions, rename, format — and the event folds that turn
the server's replies, notices, diagnostics and edits into the model. The connection itself
(the process, JSON-RPC, what to ask) is `lsp`; the request vocabulary both sides share is
`lsp-requests`, whose `LspRequest` fold impls live here."
  (:use minibuffer)
  (:use model) ; message / ed-current-buf / ed-set-buf / the diagnostics cache
  (:use pool) ; ed-find-file / ed-select / ed-name-prompt — the prompts and jumps a lookup ends in
  (:use editor/buffer) ; points, lines and the edits a server's answer applies
  (:use interactive) ; defcommand — the LSP commands, on M-x
  (:use lsp-requests) ; the request-kind records + the LspRequest ability folded here
  (:use lsp-servers)) ; the servers a lookup asks, and starting one

;; ---- starting a server, and asking it ------------------------------------------

(defn- ed-lsp-ensure (m)
  "Ensure a language server is connected for the current buffer's file. Returns
`[m' ready?]`: `ready?` is true when a LIVE connection is already on the model; false when
a server was just started (the command that asked runs again once its handshake is done,
[[ed-lsp-run-waiting]]) or there is nothing to start — no file, no server configured, the server not installed — with
an explanatory message already on `m'` (`ed-lsp-start` writes it)."
  (if (ed-lsp-live m)
    [m true]
    (let ([started conn] (ed-lsp-start (ed-lsp-drop-dead m)))
      (cond
        (nil? conn) [started false]
        ;; handed to a server already running for another project: it is ready now
        (not (empty? (map/get-in started [:lsp-servers conn :caps] {}))) [started true]
        ;; started, but the handshake has not finished: the command that asked runs again
        ;; when it does ([[ed-lsp-run-waiting]]), if you are still where you asked
        else
          [(message (map/assoc-in started
                      [:lsp-waiting conn]
                      {:command (:this-command m)
                       :at [(buffer-name (ed-current-buf m)) (buffer-point (ed-current-buf m))]})
             (str "lsp: starting "
               (map/get-in started [:lsp-servers conn :command])
               " — it will answer when it is up"))
            false]))))

(defn- ed-lsp-run-waiting (m conn)
  "The command a server's start interrupted ([[ed-lsp-ensure]]), run now its handshake is done —
when point is still where it was asked, in the same buffer; else only said, since a jump or a
list arriving somewhere you have moved on from would be a surprise."
  (let (waiting (map/get-in m [:lsp-waiting conn])
        cleared (if waiting (assoc m :lsp-waiting (dissoc (:lsp-waiting m) conn)) m)
        here [(buffer-name (ed-current-buf m)) (buffer-point (ed-current-buf m))]
        command (when waiting (:command waiting)))
    (cond
      (nil? waiting) m
      (and command (= (:at waiting) here)) ((reflect/eval command) cleared nil)
      else (message cleared "lsp: the server is up"))))

(sig ed-lsp-lookup (model any any string &optional (or nil (model -> model)) -> model))
(defn- ed-lsp-lookup (m feature kind note &optional (fallback nil))
  "Ask the server that offers `feature` the question `kind` (an `LspRequest` record) about the
symbol at point, starting a server first when none runs ([[ed-lsp-ensure]]); `note` is what
the echo area says while it is out. With no server for the file at all (none configured, or
not installed), `(fallback m)` answers instead — a search (`xrefgrep`)."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (cond
      (and (not ready?) fallback (nil? (ed-lsp-server ensured))) (fallback ensured)
      (not ready?) ensured
      else
        (let (context (ed-lsp-here ensured feature))
          (ed-lsp-ask-server ensured (:conn context) kind context nil note)))))

(defn- labeled-value (labeled label)
  ;; the value paired with `label` in the `[label value]` pairs `labeled`, or nil
  (let (hit (seq/find labeled (fn (pair) (= (first pair) label))))
    (when hit (second hit))))

;; ---- imenu: jump to a symbol in the buffer via LSP documentSymbol (M-g i) ----

(defn- ed-imenu-label (symbol)
  "The imenu candidate text for a symbol `{:name :kind …}` — its (qualified) name with a
short kind tag, e.g. `Foo.bar  (method)`."
  (str (:name symbol) "  (" (lsp-protocol/lsp-symbol-kind-name (:kind symbol)) ")"))

(defn- ed-imenu-jump (m symbol)
  "Move point to `symbol`'s position in the current buffer."
  (ed-apply m (fn (buffer) (ed-goto-lsp-position buffer (:line symbol) (:char symbol)))))

(defn- ed-imenu-prompt (m symbols)
  "A Vertico minibuffer over the buffer's `symbols` (`{:name :kind :line :char}`).
Moving the selection **previews** — point jumps to that symbol live (`:on-preview`);
accepting keeps it; cancelling restores the point and scroll the prompt opened from
(`:on-abort`), so an aborted imenu leaves you exactly where you were."
  (let (labeled (map symbols (fn (symbol) [(ed-imenu-label symbol) symbol]))
        labels (map labeled first)
        origin {:point (buffer-point (ed-current-buf m))
                :top (ed-current-top m)
                :top-row (ed-current-top-row m)})
    (assoc m
      :minibuffer
        (assoc (ed-name-prompt "Imenu: "
                 labels
                 (fn (mm label)
                   (let (symbol (labeled-value labeled label))
                     (if (nil? symbol)
                       (message mm (str "imenu: no such symbol: " label))
                       (ed-imenu-jump mm symbol)))))
          :on-preview
            (fn (mm label)
              (let (symbol (labeled-value labeled label))
                (if (nil? symbol) mm (ed-imenu-jump mm symbol))))
          :on-abort
            (fn (mm)
              (ed-set-start (ed-apply mm (fn (buffer) (goto-char buffer (:point origin))))
                (:top origin)
                (:top-row origin)))))))

(defcommand cmd-imenu
  (m key)
  "Jump to a symbol in the current buffer, picked from the language server's
`documentSymbol` list (M-g i). Starts the server on first use if one is configured for the
file type; symbols are nested-name-qualified (Emacs-style `Class.method`). Async — the
picker opens when the symbol list arrives. With no server for the file at all, the buffer's
parse lists them instead (`xrefgrep/imenu`)."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (cond
      (and (not ready?) (nil? (ed-lsp-server ensured))) (xrefgrep/imenu ensured)
      (not ready?) ensured
      else
        (let (file (buffer-file (ed-current-buf ensured))
              conn (:conn (ed-lsp-for ensured :documentSymbolProvider)))
          (ed-lsp-ask-server ensured
            conn
            (lsp-symbols)
            {:uri (lsp-protocol/lsp-path->uri file) :lang (lsp/lsp-language-id file)}
            nil
            "imenu: fetching symbols…")))))

;; ---- LSP navigation + edits: goto-def / back / references / hover / rename / format ----
;; All ASYNC (§E.2 — services never block the loop): a command registers a pending lookup
;; under a fresh corr (`ed-lsp-ask` → `:lsp-pending`) and fires the request; the conn's
;; tagged reply lands on the loop as an event (`ed-ev-lsp-reply`, registered in input.blsp)
;; and folds by corr — jump/show/apply happen when the answer ARRIVES, the echo says what's
;; in flight meanwhile, and C-g clears the table (a late reply drops as stale). Mutating
;; replies (format, rename) carry a rope guard: if the buffer changed while the server
;; worked, the edits are dropped with a message instead of applied against the wrong text.
;; `ed-lsp-here` packages the current buffer's (conn, uri, lang, line, char);
;; `ed-lsp-ensure` auto-starts the server on first use. Cross-file jumps open the target
;; with `ed-find-file` and push the jump stack (`pool/ed-push-jump`) so M-, returns.

(defn ed-ev-lsp-reply (m input textrows cols rows)
  "An LSP reply landing on the loop (`[:lsp-definition corr locs]`, `[:lsp-hover corr
s]`, …): fold its payload by corr against `:lsp-pending`; an unknown corr is a
stale/cancelled lookup (C-g, or a completion's bounded wait that already timed out)
and drops silently."
  (let (corr (nth input 1)
        pending (map/get-in m [:lsp-pending corr]))
    (if (nil? pending)
      m
      (lsp-request-fold pending
        (assoc m :lsp-pending (dissoc (:lsp-pending m) corr))
        (nth input 2)))))

(def *lsp-log-buffer*
  ;; where everything a language server says is kept, whole — lsp-mode's `*lsp-log*`,
  ;; eglot's events buffer. Never echoed by itself.
  "*lsp-log*")

(def *lsp-log-limit*
  ;; chars `*lsp-log*` keeps: Expert's Logger writes a line per file its indexer
  ;; touches, so a long session would otherwise grow the buffer without end
  2000000)

(defn- ed-lsp-echo (m notice)
  "Show one server `notice` the reader is meant to see ([[ed-ev-lsp-notices]]), unless it is
the line already on the echo area: a `showMessage` also goes to `*Messages*`, the way
Emacs's do; progress is transient — the echo area, not a `*Messages*` line per report."
  (let (echo (str "lsp: " (:line notice)))
    (cond
      ;; the same line again (a server repeating itself, a progress report that did not
      ;; change) — it is already in front of the reader
      (= (:echo m) echo) m
      (= (:channel notice) :show) (message m echo)
      else (assoc m :echo echo))))

(defn ed-ev-lsp-notices (m input textrows cols rows)
  "What a language server SAID since its connection last flushed (`[:lsp-notices notices]`,
`lsp-protocol/lsp-notice` maps, oldest first): all of it appended, whole, to `*lsp-log*` in ONE
append; echoed only where `lsp-protocol/lsp-notice-echo?` says the reader is meant to see it —
progress, and a `showMessage`.

A batch, not a notice per event: Expert's indexer logs a line per file it touches, and an
event per line would cost the loop a full turn each, the keys queued behind them.

The log is never echoed: it is a server's whole Logger, indexer errors included, and would
replace whatever the reader was looking at. A server's startup still shows — it arrives as
progress (`window.workDoneProgress`)."
  (let (notices (nth input 1)
        logged (ed-append-named m
                 *lsp-log-buffer*
                 (string/join (map notices lsp-protocol/lsp-notice-log-line) "\n")
                 *lsp-log-limit*))
    (fold (seq/filter notices lsp-protocol/lsp-notice-echo?) logged ed-lsp-echo)))

(defn ed-ev-lsp-diagnostics (m input textrows cols rows)
  "A language server publishing a file's diagnostics (`[:lsp-diagnostics path items raw conn]`)
— shown on that buffer, merged with what the file's other servers published (a main server
and an add-on both report on one file, and each publication replaces only its own).

This is what makes an LSP worth connecting for: the underline on the token, the ⚠ note at
the end of the line and the gutter mark, in every language a server checks.

An empty list is applied like any other: it is how a server says the file is clean now, and
ignoring it would leave the errors you just fixed sitting there.

Kept per file and server on `:lsp-diags` — `{path {conn [items raw]}}`, the raw objects
beside the rendered ones ([[ed-lsp-raw-diags]]): a quickfix is asked for by handing the
diagnostic back (see [[cmd-lsp-code-action]]), and bedit's flattened shape is not a thing a
server recognises. Kept only for a file that is OPEN: rust-analyzer publishes about its
whole workspace, and a server publishes again for a file when it is opened. Dropped from a
server no longer filed: a publication already queued when it was disconnected would
otherwise stay merged in for the rest of the session, with nothing able to replace it."
  (let (path (nth input 1)
        conn (nth input 4 nil)
        index (ed-buffer-index-by-file m path))
    (if (or (nil? index) (and conn (not (contains? (or (:lsp-servers m) {}) conn))))
      m
      ;; the server's columns are UTF-16 units: read on the open buffer's own lines
      (let (items (lsp-protocol/lsp-localize-diagnostics (nth input 2)
                    (buffer-rope (ed-buf-at m index))))
        (ed-lsp-show-diags (map/assoc-in m [:lsp-diags path conn] [items (nth input 3 [])]) path)))))

(defn ed-ev-lsp-capabilities (m input textrows cols rows)
  "A connected server reporting what it can do (`[:lsp-capabilities caps conn]`), kept on
its own entry in `:lsp-servers` — the one whose connection `conn` sent it. A server that is
no longer filed (disconnected meanwhile) has nowhere to keep them, and they are dropped.

Worth keeping for one reason: it is the difference between \"this server does not offer
that\" and a command that appears to do nothing. Expert advertises code actions, hover,
definition and references and does NOT advertise signature help — so the argument hints
are silent in Elixir and loud in Rust, and only its own answer here can say which.

Also the moment a shared server can say it takes more projects, so it is when two started
together are folded into one ([[ed-lsp-merge-into-host]])."
  (let (conn (nth input 2 nil))
    (if (contains? (or (:lsp-servers m) {}) conn)
      (ed-lsp-run-waiting (ed-lsp-merge-into-host (map/assoc-in m
                                                    [:lsp-servers conn :caps]
                                                    (nth input 1 {}))
                            conn)
        conn)
      m)))

(defn ed-ev-lsp-apply-edit (m input textrows cols rows)
  "A server asking to change files itself (`[:lsp-apply-edit wsedit]`) — what a code
action's `workspace/executeCommand` produces instead of carrying its edits inline.

Applied to whatever those files are, because that is the whole request: unlike a rename,
nothing here was computed against a buffer we can rope-guard — the action was chosen from
a list the server offered, and the server is the one that decided what it means. Files not
already open are opened to receive it, and every touched buffer is left modified for you
to read before saving."
  (let (wsedit (nth input 1)
        paths (keys wsedit))
    (if (empty? paths)
      m
      (message (fold paths m (fn (mm path) (ed-lsp-apply-file-edits mm path (get wsedit path))))
        (str "applied edits in " (count paths) " file(s)")))))

(defn- ed-lsp-here (m feature)
  "The LSP request context for the current buffer at point:
`{:conn :uri :lang :line :char}` (0-based line/char, LSP units), `:conn` the server to ask
for `feature` ([[ed-lsp-for]]). No text: the request is sent by [[ed-lsp-ask-server]],
which syncs the document first, incrementally."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer))
    {:conn (:conn (ed-lsp-for m feature))
     :uri (lsp-protocol/lsp-path->uri file)
     :lang (lsp/lsp-language-id file)
     :line (buffer-current-line buffer)
     :char (lsp-protocol/lsp-buffer-units buffer)}))

(defn- ed-goto-lsp-position (buffer line units)
  "Move point in `buffer` to the server's 0-based `line` / `units` (a UTF-16 column, converted on
that line by `lsp-protocol/lsp-units->column`)."
  (ed-goto-line-col buffer line (lsp-protocol/lsp-units->column (buffer-rope buffer) line units)))

(defn ed-lsp-goto-loc (m loc)
  "Jump to LSP location `loc` (`{:path :line :char}`), opening its file if needed; pushes
the location it leaves on the jump stack first (`ed-push-jump`), so M-, returns there. A large
file is read off the loop, point going to the location when it lands (`ed-find-file-then`)."
  (ed-find-file-then (ed-push-jump m)
    (:path loc)
    (fn (buffer) (ed-goto-lsp-position buffer (:line loc) (:char loc)))))

(defn- ed-lsp-loc-label (m loc)
  "A `relpath:line` label for a location (project-relative when possible) for the
references/definition picker."
  (str (projects/project-relative (:project-root m) (:path loc)) ":" (+ 1 (:line loc))))

(defn ed-lsp-locations-prompt (m prompt locs)
  "A Vertico minibuffer over LSP `locs`; the chosen one opens its file and jumps (M-, returns)."
  (let (labeled (map locs (fn (loc) [(ed-lsp-loc-label m loc) loc]))
        labels (map labeled first))
    (assoc m
      :minibuffer
        (ed-name-prompt prompt
          labels
          (fn (mm label)
            (let (loc (labeled-value labeled label))
              (if (nil? loc) (message mm "lsp: location gone") (ed-lsp-goto-loc mm loc))))))))

(defn- ed-lsp-origin (m pending)
  "The pool index of the buffer a mutating LSP request was made FROM (`:buffer` in
`pending`), but only while its rope still matches the request-time `:rope` — nil when
the buffer is gone or has changed (the edits were computed against text that no
longer exists; applying them would land misaligned). The ORIGIN buffer, not the
current one: the user may have switched buffers while the server worked."
  (let (index (ed-buffer-index-by-name m (:buffer pending)))
    (if (and index (= (buffer-rope (ed-buf-at m index)) (:rope pending)))
      index
      nil)))

;; The fold half of the `LspRequest` ability (see `lsp-requests`): an arrived reply's
;; payload folds into the model per kind — the action half of the commands below. Mutating kinds (formatting, rename) verify
;; the ORIGIN buffer (`ed-lsp-origin`, via the context merged onto the pending
;; record) still holds the rope the request was computed against, and apply to THAT
;; buffer — the user may be in another one by now. (Known limitation, as in most LSP
;; clients: a rename's edits to OTHER open files are guarded only by the origin
;; buffer; the LSP protocol's per-document versions would close that fully.) The ids
;; are written qualified — a bare id would qualify to THIS module.

(impl LspRequest
  lsp-requests/lsp-completion
  ;; a completion reply is awaited by its bounded synchronous wait (the Tab source),
  ;; never registered in `:lsp-pending` — folding is a no-op
  (lsp-request-fold (_ m payload) m))

(impl LspRequest
  lsp-requests/lsp-definition
  (lsp-request-fold (_ m payload)
    (cond
      (empty? payload) (message m "no definition found")
      (= (count payload) 1) (ed-lsp-goto-loc m (first payload))
      else (ed-lsp-locations-prompt m "Definition: " payload))))

(impl LspRequest
  lsp-requests/lsp-references
  (lsp-request-fold (_ m payload)
    (if (empty? payload)
      (message m "no references found")
      (ed-lsp-locations-prompt m "References: " payload))))

(impl LspRequest
  lsp-requests/lsp-hover
  (lsp-request-fold (_ m payload)
    (if (string/blank? payload) (message m "no hover info") (message m payload))))

(impl LspRequest
  lsp-requests/lsp-signature
  ;; The argument hint goes in the `:eldoc` slot, not the echo: `message` is what the
  ;; editor says to you and this is not the editor saying anything, it is the signature of
  ;; the call your cursor is in. The echo row shows it only when nothing louder is there
  ;; (`echoarea/ed-echo-or-eldoc`), which is exactly the precedence it should have.
  ;;
  ;; Dropped unless point is still where the question was asked from: an answer about a
  ;; call you have already typed past is worse than no answer, because it reads as being
  ;; about the one you are in now. A blank payload is applied, not dropped — it is how the
  ;; server says "you are not inside a call any more", and keeping the old hint there
  ;; would leave a signature under a cursor that has left it.
  (lsp-request-fold (pending m payload)
    (let (buffer (ed-current-buf m))
      (if (not (= [(buffer-point buffer) (buffer-rope buffer)] (:at pending)))
        m
        (assoc m :eldoc (if (string/blank? payload) nil payload))))))

(defn- ed-lsp-action-label (action n)
  "The picker label for a code `action` — its title, with its LSP `kind` after it and the
1-based ordinal `n` in front when the list needs it to tell two apart.

Titles are the server's prose and are not guaranteed distinct: Expert offers `Add alias`
once per candidate module. The picker matches the chosen row back to an action BY label,
so two identical rows would silently mean the first one."
  (str (if n (str n ". ") "")
    (:title action)
    (if (:kind action) (str "  [" (:kind action) "]") "")))

(defn- ed-lsp-action-rows (actions)
  "`[[label action] …]` for the code-action picker, numbering the rows only when two share
a title — an ordinal on every row would be noise on the common case of one or two."
  (let (titles (map actions :title)
        dup? (not (= (count (seq/distinct titles)) (count titles))))
    (into []
      (map (seq/enumerate actions)
        (fn ([position action]) [(ed-lsp-action-label action (when dup? (+ position 1))) action])))))

(defn- ed-lsp-run-action (m conn action)
  "Carry out one chosen code action: apply the edits it carries, and/or ask the server to
run the command it names. An action may be both (LSP allows it, and `organize imports`
often is), so neither arm excludes the other."
  (let (edit (:edit action)
        edited (if (or (nil? edit) (empty? edit))
                 m
                 (message (fold (keys edit)
                            m
                            (fn (mm path) (ed-lsp-apply-file-edits mm path (get edit path))))
                   (str (:title action) " — " (count (keys edit)) " file(s)"))))
    (if (nil? (:command action))
      edited
      (ed-lsp-ask-server edited
        conn
        (lsp-execute-command)
        {:command (:command action) :arguments (:arguments action)}
        nil
        (str (:title action) "…")))))

(impl LspRequest
  lsp-requests/lsp-code-actions
  ;; The picker rather than a straight apply, even for one action: a code action REWRITES
  ;; your file on the server's say-so, and "add missing import" and "delete this clause"
  ;; arrive through the same door. Reading the title first is the whole safety story.
  (lsp-request-fold (pending m payload)
    (if (empty? payload)
      (message m "lsp: no code actions here")
      (let (labeled (ed-lsp-action-rows payload)
            labels (map labeled first))
        (assoc m
          :minibuffer
            (ed-name-prompt "Code action: "
              labels
              (fn (mm label)
                (let (action (labeled-value labeled label))
                  (if (nil? action)
                    (message mm "lsp: action gone")
                    (ed-lsp-run-action mm (:conn pending) action))))))))))

(impl LspRequest
  lsp-requests/lsp-execute-command
  ;; Nothing to fold: the server answers `null` and sends its edits separately, as a
  ;; `workspace/applyEdit` request that lands on [[ed-ev-lsp-apply-edit]].
  (lsp-request-fold (_ m payload) (message m "lsp: action ran")))

(impl LspRequest
  lsp-requests/lsp-symbols
  (lsp-request-fold (_ m payload)
    (if (empty? payload)
      (message m "imenu: no symbols (is the server ready?)")
      (ed-imenu-prompt m payload))))

(impl LspRequest
  lsp-requests/lsp-formatting
  (lsp-request-fold (pending m payload)
    (let (index (ed-lsp-origin m pending))
      (cond
        (empty? payload) (message m "lsp: no formatting changes")
        (nil? index)
          (message m "lsp: buffer changed while formatting ran — dropped (re-run C-c C-f)")
        else
          (message (assoc m
                     :buffers
                       (assoc (:buffers m)
                         index (ed-apply-text-edits (ed-buf-at m index) payload)))
            "formatted")))))

(impl LspRequest
  lsp-requests/lsp-rename
  (lsp-request-fold (pending m payload)
    (cond
      (empty? payload) (message m "lsp: rename produced no changes")
      (nil? (ed-lsp-origin m pending))
        (message m "lsp: buffer changed while rename ran — dropped (re-run C-c C-r)")
      else (ed-lsp-apply-rename m pending payload))))

(defcommand cmd-goto-definition
  (m key)
  "Jump to the definition of the symbol at point (M-.); M-, returns. Picks among several
definitions via a minibuffer. Auto-starts the server on first use. Async — the jump
happens when the location arrives."
  (ed-lsp-lookup m
    :definitionProvider (lsp-definition)
    "resolving definition…"
    xrefgrep/find-definition))

(defcommand cmd-find-references
  (m key)
  "List every reference to the symbol at point and jump to the chosen one (M-?).
Async — the picker opens when the list arrives."
  (ed-lsp-lookup m
    :referencesProvider (lsp-references)
    "finding references…"
    xrefgrep/find-references))

(defn- ed-lsp-signature-ask (m note)
  "Fire a `textDocument/signatureHelp` for point and stamp the model with the position it
was asked from (`:signature-at`), so the same question is not asked twice and the answer
knows whether it is still about where the cursor is."
  (let (context (ed-lsp-here m :signatureHelpProvider)
        buffer (ed-current-buf m)
        at [(buffer-point buffer) (buffer-rope buffer)])
    (ed-lsp-ask-server (assoc m :signature-at at)
      (:conn context)
      (lsp-signature)
      context
      {:at at}
      note)))

(defn ed-signature-due? (m)
  "True when the LSP argument hint (`textDocument/signatureHelp`) is due a refresh: a LIVE
server that offers signature help, point or the text moved since the last ask
(`:signature-at`), and a buffer mode that does not answer for itself.

This is the idle job's `:stale?`, which is what keeps the beat ARMED — so it must be false
whenever the ask would not happen — a dead server, or one that never offered signature help,
would otherwise keep the beat firing on every debounce with nothing typed.

The mode's own `:eldoc` service wins where there is one, and not by seniority: it is
local, instant and always right about the language it was written for, whereas this costs
a round-trip. They share the `:eldoc` slot, so letting both write it would make the hint
depend on which reply landed last."
  (let (buffer (ed-current-buf m))
    (and (ed-lsp-live m)
      (lsp/lsp-capable? (ed-lsp-caps m :signatureHelpProvider) :signatureHelpProvider)
      (nil? (ed-mode-service buffer :eldoc))
      (not (= [(buffer-point buffer) (buffer-rope buffer)] (:signature-at m))))))

(defn ed-launch-signature (m)
  "The idle beat's argument hints: ask the connected language server what call point is
inside, and show its signature in the eldoc slot ([[ed-signature-due?]] decides when).

This is eglot's `eglot-signature-eldoc-function` and it is the feature that makes a server
worth having open while you TYPE rather than when you stop and ask a question — every
other LSP command here is one you invoke. Silent in every direction: it never starts a
server (`ed-lsp-autostart` owns that), never messages, and a server that does not offer
signature help is never asked — Expert is one, so in Elixir this costs exactly nothing."
  (if (or (ed-headless?) (not (ed-signature-due? m)) (nil? (buffer-file (ed-current-buf m))))
    m
    (ed-lsp-signature-ask m :quiet)))

(defcommand cmd-lsp-code-action
  (m key)
  "Offer the language server's fixes for the code at point and run the chosen one (C-c C-a).

Emacs' `eglot-code-actions`. The diagnostics on the current line go WITH the request —
that is how a server knows which quickfix you mean, and without them most servers answer
with their unconditional refactorings only, which reads as the fix for the error under
your cursor not existing."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (if (not ready?)
      ensured
      (let (context (ed-lsp-here ensured :codeActionProvider)
            file (buffer-file (ed-current-buf ensured))
            offering (seq/filter (lsp/lsp-live-entries ensured file)
                       (fn (entry) (lsp/lsp-capable? (:caps entry) :codeActionProvider)))
            ;; the diagnostics at point that a server published itself: a quickfix is
            ;; asked of the server whose finding it fixes (ruff's, not pyright's)
            diags-of (fn (entry)
                       (lsp-protocol/lsp-diagnostics-at-line (ed-lsp-raw-diags ensured
                                                               file
                                                               (:key entry))
                         (:line context)))
            ;; …else the first that offers them, else the main server, which has not said
            ;; yet what it offers when its caps are still empty, and may answer anyway
            entry (or (seq/find offering (fn (entry) (not (empty? (diags-of entry)))))
                    (first offering)
                    (ed-lsp-for ensured :codeActionProvider)))
        (cond
          (nil? entry) (message ensured "lsp: no server is running for this buffer")
          ;; said plainly once it HAS said, because the alternative is a key that appears
          ;; to do nothing
          (and (empty? offering) (not (empty? (or (:caps entry) {}))))
            (message ensured "lsp: this server does not offer code actions")
          else
            (ed-lsp-ask-server ensured
              (:conn entry)
              (lsp-code-actions)
              (assoc context :conn (:conn entry) :diags (diags-of entry))
              {:conn (:conn entry)}
              "code actions…"))))))

(defcommand cmd-lsp-signature-help
  (m key)
  "Show the signature of the call point is inside, in the echo area (C-c C-s).

Normally you never press this — the idle beat asks the same question as you type
(`ed-launch-signature`). It is here for the buffer whose mode answers eldoc itself, where
the automatic path stands back, and for asking again after a message has covered the hint."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (cond
      (not ready?) ensured
      ;; said plainly, because the alternative is a key that appears to do nothing
      (not (lsp/lsp-capable? (ed-lsp-caps ensured :signatureHelpProvider) :signatureHelpProvider))
        (message ensured "lsp: this server does not offer signature help")
      else (ed-lsp-signature-ask ensured "signature…"))))

(defcommand cmd-lsp-hover
  (m key)
  "Show the type / signature / docs of the symbol at point in the echo area (C-c C-d).
Async — the docs show when they arrive."
  (ed-lsp-lookup m :hoverProvider (lsp-hover) "hover…"))

(sig ed-edit-offsets
  (buffer (record &open :start-line int :start-char int :end-line int :end-char int :text string)
    ->
    (record :start int :end int :text string)))
(defn- ed-edit-offsets (buffer edit)
  "The char-offset form `{:start :end :text}` of normalised LSP `edit` in `buffer`
(offsets computed against the original buffer, clamped to its length). The edit's columns
are UTF-16 units, turned into characters on their own lines — a formatter's edit after an
emoji would otherwise land a character late per emoji."
  (let (rope (buffer-rope buffer)
        size (buffer-length buffer)
        offset (fn (line units)
                 (+ (text/line->char rope line) (lsp-protocol/lsp-units->column rope line units)))
        start (offset (:start-line edit) (:start-char edit))
        end (offset (:end-line edit) (:end-char edit)))
    {:start (math/min start size) :end (math/min end size) :text (:text edit)}))

(defn- ed-apply-text-edits (buffer edits)
  "Apply LSP `edits` to `buffer`. Offsets are resolved against the original buffer, then
applied last-position-first so each replace can't shift the offsets of edits still to come."
  (let (offsets (map edits (fn (edit) (ed-edit-offsets buffer edit)))
        sorted (sort offsets (fn (left right) (> (:start left) (:start right))))
        edited (fold sorted
                 buffer
                 (fn (current edit) (replace-region current (:start edit) (:end edit) (:text edit)))))
    (goto-char edited (math/min (buffer-point buffer) (buffer-length edited)))))

(defcommand cmd-lsp-format-buffer
  (m key)
  "Format the current buffer via the language server (C-c C-f). Async, rope-guarded:
the edits apply when they arrive iff the buffer hasn't changed meanwhile."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (if (not ready?)
      ensured
      (let (context (ed-lsp-here ensured :documentFormattingProvider)
            buffer (ed-current-buf ensured))
        (ed-lsp-ask-server ensured
          (:conn context)
          (lsp-formatting)
          context
          {:rope (buffer-rope buffer) :buffer (buffer-name buffer)}
          "formatting…")))))

(defn- ed-lsp-apply-rename (m pending wsedit)
  "Apply an arrived rename's workspace edit across every affected file, returning to
the buffer/point the rename started in (`:buffer`/`:point` captured in `pending`)."
  (let (paths (keys wsedit)
        applied (fold paths
                  m
                  (fn (mm path)
                    (ed-lsp-apply-file-edits mm path (get wsedit path))))
        returned (ed-return-to applied (:buffer pending) (:point pending)))
    (message returned (str "renamed in " (count paths) " file(s)"))))

(defn- ed-lsp-apply-file-edits (m path edits)
  "Open `path` and apply LSP `edits` to its buffer (left modified for the user to save)."
  (ed-edit-file m path (fn (buffer) (ed-apply-text-edits buffer edits))))

(defn- ed-lsp-do-rename (m new-name)
  "Fire the rename request for the symbol at point → `new-name` (async); the workspace
edit applies when it arrives (`lsp-request-fold` on `lsp-rename`), rope-guarded against edits made
while the server worked, returning to the origin buffer/point."
  (let (context (ed-lsp-here m :renameProvider)
        buffer (ed-current-buf m))
    (ed-lsp-ask-server m
      (:conn context)
      (lsp-rename)
      (assoc context :new-name new-name)
      {:rope (buffer-rope buffer) :buffer (buffer-name buffer) :point (buffer-point buffer)}
      "renaming…")))

(defcommand cmd-lsp-rename
  (m key)
  "Rename the symbol at point across the workspace (C-c C-r); prompts for the new name and
applies the edits to every affected file (left modified for you to save)."
  (let ([ensured ready?] (ed-lsp-ensure m))
    (if (not ready?)
      ensured
      (assoc ensured
        :minibuffer
          {:edit (ed-mb-edit "Rename to: " "")
           :on-complete (fn (mm new-name)
                          (if (string/blank? new-name)
                            (message mm "rename cancelled")
                            (ed-lsp-do-rename mm new-name)))}))))
;; ---- inlay hints: types and parameter names shown inside the line -------------------
;; Eglot's `eglot-inlay-hints-mode`: the server's `textDocument/inlayHint` for the lines on
;; screen, asked on the idle beat once the text and the view have settled, shown as INLINE
;; annotations (`inlinetext`, owner `:lsp-inlay`) in the dim hint voice — never buffer text,
;; so they take cells but no chars. Opt-in, as eglot's is: the init file's `:lsp-inlay-hints`
;; per mode, or M-x lsp-inlay-hints-mode for one buffer. Between an edit and the next answer
;; the hints already shown ride their markers; the answer replaces them whole.

(def *inlay-owner* :lsp-inlay)

(defn ed-inlay-hints-on? (m buffer)
  "Whether `buffer` shows its server's inlay hints: its own toggle (M-x
lsp-inlay-hints-mode) when it has one, else the init file's `:lsp-inlay-hints` for its mode
(a directory file's first, `scroll/ed-local-setting`), off by default."
  (let (own (:lsp-inlay-hints buffer))
    (if (or (= own true) (= own false))
      own
      (= true (scroll/ed-local-setting :lsp-inlay-hints (:lsp-inlay-hints m) buffer false)))))

(defn- ed-inlay-lines (m)
  ;; `[first last]` — the lines the selected pane shows (its top and the rows below it)
  (let (top (ed-current-top m)) [top (+ top (or (:view-rows m) 50))]))

(defn ed-inlay-hints-due? (m)
  "True when the current buffer's inlay hints want asking for: they are on
([[ed-inlay-hints-on?]]), it has a file and a live server that offers them, and the text or
the lines on screen moved since the last ask (`:inlay-hints-at`). The idle job's `:stale?`,
so a buffer with hints off — or a server without them — never keeps the beat armed."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer))
    (and file
      (ed-inlay-hints-on? m buffer)
      (ed-lsp-live m)
      (lsp/lsp-capable? (ed-lsp-caps m :inlayHintProvider) :inlayHintProvider)
      (not (= [file (buffer-rope buffer) (ed-inlay-lines m)] (:inlay-hints-at m))))))

(defn ed-launch-inlay-hints (m)
  "The idle beat's inlay hints: ask the server for the lines on screen
([[ed-inlay-hints-due?]] decides when), stamping `:inlay-hints-at` with the file, text and
lines asked about. Quiet: never starts a server, never messages. Off the loop, as every
lookup is — the answer folds in [[ed-apply-inlay-hints]]."
  (if (or (ed-headless?) (not (ed-inlay-hints-due? m)))
    m
    (let (buffer (ed-current-buf m)
          lines (ed-inlay-lines m))
      (ed-inlay-request-at (assoc m
                             :inlay-hints-at [(buffer-file buffer) (buffer-rope buffer) lines])
        (ed-current-index m)
        (:conn (ed-lsp-for m :inlayHintProvider))
        lines))))

(defn ed-inlay-request-at (m index connection lines)
  "Ask `connection` for the inlay hints of pool buffer `index`'s `lines` (`[first last]`),
quietly; the answer folds onto that buffer ([[ed-apply-inlay-hints]]), whichever pane shows
it — the idle beat asks for the current one, a server's refresh for each on screen."
  (let (buffer (ed-buf-at m index)
        file (buffer-file buffer)
        ;; `:inlay-asked`, per file: the ask the answer must be — one asked while the server
        ;; was still loading that lands after a newer one is dropped, not painted over it
        token (ref))
    (ed-lsp-ask-server-at (map/assoc-in m [:inlay-asked file] token)
      index
      connection
      (lsp-inlay-hints)
      (merge {:uri (lsp-protocol/lsp-path->uri file) :lang (lsp/lsp-language-id file)}
        (inlay-range (buffer-rope buffer) lines))
      {:at [file (buffer-rope buffer) lines] :token token}
      :quiet)))

(defn inlay-range (rope lines)
  "The range an inlay-hint request for `lines` (`[first last]`, a pane's top and its rows) asks
about in `rope`: `{:lines [first last]}`, cut to the text's lines, with `:end-units` — the last
line's length in UTF-16 units — when the range reaches the text's last line, so it never ends
at a position past the text (rust-analyzer answers that with `Invalid offset` and no hints).

    (lsp-commands/inlay-range (text/string-> \"ab\\ncd\") [0 48])   ;=> {:lines [0 1] :end-units 2}
    (lsp-commands/inlay-range (text/string-> \"a\\nb\\nc\\n\") [0 0])   ;=> {:lines [0 0] :end-units nil}"
  (let (final (math/max 0 (dec (text/line-count rope)))
        first-line (math/min final (math/max 0 (first lines)))
        last-line (math/min final (math/max first-line (second lines))))
    {:lines [first-line last-line]
     :end-units (when (= last-line final)
                  (lsp-protocol/lsp-column->units rope
                    last-line
                    (string/length (wrap/rope-line-text rope last-line))))}))

(defn ed-inlay-annotations (rope hints)
  "The server's `hints` (`lsp-protocol/lsp-inlay-hint-list`) as inline annotations over
`rope` — `{:at offset :text}`, each line's UTF-16 column converted to a char offset
(`lsp-protocol/lsp-units->column`). A hint on a line the text no longer has is dropped."
  (into []
    (seq/keep hints
      (fn (hint)
        (let (line (:line hint)
              units (:units hint))
          (when (and (int? line) (int? units) (>= line 0) (< line (text/line-count rope)))
            {:at (+ (text/line->char rope line) (lsp-protocol/lsp-units->column rope line units))
             :text (:text hint)}))))))

(defn ed-apply-inlay-hints (m at hints)
  "Fold an inlay-hint answer asked `at` (`[file rope lines]`) into the model: the `:lsp-inlay`
annotations of the buffer visiting that file replaced by `hints` — only while it is still at
that text, with its hints on. An answer about text that has moved since is dropped (the next
idle beat asks again), as one for a file no longer open is."
  (let ([file rope _lines] at
        index (when (string? file) (ed-buffer-index-by-file m file)))
    (if (nil? index)
      m
      (let (buffer (ed-buf-at m index))
        (if (and (= (buffer-rope buffer) rope) (ed-inlay-hints-on? m buffer))
          (ed-set-buf-at m
            index
            (inlinetext/set-annotations buffer *inlay-owner* (ed-inlay-annotations rope hints)))
          m)))))

(defn ed-ev-inlay-refresh (m input text-rows columns rows)
  "A server asking for its inlay hints again (`[:lsp-refresh-inlay-hints connection]`,
`workspace/inlayHint/refresh` — rust-analyzer once the crate has loaded): each buffer of its
on screen with hints on is asked for the lines its pane shows, and the idle beat's stamp is
forgotten, so the current one is asked again however it moves."
  (let (connection (nth input 1 nil)
        forgotten (dissoc m :inlay-hints-at))
    (fold (ed-lsp-shown forgotten connection)
      forgotten
      (fn (acc [index top])
        (let (buffer (ed-buf-at acc index)
              entry (lsp/lsp-entry-for acc (buffer-file buffer) :inlayHintProvider))
          (if (and (ed-inlay-hints-on? acc buffer)
                (= (:conn entry) connection)
                (lsp/lsp-capable? (:caps entry) :inlayHintProvider))
            (ed-inlay-request-at acc index connection [top (+ top (or (:view-rows acc) 50))])
            acc))))))

(impl LspRequest
  lsp-requests/lsp-inlay-hints
  (lsp-request-fold (pending m payload)
    (cond
      (not (= (:token pending) (map/get-in m [:inlay-asked (first (:at pending))]))) m
      ;; the server said ask again (`lsp-protocol/lsp-retry?`): the idle beat's stamp forgotten,
      ;; so the current buffer is asked on the next beat
      (= payload :lsp-retry) (dissoc m :inlay-hints-at)
      else (ed-apply-inlay-hints m (:at pending) payload))))

(defcommand cmd-lsp-inlay-hints-mode
  (m key)
  "Toggle the language server's inlay hints in this buffer (Emacs `eglot-inlay-hints-mode`):
parameter names and inferred types shown inside the line, never in the text. Off, the
hints shown go at once; on, the next idle beat asks for the lines on screen."
  (let (buffer (ed-current-buf m)
        on? (not (ed-inlay-hints-on? m buffer))
        toggled (assoc buffer :lsp-inlay-hints on?))
    (message (ed-set-buf (dissoc m :inlay-hints-at)
               (if on? toggled (inlinetext/clear toggled *inlay-owner*)))
      (if on? "lsp-inlay-hints-mode on" "lsp-inlay-hints-mode off"))))

;; ---- registration: the events and idle-beat jobs this module owns ----------------
;; Registered at load, so neither the dispatcher's event table nor its idle beat names a
;; language server. Every `:lsp-…` event comes from a connection `ed-lsp-start` made, so none
;; can arrive before these rows exist.

;; async LSP replies (corr-matched against :lsp-pending; stale ones drop) — the
;; navigation/edit commands fire and forget, the answer folds here on arrival.
;; `:lsp-completion` is only ever stale by the time it reaches the loop: completion's
;; bounded wait consumes the live ones.
(doseq (tag [:lsp-definition
              :lsp-references :lsp-hover :lsp-signature :lsp-code-actions
              :lsp-command-done :lsp-symbols :lsp-text-edits :lsp-workspace-edit :lsp-completion])
  (register-event-handler tag 'lsp-commands/ed-ev-lsp-reply))
;; not replies to anything — the server narrating its own startup, and telling us where
;; the errors are — the second most of the reason to run a language server at all.
(register-event-handler :lsp-notices 'lsp-commands/ed-ev-lsp-notices)
(register-event-handler :lsp-diagnostics 'lsp-commands/ed-ev-lsp-diagnostics)
(register-event-handler :lsp-completion 'lsp/ed-ev-lsp-completion)
;; …and the server asking to change files itself — a code action's command, whose edits
;; come back as a request TO us rather than as the reply to anything
(register-event-handler :lsp-apply-edit 'lsp-commands/ed-ev-lsp-apply-edit)
;; …and what it says it can do, so a command can say "this server does not offer that"
(register-event-handler :lsp-capabilities 'lsp-commands/ed-ev-lsp-capabilities)

;; The idle beat: after lsp-servers' autostart (20) and text push (30), ask for the signature at
;; point. It follows eldoc (order 40), whose `:eldoc` slot it shares and which wins when the
;; mode answers for itself.
(register-idle-job :lsp-signature
  {:order 50
   :run 'lsp-commands/ed-launch-signature
   :stale? 'lsp-commands/ed-signature-due?})

;; …and the inlay hints for the lines on screen, after the signature (50): the same settled
;; text, asked once it has stopped moving
(register-event-handler :lsp-inlay-hints 'lsp-commands/ed-ev-lsp-reply)
(register-event-handler :lsp-refresh-inlay-hints 'lsp-commands/ed-ev-inlay-refresh)
(register-idle-job :lsp-inlay-hints
  {:order 55
   :run 'lsp-commands/ed-launch-inlay-hints
   :stale? 'lsp-commands/ed-inlay-hints-due?})
