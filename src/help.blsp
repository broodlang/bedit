;; help.blsp — the C-h map: what is bound, what is on, what a name means.
;;
;; bedit registers several hundred interactive commands and composes its keymap from a buffer's mode
;; layers over the model's profile layers. An editor you are meant to REDEFINE at runtime has to
;; be able to tell you what it currently does — discoverability is the precondition for the
;; self-editing story.
;;
;; Everything that reports a BINDING goes through `editor/layers/scope-bindings`, which
;; walks the layer stack in dispatch order and returns each binding with the layer it came
;; from and what shadows it. That is the point: help derived beside the dispatcher drifts
;; from it and then lies, and a keymap help that lies is worse than none because it is
;; believed. `scope-bindings` is the same prefix-merging rule `scope-binding` dispatches
;; through, so "in force" here means reachable there, by construction.
(defmodule help
  "The help system: `C-h b` every binding grouped by the layer that owns it (shadowed ones
shown, and marked), `C-h m` the active modes, `C-h w` where a command is bound, `C-h a`
apropos over the command registry, `C-h l` the keys you last pressed, `C-h ?` the help map
itself, `C-h k` what one key does, `C-h f` a function's whole *Help* page (doc, keys,
signature, module), `C-h v` an init.blsp setting's (doc, type, default, the value in effect and
where it came from), `C-h P` a package's (installed, version, settings, themes). Reports bindings
through `editor/layers/scope-bindings`, so what help
says is what dispatch does."
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use minibuffer)
  (:use model) ; message
  (:use pool) ; ed-show-named — the report buffer
  (:use interactive) ; defcommand / command-names / command-sym
  (:use editor/layers) ; scope-bindings / active-layers / scope-keymap — the layer stack with provenance
  (:use userkeys :only [ed-key-binding]) ; C-h k resolves a key as dispatch does
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; C-h k reads the next chord
  (:use packages :only [package-info])) ; C-h P — loaded with help, so its page never meets an unloaded module

;; ---- the binding report ----------------------------------------------------

(defn- help-scope (m)
  "The scope contexts help reports on — `userkeys/ed-scope`, the very list the dispatcher
resolves through, asked rather than restated so the two cannot drift."
  (userkeys/ed-scope m))

(defn- help-decorate (entries)
  "`entries` with `:label` (the key sequence as an Emacs label) and `:name` (the command's
M-x name) computed ONCE each — the sort key, the column width and the row all read them, and
labelling costs ~25 µs a key (`keyhelp/ed-key-table`), so it is never done in the formatter."
  (map entries
    (fn (entry)
      (assoc entry
        :label (ed-keys-label (:sequence entry))
        ;; the M-x name, not the function's — `find-file`, not `cmd-find-file`. A reader
        ;; who finds a command here wants to type it into M-x, and `cmd-` is the one part
        ;; of the symbol that would stop them
        :name (command-friendly-name (ed-command-tail (:command entry)))))))

(defn- help-key-width (decorated)
  "The key column's width for DECORATED entries: the widest label plus two, at least 8."
  (fold decorated 8 (fn (widest entry) (math/max widest (+ 2 (count (:label entry)))))))

(defn- help-binding-row (entry key-width)
  "One DECORATED entry as a report line: the key sequence, the command's M-x name, and —
for a shadowed binding — which layer took the chord away from it."
  (let (label (:label entry)
        pad (string/repeat " " (math/max 1 (- key-width (count label))))
        shadow (:shadowed-by entry))
    (str "  "
      label
      pad
      (:name entry)
      (if (nil? shadow) "" (str "   (shadowed by " (->string shadow) ")")))))

(defn- help-by-layer (entries)
  "DECORATED `entries` grouped into `[layer-name rows]` pairs, layers in precedence order
(highest first) and each layer's rows sorted by key label. Grouping is by LAYER rather than
by key because that is the question being asked: a binding you did not expect is explained
by which layer owns it, and the layers are already in the order that decides who wins."
  (let (order (seq/distinct (map entries :layer)))
    (map order
      (fn (layer)
        [layer (seq/sort-by (seq/filter entries (fn (entry) (= (:layer entry) layer))) :label)]))))

(sig help-bindings-text (seqable -> string))
(defn help-bindings-text (entries)
  "The *Bindings* buffer text for `scope-bindings` `entries`: a section per layer, highest
precedence first, each row `key   command`, with a shadowed row saying who shadowed it.

Shadowed bindings are LISTED, not filtered out. A binding that silently vanished is the
single hardest thing to debug about a layered keymap, and the answer — some layer above took
the whole chord — is exactly what this line says."
  (let (decorated (help-decorate entries)
        width (help-key-width decorated)
        groups (help-by-layer decorated))
    (string/join (map groups
                   (fn (group)
                     (let ([layer rows] group)
                       (string/join (cons (str (->string layer)
                                            " layer  ("
                                            (ed-count-noun (count rows) "binding")
                                            ")")
                                      (map rows (fn (entry) (help-binding-row entry width))))
                         "\n"))))
      "\n\n")))

(defcommand cmd-describe-bindings
  (m key)
  "List every key binding in force, grouped by the layer that owns it (C-h b). Shadowed
bindings are shown too, marked with the layer that took their chord — Emacs's
`describe-bindings`, plus the provenance a layered keymap needs it to have."
  (let (entries (scope-bindings (help-scope m)))
    (ed-show-named m
      "*Bindings*"
      (str "Key bindings in force, highest-precedence layer first.\n"
        "A shadowed binding is unreachable: some layer above owns its chord.\n\n"
        (help-bindings-text entries)
        "\n")
      :help)))

(sig binding-layer (model vector -> any))
(defn binding-layer (m sequence)
  "The name of the layer that binds key `sequence` in force, or nil when nothing does —
`C-h k`'s \"why this command and not the one I expected\".

Asked of `scope-bindings` rather than worked out from the keymap, for the reason the whole
file exists: this must be the layer dispatch actually took the binding from, not the layer
that looks like it should have."
  (let (hit (seq/find (scope-bindings (help-scope m))
              (fn (entry) (and (nil? (:shadowed-by entry)) (= (:sequence entry) sequence)))))
    (if (nil? hit) nil (:layer hit))))

;; ---- the active modes ------------------------------------------------------

(defn- help-layer-doc (layer)
  "A layer's one-line description for `C-h m`: its `:doc` when it declares one, else the
count of keys it binds — something true rather than a blank."
  (let (doc (:doc layer))
    (if (string? doc)
      (ed-first-line doc)
      (ed-count-noun (count (editor/keymap/keymap-bindings (or (:keymap layer) {}))) "binding"))))

(sig help-mode-text (seqable seqable -> string))
(defn help-mode-text (layers entries)
  "The *Modes* buffer text: the active layers highest-precedence first, each with its
description and the bindings it contributes that are actually in force."
  (let (decorated (help-decorate entries))
    (string/join (map layers
                   (fn (layer)
                     (let (name (:name layer)
                           mine (seq/filter decorated
                                  (fn (entry)
                                    (and (= (:layer entry) name) (nil? (:shadowed-by entry)))))
                           width (help-key-width mine))
                       (string/join (append (list (str (->string name) " — " (help-layer-doc layer)))
                                      (map (seq/sort-by mine :label)
                                        (fn (entry) (help-binding-row entry width))))
                         "\n"))))
      "\n\n")))

(defcommand cmd-describe-mode
  (m key)
  "Describe the modes active in this buffer (C-h m): every layer in the stack, highest
precedence first, with what it is and the keys it contributes that are in force."
  (let (layers (active-layers {:layers (compose-layers (help-scope m))})
        entries (scope-bindings (help-scope m)))
    (ed-show-named m
      "*Modes*"
      (str "Active layers for this buffer, highest precedence first.\n\n"
        (help-mode-text layers entries)
        "\n")
      :help)))

;; ---- describe-key (C-h k) ---------------------------------------------------

(defcommand cmd-describe-key
  (m key)
  "Describe the next key sequence (C-h k): read a key (or chord) and report, in the echo
area, the command it runs and the first line of its docstring. Handled by the describe-key
overlay below; Esc/C-g aborts."
  (assoc (message m "Describe key: ") :describe-key {:pending nil :keys []}))

(defn ed-describe-key-step (m input)
  "One key of a C-h k key sequence: resolve `input` through the active keymap (descending
into a pending prefix). On a command, report its name + first docstring line; on a prefix,
keep reading; on an unbound key, say so. Esc/C-g aborts."
  (if (ed-cancel-key? input)
    (message (dissoc m :describe-key) "quit")
    (let (state (:describe-key m)
          keys (append (:keys state) (list input))
          binding (if (nil? (:pending state)) (ed-key-binding m input) (get (:pending state) input)))
      (cond
        (map? binding) (assoc m :describe-key (assoc state :pending binding :keys keys))
        ;; M-x global-set-key / local-set-key read the key the same way, then ask what to run
        (:set-key state)
          (ed-set-key-read-command (dissoc m :describe-key) (:set-key state) (vec keys))
        (nil? binding) (message (dissoc m :describe-key) (str (ed-keys-label keys) " is undefined"))
        else
          (message (dissoc m :describe-key)
            (str (ed-keys-label keys)
              " runs "
              (ed-cmd-label binding)
              ;; which LAYER bound it — the half of `C-h k` that answers "why this and not
              ;; the one I expected". `binding-layer` asks `scope-bindings`, the same
              ;; walk dispatch resolved through a moment ago, so the two cannot disagree.
              (let (layer (binding-layer m (vec keys)))
                (if (nil? layer) "" (str " (" (->string layer) " layer)")))
              (let (doc (ed-doc binding)) (if doc (str " — " (ed-first-line doc)) ""))))))))

(defrecord describe-key-overlay ()) ; C-h k: the next key sequence is described, not executed
(impl Overlay
  describe-key-overlay
  (overlay-active? (_ m) (:describe-key m))
  ;; no overlay-owns? — capture-all: the whole next chord is ours to resolve
  (overlay-handle (_ m input) (ed-describe-key-step m input)))

(register-overlay :describe-key 10 (describe-key-overlay))

;; ---- global-set-key / local-set-key: a binding made live ------------------------------
;; Emacs's `global-set-key` and `local-set-key`: read a key sequence as C-h k does (its
;; overlay, a `:set-key` scope on its state), then a command by its M-x name. The binding
;; goes into `:user-keys` — the layer amendments init.blsp's `:keys` / `:mode-keys` make
;; (`userkeys/ed-session-bind`) — so C-h k and where-is report it as dispatch runs it, and a
;; reload keeps it unless init.blsp now binds that key itself.

(defcommand cmd-global-set-key
  (m key)
  "Bind a key everywhere for this session (Emacs's `global-set-key`): read a key sequence,
then the command to run, by its M-x name. Esc/C-g aborts. M-x reload-config keeps the binding
unless init.blsp binds that key; `:keys` there makes it last."
  (assoc (message m "Set key globally: ") :describe-key {:pending nil :keys [] :set-key :global}))

(defcommand cmd-local-set-key
  (m key)
  "Bind a key in this buffer's MODE for this session (Emacs's `local-set-key`, which binds in
the major mode's map): read a key sequence, then the command to run, by its M-x name.
Esc/C-g aborts. `:mode-keys` in init.blsp makes it last."
  (let (mode (ed-buf-mode-name (ed-current-buf m)))
    (if (= mode "")
      (message m "this buffer has no mode to bind a key in")
      (assoc (message m (str "Set key in " (userkeys/ed-user-mode-name mode) " mode: "))
        :describe-key {:pending nil :keys [] :set-key (userkeys/ed-user-mode-name mode)}))))

(defn- set-key-scope-label (scope) (if (= scope :global) "globally" (str "in " scope " mode")))

(defn ed-set-key-read-command (m scope sequence)
  "Ask, in the minibuffer, for the command key `sequence` should run in `scope` (`:global` or
a mode's name), then bind it for the session (`userkeys/ed-session-bind`) and say so."
  (let (label (ed-keys-label sequence))
    (assoc m
      :minibuffer
        (assoc (ed-name-prompt (str "Set key "
                                 label
                                 " "
                                 (set-key-scope-label scope)
                                 " to command: ")
                 (interactive/command-names)
                 (fn (mm text)
                   (let ([bound problem] (userkeys/ed-session-bind mm scope sequence text))
                     (if problem
                       (message mm (str label " not bound: " problem))
                       (message bound
                         (str label
                           " runs "
                           (string/trim text)
                           " "
                           (set-key-scope-label scope)
                           " (this session)"))))))
          :category :command))))

;; ---- describe-function (C-h f) --------------------------------------------------
;; Emacs's *Help* page for a function: what it is, where it lives, the keys that run it, how
;; it is called, and the WHOLE docstring. Everything here is asked of the image (`reflect/*`) and of the dispatcher's
;; own binding report, so it describes what will run, not what a table says should.

(defn- help-row (label value)
  "One `  Label      value` line of a *Help* page's summary block, or nil when `value` is."
  (when (and (not (nil? value)) (not (= value "")))
    (str "  " label (string/repeat " " (math/max 1 (- 11 (count label)))) value)))

(defn- help-function-symbol (name)
  "The symbol `name` (typed at C-h f) describes: the command registered under it, else the
global it names when that is bound (a qualified `string/join`, loading its module as a
qualified reference would) — nil when it names neither."
  (or (command-sym name)
    (let (sym (symbol name))
      ;; check-allow: a name that does not resolve — a typo, a module that does not load — is
      ;; the answer `nil`, said by the caller as "no function"
      (check-allow :discarded-catch
        (when (try (reflect/resolves? sym) (catch _ false)) sym)))))

(defn- help-module-of (sym)
  "The module a qualified global belongs to — everything before its last `/` — or nil for a
bare (prelude / builtin) name."
  (let (text (->string sym)
        parts (string/split text "/"))
    (if (< (count parts) 2) nil (string/join (seq/drop-last parts 1) "/"))))

(defn- help-location (sym)
  "`file:line` where `sym` was defined (the home as `~`), or nil (a builtin, or a module loaded from the
startup image rather than its source)."
  (let (location (reflect/source-location sym))
    (when (and (vector? location) (>= (count location) 2))
      (str (path/abbreviate (first location)) ":" (second location)))))

(defn- help-arglist (sym)
  "The parameter list `sym` was defined with, printed — nil when it has none to report."
  ;; check-allow: `reflect/arglist` is a special form over a symbol, so it is built and
  ;; evaluated; a global that is not a function (a value, a macro) has no arglist to show
  (check-allow :discarded-catch
    (let (arglist (try (reflect/eval (list 'reflect/arglist sym)) (catch _ nil)))
      (if (nil? arglist) nil (pr-str arglist)))))

(defn- help-signature (sym)
  "`[text declared?]` — the contract a `sig` declared for `sym`, else the checker's inferred
type for it, else nil."
  (let (declared (reflect/declared-signature sym))
    (if (string? declared)
      [declared true]
      (let (inferred (reflect/type-signature sym)) (if (string? inferred) [inferred false] nil)))))

(defn- help-kind (name sym)
  "What `sym` is, as the page's heading says it: an interactive command (with its M-x name)
or a function."
  (if (= (command-sym name) sym)
    (str name " is an interactive command")
    (str (->string sym) " is a function")))

(defn describe-function-text (m name sym)
  "The *Help* page for the function `sym`, reached as `name` (its M-x name for a command):
what it is, its module and where it was defined, the keys in force that run it (the
dispatcher's own report), its parameters, its signature — declared, or the checker's
inference, marked so — and its FULL docstring, with `\\[command]` holes showing the live key."
  (let (entries (scope-bindings (help-scope m))
        keys (help-keys-for entries name)
        command? (= (command-sym name) sym)
        signature (help-signature sym)
        doc (ed-doc sym)
        keymap (scope-keymap (help-scope m))
        summary (seq/keep [(help-row "Module" (help-module-of sym))
                            (help-row "Defined" (help-location sym))
                            (help-row "Keys"
                              (cond
                                (not command?) nil
                                (empty? keys) (str "none — M-x " name)
                                else (string/join keys ", ")))
                            (help-row "Arguments" (help-arglist sym))
                            (help-row "Signature"
                              (if (nil? signature)
                                nil
                                (let ([text declared?] signature)
                                  (if declared? text (str text "   (inferred)")))))
                            (help-row "Symbol" (if command? (->string sym) nil))]
                  (fn (row) row)))
    (str (help-kind name sym)
      ".\n\n"
      (string/join summary "\n")
      "\n\n"
      (if (string? doc) (ed-substitute-command-keys keymap doc) "Not documented.")
      "\n")))

(defcommand cmd-describe-function
  (m key)
  "Describe a function (C-h f): prompt with completion over the M-x registry — or type any
qualified global (`string/join`, `pool/ed-show-named`) — then show its *Help* page: what it
is, its module and source location, the keys that run it, its parameters and signature, and
the whole docstring. Emacs's `describe-function`."
  (assoc m
    :minibuffer
      (ed-name-prompt "Describe function: "
        (command-names)
        (fn (prompted name)
          (let (sym (help-function-symbol (string/trim name)))
            (if (nil? sym)
              (message prompted (str "no function: " name))
              (ed-show-named prompted
                "*Help*"
                (describe-function-text prompted (string/trim name) sym)
                :help)))))))

;; ---- describe-setting (C-h v) ---------------------------------------------------
;; Emacs's `describe-variable` has nothing to describe here — bedit's state is a model, not
;; a sea of globals — but what a user DOES set is init.blsp, and every key of it is one
;; `settings/define` (config.blsp, and a package's own under `:bedit/settings`): its type,
;; default and doc. C-h v is the page for one of those, with the value it has now and where
;; that value came from.

(defn setting-names ()
  "Every declared init.blsp setting's name (no colon), in the order the default file lists them
— bedit's own and every loaded package's."
  (map (settings/specs config/*settings*) (fn (spec) (->string (:name spec)))))

(defn- help-value-text (value)
  "A setting value as init.blsp would spell it."
  (pr-str value))

(defn- help-per-mode-lines (value)
  "A per-mode map's entries, one `  key   value` line each, sorted — the `:line-numbers` /
`:long-lines` / `:indent-width` shape — or empty when `value` is not a map."
  (if (not (map? value))
    []
    (let (rows (seq/sort-by (vec value) (fn ([key _]) (->string key)))
          width (fold rows
                  8
                  (fn (widest [key _]) (math/max widest (+ 2 (count (pr-str key)))))))
      (map rows
        (fn ([key setting])
          (str "    "
            (pr-str key)
            (string/repeat " " (- width (count (pr-str key))))
            (pr-str setting)))))))

(defn describe-setting-text (m spec loaded on-disk)
  "The *Help* page for setting `spec` (a `settings/define` spec): its doc, type, default, the
value in effect and WHERE it came from — init.blsp, or the default (and why: unset, or a value
its type rejects) — the live value on the model when a command changed it this session, each
mode's value when it is a per-mode map, and a note when init.blsp on disk (`on-disk`) no longer
says what was loaded (`loaded`)."
  (let (name (:name spec)
        set? (contains? loaded name)
        written (get loaded name)
        valid? (settings/valid? spec written)
        in-effect (config/setting loaded name)
        model-key (:model-key spec)
        live (when model-key (get m model-key))
        ;; the project's `.bedit-locals.blsp` (`dirlocals`) for the buffer help was asked in
        buffer (ed-current-buf m)
        local (conventions/dir-local buffer name)
        source (cond
                 (not set?) "the default (init.blsp does not set it)"
                 valid? (str "init.blsp (" (config-paths/init-file) ")")
                 else
                   (str "the default — init.blsp's "
                     (help-value-text written)
                     " is rejected: it wants "
                     (settings/want-text spec)))
        summary (seq/keep [(help-row "Type" (settings/want-text spec))
                            (help-row "Default" (help-value-text (:default spec)))
                            (help-row "Value" (help-value-text in-effect))
                            (help-row "Set by" source)
                            (help-row "Live"
                              (if (and model-key (contains? m model-key) (not (= live in-effect)))
                                (str (help-value-text live) "   (changed in this session)")
                                nil))
                            (help-row "This buffer"
                              (if local
                                (str (help-value-text (second local))
                                  "   (from "
                                  (or (get buffer :dir-locals-file) ".bedit-locals.blsp")
                                  ", over init.blsp)")
                                nil))
                            (help-row "Directory"
                              (if (= true (:safe spec))
                                "a project's .bedit-locals.blsp may set it"
                                nil))
                            (help-row "Example"
                              (if (and (contains? spec :example)
                                    (not (= (:example spec) (:default spec))))
                                (help-value-text (:example spec))
                                nil))]
                  (fn (row) row))
        per-mode (help-per-mode-lines in-effect)
        stale? (not (= (get on-disk name) written)))
    (str (pr-str name)
      " is an init.blsp setting.\n\n"
      (string/join summary "\n")
      (if (empty? per-mode)
        ""
        (str "\n\n  Per mode (a mode's name, a line kind, :default):\n" (string/join per-mode "\n")))
      (if stale?
        (str "\n\n  init.blsp now says "
          (if (contains? on-disk name) (help-value-text (get on-disk name)) "nothing")
          " — M-x reload-config applies it.")
        "")
      "\n\n"
      (if (string? (:doc spec)) (:doc spec) "Not documented.")
      "\n")))

(defcommand cmd-describe-setting
  (m key)
  "Describe an init.blsp setting (C-h v): prompt with completion over every declared setting —
bedit's and each loaded package's — then show its *Help* page: doc, type, default, the value in
effect and whether init.blsp or the default gave it, each mode's value for a per-mode setting,
and the live value when a command changed it this session. Emacs's `describe-variable`, for
the variables bedit has."
  (assoc m
    :minibuffer
      (ed-name-prompt "Describe setting: "
        (setting-names)
        (fn (prompted typed)
          (let (name (keyword (string/drop-prefix (string/trim typed) ":"))
                spec (settings/spec-of config/*settings* name))
            (if (nil? spec)
              (message prompted (str "no setting: " typed))
              (let (on-disk (config/peek-init)
                    loaded (or (:init-config prompted) on-disk))
                (ed-show-named prompted
                  "*Help*"
                  (describe-setting-text prompted spec loaded on-disk)
                  :help))))))))

;; ---- describe-package (C-h P) ----------------------------------------------
;; Emacs's `describe-package`: what a package is before you install it, and what it brought
;; once you have — its version against the hive's newest, what it says it enhances, the
;; settings it declares (with their docs, from the settings registry when it is loaded) and
;; the themes it contributes. The facts are the package manager's ([[packages/package-info]]);
;; this is their page.

(defn- package-status-line (info)
  "The page's first sentence: whether `info`'s package is installed, and whether it is current."
  (let (name (:name info))
    (case (:status info)
      :update
        (str name
          " is an installed package — "
          (:latest info)
          " is available (u in M-x package-list).")
      :installed (str name " is an installed package.")
      :broken (str name " is installed but BROKEN — " (:reason info) ".")
      :incompatible (str name " is installed but was not loaded — " (:reason info) ".")
      (str name " is available on the hive (i in M-x package-list installs it)."))))

(defn- package-setting-line (name)
  "A package setting's row on its page: `:name — first line of its doc (default value)` when
the settings registry has it (the package is loaded), else the name alone."
  (let (spec (settings/spec-of config/*settings* name)
        doc (when (and spec (string? (:doc spec))) (first (string/split (:doc spec) "\n"))))
    (str "    "
      (pr-str name)
      (if doc (str " — " doc) "")
      (if spec (str " (default " (help-value-text (:default spec)) ")") ""))))

(defn describe-package-text (info)
  "The *Help* page for a package `info` ([[packages/package-info]]): whether it is installed
and current, its version and the hive's newest, what it enhances, the themes it contributes,
the init.blsp settings it declares, and its description."
  (let (enhances (:enhances info)
        summary (seq/keep [(help-row "Installed" (:installed info))
                            (help-row "Latest" (:latest info))
                            (help-row "Enhances"
                              (cond
                                (nil? enhances) nil
                                (string? enhances) enhances
                                else (pr-str enhances)))
                            (help-row "Themes"
                              (if (empty? (:themes info)) nil (string/join (:themes info) ", ")))]
                  (fn (row) row))
        settings (:settings info)
        description (:description info))
    (str (package-status-line info)
      "\n\n"
      (string/join summary "\n")
      (if (empty? settings)
        ""
        (str "\n\n  Settings (init.blsp — C-h v describes one):\n"
          (string/join (map settings package-setting-line) "\n")))
      "\n\n"
      (if (and (string? description) (not (= description ""))) description "Not described.")
      "\n")))

(defn- describe-package-named (m typed)
  ;; the *Help* page for the package named `typed`, or say there is no such package
  (let (name (string/trim typed)
        info (packages/package-info m name))
    (if (nil? info)
      (message m
        (str "no package "
          name
          (if (nil? (:package-list m)) " installed (the hive's list has not arrived)" "")))
      (ed-show-named m "*Help*" (describe-package-text info) :help))))

(defcommand cmd-describe-package
  (m key)
  "Describe a package (C-h P, Emacs's `describe-package`): whether it is installed and current,
its version against the hive's newest, what it enhances, the themes it contributes, the
init.blsp settings it declares and its description. On a *Packages* row (RET there) it
describes that package; elsewhere it prompts over the installed packages and the hive's —
fetching the hive's list off the loop when it has never been fetched, the prompt saying so."
  (let (row (when (= (editor/buffer/buffer-name (ed-current-buf m)) "*Packages*")
              (packages/package-row-at m)))
    (if row
      (describe-package-named m (:name row))
      (let (fetched (packages/fetch-list-once m))
        (assoc fetched
          :minibuffer
            (packages/package-prompt fetched :describe "Describe package: " describe-package-named))))))

;; ---- where-is / apropos ----------------------------------------------------

(defn- help-keys-for (entries name)
  "Every key sequence bound to the command whose M-x name is `name` and that is in force,
as labels. Shadowed bindings are left out on purpose: this answers \"how do I run it\",
and a key that cannot reach the command is not an answer to that. Keyed on the M-x name
(`find-file`), not the symbol tail (`cmd-find-file`). For ONE command: a caller with many
builds [[help-key-index]] once and looks each up."
  (get (help-key-index entries) name '()))

(defn- help-key-index (entries)
  "`{M-x name -> (key label …)}` for every binding in force — the whole entry list inverted
in ONE walk, for a caller that needs the keys beside many commands: scanning the entries
per row is O(rows × bindings), a visible freeze on `C-h a`."
  (fold entries
    {}
    (fn (acc entry)
      (if (:shadowed-by entry)
        acc
        (let (name (command-friendly-name (ed-command-tail (:command entry))))
          (assoc acc name (append (get acc name '()) (list (ed-keys-label (:sequence entry))))))))))

(defcommand cmd-where-is
  (m key)
  "Report the keys that run a command (C-h w): prompt for a command name with completion,
then say where it is bound — or that it is M-x only."
  (let (entries (scope-bindings (help-scope m)))
    (assoc m
      :minibuffer
        (ed-name-prompt "Where is command: "
          (command-names)
          (fn (prompted name)
            (let (keys (help-keys-for entries name))
              (message prompted
                (if (empty? keys)
                  (str name " is not on any key (M-x " name ")")
                  (str name " is on " (string/join keys ", "))))))))))

(sig help-apropos-rows (seqable seqable string -> seqable))
(defn help-apropos-rows (names entries pattern)
  "The `C-h a` rows for `pattern`: every command name containing it (case-folded), with its
keys and the first line of its docstring. Substring, not fuzzy — apropos is for \"what is
there about buffers\", and a fuzzy match over the whole registry answers a different
question.

An EMPTY pattern matches nothing rather than everything. Every row costs a `reflect/eval`
for its docstring, so \"all of them\" is ~700 ms of frozen loop to answer a question nobody
asked — `C-h b` is the list-everything command, and it is the one that is cheap."
  (if (= (string/trim pattern) "")
    '()
    (let (needle (string/fold-case pattern)
          ;; ONE walk for the keys of every command (see `help-key-index`), not a rescan
          ;; of `entries` per row
          keys-of (help-key-index entries))
      (map (seq/filter names (fn (name) (includes? (string/fold-case name) needle)))
        (fn (name)
          (let (keys (get keys-of name '())
                doc (ed-doc (command-sym name)))
            (str "  "
              name
              (if (empty? keys) "" (str "   (" (string/join keys ", ") ")"))
              "\n      "
              (if (string? doc) (ed-first-line doc) "(no docstring)"))))))))

(defcommand cmd-apropos-command
  (m key)
  "List commands whose name matches a pattern (C-h a), with their keys and docstring
summary — the way into the whole command registry when you know the noun but not the name."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Apropos command: " "")
       :on-complete (fn (prompted pattern)
                      (let (rows (help-apropos-rows (command-names)
                                   (scope-bindings (help-scope prompted))
                                   pattern))
                        (if (empty? rows)
                          (message prompted (str "no command matches: " pattern))
                          (ed-show-named prompted
                            "*Apropos*"
                            (str "Commands matching \""
                              pattern
                              "\" ("
                              (count rows)
                              ")\n\n"
                              (string/join rows "\n")
                              "\n")
                            :help))))}))

;; ---- lossage ---------------------------------------------------------------

(def *lossage-per-row* 12)
;; Keys per line in the `C-h l` report. The whole ring on one line is a line a hundred
;; keys long, and a `:help` buffer does not wrap — so the tail of what you just pressed,
;; which is the part you came to read, sits off the right edge behind a horizontal scroll.

(sig lossage-text (seqable -> string))
(defn lossage-text (ring)
  "The key ring as indented rows of `*lossage-per-row*` labels, oldest first."
  ;; `chunk-every`, not `partition`: partition DROPS a trailing partial chunk, and the
  ;; trailing chunk here is the last few keys you pressed — the ones you opened C-h l to
  ;; look at. A report that silently omits its own point.
  (string/join (map (seq/chunk-every (map ring ed-key-label) *lossage-per-row*)
                 (fn (row) (str "  " (string/join row " "))))
    "\n"))

(defcommand cmd-view-lossage
  (m key)
  "Show the keys you last pressed (C-h l) — what actually reached the dispatcher, in order.
The answer to \"what did I just do?\", and to \"why did nothing happen?\": a key that was
swallowed is in this list, which is the only place it is visible."
  (let (ring (lossage/lossage-keys m))
    (ed-show-named m
      "*Lossage*"
      (if (empty? ring)
        "No keys recorded yet.\n"
        (str "The last "
          (ed-count-noun (count ring) "key")
          ", oldest first:\n\n"
          (lossage-text ring)
          "\n"))
      :help)))

;; ---- the help map itself ---------------------------------------------------

(def *help-map-rows*
  ;; `[key what]` for the C-h map, as data — `C-h ?` renders it, and a new help command is
  ;; a row here rather than a line of prose that goes stale the first time one is added.
  [["C-h ?" "this list"]
    ["C-h b" "describe-bindings — every key in force, by layer"]
    ["C-h m" "describe-mode — the layers active in this buffer"]
    ["C-h k" "describe-key — what one key runs, and where it is bound"]
    ["C-h f" "describe-function — a function's doc, keys, signature and module"]
    ["C-h v" "describe-setting — an init.blsp setting: doc, type, default, value"]
    ["C-h P" "describe-package — a package: installed, version, settings, themes"]
    ["C-h w" "where-is — the keys that run a command"]
    ["C-h a" "apropos-command — commands matching a pattern"]
    ["C-h l" "view-lossage — the keys you last pressed"]
    ["C-h t" "the interactive tutorial"]
    ["C-h C-a" "about bedit"]])

(defcommand cmd-help-for-help
  (m key)
  "List the help map (C-h ?) — what every key under C-h does. The entry point: you get here
without knowing anything else, and everything else is one key away."
  (ed-show-named m
    "*Help*"
    (str "bedit help\n\n"
      (string/join (map *help-map-rows*
                     (fn (row)
                       (let ([k what] row)
                         (str "  " k (string/repeat " " (math/max 1 (- 10 (count k)))) what))))
        "\n")
      "\n")
    :help))
