(defmodule procstream
  "The streaming-subprocess worker every runner shares (testrun's `:testrun`,
apprun's `:apprun`): one long-lived NAMED process that owns a `proc-spawn` handle
and line-buffers its stdout. Drive it with messages:

  [:run cmd argv root]   spawn (or replace — re-running never queues) the child
  [:shutdown]            kill the child and stop the worker

`handlers` is a map of plain fns (closures cross `spawn`):

  :on-line      (line) — each complete stdout line (the trailing partial flushes
                on exit); the consumer decodes/classifies (JSON events, raw output)
  :on-err-line  (line) — each non-blank stderr line
  :on-done      (code) — the child exited (nil = killed)

The handlers are captured at the worker's FIRST spawn (a named spawn is idempotent),
so redefining a consumer's dispatch fn live reaches the worker only after it is shut
down and respawned — the one late-binding exception in the runner stack, traded for
one worker implementation instead of three.")

(defn procstream--feed (buf data on-line)
  "Fold a stdout chunk into the line buffer: hand each complete line to `on-line`,
return the trailing partial."
  (let (parts (string-split (str buf data) "\n")
        complete (take (dec (count parts)) parts))
    (doseq (line complete) (on-line line))
    (last parts)))

(defn procstream--recv (proc buf handlers)
  (receive
    ([:proc p data]
      (procstream--recv proc
        (if (= p proc) (procstream--feed buf data (:on-line handlers)) buf)
        handlers))
    ([:proc-err p data]
      (do (when (= p proc)
            (doseq (line (string-split data "\n"))
              (when (not= (trim line) "") ((:on-err-line handlers) line))))
        (procstream--recv proc buf handlers)))
    ([:proc-closed p code]
      (if (= p proc)
        (do (when (not= (trim buf) "") ((:on-line handlers) buf))
          ((:on-done handlers) code)
          (procstream-loop handlers))
        (procstream--recv proc buf handlers)))
    ([:run cmd argv root]
      (do (try (proc-close proc) (catch e nil))
        (procstream--recv (proc-spawn cmd argv {:cwd root}) "" handlers)))
    ([:shutdown]
      (do (try (proc-close proc) (catch e nil)) :procstream-stopped))))

(defn procstream-loop (handlers)
  "The idle state between runs — runs are human-paced, so hibernate while waiting."
  (hibernate)
  (receive
    ([:run cmd argv root] (procstream--recv (proc-spawn cmd argv {:cwd root}) "" handlers))
    ([:shutdown] :procstream-stopped)))
