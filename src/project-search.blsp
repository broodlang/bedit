(defmodule project-search
  "Search the project (C-x p g, Emacs `project-find-regexp`): the fastest searcher on PATH
(ripgrep, else git grep, else grep) over the project root, its rows in a `*Project Search*`
buffer that reads like Emacs's grep-mode — every row a link to its file and line.

Split out of `commands.blsp` (issues.md X1)."
  (:use model) ; message / ed-project-root — the project a search runs in
  (:use commands) ; ed-show-named / ed-goto-line — the results buffer and the jump
  (:use editor/buffer) ; the symbol at point a search starts from
  (:use interactive) ; defcommand — C-x p g, on M-x
  (:use results) ; the row → location vocabulary every results buffer shares
  (:use theme)) ; the palette the grep-mode colours are drawn from
;; ---- project search (C-x p g) ------------------------------------------------
;; Emacs `project-find-regexp`: a regexp over every file of the project, its matches in a
;; results buffer whose rows are `file:line:text` — the shared location vocabulary, so
;; RET / click visits the match (`results/location-jump-layer`). The search is the
;; system's grep, not a Brood walk: `git grep` inside a repository (it skips what
;; `.gitignore` skips, and binaries) and `grep -r` elsewhere, both extended regexps.

(def *project-search-buf* "*Project Search*")

;; Which searcher runs is a TABLE, not a branch: a row is the program, whether it has to be
;; on PATH, when it applies, and how to spell "regexp" and "literal" for it. Adding one is a
;; row. The order is preference order.
;;
;; `rg` first, and by a distance — it walks the tree in parallel, skips what `.gitignore`
;; skips, skips binaries, and is not limited to a repository the way `git grep` is. On a
;; 27k-file project it is several times `git grep` and an order over `grep -r`. The other two
;; stay because a searcher has to exist on a machine that has neither: `git grep` inside a
;; repository (it at least honours the ignore rules), plain `grep -r` anywhere.
(def *project-searchers*
  [{:program "rg"
    :on-path? true
    :applies (fn (root) true)
    :args (fn (pattern literal?)
            ;; `--no-heading` keeps the `file:line:text` shape every row parser here reads;
            ;; `-uu` is NOT passed, so .gitignore and hidden files are respected as Emacs's
            ;; `project-find-regexp` respects them. NO `-I`: that is "ignore binary files" to
            ;; grep and `--no-filename` to ripgrep, which silently drops the file from every
            ;; row and leaves a results buffer nothing can navigate. rg skips binaries anyway.
            (into ["--no-heading" "--line-number" "--with-filename" "--color" "never"]
              (append (if literal? ["--fixed-strings"] []) ["-e" pattern "--" "."])))}
    {:program "git"
     :on-path? false
     :applies (fn (root) (file/dir? (path/join root ".git")))
     :args (fn (pattern literal?)
             (into ["grep" "-n" "-I" (if literal? "-F" "-E")] ["-e" pattern "--" "."]))}
    {:program "grep"
     :on-path? false
     :applies (fn (root) true)
     :args (fn (pattern literal?)
             [(if literal? "-rnIF" "-rnIE") "--exclude-dir=.git" "-e" pattern "."])}])

(defn- on-path? (program)
  "Whether `program` is runnable — `os/which`, which looks without starting a shell."
  (not (nil? (os/which program))))

(defn project-searcher (root)
  "The first `*project-searchers*` row that applies at `root` and is actually installed."
  ;; The last row is plain `grep`: it applies anywhere and is not gated on PATH, so the
  ;; `find` cannot come back empty. Saying so is what makes the program a string downstream
  ;; rather than a maybe-string every caller has to guard.
  (or (seq/find *project-searchers*
        (fn (s) (and ((:applies s) root) (or (not (:on-path? s)) (on-path? (:program s))))))
    (error "project-searcher: no searcher applies at " root)))

(defn project-search-command (root pattern literal?)
  "The command line the search will run, as a `[program args]` pair — what the results
buffer's header shows, so a reader can copy it into a shell and get the same answer."
  (let (s (project-searcher root))
    [(:program s) ((:args s) pattern literal?)]))

(defn- project-grep-run (root pattern literal?)
  "Run the project's searcher for `pattern` — ripgrep where it exists, else `git grep` in a
repository, else `grep -r` — as a regexp, or as a fixed string when `literal?`. The raw
result map; `project-grep` decides what an exit code means."
  (let ([program args] (project-search-command root pattern literal?))
    (os/cmd program args {:cwd root})))

(defn project-grep (root pattern)
  "The `file:line:text` rows for `pattern` over the project at `root`, as one string (each
row's file relative to `root`), `\"\"` when nothing matched. An extended regexp — `git
grep` under a repository, `grep -rnI` otherwise — and an exit of 1 is \"no match\", not a
failure.

**A pattern that isn't a valid regexp is searched LITERALLY**, and the caller is told so
(`project-search` returns `[rows literal?]`). Typing `(movx` into a project search is a
perfectly reasonable thing to want — it is what the code says — and `grep` answering
`fatal: -e option, '(movx': Unmatched ( or \\(` is a shell error where a search result
belongs. The retry is what decides, not a guess at which patterns are valid: the tool
*running* the search is the authority on its own dialect, so a failure is simply re-run
with `-F`, and only a pattern that fails BOTH ways is an error worth reporting."
  (let (r (project-grep-run root pattern false)
        code (:exit r)
        out (:stdout r))
    (cond
      (= code 0) [out false]
      (= code 1) ["" false]
      ;; `grep -r` exits 2 when ANY file could not be read (a dangling symlink under
      ;; node_modules) even with matches printed: the matches are the answer, the
      ;; unreadable file is not
      (and (= code 2) (not (= out ""))) [out false]
      :else
        (let (lit (project-grep-run root pattern true)
              lit-code (:exit lit)
              lit-out (:stdout lit))
          (cond
            (= lit-code 0) [lit-out true]
            (= lit-code 1) ["" true]
            (and (= lit-code 2) (not (= lit-out ""))) [lit-out true]
            ;; neither reading worked — report the REGEXP failure, which is the one the
            ;; caller asked for and the one whose message says something
            :else (error "project-grep: " (string/trim (str (:stderr r) " " out))))))))

(defn project-search-rows (rows)
  "The searcher's stdout as clean `file:line:text` rows — blank lines dropped and the `./`
`grep -r` prefixes its paths with removed, so a row reads `a.txt:3:…` whichever searcher
produced it."
  (map (seq/reject (string/split rows "\n") (fn (l) (= l "")))
    (fn (l) (if (string/starts-with? l "./") (string/substring l 2 (string/length l)) l))))

(defn project-search-text (root pattern rows &optional (literal? false))
  "The results buffer's text, in Emacs `grep-mode`'s shape: the mode/directory line, the
command that actually ran, the `file:line:text` rows, and a closing count.

Looking like `grep-mode` is not decoration. The three things a reader wants from a search
buffer are *where did this run*, *what exactly did it run*, and *did it finish or is it
still going* — Emacs puts all three on screen, and bedit used to show only a count. The
command line especially: a search that finds nothing is a question about the pattern, and
the answer is the line you can paste into a shell.

`literal?` (the pattern wasn't a valid regexp, so it was searched as text) is said in the
header — the count is never silently about a different search than the one it claims."
  (let (clean (project-search-rows rows)
        n (count clean)
        [program args] (project-search-command root pattern literal?)
        shown (if literal? (str "\"" pattern "\" (literal)") (str "/" pattern "/")))
    (str "-*- mode: grep; default-directory: \""
      root
      "\" -*-\n"
      "Search started for "
      shown
      "\n"
      "\n"
      program
      " "
      (string/join args " ")
      "\n"
      "\n"
      (string/join clean "\n")
      (if (= n 0) "" "\n")
      "\n"
      "Search finished ("
      n
      (if (= n 1) " match" " matches")
      " found)\n")))

;; ---- the search buffer, coloured like Emacs's grep-mode ---------------------
;; `*Project Search*` had no `:fontify` at all: a wall of `file:line:text` in one colour,
;; which is a lot of rows to read with nothing telling the eye where a row starts. Emacs
;; colours three things and they are the three that matter — the FILE, the LINE NUMBER, and
;; the MATCH — so a reader scans down the left edge for the file and across for the hit.

(theme/defchrome grep-face-meta {:fg *overlay0* :italic true}) ; the -*- line, the started/finished lines
(theme/defchrome grep-face-command {:fg *subtext*}) ; the command line, copyable into a shell
(theme/defchrome grep-face-file {:fg *blue* :bold true}) ; the file a row is in
(theme/defchrome grep-face-line {:fg *green*}) ; its line number
(theme/defchrome grep-face-match {:fg *base* :bg *yellow*}) ; the text that matched — isearch's colours
(defdyn *project-search-highlight* nil)
;; `[pattern literal?]` for the rows currently in `*Project Search*`, or nil. A `:fontify`
;; service is `(text) -> spans` — it gets no buffer — and the match can only be found by the
;; pattern that produced it, so the live search parks it here. One search buffer, one global —
;; a parked value, not a cache.

(defn- grep-match-spans (text off pattern literal?)
  "Spans over `text` (at buffer offset `off`) for every occurrence of `pattern` — as a
regexp, or literally when `literal?`. A regexp that will not compile marks nothing rather
than failing the whole fontify: the rows are still readable without the highlight."
  (check-allow :discarded-catch
    (try
      (if literal?
        (let (n (string/length pattern))
          (if (= n 0)
            '()
            (letrec (go (fn (from acc)
                          (let (i (index-of text pattern from))
                            (if (< i 0)
                              (reverse acc)
                              (go (+ i n) (cons [(+ off i) (+ off i n) grep-face-match] acc))))))
              (go 0 '()))))
        (map (regex/find-all pattern text)
          (fn (mm)
            [(+ off (:start mm)) (+ off (:end mm)) grep-face-match])))
      (catch e '()))))

(defn project-search-line-spans (line off)
  "Spans for one `*Project Search*` line starting at offset `off`: a header/footer line in
the meta voice, the command line in its own, and a `file:line:text` row with its file and
line number coloured and every match in it highlighted."
  (let (n (string/length line)
        colon (index-of line ":")
        colon2 (if (< colon 0) -1 (index-of line ":" (inc colon)))
        number (if (< colon2 0) "" (string/substring line (inc colon) colon2))
        row? (and (> colon 0)
               (> colon2 colon)
               (not (= number ""))
               (nil? (seq/find (string/->list number) (fn (c) (< (index-of "0123456789" c) 0)))))
        [pattern literal?] (or *project-search-highlight* [nil false]))
    (cond
      (or (string/starts-with? line "-*-")
        (string/starts-with? line "Search started")
        (string/starts-with? line "Search finished"))
        (list [off (+ off n) grep-face-meta])
      row?
        (append (list [off (+ off colon) grep-face-file]
                  [(+ off (inc colon)) (+ off colon2) grep-face-line])
          (if (nil? pattern)
            '()
            (grep-match-spans (string/substring line (inc colon2) n)
              (+ off colon2 1)
              pattern
              literal?)))
      (= line "") '()
      ;; anything else at the top of the buffer is the command line
      :else (list [off (+ off n) grep-face-command]))))

(defn project-search-fontify (src)
  "The `:fontify` service for `*Project Search*` — `[start end face]` spans over `src`,
line by line (`project-search-line-spans`). Line-structural, so the windowed slice the view
hands it colours correctly wherever it starts."
  (let (lines (string/split src "\n"))
    (reverse (second (fold lines
                       [0 '()]
                       (fn (state line)
                         (let ([off acc] state)
                           [(+ off (string/length line) 1)
                             (fold (project-search-line-spans line off) acc (fn (a s) (cons s a)))])))))))

(def project-search-layer
  ;; the mode layer `:project-search` stacks: the grep colouring and nothing else — the
  ;; jumping, the read-only-ness and the gutter come from the layers under it
  {:name 'project-search
   :keymap {}
   :fontify 'project-search/project-search-fontify})

(defn- ed-symbol-at-point (m)
  "The symbol under point in the current buffer, or nil — the search prompt's default."
  (let (buf (ed-current-buf m)
        s (editor/highlight/symbol-at (buffer-text buf) (buffer-point buf)))
    (if (nil? s) nil (second s))))

(defn ed-project-search (m root pattern)
  "Run `pattern` over the project at `root` and show the rows in `*Project Search*`
(its `:dir` the root, so every row resolves from there); the echo area says how many, and
says `(literal)` when the pattern wasn't a valid regexp and was searched as plain text."
  (let ([rows literal?] (project-grep root pattern)
        text (project-search-text root pattern rows literal?)
        n (count (project-search-rows rows))
        shown (if literal? (str "\"" pattern "\" (literal)") (str "/" pattern "/"))
        ;; what the rows matched, for the fontify to highlight — see
        ;; `*project-search-highlight*` on why this is a global and not a buffer field
        _ (def *project-search-highlight* [pattern literal?])
        m1 (ed-show-named (assoc m :project-root root) *project-search-buf* text :project-search)
        m2 (ed-set-buf m1 (assoc (ed-current-buf m1) :dir root))
        ;; point on the FIRST result row — past the `-*-` line, the started line, the blank,
        ;; the command and its blank (Emacs lands on the first match too)
        m3 (ed-apply m2 (fn (b) (ed-goto-line b (if (= n 0) 1 6)))))
    (message m3
      (if (= n 0)
        (str "no matches for " shown)
        (str n " matches for " shown " — RET visits")))))

(defcommand cmd-project-find-regexp
  (m key)
  "Search the whole project for a regexp (C-x p g, Emacs `project-find-regexp`): prompts
with the symbol at point as the default, greps every file under the project root, and
lists `file:line:text` matches in *Project Search* — RET or a click visits one. Reports
when not in a project."
  (let (root (ed-project-root m)
        dflt (ed-symbol-at-point m))
    (if (nil? root)
      (message m "not in a project")
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit (str "Find regexp in project"
                               (if dflt (str " (default " dflt ")") "")
                               ": ")
                   "")
           :on-complete (fn (mm t)
                          (let (pat (if (string/blank? t) (or dflt "") t))
                            (if (string/blank? pat)
                              (message mm "empty pattern")
                              (try
                                (ed-project-search mm root pat)
                                (catch e (message mm (str "search failed: " (error-message e))))))))}))))

