(defmodule file-save
  "Writing a pool buffer to its file: the plain save every path shares, the two halves of a
save that lands later, and what a save tells the rest of the editor (the sidecar, a hosted
slot's process, the project's file list). A buffer a file handler owns is that handler's to save
(`model/register-file-handler`).

Every save of a plain file is written OFF the loop (`:save-proc`): `file/replace` makes a temp
file, fsyncs it and renames it, which on a slow or network disk would freeze the editor. The
buffer is made what its `.editorconfig` asks and its text taken at once ([[ed-save-prepare]]),
the write runs in a task, and the buffer is marked saved when it has landed
([[ed-save-landed]]) — only then, and only as of the text written: an edit made meanwhile
leaves it modified, and a write that fails leaves it modified and says why. One write runs at a
time; a save asked for while one is out waits its turn (`:save-waiting`) and takes the buffer's
text when its turn comes, so two saves of one file never race. [[ed-when-saves-land]] is what
C-x C-c and C-x s wait on. Headless — a test, a batch run — the write runs inline."
  (:use editor/buffer) ; buffer-file / buffer-rope / mark-buffer-saved
  (:use editor/buffer-file) ; buffer-stamp-file
  (:use editor/buffer-server) ; buffer-edit
  (:use sidecar :only [ed-forget-auto-save]) ; a saved file's sidecar removed
  (:use backup :only []) ; the file as it was, copied before the first save over it
  (:use conventions :only [prepare-for-save]) ; .editorconfig's trailing whitespace / final newline
  (:use hooks :only [ed-after-save]) ; init.blsp's :after-save commands, once a write lands
  (:use model)) ; ed-buf-at / ed-set-buf-at / message / the file handlers / register-task-reply

(defdyn *write-off-loop* nil)
;; Whether a plain save's write runs in a task: nil follows the loop (off it when there is
;; one, `model/ed-headless?`; inline in a test or a batch run). A test binds true to see a
;; write in flight, and folds its reply itself ([[ed-apply-save]]).

(def *write-timeout-ms* (* 10 60 1000))
;; How long a write may take before its task is killed and the save said to have failed: a
;; disk that never answers must not hold the queue (and a quit waiting on it) for ever. C-g does
;; not stop a write.

(defdyn *write-file* file/replace)
;; `(file content)`, what a plain save writes with: `file/replace` (temp file, fsync, rename —
;; a crash mid-save leaves the old file). Read when the save is LAUNCHED, so a test that binds
;; it reaches the task too.

;; check-allow: a handler's operation is resolved late; every one answers a model
(sig ed-save-handled (model int any -> model))
(check-allow :trusted
  (defn- ed-save-handled (m index handler)
    ;; pool buffer `index` saved by `handler`, which owns it
    (ed-handler-call handler :save m m index)))

(defn ed-project-files-forget (m path)
  "The model with every cached project file list (`:project-files`, kept by
`project-commands/ed-find-file-in-project`) that `path` lies under marked stale — what a save that
CREATES a file does, since the next `C-x p f` must list it although git's index has not moved."
  (let (cache (:project-files m))
    (if (or (empty? cache) (not (string? path)))
      m
      (assoc m
        :project-files
          (fold cache
            cache
            (fn (marked [root entry])
              (if (projects/path-under root path)
                (assoc marked root (assoc entry :stale true))
                marked)))))))

(defn- ed-ship-save-edits (m index original prepared)
  "`m` with the edits a save made before writing (`prepared` from `original`: the
`.editorconfig` fix-ups) already sent to pool slot `index`'s buffer process, when it is hosted
and they changed anything. The link remembers the buffer it brought the process up to
(`:synced`), so the loop tail's `hosted/hosted-propagate` diffs from there and does not send
them a second time."
  (let (link (map/get-in m [:hosted index]))
    (if (or (nil? (:proc link)) (= (buffer-rope original) (buffer-rope prepared)))
      m
      (map/assoc-in m
        [:hosted index]
        (assoc (editor/buffer-client/link-propagate-buffers link original prepared)
          :synced prepared)))))

;; check-allow: `then` is the caller's continuation (the formatter's), whose result the checker
;; cannot see; every caller hands one that answers a model
(check-allow :trusted
  (sig ed-save-buf-at (model int &optional any any -> model))
  (defn ed-save-buf-at (m index &optional (then nil) (abandon-note nil))
    "Save pool buffer `index` to its file: the plain save every path shares — `C-x C-s` on the
current buffer, and `save-some-buffers` on any other at quit. The buffer is first made what its
`.editorconfig` asks (`conventions/prepare-for-save`: trailing whitespace trimmed, a final
newline added — edits on the buffer, so what is written is what is shown), then written OFF the
loop: `Saving …` is said at once and the buffer stays modified until the write lands. Landed, it
is unmodified (as of the text written), stamped with the file's new time, its `#filename#`
sidecar deleted, and `(then m)` runs; failed, it stays modified and the echo area says why,
`abandon-note` after it. A save asked for while another write is out waits its turn
([[ed-when-saves-land]] is the wait for all of them). The diff-hl gutter is NOT recomputed: a
save touches neither the buffer text nor HEAD.

A buffer a file handler owns is that handler's to save (`model/register-file-handler`)."
    (let (handler (ed-buffer-handler (ed-buf-at m index)))
      (if (nil? handler)
        (ed-save-plain m index then abandon-note)
        (ed-save-handled m index handler)))))

(defn- ed-denied-hint (reason)
  ;; a file the user may not write: what a handler offers instead, Emacs's TRAMP. For no other
  ;; failure.
  (if (includes? (string/lower reason) "permission denied")
    (or (seq/find (seq/keep (ed-file-handlers) :denied-hint) string?) "")
    ""))

(defn- ed-mark-process-saved (m index)
  ;; A HOSTED slot's buffer process owns the buffer's state, so it hears of the save too:
  ;; after every splice this slot already sent (a mailbox is FIFO), so it marks exactly the
  ;; text that was written, and tagged as ours, so it folds back as an echo rather than a
  ;; foreign change. Another frame then shows the buffer saved, and no push carries the
  ;; modified flag back.
  (let (proc (map/get-in m [:hosted index :proc]))
    (when proc
      (buffer-edit proc
        (self)
        (fn (process-buffer) (mark-buffer-saved (buffer-stamp-file process-buffer)))))))

;; ---- a save that lands later ----------------------------------------------------
;; Every save is made in two halves: the buffer made what its `.editorconfig` asks and its
;; text taken now ([[ed-save-prepare]]), the buffer marked saved when the write has landed
;; ([[ed-save-landed]]). Until then it stays modified; a write that fails leaves it so. A plain
;; file's write is a task of this module's; a file handler's (sudoedit) is its own.

(sig ed-save-prepare (model int -> any))
(defn ed-save-prepare (m index)
  "`[m' buffer]` — pool buffer `index` made what its `.editorconfig` asks before a save
(`conventions/prepare-for-save`), the edits in slot `index` and shipped to its hosted process,
and the buffer as it will be written. Nothing is written and nothing is marked saved."
  (let (original (ed-buf-at m index)
        prepared (prepare-for-save original))
    [(ed-ship-save-edits (ed-set-buf-at m index prepared) index original prepared) prepared]))

(sig ed-save-landed (model int any string &optional any bool -> model))
(defn ed-save-landed (m index rope note &optional (mtime nil) (from-hook false))
  "Pool buffer `index` once a write of its text `rope` has landed: marked saved and stamped with
its file's new time (`mtime` when the writer read it, else asked now), its sidecar removed and
its hosted process told — when the buffer still holds that text. Edited while the write was
out, only the baseline moves: the buffer stays modified, its newer text unwritten. `note`
follows the `saved …` the echo area says. Then init.blsp's `:after-save` hooks — unless
`from-hook`: a save one of them asked for, which must not set them off again."
  (let (buffer (ed-buf-at m index)
        file (buffer-file buffer)
        current? (= (buffer-rope buffer) rope)
        stamped (dissoc (if (nil? mtime)
                          (buffer-stamp-file buffer)
                          (assoc buffer :file-mtime mtime))
                  :disk-warned)
        saved (if current? (mark-buffer-saved stamped) (assoc stamped :saved-rope rope)))
    (do
      (when current?
        (ed-forget-auto-save buffer)
        ;; the process holds the same text, the write's edits having reached it first
        (ed-mark-process-saved m index))
      ;; then init.blsp's `:after-save` commands, with the saved buffer current (`hooks`)
      (let (told (message (dissoc (ed-set-buf-at m index saved) :status)
                   (str "saved " file note (if current? "" " (edited since — still modified)"))))
        (if from-hook told (ed-after-save told index))))))

;; ---- a plain file's write, off the loop ------------------------------------------
;; One write at a time (`:save-proc`, its job on `:save-job`), the rest waiting their turn on
;; `:save-waiting` as `{:file :then :abandon-note}` — the FILE, not the pool index, since a
;; kill moves the pool while a write is out, and the text is taken when the turn comes, so a
;; save queued behind another of the same buffer writes what the buffer holds by then.
;; `:save-drains` are the continuations waiting for the queue to empty ([[ed-when-saves-land]]).

(defn- write-off-loop? ()
  (if (nil? *write-off-loop*) (not (ed-headless?)) *write-off-loop*))

(defn write-work (writer file content)
  "What a plain save's task does: `content` written to `file` with `writer`
([[*write-file*]]), answering `{:mtime :created?}` — the file's new time, and whether the
write made it — or `{:error reason}`. Never raises.

    (:error (file-save/write-work (fn (f c) (error \"disk full\")) \"/tmp/x\" \"\"))   ;=> \"disk full\""
  (try
    (let (created? (not (file/exists? file)))
      (do (writer file content) {:mtime (file/mtime file) :created? created?}))
    (catch failure {:error (error-message failure)})))

(defn ed-plain-index (m file)
  "The pool index of the buffer visiting `file` as itself — not through a file handler — or
nil: the buffer a plain write of `file` lands in."
  (let (index (seq/index-where (:buffers m)
                (fn (buffer) (and (= (buffer-file buffer) file) (nil? (ed-buffer-handler buffer))))))
    (if (< index 0) nil index)))

(defn ed-save-pending? (m file)
  "Whether a plain save of `file` is out or waiting its turn: its own write is about to move the
file's time, so the save asking again need not ask whether someone else changed it."
  (or (= (:file (:save-job m)) file)
    (any? (or (:save-waiting m) []) (fn (entry) (= (:file entry) file)))))

(defn- ed-job-index (m job)
  "The pool index of the buffer a save `job` (or a waiting entry) writes — the one visiting its
`:file` plainly, or for a write to a NEW path (C-x C-w, [[ed-write-buf-as]]) the one its
`:source` names: still under its old name and file until the write lands — or nil once it was
killed."
  (let (source (:source job))
    (if (nil? source)
      (ed-plain-index m (:file job))
      (let (index (seq/index-where (:buffers m)
                    (fn (buffer)
                      (and (= (buffer-name buffer) (:name source))
                        (= (buffer-file buffer) (:file source))))))
        (if (< index 0) nil index)))))

(defn- ed-save-wait (m entry)
  "A save `entry` (`{:file :then :abandon-note}`, a write to a new path's `:source` and
`:retarget` too) put on the queue behind the write that is out. A second save of a file already
waiting, with no continuation of its own, is that one: it will write what the buffer holds when
its turn comes."
  (let (waiting (or (:save-waiting m) [])
        file (:file entry)
        queued? (and (nil? (:then entry))
                  (nil? (:source entry))
                  (any? waiting (fn (other) (and (= (:file other) file) (nil? (:source other)))))))
    (message (if queued? m (assoc m :save-waiting (conj waiting entry)))
      (str (if (:source entry) "writing " "saving ") file " after the write in flight"))))

(defn- ed-save-plain (m index then abandon-note)
  ;; a plain file's save: queued behind the write that is out, else launched
  (let (file (buffer-file (ed-buf-at m index))
        entry {:file file
               :then then
               :abandon-note abandon-note
               :from-hook (= true (:in-after-save m))})
    (cond
      (nil? file)
        (ed-save-pump (message m (str "save failed: buffer has no file" (or abandon-note ""))))
      (:save-proc m) (ed-save-wait m entry)
      else (ed-save-launch m index entry))))

;; check-allow: `retarget` is the caller's (lifecycle's C-x C-w), resolved when the write lands;
;; it answers a model
(check-allow :trusted
  (sig ed-write-buf-as (model int string any -> model))
  (defn ed-write-buf-as (m index path retarget)
    "Write pool buffer `index` to the NEW plain file `path` (C-x C-w) through the same off-loop
write a save takes ([[ed-save-buf-at]]): `Writing …` at once, the buffer keeping its name and
file while the write is out. Landed, `(retarget m index)` makes the buffer visit `path` (the
caller's: its name, its hosted document, its old sidecar) and it is marked saved as of the text
written; failed, it is left visiting what it did and the echo area says why. Queued behind a
write already out, as any save is."
    (let (buffer (ed-buf-at m index)
          entry {:file path
                 :source {:name (buffer-name buffer) :file (buffer-file buffer)}
                 :retarget retarget})
      (if (:save-proc m) (ed-save-wait m entry) (ed-save-launch m index entry)))))

(defn- ed-save-launch (m index entry)
  "Pool buffer `index` prepared and its text handed to a task that writes the `entry`'s file —
inline when there is no loop ([[write-off-loop?]]). A text the buffer's coding cannot write is
refused here, saying where."
  (let ([prepared-model prepared] (ed-save-prepare m index)
        file (:file entry)
        content (charset/file-content prepared)
        writer *write-file*
        job (assoc entry :rope (buffer-rope prepared))
        backup? (and (nil? (:source entry)) (backup/backup-wanted? m (ed-buf-at m index)))
        work (fn ()
               (let (backup-failed (when backup? (backup/make-backup file))
                     written (write-work writer file content))
                 (if backup-failed (assoc written :backup-failed backup-failed) written)))
        marked (if backup?
                 (ed-set-buf-at prepared-model
                   index
                   (assoc (ed-buf-at prepared-model index) :backed-up true))
                 prepared-model)
        failed (if (:source entry) "write failed: " "save failed: "))
    (cond
      (failure? content)
        (ed-save-pump (message prepared-model
                        (str failed (error-message content) (or (:abandon-note entry) ""))))
      (write-off-loop?)
        (assoc (message marked (str (if (:source entry) "Writing " "Saving ") file "…"))
          :save-proc (task/task work {:timeout *write-timeout-ms*})
          :save-job job)
      else (ed-save-finish marked job (work)))))

(defn ed-apply-save (m answer)
  "Fold a plain save's write (`answer`, [[write-work]]'s; nil when its task failed) into the
model: the buffer marked saved as of the text written, or the failure said — then the next save
waiting its turn."
  (let (job (:save-job m)
        rest-m (dissoc m :save-proc :save-job))
    (if (nil? job) rest-m (ed-save-finish rest-m job answer))))

;; check-allow: `then` is the caller's continuation; it answers a model
(check-allow :trusted
  (defn- ed-save-finish (m job answer)
    ;; the write behind `job` has landed (or failed): the buffer told, then the queue moves on
    (let (file (:file job)
          source (:source job)
          index (ed-job-index m job)
          reason (cond
                   (nil? answer) "the write did not finish"
                   (:error answer) (:error answer)
                   else nil))
      (ed-save-pump
        (cond
          (and reason source)
            (message m
              (str "write failed: "
                reason
                (ed-denied-hint reason)
                " — "
                (:name source)
                (if (:file source) (str " still visits " (:file source)) " visits no file")))
          reason
            (message m
              (str "save failed: "
                reason
                (ed-denied-hint reason)
                " — "
                file
                " is still modified"
                (or (:abandon-note job) "")))
          ;; the buffer was killed while its text was written
          (nil? index) (message m (str (if source "wrote " "saved ") file))
          else
            (let (retargeted (if source ((:retarget job) m index) m)
                  landed (ed-save-landed retargeted
                           index
                           (:rope job)
                           (if (:backup-failed answer) (str " — " (:backup-failed answer)) "")
                           (:mtime answer)
                           (= true (:from-hook job)))
                  known (if (:created? answer) (ed-project-files-forget landed file) landed))
              ((or (:then job) identity) known)))))))

(defn- ed-save-pump (m)
  "The next save waiting its turn launched once no write is out — passed over when its buffer
was killed, or has nothing unsaved (the write before it wrote the same text) — and, the queue
empty, what waited for it ([[ed-when-saves-land]])."
  (let (waiting (or (:save-waiting m) []))
    (cond
      (:save-proc m) m
      (empty? waiting) (ed-save-drained m)
      else
        (let (entry (first waiting)
              rest-m (if (= 1 (count waiting))
                       (dissoc m :save-waiting)
                       (assoc m :save-waiting (vec (rest waiting))))
              index (ed-job-index rest-m entry))
          (cond
            (nil? index) (ed-save-pump rest-m)
            ;; a write to a new path is made whether or not the text changed
            (and (nil? (:then entry))
              (nil? (:source entry))
              (not (buffer-modified? (ed-buf-at rest-m index))))
              (ed-save-pump rest-m)
            else (ed-save-launch rest-m index entry))))))

(defn- ed-save-drained (m)
  ;; no write out and none waiting: every continuation that waited for that, in order
  (let (drains (or (:save-drains m) []))
    (if (empty? drains)
      m
      (fold drains (dissoc m :save-drains) (fn (acc then) (then acc))))))

;; check-allow: `then` is a continuation (the quit's, C-x s's); it answers a model
(check-allow :trusted
  (defn ed-when-saves-land (m then)
    "`(then m)` once no plain save is out or waiting — at once when none is. What C-x C-c waits
on before asking whether to exit with modified buffers, so a write in flight is never cut off
by the quit; a failed write leaves its buffer modified, which that question then names. C-g
drops the wait (`commands/cmd-keyboard-quit`) and leaves the writes to land."
    (if (and (nil? (:save-proc m)) (empty? (or (:save-waiting m) [])))
      (then m)
      (assoc m :save-drains (conj (or (:save-drains m) []) then)))))
(sig ed-when-saves-land (model any -> model))

(defn- save-verb (entry)
  ;; a save, or a write to a new path (C-x C-w)
  (if (:source entry) "writing " "saving "))

(defn ed-save-live (m)
  "The plain saves C-x C-c would cut off (`model/register-exit-query`): the write out, and
those waiting their turn."
  (into (if (:save-job m) [(str (save-verb (:save-job m)) (:file (:save-job m)))] [])
    (map (or (:save-waiting m) [])
      (fn (entry) (str (save-verb entry) (:file entry) " (waiting)")))))

(register-task-reply :save-proc
  'file-save/ed-apply-save
  nil
  "saving"
  ;; NOT cancelled by C-g, which clears a region as often as it stops anything: a write
  ;; cut off would leave a save the user believes made. A wedged one ends at `*write-timeout-ms*`
  {})
(register-exit-query :save 'file-save/ed-save-live)
