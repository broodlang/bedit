(defmodule sshedit
  "Editing a file on ANOTHER MACHINE that has no bedit — Emacs's TRAMP `/ssh:` method — over the
system `ssh` (`sshremote`, the transport; `sshpath`, the path syntax).

  - `C-x C-f /ssh:host:/etc/nginx.conf` opens the file ([[ed-ssh-find-file]]); also
    `/ssh:user@host#port:path`, `~` (or a relative path) for the remote home, `~other/…` for
    another user's, and a route through jump hosts (`/ssh:bastion|ssh:host:/etc/x`, TRAMP's
    multi-hop, over ssh's ProxyCommand). The buffer VISITS the TRAMP path: its `buffer-file`
    is `/ssh:host:/etc/nginx.conf`, so no local tool takes it for a file here, and C-x C-f from
    it starts in the remote directory.
  - The buffer remembers it is remote (`:ssh`, the file handler's mark): C-x C-s writes it
    back through ssh, atomically, keeping the file's mode ([[ed-ssh-save]]); M-x revert-buffer
    and C-x RET r read it again; C-x C-w to an `/ssh:` path makes a buffer remote. The mode line
    says `@host` ([[ssh-segment]]).
  - The file goes through `charset` as any file does: a binary opens as the read-only hex
    view, a file past `:large-file-warning-threshold` is asked about first — before its bytes
    cross the network.
  - A remote DIRECTORY opens in dired ([[ed-ssh-dired]], the handler's `:dired`): the listing
    comes over ssh, RET visits, `g` lists again, and `+` `R` `C` `D` `x` make, move, copy and
    delete there (the handler's file operations) — a delete is for good, there is no trash on
    the other machine. `R` and `C` reach another host or this machine too (a target typed as
    another `/ssh:` path, or a local one): a checked copy streamed from one ssh to the other, a move removing
    the original once it landed. A target that exists is asked about first, as locally.
  - Every ssh call runs OFF the loop, one at a time, on `remotejob`'s queue (`:ssh-proc`;
    another waits its turn on `:ssh-waiting`): an open shows `Loading…` at once, a save leaves
    the buffer modified until its write lands, C-g stops either, C-x C-c asks about one still
    running and saves remote files after its questions. A connection that drops is said, and a
    save's buffer stays modified.
  - ssh runs with `BatchMode=yes`, on the user's own `~/.ssh/config` and agent, through ONE
    shared connection per host (`sshremote`'s ControlMaster). When the host refuses every key
    but takes a password, the password is read MASKED (`passwd/ed-read-passwd`) and used once,
    to open that connection (`sshremote/connect-with-password`) — kept nowhere. A JUMP HOST that
    wants one is named and asked for the same way: its own shared connection is opened with
    it, and the route rides that connection (`sshremote/route-failure`). A host key that is
    not known, or changed, is never accepted: it is said, with how to check it.
  - The auto-save sidecar is PRIVATE (`sidecar/ed-auto-save-path`: the editor's state folder,
    named for the TRAMP path) — never written on the remote host, never beside a local path of
    the same name. Auto-revert, diff-hl, LSP, the formatter, compile and the project walk leave
    a remote buffer alone (each asks `sshpath/remote?`)."
  (:use statusbar :only []) ; its chip registers at load, after statusbar is there
  (:use sshpath :only []) ; the path syntax, loaded with the handler (called qualified)
  (:use sshremote :only []) ; the transport, loaded with the handler (called qualified)
  (:use remotejob :only []) ; the one-job-at-a-time queue sudoedit shares (called qualified)
  (:use sshsudo :only []) ; the root hops' (`|sudo:`, `|su:`, `|doas:`) root shell, loaded with the transport
  (:use editor/buffer) ; buffer-file / buffer-text / replace-region / goto-char
  (:use editor/buffer-file) ; buffer-from-file
  (:use model) ; message / ed-buf-at / ed-current-buf / the registries
  (:use pool) ; ed-open-buffer / ed-kill-buffer-at / file-loading-buffer / ed-find-file-prompt
  (:use file-save) ; ed-save-buf-at / ed-save-landed
  (:use sidecar) ; ed-auto-save-path — the private sidecar
  (:use autorevert) ; ed-revert-at
  (:use theme)) ; *blue*

;; ---- one ssh job at a time, off the loop ----------------------------------------------
;; An open, a save, a revert or a directory listing is a JOB on `remotejob`'s queue, folded
;; back by [[ed-apply-ssh]]. A job whose host wants a password comes back asking and runs again
;; with it; the password lives in the task's closure for that one run.

(def *ssh-timeout-ms* 150000)
;; How long one job's task may run before it is killed and the job said to have failed: past
;; ssh's own operation timeout, so ssh's word on what went wrong is the one said.

(defdyn *large-default* (* 10 1000 1000))
;; The size past which a remote file is asked about before it is read, when the model names no
;; `:large-file-warning-threshold`.

(defn- job-operation (job parts)
  ;; the job's own ssh call
  (cond
    (= (:kind job) :save) (sshremote/write-file parts (:path parts) (:content job))
    (= (:kind job) :list) (sshremote/list-entries parts (:path parts))
    else (sshremote/read-file parts (:path parts) (if (:force job) 0 (or (:limit job) 0)))))

(defn ssh-work (job password)
  "What ssh `job` does, in its task: with `password`, first open what `:password-for` names with
it — the host's shared connection (nil, `sshremote/connect-with-password`), a jump host's (its
index on the route), or the root shell of the path's root hop (`:become`,
`sshremote/become-connect`) — then the job's operation: `sshremote/read-file` for an open or a
revert (nothing past `:limit` bytes but the size), `sshremote/write-file` for a save,
`sshremote/list-entries` for a directory dired shows. Answers that call's answer, `{:failed …}`
when ssh (or the root hop) failed (`:after-password` set when a password was just tried; `:hop` the jump
host that failed, when one did — `sshremote/blame-route`)."
  (let (parts (:parts job)
        target (:password-for job)
        connected (cond
                    (nil? password) true
                    (= target :become) (sshremote/become-connect parts password)
                    (int? target)
                      (sshremote/connect-with-password (sshremote/hop-parts parts target) password)
                    else (sshremote/connect-with-password parts password)))
    (if (map? connected)
      (assoc connected :after-password true :for target)
      (sshremote/blame-route parts (job-operation job parts)))))

(defn- job-doing (job)
  (str (case (:kind job) :open "opening " :revert "reverting " :list "listing " "saving ")
    (:spec job)))

(defn- who-of (parts target)
  ;; who a password or a refusal is about: the host, jump host `target` on its route, or the
  ;; root hop there (`:become`)
  (cond
    (= target :become) (sshsudo/who (:become parts) parts)
    (int? target) (sshpath/host-label (sshremote/hop-parts parts target))
    else (sshpath/host-label parts)))

(defn- password-prompt (job)
  (let (target (:password-for job)
        who (who-of (:parts job) target))
    (cond
      (= target :become) (sshsudo/password-question (:become (:parts job)) (:parts job))
      (int? target) (str "Password for " who " (jump host) (or a key's passphrase): ")
      else (str "Password for " who " (or a key's passphrase): "))))

(def- jobs
  ;; the ssh method on `remotejob`'s queue
  {:name "ssh"
   :prefix "ssh: "
   :proc :ssh-proc
   :job :ssh-job
   :waiting :ssh-waiting
   :loading :ssh-loading
   :target :spec
   :same [:kind :spec]
   :work (fn (job password) (ssh-work job password))
   :fold (fn (m answer) (ed-apply-ssh m answer))
   :timeout-ms *ssh-timeout-ms*
   :doing (fn (job) (job-doing job))
   :prompt (fn (job) (password-prompt job))})

(defn- ssh-launch (m job password) (remotejob/launch jobs m job password))

(defn- drop-placeholder (m spec) (remotejob/drop-placeholder jobs m spec))

(defn- ssh-failed (m job reason) (remotejob/failed jobs m job reason))

(defn ssh-buffer-index (m spec)
  "The pool index of the buffer visiting the remote file `spec` (a canonical ssh path), or nil."
  (let (index (seq/index-where (:buffers m)
                (fn (buffer) (and (= true (:ssh buffer)) (= (buffer-file buffer) spec)))))
    (if (< index 0) nil index)))

(defn ed-ssh-run-waiting (m)
  "A post-step: the first job on the ssh queue taken up once no ssh job runs — launched, or its
password asked for once the prompt is free too (`remotejob/run-waiting`)."
  (remotejob/run-waiting jobs m))

(register-post-step :ssh-ask {:order 81 :run 'sshedit/ed-ssh-run-waiting})

;; ---- opening --------------------------------------------------------------------------

(defn- unique-name (m spec)
  ;; the buffer's name: the file's, or with its host when another buffer has that name
  (let (parts (sshpath/parse spec)
        base (path/basename (:path parts))
        taken? (fn (name) (not (nil? (ed-buffer-index-by-name m name)))))
    (cond
      (not (taken? base)) base
      (not (taken? (str base "<" (:host parts) ">"))) (str base "<" (:host parts) ">")
      else
        (str base "<" (sshpath/host-label parts) ":" (sshpath/path-of (sshpath/dirname spec)) ">"))))

(defn ssh-buffer (spec text &optional (mtime nil))
  "A buffer visiting the remote file `spec`: `text` its contents as read through ssh — nil for
a file that does not exist yet — `:ssh` set, so a save writes it through ssh, and the file's
modification time on the host (seconds) as `:remote-mtime`.

    (:ssh (sshedit/ssh-buffer \"/ssh:h:/etc/hosts\" \"127.0.0.1 localhost\\n\"))   ;=> true"
  (assoc (if (nil? text)
           (make-buffer "" (path/basename (or (sshpath/path-of spec) spec)) spec)
           (buffer-from-file spec text))
    :ssh true
    :remote-mtime mtime))

(defn loading-buffer (spec)
  "The buffer an open of the remote file `spec` shows until its text lands: `Loading…`,
read-only, with no file of its own; `:ssh-loading` names the path.

    (:ssh-loading (sshedit/loading-buffer \"/ssh:h:/etc/hosts\"))   ;=> \"/ssh:h:/etc/hosts\""
  (file-loading-buffer spec
    (str (path/basename (or (sshpath/path-of spec) spec)) " <ssh: loading>")
    :ssh-loading))

(defn remote-recovery-note (spec mtime)
  "What opening the remote file `spec` (modified on the host at `mtime`, seconds) should say
when its private sidecar is newer — unsaved text a session left — or nil."
  (let (sidecar-mtime (file/mtime (ed-auto-save-path spec)))
    (when (and (int? sidecar-mtime) (or (nil? mtime) (> sidecar-mtime (* 1000 mtime))))
      (str (path/basename (sshpath/path-of spec))
        " has unsaved auto-save data — M-x recover-this-file to restore it"))))

(defn- ssh-opened (m job resolved read)
  "An open's answer landed: the file `read` (`{:kind :new}` or `{:kind :file :bytes :mtime}`)
in a remote buffer visiting `resolved`, shown where the `Loading…` one was, which goes. A
binary opens as the read-only hex view. Then the job's continuation."
  (let (bytes (:bytes read)
        decoded (if (nil? bytes) {:text nil} (charset/detect bytes)))
    (if (nil? decoded)
      ((remotejob/then-of job) (message (hexl/ed-open-binary (drop-placeholder m (:spec job))
                                          resolved nil bytes)
                                 (str "opened " resolved " as hex — not text, so read-only")))
      (let (buffer (assoc (charset/with-coding (ssh-buffer resolved (:text decoded) (:mtime read))
                            (:coding decoded))
                     :name (unique-name m resolved))
            opened (drop-placeholder (ed-open-buffer m buffer) (:spec job))
            shown (let (index (ssh-buffer-index opened resolved))
                    (if (nil? index) opened (ed-select opened index))))
        ((remotejob/then-of job) (message shown
                                   (or (remote-recovery-note resolved (:mtime read))
                                     (str (if (nil? bytes) "new file " "opened ")
                                       resolved
                                       (if (:coding decoded)
                                         (str " as " (charset/label (:coding decoded)))
                                         "")))))))))

(defn- ssh-open-answer (m job answer)
  "Fold an open's `answer` (`sshremote/parse-read`'s): a file or a new one opens
([[ssh-opened]]) — or the buffer already visiting it under another spelling (`~`) is selected;
a large file is asked about first; a directory opens in dired (the `:directory` presenter,
which lists it through [[ed-ssh-dired]])."
  (let (resolved (or (sshpath/canonical (sshpath/with-path (:spec job) (:path answer))) (:spec job))
        existing (ssh-buffer-index m resolved))
    (cond
      existing ((remotejob/then-of job) (ed-select (drop-placeholder m (:spec job)) existing))
      ;; asked with no `Loading…` buffer behind the question, so a `n` leaves none; a `y` shows
      ;; it again while the bytes cross
      (= (:kind answer) :large)
        (ed-confirm (drop-placeholder m (:spec job))
          (str "File "
            (path/basename (:path answer))
            " is large ("
            (humanize/byte-size (:size answer))
            "), really open it over ssh? (y or n)")
          (fn (mm)
            (ssh-launch (ed-open-buffer mm (loading-buffer (:spec job)))
              (assoc job :force true)
              nil))
          "not opened")
      (= (:kind answer) :dir)
        (let (without (message (drop-placeholder m (:spec job)) (str "listing " resolved)))
          (ed-present without
            :directory (message without (str resolved " is a directory — no dired is loaded"))
            resolved))
      else (ssh-opened m job resolved answer))))

;; check-allow: `then` is the caller's continuation (recover-session's), whose result the
;; checker cannot see; every caller hands one that answers a model
(check-allow :trusted
  (defn ed-ssh-find-file (m spec &optional (then identity))
    "Open the TRAMP ssh path `spec` (`/ssh:host:/etc/hosts`) OFF the loop — a `Loading…` buffer
shown at once, the file when ssh answers, a password asked for first when the host wants one —
then `(then m)` with it open. A buffer already visiting it is selected; a path that is not one
is said."
    (let (canonical (sshpath/canonical spec)
          open-index (when canonical (ssh-buffer-index m canonical))
          loading-index (when canonical (remotejob/placeholder-index jobs m canonical)))
      (cond
        (nil? canonical)
          (message m (str "not an ssh path: " spec " (/ssh:[user@]host[#port]:path)"))
        (includes? canonical "\n") (message m "ssh: a path with a line break in it is not opened")
        (int? open-index) (then (ed-select m open-index))
        (int? loading-index) (ed-select m loading-index)
        else
          (ssh-launch (ed-open-buffer m (loading-buffer canonical))
            {:kind :open
             :spec canonical
             :parts (sshpath/parse canonical)
             :limit (or (:large-file-warning-threshold m) *large-default*)
             :then then}
            nil)))))
(sig ed-ssh-find-file (model string &optional any -> model))

;; ---- saving ---------------------------------------------------------------------------

(defn- ssh-saved (m job answer)
  "A save's write landed: its buffer marked saved as of the text written
(`file-save/ed-save-landed` — still modified if edited meanwhile), the host's new time kept, the
directory's listing forgotten (a new file is in it now), then the continuation."
  (let (index (ssh-buffer-index m (:spec job))
        host (sshpath/host-label (:parts job))
        _ (sshremote/forget-listing (sshpath/dirname (:spec job)))
        saved (if (nil? index)
                (message m (str "saved " (:spec job)))
                (let (landed (ed-save-landed m index (:rope job) (str " on " host)))
                  (ed-set-buf-at landed
                    index
                    (assoc (ed-buf-at landed index) :remote-mtime (:mtime answer))))))
    ((remotejob/then-of job) saved)))

;; check-allow: `then` is a continuation (the quit's, C-x s's), whose result the checker cannot
;; see; every caller hands one that answers a model
(check-allow :trusted
  (defn ed-ssh-save (m i &optional (then nil) (abandon-note nil))
    "Save pool buffer `i`, a remote buffer, through ssh OFF the loop — a password asked for first
when the host wants one (`remotejob/save`). It stays modified until the write lands, and a write
that fails — the connection dropped, the file not writable — leaves it so and says why. `then`
runs once the write has landed; `abandon-note` follows the reason when it does not."
    (remotejob/save jobs
      m
      i
      then
      abandon-note
      (fn (prepared _buffer)
        {:spec (buffer-file prepared) :parts (sshpath/parse (buffer-file prepared))}))))
(sig ed-ssh-save (model int &optional any any -> model))

;; check-allow: as above — `then` is the caller's
(check-allow :trusted
  (defn ed-ssh-save-all (m specs then &optional (abandon-note nil))
    "Save every remote buffer in `specs` in turn — one ssh job at a time, each asking for a
password when its host wants one — then `(then m)`. One that fails stops the run there, saying
why with `abandon-note`: what C-x C-c and C-x s do with the remote buffers they were told to
save."
    (remotejob/save-all m specs then abandon-note ssh-buffer-index ed-ssh-save)))
(sig ed-ssh-save-all (model seqable any &optional any -> model))

;; ---- reverting ------------------------------------------------------------------------

(defn- ssh-reverted (m job answer)
  "A revert's answer landed: the buffer holds the remote file as it is, in the job's `:coding`,
one undoable edit — or the hex view for `:hex`. A file that is gone, or not in that coding, is
said and the buffer left as it was."
  (let (i (ssh-buffer-index m (:spec job))
        coding (:coding job)
        bytes (:bytes answer)
        text (when (and (bytes? bytes) (not (= coding :hex)))
               (charset/decode bytes (or coding :utf-8))))
    (cond
      (nil? i) m
      (not (bytes? bytes)) (ssh-failed m job (str (:spec job) " is gone, or not a file"))
      (= coding :hex) (ed-show-as-hex m i bytes)
      (nil? text) (message m (str (:spec job) " is not " (charset/label coding)))
      else
        (let (reverted (ed-revert-at (ed-set-buf-at m
                                       i
                                       (charset/with-coding (ed-buf-at m i) coding))
                         i text))
          (message (ed-set-buf-at reverted
                     i
                     (assoc (ed-buf-at reverted i) :remote-mtime (:mtime answer)))
            (str "reverted " (:spec job)))))))

(defn ed-ssh-revert (m i coding)
  "Read pool buffer `i`, a remote buffer, again through ssh OFF the loop: the file in `coding`
(nil for the one it has, `:hex` for the hex view) replaces its text, one undoable edit. What
M-x revert-buffer and C-x RET r do for a remote file."
  (let (buffer (ed-buf-at m i))
    (ssh-launch m
      {:kind :revert
       :spec (buffer-file buffer)
       :parts (sshpath/parse (buffer-file buffer))
       :force true
       :coding (or coding (:coding buffer))}
      nil)))

;; ---- a remote directory in dired ------------------------------------------------------

(defn ed-ssh-dired (m dir &optional (line nil))
  "Show the remote directory `dir` (an ssh path) in dired — the file handler's `:dired`, which
dired's `ed-show-dired` asks before it lists a directory itself: the entries listed over ssh OFF
the loop (`sshremote/list-entries`, a password asked for first when the host wants one), then
`dired/ed-dired-show-entries` with them, point on (1-based) `line`."
  (let (canonical (sshpath/canonical dir))
    (if (nil? canonical)
      (message m (str "not an ssh path: " dir))
      (ssh-launch m
        {:kind :list :spec canonical :parts (sshpath/parse canonical) :line line}
        nil))))

(defn- ssh-listed (m job answer)
  ;; a listing landed: dired shows it, under the directory as the remote shell resolved it
  (let (resolved (or (sshpath/canonical (sshpath/with-path (:spec job) (:dir answer)))
                   (:spec job)))
    (dired/ed-dired-show-entries m resolved (:entries answer) (:line job))))

;; The handler's file operations, which dired calls OFF the loop (its operations run in a
;; task): each blocks on ssh, raises with the reason when it fails, and forgets the directory
;; listing the path prompt kept.

(defn- ssh-parts-of (spec)
  (or (sshpath/parse spec) (error (str "not an ssh path: " spec))))

(defn- fs-done (result spec)
  ;; `result` of a transport operation on `spec`: raised when it failed, else itself
  (do
    (sshremote/forget-listing (sshpath/dirname spec))
    (if (failure? result) (error (error-message result)) result)))

(defn ssh-make-directory (spec)
  "Make the remote directory `spec` — the handler's `:make-directory`, dired's `+`. Blocks;
raises with the reason when it fails."
  (let (parts (ssh-parts-of spec)) (fs-done (sshremote/make-directory parts (:path parts)) spec)))

(defn ssh-delete-file (spec)
  "Delete the remote `spec` for good, a directory with everything in it — the handler's
`:delete-file`, dired's `D` and `x`. Blocks; raises with the reason when it fails."
  (let (parts (ssh-parts-of spec)) (fs-done (sshremote/delete-path parts (:path parts)) spec)))

(defn ssh-make-symbolic-link (target link &optional (replace? false))
  "Make the ssh path `link` a symlink to `target`, stored as given (relative to the link's
directory, or absolute on its host) — the handler's `:make-symbolic-link` (Emacs's op name),
wdired's re-pointed link. Over an entry there only when `replace?`, never over a directory.
Blocks; raises with the reason when it fails."
  (let (parts (ssh-parts-of link))
    (fs-done (sshremote/make-symlink parts target (:path parts) replace?) link)))

(defn ssh-set-file-modes (spec mode)
  "Set the mode bits of the ssh path `spec` to `mode` (0..0o7777) — the handler's
`:set-file-modes` (Emacs's op name), wdired's edited permissions. Blocks; raises with the reason
when it fails."
  (let (parts (ssh-parts-of spec)) (fs-done (sshremote/set-mode parts (:path parts) mode) spec)))

(defn- side-of (path)
  ;; `[parts remote-path]` for an ssh path, `[nil path]` for a path on this machine; raised for
  ;; one another file handler claims (a `/sudo::` path), which no copy here reaches
  (cond
    (sshpath/remote? path) (let (parts (ssh-parts-of path)) [parts (:path parts)])
    (or (not (nil? (ed-path-handler path))) (not (string/starts-with? path "/")))
      (error (str "over ssh an entry is copied to and from ssh paths and this machine, not " path))
    else [nil path]))

(defn- forget-side (path)
  ;; what the path prompt kept of the remote directory holding `path`, forgotten
  (when (sshpath/remote? path) (sshremote/forget-listing (sshpath/dirname path))))

(defn- ssh-transfer (op from to into? replace?)
  ;; move or copy `from` to `to` — on one host, between two, or between a host and this machine
  ;; (one of them an ssh path); where it went, an ssh path or a local one
  (let ([from-parts from-path] (side-of from)
        [to-parts to-path] (side-of to)
        went (if (and from-parts to-parts (sshpath/same-connection? from to))
               (sshremote/transfer from-parts op from-path to-path into? replace?)
               (sshremote/cross-transfer op from-parts from-path to-parts to-path into? replace?)))
    (do
      (forget-side from)
      (forget-side to)
      (cond
        (failure? went) (error (error-message went))
        (nil? to-parts) went
        else (sshpath/with-path to went)))))

(defn ssh-rename-file (from to into? &optional (replace? false))
  "Move `from` to `to` — the handler's `:rename-file`, dired's `R`: within one host by a rename
there, between two hosts or a host and this machine (one of them an ssh path) as a checked copy
that removes the original once it landed (`sshremote/cross-transfer`). Into `to` when it is a
directory (which it must be when `into?`); never over a directory, over another entry only when
`replace?`. Where it went. Blocks; raises with the reason when it fails."
  (ssh-transfer :move from to into? replace?))

(defn ssh-copy-file (from to into? &optional (replace? false))
  "Copy `from` (a directory with everything in it) to `to`, as [[ssh-rename-file]] moves it — the
handler's `:copy-file`, dired's `C`."
  (ssh-transfer :copy from to into? replace?))

(defn ssh-file-kind (spec)
  "What the ssh path `spec` names on its host — `:dir`, `:file` or nil — the handler's
`:file-kind`, which dired asks before R or C to know whether a target goes INTO a directory and
whether it would replace an entry. Blocks; raises with the reason when ssh fails."
  (let (parts (ssh-parts-of spec)
        kind (sshremote/file-kind parts (:path parts)))
    (if (failure? kind) (error (error-message kind)) kind)))

;; ---- the job's fold -------------------------------------------------------------------

(defn- ssh-answer (m job answer)
  ;; a landed job's answer read the ssh way (`remotejob/landed` took the common cases)
  (let (failed (when (map? answer) (:failed answer)))
    (cond
      (and failed (= (:error failed) :auth) (:after-password answer))
        (ssh-failed m job (str (who-of (:parts job) (:for answer)) " refused the password"))
      ;; the host, or the jump host on its way that refused (`:hop`), wants a password
      (and failed (= (:error failed) :auth) (:password? failed))
        (remotejob/ask jobs m (assoc job :password-for (:hop answer)))
      ;; the path's root hop wants a password there
      (and failed (= (:error failed) :become-password))
        (remotejob/ask jobs m (assoc job :password-for :become))
      failed (ssh-failed m job (:reason failed))
      (failure? answer) (ssh-failed m job (error-message answer))
      (= (:kind job) :open) (ssh-open-answer m job answer)
      (= (:kind job) :revert) (ssh-reverted m job answer)
      (= (:kind job) :list) (ssh-listed m job answer)
      else (ssh-saved m job answer))))

(defn ed-apply-ssh (m answer)
  "Fold a finished ssh job's `answer` ([[ssh-work]]; nil when its task failed or timed out):
ask for the password its host wants, open the file, show the listing, mark the save landed — or
say why not."
  (remotejob/landed jobs m answer ssh-answer))

(defn ed-ssh-quit (m)
  "C-g's clean-up for an ssh job (its task already killed): an open's `Loading…` buffer goes, a
save's buffer stays modified, and C-g says what stopped."
  (remotejob/quit jobs m))

(defn ed-ssh-live (m)
  "The ssh jobs C-x C-c would stop (`model/register-exit-query`): the one running, and those
waiting their turn."
  (remotejob/live jobs m))

(register-task-reply :ssh-proc
  'sshedit/ed-apply-ssh
  nil
  "ssh"
  {:cancel-on-quit? true :on-quit 'sshedit/ed-ssh-quit})
(register-exit-query :ssh 'sshedit/ed-ssh-live)

;; ---- the file handler -----------------------------------------------------------------

(sig ed-ssh-write-file (model string -> model))
(defn ed-ssh-write-file (m spec)
  "C-x C-w to a TRAMP ssh path: the current buffer becomes a remote buffer visiting that file
and is saved through ssh."
  (let (canonical (sshpath/canonical spec))
    (if (or (nil? canonical) (= (sshpath/path-of canonical) "~"))
      (message m (str "write failed: not an ssh file path: " spec " (/ssh:host:PATH)"))
      (let (old (ed-current-buf m)
            old-key (hosted/hosted-key old)
            retargeted (assoc (dissoc (ed-buffer-unhandled old) :dir)
                         :file canonical
                         :dir (sshpath/dirname canonical)
                         :ssh true
                         :name (unique-name m canonical))
            index (ed-current-index m)
            rekeyed (hosted/hosted-rekey-slot (dissoc (ed-set-buf m retargeted) :status)
                      index old-key))
        (do (ed-forget-auto-save old) (ed-save-buf-at rekeyed index))))))

(defn ssh-later-entry (buffer)
  "What a quit keeps of remote `buffer` to save it after the questions: its path, for
[[ed-ssh-save-all]]."
  (buffer-file buffer))

(register-file-handler :ssh
  {:order 15
   :prefix "/ssh:"
   :mark :ssh
   :buffer-keys [:ssh :remote-mtime]
   :find-file 'sshedit/ed-ssh-find-file
   :write-file 'sshedit/ed-ssh-write-file
   :save 'sshedit/ed-ssh-save
   :revert 'sshedit/ed-ssh-revert
   :later-entry 'sshedit/ssh-later-entry
   :save-all 'sshedit/ed-ssh-save-all
   :dired 'sshedit/ed-ssh-dired
   :expand-file-name 'sshpath/join
   :parent-directory 'sshpath/dirname
   :make-directory 'sshedit/ssh-make-directory
   :delete-file 'sshedit/ssh-delete-file
   :rename-file 'sshedit/ssh-rename-file
   :copy-file 'sshedit/ssh-copy-file
   :make-symbolic-link 'sshedit/ssh-make-symbolic-link
   :set-file-modes 'sshedit/ssh-set-file-modes
   :file-kind 'sshedit/ssh-file-kind})

;; ---- a kill ---------------------------------------------------------------------------

(defn ed-ssh-cancel-killed (m killed)
  "`m` with the open behind a killed `Loading…` buffer cancelled: its task stopped, so no
buffer appears after all. Any other kill leaves it as it is."
  (remotejob/cancel-killed jobs m killed))

(register-slot-keeper :ssh-open {:order 27 :drop 'sshedit/ed-ssh-cancel-killed})

;; ---- the mode line --------------------------------------------------------------------

(defn ssh-segment (m pane buffer)
  "The `@host` chip on a remote buffer's mode line — Emacs shows the TRAMP prefix there — as a
reminder that the file is on another machine, and `@host # root` (the user) when it is edited
there through a root hop (`|sudo:`, `|su:`, `|doas:`); nil on any other buffer."
  (when (= true (:ssh buffer))
    (let (parts (sshpath/parse (buffer-file buffer)))
      (when parts
        (statusbar/seg :ssh
          (str "@"
            (sshpath/host-label parts)
            (if (:become parts) (str " # " (or (:user (:become parts)) "root")) ""))
          {:sep "  —  "
           :face {:fg *blue* :bold true}
           :tooltip (fn (_mm)
                      [(str "editing "
                         (:path parts)
                         " on "
                         (sshpath/route-label parts)
                         (if (:become parts) (str " as " (or (:user (:become parts)) "root")) ""))
                        "C-x C-s writes it back through ssh"])})))))

(statusbar/register-modeline-segment :ssh 31 'sshedit/ssh-segment)
