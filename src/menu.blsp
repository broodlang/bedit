(defmodule menu
  "The right-click context menu: which actions it offers now, opening and closing it, and
running one. It is a key panel (`panel`, the `:context-menu` source), the way embark offers
its actions: each action under a letter of its own, taken from its binding where that reads
well — Copy (M-w) is `w`, Paste (C-y) `y`, Select All (C-x h) `h`, but Cut (C-w) is `k`, for
kill, since `w` is Copy's — and a click on an entry runs it too. A key on an action that does
not apply now says why. How it looks is the panel style's; this module is the model half.

An item names its command by SYMBOL and resolves it when it runs, exactly as a key binding
does — so redefining `cmd-copy-region` at runtime changes what the menu's Copy does too."
  (:use editor/buffer) ; buffer-region — whether there is a region to copy / cut
  (:use interactive) ; defcommand
  (:use results) ; ed-link-at-point — Copy is enabled on a link line too
  (:use editor/ui :only [Overlay overlay-active? overlay-owns? overlay-handle overlay-exit]) ; its key overlay
  (:use keyhelp :only [ed-cancel-key?])
  (:use panel :only [register-panel-source]) ; the menu shown as a key panel
  (:use guest)
  (:use model)) ; ed-current-buf

;; ---- the items --------------------------------------------------------------
;; A modal overlay on `:menu` offering actions that run the *same* commands as the keyboard
;; (so Copy is exactly M-w, Cut C-w, Paste C-y, Select All C-x h — and thus the same
;; OS-clipboard sync). Opened by a right-press (events/ed-ev-mouse), an action chosen by its
;; key or by a click on its entry. Items are maps `{:key :label :binding :group :run
;; :enabled :why}` — enabled/disabled computed when the menu opens, so it reflects the current
;; region / clipboard, like a native menu. The `:run` command SYMBOL is only resolved when the
;; item runs.

(defn- ed-menu-items-for (m)
  "The context-menu items for the current model — each with the key that chooses it, its
keyboard binding, its group, whether it applies now (`:enabled`; a disabled item shows dimmed
and won't run) and, when it does not, why (`:why`). Copy is enabled by a region OR a link under
point; Cut by a region; Paste by a non-empty kill ring."
  (let (has-region (not (nil? (buffer-region (ed-current-buf m))))
        has-link (not (nil? (ed-link-at-point m)))
        has-clip (not (empty? (:kill-ring m))))
    [{:key "w"
      :label "Copy"
      :binding "M-w"
      :group "Edit"
      :run 'killing/cmd-copy-region
      :enabled (or has-region has-link)
      :why "no region"}
      {:key "k"
       :label "Cut"
       :binding "C-w"
       :group "Edit"
       :run 'killing/cmd-kill-region
       :enabled has-region
       :why "no region"}
      {:key "y"
       :label "Paste"
       :binding "C-y"
       :group "Edit"
       :run 'killing/cmd-yank
       :enabled has-clip
       :why "the kill ring is empty"}
      {:key "h"
       :label "Select All"
       :binding "C-x h"
       :group "Select"
       :run 'region/cmd-mark-whole-buffer
       :enabled true}]))

(defn ed-open-menu (m)
  "Open the context menu (point and the region are left untouched, so Copy/Cut act on the
current selection)."
  (assoc m :menu {:items (ed-menu-items-for m)}))

(defn ed-close-menu (m) "Dismiss the context menu." (dissoc m :menu))

(defcommand cmd-context-menu-open
  (m _key)
  "Open the context menu, as a right click opens it — Emacs's `context-menu-open`, on the menu
key and S-F10."
  (ed-open-menu m))

;; check-allow: the item's command is resolved late (`reflect/eval`), so its result is unknown
;; to the checker; every command answers a model
(check-allow :trusted
  (defn ed-menu-activate (m i)
    "Run item `i`'s command (`key` = nil) with the menu closed — so the command sees no `:menu`
and its copy/cut/paste is the real edit. A disabled item runs nothing and says why, the menu left
open (`Copy: no region`, as Emacs's menu says). The command symbol is resolved now, not when the
menu opened, so a redefined command runs."
    (let (item (nth (:items (:menu m)) i nil)
          run (:run item))
      (cond
        (nil? item) m
        (not (:enabled item)) (message m (str (:label item) ": " (or (:why item) "not now")))
        ;; a guest's session runs only what it may — from the menu as from a key
        (and (:guest-session m) (not (ed-guest-allows? run))) (ed-guest-refusal (ed-close-menu m))
        else ((if (symbol? run) (reflect/eval run) run) (ed-close-menu m) nil)))))
(sig ed-menu-activate (model int -> model))

(defn- ed-menu-key-index (m input)
  ;; the index of the item `input` chooses, or nil
  (let (items (:items (:menu m)))
    (seq/find (range (count items)) (fn (i) (= (:key (nth items i)) input)))))

;; ---- the menu as a key panel ------------------------------------------------

(defn menu-panel-deps (m) "What the context menu's panel is made from: the open menu." (:menu m))

(defn menu-panel (menu _rows)
  "The open context `menu` as a key panel: its items under their keys, grouped as they are
(Edit, Select), each saying its binding; nil when none is open."
  (when menu
    (let (items (:items menu)
          groups (reduce (range (count items))
                   []
                   (fn (groups i)
                     (let (item (nth items i)
                           entry {:key (:key item)
                                  :text (str (:label item) "  " (:binding item))
                                  :enabled (:enabled item)
                                  :index i}
                           group (last groups))
                       (if (and group (= (:title group) (:group item)))
                         (assoc groups
                           (dec (count groups)) (assoc group :rows (conj (:rows group) entry)))
                         (conj groups {:title (:group item) :rows [entry]}))))))
      {:title "Context menu" :groups groups :layout :balanced})))

(defn menu-panel-click (m entry)
  "A click on the context menu's `entry`: run its item."
  (ed-menu-activate m (:index entry)))

(register-panel-source :context-menu
  {:rank 5
   :when :menu
   :deps 'menu/menu-panel-deps
   :run 'menu/menu-panel
   :click 'menu/menu-panel-click})

;; ---- the key overlay --------------------------------------------------------

(defrecord menu-overlay ()) ; the right-click context menu: an item's key runs it, Esc / C-g close
(impl Overlay
  menu-overlay
  (overlay-active? (_ m) (:menu m))
  ;; no overlay-owns? — modal: every key is the menu's while it's open
  (overlay-handle (_ m input)
    (let (index (ed-menu-key-index m input))
      (cond
        (not (nil? index)) (ed-menu-activate m index)
        (ed-cancel-key? input) (ed-close-menu m)
        ;; any other key is swallowed (the menu stays open)
        else m))))

(register-overlay :menu 30 (menu-overlay))
