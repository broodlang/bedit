(defmodule sshremote
  "The TRANSPORT under `/ssh:` paths (`sshedit`): the system `ssh` binary run through brood's
`os/cmd`, one connection SHARED by every operation on a host (OpenSSH's ControlMaster, its
socket under the editor's state folder, owner-only, kept `*persist-seconds*` after the last
use), and the remote half of each operation as a POSIX `sh` script.

- **Nothing the remote LOGIN shell parses but `/bin/sh -s`.** The script — its arguments
  quoted for POSIX sh (`os/shell-quote`) and set with `set --`, and a write's bytes as Base64
  in a here-document — goes on ssh's standard input. So a path with a space, a quote, a `$`
  or a newline-free metacharacter is one argument, whatever shell the account logs into
  (bash, zsh, fish, csh).
- **Bytes, not text.** A read comes back through `base64`, so a binary or a file in another
  coding arrives exactly; the editor decodes it as it decodes any file (`charset`).
- **A write is atomic.** The bytes are staged in a temporary file in the file's own
  directory (given the file's mode first: `cp -p`), checked against the byte count and
  SHA-256 sent with them, then renamed over the file. A file with other hard links, or in a
  directory the user may not write, is copied into instead. A write cut short leaves the
  file as it was. A symbolic link is written through.
- **Never a prompt on the loop.** Every operation runs `BatchMode=yes`: ssh fails at once
  rather than asking. A failure is CLASSIFIED ([[classify]]) — the host key unknown or
  changed (never accepted for you), authentication refused (a password may be asked for,
  [[connect-with-password]]), the connection failed or dropped — and said.
- **A password is used once.** [[connect-with-password]] opens the shared connection with it:
  `SSH_ASKPASS` names a helper ([[askpass-helper]]) that reads the password from ssh's own
  standard input — never the environment, never a file — and refuses every other question
  (a host-key confirmation above all). The connection then serves the operations without it.

- **A route through jump hosts** (`/ssh:bastion|ssh:host:`, `sshpath`'s `:hops`) is a nested
  `ProxyCommand` of `ssh -W`, every hop in batch mode ([[proxy-command]]) and riding the hop's
  own shared connection when it has one. When the route fails, each hop is tried in turn
  ([[route-failure]]): the one that refused is named, and a password it would take opens ITS
  connection, once ([[hop-parts]], [[connect-with-password]]).
- **Dired's side.** A directory listed as `ls -l` facts ([[list-entries]]), and its entries
  made, moved, copied and deleted on the host ([[make-directory]], [[transfer]],
  [[delete-path]]) — never over a directory, over another entry only when told to
  ([[file-kind]] is what dired asks first) — and copied or moved between two machines, or a host
  and this one, as a checked tar stream piped from one ssh to the other, never held here ([[cross-transfer]]).
- **A root hop** (`|sudo:`, `|su:`, `|doas:`) runs every script in the host's root shell instead (`sshsudo`, [[run]],
  [[become-connect]]).

`*program*` names the ssh run — a test binds a stand-in that runs the script locally, so no
test reaches a network. Pure command construction ([[ssh-argv]], the scripts) is separate
from the call ([[run]]).")

;; ---- the program and the shared connection --------------------------------------------

(defdyn *program* "ssh")
;; The ssh program run — a path or a name on PATH. A test binds a stand-in script.

(def *persist-seconds* 300)
;; How long the shared connection outlives its last operation (ControlPersist).

(def *connect-timeout-seconds* 15)
;; How long a connection may take to come up before ssh gives up (ConnectTimeout).

(def *alive-interval-seconds* 15)
;; How often a quiet connection is checked (ServerAliveInterval): a dropped network is noticed
;; within twice this, instead of an operation waiting on a dead socket until its task times out.

(def *socket-path-max* 100)
;; The longest control socket path used as is: a Unix socket's path is limited (108 bytes on
;; Linux, 104 on macOS) and ssh appends a random suffix while it makes one.

(defdyn *control-dir* nil)
;; Where the sockets go when bound — a test's own folder. nil: [[control-dir]]'s rule.

(def- *route-key-length* 8) ; hex characters of a route's hash in front of `%C` (control-name)

(defn control-dir ()
  "Where the shared connections' sockets live: `state/ssh` under the editor's config folder
(owner-only; [[ensure-control-dir]]) — or, when that path is too long for a Unix socket,
`$XDG_RUNTIME_DIR/bedit-ssh`, else `/tmp/bedit-ssh-USER`. `*control-dir*` overrides it."
  (let (preferred (or *control-dir* (path/join (config-paths/config-dir) "state" "ssh")))
    (if (or *control-dir*
          (<= (+ (string/length preferred) 1 *route-key-length* 1 40 17) *socket-path-max*))
      preferred
      (let (runtime (os/env "XDG_RUNTIME_DIR"))
        (if (and (string? runtime) (not (string/blank? runtime)))
          (path/join runtime "bedit-ssh")
          (path/join "/tmp" (str "bedit-ssh-" (or (os/user-name) "user"))))))))

(defn ensure-control-dir ()
  "Make [[control-dir]] owner-only (0700) — the sockets in it ARE the connections: whoever can
reach one runs commands as you on that host. Its path."
  (let (dir (control-dir)) (do (file/mkdir-private dir) dir)))

(defn control-name (hops)
  "The socket name a connection reached through the jump hosts `hops` keeps under
[[control-dir]], ssh's `%C` still unexpanded: `%C` alone for a direct one, the route's hash in
front of it for one through jump hosts. `%C` hashes only the host, port and user, so without
the route a direct `/ssh:web1:` would ride a connection opened through a jump host — and work
for as long as that connection persisted, then not.

    (sshremote/control-name [])   ;=> \"%C\"
    (string/ends-with? (sshremote/control-name [{:host \"bastion\"}]) \"-%C\")   ;=> true"
  (if (empty? hops)
    "%C"
    (str (string/substring (hash/sha256 (sshpath/route-label {:host "" :hops hops}))
           0 *route-key-length*)
      "-%C")))

(defn- user-port-options (parts)
  ;; `-p PORT` and `-l USER` for the ones `parts` names
  (into (if (:port parts) ["-p" (str (:port parts))] [])
    (if (:user parts) ["-l" (:user parts)] [])))

(defn- escape-percent (text)
  ;; `text` read back exactly by the ssh that expands `%` escapes in it (a ProxyCommand)
  (string/replace text "%" "%%"))

(defn jump-argv (hops)
  "The ssh run that carries a connection through the LAST of the jump hosts `hops` (`-W`, to
the target host and port as the ssh using it expands `%h` and `%p`), itself reached through
the ones before it ([[proxy-command]], nested). Always batch mode — no prompt can reach a person
from inside another ssh — but through the hop's own SHARED connection when one is open
(`ControlPath`, `ControlMaster=no`: use it, never make one): a jump host that wants a password
gets it once, when its connection is opened ([[route-failure]], [[hop-parts]],
[[connect-with-password]]), and every -W after that rides it.

    (last (sshremote/jump-argv [{:host \"bastion\"}]))   ;=> \"bastion\""
  ;; the ControlPath escaped (`%%C`): the ssh running this ProxyCommand hands `%C` on, for THIS one
  ;; to expand — the hop's own socket, keyed by the hops before it as [[ssh-options]] keys it
  (let (hop (last hops)
        earlier (vec (take hops (dec (count hops)))))
    (into []
      (append [*program*
                "-o"
                "BatchMode=yes"
                "-o"
                "ControlMaster=no"
                "-o"
                (str "ControlPath=" (escape-percent (str (control-dir) "/" (control-name earlier))))
                "-o"
                (str "ConnectTimeout=" *connect-timeout-seconds*)
                "-o"
                (str "ServerAliveInterval=" *alive-interval-seconds*)
                "-o"
                "ServerAliveCountMax=2"]
        (if (empty? earlier)
          []
          ["-o" (str "ProxyCommand=" (escape-percent (proxy-command earlier)))])
        (user-port-options hop)
        ["-W" "[%h]:%p" "--" (:host hop)]))))

(defn proxy-command (hops)
  "The `ProxyCommand` that reaches a host through the jump hosts `hops` (TRAMP's multi-hop
`/ssh:bastion|ssh:host:`): [[jump-argv]] quoted for `/bin/sh`, which ssh runs it with (the
env names `SHELL`). ssh's own `-J` is not used because it passes none of these options on to
the jump: a jump host wanting a password would prompt on a terminal, or hang.

    (string/ends-with? (sshremote/proxy-command [{:host \"bastion\" :port 2222}]) \"-p 2222 -W '[%h]:%p' -- bastion\")   ;=> true"
  (string/join (map (jump-argv hops) os/shell-quote) " "))

(defn ssh-options (parts &optional (batch true) (tty false))
  "The ssh options every operation on `parts`' host runs with: the shared connection
(`ControlMaster=auto`, `ControlPath=DIR/%C`, `ControlPersist`), a connect timeout, keep-alives
that notice a dropped network, no terminal (a forced one, `-tt`, when `tty`: a root hop whose password is read only from one), no escape character — and `BatchMode=yes` unless
`batch` is false (the one call a password opens, [[connect-with-password]]). A path through
jump hosts (`:hops`) reaches the host through them ([[proxy-command]]). The user's own
`~/.ssh/config` still applies: an `IdentityFile`, a host alias, a `ProxyJump` of its own.

    (includes? (sshremote/ssh-options {:host \"h\"}) \"BatchMode=yes\")   ;=> true"
  (let (dir (control-dir)
        hops (or (:hops parts) []))
    (into []
      (append ["-o"
                "ControlMaster=auto"
                "-o"
                (str "ControlPath=" dir "/" (control-name hops))
                "-o"
                (str "ControlPersist=" *persist-seconds*)
                "-o"
                (str "ConnectTimeout=" *connect-timeout-seconds*)
                "-o"
                (str "ServerAliveInterval=" *alive-interval-seconds*)
                "-o"
                "ServerAliveCountMax=2"
                "-o"
                (if batch "BatchMode=yes" "BatchMode=no")
                (if tty "-tt" "-T")
                "-e"
                "none"]
        (if batch [] ["-o" "NumberOfPasswordPrompts=1"])
        (if (empty? hops) [] ["-o" (str "ProxyCommand=" (proxy-command hops))])
        (user-port-options parts)))))

(defn ssh-argv (parts remote-command &optional (batch true) (tty false))
  "The arguments ssh runs `remote-command` (one string, for the login shell) on `parts`' host
with: [[ssh-options]], `--` (so nothing after it is an option), the host, the command.

    (last (sshremote/ssh-argv {:host \"h\"} \"/bin/sh -s\"))   ;=> \"/bin/sh -s\""
  (into (ssh-options parts batch tty) ["--" (:host parts) remote-command]))

(def *script-command* "/bin/sh -s")
;; The one command the remote login shell parses: a POSIX shell reading the script from its
;; standard input. Nothing in it any shell treats specially.

(def- ssh-env
  ;; ssh's own messages in English, read only to tell what failed; a jump's ProxyCommand run by
  ;; the POSIX shell it was quoted for, whatever the user's login shell is
  {"LC_ALL" "C" "LANG" "C" "SHELL" "/bin/sh"})

;; ---- the remote scripts -----------------------------------------------------------------

(def- home-function
  ;; `home PATH` sets `$r` to PATH with a leading `~` (the home), `~/…` or `~user[/…]` (another
  ;; user's home, the name checked before the shell's own tilde expansion reads it) resolved;
  ;; fails, saying why, for a user with no home there
  (str "home() {\n"
    "  case $1 in\n" "    \"~\") r=$HOME ;;\n" "    \"~/\"*) r=$HOME/${1#??} ;;\n"
    "    \"~\"*) u=${1%%/*}; u=${u#?}; rest=${1#\"~$u\"}\n"
    "      case $u in \"\"|-*|*[!A-Za-z0-9._-]*) echo \"$1: not a user's home\" >&2; return 1 ;; esac\n"
    "      eval \"h=~$u\"\n"
    "      case $h in \"~\"*) echo \"$u: no such user there\" >&2; return 1 ;; esac\n"
    "      r=$h$rest ;;\n" "    *) r=$1 ;;\n" "  esac\n" "}\n"))

(defn script-with (arguments body)
  "A script running `body` with `arguments` as its `$1`, `$2`, … — each quoted for POSIX sh
(`os/shell-quote`), so the remote shell reads it back exactly — and the first resolved as
`$p` when it starts with `~`: the remote home (`~`, `~/notes`) or another user's
(`~www/site`). `home ARG` resolves another argument the same way, into `$r`.

    (string/starts-with? (sshremote/script-with [\"/a b\" \"it's\"] \"\") \"set -- '/a b' 'it'\")   ;=> true"
  (str "set --"
    (string/join (map arguments (fn (argument) (str " " (os/shell-quote argument)))) "")
    "\n"
    home-function
    "home \"$1\" || exit 4\n"
    "p=$r\n"
    body))

(def- mtime-line
  ;; the file's modification time in seconds, GNU and BSD stat alike, 0 when neither answers
  "m=$(stat -c %Y -- \"$p\" 2>/dev/null || stat -f %m -- \"$p\" 2>/dev/null || echo 0)\n")

(def- read-body
  ;; `$2` the largest file sent without asking (0: any). Answers a header — the KIND, the
  ;; resolved path, then for a file its mtime and size — and for a file small enough its bytes
  ;; as Base64. Exit 4 is the script's own failure, said on stderr.
  (str "limit=$2\n"
    "if [ -d \"$p\" ]; then printf 'dir\\n%s\\n' \"$p\"; exit 0; fi\n" "if [ ! -e \"$p\" ]; then\n"
    "  d=$(dirname -- \"$p\")\n"
    "  if [ ! -d \"$d\" ]; then echo \"$d: no such directory\" >&2; exit 4; fi\n"
    "  printf 'new\\n%s\\n' \"$p\"; exit 0\n" "fi\n"
    "if [ ! -r \"$p\" ]; then echo \"$p: Permission denied\" >&2; exit 4; fi\n" mtime-line
    "s=$(wc -c < \"$p\" | tr -d ' ')\n"
    "if [ \"$limit\" -gt 0 ] && [ \"$s\" -gt \"$limit\" ]; then printf 'large\\n%s\\n%s\\n%s\\n' \"$p\" \"$m\" \"$s\"; exit 0; fi\n"
    "printf 'file\\n%s\\n%s\\n%s\\n' \"$p\" \"$m\" \"$s\"\n" "base64 < \"$p\" || exit 4\n"))

(defn read-script (path &optional (limit 0))
  "The script that reads the remote file `path` ([[parse-read]] reads its answer): nothing
sent past `limit` bytes (0: no limit) but the size, so a large file is asked about first.

    (includes? (sshremote/read-script \"/etc/x y\") \"set -- '/etc/x y' 0\")   ;=> true"
  (script-with [path (str limit)] read-body))

(def- write-body
  ;; `$2` the byte count, `$3` the SHA-256; the bytes follow as a here-document the script is
  ;; given. Staged beside the file, checked, renamed over it (a copy into it where a rename
  ;; would part it from its hard links or cannot be made). Answers the new mtime.
  (str "expected=$2; digest=$3\n"
    "if [ -L \"$p\" ]; then r=$(readlink -f -- \"$p\" 2>/dev/null) && [ -n \"$r\" ] && p=$r; fi\n"
    "d=$(dirname -- \"$p\")\n"
    "if [ ! -d \"$d\" ]; then echo \"$d: no such directory\" >&2; exit 4; fi\n"
    "if [ -e \"$p\" ] && [ ! -w \"$p\" ]; then echo \"$p: Permission denied\" >&2; exit 4; fi\n"
    "if printf 'aGk=' | base64 -d >/dev/null 2>&1; then dec='base64 -d'\n"
    "elif printf 'aGk=' | base64 -D >/dev/null 2>&1; then dec='base64 -D'\n"
    "else echo 'no base64 on this host to receive the file' >&2; exit 4; fi\n" "inplace=0\n"
    "stage=$(mktemp \"$d/.bedit-write.XXXXXX\" 2>/dev/null) || { inplace=1; stage=$(mktemp \"${TMPDIR:-/tmp}/.bedit-write.XXXXXX\") || exit 4; }\n"
    "trap 'rm -f -- \"$stage\"' EXIT\n" "trap 'exit 4' HUP INT TERM\n"
    "newmode=$(printf '%o' $((0666 & ~$(umask))))\n"
    "if [ -e \"$p\" ]; then cp -p -- \"$p\" \"$stage\" 2>/dev/null || chmod \"$newmode\" \"$stage\"; else chmod \"$newmode\" \"$stage\"; fi\n"
    "$dec > \"$stage\" <<'BEDIT_EOF' || exit 4\n"))

(def- write-tail
  (str "BEDIT_EOF\n"
    "size=$(wc -c < \"$stage\" | tr -d ' ')\n"
    "if [ \"$size\" != \"$expected\" ]; then echo \"$size of $expected bytes arrived; the file is unchanged\" >&2; exit 4; fi\n"
    "if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum < \"$stage\" | cut -d' ' -f1)\n"
    "elif command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 < \"$stage\" | cut -d' ' -f1)\n"
    "else got=$digest; fi\n"
    "if [ \"$got\" != \"$digest\" ]; then echo 'the bytes arrived changed; the file is unchanged' >&2; exit 4; fi\n"
    "links=1\n" "if [ -e \"$p\" ]; then links=$(ls -ld -- \"$p\" | awk '{print $2}'); fi\n"
    "if [ $inplace = 1 ] || [ \"$links\" -gt 1 ]; then\n"
    "  cat -- \"$stage\" > \"$p\" || { echo \"$p: could not be written\" >&2; exit 4; }\n"
    "elif ! mv -f -- \"$stage\" \"$p\"; then echo \"$p: could not be replaced\" >&2; exit 4; fi\n"
    mtime-line "printf '%s\\n' \"$m\"\n"))

(defn wrap-base64 (text &optional (width 76))
  "Base64 `text` cut into lines of `width` characters, the last one ended too — what a
here-document carries to `base64 -d` on the remote.

    (sshremote/wrap-base64 \"abcdef\" 4)   ;=> \"abcd\\nef\\n\""
  (if (= text "")
    ""
    (str (regex/replace text (str ".{1," width "}") "$0\n"))))

(defn write-script (path content)
  "The script that writes `content` (bytes, or text as UTF-8) over the remote file `path`,
atomically ([[parse-write]] reads its answer): the bytes as Base64 in a here-document, their
count and SHA-256 sent with them.

    (includes? (sshremote/write-script \"/srv/a\" \"hi\") \"aGk=\\nBEDIT_EOF\")   ;=> true"
  (let (bytes (if (string? content) (string/->bytes content) (bytes/concat content)))
    (str (script-with [path (str (bytes/length bytes)) (hash/sha256-bytes bytes)] write-body)
      (wrap-base64 (encoding/base64-encode-bytes bytes))
      write-tail)))

(def- list-body
  ;; the resolved directory, then its entries as `ls -1pa` gives them (a directory with `/`)
  (str "cd -- \"$p\" 2>/dev/null || { echo \"$p: cannot list\" >&2; exit 4; }\n"
    "pwd\n" "ls -1pa\n"))

(defn list-script (path)
  "The script that lists the remote directory `path` ([[parse-list]] reads its answer).

    (includes? (sshremote/list-script \"~/src\") \"ls -1pa\")   ;=> true"
  (script-with [path] list-body))

(def- entries-body
  ;; the resolved directory, then one line per entry — `.` and `..` first — as GNU or BSD
  ;; `stat` gives it, links followed where they lead somewhere: the mode in hex, the link count,
  ;; owner, group, size, mtime (seconds), then `d` / `-` (a directory, followed) and `l` for a
  ;; link, and the name. A name with a line break in it is left out (it cannot be one line). A
  ;; link's target as stored (`readlink`, GNU and BSD alike) follows on a line of its own after
  ;; `@ ` — no entry line starts so — unless it holds a line break.
  (str "cd -- \"$p\" 2>/dev/null || { echo \"$p: cannot list\" >&2; exit 4; }\n"
    "pwd\n"
    "if stat -c %f . >/dev/null 2>&1; then flag=-c; form='%f %h %U %G %s %Y'; else flag=-f; form='%Xp %l %Su %Sg %z %m'; fi\n"
    "nl='\n'\n" "entry() {\n" "  case $1 in *\"$nl\"*) return 0 ;; esac\n"
    "  s=$(stat -L $flag \"$form\" -- \"$1\" 2>/dev/null || stat $flag \"$form\" -- \"$1\" 2>/dev/null) || return 0\n"
    "  t=-; [ -d \"$1\" ] && t=d; [ -L \"$1\" ] && t=${t}l\n"
    "  printf '%s %s %s\\n' \"$s\" \"$t\" \"$1\"\n"
    "  if [ -L \"$1\" ]; then l=$(readlink -- \"$1\" 2>/dev/null) && case $l in *\"$nl\"*) ;; *) printf '@ %s\\n' \"$l\" ;; esac; fi\n"
    "}\n" "entry .; entry ..\n" "for n in .* *; do\n" "  case $n in .|..) continue ;; esac\n"
    "  if [ -e \"$n\" ] || [ -L \"$n\" ]; then entry \"$n\"; fi\n" "done\n"))

(defn entries-script (path)
  "The script that lists the remote directory `path` the way dired shows one, an `ls -l` row's
facts per entry ([[parse-entries]] reads its answer).

    (includes? (sshremote/entries-script \"/srv\") \"entry .; entry ..\")   ;=> true"
  (script-with [path] entries-body))

(def- mkdir-body
  "if [ -e \"$p\" ] || [ -L \"$p\" ]; then echo \"$p exists\" >&2; exit 4; fi\nmkdir -- \"$p\" || exit 4\n")

(defn mkdir-script (path)
  "The script that makes the remote directory `path` (its parent must be there; one already
there is refused).

    (includes? (sshremote/mkdir-script \"/srv/new\") \"mkdir -- \")   ;=> true"
  (script-with [path] mkdir-body))

(def- delete-body
  ;; the whole tree, for good — there is no trash on the other machine; `/`, `.` and `..` refused
  (str "case $p in \"\"|/|.|..|*/.|*/..) echo \"$p: not deleted\" >&2; exit 4 ;; esac\n"
    "if [ ! -e \"$p\" ] && [ ! -L \"$p\" ]; then echo \"$p: no such file\" >&2; exit 4; fi\n"
    "rm -rf -- \"$p\" || exit 4\n"
    "if [ -e \"$p\" ] || [ -L \"$p\" ]; then echo \"$p: could not be deleted\" >&2; exit 4; fi\n"))

(defn delete-script (path)
  "The script that deletes the remote file or directory `path` — a directory with everything in
it — for good: the other machine has no trash this can reach.

    (includes? (sshremote/delete-script \"/srv/old\") \"rm -rf -- \")   ;=> true"
  (script-with [path] delete-body))

(def- symlink-body
  ;; `$2` the target, stored as given; `$3` 1 when an entry there (never a directory) may be
  ;; replaced. `ln -sfn` replaces a link to a directory rather than going into it
  (str "if [ -d \"$p\" ] && [ ! -L \"$p\" ]; then echo \"$p is a directory — not replaced\" >&2; exit 4; fi\n"
    "if { [ -e \"$p\" ] || [ -L \"$p\" ]; } && [ \"$3\" != 1 ]; then echo \"$p exists — not replaced\" >&2; exit 4; fi\n"
    "ln -sfn -- \"$2\" \"$p\" || exit 4\n"))

(defn symlink-script (target path &optional (replace? false))
  "The script that makes the remote `path` a symlink to `target` (stored as given, relative or
not): over an entry already there only when `replace?`, never over a directory.

    (includes? (sshremote/symlink-script \"a\" \"/srv/l\" true) \"ln -sfn -- \")   ;=> true"
  (script-with [path target (if replace? "1" "0")] symlink-body))

(def- chmod-body
  ;; `$2` the mode as octal digits; a link is followed, as chmod does
  (str "if [ ! -e \"$p\" ]; then echo \"$p: no such file\" >&2; exit 4; fi\n"
    "chmod -- \"$2\" \"$p\" || exit 4\n"))

(defn octal-mode (mode)
  "The mode bits `mode` (0..0o7777) as the four octal digits `chmod` reads.

    (sshremote/octal-mode 2541)   ;=> \"4755\""
  (str (math/quot mode 512)
    (math/rem (math/quot mode 64) 8)
    (math/rem (math/quot mode 8) 8)
    (math/rem mode 8)))

(defn chmod-script (path mode)
  "The script that sets the remote `path`'s mode bits to `mode` (a link followed).

    (includes? (sshremote/chmod-script \"/srv/a\" 420) \"set -- /srv/a 0644\")   ;=> true"
  (script-with [path (octal-mode mode)] chmod-body))

(def- place-function
  ;; `place TARGET NAME INTO REPLACE` sets `$to` to where an entry called NAME lands for TARGET:
  ;; INTO it when it is a directory (keeping NAME), which it must be when INTO is 1. A directory
  ;; there is never replaced; another entry only when REPLACE is 1. `$d` is its directory.
  (str "place() {\n"
    "  home \"$1\" || exit 4\n" "  to=$r\n" "  if [ -d \"$to\" ]; then to=${to%/}/$2\n"
    "  elif [ \"$3\" = 1 ]; then echo \"$1: not a directory\" >&2; exit 4; fi\n"
    "  if [ -d \"$to\" ]; then echo \"$to is a directory — not replaced\" >&2; exit 4; fi\n"
    "  if { [ -e \"$to\" ] || [ -L \"$to\" ]; } && [ \"$4\" != 1 ]; then echo \"$to exists — not replaced\" >&2; exit 4; fi\n"
    "  d=$(dirname -- \"$to\")\n"
    "  if [ ! -d \"$d\" ]; then echo \"$d: no such directory\" >&2; exit 4; fi\n" "}\n"))

(def- staging-lines
  ;; a staging directory beside the target (`$d`), removed on every exit the shell sees
  (str "stage=$(mktemp -d \"$d/.bedit-copy.XXXXXX\") || { echo \"$d: cannot write there\" >&2; exit 4; }\n"
    "trap 'rm -rf -- \"$stage\"' EXIT\n" "trap 'exit 4' HUP INT TERM\n"))

(def- transfer-body
  ;; `$2` the target (resolved as `$1` is), `$3` 1 when it must be a directory, `$4` `mv` or
  ;; `cp`, `$5` 1 when an entry there (not a directory) may be replaced: by a rename (atomic on
  ;; one filesystem) for a move, a copy staged beside it and renamed over it for a copy.
  ;; Answers where the entry went.
  (str place-function
    "place \"$2\" \"$(basename -- \"$p\")\" \"$3\" \"$5\"\n"
    "if [ \"$4\" = mv ]; then mv -f -- \"$p\" \"$to\" || exit 4\n"
    "elif [ -e \"$to\" ] || [ -L \"$to\" ]; then\n" staging-lines
    "  cp -pR -- \"$p\" \"$stage/x\" || exit 4\n" "  mv -f -- \"$stage/x\" \"$to\" || exit 4\n"
    "else cp -pR -- \"$p\" \"$to\" || exit 4; fi\n" "printf '%s\\n' \"$to\"\n"))

(defn transfer-script (op from to into? &optional (replace? false))
  "The script that moves (`op` `:move`) or copies (`:copy`) the remote `from` to `to` on the same
host — INTO `to` when it is a directory, keeping the name, which it must be when `into?` — never
over a directory, and over another entry only when `replace?` (a copy staged beside it, then
renamed over it). Answers where it went ([[transfer]]).

    (includes? (sshremote/transfer-script :copy \"/a\" \"/b\" false) \"set -- /a /b 0 cp 0\")   ;=> true"
  (script-with [from to (if into? "1" "0") (if (= op :move) "mv" "cp") (if replace? "1" "0")]
    transfer-body))

(def- kind-body
  "if [ -d \"$p\" ]; then echo dir; elif [ -e \"$p\" ] || [ -L \"$p\" ]; then echo file; else echo none; fi\n")

(defn kind-script (path)
  "The script that says what the remote `path` is: `dir` (a directory, or a link to one), `file`
(anything else there), `none` ([[file-kind]]).

    (includes? (sshremote/kind-script \"/srv\") \"echo dir\")   ;=> true"
  (script-with [path] kind-body))

;; ---- a copy CARRIED between two machines ----------------------------------------------------
;; An entry copied or moved between hosts where one side is reached through a root hop (its root
;; shell has no stream to join) crosses as a TAR archive through the editor: packed where it is
;; ([[pack-script]], Base64 on standard output), checked here (its byte count), and unpacked where
;; it goes ([[unpack-script]]), staged
;; beside the target, its size, SHA-256 and entry count checked before it is renamed into place.
;; A move removes the original only once the copy has landed checked.

(defdyn *transfer-max-bytes* (* 200 1000 1000))
;; The largest archive a copy carried through the editor takes (a root hop's side): it passes
;; through the editor's memory. A streamed copy has no limit.

(def- pack-body
  ;; `$2` the largest archive sent (0: any). Answers the name, the entry count and the archive's
  ;; size, then the archive as Base64. tar is told `./NAME`, so no name is read as an option.
  (str "limit=$2\n"
    "if [ ! -e \"$p\" ] && [ ! -L \"$p\" ]; then echo \"$p: no such file\" >&2; exit 4; fi\n"
    "d=$(dirname -- \"$p\"); n=$(basename -- \"$p\")\n"
    "tmp=$(mktemp \"${TMPDIR:-/tmp}/.bedit-pack.XXXXXX\") || exit 4\n"
    "trap 'rm -f -- \"$tmp\"' EXIT\n" "trap 'exit 4' HUP INT TERM\n"
    "(cd -- \"$d\" && COPYFILE_DISABLE=1 tar cf - \"./$n\") > \"$tmp\" || { echo \"$p: could not be packed\" >&2; exit 4; }\n"
    "c=$(cd -- \"$d\" && find \"./$n\" | wc -l | tr -d ' ')\n" "s=$(wc -c < \"$tmp\" | tr -d ' ')\n"
    "if [ \"$limit\" -gt 0 ] && [ \"$s\" -gt \"$limit\" ]; then echo \"$p: $s bytes packed, more than $limit cross between machines\" >&2; exit 4; fi\n"
    "printf '%s\\n%s\\n%s\\n' \"$n\" \"$c\" \"$s\"\n" "base64 < \"$tmp\" || exit 4\n"))

(defn pack-script (path &optional (limit 0))
  "The script that packs `path` (a directory with everything in it) as a tar archive for a copy
to another machine ([[parse-pack]] reads its answer): nothing past `limit` bytes (0: any).

    (includes? (sshremote/pack-script \"/srv/a\") \"tar cf - \")   ;=> true"
  (script-with [path (str limit)] pack-body))

(defn parse-pack (stdout)
  "What a pack script answered: `{:name :count :bytes}` — the entry's name, how many entries the
archive holds, the archive — or a failure when it arrived damaged or short.

    (:count (sshremote/parse-pack \"a\\n1\\n2\\naGk=\\n\"))   ;=> 1"
  (let (lines (lines-of stdout)
        name (first lines)
        count-read (string/->number (or (nth lines 1 nil) ""))
        size (string/->number (or (nth lines 2 nil) ""))
        bytes (encoding/base64-decode-bytes (string/join (drop lines 3) "")))
    (cond
      (or (string/blank? (or name "")) (not (int? count-read)) (not (int? size)))
        (failure "a packed copy that does not read")
      (failure? bytes) (failure "the packed copy arrived damaged")
      (not (= (bytes/length bytes) size))
        (failure (str (bytes/length bytes) " of " size " bytes of the copy arrived"))
      else {:name name :count count-read :bytes bytes})))

(def- unpack-body
  ;; `$2` the entry's name, `$3` INTO, `$4` REPLACE ([[place-function]]), `$5` the entry count,
  ;; `$6` the archive's size, `$7` its SHA-256; the archive follows as a here-document. Unpacked
  ;; in a staging directory beside the target, checked, then renamed into place.
  (str place-function
    "place \"$1\" \"$2\" \"$3\" \"$4\"\n" "name=$2; count=$5; expected=$6; digest=$7\n"
    "if printf 'aGk=' | base64 -d >/dev/null 2>&1; then dec='base64 -d'\n"
    "elif printf 'aGk=' | base64 -D >/dev/null 2>&1; then dec='base64 -D'\n"
    "else echo 'no base64 on this host to receive the copy' >&2; exit 4; fi\n" staging-lines
    "$dec > \"$stage/archive.tar\" <<'BEDIT_EOF' || exit 4\n"))

(def- received-checks
  ;; `$stage/archive.tar` arrived: its size, SHA-256 (`-`: the sending side had no tool to say)
  ;; and entry count checked, then unpacked and renamed into place. Answers where it went.
  (str "size=$(wc -c < \"$stage/archive.tar\" | tr -d ' ')\n"
    "if [ \"$size\" != \"$expected\" ]; then echo \"$size of $expected bytes arrived; nothing was copied\" >&2; exit 4; fi\n"
    "if [ \"$digest\" = - ]; then got=-\n"
    "elif command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum < \"$stage/archive.tar\" | cut -d' ' -f1)\n"
    "elif command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 < \"$stage/archive.tar\" | cut -d' ' -f1)\n"
    "else got=$digest; fi\n"
    "if [ \"$got\" != \"$digest\" ]; then echo 'the copy arrived changed; nothing was copied' >&2; exit 4; fi\n"
    "mkdir -- \"$stage/x\" || exit 4\n"
    "(cd -- \"$stage/x\" && tar xpof ../archive.tar) || { echo 'the copy could not be unpacked; nothing was copied' >&2; exit 4; }\n"
    "got=$(cd -- \"$stage/x\" && find \"./$name\" | wc -l | tr -d ' ')\n"
    "if [ \"$got\" != \"$count\" ]; then echo \"$got of $count entries arrived; nothing was copied\" >&2; exit 4; fi\n"
    "if { [ -e \"$to\" ] || [ -L \"$to\" ]; } && [ -d \"$stage/x/$name\" ]; then rm -f -- \"$to\" || exit 4; fi\n"
    "mv -f -- \"$stage/x/$name\" \"$to\" || { echo \"$to: could not be replaced\" >&2; exit 4; }\n"
    "printf '%s\\n' \"$to\"\n"))

(def- unpack-tail (str "BEDIT_EOF\n" received-checks))

(defn unpack-script (to packed into? replace?)
  "The script that unpacks `packed` ([[parse-pack]]'s answer) at `to` on the machine it runs on —
INTO `to` when it is a directory, which it must be when `into?`; never over a directory, over
another entry only when `replace?` — checked (size, SHA-256, entry count) in a staging directory
beside the target before it is renamed into place. Answers where it went.

    (includes? (sshremote/unpack-script \"/b\" {:name \"a\" :count 1 :bytes (string/->bytes \"hi\")} false false) \"tar xpof\")   ;=> true"
  (let (bytes (:bytes packed))
    (str (script-with [to
                        (:name packed)
                        (if into? "1" "0")
                        (if replace? "1" "0")
                        (str (:count packed))
                        (str (bytes/length bytes))
                        (hash/sha256-bytes bytes)]
           unpack-body)
      (wrap-base64 (encoding/base64-encode-bytes bytes))
      unpack-tail)))

;; ---- a copy STREAMED between two machines ---------------------------------------------------
;; The archive never passes through the editor: it is packed into a temporary file where it is
;; ([[stage-pack-script]], answering its size and SHA-256), a receiving script is put in a
;; temporary file where it goes ([[receiver-script]]), and then one local `sh` joins the two
;; sides with an OS PIPE — `ssh FROM cat ARCHIVE | ssh TO /bin/sh RECEIVER` (`os/pipeline`, brood ADR-696) —
;; the receiver checking size, SHA-256 and entry count in its staging directory before the
;; rename, as the carried copy does.

(def- stage-pack-body
  ;; Answers the name, the entry count, the archive's size, its SHA-256 (`-` with no tool for
  ;; it) and where the archive waits; the archive stays for the stream, removed after it
  (str "if [ ! -e \"$p\" ] && [ ! -L \"$p\" ]; then echo \"$p: no such file\" >&2; exit 4; fi\n"
    "d=$(dirname -- \"$p\"); n=$(basename -- \"$p\")\n"
    "tmp=$(mktemp \"${TMPDIR:-/tmp}/.bedit-pack.XXXXXX\") || exit 4\n"
    "trap 'rm -f -- \"$tmp\"; exit 4' HUP INT TERM\n"
    "(cd -- \"$d\" && COPYFILE_DISABLE=1 tar cf - \"./$n\") > \"$tmp\" || { rm -f -- \"$tmp\"; echo \"$p: could not be packed\" >&2; exit 4; }\n"
    "c=$(cd -- \"$d\" && find \"./$n\" | wc -l | tr -d ' ')\n" "s=$(wc -c < \"$tmp\" | tr -d ' ')\n"
    "if command -v sha256sum >/dev/null 2>&1; then h=$(sha256sum < \"$tmp\" | cut -d' ' -f1)\n"
    "elif command -v shasum >/dev/null 2>&1; then h=$(shasum -a 256 < \"$tmp\" | cut -d' ' -f1)\n"
    "else h=-; fi\n" "printf '%s\\n%s\\n%s\\n%s\\n%s\\n' \"$n\" \"$c\" \"$s\" \"$h\" \"$tmp\"\n"))

(defn stage-pack-script (path)
  "The script that packs `path` (a directory with everything in it) as a tar archive into a
temporary file for a STREAMED copy ([[parse-staged]] reads its answer: the archive is left there
for the stream to read).

    (includes? (sshremote/stage-pack-script \"/srv/a\") \"sha256sum\")   ;=> true"
  (script-with [path] stage-pack-body))

(def- safe-temp-pattern "/[A-Za-z0-9/._-]+")
;; a temporary path a remote LOGIN shell reads as one word, unquoted: the stream's commands name
;; one there, and every shell must read them alike

(defn parse-staged (stdout)
  "What a stage-pack script answered: `{:name :count :size :digest :archive}` — the entry's name,
how many entries the archive holds, its size and SHA-256 (`-` when the host had no tool for it)
and the temporary file holding it — or a failure when it does not read.

    (:size (sshremote/parse-staged \"a\\n1\\n10240\\n-\\n/tmp/.bedit-pack.x\\n\"))   ;=> 10240"
  (let (lines (lines-of stdout)
        name (first lines)
        count-read (string/->number (or (nth lines 1 nil) ""))
        size (string/->number (or (nth lines 2 nil) ""))
        digest (or (nth lines 3 nil) "")
        archive (or (nth lines 4 nil) ""))
    (cond
      (or (string/blank? (or name "")) (not (int? count-read)) (not (int? size)))
        (failure "a packed copy that does not read")
      (not (regex/matches? digest "-|[0-9a-f]{64}")) (failure "a packed copy with no checksum")
      (not (regex/matches? archive safe-temp-pattern))
        (failure (str "the packed copy waits at a path a shell would not read as one word: "
                   archive))
      else {:name name :count count-read :size size :digest digest :archive archive})))

(def- receive-body
  ;; `$2` the entry's name, `$3` INTO, `$4` REPLACE ([[place-function]]), `$5` the entry count,
  ;; `$6` the archive's size, `$7` its SHA-256; the archive is the script's standard input
  (str place-function
    "place \"$1\" \"$2\" \"$3\" \"$4\"\n" "name=$2; count=$5; expected=$6; digest=$7\n"
    staging-lines "cat > \"$stage/archive.tar\" || exit 4\n" received-checks))

(defn receiver-script (to staged into? replace? token)
  "The script that leaves a RECEIVER for the stream in a temporary file, answering its path: run
as `/bin/sh RECEIVER` with the archive `staged` ([[parse-staged]]'s answer) on its standard input,
it removes itself and unpacks the archive at `to` as [[unpack-script]] does — INTO `to` when it is
a directory (which it must be when `into?`), never over a directory, over another entry only when
`replace?`, checked before the rename. `token` ends its here-document.

    (includes? (sshremote/receiver-script \"/b\" {:name \"a\" :count 1 :size 2 :digest \"-\"} false false \"T\") \"cat > \\\"$stage/archive.tar\\\"\")   ;=> true"
  (str "f=$(mktemp \"${TMPDIR:-/tmp}/.bedit-recv.XXXXXX\") || exit 4\n"
    "cat > \"$f\" <<'BEDIT_RECV_"
    token
    "'\n"
    "rm -f -- \"$0\"\n"
    (script-with [to
                   (:name staged)
                   (if into? "1" "0")
                   (if replace? "1" "0")
                   (str (:count staged))
                   (str (:size staged))
                   (:digest staged)]
      receive-body)
    "BEDIT_RECV_"
    token
    "\n"
    "printf '%s\\n' \"$f\"\n"))

(defn stream-side (parts remote-command local-argv)
  "The argv one side of a stream runs: ssh running `remote-command` on `parts`' host, or
`local-argv` on this machine when `parts` is nil.

    (sshremote/stream-side nil \"cat -- /x\" [\"cat\" \"--\" \"/x\"])   ;=> [\"cat\" \"--\" \"/x\"]"
  (if (nil? parts) local-argv (into [*program*] (ssh-argv parts remote-command))))

;; ---- reading the answers ----------------------------------------------------------------

(defn- lines-of (text)
  (string/split (string/replace text "\r" "") "\n"))

(defn parse-read (stdout)
  "What a read script answered, as data: `{:kind :file :path :mtime :size :bytes}`,
`{:kind :large :path :mtime :size}` (past the limit: asked about first), `{:kind :new :path}`
(no file yet), `{:kind :dir :path}` — `:path` resolved by the remote shell (`~` expanded) —
or a failure when the answer does not read.

    (sshremote/parse-read \"new\\n/home/me/x\\n\")   ;=> {:kind :new :path \"/home/me/x\"}
    (:bytes (sshremote/parse-read \"file\\n/a\\n10\\n2\\naGk=\\n\"))   ;=> #b\"hi\""
  (let (lines (lines-of stdout)
        kind (first lines)
        path (second lines))
    (cond
      (or (nil? path) (= path "")) (failure (str "an answer that does not read: " stdout))
      (= kind "dir") {:kind :dir :path path}
      (= kind "new") {:kind :new :path path}
      (or (= kind "file") (= kind "large"))
        (let (mtime (string/->number (or (nth lines 2 nil) ""))
              size (string/->number (or (nth lines 3 nil) "")))
          (if (or (not (int? mtime)) (not (int? size)))
            (failure (str "an answer that does not read: " kind))
            (if (= kind "large")
              {:kind :large :path path :mtime mtime :size size}
              (let (bytes (encoding/base64-decode-bytes (string/join (drop lines 4) "")))
                (if (failure? bytes)
                  (failure "the file bytes arrived damaged")
                  {:kind :file :path path :mtime mtime :size size :bytes bytes})))))
      else (failure (str "an answer that does not read: " kind)))))

(defn parse-write (stdout)
  "The new modification time (seconds) a write script answered, or nil when it said none.

    (sshremote/parse-write \"1700000000\\n\")   ;=> 1700000000"
  (let (number (string/->number (string/trim stdout)))
    (when (int? number) number)))

(defn parse-list (stdout)
  "What a list script answered: `{:dir resolved :names [...]}`, the names sorted, a
directory's ending in `/`, `.` and `..` left out.

    (sshremote/parse-list \"/srv\\n./\\n../\\nb\\na/\\n\")   ;=> {:dir \"/srv\" :names [\"a/\" \"b\"]}"
  (let (lines (seq/reject (lines-of stdout) (fn (line) (= line ""))))
    {:dir (first lines)
     :names (vec (sort (seq/reject (rest lines) (fn (line) (or (= line "./") (= line "../"))))))}))

(def- entry-pattern
  "^([0-9A-Fa-f]+) ([0-9]+) (\\S+) (\\S+) ([0-9]+) ([0-9]+) ([-dl]+) (.*)$")

(defn parse-entry (line)
  "One entry of an [[entries-script]] answer as dired lists it, `{:name :stat}` — the stat in
`file/stat`'s shape (`:dir?` followed, `:symlink?`, `:mode` the permission bits, `:nlink`,
`:owner`, `:group`, `:size`, `:mtime` in ms, `:exec?`) — or nil when the line does not read.

    (:stat (sshremote/parse-entry \"41ed 2 me staff 4096 10 d .\"))   ;=> {:dir? true :symlink? false :mode 493 :nlink 2 :owner \"me\" :group \"staff\" :size 4096 :mtime 10000 :exec? true}"
  (when-let (found (regex/find line entry-pattern))
    (let (field (fn (index) (:text (nth (:groups found) index)))
          number (fn (index radix)
                   (let (read (string/->number (field index) radix)) (if (int? read) read 0)))
          mode (math/mod (number 0 16) 4096)
          flags (field 6))
      {:name (field 7)
       :stat {:dir? (includes? flags "d")
              :symlink? (includes? flags "l")
              :mode mode
              :nlink (number 1 10)
              :owner (field 2)
              :group (field 3)
              :size (number 4 10)
              :mtime (* 1000 (number 5 10))
              :exec? (>= (math/mod (math/quot mode 64) 2) 1)}})))

(defn parse-entries (stdout)
  "What an [[entries-script]] answered: `{:dir resolved :entries [{:name :stat} …]}`, `.` and
`..` among them, a symlink's with its `:link-target`, a line that does not read left out.

    (:dir (sshremote/parse-entries \"/srv\\n41ed 2 me me 4096 10 d .\\n\"))   ;=> \"/srv\"
    (:link-target (second (:entries (sshremote/parse-entries \"/srv\\n41ed 2 me me 4096 10 d .\\na1ff 1 me me 3 10 -l l\\n@ ../x\\n\"))))   ;=> \"../x\""
  (let (lines (seq/reject (lines-of stdout) (fn (line) (= line ""))))
    {:dir (first lines)
     :entries (fold (rest lines)
                []
                (fn (entries line)
                  (if (string/starts-with? line "@ ")
                    ;; only after the link's own line (one that did not read drops its target too)
                    (if (or (empty? entries)
                          (not (map/get-in (last entries) [:stat :symlink?]))
                          (contains? (last entries) :link-target))
                      entries
                      (assoc entries
                        (dec (count entries))
                          (assoc (last entries)
                            :link-target (string/substring line 2 (string/length line)))))
                    (let (entry (parse-entry line)) (if (nil? entry) entries (conj entries entry))))))}))

;; ---- what failed --------------------------------------------------------------------------

(defn- methods-of (stderr)
  ;; the authentication methods a `Permission denied (publickey,password).` names
  (let (found (regex/find stderr "Permission denied \\(([^)]*)\\)"))
    (if (nil? found) [] (string/split (or (:text (first (:groups found))) "") ","))))

(defn classify (result parts)
  "What an ssh `result` (`os/cmd`'s map) means: nil when ssh did its part (the script's own
exit is read by the caller), else `{:error kind :reason text}` — `:host-key` (the host's key is
not known, or changed: never accepted here), `:auth` (no key or agent worked; `:password?`
when the host would take a password), `:connection` (the host could not be reached, or the
connection dropped), `:timeout`. ssh's own failures exit 255. A reason names the host, not the
method: the caller says `ssh: ` before it.

    (:error (sshremote/classify {:exit 255 :stderr \"Host key verification failed.\\n\"} {:host \"h\"}))   ;=> :host-key"
  (let (stderr (string/replace (or (:stderr result) "") "\r" "")
        said (string/trim stderr)
        who (sshpath/host-label parts)
        hops? (not (empty? (or (:hops parts) []))))
    (cond
      (:timed-out result) {:error :timeout :reason (str who " did not answer in time")}
      (not (= 255 (:exit result))) nil
      (includes? stderr "Host key verification failed")
        {:error :host-key
         :reason (str (sshpath/route-label parts)
                   (if hops?
                     ": a host key on the way is not known, or has CHANGED — check each host with ssh"
                     (str "'s host key is not known, or has CHANGED — check it with `ssh " who "`"))
                   " in a terminal; bedit never accepts a host key for you")}
      (includes? stderr "Permission denied")
        (let (methods (methods-of stderr))
          {:error :auth
           :password? (or (includes? methods "password") (includes? methods "keyboard-interactive"))
           :reason (str who " refused every key and the agent (" (string/join methods ",") ")")})
      else
        {:error :connection
         :reason (str "the connection to "
                   (sshpath/route-label parts)
                   " failed or dropped"
                   (if (= said "") "" (str ": " said)))})))

;; ---- running ------------------------------------------------------------------------------

(def *operation-timeout-ms* 120000)
;; How long one operation may take before ssh is killed and it is said to have failed.

(defn- ssh-call (parts remote-command stdin batch extra-env)
  ;; one ssh run, its result classified: `:failed` set when ssh itself failed
  (let (_ (ensure-control-dir)
        result (os/cmd *program*
                 (ssh-argv parts remote-command batch)
                 {:stdin stdin :env (merge ssh-env extra-env) :timeout-ms *operation-timeout-ms*})
        failed (classify result parts))
    (if (nil? failed) result (assoc result :failed failed))))
(defn run (parts script)
  "Run `script` on `parts`' host — `/bin/sh -s` reading it from ssh's standard input — and
answer `os/cmd`'s map, or for a failure of ssh's own the map with `:failed` set to
[[classify]]'s answer. Batch mode: ssh never asks anything. A path through a root hop (`|sudo:`,
`|su:`, `|doas:`) runs it in the host's ROOT SHELL instead (`sshsudo`;
`{:failed {:error :become-password}}` when the method wants a password: [[become-connect]]).
Blocks: run it in a task."
  (if (:become parts)
    (sshsudo/run (assoc (become-request parts) :script script))
    (ssh-call parts *script-command* script true {})))

(defn become-request (parts)
  "What `sshsudo` needs to open the root shell on `parts`' host (its root hop): the ssh run —
`-tt` for a method that reads its password only from a terminal — read HERE, where the bindings
are (a session is a process of its own, which inherits none).

    (last (:argv (sshremote/become-request {:host \"h\" :become {:method :sudo}})))   ;~> the sudo command"
  (let (become (:become parts))
    (do
      (ensure-control-dir)
      {:argv (into [*program*]
               (ssh-argv parts (sshsudo/remote-command become) true (sshsudo/tty? become)))
       :env ssh-env
       :parts parts
       :timeout-ms *operation-timeout-ms*})))

(defn become-connect (parts password)
  "Open the root shell on `parts`' host (its root hop) with `password` — what the method asks
for: yours there for sudo and doas, the target user's for su — written once, when it asks, and
kept nowhere: the shell stays open instead (`sshsudo`). True, or `{:failed …}` — a wrong
password is `:auth`. Blocks."
  (sshsudo/open (assoc (become-request parts) :password password)))

(defn- script-failure (result)
  ;; the remote script's own failure (exit 4 and the rest), as a failure carrying its reason
  (let (said (string/trim (or (:stderr result) "")))
    (failure (if (= said "") (str "the remote command exited " (:exit result)) said))))

(defn read-file (parts path &optional (limit 0))
  "Read the remote file `path` on `parts`' host: [[parse-read]]'s answer, a failure carrying
the remote reason, or `{:failed …}` ([[classify]]) when ssh itself failed. Blocks."
  (let (result (run parts (read-script path limit)))
    (cond
      (:failed result) {:failed (:failed result)}
      (= 0 (:exit result)) (parse-read (:stdout result))
      else (script-failure result))))

(defn write-file (parts path content)
  "Write `content` over the remote file `path` on `parts`' host ([[write-script]]):
`{:mtime seconds}`, a failure carrying the remote reason, or `{:failed …}` when ssh itself
failed — a connection that dropped mid-write leaves the file as it was. Blocks."
  (let (result (run parts (write-script path content)))
    (cond
      (:failed result) {:failed (:failed result)}
      (= 0 (:exit result)) {:mtime (parse-write (:stdout result))}
      else (script-failure result))))

(defn list-dir (parts path)
  "List the remote directory `path` on `parts`' host: [[parse-list]]'s answer, a failure, or
`{:failed …}`. Blocks."
  (let (result (run parts (list-script path)))
    (cond
      (:failed result) {:failed (:failed result)}
      (= 0 (:exit result)) (parse-list (:stdout result))
      else (script-failure result))))

(defn list-entries (parts path)
  "List the remote directory `path` on `parts`' host as dired shows it: [[parse-entries]]'s
answer, a failure carrying the remote reason, or `{:failed …}`. Blocks."
  (let (result (run parts (entries-script path)))
    (cond
      (:failed result) {:failed (:failed result)}
      (= 0 (:exit result)) (parse-entries (:stdout result))
      else (script-failure result))))

(defn run-local (script)
  "Run `script` on THIS machine — `/bin/sh -s` reading it from standard input, as [[run]] runs one
on a host — and answer `os/cmd`'s map: the near side of a copy between this machine and a host.
Blocks."
  (os/cmd "/bin/sh" ["-s"] {:stdin script :env ssh-env :timeout-ms *operation-timeout-ms*}))

(defn- run-op (parts script)
  ;; a script run for its effect on `parts`' host — nil parts: this machine — its standard
  ;; output, else a failure saying why (ssh's own failure classified)
  (let (result (if (nil? parts) (run-local script) (run parts script)))
    (cond
      (:failed result) (failure (str "ssh: " (:reason (:failed result))))
      (= 0 (:exit result)) (:stdout result)
      else (script-failure result))))

(defn make-directory (parts path)
  "Make the remote directory `path` on `parts`' host: true, or a failure saying why. Blocks."
  (let (done (run-op parts (mkdir-script path))) (if (failure? done) done true)))

(defn delete-path (parts path)
  "Delete the remote `path` on `parts`' host for good, a directory with everything in it: true,
or a failure saying why. Blocks."
  (let (done (run-op parts (delete-script path))) (if (failure? done) done true)))

(defn make-symlink (parts target path &optional (replace? false))
  "Make the remote `path` on `parts`' host a symlink to `target` ([[symlink-script]]): true, or a
failure saying why. Blocks."
  (let (done (run-op parts (symlink-script target path replace?))) (if (failure? done) done true)))

(defn set-mode (parts path mode)
  "Set the remote `path`'s mode bits on `parts`' host to `mode` ([[chmod-script]]): true, or a
failure saying why. Blocks."
  (let (done (run-op parts (chmod-script path mode))) (if (failure? done) done true)))

(defn transfer (parts op from to into? &optional (replace? false))
  "Move (`op` `:move`) or copy (`:copy`) the remote `from` to `to` on `parts`' host
([[transfer-script]], over an entry there only when `replace?`): the remote path it went to, or a
failure saying why. Blocks."
  (let (done (run-op parts (transfer-script op from to into? replace?)))
    (if (failure? done) done (string/trim done))))

(defn file-kind (parts path)
  "What `path` is on `parts`' host — nil parts: this machine — `:dir` (a directory, or a link to
one), `:file` (anything else there) or nil (nothing), or a failure saying why ([[kind-script]]).
Blocks."
  (let (done (run-op parts (kind-script path)))
    (if (failure? done)
      done
      (case (string/trim done)
        "dir" :dir
        "file" :file
        nil))))

(defn- carried-transfer (from-parts from to-parts to into? replace?)
  ;; the copy carried THROUGH the editor (a root hop's shell has no stream to join): packed as
  ;; Base64, checked here, unpacked there — nothing past `*transfer-max-bytes*`. Where it went
  (let (packed-out (run-op from-parts (pack-script from *transfer-max-bytes*))
        packed (if (failure? packed-out) packed-out (parse-pack packed-out))
        landed (if (failure? packed)
                 packed
                 (run-op to-parts (unpack-script to packed into? replace?))))
    (if (failure? landed) landed (string/trim landed))))

(defn- stream-failure (result to-parts)
  ;; why the stream failed: ssh's own failure on the receiving side, or what the two sides said
  (let (failed (when to-parts (classify result to-parts)))
    (if failed (failure (str "ssh: " (:reason failed))) (script-failure result))))

(defn- streamed-transfer (from-parts from to-parts to into? replace?)
  ;; the copy STREAMED from one side to the other through an OS pipe, never held here: staged
  ;; there, a receiver left where it goes, the two joined by `os/pipeline`, the staged archive
  ;; removed after whatever happened. Where it went
  (let (staged-out (run-op from-parts (stage-pack-script from))
        staged (if (failure? staged-out) staged-out (parse-staged staged-out)))
    (if (failure? staged)
      staged
      (let (archive (:archive staged)
            receiver-out (run-op to-parts (receiver-script to staged into? replace? (rand/token 8)))
            receiver (if (failure? receiver-out) receiver-out (string/trim receiver-out))
            went (cond
                   (failure? receiver) receiver
                   (not (regex/matches? receiver safe-temp-pattern))
                     (failure (str "the receiver waits at a path a shell would not read as one word: "
                                receiver))
                   else
                     (let (result (os/pipeline [(stream-side from-parts
                                                  (str "cat -- " archive)
                                                  ["cat" "--" archive])
                                                 (stream-side to-parts
                                                   (str "/bin/sh " receiver)
                                                   ["/bin/sh" receiver])]
                                    {:env ssh-env
                                     :timeout-ms (+ *operation-timeout-ms*
                                                   (math/quot (:size staged) 1000))}))
                       (if (= 0 (:exit result))
                         (string/trim (:stdout result))
                         (stream-failure result to-parts)))))
        (do (run-op from-parts (script-with [archive] "rm -f -- \"$p\"\n")) went)))))

(defn cross-transfer (op from-parts from to-parts to into? replace?)
  "Move (`op` `:move`) or copy (`:copy`) `from` on `from-parts`' host to `to` on `to-parts`' —
either nil for THIS machine — a directory with everything in it: packed as a tar archive there and
STREAMED to the other side through an OS pipe (`ssh FROM … | ssh TO …`, `os/pipeline`), never
held in the editor, so no size is too large; a side through a root hop (its root shell has no
stream to join) is carried through the editor instead, up to `*transfer-max-bytes*`. Unpacked
where it goes in a staging directory, its size, SHA-256 and entry count checked against what the
packing side said before it is renamed into place; INTO `to` when it is a directory (which it
must be when `into?`), never over a directory, over another entry only when `replace?`. A move
removes `from` only once the copy landed checked. The path it went to on `to-parts`' side, or a
failure saying why. Blocks."
  (let (went (if (or (:become from-parts) (:become to-parts))
               (carried-transfer from-parts from to-parts to into? replace?)
               (streamed-transfer from-parts from to-parts to into? replace?)))
    (cond
      (failure? went) went
      (= op :copy) went
      else
        (let (removed (run-op from-parts (delete-script from)))
          (if (failure? removed)
            (failure (str "copied to " went ", but the original stays: " (error-message removed)))
            went)))))

;; ---- a password, once ---------------------------------------------------------------------

(def askpass-source
  ;; SSH_ASKPASS's helper. ssh runs it with the question as $1 and its OWN standard input,
  ;; which the password call fills with the password and nothing else. A yes/no question — a
  ;; host key to accept, above all — is refused (exit 1: ssh takes it as "no").
  (str "#!/bin/sh\n"
    "case \"$1\" in *yes/no*|*fingerprint*|*'(yes'*) exit 1 ;; esac\n"
    "IFS= read -r secret || exit 1\n" "printf '%s\\n' \"$secret\"\n"))

(defn askpass-helper ()
  "The SSH_ASKPASS helper's path in [[control-dir]], written (owner-only, executable) when it
is missing or out of date."
  (let (dir (ensure-control-dir)
        helper (path/join dir "askpass"))
    (do
      (when (not (= (check-allow :discarded-catch (try (file/slurp helper) (catch _ nil)))
                   askpass-source))
        (file/spit-private helper askpass-source))
      (os/cmd "chmod" ["700" helper])
      helper)))

(defn connect-with-password (parts password)
  "Open the shared connection to `parts`' host with `password` (a password, or a key's
passphrase — what ssh asks first), so the operations that follow run through it without one.
The password reaches ssh's askpass helper on standard input and goes nowhere else: not the
environment, not a file, not the model. True, or `{:failed …}` ([[classify]]) — a wrong
password is `:auth`."
  ;; the remote command is `true`, which reads nothing: were the password ever not taken by
  ;; the helper (a key that works after all), no shell on the host would run it as a command
  (let (result (ssh-call parts
                 "true"
                 (str password "\n")
                 false
                 {"SSH_ASKPASS" (askpass-helper)
                  "SSH_ASKPASS_REQUIRE" "force"
                  "DISPLAY" (or (os/env "DISPLAY") ":0")}))
    (cond
      (:failed result) {:failed (:failed result)}
      else true)))

;; ---- a jump host's own connection -----------------------------------------------------------

(defn hop-parts (parts index)
  "Jump host `index` of `parts`' route as a host of its own — reached through the hops before it
— so its shared connection can be opened (with a password: [[connect-with-password]]); the
ProxyCommand's `-W` through it then rides that connection ([[jump-argv]]).

    (sshremote/hop-parts {:host \"web1\" :hops [{:host \"a\"} {:host \"b\"}]} 1)   ;=> {:host \"b\" :hops [{:host \"a\"}]}"
  (let (hops (or (:hops parts) [])
        earlier (vec (take hops index))
        hop (nth hops index))
    (if (empty? earlier) hop (assoc hop :hops earlier))))

(defn route-failure (parts)
  "Which jump host on `parts`' route fails, tried in order, each in batch mode — `{:failed …
:hop index}` ([[classify]]'s answer for THAT host, so a refusal or an unknown host key names it,
and `:password?` says it would take a password) — or nil when every hop answers, so a failure
was the target's own. A hop that answers keeps its shared connection open: the route rides it.
The command each runs is `true`, whose exit is ignored: a jump host that allows no shell (a
forced command) is still connected. Blocks."
  (letrec (try-hop (fn (index)
                     (when (< index (count (or (:hops parts) [])))
                       (let (result (ssh-call (hop-parts parts index) "true" "" true {}))
                         (if (:failed result)
                           {:failed (:failed result) :hop index}
                           (try-hop (inc index)))))))
    (try-hop 0)))

(defn blame-route (parts answer)
  "`answer` of an operation on `parts`' host, with a failure the route may have caused —
authentication, the connection — laid on the jump host that caused it ([[route-failure]]): the
same answer when `parts` has no hops, the operation did not fail that way, or every hop
answers. Blocks."
  (let (failed (when (map? answer) (:failed answer)))
    (if (and failed
          (not (empty? (or (:hops parts) [])))
          (contains? #{:auth :connection :timeout} (:error failed)))
      (or (route-failure parts) answer)
      answer)))

;; ---- the directory listings the path prompt completes from -------------------------------
;; A remote directory's entries, kept a few seconds per directory, so typing within it asks
;; the host once. A table, not model state: the prompt's completion asks from a task.

(def- *listings* (table/new))

(def *listing-fresh-ms* 10000)
;; How long a remote listing is trusted. A failure is kept as long, so a host that refuses
;; is not asked on every key.

(defn cached-listing (dir-spec)
  "The entries of the remote directory `dir-spec` (an ssh path) listed within the last
`*listing-fresh-ms*` — a sorted vector, a directory's names ending in `/` — `[]` for a
directory that could not be listed, or nil when it has not been asked lately."
  (let (hit (table/get *listings* dir-spec))
    (when (and hit (< (- (os/now) (first hit)) *listing-fresh-ms*)) (second hit))))

(defn fetch-listing (dir-spec)
  "List the remote directory `dir-spec` now and keep the answer ([[cached-listing]]): its
entries, or `[]` when it cannot be listed (no connection without a password, no such
directory). Blocks: the prompt calls it from a task."
  (let (parts (sshpath/parse dir-spec)
        answer (if (nil? parts) nil (list-dir parts (:path parts)))
        names (if (and (map? answer) (vector? (:names answer))) (:names answer) []))
    (do
      (when (>= (table/count *listings*) 64)
        (doseq (entry (table/snapshot *listings*)) (table/delete *listings* (first entry))))
      (table/put *listings* dir-spec [(os/now) names])
      names)))

(defn forget-listing (dir-spec)
  "Drop what is kept of the remote directory `dir-spec`: a save made a new entry there."
  (table/delete *listings* dir-spec))
