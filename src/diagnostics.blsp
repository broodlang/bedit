(defmodule diagnostics
  "**The diagnostics pane** — every warning and error in the buffer, listed, in a pane
beside it.

`C-c !` (M-x diagnostics) opens `*Diagnostics*`: one row per finding, `line:col` then the
message, RET or a click on a row visiting it in the source pane. The command toggles —
press it again and the pane goes.

**Why a pane at all**, when each finding already has a mark in the margin and a note at
its line: because the inline note is a GLANCE and some findings are not glanceable. A
checker message runs to a couple of hundred columns; drawn from the end of an already
indented line it is clipped to whatever fits, and the half that fits is rarely the half
that matters. Worse, a line with both an error and an advisory about the same mistake
showed them side by side, each clipped, saying the same thing twice. The list has a whole
pane's width per row, puts the findings in line order whether or not their lines are on
screen, and answers \"what is wrong with this file?\" — which is a different question from
\"what is wrong with THIS line?\", and the one the margin cannot answer at all.

**It is an `aside`**, so it behaves like the preview and the workings pane: refreshed in
place while it is up, latched closed once you close it, brought back only by asking. And it
refreshes from the ONE place diagnostics are set (`model/ed-set-diagnostics`), so it cannot
show a finding the buffer has moved past — every producer, the Brood checker and every LSP
server alike, lands there.

**Locations are BUFFERS, not paths** (`:line-links`, resolved by
`results/line-links-loc`): the findings are about the buffer in front of you, which may
never have been saved — a playground, a scratch buffer, a file being written. A row
carries the buffer's name and its line, and `commands/cmd-visit-location` knows how to
visit that."
  (:use model) ; ed-current-buf / ed-buffer-index-by-name / message
  (:use commands) ; ed-display-buffer's home; the command registry
  (:use interactive) ; defcommand
  (:use aside) ; the pane discipline: refresh / reopen / close / open?
  (:use editor/buffer)) ; buffer-name / buffer-line-count

(def *buffer-name* "*Diagnostics*")

(def *spec*
  ;; `:key` is NOT `:diagnostics` — that is the model's own findings cache. The pane's
  ;; visibility state lives beside it, under its own key.
  {:key :diagnostics-pane :buffer diagnostics/*buffer-name* :type :diagnostics-list})

(defn severity-glyph (d)
  "The row's mark: `✗` for something that will not compile, `⚠` for an advisory — the same
call the margin makes, from the same predicate."
  (if (results/diagnostic-error? d) "✗" "⚠"))

(def *severity-words* ["error: " "warning: " "note: " "hint: "])

(defn message-lines (d)
  "A finding's message as the lines a report shows: its own lines, with the leading
severity word dropped from the first.

The word is dropped because the GLYPH already says it — `⚠ warning: DateTime.to_/1 is
undefined` spends its first eight columns saying `⚠` again. It stays in the message for
every other reader (`lsp/lsp-diagnostic` writes it there deliberately, and the echo row
shows the message whole)."
  (let (raw (string/split (or (:message d) "") "\n")
        head (fold *severity-words*
               (first raw)
               (fn (s w) (if (string/starts-with? s w) (string/substring s (string/length w) (string/length s)) s))))
    (cons head (seq/keep (rest raw) (fn (l) (let (t (string/trim l)) (when (not (= t "")) t)))))))

(defn rows-for (line d)
  "The report rows for one finding: `  12:5  ⚠ the message`, then any further lines of the
message indented under it.

A server's message is often a paragraph — `DateTime.to_/1 is undefined or private. Did you
mean:` followed by a list of candidates, one per line. Flattened into the row it became a
sentence running off the right edge with the suggestions, the part you actually wanted,
past the end of it. Indented under the row they belong to, they read as what they are."
  (let (ls (message-lines d)
        head (str "  " (ed-diag-line1 line) ":" (or (:col d) 0) "  " (severity-glyph d) " " (first ls)))
    (cons head (map (rest ls) (fn (l) (str "         " l))))))

(defn findings (buf)
  "`[0-based-line diagnostic]` for every finding on `buf`, in line then column order —
reading order, which the producers do not promise (an LSP server emits in its own)."
  (sort-by (mapcat (%map-pairs (results/diagnostic-lines buf))
             (fn ([line ds]) (map ds (fn (d) [line d]))))
    (fn ([line d]) [line (or (:col d) 0)])))

(defn report (m)
  "`[text links]` for the pane: the report text, and the row→location map
(`:line-links`) that makes each row visit its finding.

Read off the BUFFER, not off the model's `:diagnostics`: the model holds one list and the
findings belong to the buffer they were computed from, so a list labelled with whatever
buffer happens to be current is a list that names the wrong file the moment a check lands
after you switch. `results/diagnostic-lines` is the same reader the margin uses.

EVERY row of a finding links to it, continuation rows included — a reader who clicks the
suggestion is asking to go to the same place as one who clicks the line above it."
  (let (buf (ed-current-buf m)
        nm (buffer-name buf)
        found (findings buf)
        n (count found)
        header (str (if (= n 0) "no" n)
                 (if (= n 1) " diagnostic in " " diagnostics in ")
                 nm
                 "\n")
        [rows links] (fold found
                       [[] {}]
                       (fn (acc entry)
                         (let ([out map-so-far] acc
                               [line d] entry
                               loc {:buffer nm :line (ed-diag-line1 line) :col (or (:col d) 0)}
                               mine (rows-for line d))
                           [(into [] (append out mine))
                             (fold (range (count mine))
                               map-so-far
                               ;; +2: the header line and the blank under it
                               (fn (mm i) (assoc mm (+ 2 (count out) i) loc)))]))))
    [(string/trimr (str header "\n" (string/join rows "\n"))) links]))

(defn render (m force)
  "Put the current buffer's findings in the pane — opening it with `force`, else only
refreshing one already up. The row→location map rides on the pane's buffer."
  (let ([text links] (report m)
        shown (aside/refresh *spec* m text force {:keep-scroll true})
        idx (ed-buffer-index-by-name shown *buffer-name*))
    (if (nil? idx)
      shown
      (ed-set-buf-at shown idx (assoc (ed-buf-at shown idx) :line-links links)))))

(defn refresh (m)
  "Re-render an OPEN pane when what it would show has changed — the post-step calls this on
every event, so it has to be free when there is nothing to do. Never opens a pane.

The guard compares the FINDINGS themselves (with the buffer they are about), not a rope or
a timestamp. A rope would have missed the commonest case there is: a language server
republishes `publishDiagnostics` for text that has not changed — you fixed the error, the
server re-reports the file, and the rope is identical because the fix was in a different
buffer or the notification simply arrived twice. The list is a handful of entries, so
comparing it is cheaper than the render it avoids."
  (let (buf (ed-current-buf m))
    (if (or (not (aside/open? *spec* m))
          ;; point inside the pane itself: the report is about the buffer you were
          ;; reading, not about the list you are reading it in
          (= (buffer-name buf) *buffer-name*))
      m ; …and the comparison below is not even reached, which is the point: this runs per event
      (let (key [(buffer-name buf) (results/diagnostic-lines buf)])
        (if (= key (get-in m [:diagnostics-pane :rendered]))
          m
          (assoc-in (render m false) [:diagnostics-pane :rendered] key))))))

;; ---- the command ------------------------------------------------------------------

(defn row-of (buf line)
  "The pane row showing the finding anchored on 0-based `line` of `buf`, or nil — the
inverse of [[report]]'s numbering, so a caller holding a source line can point at its row."
  (let (i (index-of (map (findings buf) first) line))
    ;; `index-of` answers -1, not nil, for "not found" — and -1 is truthy here
    (when (>= i 0) (+ i 2))))

(defcommand cmd-diagnostics
  (m key)
  "List every warning and error in this buffer in a `*Diagnostics*` pane beside it (C-c !);
RET on a row visits it. Run it again to close the pane."
  (if (aside/open? *spec* m)
    (message (aside/close *spec* m) "diagnostics closed")
    (let (m1 (render (aside/reopen *spec* m "") true))
      ;; counted off the BUFFER, as the report itself is: the model's list belongs to
      ;; whichever buffer it was computed from, which need not be this one
      (if (empty? (findings (ed-current-buf m1)))
        (message m1 "no diagnostics in this buffer")
        m1))))

(defn open-from-margin (m line)
  "Open the pane from a click on a line's ⚠/✗ margin mark (`modes/gutter-mark-sources`),
scrolled to the finding you clicked.

The mark says a finding is there and the inline note shows as much of it as fits at the end
of an already-indented line; the click is how you ask for the rest — so it lands on THAT
row, not at the top of a list you then have to search. It reopens a pane the reader had
dismissed, because clicking the mark IS asking."
  (let (m1 (render (aside/reopen *spec* m "") true)
        row (row-of (ed-current-buf m1) line))
    (if (nil? row) m1 (aside/scroll-to-line *spec* m1 row))))
