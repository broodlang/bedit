(defmodule diagnostics
  "**Diagnostics** — the warnings and errors a buffer has, whoever found them: the Brood
checker or a language server.

The context's details live under `src/diagnostics/`: the store every producer lands in, with a
diagnostic's positions converted in one place (`diagnostics/store`), the checker's run, in the
sandbox child rooted in the buffer's project (`diagnostics/check`), what a finding paints — the
wave under its token, the note after its line, the margin mark, the echo
(`diagnostics/paint`) — and the `*Diagnostics*` pane (`diagnostics/pane`, C-c !).

Other contexts set and read findings through the functions below; the pane is reached through
its command. Loading this module loads the parts that register at load."
  ;; loaded with the context: each registers what it runs or paints at load
  (:use diagnostics/check :only []) ; the advisory check and its sandbox session client
  (:use diagnostics/paint :only [])) ; the wave, the note, the margin mark, the echo

;; ---- setting a buffer's findings (diagnostics/store) -----------------------------------

(defdelegate set-diagnostics
  (m diagnostics rope &optional (for-buffer nil))
  diagnostics/store
  :as ed-set-diagnostics)
(defdelegate stamp-diagnostics-at
  (m index diagnostics)
  diagnostics/store
  :as ed-stamp-diagnostics-at)
(defdelegate diagnostic-index (diagnostics) diagnostics/store :as ed-diag-index)
(defdelegate without-quiet-lines (index quiet) diagnostics/store :as ed-without-quiet-lines)

;; ---- a finding's position, converted in one place (diagnostics/store) ------------------

(defdelegate line0 (diagnostic) diagnostics/store :as ed-diag-line0)
(defdelegate col0 (diagnostic) diagnostics/store :as ed-diag-col0)
(defdelegate line1 (line0) diagnostics/store :as ed-diag-line1)
(defdelegate span-end (text offset) diagnostics/store :as ed-diag-span-end)

;; ---- the report the pane shows (diagnostics/pane) -------------------------------------

(defdelegate findings (buffer) diagnostics/pane)
(defdelegate report-rows (line diagnostic) diagnostics/pane :as rows-for)
