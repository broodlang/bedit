(defmodule results
  "**The results-buffer abstraction** — the one shared foundation behind every read-only
report buffer whose rows name a source location: `*Tests*`, `*Run*`, `*compilation*`,
`*Occur*`, `*git-status*`. Three concerns, all app-agnostic (no command, no pane/pool
navigation — that stays in the editor's command layer, which *consumes* this):

  1. **Location vocabulary** — parse a `file:line[:col]` out of a report row (`loc-at-line`)
     and resolve the location a row links to, walking up to the nearest one above for a
     row that names none (`line-link-loc`). A mode with OFF-text locations (a test runner
     storing them by line) overrides the `:line-loc` service; the default reads the text.
     This one predicate drives the jump, the pointer cursor, and the hover underline alike.

  2. **The layer** — `location-jump-layer`: stack it on any results buffer and every
     location row becomes navigable (RET / click → `commands/cmd-visit-location`, resolved
     late by symbol so this module needn't depend on the command layer). Read-only + the
     `:line-loc` contract is all a consumer needs; an unusual row shape just overrides
     `:line-loc`.

  3. **Streaming** — `ed-append-follow`: append a line to a report buffer and follow the
     tail in any pane already at the bottom (Emacs `compilation-scroll-output`), never
     yanking a pane the reader scrolled up. The shared append behind live `*Tests*`/`*Run*`.

Consumers (`testrun`/`apprun`/`compile`/`modes`' occur+git) stack the layer, override
`:line-loc` if needed, and stream through `ed-append-follow`. The navigation *command*
(`cmd-visit-location` → `ed-pop-to-file`, pane/pool-coupled) lives in `commands` and uses
this layer's vocabulary — the app-specific half, kept out of the abstraction."
  (:use model) ; ed-mode-service / ed-append-named / ed-buf-at / ed-buffer-index-by-name
  (:use editor/buffer) ; buffer-line-at / buffer-line-count — read a row's text / length
  (:use editor/keymap) ; keymap-bind — the RET binding on the jump keymap
  (:use panes) ; ed-body-layout / ed-pane-vrows / ed-pane-top — find + measure the panes
  (:use editor/pane)) ; pane-update-path — scroll the pane that follows the tail
;; ---- location vocabulary: parse a row → a source location -------------------

(defn- loc-file-token? (file)
  "Whether `file` looks like a source path rather than a host / clock field. A path
separator is decisive; a dot counts only when the part after the LAST dot is a
non-empty, non-numeric extension (`foo.blsp` yes; `0.0.0.0`, `127.0.0.1` no — an
all-numeric tail is an IP octet, not an extension). Guards against `12:34:56`
timestamps and `host:port` being read as `file:line` (a red log line + a jump to a
bogus `<root>/12` on click)."
  (and (> (string/length file) 0)
    (or (includes? file "/")
      (let (i (string/last-index-of file "."))
        (and (>= i 0)
          (let (ext (string/substring file (inc i) (string/length file)))
            (and (> (string/length ext) 0)
              (failure? (string/->number ext)))))))))

(defn- loc-parse-token (token)
  (let (parts (string/split (or token "") ":")
        n (count parts))
    (when (>= n 2)
      (let (nums (seq/filter (map (rest parts) string/->number) int?)
            file (first parts))
        (when (and (loc-file-token? file) (not (empty? nums)))
          {:file file :line (first nums) :col (or (second nums) 1)})))))

(defn loc-at-line (line)
  "Parse a `file:line[:col]` location from a report row — the leading token (an
indented failure line) or the trailing one (a labelled ✓/✗ row that carries its
declaration site at the end). nil when the row names none."
  ;; `trim`, not `triml`: `buffer-line-at` keeps the trailing newline, which would
  ;; otherwise stick to a TRAILING location token (`12\n`) and fail to parse — the
  ;; reason a ✓/✗ row (its `file:line` at the end) wouldn't jump.
  (let (tokens (seq/filter (string/split (string/trim line) " ") (fn (t) (not (= t "")))))
    (when (not (empty? tokens))
      (or (loc-parse-token (first tokens))
        (loc-parse-token (last tokens))))))

(defn default-line-loc (buf line0)
  "The default `:line-loc` service — parse `file:line[:col]` from the line's TEXT
(`loc-at-line`). A mode with off-text locations (a test runner storing them by line)
provides its own `:line-loc (buf line0) -> loc`."
  (loc-at-line (buffer-line-at buf line0)))

(defn line-loc-service (buf)
  "The buffer's `:line-loc` service (`(buf line0) -> {:file :line :col}|nil`), or the
default text parser. THE seam a results mode implements to become link-navigable."
  (or (ed-mode-service buf :line-loc) default-line-loc))

(defn line-links-loc (buf line0)
  "A `:line-loc` for a results buffer that stores its row→location map OFF-text in `:line-links`
(0-based line → `{:file :line :col}`) — the ONE mechanism `*Tests*` and `*git-status*` share:
the visible row stays clean (no file path in the text) while the click / hover / RET resolve
through the map, falling back to the text parser (`default-line-loc`) for a row not in it. A mode
becomes link-navigable by (1) stashing `:line-links` on its buffer and (2) setting
`:line-loc 'results/line-links-loc`."
  (or (get (:line-links buf) line0)
    (default-line-loc buf line0)))

(defn line-link-loc (buf line0)
  "The source location line `line0` links to, or — when it names none — the nearest
one on a line ABOVE it (bounded 40): so a test's indented output/detail lines link
to the test row above them. Drives BOTH the jump and the hover/cursor affordance."
  (let (svc (line-loc-service buf))
    (letrec (go (fn (i limit)
                  (cond
                    (or (< i 0) (<= limit 0)) nil
                    else
                      (let (loc (svc buf i))
                        (if (nil? loc) (go (dec i) (dec limit)) loc)))))
      (go line0 40))))

;; ---- the layer: read-only + navigable location rows -------------------------
;; Any report buffer whose rows name source locations stacks this: RET and a mouse click
;; both visit the row's location (`commands/cmd-visit-location`, resolved late by symbol),
;; parsed by the mode's `:line-loc` service or the standard `file:line[:col]:` shape, and
;; every clickable line gets a pointer cursor + a subtle hover highlight (the view reads
;; `:line-loc`). A mode with off-text locations overrides `:line-loc`; everyone else needs
;; nothing but to stack the layer.

(def location-jump-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-visit-location)))

(def location-jump-layer
  {:name 'location-jump
   :keymap location-jump-keymap
   :on-click 'commands/cmd-visit-location
   :line-loc 'results/default-line-loc
   :commands '("visit-location")})

;; ---- streaming: append + follow the tail ------------------------------------

(defn- ed-follow-tail (m idx old-lines cols rows)
  "Scroll every pane showing pool buffer `idx` that was at the BOTTOM before an append
(its line count then = `old-lines`, and its viewport reached that last line) down to the
new last line — so streamed output stays in view (Emacs `compilation-scroll-output`)
without yanking a pane the user has scrolled UP to read. No-op unless `:scroll-output`."
  (if (not (:scroll-output m))
    m
    (let (buf (ed-buf-at m idx)
          new-lines (buffer-line-count buf))
      (fold (:panes (ed-body-layout m cols rows))
        m
        (fn (mm pane)
          (let (vrows (ed-pane-vrows pane buf))
            (if (and (= (get-in pane [:payload :buffer]) idx)
                  (>= (+ (ed-pane-top pane buf) vrows) old-lines))
              ; was showing the old last line
              (assoc mm
                :layout
                  (pane-update-path (:layout mm)
                    (:path pane)
                    (fn (w) (assoc w :top (math/max 0 (- new-lines vrows))))))
              mm)))))))

(defn ed-append-follow (m nm s cols rows)
  "Append `s` to buffer `nm` (`ed-append-named`) then follow the tail in any pane already
at its bottom (`ed-follow-tail`) — the streaming-output append shared by *Tests* / *Run*.
Falls back to a plain append when no pane shows the buffer."
  (let (idx0 (ed-buffer-index-by-name m nm)
        old-lines (if (nil? idx0) 0 (buffer-line-count (ed-buf-at m idx0)))
        m1 (ed-append-named m nm s)
        idx (ed-buffer-index-by-name m1 nm))
    (if (nil? idx) m1 (ed-follow-tail m1 idx old-lines cols rows))))

;; ---- end-of-line notes: derived text shown AT a line -------------------------
;; A note is `{owner-key -> {:line n :kind :info|:pass|:fail|:running|:hint :text str}}`
;; stored as ONE buffer annotation (`std/editor/buffer`'s `annotate`, so currency and
;; staleness come for free) under `:eol-notes`. Three renderers share it: the margin
;; glyph (`modes/gutter-mark-for`), the ghost text past the line's end
;; (`view/ed-eol-note-ops`), and the echo row when point is on the line
;; (`view/ed-eol-note-on-line`).
;;
;; Owner-keyed rather than line-keyed on purpose: the producer knows what a note is
;; ABOUT (a playground box, a form, a test) and rebuilds its own entries, so a note
;; can never be stranded at a line the text moved out from under. The tutorial's
;; per-box verdicts are the first consumer; inline `C-x C-e` results, LSP inlay hints,
;; git blame and test failure text are the same shape.
;;
;; TWO kinds of derived text, and the distinction is what [[set-note]] is for. A RESULT
;; is what the code did and belongs under it; a HINT is what the language makes of the
;; code — a type, a signature, a blame line — and belongs AT it. So one call places both,
;; on two lines, from one note: `{… :text "=> 3" :hint ": int"}`. Neither is ever inserted
;; into the buffer, which is the constraint the whole shape exists to honour — real lines
;; would push everything below them down each time an answer arrived or a type changed,
;; and text must not jump under the cursor.

;; ---- anchoring: which line a note goes on ------------------------------------
;; Line arithmetic over a buffer's TEXT rather than its rope: a producer deriving notes
;; has the text already (it just parsed it into forms or regions), so asking the rope
;; per note would traverse twice for one answer.

;; Line arithmetic goes to the ROPE, never to the text. A producer deriving notes has the
;; text already (it just parsed it into forms or regions), so asking the string "which line
;; is offset N on?" looks free — but each such question is a `string/split` of the whole
;; buffer, and a producer asks one per note. That is O(notes × buffer): 114ms to place the
;; notes of a 500-form playground, on the keystroke path. The rope indexes lines already
;; (`text/char->line`, O(log n)); asking it is both faster than a table built here and less
;; code than one, which is the usual shape of a toolkit question answered by hand.

(defn line-count (rope)
  "How many lines `rope` has — a trailing newline ends a line, `\"\"` is one line."
  (text/line-count rope))

(defn line-of (rope pos)
  "The 0-based line the character offset `pos` falls on, clamped into `rope`."
  (text/char->line rope (math/min (math/max 0 pos) (text/length rope))))

(defn line-text (rope line)
  "The text of 0-based `line`, its trailing newline included; `\"\"` for a line that isn't
there."
  (if (or (< line 0) (>= line (line-count rope))) "" (text/line rope line)))

(defn answer-line (rope pos)
  "Where a RESULT for code ending at offset `pos` goes: **the line below when that line is
blank**, else the code's own line.

Not simply \"the line below\", which is what it reads best as — `=> 6` under the form rather
than trailing it — because that only holds when the line below is empty. Two other cases
share one answer:

  - **The next form starts immediately below.** An answer placed there lands where that
    form's own derived text already sits, and two ghost texts at one line's end paint over
    each other — `=> bar` and `=> 42` come out as illegible mush. (What made this a bug and
    not a curiosity: a buffer with no blank lines between forms is the normal way to write.)
  - **There is no line below at all** — code at the very end of a buffer with no trailing
    newline. That anchor is past EOF, which does not merely hide the note: a renderer asks
    the rope for the line and the frame dies (`%rope-line: line 4 out of bounds`).

In both, the right place is the end of the code's own line, so this is one rule rather than
a rule plus a clamp. [[set-note]] then folds a hint for that same line into the answer, since
they would otherwise be the two texts overpainting."
  (let (here (line-of rope pos)
        below (inc here))
    (if (and (< below (line-count rope)) (string/blank? (line-text rope below)))
      below
      here)))

(sig eol-notes (buffer -> (or nil map)))
(defn eol-notes (buf)
  "The buffer's end-of-line notes while they are positionally current, else nil."
  ;; as `eol-notes-any` below: an annotation's value is `any` in std, so the guard is
  ;; what proves the map this declares
  (let (notes (annotation-value buf :eol-notes))
    (if (map? notes) notes nil)))

(sig eol-notes-any (buffer -> (or nil map)))
(defn eol-notes-any (buf)
  "The notes REGARDLESS of positional currency — for the PRODUCER, which re-anchors
them as it rebuilds (a note whose line has shifted is still the right note; it just
needs a new `:line`). Renderers must use `eol-notes`, which hides notes that would
paint at the wrong line."
  ;; an annotation's `:value` is whatever the producer stored (std/editor/buffer keeps
  ;; it as `any`); the notes producer stores a map, and the guard says so
  (let (notes (:value (annotation buf :eol-notes)))
    (if (map? notes) notes nil)))

(defn eol-notes-stale? (buf)
  "Whether the notes predate the buffer's current text (an edit dims them)."
  (let (a (annotation buf :eol-notes)) (and a (:stale? a))))

(defn eol-notes-hidden? (buf)
  "The buffer HAS notes and [[eol-notes]] will not hand them to a renderer — the line count
moved since they were stamped, so every result the reader had is gone from the screen.

The question a live evaluator's `stale?` predicate has to ask alongside \"did the text
move?\". Those two are not the same, and treating them as one is how a buffer gets STUCK
showing nothing: a note stamped when a reply landed describes the rope of that moment, and
if the text then returns to what the last launch parsed (type a newline, delete it again)
the rope test says \"nothing to do\" while the notes are anchored to a line count the buffer
no longer has. Nothing re-anchors them, nothing re-evaluates, and the results stay invisible
until the next real edit. Asking this too is what re-arms the debounce."
  (let (a (annotation buf :eol-notes))
    (and a (not (:current? a)) (not (empty? (or (:value a) {}))))))

(defn note-pending? (kind)
  "Is this note kind \"no answer yet\" — the request is still out (`:running`), or the region
is mid-form and was never sent (`:incomplete`)?

The margin glyph and the ghost-text face both branch on it, and both must: a pending note
takes the dim voice and the `⋯` mark, never a verdict colour, because grey reads as \"not in
yet\" while green or red reads as an answer that has landed. One predicate rather than the
same two-way `or` in each renderer — a third pending flavour would otherwise be wired into
one table and forgotten in the other, which is exactly how the playground's notes came to
paint as results."
  (or (= kind :running) (= kind :incomplete)))

(defn diagnostic-error? (d)
  "Is this finding something that will not compile, as opposed to an advisory?

An LSP server says so with `:severity 1`; Brood's checker says so in the message. One
predicate, because the margin glyph and the pane's row both have to make the same call —
a line marked ⚠ whose row reads ✗ is the margin and the list disagreeing about the same
finding."
  (or (= (:severity d) 1)
    (= (:severity d) :error)
    (includes? (or (:message d) "") "does not compile")))

(defn diagnostic-lines (buf)
  "The findings anchored on `buf` as `{0-based line -> (list diagnostic)}`, or `{}` when it
carries none or they no longer describe the text (`annotate`'s `:current?`).

THE reader for diagnostics — the margin and the `*Diagnostics*` pane both come here, so a
finding can never be in one and not the other. It is a buffer annotation rather than the
model's `:diagnostics` for two reasons: the gutter's cell cache is keyed on the buffer, and
the model holds ONE list while the findings belong to the particular buffer they were
computed from (`model/ed-set-diagnostics` stamps only that one)."
  (let (a (editor/buffer/annotation buf :diagnostic-lines))
    (if (and a (:current? a)) (or (:value a) {}) {})))

(defn note-glyph (note)
  "The one-character mark for a note — `·` a result, `✓` a pass, `✗` a failure, `⚠` an
advisory, `⋯` an answer still out.

The single spelling, asked for by kind. It used to be spelled twice — once by the margin
and again inside each note's own `:text` — so a raise painted `✗   ✗ ** (FunctionClauseError)
…`: the glyph beside the glyph, in a note already short of room. A note now carries its
MESSAGE and nothing else, and every renderer that wants a mark asks here."
  (let (kind (if (:warn note) :warn (:kind note)))
    (cond
      (= kind :pass) "✓"
      ;; `:broken` says the same thing as `:fail` — this will not run — and says it in the
      ;; pending VOICE (see `ed-eol-note-face`), because a form you are still typing has
      ;; not failed, it has not run yet
      (or (= kind :fail) (= kind :broken)) "✗"
      (note-pending? kind) "⋯"
      (= kind :warn) "⚠"
      else "·")))

(defn hint-key (key &optional (index nil))
  "The key owner `key`'s HINT is stored under, one per `index`. Derived rather than chosen
by the caller so that [[set-note]] can always find and clear the hints that no longer apply
— and keyed apart from the result because they sit on different lines and are rebuilt
together.

`index` is nil for a form with ONE derived note (a type at its opening line) and 0, 1, 2 …
for a form that derives one per thing it defines — a `defmodule` with a note against each
`def` inside it. Both shapes answer [[owner-of]] the same way, so ordering does not care
which a producer used."
  (if (nil? index) [:hint key] [:hint key index]))

(defn owner-of (key)
  "Whose note `key` holds — itself, or the owner its hint was derived for. [[hint-key]]'s
inverse, so a reader can order a hint with the thing it describes rather than beside it."
  (if (and (vector? key) (= (first key) :hint)) (second key) key))

(defn- by-owner (entries)
  ;; `[key note]` pairs in owner order — a hint sorting with the owner it describes, since
  ;; `owner-of` is `hint-key`'s inverse. Every producer keys by an index into what it derived
  ;; notes FROM (a form, a box, a region), so numeric order is source order, which is what
  ;; makes two notes on one line read left to right the way the code does. A non-numeric
  ;; owner sorts after those, by its printed form, so the order is total whatever a future
  ;; producer keys by; the annotation is a map, and map order is not an order.
  (let (owner (fn (kv) (owner-of (first kv)))
        ints (seq/filter entries (fn (kv) (int? (owner kv)))))
    (append (sort-by ints owner)
      (sort-by (seq/filter entries (fn (kv) (not (int? (owner kv))))) (fn (kv) (pr-str (owner kv)))))))

(defn notes-on-line (buf line)
  "EVERY current note anchored on 0-based `line`, in reading order: the hint first (it
describes the code right there), then the results in owner order. `()` when the notes are
not positionally current.

Plural because a line can carry more than one — two forms written on one line, or a form
whose answer had nowhere below it to go — and every reader of this annotation has to survive
that. A reader that takes only the first silently drops the rest; a renderer that draws them
all at the same column paints them on top of each other. A buffer holds a handful of notes,
so this scans."
  (let (here (by-owner (seq/filter (or (eol-notes buf) {}) (fn (kv) (= (:line (second kv)) line))))
        notes (map here second))
    (append (seq/filter notes (fn (n) (= (:kind n) :hint)))
      (seq/filter notes (fn (n) (not (= (:kind n) :hint)))))))

(defn note-lines (buf)
  "The distinct lines carrying a current note, ascending — what a renderer iterates so it
visits each line once and can lay that line's notes out side by side."
  (sort (seq/distinct (map (or (eol-notes buf) {}) (fn (kv) (:line (second kv)))))))

(defn note-text (note)
  "One note's full text, its `:warn` advisory included — what a reader with room for the
whole thing shows. Shared so the ghost text, the echo row and any later reader cannot
disagree about what a note says.

`:warn` carries TWO things and only one of them is text. The tutor stores the advisory it
wants shown beside a result (`(assoc note :warn (:text w))`, a string); the checker's
diagnostics store a plain flag (`:warn true`) that `mark-note-glyph` and `ed-eol-note-face`
read to pick the ⚠ and its colour. Appending it unconditionally printed the flag —
`⚠ unbound symbol: acc   true` — so only a STRING is text to append."
  (if (string? (:warn note)) (str (:text note) "   " (:warn note)) (:text note)))

(defn eol-note-at (buf line)
  "The line's notes as ONE string (`\": int  => 42\"`), or nil when it carries none — the
echo-area form of [[notes-on-line]], for the row that reports what is on the cursor's line."
  (let (notes (notes-on-line buf line))
    (when (not (empty? notes))
      (string/join (map notes note-text) "  "))))

(defn- without-hints (notes key)
  ;; every derived hint currently stored for `key`, dropped — however many there are and
  ;; whichever shape keyed them. Rebuilt-not-patched: a form that defined three functions
  ;; and now defines two must not keep the third's note sitting on a line it no longer owns.
  (fold (keys notes)
    notes
    (fn (acc k)
      (if (and (vector? k) (= (first k) :hint) (= (second k) key)) (dissoc acc k) acc))))

(defn- hint-entries (buf key note at hint-at)
  ;; `([hint-key note] …)` — the derived notes this note wants placed away from its answer.
  ;;
  ;; `:hints` is the general form: one `{:line :text}` per thing the form defined, each at
  ;; its OWN line, which is what puts a type against every `def` inside a `defmodule`
  ;; instead of piling all their names onto the `defmodule` line. `:hint` is the same
  ;; mechanism with one entry at the form's opening line, and is kept because that is what
  ;; a plain expression wants: it has one type and one place to say it.
  ;;
  ;; A `:hints` line is CHECKED against the buffer, which `:hint`'s never needed to be: a
  ;; lone hint's line is derived from an offset in this very rope, while these come back
  ;; from the child, which was sent the form as it stood some milliseconds ago. Delete two
  ;; lines while a reply is in flight and its notes name lines the buffer no longer has —
  ;; and a note anchored past EOF does not merely fail to show, it takes the FRAME down
  ;; (`%rope-line: line 7 out of bounds`) the next time a renderer asks the rope for that
  ;; line. The stale ones are dropped; the next launch re-derives them all anyway.
  (let (lines (buffer-line-count buf)
        hints (:hints note))
    (cond
      (not (empty? hints))
        (seq/keep (seq/enumerate hints)
          (fn ([i h])
            (let (line (:line h))
              (when (and (:text h) (int? line) (>= line 0) (< line lines))
                [(hint-key key i) {:kind :hint :text (:text h) :line line}]))))
      (and (:hint note) hint-at (not (= hint-at at)))
        (list [(hint-key key) {:kind :hint :text (:hint note) :line hint-at}])
      else '())))

(defn set-note (buf key note at &optional (hint-at nil))
  "Store `note` under `key` anchored on 0-based line `at`, re-stamping the annotation against
the current text.

A note's DERIVED text — the types it wants shown at the code rather than under it — is
placed as its own note(s) under [[hint-key]], so the answer and the types can never move one
another. Two shapes: `:hint` is one string at `hint-at` (an expression's type, at the form's
opening line), and `:hints` is a vector of `{:line :text}`, one per thing the form defined,
each at its own line (a `defmodule`'s functions, against their own `def`s). When a lone
hint's line coincides with the answer's (a region whose answer [[answer-line]] put at the
end of its own line, having nowhere blank below) it rejoins the note's text instead of
becoming a second note at the same cell. With no hints, any stale ones for `key` are dropped.

The hints travel INSIDE the note rather than as more arguments so that a producer
re-anchoring its notes after an edit re-derives all of them from one entry, and cannot leave
one stranded on a line its owner has moved off. The note's own text is kept under `:answer`,
so re-stamping a note that was already joined (`\"=> 3  : int\"`) joins the hint to the answer
again — not to the joined text, which appended another `: int` on every re-anchor.

Merges onto [[eol-notes-any]] (not [[eol-notes]]): a sibling owner's note must survive even
when the lines have shifted since it was written, or whoever writes second silently deletes
the first one's work."
  (let (hint (:hint note)
        share? (and hint (empty? (:hints note)) hint-at (= hint-at at))
        answer (or (:answer note) (:text note))
        notes (assoc (without-hints (or (eol-notes-any buf) {}) key)
                key
                  (assoc note
                    :answer answer
                    :text (if share? (str answer "  " hint) answer)
                    :line at)))
    (annotate buf
      :eol-notes (fold (if share? '() (hint-entries buf key note at hint-at))
                   notes
                   (fn (acc entry) (let ([k v] entry) (assoc acc k v)))))))
