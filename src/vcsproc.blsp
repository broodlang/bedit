(defmodule vcsproc
  "What every version control's command line shares in the editor, git's and mur's alike:
the PROCESS LOG (`$`, Magit's `magit-process-buffer`) — every command a VCS porcelain ran,
its exit code, how long it took and its output — and running one OFF the loop (`vcs-launch`),
for a command that talks to a network (git's pull and push, mur's land and update).

A porcelain runs its commands through `vcs-launch` (a network one, in a task) or the
working-tree queue (`vcs-run-queued`, one at a time, in order, each in a task) — journalled,
naming the PROGRAM, so the log reads `git push` beside `mur land` in the order they ran — and
asks what a key must know first (the refs to complete over, whether anything is staged)
through the same queue (`vcs-gather`). No key runs a VCS on the loop; `vcs-run` is the
synchronous form headless runs use. Nothing here knows any one VCS's arguments or output."
  (:use editor/keymap :only [keymap-bind]) ; the *vcs-process* keymap
  (:use editor/layers :only [register-type-layers]) ; its buffer type
  (:use model) ; message / ed-apply / ed-buffer-index-by-name / ed-headless? / register-task-reply
  (:use pool) ; ed-display-buffer / ed-upsert-named / ed-goto-line
  (:use interactive) ; defcommand
  (:use section) ; section — a diff's hunks as sections
  (:use task)) ; task — a network command, off the loop
;; `theme` (a project source module, loaded with the image) provides the *green* / *red* /
;; *blue* / *subtext* dynamic-var colour globals this file reads bare.

;; ---- unified diffs, as every VCS prints them ---------------------------------------
;; git and mur both print a unified diff (`git diff`, `mur diff`), so the faces of one, and
;; the classifiers that pick them from a line, are the shared vocabulary of every diff view:
;; a section buffer's hunk lines, a plain-text report's raw output, the process log.

(theme/defchrome vcs-face-add {:fg *green*}) ; an added (+) line; a command that exited 0
(theme/defchrome vcs-face-del {:fg *red*}) ; a removed (-) line; a command that failed
(theme/defchrome vcs-face-hunk {:fg *blue* :bold true}) ; a @@ hunk header; a command still running
(theme/defchrome vcs-face-file {:fg *subtext* :bold true}) ; diff --git / +++ / --- file headers
(theme/defchrome vcs-face-meta {:fg *subtext*}) ; index / mode / rename metadata

;; Magit's look: an added or removed line is a faint tint of its colour across the whole pane
;; (`:section-bands`), the words that changed in it a stronger one, the code itself in its
;; language's colours; a hunk heading is a bar. Blended from the palette (`theme/mix`), so a
;; theme switch re-derives them.
(theme/defchrome vcs-face-add-band {:bg (theme/mix *green* *base* 0.12)}) ; an added line's background
(theme/defchrome vcs-face-del-band {:bg (theme/mix *red* *base* 0.12)}) ; a removed line's background
(theme/defchrome vcs-face-add-refine {:bg (theme/mix *green* *base* 0.32)}) ; the words an added line changed
(theme/defchrome vcs-face-del-refine {:bg (theme/mix *red* *base* 0.32)}) ; the words a removed line changed
(theme/defchrome vcs-face-hunk-band {:bg (theme/mix *blue* *base* 0.14)}) ; a @@ hunk heading's bar
(theme/defchrome vcs-face-hunk-range {:fg *overlay0*}) ; a hunk heading's `@@ -a,b +c,d @@`

(defn vcs-whole-line (off line face)
  "A whole-line span `[off end face]`, or `()` when `face` is nil."
  (if (nil? face) '() (list [off (+ off (string/length line)) face])))

(defn vcs-diff-line-face (line)
  "The face of one diff BODY line by its first character, or nil for context."
  (cond
    (string/starts-with? line "+") vcs-face-add
    (string/starts-with? line "-") vcs-face-del
    (string/starts-with? line "\\") vcs-face-meta
    else nil))

(defn vcs-diff-text-face (line)
  "The face for a line of raw unified-diff TEXT: headers, hunk headers, `+` and `-` lines;
nil for a context line. For the plain-text reports (`!`'s output, `mur diff`); a section
buffer colours by what a line IS instead (its row)."
  (cond
    (string/starts-with? line "@@") vcs-face-hunk
    (or (string/starts-with? line "+++") (string/starts-with? line "---")) vcs-face-file
    (string/starts-with? line "diff ") vcs-face-file
    (or (string/starts-with? line "index ")
      (string/starts-with? line "new ")
      (string/starts-with? line "deleted ")
      (string/starts-with? line "rename ")
      (string/starts-with? line "similarity ")
      (string/starts-with? line "old mode")
      (string/starts-with? line "new mode"))
      vcs-face-meta
    else (vcs-diff-line-face line)))

(defn vcs-diff-fontify (src)
  "The `:fontify` of a plain-text report holding a unified diff — colour each line."
  (modes/fontify-lines src (fn (l off) (vcs-whole-line off l (vcs-diff-text-face l)))))

;; A file's diff in a section buffer is the same tree whichever VCS printed it: each hunk a
;; section headed by its `@@` line, its lines the body — parsed by std's `diff`, so a body line
;; knows the file line it is (`diff/hunk-new-line`) and a hunk can be turned back into a patch.

(defn vcs-hunk-sections (file value &optional (paint? true))
  "The hunk sections of one parsed `std/diff` file: each `@@` header a heading, its lines the
body, each section's value `value` with `:file` and `:hunk` added. Keyed by position and
header, so a re-render keeps a folded hunk folded. A hunk's value also carries how to paint
it (`diffpaint`): `:syntax`, its lines in their language's colours, and `:refine`, the words
that changed — when `paint?` (the buffer's budget, `diffpaint/paint-keys`, has room for this
file) and the file is small enough to paint (`diffpaint/paint?`). A hunk's paint is
remembered (`diffpaint/hunk-paint`), so rebuilding a tree repaints only the hunks that changed."
  (let (hunks (:hunks file)
        path (or (:new-path file) (:old-path file))
        painted? (and paint? (diffpaint/paint? file)))
    (map (range (count hunks))
      (fn (i)
        (let (h (nth hunks i)
              paint (if painted? (diffpaint/hunk-paint path (:lines h)) {:syntax nil :refine {}}))
          (section :hunk
            (merge value {:file file :hunk h :syntax (:syntax paint) :refine (:refine paint)})
            (:header h)
            (:lines h)
            {:key (str i " " (:header h))}))))))

(defn vcs-hunk-line (row hunk)
  "The line of the NEW file the section `row` stands for inside `hunk` (a `vcs-hunk-sections`
value): a body line the line it is (or, removed, sits at); the heading the hunk's first line.

    (vcsproc/vcs-hunk-line {:heading? false :line 2} {:hunk {:new-start 10 :lines [\" a\" \"-b\" \"+c\"]}})   ;=> 11"
  (if (and row (not (:heading? row)) (int? (:line row)))
    (diff/hunk-new-line (:hunk hunk) (:line row))
    (:new-start (:hunk hunk) 1)))

(defn- vcs-hunk-heading-spans (line)
  "A `@@ -a,b +c,d @@ context` heading: the line ranges quiet, the context (the function the
hunk is in) in the hunk face."
  (let (after (if (> (string/length line) 2)
                (index-of (string/substring line 2 (string/length line)) "@@")
                -1)
        close (if (< after 0) -1 (+ after 2)))
    (if (< close 0)
      (vcs-whole-line 0 line vcs-face-hunk)
      (list [0 (+ close 2) vcs-face-hunk-range] [(+ close 2) (string/length line) vcs-face-hunk]))))

(defn vcs-hunk-spans (row line)
  "The faces of `line`, a line of a `vcs-hunk-sections` hunk that section `row` stands for:
its heading's ranges and context, or a body line's sign in green or red, its code in its
language's colours (the line whole in green or red when the language has none) and the
words it changed under a stronger tint."
  (if (:heading? row)
    (vcs-hunk-heading-spans line)
    (let (value (:value row)
          index (:line row)
          sign-face (vcs-diff-line-face line)
          syntax (when (and (vector? (:syntax value)) (int? index)) (nth (:syntax value) index nil))
          spans (cond
                  (string/starts-with? line "\\") (vcs-whole-line 0 line sign-face)
                  (nil? syntax) (vcs-whole-line 0 line sign-face)
                  (nil? sign-face) syntax
                  else (into [[0 1 sign-face]] syntax))
          changed (get (or (:refine value) {}) index))
      (if (empty? changed)
        spans
        (diffpaint/overlay (into [] spans)
          changed
          (if (string/starts-with? line "+") vcs-face-add-refine vcs-face-del-refine))))))

(defn vcs-hunk-band (row line)
  "The background of `line` in a hunk (a `:section-bands` service's answer for one): the
heading's bar, an added or removed line's tint, nil for context."
  (cond
    (:heading? row) vcs-face-hunk-band
    (string/starts-with? line "+") vcs-face-add-band
    (string/starts-with? line "-") vcs-face-del-band
    else nil))

;; ---- the journal: what the VCS actually ran (`$`) -------------------------------
;; Magit's `$` (`magit-process-buffer`): every invocation, its exit code and its output,
;; newest last — the answer to "what did it actually run" and to "it failed and the echo
;; area only gave me one line of it". ONE log for every VCS, because a project that moved
;; from git to mur still asks the question of both.
;;
;; Called the JOURNAL and not the process log because the porcelains already have handles
;; to running things named `…-proc` (`:vcs-proc`, `:vcs-op-proc`), and a list of past
;; commands four characters away from one is a misreading waiting to happen.
;;
;; It lives on the MODEL rather than in a shared table because every command worth
;; recording already threads the model — the synchronous ones through `vcs-run`, the network
;; ones through `vcs-launch` (recorded when they START, so an in-flight pull reads `run`) and
;; `vcs-apply-op` (completed when they land). A read-only command a renderer runs to draw a
;; diff is not in here; Magit logs those too and they are mostly noise.
;;
;; Four things this does that Magit does not:
;;   - a DURATION per entry, which is what you want to know when a push feels slow;
;;   - `\r` progress applied — `git push`'s "Writing objects: 47%" rewrites its line, so the
;;     entry holds the line it ended on rather than forty of them (`ansi/render`);
;;   - credentials in a remote URL are REDACTED, because a journal gets pasted into bug
;;     reports;
;;   - the NUL a `-z` command separates its paths with is shown as `^@` rather than written
;;     into the rope.

(def *vcs-journal-max* 64) ; entries kept; the oldest go first, never one still running

(def *vcs-op-timeout-ms* 120000)
;; A network operation gets two minutes before the task is killed and reported as a timeout.
;; Unbounded is how a wedged pull against an unreachable host becomes a slot that never frees
;; and a command that is "already running" until restart.

;; ---- an entry ----------------------------------------------------------------
;; `{:id :program :args :exit :ms :output :running? :at}` — one map, built in ONE place, so
;; the producers (a synchronous run, a git hunk apply, a launched network op) cannot drift
;; into three shapes.

(defn- vcs-redact (s)
  "`s` with the credentials in its URLs replaced by `***`: the password of a
`user:secret@`, and the whole user part of an `http(s)://token@` — a personal access
token is sent as the USERNAME (`https://ghp_…@github.com`), so hiding only what follows a
colon left the token itself in the log. An ssh `git@host` names an account, not a
secret, and stays."
  (regex/replace "(https?://)[^/@:\\s]+@"
    (regex/replace "://([^/@:\\s]+):[^/@\\s]+@" s "://$1:***@")
    "$1***@"))

(defn- vcs-printable (s)
  "`s` made fit to put in a rope: `\\r` progress and escape sequences APPLIED (so
\"Writing objects: 47%\" is the line it ended on, not forty lines), the NUL a `-z`
command separates paths with shown as `^@`, and credentials redacted."
  (let (rendered (if (or (includes? s "\r") (includes? s "\e")) (ansi/render "" s) s))
    (vcs-redact (string/trimr (string/replace rendered (string/int->char 0) "^@")))))

(defdyn *vcs-entry-output-max-lines* 500)
;; Lines of output one journal entry keeps — its LAST ones, where a VCS says how it ended. The
;; journal keeps `*vcs-journal-max*` entries, so this is what bounds the whole log: a command
;; that printed a hundred thousand lines no longer keeps them all for the session.

(defn vcs-entry-tail (output)
  "`output` cut to its last [[*vcs-entry-output-max-lines*]] lines, a first line saying how
many earlier ones were dropped; `output` itself when it is no longer.

    (binding (*vcs-entry-output-max-lines* 2) (vcsproc/vcs-entry-tail \"a\\nb\\nc\"))   ;=> \"[1 earlier line dropped]\\nb\\nc\""
  (let (lines (string/split output "\n")
        excess (- (count lines) *vcs-entry-output-max-lines*))
    (if (<= excess 0)
      output
      (str "["
        (ed-count-noun excess "earlier line")
        " dropped]\n"
        (string/join (drop lines excess) "\n")))))

(defn vcs-entry-output (r)
  "The output an entry shows: stderr then stdout — a VCS says the interesting thing on
stderr — or what a task that never answered leaves behind; its last
[[*vcs-entry-output-max-lines*]] lines ([[vcs-entry-tail]])."
  (if (nil? r)
    "no result (timed out)"
    (vcs-entry-tail (vcs-printable (str (:stderr r "") (:stdout r ""))))))

(defn vcs-entry (program args)
  "A journal entry for `program args`, as it reads while it is still running. No `verb`:
the label a command puts in the echo area (`stage hunk`) is the echo's business, and an
entry that carried both could disagree with the command line — which is the one thing this
buffer exists to be right about."
  {:program program :args (into [] args) :running? true :at (os/now)})

(defn- vcs-entry-done (e r)
  "Entry `e` completed by result `r` (nil = the task never answered), timed from its
own `:at` — the entry knows when it started, so nothing else has to carry that."
  (assoc e
    :running? false
    :ms (- (os/now) (or (:at e) (os/now)))
    :exit (if (nil? r) nil (:exit r))
    :output (vcs-entry-output r)))

;; ---- the log ------------------------------------------------------------------
;; The buffer is a VIEW of the log, not a copy of it: every write re-renders it in place
;; (`ed-upsert-named` — no pane, no selection touched) when it happens to be open, so a
;; `pull` you are watching completes in front of you rather than when you next press `g`.

;; check-allow: `:vcs-journal` is the log this file owns and only ever writes as a vector;
;; the model record does not declare it, so `or` reads as every value a map key could hold.
(check-allow :trusted
  (sig vcs-journal (model -> vector))
  (defn vcs-journal (m)
    "The process log, oldest first."
    (or (:vcs-journal m) [])))

(defn- vcs-journal-sync (m)
  "Re-render *vcs-process* in place when it is open; the model unchanged when it is not."
  (if (nil? (ed-buffer-index-by-name m "*vcs-process*"))
    m
    (pool/ed-upsert-named m "*vcs-process*" (vcs-journal-text m) :vcs-process)))

(defn- vcs-journal-trim (entries)
  "`entries` cut to `*vcs-journal-max*`, dropping the oldest — but never one still running,
whose output has not arrived yet."
  (let (n (count entries))
    (if (<= n *vcs-journal-max*)
      entries
      (into []
        (append (seq/filter (seq/subvec entries 0 (- n *vcs-journal-max*)) :running?)
          (seq/subvec entries (- n *vcs-journal-max*)))))))

(defn vcs-journal-add (m entry)
  "`[model' id]`: the model with `entry` appended under a fresh id, the log trimmed and the
buffer re-rendered if it is open."
  (let (id (or (:vcs-journal-seq m) 1))
    [(vcs-journal-sync (assoc m
                         :vcs-journal
                           (vcs-journal-trim (into (vcs-journal m) [(assoc entry :id id)]))
                         :vcs-journal-seq (inc id)))
      id]))

(defn vcs-journal-finish (m id r)
  "The model with running entry `id` completed by result `r` — unchanged when that entry has
already been trimmed away. Re-renders the buffer if it is open, so a `pull` you are watching
stops reading `run` the moment it lands. A finished command may have changed what the mode
line's summary says, so its stamp goes too (`vcscore/vcs-summary-fresh?`): the next idle beat asks."
  (vcs-journal-sync (assoc (dissoc m :vcs-summary-asked-key)
                      :vcs-journal
                        (into []
                          (map (vcs-journal m) (fn (e) (if (= (:id e) id) (vcs-entry-done e r) e)))))))

(defn vcs-journal-note ()
  "The hint appended to a failed command's message: how to see the whole output. Magit
appends the same thing, for the same reason — the echo area shows one line, and nobody
guesses that a key exists to show the rest. Nothing to point at when there is no UI."
  (if (ed-headless?) "" " ($ for the full output)"))

;; check-allow: `run` is an opaque caller-supplied thunk; the declaration is the contract.
(check-allow :trusted
  (sig vcs-run (model string seqable fn -> vector))
  (defn vcs-run (m program args run)
    "`[model' result]`: record `program args` as started, call `run` (which runs it and
returns `{:exit :stdout :stderr}`), complete the entry. The one seam a porcelain's
model-threaded commands go through, so the log cannot disagree with what ran: a command
cannot be run without being recorded."
    (let ([m1 id] (vcs-journal-add m (vcs-entry program args))
          r (run))
      [(vcs-journal-finish m1 id r) r])))

;; ---- rendering the buffer ------------------------------------------------------
;; A heading starts at column 0 and its exit code is right-aligned in three columns; every
;; line of output is indented FOUR, one more than the widest heading prefix can be. That is
;; what lets the `:fontify` — which sees text and nothing else — tell the two apart by the
;; line alone: an output line that happens to read `0 …` is never taken for a command that
;; exited 0. It also lines the output up under the command.

(def- vcs-output-indent "    ")

(def- vcs-global-flags
  ;; the porcelain's own arguments before the subcommand — git's `-C <root>` and
  ;; `-c core.quotePath=false`, on every call and typed by nobody: elided. Magit collapses
  ;; the same thing to `…` with the full text in a tooltip.
  #{"-C" "-c"})

(defn- vcs-command-text (e)
  "The command line as the user means it: the program and its arguments, less the
porcelain's own flags."
  (letrec (strip (fn (a)
                   (if (and (> (count a) 1) (contains? vcs-global-flags (first a)))
                     (strip (drop a 2))
                     a)))
    (vcs-redact (string/join (into [(:program e "git")] (strip (into [] (:args e)))) " "))))

(defn vcs-journal-heading (e)
  "One entry's heading: the exit code (Magit's right-aligned three columns, `run` while in
flight), the command, and how long it took."
  ;; `(or …)` and not a `get` default: a timed-out entry HAS an `:exit`, whose value is nil,
  ;; so a default would never be reached — and 0 is truthy in Brood, so an exit of 0 still
  ;; reads as itself
  (str (if (:running? e) "run " (str (string/pad-left (str (or (:exit e) "?")) 3) " "))
    (vcs-command-text e)
    (if (:running? e) "" (str "  (" (humanize/duration (:ms e 0)) ")"))))

(defn- vcs-journal-block (e)
  "An entry as text: its heading, then its output indented under it."
  (let (out (:output e ""))
    (if (= out "")
      (vcs-journal-heading e)
      (str (vcs-journal-heading e)
        "\n"
        (string/join (map (string/split out "\n") (fn (l) (str vcs-output-indent l))) "\n")))))

(defn vcs-journal-text (m)
  "The whole journal as the buffer shows it: one block per entry, oldest first."
  (let (entries (vcs-journal m))
    (if (empty? entries)
      "(no version control commands yet)"
      (string/join (map entries vcs-journal-block) "\n"))))

(defn vcs-process-fontify (src)
  "The *vcs-process* `:fontify`: a heading reads by its exit code — green for 0, red for
anything else, blue while it runs — and the output indented under it is plain."
  (modes/fontify-lines src
    (fn (line off)
      (cond
        (string/starts-with? line "run ") (vcs-whole-line off line vcs-face-hunk)
        (string/starts-with? line vcs-output-indent) '()
        (string/starts-with? line "  0 ") (vcs-whole-line off line vcs-face-add)
        else (vcs-whole-line off line vcs-face-del)))))

(defcommand cmd-vcs-process
  (m key)
  "Show what the version control actually ran (`$`, Magit's `magit-process-buffer`): every
git or mur command this editor issued, with its exit code, how long it took and its output
— the whole of it, where the echo area could only show the first line. `g` refreshes, `k`
clears, `q` quits."
  (vcs-show-report m "*vcs-process*" (vcs-journal-text m) :vcs-process {:action :pop}))

(defcommand cmd-vcs-process-clear
  (m key)
  "Clear the process log (k in *vcs-process*)."
  (let (m1 (dissoc m :vcs-journal))
    (vcs-show-report m1 "*vcs-process*" (vcs-journal-text m1) :vcs-process {:action :here})))

(defcommand cmd-vcs-quit
  (m key)
  "Bury the version-control buffer (q)."
  (cmd-kill-buffer m key))

;; ---- reporting -----------------------------------------------------------------

(defn vcs-show-report (m name text type &optional (opts {:action :here}))
  "Show `text` in a read-only report buffer `name` of `type` (a diff, a log, a command's
output), point at the top. `opts` routes through `ed-display-buffer` (default
`{:action :here}`, replacing the current pane; `{:action :pop}` opens it in another pane)."
  (ed-apply (pool/ed-display-buffer m name (if (= text "") "(empty)" text) type opts)
    (fn (b) (pool/ed-goto-line b 1))))

(defn- vcs-output-lines (s)
  "The non-blank lines of command output `s`, progress applied and credentials redacted."
  (seq/filter (map (string/split (vcs-printable (or s "")) "\n") string/trim)
    (fn (line) (not (= line "")))))

(defn vcs-summary (r)
  "`[line more?]`: the ONE line that says how command result `r` went, and whether there was
more output than that line. A success ends its report on stdout — `Already up to date.`, a
pull's `3 files changed, 10 insertions(+)` — so that is its LAST stdout line, else the last
of stderr (a push or fetch says everything there). A failure is its first `fatal:` /
`error:` line, else the first line it wrote. Never the whole output folded onto one row: a
pull's stderr is a line per ref it moved, and the echo area ran off the screen with them.

    (vcsproc/vcs-summary {:exit 0 :stdout \"Fast-forward\\n 2 files changed\\n\" :stderr \"From x\\n\"})   ;=> [\"2 files changed\" true]
    (vcsproc/vcs-summary {:exit 1 :stdout \"\" :stderr \"hint: a\\nfatal: no upstream\\n\"})   ;=> [\"fatal: no upstream\" true]
    (vcsproc/vcs-summary {:exit 0 :stdout \"\" :stderr \"\"})   ;=> [\"done\" false]"
  (let (out (vcs-output-lines (:stdout r))
        err (vcs-output-lines (:stderr r))
        all (append err out)
        line (if (= (:exit r) 0)
               (or (last out) (last err) "done")
               (or (seq/find all (fn (l) (regex/match? "^(fatal|error):" l)))
                 (first all)
                 (str "exit " (:exit r)))))
    [line (> (count all) 1)]))

(defn vcs-report-cmd (m verb r)
  "Echo how command `r` went (`verb` names it) in one line — [[vcs-summary]] — and, when it
said more than that, where the rest is: the process log, `$` (Magit's hint, for the same
reason — nobody guesses that a key shows the whole output). A failure always gets the hint."
  (let (failed? (not (= (:exit r) 0))
        [line more?] (vcs-summary r))
    (message m
      (str verb
        (if failed? " failed: " ": ")
        line
        (if (or failed? more?) (vcs-journal-note) "")))))

;; ---- off the loop: no VCS command ever blocks a keystroke -----------------------
;; A command that talks to a network (git's pull / push / fetch, mur's land / update /
;; sync) run on the loop freezes the whole editor — no repaint, no C-g — for as long as the
;; remote takes. So it goes through `vcs-launch`, which runs it in a `task` and folds the
;; result when it lands (`model/register-task-reply`). The editor stays live and C-g
;; cancels it. `ed-headless?` keeps the synchronous path for tests and `--headless`, where
;; there is no loop for a reply to land in.

(defn vcs-op-running (m)
  "The verb of the operation in flight (`\"pull\"`, `\"land\"`, …), or nil."
  (map/get-in m [:vcs-op :verb]))

(defn vcs-live (m)
  "The version-control work C-x C-c would kill (`model/register-exit-query`): a network
operation in flight (a push cut off half way), and a queued working-tree command (a stage
or commit killed mid-write leaves `index.lock` behind)."
  (into (if-let (verb (vcs-op-running m))
          [(str "vc: " verb " in " (path/basename (map/get-in m [:vcs-op :root] "")))]
          [])
    (if (:vcs-queue-proc m) ["vc: a working-tree command"] [])))

(register-exit-query :vcs 'vcsproc/vcs-live)

;; check-allow: `runner` and `then` are opaque caller-supplied functions; the declaration
;; is the contract (ADR-341's `:trusted`).
(check-allow :trusted
  (sig vcs-launch (model string string string seqable fn any &optional any -> model))
  (defn vcs-launch (m program verb root args runner then &optional (ordered? true))
    "Run `program args` in `root` OFF the loop — `(runner root args)` in a task, returning
`{:exit :stdout :stderr}` — and report when it lands, then run `then`, a
`(model result) -> model` (nil for nothing more).

Refuses a second operation while one is in flight or waiting: two lands at once is not a
thing anyone means, and the in-flight slot holds exactly one handle.

`ordered?` (the default) says the operation WRITES this checkout — a pull, a commit, mur's
update — so it takes its turn in the working-tree queue (`vcs-run-queued`): `k` then `F u`
must not race the discard for `index.lock`, so the pull starts when the commands before it
have landed and one pressed while it runs waits for it. One that only talks to the other
side (a push, a fetch) is not ordered: it starts at once and staging, reading and
committing go on beside it — a slow push must not hold `s` for two minutes. Headless runs
it synchronously, because there is no loop to hand the reply to."
    (let (op {:kind :launch
              :program program
              :verb verb
              :root root
              :args args
              :runner runner
              :then then
              :ordered? ordered?})
      (cond
        (vcs-op-running m) (message m (str (vcs-op-running m) " is already running"))
        (vcs-launch-waiting m) (message m (str (vcs-launch-waiting m) " is already waiting to run"))
        (ed-headless?)
          (let ([m0 r] (vcs-run m program args (fn () (runner root args)))
                m1 (vcs-report-cmd m0 verb r))
            (if (nil? then) m1 (vcs-pinned m1 root (fn (mm) (then mm r)))))
        ordered? (vcs-queue-next (vcs-enqueue (message m (str verb "…")) op))
        else (vcs-start-launch (message m (str verb "…")) op)))))

(defn- vcs-launch-waiting (m)
  "The verb of a network operation queued but not started, or nil."
  (:verb (seq/find (or (:vcs-queue m) []) (fn (op) (= (:kind op) :launch)))))

(defn- vcs-start-launch (m op)
  "Start the queued network operation `op`. The entry is journalled when the command STARTS,
so an in-flight pull reads as `run git pull` while it is still out there — which is the
question you have when one is slow. `vcs-apply-op` completes it; the entry times itself."
  (let (runner (:runner op)
        root (:root op)
        args (:args op)
        job (task (fn () (runner root args)) {:timeout *vcs-op-timeout-ms*})
        [logged id] (vcs-journal-add m (vcs-entry (:program op) args)))
    (assoc logged
      :vcs-op-proc job
      :vcs-op
        {:verb (:verb op)
         :root root
         :then (:then op)
         :entry id
         :ordered? (:ordered? op true)})))

(check-allow :trusted
  ;; a command that can outlast a frame — network, so a task
  (register-task-reply :vcs-op-proc 'vcsproc/vcs-apply-op nil "vc")
  (sig vcs-apply-op (model any -> model))
  (defn vcs-apply-op (m r)
    "Fold a finished `vcs-launch`: report the outcome and run its `then`. A nil `r` is the
task having errored or timed out — said plainly, rather than reported as a success with an
empty output, which is what a bare exit-code check would do with it."
    (let (op (:vcs-op m)
          verb (or (:verb op) "command")
          m1 (vcs-journal-finish (dissoc m :vcs-op :vcs-op-proc) (:entry op) r))
      (if (nil? r)
        (vcs-queue-next (message m1
                          (str verb
                            " failed: no result (timed out after "
                            *vcs-op-timeout-ms*
                            "ms)"
                            (vcs-journal-note))))
        (let (m2 (vcs-report-cmd m1 verb r))
          (if (nil? (:then op))
            (vcs-queue-next m2)
            (vcs-continue m2 (:root op) (:then op) r)))))))

;; ---- working-tree commands: off the loop, one at a time, in order ------------------
;; A stage, an unstage, a discard, a claim: a command that changes this checkout and stays
;; on this machine. Run inside the key it is a few milliseconds on a small repository and a
;; frozen window on a large one, or while another git holds the index lock.
;; `vcs-launch` is wrong for these — it refuses a second command while one runs, and `s s s`
;; down a list of files is three commands — so they QUEUE: each runs in a task once the one
;; before it has landed, which is also the order git's index lock would force anyway.
;;
;; A READ the next step depends on queues too (`vcs-gather`): the refs a prompt completes
;; over, whether anything is staged before `c c`, the branch a push goes from. Behind the
;; commands, because `s` then `c c` must find the stage done; and in a task, because `git
;; for-each-ref` on a monorepo or a network filesystem takes as long as any other git. What
;; a step's `then` queues runs NEXT, ahead of anything queued after it was asked for: `u`
;; reads whether the repo has a commit, then unstages, and an `s` pressed meanwhile must not
;; land in between.

(defn vcs-run-queued (m program root args runner then)
  "Queue the working-tree command `program args` in `root` — `(runner root args)`, returning
`{:exit :stdout :stderr}` — to run OFF the loop after any already queued, journalled like
every command, then fold `(then model result)`. Headless runs it at once."
  (if (ed-headless?)
    (let ([m0 r] (vcs-run m program args (fn () (runner root args))))
      (vcs-pinned m0 root (fn (mm) (then mm r))))
    (vcs-queue-next (vcs-enqueue m
                      {:kind :command
                       :program program
                       :root root
                       :args args
                       :runner runner
                       :then then}))))

(defn vcs-gather (m label root collect then)
  "Read `(collect root)` OFF the loop, queued behind any working-tree command still to run
(so it sees what they did), and fold `(then model answer)`. `collect` runs in a task: plain
data in and out, so it must close over no model, no rope and no `then`. `label` names the
read in a failure (`git branch failed or timed out`). Not journalled — the process log is
the commands that changed something. C-g cancels it, and every read queued behind it:
nothing is half-done by abandoning a read. Headless runs it at once."
  (if (ed-headless?)
    (vcs-pinned m root (fn (mm) (then mm (collect root))))
    (vcs-queue-next (vcs-enqueue m
                      {:kind :read :label label :root root :collect collect :then then}))))

(defn vcs-gather-holding (m label root collect then)
  "[[vcs-gather]] for a read whose answer is what the reader is about to work in — the
message an amend opens on, the branch a rename renames: until it lands the keyboard is HELD
(a read-char that says what it waits for and keeps it), so keys typed meanwhile are not
run as commands in the buffer underneath — `c a` then typing a message must not stage,
unstage and discard in *git-status*. C-g lets go and cancels the read.

The hold is THIS read's — tagged with a token the read carries — and only its landing,
failing or being dropped lets go: another read finishing first (a `r u` asked before the
`c a`) must not hand the keyboard back while this one still waits behind it."
  (if (ed-headless?)
    (vcs-gather m label root collect then)
    (let (token (inc (or (:vcs-hold-seq m) 0)))
      (vcs-queue-next (vcs-enqueue (assoc (vcs-hold m label token) :vcs-hold-seq token)
                        {:kind :read
                         :label label
                         :root root
                         :collect collect
                         :then then
                         :hold token})))))

(defn- vcs-hold (m label token)
  "`m` holding the keyboard while `label` is read, for the read tagged `token`."
  ;; no `:prompt`: a hold is a wait, not a question (`model/ed-standing-question`) — a message
  ;; meanwhile, C-g's own included, is said in its place
  (assoc (message m (str label "… (C-g cancels)"))
    :read-char
      {:then (fn (mm _key) (vcs-hold mm label token))
       :on-cancel 'vcsproc/vcs-hold-cancel
       :vcs-hold token}))

(defn- vcs-let-go (m tokens)
  "`m` with the keyboard let go when it is held for one of the reads tagged `tokens` (a
read that landed, failed or was dropped) — never for another read's hold."
  (let (held (map/get-in m [:read-char :vcs-hold]))
    (if (and (not (nil? held)) (includes? tokens held)) (dissoc m :read-char) m)))

(defn vcs-hold-cancel (m)
  "C-g while a read holds the keyboard: let go, cancel the reads (the held one with them)
and say which, as C-g's own clean-up does ([[vcs-gather-quit]])."
  (let (handle (:vcs-gather-proc m))
    (do
      (when handle (task/cancel handle))
      (vcs-gather-quit (dissoc m :read-char :vcs-gather-proc) true))))

(defn- vcs-enqueue (m op)
  "`m` with `op` at the back of the working-tree queue."
  (assoc m :vcs-queue (conj (or (:vcs-queue m) []) op)))

(defn vcs-queue-busy? (m)
  "Whether the working-tree queue's turn is taken: a queued command or read running, or a
network operation that writes this checkout ([[vcs-launch]]'s `ordered?`). A push or fetch
in flight takes no turn — staging and reading go on beside it."
  (or (not (nil? (:vcs-queue-proc m)))
    (not (nil? (:vcs-gather-proc m)))
    (and (not (nil? (:vcs-op-proc m))) (map/get-in m [:vcs-op :ordered?] true))))

;; ---- the repo a follow-up runs in ------------------------------------------------
;; A follow-up — what a read's answer, a command's result, a prompt's answer or a y/n does
;; next — runs later than its key, off the loop, and by then the reader may be in a buffer
;; of another repo: `U`, then a switch to a file in repo B before the read landed, must not
;; unstage everything in B. So each follow-up runs with the repo it was asked in
;; PINNED (`:vcs-pinned-root`), and a porcelain's root resolution reads the pin first
;; (`gitcore/git-resolve-root`, `murcore/mur-resolve-root`).

(defn vcs-pinned-root (m)
  "The repo the follow-up running now was asked in, or nil outside one."
  (:vcs-pinned-root m))

(defn vcs-pinned (m root then)
  "`(then model)` with `root` pinned as the repo it runs in — nothing pinned for a nil
`root` — and the pin as it was restored after, so a follow-up's own follow-ups carry theirs."
  (if (nil? root)
    (then m)
    (let (previous (:vcs-pinned-root m)
          result (then (assoc m :vcs-pinned-root root)))
      (if (nil? previous)
        (dissoc result :vcs-pinned-root)
        (assoc result :vcs-pinned-root previous)))))

(defn- vcs-queue-next (m)
  ;; start the queue's head when nothing is running; the task closes over the runner (or the
  ;; collector), the root and the arguments alone, never the `then` (which may hold anything)
  (let (queue (or (:vcs-queue m) []))
    (if (or (vcs-queue-busy? m)
          (empty? queue)
          ;; an ordered operation at the head waits for the one slot a push may still hold
          (and (= (:kind (first queue)) :launch) (not (nil? (:vcs-op-proc m)))))
      m
      (let (op (first queue)
            root (:root op)
            waiting (assoc m :vcs-queue (vec (rest queue))))
        (case (:kind op)
          :read
            (let (collect (:collect op))
              (assoc waiting
                :vcs-gather-proc (task (fn () (collect root)) {:timeout *vcs-op-timeout-ms*})
                :vcs-gather-op {:then (:then op) :label (:label op) :root root :hold (:hold op)}))
          :launch (vcs-start-launch waiting op)
          (let (runner (:runner op)
                args (:args op)
                job (task (fn () (runner root args)) {:timeout *vcs-op-timeout-ms*})
                [logged id] (vcs-journal-add waiting (vcs-entry (:program op) args)))
            (assoc logged
              :vcs-queue-proc job
              :vcs-queue-op {:then (:then op) :entry id :root root})))))))

(defn- vcs-continue (m root then answer)
  "Fold a queued step's `answer` through its `then` — in the repo `root` it was asked in
([[vcs-pinned]]), whatever buffer the reader is in now — with what that queues put AHEAD of
what was already waiting, then start the next. A `then` that raises is said in the echo area
and the queue carries on — a fold that threw would otherwise leave its successors queued for
good, since the loop keeps the model from before a failed update."
  (let (waiting (or (:vcs-queue m) [])
        cleared (assoc m :vcs-queue [])
        m1 (check-allow :discarded-catch
             (try
               (vcs-pinned cleared root (fn (mm) (then mm answer)))
               (catch e
                 (do
                   (log/error (str "vc: a queued step's fold failed: " (error-message e)))
                   (message cleared (str "version control: " (error-message e)))))))
        ahead (or (:vcs-queue m1) []))
    (vcs-queue-next (assoc m1 :vcs-queue (into ahead waiting)))))

(check-allow :trusted
  ;; a working-tree command, queued; quick, so no activity label, and no C-g: half a stage is
  ;; a lock left behind
  (register-task-reply :vcs-queue-proc 'vcsproc/vcs-apply-queued nil nil)
  (sig vcs-apply-queued (model any -> model))
  (defn vcs-apply-queued (m r)
    "Fold a finished queued command through its `then`, then start the next. A nil `r` is the
task having errored or timed out, said plainly."
    (let (op (:vcs-queue-op m)
          m1 (vcs-journal-finish (dissoc m :vcs-queue-op :vcs-queue-proc) (:entry op) r))
      (if (nil? r)
        (vcs-queue-next (message m1
                          (str "failed: no result (timed out after "
                            *vcs-op-timeout-ms*
                            "ms)"
                            (vcs-journal-note))))
        (vcs-continue m1 (:root op) (:then op) r)))))

(check-allow :trusted
  ;; a read a command waits on (a prompt's candidates, the branch a push goes from); the
  ;; whole event, because nil is an answer a read can give (no upstream) and a failure is not
  (register-task-reply :vcs-gather-proc
    'vcsproc/vcs-apply-gather
    nil
    "vc"
    {:folds-event? true :cancel-on-quit? true :on-quit 'vcsproc/vcs-gather-quit})
  (sig vcs-apply-gather (model any -> model))
  (defn vcs-apply-gather (m event)
    "Fold a finished `vcs-gather`: its answer through its `then`, or — when the task errored
or timed out — say so and carry on with the queue."
    (let (op (:vcs-gather-op m)
          ;; the keyboard is let go whichever way the read ended — if it was THIS read's hold
          m1 (vcs-let-go (dissoc m :vcs-gather-op :vcs-gather-proc) [(:hold op)]))
      (if (= (first event) :task-done)
        (vcs-continue m1 (:root op) (:then op) (nth event 2))
        (vcs-queue-next (message m1
                          (str (:label op "a read")
                            " failed or timed out"
                            (if (= (first event) :task-error) (str ": " (nth event 2 "")) ""))))))))

(defn vcs-gather-quit (m &optional (said-here? false))
  "C-g's clean-up for the reads (`:on-quit`; the one in flight already cancelled): forget it
and every read queued behind it — what they were going to ask is what C-g abandons — and
carry on with the working-tree commands still queued, which the reader did ask for. What was
dropped is SAID: a quiet C-g left the command that was waiting on the read (a checkout, a
commit) simply never happening. Left as a note C-g's own message carries
(`model/ed-quit-note`), or said here when C-g came to the hold rather than to the command
loop (`said-here?`)."
  (let (in-flight (map/get-in m [:vcs-gather-op :label])
        dropped (seq/filter (or (:vcs-queue m) []) (fn (op) (= (:kind op) :read)))
        queued (map dropped :label)
        labels (if (nil? in-flight) queued (cons in-flight queued))
        ;; the holds of every read dropped here: a hold whose read is gone must let go
        holds (cons (map/get-in m [:vcs-gather-op :hold]) (map dropped :hold))
        commands (into [] (seq/reject (or (:vcs-queue m) []) (fn (op) (= (:kind op) :read))))
        note (str "cancelled reading "
               (string/join (seq/distinct labels) ", ")
               " — what was waiting on it did not run")
        m1 (vcs-let-go (assoc (dissoc m :vcs-gather-op) :vcs-queue commands) holds))
    (vcs-queue-next (cond
                      (empty? labels) m1
                      said-here? (message m1 note)
                      else (ed-quit-note m1 note)))))

;; ---- the buffer type -------------------------------------------------------------
;; *vcs-process* — its own layer rather than a shared report keymap, because `k` clears the
;; log here.
(def vcs-process-keymap
  (-> {}
    (keymap-bind ["q"] 'vcsproc/cmd-vcs-quit)
    (keymap-bind ["g"] 'vcsproc/cmd-vcs-process)
    (keymap-bind ["k"] 'vcsproc/cmd-vcs-process-clear)
    (keymap-bind ["$"] 'vcsproc/cmd-vcs-process)
    (keymap-bind [:ctrl-n] 'motion/cmd-next-line)
    (keymap-bind [:ctrl-p] 'motion/cmd-previous-line)
    (keymap-bind [:down] 'motion/cmd-next-line)
    (keymap-bind [:up] 'motion/cmd-previous-line)))

(def vcs-process-mode-layer
  {:name 'vcs-process
   :doc "What the version control actually ran: every command, its exit code, how long it took and its output."
   :keymap vcsproc/vcs-process-keymap
   ;; NOT "vcs-process": a layer's `:commands` are subtracted from the GLOBAL M-x set
   ;; (`model/ed-all-layer-commands`), and `M-x vcs-process` has to work from anywhere —
   ;; the buffer it opens is exactly where you are not
   :commands '("vcs-process-clear" "vcs-quit")
   :fontify 'vcsproc/vcs-process-fontify})

(register-type-layers :vcs-process
  (list 'vcsproc/vcs-process-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- a status buffer, shown before its collection lands -----------------------------
;; *git-status* and *mur-status* collect in a task and render when it answers; meanwhile the
;; buffer is already there, so the reader's keys go to it.
;;
;; ONE STATUS BUFFER PER REPO, as Magit keeps one per repository: C-x g in project B opens B's
;; beside A's rather than repainting A's. A status buffer is found by the repo it SHOWS (its
;; type and its `:section-ctx :root`, stamped on the `Loading…` placeholder too), never by its
;; name, which is only what the reader sees: `*git-status: bedit*`, the parent directory added
;; when another repo of that name has one (`*git-status: bedit<src>*`), else the whole path.
;;
;; A repo arrives spelled however its caller had it — the walk up from a file's directory, a
;; path typed at `git-init`'s prompt (`~/src/foo/`), a worktree's — so it is CLEANED where a
;; status is shown (`vcs-clean-root`) and COMPARED by its real path (`vcs-same-root?`), never
;; as a string: one repo reached two ways is one status buffer.

(defn vcs-clean-root (root)
  "`root` absolute, with no trailing slash and no `.` / `..` — what a status buffer stamps
and names itself after. Symlinks are left as they are, so the path shown is the one walked.

    (vcsproc/vcs-clean-root \"/src/foo/\")   ;=> \"/src/foo\"
    (vcsproc/vcs-clean-root \"/src/foo/bar/..\")   ;=> \"/src/foo\""
  (when root (path/normalize (path/absolute root))))

(defn vcs-root-key (root)
  "The identity of repo `root`: its real path (`os/canonicalize` — symlinks, `..` and a trailing
slash resolved), else `root` itself."
  (or (os/canonicalize root) root))

(defn vcs-same-root? (a b)
  "Whether `a` and `b` name the same repo, however each is spelled ([[vcs-root-key]])."
  (and (not (nil? a)) (not (nil? b)) (or (= a b) (= (vcs-root-key a) (vcs-root-key b)))))

(sig vcs-status-index (model keyword any -> (or nil int)))
(defn vcs-status-index (m type root)
  "The pool index of the status buffer of `type` (`:git-status`, `:mur-status`) showing repo
`root` ([[vcs-same-root?]]), or nil when it has none open."
  (when root
    (let (key (vcs-root-key root)
          i (seq/index-where (:buffers m)
              (fn (b)
                (and (= (:type b) type)
                  (let (shown (map/get-in b [:section-ctx :root]))
                    (and (not (nil? shown)) (or (= shown root) (= (vcs-root-key shown) key))))))))
      (if (< i 0) nil i))))

(sig vcs-status-indices (model keyword -> seqable))
(defn vcs-status-indices (m type)
  "The pool indices of every status buffer of `type`, whichever repo each shows."
  (seq/filter (range (count (:buffers m))) (fn (i) (= (:type (nth (:buffers m) i)) type))))

(defn vcs-status-name (m label type root)
  "The name of repo `root`'s status buffer: the one it has, else the first of
`*LABEL: repo*`, `*LABEL: repo<parent>*` and `*LABEL: ~/the/path*` no buffer has taken."
  (let (i (vcs-status-index m type root))
    (if i
      (editor/buffer/buffer-name (ed-buf-at m i))
      (let (base (path/basename root)
            parent (path/basename (path/dirname root))
            names [(str "*" label ": " base "*")
                    (str "*" label ": " base "<" parent ">*")
                    (str "*" label ": " (path/abbreviate root) "*")])
        (or (seq/find names (fn (nm) (nil? (ed-buffer-index-by-name m nm)))) (last names))))))

(defn vcs-status-focus (m type root)
  "`:here` when the reader is looking at repo `root`'s status buffer (or it is not open yet,
so this is the first show), else `:none` — a refresh the background asked for lands quietly."
  (let (i (vcs-status-index m type root))
    (if (or (nil? i) (= i (ed-current-index m))) :here :none)))

(defn vcs-status-show-now (m label type root action)
  "Show repo `root`'s status buffer (of buffer `type`, named after `label` —
[[vcs-status-name]]) at once, for a collection launched off the loop: `Loading…` the first
time, else what it holds until the refresh lands — a flicker back to `Loading…` on every `g`
is worse than a stale half-second. The reader asked for it, so it is shown and selected NOW:
selected only when the collection came back, their keys went to the buffer they came from
for seconds (`C-x g l l` typed `ll` there). `action` is `:pop`, `:here`, or `:none` for a
refresh behind the reader, which leaves it where it is.

The placeholder carries `root` as its `:section-ctx` already, so it is found as this repo's
status, and a key pressed in it runs in this repo, before the collection lands."
  (let (existing (vcs-status-index m type root))
    (cond
      (nil? existing)
        (let (name (vcs-status-name m label type root))
          (ed-update-named (pool/ed-display-buffer m
                             name
                             "Loading…\n"
                             type
                             {:action (if (= action :none) :display action)})
            name
            (fn (b) (assoc b :section-ctx {:root root}))))
      (= action :pop) (pool/ed-pop-to-index m existing)
      (= action :here) (pool/ed-select m existing)
      else m)))

;; One collection in flight per porcelain (its task slot); a status of ANOTHER repo asked for
;; meanwhile waits its turn rather than cancelling it — that repo's buffer would otherwise sit
;; on `Loading…` — and the landing starts the next. A newer ask of the SAME repo replaces the
;; one waiting: the waiting are keyed by the repo's identity (`vcs-root-key`), each request
;; keeping the root as it was asked.

(defn vcs-status-defer (m waiting-key root request)
  "`m` with a status of `root` (`request`: what the launch needs again) waiting under
`waiting-key` for the collection in flight to land."
  (assoc m
    waiting-key (assoc (get m waiting-key {}) (vcs-root-key root) (assoc request :root root))))

;; check-allow: `launch` is a caller-supplied `(model root request) -> model`; the declaration
;; is the contract.
(check-allow :trusted
  (sig vcs-status-next (model keyword fn -> model))
  (defn vcs-status-next (m waiting-key launch)
    "Start the next status waiting under `waiting-key` (`(launch model root request)`), if any."
    (let (waiting (get m waiting-key {}))
      (if (empty? waiting)
        m
        (let ([key request] (first waiting))
          (launch (assoc m waiting-key (dissoc waiting key)) (:root request) request))))))

(defn vcs-status-landing (action)
  "Where a status collection launched with `action` lands: where the buffer now is (`:here`)
— it was placed when the collection started, never a second time — or quietly (`:none`)."
  (if (= action :none) :none :here))

;; ---- a view's job: one task per slot, the newest request wins -----------------------
;; A view that fetches off the loop (gitview's, the time machine's) keeps one task per SLOT —
;; a model key holding the task's handle — and what each was asked for in a map of pending
;; requests by slot, under its own `pending-key`. A new request on a busy slot cancels the one
;; in flight. Headless, a job runs inline (its handle `:inline`) and folds at once.

(defn vcs-job-pending (m pending-key slot)
  "What the job on `slot` was asked for, or nil."
  (get (get m pending-key {}) slot))

(defn vcs-job-forget (m pending-key slot)
  "`m` with `slot` free: no handle, no pending request."
  (assoc (dissoc m slot) pending-key (dissoc (get m pending-key {}) slot)))

(defn vcs-job-slot (m slots handle)
  "Which of `slots` holds `handle` — the slot an answer is for — or nil once superseded."
  (seq/find slots (fn (slot) (and (not (nil? (get m slot))) (= (get m slot) handle)))))

;; check-allow: `same?` and `release` are caller-supplied functions; the declaration is the
;; contract.
(check-allow :trusted
  (sig vcs-job-supersede (model keyword keyword fn fn -> model))
  (defn vcs-job-supersede (m pending-key slot same? release)
    "Free `slot` for a new request: the job in flight there is cancelled, then forgotten when
`(same? its-pending)` (the new request takes its buffer over), else handed to `(release
model slot)`, which says so in the buffer it was for and frees the slot."
    (let (handle (get m slot))
      (if (nil? handle)
        m
        (do
          (when (not (= handle :inline)) (task/cancel handle))
          (if (same? (vcs-job-pending m pending-key slot))
            (vcs-job-forget m pending-key slot)
            (release m slot)))))))

(defn vcs-job-handle (build timeout-ms)
  "Start `build` (a `() -> answer`) as a task, or `:inline` when headless — run by
[[vcs-job-register]] then."
  (if (ed-headless?) :inline (task/task build {:timeout timeout-ms})))

;; check-allow: `build` and `apply` are caller-supplied functions; the declaration is the
;; contract.
(check-allow :trusted
  (sig vcs-job-register (model keyword keyword any map fn fn -> model))
  (defn vcs-job-register (m pending-key slot handle pending build apply)
    "`m` with the job `handle` on `slot`, asked for `pending`. An `:inline` handle runs
`build` now and folds its answer through `(apply model event)` as the task reply would."
    (let (launched (assoc m slot handle pending-key (assoc (get m pending-key {}) slot pending)))
      (if (= handle :inline) (apply launched [:task-done handle (build)]) launched))))

;; check-allow: `release` is a caller-supplied function; the declaration is the contract.
(check-allow :trusted
  (sig vcs-job-quit (model keyword fn -> model))
  (defn vcs-job-quit (m pending-key release)
    "C-g's clean-up (a task reply's `:on-quit`): every job whose task it just cancelled — its
slot emptied, its request still pending — goes through `(release model slot)`."
    (fold (get m pending-key {})
      m
      (fn (acc entry)
        (let ([slot _] entry)
          (if (nil? (get acc slot)) (release acc slot) acc))))))

;; ---- asking before something that cannot be undone ---------------------------

(defn vcs-confirm (m prompt then)
  "Ask `prompt` (y/n) and run `then` on yes. The one-key reader every irreversible VC command
uses (git's discard and reset, mur's drop and restore) — and the prompt NAMES what is
about to happen (`Reset --hard to abc123, losing all uncommitted changes?`) rather than
asking whether you are sure. \"Are you sure?\" is answered yes by reflex; a sentence that
says what will be lost is not.

Asked inside a follow-up, the answer runs in the repo that follow-up was pinned to
([[vcs-pinned]]) — and the question names that repo when the reader has moved to a buffer
in another, so a `reset --hard` asked of repo A is never answered as though about B."
  (let (root (vcs-pinned-root m)
        here (vcs/root (pool/ed-default-dir m))
        elsewhere? (and root here (not (= root here))))
    (ed-confirm m
      (str (if elsewhere? (str "[" (path/basename root) "] ") "") prompt " (y/n) ")
      (fn (mm) (vcs-pinned mm root then))
      "cancelled")))
