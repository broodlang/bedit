(defmodule recover
  "Getting unsaved text back from the `#file#` auto-save sidecars (`autosave`): Emacs's
`recover-this-file` and `recover-session`. A sidecar is written every round while a file
buffer has unsaved changes and removed by a real save, so one that outlives its session —
the editor quit without saving, or died — holds the text that never reached the file.
Visiting such a file says so (the visit step at the end of this file); these commands put
the text back."
  (:use editor/buffer) ; buffer-file / buffer-length / buffer-point / replace-region / goto-char
  (:use model) ; message / ed-current-buf / ed-edit / ed-confirm
  (:use pool) ; ed-find-file / ed-path-list-prompt / ed-default-dir
  (:use sidecar) ; ed-auto-save-path / ed-auto-save-newer? / ed-private-auto-save-dir
  (:use projects) ; recent-files — where recover-session looks
  (:use interactive)) ; defcommand

(defn- sidecar-written (sidecar)
  "When `sidecar` was written, as `YYYY-MM-DD HH:MM` (UTC), or `?` when it cannot be read."
  (let (mtime (file/mtime sidecar))
    (if (nil? mtime) "?" (datetime/format (datetime/epoch-ms-> mtime) "%Y-%m-%d %H:%M"))))

(sig ed-recover-from-sidecar (model string -> model))
(defn ed-recover-from-sidecar (m path)
  "The current buffer's text replaced by the auto-save sidecar of its file `path` — one undoable edit,
so C-/ goes back to the text from the file, and the buffer is modified until a save writes
the recovered text (which also removes the sidecar). Point stays where it was, clamped. A
buffer edited as root reads its private sidecar (`sidecar/ed-auto-save-path`)."
  (let (text (file/slurp (ed-auto-save-path path (buffer-sudo-user (ed-current-buf m)))))
    (message (ed-edit m
               (fn (buffer)
                 (let (point (buffer-point buffer))
                   (goto-char (replace-region buffer 0 (buffer-length buffer) text)
                     (math/min point (count text))))))
      (str "recovered " (path/basename path) " from its auto-save — C-x C-s keeps it, C-/ undoes"))))

(sig ed-offer-recovery (model string -> model))
(defn- ed-offer-recovery (m path)
  "Ask whether to recover file `path` from its sidecar, saying when that was written and
whether it is older than the file; or say there is none. The current buffer's — the
private sidecar when it is edited as root."
  (let (user (buffer-sudo-user (ed-current-buf m))
        sidecar (ed-auto-save-path path user))
    (if (not (file/exists? sidecar))
      (message m (str "no auto-save data for " (path/basename path)))
      (ed-confirm m
        (str "Recover "
          (path/basename path)
          " from its auto-save of "
          (sidecar-written sidecar)
          (if (ed-auto-save-newer? path user) "" " — OLDER than the file")
          "? (y/n)")
        (fn (mm) (ed-recover-from-sidecar mm path))))))

(defcommand cmd-recover-this-file
  (m key)
  "Put back the text of the current file's auto-save sidecar (`#file#`), after a y/n
confirm — Emacs `recover-this-file`. What a visit means when it says the file \"has unsaved
auto-save data\": the editor that wrote the sidecar ended without saving. The recovered text
is one undoable edit over the file's; save to keep it. A sidecar OLDER than the file is
offered too, and the question says so."
  (let (path (buffer-file (ed-current-buf m)))
    (if (nil? path) (message m "not visiting a file") (ed-offer-recovery m path))))

(defn ed-recoverable-files (m)
  "The files with auto-save data newer than themselves ([[ed-auto-save-newer?]]) among the
open file buffers and the recently opened files — where the files a session that ended
without saving was editing are, since a sidecar sits beside its file and nothing else lists
them — and the files edited AS ROOT whose private sidecars are newer ([[ed-private-recoverable]]),
named by their TRAMP path (`/sudo::/etc/hosts`), so visiting one opens it as root again."
  (append (seq/filter (seq/distinct (append (seq/keep (seq/reject (:buffers m)
                                                        (fn (buffer)
                                                          (or (:sudo buffer) (:ssh buffer))))
                                              buffer-file)
                                      (recent-files)))
            ed-auto-save-newer?)
    (ed-private-recoverable (ed-private-auto-save-dir))))

(defn ed-private-recoverable (dir)
  "The TRAMP path (`/sudo::/etc/hosts`, `/sudo:www@:/srv/a`) of every file whose private
sidecar in `dir` (see `sidecar/private-sidecar-name`; a hashed one read through its
`NAME.spec`) is newer than the file — the files a session edited as another user and did
not save. `dir` missing is none.

    (recover/ed-private-recoverable \"/nowhere/at/all\")   ;=> []"
  (if (not (file/dir? dir))
    []
    (into []
      ;; a sidecar still under its old name (`#%2Fetc%2Fhosts#`) is renamed first, so it is listed
      (seq/keep (do (ed-migrate-private-sidecars dir) (file/ls dir))
        (fn (name)
          (let (spec (private-sidecar-spec name dir)
                parts (sidecar-spec-parts spec))
            (cond
              parts (when (ed-auto-save-newer? (first parts) (second parts)) spec)
              ;; a file on another machine: its sidecar is there only while its text is unsaved
              ;; (a save removes it), and the host is not asked for its time to compare
              (sshpath/remote? spec) spec
              else nil)))))))

(defcommand cmd-recover-session
  (m key)
  "Choose a file to recover from among those with unsaved auto-save data — the open files and
the recent ones whose sidecar is newer than the file ([[ed-recoverable-files]]) — then visit
it and recover it as `recover-this-file` does. Emacs `recover-session`, which lists the
files the crashed session was visiting."
  (let (files (ed-recoverable-files m))
    (if (empty? files)
      (message m "no files have unsaved auto-save data")
      (assoc m
        :minibuffer
          (ed-path-list-prompt (str "Recover file (" (count files) " with auto-save data): ")
            files
            (fn (mm path)
              (cond
                (= path "") (message mm "canceled")
                ;; a file edited as root opens as root again — after its password, when sudo
                ;; asks for one — and is recovered from its private sidecar then
                (string/starts-with? path "/sudo:")
                  (sudoedit/ed-sudo-find-file mm
                    path
                    (fn (opened) (cmd-recover-this-file opened nil)))
                ;; a file on another machine opens over ssh, and is recovered once it has
                (sshpath/remote? path)
                  (sshedit/ed-ssh-find-file mm
                    path
                    (fn (opened) (cmd-recover-this-file opened nil)))
                else (cmd-recover-this-file (ed-find-file mm path) nil)))
            (ed-default-dir m))))))

(defn ed-recovery-visited (m buffer)
  "The visit step: a sidecar newer than the file is unsaved text from a session that ended
without saving, said instead of the open notice, so it is what you read."
  [buffer (ed-recovery-note (buffer-file buffer))])

(register-visit-step :recovery {:order 90 :run 'recover/ed-recovery-visited :instead true})
