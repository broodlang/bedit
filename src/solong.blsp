(defmodule solong
  "so-long (Emacs's so-long-mode): a file opened with a line longer than `:so-long-threshold`
characters — a minified bundle, a JSON dump, a log with a megabyte line — is put in a cheap
state the moment it opens, and the echo area says so.

The cheap state is two things, and both are things the editor already has:

- its long lines TRUNCATE (`:long-lines :truncate` on the buffer — the same toggle as M-x
  toggle-truncate-lines, so `scroll/ed-long-lines` and the row table need nothing new): one row
  per line, cut at the pane's edge, instead of thousands of wrapped rows or a pane scrolled a
  megabyte sideways.
- the per-line services that read the line around point or the whole visible band —
  show-paren's bracket match, rainbow delimiters, visible whitespace, the spell check, the
  eldoc hint — skip the buffer (`so-long?`, which each asks).

M-x so-long-mode toggles it: off puts back the long-lines policy the buffer had (its mode's,
or its own toggle), on forces it for a buffer that opened under the threshold."
  (:use editor/buffer) ; buffer-rope
  (:use model) ; ed-current-buf / ed-set-buf / message
  (:use interactive)) ; defcommand — M-x so-long-mode

(def *default-threshold* 10000) ; Emacs's `so-long-threshold`

(sig line-length (any int int -> int))
(defn- line-length (rope line lines)
  ;; line `line`'s chars, its newline not counted
  (let (start (text/line->char rope line))
    (if (< (inc line) lines)
      (- (text/line->char rope (inc line)) start 1)
      (- (count rope) start))))

(sig long-line-from (any int int int int -> (or nil vector)))
(defn- long-line-from (rope threshold at length lines)
  ;; tail-recursive: the first line holding a char at `at` or a later sample that is over
  ;; `threshold`, as `[line length]`
  (if (>= at length)
    nil
    (let (line (text/char->line rope at)
          chars (line-length rope line lines))
      (if (> chars threshold)
        [line chars]
        ;; on past this line, and at least a threshold on: a line longer than the threshold
        ;; that starts at or after `at` holds one of the samples from here
        (long-line-from rope
          threshold
          (math/max (+ at threshold)
            (if (< (inc line) lines) (text/line->char rope (inc line)) length))
          length
          lines)))))

(sig long-line (any any -> (or nil vector)))
(defn long-line (rope threshold)
  "The first line of `rope` longer than `threshold` chars, as `[line length]`, or nil.

Found by looking only at the line under every `threshold`-th char: a line that long holds
one of them, so a ten-megabyte file at the default threshold is a thousand lookups however
many lines it has, and a short file is none — where Emacs's so-long reads only the first few
lines.

    (solong/long-line (text/string-> \"short\\n0123456789\\nend\") 5)   ;=> [1 10]
    (solong/long-line (text/string-> \"short\\nlines\") 5)   ;=> nil"
  (if (or (not (int? threshold)) (<= threshold 0))
    nil
    (long-line-from rope threshold 0 (count rope) (text/line-count rope))))

(sig so-long? (buffer -> bool))
(defn so-long? (buf)
  "Whether `buf` is in so-long's cheap state — what a per-line service asks before it reads
the line around point or the visible band."
  (map? (get buf :so-long)))

(sig so-long-on (buffer (or nil vector) -> buffer))
(defn so-long-on (buf found)
  "`buf` in so-long's cheap state: its long lines truncated, and what it had before (its own
`:long-lines`, the long line `found`) kept under `:so-long` for `so-long-off`."
  (assoc buf
    :so-long
      {:line (when found (first found))
       :length (when found (second found))
       :long-lines (get buf :long-lines)}
    :line-services-off true
    :long-lines :truncate))

(sig so-long-carried (buffer any -> buffer))
(defn so-long-carried (buf state)
  "`buf` in so-long's cheap state `state` (another copy's `:so-long`, carried over), or as
it was when `state` is nil — a frame's copy of a buffer another frame opened."
  (if (map? state) (assoc buf :so-long state :long-lines :truncate :line-services-off true) buf))

(sig so-long-off (buffer -> buffer))
(defn so-long-off (buf)
  "`buf` out of so-long's cheap state, its long-lines policy back to what it was."
  (let (was (get (get buf :so-long) :long-lines)
        restored (if (nil? was) (dissoc buf :long-lines) (assoc buf :long-lines was)))
    (dissoc restored :so-long :line-services-off)))

(defn- note (found)
  ;; what the echo area says when a visit turns it on
  (str "so-long: line "
    (inc (first found))
    " is "
    (second found)
    " characters — long lines truncated, per-line services off (M-x so-long-mode to undo)"))

(defn so-long-note (buf)
  "What the echo area says about `buf` being in so-long's cheap state because of a long line
— which line, how long — or nil when it is not, or was put there by hand. For a path that
checks the buffer before there is a model to say it in (the launch file, `main`)."
  (let (state (get buf :so-long))
    (when (and (map? state) (int? (:line state)) (int? (:length state)))
      (note [(:line state) (:length state)]))))

(sig model-threshold (map -> any))
(defn model-threshold (m)
  "The `:so-long-threshold` model `m` was seeded with (`config/apply-to-model`), else the
default — a model built without the init file (a test, a batch run) still checks."
  (if (contains? m :so-long-threshold) (:so-long-threshold m) *default-threshold*))

(sig so-long-visit (buffer any -> (tuple buffer (or nil string))))
(defn so-long-visit (buf threshold)
  "`[buffer note]` for a buffer just made from a file: in so-long's cheap state, with the
note saying why, when a line of it is longer than `threshold` (`:so-long-threshold`; false
or 0 turns the check off); else `buf` as it was and a nil note. A buffer already in the
state (one another frame shared) keeps it and says nothing.

THE one check every path that brings a file into the pool makes — find-file
(`pool/ed-open-text`), a jump to a location (`pool/ed-ensure-file-buffer`: next-error,
goto-definition, C-x 4 f), the launch file (`main`), a served or shared file (`remote`,
`collab-commands`), and a frame adopting another frame's buffer (`frames`, which carries
the state over from the registry's meta rather than finding it again: the slot is empty
until the seed push fills it)."
  (let (found (when (and (int? threshold) (not (so-long? buf)))
                (long-line (buffer-rope buf) threshold)))
    (if (nil? found) [buf nil] [(so-long-on buf found) (note found)])))

(defn so-long-checked (buf)
  "`buf` through `so-long-visit` at the default threshold, the note dropped — for a path
with no model or init file to read either from (a served or shared session's file)."
  (first (so-long-visit buf *default-threshold*)))

(sig ed-so-long-off (model -> model))
(defn ed-so-long-off (m)
  "`m` with the current buffer out of so-long's cheap state."
  (ed-set-buf m (so-long-off (ed-current-buf m))))

(defcommand cmd-so-long-mode
  (m key)
  "Toggle so-long-mode on the current buffer (M-x so-long-mode, Emacs's name). On — what
opening a file with a line over `:so-long-threshold` does by itself — its long lines
truncate and the per-line services that read the line (show-paren, rainbow delimiters,
whitespace, the spell check, eldoc) leave it alone; off puts back the long-lines policy it
had."
  (let (buf (ed-current-buf m))
    (if (so-long? buf)
      (message (ed-so-long-off m)
        (str "so-long-mode off: "
          (scroll/ed-long-lines-says (scroll/ed-long-lines (so-long-off buf)))))
      (message (scroll/ed-set-hscroll (ed-set-buf m (so-long-on buf nil)) 0)
        "so-long-mode on: long lines truncated, per-line services off"))))

(defn ed-so-long-visited (m buf)
  "The visit step: [[so-long-visit]] at the model's threshold, before the first frame lays a
long line out. It runs on a jump's file too."
  (so-long-visit buf (model-threshold m)))

(register-visit-step :so-long {:order 20 :run 'solong/ed-so-long-visited :passing true})
