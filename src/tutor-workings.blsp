(defmodule tutor-workings
  "The tutorial's ***Workings*** pane — the \"show me how it actually ran\" channel.

A sandbox reply for a traced box carries `:spy` entries; they render here as an indented
call/return tree beside the page, and the pane shows the workings of the box the reader's
cursor is IN, following them from box to box with no re-evaluation.

**The boundary.** This module knows about a *pane*, a *cache* and a *box index*; it never
looks at the tutorial buffer, parses a box, or decides which box you are in. `tutor` passes
the index. That is what keeps the two modules acyclic (the tutorial owns the box parser, and
the pane is downstream of it) and what makes the pane testable from a synthetic reply — no
lesson, no sandbox, no window.

**The state**, all under the model's `:tutor` map:

  `:workings`         box index → its rendered cascade (a string), or `:none` for
                      \"it ran and traced nothing\". The distinction is load-bearing in
                      both directions: it is the difference between \"box 3 ran nothing
                      traceable\" and \"box 3 has not run yet\", and only a real cascade is
                      worth opening a closed pane for.
  `:workings-region`  which box the pane is currently showing (nil = not shown on this page).
  `:workings-closed?` the reader dismissed it — latched, because the absence of a pane cannot
                      by itself tell a dismissal from a pane that never opened.

Shown with `commands/ed-show-named-aside` (`:action :display`), so it splits or reuses
another pane and never takes the selection or replaces the tutorial's own."
  (:use model) ; ed-buffer-index-by-name — is the pane on screen?
  (:use commands)) ; ed-show-named-aside — put it beside the page, selection untouched
;; eval-server/*spy-entry-cap* (the budget a full cascade has reached) is referenced
;; qualified below and auto-loads.
(def *buffer-name* "*Workings*")

;; ---- rendering a reply's cascade ----------------------------------------------

(defn- workings-strip-parens
  (s)
  ;; "(5)" -> "5" — an args list reads better without its wrapping parens
  (if (and (string? s) (starts-with? s "(") (ends-with? s ")"))
    (substring s 1 (dec (string-length s)))
    (or s "")))

(defn lines (entries)
  "Spy entries → indented lines: a `call` opens a level (`fac 3`), its `return`
closes it (`= 6`); anything else renders flat."
  (let (r (fold (fn (acc e)
                  (let ([depth ls] acc
                        kind (:kind e))
                    (cond
                      (= kind "call")
                        [(inc depth)
                          (cons (str (string-repeat "  " depth)
                                  (:fn e)
                                  " "
                                  (workings-strip-parens (:args e)))
                            ls)]
                      (= kind "return")
                        (let (d (max 0 (dec depth)))
                          [d (cons (str (string-repeat "  " d) "= " (:value e)) ls)])
                      else [depth (cons (str (:form e) " => " (:value e)) ls)])))
            [0 '()]
            entries))
    (reverse (second r))))

(defn budget-spent? (entries)
  "Whether this cascade is all the sandbox would collect — it stopped at the trace
budget (`eval-server/*spy-entry-cap*`) rather than because the code stopped calling.

Worth telling the reader, and not a footnote: the loop kept running after this, in
constant stack and at full speed, because the tracer steps aside once its sink is
full (`debug/trace-fn`). A pane claiming to show \"every call\" would be lying, and
lying in the one lesson whose subject is that a tail loop can run forever."
  (>= (count entries) eval-server/*spy-entry-cap*))

(defn text (reply)
  "A reply's `:spy` entries as the pane's body text."
  (let (entries (or (:spy reply) ()))
    (join "\n"
      (append (list (if (budget-spent? entries)
                      (str "The workings — the first "
                        (count entries)
                        " traced calls, innermost nested:")
                      "The workings — every traced call and return, innermost nested:")
                "")
        (lines entries)
        (if (budget-spent? entries)
          (list "" "…the trace budget stops here; the code carried on untraced.")
          '())))))

;; ---- the pane's state on the model --------------------------------------------

(def *unshown*
  ;; The pane's VISIBILITY state, forgotten: not on screen, and not dismissed either. The
  ;; cascade cache is deliberately not part of it — the two resets differ, which is the
  ;; whole reason to name this. A new page clears both (`tutor/tutor-install-page`); asking
  ;; for the pane back (`tutor/cmd-tutorial-workings`) clears only this pair, so the reopen
  ;; wins against the close latch while the cached cascades it is about to show survive.
  {:workings-region nil :workings-closed? false})

(defn cascade (m i)
  "Box `i`'s cached cascade text, or nil when it has none (never ran, or traced nothing) —
also the test for whether the pane has something worth showing."
  (let (v (get-in m [:tutor :workings i]))
    (when (string? v) v)))

(defn on-page? (m)
  "Whether any box on this page has a cascade — what makes the pane worth having open at
all on this lesson."
  (any? string? (vals (or (get-in m [:tutor :workings]) {}))))

(defn body (m i)
  "What the pane should show for box `i` right now: its cached cascade, else why there
isn't one. `i` nil means the cursor is not in a box at all."
  (let (v (when i (get-in m [:tutor :workings i])))
    (cond
      (nil? i) "The workings — put the cursor in a ╭─ box to see how its code ran."
      (string? v) v
      (= v :none)
        (str "The workings — box "
          (inc i)
          " ran nothing traceable:"
          "\nno call of its own to step into.")
      :else
        (str "The workings — box "
          (inc i)
          " has not run yet.\n"
          "Type in it and the calls it makes appear here."))))

(defn forget (m from)
  "Drop the cached workings of every box from `from` down — they were just re-sent, so their
old cascades describe code that no longer exists. Keeps the boxes above, whose replies still
stand. `from` nil (nothing changed) keeps everything."
  (if (nil? from)
    m
    (assoc-in m
      [:tutor :workings]
      (into {}
        (filter (fn (kv) (< (first kv) from))
          (or (get-in m [:tutor :workings]) {}))))))

;; ---- showing it ---------------------------------------------------------------

(defn refresh (m i force)
  "Re-render the pane for box `i`. With `force` it is opened if it isn't there; without,
only an already-open pane is refreshed.

**A pane the reader closed stays closed** — even against `force`, which is otherwise how the
pane first appears (a reply for the box you are in, or a lesson that has workings). Closing
it is a choice, and the next reply must not undo it, so the close is latched on the model:
absence alone cannot tell a pane the reader dismissed from one that has never opened.
`tutor/cmd-tutorial-workings` is the way back, and the only thing that clears the latch (a
new page also starts fresh)."
  (let (pane (ed-buffer-index-by-name m tutor-workings/*buffer-name*)
        ;; shown on this page (`:workings-region` set) and gone now = the reader closed it
        closed? (or (get-in m [:tutor :workings-closed?])
                  (and (nil? pane) (not (nil? (get-in m [:tutor :workings-region])))))
        m1 (assoc-in m [:tutor :workings-closed?] closed?))
    (if (and (nil? pane) (or (not force) closed?))
      m1
      (assoc-in (ed-show-named-aside m1 tutor-workings/*buffer-name* (body m1 i) :tutor-workings)
        [:tutor :workings-region]
        i))))

(defn show (m region-idx at reply)
  "Cache what box `region-idx` just did, then refresh the pane for box `at` (the box at
point).

Opens the pane only for a reply that HAS a cascade and belongs to the box the reader is in:
having something to show is what earns a split, and a box that ran nothing traceable is not
worth halving the page for. A reply for any other box updates its cache silently — a
background re-eval never yanks the view off the box you are reading — and once the pane is
open it follows you, saying so for the boxes that traced nothing."
  (let (spy (or (:spy reply) ())
        cached (assoc-in m [:tutor :workings region-idx] (if (empty? spy) :none (text reply))))
    (refresh cached at (and (not (empty? spy)) (= region-idx at)))))

(defn follow (m i)
  "Keep the pane on box `i` — the `:post-key` half, so a plain motion (M-n to the next box,
an arrow into another one) re-renders from the cache with no re-evaluation. Only touches the
buffer when the box actually changed.

Moving into a box that HAS a cascade opens the pane; moving into one with nothing to show
only refreshes a pane already open. So the pane is where the workings are, and a box that
traced nothing never splits the page on its own."
  (if (= i (get-in m [:tutor :workings-region]))
    m
    (refresh m i (not (nil? (cascade m i))))))
