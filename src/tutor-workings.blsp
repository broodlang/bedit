(defmodule tutor-workings
  "The tutorial's ***Workings*** pane — the \"show me how it actually ran\" channel.

A sandbox reply for a traced box carries `:spy` entries; they render here as an indented
call/return tree beside the page, and the pane shows the workings of the box the reader's
cursor is IN, following them from box to box with no re-evaluation.

**This module is now the tutorial's ADAPTER onto `workings`** — the shared pane. It supplies
the spec (where the state lives, what the pane is called, what to call a region in prose) and
keeps the names `tutor` and its tests already use. The behaviour, and the reasoning behind
it, is in `workings`; the cascade rendering is in `liveeval`.

**The boundary.** Neither this nor `workings` looks at the tutorial buffer, parses a box, or
decides which box you are in — `tutor` passes the index. That is what keeps them acyclic (the
tutorial owns the box parser, the pane is downstream of it) and what makes the pane testable
from a synthetic reply: no lesson, no sandbox, no window.

**The state**, all under the model's `:tutor` map:

  `:workings`         box index → its rendered cascade (a string), or `:none` for
                      \"it ran and traced nothing\". The distinction is load-bearing in
                      both directions: it is the difference between \"box 3 called nothing
                      of yours\" and \"box 3 has not run yet\", and only a real cascade is
                      worth opening a closed pane for.
  `:workings-region`  which box the pane is currently showing (nil = not shown on this page).
  `:workings-closed?` the reader dismissed it — latched, because the absence of a pane cannot
                      by itself tell a dismissal from a pane that never opened.

Shown with `commands/ed-show-named-aside` (`:action :display`), so it splits or reuses
another pane and never takes the selection or replaces the tutorial's own."
  (:use model) ; ed-buffer-index-by-name — is the pane on screen?
  (:use commands)) ; ed-show-named-aside — put it beside the page, selection untouched
;; eval-server/*spy-entry-cap* (the budget a full cascade has reached) is referenced
;; qualified below and auto-loads.
(def *buffer-name* "*Workings*")

;; ---- rendering a reply's cascade ----------------------------------------------

;; The reply RENDERING moved to `liveeval` (`spy-lines` / `budget-spent?` / `report-text`) when
;; the playground became a second client for it — spy entries render the same whether they
;; came from a lesson box or from a free-text buffer. What stays here is the pane: which box
;; it is showing, whether the reader dismissed it, and where it sits on screen.

(defn lines (entries)
  "Spy entries → indented call/return lines. The tutorial's name for [[liveeval/spy-lines]]."
  (liveeval/spy-lines entries))

(defn budget-spent? (entries)
  "Whether this cascade stopped at the trace budget rather than because the code stopped
calling — [[liveeval/budget-spent?]]."
  (liveeval/budget-spent? entries))

(defn text (reply)
  "Everything a reply said, as the pane's body text — [[liveeval/report-text]]."
  (liveeval/report-text reply))

;; ---- the pane's state on the model --------------------------------------------

;; The pane BEHAVIOUR — when it opens, what it says, how it follows, how a dismissal latches
;; — moved to `workings` when the playground became a second pane wanting exactly the same
;; judgement. What is left here is the tutorial's spec and its names: `tutor` and its tests
;; call these, and there is no reason for either to learn a new vocabulary for a refactor
;; that changed nothing about how the pane behaves.
(def *spec*
  {:key :tutor
   :buffer tutor-workings/*buffer-name*
   :type :tutor-workings
   :noun "box"
   :heading "The workings"})

(def *unshown* workings/*unshown*)

(defn cascade (m i)
  "Box `i`'s cached cascade text, or nil when it has none — [[workings/cascade]]."
  (workings/cascade *spec* m i))

(defn on-page? (m)
  "Whether any box on this page has a cascade — [[workings/on-page?]]."
  (workings/on-page? *spec* m))

(defn body (m i)
  "What the pane should show for box `i` — [[workings/body]]."
  (workings/body *spec* m i))

(defn forget (m from)
  "Drop the cached workings of every box from `from` down — [[workings/forget]], whose
predicate the tutorial fills in as a suffix (its boxes are re-evaluated from the edit down).
`from` nil (nothing changed) keeps everything."
  (if (nil? from) m (workings/forget *spec* m (fn (i) (>= i from)))))

(defn refresh (m i force)
  "Re-render the pane for box `i` — [[workings/refresh]]."
  (workings/refresh *spec* m i force))

(defn show (m region-idx at reply)
  "Cache what box `region-idx` did and refresh the pane for the box at point —
[[workings/show]]."
  (workings/show *spec* m region-idx at reply))

(defn follow (m i)
  "Keep the pane on box `i` — [[workings/follow]]."
  (workings/follow *spec* m i))
