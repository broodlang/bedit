(defmodule search-commands
  "The search commands that open a search, a list or a replace: isearch's entry points (C-s C-r
C-M-s M-s w M-s .), occur (M-s o), the fuzzy line search, and the query-replace prompts (M-%
C-M-%). The loops themselves are `isearch`'s and `query-replace`'s."
  (:use editor/buffer)
  (:use interactive)
  (:use isearch)
  (:use query-replace)
  (:use pool)
  (:use minibuffer)
  (:use model))

;; ---- occur (M-s o) ----------------------------------------------------------
;; List the current buffer's lines matching a string in a read-only *Occur* buffer;
;; RET or a click on a result visits that line of the source, in another pane. A results
;; buffer like *Diagnostics*: each row's location rides OFF-text in `:line-links`
;; (`{:buffer :line}`, resolved by `results/line-links-only-loc`), and the jump is the
;; shared `cmd-visit-location` (`results/location-jump-layer`) — so a second *Occur* over
;; another buffer can never send the first one's rows to the wrong source.

(defn- ed-occur-matches (buf needle)
  "`[line0 text]` for each 0-based line of `buf` whose text contains `needle`."
  (seq/keep (range (buffer-line-count buf))
    (fn (line)
      (let (text (wrap/line-text buf line))
        (if (>= (index-of text needle 0) 0) [line text] nil)))))

(defn ed-occur-text (matches needle)
  "The *Occur* buffer text for `matches` of `needle`: a header line then `N: <line>`
rows (1-based source line numbers)."
  (str (count matches)
    " matches for \""
    needle
    "\":\n"
    (string/join (map matches (fn (e) (str (inc (first e)) ": " (second e)))) "\n")
    "\n"))

(defn- ed-occur-links (matches source)
  "The *Occur* rows' `:line-links`: each row (0-based, after the header line) → the
`{:buffer :line}` of the match it shows in buffer `source`."
  (into {}
    (map (seq/enumerate matches) (fn ([i e]) [(inc i) {:buffer source :line (inc (first e))}]))))

(defcommand cmd-occur
  (m key)
  "List the current buffer's lines matching a string in a read-only *Occur* buffer
(M-s o); RET on a result visits that line of the source buffer, in another pane."
  (let (source (buffer-name (ed-current-buf m)))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Occur: " "")
         :on-complete (fn (mm t)
                        (if (= t "")
                          (message mm "empty pattern")
                          (let (matches (ed-occur-matches (ed-current-buf mm) t))
                            (if (empty? matches)
                              (message mm (str "no matches for \"" t "\""))
                              (let (shown (ed-show-named mm
                                            "*Occur*"
                                            (ed-occur-text matches t)
                                            :occur))
                                (ed-set-buf shown
                                  (assoc (ed-current-buf shown)
                                    :line-links (ed-occur-links matches source))))))))})))

;; ---- incremental search (C-s / C-r) -----------------------------------------
;; Open the modal isearch loop; `input/ed-update` then routes keys to it. The work —
;; searching, highlighting, wrap — is `isearch`'s.

(defcommand cmd-isearch-forward
  (m key)
  "Begin an incremental search forward (C-s)."
  (isearch-start m :forward))

(defcommand cmd-isearch-backward
  (m key)
  "Begin an incremental search backward (C-r)."
  (isearch-start m :backward))

(defcommand cmd-isearch-forward-regexp
  (m key)
  "Begin an incremental REGEXP search forward (C-M-s) — Brood's pattern dialect, `^`/`$` at a
line's ends and `.` short of a newline. M-r inside any search toggles between the two."
  (isearch-start m :forward :regexp))

(defcommand cmd-isearch-backward-regexp
  (m key)
  "Begin an incremental regexp search backward (C-M-r)."
  (isearch-start m :backward :regexp))

(defcommand cmd-isearch-forward-symbol-at-point
  (m key)
  "Search forward for the symbol at point, whole symbols only (M-s .) — the next C-s is its next
use (Emacs's isearch-forward-symbol-at-point)."
  (isearch-start-symbol m))

(defcommand cmd-isearch-forward-word
  (m key)
  "Begin an incremental WORD search forward (M-s w): the words typed, whatever punctuation,
spaces or line breaks lie between them in the buffer."
  (isearch-start m :forward :word))

;; ---- query-replace (M-% · C-M-%) -------------------------------------------------
;; Ask what to replace and with what; the y/n/!/./q loop is `query-replace`'s.

(defn- ed-query-replace-prompts (m regexp?)
  "Ask what to replace and with what, then start the y/n/!/./q loop (`query-replace/qr-start`).
The region is read NOW, before either prompt, as Emacs's interactive spec reads it: with one
active the replace is confined to it, and both prompts say so — `Query replace in region:`."
  (let (region (region/ed-active-region m)
        kind (str "Query replace" (if regexp? " regexp" "") (if region " in region" ""))
        ;; a narrowed pane confines it too: from point (or the region) to the restriction's end
        scope (when (or region (ed-selected-restrict m)) (ed-replace-scope m region))
        options (merge {:regexp? regexp?} (if scope {:region scope} {}))
        ;; the last pair of THIS kind, which an empty answer reuses (Emacs's
        ;; `query-replace-defaults`): the prompt names it
        last (get (or (:query-replace-last m) {}) regexp?)
        default (if last (str " (default " (first last) " -> " (second last) ")") "")
        ;; M-% from a search hands over what it searched for: only the replacement is asked
        seed (:query-replace-seed m)
        ;; every match on screen shows what it becomes as the replacement is typed
        ;; (`query-replace/preview`, Emacs 32's query-replace-show-preview)
        ask-to (fn (mm from)
                 (assoc (query-replace/preview mm from "" options)
                   :minibuffer
                     {:edit (ed-mb-edit (str kind " " from " with: ") "")
                      :on-edit (fn (m2 to) (query-replace/preview m2 from to options))
                      :on-abort query-replace/preview-off
                      :on-complete (fn (m2 to)
                                     (qr-start (map/assoc-in (query-replace/preview-off m2)
                                                 [:query-replace-last regexp?]
                                                 [from to])
                                       from to options))})))
    (if seed
      (ask-to (dissoc m :query-replace-seed) (:from seed))
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit (str kind default ": ") "")
           :on-complete (fn (mm from)
                          (cond
                            (and (= from "") last) (qr-start mm (first last) (second last) options)
                            (= from "") (message mm "(nothing to replace)")
                            else (ask-to mm from)))}))))

(defcommand cmd-query-replace
  (m key)
  "Replace occurrences of one string with another from point — or within the region when one
is active — asking at each (M-%). Prompts for the search string, then the replacement, then
enters the y/n/!/./q loop (see `query-replace`)."
  (ed-query-replace-prompts m false))

(defcommand cmd-query-replace-regexp
  (m key)
  "Replace matches of a regexp from point — or within the region when one is active — asking
at each (C-M-%). The replacement may refer to what matched: `\\&` the whole match, `\\1`…`\\9`
its groups, `\\\\` a backslash."
  (ed-query-replace-prompts m true))

;; ---- fuzzy in-buffer line search (M-s s, M-s l) --------------------------------------
;; The same Vertico minibuffer the other completers use, ranking the buffer's own lines
;; (consult-line / swiper style): you fuzzy-type, the list narrows, Enter jumps to the
;; selected line. Each candidate is "<n>: <text>" so accept can recover the line number
;; (and typing a bare number jumps straight to that line, like goto-line).

(defn- ed-buffer-line-candidates (buf)
  "Every non-blank line of `buf` as `\"<1-based n>: <text>\"` — the fuzzy line-search
candidates; the leading number lets accept jump back to the line."
  (let (n (buffer-line-count buf))
    (seq/keep (range n)
      (fn (i)
        (let (text (wrap/line-text buf i))
          (if (= "" (string/trim text)) nil (str (inc i) ": " text)))))))

(defn ed-goto-line-candidate (m candidate)
  "Move point to the start of the line a fuzzy line-search candidate names; a candidate
with no leading number leaves point unmoved (`ed-scroll` after dispatch reveals it). The
candidate's leading number is parsed by the shared `ed-leading-int` (a `\"<n>: text\"`
row, like an *Occur* line)."
  (let (n (ed-leading-int candidate))
    (if (nil? n)
      m
      (let (buf (ed-current-buf m)
            line (math/max 0 (math/min (dec (buffer-line-count buf)) (dec n)))
            bol (text/line->char (buffer-rope buf) line))
        (ed-set-buf m (goto-char buf bol))))))

(defcommand cmd-fuzzy-find-line
  (m key)
  "Fuzzy-search the current buffer's lines (M-s s, or M-s l as consult-line): a minibuffer listing every non-blank
line as `\"<n>: <text>\"`, fuzzy-ranked as you type — the same list + ↑/↓ navigation as
M-x and find-file. Enter jumps point to the selected line; a bare number jumps to it."
  (let (candidates (ed-buffer-line-candidates (ed-current-buf m)))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Find line: " "")
         :on-complete (fn (mm t) (ed-goto-line-candidate mm t))
         :complete-fn (fn (t) t)
         :rank-source candidates ; every buffer line, narrowed incrementally as you type
         :rank-cap 40
         :accept-selection true})))

;; ---- what the core must know of these commands -------------------------------------

;; a guest may run them (`guest`); the search and replace loops stay in the buffer
(declare-trait :guest
  '(search-commands/cmd-fuzzy-find-line search-commands/cmd-isearch-backward
     search-commands/cmd-isearch-backward-regexp search-commands/cmd-isearch-forward
     search-commands/cmd-isearch-forward-regexp search-commands/cmd-isearch-forward-word
     search-commands/cmd-occur search-commands/cmd-query-replace
     search-commands/cmd-query-replace-regexp))
