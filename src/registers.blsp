(defmodule registers
  "Emacs registers and bookmarks: a register is a single-character slot on the model
holding a saved point or text (C-x r SPC / j / s / i); a bookmark is a named, persisted
file position (C-x r m / b). What a register can do is the `Register` ability, so a new
kind is a record and an impl, not another branch in the commands."
  (:use editor/buffer) ; goto-char / insert / buffer-point / buffer-region — what a register saves and restores
  (:use minibuffer)
  (:use model) ; message / ed-apply / ed-edit / ed-read-char / ed-mb-edit
  (:use pool) ; ed-find-file / ed-name-prompt — a bookmark's file and the jump prompt
  (:use projects) ; bookmark-names / bookmark-get / bookmark-set! — the persisted bookmarks
  (:use interactive)) ; defcommand — the register and bookmark commands, on M-x

;; ---- registers (C-x r SPC / j / s / i) --------------------------------------
;; A register is a single-character slot in the model's `:registers` map holding a
;; `Register` record — a saved point (`point-register`) or text (`text-register`).
;; The ability keeps the jump/insert commands closed over WHAT a register holds:
;; a new register kind (a rectangle, a window config, …) is a record + impl here,
;; not another branch in the commands. Each command reads the register name with
;; `ed-read-char`. Emacs C-x r SPC / j / s / i.

;; C-x r SPC — a saved position and the buffer it is in: the buffer's file, or its name when
;; it visits none, and a marker in that buffer (`[:register c]`) so the position follows edits
;; made since, as an Emacs register's marker does. `position` is where it was, for a buffer
;; read again since (the marker went with the old one).
(defrecord point-register ((file any) (name string) (marker any) (position int)))
(defrecord text-register ((text string))) ; C-x r s — a saved region
(defability Register
  "What a register's held value can do: jump to it (C-x r j) or insert it (C-x r i).
A kind that can't do one says so in the echo area (`c` is the register's name)."
  (register-jump (self m c) :-> any)
  (register-insert (self m c) :-> any))

(defn- ed-goto-register-point (m v)
  ;; the current buffer at `v`'s marker — or its saved position when the marker is gone
  (ed-apply m
    (fn (b)
      (goto-char b
        (math/min (or (buffer-marker b (point-register-marker v)) (point-register-position v))
          (buffer-length b))))))

(impl Register
  point-register
  (register-jump (v m c)
    (let (file (point-register-file v)
          index (if file
                  (ed-buffer-index-by-file m file)
                  (ed-buffer-index-by-name m (point-register-name v))))
      (cond
        (= index (ed-current-index m)) (ed-goto-register-point m v)
        index (ed-goto-register-point (pool/ed-select m index) v)
        ;; the file's buffer was killed: visit the file again, at the saved position
        file (ed-goto-register-point (ed-find-file m file) v)
        else
          (message m (str "register " c "'s buffer " (point-register-name v) " no longer exists")))))
  (register-insert (v m c) (message m (str "register " c " holds no text"))))

(impl Register
  text-register
  (register-jump (v m c) (message m (str "register " c " holds no point")))
  (register-insert (v m c) (ed-edit m (fn (b) (insert b (text-register-text v))))))

(defn ed-set-register (m c v) (assoc m :registers (assoc (or (:registers m) {}) c v)))
(defn ed-get-register (m c) (get (or (:registers m) {}) c))

(defcommand cmd-point-to-register
  (m key)
  "Save point and its buffer in a register (C-x r SPC <r>); C-x r j <r> later goes back to that
buffer and that place, moved with the edits made since."
  (ed-read-char m
    "Point to register: "
    (fn (mm c)
      (let (buffer (ed-current-buf mm)
            marker [:register c]
            point (buffer-point buffer))
        (message (ed-set-register (ed-set-buf mm (buffer-marker-set buffer marker point))
                   c
                   (point-register (buffer-file buffer) (buffer-name buffer) marker point))
          (str "Point saved in register " c))))))

(defcommand cmd-jump-to-register
  (m key)
  "Jump to the point saved in a register (C-x r j <r>)."
  (ed-read-char m
    "Jump to register: "
    (fn (mm c)
      (let (v (ed-get-register mm c))
        (if v
          (register-jump v mm c)
          (message mm (str "register " c " holds no point")))))))

(defcommand cmd-copy-to-register
  (m key)
  "Copy the region into a register (C-x r s <r>); C-x r i <r> inserts it later."
  (ed-read-char m
    "Copy to register: "
    (fn (mm c)
      (region/ed-with-region mm
        (buffer-region (ed-current-buf mm))
        (fn (text)
          (message (ed-set-register mm c (text-register text)) (str "Region saved in register " c)))))))

(defcommand cmd-insert-register
  (m key)
  "Insert a register's saved text at point (C-x r i <r>)."
  (ed-read-char m
    "Insert register: "
    (fn (mm c)
      (let (v (ed-get-register mm c))
        (if v
          (register-insert v mm c)
          (message mm (str "register " c " holds no text")))))))

;; ---- bookmarks (C-x r m set / C-x r b jump) ---------------------------------

(defcommand cmd-bookmark-set
  (m key)
  "Set a named bookmark at point in the current file (C-x r m); persisted across sessions."
  (let (b (ed-current-buf m) f (buffer-file b) p (buffer-point b))
    (if (nil? f)
      (message m "buffer has no file to bookmark")
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit "Set bookmark: " "")
           :on-complete (fn (mm t)
                          (do
                            (bookmark-set! t f p)
                            (message mm (str "Bookmark set: " t))))}))))

(defcommand cmd-bookmark-jump
  (m key)
  "Jump to a bookmark (C-x r b): prompt with completion, open its file and go to point."
  (let (names (into [] (bookmark-names)))
    (if (empty? names)
      (message m "no bookmarks yet (set one with C-x r m)")
      (assoc m
        :minibuffer
          (ed-name-prompt "Jump to bookmark: "
            names
            (fn (mm t)
              (let (bk (bookmark-get t))
                (if (nil? bk)
                  (message mm (str "no bookmark: " t))
                  (ed-apply (ed-find-file mm (:file bk))
                    (fn (bb) (goto-char bb (math/min (:pos bk) (buffer-length bb)))))))))))))
