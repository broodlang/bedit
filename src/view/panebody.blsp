(defmodule view/panebody
  "One pane's body as render ops: its visible lines (folded and wrapped rows from the row table),
each row's text with its spans and ellipsis, and the gutter beside it — numbers, the current
line's, change bars and margin marks."
  (:use editor/buffer)
  (:use model)
  (:use ui-kit)
  (:use editor/ui)
  (:use editor/display)
  (:use memo)
  (:use theme)) ; the gutter and truncation faces

(sig ed-row-slice (any int int (or nil int) int &optional (or nil int) -> (tuple string int int)))

(defn- ed-row-slice (rope line from to w &optional (known-col nil))
  "`[vis from-col base]` for the chars `[from, to)` of `line` a `w`-wide row shows (`to` nil
for the rest of the line): the text it paints, the display column that text starts at on
its line, and the buffer offset of its first character.

The line is read as rope SLICES — its bounds from the line index, then only the chars the
row shows (and, h-scrolled, the ones left of it) — not as the whole line's text with its
newline stripped and then substringed: two fewer copies of every visible line on every
frame that re-renders it.

`known-col` is the display column `from` sits at when the caller already knows it — the row
after another row of the same wrapped line starts where that one ended — so a row in the
middle of a megabyte line does not measure the line's text before it."
  (let (bol (text/line->char rope line)
        len (- (textpos/ed-line-end rope line) bol)
        ;; `if`, not `math/min`: the checker reads `math/min` of two ints as a `number`, and
        ;; these become rope offsets, which are ints
        h (if (< from len) from len)
        ;; `h + w` chars, not the rest of the line: `ed-fit` keeps only the first `w` of
        ;; whatever this slices, so the cap is EXACT, not an approximation — and it is the
        ;; difference between allocating what the pane shows and allocating the line. On a
        ;; file of 12,000-character lines that was a 12 KB copy per row per frame.
        end (let (cap (if (nil? to) (+ h w) to)) (if (< cap len) cap len)))
    [(ed-fit (text/slice rope (+ bol h) (+ bol (if (< end h) h end))) w)
      (cond
        (= h 0) 0
        (and (int? known-col) (= h from)) known-col
        else (string/display-width (text/slice rope bol (+ bol h))))
      (+ bol h)]))

(defn- ed-row-start-cols (rope table)
  "Per row of a pane's row `table`, the display column its text starts at when the row
before it was the same line's and ended where it starts (a wrapped line's next row: that
row's column plus its width), else nil — so only the FIRST row of a line on screen measures
the line's text before it (`ed-row-slice`)."
  (first
    (fold table
      [[] nil]
      (fn (acc row)
        (let ([cols previous] acc
              line (nth row 0)
              from (nth row 1)
              to (nth row 2)
              inlay (nth row 3 nil)
              bol (text/line->char rope line)
              start (+ bol from)
              end (when (int? to) (+ bol to))
              ;; the guard also tells the checker the offsets are ints: a row is untyped data
              wrapped? (and (nil? inlay) (int? start) (int? end) (nil? (nth row 4 nil)))
              ;; this row's start column: handed on by the row before, else — for a
              ;; wrapped row, whose end the next row needs — measured here, once
              col (cond
                    (not (nil? inlay)) nil
                    (and previous (= (first previous) line) (= (second previous) from))
                      (nth previous 2)
                    (not wrapped?) nil
                    (= from 0) 0
                    (int? start) (string/display-width (text/slice rope bol start))
                    else nil)
              ;; where a wrapped row ends, and the column there, for the row after it
              next (when (and wrapped? (int? col) (int? start) (int? end))
                     [line
                       to
                       (+ col
                         (string/display-width (text/slice rope start end) col))]))
          [(conj cols col) next])))))

(sig ed-row-ops (int int int string int int any any any any &optional any -> any))

(defn- ed-row-ops (row x w vis from-col base plain? spans ranges overrides &optional (display nil))
  "The ops painting `vis` (`ed-row-slice`) on screen row `row` from column `x`, `w` wide:
one plain `text` op when `plain?`, else the tiled `[substring face]` chunks of the syntax
`spans`, highlight `ranges` and `overrides` (all absolute offsets, `base` being `vis`'s).
The row's `display` (`wrap/row-display`) moves the text right by its prefix — a wrapped
line's continuation row starts under its indentation, as `wrap/row-cell` places the caret."
  (let (prefix (let (p (get display :prefix)) (if (int? p) (math/min p w) 0))
        left (+ x prefix)
        room (- w prefix)
        ;; `[index text face]` into `vis` (`ed-paint-display`): the inline annotations
        inline (map (or (get display :paint-inline) [])
                 (fn (annotation)
                   [(first annotation)
                     (second annotation)
                     (or (nth annotation 2 nil) face-inline-annotation)])))
    (if (and plain? (empty? inline))
      [(text row left (ed-fit-cells (string/expand-tabs vis from-col) room))]
      ;; laid out by std's `editor/display/chunk-ops`, the hints spliced in as virtual chunks
      (chunk-ops row
        left
        (splice-inline (spanpaint/ed-line-chunks vis base (or spans '()) ranges overrides)
          inline)
        from-col
        (+ x w)))))

;; Inline text (`inlinetext`): virtual text inside a line, painted in the hint voice unless
;; its producer names a face. `defchrome`, so a theme switch re-derives it.
(defchrome face-inline-annotation {:fg *overlay0* :italic true})

(defn- ed-paint-display (display from vis-length)
  "A row's `display` (`wrap/row-display`) as the painter reads it: its inline annotations as
`:paint-inline`, `[index text face]` — `index` the char of the row's painted text (it starts
`from` chars into its line and is `vis-length` long) each is painted before, and the face its
producer named (nil: [[face-inline-annotation]], resolved as it is painted, so a theme switch
reaches it) — dropping any past the painted text (a cut row's).
`display` itself when it has none; nil for nil."
  (let (inline (get display :inline))
    (if (empty? inline)
      display
      (assoc (or display {})
        :paint-inline
          (into []
            (seq/keep inline
              (fn (annotation)
                (let (index (- (first annotation) from))
                  (when (and (>= index 0) (<= index vis-length))
                    [index (nth annotation 2) (nth annotation 3 nil)])))))))))

(defn- ed-with-ellipsis (ops row x w ellipsis)
  "A row's `ops` with the `ellipsis` of a truncated line (`wrap/one-row`) after them, in the
row's LAST cells and the truncation face — so the marks of a column of truncated lines line
up at the pane's edge, as Emacs's fringe `$` does. `ops` as they were for a row that shows
its whole line (nil or `\"\"`)."
  (cond
    (or (nil? ellipsis) (= ellipsis "")) ops
    ;; a wrapped row's continuation mark, and the cut mark of a line that scrolls past the
    ;; edge, sit OUTSIDE the text, in the scrollbar column every pane keeps, as Emacs's arrows
    ;; sit in the fringe: the row keeps its whole width
    (or (= ellipsis wrap/continuation-mark) (= ellipsis wrap/cut-right-mark))
      (append ops (list (text row (+ x w) ellipsis face-truncation)))
    else
      (append ops
        (list (text row
                (+ x (math/max 0 (- w (string/display-width ellipsis))))
                ellipsis
                face-truncation)))))

(defn- ed-with-cut-left (ops row x cut-left?)
  "A row's `ops` with, when `cut-left?` (its line scrolled past some of its text), the left cut
mark over its first cell in the truncation face — Emacs's `$` at a scrolled line's left edge."
  (if cut-left? (append ops (list (text row x wrap/cut-left-mark face-truncation))) ops))

(sig ed-slice-ops (buffer int int int int any any any int (or nil int) -> any))

(defn- ed-slice-ops (buf line row x w hl-ranges spans overrides from to)
  "Render op(s) for the chars `[from, to)` of buffer `line` on screen row `row`, in a
text area starting at column `x` and `w` wide — `to` nil for the rest of the line. The
one row painter: an unwrapped pane's row is `[hscroll, len)` of its line, a wrapped
pane's a segment of it. With neither `:fontify` `spans` nor any highlight range it's a
single plain `text` op; otherwise coloured `[substring face]` chunks (the syntax spans +
highlight ranges + bracket `overrides` merged), tiled from the slice's absolute `base`
offset. Tabs are expanded to the LINE's stops (ADR-342): the slice is laid out from the
display column its first character sits at (`from-col`), so a chunk mid-line tabs where
the whole line would, and the frontend never sees a raw tab."
  (let ([vis from-col base] (ed-row-slice (buffer-rope buf) line from to w))
    (ed-row-ops row
      x
      w
      vis
      from-col
      base
      (and (nil? spans) (empty? hl-ranges))
      spans
      hl-ranges
      overrides)))

(sig ed-line-ops (buffer int int int int int any any any int -> any))

(defn ed-line-ops (buf line top x y w hl-ranges spans overrides hscroll)
  "Render op(s) for buffer `line` at its screen row `y + (line - top)` inside a pane whose
text area starts at column `x`, width `w`, scrolled `hscroll` characters left — the
unwrapped pane's row: `ed-slice-ops` over `[hscroll, end)` (long lines scroll, not wrap)."
  (ed-slice-ops buf line (+ y (- line top)) x w hl-ranges spans overrides hscroll nil))

(sig ed-visible-lines (buffer int int int int int any any any int vector any -> any))

(defn ed-visible-lines
  (buf top textrows x y w hl-ranges spans overrides hscroll rows row-wise? &optional (memo? false))
  "`text` ops for the rows of a `textrows`-tall pane whose text area starts at `(x, y)`
and is `w` wide: one row per entry of the pane's row table `rows` (`panes/ed-pane-rows`) —
a whole line scrolled `hscroll` columns left, or, `row-wise?` (wrapped, truncated, inlays), a
`[line from to]` segment of one. `hl-ranges` `[lo hi face]` highlight the
region/overlays, `spans` syntax-colour, and `overrides` is the bracket/diagnostic face
table **grouped by line** (`ed-overrides-by-line`) — each row is handed only its own.

With `memo?`, each row is a memoised fragment (`editor/ui/ui-memo-at`, brood ADR-336 and
ADR-728) keyed by its line `[:line x y line from-col generation layout]` (the theme's
generation and the cell layout, what it paints by besides its content) and drawn where it
lands, so a scroll repaints only the rows it brings in: its ops are reused from the previous
turn while what the row shows, the width, its spans, its highlights and **that line's** overrides
are `=`
— all of them values the model keeps between turns, so a cursor blink,
a mouse move or a motion that touches no bracket re-renders no line at all. (The per-line
grouping of the overrides is what makes that true — see `ed-overrides-by-line`.) Off (the
default) outside the loop and for a scaled pane, whose ops are transformed after this.

**A row's deps are its CONTENT, not its position** — the text it shows, the column that
text starts at, and its spans, highlights and overrides rebased to that text's first
character; the line is the memo's key and the screen row only where the ops are drawn — so
a row whose text did not change hits even after an edit elsewhere re-lexed
the band, and typing re-renders the edited row (and whatever the bracket pair moved
across) rather than all of them. That was first written and MEASURED as a loss: computing
those deps per line per frame (a rope slice and a span walk) cost more than the re-render it
saved, on exactly the frames that change nothing. What makes it a win is that the per-row
facts are remembered (`ed-row-facts-at`) on the rope, the band and the viewport: a frame
where nothing moved reads them back in one comparison, and only a frame that changed the
text or scrolled pays for them, once. The memo is handed only the spans on the rows shown
(`spanpaint/ed-spans-window`): its store is a deep copy, so a whole buffer's `:face-spans`
in the key were compared element by element on every lookup and copied on every miss."
  (let (rope (buffer-rope buf)
        layout (conventions/cell-layout-key)
        facts (ed-row-facts-at rope
                (spanpaint/ed-spans-window rope
                  spans
                  top
                  (ed-rows-last-line rows textrows))
                top
                textrows
                hscroll
                rows
                w
                layout
                row-wise?)
        any-ranges? (not (empty? hl-ranges))
        ;; in each row's memo KEY, beside its line: what a row paints by that is not its content
        ;; — the theme (its cut marks are `face-truncation`) and the cell layout (its tabs expand
        ;; at the tab width, a glyphless character shows by `:glyphless-chars`) — so a theme
        ;; applied or a layout changed since finds none of the old rows
        generation (theme/generation)
        paint-row (fn (row fact)
                    (let (line (:line fact)
                          vis (:text fact)
                          from-col (:column fact)
                          base (:start fact)
                          line-spans (:spans fact)
                          ellipsis (:ellipsis fact)
                          line-overrides (or (get overrides line) '())
                          ;; only the highlight ranges ON this line, clipped to it: the
                          ;; region's far end moves on every motion while it is active, and
                          ;; with the whole range as the dep every row re-rendered — a
                          ;; selected line in the middle paints the same either way
                          line-ranges (if any-ranges?
                                        (spanpaint/ed-ranges-on-line hl-ranges
                                          (:line-start fact)
                                          (inc (:line-end fact)))
                                        '())
                          ;; tiled or plain is the LINE's call: a line with no spans, no range
                          ;; and no override of its own paints plain whatever the rest of the
                          ;; pane has. As the pane's call, the first spell underline anywhere
                          ;; (or a region) flipped every bare line to the tiler — a blank line
                          ;; lost its `\"\"` op — so every row's memo missed once per check
                          plain? (and (nil? line-spans)
                                   (empty? line-ranges)
                                   (empty? line-overrides))
                          paint-at (fn (at-row at-col)
                                     (ed-with-cut-left (ed-with-ellipsis (ed-row-ops at-row
                                                                           at-col
                                                                           w
                                                                           vis
                                                                           from-col
                                                                           base
                                                                           plain?
                                                                           line-spans
                                                                           line-ranges
                                                                           line-overrides
                                                                           (:display fact))
                                                         at-row at-col w ellipsis)
                                       at-row
                                       at-col
                                       (:cut-left (:content fact)))))
                      ;; The deps are the row's content relative to its first character —
                      ;; never the whole band (`=` on a rebuilt band walks it once per row:
                      ;; on a file of 12,000-character lines that made the memo thirty times
                      ;; slower than no memo) and never the line number or the screen row —
                      ;; the line is the KEY ([:line x y line from-col …]), the row only where the
                      ;; ops land — so a row whose text and faces are unchanged hits wherever
                      ;; the edit was.
                      (if memo?
                        (let (deps (if (and (empty? line-ranges) (empty? line-overrides))
                                     ;; `content` first: the text, its column, the width and its
                                     ;; spans, one vector built with the facts, so on a frame
                                     ;; where nothing moved it is the SAME cell as last turn's
                                     ;; and compares at once. A row with no range and no
                                     ;; override on it reads its deps back from the facts (the
                                     ;; same vector as last frame, so `=` answers at once and
                                     ;; nothing is built); the rest build theirs
                                     (if plain? (:plain-deps fact) (:tiled-deps fact))
                                     [(:content fact)
                                       (ed-rebase-ranges line-ranges base)
                                       (ed-rebase-overrides line-overrides base)
                                       plain?]))
                          ;; a row's fragment keyed by its LINE and drawn where it lands, so a
                          ;; scroll repaints only the rows it brings in (brood ADR-728)
                          (ui-memo-at [:line x y line from-col generation layout]
                            deps
                            row
                            x
                            (fn () (paint-at 0 0))))
                        (paint-at row x)))))
    ;; One walk that conses each row's ops onto a reversed accumulator and reverses once.
    ;; `mapcat` over `seq/enumerate` built the index pairs, then spliced every row's
    ;; one-marker list through `append` — about twice the cost of the memo lookups
    ;; themselves on a frame where every row hits.
    (ed-visible-walk facts 0 '() y x w paint-row)))

;; An inlay row: derived text on a row of its own, above the code it describes. The hint
;; voice — dim and italic — because it is a remark about the line below it and must never
;; read as a line of the buffer. Same face as the type note it replaces when the note is too
;; long to sit at the end of its line. `defchrome`, so a theme switch re-derives it.
(defchrome face-inlay-line {:fg *overlay0* :italic true})

(sig ed-visible-walk (any int any int int int fn -> any))

(defn- ed-visible-walk (facts k acc y x w paint-row)
  "`ed-visible-lines`' walk over its row `facts` from screen row `k`: each row's ops consed
onto the reversed `acc` (`paint-row` for a text row; an INLAY row paints its own derived
text, indented to the line it describes, in the hint voice — a remark about the code below
it, not code), reversed once at the end."
  (if (empty? facts)
    (reverse acc)
    (let (fact (first facts)
          ops (if (string? fact)
                (list (text (+ y k) x (ui-clip (str "  " fact) w) face-inlay-line))
                (paint-row (+ y k) fact)))
      (ed-visible-walk (rest facts)
        (inc k)
        ;; a row is almost always ONE op — its memo marker — and `fold` over a one-element
        ;; list cost a microsecond a row, the dearest step of a row that hits
        (if (and (list? ops) (empty? (rest ops)))
          (ed-push-op acc (first ops))
          (fold ops acc ed-push-op))
        y
        x
        w
        paint-row))))

(sig ed-rows-last-line (vector int -> int))
(defn ed-rows-last-line (rows textrows)
  "The last buffer line the first `textrows` rows of a pane's row table `rows` show — the line
of the last of them, as a table runs down the lines in order — or -1 for an empty table."
  (let (shown (math/min textrows (count rows))
        line (when (> shown 0) (first (nth rows (dec shown)))))
    (if (int? line) line -1)))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a list of row facts.
(check-allow :trusted
  (defmemo ed-row-facts-at 8 (rope spans top textrows hscroll rows w cell-layout row-wise?)
    "Per screen row of a pane, what painting it reads from the TEXT: an inlay row's string,
or a text row's [[row-fact]].

Remembered on the rope, the spans on the rows shown (`spanpaint/ed-spans-window`), the
viewport and the width, so on a frame where nothing moved the rows' deps
(`ed-visible-lines`) are read back rather than rebuilt; the pane's row table `rows` is a
memoised vector (`panes/ed-pane-rows`), the same cell while the viewport stays put. Every key is the size of what is shown: the store is a
deep copy, so a lookup compares each key element by element."
    (let (table (take rows textrows)
          ;; the band sliced per line, ONCE — `fontify-runs` reads its whole `spans`
          ;; argument before tiling, so handing every row the whole band is O(rows × band).
          ;; The rows a wrapped pane draws are the same LINES, so the slice covers both.
          by-line (if (or (nil? spans) (empty? spans))
                    {}
                    (spanpaint/ed-spans-by-line-at rope
                      spans
                      top
                      (ed-rows-last-line rows textrows))))
      (let (carry (when (not row-wise?) (ed-row-facts-carry rope hscroll w cell-layout)))
        (map (seq/zip table (ed-row-start-cols rope table))
          (fn ([row known-col])
            (let (line (nth row 0)
                  inlay (nth row 3 nil)
                  carried (when (and carry (nil? inlay)) (carry line)))
              (cond
                (not (nil? inlay)) inlay
                carried (ed-row-fact-moved carried line (get by-line line))
                else (ed-row-fact rope by-line w row known-col)))))))))

(defn- ed-row-facts-key (key)
  ;; A remembered [[ed-row-facts-at]] call's key, named: the pattern IS that memo's parameter
  ;; list, and a vector pattern matches only its own length, so a parameter added or dropped
  ;; there without this raises here instead of [[ed-row-facts-carry]] reading the wrong slot
  (let ([rope _spans top _textrows hscroll _rows width cell-layout row-wise?] key)
    {:rope rope
     :top top
     :hscroll hscroll
     :width width
     :cell-layout cell-layout
     :row-wise? row-wise?}))

(defn- ed-row-fact (rope by-line w row known-col)
  ;; one text row's facts (`ed-row-facts-at`'s), read from the text
  (let (line (nth row 0)
        from (nth row 1)
        to (nth row 2)
        clip (nth row 4 nil)
        display (wrap/row-display row)
        [vis from-col base] (ed-row-slice rope line from (if clip (first clip) to) w known-col)
        bol (text/line->char rope line)
        eol (textpos/ed-line-end rope line)
        ;; a wrapped row its line goes on past ends in the continuation mark, and a row of a
        ;; line that scrolls, cut by the pane's edge, in the cut mark — both painted just past
        ;; the text (`ed-with-ellipsis`: the scrollbar column), as Emacs marks them in the fringe
        ellipsis (cond
                   clip (second clip)
                   (and (not (nil? to)) (< (+ bol to) eol)) wrap/continuation-mark
                   (and (nil? to)
                     (or (< (+ base (count vis)) eol) (> (string/display-width vis from-col) w)))
                     wrap/cut-right-mark
                   else nil)
        ;; a row of a line that scrolls, scrolled past some of its text: the left mark
        cut-left? (and (nil? to) (nil? clip) (> base bol))
        line-spans (get by-line line)
        ;; the row's prefix and inline text, the latter as indices into `vis`
        painted (ed-paint-display display (- base bol) (count vis)))
    (ed-row-fact-of line
      vis
      from-col
      base
      line-spans
      ;; the spans CLIPPED to the text the row shows: a docstring's one span runs over many
      ;; lines and lengthens with every character typed in it, and every row it covers
      ;; paints the same however long it is
      {:text vis
       :column from-col
       :width w
       :spans (ed-row-content-spans line-spans base vis)
       :ellipsis ellipsis
       :cut-left cut-left?
       :display painted}
      bol
      eol)))

(defn- ed-row-content-spans (line-spans base vis)
  ;; the line's spans over the text a row shows, relative to its first character
  (ed-rebase-ranges (spanpaint/ed-ranges-on-line line-spans base (+ base (count vis))) base))

;; A text row's facts (`ed-row-facts-at`): what painting it reads from the TEXT, built once
;; per row the text or the viewport changed and read back on every frame that did not.
;;
;;   :line        the buffer line the row shows (part of)
;;   :text        the chars it paints (`ed-row-slice`), cut at a truncated row's clip
;;   :column      the display column `:text` starts at on its line (its tabs' stops)
;;   :start       the buffer offset of `:text`'s first char
;;   :spans       the line's syntax spans, absolute
;;   :content     the row's CONTENT key, `{:text :column :width :spans :ellipsis :cut-left
;;                :display}`,
;;                its spans clipped to `:text` and rebased to `:start` — what its memo compares
;;   :line-start  :line-end   the line's bounds, which the highlight ranges are clipped to
;;   :plain-deps  :tiled-deps   the row's whole memo deps on a frame with no highlight range
;;                and no override on it, painted plain and painted tiled — built once here, so
;;                such a row hands its memo the SAME vector every frame
;;   :ellipsis    what a cut row ends in (`wrap/one-row`, or the wrap continuation mark), nil
;;                for one that shows its whole line
;;   :display     the row's prefix and inline text, as the painter reads them
(deftype row-fact
  (record :line
    int
    :text string
    :column int
    :start int
    :spans any
    :content map
    :line-start int
    :line-end int
    :plain-deps vector
    :tiled-deps vector
    :ellipsis (or nil string)
    :display (or nil map)))

(defn- ed-row-fact-of (line vis from-col base line-spans content bol eol)
  ;; the [[row-fact]] of a row, its memo deps for the usual frame — no highlight range and no
  ;; override on the line — built with it, plain then tiled
  {:line line
   :text vis
   :column from-col
   :start base
   :spans line-spans
   :content content
   :line-start bol
   :line-end eol
   :plain-deps [content '() '() true]
   :tiled-deps [content '() '() false]
   :ellipsis (:ellipsis content)
   :display (:display content)})

(defn- ed-row-fact-moved (carried line line-spans)
  "A row's facts carried from the frame before: `carried` is `[fact delta]`, the fact of the
same text there and how far an edit moved it. The offsets move by `delta`; the text, its
column and what it paints are the fact's own. Its content — and with it the memo deps — stays
the SAME cell while the line's spans over it are unchanged, so the row's memo hits at once."
  (let ([fact delta] carried
        base (+ (:start fact) delta)
        vis (:text fact)
        content (:content fact)
        ;; the line's spans moved with its text — what an edit elsewhere leaves — keep the
        ;; content as it is, without clipping and rebasing them again (most of a row's cost)
        moved-spans? (ed-spans-moved? (:spans fact) line-spans delta)
        same-spans? (or moved-spans?
                      (= (ed-row-content-spans line-spans base vis) (:spans content))))
    (cond
      ;; a line before the edit: the very fact, nothing built
      (and moved-spans? (= delta 0) (= line (:line fact))) fact
      ;; a line after it: the same content and memo deps, its offsets moved
      same-spans?
        (assoc fact
          :line line
          :start base
          :spans line-spans
          :line-start (+ (:line-start fact) delta)
          :line-end (+ (:line-end fact) delta))
      else
        (ed-row-fact-of line
          vis
          (:column fact)
          base
          line-spans
          (assoc content :spans (ed-row-content-spans line-spans base vis))
          (+ (:line-start fact) delta)
          (+ (:line-end fact) delta)))))

(defn- ed-spans-moved? (old new delta)
  "Whether the `[start end face]` spans `new` are `old`, each moved `delta` characters —
compared in one walk, nothing built."
  (cond
    (and (empty? old) (empty? new)) true
    (or (empty? old) (empty? new)) false
    else
      (let (old-span (first old)
            new-span (first new))
        (and (vector? old-span)
          (int? (nth old-span 0))
          (int? (nth old-span 1))
          (vector? new-span)
          (= (nth new-span 0) (+ (nth old-span 0) delta))
          (= (nth new-span 1) (+ (nth old-span 1) delta))
          (= (nth new-span 2) (nth old-span 2))
          (ed-spans-moved? (rest old) (rest new) delta)))))

(defn- ed-row-facts-carry (rope hscroll w cell-layout)
  "For an unwrapped pane's rows on a frame `ed-row-facts-at` missed — an edit, a scroll — a
fn from a line to `[fact delta]`: the fact the newest remembered unwrapped call with the same
columns, width and layout has for the same text, and how far the edit between moved it; nil
for a line the edit touched or that call did not show. Nil when there is no such call.

Typing changes the rope, so the whole-pane memo misses on every key; without this every row
was read again from the text (0.75 ms at 213x49), where one line changed. Lines before the
edit keep their offsets, lines after it move by its length (`text/changed-range`)."
  (let (name (symbol (str (reflect/fn-module ed-row-facts-at) "/ed-row-facts-at"))
        entry (seq/find (memo/entries name)
                (fn (entry)
                  (let (key (ed-row-facts-key (first entry)))
                    (and (not (:row-wise? key))
                      (= (:hscroll key) hscroll)
                      (= (:width key) w)
                      (= (:cell-layout key) cell-layout))))))
    (when entry
      (let (key (ed-row-facts-key (first entry))
            old-rope (:rope key)
            old-top (:top key)
            facts (vec (second entry))
            change (text/changed-range old-rope rope)
            ;; `[first-changed last-changed shift-lines shift-chars]` of the edit, in the new text
            edit (when change
                   (let ([start old-end new-end] change
                         new-last (text/char->line rope new-end))
                     [(text/char->line rope start)
                       new-last
                       (- new-last (text/char->line old-rope old-end))
                       (- new-end old-end)])))
        (fn (line)
          (let (moved (cond
                        (nil? edit) [line 0]
                        (< line (nth edit 0)) [line 0]
                        (> line (nth edit 1)) [(- line (nth edit 2)) (nth edit 3)]
                        else nil))
            (when moved
              (let (index (- (first moved) old-top)
                    fact (when (and (>= index 0) (< index (count facts))) (nth facts index)))
                (when (and (map? fact) (= (:line fact) (first moved)))
                  [fact (second moved)])))))))))

(defn- ed-rebase-ranges (ranges base)
  "`[start end face]` `ranges` with both ends made relative to offset `base` — `()` for
none. What a row's memo compares, so a row whose text moved compares equal. A range whose
ends are not numbers is kept as it is (`ed-ranges-on-line` passes those through)."
  (if (empty? ranges)
    '()
    (map ranges
      (fn (range)
        (let ([start end face] range)
          (if (and (int? start) (int? end)) [(- start base) (- end base) face] range))))))

(defn- ed-rebase-overrides (overrides base)
  "`[pos face]` `overrides` with the position made relative to offset `base` — `()` for
none."
  (if (empty? overrides) '() (map overrides (fn (o) (let ([pos face] o) [(- pos base) face])))))

;; How many of the gutter's trailing columns the recessed surface leaves *unpainted*, so the
;; cell's separator space falls on the edit background — a slight light gap between the line
;; number and the text (not a heavy dark band). The gutter cell already reserves that space.
(def *gutter-edit-margin* 1)

(def- ed-gutter-bar-width 0.28) ; the change-bar's width in cells (a thin diff-hl rule)

(defn- ed-gutter-display-chunks (chunks)
  "A gutter cell's `chunks` as `editor/display` chunks for `chunk-ops` to lay out: a text
chunk as itself, a change bar `[:bar colour]` as one blank cell faced `[:bar colour]`, which
`ed-gutter-cell-ops` paints as the bar."
  (map chunks (fn (chunk) (if (= (first chunk) :bar) [" " chunk] chunk))))

(defn- ed-gutter-cell-width (chunks)
  "The cells a gutter cell's `chunks` take — a change bar one, a text chunk its width."
  (fold (ed-gutter-display-chunks chunks)
    0
    (fn (acc chunk) (+ acc (string/display-width (first chunk))))))

(defn- ed-gutter-bar-op (op gui?)
  "The op for a change bar's cell `op` (laid by `chunk-ops`, faced `[:bar colour]`): in the GUI a
thin **full-cell-height** `frect` (a CONTINUOUS solid rule — a half-block glyph leaves a gap at
the 1.4 line-height, reading as a dashed TUI bar), in the terminal the `▌` half-block."
  (let ([_ row col _ face] op
        colour (second face))
    (if gui?
      (frect (+ col 0.0) (+ row 0.0) ed-gutter-bar-width 1.0 {:bg colour})
      (text row col "▌" {:fg colour}))))

(defn- ed-gutter-cell-ops (row col chunks gui?)
  "The render ops for one gutter cell's `chunks` (normalised via `model/gutter-cell-chunks`)
laid left to right from column `col` by std's `chunk-ops` — so a gutter can carry a change bar
*and* the dim line number in one cell (diff-hl), each chunk at its cell width. The web mirror
decodes the same chunks (`web-gutter-html`)."
  (map (chunk-ops row col (ed-gutter-display-chunks chunks))
    (fn (op)
      (let (face (nth op 4 nil))
        (if (and (vector? face) (= (first face) :bar)) (ed-gutter-bar-op op gui?) op)))))

(defn ed-gutter-ops (cells bx by gui? &optional (memo? false))
  "Render ops for prebuilt gutter `cells` (one `[text face]` / `[:bar colour]` chunk list
per visible line, from `spancache/ed-pane-gutter-cells` — cached across frames, since typing
never changes them), placed at column `bx`, rows from `by`. `gui?` picks the change bar's
rendering (frect vs `▌`). `()` when `cells` is nil (gutter hidden / no service). With
`memo?` the ops are a memoised fragment (ADR-336) — off for a scaled pane, whose ops
are transformed after this."
  (if (nil? cells)
    '()
    ;; A memoised fragment (ADR-336): `cells` is the model's cached vector, the same
    ;; object turn after turn, so the ops are reused until the gutter itself changes.
    (ui-memo (if memo? [:gutter bx by] nil)
      [cells bx by gui?]
      (fn ()
        ;; one reversed accumulator across every cell's ops, reversed once — not a list per
        ;; line spliced by `mapcat` over `seq/enumerate`'s index pairs
        (reverse (fold (range (count cells))
                   '()
                   (fn (acc i)
                     (fold (ed-gutter-cell-ops (+ by i) bx (gutter-cell-chunks (nth cells i)) gui?)
                       acc
                       (fn (ops op) (cons op ops))))))))))

(defn- ed-row-cells (cells rows row-wise? top &optional (top-continued false))
  "The gutter `cells` (one per buffer line from `top`) re-keyed per ROW of a wrapped
pane's table: a line's first row gets its cell, a continuation row no number (as Emacs
shows none on a continuation line) but the `wrap/continued-mark` (`ed-continued-cell`). `cells` itself when the table is not `row-wise?` (one line per row from `top`).
With `top-continued` the pane starts part-way through line `top`'s text, so its first rows
continue that line and get the mark too."
  (if (or (not row-wise?) (nil? cells))
    cells
    ;; a line's FIRST text row is the one after a row of another line (or an inlay): not
    ;; `from = 0`, since the line at point may be shown scrolled sideways
    ;; (`wrap/follow-point`) and is still the line its number names
    (let (continued (ed-continued-cell cells))
      (letrec (walk (fn (left previous acc)
                      (if (empty? left)
                        (into [] (reverse acc))
                        (let (row (first left)
                              line (first row)
                              inlay (nth row 3 nil)
                              first? (and (nil? inlay) (not (= line previous))))
                          (walk (rest left)
                            (if (nil? inlay) line previous)
                            (cons (cond
                                    (not first?) (if (nil? inlay) continued '())
                                    (< (- line top) (count cells)) (nth cells (- line top))
                                    else '())
                              acc))))))
        (walk (seq rows) (if top-continued top -1) '())))))

(defn- ed-continued-cell (cells)
  "The gutter cell of a row that continues a wrapped line: no number, the
`wrap/continued-mark` in the number's last column (Emacs's left fringe arrow) — as wide as
the line-number cells in `cells`, so the text after it does not move. Empty when no cell
has a width to match."
  (let (sample (seq/find cells (fn (cell) (not (empty? cell))))
        width (if (nil? sample) 0 (ed-gutter-cell-width (gutter-cell-chunks sample))))
    (if (<= width gutter/line-number-right-margin)
      '()
      [(string/pad-right (string/pad-left wrap/continued-mark
                           (- width gutter/line-number-right-margin))
         width)
        face-truncation])))

;; `gui?` is `(:gui m)` — absent (nil) in a terminal model, never `false`.
(sig ed-pane-gutter-ops (panegeometry/pane-geometry any (or bool nil) -> any))

(defn ed-pane-gutter-ops (geometry cells gui?)
  "The pane's gutter ops from its prebuilt/cached chunk lists `cells`, re-keyed per row of a
wrapped pane (`ed-row-cells`)."
  (ed-gutter-ops (ed-row-cells cells
                   (:rows geometry)
                   (:row-wise geometry)
                   (:top geometry)
                   (:top-continued geometry))
    (:x geometry)
    (:y geometry)
    gui?
    true))

(defn- ed-number-chunk-ops (chunks row col)
  "The current line's number repainted from its gutter `chunks` laid from column `col` on
`row` (`ed-gutter-cell-ops`, the gutter's own layout): the chunk whose role is `:line-number`
(`gutter/line-number-cell`) again in `face-gutter-line-current`, on the gutter's background so it
covers the dim one. Found by its role, not its face: the cells are cached, and a face compared
with the live one stops matching the moment a theme changes it. `()` when no chunk is a line
number (a mark took the column, or relative numbering already painted the line in its current
face, `:line-number-current`)."
  (letrec (walk (fn (left at)
                  (cond
                    (empty? left) '()
                    (= (nth (first left) 2 nil) :line-number)
                      (list (text row
                              at
                              (first (first left))
                              (assoc face-gutter-line-current :bg (:bg face-gutter-bg))))
                    else (walk (rest left) (+ at (ed-gutter-cell-width (list (first left))))))))
    (walk chunks col)))

(defn ed-current-number-ops (pane buf geometry cells)
  "The selected pane's current line number in lavender (`face-gutter-line-current`,
Catppuccin's \"you are here\"), painted over the cached gutter column at the line's first
screen row — an overlay rather than a part of the cells, so a motion leaves the cached
gutter alone (`spancache/ed-gutter-key` holds no point line under absolute numbering). `()`
off the selected pane, with no gutter, or when the line's first row is not on screen."
  (let (line (buffer-current-line buf)
        top (:top geometry)
        index (- line top))
    (if (or (not (:selected pane))
          (nil? cells)
          (< index 0)
          (>= index (count cells))
          (and (= line top) (:top-continued geometry)))
      '()
      (let (row (first (panegeometry/ed-line-screen-rows geometry
                         line
                         (math/max 1 (:text-height geometry)))))
        (if (nil? row)
          '()
          (ed-number-chunk-ops (gutter-cell-chunks (nth cells index))
            (+ (:y geometry) (first row))
            (:x geometry)))))))

(sig ed-pane-text-ops (buffer panegeometry/pane-geometry any any any -> any))

(defn ed-pane-text-ops (buf geometry hl-ranges spans overrides)
  "The pane's visible text rows (`ed-visible-lines`, memoised per row), the whole BODY one
memoised fragment around them (ADR-336): an unchanged pane's text is one lookup, not one
per row.

The body's deps are exactly what `ed-visible-lines` reads, and every one is a value the
model keeps between turns, so on a frame where nothing in the body moved they are the SAME
cells and `=` answers at once:
- the rope — the text (identity: an edit makes a new one);
- `spans` — the `:span-cache` band's own vector (or the buffer's `:face-spans`);
- the viewport — `:top`, `:render-height` (the smooth-scroll extra row and a narrowing are
  in it), `:hscroll`, the wrapped row table `:rows` (`wrap/rows-from`'s memoised vector) —
  and the text area's `x` and width (the gutter width and the pane's rect are in those);
- `hl-ranges` — the sources' ranges, the region, the overlays, remote selections and the link hover,
  with their faces (a theme switch re-derives `face-region`, so it shows up here);
- `overrides` — the bracket/diagnostic table by line (`ed-overrides-by-line-at`'s own map
  while there is no diagnostic underline; a small `=` walk while there is);
- the theme's generation (`theme/generation`) — the body paints faces it is not handed (a
  cut row's mark in `face-truncation`, an inlay row in `face-inlay-line`);
- the cell layout (`conventions/cell-layout-key`: the tab width, how glyphless characters
  show) — the same text lays out differently under another.
`y` is in the key. Those are also the union of every row's deps, so when the body misses
the rows still answer one by one — a `C-n` that moved the bracket pair re-renders the two
rows it touched, as before; when it hits, the stored ops carry the rows' own markers
(`%ui-harvest` keeps an entry's ops as emitted), so the next turn's rows still find
theirs."
  (let ([x width] (panegeometry/geometry-span geometry :text)
        y (:y geometry)
        top (:top geometry)
        height (:render-height geometry)
        hscroll (:hscroll geometry)
        rows (:rows geometry)
        row-wise? (:row-wise geometry))
    ;; check-allow: the thunk's only effects are the row-facts and span-slice memo stores
    ;; (`defmemo`), which answer the same whether this turn ran them or not
    (check-allow :pure
      (ui-memo [:body x y]
        [(buffer-rope buf)
          spans
          top
          height
          hscroll
          rows
          width
          hl-ranges
          overrides
          (theme/generation)
          (conventions/cell-layout-key)]
        (fn ()
          (ed-visible-lines buf
            top height x y width hl-ranges spans overrides hscroll rows row-wise? true))))))

;; ---- the layers behind and beside the text: bands, the gutter surface, the margin ----
;; Full-row backgrounds, and the columns the text was narrowed for, laid out over the same
;; `panegeometry` map as the text and drawn before it.

(sig ed-hl-line-band (model map buffer panegeometry/pane-geometry -> any))

(defn ed-hl-line-band (m pane buf geometry)
  "The hl-line current-line highlight: a `geometry-band` behind each row the line at point
occupies (`ed-line-screen-rows`: one for an unwrapped line, every continuation row of a
wrapped one, as Emacs highlights the whole logical line). It starts at the text, never in
the gutter (Emacs `hl-line-mode`, sans the fringe), and runs to the pane's edge. Painted
only on the selected pane with `:hl-line` on and **no** active region, and only for rows on
screen (`:text-height`). `()` otherwise. Drawn before the text so it sits behind it."
  (if (and (:hl-line m) (:selected pane) (nil? (buffer-region-bounds buf)))
    (map (panegeometry/ed-line-screen-rows geometry
           (buffer-current-line buf)
           (math/max 1 (:text-height geometry)))
      (fn (row) (panegeometry/geometry-band geometry (first row) face-hl-line)))
    '()))

(defn- ed-region-eol-band (buf geometry lo hi line)
  "The region band filling `line`'s end-of-text → right-edge gap, or nil: when the region
`[lo, hi]` covers the line THROUGH its end and the line's last row is on screen. Reaching
the end of the text is enough; the newline itself need not be inside, which is the
difference between a selection that stops flush against the last character and one that
reads as covering the line. The last line of a region is the case that shows it, and it is
the one a reader looks at. It runs to the end of the `:row` span: the right margin, or the
pane's edge."
  (let (rope (buffer-rope buf)
        bol (text/line->char rope line)
        ;; the length from the line bounds, not from a copy of the line's text
        line-len (- (textpos/ed-line-end rope line) bol)
        eol (+ bol line-len)
        row (when (and (<= lo eol) (<= eol hi))
              (panegeometry/ed-line-last-row geometry line (math/max 1 (:text-height geometry)))))
    (when row
      (let ([k _from _to entry] row
            [x width] (panegeometry/geometry-span geometry :row)
            ;; where the row's text ends (`wrap/row-cell`: its prefix, its inline
            ;; annotations, the line's tabs)
            end-column (wrap/row-cell rope entry line-len)
            band-width (- width end-column))
        (when (> band-width 0)
          (rect (+ (:y geometry) k) (+ x end-column) band-width 1 face-region))))))

(sig ed-region-eol-bands (buffer panegeometry/pane-geometry -> list))

(defn ed-region-eol-bands (buf geometry)
  "Region-selection bands filling each fully-selected line's end-of-text → right-edge gap,
so an empty or short line whose newline lies inside the region shows the selection through
end-of-line (Emacs region highlighting). The char-range region tint (`region/region-ranges`) only
paints actual text; this is its full-width counterpart — the same relationship
`ed-hl-line-band` has to the per-line cursor. `()` when no region is active. Laid out over
the `:text-height` rows. The band sits on the line's LAST row (`ed-line-last-row`), after that
row's text. Bottom line first."
  (let (region (buffer-region-bounds buf))
    ;; a rectangle region stops at its right column: no fill past a line's end
    (if (or (nil? region) (bufferops/rectangle-mark-active? buf))
      '()
      (let (top (:top geometry)
            last-line (math/min (dec (buffer-line-count buf))
                        (dec (+ top (math/max 1 (:text-height geometry))))))
        (seq/keep (reverse (range top (inc last-line)))
          (fn (line) (ed-region-eol-band buf geometry (first region) (second region) line)))))))

(defn ed-gutter-bg-ops (geometry)
  "The line-number gutter's own recessed surface, short of the edit margin; `[]` with no
gutter."
  (let ([x gutter-width] (panegeometry/geometry-span geometry :gutter))
    (if (> gutter-width 0)
      [(rect (:y geometry)
         x
         (math/max 0 (- gutter-width *gutter-edit-margin*))
         (:text-height geometry)
         face-gutter-bg)]
      [])))

(defn ed-right-margin-ops (buf geometry)
  "The buffer's right margin (`:right-margin`, `{:width :lines {line [[text face] …]}}`):
each shown line's segments painted in the margin's column at the pane's right edge, on the
line's first screen row — Emacs's right margin, where Magit's log keeps who and when. The
text area was narrowed for it (`:margin-width`), so a long line is cut before it rather
than painted under it. `()` for a buffer without one."
  (let (margin (:right-margin buf))
    (if (nil? margin)
      '()
      (let (top (:top geometry)
            height (:render-height geometry)
            end (math/min (+ top height) (buffer-line-count buf))
            x (first (panegeometry/geometry-span geometry :margin))
            lines (:lines margin))
        (mapcat (range top end)
          (fn (line)
            (let (segments (get lines line)
                  row (when segments
                        (first (first (panegeometry/ed-line-screen-rows geometry line height)))))
              (if (not (int? row))
                '()
                (second (fold segments
                          [x '()]
                          (fn ([col ops] segment)
                            (let ([s face] segment)
                              [(+ col (string/display-width s))
                                (conj ops (text (+ (:y geometry) row) col s face))]))))))))))))

(defn ed-line-band-ops (buf geometry)
  "The buffer's line backgrounds (`:line-bands`, `{line face}`): a band across the text area
behind each shown line, every screen row of a wrapped one — a diff's added and removed lines
tinted whole, Magit's `magit-diff-added`, rather than only as far as their text reaches.
Drawn first, so the hl-line band and the region sit over it. `()` for a buffer without any."
  (let (bands (:line-bands buf))
    (if (empty? bands)
      '()
      (let (top (:top geometry)
            height (math/max 1 (:text-height geometry))
            end (math/min (+ top height) (buffer-line-count buf)))
        (mapcat (seq/filter (range top end) (fn (line) (contains? bands line)))
          (fn (line)
            (map (panegeometry/ed-line-screen-rows geometry line height)
              (fn (row) (panegeometry/geometry-band geometry (first row) (get bands line))))))))))
