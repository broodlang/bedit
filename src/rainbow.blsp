(defmodule rainbow
  "Brackets coloured by depth in a tree-sitter buffer (Emacs's `rainbow-delimiters-mode`,
which the user turns on from `prog-mode-hook`), on with the init file's
`:rainbow-delimiters` (`theme/*rainbow-delimiters*`). The Lisp modes colour theirs in their
own lexer (`editor/highlight/lisp-line-lexer`); this is every language with a held parse.

A bracket here is a DELIMITER TOKEN of the parse, as show-paren's is (`tsbrackets`): an
anonymous leaf whose last character opens or whose first closes, so a `(` in a string or a
comment is not one. The depth at the top of the window comes from the tree — the bracketed
nodes around that offset, each a node whose text opens with a bracket and closes with its
partner — and the window's own brackets count up and down from it. One chain query per
bracket on screen and one for the window's top: the cost is the window, whatever the size
of the file. A pair in the middle of its node (an HCL block's braces) is not seen from
above, so the window starting inside one colours its brackets a level shallower."
  (:use editor/buffer) ; buffer-rope
  (:use model :only [register-highlight-source message]) ; a pane's ranges; the toggle says so
  (:use interactive) ; defcommand — M-x rainbow-delimiters-mode
  (:use memo)) ; defmemo — asked every frame, recomputed when the text or the window moves

(def- closer-of {"(" ")" "[" "]" "{" "}"})
(def- openers #{"(" "[" "{"})
(def- closers #{")" "]" "}"})

(def *rainbow-depths* 9) ; the faces `:syntax/delimiter-1` … `-9`, cycling past the ninth

(sig depth-name (int -> keyword))
(defn depth-name (depth)
  "The face NAME of a bracket at `depth` (1 outermost), cycling past `*rainbow-depths*`."
  (keyword (str "syntax/delimiter-" (inc (math/mod (dec depth) *rainbow-depths*)))))

(defn- depth-face (depth)
  "The face of a bracket at `depth`: `depth-name`'s, as the theme defines it now."
  (editor/face/face (depth-name depth)))

(defn- chain-at (tree offset)
  ;; the nodes from the root down to the leaf at `offset`, `[]` for a gone handle
  (check-allow :discarded-catch
    (try (or (%tree-sitter-tree-chain tree offset) []) (catch _ []))))

(sig char-at (any int -> any))
(defn- char-at (rope offset)
  (when (and (>= offset 0) (< offset (count rope))) (text/slice rope offset (inc offset))))

(defn- delimiter? (tree offset open?)
  ;; whether the bracket at `offset` is a delimiter token: the leaf the chain ends at is
  ;; anonymous, and an opener ends it (`$(`) while a closer begins it (`))`)
  (let (leaf (last (chain-at tree offset)))
    (and leaf
      (not (:named leaf))
      (not (:container leaf))
      (if open? (= offset (dec (:end leaf))) (= offset (:start leaf))))))

(defn depth-at (tree rope offset)
  "How many bracketed nodes enclose `offset`: each node of the chain there whose text opens
with a bracket before `offset` and closes with its partner after it, two nodes of one extent
counted once."
  (count (into #{}
           (seq/keep (chain-at tree offset)
             (fn (node)
               (let (start (:start node)
                     end (:end node))
                 (when (and (int? start)
                         (int? end)
                         (contains? openers (char-at rope start))
                         (< start offset)
                         (< offset (dec end))
                         (= (char-at rope (dec end)) (get closer-of (char-at rope start))))
                   start)))))))

(defn window-ranges (tree rope from to &optional (face-of depth-face))
  "The `[pos (inc pos) face]` ranges of the delimiter brackets in `rope` between offsets
`from` and `to`, each in the face `face-of` gives its depth: an opener one deeper than what
encloses it, a closer the depth of the opener it ends."
  (let (text (text/slice rope from to)
        n (count text))
    (letrec (walk (fn (i depth acc)
                    (if (>= i n)
                      (reverse acc)
                      (let (c (string/char-at text i)
                            at (+ from i))
                        (cond
                          (and (contains? openers c) (delimiter? tree at true))
                            (walk (inc i)
                              (inc depth)
                              (cons [at (inc at) (face-of (inc depth))] acc))
                          (and (contains? closers c) (delimiter? tree at false))
                            (walk (inc i)
                              (math/max 0 (dec depth))
                              (cons [at (inc at) (face-of (math/max 1 depth))] acc))
                          else (walk (inc i) depth acc))))))
      (walk 0 (depth-at tree rope from) '()))))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what `window-ranges` built, a list of ranges.
(check-allow :trusted
  (defmemo ranges-at 4 (tree rope from to faces)
    "`window-ranges`, remembered on what it reads (`faces` is the delimiter faces, so a theme
switch recomputes)."
    (window-ranges tree rope from to)))

(sig ranges (any any any int int -> any))
(defn ranges (m idx buf top rows)
  "The rainbow ranges for pool buffer `idx` (`buf`) over lines `top` through `top + rows`:
`()` with `:rainbow-delimiters` off or no parse held of exactly this text."
  (let (entry (when (and theme/*rainbow-delimiters* (not (solong/so-long? buf)))
                (syntaxtree/current-syntax-tree m idx buf)))
    (if (or (nil? entry) (nil? (:tree entry)))
      ()
      (let (rope (buffer-rope buf)
            lines (text/line-count rope)
            last-line (+ top rows 1))
        (ranges-at (:tree entry)
          rope
          (text/line->char rope (math/max 0 (math/min top (dec lines))))
          (if (>= last-line lines) (count rope) (text/line->char rope last-line))
          (map (range 1 (inc *rainbow-depths*)) depth-face))))))

(defn highlight-source (m pane buf context)
  "The registry row: [[ranges]] for the buffer this pane shows, under every other highlight."
  (ranges m (map/get-in pane [:payload :buffer]) buf (:top context) (:rows context)))

(defn highlight-deps (m pane buf)
  "What [[highlight-source]] reads off the model: the switch and the held parse."
  (let (entry (syntaxtree/syntax-tree-entry m (map/get-in pane [:payload :buffer])))
    [theme/*rainbow-delimiters* (:tree entry) (:rope entry)]))

(register-highlight-source :rainbow
  {:rank 10 :run 'rainbow/highlight-source :deps 'rainbow/highlight-deps})

(defcommand cmd-rainbow-delimiters-mode
  (m key)
  "Turn brackets coloured by depth on or off everywhere (M-x rainbow-delimiters-mode, Emacs's) —
for this session; init.blsp's `:rainbow-delimiters` says how the editor starts. The colours
change at once: a Lisp's line lexer rebuilds when the switch moves, and the panes' bands are
coloured again."
  (let (on (not theme/*rainbow-delimiters*))
    (do
      (theme/set-rainbow-delimiters on)
      (message (dissoc m :span-cache)
        (if on "Rainbow delimiters on" "Rainbow delimiters off")))))
