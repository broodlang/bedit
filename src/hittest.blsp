(defmodule hittest
  "**Where did the pointer land?** — the mouse side of the view: every hit-test and hover
fold that turns a screen cell into a model change. The view (`src/view.blsp`) is a pure
`model -> frame`; these take a model and RETURN one (`:hover`, `:diag-hover`,
`:link-hover`, a clicked chip's command), which is why they are not in it — and why
`input` reads them here rather than importing the renderer.

None of them keeps geometry of its own. Each recomputes what the view drew from the SAME
function the view drew it with — the status-bar segments and their layout, the context
menu widget, the pane layout, the diagnostic underline's span — and hit-tests against
that, so a click or a hover can never land a cell away from the glyphs it is about."
  (:use editor/buffer) ; buffer-rope / buffer-line-at — the line under the pointer
  (:use model) ; ed-mode-service / ed-diag-col0 — the `:line-loc` service, a finding's column
  (:use mouse)
  (:use panes) ; ed-pane-at / ed-select-pane-at / ed-pane-buf / ed-pane-line-at — pane geometry
  (:use statusbar) ; statusbar-zones / seg-by-id / seg-interactive? — the bar's zones
  (:use ui-kit) ; ui-in-rect? — inside the menu card but off an item
  (:use editor/display) ; zone-at — the hit-test over a widget's zones
  ;; what was drawn, asked again: the bar's segments, the pane whose bar is under the
  ;; pointer, the menu card
  (:use modeline :only [ed-statusbar-segments ed-modeline-pane-at ed-pointer-layout])
  (:use overlayview :only [ed-menu-widget]))

(defn- ed-pointed-pane (m cols rows row col)
  "The pane under screen cell `[row col]`, or nil — `mouse/ed-pane-at` over the view's
remembered layout (`ed-pointer-layout`): one pointer move asks this of the bar, the
diagnostics and the links in turn, and the pane tree is laid out for the first of them only."
  (editor/pane/pane-at (ed-pointer-layout m cols rows) [row col]))

;; ---- status-bar hit-testing (the mouse side of the bar) ----------------------
;; The mouse handler recomputes the hovered pane's segment layout — the same one the view
;; drew — and hit-tests the pointer against its zones, exactly as `ed-menu-hit` recomputes the
;; menu card's rect. So a segment is hoverable / clickable precisely where its glyphs are.

(defn ed-modeline-segment-at (m cols rows col row)
  "The status-bar segment under screen cell `[col row]` on whichever pane's mode line holds
it, or nil (no mode line there, or a gap between segments). What hover (`:move`) and click
hit-test against — the caller reads the returned segment's `:on-click` / `:tooltip`."
  (let (pane (ed-modeline-pane-at m cols rows col row))
    (if (nil? pane)
      nil
      (let ([x y w ph] (:rect pane)
            buf (ed-pane-buf m pane)
            segs (ed-statusbar-segments m pane buf)
            ;; the zones only, remembered on what places them (`statusbar-zones`)
            z (zone-at (statusbar-zones segs x (+ y (dec ph)) w (:gui m)) col row))
        (if (nil? z) nil (seg-by-id segs (:id z)))))))

(defn ed-modeline-click (m cols rows col row)
  "If a status-bar segment with an `:on-click` command sits under press `[col row]`, run that
command (resolved late via `reflect/eval`, like a keymap binding — `(m key) -> m`) and return the new
model; else nil. The mouse handler tries this before its normal left-press handling, so a
click on the branch / git indicator opens `*git-status*` instead of moving point. The pane
under the click is SELECTED first, so a command that acts on the current pane (the zoom
chip's `text-scale-reset`) acts on the one whose bar was clicked."
  (let (s (ed-modeline-segment-at m cols rows col row))
    (if (and s (:on-click s))
      ((reflect/eval (:on-click s)) (dissoc (ed-select-pane-at m cols rows row col) :hover)
        ; dismiss the tooltip as the click fires
        :mouse)
      nil)))

(defn ed-modeline-hover (m cols rows col row)
  "Fold a bare pointer move over the status bar into `:hover` (`{:id :col :row}`, read by the
renderer to draw the hover pill + tooltip): set it to the segment under `[col row]`, or clear
it when the pointer is off any segment. Never touches scroll — a hover must not snap the view
back to point (the GUI emits a `:move` per cell crossed)."
  (let (s (ed-modeline-segment-at m cols rows col row))
    (cond
      (and s (seg-interactive? s)) (assoc m :hover {:id (:id s) :col col :row row})
      (:hover m) (dissoc m :hover)
      else m)))

;; ---- the tab bar ----------------------------------------------------------------

(defn ed-tab-bar-click (m cols rows col row)
  "A left press on the tab bar at `[col row]`: the model with the tab under it shown, or
closed when the press is on its ×, hit-tested against the zones the bar was painted with
(`tabbar/tab-bar-widget`); nil off the bar, or on the bar between tabs."
  (when (< row (ed-tab-bar-rows m))
    (let (hit (zone-at (:zones (tabbar/tab-bar-widget m cols)) col row))
      (when hit (tabbar/tab-bar-clicked m (:id hit))))))

;; ---- the pointer over a pane's text -------------------------------------------

(defn- ed-without (m key)
  "`m` with the hover state under `key` cleared — `m` itself when there is none, so a move
over nothing changes nothing."
  (if (key m) (dissoc m key) m))

(defn- ed-text-line-at (pane buf row)
  "The buffer line under screen row `row` of `pane`'s TEXT area (`ed-pane-line-at`), or nil
— below the buffer's last line there is nothing to point at, and the mode-line row is not
text."
  (let ([_px py _pw ph] (:rect pane)
        line (ed-pane-line-at pane buf row))
    (when (and (int? line) (< row (+ py (dec ph)))) line)))

(defn- ed-link-line-at (m pane row)
  "The line under `row` of `pane` when it is a clickable line of a results buffer — its
mode has `:line-loc` and that resolves the line — else nil."
  (let (buf (ed-pane-buf m pane)
        svc (ed-mode-service buf :line-loc)
        line (ed-text-line-at pane buf row))
    (when (and svc line (svc buf line)) line)))

(sig ed-results-link-at (map int int int int -> (or nil vector)))
(defn ed-results-link-at (m cols rows row col)
  "A left-click hit-test for the RESULTS-buffer link-only-click rule: `[:link loc]`
when cell `(row,col)` is on a clickable line of a results buffer (its mode has
`:line-loc` and that line resolves), `[:inert]` when a results buffer but a non-link
line (so the click does NOTHING), or `nil` for an ordinary buffer/pane (normal
click). Same `:line-loc` predicate as the pointer cursor + underline, so the click
matches exactly what reads as a link."
  (let (pane (ed-pointed-pane m cols rows row col))
    (when pane
      (let (buf (ed-pane-buf m pane)
            svc (ed-mode-service buf :line-loc))
        (when svc
          (let (line (ed-text-line-at pane buf row)
                loc (when line (svc buf line)))
            (if (nil? loc) [:inert] [:link loc])))))))

(defn ed-diags-at (buf line0 col0)
  "The diagnostics on `line0` whose underlined span covers column `col0` — `()` when none
does.

The span is `ed-diag-span-end`'s, the SAME one that draws the underline, so the thing you
hover is exactly the thing that is marked. Computing the target a second way is how a
tooltip comes to appear a column short of the squiggle it belongs to."
  (let (lt (buffer-line-at buf line0))
    (seq/filter (get (results/diagnostic-lines buf) line0 '())
      (fn (d)
        (let (from (diagstore/ed-diag-col0 d))
          (and (>= col0 from) (< col0 (diagstore/ed-diag-span-end lt from))))))))

(defn- ed-diags-under (m pane col row)
  "The diagnostics under pointer `[col row]` in `pane`: every one on the line when the
pointer is on its margin mark (the middle of the gutter→text gap), else those whose
underlined token holds the character under it. `()` off the text."
  (let (buf (ed-pane-buf m pane)
        line (ed-text-line-at pane buf row))
    (if (nil? line)
      '()
      (let ([px _py _pw _ph] (:rect pane)
            gutter-width (ed-pane-gutter-width buf pane)
            [rw _rh] (ed-zoom-ratio pane)
            column (math/floor (/ (math/max 0 (- col px)) rw)))
        (if (and (> gutter-width 0) (= column (- gutter-width 2)))
          (get (results/diagnostic-lines buf) line '())
          (let (offset (ed-row-offset-at buf
                         (ed-pane-row-entry pane buf row)
                         gutter-width
                         rw
                         px
                         col))
            (ed-diags-at buf line (- offset (text/line->char (buffer-rope buf) line)))))))))

(sig ed-diag-hover (map int int number number -> map))
(defn ed-diag-hover (m cols rows col row)
  "Fold a bare pointer move into `:diag-hover` — `{:row :col :lines}` for a cell over a
diagnostic's underlined token or over its margin mark (`ed-diags-under`) — else clear it.

Both targets, because both are the mark: the squiggle says WHERE and the glyph in the
margin says THAT, and a reader reaches for whichever is nearer. The message is resolved
here rather than at paint time so the renderer stays a pure read. `col` `row` may be
fractional (`mouse/ed-mouse-at`): the pane is found by the cell they are in, the token
under them by the exact position."
  (let (cell-row (math/floor row)
        cell-col (math/floor col)
        pane (ed-pointed-pane m cols rows cell-row cell-col)
        lines (if (nil? pane)
                '()
                (mapcat (ed-diags-under m pane col row)
                  (fn (d) (string/split (or (:message d) "") "\n")))))
    (if (empty? lines)
      (ed-without m :diag-hover)
      (assoc m :diag-hover {:row cell-row :col cell-col :lines (into [] lines)}))))

(sig ed-link-hover (map int int number number -> map))
(defn ed-link-hover (m cols rows col row)
  "Fold a bare pointer move into `:link-hover` (`{:buffer <pool idx> :line <0-based>}`)
when the cell is over a clickable line of a results buffer (`ed-link-line-at`), else clear
it. Drives the subtle hover highlight + the pointer cursor's per-line target; never touches
scroll. `row` may be fractional, as in `ed-diag-hover`."
  (let (pane (ed-pointed-pane m cols rows (math/floor row) (math/floor col))
        line (when pane (ed-link-line-at m pane row)))
    (if (nil? line)
      (ed-without m :link-hover)
      (assoc m :link-hover {:buffer (map/get-in pane [:payload :buffer]) :line line}))))

;; ---- links in the text: a terminal's OSC 8 hyperlinks ---------------------------------------
;; A buffer may carry `:text-links`, `[start end uri]` runs over its text (a terminal's, from
;; the screen its program drew). Ctrl over one shows it as a link — the pointer cursor and an
;; underscore — and a Ctrl-click opens it (`mouse/ed-mouse`). Ctrl, as every terminal asks,
;; so a plain click still selects text.

(defn ed-text-link-hover (m cols rows at mods)
  "Fold a bare pointer move into `:text-link-hover` (`{:buffer :start :end :uri}`) when Ctrl
is held over a link in the text (`mouse/ed-text-link-at`), else clear it. The value is the
link's, not the pointer's, so moving along one link leaves the model as it was and nothing
repaints."
  (let (link (when (includes? mods :ctrl) (ed-text-link-at m cols rows at)))
    (if (nil? link)
      (ed-without m :text-link-hover)
      (let ([buffer start end uri] link
            hover {:buffer buffer :start start :end end :uri uri})
        (if (= hover (:text-link-hover m)) m (assoc m :text-link-hover hover))))))

;; ---- the context menu ------------------------------------------------------

(defn ed-menu-hit (m cols rows col row)
  "Classify a click over the open menu via the widget's zones: `[:run i]` on an enabled
item, `:inside` when inside the card but off an item (a divider / disabled row / padding —
the menu stays open), or nil when outside (dismiss). One widget drives both this and the
render, so the click can't disagree with what's drawn."
  (let (w (ed-menu-widget m cols rows)
        z (zone-at (:zones w) col row))
    (cond
      (not (nil? z)) [:run (second (:id z))] ; z's :id is [:menu-run i]
      (let (a (:area w)) (and a (ui-in-rect? a col row))) :inside
      else nil)))
