(defmodule config
  "The editor's **user init file** — `~/.config/bedit/init.blsp` (honouring
`$XDG_CONFIG_HOME`). On launch the editor ensures the file exists (writing a
documented default the first time, so there's always something to edit), then reads
it as **data** and applies it. The file holds a single declarative `(config …)`
form — a tiny DSL, *not* arbitrary code — so it's safe to read without evaluating it
(mirrors the build tool's `~/.config/brood/config.blsp`, and sidesteps the namespace
pitfall of `(reflect/load)`-ing a bare DSL — ADR-065).

Every key is a SETTING declared once below with `settings/define` (brood ADR-428,
std's `settings`): its default, its type, and its doc — which is also the comment above
it in the generated default file. That one declaration is the check `config-warnings`
makes, the fallback `setting` answers, and the line `*init-default-source*` writes; a
package declares its own under `:bedit/settings` the same way. Some notes the docs
leave out:

  :fullscreen  `window-mode` maps the value; `main` applies it.
  :text-aa / :line-height / :text-contrast / :ligatures  window settings `apply-window!` applies at
               startup and on `M-x reload-config`.
  :welcome     `\\[command]` holes render as that command's live key binding
               (`main/welcome-text`); keep a link line's marker text
               (`modes/*welcome-links*`) and it stays clickable. Startup-only.

The path / read / write helpers mirror `projects.blsp`'s cache idioms; read and
ensure are path-parameterised so tests drive them without touching the real
`~/.config`. `main` calls `(init-config)` once at startup and applies the map."
  (:use ownership :only []) ; its registrations are claimed at load
  (:use config-paths) ; the init file's path, the test-run guard
  (:use display-rules)) ; the `:display-buffer` setting's default and validator

(def *window-options*
  ;; What every bedit window opens with — the main one, a C-x 5 2 frame, an --attach
  ;; client's and the --serve host's: the desktop identity, and the desktop's own key
  ;; repeat (its delay and rate, as plain presses — brood ADR-441). bedit has no repeat
  ;; of its own, so a window opened without `:key-repeat :os` would not repeat a held key.
  {:app-id *app-id* :key-repeat :os})

;; ---- the settings -------------------------------------------------------------
;; Declared in the order the default file lists them. `:model-key` is bedit's own spec
;; field: the model key `apply-to-model` seeds with the setting's value. `:safe true` is
;; another: a project's `.bedit-locals.blsp` may set it (`dirlocals`, Emacs's
;; safe-local-variable) — a layout convention or a display switch, nothing that runs code.

(def *settings* :bedit/settings) ; the registry id every bedit setting is declared under

(defn line-height-in-range? (value)
  "True when `value` is a number in the window's 0.8..3.0 range — what `gui/line-height`
clamps to, so a value outside it is a typo (pixels, say), not a taste."
  (and (number? value) (>= value 0.8) (<= value 3.0)))

(defn text-contrast-in-range? (value)
  "True when `value` is a number in the window's 0.5..3.0 range (what `gui/text-contrast`
clamps to)."
  (and (number? value) (>= value 0.5) (<= value 3.0)))

(settings/define *settings*
  :fullscreen {:default false
   :type '(or :maximized :fullboth :fullscreen true false)
   :doc (str "how the window opens (like Emacs init.el's `fullscreen` frame parameter):\n"
          "  :maximized  fill the screen, keep the title bar\n"
          "  :fullboth   true fullscreen — no title bar\n" "  false       a normal window")})

(settings/define *settings*
  :hl-line {:default true
   :type 'bool
   :model-key :hl-line
   :doc "highlight the current line across the whole width (Emacs hl-line); false to disable"})

(settings/define *settings*
  :mouse-drag-copy-region {:default false
   :type 'bool
   :model-key :mouse-drag-copy-region
   :commented? true
   :doc (str "true: a mouse drag-select also copies its text to the kill ring and the OS\n"
          "clipboard (Emacs's mouse-drag-copy-region). Off, a drag only sets the PRIMARY\n"
          "selection a middle click pastes, and what you copied elsewhere stays put")})

(settings/define *settings*
  :header-line {:default false
   :type 'bool
   :model-key :header-line
   :commented? true
   :doc (str "a header line above each window naming where you are: the file by its project\n"
          "and path, then the heading or definition at point (Emacs's breadcrumb-mode)")})

(settings/define *settings*
  :tab-bar {:default false
   :type 'bool
   :model-key :tab-bar
   :commented? true
   :doc (str "the tab bar always at the top of the frame (Emacs's tab-bar-mode); off, it shows\n"
          "only while there is more than one tab (C-x t 2 opens one)")})

(settings/define *settings*
  :cursor {:default :block
   :type '(or :block :bar :hollow)
   :model-key :cursor-style
   :doc "the caret shape (every buffer): :block (the wide box), :bar (a thin line) or :hollow"})

(settings/define *settings*
  :cursor-other-windows {:default :hollow
   :type '(or :hollow :block :bar false)
   :model-key :cursor-other-windows
   :commented? true
   :doc (str "the caret in a window that is not selected, and in every window while the\n"
          "minibuffer has the keyboard: :hollow (Emacs's cursor-in-non-selected-windows),\n"
          ":block, :bar, or false for none")})

(settings/define *settings*
  :completion-auto {:default {:default true}
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :model-key :completion-auto
   :commented? true
   :example {:default true :markdown true :yaml false}
   :doc (str "open the completion popup on its own after a pause in typing (Emacs corfu-auto):\n"
          "per mode, in code modes and config formats but not in prose (Markdown, Org, text,\n"
          "commit messages, mail), which complete on demand with C-M-i; a map's entry for\n"
          "a mode (:prog, :text, :markdown…) wins, true / false sets it everywhere, and false\n"
          "brings back the inline preview")})

(settings/define *settings*
  :markdown-preview {:default false
   :type 'bool
   :model-key :markdown-preview-auto
   :commented? true
   :doc (str "open the rendered preview beside a markdown buffer on its own (C-c C-p opens\n"
          "and closes it by hand either way; once closed it stays closed until C-c C-p)")})

(settings/define *settings*
  :spell-check {:default true
   :type 'bool
   :model-key :spell-check?
   :commented? true
   :doc (str "underline misspelled words in the visible text (Emacs's global-jinx-mode): every\n"
          "word in prose, comments and strings in code. Needs enchant-2 or aspell")})

(settings/define *settings*
  :spell-language {:default nil
   :type 'string
   :model-key :spell-language
   :commented? true
   :example "en_GB"
   :doc "the dictionary to check in (C-M-$ picks one live); nil uses the locale's"})

(settings/define *settings*
  :completion-auto-delay {:default 200
   :type 'int
   :model-key :completion-auto-delay
   :commented? true
   :doc "the pause in typing, in ms, before the completion popup opens (corfu-auto-delay)"})

(settings/define *settings*
  :completion-auto-prefix {:default 2
   :type 'int
   :model-key :completion-auto-prefix
   :commented? true
   :doc "how many word characters before point open the completion popup (corfu-auto-prefix)"})

(settings/define *settings*
  :completion-popupinfo {:default true
   :type 'bool
   :model-key :completion-popupinfo
   :commented? true
   :doc "show the selected completion's documentation beside the popup (corfu-popupinfo)"})

(settings/define *settings*
  :blink-cursor-blinks {:default 10 ; model's `*blink-cursor-blinks*`, Emacs's own default
   :type 'int
   :model-key :blink-cursor-blinks
   :commented? true
   :doc (str "how many times the caret blinks at rest before it stays solid (Emacs\n"
          "blink-cursor-blinks); any key or click starts it over. 0 blinks forever")})

(settings/define *settings*
  :dired-listing-switches {:default "-al"
   :type 'string
   :model-key :dired-listing-switches
   :commented? true
   :doc (str "how Dired orders a listing, as `ls` switches (Emacs dired-listing-switches):\n"
          "  -al by name, folders and files mixed · t by date · S by size · X by extension\n"
          "  · U unsorted · r reversed. s in Dired toggles name and date; C-u s edits them")})

(settings/define *settings*
  :delete-by-moving-to-trash {:default true
   :type 'bool
   :model-key :delete-by-moving-to-trash
   :commented? true
   :doc (str "Dired's D and x move what they delete to the desktop's trash, where it can be\n"
          "restored (Emacs delete-by-moving-to-trash); false deletes for good, after a\n"
          "question naming how many files a directory takes")})

(settings/define *settings*
  :wdired-allow-to-redirect-links {:default true
   :type 'bool
   :model-key :wdired-allow-to-redirect-links
   :commented? true
   :doc (str "in wdired (C-x C-q in Dired) a symlink's target after ` -> ` is editable too, and\n"
          "C-c C-c re-points the link (Emacs wdired-allow-to-redirect-links)")})

(settings/define *settings*
  :wdired-allow-to-change-permissions {:default false
   :type '(or bool :advanced)
   :model-key :wdired-allow-to-change-permissions
   :commented? true
   :doc (str "in wdired the `rwxr-xr-x` column is editable (Emacs wdired-allow-to-change-permissions):\n"
          "  true: each character toggles — SPC flips it, r w x s t S T or - sets it\n"
          "  :advanced: free text, read as `ls -l` shows it · false: not editable")})

(settings/define *settings*
  :text-aa {:default :auto
   :type '(or :auto :gray :subpixel :bgr)
   :commented? true
   :doc (str "text anti-aliasing: :auto (subpixel/LCD text at 1x, grayscale on HiDPI), :gray,\n"
          ":subpixel (an RGB panel) or :bgr — subpixel is crisper on a 1x display")})

;; The editor font, any installed family by its name (brood ADR-442; a family not installed
;; falls back to the bundled DejaVu Sans Mono, which startup and M-x reload-config say in the
;; echo area and *Messages* — `startup/font-warning`). Hack is the default, and the heavy end of the
;; coding faces: at 15 px it lays down a quarter to two-fifths more ink than Ubuntu Sans
;; Mono (H 40.6 px of coverage against 29.0, m 36.6 against 26.0, swash's own raster). A theme
;; keeps this font unless it names one.
(settings/define *settings*
  :font {:default "Hack"
   :type 'string
   :commented? true
   :doc (str "the editor font: an installed family by name (\"Hack\", \"Ubuntu Sans Mono\",\n"
          "\"JetBrains Mono\", \"DejaVu Sans Mono\"); `fc-list : family` lists them. One not\n"
          "installed falls back to the bundled DejaVu Sans Mono, and the editor says so")})

;; The theme the window opens in. Unset, the palette is theme.blsp's Catppuccin Mocha; a name
;; M-x theme-select lists swaps the colours (and its font, for a theme that names one) at
;; startup and on M-x reload-config.
(settings/define *settings*
  :theme {:default nil
   :type 'string
   :commented? true
   :example "Modus Vivendi Tinted"
   :doc (str "the colour theme to open in, by its M-x theme-select name (\"Modus Vivendi Tinted\",\n"
          "\"Nord\", \"Tokyo Night\" …); unset, the desktop's light or dark setting picks\n"
          ":theme-light or :theme-dark, and a change of it is followed")})

(defn faces-valid? (value)
  "True when `value` is a `:faces` value: a map from a face's name — a registry face's keyword
(`:syntax/comment`) or a chrome face's symbol (`theme/face-hl-line`) — to its attributes, a map."
  (and (map? value)
    (every? value
      (fn ([name attributes]) (and (or (keyword? name) (symbol? name)) (map? attributes))))))

(settings/define *settings*
  :faces {:default {}
   :type 'map
   :valid? 'config/faces-valid?
   :want "a map from a face's name to its attributes"
   :commented? true
   :example {:syntax/comment {:fg "#888888" :italic true}}
   :doc (str "faces set by name over every theme (Emacs's custom-set-faces): a syntax face by its\n"
          "keyword (:syntax/comment, :syntax/string, :org/level-1), a chrome face by its symbol\n"
          "(theme/face-hl-line), each to the attributes it takes (:fg :bg :bold :italic\n"
          ":underline). Kept across M-x theme-select; M-x reload-config applies a change")})

(settings/define *settings*
  :theme-dark {:default "Catppuccin Mocha"
   :type 'string
   :commented? true
   :doc "the theme when :theme is unset and the desktop is dark (or says nothing)"})

(settings/define *settings*
  :theme-light {:default "Catppuccin Latte (light)"
   :type 'string
   :commented? true
   :doc "the theme when :theme is unset and the desktop is light"})

(defn font-size-in-range? (value)
  "True when `value` is a whole pixel size the window takes: 6..72 (appearance's clamp)."
  (and (int? value) (>= value 6) (<= value 72)))

(settings/define *settings*
  :font-size {:default 15
   :type 'int
   :valid? 'config/font-size-in-range?
   :want "a whole number of pixels in 6..72"
   :commented? true
   :doc "the editor font's size in pixels (a cell's height before :line-height)"})

(settings/define *settings*
  :line-height {:default 1.25 ; a terminal's density: kitty, foot and Emacs sit near 1.2
   :type 'number
   :valid? 'config/line-height-in-range?
   :want "a number in 0.8..3.0"
   :commented? true
   :doc "the line height as a multiple of the font size: 1.25 is a terminal's, 1.4 breathes"})

;; The text-contrast default is the window's own (brood ADR-611): the perceptual gamma light
;; text on the dark theme is weighted at. Text blends in linear light with the weight of a
;; lerp of the ENCODED colours, the space a rasteriser's coverage is made for, and its partial
;; coverage is lifted to cov^(1/γ) where it is lighter than its ground. 1.0 is the encoded
;; lerp's weight, which reads thin on a dark ground: a stem straddling two pixels keeps less
;; than half its light. 1.4 fills it without making the rims glow: white on black at half
;; coverage lands at 155. Raise this for bolder text, 1.0 for the encoded weight.
(settings/define *settings*
  :text-contrast {:default 1.4
   :type 'number
   :valid? 'config/text-contrast-in-range?
   :want "a number in 0.5..3.0"
   :commented? true
   :doc (str "text contrast: how full light text on the dark theme reads — 1.0 is no lift (thin),\n"
          "1.4 (the default) fuller, 1.8 heavy")})

(settings/define *settings*
  :ligatures {:default false
   :type 'bool
   :model-key :ligatures
   :commented? true
   :doc (str "programming ligatures: a run of punctuation (-> != === <=> |>) shaped as one unit,\n"
          "so a font that has them (JetBrains Mono, Fira Code, Iosevka) draws its ligatures —\n"
          "each char still one cell. A window setting; the terminal draws what it draws")})

(settings/define *settings*
  :electric-pair {:default true
   :type '(or bool map)
   :valid? 'config/electric-pair-valid?
   :want "true, false, or a map of :default / a mode's name to one or to a vector of [open close] pairs"
   :model-key :electric-pair
   :doc (str "brackets in every buffer: `(` types `()` and lands inside, a backspace between an empty\n"
          "pair takes both (Emacs electric-pair-mode); false to just type the character. Each mode\n"
          "pairs its own characters (' in Python, ` in Markdown); a map sets it per mode, and a\n"
          "mode's entry may be its pairs: {:default true :org false :markdown [[\"(\" \")\"] [\"*\" \"*\"]]}.\n"
          "M-x electric-pair-mode toggles it live, M-x electric-pair-local-mode in one buffer;\n"
          "a bracket typed over a selection wraps it either way")})

(settings/define *settings*
  :electric-pair-preserve-balance {:default true
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :want "true, false, or a map of :default / a mode's name to one"
   :model-key :electric-pair-preserve-balance
   :commented? true
   :example {:default true :markdown false}
   :doc (str "keep brackets balanced while pairing (Emacs electric-pair-preserve-balance): an opener a\n"
          "waiting closer already balances is typed alone, and a closer is stepped over only while\n"
          "the brackets stay balanced; false pairs and steps over regardless. A map sets it per mode")})

(settings/define *settings*
  :display-buffer {:default *display-buffer-defaults*
   :type 'vector
   :valid? 'display-rules/display-buffer-valid?
   :want "a vector of {:match … :action …} rules (an invalid rule is dropped and named)"
   :model-key :display-buffer
   :commented? true
   :example [{:match "^\\*compilation\\*$" :action {:side :bottom :size 0.3}}
              {:match :help :action :reuse}
              {:match "^\\*shell" :action :same-window}]
   :doc (str "where a buffer a command shows goes (Emacs display-buffer-alist): rules, first match\n"
          "wins, before the defaults (shown here). :match is a regex on the buffer's name, or a\n"
          "keyword naming its type or mode (:help, :git-status, :prog); :request limits a rule to\n"
          "what the command asked (:here, :pop, :display); :action is :same-window, :other-window,\n"
          ":reuse (a window already showing it, else the next rule), :side or {:side :bottom\n"
          ":size 0.3} (a window along that side of the frame), or :new-frame")})

(settings/define *settings*
  :auto-fill {:default false
   :safe true
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :want "true, false, or a map of :default / a mode's name to one"
   :model-key :auto-fill
   :commented? true
   :example {:default false :text true :prog true}
   :doc (str "break a line at its last space within the fill column when a space or RET is typed\n"
          "past it, the new line continuing the paragraph's prefix (Emacs auto-fill-mode); in code\n"
          "only comments. A map sets it per mode; M-x auto-fill-mode toggles one buffer")})

(settings/define *settings*
  :delete-selection {:default false
   :type 'bool
   :model-key :delete-selection
   :commented? true
   :doc (str "typing, yanking or RET over a selection replaces it, and a delete takes the whole\n"
          "selection (Emacs delete-selection-mode); one undo brings it back")})

(settings/define *settings*
  :pulse {:default false
   :type 'bool
   :model-key :pulse-on
   :commented? true
   :doc (str "flash the line point lands on after a jump — another window or buffer, recenter,\n"
          "imenu, goto-line, a page scroll (Emacs pulsar)")})

;; One switch for every animation (`model/ed-reduce-motion?`): the settle ease after a
;; trackpad scroll, the pulse's fade, the scrollbar's fade, the activity spinner. Read by the
;; model at the moment each would start, so M-x reload-config takes effect from the next one.
(settings/define *settings*
  :reduce-motion {:default :auto
   :type '(or :auto bool)
   :model-key :reduce-motion
   :commented? true
   :doc (str "show no animation: a scroll snaps onto its line instead of easing there, the pulse\n"
          "after a jump is a still band the next command clears, the scrollbar hides without a\n"
          "fade and the activity spinner stands still. :auto follows the desktop's setting\n"
          "(GNOME's animations switch, KDE's animation speed, macOS's Reduce Motion, Windows'\n"
          "animation effects), read when the editor starts; true or false decides regardless")})

(settings/define *settings*
  :winner {:default false
   :type 'bool
   :model-key :winner-on
   :commented? true
   :doc "C-c ← / C-c → undo and redo changes to the window layout (Emacs winner-mode)"})

(settings/define *settings*
  :show-whitespace {:default false
   :safe true
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :model-key :show-whitespace
   :commented? true
   :example {:default false :prog true}
   :doc (str "tint trailing whitespace and mark tabs (Emacs whitespace-mode with trailing and\n"
          "tab-mark); a map sets it per mode, :prog for every code mode, as a mode hook does")})

(settings/define *settings*
  :fill-column-indicator {:default false
   :safe true
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :want "true, false, or a map of :default / a mode's name to one"
   :model-key :fill-column-indicator
   :commented? true
   :example {:default false :prog true}
   :doc (str "a thin rule at the fill column wherever a line leaves it empty (Emacs\n"
          "display-fill-column-indicator-mode); a map sets it per mode, :prog for every code\n"
          "mode. M-x display-fill-column-indicator-mode toggles one buffer")})

(settings/define *settings*
  :glyphless-chars {:default :hex-code
   :type '(or :hex-code :hidden)
   :commented? true
   :doc (str "how an invisible format character shows — a zero width space, a bidi control, a\n"
          "BOM in mid-text (Emacs glyphless-char-display): :hex-code as a `<200b>` escape (a\n"
          "bidi control marked as a hazard), :hidden as nothing at all")})

(settings/define *settings*
  :lsp-inlay-hints {:default false
   :safe true
   :type '(or bool map)
   :valid? 'config/per-mode-bool-valid?
   :model-key :lsp-inlay-hints
   :commented? true
   :example {:default false 'rust true}
   :doc (str "show the language server's inlay hints — parameter names and inferred types —\n"
          "inside the line, never in the text (Emacs eglot-inlay-hints-mode); a map sets it per\n"
          "mode. M-x lsp-inlay-hints-mode toggles one buffer")})

(settings/define *settings*
  :nobreak-char-display {:default true
   :type 'bool
   :model-key :nobreak-char-display
   :commented? true
   :doc (str "mark a no-break space (U+00A0, and the narrow one U+202F) underlined in the escape\n"
          "colour, so it does not pass for a plain space (Emacs nobreak-char-display); false\n"
          "shows it as a space")})

(settings/define *settings*
  :lsp-autostart {:default true
   :type 'bool
   :model-key :lsp-autostart
   :commented? true
   :doc (str "start a file's language server when it is opened (Emacs eglot-ensure); false\n"
          "starts one only when asked (M-x lsp-connect) — Expert compiles a whole mix\n"
          "project before it answers, a cost to pay on demand")})

(settings/define *settings*
  :lsp-semantic-tokens {:default true
   :type 'bool
   :model-key :lsp-semantic-tokens
   :commented? true
   :doc (str "colour names by what the language server says they are — a parameter, a macro, a\n"
          "type, a definition — over the mode's own colours, where the server offers semantic\n"
          "tokens (eglot's semantic tokens); M-x lsp-semantic-tokens-mode toggles it")})

(settings/define *settings*
  :lsp-code-lens {:default false
   :type 'bool
   :model-key :lsp-code-lens
   :commented? true
   :doc (str "show the language server's code lenses (`3 references`, `Run test`) as a dim row\n"
          "above their line; M-x lsp-code-lens-run runs the one on point's line")})

(settings/define *settings*
  :rainbow-delimiters {:default false
   :type 'bool
   :commented? true
   :doc "colour a code buffer's brackets by depth, each pair one colour (Emacs rainbow-delimiters)"})

(settings/define *settings*
  :save-place {:default true
   :type 'bool
   :commented? true
   :doc (str "reopen a file where you left it: its point is remembered when its buffer is killed\n"
          "or the editor quits (Emacs save-place-mode; state/places.blsp)")})

(settings/define *settings*
  :restore-session {:default true
   :type 'bool
   :commented? true
   :doc (str "started in a project with no file named, reopen the files and window layout the last\n"
          "session in that project had (Emacs desktop-save-mode; state/sessions/)")})

(def *large-file-warning-default* (* 10 1000 1000))
;; Emacs's `large-file-warning-threshold`: a file over 10 MB is asked about before it is
;; opened (`pool/ed-visit-file`), because it is read whole, on the loop, and the editor
;; waits for it. Here rather than in `pool` because this module loads first; a model built
;; without the init file (a test's) falls back to it.

(settings/define *settings*
  :large-file-warning-threshold {:default *large-file-warning-default*
   :type '(int 0 _)
   :model-key :large-file-warning-threshold
   :commented? true
   :doc (str "ask before opening a file larger than this many bytes, since it is read whole and\n"
          "the editor waits for it (Emacs large-file-warning-threshold); 0 never asks")})

(settings/define *settings*
  :savehist {:default true
   :type 'bool
   :commented? true
   :doc (str "keep what each minibuffer prompt was answered with across sessions — M-p / ↑ at a\n"
          "prompt recalls them (Emacs savehist-mode; state/minibuffer-history.blsp)")})

(settings/define *settings*
  :kill-whole-line {:default false
   :type 'bool
   :model-key :kill-whole-line
   :commented? true
   :doc "C-k at the start of a line kills the line AND its newline (Emacs kill-whole-line)"})

(settings/define *settings*
  :scroll-output {:default true
   :type 'bool
   :model-key :scroll-output
   :commented? true
   :doc "follow streamed output (*Tests*, *Run*) to its tail (Emacs compilation-scroll-output)"})

(settings/define *settings*
  :version-format {:default nil
   :type '(or string symbol)
   :want "a {{key}} template string, or a symbol naming a (facts) -> string function"
   :commented? true
   :example "bedit {{bedit}} on brood {{brood}}, up {{uptime}}"
   :doc (str "what M-x version / `bedit --version` print. A {{key}} template over the facts in\n"
          "`about/facts` — {{bedit}} {{brood}} {{built}} {{started}} {{uptime}} {{commit}}\n"
          "{{features}} {{modules}} {{config}} … — or a symbol naming your own (facts) -> string")})

(settings/define *settings*
  :share-name {:default nil
   :type 'string
   :commented? true
   :example "ada"
   :doc (str "your display name in shared sessions (caret tag, join/leave echoes);\n"
          "unset, the editor falls back to --as NAME, then $USER, then prompts")})

(settings/define *settings*
  :welcome {:default nil
   :type 'string
   :commented? true
   :example "hi!\n\n➜ the interactive bedit tutorial · \\[tutor/cmd-tutorial]\n"
   :doc (str "the startup scratch's text, replacing the built-in welcome message —\n"
          "\\[command] holes render as that command's live key binding")})

(defn- line-numbers-value? (value) (or (= value true) (= value false) (= value :relative)))
(defn- bool-value? (value) (or (= value true) (= value false)))

(defn- per-mode-map? (value valid?)
  "True when `value` is a map whose every key names what it sets — `:default`, a line kind or
a mode (a keyword, or a mode's bare symbol name) — and whose every value passes `valid?`:
the shape `:line-numbers`, the per-mode switches and `:long-lines` share."
  (and (map? value)
    (every? value (fn ([key setting]) (and (or (keyword? key) (symbol? key)) (valid? setting))))))

(defn per-mode-bool-valid? (value)
  "True when `value` is a per-mode switch's value (`:show-whitespace`, `:auto-fill`,
`:completion-auto`, `:electric-pair-preserve-balance`): a bool, or a map from `:default` or a
mode's name to one."
  (or (bool-value? value) (per-mode-map? value bool-value?)))

(defn- pairs-value? (value)
  ;; a vector of [open close] string pairs
  (and (vector? value)
    (every? value
      (fn (pair)
        (and (vector? pair)
          (= 2 (count pair))
          (string? (first pair))
          (string? (second pair))
          (not (= "" (first pair)))
          (not (= "" (second pair))))))))

(defn electric-pair-valid? (value)
  "True when `value` is an `:electric-pair` value: a bool, or a map from `:default` or a mode's
name to a bool or a vector of `[open close]` string pairs."
  (or (bool-value? value)
    (per-mode-map? value (fn (setting) (or (bool-value? setting) (pairs-value? setting))))))

(defn line-numbers-valid? (value)
  "True when `value` is a `:line-numbers` value: `true`, `false` or `:relative`, or a map from
`:default` or a mode's name (`:prog`, `:elixir`, a keyword or a bare symbol) to one."
  (or (line-numbers-value? value) (per-mode-map? value line-numbers-value?)))

(settings/define *settings*
  :line-numbers {:default true
   :safe true
   :type '(or bool keyword map)
   :valid? 'config/line-numbers-valid?
   :want "true, false, :relative, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default false :prog :relative}
   :doc (str "which buffers number their lines, and how: true (absolute), :relative (distance\n"
          "from point's line, which shows its own — Emacs's display-line-numbers-type) or false.\n"
          "A map sets it per mode, as Emacs's mode hooks do: a mode's name reaches its buffers,\n"
          "and :prog every code mode (:text every mode, code included); :default the rest. C-x l\n"
          "still toggles one window")})

(defn long-lines-valid? (value)
  "True when `value` is a `:long-lines` map: each key `:default`, a line kind (a keyword —
`:section-heading`, `:section-body`) or a mode's name (a symbol — `markdown`, `git-status`),
each value a policy in `scroll/*long-lines-policies*` (`:wrap`, `:truncate`, `:scroll`)."
  (per-mode-map? value (fn (policy) (contains? scroll/*long-lines-policies* policy))))

(settings/define *settings*
  :long-lines {:default scroll/*long-lines-defaults*
   :type 'map
   :valid? 'config/long-lines-valid?
   :want "a map of :default / a line kind / a mode name to :wrap, :truncate or :scroll"
   :commented? true
   :example {:default :scroll
             :section-heading :truncate
             :section-body :wrap
             'markdown :wrap
             'prog :scroll
             'git-log :truncate}
   :doc (str "how a line too long for its window shows: :wrap (on as many rows as it needs,\n"
          "visual-line-mode), :truncate (one row ending in the ellipsis — truncate-lines) or\n"
          ":scroll (one row, the window scrolls sideways to point). :default is for a buffer's\n"
          "mode with no say of its own; markdown and org wrap, every code mode scrolls. A\n"
          "mode's NAME (bare: markdown, git-status) sets every line of that mode's buffers, and\n"
          "every mode stacked over that layer, the most specific entry winning: prog is every\n"
          "code mode (text is every mode, code included);\n"
          "a line KIND sets those lines where the mode has no entry — in a section buffer\n"
          "(*git-status*, a log, *mur-status*) :section-heading is a file, commit or stash row\n"
          "and :section-body a hunk's code or a message. Unlisted keys keep the defaults shown.\n"
          "M-x toggle-truncate-lines / visual-line-mode override it for one buffer")})

(defn wrap-prefix-valid? (value)
  "True when `value` is a `:wrap-prefix` value: `:indent`, `:adaptive` or `:none`, or a map
from `:default` or a mode's name to one."
  (let (style? (fn (style) (contains? #{:indent :adaptive :none} style)))
    (or (style? value) (per-mode-map? value style?))))

(settings/define *settings*
  :wrap-prefix {:default scroll/*wrap-prefix-defaults*
   :safe true
   :type '(or keyword map)
   :valid? 'config/wrap-prefix-valid?
   :want "one of :indent / :adaptive / :none, or a map of :default / a mode name to one"
   :commented? true
   :example {:default :none 'text :adaptive 'prog :indent 'org :none}
   :doc (str "where a WRAPPED line's continuation rows start (Emacs wrap-prefix, adaptive-wrap):\n"
          ":indent under the line's indentation, :adaptive under its fill prefix (a list item's\n"
          "text, a quote's marker), :none at the window's edge. A line indented past half the\n"
          "window wraps from the edge. Code continues under its indent, prose under its fill\n"
          "prefix; unlisted modes keep the defaults shown")})

(settings/define *settings*
  :truncation-ellipsis {:default "…"
   :type 'string
   :commented? true
   :example "$"
   :doc "what ends a truncated line, in its last cells (Emacs shows `$` in the fringe)"})

;; ---- the keyboard: which Option key is Meta (brood ADR-541) -------------------

(settings/define *settings*
  :option-meta {:default :left
   :type '(or :left :right :both :none)
   :commented? true
   :doc (str "macOS: which Option key is Meta (Emacs's ns-alternate-modifier). The other one\n"
          "composes as the layout says (right-Option+2 types @ on a German layout):\n"
          "  :left  left Option is Meta, right Option composes\n"
          "  :right right Option is Meta, left Option composes\n"
          "  :both  both are Meta    :none  neither (both compose)\n"
          "Linux and Windows report no side: Alt is Meta and AltGr types its characters.\n"
          "Takes effect when a window opens")})

(defn window-options (config)
  "The options a bedit window opens with under the parsed init `config`: `*window-options*`
and the keyboard's `:option-meta` (which macOS Option key is Meta, brood ADR-541) — fixed
when the window is built, so a change reaches the next window opened.

    (:option-meta (config/window-options {:option-meta :both}))   ;=> :both
    (:option-meta (config/window-options {}))   ;=> :left"
  (assoc *window-options* :option-meta (setting config :option-meta)))
;; Key bindings (`userkeys`): the shape is checked here, with the settings; whether each key
;; reads and each command exists is `userkeys/ed-user-key-warnings`, part of [[init-warnings]].

(defn keys-valid? (value)
  "True when `value` is a `:keys` map: each key a key description (a string, `\"C-c f\"`),
each value a command's name (a symbol or a string) or nil to unbind."
  (and (map? value)
    (every? value
      (fn ([key command])
        (and (string? key) (or (nil? command) (symbol? command) (string? command)))))))

(defn mode-keys-valid? (value)
  "True when `value` is a `:mode-keys` map: each key a mode's name (a symbol, keyword or
string), each value a `:keys` map ([[keys-valid?]])."
  (and (map? value)
    (every? value
      (fn ([mode bindings])
        (and (or (symbol? mode) (keyword? mode) (string? mode)) (keys-valid? bindings))))))

(settings/define *settings*
  :keys {:default {}
   :type 'map
   :valid? 'config/keys-valid?
   :want "a map of key (a string, \"C-c f\") to a command's name, or nil to unbind"
   :commented? true
   :example {"C-c f" 'project-find-file "<f5>" 'compile "C-z" nil}
   :doc (str "your own key bindings, over every buffer (Emacs's global-set-key): a key written\n"
          "as C-h k shows it — C-x C-f, M-%, C-c t f, <f5>, C-M-<return>, RET, TAB, SPC — to a\n"
          "command by its M-x name, or nil to unbind the key. A mode's own binding for the\n"
          "same key still wins in its buffers: :mode-keys binds one there")})

(settings/define *settings*
  :mode-keys {:default {}
   :type 'map
   :valid? 'config/mode-keys-valid?
   :want "a map of a mode's name to a map of key to command, as :keys"
   :commented? true
   :example {'markdown {"C-c C-c" 'markdown-preview} 'prog {"C-c d" 'duplicate-line}}
   :doc (str "key bindings for one mode's buffers (Emacs's define-key in a mode map): a mode by\n"
          "the name its mode line shows (markdown, elixir, git-status; prog is every code mode,\n"
          "text every mode), its keys as in :keys")})

(defn- command-list? (value)
  ;; a vector of command names, each a symbol or a string
  (and (vector? value) (every? value (fn (entry) (or (symbol? entry) (string? entry))))))

(defn hooks-valid? (value)
  "True when `value` is a `:hooks` map: `:after-save` a vector of command names (symbols or
strings), `:mode` a map from a mode's name to one, and no other key."
  (and (map? value)
    (every? value
      (fn ([key entries])
        (case key
          :after-save (command-list? entries)
          :mode
            (and (map? entries)
              (every? entries
                (fn ([mode commands])
                  (and (or (symbol? mode) (keyword? mode) (string? mode)) (command-list? commands)))))
          false)))))

(settings/define *settings*
  :hooks {:default {}
   :type 'map
   :valid? 'config/hooks-valid?
   :want "{:after-save [command …] :mode {mode [command …]}}, each command by its M-x name"
   :model-key :hooks
   :commented? true
   :example {:after-save ['delete-trailing-whitespace] :mode {'markdown ['auto-fill-mode]}}
   :doc (str "commands to run at a seam (Emacs's hooks), each by its M-x name, in order:\n"
          ":after-save once a file's write lands, its buffer current (after-save-hook); :mode a\n"
          "mode's the first time a buffer is current in it, the most general mode first, as a\n"
          "mode's name in :mode-keys (prog is every code mode). One that fails is said and the\n"
          "rest still run")})

(defn snippets-valid? (value)
  "True when `value` is a `:snippets` map: each key a mode's name (a symbol, keyword or
string), each value a map of a snippet's key (a string) to its template (a string), or nil to
take a built-in one away."
  (and (map? value)
    (every? value
      (fn ([mode table])
        (and (or (symbol? mode) (keyword? mode) (string? mode))
          (map? table)
          (every? table
            (fn ([key template]) (and (string? key) (or (nil? template) (string? template))))))))))

(settings/define *settings*
  :snippets {:default {}
   :type 'map
   :valid? 'config/snippets-valid?
   :want "a map of a mode's name to a map of snippet key to template"
   :model-key :snippets
   :commented? true
   :example {'ruby {"def" "def ${1:name}\n  $0\nend"} 'prog {"todo" "TODO(${1:who}): $0"}}
   :doc (str "your own snippets per mode (Emacs's yasnippet): a mode as in :mode-keys, then a\n"
          "key to a template in the LSP snippet syntax — $1, ${2:default}, $0 for where point\n"
          "ends, a number twice mirrors it. C-c & expands the key before point, TAB / S-TAB\n"
          "move between the fields. They join (and override) the built-in ones; nil drops one")})
;; ---- indentation and fill: the conventions a buffer is edited with ----------------------
;; Each a value, or a per-mode map like `:line-numbers`'; `conventions` resolves them per
;; buffer, under the file's .editorconfig and over the mode's own convention (a bare value
;; and `:default` sit BELOW the mode's: Python indents by 4 whatever the default says, as
;; Emacs's `standard-indent` does not reach `python-indent-offset`).

(defn- positive-int? (value) (and (int? value) (> value 0)))
(defn- indent-width-value? (value) (or (positive-int? value) (= value :tab)))

(defn- convention-valid? (value valid?)
  (or (valid? value) (per-mode-map? value valid?)))

(defn indent-width-valid? (value)
  "True when `value` is an `:indent-width` value: a positive int or `:tab`, or a per-mode map
of them."
  (convention-valid? value indent-width-value?))

(defn width-valid? (value)
  "True when `value` is a `:fill-column` value: a positive int, or a per-mode map of them."
  (convention-valid? value positive-int?))

(defn- tab-width-value? (value)
  ;; brood's cell layout takes no tab stop past 1024 (`conventions/*max-tab-width*`)
  (and (positive-int? value) (<= value conventions/*max-tab-width*)))

(defn tab-width-valid? (value)
  "True when `value` is a `:tab-width` value: an int from 1 to 1024, or a per-mode map of
them."
  (convention-valid? value tab-width-value?))

(defn indent-tabs-valid? (value)
  "True when `value` is an `:indent-tabs` value: a bool, or a per-mode map of them."
  (convention-valid? value bool-value?))

(settings/define *settings*
  :indent-width {:default {:default 2}
   :safe true
   :type '(or int keyword map)
   :valid? 'config/indent-width-valid?
   :want "a positive number, :tab, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default 2 'python 4 'prog 4}
   :doc (str "the columns one indent level is — what TAB indents by and Shift-TAB dedents by\n"
          "(Emacs's per-mode indent offsets); :tab is one tab. Each language has its own\n"
          "(Python 4, Ruby / Elixir / Brood 2, Go a tab), which a mode's NAME here overrides\n"
          "and :default does not; a file's .editorconfig overrides both")})

(settings/define *settings*
  :tab-width {:default {:default 8}
   :safe true
   :type '(or int map)
   :valid? 'config/tab-width-valid?
   :want "a number from 1 to 1024, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default 8 'go 4}
   :doc "the columns a tab character spans when indenting with tabs (Emacs tab-width)"})

(settings/define *settings*
  :indent-tabs {:default {:default false}
   :safe true
   :type '(or bool map)
   :valid? 'config/indent-tabs-valid?
   :want "true, false, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default false 'c true}
   :doc (str "indent with tabs rather than spaces (Emacs indent-tabs-mode); Go and Makefiles\n"
          "do by their own convention")})

(settings/define *settings*
  :fill-column {:default {:default 70}
   :safe true
   :type '(or int map)
   :valid? 'config/width-valid?
   :want "a positive number, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default 80 'markdown 72}
   :doc (str "the column M-q fills a paragraph to (Emacs fill-column); Python's own is 79, and\n"
          "a file's .editorconfig max_line_length overrides it. M-x set-fill-column for one\n"
          "buffer, M-x describe-indentation says where each value came from")})

(settings/define *settings*
  :editorconfig {:default true
   :type 'bool
   :commented? true
   :doc (str "honour a visited file's .editorconfig (editorconfig.org): its indent style and\n"
          "size, tab width and max_line_length, and on save its trim_trailing_whitespace and\n"
          "insert_final_newline — over the settings above, as it is the project's say")})

(defn convention-settings (config)
  "The indentation and fill settings of the parsed init `config`, as `conventions` takes them."
  {:indent-width (setting config :indent-width)
   :tab-width (setting config :tab-width)
   :indent-tabs (setting config :indent-tabs)
   :fill-column (setting config :fill-column)
   :editorconfig (setting config :editorconfig)})
;; so-long (src/solong.blsp): the line length past which a file opens in the cheap state
(defn so-long-threshold-valid? (value)
  "True when `value` is a `:so-long-threshold`: a positive number of characters, or false
(never)."
  (or (= value false) (and (int? value) (> value 0))))

(settings/define *settings*
  :so-long-threshold {:default 10000
   :type '(or int bool)
   :valid? 'config/so-long-threshold-valid?
   :want "a positive number of characters, or false"
   :model-key :so-long-threshold
   :commented? true
   :example 20000
   :doc (str "a file opened with a line longer than this many characters (a minified bundle, a\n"
          "log with a megabyte line) truncates its long lines and turns off the per-line\n"
          "services that read them — Emacs's so-long-threshold. false never does. M-x\n"
          "so-long-mode toggles it per buffer")})

;; Undo history and streaming output, both of which a session that runs for days would
;; otherwise grow without end. The undo limits are std/editor/buffer's (brood ADR-550), set
;; image-wide by `apply-to-model` so a buffer's own process trims by them too.
(settings/define *settings*
  :undo-limit {:default 2000000
   :type '(int 1 _)
   :commented? true
   :doc (str "how much undo history a buffer is cut back to, in characters of change (each step\n"
          "also counts about 1 KB): Emacs's undo-limit. The oldest steps go first, whole")})

(settings/define *settings*
  :undo-strong-limit {:default 3000000
   :type '(int 1 _)
   :commented? true
   :doc (str "how far a buffer's undo history may grow before it is cut back to :undo-limit\n"
          "(Emacs's undo-strong-limit); never read as less than :undo-limit")})

(settings/define *settings*
  :file-coding {:default "windows-1252"
   :type 'string
   :commented? true
   :doc (str "what a file reads as when it is neither UTF-8 nor recognised as Cyrillic, Greek,\n"
          "Hebrew or Arabic, which bytes alone can tell; Polish and French they cannot. Any\n"
          "single-byte coding: \"windows-1250\", \"iso-8859-2\". C-x RET r overrules it per file")})

(settings/define *settings*
  :output-buffer-max-lines {:default 10000
   :type '(int 1 _)
   :model-key :output-max-lines
   :commented? true
   :doc (str "how many lines a streaming output buffer keeps — *compilation*, *Tests*, *Run*, a\n"
          "shell, *Spy*, a log — before its oldest go (Emacs's comint-buffer-maximum-size)")})

(settings/define *settings*
  :package-review-updates {:default true
   :type 'bool
   :model-key :package-review-updates
   :commented? true
   :doc (str "true: a package update (u in *Packages*, M-x package-update) is fetched and shown\n"
          "first — the versions, its changelog, the diff of its files — and applied with C-c C-c\n"
          "(C-c C-k drops it); false: applied as soon as it arrives")})

(settings/define *settings*
  :bug-report-url {:default "https://brood.fly.dev/api/v1/reports"
   :type 'string
   :model-key :bug-report-url
   :commented? true
   :doc (str "where M-x report-bug sends a report, after you have read it and said so; nothing is\n"
          "sent otherwise")})

;; The settings registry as an `ownership` kind: a package's declarations are claimed for it
;; (`packages` adopts them after its load), and removing the package takes them out with
;; std's `settings/undefine` — a core declaration it replaced is put back as it was.
(defn- setting-lookup (name)
  (let (spec (settings/spec-of *settings* name)) [(not (nil? spec)) spec]))

(defn- setting-write (name spec) (registry/put *settings* name spec))

(defn- setting-remove (name) (settings/undefine *settings* name))

(ownership/define-kind *settings* setting-lookup setting-write setting-remove)

(defn setting (config name)
  "The value of setting `name` under the parsed init `config`: the file's value when it is
valid, else the declared default — so a typo'd value never reaches the editor, and a key
deleted before `M-x reload-config` means the default again."
  (settings/value-of *settings* config name))

(def *init-default-source*
  (settings/default-source *settings*
    'config
    (str ";; bedit init — your editor config (read as data on launch, not eval'd).\n"
      ";; A single (config …) form; edit to taste — the editor re-reads it each start.\n")))

;; ---- read it (as data) ------------------------------------------------------

(defn- config-read (file)
  "Read `file` as the editor config — a map of the `(config …)` form's keys. `{}` when
the file is missing, unreadable, or doesn't hold a leading `(config …)` form. Never
throws (a malformed init file must not stop the editor opening)."
  (settings/read-file file 'config))

(defn window-mode (config)
  "The window mode `config` asks for, from its `:fullscreen` value (Emacs-style):
`:maximized` (fill the work area, keep the title bar) for `:maximized`/`true`,
`:fullscreen` (borderless, no title bar) for `:fullboth`/`:fullscreen`, else `nil`
(a normal window). What `main` switches on to call the matching `gui-*` primitive."
  (let (fullscreen (:fullscreen config))
    (cond
      (or (= fullscreen :maximized) (= fullscreen true)) :maximized
      (or (= fullscreen :fullboth) (= fullscreen :fullscreen)) :fullscreen
      else nil)))

;; The window mode is a closed set of keyword values (a keyword-literal type,
;; Brood ADR-105): the checker and LSP enumerate the modes a caller can get back. The
;; ARGUMENT is the whole config, so its values are every setting's — a narrower map type
;; would make any number in init.blsp (`:line-height 1.3`) a contract error at startup.
(sig window-mode ((map any any) -> (or :maximized :fullscreen nil)))

;; ---- advisory warnings for the init file ------------------------------------
;; `init.blsp` is read as *data*, so the type checker never sees it — a typo'd value can't
;; be a static warning. The settings' declared types find it at load time instead; `main`
;; logs each line into *Messages*, `M-x reload-config` echoes the first ([[init-warnings]],
;; with what did not read at all ahead of them).

(defn config-warnings (config)
  "Advisory warnings for `config` (the parsed init.blsp) — a vector of human-readable
strings, empty when the config is clean: each value its setting's type rejects, naming the
value and what was wanted, then each key no setting declares. Pure, so it's unit-tested."
  (into (settings/warnings *settings* config "init.blsp") (display-buffer-warnings config)))

;; ---- the window-side settings ------------------------------------------------

(defn window-settings (config)
  "The `gui/*` calls `config` asks for, as data: `[[:text-aa mode] [:line-height mult]
[:text-contrast gamma] [:ligatures on]]`. A key that is absent — or holds a value `config-warnings`
rejects — asks for the DEFAULT (`:auto`, 1.25, 1.4, false), so deleting a key from init.blsp and
reloading actually returns the window to that default rather than leaving the last value
in force. Pure, so the mapping is unit-tested; `apply-window!` performs it."
  [[:text-aa (setting config :text-aa)]
    [:line-height (setting config :line-height)]
    [:text-contrast (setting config :text-contrast)]
    [:ligatures (setting config :ligatures)]])

(defn apply-window! (config)
  "Apply `config`'s window-side settings (`window-settings`) to the live window: text
anti-aliasing (`gui/text-aa`), line height (`gui/line-height`) and text contrast
(`gui/text-contrast`) and programming ligatures (`gui/ligatures`). Each is a no-op
without a GUI build (`theme/gui-only`). Called by `main` at startup and by
`lifecycle/cmd-reload-config`, so editing init.blsp and reloading re-skins the window
without a restart."
  (doseq (entry (window-settings config))
    (let ([which value] entry)
      (case which
        :text-aa (theme/gui-only gui/text-aa value)
        :line-height (theme/gui-only gui/line-height value)
        :text-contrast (theme/gui-only gui/text-contrast value)
        :ligatures (theme/gui-only gui/ligatures value)
        nil))))

;; ---- ensure + apply ---------------------------------------------------------

(defn ensure-init! (file)
  "Ensure `file` exists, writing `*init-default-source*` the first time (creating its
directory). Best-effort — a write failure is swallowed (the editor still opens, just
without a persisted init). Returns `file`."
  (when (not (or (file/exists? file) (test-forbidden-path? file)))
    (try
      (do (file/mkdir (path/dirname file)) (file/spit file *init-default-source*))
      (catch e (log/warn (str "init: could not write " file ": " (error-message e))))))
  file)

(defn peek-init ()
  "The user's init config as a map WITHOUT creating the file — `{}` when there is none.

[[init-config]] is the STARTUP path and writes a documented default the first time; this is
for a caller that only wants to read one setting and must not have a side effect: `bedit
--version`, which should not leave a config file behind on a machine that had none."
  (config-read (init-file)))

(defn init-config (&optional (file (init-file)))
  "The user's editor config as a map: ensure the init file `file` (by default `init.blsp`)
exists (writing a documented default on first launch), then read it. What startup reads
(`startup/read-init`); a test names a temp file."
  (config-read (ensure-init! file)))

(defn init-read-warnings (&optional (file (init-file)))
  "What the init file at `file` failed to say, as readable lines — empty when it read as
written, or is missing: text that does not read (its line and column, and whether the
`(config …)` form before it still applies), a first form that is not `(config …)`, text
after it, a key left without a value. The read itself is `{}` for a file that does not
read (a broken init must not stop the editor opening); this is what keeps that from being
silent, since every setting is then quietly back at its default."
  (settings/file-warnings file 'config "init.blsp"))

(defn apply-file-coding (config)
  "Make `config`'s `:file-coding` what text naming no coding reads as (`charset/set-default-coding`).
A name that is none is said by [[file-coding-warnings]]."
  (charset/set-default-coding (setting config :file-coding))
  nil)

(defn- file-coding-warnings (config)
  (let (name (setting config :file-coding))
    (if (charset/single-byte-coding? name)
      []
      [(str ":file-coding: no single-byte coding is called " name "; text reads as windows-1252")])))

(defn- line-of (text offset)
  ;; the 1-based line character `offset` of `text` is on
  (inc (count (seq/filter (string/->list (string/substring text 0 offset)) (fn (c) (= c "\n"))))))

(defn duplicate-key-warnings (text)
  "A warning for each key the `(config …)` form of `text` sets more than once, with the line
of every time: the read keeps only the LAST (`settings/read-form`), so the earlier ones are
silently dropped — Emacs's `setq` twice in an init file, which no one notices either. Read
from the source's positioned CST (`sexp/top-level-forms`), so it sees what the map read
collapses; empty when the text has no `(config …)` form first.

    (config/duplicate-key-warnings \"(config\\n :hl-line true\\n :hl-line false)\")   ;=> [\"init.blsp: :hl-line is set twice (lines 2 and 3); the last one is used\"]"
  (let (form (first (sexp/top-level-forms text))
        kids (when (and form (= (:kind form) :list)) (sexp/forms-of form))
        head (first kids))
    (if (not (and head (= (:kind head) :symbol) (= (:text head) "config")))
      []
      (let (keys (map (seq/partition (rest kids) 2) first)
            lines-by-key (fold keys
                           {}
                           (fn (acc node)
                             (let (key (:text node))
                               (assoc acc key (conj (get acc key []) (line-of text (:start node)))))))
            ;; in the order each key first appears
            ordered (seq/distinct (map keys :text)))
        (into []
          (seq/keep ordered
            (fn (key)
              (let (lines (get lines-by-key key))
                (when (> (count lines) 1)
                  (str "init.blsp: "
                    key
                    " is set "
                    (if (= (count lines) 2) "twice" (str (count lines) " times"))
                    " (lines "
                    (string/join (map (seq/drop-last lines 1) str) ", ")
                    " and "
                    (last lines)
                    "); the last one is used"))))))))))

(defn- duplicate-key-file-warnings (file)
  ;; [[duplicate-key-warnings]] over `file`, empty when it is missing or cannot be read (the
  ;; read warnings say that)
  (check-allow :discarded-catch
    (if (file/exists? file)
      (try (duplicate-key-warnings (file/slurp file)) (catch _e []))
      [])))

(defn init-warnings (config &optional (file (init-file)))
  "Every problem with the init file at `file`, read as `config`: what did not read
([[init-read-warnings]]), a key set twice ([[duplicate-key-warnings]]), then each value or
key the settings reject ([[config-warnings]]). What `main` logs into *Messages* and `M-x
reload-config` echoes the first of."
  (-> (init-read-warnings file)
    (into (duplicate-key-file-warnings file))
    (into (config-warnings config))
    (into (file-coding-warnings config))
    (into (userkeys/ed-user-key-warnings (setting config :keys) (setting config :mode-keys)))))

(def per-mode-settings
  ;; the settings whose value may be a map keyed by mode (`scroll/ed-mode-setting`,
  ;; `conventions`): a key there that names no mode is silently never used
  [:auto-fill
    :completion-auto :electric-pair :electric-pair-preserve-balance :fill-column
    :fill-column-indicator :indent-tabs :indent-width :line-numbers :long-lines :lsp-inlay-hints
    :show-whitespace :tab-width :wrap-prefix])

(defn per-mode-key-warnings (config mode-names)
  "A warning for each key of a per-mode map in `config` ([[per-mode-settings]]) that names
nothing a buffer can be in — not `:default`, not a mode in `mode-names` (strings, as
`modes/mode-names` answers), and for `:long-lines` not a line kind — so `:show-whitespace
{:pyhton true}` is said rather than quietly ignored. Asked once the packages have loaded:
a package's mode is a mode too.

    (config/per-mode-key-warnings {:auto-fill {:pyhton true}} #{\"python\"})   ;=> [\":auto-fill: no mode is called pyhton (init.blsp); the entry is never used\"]"
  (into []
    (for (setting-name per-mode-settings
           key
           (let (value (get config setting-name))
             (if (map? value) (seq/sort-by (keys value) ->string) []))
           :when (not (or (= key :default)
                  (contains? mode-names (->string key))
                  (and (= setting-name :long-lines)
                    (contains? scroll/*long-lines-defaults* key)))))
      (str setting-name
        ": no mode is called "
        (->string key)
        " (init.blsp); the entry is never used"))))

(defn user-keys (config)
  "`config`'s `:keys` / `:mode-keys` compiled (`userkeys/ed-user-keys`, its warnings dropped):
what a model carries as `:user-keys`, and what text rendered before there is a model (the
welcome scratch) binds in to name the user's own keys."
  (dissoc (userkeys/ed-user-keys (setting config :keys) (setting config :mode-keys)) :warnings))

(defn apply-undo-limits (config)
  "Make `config`'s `:undo-limit` / `:undo-strong-limit` the ones every buffer trims its undo
history by (std/editor/buffer's `*undo-limit*` / `*undo-strong-limit*`, brood ADR-550). A
`def`, not a per-turn `binding`: the root value is what a buffer's own PROCESS (hosted,
frames) sees as well as the loop, and the next edit of each buffer trims to it."
  (def editor/buffer/*undo-limit* (setting config :undo-limit))
  (def editor/buffer/*undo-strong-limit* (setting config :undo-strong-limit))
  nil)

(defn apply-to-model (m config)
  "Apply the parsed init `config`'s **model-level** settings onto editor model `m`: every
setting that declares a `:model-key` is seeded there with its value (`setting` — the
default when absent or invalid). `main` seeds them at startup, `lifecycle/cmd-reload-config`
refreshes them live. (Window mode / font are GUI side effects `main` applies separately,
not here.) Also seeds `:participant` from `:share-name` when set — the collab display name
shown on your caret tag and join/leave echoes (share-session prompts for one otherwise).
And seeds `:user-keys`, the `:keys` / `:mode-keys` bindings compiled (`userkeys`), so a
reload rebinds from scratch: a binding deleted from the file is gone, while one made this
session with M-x global-set-key / local-set-key (`:session-keys`) stays unless the file now
binds that key itself (`userkeys/ed-merge-session-keys`). And keeps `config` itself as
`:init-config` — what was applied, which `C-h v` reports against the file as it is now.

`:line-numbers` (`scroll/ed-set-line-numbers`), `:long-lines`, `:truncation-ellipsis` and
`:wrap-prefix` (`scroll/ed-set-wrap-prefix`) are applied here too, though not onto the model:
the row table that reads them has a buffer and no model, so `scroll` holds them as globals
(`scroll/ed-set-long-lines`), re-bound here as a theme switch re-binds the palette. So are
the undo limits ([[apply-undo-limits]]), which std/editor/buffer reads, and
`:glyphless-chars` (`conventions/set-glyphless-chars`), which every cell measure reads."
  (apply-undo-limits config)
  (apply-file-coding config)
  (scroll/ed-set-long-lines (setting config :long-lines) (setting config :truncation-ellipsis))
  (scroll/ed-set-line-numbers (setting config :line-numbers))
  (scroll/ed-set-wrap-prefix (setting config :wrap-prefix))
  (theme/set-rainbow-delimiters (setting config :rainbow-delimiters))
  (conventions/set-user-settings (convention-settings config))
  (conventions/set-glyphless-chars (setting config :glyphless-chars))
  (let (m1 (fold (settings/specs *settings*)
             m
             (fn (acc spec)
               (if (:model-key spec)
                 (assoc acc (:model-key spec) (setting config (:name spec)))
                 acc)))
        name (setting config :share-name)
        ;; :keys / :mode-keys compiled, which `userkeys/ed-scope` binds into the layers, with
        ;; the keys M-x global-set-key / local-set-key bound this session laid back over them
        ;; — but for a key the file now binds itself
        [bound session] (userkeys/ed-merge-session-keys (user-keys config) (:session-keys m))
        m2 (assoc m1 :user-keys bound :session-keys session :init-config config))
    (if name (assoc m2 :participant name) m2)))
