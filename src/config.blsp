(defmodule config
  "The editor's **user init file** — `~/.config/bedit/init.blsp` (honouring
`$XDG_CONFIG_HOME`). On launch the editor ensures the file exists (writing a
documented default the first time, so there's always something to edit), then reads
it as **data** and applies it. The file holds a single declarative `(config …)`
form — a tiny DSL, *not* arbitrary code — so it's safe to read without evaluating it
(mirrors the build tool's `~/.config/brood/config.blsp`, and sidesteps the namespace
pitfall of `(reflect/load)`-ing a bare DSL — ADR-065).

Every key is a SETTING declared once below with `settings/define` (brood ADR-428,
std's `settings`): its default, its type, and its doc — which is also the comment above
it in the generated default file. That one declaration is the check `config-warnings`
makes, the fallback `setting` answers, and the line `*init-default-source*` writes; a
package declares its own under `:bedit/settings` the same way. Some notes the docs
leave out:

  :fullscreen  `window-mode` maps the value; `main` applies it.
  :text-aa / :line-height / :text-contrast  window settings `apply-window!` applies at
               startup and on `M-x reload-config`.
  :welcome     `\\[command]` holes render as that command's live key binding
               (`main/welcome-text`); keep a link line's marker text
               (`modes/*welcome-links*`) and it stays clickable. Startup-only.

The path / read / write helpers mirror `projects.blsp`'s cache idioms; read and
ensure are path-parameterised so tests drive them without touching the real
`~/.config`. `main` calls `(init-config)` once at startup and applies the map.")

;; ---- who the editor is, to the rest of the system ---------------------------

(def *app-id*
  ;; The editor's identity outside its own window: the name of its config directory,
  ;; and the **desktop application id** every window declares (`gui-display`'s
  ;; `:app-id` — Wayland's `app_id`, X11's `WM_CLASS`). A desktop matches a window to
  ;; an installed `<app-id>.desktop` entry by this string and nothing else, so it is
  ;; what earns the window its own icon and name in the GNOME dash / alt-tab instead
  ;; of the generic fallback. It must stay in step with `assets/bedit.desktop`
  ;; (that file's basename, and its `StartupWMClass`) — see `assets/README.md`.
  "bedit")

(def *window-options*
  ;; What every bedit window opens with — the main one, a C-x 5 2 frame, an --attach
  ;; client's and the --serve host's: the desktop identity, and the desktop's own key
  ;; repeat (its delay and rate, as plain presses — brood ADR-441). bedit has no repeat
  ;; of its own, so a window opened without `:key-repeat :os` would not repeat a held key.
  {:app-id *app-id* :key-repeat :os})

;; ---- where the init file lives ----------------------------------------------

(defdyn *config-base* nil)
;; A config base that wins over the environment, for the one caller that must not touch the
;; user's real config: a test (no process can set its own environment variables). nil —
;; the default — means "ask the environment".

(defn config-base-dir ()
  "The XDG config base: `*config-base*` when bound, else `$XDG_CONFIG_HOME`, else `~/.config`."
  ;; no HOME (a bare container, a service unit): the working directory, rather than a crash
  ;; before the first frame — the config is optional and its absence is already handled
  (or *config-base* (os/env "XDG_CONFIG_HOME") (path/join (or (os/env "HOME") ".") ".config")))

(defn config-dir ()
  "The editor's config directory: `$XDG_CONFIG_HOME/bedit` or `~/.config/bedit`."
  (path/join (config-base-dir) *app-id*))

(defn init-file ()
  "Path of the user init file (`~/.config/bedit/init.blsp`)."
  (path/join (config-dir) "init.blsp"))

;; ---- the settings -------------------------------------------------------------
;; Declared in the order the default file lists them. `:model-key` is bedit's own spec
;; field: the model key `apply-to-model` seeds with the setting's value.

(def *settings* :bedit/settings) ; the registry id every bedit setting is declared under

(defn line-height-in-range? (v)
  "True when `v` is a number in the window's 0.8..3.0 range — what `gui/line-height`
clamps to, so a value outside it is a typo (pixels, say), not a taste."
  (and (number? v) (>= v 0.8) (<= v 3.0)))

(defn text-contrast-in-range? (v)
  "True when `v` is a number in the window's 0.5..3.0 range (what `gui/text-contrast`
clamps to)."
  (and (number? v) (>= v 0.5) (<= v 3.0)))

(settings/define *settings*
  :fullscreen {:default false
   :type '(or :maximized :fullboth :fullscreen true false)
   :doc (str "how the window opens (like Emacs init.el's `fullscreen` frame parameter):\n"
          "  :maximized  fill the screen, keep the title bar\n"
          "  :fullboth   true fullscreen — no title bar\n" "  false       a normal window")})

(settings/define *settings*
  :hl-line {:default true
   :type 'bool
   :model-key :hl-line
   :doc "highlight the current line across the whole width (Emacs hl-line); false to disable"})

(settings/define *settings*
  :header-line {:default false
   :type 'bool
   :model-key :header-line
   :commented? true
   :doc (str "a header line above each window naming where you are: the file by its project\n"
          "and path, then the heading or definition at point (Emacs's breadcrumb-mode)")})

(settings/define *settings*
  :cursor {:default :block
   :type '(or :block :bar)
   :model-key :cursor-style
   :doc "the caret shape (every buffer): :block (the wide box) or :bar (a thin line)"})

(settings/define *settings*
  :completion-auto {:default true
   :type 'bool
   :model-key :completion-auto
   :commented? true
   :doc (str "open the completion popup on its own after a pause in typing (Emacs corfu-auto);\n"
          "false completes on Tab only, and brings back the inline preview")})

(settings/define *settings*
  :spell-check {:default true
   :type 'bool
   :model-key :spell-check?
   :commented? true
   :doc (str "underline misspelled words in the visible text (Emacs's global-jinx-mode): every\n"
          "word in prose, comments and strings in code. Needs enchant-2 or aspell")})

(settings/define *settings*
  :spell-language {:default nil
   :type 'string
   :model-key :spell-language
   :commented? true
   :example "en_GB"
   :doc "the dictionary to check in (C-M-$ picks one live); nil uses the locale's"})

(settings/define *settings*
  :completion-auto-delay {:default 200
   :type 'int
   :model-key :completion-auto-delay
   :commented? true
   :doc "the pause in typing, in ms, before the completion popup opens (corfu-auto-delay)"})

(settings/define *settings*
  :completion-auto-prefix {:default 2
   :type 'int
   :model-key :completion-auto-prefix
   :commented? true
   :doc "how many word characters before point open the completion popup (corfu-auto-prefix)"})

(settings/define *settings*
  :completion-popupinfo {:default true
   :type 'bool
   :model-key :completion-popupinfo
   :commented? true
   :doc "show the selected completion's documentation beside the popup (corfu-popupinfo)"})

(settings/define *settings*
  :blink-cursor-blinks {:default 10 ; model's `*blink-cursor-blinks*`, Emacs's own default
   :type 'int
   :model-key :blink-cursor-blinks
   :commented? true
   :doc (str "how many times the caret blinks at rest before it stays solid (Emacs\n"
          "blink-cursor-blinks); any key or click starts it over. 0 blinks forever")})

(settings/define *settings*
  :dired-listing-switches {:default "-al"
   :type 'string
   :model-key :dired-listing-switches
   :commented? true
   :doc (str "how Dired orders a listing, as `ls` switches (Emacs dired-listing-switches):\n"
          "  -al by name, folders and files mixed · t by date · S by size · X by extension\n"
          "  · U unsorted · r reversed. s in Dired toggles name and date; C-u s edits them")})

(settings/define *settings*
  :text-aa {:default :auto
   :type '(or :auto :gray :subpixel :bgr)
   :commented? true
   :doc (str "text anti-aliasing: :auto (subpixel/LCD text at 1x, grayscale on HiDPI), :gray,\n"
          ":subpixel (an RGB panel) or :bgr — subpixel is crisper on a 1x display")})

;; The editor font, any installed family by its name (brood ADR-442; a family not installed
;; falls back to the bundled DejaVu Sans Mono). Hack is the default, and the heavy end of the
;; coding faces: at 15 px it lays down a quarter to two-fifths more ink than Ubuntu Sans
;; Mono (H 40.6 px of coverage against 29.0, m 36.6 against 26.0, swash's own raster). A theme
;; keeps this font unless it names one.
(settings/define *settings*
  :font {:default "Hack"
   :type 'string
   :commented? true
   :doc (str "the editor font: an installed family by name (\"Hack\", \"Ubuntu Sans Mono\",\n"
          "\"JetBrains Mono\", \"DejaVu Sans Mono\"); `fc-list : family` lists them")})

;; The theme the window opens in. Unset, the palette is theme.blsp's Catppuccin Mocha; a name
;; M-x theme-select lists swaps the colours (and its font, for a theme that names one) at
;; startup and on M-x reload-config.
(settings/define *settings*
  :theme {:default nil
   :type 'string
   :commented? true
   :example "Modus Vivendi Tinted"
   :doc (str "the colour theme to open in, by its M-x theme-select name (\"Modus Vivendi Tinted\",\n"
          "\"Nord\", \"Tokyo Night\" …); unset, Catppuccin Mocha")})

(defn font-size-in-range? (v)
  "True when `v` is a whole pixel size the window takes: 6..72 (appearance's clamp)."
  (and (int? v) (>= v 6) (<= v 72)))

(settings/define *settings*
  :font-size {:default 15
   :type 'int
   :valid? 'config/font-size-in-range?
   :want "a whole number of pixels in 6..72"
   :commented? true
   :doc "the editor font's size in pixels (a cell's height before :line-height)"})

(settings/define *settings*
  :line-height {:default 1.25 ; a terminal's density: kitty, foot and Emacs sit near 1.2
   :type 'number
   :valid? 'config/line-height-in-range?
   :want "a number in 0.8..3.0"
   :commented? true
   :doc "the line height as a multiple of the font size: 1.25 is a terminal's, 1.4 breathes"})

;; The text-contrast default is the window's own, and now the honest one: text composites in
;; sRGB space, the encoded space a rasteriser's coverage is made for, so 1.0 puts a partly
;; covered pixel at the fraction it covers and stems end where the outline ends.
;;
;; This shipped at 1.4 for a while, and the reason is worth keeping: the renderer used to
;; composite text in LINEAR light, which put a half-covered pixel of light-on-dark text at
;; 188/255 instead of 128 and a quarter-covered one at 137 instead of 64. Every antialiased
;; rim glowed — text read puffy rather than crisp — and because the glow reads as blur
;; rather than weight, the lift was added on top of it, which made it worse. The fix was in
;; the renderer (brood's `blend_text`), not here; raise this above 1.0 only if you want
;; deliberately bolder text.
(settings/define *settings*
  :text-contrast {:default 1.0
   :type 'number
   :valid? 'config/text-contrast-in-range?
   :want "a number in 0.5..3.0"
   :commented? true
   :doc (str "text contrast: how full light text on the dark theme reads — 1.0 (the default)\n"
          "is no lift, 1.4 fuller, 1.8 heavy")})

(settings/define *settings*
  :electric-pair {:default true
   :type 'bool
   :model-key :electric-pair?
   :doc (str "brackets in every buffer: `(` types `()` and lands inside, a backspace between an empty\n"
          "pair takes both (Emacs electric-pair-mode); false to just type the character.\n"
          "M-x electric-pair-mode toggles it live; a bracket typed over a selection wraps it either way")})

(settings/define *settings*
  :delete-selection {:default false
   :type 'bool
   :model-key :delete-selection
   :commented? true
   :doc (str "typing, yanking or RET over a selection replaces it, and a delete takes the whole\n"
          "selection (Emacs delete-selection-mode); one undo brings it back")})

(settings/define *settings*
  :pulse {:default false
   :type 'bool
   :model-key :pulse-on
   :commented? true
   :doc (str "flash the line point lands on after a jump — another window or buffer, recenter,\n"
          "imenu, goto-line, a page scroll (Emacs pulsar)")})

(settings/define *settings*
  :winner {:default false
   :type 'bool
   :model-key :winner-on
   :commented? true
   :doc "C-c ← / C-c → undo and redo changes to the window layout (Emacs winner-mode)"})

(settings/define *settings*
  :show-whitespace {:default false
   :type '(or bool map)
   :valid? 'config/show-whitespace-valid?
   :model-key :show-whitespace
   :commented? true
   :example {:default false :prog true}
   :doc (str "tint trailing whitespace and mark tabs (Emacs whitespace-mode with trailing and\n"
          "tab-mark); a map sets it per mode, :prog for every code mode, as a mode hook does")})

(settings/define *settings*
  :rainbow-delimiters {:default false
   :type 'bool
   :commented? true
   :doc "colour a Lisp buffer's brackets by depth, each pair one colour (Emacs rainbow-delimiters)"})

(settings/define *settings*
  :save-place {:default true
   :type 'bool
   :commented? true
   :doc (str "reopen a file where you left it: its point is remembered when its buffer is killed\n"
          "or the editor quits (Emacs save-place-mode; state/places.blsp)")})

(settings/define *settings*
  :savehist {:default true
   :type 'bool
   :commented? true
   :doc (str "keep what each minibuffer prompt was answered with across sessions — M-p / ↑ at a\n"
          "prompt recalls them (Emacs savehist-mode; state/minibuffer-history.blsp)")})

(settings/define *settings*
  :kill-whole-line {:default false
   :type 'bool
   :model-key :kill-whole-line
   :commented? true
   :doc "C-k at the start of a line kills the line AND its newline (Emacs kill-whole-line)"})

(settings/define *settings*
  :scroll-output {:default true
   :type 'bool
   :model-key :scroll-output
   :commented? true
   :doc "follow streamed output (*Tests*, *Run*) to its tail (Emacs compilation-scroll-output)"})

(settings/define *settings*
  :version-format {:default nil
   :type '(or string symbol)
   :want "a {{key}} template string, or a symbol naming a (facts) -> string function"
   :commented? true
   :example "bedit {{bedit}} on brood {{brood}}, up {{uptime}}"
   :doc (str "what M-x version / `bedit --version` print. A {{key}} template over the facts in\n"
          "`about/facts` — {{bedit}} {{brood}} {{built}} {{started}} {{uptime}} {{commit}}\n"
          "{{features}} {{modules}} {{config}} … — or a symbol naming your own (facts) -> string")})

(settings/define *settings*
  :share-name {:default nil
   :type 'string
   :commented? true
   :example "ada"
   :doc (str "your display name in shared sessions (caret tag, join/leave echoes);\n"
          "unset, the editor falls back to --as NAME, then $USER, then prompts")})

(settings/define *settings*
  :welcome {:default nil
   :type 'string
   :commented? true
   :example "hi!\n\n➜ the interactive bedit tutorial · \\[tutor/cmd-tutorial]\n"
   :doc (str "the startup scratch's text, replacing the built-in welcome message —\n"
          "\\[command] holes render as that command's live key binding")})

(defn- line-numbers-value? (v) (or (= v true) (= v false) (= v :relative)))

(defn show-whitespace-valid? (v)
  "True when `v` is a `:show-whitespace` value: a bool, or a map from `:default` or a mode's
name to one."
  (or (= v true)
    (= v false)
    (and (map? v)
      (every? v
        (fn ([k value]) (and (or (keyword? k) (symbol? k)) (or (= value true) (= value false))))))))

(defn line-numbers-valid? (v)
  "True when `v` is a `:line-numbers` value: `true`, `false` or `:relative`, or a map from
`:default` or a mode's name (`:prog`, `:elixir`, a keyword or a bare symbol) to one."
  (or (line-numbers-value? v)
    (and (map? v)
      (every? v (fn ([k value]) (and (or (keyword? k) (symbol? k)) (line-numbers-value? value)))))))

(settings/define *settings*
  :line-numbers {:default true
   :type '(or bool keyword map)
   :valid? 'config/line-numbers-valid?
   :want "true, false, :relative, or a map of :default / a mode's name to one"
   :commented? true
   :example {:default false :prog :relative}
   :doc (str "which buffers number their lines, and how: true (absolute), :relative (distance\n"
          "from point's line, which shows its own — Emacs's display-line-numbers-type) or false.\n"
          "A map sets it per mode, as Emacs's mode hooks do: a mode's name reaches its buffers,\n"
          "and :prog every code mode, :text every other; :default the rest. C-x l still toggles\n"
          "one window")})

(def long-lines-policies #{:wrap :truncate :scroll}) ; what a `:long-lines` entry may say

(defn long-lines-valid? (v)
  "True when `v` is a `:long-lines` map: each key `:default`, a line kind (a keyword —
`:section-heading`, `:section-body`) or a mode's name (a symbol — `markdown`, `git-status`),
each value one of `:wrap`, `:truncate`, `:scroll`."
  (and (map? v)
    (every? v
      (fn (entry)
        (let ([k policy] entry)
          (and (or (keyword? k) (symbol? k)) (contains? long-lines-policies policy)))))))

(settings/define *settings*
  :long-lines {:default {:default :scroll :section-heading :truncate :section-body :wrap}
   :type 'map
   :valid? 'config/long-lines-valid?
   :want "a map of :default / a line kind / a mode name to :wrap, :truncate or :scroll"
   :commented? true
   :example {:default :scroll
             :section-heading :truncate
             :section-body :wrap
             'markdown :wrap
             'git-log :truncate}
   :doc (str "how a line too long for its window shows: :wrap (on as many rows as it needs,\n"
          "visual-line-mode), :truncate (one row ending in the ellipsis — truncate-lines) or\n"
          ":scroll (one row, the window scrolls sideways to point). :default is every buffer's;\n"
          "a mode's NAME (bare: markdown, git-status) sets every line of that mode's buffers;\n"
          "a line KIND sets those lines where the mode has no entry — in a section buffer\n"
          "(*git-status*, a log, *mur-status*) :section-heading is a file, commit or stash row\n"
          "and :section-body a hunk's code or a message. Unlisted keys keep the defaults shown.\n"
          "M-x toggle-truncate-lines / visual-line-mode override it for one buffer")})

(settings/define *settings*
  :truncation-ellipsis {:default "…"
   :type 'string
   :commented? true
   :example "$"
   :doc "what ends a truncated line, in its last cells (Emacs shows `$` in the fringe)"})

(defn setting (cfg name)
  "The value of setting `name` under the parsed init `cfg`: the file's value when it is
valid, else the declared default — so a typo'd value never reaches the editor, and a key
deleted before `M-x reload-config` means the default again."
  (settings/value-of *settings* cfg name))

(def *init-default-source*
  (settings/default-source *settings*
    'config
    (str ";; bedit init — your editor config (read as data on launch, not eval'd).\n"
      ";; A single (config …) form; edit to taste — the editor re-reads it each start.\n")))

;; ---- read it (as data) ------------------------------------------------------

(defn- config-read (file)
  "Read `file` as the editor config — a map of the `(config …)` form's keys. `{}` when
the file is missing, unreadable, or doesn't hold a leading `(config …)` form. Never
throws (a malformed init file must not stop the editor opening)."
  (settings/read-file file 'config))

(defn window-mode (cfg)
  "The window mode `cfg` asks for, from its `:fullscreen` value (Emacs-style):
`:maximized` (fill the work area, keep the title bar) for `:maximized`/`true`,
`:fullscreen` (borderless, no title bar) for `:fullboth`/`:fullscreen`, else `nil`
(a normal window). What `main` switches on to call the matching `gui-*` primitive."
  (let (fs (:fullscreen cfg))
    (cond
      (or (= fs :maximized) (= fs true)) :maximized
      (or (= fs :fullboth) (= fs :fullscreen)) :fullscreen
      :else nil)))

;; The window mode is a closed set of keyword values (a keyword-literal type,
;; Brood ADR-105): the checker/LSP now enumerate the modes a caller can get back,
;; and hover on `window-mode` shows `:maximized | :fullscreen | nil`.
;; `:fullscreen` is a keyword OR a bool — `true` means `:maximized`, `false` a normal
;; window — so the value type is not keyword-only.
(sig window-mode ((map any (or keyword bool)) -> (or :maximized :fullscreen nil)))

;; ---- advisory warnings for the init file ------------------------------------
;; `init.blsp` is read as *data*, so the type checker never sees it — a typo'd value can't
;; be a static warning. The settings' declared types find it at load time instead; `main`
;; logs each line into *Messages*, `M-x reload-config` echoes the first.

(defn config-warnings (cfg)
  "Advisory warnings for `cfg` (the parsed init.blsp) — a vector of human-readable
strings, empty when the config is clean: each value its setting's type rejects, naming the
value and what was wanted, then each key no setting declares. Pure, so it's unit-tested."
  (settings/warnings *settings* cfg "init.blsp"))

;; ---- the window-side settings ------------------------------------------------

(defn window-settings (cfg)
  "The `gui/*` calls `cfg` asks for, as data: `[[:text-aa mode] [:line-height mult]
[:text-contrast gamma]]`. A key that is absent — or holds a value `config-warnings`
rejects — asks for the DEFAULT (`:auto`, 1.25, 1.0), so deleting a key from init.blsp and
reloading actually returns the window to that default rather than leaving the last value
in force. Pure, so the mapping is unit-tested; `apply-window!` performs it."
  [[:text-aa (setting cfg :text-aa)]
    [:line-height (setting cfg :line-height)]
    [:text-contrast (setting cfg :text-contrast)]])

(defn apply-window! (cfg)
  "Apply `cfg`'s window-side settings (`window-settings`) to the live window: text
anti-aliasing (`gui/text-aa`), line height (`gui/line-height`) and text contrast
(`gui/text-contrast`). Each is a no-op
without a GUI build (`theme/gui-only`). Called by `main` at startup and by
`commands/cmd-reload-config`, so editing init.blsp and reloading re-skins the window
without a restart."
  (fold (window-settings cfg)
    nil
    (fn (_ [which arg])
      (cond
        (= which :text-aa) (theme/gui-only gui/text-aa arg)
        (= which :line-height) (theme/gui-only gui/line-height arg)
        (= which :text-contrast) (theme/gui-only gui/text-contrast arg)
        else nil))))

;; ---- ensure + apply ---------------------------------------------------------

(defn ensure-init! (file)
  "Ensure `file` exists, writing `*init-default-source*` the first time (creating its
directory). Best-effort — a write failure is swallowed (the editor still opens, just
without a persisted init). Returns `file`."
  (unless (file/exists? file)
    (try
      (do (file/mkdir (path/dirname file)) (file/spit file *init-default-source*))
      (catch e (log/warn (str "init: could not write " file ": " (error-message e))))))
  file)

(defn peek-init ()
  "The user's init config as a map WITHOUT creating the file — `{}` when there is none.

[[init-config]] is the STARTUP path and writes a documented default the first time; this is
for a caller that only wants to read one setting and must not have a side effect. `bedit
--version` is the case that forced the distinction: printing a version should not leave a
config file behind on a machine that had none."
  (config-read (init-file)))

(defn init-config ()
  "The user's editor config as a map: ensure `init.blsp` exists (writing a documented
default on first launch), then read it. The single entry point `main` calls at startup."
  (config-read (ensure-init! (init-file))))

(defn apply-to-model (m cfg)
  "Apply the parsed init `cfg`'s **model-level** settings onto editor model `m`: every
setting that declares a `:model-key` is seeded there with its value (`setting` — the
default when absent or invalid). `main` seeds them at startup, `commands/cmd-reload-config`
refreshes them live. (Window mode / font are GUI side effects `main` applies separately,
not here.) Also seeds `:participant` from `:share-name` when set — the collab display name
shown on your caret tag and join/leave echoes (share-session prompts for one otherwise).

`:line-numbers` (`scroll/ed-set-line-numbers`), `:long-lines` and `:truncation-ellipsis` are applied here too, though not onto the model:
the row table that reads them has a buffer and no model, so `scroll` holds them as globals
(`scroll/ed-set-long-lines`), re-bound here as a theme switch re-binds the palette."
  (scroll/ed-set-long-lines (setting cfg :long-lines) (setting cfg :truncation-ellipsis))
  (scroll/ed-set-line-numbers (setting cfg :line-numbers))
  (theme/set-rainbow-delimiters (setting cfg :rainbow-delimiters))
  (let (m1 (fold (settings/specs *settings*)
             m
             (fn (acc spec)
               (if (:model-key spec) (assoc acc (:model-key spec) (setting cfg (:name spec))) acc)))
        name (setting cfg :share-name))
    (if name (assoc m1 :participant name) m1)))
