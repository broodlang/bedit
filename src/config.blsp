(defmodule config
  "The editor's **user init file** — `~/.config/bedit/init.blsp` (honouring
`$XDG_CONFIG_HOME`). On launch the editor ensures the file exists (writing a
documented default the first time, so there's always something to edit), then reads
it as **data** and applies it. The file holds a single declarative `(config …)`
form — a tiny DSL, *not* arbitrary code — so it's safe to read with `read-first`
without evaluating it (mirrors the build tool's `~/.config/brood/config.blsp`, and
sidesteps the namespace pitfall of `(load)`-ing a bare DSL — ADR-065).

Recognised keys (more slot in here as the editor grows):

  :fullscreen  how the window opens — an Emacs-style value (its init.el `fullscreen`
               frame parameter): `:maximized` (or `true`) fills the screen but keeps
               the title bar (`gui/maximize!`); `:fullboth` (or `:fullscreen`) is true
               borderless fullscreen with no title bar (`gui/fullscreen!`); `false`
               (the default) a normal window. `window-mode` maps the value; `main`
               applies it.
  :hl-line     highlight the current line full-width (Emacs hl-line). `true` (default)
               or `false`.
  :cursor      the caret shape, consistent across every buffer (outside Vim insert/
               normal/visual): `:block` (default, the wide box) or `:bar` (a thin line).

The path / read / write helpers mirror `projects.blsp`'s cache idioms; read and
ensure are path-parameterised so tests drive them without touching the real
`~/.config`. `main` calls `(init-config)` once at startup and applies the map.")

;; ---- who the editor is, to the rest of the system ---------------------------

(def *app-id*
  ;; The editor's identity outside its own window: the name of its config directory,
  ;; and the **desktop application id** every window declares (`gui-display`'s
  ;; `:app-id` — Wayland's `app_id`, X11's `WM_CLASS`). A desktop matches a window to
  ;; an installed `<app-id>.desktop` entry by this string and nothing else, so it is
  ;; what earns the window its own icon and name in the GNOME dash / alt-tab instead
  ;; of the generic fallback. It must stay in step with `assets/bedit.desktop`
  ;; (that file's basename, and its `StartupWMClass`) — see `assets/README.md`.
  "bedit")

;; ---- where the init file lives ----------------------------------------------

(defn config-base-dir ()
  "The XDG config base: `$XDG_CONFIG_HOME`, else `~/.config`."
  (or (os/getenv "XDG_CONFIG_HOME") (path/join (os/getenv "HOME") ".config")))

(defn config-dir ()
  "The editor's config directory: `$XDG_CONFIG_HOME/bedit` or `~/.config/bedit`."
  (path/join (config-base-dir) *app-id*))

(defn init-file ()
  "Path of the user init file (`~/.config/bedit/init.blsp`)."
  (path/join (config-dir) "init.blsp"))

(def *init-default-source*
  (str ";; bedit init — your editor config (read as data on launch, not eval'd).\n"
    ";; A single (config …) form; edit to taste — the editor re-reads it each start.\n" "(config\n"
    "  ;; how the window opens (like Emacs init.el's `fullscreen` frame parameter):\n"
    "  ;;   :maximized  fill the screen, keep the title bar\n"
    "  ;;   :fullboth   true fullscreen — no title bar\n" "  ;;   false       a normal window\n"
    "  :fullscreen false\n"
    "  ;; highlight the current line across the whole width (Emacs hl-line); false to disable\n"
    "  :hl-line true\n"
    "  ;; the caret shape (every buffer): :block (the wide box) or :bar (a thin line)\n"
    "  :cursor :block\n"
    "  ;; your display name in shared sessions (caret tag, join/leave echoes);\n"
    "  ;; unset, the editor falls back to --as NAME, then $USER, then prompts\n"
    "  ;; :share-name \"wilhelm\"\n" "  )\n"))

;; ---- read it (as data) ------------------------------------------------------

(defn- config-read
  (file)
  "Read `file` as the editor config — a map of the `(config …)` form's keys. `{}` when
the file is missing, unreadable, or doesn't hold a leading `(config …)` form. Never
throws (a malformed init file must not stop the editor opening)."
  (if (file/exists? file)
    (try
      (let (form (read-first (file/slurp file)))
        (if (and (pair? form) (= (first form) 'config))
          (fold (fn (m kv) (assoc m (first kv) (second kv))) {} (partition 2 (rest form)))
          {}))
      (catch e {}))
    {}))

(defn window-mode (cfg)
  "The window mode `cfg` asks for, from its `:fullscreen` value (Emacs-style):
`:maximized` (fill the work area, keep the title bar) for `:maximized`/`true`,
`:fullscreen` (borderless, no title bar) for `:fullboth`/`:fullscreen`, else `nil`
(a normal window). What `main` switches on to call the matching `gui-*` primitive."
  (let (fs (:fullscreen cfg))
    (cond
      (or (= fs :maximized) (= fs true)) :maximized
      (or (= fs :fullboth) (= fs :fullscreen)) :fullscreen
      :else nil)))

;; The window mode is a closed set of keyword values (a keyword-literal type,
;; Brood ADR-105): the checker/LSP now enumerate the modes a caller can get back,
;; and hover on `window-mode` shows `:maximized | :fullscreen | nil`.
(sig window-mode ((map keyword any) -> (or :maximized :fullscreen nil)))

;; ---- advisory warnings for the init file ------------------------------------
;; `init.blsp` is read as *data* (config-read), so the type checker never sees it
;; — a typo'd value can't be a static warning. We re-find that feedback at *load*
;; time: validate the known keys against their accepted values and surface anything
;; unrecognized in *Messages* (main logs each line). The clean version of this would
;; be `(type-matches? '(or :maximized …) v)` over a keyword-literal type, but the
;; mode also accepts the booleans `true`/`false`, which aren't literal-typeable yet
;; (the deferred bool/int/string slice of Brood ADR-105) — so the accepted set is an
;; explicit list for now.

(def *fullscreen-values*
  ;; what `window-mode` recognises for `:fullscreen`; anything else is a typo.
  [:maximized :fullboth :fullscreen true false nil])

(def *cursor-values*
  ;; what `:cursor` (the caret shape) accepts; anything else is a typo. `nil` (the key
  ;; absent) is fine — `main` defaults it to `:block`.
  [:block :bar nil])

(defn config-warnings (cfg)
  "Advisory warnings for `cfg` (the parsed init.blsp) — a vector of human-readable
strings, empty when the config is clean. Currently: an unrecognized `:fullscreen` or
`:cursor` value. Pure, so it's unit-tested; `main` logs each line into *Messages*."
  (let (fs (:fullscreen cfg)
        cur (:cursor cfg))
    (append (if (any? (fn (v) (= v fs)) *fullscreen-values*)
              []
              [(str "init.blsp: unknown :fullscreen value "
                 (pr-str fs)
                 " — want :maximized / :fullboth / :fullscreen / nil")])
      (if (any? (fn (v) (= v cur)) *cursor-values*)
        []
        [(str "init.blsp: unknown :cursor value " (pr-str cur) " — want :block / :bar")]))))

;; ---- ensure + apply ---------------------------------------------------------

(defn ensure-init! (file)
  "Ensure `file` exists, writing `*init-default-source*` the first time (creating its
directory). Best-effort — a write failure is swallowed (the editor still opens, just
without a persisted init). Returns `file`."
  (unless (file/exists? file)
    (try (do (file/mkdir (path/dirname file)) (file/spit file *init-default-source*)) (catch e nil)))
  file)

(defn init-config ()
  "The user's editor config as a map: ensure `init.blsp` exists (writing a documented
default on first launch), then read it. The single entry point `main` calls at startup."
  (config-read (ensure-init! (init-file))))

(defn apply-to-model (m cfg)
  "Apply the parsed init `cfg`'s **model-level** settings onto editor model `m`, each
falling back to its default when the key is absent: `:hl-line` (current-line highlight,
default on) and `:cursor-style` (the caret shape, default `:block`). The one place these
defaults live — `main` seeds them at startup, `commands/cmd-reload-config` refreshes them
live. (Window mode / font are GUI side effects `main` applies separately, not here.)
Also seeds `:participant` from `:share-name` when set — the collab display name shown on
your caret tag and join/leave echoes (share-session prompts for one otherwise)."
  (let (m1 (assoc m
             :hl-line (if (contains? cfg :hl-line) (:hl-line cfg) true)
             :cursor-style (if (contains? cfg :cursor) (:cursor cfg) :block)
             ;; follow streamed output (*Tests* / *Run*) to the tail — Emacs
             ;; `compilation-scroll-output`; on by default, `(config :scroll-output false)` pins it.
             :scroll-output (if (contains? cfg :scroll-output) (:scroll-output cfg) true)
             ;; held-key typematic feel: ms before a held key starts repeating, and ms
             ;; between repeats (`input/ed-repeat-delay`/`ed-repeat-rate`; nil = defaults).
             :repeat-delay (:repeat-delay cfg)
             :repeat-rate (:repeat-rate cfg)))
    (if (contains? cfg :share-name) (assoc m1 :participant (:share-name cfg)) m1)))
