(defmodule murbar
  "mur on the mode line, for every buffer in a mur working copy: ◆ and what the change is
for, a state dot, then `~N` files changed since the last save, `!N` clashes left to settle,
`↑N` versions not on the forge yet and `?N` edits no change has claimed — each shown only
when there is one, each clickable to `C-x g`. mur's row in `vcscore`: the summary is one
`mur status --json`, computed off the loop on the idle beat."
  (:use vcscore) ; register-vcs-backend — mur's row
  (:use murcore)) ; mur-json / mur-short / the faces

(def *mur-change-glyph* "◆ ") ; the change marker; set to "mur:" if your font lacks ◆
(def *mur-title-width* 40) ; what the change is for, cut to this on the bar (the tooltip has it whole)

(defn mur-other-changes (here)
  "The changes open in this working copy besides yours, as `mur status` counts them: those
with something saved or claimed — a fresh change a terminal left behind holds nothing and is
not work anyone is doing."
  (seq/filter (or here [])
    (fn (entry) (and (not (:yours entry)) (or (string? (:title entry)) (> (:claimed entry 0) 0))))))

(defn mur-summary-of (status)
  "The mode line's facts from a `mur status --json` answer: `{:label :change :title :state
:project :url :versions :unsent :changed :clashes :unclaimed :others}`. Pure, so it is
tested without mur. `:label` — what the work is on, for the window title — is the change's
title, or its short ID while it has none."
  (let (title (:title status)
        change (:change status))
    {:label (or title (mur-short change))
     :change change
     :title title
     :state (:state status)
     :project (:project status)
     :url (:url status)
     :versions (or (:versions status) 0)
     :unsent (or (:unsent status) 0)
     :changed (count (or (:files status) []))
     :clashes (count (or (:clashes status) []))
     :unclaimed (count (or (:unclaimed status) []))
     :others (count (mur-other-changes (:here status)))}))

(defn mur-summary (root)
  "The mode line's summary for working copy `root` (`mur status --json`), or nil when mur
cannot answer. One subprocess, which `vcscore` runs off the loop."
  (let (status (mur-json root ["status" "--json"]))
    (if (map? status) (mur-summary-of status) nil)))

(defn mur-state-words (summary)
  "Where the change stands, as a person says it."
  (let (state (:state summary)
        versions (:versions summary))
    (cond
      (= state "new") "not said what it is for yet (c says it)"
      (= state "said") "said what it is for; nothing saved yet"
      (= state "saved")
        (str versions (if (= versions 1) " version" " versions") " saved, not landed")
      (= state "moved") "moved on the forge by another working copy (u merges)"
      (= state "moving") "moving onto the latest trunk"
      (= state "merging") "merging with the forge's version"
      else (str state))))

(defn- mur-dot-face (summary)
  "The state dot: red with a clash to settle, yellow with files changed since the last save,
blue with versions not sent, green when everything saved is on the forge."
  (cond
    (> (:clashes summary) 0) mur-face-clash
    (> (:changed summary) 0) mur-face-changed
    (> (:unsent summary) 0) mur-face-unsent
    else mur-face-saved))

(defn- mur-change-tooltip (summary)
  (seq/reject [(str "Change:  " (mur-short (:change summary)) "  " (or (:title summary) ""))
                (str "Project: " (or (:project summary) "?"))
                (mur-state-words summary)
                (if (> (:unsent summary) 0) (str (:unsent summary) " not on the forge yet") nil)
                (if (> (:others summary) 0) (str (:others summary) " other changes open here") nil)
                (:url summary)]
    nil?))

(defn- mur-tree-tooltip (summary)
  (if (and (= (:changed summary) 0) (= (:clashes summary) 0))
    ["Nothing changed since the last save"]
    (seq/reject [(if (> (:changed summary) 0) (str "Changed:   " (:changed summary)) nil)
                  (if (> (:clashes summary) 0)
                    (str "Clashes:   " (:clashes summary) " (S settles)")
                    nil)]
      nil?)))

(defn- mur-count (id prefix n face tooltip)
  (if (= n 0) nil {:id id :text (str prefix n) :face face :tooltip tooltip}))

(defn- mur-cut (text width)
  (if (<= (count text) width) text (str (string/substring text 0 (dec width)) "…")))

(defn mur-chip (summary)
  "mur's chip (`vcscore/vcs-chip-segments` draws it) from `summary`, or nil: the ◆ change
(what it is for, cut; whole in the tooltip), the state dot, then `~changed !clashes ↑unsent
?unclaimed`, each only when non-zero. Pure."
  (if (nil? summary)
    nil
    {:glyph *mur-change-glyph*
     :label (mur-cut (:label summary) *mur-title-width*)
     :label-face mur-face-label
     :tooltip (mur-change-tooltip summary)
     :dot-face (mur-dot-face summary)
     :dot-tooltip (mur-tree-tooltip summary)
     :counts [(mur-count :mur-changed
                "~"
                (:changed summary)
                mur-face-changed
                "files changed since the last save")
               (mur-count :mur-clashes
                 "!"
                 (:clashes summary)
                 mur-face-clash
                 "clashes with trunk to settle")
               (mur-count :mur-unsent
                 "↑"
                 (:unsent summary)
                 mur-face-unsent
                 "versions not on the forge yet (y sends)")
               (mur-count :mur-unclaimed
                 "?"
                 (:unclaimed summary)
                 mur-face-dim
                 "edits no change has claimed")]}))

(register-vcs-backend :mur
  {:status 'murstatus/cmd-mur-status
   :dispatch 'mur/cmd-mur-dispatch
   :file-menu 'mur/cmd-mur-file-menu
   :diff-file 'murstatus/cmd-mur-diff-file
   :log-file 'murstatus/cmd-mur-log-file
   ;; no :blame (nor :blame-revision) — the client has none (the forge shows a line's
   ;; origins on a change's page)
   :file-history 'murhistory/mur-file-history
   :file-at 'murhistory/mur-file-revision
   :show-revision 'murhistory/mur-show-revision
   :summary 'murbar/mur-summary
   :chip 'murbar/mur-chip})
