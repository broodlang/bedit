(defmodule git
  "A git porcelain modelled on Magit: `C-x g` opens a read-only `*git-status*` buffer with
Unstaged / Staged / Untracked / Unpushed / Unpulled / Recent-commits sections. Single-key actions — s/u/k
stage/unstage/discard the **file or hunk** under point, S stage-all, U unstage-all, c commit
(a amend), b b checkout branch / b c create branch, n/p jump between actionable rows, TAB
expand file hunks inline / collapse section, RET preview diff or show commit, d diff whole pane,
g refresh, q quit, P/F push/pull, l log, z z/z p stash push/pop. `$` opens *git-process*:
what git actually ran (Magit's process buffer) — every command, its exit code, how long it
took and its whole output. Hunk-level staging: TAB expands
a file showing each `@@` hunk as an actionable row; s/u/k on a hunk runs `git apply --cached`
(or its reverse) piping the patch via stdin (`%os-cmd-stdin`). Section collapsing: TAB on a
section header toggles it between expanded and collapsed (`:git-collapsed-sections` tracks which).
The dired pattern: a `:git-status` mode layer over a generated buffer, with the per-row data (file,
hunk, section-header, OR commit-log row) kept on the model (`:git-rows`, parallel to the buffer's
lines) so commands read the current row without re-parsing text. Git runs synchronously via
`%os-cmd` in the repo root (`:git-root`). Parsing/rendering are pure (tests/git_test.blsp)."
  (:use model) ; ed-current-buf / ed-set-buf / message / ed-read-char / ed-apply
  (:use commands) ; ed-show-named / ed-default-dir / ed-goto-line / cmd-kill-buffer
  (:use interactive) ; defcommand
  ;; `:use`d, not referenced qualified: `cmd-git-push` calls `ed-transient-args` on EVERY
  ;; push, including one reached by a keybinding with no menu in sight, and a qualified
  ;; reference does not load a module (that is the `unbound symbol: term/…` bug, 154d4a73).
  ;; Loading it with git is right anyway — git is where the menus are.
  (:use transient) ; ed-transient-open / ed-transient-args — the P and F menus
  (:use statusbar) ; `seg` — build the branch + working-tree status-bar segments
  (:use editor/buffer) ; buffer-current-line / buffer-text
  (:use task)) ; task — the status summary's four git subprocesses, off the loop
;; `theme` (a project source module, loaded with the image) provides the *green* / *red* /
;; *blue* / *yellow* / *subtext* dynamic-var colour globals this file reads bare.
;; ---- syntax highlighting for the diff / log / status buffers ----------------
;; A `:fontify` service like every mode's: a pure `slice -> [start end face]`, line-
;; structural (no lexer state) so the windowed slice the view passes colours correctly
;; wherever it starts. The classifier trims leading whitespace first, so it works for the
;; raw *git-diff* output AND the indented inline diff under a file in *git-status*.

(def git-face-add {:fg *green*}) ; an added (+) line
(def git-face-del {:fg *red*}) ; a removed (-) line
(def git-face-hunk {:fg *blue* :bold true}) ; a @@ hunk header
(def git-face-file {:fg *subtext* :bold true}) ; diff --git / +++ / --- file headers
(def git-face-meta {:fg *subtext*}) ; index / mode / rename metadata
(def git-face-section {:fg *blue* :bold true}) ; a *git-status* section header
(def git-face-note {:fg *subtext* :italic true})
(def git-face-hash {:fg *yellow*}) ; a commit hash in the log
;; the status-bar segment faces (branch + colour-coded working-tree indicator): staged reads
;; green, unstaged yellow, untracked dim; a clean/staged tree dot is green. Built from the
;; theme colour tokens (via `require`), like the diff faces above — kept here, not in theme,
;; because git reaches the palette through `require` (dynamic-var colours only).
(def git-face-branch {:fg *subtext*}) ; the ⎇ branch label (quiet, secondary)
(def git-face-clean {:fg *green*}) ; the state dot when the tree is clean / staged
(def git-face-staged {:fg *green*}) ; the +N staged-change count (ready to commit)
(def git-face-unstaged {:fg *yellow*}) ; the ~N unstaged-change count (modified, dirty)
(def git-face-untracked {:fg *overlay0*}) ; the ?N untracked-file count (dim)
;; the *git-status* header block: a local branch (the `Head:` line) reads blue, a remote /
;; upstream branch (the `Merge:` line) green — Magit's magit-branch-local / -remote.
(def git-face-branch-local {:fg *blue* :bold true}) ; the `Head:` line's branch
(def git-face-branch-remote {:fg *green* :bold true}) ; the `Merge:` line's upstream
;; the colour-coded file-status labels — a legend at a glance, reusing the diff-hl palette
;; (modified yellow, added green, deleted red, rename/copy blue, untracked dim). Keyed by the
;; human label `git-entry-label` emits, so the fontify colours just that word.
(def- git-label-faces
  {"modified" git-face-unstaged
   "new file" git-face-add
   "deleted" git-face-del
   "renamed" git-face-hunk
   "copied" git-face-hunk
   "conflict" git-face-del
   "untracked" git-face-untracked
   ;; how a conflict happened (`git-conflict-label`) — all red, because every one of them
   ;; is the same instruction: this file is not going anywhere until you decide
   "both modified" git-face-del
   "both added" git-face-del
   "both deleted" git-face-del
   "added by us" git-face-del
   "added by them" git-face-del
   "deleted by us" git-face-del
   "deleted by them" git-face-del
   "unmerged" git-face-del})

(defn- git-diff-line-face (line)
  "The face for a unified-diff line (leading indent ignored), or nil for a context line."
  (let (t (string/triml line))
    (cond
      (string/starts-with? t "@@") git-face-hunk
      (or (string/starts-with? t "+++") (string/starts-with? t "---")) git-face-file
      (string/starts-with? t "diff ") git-face-file
      (or (string/starts-with? t "index ")
        (string/starts-with? t "new ")
        (string/starts-with? t "deleted ")
        (string/starts-with? t "rename ")
        (string/starts-with? t "similarity ")
        (string/starts-with? t "old mode")
        (string/starts-with? t "new mode"))
        git-face-meta
      (string/starts-with? t "+") git-face-add
      (string/starts-with? t "-") git-face-del
      :else nil)))

(defn- git-hex? (s)
  "True when `s` is a run of at least four lowercase-hex digits — i.e. a git short hash (so a
commit row is told apart from a file row, whose label is a word)."
  (and (>= (string/length s) 4)
    (nil? (seq/find (range (string/length s))
            (fn (i) (< (index-of "0123456789abcdef" (string/char-at s i)) 0))))))

(defn- git-header-spans (line off)
  "Spans for a `Head:`/`Merge:`/`Push:` header line: the `Label:` in the dim meta face, the
branch/upstream name in a branch face (local blue on `Head:`, remote green otherwise), the
trailing commit subject left in the default face."
  (let (colon (index-of line ":")
        rest (if (< colon 0) "" (string/substring line (inc colon) (string/length line)))
        after (string/triml rest)
        lead (- (string/length rest) (string/length after))
        sp (index-of after " ")
        blen (if (< sp 0) (string/length after) sp)
        bstart (+ (inc colon) lead)
        bface (if (string/starts-with? line "Head:") git-face-branch-local git-face-branch-remote))
    (append (if (< colon 0) '() (list [off (+ off (inc colon)) git-face-meta]))
      (if (= blen 0) '() (list [(+ off bstart) (+ off bstart blen) bface])))))

(defn- git-section-header-spans (line off)
  "Spans for a section header (`Unstaged changes (2):`): the name in the section face, the
`(N):` count in the dim meta face so the section name leads."
  (let (i (index-of line " ("))
    (if (< i 0)
      (git-whole-line off line git-face-section)
      (list [off (+ off i) git-face-section]
        [(+ off i 1) (+ off (string/length line)) git-face-meta]))))

(sig git-file-row-spans (string int -> any))
(defn- git-file-row-spans (line off)
  "Spans for a file row (`\"  modified   path\"`): the status label in its state colour, the path
left plain. A commit row (`\"  <hash>  subject\"`) instead gets its leading hash coloured; any
other 2-space line is left uncoloured."
  (let (end (string/length line)
        body (string/substring line 2 end)
        ;; the label runs to the DOUBLE space that separates it from the path, not to a
        ;; fixed column: a conflict's label says how it conflicted (`deleted by them`) and
        ;; is wider than the column the other labels are padded into. Measured by the
        ;; separator, any label colours; measured by `git-label-width`, the long ones
        ;; silently stopped.
        sep (index-of body "  ")
        field (if (< sep 0) (string/trim body) (string/substring body 0 sep))
        face (get git-label-faces field))
    (if face
      (list [(+ off 2) (+ off 2 (string/length field)) face])
      (let (sp (index-of body " ")
            tok (if (< sp 0) body (string/substring body 0 sp)))
        (if (git-hex? tok)
          (list [(+ off 2) (+ off 2 (string/length tok)) git-face-hash])
          '())))))

(defn- git-status-line-spans (line off)
  "The spans for one *git-status* line, dispatched on its shape: the header block, a section
header (dim count), an inline diff line (4-space indent), a file or commit row (2-space
indent), or the clean-tree note. `off` is the line's start offset in the buffer."
  (cond
    (= line "") '()
    ;; the in-progress banner, before the header rules it would otherwise match: it is a
    ;; `<verb>:` line like `Head:`, and it is the one line here that is a WARNING
    (includes? line "in progress") (git-whole-line off line git-face-unstaged)
    (or (string/starts-with? line "Head:")
      (string/starts-with? line "Merge:")
      (string/starts-with? line "Push:"))
      (git-header-spans line off)
    (string/ends-with? line ":") (git-section-header-spans line off)
    (string/starts-with? line "    ") (git-whole-line off line (git-diff-line-face line))
    (string/starts-with? line "  ") (git-file-row-spans line off)
    (string/starts-with? line "nothing to commit") (git-whole-line off line git-face-note)
    :else '()))

(defn- git-whole-line (off line face)
  "A whole-line span `[off end face]`, or `()` when `face` is nil."
  (if (nil? face) '() (list [off (+ off (string/length line)) face])))

(defn- git-log-line-spans (line off)
  "Spans for one `git log --oneline` row: just the leading commit hash (to the first space)."
  (let (i (index-of line " "))
    (if (< i 0) '() (list [off (+ off i) git-face-hash]))))

(defn- git-fontify-lines (lines off line-spans acc)
  "Tail-recursive: accumulate `(line-spans line off)` spans (prepended via `cons`, reversed
once at the end), advancing `off` by each line's length + 1 (the stripped newline).
`cons`+`reverse` rather than `append acc` so fontifying a large diff/log window is O(lines),
not O(lines²) — `append` recopies the whole accumulator each line."
  (if (empty? lines)
    (reverse acc)
    (git-fontify-lines (rest lines)
      (+ off (string/length (first lines)) 1)
      line-spans
      (fold (line-spans (first lines) off) acc (fn (a span) (cons span a))))))

(defn git-diff-fontify (src)
  "The *git-diff* `:fontify` — colour each unified-diff line (`git-diff-line-face`)."
  (git-fontify-lines (string/split src "\n")
    0
    (fn (l off) (git-whole-line off l (git-diff-line-face l)))
    '()))

(defn git-status-fontify (src)
  "The *git-status* `:fontify` — the header block, section headers (dim counts), colour-coded
file/commit rows, and inline diffs (`git-status-line-spans`)."
  (git-fontify-lines (string/split src "\n") 0 git-status-line-spans '()))

(defn git-log-fontify (src)
  "The *git-log* `:fontify` — the leading commit hash on each row."
  (git-fontify-lines (string/split src "\n") 0 git-log-line-spans '()))

;; ---- running git ------------------------------------------------------------

(defn- git-git (root args)
  "Run git in `root` with `args` (a vector); `{:exit :stdout :stderr}`. `core.quotePath=false`
keeps non-ASCII paths literal (no octal escapes) in status / diff output."
  (%os-cmd "git" (into ["-C" root "-c" "core.quotePath=false"] args)))

(defn- git-toplevel (dir)
  "The git work-tree root containing `dir`, or nil when `dir` isn't in a repo."
  (let (r (%os-cmd "git" ["-C" dir "rev-parse" "--show-toplevel"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn- git-branch (root)
  "The current branch name (or a short hash when detached), `?` on error."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "HEAD"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) "?")))

(defn- git-resolve-root (m)
  "The repo root: `:git-root` when already in a git buffer, else `git-toplevel` of the
current file's directory. Returns nil when not in a git repository."
  (or (:git-root m) (git-toplevel (commands/ed-default-dir m))))

;; ---- hunk parsing + patch construction (for hunk-level staging) ------------
;; Magit's defining feature: TAB on a file expands it into individual `@@` hunks, each
;; an actionable row. `s`/`u`/`k` on a hunk row builds a minimal one-hunk patch and pipes
;; it to `git apply --cached` (or its reverse) via `%os-cmd-stdin` — `git apply -` reads
;; the patch from stdin, avoiding any temp file.

(defn- git-finish-hunk (acc)
  "Flush the pending hunk (`{:header :lines}`) into `:hunks` and reset the accumulator."
  (if (nil? (:pending-header acc))
    acc
    (assoc acc
      :pending-header nil
      :pending-lines []
      :hunks
        (append (:hunks acc)
          (list {:header (:pending-header acc) :lines (:pending-lines acc)})))))

(defn- git-parse-hunks (diff-text)
  "Parse a unified diff into `{:headers [file-header-lines] :hunks [{:header @@-line :lines
body-lines}]}`. Lines before the first `@@` are file headers (diff/index/---/+++ lines);
each `@@`-prefixed line starts a new hunk whose body lines follow. Empty or nil input
gives zero hunks."
  (if (or (nil? diff-text) (= (string/trim diff-text) ""))
    {:headers [] :hunks []}
    (let (result (fold (string/split diff-text "\n")
                   {:headers [] :hunks [] :pending-header nil :pending-lines []}
                   (fn (acc line)
                     (cond
                       (string/starts-with? (string/triml line) "@@")
                         (assoc (git-finish-hunk acc)
                           :pending-header line
                           :pending-lines [])
                       (nil? (:pending-header acc))
                         (assoc acc :headers (append (:headers acc) (list line)))
                       :else (assoc acc :pending-lines (append (:pending-lines acc) (list line)))))))
      (let (final (git-finish-hunk result))
        {:headers (:headers final) :hunks (:hunks final)}))))

(defn- git-hunk-patch (parsed hunk)
  "A valid minimal patch for `hunk` alone: the diff file headers + this one hunk's lines,
joined with newlines and **terminated by one** — `git apply` rejects a patch whose final
line has no trailing newline as corrupt. Pass to `git apply --cached` (or `--reverse`) to
stage/unstage just this hunk."
  (str (string/join (append (:headers parsed) (list (:header hunk)) (:lines hunk)) "\n")
    "\n"))

(defn- git-apply-hunk (root patch-text cached? reverse?)
  "Pipe `patch-text` to `git apply -` (stdin). `cached?` adds `--cached` (index);
`reverse?` adds `--reverse` (for unstage/discard). Returns `{:exit :stdout :stderr}`."
  (%os-cmd-stdin "git"
    (into ["-C" root "-c" "core.quotePath=false" "apply" "--ignore-space-change"]
      (append (if cached? ["--cached"] [])
        (if reverse? ["--reverse"] [])
        ["-"]))
    patch-text))

;; ---- pure: parse `git status --porcelain -z` --------------------------------
;; The NUL-separated form is robust to paths with spaces / quotes / newlines (no quoting, no
;; octal escapes) — git never mangles a filename in `-z`. A rename or copy emits its NEW path
;; in the status token and the OLD source as a separate trailing token, which we consume.

(defn- git-parse-z (tokens acc)
  "Walk NUL-split `git status --porcelain -z` tokens into `{:x :y :path}` entries; a rename or
copy (`R`/`C` in the status code) consumes the following token as its source path, keeping the
new path under point."
  (if (empty? tokens)
    (reverse acc)
    (let (t (first tokens))
      (if (< (string/length t) 4)
        (git-parse-z (rest tokens) acc)
        (let (x (string/substring t 0 1)
              y (string/substring t 1 2)
              path (string/substring t 3 (string/length t))
              rename? (or (= x "R") (= x "C")))
          (git-parse-z (if rename? (rest (rest tokens)) (rest tokens))
            (cons {:x x :y y :path path} acc)))))))

(defn- git-entries (porcelain)
  "Parse `git status --porcelain -z` output (NUL-separated; a rename/copy carries its source as
a trailing field) into a list of `{:x :y :path}`."
  (git-parse-z (seq/reject (string/split porcelain "\u{0}") empty?) '()))

(defn- git-conflicted? (e)
  "Whether `e` is an unmerged path — a conflict waiting to be resolved.

Porcelain v1 spells these `UU` `AA` `DD` `AU` `UA` `DU` `UD`: either side `U`, or both
sides the same `A`/`D`. They are NOT staged-and-unstaged, which is how the plain
`git-staged?` / `git-unstaged?` tests read them — so before this, a conflicted file
appeared in both sections at once, and `s` on it staged a file with `<<<<<<<` markers in
it. Its own section is the fix, and the reason Magit has one."
  (let (x (:x e) y (:y e))
    (or (= x "U") (= y "U") (and (= x "A") (= y "A")) (and (= x "D") (= y "D")))))

(defn- git-untracked? (e) (and (= (:x e) "?") (= (:y e) "?")))
(defn- git-staged? (e) (and (not (= (:x e) " ")) (not (= (:x e) "?"))))
(defn- git-unstaged? (e) (and (not (= (:y e) " ")) (not (git-untracked? e))))

;; ---- the status-bar segments (branch + working-tree indicator) --------------
;; The branch and a colour-coded working-tree indicator on the status bar, for **every**
;; buffer in a repo (not just *git-status*). Built off the render path: the idle beat calls
;; `git-cache-status` to recompute the summary + segments and cache them on the model as
;; `:git-segments` (see `input`), which the view lays out (`view/ed-statusbar-segments`).
;; Both segments are clickable (→ `C-x g`) and carry a hover tooltip.

(def *git-branch-glyph* "⎇ ") ; the branch marker; set to "git:" if your font lacks ⎇
(def *git-state-glyph* "●") ; the working-tree state dot
(defn- git-upstream (root)
  "The upstream ref (e.g. `origin/main`) of the current branch, or nil when it has none."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{u}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn- git-ahead-behind (root)
  "`{:ahead :behind}` commit counts (as strings — tooltip-only) vs the upstream, or nil when
there is no upstream. `--left-right` counts the upstream side (behind) and the HEAD side (ahead)."
  (let (r (git-git root ["rev-list" "--left-right" "--count" "@{u}...HEAD"]))
    (if (not (= (:exit r) 0))
      nil
      (let (parts (seq/reject (string/split (string/trim (:stdout r)) "\t") empty?))
        (if (= (count parts) 2) {:behind (first parts) :ahead (second parts)} nil)))))

(defn git-summary (root)
  "A working-tree summary for the status bar, or nil outside a repo: `{:root :branch :upstream
:ahead :behind :staged :unstaged :untracked}`. Counts come from `git status --porcelain`;
ahead/behind are best-effort strings vs the upstream. A few `git` calls, so it runs off the
render path (the idle beat — `git-cache-status`)."
  (if (nil? root)
    nil
    (let (entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"])))
          upstream (git-upstream root)
          ab (and upstream (git-ahead-behind root)))
      {:root root
       :branch (git-branch root)
       :upstream upstream
       :ahead (and ab (:ahead ab))
       :behind (and ab (:behind ab))
       :staged (count (seq/filter entries git-staged?))
       :unstaged (count (seq/filter entries git-unstaged?))
       :untracked (count (seq/filter entries git-untracked?))})))

(defn- git-basename (path)
  "The last path component of `path` (the repo directory name), tolerating a trailing slash."
  (let (parts (seq/reject (string/split path "/") empty?))
    (if (empty? parts) path (last parts))))

(defn- git-dot-face (summary)
  "The state-dot colour: yellow when there are unstaged changes (a dirty tree), green when
only staged (ready to commit) or clean."
  (cond
    (> (:unstaged summary) 0) git-face-unstaged
    (> (:staged summary) 0) git-face-staged
    :else git-face-clean))

(defn- git-repo-tooltip (summary)
  "The branch segment's hover tooltip: repo name, branch, upstream, and ahead/behind."
  (append [(str "Repo:   " (git-basename (:root summary))) (str "Branch: " (:branch summary))]
    (if (:upstream summary)
      [(str "Upstream: " (:upstream summary))
        (str "↑ " (or (:ahead summary) "0") " ahead    ↓ " (or (:behind summary) "0") " behind")]
      ["(no upstream)"])))

(defn- git-tree-tooltip (summary)
  "The state-dot segment's hover tooltip: the working-tree counts, or 'clean'."
  (if (and (= (:staged summary) 0) (= (:unstaged summary) 0) (= (:untracked summary) 0))
    ["Working tree clean"]
    [(str "Staged:    " (:staged summary))
      (str "Unstaged:  " (:unstaged summary))
      (str "Untracked: " (:untracked summary))]))

(defn- git-count-seg (id prefix n face)
  "A colour-coded count segment (e.g. `+3`), or nil when the count is 0 (so it vanishes)."
  (if (= n 0) nil (seg id (str prefix n) {:sep "  " :face face})))

(defn- git-sync-count (s)
  "An ahead/behind count as an int — they arrive from `git rev-list --count` as strings,
and a missing upstream leaves them absent entirely."
  (let (n (if (string? s) (string/->number s) s))
    (if (int? n) n 0)))

(defn git-sync-seg (summary)
  "The `↓2 ↑1` upstream segment, or nil when the branch is level with its upstream (or has
none). What the background fetch is FOR: ahead/behind was already computed for the branch
tooltip, where you had to hover to find out the remote had moved. On the mode line it is
the thing you glance at — and `↓` appearing on its own is the notification arriving twice,
once as a message you might miss and once as a mark that stays."
  (if (nil? summary)
    nil
    (let (behind (git-sync-count (:behind summary))
          ahead (git-sync-count (:ahead summary))
          parts (seq/reject (list (if (> behind 0) (str "↓" behind) nil)
                              (if (> ahead 0) (str "↑" ahead) nil))
                  nil?))
      (if (empty? parts)
        nil
        (seg :git-sync
          (string/join parts " ")
          {:sep "  "
           ;; behind reads as "there is something to pull" — the colour the unstaged count
           ;; uses for "you have work to do"; ahead-only is quieter, it is just unpushed
           :face (if (> behind 0) git-face-unstaged git-face-branch)
           :on-click 'git/cmd-git-status
           :tooltip (str (if (> behind 0) (str behind " to pull") "")
                      (if (and (> behind 0) (> ahead 0)) ", " "")
                      (if (> ahead 0) (str ahead " to push") ""))})))))

(defn git-statusbar-segments (summary)
  "The git status-bar segments from `summary` (nil ⇒ `()`): a clickable **branch** segment
(tooltip: repo / upstream / ahead-behind; click: `C-x g`), a **state dot** coloured by the
working tree (tooltip: the counts; click: `C-x g`), then colour-coded **+staged ~unstaged
?untracked** counts, each shown only when non-zero. Pure — built from the cached summary."
  (if (nil? summary)
    '()
    (seq/filter (list (seg :git-branch
                        (str *git-branch-glyph* (:branch summary))
                        {:sep "  —  "
                         :face git-face-branch
                         :on-click 'git/cmd-git-status
                         :tooltip (git-repo-tooltip summary)})
                  (seg :git-dot
                    *git-state-glyph*
                    {:sep "   "
                     :face (git-dot-face summary)
                     :on-click 'git/cmd-git-status
                     :tooltip (git-tree-tooltip summary)})
                  (git-sync-seg summary)
                  (git-count-seg :git-staged "+" (:staged summary) git-face-staged)
                  (git-count-seg :git-unstaged "~" (:unstaged summary) git-face-unstaged)
                  (git-count-seg :git-untracked "?" (:untracked summary) git-face-untracked))
      (fn (s) (not (nil? s))))))

;; ---- the status summary, off the loop ---------------------------------------
;; `git-summary` is FOUR `git` subprocesses — `rev-parse --show-toplevel`, `status
;; --porcelain -z`, `rev-parse --abbrev-ref HEAD` and `rev-list --left-right --count` — and
;; it ran on the loop process on every idle beat. On a 27,310-file repo `git status` alone
;; measures 40 ms, and each spawn is a few more: fifty-odd milliseconds of frozen editor
;; every time typing settled, which is exactly when a reader looks up and notices. It also
;; scales with the repo rather than with anything the editor is doing.
;;
;; So it runs in a spawned task and folds its answer back like every other async recompute
;; (`model/ed-launch-gitdiff`, `ed-launch-diag`, `ed-launch-eldoc` — same shape, same reply
;; route).
;;
;; Note what travels: a KEY, not a root. Resolving the root is itself `git rev-parse
;; --show-toplevel`, so asking for the root on the loop — and asking again when the answer
;; lands, to check it is still the right one — would have left two of the four subprocesses
;; exactly where they were. The key is what the editor already knows (the git buffer's root
;; if it has one, the current buffer's directory, whether it is file-backed), it is free to
;; compute, and comparing it is how a stale answer is recognised.

(defn git-status-key (m)
  "What the status-bar summary is ABOUT, as a value the loop can compute for nothing:
`[git-root default-dir file-backed?]`. Resolving that to a repo root is a subprocess, so it
happens in the task; this is what is compared to tell a stale answer from a current one.

A **fileless** buffer (*scratch*, *Playground*, a report) that is not itself a git buffer
carrying `:git-root` has nothing to describe: it only *inherits* a `:dir` from wherever it
was created, and one that cannot be saved has no working-tree relationship for a branch +
dirty-state indicator to be about."
  [(:git-root m) (commands/ed-default-dir m) (and (buffer-file (ed-current-buf m)) true)])

(defn git-status-summary (key)
  "The working-tree summary for a `git-status-key`, or nil when there is nothing to describe.
Resolves the repo root and runs `git-summary` — five subprocesses all told, which is why
this is what the task runs and nothing on the loop calls it directly."
  (let ([git-root dir file?] key)
    (if (not (or git-root file?)) nil (git-summary (or git-root (git-toplevel dir))))))

(defn git-cache-status (m)
  "Recompute the cached git status-bar segments (`:git-segments`) + summary (`:git-summary`)
**synchronously**. The headless path, and the one the tests drive; a live editor goes through
`git-launch-status` instead."
  (let (summary (git-status-summary (git-status-key m)))
    (if (= summary (:git-summary m))
      m
      (assoc m :git-summary summary :git-segments (git-statusbar-segments summary)))))

(defn git-launch-status (m)
  "Recompute the status-bar git summary OFF the loop when nothing is already in flight.
Headless (no loop for a reply to land in) falls back to the synchronous `git-cache-status`,
so tests and a `--headless` daemon behave exactly as before."
  (cond
    (:git-proc m) m
    (ed-headless?) (git-cache-status m)
    :else
      (let (key (git-status-key m)
            job (task (fn () (git-status-summary key))))
        (assoc m :git-proc job :git-checking key))))

(defn git-apply-status (m summary)
  "Fold a finished summary into `:git-summary` + `:git-segments` and free the in-flight slot.
An answer about a buffer the reader has since left is dropped — the next idle beat asks about
the one they are in now."
  (let (asked (:git-checking m)
        m1 (dissoc m :git-proc :git-checking))
    (cond
      (not (= asked (git-status-key m1))) m1
      (= summary (:git-summary m1)) m1
      :else (assoc m1 :git-summary summary :git-segments (git-statusbar-segments summary)))))

;; ---- pure: render the status buffer (text + parallel per-line rows) ---------

(defn- git-row (e section)
  "The actionable row data for an entry shown in `section` (`:staged` / `:unstaged` /
`:untracked`): `{:path :staged? :untracked?}`."
  {:path (:path e)
   :staged? (= section :staged)
   :untracked? (= section :untracked)
   :unmerged? (= section :unmerged)})

(sig git-label-width int)
(def- git-label-width 9) ; "untracked" is the widest label
(defn- git-conflict-label (e)
  "How a conflict happened, from its two status letters — which is what decides how to
resolve it. `both modified` takes an edit; `deleted by them` takes a decision about whether
the file should exist at all, and no amount of editing the working copy expresses it."
  (let (x (:x e) y (:y e))
    (cond
      (and (= x "U") (= y "U")) "both modified"
      (and (= x "A") (= y "A")) "both added"
      (and (= x "D") (= y "D")) "both deleted"
      (and (= x "A") (= y "U")) "added by us"
      (and (= x "U") (= y "A")) "added by them"
      (and (= x "D") (= y "U")) "deleted by us"
      (and (= x "U") (= y "D")) "deleted by them"
      :else "unmerged")))

(defn- git-entry-label (e section)
  "A human-readable status label for `e` in `section`, matching Magit's file-status display."
  (cond
    (= section :unmerged) (git-conflict-label e)
    (= section :untracked) "untracked"
    (= section :staged)
      (cond
        (= (:x e) "M") "modified"
        (= (:x e) "A") "new file"
        (= (:x e) "D") "deleted"
        (= (:x e) "R") "renamed"
        (= (:x e) "C") "copied"
        :else (str (:x e) (:y e)))
    :else ; unstaged
      (cond
        (= (:y e) "M") "modified"
        (= (:y e) "D") "deleted"
        (= (:y e) "U") "conflict"
        :else (str (:x e) (:y e)))))

(defn- git-hunk-pairs (path section parsed)
  "`[line row]` pairs for one expanded section's parsed diff: each `@@` hunk header becomes an
actionable hunk row `{:path :section :hunk? true :hunk-patch}` so s/u/k operate on just that
hunk; its body lines (context, +/- lines) are non-actionable `nil` rows."
  (if (empty? (:hunks parsed))
    (list ["    (no diff)" nil])
    (mapcat (:hunks parsed)
      (fn (hunk)
        (let (patch (git-hunk-patch parsed hunk)
              hrow {:path path :section section :hunk? true :hunk-patch patch})
          (append (list [(str "    " (:header hunk)) hrow])
            (map (:lines hunk) (fn (l) [(str "    " l) nil]))))))))

(defn- git-file-pairs (e section expanded diffs)
  "`[line row]` pairs for one file in `section`: its `[\"  label   path\" row]` line (with a
human-readable status label rather than raw XY codes), plus — when the path is in `expanded`
— that section's parsed hunks as indented hunk rows and body lines (TAB toggles). Hunk `@@`
lines are actionable; body lines are nil."
  (let (path (:path e)
        label (git-entry-label e section)
        head [(str "  " (string/pad-right label git-label-width) "  " path) (git-row e section)]
        body (if (includes? expanded path)
               (let (parsed (get-in diffs [path section]))
                 (if (nil? parsed)
                   (list ["    (no diff)" nil])
                   (git-hunk-pairs path section parsed)))
               '()))
    (append (list head) body)))

(defn- git-section-pairs (title entries section expanded diffs &optional (collapsed '()))
  "`[line row]` pairs for one section (empty when no entries). The title line gets a
`{:section-header section}` row so TAB can detect and collapse it. When `section` is in
`collapsed`, only the header + a blank show (file rows are hidden)."
  (if (empty? entries)
    '()
    (append (list [(str title " (" (count entries) "):") {:section-header section}])
      (if (includes? collapsed section)
        '()
        (mapcat entries (fn (e) (git-file-pairs e section expanded diffs))))
      (list ["" nil] ["" nil])))) ; a blank rule between sections (Magit's breathing room)
(defn- git-parse-log-oneline (stdout)
  "Parse `git log --oneline` output into `({:hash :subject} ...)` — the leading abbreviated
hash (to the first space) and the rest as the subject. Blank output gives `()`."
  (map (seq/reject (string/split (string/trim (or stdout "")) "\n") empty?)
    (fn (line)
      (let (i (index-of line " "))
        {:hash (if (< i 1) line (string/substring line 0 i))
         :subject (if (< i 1) "" (string/substring line (inc i) (string/length line)))}))))

(defn- git-log-commits (root args)
  "Run `git log --oneline` with the extra `args` and parse the result (`git-parse-log-oneline`),
returning `()` when the command fails."
  (let (r (git-git root (into ["log" "--oneline"] args)))
    (if (= (:exit r) 0) (git-parse-log-oneline (:stdout r "")) '())))

(def- git-recent-count 10) ; how many recent commits the status buffer lists (Magit's default)
(defn- git-recent-commits (root)
  "The most recent commits on HEAD for the status buffer's `Recent commits` section."
  (git-log-commits root [(str "-" git-recent-count)]))

(defn- git-upstream-commits (root direction)
  "Commits between HEAD and upstream in `direction` (`:unpushed` → commits ahead of upstream;
`:unpulled` → commits upstream has that HEAD doesn't). Returns `({:hash :subject} ...)`,
or `()` when there is no upstream or the command fails."
  (git-log-commits root [(if (= direction :unpushed) "@{u}..HEAD" "HEAD..@{u}")]))

(defn- git-commit-pairs (title commits direction)
  "`[line row]` pairs for an upstream-commit section (Unpushed / Unpulled). The header gets a
`{:section-header direction}` row (TAB collapses); each commit gets a
`{:hash :subject :commit-log? true}` row (RET → `cmd-git-show-diff` shows the full diff)."
  (if (empty? commits)
    '()
    (append (list [(str title " (" (count commits) "):") {:section-header direction}])
      (map commits
        (fn (c)
          [(str "  " (:hash c) "  " (:subject c))
            {:hash (:hash c) :subject (:subject c) :commit-log? true}]))
      (list ["" nil] ["" nil]))))

(def- git-head-label-width 8) ; pads "Head:" / "Merge:" so the branch column aligns
(defn- git-head-line (label ref subject)
  "One header line: a left-padded `label` (`Head:` / `Merge:`), the branch/upstream `ref`, then
its commit `subject` (omitted when empty)."
  (str (string/pad-right label git-head-label-width) ref (if (= subject "") "" (str "  " subject))))

(defn- git-head-pairs (branch head)
  "The header block `[line row]` pairs: a `Head:` line (branch + latest commit subject) and,
when `head` carries an `:upstream`, a `Merge:` line (upstream + its subject), then one blank.
`head` is `{:subject :upstream :upstream-subject :sequencer}` (all optional — an empty map
just names the branch, as on a fresh repo).

`:sequencer` — the rebase / merge / cherry-pick this repo is part-way through — gets a line
of its own at the TOP, above Head:, saying what is in flight and which key finishes it.
That placement is the point. A repo stopped mid-rebase looks, in every other respect, like
a repo with some conflicted files in it; the difference is that HEAD is detached and half
your commits are not where you think they are. Magit puts it at the top for the same
reason, and a status buffer that does not say so is how people lose work."
  (let (upstream (:upstream head)
        seq (:sequencer head))
    (append (if seq
               (list [(git-head-line (str (:verb seq) ":")
                        "in progress"
                        "— r c continue · r s skip · r a abort")
                       {:sequencer (:kind seq)}]
                 ["" nil])
               '())
      (list [(git-head-line "Head:" branch (:subject head "")) nil])
      (if upstream
        (list [(git-head-line "Merge:" upstream (:upstream-subject head "")) nil])
        '())
      (list ["" nil]))))

(defn- git-render
  (branch entries
    &optional
    (expanded '())
    (diffs {})
    (collapsed '())
    (unpushed '())
    (unpulled '())
    (recent '())
    (head {}))
  "`{:text :rows}` for the status buffer. `:rows` is a vector parallel to the buffer's lines —
nil on a blank/body line; `{:section-header section}` on a section title line (TAB collapses);
`{:path :staged? :untracked?}` for a file row; `{:path :section :hunk? true :hunk-patch ...}` for
an inline hunk row; `{:hash :subject :commit-log? true}` for an unpushed/unpulled/recent commit row.
`diffs` is `path → {section → parsed}` from `git-expanded-diffs`; `head` (see `git-head-pairs`)
carries the branch/upstream commit subjects for the header block."
  (let (conflicted (seq/filter entries git-conflicted?)
        pairs (append (git-head-pairs branch head)
                ;; FIRST, above everything: a conflicted file is the only thing in the
                ;; buffer you cannot make progress without dealing with.
                (git-section-pairs "Unmerged paths"
                  conflicted
                  :unmerged expanded
                  diffs
                  collapsed)
                (git-section-pairs "Untracked files"
                  (seq/filter entries git-untracked?)
                  :untracked expanded
                  diffs
                  collapsed)
                (git-section-pairs "Unstaged changes"
                  (seq/reject (seq/filter entries git-unstaged?) git-conflicted?)
                  :unstaged expanded
                  diffs
                  collapsed)
                (git-section-pairs "Staged changes"
                  (seq/reject (seq/filter entries git-staged?) git-conflicted?)
                  :staged expanded
                  diffs
                  collapsed)
                (if (empty? entries)
                  (list ["nothing to commit, working tree clean" nil] ["" nil])
                  '())
                (git-commit-pairs "Unpushed to upstream" unpushed :unpushed)
                (git-commit-pairs "Unpulled from upstream" unpulled :unpulled)
                (git-commit-pairs "Recent commits" recent :recent)))
    {:text (string/join (map pairs first) "\n") :rows (into [] (map pairs second))}))

(defn- git-row-section (row)
  "Which section a status row belongs to — `:untracked` / `:staged` / `:unstaged` — or nil for
section-header, commit-log, blank, and inline-diff rows. Hunk rows carry their section explicitly."
  (cond
    (nil? row) nil
    (:section-header row) nil
    (:commit-log? row) nil
    (:hunk? row) (:section row)
    (:unmerged? row) :unmerged
    (:untracked? row) :untracked
    (:staged? row) :staged
    :else :unstaged))

(defn- git-file-row? (row)
  "True for a plain file row (`{:path :staged? :untracked?}`), distinguishing it from section-header,
hunk, commit-log, and nil rows."
  (and (not (nil? row))
    (nil? (:section-header row))
    (not (:hunk? row))
    (not (:commit-log? row))))

(defn- git-section-lines (rows section)
  "The 0-based line indices of the file rows in `section`, top to bottom (parallel to the
buffer's lines, the same indexing `git-row-at` uses)."
  (get (fold rows
         {:i 0 :ls '()}
         (fn (acc r)
           {:i (inc (:i acc))
            :ls (if (= (git-row-section r) section)
                  (append (:ls acc) (list (:i acc)))
                  (:ls acc))}))
    :ls))

;; ---- the status buffer + the per-row reader ---------------------------------

(defn- git-sections-of (e)
  "The sections an entry appears in. A file with both staged and unstaged changes is in two, so
its diff is fetched (and shown) once per section."
  (if (git-conflicted? e)
    ;; a conflict shows ONCE, in its own section — never also as staged and unstaged, which
    ;; is what the plain tests below say about it
    (list :unmerged)
    (append (if (git-staged? e) (list :staged) '())
      (if (git-unstaged? e) (list :unstaged) '())
      (if (git-untracked? e) (list :untracked) '()))))

(defn- git-diff-args (section path)
  "The `git diff` argv for `path` in `section`: the staged diff (`--cached`), the working-tree
diff, or — for an untracked file — its whole content as additions (`--no-index` vs /dev/null)."
  (cond
    (= section :staged) ["diff" "--cached" "--" path]
    (= section :untracked) ["diff" "--no-index" "--" "/dev/null" path]
    ;; a conflict has no single "other side" to diff against, so git's own combined diff is
    ;; what a merge conflict looks like: both parents at once, two columns of markers
    (= section :unmerged) ["diff" "--" path]
    :else ["diff" "--" path]))

(defn- git-expanded-diffs (root entries expanded)
  "`{path → {section → parsed}}` for each expanded file, where `parsed` is the
`{:headers :hunks}` map from `git-parse-hunks`. One diff per section (staged row shows its
`--cached` diff, unstaged row the working-tree diff). Each fetch is done once."
  (fold entries
    {}
    (fn (acc e)
      (let (path (:path e))
        (if (includes? expanded path)
          (fold (git-sections-of e)
            acc
            (fn (a section)
              (assoc-in a
                [path section]
                (git-parse-hunks (get (git-git root (git-diff-args section path)) :stdout "")))))
          acc)))))

(defn- git-visible-expanded (prev-rows expanded top vrows)
  "The paths from `expanded` whose file row falls within one viewport of `[top, top+vrows)` in
`prev-rows` (the rows from the most recent render), plus any path not yet in `prev-rows` (newly
expanded — always fetch). When `prev-rows` is empty (first render), returns all of `expanded`.
The one-viewport margin above and below makes scrolling feel instant."
  (if (empty? prev-rows)
    expanded
    (let (lo (math/max 0 (- top vrows))
          hi (+ top (* 2 vrows)))
      (seq/filter expanded
        (fn (path)
          (let (i (seq/index-where prev-rows (fn (r) (and r (= (:path r) path)))))
            (or (< i 0) (and (>= i lo) (< i hi)))))))))

;; ---- the status buffer's eight subprocesses, off the loop --------------------
;; `git status --porcelain` is not fast on every repo. Measured on a mix project whose
;; `.git` is 128 MB: **5.4 seconds** for the status call alone, 17 s for the seven the
;; status buffer runs — because git walks `_build/` and `deps/` to decide they are
;; ignored. On the loop that is a 17-second freeze on `C-x g`, and another on every `g`,
;; `s` and `u` after it.
;;
;; The split that makes it fixable: COLLECT (every subprocess, plain data in and out, so
;; it can cross a process boundary) and RENDER (pure, needs the model). Collect runs in a
;; task; render folds the answer. Headless collects inline, so tests still drive real git.

(defn git-status-inputs (m root)
  "Everything the collection needs from the model, as plain data — read on the loop before
the task starts, because a task cannot see the model and a rope cannot cross to it."
  {:root root
   :expanded (:git-expanded m '())
   :prev-rows (:git-rows m '())
   :top (model/ed-current-top m)
   :vrows (or (:view-rows m) 40)})

(defn git-collect-status (inputs)
  "Every git subprocess the status buffer needs, as one plain-data answer. The whole of
what used to run on the dispatch path. Safe to run in a task: plain data in, plain data
out, no model and no rope."
  (let (root (:root inputs)
        entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"]) ""))
        vis-expanded (git-visible-expanded (:prev-rows inputs)
                       (:expanded inputs)
                       (:top inputs)
                       (:vrows inputs))
        upstream (git-upstream root)
        recent (git-recent-commits root))
    {:root root
     :branch (git-branch root)
     :entries entries
     :diffs (git-expanded-diffs root entries vis-expanded)
     :unpushed (if upstream (git-upstream-commits root :unpushed) '())
     :unpulled (if upstream (git-upstream-commits root :unpulled) '())
     :recent recent
     :head {:sequencer (git-sequencer root)
            :subject (if (empty? recent) "" (:subject (first recent) ""))
            :upstream upstream
            :upstream-subject (if upstream
                                (let (cs (git-log-commits root ["-1" upstream]))
                                  (if (empty? cs) "" (:subject (first cs) "")))
                                "")}}))

(defn- git-render-status (m root collected &optional (line nil))
  "PURE: fold a finished `git-collect-status` into `*git-status*` for repo `root`, recording
`:git-root`/`:git-rows`. `line` places point: a 1-based number, nil (default — the first
file row if any, else the top), or a function `(rows -> 1-based line)` resolved against the
freshly-rendered rows (see `git-stay-in-section`). Respects `:git-expanded` and
`:git-collapsed-sections`.

No subprocess runs here — that is `git-collect-status`, and keeping the two apart is what
lets the slow half go in a task."
  (let (expanded (:git-expanded m '())
        collapsed (:git-collapsed-sections m '())
        r (git-render (:branch collected)
            (:entries collected)
            expanded
            (:diffs collected)
            collapsed
            (:unpushed collected)
            (:unpulled collected)
            (:recent collected)
            (:head collected))
        rows (:rows r)
        target (cond
                 (fn? line) (line rows)
                 (nil? line) (git-first-row-line rows)
                 :else line)
        m1 (ed-show-named (assoc m :git-root root :git-rows rows)
             "*git-status*"
             (:text r)
             :git-status)
        ;; stash the off-text line→location map on the buffer so the SHARED
        ;; `results/line-links-loc` makes each file row a clickable link — pointer cursor +
        ;; hover underline + click/RET → the file — the exact mechanism *Tests* uses.
        gi (ed-buffer-index-by-name m1 "*git-status*")
        m2 (if (nil? gi)
             m1
             (update m1
               :buffers assoc
               gi
               (assoc (ed-buf-at m1 gi) :line-links (git-status-line-links rows root)))))
    (ed-apply m2 (fn (b) (commands/ed-goto-line b target)))))


(defn- git-show-status (m root &optional (line nil))
  "Show/refresh `*git-status*` for `root` — collecting OFF the loop.

The editor gets the buffer immediately (the previous contents while a refresh is in
flight, a `Loading…` placeholder the first time) and the real thing when the eight
subprocesses land. On a repo where `git status` takes five seconds, the difference is
between an editor that is frozen for five seconds and one that says so and keeps working.

Headless collects inline: no loop means no reply, and every git test wants the real
answer synchronously."
  (if (model/ed-headless?)
    (git-render-status m root (git-collect-status (git-status-inputs m root)) line)
    (let (inputs (git-status-inputs m root)
          job (task (fn () (git-collect-status inputs)) {:timeout *git-op-timeout-ms*})
          ;; the first open has nothing to show yet; a refresh keeps what is on screen
          ;; rather than blanking it, because a flicker back to "Loading" on every `g`
          ;; is worse than a stale half-second
          m1 (if (nil? (:git-rows m))
               (ed-show-named (assoc m :git-root root) "*git-status*" "Loading…\n" :git-status)
               (assoc m :git-root root)))
      (assoc m1 :git-status-proc job :git-status-line line))))

(defn git-apply-show-status (m collected)
  "Fold a finished status collection into the buffer. A nil answer (the task errored or
timed out) says so rather than rendering an empty repo, which is what a blank `entries`
would look like — a clean working tree, confidently wrong."
  (let (line (:git-status-line m)
        m1 (dissoc m :git-status-proc :git-status-line))
    (cond
      (nil? collected) (message m1 "git status failed or timed out")
      ;; an answer about a repo the reader has since left
      (not (= (:root collected) (:git-root m1))) m1
      :else (git-render-status m1 (:root collected) collected line))))
(defn- git-status-line-links (rows root)
  "The 0-based-line → `{:file :line}` map for *git-status*: every plain file row links to its
file (line 1); section-header / hunk / commit-log rows link to nothing. Read by the shared
`results/line-links-loc` `:line-loc`."
  (fold (range (count rows))
    {}
    (fn (acc i)
      (let (row (nth rows i))
        (if (git-file-row? row)
          (assoc acc i {:file (path/join root (:path row)) :line 1})
          acc)))))

(defn- git-first-row-line (rows)
  "The 1-based line of the first file row in `rows` (skipping section-header rows), or 1 if none."
  (let (i (seq/index-where rows git-file-row?))
    (if (< i 0) 1 (inc i))))

(defn- git-row-at (m)
  "The `{:path :staged? :untracked?}` on the current `*git-status*` line, or nil on a
header/blank."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (and rows (>= i 0) (< i (count rows))) (nth rows i) nil)))

(defn- git-stay-in-section (m)
  "A `(new-rows -> 1-based line)` for `git-show-status` that keeps point in the section of the
row currently under point, across a rebuild: on whatever file slides into its slot — the next
file, the section's last when it was the bottom one, or the first actionable row if the section
emptied. When point isn't on a file row (a header / blank / inline-diff line) it keeps the
literal line. This is the single cursor policy every refresh shares, so the commands that move
the file under point out of its section (stage / unstage / discard) land on the next file to act
on instead of chasing it into another section, while a plain refresh / expand stays put."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m))
        section (git-row-section (git-row-at m)))
    (if (nil? section)
      (fn (new-rows)
        (let (target (math/min (inc i) (dec (count new-rows))))
          (if (and (not (= (count new-rows) (count rows))) (nil? (get new-rows (dec target))))
            (git-first-row-line new-rows)
            target)))
      (let (before (count (seq/filter (git-section-lines rows section) (fn (j) (< j i)))))
        (fn (new-rows)
          (let (ls (git-section-lines new-rows section))
            (if (empty? ls)
              (git-first-row-line new-rows)
              ;; the index is clamped into `ls`, so the default is never taken
              (inc (nth ls (math/min before (dec (count ls))) 0)))))))))

;; ---- git off the loop: no git command ever blocks a keystroke -----------------
;; Every `git-git` here is a SUBPROCESS, and three of them talk to a network: `pull`,
;; `push`, `fetch`. Run on the loop, a pull over a slow link freezes the whole editor —
;; no repaint, no C-g, nothing — for as long as the remote takes. That is not a git
;; problem; it is the one thing a Brood editor has no excuse for, because the language's
;; whole answer to blocking work is a process.
;;
;; So: a git command that can take longer than a frame goes through `git-launch-op`,
;; which runs it in a `task` and folds the result when it lands (the same launch / fold /
;; row shape as every other off-loop recompute — `input/ed-task-replies`). The editor
;; stays live, the mode line says what is running, and C-g cancels it.
;;
;; `ed-headless?` keeps the synchronous path for tests and `--headless`, where there is no
;; loop for a reply to land in — so every existing git test still exercises real git.

(def *git-op-timeout-ms* 120000)
;; A network git operation gets two minutes before the task is killed and reported as a
;; timeout. Unbounded is how a wedged `pull` against an unreachable host becomes a slot
;; that never frees and a `git` that is "already running" until restart.

(defn git-op-running (m)
  "The verb of the git operation in flight (`\"pull\"`, `\"push\"`, …), or nil."
  (get-in m [:git-op :verb]))

;; check-allow: `then` is an opaque caller-supplied `(model result) -> model`, so the
;; checker cannot see what the last branch returns. ADR-341 names `:trusted` for exactly
;; this — the declaration is the contract, and every branch here is a `message` or a fold.
(check-allow :trusted
  (sig git-launch-op (model string seqable &optional any -> model))
  (defn git-launch-op (m verb args &optional (then nil))
  "Run `git args` in the repo root OFF the loop and report when it lands. `then` is an
optional `(model result) -> model` run after the report — a refresh, usually.

Refuses to start a second operation while one is in flight: two pulls at once is not a
thing anyone means, and the in-flight slot holds exactly one handle. Headless runs it
synchronously, because there is no loop to hand the reply to."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      (git-op-running m) (message m (str "git " (git-op-running m) " is already running"))
      (model/ed-headless?)
        (let ([m0 r] (git-run (assoc m :git-root root) args)
              m1 (git-report-cmd m0 verb r))
          (if (nil? then) m1 (then m1 r)))
      :else
        ;; the entry is recorded when the command STARTS, so an in-flight pull reads as
        ;; `run git pull` in the process log while it is still out there — which is the
        ;; question you have when one is slow
        ;; the entry is journalled when the command STARTS, so an in-flight pull reads as
        ;; `run git pull` while it is still out there — which is the question you have
        ;; when one is slow. `git-apply-op` completes it; the entry times itself.
        (let (job (task (fn () (git-git root args)) {:timeout *git-op-timeout-ms*})
              [logged id] (git-journal-add m (git-entry args)))
          (assoc (message logged (str verb "…"))
            :git-op-proc job
            :git-op {:verb verb :root root :then then :entry id}))))))

(check-allow :trusted
  (sig git-apply-op (model any -> model))
  (defn git-apply-op (m r)
  "Fold a finished `git-launch-op`: report the outcome and run its `then`. A nil `r` is the
task having errored or timed out — said plainly, rather than reported as a success with an
empty output, which is what a bare exit-code check would do with it."
  (let (op (:git-op m)
        verb (or (:verb op) "git")
        m1 (git-journal-finish (dissoc m :git-op :git-op-proc) (:entry op) r))
    (if (nil? r)
      (message m1
        (str verb " failed: no result (timed out after " *git-op-timeout-ms* "ms)" (git-journal-note)))
      (let (m2 (git-report-cmd m1 verb r))
        (if (nil? (:then op)) m2 ((:then op) m2 r)))))))

;; ---- the repo watches itself: a background fetch, and being TOLD ------------
;; Magit shows you the truth as of the last time you asked it to fetch. You find out the
;; remote moved by pressing `f f` and looking — which means in practice you find out when
;; you try to push and are told no.
;;
;; bedit fetches on a timer, in a task, and SAYS SO when the answer changes: "origin/main:
;; 3 new commits (F to pull)". It costs nothing on the loop and it is the difference
;; between a status buffer you interrogate and a repo that tells you about itself. That is
;; the whole "better than magit" claim, and it is only possible because the fetch is a
;; process rather than something you have to stop and wait for.
;;
;; `git fetch` is network and can hang; it rides `task` with the same timeout as a pull,
;; and a fetch already in flight is never started twice.

(def *git-fetch-every-ms* 180000)
;; How often to fetch in the background (3 minutes). Long enough that a laptop on a phone
;; tether is not fetching constantly, short enough that "someone pushed" reaches you while
;; it still matters. `nil` turns the watch off entirely.

(defn git-fetch-key (m)
  "What a background fetch would be ABOUT — the repo root, or nil when there is no repo to
watch. Compared on the reply so an answer about a repo you have since left is dropped."
  (or (:git-root m) (:git-summary-root m) (get-in m [:git-summary :root])))

(defn git-fetch-upstream (root)
  "Fetch quietly and report the upstream's position afterwards: `{:root :upstream :behind
:ahead}`, or nil when there is no upstream to watch. Runs in a task — three subprocesses,
one of them a network round trip."
  (if (nil? root)
    nil
    (let (upstream (git-upstream root))
      (if (nil? upstream)
        nil
        (do
          ;; the fetch itself; its exit code does not matter here — offline just means the
          ;; counts below are unchanged, which is exactly the right thing to report
          (git-git root ["fetch" "--quiet"])
          (let (ab (git-ahead-behind root))
            {:root root
             :upstream upstream
             :behind (get ab :behind "0")
             :ahead (get ab :ahead "0")}))))))

(defn git-launch-fetch (m)
  "Start the background fetch OFF the loop, unless one is in flight, the watch is off, or
there is no repo. Never runs headless — a test or a daemon has no business reaching the
network on a timer."
  (let (root (git-fetch-key m))
    (cond
      (not (int? *git-fetch-every-ms*)) m ; the watch switched off (set it to nil)
      (:git-fetch-proc m) m
      (nil? root) m
      (model/ed-headless?) m
      :else (assoc m :git-fetch-proc (task (fn () (git-fetch-upstream root))
                                       {:timeout *git-op-timeout-ms*})))))

(defn git-upstream-news (before after)
  "What to say about the upstream having moved, or nil when there is nothing to say.

Only an INCREASE in `behind` is news. Reporting the count every time would announce the
same three commits every three minutes until you pulled them, which is how a notification
becomes something you learn to ignore."
  (let (was (string/->number (get before :behind "0"))
        now (string/->number (get after :behind "0"))
        was (if (int? was) was 0)
        now (if (int? now) now 0))
    (if (or (<= now 0) (<= now was))
      nil
      (str (:upstream after)
        ": "
        (- now was)
        " new commit"
        (if (= (- now was) 1) "" "s")
        (if (> was 0) (str " (" now " behind)") "")
        " — F to pull"))))

(defn git-apply-fetch (m result)
  "Fold a finished background fetch: free the slot, remember the upstream position, and say
so if the remote moved. An answer about a repo the reader has since left is dropped."
  (let (m1 (dissoc m :git-fetch-proc))
    (cond
      (nil? result) m1
      (not (= (:root result) (git-fetch-key m1))) m1
      :else
        (let (news (git-upstream-news (:git-upstream-seen m1) result)
              m2 (assoc m1 :git-upstream-seen result)
              ;; a moved upstream also makes the *git-status* Unpulled section stale
              m3 (if (and news (:git-rows m2)) (git-refresh m2) m2))
          (if (nil? news) m3 (message m3 news))))))

(defcommand cmd-git-fetch
  (m key)
  "Fetch from the remote now (f) — off the loop. The background watch does this on a timer;
this is for when you know something landed and do not want to wait for it."
  (if (nil? (git-fetch-key m))
    (message m "not in a git repository")
    (message (git-launch-fetch (dissoc m :git-fetch-proc)) "fetching…")))

(defn- git-refresh (m)
  "Refresh `*git-status*` in place, keeping point in its section (`git-stay-in-section`)."
  (git-show-status m (:git-root m) (git-stay-in-section m)))

(defn- git-refresh-if-open (m _r)
  "Refresh `*git-status*` when it is open — the usual `then` for a `git-launch-op`."
  (if (nil? (:git-rows m)) m (git-refresh m)))

(defn- git-scan-rows (rows j dir n)
  "From 0-based position `j`, step `dir` (+1 or -1) `n` times, skipping nil (blank/diff-body)
rows. Returns the clamped 1-based landing line. Section-header, file, hunk, and commit-log
rows are all navigable; only nil rows are skipped."
  (if (= n 0)
    (inc j)
    (let (j2 (+ j dir))
      (cond
        (< j2 0) (inc j)
        (>= j2 (count rows)) (inc j)
        (nil? (nth rows j2)) (git-scan-rows rows j2 dir n)
        :else (git-scan-rows rows j2 dir (dec n))))))

;; ---- commands: open / navigate / stage / unstage / discard / refresh / quit -

(defcommand cmd-git-status
  (m key)
  "Open the git status buffer for the current project (C-x g). Files start collapsed; TAB on a
file expands its diff inline."
  (let (root (git-toplevel (commands/ed-default-dir m)))
    (if (nil? root) (message m "not in a git repository") (git-show-status m root))))

(defcommand cmd-git-next-item
  (m key)
  "Jump to the next actionable row — file, hunk, commit, or section header — skipping inline
diff body lines (n). Falls back to line-by-line motion outside a status buffer."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (nil? rows)
      (commands/cmd-next-line m key)
      (ed-apply m (fn (b) (commands/ed-goto-line b (git-scan-rows rows i 1 1)))))))

(defcommand cmd-git-prev-item
  (m key)
  "Jump to the previous actionable row — file, hunk, commit, or section header — skipping
inline diff body lines (p)."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (nil? rows)
      (commands/cmd-previous-line m key)
      (ed-apply m (fn (b) (commands/ed-goto-line b (git-scan-rows rows i -1 1)))))))

(defcommand cmd-git-stage
  (m key)
  "Stage the file or hunk on the current line (s). Hunk row: `git apply --cached` with just
that hunk's patch. File row: `git add -- <path>`. Section header or commit row: no-op."
  (let (row (git-row-at m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) (message m "press S to stage all, or move to a specific file")
      (:commit-log? row) m
      (:hunk? row) (git-do-hunk m "stage hunk" (:hunk-patch row) true false)
      :else (git-do m "stage" ["add" "--" (:path row)]))))

(defcommand cmd-git-stage-all
  (m key)
  "Stage all tracked modified files (S) — `git add -u`."
  (let (root (:git-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do m "stage all" ["add" "-u"]))))

(defcommand cmd-git-unstage
  (m key)
  "Unstage the file or hunk on the current line (u). Hunk row: `git apply --cached --reverse`
with just that hunk. File row: `git reset HEAD -- <path>`. Section header or commit row: no-op."
  (let (row (git-row-at m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) (message m "press U to unstage all, or move to a specific file")
      (:commit-log? row) m
      (:hunk? row) (git-do-hunk m "unstage hunk" (:hunk-patch row) true true)
      :else (git-do m "unstage" ["reset" "-q" "HEAD" "--" (:path row)]))))

(defcommand cmd-git-unstage-all
  (m key)
  "Unstage all staged changes (U) — `git reset HEAD`."
  (let (root (:git-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do m "unstage all" ["reset" "HEAD"]))))

(defcommand cmd-git-discard
  (m key)
  "Discard the working-tree changes to the file or hunk on the current line (k), after
confirmation. Hunk row: `git apply --reverse`. File row: `git checkout -- <path>`.
Section headers, commit rows, and untracked files are no-ops."
  (let (row (git-row-at m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) m
      (:commit-log? row) m
      (:untracked? row) (message m "untracked file — remove it from a shell, not here")
      (:hunk? row)
        (ed-read-char m
          "Discard hunk? (y/n) "
          (fn (mm c)
            (if (or (= c "y") (= c "Y"))
              (git-do-hunk mm "discard hunk" (:hunk-patch row) false true)
              (message mm "discard cancelled"))))
      :else
        (ed-read-char m
          (str "Discard changes to " (:path row) "? (y/n) ")
          (fn (mm c)
            (if (or (= c "y") (= c "Y"))
              (git-do mm "discard" ["checkout" "--" (:path row)])
              (message mm "discard cancelled")))))))

(defcommand cmd-git-refresh
  (m key)
  "Re-read git status (g)."
  (git-refresh m))

(defcommand cmd-git-expand
  (m key)
  "TAB: on a section header, toggle the section's collapse (`:git-collapsed-sections`); on a
file row, toggle its inline diff. Hunk, commit-log, and blank rows are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row)
        (let (sec (:section-header row)
              cols (:git-collapsed-sections m '())
              cols2 (if (includes? cols sec)
                      (seq/reject cols (fn (s) (= s sec)))
                      (cons sec cols)))
          (git-show-status (assoc m :git-collapsed-sections cols2) root (git-stay-in-section m)))
      (or (:hunk? row) (:commit-log? row)) m
      :else
        (let (path (:path row)
              exp (:git-expanded m '())
              exp2 (if (includes? exp path)
                     (seq/reject exp (fn (p) (= p path)))
                     (cons path exp)))
          (git-show-status (assoc m :git-expanded exp2) root (git-stay-in-section m))))))

(defcommand cmd-git-visit
  (m key)
  "Visit (open) the file on the current line — bound to a mouse click. Section headers,
commit-log rows, and blank lines are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row) m
      (:commit-log? row) m
      ;; next-error discipline (shared with *Tests*/*Run*/compilation): the file
      ;; opens in another pane, the *git-status* buffer stays visible
      :else (commands/ed-pop-to-file m (path/join root (:path row)) 1))))

(defcommand cmd-git-quit
  (m key)
  "Bury the git status buffer (q)."
  (cmd-kill-buffer m key))

;; ---- the journal: what git actually ran (`$`) ---------------------------------
;; Magit's `$` (`magit-process-buffer`): every git invocation, its exit code and its
;; output, newest last — the answer to "what did it actually run" and to "it failed and
;; the echo area only gave me one line of it".
;;
;; Called the JOURNAL and not the process log because this file already has three `proc`s
;; that are handles to running things (`:git-proc`, `:git-op-proc`, `:git-fetch-proc`),
;; and a `:git-process` four characters away from `:git-proc` meaning a list of past
;; commands is a misreading waiting to happen. The BUFFER is still `*git-process*`: that
;; is the name a Magit user is looking for.
;;
;; It lives on the MODEL rather than in a shared table because every command worth
;; recording already threads the model — the synchronous ones through `git-run`, the
;; network ones through `git-launch-op` (recorded when they START, so an in-flight pull
;; reads `run`) and `git-apply-op` (completed when they land). A read-only command a
;; renderer runs to draw a diff is not in here; Magit logs those too and they are mostly
;; noise.
;;
;; Four things this does that Magit does not:
;;   - a DURATION per entry (Magit has an optional timestamp, off by default), which is
;;     what you actually want to know when a push feels slow;
;;   - `\r` progress applied properly — `git push`'s "Writing objects: 47%" rewrites its
;;     line, so the entry holds the line it ended on rather than forty of them. Magit
;;     does this by hand in its process filter (find the last ^M, delete the line); bedit
;;     has `ansi/render`, a real terminal, from the terminal buffer (brood ADR-384);
;;   - credentials in a remote URL are REDACTED, because a journal gets pasted into bug
;;     reports;
;;   - the NUL a `-z` command separates its paths with is shown as `^@` rather than
;;     written into the rope. Emacs shows those raw.

(def *git-journal-max* 64) ; entries kept; the oldest go first, never one still running

;; ---- an entry ----------------------------------------------------------------
;; `{:id :verb :args :exit :ms :output :running? :at}` — one map, built in ONE place, so
;; the three producers (a synchronous run, a hunk apply, a launched network op) cannot
;; drift into three shapes.

(defn- git-redact (s)
  "`s` with any `user:secret@` credential in a URL replaced by `user:***@`."
  (regex/replace "://([^/@:\\s]+):[^/@\\s]+@" s "://$1:***@"))

(defn- git-printable (s)
  "`s` made fit to put in a rope: `\\r` progress and escape sequences APPLIED (so
\"Writing objects: 47%\" is the line it ended on, not forty lines), the NUL a `-z`
command separates paths with shown as `^@`, and credentials redacted."
  (let (rendered (if (or (includes? s "\r") (includes? s "\e")) (ansi/render "" s) s))
    (git-redact (string/trimr (string/replace rendered (string/int->char 0) "^@")))))

(defn- git-entry-output (r)
  "The output an entry shows: stderr then stdout — git says the interesting thing on
stderr — or what a task that never answered leaves behind."
  (if (nil? r)
    "no result (timed out)"
    (git-printable (str (:stderr r "") (:stdout r "")))))

(defn- git-entry (args)
  "A journal entry for `git args`, as it reads while it is still running. No `verb`: the
label a command puts in the echo area (`stage hunk`) is the echo's business, and an entry
that carried both could disagree with the command line — which is the one thing this
buffer exists to be right about."
  {:args (into [] args) :running? true :at (os/now)})

(defn- git-entry-done (e r)
  "Entry `e` completed by result `r` (nil = the task never answered), timed from its
own `:at` — the entry knows when it started, so nothing else has to carry that."
  (assoc e
    :running? false
    :ms (- (os/now) (or (:at e) (os/now)))
    :exit (if (nil? r) nil (:exit r))
    :output (git-entry-output r)))

;; ---- the log ------------------------------------------------------------------
;; The buffer is a VIEW of the log, not a copy of it: every write re-renders it in place
;; (`ed-upsert-named` — no pane, no selection touched) when it happens to be open, so a
;; `pull` you are watching completes in front of you rather than when you next press `g`.
;; Nothing happens at all when it is closed, which is the usual case.

;; check-allow: `:git-journal` is the log this file owns and only ever writes as a
;; vector; the model record does not declare it, so `or` reads as every value a map
;; key could hold.
(check-allow :trusted
  (sig git-journal (model -> vector))
  (defn git-journal (m)
    "The git journal, oldest first."
    (or (:git-journal m) [])))

(defn- git-journal-sync (m)
  "Re-render *git-process* in place when it is open; the model unchanged when it is not."
  (if (nil? (ed-buffer-index-by-name m "*git-process*"))
    m
    (commands/ed-upsert-named m "*git-process*" (git-journal-text m) :git-process)))

(defn- git-journal-trim (entries)
  "`entries` cut to `*git-journal-max*`, dropping the oldest — but never one still
running, whose output has not arrived yet."
  (let (n (count entries))
    (if (<= n *git-journal-max*)
      entries
      (into [] (append (seq/filter (seq/subvec entries 0 (- n *git-journal-max*)) :running?)
                 (seq/subvec entries (- n *git-journal-max*)))))))

(defn- git-journal-add (m entry)
  "`[model' id]`: the model with `entry` appended under a fresh id, the log trimmed and
the buffer re-rendered if it is open."
  (let (id (or (:git-journal-seq m) 1))
    [(git-journal-sync
       (assoc m
         :git-journal (git-journal-trim (into (git-journal m) [(assoc entry :id id)]))
         :git-journal-seq (inc id)))
      id]))

(defn- git-journal-finish (m id r)
  "The model with running entry `id` completed by result `r` — unchanged when that entry
has already been trimmed away. Re-renders the buffer if it is open, so a `pull` you are
watching stops reading `run` the moment it lands."
  (git-journal-sync
    (assoc m
      :git-journal
        (into [] (map (git-journal m) (fn (e) (if (= (:id e) id) (git-entry-done e r) e)))))))

(defn git-journal-note ()
  "The hint appended to a failed command's message: how to see the whole output. Magit
appends the same thing, for the same reason — the echo area shows one line, and nobody
guesses that a key exists to show the rest. Nothing to point at when there is no UI."
  (if (ed-headless?) "" " ($ for the full output)"))

;; ---- running a git command, journalled -----------------------------------------
;; One seam: `git-journal-run` takes what to RECORD and a thunk that runs it, so a
;; command cannot be run without being recorded, and the two runners below differ only
;; in how they invoke git.

(check-allow :trusted
  (sig git-journal-run (model seqable fn -> vector))
  (defn- git-journal-run (m args run)
    "`[model' result]`: record `git args` as started, call `run`, complete the entry."
    (let ([m1 id] (git-journal-add m (git-entry args))
          r (run))
      [(git-journal-finish m1 id r) r])))

(sig git-run (model seqable -> vector))
(defn git-run (m args)
  "Run `git args` in the repo root, journalled: `[model' result]`. The seam every
model-threaded git command goes through, so the journal cannot disagree with what ran."
  (git-journal-run m args (fn () (git-git (:git-root m) args))))

(sig git-run-hunk (model string bool bool -> vector))
(defn git-run-hunk (m patch cached? reverse?)
  "[[git-run]] for the hunk path: the patch goes to `git apply` over stdin, so the entry
names the arguments rather than the patch — which is in the diff above it anyway."
  (git-journal-run m
    (append ["apply"] (if cached? ["--cached"] []) (if reverse? ["--reverse"] []) ["-"])
    (fn () (git-apply-hunk (:git-root m) patch cached? reverse?))))

;; ---- rendering the buffer ------------------------------------------------------
;; A heading starts at column 0 and its exit code is right-aligned in three columns; every
;; line of output is indented FOUR, which is one more than the widest heading prefix can
;; be. That is what lets the `:fontify` — which sees text and nothing else — tell the two
;; apart by looking at the line alone: an output line that happens to read `0 …` cannot be
;; mistaken for a command that exited 0. It also lines the output up under the command.

(def- git-output-indent "    ")

(def- git-global-flags
  ;; bedit's own arguments, before the subcommand, on every call and typed by nobody:
  ;; elided. Magit collapses the same thing to `…` with the full text in a tooltip.
  #{"-C" "-c"})

(defn- git-command-text (args)
  "The command line as the user means it: `git` plus `args`, less bedit's own flags."
  (letrec (strip (fn (a)
                   (if (and (> (count a) 1) (contains? git-global-flags (first a)))
                     (strip (drop a 2))
                     a)))
    (git-redact (string/join (into ["git"] (strip (into [] args))) " "))))

(defn git-journal-heading (e)
  "One entry's heading: the exit code (Magit's right-aligned three columns, `run` while
in flight), the command, and how long it took."
  ;; `(or …)` and not a `get` default: a timed-out entry HAS an `:exit`, whose value is
  ;; nil, so a default would never be reached — and 0 is truthy in Brood, so an exit of 0
  ;; still reads as itself
  (str (if (:running? e) "run " (str (string/pad-left (str (or (:exit e) "?")) 3) " "))
    (git-command-text (:args e))
    (if (:running? e) "" (str "  (" (humanize/duration (:ms e 0)) ")"))))

(defn- git-journal-block (e)
  "An entry as text: its heading, then its output indented under it."
  (let (out (:output e ""))
    (if (= out "")
      (git-journal-heading e)
      (str (git-journal-heading e)
        "\n"
        (string/join (map (string/split out "\n") (fn (l) (str git-output-indent l))) "\n")))))

(defn git-journal-text (m)
  "The whole journal as the buffer shows it: one block per entry, oldest first."
  (let (entries (git-journal m))
    (if (empty? entries)
      "(no git commands yet)"
      (string/join (map entries git-journal-block) "\n"))))

(defn git-process-fontify (src)
  "The *git-process* `:fontify`: a heading reads by its exit code — green for 0, red for
anything else, blue while it runs — and the output indented under it is plain."
  (git-fontify-lines (string/split src "\n")
    0
    (fn (line off)
      (cond
        (string/starts-with? line "run ") (git-whole-line off line git-face-hunk)
        (string/starts-with? line git-output-indent) '()
        (string/starts-with? line "  0 ") (git-whole-line off line git-face-add)
        :else (git-whole-line off line git-face-del)))
    '()))

(defcommand cmd-git-process
  (m key)
  "Show what git actually ran (`$`, Magit's `magit-process-buffer`): every command this
editor issued, with its exit code, how long it took and its output — the whole of it,
where the echo area could only show the first line. `g` refreshes, `k` clears, `q` quits."
  (git-show-report m "*git-process*" (git-journal-text m) :git-process {:action :pop}))

(defcommand cmd-git-process-clear
  (m key)
  "Clear the process log (k in *git-process*)."
  (let (m1 (dissoc m :git-journal))
    (git-show-report m1 "*git-process*" (git-journal-text m1) :git-process {:action :here})))

;; ---- a read-only report buffer (diff / log) ---------------------------------

(defn- git-show-report (m name text type &optional (opts {:action :here}))
  "Show `text` in a read-only report buffer `name` of `type` (e.g. *git-diff*, *git-log*),
point at the top. `opts` routes through `ed-display-buffer` (default `{:action :here}` — replace
the current pane); pass `{:action :pop}` to open it in another pane and jump there. Keeps
`:git-root` for follow-up commands."
  (ed-apply (commands/ed-display-buffer m name (if (= text "") "(empty)" text) type opts)
    (fn (b) (commands/ed-goto-line b 1))))

(defn- git-report-cmd (m verb r)
  "Echo the result of a git command `r` (`verb` names it), preferring stderr then stdout;
falls back to the exit code when both streams are empty. A FAILURE says where the rest of
the output is: the echo area holds one line, and nobody guesses that a key shows the whole
of it (Magit appends the same hint, for the same reason)."
  (let (e (string/trim (:stderr r ""))
        raw (if (= e "") (string/trim (:stdout r "")) e)
        failed? (not (= (:exit r) 0))
        out (one-line (if (= raw "") (str "exit " (:exit r)) raw)))
    (message m
      (str verb (if failed? " failed: " ": ") out (if failed? (git-journal-note) "")))))

(defn- git-do (m verb args)
  "Run `git args` (logged), then refresh the status buffer on success -- else report what
went wrong. The shape every working-tree action has: eight sites spelled the run, the log
and the refresh separately, and the one that must not be got wrong is refreshing after a
command that FAILED."
  (let ([m1 r] (git-run m args)) (git-refreshed m1 verb r)))

(defn- git-do-hunk (m verb patch cached? reverse?)
  "[[git-do]] for a hunk: `git apply` over stdin, logged, then the same refresh."
  (let ([m1 r] (git-run-hunk m patch cached? reverse?)) (git-refreshed m1 verb r)))

(defn- git-refreshed (m verb r)
  "The outcome of a working-tree-changing git command `r`: re-read the status buffer when it
succeeded, else say what went wrong (`git-report-cmd`, `verb` naming it). Every stage /
unstage / discard action ends this way — eight sites spelled the same three lines, and the
one thing they must not get wrong is refreshing after a command that FAILED, which is what
having it in one place makes impossible."
  (if (= (:exit r) 0) (git-refresh m) (git-report-cmd m verb r)))

(defcommand cmd-git-diff
  (m key)
  "Show a diff in *git-diff*, replacing the current pane (d): the file on the current line — a
staged row's `--cached` diff, an unstaged row's working-tree diff, an untracked file's contents
— or, on a section header / blank line, the whole working tree vs HEAD."
  (let (row (git-row-at m)
        root (:git-root m)
        args (if (nil? row) ["diff" "HEAD"] (git-diff-args (git-row-section row) (:path row)))
        r (git-git root args))
    (if (>= (:exit r) 2)
      (git-report-cmd m "git diff" r)
      (git-show-report (assoc m :git-root root) "*git-diff*" (:stdout r "") :git-diff))))

(defcommand cmd-git-show-diff
  (m key)
  "RET in `*git-status*`: on a commit-log row (unpushed / unpulled), run `git show <hash>` in
`*git-show*`; on a file / hunk row, preview its diff in `*git-diff*` to the right. Section
headers and blank lines are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row) m
      (:commit-log? row)
        (let (r (git-git root ["show" "--stat" "-p" (:hash row)]))
          (if (not (= (:exit r) 0))
            (git-report-cmd m "git show" r)
            (git-show-report (assoc m :git-root root)
              "*git-show*"
              (:stdout r "")
              :git-diff)))
      :else
        (let (r (git-git root (git-diff-args (git-row-section row) (:path row)))
              out (:stdout r ""))
          (if (>= (:exit r) 2)
            (git-report-cmd m "git diff" r)
            (ed-show-named-aside (assoc m :git-root root)
              "*git-diff*"
              (if (= (string/trim out) "") "(empty)" out)
              :git-diff))))))

(defcommand cmd-vc-diff
  (m key)
  "Show the current file's changes vs HEAD in *git-diff* (C-x v =) — works from any file
buffer, no need to open the status buffer first."
  (let (file (buffer-file (ed-current-buf m)))
    (if (nil? file)
      (message m "no file to diff")
      (let (root (git-toplevel (path/dirname file)))
        (if (nil? root)
          (message m "not in a git repository")
          (let (r (git-git root ["diff" "HEAD" "--" file]))
            (if (= (string/trim (:stdout r "")) "")
              (message m "no changes vs HEAD")
              ;; launched from your own file — pop the diff into another pane and jump to it,
              ;; leaving your file visible in the pane you came from
              (git-show-report (assoc m :git-root root)
                "*git-diff*"
                (:stdout r "")
                :git-diff {:action :pop}))))))))

(defn- git-log-line-hash (line)
  "The abbreviated commit hash at the start of a `git log --oneline` line (up to the first
space), or nil when the line is blank or not a commit line."
  (let (i (index-of line " "))
    (if (< i 1) nil (string/substring line 0 i))))

(defcommand cmd-git-show-commit
  (m key)
  "Show the full diff of the commit on the current log line (RET in *git-log*)."
  (let (root (:git-root m)
        buf (ed-current-buf m)
        line-i (buffer-current-line buf)
        lines (string/split (buffer-text buf) "\n")
        hash (git-log-line-hash (nth lines line-i "")))
    (if (nil? hash)
      (message m "not on a commit line")
      (let (r (git-git root ["show" "--stat" "-p" hash]))
        (if (not (= (:exit r) 0))
          (git-report-cmd m "git show" r)
          (git-show-report (assoc m :git-root root)
            "*git-show*"
            (:stdout r "")
            :git-diff))))))

(defcommand cmd-git-log
  (m key)
  "Show the commit log in *git-log* (l l). RET on a line shows that commit's diff. Takes
the log menu's arguments — `--graph`, `--all`, `-n`, `--author=` — and 30 commits when the
menu set no limit. Opened in another pane, keeping your working buffer visible."
  (git-log-report m [] "*git-log*"))

;; ---- push / pull (synchronous; report in the echo area) ---------------------

;; ---- the push / pull MENUS (Magit's `P` and `F`) -----------------------------
;; The reason a transient exists at all: `--force-with-lease` has nowhere to live in a
;; keymap, so before this it could not be typed. A spec is plain data — adding a flag is a
;; row, not code — and the commands below splice `transient/ed-transient-args` into their
;; argv, so each one behaves identically whether it was reached from the menu, from `P`,
;; or from `M-x`.
;;
;; `--force-with-lease` and not `--force`: the lease is the one that refuses when the
;; remote moved under you, which is the difference between overwriting your own rewritten
;; history and overwriting a colleague's push. Magit puts `--force` in its menu too; we
;; leave it out, because the menu is also a recommendation.

(def git-push-transient
  {:name 'git-push
   :title "Push"
   :groups [{:title "Arguments"
             :suffixes [{:key "-f"
                         :kind :switch
                         :arg "--force-with-lease"
                         :label "refuses if the remote moved"}
                        {:key "-n" :kind :switch :arg "--dry-run" :label "show what would be pushed"}
                        {:key "-t" :kind :switch :arg "--tags" :label "push tags too"}
                        {:key "-u"
                         :kind :switch
                         :arg "--set-upstream"
                         :label "set the upstream"}]}
            {:title "Push"
             :suffixes [{:key "p"
                         :kind :command
                         :command 'git/cmd-git-push
                         :label "the current branch"}]}]})

(def git-pull-transient
  {:name 'git-pull
   :title "Pull"
   :groups [{:title "Arguments"
             :suffixes [{:key "-r" :kind :switch :arg "--rebase" :label "rebase instead of merging"}
                        {:key "-a" :kind :switch :arg "--autostash" :label "autostash local changes"}]}
            {:title "Pull"
             :suffixes [{:key "F" :kind :command :command 'git/cmd-git-pull :label "from upstream"}]}]})

(defcommand cmd-git-push-menu
  (m key)
  "The push menu (P): toggle `--force-with-lease`, `--dry-run`, `--tags`, `--set-upstream`,
then push. It reopens with the arguments you used last time."
  (transient/ed-transient-open m git-push-transient))

(defcommand cmd-git-pull-menu
  (m key)
  "The pull menu (F): toggle `--rebase` / `--autostash`, then pull. It reopens with the
arguments you used last time."
  (transient/ed-transient-open m git-pull-transient))

(defcommand cmd-git-push
  (m key)
  "Push the current branch — off the loop, so the editor stays live while the remote
thinks about it. The mode line says `push...`; the outcome lands in the echo area.
Any arguments set in the push menu are spliced in; reached any other way there are none."
  (git-launch-op m "push" (into ["push"] (transient/ed-transient-args m)) git-refresh-if-open))

(defcommand cmd-git-pull
  (m key)
  "Pull the current branch, then refresh status (F) — off the loop.

This is the command that froze the editor: a pull is a NETWORK round trip, and it ran on
the dispatch path, so the window stopped repainting until the remote answered. It now runs
in a task like everything else that can outlast a frame.

`--ff-only` unless the menu said otherwise: a pull that silently makes a merge commit is
how an accidental merge of `main` into `main` happens, and `--rebase` from the menu is the
other answer. Both are refusals to guess."
  (let (args (transient/ed-transient-args m))
    (git-launch-op m
      "pull"
      (into ["pull"] (if (empty? args) ["--ff-only"] args))
      git-refresh-if-open)))

;; ---- stash (z z / z p) -------------------------------------------------------

(defcommand cmd-git-stash
  (m key)
  "Stash working-tree changes (z z) — `git stash push`, with the stash menu's arguments
(`--include-untracked`, `--keep-index`). Refreshes status on success."
  (git-act m "stash" (append ["stash" "push"] (transient/ed-transient-args m))))

(defcommand cmd-git-stash-pop
  (m key)
  "Pop the latest stash onto the working tree (z p) — `git stash pop`. Refreshes on success."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["stash" "pop"]))
        (git-report-cmd (if (nil? (:git-rows m)) m (git-refresh m)) "stash pop" r)))))

;; ---- branch checkout / create (b b / b c) -----------------------------------

(defcommand cmd-git-checkout
  (m key)
  "Checkout a branch with minibuffer completion over all local and remote branches (b b)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["branch" "-a" "--format=%(refname:short)"]))
        (if (not (= (:exit r) 0))
          (git-report-cmd m "git branch" r)
          (let (branches (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?))
            (assoc m
              :minibuffer
                (commands/ed-name-prompt "Checkout branch: "
                  branches
                  (fn (mm branch)
                    (let (r2 (git-git root ["checkout" branch]))
                      (git-report-cmd (if (= (:exit r2) 0) (git-show-status mm root) mm)
                        "checkout" r2)))))))))))

(defcommand cmd-git-create-branch
  (m key)
  "Create and checkout a new branch, prompting for its name (b c)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt "New branch name: "
            '()
            (fn (mm name)
              (if (= (string/trim name) "")
                (message mm "branch name cannot be empty")
                (let (r (git-git root ["checkout" "-b" (string/trim name)]))
                  (git-report-cmd (if (= (:exit r) 0) (git-show-status mm root) mm)
                    "create branch" r)))))))))

;; ---- commit (an editable message buffer; C-c C-c / C-c C-k) -----------------

(defn- git-commit-message (text)
  "The commit message from the *git-commit* buffer text — comment lines (leading `#`) dropped
and the rest trimmed."
  (string/trim (string/join (seq/reject (string/split text "\n")
                              (fn (l) (string/starts-with? (string/triml l) "#")))
                 "\n")))

(defcommand cmd-git-commit
  (m key)
  "Open an editable *git-commit* buffer; C-c C-c commits the staged changes, C-c C-k aborts (c)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (ed-show-named (assoc m
                       :git-root root
                       :git-amend? nil
                       ;; the menu's flags, carried to `cmd-git-commit-finish` — the commit
                       ;; happens in another command, after the message buffer, so the
                       ;; arguments have to survive the round trip on the model
                       :git-commit-args (transient/ed-transient-args m))
        "*git-commit*"
        "\n# Enter a commit message above. C-c C-c to commit, C-c C-k to cancel.\n# Lines starting with # are ignored."
        :git-commit))))

(defcommand cmd-git-commit-amend
  (m key)
  "Open *git-commit* pre-populated with the last commit message for amending (a). C-c C-c
runs `git commit --amend`; C-c C-k aborts."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["log" "-1" "--format=%B"]))
        (if (not (= (:exit r) 0))
          (message m "no commits yet to amend")
          (ed-show-named (assoc m
                           :git-root root
                           :git-amend? true
                           :git-commit-args (transient/ed-transient-args m))
            "*git-commit*"
            (str (string/trim (:stdout r))
              "\n# Amending the last commit. C-c C-c to commit --amend, C-c C-k to cancel.\n# Lines starting with # are ignored.")
            :git-commit))))))

(defcommand cmd-git-commit-finish
  (m key)
  "Commit the staged changes with this buffer's message (C-c C-c). If `:git-amend?` is set,
runs `git commit --amend` to rewrite the last commit."
  (let (root (:git-root m)
        msg (git-commit-message (buffer-text (ed-current-buf m)))
        amend? (:git-amend? m))
    (cond
      (nil? root) (message m "no git repo")
      (= msg "") (message m "empty commit message — aborted")
      :else
        (let (args (append ["commit" "-m" msg]
                     (append (if amend? ["--amend"] []) (or (:git-commit-args m) [])))
              r (git-git root args)
              m1 (cmd-kill-buffer (assoc m :git-amend? nil :git-commit-args nil) key))
          (if (= (:exit r) 0)
            (message (git-show-status m1 root)
              (str (if amend? "amended: " "committed: ") (one-line (:stdout r))))
            (message m1 (str "commit failed: " (one-line (str (:stdout r) " " (:stderr r))))))))))

(defcommand cmd-git-commit-abort
  (m key)
  "Abort the commit and close the message buffer (C-c C-k)."
  (message (cmd-kill-buffer (assoc m :git-amend? nil :git-commit-args nil) key) "commit aborted"))

;; ============================================================================
;; THE REST OF THE PORCELAIN: merge, rebase, cherry-pick, revert, tag, remote,
;; reset, and menus over the commands that already existed.
;; ============================================================================
;;
;; Every one of these is "run a git subcommand with some flags, then refresh", and the
;; flags are what a keymap could never hold — which is why this arrives now and not
;; before: a transient (brood ADR-387) is the place a flag can live.
;;
;; Two rules run through the lot.
;;
;; **Nothing here guesses.** A command that could lose work asks first — `git-confirm`
;; is a y/n the dangerous ones go through, and it names what it is about to do rather
;; than asking "are you sure?". `reset --hard` and `clean` are the two that can destroy
;; uncommitted work, and both are behind it.
;;
;; **The SEQUENCER is one idea, not five.** A rebase, a merge, a cherry-pick and a revert
;; can all stop half-way and leave the repo waiting for you, and each has its own
;; `--continue` / `--abort` / `--skip`. Magit has a key per verb; it does not need to be
;; that way, because git itself records which one is in flight — in `.git`. So
;; `git-sequencer` reads the state and `cmd-git-sequence-continue` / `-abort` / `-skip`
;; dispatch on it: one key that means "carry on with whatever we are in the middle of".

(defn- git-act (m verb args)
  "Resolve the repo root onto the model, then [[git-do]]: run `git args` journalled and
refresh on success.

`git-do` alone is not enough for anything below. It runs git in `(:git-root m)`, which is
set while *git-status* is open and nil everywhere else — and every command here is also
reachable by `M-x`, from a buffer that has never opened a status. Without this they would
run git in nil."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do (assoc m :git-root root) verb args))))

(def- git-no-editor
  ;; `git rebase --continue`, `merge`, `commit --amend` and friends all open an EDITOR for
  ;; the message unless told otherwise. There is no terminal on this side of the pipe, so
  ;; git would launch a `vi` nobody can see and the command would hang until the 120 s
  ;; timeout — the editor frozen, waiting on an editor.
  ;;
  ;; `core.editor=true` points git at `true(1)`, which exits 0 having changed nothing: the
  ;; message git prepared is accepted as it stands, exactly what `--no-edit` means for the
  ;; verbs that have such a flag. `sequence.editor` is the same thing for the interactive
  ;; rebase todo list.
  ;;
  ;; Prepended to the ARGS rather than passed as config, because `git-git` puts our args
  ;; immediately after its own `-c core.quotePath=false` and `-c` may repeat. The journal's
  ;; `git-command-text` strips leading `-c` pairs, so `$` still shows `git rebase
  ;; --continue` rather than the plumbing.
  ["-c" "core.editor=true" "-c" "sequence.editor=true"])

(def- git-sequencer-markers
  ;; The file git leaves in `.git` while an operation is part-way through, and what to
  ;; call it. Order matters: `rebase-merge` and `rebase-apply` are two implementations of
  ;; the same verb, and a cherry-pick in the middle of a rebase is still a rebase.
  [["rebase-merge" :rebase "rebase"]
   ["rebase-apply" :rebase "rebase"]
   ["CHERRY_PICK_HEAD" :cherry-pick "cherry-pick"]
   ["REVERT_HEAD" :revert "revert"]
   ["MERGE_HEAD" :merge "merge"]
   ["BISECT_LOG" :bisect "bisect"]])

(defn git-sequencer (root)
  "The git operation this repo is part-way through — `{:kind :rebase :verb \"rebase\"}` —
or **nil** when none is. Read from the marker `.git` leaves behind, which is how git
itself knows, so this cannot disagree with what `--continue` would resume.

`.git` is a FILE, not a directory, in a worktree or a submodule (it holds a `gitdir:`
pointer), so the markers are looked for through `git rev-parse --git-dir` rather than at
`<root>/.git` — otherwise every one of these features would be silently dead in a
worktree, which is where a rebase is most likely to be happening."
  (let (dir (string/trim (:stdout (git-git root ["rev-parse" "--absolute-git-dir"]) ""))
        hit (if (= dir "")
              nil
              (seq/find git-sequencer-markers
                (fn (row) (file/exists? (path/join dir (first row)))))))
    (if (nil? hit) nil {:kind (nth hit 1) :verb (nth hit 2)})))

(defn- git-sequence-step (m step)
  "Run `--<step>` (continue / abort / skip) on whatever operation is in flight. The one
command behind three keys, because git already knows which verb it is."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      :else
        (let (seq (git-sequencer root))
          (if (nil? seq)
            (message m "nothing in progress")
            (git-act m
              (str (:verb seq) " --" step)
              (append git-no-editor [(:verb seq) (str "--" step)])))))))

(defcommand cmd-git-sequence-continue
  (m key)
  "Carry on with the rebase / merge / cherry-pick / revert that is part-way through (r c)."
  (git-sequence-step m "continue"))

(defcommand cmd-git-sequence-abort
  (m key)
  "Abandon the operation in progress and put the repo back (r a)."
  (git-sequence-step m "abort"))

(defcommand cmd-git-sequence-skip
  (m key)
  "Skip the commit the operation is stuck on and carry on (r s)."
  (git-sequence-step m "skip"))

;; ---- picking a ref, and the shape every new command shares -------------------
;; Six of the commands below are the same sentence: "pick a ref, run a subcommand with the
;; menu's flags and that ref, refresh". Written out six times that is six chances to forget
;; the flags, the refresh, or the not-a-repo case — `cmd-git-checkout` above is the
;; hand-written version, kept because checkout is the one that reports differently.

(defn- git-refs (root kind)
  "The repo's refs of `kind` — `:branches` (local and remote), `:local` or `:tags` — newest
first where git will say, as a list of plain names."
  (let (args (case kind
               :local ["branch" "--format=%(refname:short)" "--sort=-committerdate"]
               :tags ["tag" "--sort=-creatordate"]
               ["branch" "-a" "--format=%(refname:short)" "--sort=-committerdate"])
        r (git-git root args))
    (if (= (:exit r) 0)
      (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?)
      '())))

(defn- git-with-ref (m prompt kind then)
  "Prompt for a ref of `kind` (completing over what the repo has) and hand it to `then`
(`(model ref) -> model`). The refs are read on the loop, which is the one thing here that
costs a subprocess — acceptable, because the prompt cannot be shown before they are known."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt prompt
            (git-refs root kind)
            (fn (mm ref)
              (if (= (string/trim ref) "")
                (message mm "nothing chosen")
                (then mm (string/trim ref)))))))))

(defn- git-menu-action (m verb subcommand &optional (tail []))
  "Run `git <subcommand> <the menu's flags> <tail>`, journalled, then refresh. The shape of
every menu-driven action: the flags come from whichever menu invoked the command, and are
empty when it was reached by a key instead."
  (git-act m verb (append git-no-editor (append [subcommand] (append (transient/ed-transient-args m) tail)))))

;; ---- merge (m) ---------------------------------------------------------------

(def git-merge-transient
  {:name 'git-merge
   :title "Merge"
   :groups [{:title "Arguments"
             :suffixes [{:key "-n" :kind :switch :arg "--no-ff" :label "always make a merge commit"}
                        {:key "-s" :kind :switch :arg "--squash" :label "squash to a single change"}
                        {:key "-S" :kind :switch :arg "--no-commit" :label "stop before committing"}]}
            {:title "Merge"
             :suffixes [{:key "m" :kind :command :command 'git/cmd-git-merge :label "a branch into HEAD"}]}
            {:title "In progress"
             :suffixes [{:key "c"
                         :kind :command
                         :command 'git/cmd-git-sequence-continue
                         :label "continue"}
                        {:key "a"
                         :kind :command
                         :command 'git/cmd-git-sequence-abort
                         :label "abort"}]}]})

(defcommand cmd-git-merge-menu
  (m key)
  "The merge menu (m)."
  (transient/ed-transient-open m git-merge-transient))

(defcommand cmd-git-merge
  (m key)
  "Merge a branch into HEAD, with the merge menu's flags."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m "Merge branch: " :branches
      (fn (mm ref)
        (git-act mm "merge" (append git-no-editor (append ["merge"] (append args [ref]))))))))

;; ---- rebase (r) --------------------------------------------------------------

(def git-rebase-transient
  {:name 'git-rebase
   :title "Rebase"
   :groups [{:title "Arguments"
             :suffixes [{:key "-a"
                         :kind :switch
                         :arg "--autostash"
                         :label "stash local changes and put them back"}
                        {:key "-i" :kind :switch :arg "--interactive" :label "edit the todo list"}
                        {:key "-k"
                         :kind :switch
                         :arg "--keep-empty"
                         :label "keep commits that become empty"}]}
            {:title "Rebase"
             :suffixes [{:key "u" :kind :command :command 'git/cmd-git-rebase-upstream :label "onto upstream"}
                        {:key "e" :kind :command :command 'git/cmd-git-rebase :label "onto another branch"}]}
            {:title "In progress"
             :suffixes [{:key "c"
                         :kind :command
                         :command 'git/cmd-git-sequence-continue
                         :label "continue"}
                        {:key "s" :kind :command :command 'git/cmd-git-sequence-skip :label "skip this commit"}
                        {:key "a"
                         :kind :command
                         :command 'git/cmd-git-sequence-abort
                         :label "abort"}]}]})

(defcommand cmd-git-rebase-menu
  (m key)
  "The rebase menu (r): the arguments, where to rebase onto, and the three ways out of one
that has stopped part-way."
  (transient/ed-transient-open m git-rebase-transient))

(defcommand cmd-git-rebase
  (m key)
  "Rebase the current branch onto a branch you pick, with the menu's flags."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m "Rebase onto: " :branches
      (fn (mm ref)
        (git-act mm "rebase" (append git-no-editor (append ["rebase"] (append args [ref]))))))))

(defcommand cmd-git-rebase-upstream
  (m key)
  "Rebase the current branch onto its upstream — the common case, with no prompt."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? (git-upstream root)) (message m "this branch has no upstream to rebase onto")
      :else (git-menu-action m "rebase" "rebase" [(git-upstream root)]))))

;; ---- cherry-pick (A) and revert (V) ------------------------------------------
;; Both take a commit and both can stop on a conflict, so both lead into the sequencer.
;; In *git-status* the commit under point is the obvious subject — the log sections are
;; right there — so the commit row's hash is offered as the default.

(defn- git-commit-at-point (m)
  "The commit hash on the current *git-status* line, or nil when the line is not a commit."
  (let (row (git-row-at m))
    (if (and row (:commit-log? row)) (:hash row) nil)))

(defn- git-pick-commit (m prompt then)
  "Prompt for a commit, defaulting to the one under point in *git-status*, and hand it to
`then`. The recent commits complete, so picking one off the log is a keystroke."
  (let (root (git-resolve-root m)
        here (git-commit-at-point m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (hashes (map (git-log-commits root ["-30"]) :hash))
        (assoc m
          :minibuffer
            (commands/ed-name-prompt (str prompt (if here (str "(" here ") ") ""))
              hashes
              (fn (mm text)
                (let (chosen (if (= (string/trim text) "") (or here "") (string/trim text)))
                  (if (= chosen "")
                    (message mm "no commit chosen")
                    (then mm chosen))))))))))

(def git-cherry-pick-transient
  {:name 'git-cherry-pick
   :title "Cherry-pick"
   :groups [{:title "Arguments"
             :suffixes [{:key "-n"
                         :kind :switch
                         :arg "--no-commit"
                         :label "apply it but do not commit"}
                        {:key "-x"
                         :kind :switch
                         :arg "-x"
                         :label "record which commit it came from"}]}
            {:title "Cherry-pick"
             :suffixes [{:key "A"
                         :kind :command
                         :command 'git/cmd-git-cherry-pick
                         :label "a commit onto HEAD"}]}
            {:title "In progress"
             :suffixes [{:key "c"
                         :kind :command
                         :command 'git/cmd-git-sequence-continue
                         :label "continue"}
                        {:key "a"
                         :kind :command
                         :command 'git/cmd-git-sequence-abort
                         :label "abort"}]}]})

(def git-revert-transient
  {:name 'git-revert
   :title "Revert"
   :groups [{:title "Arguments"
             :suffixes [{:key "-n"
                         :kind :switch
                         :arg "--no-commit"
                         :label "stage the reversal but do not commit"}]}
            {:title "Revert"
             :suffixes [{:key "V" :kind :command :command 'git/cmd-git-revert :label "a commit"}]}
            {:title "In progress"
             :suffixes [{:key "c"
                         :kind :command
                         :command 'git/cmd-git-sequence-continue
                         :label "continue"}
                        {:key "a"
                         :kind :command
                         :command 'git/cmd-git-sequence-abort
                         :label "abort"}]}]})

(defcommand cmd-git-cherry-pick-menu
  (m key)
  "The cherry-pick menu (A)."
  (transient/ed-transient-open m git-cherry-pick-transient))

(defcommand cmd-git-revert-menu
  (m key)
  "The revert menu (V)."
  (transient/ed-transient-open m git-revert-transient))

(defcommand cmd-git-cherry-pick
  (m key)
  "Cherry-pick a commit onto HEAD — the one under point by default."
  (let (args (transient/ed-transient-args m))
    (git-pick-commit m "Cherry-pick commit: "
      (fn (mm commit)
        (git-act mm "cherry-pick"
          (append git-no-editor (append ["cherry-pick"] (append args [commit]))))))))

(defcommand cmd-git-revert
  (m key)
  "Revert a commit — the one under point by default."
  (let (args (transient/ed-transient-args m))
    (git-pick-commit m "Revert commit: "
      (fn (mm commit)
        (git-act mm "revert" (append git-no-editor (append ["revert"] (append args [commit]))))))))

;; ---- asking before something that cannot be undone ---------------------------

(defn- git-confirm (m prompt then)
  "Ask `prompt` (y/n) and run `then` on yes. The same one-key reader `cmd-git-discard`
uses, pulled out because three more commands now need it — and the prompt NAMES what is
about to happen (`Reset --hard to abc123, losing all uncommitted changes?`) rather than
asking whether you are sure. \"Are you sure?\" is answered yes by reflex; a sentence that
says what will be lost is not."
  (ed-read-char m
    (str prompt " (y/n) ")
    (fn (mm c) (if (or (= c "y") (= c "Y")) (then mm) (message mm "cancelled")))))

;; ---- tags (t) ----------------------------------------------------------------

(def git-tag-transient
  {:name 'git-tag
   :title "Tag"
   :groups [{:title "Arguments"
             :suffixes [{:key "-a" :kind :switch :arg "--annotate" :label "annotated"}
                        {:key "-f" :kind :switch :arg "--force" :label "replace an existing tag"}
                        {:key "=m" :kind :option :arg "--message=" :label "message" :prompt "Tag message"}]}
            {:title "Tag"
             :suffixes [{:key "t" :kind :command :command 'git/cmd-git-tag-create :label "create at HEAD"}
                        {:key "k" :kind :command :command 'git/cmd-git-tag-delete :label "delete"}
                        {:key "l" :kind :command :command 'git/cmd-git-tag-list :label "list"}]}]})

(defcommand cmd-git-tag-menu
  (m key)
  "The tag menu (t)."
  (transient/ed-transient-open m git-tag-transient))

(defcommand cmd-git-tag-create
  (m key)
  "Create a tag at HEAD, prompting for the name."
  (let (args (transient/ed-transient-args m))
    (assoc m
      :minibuffer
        (commands/ed-name-prompt "Tag name: "
          '()
          (fn (mm name)
            (if (= (string/trim name) "")
              (message mm "tag name cannot be empty")
              (git-act mm "tag" (append ["tag"] (append args [(string/trim name)])))))))))

(defcommand cmd-git-tag-delete
  (m key)
  "Delete a tag, completing over the repo's tags."
  (git-with-ref m "Delete tag: " :tags
    (fn (mm tag) (git-confirm mm (str "Delete tag " tag "?") (fn (m2) (git-act m2 "tag -d" ["tag" "-d" tag]))))))

(defcommand cmd-git-tag-list
  (m key)
  "Every tag in the repo, newest first, in a report buffer."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run m ["tag" "-n" "--sort=-creatordate"]))
        (git-show-report m1 "*git-tags*" (:stdout r "") :git-log {:action :pop})))))

;; ---- remotes (M) -------------------------------------------------------------

(defcommand cmd-git-remote-list
  (m key)
  "Every remote and where it points (M l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run m ["remote" "-v"]))
        (git-show-report m1 "*git-remotes*" (:stdout r "") :git-log {:action :pop})))))

(defcommand cmd-git-remote-add
  (m key)
  "Add a remote: prompts for the name, then the URL."
  (assoc m
    :minibuffer
      (commands/ed-name-prompt "Remote name: "
        '()
        (fn (mm name)
          (if (= (string/trim name) "")
            (message mm "remote name cannot be empty")
            (assoc mm
              :minibuffer
                (commands/ed-name-prompt (str "URL for " (string/trim name) ": ")
                  '()
                  (fn (m2 url)
                    (if (= (string/trim url) "")
                      (message m2 "url cannot be empty")
                      (git-act m2 "remote add"
                        ["remote" "add" (string/trim name) (string/trim url)]))))))))))

(defcommand cmd-git-remote-remove
  (m key)
  "Remove a remote, completing over the ones this repo has."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (names (seq/reject (string/split (string/trim (:stdout (git-git root ["remote"]) "")) "\n")
                    empty?))
        (assoc m
          :minibuffer
            (commands/ed-name-prompt "Remove remote: "
              names
              (fn (mm name)
                (git-confirm mm
                  (str "Remove remote " name "?")
                  (fn (m2) (git-act m2 "remote remove" ["remote" "remove" (string/trim name)]))))))))))

(def git-remote-transient
  {:name 'git-remote
   :title "Remote"
   :groups [{:title "Remote"
             :suffixes [{:key "l" :kind :command :command 'git/cmd-git-remote-list :label "list"}
                        {:key "a" :kind :command :command 'git/cmd-git-remote-add :label "add"}
                        {:key "k" :kind :command :command 'git/cmd-git-remote-remove :label "remove"}]}]})

(defcommand cmd-git-remote-menu
  (m key)
  "The remote menu (M)."
  (transient/ed-transient-open m git-remote-transient))

;; ---- reset (X) ---------------------------------------------------------------
;; The one that can destroy work, so `--hard` is the only command in this file that both
;; asks first AND says in the prompt what will be lost.

(defcommand cmd-git-reset-soft
  (m key)
  "Move HEAD to a commit, keeping the index and the working tree (X s)."
  (git-pick-commit m "Reset --soft to: "
    (fn (mm commit) (git-act mm "reset --soft" ["reset" "--soft" commit]))))

(defcommand cmd-git-reset-mixed
  (m key)
  "Move HEAD to a commit and reset the index, keeping the working tree (X m)."
  (git-pick-commit m "Reset --mixed to: "
    (fn (mm commit) (git-act mm "reset" ["reset" "--mixed" commit]))))

(defcommand cmd-git-reset-hard
  (m key)
  "Move HEAD to a commit and throw away the index AND the working tree (X h). Asks first,
naming what goes."
  (git-pick-commit m "Reset --hard to: "
    (fn (mm commit)
      (git-confirm mm
        (str "Reset --hard to " commit ", losing every uncommitted change?")
        (fn (m2) (git-act m2 "reset --hard" ["reset" "--hard" commit]))))))

(def git-reset-transient
  {:name 'git-reset
   :title "Reset"
   :groups [{:title "Reset HEAD to a commit"
             :suffixes [{:key "s"
                         :kind :command
                         :command 'git/cmd-git-reset-soft
                         :label "--soft   keep the index and the working tree"}
                        {:key "m"
                         :kind :command
                         :command 'git/cmd-git-reset-mixed
                         :label "--mixed  reset the index, keep the working tree"}
                        {:key "h"
                         :kind :command
                         :command 'git/cmd-git-reset-hard
                         :label "--hard   throw away everything uncommitted"}]}]})

(defcommand cmd-git-reset-menu
  (m key)
  "The reset menu (X). The three modes are spelled out with what each keeps, because
nobody remembers which of soft and mixed touches the index."
  (transient/ed-transient-open m git-reset-transient))

;; ---- log (l), with the arguments a log is actually read with -----------------
;; `git log` is the command whose flags matter most and are remembered least: `--graph`,
;; `--all`, `-n`, `--author=`. Each was a rewrite of the command before; now each is a row.

(def git-log-transient
  {:name 'git-log
   :title "Log"
   :groups [{:title "Arguments"
             :suffixes [{:key "-g" :kind :switch :arg "--graph" :label "draw the commit graph"}
                        {:key "-a" :kind :switch :arg "--all" :label "every branch, not just HEAD"}
                        {:key "-p" :kind :switch :arg "--patch" :label "show each commit's diff"}
                        {:key "-s" :kind :switch :arg "--stat" :label "show what each commit touched"}
                        {:key "=n" :kind :option :arg "-n" :label "limit" :prompt "How many commits"}
                        {:key "=a"
                         :kind :option
                         :arg "--author="
                         :label "author"
                         :prompt "Author"}
                        {:key "=g"
                         :kind :option
                         :arg "--grep="
                         :label "message matches"
                         :prompt "Message pattern"}]}
            {:title "Log"
             :suffixes [{:key "l" :kind :command :command 'git/cmd-git-log :label "the current branch"}
                        {:key "f"
                         :kind :command
                         :command 'git/cmd-git-log-file
                         :label "the file at point"}
                        {:key "r" :kind :command :command 'git/cmd-git-reflog :label "the reflog"}]}]})

(defcommand cmd-git-log-menu
  (m key)
  "The log menu (l)."
  (transient/ed-transient-open m git-log-transient))

(defn- git-log-report (m extra title)
  "Run `git log` with the menu's flags plus `extra` and show it in `title`. `-n 30` unless
the menu set a limit — an unbounded log in a report buffer is a way to render a hundred
thousand lines nobody asked for."
  (let (root (git-resolve-root m)
        args (transient/ed-transient-args m)
        limited? (any? args (fn (a) (string/starts-with? a "-n")))
        base (append ["log" "--oneline" "--decorate"] (if limited? [] ["-n" "30"])))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) (append base (append args extra))))
        (git-show-report m1 title (:stdout r "") :git-log {:action :pop})))))

(defcommand cmd-git-log-file
  (m key)
  "The log of the file on the current line, or of the buffer's own file."
  (let (row (git-row-at m)
        path (or (if (and row (git-file-row? row)) (:path row) nil)
               (:path (ed-current-buf m))))
    (if (nil? path)
      (message m "no file here to log")
      (git-log-report m ["--" path] "*git-log*"))))

(defcommand cmd-git-reflog
  (m key)
  "The reflog — where HEAD has been (l r). The thing you want after a reset you regret,
and the reason a `--hard` is survivable."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["reflog" "-n" "50"]))
        (git-show-report m1 "*git-reflog*" (:stdout r "") :git-log {:action :pop})))))

;; ---- fetch (f) ---------------------------------------------------------------

(def git-fetch-transient
  {:name 'git-fetch
   :title "Fetch"
   :groups [{:title "Arguments"
             :suffixes [{:key "-p" :kind :switch :arg "--prune" :label "drop remote branches that are gone"}
                        {:key "-t" :kind :switch :arg "--tags" :label "fetch tags too"}
                        {:key "-f" :kind :switch :arg "--force" :label "force"}]}
            {:title "Fetch"
             :suffixes [{:key "f" :kind :command :command 'git/cmd-git-fetch-upstream :label "from upstream"}
                        {:key "a" :kind :command :command 'git/cmd-git-fetch-all :label "from every remote"}]}]})

(defcommand cmd-git-fetch-menu
  (m key)
  "The fetch menu (f)."
  (transient/ed-transient-open m git-fetch-transient))

(defcommand cmd-git-fetch-all
  (m key)
  "Fetch from every remote (f a) — off the loop, like every other network command."
  (git-launch-op m "fetch" (append ["fetch" "--all"] (transient/ed-transient-args m))
    git-refresh-if-open))

;; ---- stash (z) ---------------------------------------------------------------

(def git-stash-transient
  {:name 'git-stash
   :title "Stash"
   :groups [{:title "Arguments"
             :suffixes [{:key "-u"
                         :kind :switch
                         :arg "--include-untracked"
                         :label "untracked files too"}
                        {:key "-k" :kind :switch :arg "--keep-index" :label "leave the index staged"}]}
            {:title "Stash"
             :suffixes [{:key "z" :kind :command :command 'git/cmd-git-stash :label "push"}
                        {:key "p" :kind :command :command 'git/cmd-git-stash-pop :label "pop the latest"}
                        {:key "a" :kind :command :command 'git/cmd-git-stash-apply :label "apply the latest"}
                        {:key "l" :kind :command :command 'git/cmd-git-stash-list :label "list"}
                        {:key "k" :kind :command :command 'git/cmd-git-stash-drop :label "drop the latest"}]}]})

(defcommand cmd-git-stash-menu
  (m key)
  "The stash menu (z)."
  (transient/ed-transient-open m git-stash-transient))

(defcommand cmd-git-stash-apply
  (m key)
  "Apply the latest stash without removing it (z a)."
  (git-act m "stash apply" ["stash" "apply"]))

(defcommand cmd-git-stash-list
  (m key)
  "Every stash, newest first (z l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run m ["stash" "list"]))
        (git-show-report m1 "*git-stashes*" (:stdout r "") :git-log {:action :pop})))))

(defcommand cmd-git-stash-drop
  (m key)
  "Drop the latest stash (z k), after confirmation — a dropped stash is gone."
  (git-confirm m
    "Drop the latest stash? It cannot be recovered from the UI."
    (fn (mm) (git-act mm "stash drop" ["stash" "drop"]))))

;; ---- blame (b) ---------------------------------------------------------------

(defcommand cmd-git-blame
  (m key)
  "Who last touched each line of this file, in *git-blame* (C-x v b). Opened beside the
file and scrolled to the line point was on, because the question is always about a
particular line rather than about the file."
  (let (buf (ed-current-buf m)
        path (:path buf)
        root (git-resolve-root m)
        line (inc (buffer-current-line buf)))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? path) (message m "this buffer is not a file")
      :else
        (let ([m1 r] (git-run (assoc m :git-root root) ["blame" "--date=short" "-w" "--" path]))
          (if (not (= (:exit r) 0))
            (git-report-cmd m1 "blame" r)
            (ed-apply (git-show-report m1 "*git-blame*" (:stdout r "") :git-log {:action :pop})
              (fn (b) (commands/ed-goto-line b line))))))))

(defcommand cmd-git-fetch-upstream
  (m key)
  "Fetch from the upstream remote with the fetch menu's arguments (f f) — off the loop.

Distinct from `cmd-git-fetch`, which is the *background* watch's quick fetch on a timer
and takes no arguments: a menu that offered `--prune` and then dropped it would be worse
than not offering it."
  (git-launch-op m "fetch" (append ["fetch"] (transient/ed-transient-args m)) git-refresh-if-open))

;; ---- resolving a conflict (o / T on an unmerged row) -------------------------
;; The two resolutions that cannot be typed into the file: "keep the version that was
;; already here" and "keep the version that came in". Everything else is editing, which
;; the editor already does — you open the file, delete the markers, and press `s`.
;;
;; `--ours` and `--theirs` are notoriously backwards during a REBASE: git replays your
;; commits onto the other branch, so "ours" is the branch you are rebasing onto and
;; "theirs" is your own work. The labels below say which is which by what it MEANS at the
;; time, not by which flag it passes, because the flag is the part that misleads.

(defn- git-resolve-with (m side)
  "Resolve the unmerged file on the current line by taking one whole side, then stage it —
`git checkout --ours|--theirs -- <path>` followed by `git add`, which is what marks it
resolved. Without the add it would still be listed as unmerged and the rebase would not
continue."
  (let (row (git-row-at m))
    (cond
      (or (nil? row) (not (git-file-row? row))) (message m "not on a file")
      (not (:unmerged? row)) (message m "this file is not conflicted")
      :else
        (let (path (:path row)
              m1 (git-act m
                   (str "checkout --" side)
                   ["checkout" (str "--" side) "--" path]))
          (git-act m1 "add" ["add" "--" path])))))

(defcommand cmd-git-take-ours
  (m key)
  "Resolve the conflict on this line by keeping the side that was already here (o) — the
branch you are merging INTO, or during a rebase the branch you are rebasing ONTO."
  (git-resolve-with m "ours"))

(defcommand cmd-git-take-theirs
  (m key)
  "Resolve the conflict on this line by keeping the side that came in (T) — the branch
being merged, or during a rebase your own commit being replayed."
  (git-resolve-with m "theirs"))

;; ---- commit (c), branch (b) and diff (d) menus -------------------------------
;; The three that already had keys but no flags. Commit especially: `--no-verify` is the
;; flag you want at the exact moment you cannot remember how to pass it, because a hook is
;; refusing a commit you need to make.

(def git-commit-transient
  {:name 'git-commit
   :title "Commit"
   :groups [{:title "Arguments"
             :suffixes [{:key "-n" :kind :switch :arg "--no-verify" :label "skip the pre-commit hooks"}
                        {:key "-s" :kind :switch :arg "--signoff" :label "add a Signed-off-by line"}
                        {:key "-e" :kind :switch :arg "--allow-empty" :label "allow an empty commit"}
                        {:key "-A" :kind :switch :arg "--all" :label "stage every tracked change first"}]}
            {:title "Commit"
             :suffixes [{:key "c" :kind :command :command 'git/cmd-git-commit :label "the staged changes"}
                        {:key "a"
                         :kind :command
                         :command 'git/cmd-git-commit-amend
                         :label "amend the last commit"}
                        {:key "e"
                         :kind :command
                         :command 'git/cmd-git-commit-extend
                         :label "extend the last commit, keeping its message"}]}]})

(defcommand cmd-git-commit-menu
  (m key)
  "The commit menu (c)."
  (transient/ed-transient-open m git-commit-transient))

(defcommand cmd-git-commit-extend
  (m key)
  "Add the staged changes to the last commit WITHOUT opening its message (c e) — Magit's
`--amend --no-edit`, the one you want when you forgot a file."
  (git-act m "commit --amend --no-edit"
    (append git-no-editor
      (append ["commit" "--amend" "--no-edit"] (transient/ed-transient-args m)))))

;; ---- branch (b) --------------------------------------------------------------

(def git-branch-transient
  {:name 'git-branch
   :title "Branch"
   :groups [{:title "Branch"
             :suffixes [{:key "b" :kind :command :command 'git/cmd-git-checkout :label "checkout"}
                        {:key "c"
                         :kind :command
                         :command 'git/cmd-git-create-branch
                         :label "create and checkout"}
                        {:key "k" :kind :command :command 'git/cmd-git-branch-delete :label "delete"}
                        {:key "m" :kind :command :command 'git/cmd-git-branch-rename :label "rename this branch"}
                        {:key "l" :kind :command :command 'git/cmd-git-branch-list :label "list"}]}]})

(defcommand cmd-git-branch-menu
  (m key)
  "The branch menu (b)."
  (transient/ed-transient-open m git-branch-transient))

(defcommand cmd-git-branch-list
  (m key)
  "Every branch with where it points and what it tracks (b l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["branch" "-vv" "--all"]))
        (git-show-report m1 "*git-branches*" (:stdout r "") :git-log {:action :pop})))))

(defcommand cmd-git-branch-delete
  (m key)
  "Delete a local branch (b k). Uses `-d`, which REFUSES to delete a branch whose commits
are not merged anywhere — the refusal is the feature, so this does not offer `-D`."
  (git-with-ref m "Delete branch: " :local
    (fn (mm branch) (git-act mm "branch -d" ["branch" "-d" branch]))))

(defcommand cmd-git-branch-rename
  (m key)
  "Rename the current branch (b m)."
  (assoc m
    :minibuffer
      (commands/ed-name-prompt "Rename current branch to: "
        '()
        (fn (mm name)
          (if (= (string/trim name) "")
            (message mm "branch name cannot be empty")
            (git-act mm "branch -m" ["branch" "-m" (string/trim name)]))))))

;; ---- diff (d) ----------------------------------------------------------------

(def git-diff-transient
  {:name 'git-diff
   :title "Diff"
   :groups [{:title "Arguments"
             :suffixes [{:key "-w" :kind :switch :arg "-w" :label "ignore whitespace"}
                        {:key "-s" :kind :switch :arg "--stat" :label "summary only"}
                        {:key "-b"
                         :kind :switch
                         :arg "--ignore-blank-lines"
                         :label "ignore blank-line changes"}
                        {:key "=u"
                         :kind :option
                         :arg "--unified="
                         :label "context lines"
                         :prompt "Lines of context"}]}
            {:title "Diff"
             :suffixes [{:key "d" :kind :command :command 'git/cmd-git-diff :label "the thing at point"}
                        {:key "u" :kind :command :command 'git/cmd-git-diff-unstaged :label "unstaged"}
                        {:key "s" :kind :command :command 'git/cmd-git-diff-staged :label "staged"}]}]})

(defcommand cmd-git-diff-menu
  (m key)
  "The diff menu (d)."
  (transient/ed-transient-open m git-diff-transient))

(defn- git-diff-report (m extra title)
  "`git diff` with the diff menu's arguments plus `extra`, in a report buffer."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root)
                     (append ["diff"] (append (transient/ed-transient-args m) extra))))
        (git-show-report m1 title (:stdout r "") :git-diff {:action :pop})))))

(defcommand cmd-git-diff-unstaged
  (m key)
  "Everything not yet staged (d u)."
  (git-diff-report m [] "*git-diff*"))

(defcommand cmd-git-diff-staged
  (m key)
  "Everything staged, against HEAD (d s)."
  (git-diff-report m ["--cached"] "*git-diff*"))

;; ---- `!` — run a git command, for the one this menu does not have ------------

(defcommand cmd-git-run-command
  (m key)
  "Run an arbitrary git command in the repo root and show its output (!).

Every porcelain is an incomplete porcelain, and the honest answer to that is a way to run
the command it is missing WITHOUT leaving the editor and losing the context you are in.
Journalled like everything else, so `$` shows it alongside the commands the menus ran."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt "git "
            '()
            (fn (mm line)
              (let (args (seq/reject (string/split (string/trim line) " ") empty?))
                (if (empty? args)
                  (message mm "nothing to run")
                  (let ([m1 r] (git-run (assoc mm :git-root root) (into [] args)))
                    (git-show-report (git-report-cmd m1 (str "git " (string/trim line)) r)
                      "*git-output*"
                      (str (:stdout r "") (:stderr r ""))
                      :git-log
                      {:action :pop}))))))))))
