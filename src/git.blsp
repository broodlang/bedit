;; ---- `!` — run a git command, for the one this menu does not have ------------

(defcommand cmd-git-run-command
  (m key)
  "Run an arbitrary git command in the repo root and show its output (!).

Every porcelain is an incomplete porcelain, and the honest answer to that is a way to run
the command it is missing WITHOUT leaving the editor and losing the context you are in.
Journalled like everything else, so `$` shows it alongside the commands the menus ran.

**The line is split on spaces, not parsed as a shell would.** `commit -m \"two words\"`
becomes four arguments with literal quote characters in two of them, which is not what you
meant. There is no shell here on purpose — git is run as an argv, which is what keeps a
path with a space in it from being three paths — so the limitation is real rather than an
oversight, and an argument containing a space needs the command that takes it properly
(`c` for a commit message). Said plainly because a `!` that silently mangles quotes is
worse than one that does not offer them."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt "git "
            '()
            (fn (mm line)
              (let (args (seq/reject (string/split (string/trim line) " ") empty?))
                (if (empty? args)
                  (message mm "nothing to run")
                  (let ([m1 r] (git-run (assoc mm :git-root root) (into [] args)))
                    (git-show-report (git-report-cmd m1 (str "git " (string/trim line)) r)
                      "*git-output*"
                      (str (:stdout r "") (:stderr r ""))
                      :git-text {:action :pop}))))))))))

;; ---- removing an untracked file ---------------------------------------------
;; `k` on an untracked row used to answer "remove it from a shell, not here", which is a
;; strange thing for an editor to say about a file it is showing you. The reason it said it
;; is real — an untracked file has no copy in git, so deleting it is unrecoverable, unlike
;; every other `k` in this buffer — but the answer to "this is irreversible" is to say so
;; and ask, not to refuse and send you elsewhere.

(defn- git-remove-untracked (m path)
  "Delete an untracked file from the working tree, after confirmation that says so."
  (git-confirm m
    (str "Delete " path "? It is untracked, so git has no copy — this cannot be undone.")
    (fn (mm) (git-act mm "clean" ["clean" "-f" "--" path]))))

;; ---- the stashes, in the status buffer --------------------------------------
;; A stash you cannot see is a stash you forget you made. Magit lists them; so does this,
;; below the commit sections, collapsed like any other section.

(defn git-stashes (root)
  "The repo's stashes as `{:hash :subject}` rows — the same shape the commit sections use,
so `git-commit-pairs` renders them with no new code. `()` when there are none."
  (let (r (git-git root ["stash" "list" "--format=%gd %s"]))
    (if (not (= (:exit r) 0))
      '()
      (map (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?)
        (fn (line)
          (let (sp (index-of line " "))
            (if (< sp 0)
              {:hash line :subject ""}
              {:hash (string/substring line 0 sp)
               :subject (string/substring line (inc sp) (string/length line))})))))))

;; ============================================================================
;; INTERACTIVE REBASE — the todo list, edited in a buffer
;; ============================================================================
;;
;; `git rebase -i` works by writing a TODO list to `.git/rebase-merge/git-rebase-todo` and
;; opening your editor on it. That is a problem from inside an editor: git runs as a
;; subprocess and blocks, and there is no terminal on the far side, so the editor it opens
;; is one nobody can see. Everywhere else in this file that is solved by
;; `core.editor=true` — accept whatever git prepared — which for `-i` means "pick
;; everything", i.e. `--interactive` that is not interactive.
;;
;; The way round it is to compose the todo FIRST and hand git a sequence editor that
;; installs it. `sequence.editor` is run as `<value> <path-to-todo>`, so
;; `sequence.editor=cp <our file>` becomes `cp <our file> <the todo>` — git then proceeds
;; with exactly the plan you wrote, and never opens anything.
;;
;; So the flow is: press `r i`, get a buffer of `pick <hash> <subject>` lines, edit it (by
;; key or by hand — it is a text buffer), `C-c C-c` to run it. Which is Magit's flow, and
;; it reads the same way, but it is doing something quite different underneath.

(def- git-rebase-actions
  ;; The todo verbs, and what each does. Shown in the buffer's help block, because nobody
  ;; remembers the difference between squash and fixup under pressure.
  [["pick" "p" "use the commit as it is"]
    ["reword" "r" "use it, but edit its message"]
    ["edit" "e" "use it, then stop so you can amend it"]
    ["squash" "s" "meld into the previous commit, editing the combined message"]
    ["fixup" "f" "meld into the previous commit, discarding this message"]
    ["drop" "d" "remove the commit entirely"]])

(defn- git-rebase-help ()
  "The comment block under the todo — the verbs, and the keys."
  (str "\n# Commits are applied TOP DOWN — the oldest is first, the opposite of a log.\n#\n"
    (string/join (map git-rebase-actions
                   (fn (row)
                     (let ([verb key doc] row)
                       (str "#   " (string/pad-right verb 8) key "   " doc))))
      "\n")
    "\n#\n# M-<up> / M-<down> reorder · C-c C-c run it · C-c C-k cancel\n"
    "# Edit the lines by hand if you prefer; this is an ordinary buffer.\n"))

(defn git-rebase-todo-text (commits)
  "The todo buffer's text for `commits` (newest first, as git reports them): a `pick` line
each in OLDEST-FIRST order, then the help block.

Oldest first is not a presentation choice — it is the order a rebase applies them in, and
it is the reverse of every log you have ever read. A todo shown newest-first would have
`squash` meld the wrong way round, and nothing would tell you until it had."
  (str (string/join (map (reverse commits) (fn (c) (str "pick " (:hash c) " " (:subject c ""))))
         "\n")
    "\n"
    (git-rebase-help)))

(defn git-rebase-todo-lines (text)
  "The instruction lines of a todo buffer — comments and blanks dropped. What gets written
to git's todo file."
  (seq/reject (string/split text "\n")
    (fn (l) (or (string/blank? l) (string/starts-with? (string/triml l) "#")))))

(defcommand cmd-git-rebase-interactive
  (m key)
  "Interactive rebase (r i): pick the first commit to rewrite — the one at point in a log
or the status buffer — then edit the plan in a buffer."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-pick-commit m
        "Rebase interactively from commit: "
        (fn (mm c)
          (let (onto (str c "^")
                commits (git-log-commits root [(str onto "..HEAD")]))
            (if (empty? commits)
              (message mm (str "nothing to rebase from " c))
              (ed-show-named (assoc mm :git-root root :git-rebase-onto onto)
                "*git-rebase-todo*"
                (git-rebase-todo-text commits)
                :git-rebase))))))))

(defn- git-rebase-todo-file (root)
  "Where the composed todo is written for git to copy in. Under `.git`, so it shares the
repo's lifetime and permissions rather than living in a world-readable temp dir — a todo
names every commit subject you are about to rewrite."
  (path/join (string/trim (:stdout (git-git root ["rev-parse" "--absolute-git-dir"]) ""))
    "bedit-rebase-todo"))

(defn- git-rebase-plan (m root onto lines)
  "Run an interactive rebase of `root` onto `onto` following the plan `lines`, with no
editor opened by anything. `sequence.editor` is run as `<value> <todo path>`, so `cp <our
plan>` puts it in place of git's; `core.editor` covers the message editor a `squash` would
otherwise open."
  (let (file (git-rebase-todo-file root))
    (do
      (file/spit file (str (string/join lines "\n") "\n"))
      (git-act (assoc m :git-root root)
        "rebase -i"
        ["-c"
          (str "sequence.editor=cp " (os/shell-quote file))
          "-c"
          "core.editor=true"
          "rebase"
          "-i"
          "--autostash"
          onto]))))

(defcommand cmd-git-rebase-todo-run
  (m key)
  "Run the rebase with the plan in this buffer (C-c C-c)."
  (let (root (:git-root m)
        onto (:git-rebase-onto m)
        lines (git-rebase-todo-lines (buffer-text (ed-current-buf m))))
    (cond
      (or (nil? root) (nil? onto)) (message m "no rebase in progress")
      (empty? lines) (message m "the plan is empty — C-c C-k to cancel")
      :else (git-rebase-plan (cmd-kill-buffer (assoc m :git-rebase-onto nil) key) root onto lines))))

(defcommand cmd-git-rebase-todo-abort
  (m key)
  "Abandon the plan without starting a rebase (C-c C-k)."
  (message (cmd-kill-buffer (assoc m :git-rebase-onto nil) key) "rebase cancelled"))

;; ---- rewriting ONE commit: r w / r m / r k / r f ---------------------------------
;; The interactive rebase with the plan already written: every commit from the target on is
;; picked, and the target gets its verb. Magit's `magit-rebase-reword-commit` and friends —
;; the edits you make most, without a plan to compose.

(defn- git-plan-for (root target verb &optional (after nil))
  "The plan rewriting `target` with `verb` (every later commit picked), and `after` — extra
plan lines — straight after it. Returns `[onto lines]`, or nil when `target` is not an
ancestor of HEAD."
  (let (onto (str target "^")
        commits (reverse (git-log-commits root [(str onto "..HEAD")]))
        full (string/trim (:stdout (git-git root ["rev-parse" target]) "")))
    (if (empty? commits)
      nil
      [onto
        (mapcat commits
          (fn (c)
            (let (mine? (string/starts-with? full (str (:hash c))))
              (append [(str (if mine? verb "pick") " " (:hash c) " " (:subject c ""))]
                (if (and mine? after) after [])))))])))

(defn- git-rewrite-one (m prompt verb &optional (confirm nil))
  "Pick a commit (the one at point first) and rebase with `verb` on it."
  (let (root (git-resolve-root m))
    (git-pick-commit m
      prompt
      (fn (mm c)
        (let (plan (git-plan-for root c verb))
          (cond
            (nil? plan) (message mm (str c " is not in HEAD's history"))
            (nil? confirm) (git-rebase-plan mm root (first plan) (second plan))
            :else
              (git-confirm mm
                (str confirm " " c "?")
                (fn (m2) (git-rebase-plan m2 root (first plan) (second plan))))))))))

(defcommand cmd-git-rebase-edit-commit
  (m key)
  "Stop at a commit so you can change it (r m): the rebase halts there; amend it, then r c."
  (git-rewrite-one m "Modify commit: " "edit"))

(defcommand cmd-git-rebase-remove-commit
  (m key)
  "Remove a commit from history (r k), after a question."
  (git-rewrite-one m "Remove commit: " "drop" "Remove"))

(defcommand cmd-git-rebase-reword-commit
  (m key)
  "Reword an earlier commit (r w): its message opens in *git-commit*; C-c C-c rewrites it
in place, and nothing else about the history changes."
  (let (root (git-resolve-root m))
    (git-pick-commit m
      "Reword commit: "
      (fn (mm c)
        (let (msg (string/trim (:stdout (git-git root ["log" "-1" "--format=%B" c]) "")))
          (git-open-commit (assoc mm :git-reword-target c) root :reword-at msg))))))

(defn git-reword-at (m root target msg)
  "Rewrite `target`'s message to `msg`: pick it, then amend it with an `exec` line, and pick
everything after — the whole of `r w`, as one plan."
  (let (plan (git-plan-for root
               target
               "pick"
               [(str "exec git commit --amend --only --allow-empty -m " (os/shell-quote msg))]))
    (if (nil? plan)
      (message m (str target " is not in HEAD's history"))
      (git-rebase-plan m root (first plan) (second plan)))))

(defcommand cmd-git-rebase-autosquash
  (m key)
  "Fold every `fixup!` / `squash!` commit into its target (r f), from a commit you pick."
  (git-pick-commit m "Autosquash from commit: " git-autosquash))

(defn- git-rebase-set-action (m verb)
  "Replace the verb on the current todo line, leaving the hash and subject alone."
  (let (b (ed-current-buf m)
        line (buffer-current-line b)
        text (buffer-text b)
        lines (string/split text "\n")
        current (nth lines line ""))
    (if (or (string/blank? current) (string/starts-with? (string/triml current) "#"))
      (message m "not on a commit line")
      (let (rest-of (let (sp (index-of current " "))
                      (if (< sp 0) "" (string/substring current sp (string/length current))))
            updated (string/join (assoc (into [] lines) line (str verb rest-of)) "\n"))
        (ed-set-buf m (replace-region (ed-current-buf m) 0 (buffer-length b) updated))))))

(defcommand cmd-git-rebase-pick
  (m key)
  "Use this commit as it is (p)."
  (git-rebase-set-action m "pick"))
(defcommand cmd-git-rebase-reword
  (m key)
  "Use it, but edit its message (r)."
  (git-rebase-set-action m "reword"))
(defcommand cmd-git-rebase-edit
  (m key)
  "Stop at it so you can amend (e)."
  (git-rebase-set-action m "edit"))
(defcommand cmd-git-rebase-squash
  (m key)
  "Meld into the previous commit, editing the combined message (s)."
  (git-rebase-set-action m "squash"))
(defcommand cmd-git-rebase-fixup
  (m key)
  "Meld into the previous commit, discarding this message (f)."
  (git-rebase-set-action m "fixup"))
(defcommand cmd-git-rebase-drop
  (m key)
  "Remove the commit entirely (d)."
  (git-rebase-set-action m "drop"))

(defn- git-rebase-move (m delta)
  "Move the current todo line up or down, taking point with it — reordering commits is half
of what an interactive rebase is for, and doing it by kill-and-yank in a list of hashes is
how you end up rebasing the wrong plan."
  (let (b (ed-current-buf m)
        line (buffer-current-line b)
        lines (into [] (string/split (buffer-text b) "\n"))
        target (+ line delta)
        movable? (fn (i)
                   (and (>= i 0)
                     (< i (count lines))
                     (not (string/blank? (nth lines i "")))
                     (not (string/starts-with? (string/triml (nth lines i "")) "#")))))
    (if (not (and (movable? line) (movable? target)))
      (message m "cannot move past the end of the plan")
      (let (swapped (assoc (assoc lines line (nth lines target)) target (nth lines line))
            text (string/join swapped "\n")
            b2 (replace-region (set-read-only b false) 0 (buffer-length b) text))
        (ed-set-buf m (commands/ed-goto-line b2 (inc target)))))))

(defcommand cmd-git-rebase-move-up
  (m key)
  "Move this commit earlier (M-<up>)."
  (git-rebase-move m -1))
(defcommand cmd-git-rebase-move-down
  (m key)
  "Move this commit later (M-<down>)."
  (git-rebase-move m 1))

;; ---- the FILE menu (C-c g) — git, about the file you are looking at ----------
;; Everything above assumes you are in *git-status*. Most of the time you are not: you are
;; in a source file, and the question is about THIS file — what changed in it, who wrote
;; this line, what its history is, what it looked like last week, stage it, throw my changes
;; away. Magit calls this the file dispatch, and it is the half of the porcelain that gets
;; used without opening a status buffer at all.

(defn- git-buffer-path (m)
  "The current buffer's file path, or nil. (It read `:path`, which no buffer has — a file
buffer's path is `:file` — so stage, unstage and discard from here never found a file.)"
  (buffer-file (ed-current-buf m)))

(defn- git-on-file (m verb args-fn)
  "Run a git command over the current buffer's file, refreshing after."
  (let (path (git-buffer-path m))
    (if (nil? path)
      (message m "this buffer is not a file")
      (git-act m verb (args-fn path)))))

(defcommand cmd-git-file-stage
  (m key)
  "Stage the whole of this file (C-c g s)."
  (git-on-file m "add" (fn (path) ["add" "--" path])))

(defcommand cmd-git-file-unstage
  (m key)
  "Unstage this file (C-c g u)."
  (git-on-file m "reset" (fn (path) (git-unstage-args (git-resolve-root m) [path]))))

(defcommand cmd-git-file-discard
  (m key)
  "Throw away this file's uncommitted changes (C-c g k), after confirmation naming it —
the only entry in this menu that can lose work."
  (let (path (git-buffer-path m))
    (if (nil? path)
      (message m "this buffer is not a file")
      (git-confirm m
        (str "Discard every uncommitted change to " (git-basename path) "?")
        (fn (mm) (git-act mm "checkout" ["checkout" "HEAD" "--" path]))))))

(def git-file-transient
  {:name 'git-file
   :title "This file"
   :groups [{:title "Look"
             :suffixes [{:key "d"
                         :kind :command
                         :command 'gitview/cmd-vc-diff
                         :label "diff against HEAD"}
                         {:key "l"
                          :kind :command
                          :command 'gitview/cmd-git-log-file
                          :label "its history"}
                         {:key "b"
                          :kind :command
                          :command 'gitview/cmd-git-blame
                          :label "who wrote each line"}]}
             {:title "Other versions"
              :suffixes [{:key "f"
                          :kind :command
                          :command 'gitview/cmd-git-find-file
                          :label "as it was at a revision"}
                          {:key "p"
                           :kind :command
                           :command 'gitview/cmd-git-blob-previous
                           :label "the version before"}
                          {:key "n"
                           :kind :command
                           :command 'gitview/cmd-git-blob-next
                           :label "the version after"}]}
             {:title "Change"
              :suffixes [{:key "s"
                          :kind :command
                          :command 'git/cmd-git-file-stage
                          :label "stage it"}
                          {:key "u"
                           :kind :command
                           :command 'git/cmd-git-file-unstage
                           :label "unstage it"}
                          {:key "k"
                           :kind :command
                           :command 'git/cmd-git-file-discard
                           :label "discard its changes"}
                          {:key "c" :kind :command :command 'git/cmd-git-commit :label "commit"}]}
             {:title "Elsewhere"
              :suffixes [{:key "g"
                          :kind :command
                          :command 'git/cmd-git-status
                          :label "the status buffer"}]}]})

(defcommand cmd-git-file-menu
  (m key)
  "Git, about the file you are looking at (C-c g): diff, log, blame, older versions, stage,
unstage, discard — without opening the status buffer."
  (transient/ed-transient-open m git-file-transient))

;; ---- bisect (B) --------------------------------------------------------------
;; Binary search for the commit that broke something. Rarely reached for, and painful
;; without tooling precisely because it is rare: nobody remembers the four verbs, and the
;; state lives in the repo rather than in your head, so coming back to it after lunch means
;; working out where you were.
;;
;; The status buffer already says a bisect is in progress (`git-sequencer` reads
;; `BISECT_LOG`), so the "where was I" half is answered by opening it.

(defcommand cmd-git-bisect-start
  (m key)
  "Start a bisect (B s): prompts for a KNOWN-BAD commit, then a known-good one. git then
checks out a commit half way between them and asks you about it."
  (git-pick-commit m
    "Bisect — a commit that is BAD: "
    (fn (mm bad)
      (git-with-ref mm
        "…and one that was GOOD: "
        :branches (fn (m2 good) (git-act m2 "bisect start" ["bisect" "start" bad good]))))))

(defcommand cmd-git-bisect-good
  (m key)
  "This commit is good (B g) — the fault is later."
  (git-act m "bisect good" ["bisect" "good"]))

(defcommand cmd-git-bisect-bad
  (m key)
  "This commit is bad (B b) — the fault is here or earlier."
  (git-act m "bisect bad" ["bisect" "bad"]))

(defcommand cmd-git-bisect-skip
  (m key)
  "Can't tell from this commit — it doesn't build, or the test can't run (B k)."
  (git-act m "bisect skip" ["bisect" "skip"]))

(defcommand cmd-git-bisect-reset
  (m key)
  "Stop bisecting and go back to where you were (B r)."
  (git-act m "bisect reset" ["bisect" "reset"]))

(defcommand cmd-git-bisect-log
  (m key)
  "What the bisect has established so far (B l) — the answers you have given and what they
ruled out."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["bisect" "log"]))
        (git-show-report m1 "*git-bisect*" (:stdout r "") :git-text {:action :pop})))))

(def git-bisect-transient
  {:name 'git-bisect
   :title "Bisect"
   :groups [{:title "Start"
             :suffixes [{:key "s"
                         :kind :command
                         :command 'git/cmd-git-bisect-start
                         :label "start a bisect"}]}
             {:title "Answer for the commit you are on"
              :suffixes [{:key "g"
                          :kind :command
                          :command 'git/cmd-git-bisect-good
                          :label "good — the fault is later"}
                          {:key "b"
                           :kind :command
                           :command 'git/cmd-git-bisect-bad
                           :label "bad — the fault is here or earlier"}
                          {:key "k"
                           :kind :command
                           :command 'git/cmd-git-bisect-skip
                           :label "can't tell — skip this one"}]}
             {:title "Finish"
              :suffixes [{:key "l"
                          :kind :command
                          :command 'git/cmd-git-bisect-log
                          :label "what it has established"}
                          {:key "r"
                           :kind :command
                           :command 'git/cmd-git-bisect-reset
                           :label "stop and go back"}]}]})

(defcommand cmd-git-bisect-menu
  (m key)
  "The bisect menu (B)."
  (transient/ed-transient-open m git-bisect-transient))

;; ---- worktrees (%) -----------------------------------------------------------
;; A second checkout of the same repo, on another branch, in another directory. Worth
;; having in the porcelain because the alternative — stash, switch branch, switch back,
;; unstash — is the thing worktrees exist to replace, and because a repo with worktrees is
;; one where `.git` is a FILE and half the naive git tooling quietly stops working.
;; On `%`, Magit's key (`W` is Magit's patch menu, and is ours now too).

(defn- git-worktree-dirs (root)
  "The directories of `root`'s worktrees, this one first."
  (map (seq/filter (string/split (string/trim (:stdout (git-git root
                                                         ["worktree" "list" "--porcelain"])
                                                ""))
                     "\n")
         (fn (l) (string/starts-with? l "worktree ")))
    (fn (l) (string/substring l 9 (string/length l)))))

(defcommand cmd-git-worktree-list
  (m key)
  "Every worktree of this repo and the branch it is on (% l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["worktree" "list"]))
        (git-show-report m1 "*git-worktrees*" (:stdout r "") :git-text {:action :pop})))))

(defcommand cmd-git-worktree-add
  (m key)
  "Add a worktree on a NEW branch (% c): a directory, then the branch's name."
  (git-with-name m
    "New worktree at: "
    (fn (mm dir)
      (git-with-name mm
        "…on a NEW branch named: "
        (fn (m2 branch) (git-act m2 "worktree add" ["worktree" "add" "-b" branch dir]))))))

(defcommand cmd-git-worktree-add-existing
  (m key)
  "Add a worktree checking out an EXISTING branch (% b)."
  (git-with-ref m
    "Worktree for branch: "
    :local (fn (mm branch)
      (git-with-name mm
        (str "Check " branch " out at: ")
        (fn (m2 dir) (git-act m2 "worktree add" ["worktree" "add" dir branch]))))))

(defn- git-with-worktree (m prompt then)
  "Prompt for one of the repo's worktree directories."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt prompt
            (git-worktree-dirs root)
            (fn (mm dir)
              (if (string/blank? dir) (message mm "no worktree chosen") (then mm (string/trim dir)))))))))

(defcommand cmd-git-worktree-goto
  (m key)
  "Open the status of another worktree (% g)."
  (git-with-worktree m "Go to worktree: " (fn (mm dir) (git-show-status mm dir nil :here))))

(defcommand cmd-git-worktree-remove
  (m key)
  "Remove a worktree (% k), after confirmation. Refuses if it has uncommitted changes —
git's refusal, kept rather than forced past."
  (git-with-worktree m
    "Remove worktree: "
    (fn (mm dir)
      (git-confirm mm
        (str "Remove the worktree at " dir "?")
        (fn (m2) (git-act m2 "worktree remove" ["worktree" "remove" dir]))))))

(def git-worktree-transient
  {:name 'git-worktree
   :title "Worktree"
   :groups [{:title "Worktree"
             :suffixes [{:key "b"
                         :kind :command
                         :command 'git/cmd-git-worktree-add-existing
                         :label "add, for a branch"}
                         {:key "c"
                          :kind :command
                          :command 'git/cmd-git-worktree-add
                          :label "add, on a new branch"}
                         {:key "g"
                          :kind :command
                          :command 'git/cmd-git-worktree-goto
                          :label "go to one"}
                         {:key "l" :kind :command :command 'git/cmd-git-worktree-list :label "list"}
                         {:key "k"
                          :kind :command
                          :command 'git/cmd-git-worktree-remove
                          :label "remove"}]}]})

(defcommand cmd-git-worktree-menu
  (m key)
  "The worktree menu (%)."
  (transient/ed-transient-open m git-worktree-transient))

;; ---- patches (W) and applying them (w) ---------------------------------------
;; Mail-style patches: `W c` writes one per commit of a range into a directory, `w m`
;; applies a mailbox of them as commits (`git am`), `w a` applies a plain diff to the work
;; tree. An `am` that stops is in the sequencer like any other, so `r c` / `r a` finish it.

;; `git am` leaves `rebase-apply` behind, so the sequencer reads a stopped `am` as a rebase —
;; and `am --continue` / `--abort` / `--skip` are spelled the same, so that is enough.

(defcommand cmd-git-patch-create
  (m key)
  "Write mail-style patches for a range of commits (W c) — `main..`, `HEAD~3..` — into
`patches/` at the top of the repo."
  (let (root (git-resolve-root m)
        args (transient/ed-transient-args m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt "Patches for range: "
            (map (git-refs root :branches) (fn (b) (str b "..")))
            (fn (mm range)
              (if (string/blank? range)
                (message mm "no range")
                (git-act mm
                  "format-patch"
                  (append ["format-patch" "-o" (path/join root "patches")]
                    args
                    [(string/trim range)])))))))))

(def git-patch-transient
  {:name 'git-patch
   :title "Patches"
   :groups [{:title "Arguments"
             :suffixes [{:key "-c" :kind :switch :arg "--cover-letter" :label "a cover letter"}
                         {:key "-s" :kind :switch :arg "--signoff" :label "sign off"}
                         {:key "=v"
                          :kind :option
                          :arg "--reroll-count="
                          :label "version"
                          :prompt "Reroll count"}]}
             {:title "Create"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-patch-create
                          :label "patches for a range"}]}]})

(defcommand cmd-git-patch-menu
  (m key)
  "The patch menu (W)."
  (transient/ed-transient-open m git-patch-transient))

(defn- git-with-file (m prompt then)
  "Prompt for a file path (relative to the repo, or absolute)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-with-name m
        prompt
        (fn (mm p) (then mm (if (string/starts-with? p "/") p (path/join root p))))))))

(defcommand cmd-git-am
  (m key)
  "Apply a mailbox of patches as commits (w m) — `git am`."
  (let (args (transient/ed-transient-args m))
    (git-with-file m
      "Apply patches from: "
      (fn (mm f) (git-act mm "am" (append git-no-editor ["am"] args [f]))))))

(defcommand cmd-git-apply-patch
  (m key)
  "Apply a plain patch file to the work tree (w a) — `git apply`."
  (let (args (transient/ed-transient-args m))
    (git-with-file m
      "Apply patch file: "
      (fn (mm f) (git-act mm "apply" (append ["apply"] args [f]))))))

(def git-apply-transient
  {:name 'git-apply-patches
   :title "Apply patches"
   :groups [{:title "Arguments"
             :suffixes [{:key "-3"
                         :kind :switch
                         :arg "--3way"
                         :label "fall back to a three-way merge"}
                         {:key "-s" :kind :switch :arg "--signoff" :label "sign off"}]}
             {:title "Apply"
              :suffixes [{:key "m"
                          :kind :command
                          :command 'git/cmd-git-am
                          :label "a mailbox, as commits"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-apply-patch
                           :label "a plain patch, to the work tree"}]}
             {:title "In progress"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-sequence-continue
                          :label "continue"}
                          {:key "s"
                           :kind :command
                           :command 'git/cmd-git-sequence-skip
                           :label "skip"}
                          {:key "k"
                           :kind :command
                           :command 'git/cmd-git-sequence-abort
                           :label "abort"}]}]})

(defcommand cmd-git-apply-menu
  (m key)
  "The apply-patches menu (w)."
  (transient/ed-transient-open m git-apply-transient))

;; ---- submodules (o) ------------------------------------------------------------

(defcommand cmd-git-submodule-list
  (m key)
  "Every submodule and the commit it is at (o l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["submodule" "status" "--recursive"]))
        (git-show-report m1 "*git-submodules*" (:stdout r "") :git-text {:action :pop})))))

(defcommand cmd-git-submodule-add
  (m key)
  "Add a submodule (o a): its URL, then where it goes."
  (git-with-name m
    "Submodule URL: "
    (fn (mm url)
      (git-with-name mm
        "…at path: "
        (fn (m2 p) (git-launch-op m2 "submodule add" ["submodule" "add" url p] git-refresh-if-open))))))

(defcommand cmd-git-submodule-update
  (m key)
  "Check every submodule out at the commit this repo records, initialising new ones (o u)."
  (git-launch-op m
    "submodule update"
    ["submodule" "update" "--init" "--recursive"]
    git-refresh-if-open))

(defcommand cmd-git-submodule-sync
  (m key)
  "Copy each submodule's URL from .gitmodules into its config (o s)."
  (git-act m "submodule sync" ["submodule" "sync" "--recursive"]))

(def git-submodule-transient
  {:name 'git-submodule
   :title "Submodules"
   :groups [{:title "Submodules"
             :suffixes [{:key "l" :kind :command :command 'git/cmd-git-submodule-list :label "list"}
                         {:key "a" :kind :command :command 'git/cmd-git-submodule-add :label "add"}
                         {:key "u"
                          :kind :command
                          :command 'git/cmd-git-submodule-update
                          :label "update (and init)"}
                         {:key "s"
                          :kind :command
                          :command 'git/cmd-git-submodule-sync
                          :label "sync URLs"}
                         {:key "f"
                          :kind :command
                          :command 'git/cmd-git-fetch-submodules
                          :label "fetch all"}]}]})

(defcommand cmd-git-submodule-menu
  (m key)
  "The submodule menu (o)."
  (transient/ed-transient-open m git-submodule-transient))

;; ---- notes (T) --------------------------------------------------------------------

(defcommand cmd-git-note-add
  (m key)
  "Attach a note to a commit (T T) — the one at point first; replaces an existing note."
  (git-pick-commit m
    "Note on commit: "
    (fn (mm c)
      (git-with-name mm
        "Note: "
        (fn (m2 text) (git-act m2 "notes add" ["notes" "add" "-f" "-m" text c]))))))

(defcommand cmd-git-note-remove
  (m key)
  "Remove a commit's note (T r)."
  (git-pick-commit m
    "Remove the note on: "
    (fn (mm c) (git-act mm "notes remove" ["notes" "remove" c]))))

(def git-notes-transient
  {:name 'git-notes
   :title "Notes"
   :groups [{:title "Notes"
             :suffixes [{:key "T"
                         :kind :command
                         :command 'git/cmd-git-note-add
                         :label "add or replace"}
                         {:key "r" :kind :command :command 'git/cmd-git-note-remove :label "remove"}]}]})

(defcommand cmd-git-notes-menu
  (m key)
  "The notes menu (T)."
  (transient/ed-transient-open m git-notes-transient))

;; ---- ignoring (i), untracking (K), renaming (R) --------------------------------------

(defn- git-ignore-into (m file what)
  "Append `what` to ignore file `file` (made if absent) and refresh."
  (let (old (if (file/exists? file) (file/slurp file) "")
        sep (if (or (= old "") (string/ends-with? old "\n")) "" "\n"))
    (do
      (file/spit file (str old sep what "\n"))
      (git-refresh (message m (str "ignoring " what " in " (git-basename file)))))))

(defn- git-with-ignore-pattern (m then)
  "Prompt for a pattern to ignore — the file at point first, as a path from the top."
  (let (f (git-file-at m)
        here (if (nil? f) nil (str "/" (:path f))))
    (assoc m
      :minibuffer
        (commands/ed-name-prompt "Ignore: "
          (if (nil? here) '() (list here))
          (fn (mm p)
            (if (string/blank? p) (message mm "nothing to ignore") (then mm (string/trim p))))))))

(defcommand cmd-git-ignore-shared
  (m key)
  "Ignore a file for everyone (i t) — in the top-level .gitignore, which is committed."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-with-ignore-pattern m (fn (mm p) (git-ignore-into mm (path/join root ".gitignore") p))))))

(defcommand cmd-git-ignore-private
  (m key)
  "Ignore a file for this clone only (i p) — in .git/info/exclude, which is never committed."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (dir (string/trim (:stdout (git-git root ["rev-parse" "--absolute-git-dir"]) "")))
        (git-with-ignore-pattern m
          (fn (mm p)
            (do
              (file/mkdir (path/join dir "info"))
              (git-ignore-into mm (path/join dir "info" "exclude") p))))))))

(def git-ignore-transient
  {:name 'git-ignore
   :title "Ignore"
   :groups [{:title "Ignore a file"
             :suffixes [{:key "t"
                         :kind :command
                         :command 'git/cmd-git-ignore-shared
                         :label "for everyone (.gitignore)"}
                         {:key "p"
                          :kind :command
                          :command 'git/cmd-git-ignore-private
                          :label "for this clone (.git/info/exclude)"}]}]})

(defcommand cmd-git-ignore-menu
  (m key)
  "The ignore menu (i)."
  (transient/ed-transient-open m git-ignore-transient))

(defcommand cmd-git-untrack
  (m key)
  "Stop tracking the file at point (K), keeping it on disk — `git rm --cached`."
  (let (f (git-file-at m))
    (if (nil? f)
      (message m "not on a file")
      (git-confirm m
        (str "Stop tracking " (:path f) "? It stays on disk.")
        (fn (mm) (git-act mm "rm --cached" ["rm" "--cached" "-q" "--" (:path f)]))))))

(defcommand cmd-git-rename-file
  (m key)
  "Rename or move the file at point (R) — `git mv`, so the rename is staged."
  (let (f (git-file-at m))
    (if (nil? f)
      (message m "not on a file")
      (git-with-name m
        (str "Rename " (:path f) " to: ")
        (fn (mm new) (git-act mm "mv" ["mv" "--" (:path f) new]))))))

;; ---- j — jump to a section of the status buffer -------------------------------------

(defn- git-jump (m type)
  "Point to the heading of the status section of `type`, or say it is not there."
  (let (rows (sectionbuf/sb-rows m)
        i (if (nil? rows)
            -1
            (seq/index-where rows (fn (r) (and r (:heading? r) (= (:type r) type))))))
    (if (< i 0)
      (message m "no such section here")
      (ed-apply m (fn (b) (commands/ed-goto-line b (inc i)))))))

(defcommand cmd-git-jump-untracked (m key) "Jump to Untracked files (j n)." (git-jump m :untracked))
(defcommand cmd-git-jump-unstaged (m key) "Jump to Unstaged changes (j u)." (git-jump m :unstaged))
(defcommand cmd-git-jump-staged (m key) "Jump to Staged changes (j s)." (git-jump m :staged))
(defcommand cmd-git-jump-unpushed
  (m key)
  "Jump to the unpushed commits (j p)."
  (git-jump m :unpushed))
(defcommand cmd-git-jump-unpulled
  (m key)
  "Jump to the unpulled commits (j f)."
  (git-jump m :unpulled))
(defcommand cmd-git-jump-stashes (m key) "Jump to Stashes (j z)." (git-jump m :stashes))
(defcommand cmd-git-jump-recent (m key) "Jump to Recent commits (j r)." (git-jump m :recent))

(def git-jump-transient
  {:name 'git-jump
   :title "Jump to"
   :groups [{:title "Jump to"
             :suffixes [{:key "n"
                         :kind :command
                         :command 'git/cmd-git-jump-untracked
                         :label "untracked"}
                         {:key "u"
                          :kind :command
                          :command 'git/cmd-git-jump-unstaged
                          :label "unstaged"}
                         {:key "s" :kind :command :command 'git/cmd-git-jump-staged :label "staged"}
                         {:key "p"
                          :kind :command
                          :command 'git/cmd-git-jump-unpushed
                          :label "unpushed"}
                         {:key "f"
                          :kind :command
                          :command 'git/cmd-git-jump-unpulled
                          :label "unpulled"}
                         {:key "z"
                          :kind :command
                          :command 'git/cmd-git-jump-stashes
                          :label "stashes"}
                         {:key "r"
                          :kind :command
                          :command 'git/cmd-git-jump-recent
                          :label "recent commits"}]}]})

(defcommand cmd-git-jump-menu
  (m key)
  "Jump to a section (j)."
  (transient/ed-transient-open m git-jump-transient))

;; ---- a repository to begin with: M-x git-init, M-x git-clone ----------------------

(defn- git-absolute (m dir)
  "`dir` made absolute against the current buffer's directory, `~` expanded."
  (let (d (string/trim dir)
        home (or (os/env "HOME") "/"))
    (cond
      (string/starts-with? d "~/") (path/join home (string/substring d 2 (string/length d)))
      (string/starts-with? d "/") d
      :else (path/join (commands/ed-default-dir m) d))))

(defcommand cmd-git-init
  (m key)
  "Make a directory a git repository (M-x git-init) — the current one by default — and
open its status."
  (assoc m
    :minibuffer
      (commands/ed-name-prompt "Initialise a repository in: "
        (list (commands/ed-default-dir m))
        (fn (mm dir)
          (let (target (git-absolute mm (if (string/blank? dir) (commands/ed-default-dir mm) dir))
                r (os/cmd "git" ["init" "-q" target] {:env *git-env*}))
            (if (= (:exit r) 0)
              (git-show-status (message mm (str "initialised " target)) target nil :here)
              (git-report-cmd mm "git init" r)))))))

(defn- git-clone-name (url)
  "The directory `git clone url` would make: the URL's last part, less `.git`."
  (let (last-part (last (seq/reject (string/split (string/trimr url) "/") empty?))
        base (last (string/split (or last-part "repo") ":")))
    (if (string/ends-with? base ".git") (string/substring base 0 (- (string/length base) 4)) base)))

(defcommand cmd-git-clone
  (m key)
  "Clone a repository (M-x git-clone): its URL, then where to put it — off the loop, like
every network command — and open its status when it lands."
  (git-with-name m
    "Clone repository: "
    (fn (mm url)
      (assoc mm
        :minibuffer
          (commands/ed-name-prompt "Clone into: "
            (list (path/join (commands/ed-default-dir mm) (git-clone-name url)))
            (fn (m2 dir)
              (let (target (git-absolute m2 (if (string/blank? dir) (git-clone-name url) dir)))
                (git-launch-op (assoc m2 :git-root (path/dirname target))
                  "clone"
                  ["clone" url target]
                  (fn (m3 r) (if (= (:exit r) 0) (git-show-status m3 target nil :here) m3))))))))))

;; ---- `?` — everything, from one place ---------------------------------------
;; Thirty-odd single keys in the status buffer and no way to find out what they are.
;; which-key cannot help: it reveals what follows a PREFIX, and these are not behind one.
;;
;; So the dispatch menu, Magit's `?` (and `h`): every menu as a SUB-MENU of one. Pressing
;; `?` then `P` is the same journey as pressing `P`, which is the point — it is a map of the
;; keys you will eventually press directly, not a second way of working.
;;
;; This is also the first use in the editor of a transient's `:menu` suffix (brood
;; ADR-387): entering one pushes, Escape pops back rather than dismissing, and the title
;; carries the trail so you can see where you are.

(def git-dispatch-transient
  {:name 'git-dispatch
   :title "Git"
   :groups [{:title "Look"
             :suffixes [{:key "d" :kind :menu :menu git-diff-transient :label "diff"}
                         {:key "l" :kind :menu :menu git-log-transient :label "log"}
                         {:key "y"
                          :kind :command
                          :command 'gitview/cmd-git-refs
                          :label "branches and tags"}
                         {:key "j" :kind :menu :menu git-jump-transient :label "jump to a section"}]}
             {:title "Change the working tree"
              :suffixes [{:key "c" :kind :menu :menu git-commit-transient :label "commit"}
                          {:key "z" :kind :menu :menu git-stash-transient :label "stash"}
                          {:key "X" :kind :menu :menu git-reset-transient :label "reset"}
                          {:key "i" :kind :menu :menu git-ignore-transient :label "ignore"}
                          {:key "w" :kind :menu :menu git-apply-transient :label "apply patches"}]}
             {:title "Change history"
              :suffixes [{:key "m" :kind :menu :menu git-merge-transient :label "merge"}
                          {:key "r" :kind :menu :menu git-rebase-transient :label "rebase"}
                          {:key "A"
                           :kind :menu
                           :menu git-cherry-pick-transient
                           :label "cherry-pick"}
                          {:key "V" :kind :menu :menu git-revert-transient :label "revert"}
                          {:key "W" :kind :menu :menu git-patch-transient :label "format patches"}
                          {:key "T" :kind :menu :menu git-notes-transient :label "notes"}]}
             {:title "Elsewhere"
              :suffixes [{:key "P" :kind :menu :menu git-push-transient :label "push"}
                          {:key "F" :kind :menu :menu git-pull-transient :label "pull"}
                          {:key "f" :kind :menu :menu git-fetch-transient :label "fetch"}
                          {:key "M" :kind :menu :menu git-remote-transient :label "remote"}
                          {:key "o" :kind :menu :menu git-submodule-transient :label "submodules"}]}
             {:title "Names and places"
              :suffixes [{:key "b" :kind :menu :menu git-branch-transient :label "branch"}
                          {:key "t" :kind :menu :menu git-tag-transient :label "tag"}
                          {:key "%" :kind :menu :menu git-worktree-transient :label "worktree"}
                          {:key "B" :kind :menu :menu git-bisect-transient :label "bisect"}]}
             {:title "This file"
              :suffixes [{:key "g"
                          :kind :menu
                          :menu git-file-transient
                          :label "git about the file at point"}]}]})

(defcommand cmd-git-dispatch
  (m key)
  "Every git menu, from one key (?). Escape steps back out of a sub-menu rather than
closing, so looking around costs nothing."
  (transient/ed-transient-open m git-dispatch-transient))
