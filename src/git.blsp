(defmodule git
  "A git porcelain modelled on Magit — the top of it. `C-x g` opens *git-status*
(`gitstatus`); every other key is Magit's menu on Magit's letter, a transient of flags
(`src/transient.blsp`). The porcelain is split by what each part is about, and this module
`:use`s every one of them, so loading git loads the whole porcelain and every command a
menu or a keymap names by symbol is there to be dispatched:

- `gitcore` — running git, the journal (`$`), `git-do` / `git-launch-op`, the repo's refs
- `gitbar` — the branch and working-tree state on the mode line
- `gitsection` — what every git section buffer shares: builders, faces, the common keymap
- `gitpick` — asking for a remote, a ref, a commit, a name
- `gitview` — the views: a commit, a diff, a log, blame, the refs
- `gitstatus` — *git-status*, `s` / `u` / `k`, the background fetch
- `gitremote` — `P` push, `F` pull, `f` fetch, `M` remotes
- `gitrefs` — `b` branches, `t` tags, `z` stashes, `X` reset
- `gitcommit` — `c` commit, fixup, squash, reword
- `gitsequence` — `m` merge, `r` rebase, `A` cherry-pick, `V` revert, `B` bisect

What is left here is what has no better home: the `l` log and `d` diff menus (over
`gitview`'s commands), `!` (any git command), the file menu (`C-c g`), worktrees (`%`),
patches (`W` / `w`), submodules (`o`), notes (`T`), ignoring (`i`), `K` untrack, `R` rename,
`j` jump, `M-x git-init` / `git-clone`, and `?` — every menu from one key."
  (:use model) ; ed-current-buf / message / ed-apply
  (:use pool) ; ed-default-dir / ed-name-prompt / ed-goto-line
  (:use interactive) ; defcommand
  ;; `:use`d, not referenced qualified: a qualified reference does not load a module (that
  ;; is the `unbound symbol: term/…` bug, 154d4a73), and git is where the menus are
  (:use transient) ; ed-transient-open / ed-transient-args
  (:use editor/buffer) ; buffer-file
  (:use sectionbuf) ; sb-rows — `j` jumps between the status buffer's sections
  (:use gitcore)
  (:use gitbar) ; loaded for its idle job: the mode line's branch and state
  (:use gitsection)
  (:use gitpick)
  (:use gitview)
  (:use gitstatus)
  (:use gitremote)
  (:use gitrefs)
  (:use gitcommit)
  (:use gitsequence))

;; ---- log (l), with the arguments a log is actually read with -----------------
;; `git log` is the command whose flags matter most and are remembered least: `--graph`,
;; `-n`, `--author=`. Each is a row; WHICH history is the suffix — the current branch,
;; another, every local branch, every branch, everything, a file, the reflog. The buffers
;; are `gitview`'s: commits you can show, pick, revert and rebase from.

(def git-log-transient
  {:name 'git-log
   :title "Log"
   ;; Magit's log starts with the graph drawn (`magit-log-arguments`: -n256 --graph
   ;; --decorate; the count and the decorations are every log's here)
   :defaults {"--graph" true}
   :groups [{:title "Arguments"
             :suffixes [["-g" :switch "--graph" "draw the commit graph"]
                         ["-m" :switch "--no-merges" "leave out merges"]
                         ["-F" :switch "--first-parent" "first parents only"]
                         ["=n" :option "-n" "limit" {:prompt "How many commits"}]
                         ["=a" :option "--author=" "author" {:prompt "Author"}]
                         ["=g" :option "--grep=" "message matches" {:prompt "Message pattern"}]
                         ["=S" :option "-S" "changes the count of" {:prompt "Text"}]
                         ["=s" :option "--since=" "since" {:prompt "Since (e.g. 2 weeks ago)"}]]}
             {:title "Log"
              :suffixes [["l" 'gitview/cmd-git-log "the current branch"]
                          ["o" 'gitview/cmd-git-log-other "another branch"]
                          ["L" 'gitview/cmd-git-log-local "every local branch"]
                          ["b" 'gitview/cmd-git-log-branches "every branch"]
                          ["a" 'gitview/cmd-git-log-all "every ref"]]}
             {:title "And"
              :suffixes [["f" 'gitview/cmd-git-log-file "the file at point"]
                          ["r" 'gitview/cmd-git-reflog "the reflog"]
                          ["y" 'gitview/cmd-git-refs "branches and tags"]]}]})

(defcommand cmd-git-log-menu
  (m key)
  "The log menu (l)."
  (transient/ed-transient-open m git-log-transient))

;; ---- diff (d) ----------------------------------------------------------------

(def git-diff-transient
  {:name 'git-diff
   :title "Diff"
   :groups [{:title "Arguments"
             :suffixes [["-w" :switch "-w" "ignore whitespace"]
                         ["-b" :switch "--ignore-blank-lines" "ignore blank-line changes"]
                         ["-M" :switch "-M" "detect renames"]
                         ["=u" :option "--unified=" "context lines" {:prompt "Lines of context"}]]}
             {:title "Diff"
              :suffixes [["d" 'gitview/cmd-git-diff "the thing at point"]
                          ["u" 'gitview/cmd-git-diff-unstaged "unstaged"]
                          ["s" 'gitview/cmd-git-diff-staged "staged"]
                          ["w" 'gitview/cmd-git-diff-worktree "the work tree against HEAD"]]}
             {:title "Show"
              :suffixes [["r" 'gitview/cmd-git-diff-range "a range"]
                          ["c" 'gitview/cmd-git-show-commit "a commit"]
                          ["t" 'gitrefs/cmd-git-stash-show "a stash"]]}]})

(defcommand cmd-git-diff-menu
  (m key)
  "The diff menu (d)."
  (transient/ed-transient-open m git-diff-transient))

;; ---- `!` — run a git command, for the one this menu does not have ------------

(defcommand cmd-git-run-command
  (m key)
  "Run an arbitrary git command in the repo root and show its output (!).

Every porcelain is an incomplete porcelain, and the honest answer to that is a way to run
the command it is missing WITHOUT leaving the editor and losing the context you are in.
Journalled like everything else, so `$` shows it alongside the commands the menus ran.

**The line is split into words as a shell would split them** (`os/shell-split`):
`commit -m 'two words'` is three arguments, quotes and backslashes as sh reads them. No
shell RUNS it, on purpose — git is run as an argv, so nothing is expanded (`$HOME`, a glob,
`~` reach git as typed), and a path with a space in it, quoted, stays one path."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer (pool/ed-name-prompt "git " '() (fn (mm line) (git-run-line mm root line)))))))

(defn- git-run-line (m root line)
  "Run `line`, split into words as a shell would (`os/shell-split`), as git's argv in
`root`, and show what it printed in *git-output*."
  (let (args (os/shell-split line))
    (if (empty? args)
      (message m "nothing to run")
      (git-run-then (assoc m :git-root root)
        (into [] args)
        (fn (m1 r)
          (vcsproc/vcs-show-report (vcsproc/vcs-report-cmd m1 (str "git " (string/trim line)) r)
            "*git-output*"
            (str (:stdout r "") (:stderr r ""))
            :git-text {:action :pop}))))))

;; ---- the FILE menu (C-c g) — git, about the file you are looking at ----------
;; Everything in `gitstatus` assumes you are in *git-status*. Most of the time you are not: you are
;; in a source file, and the question is about THIS file — what changed in it, who wrote
;; this line, what its history is, what it looked like last week, stage it, throw my changes
;; away. Magit calls this the file dispatch, and it is the half of the porcelain that gets
;; used without opening a status buffer at all.

(defn- git-buffer-path (m)
  "The current buffer's file path, or nil."
  (buffer-file (ed-current-buf m)))

(defn- git-on-file (m verb args-fn)
  "Run a git command over the current buffer's file, refreshing after."
  (let (path (git-buffer-path m))
    (if (nil? path)
      (message m "this buffer is not a file")
      (git-do m verb (args-fn path)))))

(defcommand cmd-git-file-stage
  (m key)
  "Stage the whole of this file (C-c g s)."
  (git-on-file m "add" (fn (path) ["add" "--" path])))

(defcommand cmd-git-file-unstage
  (m key)
  "Unstage this file (C-c g u)."
  (let (path (git-buffer-path m))
    (if (nil? path) (message m "this buffer is not a file") (git-unstage-paths m "reset" [path]))))

(defcommand cmd-git-file-discard
  (m key)
  "Throw away this file's uncommitted changes (C-c g k), after confirmation naming it —
the only entry in this menu that can lose work."
  (let (path (git-buffer-path m))
    (if (nil? path)
      (message m "this buffer is not a file")
      (vcsproc/vcs-confirm m
        (str "Discard every uncommitted change to " (git-basename path) "?")
        (fn (mm) (git-do mm "checkout" ["checkout" "HEAD" "--" path]))))))

(def git-file-transient
  {:name 'git-file
   :title "This file"
   :groups [{:title "Look"
             :suffixes [["d" 'gitview/cmd-git-diff-file "diff against HEAD"]
                         ["l" 'gitview/cmd-git-log-file "its history"]
                         ["b" 'gitview/cmd-git-blame "who wrote each line"]]}
             {:title "Other versions"
              :suffixes [["f" 'gitview/cmd-git-find-file "as it was at a revision"]
                          ["t" 'timemachine/cmd-vc-timemachine "step through its history"]
                          ["p" 'timemachine/cmd-vc-timemachine-older "the version before"]
                          ["n" 'timemachine/cmd-vc-timemachine-newer "the version after"]]}
             {:title "Change"
              :suffixes [["s" 'git/cmd-git-file-stage "stage it"]
                          ["u" 'git/cmd-git-file-unstage "unstage it"]
                          ["k" 'git/cmd-git-file-discard "discard its changes"]
                          ["c" 'gitcommit/cmd-git-commit "commit"]]}
             {:title "Elsewhere"
              :suffixes [["g" 'gitstatus/cmd-git-status "the status buffer"]]}]})

(defcommand cmd-git-file-menu
  (m key)
  "Git, about the file you are looking at (C-c g): diff, log, blame, older versions, stage,
unstage, discard — without opening the status buffer."
  (transient/ed-transient-open m git-file-transient))

;; ---- worktrees (%) -----------------------------------------------------------
;; A second checkout of the same repo, on another branch, in another directory. Worth
;; having in the porcelain because the alternative — stash, switch branch, switch back,
;; unstash — is the thing worktrees exist to replace, and because a repo with worktrees is
;; one where `.git` is a FILE and half the naive git tooling quietly stops working.
;; On `%`, Magit's key (`W` is Magit's patch menu, and is ours now too).

(defn- git-worktree-dirs (root)
  "The directories of `root`'s worktrees, this one first."
  (map (seq/filter (string/split (string/trim (:stdout (git-git root
                                                         ["worktree" "list" "--porcelain"])
                                                ""))
                     "\n")
         (fn (l) (string/starts-with? l "worktree ")))
    (fn (l) (string/substring l 9 (string/length l)))))

(defcommand cmd-git-worktree-list
  (m key)
  "Every worktree of this repo and the branch it is on (% l)."
  (git-run-report m ["worktree" "list"] "*git-worktrees*"))

(defcommand cmd-git-worktree-add
  (m key)
  "Add a worktree on a NEW branch (% c): a directory, then the branch's name."
  (git-with-name m
    "New worktree at: "
    (fn (mm dir)
      (git-with-name mm
        "…on a NEW branch named: "
        (fn (m2 branch) (git-do m2 "worktree add" ["worktree" "add" "-b" branch dir]))))))

(defcommand cmd-git-worktree-add-existing
  (m key)
  "Add a worktree checking out an EXISTING branch (% b)."
  (git-with-ref m
    "Worktree for branch: "
    :local (fn (mm branch)
      (git-with-name mm
        (str "Check " branch " out at: ")
        (fn (m2 dir) (git-do m2 "worktree add" ["worktree" "add" dir branch]))))))

(defn- git-with-worktree (m prompt then)
  "Prompt for one of the repo's worktree directories."
  (git-prompt m
    {:prompt prompt :candidates git-worktree-dirs :blank "no worktree chosen" :then then}))

(defcommand cmd-git-worktree-goto
  (m key)
  "Open the status of another worktree (% g)."
  (git-with-worktree m "Go to worktree: " (fn (mm dir) (git-show-status mm dir nil :here))))

(defcommand cmd-git-worktree-remove
  (m key)
  "Remove a worktree (% k), after confirmation. Refuses if it has uncommitted changes —
git's refusal, kept rather than forced past."
  (git-with-worktree m
    "Remove worktree: "
    (fn (mm dir)
      (vcsproc/vcs-confirm mm
        (str "Remove the worktree at " dir "?")
        (fn (m2) (git-do m2 "worktree remove" ["worktree" "remove" dir]))))))

(def git-worktree-transient
  {:name 'git-worktree
   :title "Worktree"
   :groups [{:title "Worktree"
             :suffixes [["b" 'git/cmd-git-worktree-add-existing "add, for a branch"]
                         ["c" 'git/cmd-git-worktree-add "add, on a new branch"]
                         ["g" 'git/cmd-git-worktree-goto "go to one"]
                         ["l" 'git/cmd-git-worktree-list "list"]
                         ["k" 'git/cmd-git-worktree-remove "remove"]]}]})

(defcommand cmd-git-worktree-menu
  (m key)
  "The worktree menu (%)."
  (transient/ed-transient-open m git-worktree-transient))

;; ---- patches (W) and applying them (w) ---------------------------------------
;; Mail-style patches: `W c` writes one per commit of a range into a directory, `w m`
;; applies a mailbox of them as commits (`git am`), `w a` applies a plain diff to the work
;; tree. An `am` that stops is in the sequencer like any other (`gitcore/git-sequencer`), so
;; `r c` / `r a` / `r s` run `git am --continue` / `--abort` / `--skip`.

(defcommand cmd-git-patch-create
  (m key)
  "Write mail-style patches for a range of commits (W c) — `main..`, `HEAD~3..` — into
`patches/` at the top of the repo."
  (let (args (transient/ed-transient-args m))
    (git-with-range m
      "Patches for range: "
      ".."
      (fn (mm range)
        (git-do mm
          "format-patch"
          (append ["format-patch" "-o" (path/join (git-resolve-root mm) "patches")] args [range]))))))

(def git-patch-transient
  {:name 'git-patch
   :title "Patches"
   :groups [{:title "Arguments"
             :suffixes [["-c" :switch "--cover-letter" "a cover letter"]
                         ["-s" :switch "--signoff" "sign off"]
                         ["=v" :option "--reroll-count=" "version" {:prompt "Reroll count"}]]}
             {:title "Create"
              :suffixes [["c" 'git/cmd-git-patch-create "patches for a range"]]}]})

(defcommand cmd-git-patch-menu
  (m key)
  "The patch menu (W)."
  (transient/ed-transient-open m git-patch-transient))

(defn- git-with-file (m prompt then)
  "Ask for a file — a patch, a mailbox — with the path prompt find-file uses, opened at the
repository's root, and hand the absolute path to `then`."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (ed-path-prompt prompt
            (filename/as-dir root)
            []
            (fn (mm path)
              (cond
                (string/blank? path) (message mm "no file given")
                (file/dir? path) (message mm (str (path/abbreviate path) " is a directory"))
                else (then mm path))))))))

(defcommand cmd-git-am
  (m key)
  "Apply a mailbox of patches as commits (w m) — `git am`."
  (let (args (transient/ed-transient-args m))
    (git-with-file m
      "Apply patches from: "
      (fn (mm f) (git-do mm "am" (append git-no-editor ["am"] args [f]))))))

(defcommand cmd-git-apply-patch
  (m key)
  "Apply a plain patch file to the work tree (w a) — `git apply`."
  (let (args (transient/ed-transient-args m))
    (git-with-file m
      "Apply patch file: "
      (fn (mm f) (git-do mm "apply" (append ["apply"] args [f]))))))

(def git-apply-transient
  {:name 'git-apply-patches
   :title "Apply patches"
   :groups [{:title "Arguments"
             :suffixes [["-3" :switch "--3way" "fall back to a three-way merge"]
                         ["-s" :switch "--signoff" "sign off"]]}
             {:title "Apply"
              :suffixes [["m" 'git/cmd-git-am "a mailbox, as commits"]
                          ["a" 'git/cmd-git-apply-patch "a plain patch, to the work tree"]]}
             {:title "In progress"
              :suffixes [["c" 'gitsequence/cmd-git-sequence-continue "continue"]
                          ["s" 'gitsequence/cmd-git-sequence-skip "skip"]
                          ["k" 'gitsequence/cmd-git-sequence-abort "abort"]]}]})

(defcommand cmd-git-apply-menu
  (m key)
  "The apply-patches menu (w)."
  (transient/ed-transient-open m git-apply-transient))

;; ---- submodules (o) ------------------------------------------------------------

(defcommand cmd-git-submodule-list
  (m key)
  "Every submodule and the commit it is at (o l)."
  (git-run-report m ["submodule" "status" "--recursive"] "*git-submodules*"))

(defcommand cmd-git-submodule-add
  (m key)
  "Add a submodule (o a): its URL, then where it goes."
  (git-with-name m
    "Submodule URL: "
    (fn (mm url)
      (git-with-name mm
        "…at path: "
        (fn (m2 p) (git-launch-op m2 "submodule add" ["submodule" "add" url p]))))))

(defcommand cmd-git-submodule-update
  (m key)
  "Check every submodule out at the commit this repo records, initialising new ones (o u)."
  (git-launch-op m
    "submodule update"
    ["submodule" "update" "--init" "--recursive"]))

(defcommand cmd-git-submodule-sync
  (m key)
  "Copy each submodule's URL from .gitmodules into its config (o s)."
  (git-do m "submodule sync" ["submodule" "sync" "--recursive"]))

(def git-submodule-transient
  {:name 'git-submodule
   :title "Submodules"
   :groups [{:title "Submodules"
             :suffixes [["l" 'git/cmd-git-submodule-list "list"]
                         ["a" 'git/cmd-git-submodule-add "add"]
                         ["u" 'git/cmd-git-submodule-update "update (and init)"]
                         ["s" 'git/cmd-git-submodule-sync "sync URLs"]
                         ["f" 'gitremote/cmd-git-fetch-submodules "fetch all"]]}]})

(defcommand cmd-git-submodule-menu
  (m key)
  "The submodule menu (o)."
  (transient/ed-transient-open m git-submodule-transient))

;; ---- notes (T) --------------------------------------------------------------------

(defcommand cmd-git-note-add
  (m key)
  "Attach a note to a commit (T T) — the one at point first; replaces an existing note."
  (git-pick-commit m
    "Note on commit: "
    (fn (mm c)
      (git-with-name mm
        "Note: "
        (fn (m2 text) (git-do m2 "notes add" ["notes" "add" "-f" "-m" text c]))))))

(defcommand cmd-git-note-remove
  (m key)
  "Remove a commit's note (T r)."
  (git-pick-commit m
    "Remove the note on: "
    (fn (mm c) (git-do mm "notes remove" ["notes" "remove" c]))))

(def git-notes-transient
  {:name 'git-notes
   :title "Notes"
   :groups [{:title "Notes"
             :suffixes [["T" 'git/cmd-git-note-add "add or replace"]
                         ["r" 'git/cmd-git-note-remove "remove"]]}]})

(defcommand cmd-git-notes-menu
  (m key)
  "The notes menu (T)."
  (transient/ed-transient-open m git-notes-transient))

;; ---- ignoring (i), untracking (K), renaming (R) --------------------------------------

(defn- git-ignore-into (m file what)
  "Append `what` to ignore file `file` (made if absent) and refresh."
  (let (old (if (file/exists? file) (file/slurp file) "")
        sep (if (or (= old "") (string/ends-with? old "\n")) "" "\n"))
    (do
      (file/spit file (str old sep what "\n"))
      (git-refresh (message m (str "ignoring " what " in " (git-basename file)))))))

(defn- git-with-ignore-pattern (m then)
  "Prompt for a pattern to ignore — the file at point first, as a path from the top."
  (let (f (git-file-at m))
    (git-prompt m
      {:prompt "Ignore: "
       :here (fn (_root) (if (nil? f) nil (str "/" (:path f))))
       :blank "nothing to ignore"
       :then then})))

(defcommand cmd-git-ignore-shared
  (m key)
  "Ignore a file for everyone (i t) — in the top-level .gitignore, which is committed."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-with-ignore-pattern m (fn (mm p) (git-ignore-into mm (path/join root ".gitignore") p))))))

(defcommand cmd-git-ignore-private
  (m key)
  "Ignore a file for this clone only (i p) — in .git/info/exclude, which is never committed."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (dir (or (git-dir root) (path/join root ".git")))
        (git-with-ignore-pattern m
          (fn (mm p)
            (do
              (file/mkdir (path/join dir "info"))
              (git-ignore-into mm (path/join dir "info" "exclude") p))))))))

(def git-ignore-transient
  {:name 'git-ignore
   :title "Ignore"
   :groups [{:title "Ignore a file"
             :suffixes [["t" 'git/cmd-git-ignore-shared "for everyone (.gitignore)"]
                         ["p" 'git/cmd-git-ignore-private "for this clone (.git/info/exclude)"]]}]})

(defcommand cmd-git-ignore-menu
  (m key)
  "The ignore menu (i)."
  (transient/ed-transient-open m git-ignore-transient))

(defcommand cmd-git-untrack
  (m key)
  "Stop tracking the file at point (K), keeping it on disk — `git rm --cached`."
  (let (f (git-file-at m))
    (if (nil? f)
      (message m "not on a file")
      (vcsproc/vcs-confirm m
        (str "Stop tracking " (:path f) "? It stays on disk.")
        (fn (mm) (git-do mm "rm --cached" ["rm" "--cached" "-q" "--" (:path f)]))))))

(defcommand cmd-git-rename-file
  (m key)
  "Rename or move the file at point (R) — `git mv`, so the rename is staged."
  (let (f (git-file-at m))
    (if (nil? f)
      (message m "not on a file")
      (git-with-name m
        (str "Rename " (:path f) " to: ")
        (fn (mm new) (git-do mm "mv" ["mv" "--" (:path f) new]))))))

;; ---- j — jump to a section of the status buffer -------------------------------------

(defn- git-jump (m type)
  "Point to the heading of the status section of `type`, or say it is not there."
  (let (rows (sectionbuf/sb-rows m)
        i (if (nil? rows)
            -1
            (seq/index-where rows (fn (r) (and r (:heading? r) (= (:type r) type))))))
    (if (< i 0)
      (message m "no such section here")
      (ed-apply m (fn (b) (pool/ed-goto-line b (inc i)))))))

(defcommand cmd-git-jump-untracked (m key) "Jump to Untracked files (j n)." (git-jump m :untracked))
(defcommand cmd-git-jump-unstaged (m key) "Jump to Unstaged changes (j u)." (git-jump m :unstaged))
(defcommand cmd-git-jump-staged (m key) "Jump to Staged changes (j s)." (git-jump m :staged))
(defcommand cmd-git-jump-unpushed
  (m key)
  "Jump to the unpushed commits (j p)."
  (git-jump m :unpushed))
(defcommand cmd-git-jump-unpulled
  (m key)
  "Jump to the unpulled commits (j f)."
  (git-jump m :unpulled))
(defcommand cmd-git-jump-stashes (m key) "Jump to Stashes (j z)." (git-jump m :stashes))
(defcommand cmd-git-jump-recent (m key) "Jump to Recent commits (j r)." (git-jump m :recent))

(def git-jump-transient
  {:name 'git-jump
   :title "Jump to"
   :groups [{:title "Jump to"
             :suffixes [["n" 'git/cmd-git-jump-untracked "untracked"]
                         ["u" 'git/cmd-git-jump-unstaged "unstaged"]
                         ["s" 'git/cmd-git-jump-staged "staged"]
                         ["p" 'git/cmd-git-jump-unpushed "unpushed"]
                         ["f" 'git/cmd-git-jump-unpulled "unpulled"]
                         ["z" 'git/cmd-git-jump-stashes "stashes"]
                         ["r" 'git/cmd-git-jump-recent "recent commits"]]}]})

(defcommand cmd-git-jump-menu
  (m key)
  "Jump to a section (j)."
  (transient/ed-transient-open m git-jump-transient))

;; ---- a repository to begin with: M-x git-init, M-x git-clone ----------------------

(defcommand cmd-git-init
  (m key)
  "Make a directory a git repository (M-x git-init) — the current one by default — and
open its status. The directory is read as find-file reads a path (`pool/ed-path-prompt`, a new name: `~/…`,
Tab, a relative one under the current directory)."
  (let (here (pool/ed-default-dir m))
    (assoc m
      :minibuffer
        (pool/ed-path-prompt "Initialise a repository in: "
          (filename/as-dir here)
          []
          (fn (mm dir)
            (let (target (path/normalize dir))
              ;; queued off the loop like any other git; journalled, so `$` shows it
              (vcsproc/vcs-run-queued mm
                "git"
                target
                ["init" "-q" target]
                (fn (_dir arguments) (os/cmd "git" arguments {:env *git-env*}))
                (fn (m1 r)
                  (if (= (:exit r) 0)
                    (git-show-status (message m1 (str "initialised " (path/abbreviate target)))
                      target nil :here)
                    (vcsproc/vcs-report-cmd m1 "git init" r))))))
          {:new-name true}))))

(defn- git-clone-name (url)
  "The directory `git clone url` would make: the URL's last part, less `.git`."
  (let (last-part (last (seq/reject (string/split (string/trim-right url) "/") empty?))
        base (last (string/split (or last-part "repo") ":")))
    (if (string/ends-with? base ".git") (string/substring base 0 (- (string/length base) 4)) base)))

(defcommand cmd-git-clone
  (m key)
  "Clone a repository (M-x git-clone): its URL, then where to put it — off the loop, like
every network command — and open its status when it lands. Where is read as find-file reads a path
(`pool/ed-path-prompt`, a new name), a relative one under the current directory."
  (git-with-name m
    "Clone repository: "
    (fn (mm url)
      (let (here (pool/ed-default-dir mm)
            default (path/join here (git-clone-name url)))
        (assoc mm
          :minibuffer
            (pool/ed-path-prompt "Clone into: "
              default
              []
              (fn (m2 dir) (git-clone-into m2 url (path/normalize dir)))
              {:new-name true}))))))

(defn- git-clone-into (m url target)
  "Clone `url` into the absolute directory `target` off the loop, and open its status when it
lands."
  (git-launch-op-in m
    (path/dirname target)
    "clone"
    ["clone" url target]
    (fn (mm r) (if (= (:exit r) 0) (git-show-status mm target nil :here) mm))))

;; ---- `?` — everything, from one place ---------------------------------------
;; Thirty-odd single keys in the status buffer and no way to find out what they are.
;; which-key cannot help: it reveals what follows a PREFIX, and these are not behind one.
;;
;; So the dispatch menu, Magit's `?` (and `h`): every menu as a SUB-MENU of one. Pressing
;; `?` then `P` is the same journey as pressing `P`, which is the point — it is a map of the
;; keys you will eventually press directly, not a second way of working.
;;
;; Each row is a transient's `:menu` suffix (brood ADR-387): entering one pushes, Escape
;; pops back rather than dismissing, and the title carries the trail so you can see where
;; you are.

(def git-dispatch-transient
  {:name 'git-dispatch
   :title "Git"
   :groups [{:title "Look"
             :suffixes [["d" :menu git-diff-transient "diff"]
                         ["l" :menu git-log-transient "log"]
                         ["y" 'gitview/cmd-git-refs "branches and tags"]
                         ["j" :menu git-jump-transient "jump to a section"]]}
             {:title "Change the working tree"
              :suffixes [["c" :menu git-commit-transient "commit"]
                          ["z" :menu git-stash-transient "stash"]
                          ["X" :menu git-reset-transient "reset"]
                          ["i" :menu git-ignore-transient "ignore"]
                          ["w" :menu git-apply-transient "apply patches"]]}
             {:title "Change history"
              :suffixes [["m" :menu git-merge-transient "merge"]
                          ["r" :menu git-rebase-transient "rebase"]
                          ["A" :menu git-cherry-pick-transient "cherry-pick"]
                          ["V" :menu git-revert-transient "revert"]
                          ["W" :menu git-patch-transient "format patches"]
                          ["T" :menu git-notes-transient "notes"]]}
             {:title "Elsewhere"
              :suffixes [["P" :menu git-push-transient "push"]
                          ["F" :menu git-pull-transient "pull"]
                          ["f" :menu git-fetch-transient "fetch"]
                          ["M" :menu git-remote-transient "remote"]
                          ["o" :menu git-submodule-transient "submodules"]]}
             {:title "Names and places"
              :suffixes [["b" :menu git-branch-transient "branch"]
                          ["t" :menu git-tag-transient "tag"]
                          ["%" :menu git-worktree-transient "worktree"]
                          ["B" :menu git-bisect-transient "bisect"]]}
             {:title "This file"
              :suffixes [["g" :menu git-file-transient "git about the file at point"]]}]})

(defcommand cmd-git-dispatch
  (m key)
  "Every git menu, from one key (?). Escape steps back out of a sub-menu rather than
closing, so looking around costs nothing."
  (transient/ed-transient-open m git-dispatch-transient))
