                           :label "the index"}
                          {:key "w"
                           :kind :command
                           :command 'git/cmd-git-stash-worktree
                           :label "the work tree"}]}
             {:title "Use a stash"
              :suffixes [{:key "a" :kind :command :command 'git/cmd-git-stash-apply :label "apply"}
                          {:key "p" :kind :command :command 'git/cmd-git-stash-pop :label "pop"}
                          {:key "v" :kind :command :command 'git/cmd-git-stash-show :label "show"}
                          {:key "b"
