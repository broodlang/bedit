;; ---- fetch (f) ---------------------------------------------------------------

(def git-fetch-transient
  {:name 'git-fetch
   :title "Fetch"
   :groups [{:title "Arguments"
             :suffixes [{:key "-p"
                         :kind :switch
                         :arg "--prune"
                         :label "drop remote branches that are gone"}
                         {:key "-t" :kind :switch :arg "--tags" :label "fetch tags too"}
                         {:key "-f" :kind :switch :arg "--force" :label "force"}]}
             {:title "Fetch from"
              :suffixes [{:key "f"
                          :kind :command
                          :command 'git/cmd-git-fetch-upstream
                          :label "the upstream"}
                          {:key "e"
                           :kind :command
                           :command 'git/cmd-git-fetch-other
                           :label "another remote"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-fetch-all
                           :label "every remote"}
                          {:key "m"
                           :kind :command
                           :command 'git/cmd-git-fetch-submodules
                           :label "every submodule"}]}]})

(defcommand cmd-git-fetch-menu
  (m key)
  "The fetch menu (f)."
  (transient/ed-transient-open m git-fetch-transient))

(defcommand cmd-git-fetch-all
  (m key)
  "Fetch from every remote (f a) — off the loop, like every other network command."
  (git-launch-op m
    "fetch"
    (append ["fetch" "--all"] (transient/ed-transient-args m))
    git-refresh-if-open))

(defcommand cmd-git-fetch-other
  (m key)
  "Fetch from a remote you pick (f e)."
  (let (args (transient/ed-transient-args m))
    (git-with-remote m
      "Fetch from: "
      (fn (mm remote)
        (git-launch-op mm "fetch" (append ["fetch"] args [remote]) git-refresh-if-open)))))

(defcommand cmd-git-fetch-submodules
  (m key)
  "Fetch in every submodule too (f m)."
  (git-launch-op m
    "fetch"
    (append ["fetch" "--recurse-submodules"] (transient/ed-transient-args m))
    git-refresh-if-open))

(defcommand cmd-git-fetch-upstream
  (m key)
  "Fetch from the upstream remote with the fetch menu's arguments (f f) — off the loop.

Distinct from `cmd-git-fetch`, which is the *background* watch's quick fetch on a timer
and takes no arguments: a menu that offered `--prune` and then dropped it would be worse
than not offering it."
  (git-launch-op m "fetch" (append ["fetch"] (transient/ed-transient-args m)) git-refresh-if-open))

