(defmodule git
  "A git porcelain modelled on Magit. `C-x g` opens *git-status*: what is in progress, `Head:`
/ `Merge:` / `Push:` / `Tag:`, then Unmerged, Untracked, Unstaged and Staged files, the
unpushed and unpulled commits, the stashes and the recent history — a `std/editor/section`
tree (brood ADR-388) shown through `sectionbuf`, so TAB folds any of it, `n`/`p`/`^`/`M-n`/`M-p`
walk it and `1`–`4` show it to a depth.

`s` / `u` / `k` stage, unstage and discard what is at point — a REGION of a hunk's lines, a
hunk, a file, several files, or a whole list — the patches cut by `std/diff`
(`diff/hunk-select`) and piped to `git apply`. `RET` goes to the line a diff line became, a
file, or a commit. Every other key is Magit's menu on Magit's letter, a transient of flags
(`src/transient.blsp`): `c` commit (and fixup, squash, reword, instant fixup), `b` branch,
`P` / `F` / `f` push, pull, fetch, `l` log, `d` diff, `z` stash, `m` merge, `r` rebase
(including rewording, editing or dropping one commit), `A` cherry-pick, `V` revert, `X`
reset, `t` tag, `M` remote, `B` bisect, `%` worktrees, `W` / `w` patches, `o` submodules,
`T` notes, `i` ignore, `j` jump, `y` refs, `?` all of them. `$` shows what git actually ran.

The views — a commit, a diff, a log, blame, the refs, a file at a revision — are
`gitview`'s, section buffers with the same keys. Nothing that can take longer than a frame
runs on the loop: the status collects in a task, network operations and commits are launched."
  (:use model) ; ed-current-buf / ed-set-buf / message / ed-read-char / ed-apply
  (:use commands) ; ed-show-named / ed-default-dir / ed-goto-line / cmd-kill-buffer
  (:use interactive) ; defcommand
  ;; `:use`d, not referenced qualified: `cmd-git-push` calls `ed-transient-args` on EVERY
  ;; push, including one reached by a keybinding with no menu in sight, and a qualified
  ;; reference does not load a module (that is the `unbound symbol: term/…` bug, 154d4a73).
  ;; Loading it with git is right anyway — git is where the menus are.
  (:use transient) ; ed-transient-open / ed-transient-args — the P and F menus
  (:use statusbar) ; `seg` — build the branch + working-tree status-bar segments
  (:use editor/buffer) ; buffer-current-line / buffer-text
  (:use editor/section) ; section — the status buffer is a section tree (brood ADR-388)
  (:use sectionbuf) ; the section buffer: rows, folding, n/p, what is at point
  (:use task)) ; task — the status summary's four git subprocesses, off the loop
;; `theme` (a project source module, loaded with the image) provides the *green* / *red* /
;; *blue* / *yellow* / *subtext* dynamic-var colour globals this file reads bare.
;; ---- syntax highlighting for the diff / log / status buffers ----------------
;; A `:fontify` service like every mode's: a pure `slice -> [start end face]`, line-
;; structural (no lexer state) so the windowed slice the view passes colours correctly
;; wherever it starts. The classifier trims leading whitespace first, so it works for the
;; raw *git-diff* output AND the indented inline diff under a file in *git-status*.

(def git-face-add {:fg *green*}) ; an added (+) line
(def git-face-del {:fg *red*}) ; a removed (-) line
(def git-face-hunk {:fg *blue* :bold true}) ; a @@ hunk header
(def git-face-file {:fg *subtext* :bold true}) ; diff --git / +++ / --- file headers
(def git-face-meta {:fg *subtext*}) ; index / mode / rename metadata
(def git-face-section {:fg *blue* :bold true}) ; a *git-status* section header
(def git-face-note {:fg *subtext* :italic true})
(def git-face-summary {:bold true}) ; a commit's summary line, heading its message
(def git-face-hash {:fg *yellow*}) ; a commit hash in the log
;; the status-bar segment faces (branch + colour-coded working-tree indicator): staged reads
;; green, unstaged yellow, untracked dim; a clean/staged tree dot is green. Built from the
;; theme colour tokens (via `require`), like the diff faces above — kept here, not in theme,
;; because git reaches the palette through `require` (dynamic-var colours only).
(def git-face-branch {:fg *subtext*}) ; the ⎇ branch label (quiet, secondary)
(def git-face-clean {:fg *green*}) ; the state dot when the tree is clean / staged
(def git-face-staged {:fg *green*}) ; the +N staged-change count (ready to commit)
(def git-face-unstaged {:fg *yellow*}) ; the ~N unstaged-change count (modified, dirty)
(def git-face-untracked {:fg *overlay0*}) ; the ?N untracked-file count (dim)
;; the *git-status* header block: a local branch (the `Head:` line) reads blue, a remote /
;; upstream branch (the `Merge:` line) green — Magit's magit-branch-local / -remote.
(def git-face-branch-local {:fg *blue* :bold true}) ; the `Head:` line's branch
(def git-face-branch-remote {:fg *green* :bold true}) ; the `Merge:` line's upstream
;; the colour-coded file-status labels — a legend at a glance, reusing the diff-hl palette
;; (modified yellow, added green, deleted red, rename/copy blue, untracked dim). Keyed by the
;; human label `git-entry-label` emits, so the fontify colours just that word.
(def- git-label-faces
  {"modified" git-face-unstaged
   "new file" git-face-add
   "deleted" git-face-del
   "renamed" git-face-hunk
   "copied" git-face-hunk
   "conflict" git-face-del
   "untracked" git-face-untracked
   ;; how a conflict happened (`git-conflict-label`) — all red, because every one of them
   ;; is the same instruction: this file is not going anywhere until you decide
   "both modified" git-face-del
   "both added" git-face-del
   "both deleted" git-face-del
   "added by us" git-face-del
   "added by them" git-face-del
   "deleted by us" git-face-del
   "deleted by them" git-face-del
   "unmerged" git-face-del})

(defn- git-diff-text-face (line)
  "The face for a line of raw unified-diff TEXT: headers, hunk headers, `+` and `-` lines;
nil for a context line. For the plain-text git buffers (`!`'s output); the section buffers
colour by what a line IS instead (`git-section-faces`)."
  (cond
    (string/starts-with? line "@@") git-face-hunk
    (or (string/starts-with? line "+++") (string/starts-with? line "---")) git-face-file
    (string/starts-with? line "diff ") git-face-file
    (or (string/starts-with? line "index ")
      (string/starts-with? line "new ")
      (string/starts-with? line "deleted ")
      (string/starts-with? line "rename ")
      (string/starts-with? line "similarity ")
      (string/starts-with? line "old mode")
      (string/starts-with? line "new mode"))
      git-face-meta
    (string/starts-with? line "+") git-face-add
    (string/starts-with? line "-") git-face-del
    :else nil))

(defn- git-whole-line (off line face)
  "A whole-line span `[off end face]`, or `()` when `face` is nil."
  (if (nil? face) '() (list [off (+ off (string/length line)) face])))

(defn- git-fontify-lines (lines off line-spans acc)
  "Tail-recursive: accumulate `(line-spans line off)` spans (prepended via `cons`, reversed
once at the end), advancing `off` by each line's length + 1 (the stripped newline).
`cons`+`reverse` rather than `append acc` so fontifying a large diff/log window is O(lines),
not O(lines²) — `append` recopies the whole accumulator each line."
  (if (empty? lines)
    (reverse acc)
    (git-fontify-lines (rest lines)
      (+ off (string/length (first lines)) 1)
      line-spans
      (fold (line-spans (first lines) off) acc (fn (a span) (cons span a))))))

(defn git-diff-fontify (src)
  "The `:fontify` of a plain-text git buffer — colour each unified-diff line."
  (git-fontify-lines (string/split src "\n")
    0
    (fn (l off) (git-whole-line off l (git-diff-text-face l)))
    '()))

;; ---- running git ------------------------------------------------------------

(def *git-env*
  ;; Every git the editor runs: there is no terminal for git to prompt on — bedit started
  ;; from a shell would hand git THAT terminal, and a password prompt would appear in a
  ;; window nobody is looking at while the command hangs. A credential git cannot find is a
  ;; failed command, reported like any other.
  {"GIT_TERMINAL_PROMPT" "0"})

(def *git-background-env*
  ;; A git nobody asked for (the background fetch) must not ask anything at all: no askpass
  ;; dialog popping up every three minutes, no ssh passphrase prompt. `true` as the askpass
  ;; program answers every question with nothing, so the fetch fails quietly instead.
  (merge *git-env*
    {"GIT_ASKPASS" "true" "SSH_ASKPASS" "true" "GIT_SSH_COMMAND" "ssh -o BatchMode=yes"}))

(defn git-git (root args &optional (opts {}))
  "Run git in `root` with `args` (a vector); `{:exit :stdout :stderr}`. `core.quotePath=false`
keeps non-ASCII paths literal (no octal escapes) in status / diff output; `*git-env*` keeps
git from prompting. `opts` go to `os/cmd` (`:stdin`, `:timeout-ms`, `:env` over `*git-env*`)."
  (os/cmd "git"
    (into ["-C" root "-c" "core.quotePath=false"] args)
    (assoc opts :env (merge *git-env* (get opts :env {})))))

(defn git-toplevel (dir)
  "The git work-tree root containing `dir`, or nil when `dir` isn't in a repo."
  (let (r (os/cmd "git" ["-C" dir "rev-parse" "--show-toplevel"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn git-branch (root)
  "The current branch name (or a short hash when detached), `?` on error — `projects`'
`git-branch`, the one implementation."
  (or (projects/git-branch root) "?"))

(defn- git-born? (root)
  "Whether the repo at `root` has a first commit. Before one, HEAD names a branch with
nothing on it, and everything that resolves `HEAD` fails."
  (= 0 (:exit (git-git root ["rev-parse" "-q" "--verify" "HEAD"]))))

(defn- git-unstage-args (root paths)
  "The git arguments that take `paths` out of the index, back to HEAD. `reset HEAD` is the
usual way, and it fails in a repo with no commits yet (there is no HEAD to reset to) — so
after `git init`, nothing could be unstaged. There, the index entry is simply removed."
  (if (or (nil? root) (git-born? root))
    (into ["reset" "-q" "HEAD" "--"] paths)
    (into ["rm" "--cached" "-q" "-r" "--"] paths)))

(defn git-resolve-root (m)
  "The repo the current buffer is about: a git section buffer's own root (a status, a log, a
commit — each knows which repo it shows), else the repo containing the buffer's directory,
else the root the last git command ran in. Nil when there is none.

The buffer comes first. `:git-root` is one slot on the MODEL, so reading it first meant a
file in repo B, visited after a status of repo A, ran its git in A."
  (or (get (sectionbuf/sb-ctx m) :root) (git-toplevel (commands/ed-default-dir m)) (:git-root m)))

;; ---- applying a patch (hunk- and line-level staging) --------------------------
;; A hunk, or a run of its lines, is turned back into a patch by `std/diff`
;; (`diff/hunk-patch`, `diff/hunk-select` — brood ADR-388) and piped to `git apply` over
;; stdin: `--cached` stages it, `--reverse` with it unstages, `--reverse` alone discards,
;; and `--index --reverse` discards a staged change from the index and the work tree at once.

(defn- git-apply-hunk (root patch-text cached? reverse?)
  "Pipe `patch-text` to `git apply -` (stdin). `cached?` adds `--cached` (the index alone),
or `:index` for `--index` (index and work tree together — discarding a staged hunk);
`reverse?` adds `--reverse` (for unstage/discard). Returns `{:exit :stdout :stderr}`."
  (git-git root
    (append ["apply" "--ignore-space-change"]
      (cond (= cached? :index) ["--index"] cached? ["--cached"] :else [])
      (if reverse? ["--reverse"] [])
      ["-"])
    {:stdin patch-text}))

;; ---- pure: parse `git status --porcelain -z` --------------------------------
;; The NUL-separated form is robust to paths with spaces / quotes / newlines (no quoting, no
;; octal escapes) — git never mangles a filename in `-z`. A rename or copy emits its NEW path
;; in the status token and the OLD source as a separate trailing token, which we consume.

(defn- git-parse-z (tokens acc)
  "Walk NUL-split `git status --porcelain -z` tokens into `{:x :y :path}` entries; a rename or
copy (`R`/`C` in the status code) consumes the following token as its source path, keeping the
new path under point."
  (if (empty? tokens)
    (reverse acc)
    (let (t (first tokens))
      (if (< (string/length t) 4)
        (git-parse-z (rest tokens) acc)
        (let (x (string/substring t 0 1)
              y (string/substring t 1 2)
              path (string/substring t 3 (string/length t))
              rename? (or (= x "R") (= x "C")))
          ;; keep a rename's source: unstaging `new` alone left the deletion of `old` staged
          (git-parse-z (if rename? (rest (rest tokens)) (rest tokens))
            (cons (if rename?
                    {:x x :y y :path path :orig-path (second tokens)}
                    {:x x :y y :path path})
              acc)))))))

(defn- git-entries (porcelain)
  "Parse `git status --porcelain -z` output (NUL-separated; a rename/copy carries its source as
a trailing field) into a list of `{:x :y :path}`."
  (git-parse-z (seq/reject (string/split porcelain "\u{0}") empty?) '()))

(defn- git-conflicted? (e)
  "Whether `e` is an unmerged path — a conflict waiting to be resolved.

Porcelain v1 spells these `UU` `AA` `DD` `AU` `UA` `DU` `UD`: either side `U`, or both
sides the same `A`/`D`. They are NOT staged-and-unstaged, which is how the plain
`git-staged?` / `git-unstaged?` tests read them — so before this, a conflicted file
appeared in both sections at once, and `s` on it staged a file with `<<<<<<<` markers in
it. Its own section is the fix, and the reason Magit has one."
  (let (x (:x e) y (:y e))
    (or (= x "U") (= y "U") (and (= x "A") (= y "A")) (and (= x "D") (= y "D")))))

(defn- git-untracked? (e) (and (= (:x e) "?") (= (:y e) "?")))
(defn- git-staged? (e) (and (not (= (:x e) " ")) (not (= (:x e) "?"))))
(defn- git-unstaged? (e) (and (not (= (:y e) " ")) (not (git-untracked? e))))

;; ---- the status-bar segments (branch + working-tree indicator) --------------
;; The branch and a colour-coded working-tree indicator on the status bar, for **every**
;; buffer in a repo (not just *git-status*). Built off the render path: the idle beat calls
;; `git-cache-status` to recompute the summary + segments and cache them on the model as
;; `:git-segments` (see `input`), which the view lays out (`view/ed-statusbar-segments`).
;; Both segments are clickable (→ `C-x g`) and carry a hover tooltip.

(def *git-branch-glyph* "⎇ ") ; the branch marker; set to "git:" if your font lacks ⎇
(def *git-state-glyph* "●") ; the working-tree state dot
(defn git-upstream (root)
  "The upstream ref (e.g. `origin/main`) of the current branch, or nil when it has none."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{u}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn- git-ahead-behind (root)
  "`{:ahead :behind}` commit counts (as strings — tooltip-only) vs the upstream, or nil when
there is no upstream. `--left-right` counts the upstream side (behind) and the HEAD side (ahead)."
  (let (r (git-git root ["rev-list" "--left-right" "--count" "@{u}...HEAD"]))
    (if (not (= (:exit r) 0))
      nil
      (let (parts (seq/reject (string/split (string/trim (:stdout r)) "\t") empty?))
        (if (= (count parts) 2) {:behind (first parts) :ahead (second parts)} nil)))))

(defn git-summary (root)
  "A working-tree summary for the status bar, or nil outside a repo: `{:root :branch :upstream
:ahead :behind :staged :unstaged :untracked}`. Counts come from `git status --porcelain`;
ahead/behind are best-effort strings vs the upstream. A few `git` calls, so it runs off the
render path (the idle beat — `git-cache-status`)."
  (if (nil? root)
    nil
    (let (entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"])))
          upstream (git-upstream root)
          ab (and upstream (git-ahead-behind root)))
      {:root root
       :branch (git-branch root)
       :upstream upstream
       :ahead (and ab (:ahead ab))
       :behind (and ab (:behind ab))
       :staged (count (seq/filter entries git-staged?))
       :unstaged (count (seq/filter entries git-unstaged?))
       :untracked (count (seq/filter entries git-untracked?))})))

(defn- git-basename (path)
  "The last path component of `path` (the repo directory name), tolerating a trailing slash."
  (let (parts (seq/reject (string/split path "/") empty?))
    (if (empty? parts) path (last parts))))

(defn- git-dot-face (summary)
  "The state-dot colour: yellow when there are unstaged changes (a dirty tree), green when
only staged (ready to commit) or clean."
  (cond
    (> (:unstaged summary) 0) git-face-unstaged
    (> (:staged summary) 0) git-face-staged
    :else git-face-clean))

(defn- git-repo-tooltip (summary)
  "The branch segment's hover tooltip: repo name, branch, upstream, and ahead/behind."
  (append [(str "Repo:   " (git-basename (:root summary))) (str "Branch: " (:branch summary))]
    (if (:upstream summary)
      [(str "Upstream: " (:upstream summary))
        (str "↑ " (or (:ahead summary) "0") " ahead    ↓ " (or (:behind summary) "0") " behind")]
      ["(no upstream)"])))

(defn- git-tree-tooltip (summary)
  "The state-dot segment's hover tooltip: the working-tree counts, or 'clean'."
  (if (and (= (:staged summary) 0) (= (:unstaged summary) 0) (= (:untracked summary) 0))
    ["Working tree clean"]
    [(str "Staged:    " (:staged summary))
      (str "Unstaged:  " (:unstaged summary))
      (str "Untracked: " (:untracked summary))]))

(defn- git-count-seg (id prefix n face)
  "A colour-coded count segment (e.g. `+3`), or nil when the count is 0 (so it vanishes)."
  (if (= n 0) nil (seg id (str prefix n) {:sep "  " :face face})))

(defn- git-sync-count (s)
  "An ahead/behind count as an int — they arrive from `git rev-list --count` as strings,
and a missing upstream leaves them absent entirely."
  (let (n (if (string? s) (string/->number s) s))
    (if (int? n) n 0)))

(defn git-sync-seg (summary)
  "The `↓2 ↑1` upstream segment, or nil when the branch is level with its upstream (or has
none). What the background fetch is FOR: ahead/behind was already computed for the branch
tooltip, where you had to hover to find out the remote had moved. On the mode line it is
the thing you glance at — and `↓` appearing on its own is the notification arriving twice,
once as a message you might miss and once as a mark that stays."
  (if (nil? summary)
    nil
    (let (behind (git-sync-count (:behind summary))
          ahead (git-sync-count (:ahead summary))
          parts (seq/reject (list (if (> behind 0) (str "↓" behind) nil)
                              (if (> ahead 0) (str "↑" ahead) nil))
                  nil?))
      (if (empty? parts)
        nil
        (seg :git-sync
          (string/join parts " ")
          {:sep "  "
           ;; behind reads as "there is something to pull" — the colour the unstaged count
           ;; uses for "you have work to do"; ahead-only is quieter, it is just unpushed
           :face (if (> behind 0) git-face-unstaged git-face-branch)
           :on-click 'git/cmd-git-status
           :tooltip (str (if (> behind 0) (str behind " to pull") "")
                      (if (and (> behind 0) (> ahead 0)) ", " "")
                      (if (> ahead 0) (str ahead " to push") ""))})))))

(defn git-statusbar-segments (summary)
  "The git status-bar segments from `summary` (nil ⇒ `()`): a clickable **branch** segment
(tooltip: repo / upstream / ahead-behind; click: `C-x g`), a **state dot** coloured by the
working tree (tooltip: the counts; click: `C-x g`), then colour-coded **+staged ~unstaged
?untracked** counts, each shown only when non-zero. Pure — built from the cached summary."
  (if (nil? summary)
    '()
    (seq/filter (list (seg :git-branch
                        (str *git-branch-glyph* (:branch summary))
                        {:sep "  —  "
                         :face git-face-branch
                         :on-click 'git/cmd-git-status
                         :tooltip (git-repo-tooltip summary)})
                  (seg :git-dot
                    *git-state-glyph*
                    {:sep "   "
                     :face (git-dot-face summary)
                     :on-click 'git/cmd-git-status
                     :tooltip (git-tree-tooltip summary)})
                  (git-sync-seg summary)
                  (git-count-seg :git-staged "+" (:staged summary) git-face-staged)
                  (git-count-seg :git-unstaged "~" (:unstaged summary) git-face-unstaged)
                  (git-count-seg :git-untracked "?" (:untracked summary) git-face-untracked))
      (fn (s) (not (nil? s))))))

;; ---- the status summary, off the loop ---------------------------------------
;; `git-summary` is FOUR `git` subprocesses — `rev-parse --show-toplevel`, `status
;; --porcelain -z`, `rev-parse --abbrev-ref HEAD` and `rev-list --left-right --count` — and
;; it ran on the loop process on every idle beat. On a 27,310-file repo `git status` alone
;; measures 40 ms, and each spawn is a few more: fifty-odd milliseconds of frozen editor
;; every time typing settled, which is exactly when a reader looks up and notices. It also
;; scales with the repo rather than with anything the editor is doing.
;;
;; So it runs in a spawned task and folds its answer back like every other async recompute
;; (`model/ed-launch-gitdiff`, `ed-launch-diag`, `ed-launch-eldoc` — same shape, same reply
;; route).
;;
;; Note what travels: a KEY, not a root. Resolving the root is itself `git rev-parse
;; --show-toplevel`, so asking for the root on the loop — and asking again when the answer
;; lands, to check it is still the right one — would have left two of the four subprocesses
;; exactly where they were. The key is what the editor already knows (the git buffer's root
;; if it has one, the current buffer's directory, whether it is file-backed), it is free to
;; compute, and comparing it is how a stale answer is recognised.

(defn git-status-key (m)
  "What the status-bar summary is ABOUT, as a value the loop can compute for nothing:
`[git-root default-dir file-backed?]`. Resolving that to a repo root is a subprocess, so it
happens in the task; this is what is compared to tell a stale answer from a current one.

A **fileless** buffer (*scratch*, *Playground*, a report) that is not itself a git buffer
carrying `:git-root` has nothing to describe: it only *inherits* a `:dir` from wherever it
was created, and one that cannot be saved has no working-tree relationship for a branch +
dirty-state indicator to be about."
  [(:git-root m) (commands/ed-default-dir m) (and (buffer-file (ed-current-buf m)) true)])

(defn git-status-summary (key)
  "The working-tree summary for a `git-status-key`, or nil when there is nothing to describe.
Resolves the repo root and runs `git-summary` — five subprocesses all told, which is why
this is what the task runs and nothing on the loop calls it directly."
  (let ([git-root dir file?] key)
    (if (not (or git-root file?)) nil (git-summary (or git-root (git-toplevel dir))))))

(defn git-cache-status (m)
  "Recompute the cached git status-bar segments (`:git-segments`) + summary (`:git-summary`)
**synchronously**. The headless path, and the one the tests drive; a live editor goes through
`git-launch-status` instead."
  (let (summary (git-status-summary (git-status-key m)))
    (if (= summary (:git-summary m))
      m
      (assoc m :git-summary summary :git-segments (git-statusbar-segments summary)))))

(defn git-launch-status (m)
  "Recompute the status-bar git summary OFF the loop when nothing is already in flight.
Headless (no loop for a reply to land in) falls back to the synchronous `git-cache-status`,
so tests and a `--headless` daemon behave exactly as before."
  (cond
    (:git-proc m) m
    (ed-headless?) (git-cache-status m)
    :else
      (let (key (git-status-key m)
            job (task (fn () (git-status-summary key))))
        (assoc m :git-proc job :git-checking key))))

(defn git-apply-status (m summary)
  "Fold a finished summary into `:git-summary` + `:git-segments` and free the in-flight slot.
An answer about a buffer the reader has since left is dropped — the next idle beat asks about
the one they are in now."
  (let (asked (:git-checking m)
        m1 (dissoc m :git-proc :git-checking))
    (cond
      (not (= asked (git-status-key m1))) m1
      (= summary (:git-summary m1)) m1
      :else (assoc m1 :git-summary summary :git-segments (git-statusbar-segments summary)))))

;; ---- the status buffer is a SECTION TREE ---------------------------------------
;; Magit's layout, and Magit's density: a heading per section with its count, one line per
;; file with its state word, the hunks under a file when it is opened, a blank line between
;; top-level sections and nowhere else. It used to be text with a parallel vector of per-line
;; maps on the MODEL, two blank lines between sections and every line indented so a text-only
;; fontifier could tell a diff line from a file line. Now it is a `std/editor/section` tree
;; shown through `sectionbuf`: the rows live on the buffer, the faces come from what each
;; line IS (`git-section-faces`), and TAB, n/p, ^, M-n/M-p and 1-4 are the shared ones.
;;
;; The pieces, all pure: `git-status-tree` builds the tree from a collection
;; (`git-collect-status`, the subprocesses, run in a task), and the section VALUES are what
;; commands act on — a file `{:path :orig-path :section :x :y}`, a hunk `{:path :section
;; :file :hunk}` (the parsed `std/diff` file and hunk, so a patch is `diff/hunk-patch` and a
;; line range is `diff/hunk-select`), a commit `{:hash :subject :refs}`, a stash `{:ref}`.

(def- git-list-sections
  ;; The four sections a working-tree FILE can be in, as section types.
  #{:unmerged :untracked :unstaged :staged})

(defn- git-conflict-label (e)
  "How a conflict happened, from its two status letters — which is what decides how to
resolve it. `both modified` takes an edit; `deleted by them` takes a decision about whether
the file should exist at all, and no amount of editing the working copy expresses it."
  (let (x (:x e) y (:y e))
    (cond
      (and (= x "U") (= y "U")) "both modified"
      (and (= x "A") (= y "A")) "both added"
      (and (= x "D") (= y "D")) "both deleted"
      (and (= x "A") (= y "U")) "added by us"
      (and (= x "U") (= y "A")) "added by them"
      (and (= x "D") (= y "U")) "deleted by us"
      (and (= x "U") (= y "D")) "deleted by them"
      :else "unmerged")))

(defn git-entry-label (e section)
  "A human-readable status label for `e` in `section`, matching Magit's file-status display."
  (cond
    (= section :unmerged) (git-conflict-label e)
    (= section :untracked) "untracked"
    (= section :staged)
      (cond
        (= (:x e) "M") "modified"
        (= (:x e) "A") "new file"
        (= (:x e) "D") "deleted"
        (= (:x e) "R") "renamed"
        (= (:x e) "C") "copied"
        (= (:x e) "T") "typechange"
        :else (str (:x e) (:y e)))
    :else
      (cond
        (= (:y e) "M") "modified"
        (= (:y e) "D") "deleted"
        (= (:y e) "T") "typechange"
        (= (:y e) "U") "conflict"
        :else (str (:x e) (:y e)))))

(def- git-label-width 11) ; Magit's column: "modified   " — the widest common label and two spaces
(defn- git-file-heading (e lst)
  "A file's line: its state word padded to Magit's column, then the path — `old -> new` for
a rename. An untracked file is just its path, as in Magit: the section says what it is."
  (let (path (if (:orig-path e) (str (:orig-path e) " -> " (:path e)) (:path e)))
    (if (= lst :untracked)
      path
      (let (label (git-entry-label e lst))
        (str label
          (string/pad-right "" (math/max 2 (- git-label-width (string/length label))))
          path)))))

(defn git-hunk-sections (path lst file)
  "The hunk sections of one parsed `std/diff` file: each `@@` header a heading, its lines
the body. Keyed by position and header, so a re-render keeps a folded hunk folded."
  (let (hunks (:hunks file))
    (map (range (count hunks))
      (fn (i)
        (let (h (nth hunks i))
          (section :hunk
            {:path path :section lst :file file :hunk h}
            (:header h)
            (:lines h)
            {:key (str i " " (:header h))}))))))

(defn- git-file-section (e lst diffs)
  "The section for file `e` in list `section`. Folded by default; its hunks are there when
the collection fetched its diff (it was open), and it is marked `:lazy?` when it was not,
so TAB knows to fetch rather than to unfold nothing."
  (let (path (:path e)
        diff (get-in diffs [lst path])
        value {:path path
               :orig-path (:orig-path e)
               :section lst
               :x (:x e)
               :y (:y e)
               :lazy? (nil? diff)}
        children (cond
                   (nil? diff) []
                   ;; a conflict's combined diff has `@@@` hunks the two-way parser does not
                   ;; read — shown as it is, which is what a conflict looks like
                   (string? diff) (seq/reject (string/split diff "\n") empty?)
                   :else (git-hunk-sections path lst diff)))
    (section :file value (git-file-heading e lst) children {:key path :hidden true})))

(defn- git-list-section (type title entries diffs)
  "One of the four file lists, or nil when it has no files."
  (if (empty? entries)
    nil
    (section type
      nil
      (str title " (" (count entries) ")")
      (into [] (map entries (fn (e) (git-file-section e type diffs))))
      {:separator true})))

(defn- git-refs-text (refs)
  "A commit's decorations as Magit shows them after the hash, or empty."
  (if (or (nil? refs) (= refs "")) "" (str "(" refs ") ")))

(defn git-commit-section (c &optional (opts {}))
  "The section for commit `c` (`{:hash :subject :refs}`): `hash (refs) subject`, the value
the commit itself — what RET shows, `A` cherry-picks, `X` resets to."
  (section :commit
    c
    (str (:hash c) " " (git-refs-text (:refs c)) (:subject c ""))
    (or (:children opts) [])
    {:key (:hash c)}))

(defn- git-commits-section (type title commits &optional (count? true))
  "A section of commits (unpushed / unpulled / recent), or nil when there are none."
  (if (empty? commits)
    nil
    (section type
      nil
      (if count? (str title " (" (count commits) ")") title)
      (into [] (map commits git-commit-section))
      {:separator true})))

(defn- git-stash-section (stashes)
  "The Stashes section, or nil when there are none."
  (if (empty? stashes)
    nil
    (section :stashes
      nil
      (str "Stashes (" (count stashes) ")")
      (into []
        (map stashes
          (fn (s)
            (section :stash
              {:ref (:hash s) :subject (:subject s)}
              (str (:hash s) " " (:subject s))
              []
              {:key (:hash s)}))))
      {:separator true})))

(def- git-head-label-width 8) ; pads "Head:" / "Merge:" so the branch column aligns
(defn- git-head-line (label ref subject)
  "One header line: a left-padded `label` (`Head:` / `Merge:`), the branch/upstream `ref`, then
its commit `subject` (omitted when empty)."
  (str (string/pad-right label git-head-label-width) ref (if (= subject "") "" (str "  " subject))))

(defn- git-headers-section (branch head)
  "The header block: the operation in progress (if any) ABOVE everything, then `Head:`,
`Merge:` (the upstream), `Push:` (where a push goes, when that is not the upstream) and
`Tag:` (the nearest tag and how far past it HEAD is).

The in-progress line's placement is the point. A repo stopped mid-rebase looks, in every
other respect, like a repo with some conflicted files in it; the difference is that HEAD is
detached and half your commits are not where you think they are. Magit puts it at the top
for the same reason, and a status buffer that does not say so is how people lose work."
  (let (seq (:sequencer head)
        upstream (:upstream head)
        push (:push head)
        tag (:tag head))
    (section :headers
      nil
      nil
      (seq/reject [(if seq
                     (section :sequencer
                       (:kind seq)
                       (git-head-line (str (:verb seq) ":")
                         "in progress" "— r c continue · r s skip · r a abort"))
                     nil)
                    (section :branch
                      {:name branch :local? true}
                      (git-head-line "Head:" branch (:subject head "")))
                    (if upstream
                      (section :branch
                        {:name upstream}
                        (git-head-line "Merge:" upstream (:upstream-subject head ""))
                        []
                        {:key [:upstream upstream]})
                      nil)
                    (if (and push (not (= push upstream)))
                      (section :branch
                        {:name push}
                        (git-head-line "Push:" push "")
                        []
                        {:key [:push push]})
                      nil)
                    (if tag
                      (section :tag
                        {:name (:name tag)}
                        (git-head-line "Tag:"
                          (:name tag)
                          (if (> (:distance tag 0) 0) (str "(" (:distance tag) ")") "")))
                      nil)]
        nil?)
      {:separator true})))

(defn git-status-tree (collected)
  "The *git-status* section tree for a finished collection. Pure — a test builds one from a
hand-written collection and asserts on `section-render`.

Order is Magit's: what is in progress, the unmerged files you cannot get past, untracked,
unstaged, staged, then where you stand against the upstream, the stashes and the recent
history."
  (let (entries (:entries collected '())
        diffs (:diffs collected {})
        conflicted (seq/filter entries git-conflicted?)
        plain (seq/reject entries git-conflicted?)
        upstream (get-in collected [:head :upstream]))
    (section :status
      nil
      nil
      (seq/reject [(git-headers-section (:branch collected) (:head collected {}))
                    (git-list-section :unmerged "Unmerged paths" conflicted diffs)
                    (git-list-section :untracked
                      "Untracked files"
                      (seq/filter plain git-untracked?)
                      diffs)
                    (git-list-section :unstaged
                      "Unstaged changes"
                      (seq/filter plain git-unstaged?)
                      diffs)
                    (git-list-section :staged "Staged changes" (seq/filter plain git-staged?) diffs)
                    (git-commits-section :unpushed
                      (str "Unpushed to " upstream)
                      (:unpushed collected '()))
                    (git-commits-section :unpulled
                      (str "Unpulled from " upstream)
                      (:unpulled collected '()))
                    (git-stash-section (:stashes collected '()))
                    (git-commits-section :recent "Recent commits" (:recent collected '()) false)]
        nil?))))

;; ---- faces: what a line IS, not what it looks like ------------------------------
;; One service for every git section buffer (status, log, commit, diff, blame, refs): the
;; row says what the line is, so a `-` at the start of a diff line and a `-` at the start of
;; a commit subject are never confused, and nothing has to be indented to be told apart.

(defn git-diff-line-face (line)
  "The face of one diff BODY line by its first character, or nil for context."
  (cond
    (string/starts-with? line "+") git-face-add
    (string/starts-with? line "-") git-face-del
    (string/starts-with? line "\\") git-face-meta
    :else nil))

(defn- git-heading-count-spans (line)
  "A section heading `Title (N)`: the title in the section face, the count dim."
  (let (i (index-of line " ("))
    (if (< i 0)
      (list [0 (string/length line) git-face-section])
      (list [0 i git-face-section] [(inc i) (string/length line) git-face-meta]))))

(defn- git-label-spans (line face)
  "A header line `Label:  ref  rest`: the label dim, the ref (to the next space) coloured
by `face`."
  (do
    (let (colon (index-of line ":")
          start (let (j (seq/index-where (range (inc colon) (string/length line))
                          (fn (k) (not (= (string/char-at line k) " ")))))
                  (if (< j 0) (string/length line) (+ colon 1 j)))
          sp (index-of (string/substring line start (string/length line)) " ")
          end (if (< sp 0) (string/length line) (+ start sp)))
      (list [0 (inc colon) git-face-meta] [start end face]))))

(defn- git-file-heading-spans (line value)
  "A file heading: the state word in its colour; an untracked path dim."
  (let (section (:section value))
    (if (= section :untracked)
      (list [0 (string/length line) git-face-untracked])
      (let (sep (index-of line "  ")
            word (if (< sep 0) line (string/substring line 0 sep))
            face (get git-label-faces (string/trim word)))
        (if (nil? face) '() (list [0 (string/length word) face]))))))

(defn- git-commit-heading-spans (line value)
  "A commit heading: the graph drawing dim (a log's `--graph`), the hash, the refs in
parentheses in the branch face, and the author-and-age margin dim."
  (let (g (string/length (str (:graph value "")))
        h (string/length (str (:hash value "")))
        refs (git-refs-text (:refs value))
        margin (:margin-at value))
    (append (if (> g 0) (list [0 g git-face-meta]) '())
      (list [g (+ g h) git-face-hash])
      (if (= refs "") '() (list [(+ g h 1) (+ g h (string/length refs)) git-face-branch-remote]))
      (if (int? margin) (list [margin (string/length line) git-face-meta]) '()))))

(defn git-section-faces (row line)
  "The `:section-faces` service shared by every git section buffer: the faces of `line`,
which is what `row` says it is."
  (let (type (:type row)
        value (:value row))
    (if (not (:heading? row))
      ;; a body line: a diff line in a hunk or a commit body, else a plain line
      (let (face (cond
                   (or (= type :hunk) (= type :file) (= type :diff)) (git-diff-line-face line)
                   ;; a --graph line with no commit on it, and a commit header's fields
                   (or (= type :log) (= type :meta)) git-face-meta
                   :else nil))
        (if (nil? face) '() (list [0 (string/length line) face])))
      (cond
        (contains? git-list-sections type) (git-heading-count-spans line)
        (includes? [:unpushed :unpulled :stashes :recent :section :refs-group] type)
          (git-heading-count-spans line)
        (= type :sequencer) (list [0 (string/length line) git-face-unstaged])
        (= type :branch)
          (git-label-spans line (if (:local? value) git-face-branch-local git-face-branch-remote))
        (= type :tag) (git-label-spans line git-face-hash)
        (= type :file) (git-file-heading-spans line value)
        (= type :hunk) (list [0 (string/length line) git-face-hunk])
        (= type :diff-file) (list [0 (string/length line) git-face-file])
        (= type :commit) (git-commit-heading-spans line value)
        (= type :stash) (list [0 (string/length (:ref value "")) git-face-hash])
        (= type :ref)
          (list [0
                  (string/length (:name value ""))
                  (if (:remote? value) git-face-branch-remote git-face-branch-local)])
        (= type :blame)
          (list [0 (string/length (:hash value "")) git-face-hash]
            [(inc (string/length (:hash value ""))) (string/length line) git-face-meta])
        (= type :note) (list [0 (string/length line) git-face-note])
        (= type :message) (list [0 (string/length line) git-face-summary])
        (= type :meta) (list [0 (string/length line) git-face-meta])
        :else '()))))

;; ---- commit rows, for every section buffer that lists commits -------------------

(def git-log-format
  ;; hash, decorations, subject, author, relative date — NUL-separated, so a subject with
  ;; any character in it survives. `%D` is the decoration without its parentheses.
  "--format=%h%x00%D%x00%s%x00%an%x00%ar")

(defn git-parse-log (stdout)
  "Parse `git log` output in `git-log-format` into `({:hash :refs :subject :author :date})`.
A `--graph` log interleaves graph-only lines; a line without the NUL fields keeps its text
as `:graph` and no hash."
  (map (seq/reject (string/split (or stdout "") "\n") empty?)
    (fn (line)
      (let (parts (string/split line (string/int->char 0)))
        (if (< (count parts) 5)
          {:graph line}
          (let (lead (nth parts 0)
                ;; with --graph the hash field carries the graph drawing in front of it
                sp (string/last-index-of lead " ")
                hash (if (< sp 0) lead (string/substring lead (inc sp) (string/length lead)))
                graph (if (< sp 0) "" (string/substring lead 0 (inc sp))))
            {:hash hash
             :graph graph
             :refs (nth parts 1)
             :subject (nth parts 2)
             :author (nth parts 3)
             :date (nth parts 4)}))))))

(defn git-log-commits (root args)
  "Run `git log` with `args` in `git-log-format` and parse it, `()` when it fails."
  (let (r (git-git root (append ["log" git-log-format] args)))
    (if (= (:exit r) 0) (seq/filter (git-parse-log (:stdout r "")) :hash) '())))

(def- git-recent-count 10) ; how many recent commits the status buffer lists (Magit's default)
;; ---- collecting: every subprocess, off the loop ---------------------------------
;; `git status --porcelain` is not fast on every repo. Measured on a mix project whose
;; `.git` is 128 MB: **5.4 seconds** for the status call alone, 17 s for everything the
;; status buffer runs — because git walks `_build/` and `deps/` to decide they are ignored.
;; On the loop that is a 17-second freeze on `C-x g`, and another on every `g`, `s` and `u`.
;;
;; The split that makes it fixable: COLLECT (every subprocess, plain data in and out, so it
;; can cross a process boundary) and RENDER (pure, needs the model). Collect runs in a
;; task; render folds the answer. Headless collects inline, so tests still drive real git.
;;
;; Diffs are fetched per SECTION, not per file: one `git diff` for every open unstaged
;; file and one `git diff --cached` for the staged ones, parsed with `diff/parse-unified`
;; and split by path. Only a section with a file open is diffed at all.

(defn- git-open-files (vis)
  "The `[section path]` pairs of the status files open in visibility `vis` — the ones the
collection must fetch a diff for. A file's id is `[[:status nil] [section nil] [:file path]]`."
  (fold vis
    []
    (fn (acc kv)
      (let ([id state] kv)
        (if (and (= state :show) (= (count id) 3) (= (first (nth id 2)) :file))
          (into acc [[(first (nth id 1)) (second (nth id 2))]])
          acc)))))

(defn- git-diff-by-path (text)
  "A whole-section diff parsed and keyed by path (the new side, the old for a deletion)."
  (fold (diff/parse-unified text)
    {}
    (fn (acc f) (assoc acc (or (:new-path f) (:old-path f)) f))))

(defn- git-collect-diffs (root open)
  "`{section {path file}}` for the open files: one diff per section that has any open."
  (let (sections (into #{} (map open first))
        paths-in (fn (s) (map (seq/filter open (fn (o) (= (first o) s))) second)))
    (fold sections
      {}
      (fn (acc s)
        (case s
          :unstaged
            (assoc acc
              :unstaged (git-diff-by-path (:stdout (git-git root ["diff" "--no-ext-diff"]) "")))
          :staged
            (assoc acc
              :staged
                (git-diff-by-path (:stdout (git-git root ["diff" "--cached" "--no-ext-diff"]) "")))
          :unmerged
            (assoc acc
              :unmerged
                (fold (paths-in s)
                  {}
                  (fn (a p) (assoc a p (:stdout (git-git root ["diff" "--no-ext-diff" "--" p]) "")))))
          :untracked
            (assoc acc
              :untracked
                (fold (paths-in s)
                  {}
                  (fn (a p)
                    (let (f (first (diff/parse-unified (:stdout (git-git root
                                                                  ["diff"
                                                                    "--no-index" "--" "/dev/null" p])
                                                         ""))))
                      (if (nil? f) a (assoc a p f))))))
          acc)))))

(defn git-status-inputs (m root)
  "Everything the collection needs from the model, as plain data — read on the loop before
the task starts, because a task cannot see the model and a rope cannot cross to it."
  (let (i (ed-buffer-index-by-name m "*git-status*")
        vis (if (nil? i) {} (or (:section-vis (ed-buf-at m i)) {})))
    {:root root :open (git-open-files vis)}))

(defn- git-nearest-tag (root)
  "`{:name :distance}` for the nearest tag behind HEAD, or nil when there is none."
  (let (r (git-git root ["describe" "--tags" "--abbrev=0"]))
    (if (not (= (:exit r) 0))
      nil
      (let (name (string/trim (:stdout r ""))
            n (string/->number (string/trim (:stdout (git-git root
                                                       ["rev-list" "--count" (str name "..HEAD")])
                                              ""))))
        {:name name :distance (if (int? n) n 0)}))))

(defn- git-push-target (root)
  "Where a plain `git push` of this branch goes (`@{push}`), or nil."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "@{push}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r "")) nil)))

(defn git-collect-status (inputs)
  "Every git subprocess the status buffer needs, as one plain-data answer. Safe to run in a
task: plain data in, plain data out, no model and no rope."
  (let (root (:root inputs)
        entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"]) ""))
        upstream (git-upstream root)
        recent (git-log-commits root [(str "-" git-recent-count)]))
    {:root root
     :branch (git-branch root)
     :entries entries
     :diffs (git-collect-diffs root (:open inputs '()))
     :unpushed (if upstream (git-log-commits root ["@{u}..HEAD"]) '())
     :unpulled (if upstream (git-log-commits root ["HEAD..@{u}"]) '())
     :recent recent
     :stashes (git-stashes root)
     :head {:sequencer (git-sequencer root)
            :subject (if (empty? recent) "" (:subject (first recent) ""))
            :upstream upstream
            :push (git-push-target root)
            :tag (git-nearest-tag root)
            :upstream-subject (if upstream
                                (let (cs (git-log-commits root ["-1" upstream]))
                                  (if (empty? cs) "" (:subject (first cs) "")))
                                "")}}))

;; ---- showing it ------------------------------------------------------------------

(defn- git-status-line-links (rows root)
  "The 0-based-line → `{:file :line}` map for *git-status*: every file heading links to its
file — the pointer cursor, hover underline and click that *Tests* rows have (the SHARED
`results/line-links-loc`)."
  (fold (range (count rows))
    {}
    (fn (acc i)
      (let (row (nth rows i))
        (if (and row (:heading? row) (= (:type row) :file))
          (assoc acc i {:file (path/join root (:path (:value row))) :line 1})
          acc)))))

(defn- git-first-file-line (rows)
  "The 1-based line of the first file heading, else of the first list heading, else 1."
  (let (i (seq/index-where rows (fn (r) (and r (:heading? r) (= (:type r) :file))))
        j (seq/index-where rows
            (fn (r) (and r (:heading? r) (contains? git-list-sections (:type r))))))
    (cond
      (>= i 0) (inc i)
      (>= j 0) (inc j)
      :else 1)))

(defn- git-render-status (m root collected &optional (line nil) (action :here))
  "PURE: fold a finished `git-collect-status` into `*git-status*` for repo `root`. `line`
places point — a 1-based number, nil (the first file on a first open, else where it was),
or `(rows -> line)` (see `git-stay-in-section`). `action` is `:here` when the reader asked
for the buffer, `:none` for a refresh behind them, which must not move their pane."
  (let (fresh? (nil? (ed-buffer-index-by-name m "*git-status*"))
        m1 (sectionbuf/sb-show (assoc m :git-root root)
             "*git-status*"
             (git-status-tree collected)
             :git-status {:action action
              :ctx {:root root}
              :line (if (and (nil? line) fresh?) git-first-file-line line)})
        i (ed-buffer-index-by-name! m1 "*git-status*")
        b (ed-buf-at m1 i))
    (ed-set-buf-at m1 i (assoc b :line-links (git-status-line-links (:section-rows b) root)))))

(defn- git-status-focus (m)
  "`:here` when the reader is looking at *git-status* (or it is not open yet, so this is the
first show), else `:none` — a refresh the background asked for lands in the pool quietly."
  (let (i (ed-buffer-index-by-name m "*git-status*"))
    (if (or (nil? i) (= i (ed-current-index m))) :here :none)))

(defn- git-show-status (m root &optional (line nil) (action nil))
  "Show/refresh `*git-status*` for `root` — collecting OFF the loop.

The editor gets the buffer immediately (the previous contents while a refresh is in flight,
a `Loading…` placeholder the first time) and the real thing when the subprocesses land. On a
repo where `git status` takes five seconds, the difference is between an editor that is
frozen for five seconds and one that says so and keeps working.

Headless collects inline: no loop means no reply, and every git test wants the real answer
synchronously."
  (let (act (or action (git-status-focus m)))
    (if (model/ed-headless?)
      (git-render-status m root (git-collect-status (git-status-inputs m root)) line act)
      (let (inputs (git-status-inputs m root)
            job (task (fn () (git-collect-status inputs)) {:timeout *git-op-timeout-ms*})
            ;; the first open has nothing to show yet; a refresh keeps what is on screen
            ;; rather than blanking it, because a flicker back to "Loading" on every `g`
            ;; is worse than a stale half-second
            m1 (if (nil? (ed-buffer-index-by-name m "*git-status*"))
                 (ed-show-named (assoc m :git-root root) "*git-status*" "Loading…\n" :git-status)
                 (assoc m :git-root root)))
        (assoc m1 :git-status-proc job :git-status-line line :git-status-action act)))))

(defn git-apply-show-status (m collected)
  "Fold a finished status collection into the buffer. A nil answer (the task errored or
timed out) says so rather than rendering an empty repo, which is what a blank `entries`
would look like — a clean working tree, confidently wrong."
  (let (line (:git-status-line m)
        action (:git-status-action m :here)
        m1 (dissoc m :git-status-proc :git-status-line :git-status-action))
    (cond
      (nil? collected) (message m1 "git status failed or timed out")
      ;; an answer about a repo the reader has since left
      (not (= (:root collected) (:git-root m1))) m1
      ;; `:here` was decided when the refresh STARTED; if the reader has since moved to
      ;; another buffer, landing it `:here` would drag them back
      :else
        (git-render-status m1
          (:root collected)
          collected
          line
          (if (= :here (git-status-focus m1)) action :none)))))

;; ---- what is at point ------------------------------------------------------------

(defn git-row-at (m)
  "The section row on point's line in the current git buffer, or nil."
  (sectionbuf/sb-at m))

(defn- git-list-of (row)
  "The file list (`:unstaged` / `:staged` / `:untracked` / `:unmerged`) a status row is
inside, or nil — the second step of its id."
  (if (or (nil? row) (< (count (:id row)) 2))
    nil
    (let (t (first (nth (:id row) 1))) (if (contains? git-list-sections t) t nil))))

(defn git-file-at (m)
  "The file value `{:path :orig-path :section …}` at point — on its heading or anywhere in
its hunks — or nil."
  (let (r (sectionbuf/sb-ancestor m :file)) (if (nil? r) nil (:value r))))

(defn git-hunk-at (m)
  "The hunk value `{:path :section :file :hunk}` at point, or nil."
  (let (r (sectionbuf/sb-ancestor m :hunk)) (if (nil? r) nil (:value r))))

(defn- git-list-files (m section)
  "Every file value in list `section` of the current status tree — what `s` on the
`Untracked files` heading stages, or `k` there deletes."
  (let (tree (:section-tree (ed-current-buf m))
        lst (if (nil? tree)
              nil
              (seq/find (:children tree) (fn (s) (and (map? s) (= (:type s) section))))))
    (if (nil? lst) '() (map (:children lst) :value))))

(defn- git-region-hunk (m reverse?)
  "When the region lies inside ONE hunk's body, that hunk cut down to the region's lines
(`diff/hunk-select`, `reverse?` for a patch applied in reverse) as `[value patch]`, else
nil. Magit's line-level staging: select the lines, press `s`."
  (let (rows (sectionbuf/sb-region-rows m))
    (if (or (nil? rows) (empty? rows) (any? rows nil?))
      nil
      (let (ids (into #{} (map rows :id))
            row (first rows))
        (if (or (not (= (count ids) 1)) (not (= (:type row) :hunk)))
          nil
          (let (lines (seq/reject (map rows :line) nil?)
                value (:value row))
            (if (empty? lines)
              nil
              (let (lo (reduce lines math/min)
                    hi (reduce lines math/max)
                    cut (if (and (int? lo) (int? hi))
                          (diff/hunk-select (:hunk value) lo (inc hi) reverse?)
                          nil))
                (if (nil? cut) nil [value (diff/hunk-patch (:file value) cut)])))))))))

(defn- git-region-files (m)
  "The file values whose headings the region covers, or nil when there is no region or it
covers none — `s` over three files stages three files."
  (let (rows (sectionbuf/sb-region-rows m))
    (if (nil? rows)
      nil
      (let (files (map (seq/filter rows (fn (r) (and r (:heading? r) (= (:type r) :file)))) :value))
        (if (empty? files) nil files)))))

(defn- git-stay-in-section (m)
  "A `(new-rows -> 1-based line)` that keeps point in the file LIST it was in, across a
rebuild: on whichever file slides into its slot — the next one, the list's last when it was
the bottom one, or the first file anywhere when the list emptied. So `s` on a file lands on
the next file to stage instead of chasing the staged one into another section."
  (let (row (git-row-at m)
        list-type (git-list-of row)
        rows (or (sectionbuf/sb-rows m) [])
        here (sectionbuf/sb-line m)
        file-lines (fn (rs t)
                     (seq/filter (range (count rs))
                       (fn (i)
                         (let (r (nth rs i))
                           (and r (:heading? r) (= (:type r) :file) (= (git-list-of r) t))))))
        before (if (nil? list-type)
                 0
                 (count (seq/filter (file-lines rows list-type) (fn (j) (< j here))))))
    (fn (new-rows)
      (if (nil? list-type)
        (math/min (inc here) (math/max 1 (count new-rows)))
        (let (ls (file-lines new-rows list-type))
          (if (empty? ls)
            (git-first-file-line new-rows)
            (inc (nth ls (math/min before (dec (count ls))) 0))))))))

;; ---- git off the loop: no git command ever blocks a keystroke -----------------
;; Every `git-git` here is a SUBPROCESS, and three of them talk to a network: `pull`,
;; `push`, `fetch`. Run on the loop, a pull over a slow link freezes the whole editor —
;; no repaint, no C-g, nothing — for as long as the remote takes. That is not a git
;; problem; it is the one thing a Brood editor has no excuse for, because the language's
;; whole answer to blocking work is a process.
;;
;; So: a git command that can take longer than a frame goes through `git-launch-op`,
;; which runs it in a `task` and folds the result when it lands (the same launch / fold /
;; row shape as every other off-loop recompute — `input/ed-task-replies`). The editor
;; stays live, the mode line says what is running, and C-g cancels it.
;;
;; `ed-headless?` keeps the synchronous path for tests and `--headless`, where there is no
;; loop for a reply to land in — so every existing git test still exercises real git.

(def *git-op-timeout-ms* 120000)
;; A network git operation gets two minutes before the task is killed and reported as a
;; timeout. Unbounded is how a wedged `pull` against an unreachable host becomes a slot
;; that never frees and a `git` that is "already running" until restart.

(defn git-op-running (m)
  "The verb of the git operation in flight (`\"pull\"`, `\"push\"`, …), or nil."
  (get-in m [:git-op :verb]))

;; check-allow: `then` is an opaque caller-supplied `(model result) -> model`, so the
;; checker cannot see what the last branch returns. ADR-341 names `:trusted` for exactly
;; this — the declaration is the contract, and every branch here is a `message` or a fold.
(check-allow :trusted
  (sig git-launch-op (model string seqable &optional any -> model))
  (defn git-launch-op (m verb args &optional (then nil))
    "Run `git args` in the repo root OFF the loop and report when it lands. `then` is an
optional `(model result) -> model` run after the report — a refresh, usually.

Refuses to start a second operation while one is in flight: two pulls at once is not a
thing anyone means, and the in-flight slot holds exactly one handle. Headless runs it
synchronously, because there is no loop to hand the reply to."
    (let (root (git-resolve-root m))
      (cond
        (nil? root) (message m "not in a git repository")
        (git-op-running m) (message m (str "git " (git-op-running m) " is already running"))
        (model/ed-headless?)
          (let ([m0 r] (git-run (assoc m :git-root root) args)
                m1 (git-report-cmd m0 verb r))
            (if (nil? then) m1 (then m1 r)))
        :else
        ;; the entry is recorded when the command STARTS, so an in-flight pull reads as
        ;; `run git pull` in the process log while it is still out there — which is the
        ;; question you have when one is slow
        ;; the entry is journalled when the command STARTS, so an in-flight pull reads as
        ;; `run git pull` while it is still out there — which is the question you have
        ;; when one is slow. `git-apply-op` completes it; the entry times itself.
          (let (job (task (fn () (git-git root args)) {:timeout *git-op-timeout-ms*})
                [logged id] (git-journal-add m (git-entry args)))
            (assoc (message logged (str verb "…"))
              :git-op-proc job
              :git-op {:verb verb :root root :then then :entry id}))))))

(check-allow :trusted
  (sig git-apply-op (model any -> model))
  (defn git-apply-op (m r)
    "Fold a finished `git-launch-op`: report the outcome and run its `then`. A nil `r` is the
task having errored or timed out — said plainly, rather than reported as a success with an
empty output, which is what a bare exit-code check would do with it."
    (let (op (:git-op m)
          verb (or (:verb op) "git")
          m1 (git-journal-finish (dissoc m :git-op :git-op-proc) (:entry op) r))
      (if (nil? r)
        (message m1
          (str verb
            " failed: no result (timed out after "
            *git-op-timeout-ms*
            "ms)"
            (git-journal-note)))
        (let (m2 (git-report-cmd m1 verb r))
          (if (nil? (:then op)) m2 ((:then op) m2 r)))))))

;; ---- the repo watches itself: a background fetch, and being TOLD ------------
;; Magit shows you the truth as of the last time you asked it to fetch. You find out the
;; remote moved by pressing `f f` and looking — which means in practice you find out when
;; you try to push and are told no.
;;
;; bedit fetches on a timer, in a task, and SAYS SO when the answer changes: "origin/main:
;; 3 new commits (F to pull)". It costs nothing on the loop and it is the difference
;; between a status buffer you interrogate and a repo that tells you about itself. That is
;; the whole "better than magit" claim, and it is only possible because the fetch is a
;; process rather than something you have to stop and wait for.
;;
;; `git fetch` is network and can hang; it rides `task` with the same timeout as a pull,
;; and a fetch already in flight is never started twice.

(def *git-fetch-every-ms* 180000)
;; How often to fetch in the background (3 minutes). Long enough that a laptop on a phone
;; tether is not fetching constantly, short enough that "someone pushed" reaches you while
;; it still matters. `nil` turns the watch off entirely.

(defn git-fetch-key (m)
  "What a background fetch would be ABOUT — the repo root, or nil when there is no repo to
watch. Compared on the reply so an answer about a repo you have since left is dropped."
  (or (:git-root m) (:git-summary-root m) (get-in m [:git-summary :root])))

(defn git-fetch-upstream (root)
  "Fetch quietly and report the upstream's position afterwards: `{:root :upstream :behind
:ahead}`, or nil when there is no upstream to watch. Runs in a task — three subprocesses,
one of them a network round trip."
  (if (nil? root)
    nil
    (let (upstream (git-upstream root))
      (if (nil? upstream)
        nil
        (do
          ;; the fetch itself; its exit code does not matter here — offline just means the
          ;; counts below are unchanged, which is exactly the right thing to report
          (git-git root
            ["fetch" "--quiet"]
            {:env *git-background-env* :timeout-ms *git-op-timeout-ms*})
          (let (ab (git-ahead-behind root))
            {:root root
             :upstream upstream
             :behind (get ab :behind "0")
             :ahead (get ab :ahead "0")}))))))

(defn git-launch-fetch (m)
  "Start the background fetch OFF the loop, unless one is in flight, the watch is off, or
there is no repo. Never runs headless — a test or a daemon has no business reaching the
network on a timer."
  (let (root (git-fetch-key m))
    (cond
      (not (int? *git-fetch-every-ms*)) m ; the watch switched off (set it to nil)
      (:git-fetch-proc m) m
      (nil? root) m
      (model/ed-headless?) m
      :else
        (assoc m
          :git-fetch-proc
            (task (fn () (git-fetch-upstream root))
              {:timeout *git-op-timeout-ms*})))))

(defn git-upstream-news (before after)
  "What to say about the upstream having moved, or nil when there is nothing to say.

Only an INCREASE in `behind` is news. Reporting the count every time would announce the
same three commits every three minutes until you pulled them, which is how a notification
becomes something you learn to ignore."
  (let (was (string/->number (get before :behind "0"))
        now (string/->number (get after :behind "0"))
        was (if (int? was) was 0)
        now (if (int? now) now 0))
    (if (or (<= now 0) (<= now was))
      nil
      (str (:upstream after)
        ": "
        (- now was)
        " new commit"
        (if (= (- now was) 1) "" "s")
        (if (> was 0) (str " (" now " behind)") "")
        " — F to pull"))))

(defn git-apply-fetch (m result)
  "Fold a finished background fetch: free the slot, remember the upstream position, and say
so if the remote moved. An answer about a repo the reader has since left is dropped."
  (let (m1 (dissoc m :git-fetch-proc))
    (cond
      (nil? result) m1
      (not (= (:root result) (git-fetch-key m1))) m1
      :else
        (let (news (git-upstream-news (:git-upstream-seen m1) result)
              m2 (assoc m1 :git-upstream-seen result)
              ;; a moved upstream also makes the *git-status* Unpulled section stale
              m3 (if news (git-refresh-if-open m2 nil) m2))
          (if (nil? news) m3 (message m3 news))))))

(defcommand cmd-git-fetch
  (m key)
  "Fetch from the remote now (f) — off the loop. The background watch does this on a timer;
this is for when you know something landed and do not want to wait for it."
  (if (nil? (git-fetch-key m))
    (message m "not in a git repository")
    (message (git-launch-fetch (dissoc m :git-fetch-proc)) "fetching…")))

(defn- git-late (module sym)
  "The function `sym` of `module`, loading the module first. `gitview` (the log, commit and
diff buffers) and `smerge` `:use` git, so git cannot `:use` them back; and a qualified
reference alone does not load a module in the released editor (the `unbound symbol: term/…`
bug), which is why this asks for it by name."
  (do (require-one module) (reflect/eval sym)))

;; check-allow: the three below call a function `git-late` fetched by name, so the checker
;; cannot see its result; each is the named function's own `model -> model` contract.
(check-allow :trusted
  (sig git-view-revision (model any any &optional keyword -> model))
  (defn- git-view-revision (m root rev &optional (action :pop))
    "`gitview/git-show-revision`: commit `rev` in *git-revision*."
    ((git-late 'gitview 'gitview/git-show-revision) m root rev action)))

(check-allow :trusted
  (sig git-view-diff (model any any any &optional keyword -> model))
  (defn- git-view-diff (m root args lst &optional (action :pop))
    "`gitview/git-show-diff`: `git diff args` in *git-diff*."
    ((git-late 'gitview 'gitview/git-show-diff) m root args lst action)))

(check-allow :trusted
  (sig git-smerge-next (model -> model))
  (defn- git-smerge-next (m)
    "`smerge/cmd-smerge-next`: point to the next conflict marker in the current buffer."
    ((git-late 'smerge 'smerge/cmd-smerge-next) m nil)))

(defn- git-unmark (m)
  "The model with the region dropped — after acting on it, as every region command does."
  (ed-apply m clear-mark))

(defn- git-status-root (m)
  "The repo *git-status* shows, or nil when it is not open."
  (let (i (ed-buffer-index-by-name m "*git-status*"))
    (if (nil? i) nil (get-in (ed-buf-at m i) [:section-ctx :root]))))

(defn- git-in-status? (m)
  "Whether the reader is in *git-status* right now."
  (= (buffer-name (ed-current-buf m)) "*git-status*"))

(defn git-refresh (m)
  "Refresh `*git-status*` — in place, and keeping point in its file list when the reader is
in it (`git-stay-in-section`); behind them, quietly, when they are not."
  (let (root (or (git-status-root m) (:git-root m)))
    (if (nil? root) m (git-show-status m root (if (git-in-status? m) (git-stay-in-section m) nil)))))

(defn- git-refresh-if-open (m _r)
  "Refresh `*git-status*` when it is open — the usual `then` for a `git-launch-op`."
  (if (nil? (git-status-root m)) m (git-refresh m)))

;; ---- commands: open / stage / unstage / discard / visit / refresh / quit ------
;; `s`, `u` and `k` do what Magit's do, by what is at point: a REGION inside one hunk acts
;; on those lines; a hunk on the hunk; a file (its heading or anywhere in its diff when no
;; hunk is under point) on the file; a region over several files on each; a list's heading
;; on the whole list. Which list decides the direction — there is nothing to unstage in
;; `Unstaged changes`, and saying so beats doing nothing.

(defcommand cmd-git-status
  (m key)
  "Open the git status buffer for the current project (C-x g). Files start folded; TAB on
one fetches and shows its hunks."
  (let (root (git-toplevel (commands/ed-default-dir m)))
    (if (nil? root) (message m "not in a git repository") (git-show-status m root nil :here))))

(defn- git-stage-list (m lst)
  "`s` on a list's heading: stage all of it."
  (case lst
    :unstaged (git-do m "stage all" ["add" "-u"])
    :untracked
      (git-do m "stage untracked" (into ["add" "--"] (map (git-list-files m :untracked) :path)))
    :unmerged
      (git-do m "mark resolved" (into ["add" "--"] (map (git-list-files m :unmerged) :path)))
    (message m "already staged")))

(defn- git-file-paths (f)
  "The paths a file value stands for in the index — both halves of a rename."
  (if (:orig-path f) [(:path f) (:orig-path f)] [(:path f)]))

(defcommand cmd-git-stage
  (m key)
  "Stage what is at point (s): the region's lines, the hunk, the file, the files the region
covers, or — on a list's heading — the whole list."
  (let (row (git-row-at m)
        lst (git-list-of row)
        region (git-region-hunk m false)
        files (git-region-files m)
        hunk (git-hunk-at m))
    (cond
      (nil? row) (message m "nothing to stage here")
      (= lst :staged) (message m "already staged")
      (not (nil? region))
        (let ([value patch] region)
          (if (= (:section value) :untracked)
            (git-do m "stage" ["add" "--" (:path value)])
            (git-do-hunk (git-unmark m) "stage lines" patch true false)))
      (not (nil? files)) (git-do (git-unmark m) "stage" (into ["add" "--"] (map files :path)))
      (and (:heading? row) (contains? git-list-sections (:type row))) (git-stage-list m (:type row))
      (and hunk (= (:section hunk) :unstaged))
        (git-do-hunk m "stage hunk" (diff/hunk-patch (:file hunk) (:hunk hunk)) true false)
      (not (nil? (git-file-at m))) (git-do m "stage" ["add" "--" (:path (git-file-at m))])
      :else (message m "nothing to stage here"))))

(defcommand cmd-git-stage-all
  (m key)
  "Stage all tracked modified files (S) — `git add -u`."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do (assoc m :git-root root) "stage all" ["add" "-u"]))))

(defcommand cmd-git-unstage
  (m key)
  "Unstage what is at point (u): the region's lines, the hunk, the file, the files the
region covers, or everything on the `Staged changes` heading."
  (let (row (git-row-at m)
        lst (git-list-of row)
        region (git-region-hunk m true)
        files (git-region-files m)
        hunk (git-hunk-at m))
    (cond
      (nil? row) (message m "nothing to unstage here")
      (not (= lst :staged)) (message m "not staged")
      (not (nil? region)) (git-do-hunk (git-unmark m) "unstage lines" (second region) true true)
      (not (nil? files))
        (git-do (git-unmark m)
          "unstage"
          (git-unstage-args (:git-root m) (mapcat files git-file-paths)))
      (and (:heading? row) (= (:type row) :staged))
        (git-do m "unstage all" (git-unstage-args (:git-root m) ["."]))
      (not (nil? hunk))
        (git-do-hunk m "unstage hunk" (diff/hunk-patch (:file hunk) (:hunk hunk)) true true)
      :else (git-do m "unstage" (git-unstage-args (:git-root m) (git-file-paths (git-file-at m)))))))

(defcommand cmd-git-unstage-all
  (m key)
  "Unstage all staged changes (U)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do (assoc m :git-root root) "unstage all" (git-unstage-args root ["."])))))

(defn- git-discard-file-args (f)
  "The argv that throws away file `f`'s change in its list. A staged NEW file has nothing
in HEAD to go back to, so it is removed; any other staged change is checked out from HEAD
(index and work tree together — from the index alone would keep it); an unstaged one from
the index."
  (case (:section f)
    :staged (if (= (:x f) "A") ["rm" "-f" "--" (:path f)] ["checkout" "HEAD" "--" (:path f)])
    :untracked ["clean" "-f" "--" (:path f)]
    ["checkout" "--" (:path f)]))

(defn- git-discard-list (m lst)
  "`k` on a list's heading: throw the whole list away, after a question that says so."
  (let (files (git-list-files m lst))
    (case lst
      :untracked
        (git-confirm m
          (str "Delete "
            (count files)
            " untracked file"
            (if (= (count files) 1) "" "s")
            "? git has no copy of them.")
          (fn (mm) (git-do mm "clean" (into ["clean" "-f" "--"] (map files :path)))))
      :unstaged
        (git-confirm m
          (str "Discard the unstaged changes to "
            (count files)
            " file"
            (if (= (count files) 1) "" "s")
            "?")
          (fn (mm) (git-do mm "discard" (into ["checkout" "--"] (map files :path)))))
      :staged
        (git-confirm m
          "Discard every staged change, from the index AND the work tree?"
          (fn (mm)
            (fold files mm (fn (a f) (git-do a "discard" (git-discard-file-args f))))))
      (message m "resolve conflicts one file at a time: k on the file, or e to edit it"))))

(defcommand cmd-git-discard
  (m key)
  "Throw away what is at point (k), after a question naming it: the region's lines, the
hunk, the file (an untracked one is deleted — git has no copy), a list, or a stash."
  (let (row (git-row-at m)
        lst (git-list-of row)
        hunk (git-hunk-at m)
        ;; a staged change goes from the index and the work tree at once (`--index`):
        ;; reversing it in the work tree alone left it staged
        target (if (= lst :staged) :index false)
        region (git-region-hunk m true))
    (cond
      (nil? row) m
      (= (:type row) :stash) (git-stash-drop-ref m (:ref (:value row)))
      (nil? lst) m
      (= lst :unmerged)
        (ed-read-char m
          (str "Resolve "
            (:path (git-file-at m))
            " by keeping [o]urs or [t]heirs? (e edits it instead) ")
          (fn (mm c)
            (case c
              "o" (git-resolve-with mm "ours")
              "t" (git-resolve-with mm "theirs")
              (message mm "cancelled"))))
      (not (nil? region))
        (git-confirm m
          "Discard the selected lines?"
          (fn (mm) (git-do-hunk (git-unmark mm) "discard lines" (second region) target true)))
      (and (:heading? row) (contains? git-list-sections (:type row)))
        (git-discard-list m (:type row))
      (and hunk (not (= lst :untracked)))
        (git-confirm m
          "Discard this hunk?"
          (fn (mm)
            (git-do-hunk mm "discard hunk" (diff/hunk-patch (:file hunk) (:hunk hunk)) target true)))
      :else
        (let (f (git-file-at m))
          (if (= (:section f) :untracked)
            (git-remove-untracked m (:path f))
            (git-confirm m
              (str "Discard changes to " (:path f) "?")
              (fn (mm) (git-do mm "discard" (git-discard-file-args f)))))))))

(defcommand cmd-git-refresh
  (m key)
  "Refresh (g): the git view you are in (a log, a commit, a diff) and the status buffer."
  (git-refresh (git-reload-view m)))

(defn git-status-reload (m)
  "The status buffer's `:section-reload`: TAB opened a file whose diff was never fetched,
so fetch it — a refresh, with the visibility TAB just set."
  (git-refresh m))

(defn- git-hunk-line-at (m hunk)
  "The line of the NEW file that point is on inside `hunk` — the heading goes to the hunk's
first line, a body line to its own."
  (let (row (git-row-at m))
    (if (and row (not (:heading? row)) (int? (:line row)))
      (diff/hunk-new-line (:hunk hunk) (:line row))
      (:new-start (:hunk hunk) 1))))

(defn git-visit-location (m root)
  "The file and line to jump to from point in a git section buffer, `{:file :line}`, or nil
— a diff line to the line it became, a hunk to its first line, a file to its top."
  (let (hunk (git-hunk-at m)
        f (git-file-at m))
    (cond
      (not (nil? hunk)) {:file (path/join root (:path hunk)) :line (git-hunk-line-at m hunk)}
      (not (nil? f)) {:file (path/join root (:path f)) :line 1}
      :else nil)))

(defcommand cmd-git-visit
  (m key)
  "Visit what is at point (RET): a diff line opens its file AT that line, a file opens the
file, a commit or a stash opens it in a commit buffer. The file opens in another pane and
the status stays where it is — next-error's discipline, shared with *Tests*."
  (let (row (git-row-at m)
        root (git-resolve-root m)
        loc (if (nil? root) nil (git-visit-location m root)))
    (cond
      (nil? row) m
      (= (:type row) :commit) (git-view-revision m root (:hash (:value row)))
      (= (:type row) :stash) (git-view-revision m root (:ref (:value row)))
      (= (:type row) :branch) (git-view-revision m root (:name (:value row)))
      (not (nil? loc)) (commands/ed-pop-to-file m (:file loc) (:line loc))
      :else (sectionbuf/sb-toggle m))))

(defcommand cmd-git-quit
  (m key)
  "Bury the git buffer (q)."
  (cmd-kill-buffer m key))

;; ---- the journal: what git actually ran (`$`) ---------------------------------
;; Magit's `$` (`magit-process-buffer`): every git invocation, its exit code and its
;; output, newest last — the answer to "what did it actually run" and to "it failed and
;; the echo area only gave me one line of it".
;;
;; Called the JOURNAL and not the process log because this file already has three `proc`s
;; that are handles to running things (`:git-proc`, `:git-op-proc`, `:git-fetch-proc`),
;; and a `:git-process` four characters away from `:git-proc` meaning a list of past
;; commands is a misreading waiting to happen. The BUFFER is still `*git-process*`: that
;; is the name a Magit user is looking for.
;;
;; It lives on the MODEL rather than in a shared table because every command worth
;; recording already threads the model — the synchronous ones through `git-run`, the
;; network ones through `git-launch-op` (recorded when they START, so an in-flight pull
;; reads `run`) and `git-apply-op` (completed when they land). A read-only command a
;; renderer runs to draw a diff is not in here; Magit logs those too and they are mostly
;; noise.
;;
;; Four things this does that Magit does not:
;;   - a DURATION per entry (Magit has an optional timestamp, off by default), which is
;;     what you actually want to know when a push feels slow;
;;   - `\r` progress applied properly — `git push`'s "Writing objects: 47%" rewrites its
;;     line, so the entry holds the line it ended on rather than forty of them. Magit
;;     does this by hand in its process filter (find the last ^M, delete the line); bedit
;;     has `ansi/render`, a real terminal, from the terminal buffer (brood ADR-384);
;;   - credentials in a remote URL are REDACTED, because a journal gets pasted into bug
;;     reports;
;;   - the NUL a `-z` command separates its paths with is shown as `^@` rather than
;;     written into the rope. Emacs shows those raw.

(def *git-journal-max* 64) ; entries kept; the oldest go first, never one still running
;; ---- an entry ----------------------------------------------------------------
;; `{:id :verb :args :exit :ms :output :running? :at}` — one map, built in ONE place, so
;; the three producers (a synchronous run, a hunk apply, a launched network op) cannot
;; drift into three shapes.

(defn- git-redact (s)
  "`s` with the credentials in its URLs replaced by `***`: the password of a
`user:secret@`, and the whole user part of an `http(s)://token@` — a personal access
token is sent as the USERNAME (`https://ghp_…@github.com`), so hiding only what follows a
colon left the token itself in the log. An ssh `git@host` names an account, not a
secret, and stays."
  (regex/replace "(https?://)[^/@:\\s]+@"
    (regex/replace "://([^/@:\\s]+):[^/@\\s]+@" s "://$1:***@")
    "$1***@"))

(defn- git-printable (s)
  "`s` made fit to put in a rope: `\\r` progress and escape sequences APPLIED (so
\"Writing objects: 47%\" is the line it ended on, not forty lines), the NUL a `-z`
command separates paths with shown as `^@`, and credentials redacted."
  (let (rendered (if (or (includes? s "\r") (includes? s "\e")) (ansi/render "" s) s))
    (git-redact (string/trimr (string/replace rendered (string/int->char 0) "^@")))))

(defn- git-entry-output (r)
  "The output an entry shows: stderr then stdout — git says the interesting thing on
stderr — or what a task that never answered leaves behind."
  (if (nil? r)
    "no result (timed out)"
    (git-printable (str (:stderr r "") (:stdout r "")))))

(defn- git-entry (args)
  "A journal entry for `git args`, as it reads while it is still running. No `verb`: the
label a command puts in the echo area (`stage hunk`) is the echo's business, and an entry
that carried both could disagree with the command line — which is the one thing this
buffer exists to be right about."
  {:args (into [] args) :running? true :at (os/now)})

(defn- git-entry-done (e r)
  "Entry `e` completed by result `r` (nil = the task never answered), timed from its
own `:at` — the entry knows when it started, so nothing else has to carry that."
  (assoc e
    :running? false
    :ms (- (os/now) (or (:at e) (os/now)))
    :exit (if (nil? r) nil (:exit r))
    :output (git-entry-output r)))

;; ---- the log ------------------------------------------------------------------
;; The buffer is a VIEW of the log, not a copy of it: every write re-renders it in place
;; (`ed-upsert-named` — no pane, no selection touched) when it happens to be open, so a
;; `pull` you are watching completes in front of you rather than when you next press `g`.
;; Nothing happens at all when it is closed, which is the usual case.

;; check-allow: `:git-journal` is the log this file owns and only ever writes as a
;; vector; the model record does not declare it, so `or` reads as every value a map
;; key could hold.
(check-allow :trusted
  (sig git-journal (model -> vector))
  (defn git-journal (m)
    "The git journal, oldest first."
    (or (:git-journal m) [])))

(defn- git-journal-sync (m)
  "Re-render *git-process* in place when it is open; the model unchanged when it is not."
  (if (nil? (ed-buffer-index-by-name m "*git-process*"))
    m
    (commands/ed-upsert-named m "*git-process*" (git-journal-text m) :git-process)))

(defn- git-journal-trim (entries)
  "`entries` cut to `*git-journal-max*`, dropping the oldest — but never one still
running, whose output has not arrived yet."
  (let (n (count entries))
    (if (<= n *git-journal-max*)
      entries
      (into []
        (append (seq/filter (seq/subvec entries 0 (- n *git-journal-max*)) :running?)
          (seq/subvec entries (- n *git-journal-max*)))))))

(defn- git-journal-add (m entry)
  "`[model' id]`: the model with `entry` appended under a fresh id, the log trimmed and
the buffer re-rendered if it is open."
  (let (id (or (:git-journal-seq m) 1))
    [(git-journal-sync (assoc m
                         :git-journal
                           (git-journal-trim (into (git-journal m) [(assoc entry :id id)]))
                         :git-journal-seq (inc id)))
      id]))

(defn- git-journal-finish (m id r)
  "The model with running entry `id` completed by result `r` — unchanged when that entry
has already been trimmed away. Re-renders the buffer if it is open, so a `pull` you are
watching stops reading `run` the moment it lands."
  (git-journal-sync (assoc m
                      :git-journal
                        (into []
                          (map (git-journal m) (fn (e) (if (= (:id e) id) (git-entry-done e r) e)))))))

(defn git-journal-note ()
  "The hint appended to a failed command's message: how to see the whole output. Magit
appends the same thing, for the same reason — the echo area shows one line, and nobody
guesses that a key exists to show the rest. Nothing to point at when there is no UI."
  (if (ed-headless?) "" " ($ for the full output)"))

;; ---- running a git command, journalled -----------------------------------------
;; One seam: `git-journal-run` takes what to RECORD and a thunk that runs it, so a
;; command cannot be run without being recorded, and the two runners below differ only
;; in how they invoke git.

(check-allow :trusted
  (sig git-journal-run (model seqable fn -> vector))
  (defn- git-journal-run (m args run)
    "`[model' result]`: record `git args` as started, call `run`, complete the entry."
    (let ([m1 id] (git-journal-add m (git-entry args))
          r (run))
      [(git-journal-finish m1 id r) r])))

(sig git-run (model seqable -> vector))
(defn git-run (m args)
  "Run `git args` in the repo root, journalled: `[model' result]`. The seam every
model-threaded git command goes through, so the journal cannot disagree with what ran."
  (git-journal-run m args (fn () (git-git (:git-root m) args))))

(sig git-run-hunk (model string (or bool keyword) bool -> vector))
(defn git-run-hunk (m patch cached? reverse?)
  "[[git-run]] for the hunk path: the patch goes to `git apply` over stdin, so the entry
names the arguments rather than the patch — which is in the diff above it anyway."
  (git-journal-run m
    (append ["apply"]
      (cond (= cached? :index) ["--index"] cached? ["--cached"] :else [])
      (if reverse? ["--reverse"] [])
      ["-"])
    (fn () (git-apply-hunk (:git-root m) patch cached? reverse?))))

;; ---- rendering the buffer ------------------------------------------------------
;; A heading starts at column 0 and its exit code is right-aligned in three columns; every
;; line of output is indented FOUR, which is one more than the widest heading prefix can
;; be. That is what lets the `:fontify` — which sees text and nothing else — tell the two
;; apart by looking at the line alone: an output line that happens to read `0 …` cannot be
;; mistaken for a command that exited 0. It also lines the output up under the command.

(def- git-output-indent "    ")

(def- git-global-flags
  ;; bedit's own arguments, before the subcommand, on every call and typed by nobody:
  ;; elided. Magit collapses the same thing to `…` with the full text in a tooltip.
  #{"-C" "-c"})

(defn- git-command-text (args)
  "The command line as the user means it: `git` plus `args`, less bedit's own flags."
  (letrec (strip (fn (a)
                   (if (and (> (count a) 1) (contains? git-global-flags (first a)))
                     (strip (drop a 2))
                     a)))
    (git-redact (string/join (into ["git"] (strip (into [] args))) " "))))

(defn git-journal-heading (e)
  "One entry's heading: the exit code (Magit's right-aligned three columns, `run` while
in flight), the command, and how long it took."
  ;; `(or …)` and not a `get` default: a timed-out entry HAS an `:exit`, whose value is
  ;; nil, so a default would never be reached — and 0 is truthy in Brood, so an exit of 0
  ;; still reads as itself
  (str (if (:running? e) "run " (str (string/pad-left (str (or (:exit e) "?")) 3) " "))
    (git-command-text (:args e))
    (if (:running? e) "" (str "  (" (humanize/duration (:ms e 0)) ")"))))

(defn- git-journal-block (e)
  "An entry as text: its heading, then its output indented under it."
  (let (out (:output e ""))
    (if (= out "")
      (git-journal-heading e)
      (str (git-journal-heading e)
        "\n"
        (string/join (map (string/split out "\n") (fn (l) (str git-output-indent l))) "\n")))))

(defn git-journal-text (m)
  "The whole journal as the buffer shows it: one block per entry, oldest first."
  (let (entries (git-journal m))
    (if (empty? entries)
      "(no git commands yet)"
      (string/join (map entries git-journal-block) "\n"))))

(defn git-process-fontify (src)
  "The *git-process* `:fontify`: a heading reads by its exit code — green for 0, red for
anything else, blue while it runs — and the output indented under it is plain."
  (git-fontify-lines (string/split src "\n")
    0
    (fn (line off)
      (cond
        (string/starts-with? line "run ") (git-whole-line off line git-face-hunk)
        (string/starts-with? line git-output-indent) '()
        (string/starts-with? line "  0 ") (git-whole-line off line git-face-add)
        :else (git-whole-line off line git-face-del)))
    '()))

(defcommand cmd-git-process
  (m key)
  "Show what git actually ran (`$`, Magit's `magit-process-buffer`): every command this
editor issued, with its exit code, how long it took and its output — the whole of it,
where the echo area could only show the first line. `g` refreshes, `k` clears, `q` quits."
  (git-show-report m "*git-process*" (git-journal-text m) :git-process {:action :pop}))

(defcommand cmd-git-process-clear
  (m key)
  "Clear the process log (k in *git-process*)."
  (let (m1 (dissoc m :git-journal))
    (git-show-report m1 "*git-process*" (git-journal-text m1) :git-process {:action :here})))

;; ---- a read-only report buffer (diff / log) ---------------------------------

(defn git-show-report (m name text type &optional (opts {:action :here}))
  "Show `text` in a read-only report buffer `name` of `type` (e.g. *git-diff*, *git-log*),
point at the top. `opts` routes through `ed-display-buffer` (default `{:action :here}` — replace
the current pane); pass `{:action :pop}` to open it in another pane and jump there. Keeps
`:git-root` for follow-up commands."
  (ed-apply (commands/ed-display-buffer m name (if (= text "") "(empty)" text) type opts)
    (fn (b) (commands/ed-goto-line b 1))))

(defn git-report-cmd (m verb r)
  "Echo the result of a git command `r` (`verb` names it), preferring stderr then stdout;
falls back to the exit code when both streams are empty. A FAILURE says where the rest of
the output is: the echo area holds one line, and nobody guesses that a key shows the whole
of it (Magit appends the same hint, for the same reason)."
  (let (e (string/trim (:stderr r ""))
        raw (if (= e "") (string/trim (:stdout r "")) e)
        failed? (not (= (:exit r) 0))
        out (one-line (if (= raw "") (str "exit " (:exit r)) raw)))
    (message m
      (str verb (if failed? " failed: " ": ") out (if failed? (git-journal-note) "")))))

(defn git-do (m verb args)
  "Run `git args` (logged), then refresh the status buffer on success -- else report what
went wrong. The shape every working-tree action has: eight sites spelled the run, the log
and the refresh separately, and the one that must not be got wrong is refreshing after a
command that FAILED."
  (let ([m1 r] (git-run (assoc m :git-root (git-resolve-root m)) args)) (git-refreshed m1 verb r)))

(defn git-do-hunk (m verb patch cached? reverse?)
  "[[git-do]] for a hunk: `git apply` over stdin, logged, then the same refresh."
  (let ([m1 r] (git-run-hunk (assoc m :git-root (git-resolve-root m)) patch cached? reverse?))
    (git-refreshed m1 verb r)))

(defn- git-refreshed (m verb r)
  "The outcome of a working-tree-changing git command `r`: re-read the status buffer when it
succeeded, else say what went wrong (`git-report-cmd`, `verb` naming it). Every stage /
unstage / discard action ends this way — eight sites spelled the same three lines, and the
one thing they must not get wrong is refreshing after a command that FAILED, which is what
having it in one place makes impossible."
  (if (= (:exit r) 0) (git-refresh (git-reload-view m)) (git-report-cmd m verb r)))

(defn git-reload-view (m)
  "Re-run the git view the reader is in (a diff, a commit) when it has a `:reload` — so
staging a hunk from *git-diff* takes it out of *git-diff*, not only out of the status."
  (let (reload (get (sectionbuf/sb-ctx m) :reload))
    (if (nil? reload) m ((reflect/eval reload) m))))

;; ---- the push / pull MENUS (Magit's `P` and `F`) -----------------------------
;; The reason a transient exists at all: `--force-with-lease` has nowhere to live in a
;; keymap, so before this it could not be typed. A spec is plain data — adding a flag is a
;; row, not code — and the commands below splice `transient/ed-transient-args` into their
;; argv, so each one behaves identically whether it was reached from the menu, from `P`,
;; or from `M-x`.
;;
;; `--force-with-lease` and not `--force`: the lease is the one that refuses when the
;; remote moved under you, which is the difference between overwriting your own rewritten
;; history and overwriting a colleague's push. Magit puts `--force` in its menu too; we
;; leave it out, because the menu is also a recommendation.
;;
;; WHERE to push is Magit's split: `p` to where this branch pushes (its push remote, else
;; its upstream), `u` to its upstream, `e` elsewhere, `o` another branch, `t` / `T` tags. A
;; branch with nowhere to go is ASKED where, and remembers the answer (`--set-upstream`):
;; the first push of a new branch used to answer "has no upstream branch" and stop.

(def git-push-transient
  {:name 'git-push
   :title "Push"
   :groups [{:title "Arguments"
             :suffixes [{:key "-f"
                         :kind :switch
                         :arg "--force-with-lease"
                         :label "refuses if the remote moved"}
                         {:key "-n"
                          :kind :switch
                          :arg "--dry-run"
                          :label "show what would be pushed"}
                         {:key "-h"
                          :kind :switch
                          :arg "--no-verify"
                          :label "skip the pre-push hook"}
                         {:key "-u"
                          :kind :switch
                          :arg "--set-upstream"
                          :label "set the upstream"}]}
             {:title "Push the current branch to"
              :suffixes [{:key "p"
                          :kind :command
                          :command 'git/cmd-git-push
                          :label "where it pushes"}
                          {:key "u"
                           :kind :command
                           :command 'git/cmd-git-push-upstream
                           :label "its upstream"}
                          {:key "e"
                           :kind :command
                           :command 'git/cmd-git-push-elsewhere
                           :label "elsewhere"}]}
             {:title "Push"
              :suffixes [{:key "o"
                          :kind :command
                          :command 'git/cmd-git-push-other
                          :label "another branch"}
                          {:key "t"
                           :kind :command
                           :command 'git/cmd-git-push-tags
                           :label "all tags"}
                          {:key "T" :kind :command :command 'git/cmd-git-push-tag :label "a tag"}]}]})

(def git-pull-transient
  {:name 'git-pull
   :title "Pull"
   :groups [{:title "Arguments"
             :suffixes [{:key "-r" :kind :switch :arg "--rebase" :label "rebase instead of merging"}
                         {:key "-f" :kind :switch :arg "--ff-only" :label "fast-forward only"}
                         {:key "-a"
                          :kind :switch
                          :arg "--autostash"
                          :label "autostash local changes"}]}
             {:title "Pull into the current branch from"
              :suffixes [{:key "F" :kind :command :command 'git/cmd-git-pull :label "its upstream"}
                          {:key "u" :kind :command :command 'git/cmd-git-pull :label "its upstream"}
                          {:key "e"
                           :kind :command
                           :command 'git/cmd-git-pull-elsewhere
                           :label "elsewhere"}]}]})

(defcommand cmd-git-push-menu
  (m key)
  "The push menu (P): the flags, then where to. It reopens with the arguments you used
last time."
  (transient/ed-transient-open m git-push-transient))

(defcommand cmd-git-pull-menu
  (m key)
  "The pull menu (F): `--rebase` / `--ff-only` / `--autostash`, then from where."
  (transient/ed-transient-open m git-pull-transient))

(defn git-remotes (root)
  "The repo's remote names, `origin` first when there is one."
  (let (names (seq/reject (string/split (string/trim (:stdout (git-git root ["remote"]) "")) "\n")
                empty?))
    (git-first (if (includes? names "origin") "origin" nil) names)))

(defn- git-current-branch (root)
  "The checked-out branch's name, or nil when HEAD is detached."
  (let (r (git-git root ["symbolic-ref" "--short" "-q" "HEAD"]))
    (if (= (:exit r) 0) (string/trim (:stdout r "")) nil)))

(defn- git-with-remote (m prompt then)
  "Prompt for one of the repo's remotes (`origin` first) and hand it to `then`."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (names (git-remotes root))
        (if (empty? names)
          (message m "this repository has no remotes — M a adds one")
          (assoc m
            :minibuffer
              (commands/ed-name-prompt prompt
                names
                (fn (mm r)
                  (if (string/blank? r) (message mm "no remote chosen") (then mm (string/trim r)))))))))))

(defn- git-push-to (m args remote refspec)
  "Push `refspec` to `remote` with the menu's `args`, off the loop."
  (git-launch-op m "push" (append ["push"] args [remote refspec]) git-refresh-if-open))

(defn- git-push-first (m args branch)
  "A branch with nowhere to push: ask which remote, push it there under its own name, and
remember that as its upstream."
  (git-with-remote m
    (str "Push " branch " to remote (and set it as upstream): ")
    (fn (mm remote)
      (git-push-to mm
        (append (seq/reject args (fn (a) (= a "--set-upstream"))) ["--set-upstream"])
        remote
        branch))))

(defcommand cmd-git-push
  (m key)
  "Push the current branch to where it pushes (P p) — its push remote, else its upstream —
off the loop, so the editor stays live while the remote thinks about it. A branch with
neither is asked where to go, and remembers it."
  (let (root (git-resolve-root m)
        args (transient/ed-transient-args m)
        branch (if (nil? root) nil (git-current-branch root)))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? branch)
        (message m "HEAD is detached — there is no branch to push (P o pushes a branch)")
      (and (nil? (git-push-target root)) (nil? (git-upstream root))) (git-push-first m args branch)
      :else (git-launch-op m "push" (into ["push"] args) git-refresh-if-open))))

(defn- git-split-remote-branch (root ref)
  "`[remote branch]` for a remote-tracking ref like `origin/feature/x`, when it names one
of the repo's remotes; else nil."
  (let (remote (seq/find (git-remotes root) (fn (r) (string/starts-with? ref (str r "/")))))
    (if (nil? remote)
      nil
      [remote (string/substring ref (inc (string/length remote)) (string/length ref))])))

(defcommand cmd-git-push-upstream
  (m key)
  "Push the current branch to its upstream (P u), asking for one when it has none."
  (let (root (git-resolve-root m)
        args (transient/ed-transient-args m)
        branch (if (nil? root) nil (git-current-branch root))
        up (if (nil? root) nil (git-upstream root))
        split (if (nil? up) nil (git-split-remote-branch root up)))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? branch) (message m "HEAD is detached — there is no branch to push")
      (nil? split) (git-push-first m args branch)
      :else (git-push-to m args (first split) (str "HEAD:" (second split))))))

(defcommand cmd-git-push-elsewhere
  (m key)
  "Push the current branch to a remote branch you pick (P e) — `origin/other` pushes HEAD
there."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Push HEAD to: "
      :remote (fn (mm ref)
        (let (split (git-split-remote-branch (git-resolve-root mm) ref))
          (if (nil? split)
            (message mm (str ref " is not a remote branch — spell it remote/branch"))
            (git-push-to mm args (first split) (str "HEAD:" (second split)))))))))

(defcommand cmd-git-push-other
  (m key)
  "Push a local branch you pick to a remote (P o), under its own name."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Push branch: "
      :local (fn (mm branch)
        (git-with-remote mm
          (str "Push " branch " to remote: ")
          (fn (m2 remote) (git-push-to m2 args remote branch)))))))

(defcommand cmd-git-push-tags
  (m key)
  "Push every tag to a remote (P t)."
  (let (args (transient/ed-transient-args m))
    (git-with-remote m
      "Push all tags to: "
      (fn (mm remote)
        (git-launch-op mm
          "push --tags"
          (append ["push"] args [remote "--tags"])
          git-refresh-if-open)))))

(defcommand cmd-git-push-tag
  (m key)
  "Push one tag to a remote (P T)."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Push tag: "
      :tags (fn (mm tag)
        (git-with-remote mm
          (str "Push " tag " to: ")
          (fn (m2 remote) (git-push-to m2 args remote tag)))))))

(defcommand cmd-git-pull
  (m key)
  "Pull the current branch from its upstream, then refresh status (F F) — off the loop.

This is the command that froze the editor: a pull is a NETWORK round trip, and it ran on
the dispatch path, so the window stopped repainting until the remote answered. It now runs
in a task like everything else that can outlast a frame.

`--ff-only` unless the menu said otherwise: a pull that silently makes a merge commit is
how an accidental merge of `main` into `main` happens, and `--rebase` from the menu is the
other answer. Both are refusals to guess."
  (let (args (transient/ed-transient-args m))
    (git-launch-op m
      "pull"
      (into ["pull"] (if (empty? args) ["--ff-only"] args))
      git-refresh-if-open)))

(defcommand cmd-git-pull-elsewhere
  (m key)
  "Pull a remote branch you pick into the current one (F e)."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Pull from: "
      :remote (fn (mm ref)
        (let (split (git-split-remote-branch (git-resolve-root mm) ref))
          (if (nil? split)
            (message mm (str ref " is not a remote branch — spell it remote/branch"))
            (git-launch-op mm
              "pull"
              (append ["pull"] (if (empty? args) ["--ff-only"] args) split)
              git-refresh-if-open)))))))

;; ---- stash (z) ---------------------------------------------------------------
;; A stash is something you act on in place: `a` / `A` / `k` on a stash in *git-status*,
;; or `z a` / `z p` / `z k` from anywhere, which offer the stash at point first and the
;; newest otherwise — the old `z p` could only ever pop the newest.

(defcommand cmd-git-stash
  (m key)
  "Stash working-tree changes (z z) — `git stash push`, with the stash menu's arguments
(`--include-untracked`, `--keep-index`). Refreshes status on success."
  (git-act m "stash" (append ["stash" "push"] (transient/ed-transient-args m))))

(defcommand cmd-git-stash-index
  (m key)
  "Stash only what is staged (z i), leaving the rest of the work tree alone."
  (git-act m "stash --staged" (append ["stash" "push" "--staged"] (transient/ed-transient-args m))))

(defcommand cmd-git-stash-worktree
  (m key)
  "Stash only what is NOT staged (z w): the index is kept, and so is the work tree's copy of it."
  (git-act m
    "stash --keep-index"
    (append ["stash" "push" "--keep-index"] (transient/ed-transient-args m))))

(defn- git-stash-at-point (m)
  "The stash ref at point (`stash@{2}`), or nil."
  (let (row (git-row-at m))
    (if (and row (= (:type row) :stash)) (:ref (:value row)) nil)))

(defn- git-with-stash (m prompt then)
  "Prompt for a stash — the one at point first, else the newest — and hand its ref to `then`."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (refs (map (git-stashes root) :hash))
        (if (empty? refs)
          (message m "there are no stashes")
          (assoc m
            :minibuffer
              (commands/ed-name-prompt prompt
                (git-first (git-stash-at-point m) refs)
                (fn (mm ref)
                  (if (string/blank? ref)
                    (message mm "no stash chosen")
                    (then mm (string/trim ref)))))))))))

(defcommand cmd-git-stash-apply
  (m key)
  "Apply a stash, keeping it (z a, or a on a stash)."
  (git-with-stash m "Apply stash: " (fn (mm ref) (git-act mm "stash apply" ["stash" "apply" ref]))))

(defcommand cmd-git-stash-pop
  (m key)
  "Apply a stash and drop it (z p, or A on a stash)."
  (git-with-stash m "Pop stash: " (fn (mm ref) (git-act mm "stash pop" ["stash" "pop" ref]))))

(defn- git-stash-drop-ref (m ref)
  "Drop stash `ref` after a question — a dropped stash is only in the reflog's reach."
  (git-confirm m
    (str "Drop " ref "? It cannot be recovered from here.")
    (fn (mm) (git-act mm "stash drop" ["stash" "drop" ref]))))

(defcommand cmd-git-stash-drop
  (m key)
  "Drop a stash (z k, or k on a stash), after a question."
  (git-with-stash m "Drop stash: " git-stash-drop-ref))

(defcommand cmd-git-stash-show
  (m key)
  "Show a stash's change as a commit (z v, or RET on a stash)."
  (git-with-stash m "Show stash: " (fn (mm ref) (git-view-revision mm (git-resolve-root mm) ref))))

(defcommand cmd-git-stash-branch
  (m key)
  "Make a branch from a stash (z b): check out the commit it was made on, apply it there,
and drop it — the way back when a stash no longer applies where you are."
  (git-with-stash m
    "Branch from stash: "
    (fn (mm ref)
      (assoc mm
        :minibuffer
          (commands/ed-name-prompt "New branch name: "
            '()
            (fn (m2 name)
              (if (string/blank? name)
                (message m2 "a branch needs a name")
                (git-act m2 "stash branch" ["stash" "branch" (string/trim name) ref]))))))))

;; ---- branches (b) ------------------------------------------------------------
;; Magit's branch menu, less the configuration sub-menu: check out (a REMOTE branch is
;; checked out as a local branch tracking it — checking out `origin/x` detached HEAD before),
;; create from a starting point, spin off, rename, set the upstream, reset, delete.

(defn- git-local-branch? (root name)
  "Whether `name` is a local branch."
  (= 0 (:exit (git-git root ["show-ref" "--verify" "--quiet" (str "refs/heads/" name)]))))

(defn git-checkout-args (root ref)
  "The argv that checks out `ref`: a local branch as it is; a remote branch as the local
branch of the same name — made to track it when there is none yet; anything else (a tag, a
hash) as it is, which detaches HEAD, as asked."
  (let (split (git-split-remote-branch root ref))
    (cond
      (nil? split) ["checkout" ref]
      (git-local-branch? root (second split)) ["checkout" (second split)]
      :else ["checkout" "--track" ref])))

(defcommand cmd-git-checkout
  (m key)
  "Check out a branch (b b) — the one at point first. A remote branch becomes a local one
tracking it."
  (git-with-ref m
    "Checkout: "
    :branches (fn (mm ref) (git-act mm "checkout" (git-checkout-args (git-resolve-root mm) ref)))))

(defcommand cmd-git-checkout-local
  (m key)
  "Check out a remote branch as a local branch tracking it (b l)."
  (git-with-ref m
    "Checkout remote branch as local: "
    :remote (fn (mm ref) (git-act mm "checkout" (git-checkout-args (git-resolve-root mm) ref)))))

(defn- git-with-start (m prompt then)
  "Prompt for a starting point — the commit or ref at point first, else the current branch."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (here (or (git-commit-at-point m) (git-current-branch root) "HEAD"))
        (assoc m
          :minibuffer
            (commands/ed-name-prompt prompt
              (git-first here (git-refs root :branches))
              (fn (mm ref) (then mm (if (string/blank? ref) here (string/trim ref))))))))))

(defn- git-with-name (m prompt then)
  "Prompt for a new name and hand it to `then`, refusing an empty one."
  (assoc m
    :minibuffer
      (commands/ed-name-prompt prompt
        '()
        (fn (mm name)
          (if (string/blank? name) (message mm "a name is needed") (then mm (string/trim name)))))))

(defcommand cmd-git-create-branch
  (m key)
  "Create a branch and check it out (b c): its name, then where it starts."
  (git-with-name m
    "New branch: "
    (fn (mm name)
      (git-with-start mm
        (str "Start " name " at: ")
        (fn (m2 start) (git-act m2 "checkout -b" ["checkout" "-b" name start]))))))

(defcommand cmd-git-branch-create-only
  (m key)
  "Create a branch without checking it out (b n)."
  (git-with-name m
    "New branch: "
    (fn (mm name)
      (git-with-start mm
        (str "Start " name " at: ")
        (fn (m2 start) (git-act m2 "branch" ["branch" name start]))))))

(defcommand cmd-git-branch-spinoff
  (m key)
  "Spin off a branch (b s): move the current branch's unpushed commits onto a new branch
and put the current one back where its upstream is — for when you started work on `main`
that should have been a branch."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (old (git-current-branch root)
            up (git-upstream root))
        (git-with-name m
          "Spin off to new branch: "
          (fn (mm name)
            (let ([m1 r] (git-run (assoc mm :git-root root) ["checkout" "-b" name]))
              (cond
                (not (= (:exit r) 0)) (git-report-cmd m1 "checkout -b" r)
                (or (nil? old) (nil? up)) (git-refresh m1)
                :else (git-act m1 "branch -f" ["branch" "-f" old up])))))))))

(defcommand cmd-git-branch-rename
  (m key)
  "Rename a branch (b m) — the one at point, or the current one."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (old (or (git-ref-at-point m) (git-current-branch root)))
        (git-with-name m
          (str "Rename " old " to: ")
          (fn (mm name) (git-act mm "branch -m" ["branch" "-m" old name])))))))

(defcommand cmd-git-branch-upstream
  (m key)
  "Set the current branch's upstream (b u) to a remote branch you pick."
  (git-with-ref m
    "Upstream: "
    :branches (fn (mm ref) (git-act mm "branch --set-upstream-to" ["branch" (str "--set-upstream-to=" ref)]))))

(defcommand cmd-git-branch-reset
  (m key)
  "Point a branch at another commit (b x). The current branch is reset --hard, after a
question that says what goes; any other is moved with `branch -f`."
  (let (root (git-resolve-root m))
    (git-with-ref m
      "Reset branch: "
      :local (fn (mm branch)
        (git-with-start mm
          (str "Reset " branch " to: ")
          (fn (m2 target)
            (if (= branch (git-current-branch root))
              (git-confirm m2
                (str "Reset " branch " --hard to " target ", losing every uncommitted change?")
                (fn (m3) (git-act m3 "reset --hard" ["reset" "--hard" target])))
              (git-act m2 "branch -f" ["branch" "-f" branch target]))))))))

(defcommand cmd-git-branch-delete
  (m key)
  "Delete a branch (b k) — the one at point first. A local branch goes with `-d`, which
refuses one whose commits are merged nowhere; that refusal is then offered as a question,
naming the loss. A remote branch is deleted ON the remote, after a question."
  (let (root (git-resolve-root m))
    (git-with-ref m
      "Delete branch: "
      :branches (fn (mm ref)
        (let (split (git-split-remote-branch root ref))
          (if (and split (not (git-local-branch? root ref)))
            (git-confirm mm
              (str "Delete " (second split) " on " (first split) "?")
              (fn (m2)
                (git-launch-op m2
                  "push --delete"
                  ["push" (first split) "--delete" (second split)]
                  git-refresh-if-open)))
            (let ([m1 r] (git-run (assoc mm :git-root root) ["branch" "-d" ref]))
              (cond
                (= (:exit r) 0) (git-refresh (message m1 (str "deleted " ref)))
                (includes? (:stderr r "") "not fully merged")
                  (git-confirm m1
                    (str ref " has commits merged nowhere else. Delete it anyway, losing them?")
                    (fn (m2) (git-act m2 "branch -D" ["branch" "-D" ref])))
                :else (git-report-cmd m1 "branch -d" r)))))))))

;; ---- commit (an editable message buffer; C-c C-c / C-c C-k) -----------------
;; The message buffer is where the commit is decided, so it shows what is being committed:
;; the staged diff opens beside it. The commit itself runs OFF the loop — a pre-commit hook
;; can take as long as a test suite, and it used to freeze the editor for all of it — and a
;; commit that fails keeps its message: `c c` again starts from the draft, not from nothing.
;; M-p / M-n in the buffer walk the messages you committed before (Magit's message ring).

(def *git-message-ring-max* 32)

(defn- git-commit-message (text)
  "The commit message from the *git-commit* buffer text — comment lines (leading `#`) dropped
and the rest trimmed."
  (string/trim (string/join (seq/reject (string/split text "\n")
                              (fn (l) (string/starts-with? (string/triml l) "#")))
                 "\n")))

(defn- git-commit-help (kind)
  "The comment block under a message: what C-c C-c will do, and the keys."
  (str "\n# "
    (case kind
      :amend "Amending the last commit — C-c C-c rewrites it."
      :reword "Rewording the last commit — only its message changes; what is staged stays staged."
      :reword-at "Rewording an earlier commit — C-c C-c rebases to rewrite its message."
      "C-c C-c commits what is staged.")
    "\n# C-c C-k cancels · M-p / M-n earlier messages · C-c C-s sign off\n# Lines starting with # are ignored."))

(defn- git-open-commit (m root kind text)
  "Open *git-commit* for `kind` (`:commit`, `:amend`, `:reword`) with `text` above the help,
and the diff it is about beside it — what is staged, or for a reword the commit itself."
  (let (m1 (ed-show-named
             (assoc m
               :git-root root
               :git-commit-kind kind
               :git-ring-at nil
               ;; the menu's flags, carried to `cmd-git-commit-finish` — the commit
               ;; happens in another command, after the message buffer, so the
               ;; arguments have to survive the round trip on the model
               :git-commit-args (transient/ed-transient-args m))
             "*git-commit*"
             (str text (git-commit-help kind))
             :git-commit))
    (case kind
      :reword m1
      :reword-at (git-view-revision m1 root (:git-reword-target m) :display)
      (git-view-diff m1
        root
        (if (= kind :amend) ["--cached" "HEAD^"] ["--cached"])
        :staged :display))))

(defcommand cmd-git-commit
  (m key)
  "Commit what is staged (c c): a message buffer, with the staged diff beside it. With
nothing staged it offers to stage every tracked change first, as Magit does, rather than
failing at the end."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      (and (= 0 (:exit (git-git root ["diff" "--cached" "--quiet"])))
        (not (includes? (transient/ed-transient-args m) "--allow-empty"))
        (not (includes? (transient/ed-transient-args m) "--all")))
        (git-confirm m
          "Nothing is staged. Stage every tracked change and commit it?"
          (fn (mm)
            (let ([m1 r] (git-run (assoc mm :git-root root) ["add" "-u"]))
              (if (= (:exit r) 0)
                (git-open-commit m1 root :commit (or (:git-commit-draft m1) ""))
                (git-report-cmd m1 "add -u" r)))))
      :else (git-open-commit m root :commit (or (:git-commit-draft m) "")))))

(defn- git-last-message (root)
  "HEAD's message, or nil before the first commit."
  (let (r (git-git root ["log" "-1" "--format=%B"]))
    (if (= (:exit r) 0) (string/trim (:stdout r "")) nil)))

(defcommand cmd-git-commit-amend
  (m key)
  "Amend the last commit (c a): its message to edit, what is staged added to it."
  (let (root (git-resolve-root m)
        msg (if (nil? root) nil (git-last-message root)))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? msg) (message m "no commits yet to amend")
      :else (git-open-commit m root :amend msg))))

(defcommand cmd-git-commit-reword
  (m key)
  "Reword the last commit (c w): change its message and nothing else — what is staged
stays staged (`--only`)."
  (let (root (git-resolve-root m)
        msg (if (nil? root) nil (git-last-message root)))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? msg) (message m "no commits yet to reword")
      :else (git-open-commit m root :reword msg))))

(defn- git-remember-message (m msg)
  "`m` with `msg` at the head of the message ring."
  (assoc m
    :git-message-ring
      (into []
        (take (cons msg (seq/reject (or (:git-message-ring m) []) (fn (x) (= x msg))))
          *git-message-ring-max*))))

(defn- git-commit-landed (m r)
  "The `then` of a launched commit: on success forget the draft and refresh; on failure
keep it, so the next `c c` starts from what was written."
  (if (= (:exit r) 0)
    (git-refresh-if-open (dissoc m :git-commit-draft) r)
    m))

(defcommand cmd-git-commit-finish
  (m key)
  "Commit with this buffer's message (C-c C-c) — off the loop, because a pre-commit hook
can take as long as it likes."
  (let (root (:git-root m)
        msg (git-commit-message (buffer-text (ed-current-buf m)))
        kind (or (:git-commit-kind m) :commit))
    (cond
      (nil? root) (message m "no git repo")
      (= msg "") (message m "empty commit message — aborted")
      (= kind :reword-at)
        (let (target (:git-reword-target m)
              m1 (cmd-kill-buffer (dissoc m
                                    :git-commit-kind :git-commit-args
                                    :git-ring-at :git-reword-target)
                   key)
              m2 (if (nil? (ed-buffer-index-by-name m1 "*git-revision*"))
                   m1
                   (commands/ed-kill-buffer-named m1 "*git-revision*")))
          (git-reword-at (git-remember-message m2 msg) root target msg))
      :else
        (let (args (append ["commit" "-m" msg]
                     (case kind :amend ["--amend"] :reword ["--amend" "--only"] [])
                     (or (:git-commit-args m) []))
              m1 (cmd-kill-buffer (dissoc m :git-commit-kind :git-commit-args :git-ring-at) key)
              m2 (let (i (ed-buffer-index-by-name m1 "*git-diff*"))
                   (if (nil? i) m1 (commands/ed-kill-buffer-named m1 "*git-diff*"))))
          (git-launch-op (git-remember-message (assoc m2 :git-commit-draft msg :git-root root) msg)
            (case kind :amend "amend" :reword "reword" "commit")
            (append git-no-editor args)
            git-commit-landed)))))

(defcommand cmd-git-commit-abort
  (m key)
  "Abort the commit and close the message buffer (C-c C-k). What was written is kept as the
draft the next `c c` starts from."
  (let (msg (git-commit-message (buffer-text (ed-current-buf m)))
        m1 (cmd-kill-buffer (dissoc m :git-commit-kind :git-commit-args :git-ring-at) key)
        m2 (if (nil? (ed-buffer-index-by-name m1 "*git-diff*"))
             m1
             (commands/ed-kill-buffer-named m1 "*git-diff*")))
    (message (if (= msg "") m2 (assoc m2 :git-commit-draft msg)) "commit aborted")))

(defn- git-ring-step (m delta)
  "Replace the message in *git-commit* with the ring's entry `delta` away from the current one."
  (let (ring (or (:git-message-ring m) [])
        at (:git-ring-at m)
        next (if (nil? at) (if (> delta 0) 0 nil) (+ at delta)))
    (cond
      (empty? ring) (message m "no earlier messages")
      (or (nil? next) (< next 0)) (message m "at the newest message")
      (>= next (count ring)) (message m "at the oldest message")
      :else
        (let (b (ed-current-buf m)
              text (buffer-text b)
              help-at (index-of text "\n# ")
              help (if (< help-at 0) "" (string/substring text help-at (string/length text))))
          (assoc (ed-set-buf m
                   (goto-char (replace-region b 0 (buffer-length b) (str (nth ring next) help)) 0))
            :git-ring-at next)))))

(defcommand cmd-git-commit-prev-message
  (m key)
  "The message committed before this one (M-p)."
  (git-ring-step m 1))
(defcommand cmd-git-commit-next-message
  (m key)
  "The message committed after this one (M-n)."
  (git-ring-step m -1))

(defcommand cmd-git-commit-signoff
  (m key)
  "Add a `Signed-off-by:` trailer with your name and email (C-c C-s)."
  (let (root (:git-root m)
        name (string/trim (:stdout (git-git root ["config" "user.name"]) ""))
        email (string/trim (:stdout (git-git root ["config" "user.email"]) ""))
        b (ed-current-buf m)
        text (buffer-text b)
        help-at (index-of text "\n# ")
        at (if (< help-at 0) (buffer-length b) help-at)
        body (string/trimr (string/substring text 0 at))
        trailer (str "Signed-off-by: " name " <" email ">"))
    (if (includes? body trailer)
      (message m "already signed off")
      (ed-set-buf m
        (replace-region b 0 at (str body (if (includes? body "\n\n") "\n" "\n\n") trailer))))))

;; ---- fixup and squash: commits aimed at an earlier commit --------------------------
;; `c f` makes a `fixup! <subject>` commit of what is staged, aimed at the commit you pick;
;; `c F` does that and then folds it in straight away (an autosquash rebase that opens no
;; editor). `c s` / `c S` are the same with the message kept for editing into the target's.

(defn- git-autosquash (m target)
  "Rebase from `target`'s parent with `--autosquash`, accepting the plan git prepares — the
fixup lands on its target — and stashing any other changes around it."
  (git-act m
    "rebase --autosquash"
    (append ["-c" "sequence.editor=true" "-c" "core.editor=true"]
      ["rebase" "-i" "--autosquash" "--autostash" (str target "^")])))

(defn- git-aimed-commit (m verb flag instant?)
  "Commit what is staged as a `flag` (`--fixup` / `--squash`) of a commit you pick — the one
at point first — then, `instant?`, fold it in."
  (git-pick-commit m
    (str verb " commit: ")
    (fn (mm target)
      (let (root (git-resolve-root mm)
            [m1 r] (git-run (assoc mm :git-root root)
                     (append git-no-editor
                       ["commit" "--no-edit" (str flag "=" target)]
                       (transient/ed-transient-args m))))
        (cond
          (not (= (:exit r) 0)) (git-report-cmd m1 (str "commit " flag) r)
          instant? (git-autosquash m1 target)
          :else (git-refresh (git-report-cmd m1 (str "commit " flag) r)))))))

(defcommand cmd-git-commit-fixup
  (m key)
  "A fixup of an earlier commit (c f)."
  (git-aimed-commit m "Fixup" "--fixup" false))
(defcommand cmd-git-commit-squash
  (m key)
  "A squash into an earlier commit (c s)."
  (git-aimed-commit m "Squash into" "--squash" false))
(defcommand cmd-git-commit-instant-fixup
  (m key)
  "Fix up an earlier commit and fold it in now (c F)."
  (git-aimed-commit m "Fixup (instantly)" "--fixup" true))
(defcommand cmd-git-commit-instant-squash
  (m key)
  "Squash into an earlier commit and fold it in now (c S)."
  (git-aimed-commit m "Squash (instantly) into" "--squash" true))

;; ============================================================================
;; THE REST OF THE PORCELAIN: merge, rebase, cherry-pick, revert, tag, remote,
;; reset, and menus over the commands that already existed.
;; ============================================================================
;;
;; Every one of these is "run a git subcommand with some flags, then refresh", and the
;; flags are what a keymap could never hold — which is why this arrives now and not
;; before: a transient (brood ADR-387) is the place a flag can live.
;;
;; Two rules run through the lot.
;;
;; **Nothing here guesses.** A command that could lose work asks first — `git-confirm`
;; is a y/n the dangerous ones go through, and it names what it is about to do rather
;; than asking "are you sure?". `reset --hard` and `clean` are the two that can destroy
;; uncommitted work, and both are behind it.
;;
;; **The SEQUENCER is one idea, not five.** A rebase, a merge, a cherry-pick and a revert
;; can all stop half-way and leave the repo waiting for you, and each has its own
;; `--continue` / `--abort` / `--skip`. Magit has a key per verb; it does not need to be
;; that way, because git itself records which one is in flight — in `.git`. So
;; `git-sequencer` reads the state and `cmd-git-sequence-continue` / `-abort` / `-skip`
;; dispatch on it: one key that means "carry on with whatever we are in the middle of".

(defn git-act (m verb args)
  "Resolve the repo root onto the model, then [[git-do]]: run `git args` journalled and
refresh on success.

`git-do` alone is not enough for anything below. It runs git in `(:git-root m)`, which is
set while *git-status* is open and nil everywhere else — and every command here is also
reachable by `M-x`, from a buffer that has never opened a status. Without this they would
run git in nil."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-do (assoc m :git-root root) verb args))))

(def- git-no-editor
  ;; `git rebase --continue`, `merge`, `commit --amend` and friends all open an EDITOR for
  ;; the message unless told otherwise. There is no terminal on this side of the pipe, so
  ;; git would launch a `vi` nobody can see and the command would hang until the 120 s
  ;; timeout — the editor frozen, waiting on an editor.
  ;;
  ;; `core.editor=true` points git at `true(1)`, which exits 0 having changed nothing: the
  ;; message git prepared is accepted as it stands, exactly what `--no-edit` means for the
  ;; verbs that have such a flag. `sequence.editor` is the same thing for the interactive
  ;; rebase todo list.
  ;;
  ;; Prepended to the ARGS rather than passed as config, because `git-git` puts our args
  ;; immediately after its own `-c core.quotePath=false` and `-c` may repeat. The journal's
  ;; `git-command-text` strips leading `-c` pairs, so `$` still shows `git rebase
  ;; --continue` rather than the plumbing.
  ["-c" "core.editor=true" "-c" "sequence.editor=true"])

(def- git-sequencer-markers
  ;; The file git leaves in `.git` while an operation is part-way through, and what to
  ;; call it. Order matters: `rebase-merge` and `rebase-apply` are two implementations of
  ;; the same verb, and a cherry-pick in the middle of a rebase is still a rebase.
  [["rebase-merge" :rebase "rebase"]
    ["rebase-apply" :rebase "rebase"]
    ["CHERRY_PICK_HEAD" :cherry-pick "cherry-pick"]
    ["REVERT_HEAD" :revert "revert"]
    ["MERGE_HEAD" :merge "merge"]
    ["BISECT_LOG" :bisect "bisect"]])

(defn git-sequencer (root)
  "The git operation this repo is part-way through — `{:kind :rebase :verb \"rebase\"}` —
or **nil** when none is. Read from the marker `.git` leaves behind, which is how git
itself knows, so this cannot disagree with what `--continue` would resume.

`.git` is a FILE, not a directory, in a worktree or a submodule (it holds a `gitdir:`
pointer), so the markers are looked for through `git rev-parse --git-dir` rather than at
`<root>/.git` — otherwise every one of these features would be silently dead in a
worktree, which is where a rebase is most likely to be happening."
  (let (dir (string/trim (:stdout (git-git root ["rev-parse" "--absolute-git-dir"]) ""))
        hit (if (= dir "")
              nil
              (seq/find git-sequencer-markers
                (fn (row) (file/exists? (path/join dir (first row)))))))
    (if (nil? hit) nil {:kind (nth hit 1) :verb (nth hit 2)})))

(defn- git-sequence-argv (seq step)
  "The argv that performs `step` (continue / abort / skip) on the operation `seq`, or nil
when that operation has no such step.

Almost every verb spells these `--continue` / `--abort` / `--skip`, which is what made one
set of keys possible at all. **Bisect does not**: it is `git bisect reset` to stop and
`git bisect skip` to move on, with no `--` and no continue at all — `git bisect --abort`
is simply an error. A table, so the exception is data rather than a special case that gets
forgotten."
  (let (verb (:verb seq))
    (if (= (:kind seq) :bisect)
      (case step
        "abort" ["bisect" "reset"]
        "skip" ["bisect" "skip"]
        nil) ; there is nothing to "continue" in a bisect — you answer good or bad
      [verb (str "--" step)])))

(defn- git-sequence-step (m step)
  "Run `step` on whatever operation is in flight. The one command behind three keys,
because git already knows which verb it is."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      :else
        (let (seq (git-sequencer root)
              argv (if (nil? seq) nil (git-sequence-argv seq step)))
          (cond
            (nil? seq) (message m "nothing in progress")
            (nil? argv) (message m (str "a " (:verb seq) " has no " step " — answer good or bad"))
            :else (git-act m (string/join argv " ") (append git-no-editor argv)))))))

(defcommand cmd-git-sequence-continue
  (m key)
  "Carry on with the rebase / merge / cherry-pick / revert that is part-way through (r c)."
  (git-sequence-step m "continue"))

(defcommand cmd-git-sequence-abort
  (m key)
  "Abandon the operation in progress and put the repo back (r a)."
  (git-sequence-step m "abort"))

(defcommand cmd-git-sequence-skip
  (m key)
  "Skip the commit the operation is stuck on and carry on (r s)."
  (git-sequence-step m "skip"))

;; ---- picking a ref, and the shape every new command shares -------------------
;; Six of the commands below are the same sentence: "pick a ref, run a subcommand with the
;; menu's flags and that ref, refresh". Written out six times that is six chances to forget
;; the flags, the refresh, or the not-a-repo case — `cmd-git-checkout` above is the
;; hand-written version, kept because checkout is the one that reports differently.

(defn git-refs (root kind)
  "The repo's refs of `kind` — `:branches` (local and remote), `:local` or `:tags` — newest
first where git will say, as a list of plain names."
  (let (args (case kind
               :local ["branch" "--format=%(refname:short)" "--sort=-committerdate"]
               :tags ["tag" "--sort=-creatordate"]
               :remote ["branch" "-r" "--format=%(refname:short)" "--sort=-committerdate"]
               ["branch" "-a" "--format=%(refname:short)" "--sort=-committerdate"])
        r (git-git root args))
    (if (= (:exit r) 0)
      (seq/reject (string/split (string/trim (:stdout r "")) "\n") empty?)
      '())))

(defn git-with-ref (m prompt kind then)
  "Prompt for a ref of `kind` (completing over what the repo has) and hand it to `then`
(`(model ref) -> model`). The refs are read on the loop, which is the one thing here that
costs a subprocess — acceptable, because the prompt cannot be shown before they are known."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt prompt
            ;; the ref at point first: RET on the branch you are looking at takes it
            (git-first (git-ref-at-point m) (git-refs root kind))
            (fn (mm ref)
              (if (= (string/trim ref) "")
                (message mm "nothing chosen")
                (then mm (string/trim ref)))))))))

;; ---- merge (m) ---------------------------------------------------------------

(def git-merge-transient
  {:name 'git-merge
   :title "Merge"
   :groups [{:title "Arguments"
             :suffixes [{:key "-n" :kind :switch :arg "--no-ff" :label "always make a merge commit"}
                         {:key "-f" :kind :switch :arg "--ff-only" :label "fast-forward only"}
                         {:key "-s"
                          :kind :switch
                          :arg "--squash"
                          :label "squash to a single change"}
                         {:key "-S"
                          :kind :switch
                          :arg "--no-commit"
                          :label "stop before committing"}]}
             {:title "Merge"
              :suffixes [{:key "m"
                          :kind :command
                          :command 'git/cmd-git-merge
                          :label "a branch into HEAD"}
                          {:key "p"
                           :kind :command
                           :command 'git/cmd-git-merge-preview
                           :label "preview what it would bring in"}]}
             {:title "In progress"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-sequence-continue
                          :label "continue"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-sequence-abort
                           :label "abort"}]}]})

(defcommand cmd-git-merge-menu
  (m key)
  "The merge menu (m)."
  (transient/ed-transient-open m git-merge-transient))

(defcommand cmd-git-merge
  (m key)
  "Merge a branch into HEAD, with the merge menu's flags."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Merge branch: "
      :branches (fn (mm ref)
        (git-act mm "merge" (append git-no-editor (append ["merge"] (append args [ref]))))))))

(defcommand cmd-git-merge-preview
  (m key)
  "What merging a branch would bring in (m p): its changes since it left HEAD's history."
  (git-with-ref m
    "Preview merging: "
    :branches (fn (mm ref) (git-view-diff mm (git-resolve-root mm) [(str "HEAD..." ref)] nil))))

;; ---- rebase (r) --------------------------------------------------------------

(def git-rebase-transient
  {:name 'git-rebase
   :title "Rebase"
   :groups [{:title "Arguments"
             :suffixes [{:key "-a"
                         :kind :switch
                         :arg "--autostash"
                         :label "stash local changes and put them back"}
                         {:key "-k"
                          :kind :switch
                          :arg "--keep-empty"
                          :label "keep commits that become empty"}
                         {:key "-u"
                          :kind :switch
                          :arg "--update-refs"
                          :label "move branches on the way too"}]}
             {:title "Rebase the current branch onto"
              :suffixes [{:key "u"
                          :kind :command
                          :command 'git/cmd-git-rebase-upstream
                          :label "its upstream"}
                          {:key "e" :kind :command :command 'git/cmd-git-rebase :label "elsewhere"}]}
             {:title "Rewrite history"
              :suffixes [{:key "i"
                          :kind :command
                          :command 'git/cmd-git-rebase-interactive
                          :label "interactively — edit the plan first"}
                          {:key "w"
                           :kind :command
                           :command 'git/cmd-git-rebase-reword-commit
                           :label "reword a commit"}
                          {:key "m"
                           :kind :command
                           :command 'git/cmd-git-rebase-edit-commit
                           :label "modify a commit"}
                          {:key "k"
                           :kind :command
                           :command 'git/cmd-git-rebase-remove-commit
                           :label "remove a commit"}
                          {:key "f"
                           :kind :command
                           :command 'git/cmd-git-rebase-autosquash
                           :label "autosquash fixups"}]}
             {:title "In progress"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-sequence-continue
                          :label "continue"}
                          {:key "s"
                           :kind :command
                           :command 'git/cmd-git-sequence-skip
                           :label "skip this commit"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-sequence-abort
                           :label "abort"}]}]})

(defcommand cmd-git-rebase-menu
  (m key)
  "The rebase menu (r): the arguments, where to rebase onto, and the three ways out of one
that has stopped part-way."
  (transient/ed-transient-open m git-rebase-transient))

(defcommand cmd-git-rebase
  (m key)
  "Rebase the current branch onto a branch you pick, with the menu's flags."
  (let (args (transient/ed-transient-args m))
    (git-with-ref m
      "Rebase onto: "
      :branches (fn (mm ref)
        (git-act mm "rebase" (append git-no-editor (append ["rebase"] (append args [ref]))))))))

(defcommand cmd-git-rebase-upstream
  (m key)
  "Rebase the current branch onto its upstream — the common case, with no prompt."
  (let (root (git-resolve-root m))
    (cond
      (nil? root) (message m "not in a git repository")
      (nil? (git-upstream root)) (message m "this branch has no upstream to rebase onto")
      :else
        (git-act m
          "rebase"
          (append git-no-editor
            (append ["rebase"]
              (append (transient/ed-transient-args m) [(git-upstream root)])))))))

;; ---- cherry-pick (A) and revert (V) ------------------------------------------
;; Both take a commit and both can stop on a conflict, so both lead into the sequencer.
;; In *git-status* the commit under point is the obvious subject — the log sections are
;; right there — so the commit row's hash is offered as the default.

(defn git-commit-at-point (m)
  "The revision at point in any git buffer, or nil: a commit (a status section, a log line),
a stash, a blame chunk, a branch or ref, or — in a commit buffer — the commit it shows.
What `A`, `V`, `X`, `r i`, `c f` and `d c` offer first."
  (let (row (git-row-at m)
        v (if (nil? row) nil (:value row)))
    (case (if (nil? row) nil (:type row))
      :commit (:hash v)
      :stash (:ref v)
      :blame (:full v)
      :branch (:name v)
      :ref (:name v)
      :tag (:name v)
      (get (sectionbuf/sb-ctx m) :rev))))

(defn git-ref-at-point (m)
  "The branch, remote branch or tag at point, or nil — what `b b`, `b k` and `m m` offer
first."
  (let (row (git-row-at m))
    (if (and row (includes? [:branch :ref :tag] (:type row))) (:name (:value row)) nil)))

(defn- git-first (here names)
  "`names` with `here` moved to the front — the candidate RET takes in a completing prompt."
  (if (nil? here) names (cons here (seq/reject names (fn (n) (= n here))))))

(defn git-pick-commit (m prompt then)
  "Prompt for a commit, defaulting to the one under point in *git-status*, and hand it to
`then`. The recent commits complete, so picking one off the log is a keystroke."
  (let (root (git-resolve-root m)
        here (git-commit-at-point m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (hashes (git-first here (map (git-log-commits root ["-30"]) :hash)))
        (assoc m
          :minibuffer
            (commands/ed-name-prompt (str prompt (if here (str "(" here ") ") ""))
              hashes
              (fn (mm text)
                (let (chosen (if (= (string/trim text) "") (or here "") (string/trim text)))
                  (if (= chosen "")
                    (message mm "no commit chosen")
                    (then mm chosen))))))))))

(def git-cherry-pick-transient
  {:name 'git-cherry-pick
   :title "Cherry-pick"
   :groups [{:title "Arguments"
             :suffixes [{:key "-x"
                         :kind :switch
                         :arg "-x"
                         :label "record which commit it came from"}
                         {:key "-s"
                          :kind :switch
                          :arg "--signoff"
                          :label "add a Signed-off-by line"}]}
             {:title "Cherry-pick"
              :suffixes [{:key "A"
                          :kind :command
                          :command 'git/cmd-git-cherry-pick
                          :label "a commit onto HEAD"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-cherry-apply
                           :label "apply a commit's change, uncommitted"}]}
             {:title "In progress"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-sequence-continue
                          :label "continue"}
                          {:key "s"
                           :kind :command
                           :command 'git/cmd-git-sequence-skip
                           :label "skip"}
                          {:key "k"
                           :kind :command
                           :command 'git/cmd-git-sequence-abort
                           :label "abort"}]}]})

(def git-revert-transient
  {:name 'git-revert
   :title "Revert"
   :groups [{:title "Arguments"
             :suffixes [{:key "-s" :kind :switch :arg "--signoff" :label "add a Signed-off-by line"}]}
             {:title "Revert"
              :suffixes [{:key "V" :kind :command :command 'git/cmd-git-revert :label "a commit"}
                          {:key "v"
                           :kind :command
                           :command 'git/cmd-git-revert-no-commit
                           :label "a commit's change, uncommitted"}]}
             {:title "In progress"
              :suffixes [{:key "c"
                          :kind :command
                          :command 'git/cmd-git-sequence-continue
                          :label "continue"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-sequence-abort
                           :label "abort"}]}]})

(defcommand cmd-git-cherry-pick-menu
  (m key)
  "The cherry-pick menu (A)."
  (transient/ed-transient-open m git-cherry-pick-transient))

(defcommand cmd-git-revert-menu
  (m key)
  "The revert menu (V)."
  (transient/ed-transient-open m git-revert-transient))

(defcommand cmd-git-cherry-pick
  (m key)
  "Cherry-pick a commit onto HEAD — the one under point by default."
  (let (args (transient/ed-transient-args m))
    (git-pick-commit m
      "Cherry-pick commit: "
      (fn (mm commit)
        (git-act mm
          "cherry-pick"
          (append git-no-editor (append ["cherry-pick"] (append args [commit]))))))))

(defcommand cmd-git-revert
  (m key)
  "Revert a commit — the one under point by default."
  (let (args (transient/ed-transient-args m))
    (git-pick-commit m
      "Revert commit: "
      (fn (mm commit)
        (git-act mm "revert" (append git-no-editor (append ["revert"] (append args [commit]))))))))

(defcommand cmd-git-cherry-apply
  (m key)
  "Apply a commit's change to the work tree and index without committing (A a)."
  (git-pick-commit m
    "Apply commit: "
    (fn (mm c) (git-act mm "cherry-pick --no-commit" ["cherry-pick" "--no-commit" c]))))

(defcommand cmd-git-revert-no-commit
  (m key)
  "Reverse a commit's change in the work tree and index without committing (V v)."
  (git-pick-commit m
    "Revert (uncommitted) commit: "
    (fn (mm c) (git-act mm "revert --no-commit" ["revert" "--no-commit" c]))))

;; ---- asking before something that cannot be undone ---------------------------

(defn git-confirm (m prompt then)
  "Ask `prompt` (y/n) and run `then` on yes. The same one-key reader `cmd-git-discard`
uses, pulled out because three more commands now need it — and the prompt NAMES what is
about to happen (`Reset --hard to abc123, losing all uncommitted changes?`) rather than
asking whether you are sure. \"Are you sure?\" is answered yes by reflex; a sentence that
says what will be lost is not."
  (ed-read-char m
    (str prompt " (y/n) ")
    (fn (mm c) (if (or (= c "y") (= c "Y")) (then mm) (message mm "cancelled")))))

;; ---- tags (t) ----------------------------------------------------------------

(def git-tag-transient
  {:name 'git-tag
   :title "Tag"
   :groups [{:title "Arguments"
             :suffixes [{:key "-a" :kind :switch :arg "--annotate" :label "annotated"}
                         {:key "-f" :kind :switch :arg "--force" :label "replace an existing tag"}
                         {:key "-s" :kind :switch :arg "--sign" :label "signed"}
                         {:key "=m"
                          :kind :option
                          :arg "--message="
                          :label "message"
                          :prompt "Tag message"}]}
             {:title "Tag"
              :suffixes [{:key "t" :kind :command :command 'git/cmd-git-tag-create :label "create"}
                          {:key "k" :kind :command :command 'git/cmd-git-tag-delete :label "delete"}
                          {:key "p" :kind :command :command 'git/cmd-git-push-tag :label "push one"}
                          {:key "l"
                           :kind :command
                           :command 'gitview/cmd-git-refs
                           :label "list (with branches)"}]}]})

(defcommand cmd-git-tag-menu
  (m key)
  "The tag menu (t)."
  (transient/ed-transient-open m git-tag-transient))

(defcommand cmd-git-tag-create
  (m key)
  "Create a tag (t t): its name, then the commit it names — the one at point first."
  (let (args (transient/ed-transient-args m))
    (git-with-name m
      "Tag name: "
      (fn (mm name)
        (git-with-start mm
          (str "Tag " name " at: ")
          (fn (m2 target)
            ;; an annotated tag without a message would open an editor nobody can see
            (let (annotated? (or (includes? args "--annotate") (includes? args "--sign"))
                  msg? (any? args (fn (a) (string/starts-with? a "--message="))))
              (git-act m2
                "tag"
                (append ["tag"]
                  args
                  (if (and annotated? (not msg?)) [(str "--message=" name)] [])
                  [name target])))))))))

(defcommand cmd-git-tag-delete
  (m key)
  "Delete a tag, completing over the repo's tags."
  (git-with-ref m
    "Delete tag: "
    :tags (fn (mm tag)
      (git-confirm mm (str "Delete tag " tag "?") (fn (m2) (git-act m2 "tag -d" ["tag" "-d" tag]))))))

;; ---- remotes (M) -------------------------------------------------------------

(defcommand cmd-git-remote-list
  (m key)
  "Every remote and where it points (M l)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let ([m1 r] (git-run (assoc m :git-root root) ["remote" "-v"]))
        (git-show-report m1 "*git-remotes*" (:stdout r "") :git-text {:action :pop})))))

(defcommand cmd-git-remote-add
  (m key)
  "Add a remote: prompts for the name, then the URL."
  (assoc m
    :minibuffer
      (commands/ed-name-prompt "Remote name: "
        '()
        (fn (mm name)
          (if (= (string/trim name) "")
            (message mm "remote name cannot be empty")
            (assoc mm
              :minibuffer
                (commands/ed-name-prompt (str "URL for " (string/trim name) ": ")
                  '()
                  (fn (m2 url)
                    (if (= (string/trim url) "")
                      (message m2 "url cannot be empty")
                      (git-act m2
                        "remote add"
                        ["remote" "add" (string/trim name) (string/trim url)]))))))))))

(defcommand cmd-git-remote-remove
  (m key)
  "Remove a remote, completing over the ones this repo has."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (names (seq/reject (string/split (string/trim (:stdout (git-git root ["remote"]) ""))
                                "\n")
                    empty?))
        (assoc m
          :minibuffer
            (commands/ed-name-prompt "Remove remote: "
              names
              (fn (mm name)
                (git-confirm mm
                  (str "Remove remote " name "?")
                  (fn (m2) (git-act m2 "remote remove" ["remote" "remove" (string/trim name)]))))))))))

(defcommand cmd-git-remote-rename
  (m key)
  "Rename a remote (M r)."
  (git-with-remote m
    "Rename remote: "
    (fn (mm old)
      (git-with-name mm
        (str "Rename " old " to: ")
        (fn (m2 new) (git-act m2 "remote rename" ["remote" "rename" old new]))))))

(defcommand cmd-git-remote-set-url
  (m key)
  "Point a remote at another URL (M u)."
  (git-with-remote m
    "Set the URL of remote: "
    (fn (mm name)
      (git-with-name mm
        (str "New URL for " name ": ")
        (fn (m2 url) (git-act m2 "remote set-url" ["remote" "set-url" name url]))))))

(defcommand cmd-git-remote-prune
  (m key)
  "Forget a remote's branches that are gone from it (M p)."
  (git-with-remote m
    "Prune remote: "
    (fn (mm name) (git-act mm "remote prune" ["remote" "prune" name]))))

(def git-remote-transient
  {:name 'git-remote
   :title "Remote"
   :groups [{:title "Remote"
             :suffixes [{:key "l" :kind :command :command 'git/cmd-git-remote-list :label "list"}
                         {:key "a" :kind :command :command 'git/cmd-git-remote-add :label "add"}
                         {:key "r"
                          :kind :command
                          :command 'git/cmd-git-remote-rename
                          :label "rename"}
                         {:key "u"
                          :kind :command
                          :command 'git/cmd-git-remote-set-url
                          :label "set its URL"}
                         {:key "p"
                          :kind :command
                          :command 'git/cmd-git-remote-prune
                          :label "prune gone branches"}
                         {:key "k"
                          :kind :command
                          :command 'git/cmd-git-remote-remove
                          :label "remove"}]}]})

(defcommand cmd-git-remote-menu
  (m key)
  "The remote menu (M)."
  (transient/ed-transient-open m git-remote-transient))

;; ---- reset (X) ---------------------------------------------------------------
;; The one that can destroy work, so `--hard` is the only command in this file that both
;; asks first AND says in the prompt what will be lost.

(defcommand cmd-git-reset-soft
  (m key)
  "Move HEAD to a commit, keeping the index and the working tree (X s)."
  (git-pick-commit m
    "Reset --soft to: "
    (fn (mm commit) (git-act mm "reset --soft" ["reset" "--soft" commit]))))

(defcommand cmd-git-reset-mixed
  (m key)
  "Move HEAD to a commit and reset the index, keeping the working tree (X m)."
  (git-pick-commit m
    "Reset --mixed to: "
    (fn (mm commit) (git-act mm "reset" ["reset" "--mixed" commit]))))

(defcommand cmd-git-reset-hard
  (m key)
  "Move HEAD to a commit and throw away the index AND the working tree (X h). Asks first,
naming what goes."
  (git-pick-commit m
    "Reset --hard to: "
    (fn (mm commit)
      (git-confirm mm
        (str "Reset --hard to " commit ", losing every uncommitted change?")
        (fn (m2) (git-act m2 "reset --hard" ["reset" "--hard" commit]))))))

(defcommand cmd-git-reset-keep
  (m key)
  "Move HEAD to a commit, keeping uncommitted changes — refusing if any would be lost (X k)."
  (git-pick-commit m
    "Reset --keep to: "
    (fn (mm commit) (git-act mm "reset --keep" ["reset" "--keep" commit]))))

(defcommand cmd-git-reset-index
  (m key)
  "Make the index match a commit, leaving HEAD and the work tree alone (X i)."
  (git-pick-commit m
    "Reset the index to: "
    (fn (mm commit) (git-act mm "reset index" ["reset" commit "--" "."]))))

(defcommand cmd-git-reset-worktree
  (m key)
  "Make the work tree match a commit, leaving HEAD and the index alone (X w), after a
question — every uncommitted edit to a tracked file goes."
  (git-pick-commit m
    "Reset the work tree to: "
    (fn (mm commit)
      (git-confirm mm
        (str "Overwrite every tracked file with its content at " commit "?")
        (fn (m2) (git-act m2 "checkout worktree" ["checkout" commit "--" "."]))))))

(defcommand cmd-git-reset-file
  (m key)
  "Put one file back as it was at a commit (X f) — the file at point or this buffer's file."
  (let (root (git-resolve-root m)
        f (git-file-at m)
        file (buffer-file (ed-current-buf m))
        path (cond
               (not (nil? f)) (:path f)
               (and root file (string/starts-with? file (str root "/")))
                 (string/substring file (inc (string/length root)) (string/length file))
               :else nil))
    (if (nil? path)
      (message m "no file here")
      (git-pick-commit m
        (str "Reset " path " to: ")
        (fn (mm commit) (git-act mm "checkout file" ["checkout" commit "--" path]))))))

(def git-reset-transient
  {:name 'git-reset
   :title "Reset"
   :groups [{:title "Reset HEAD to a commit"
             :suffixes [{:key "m"
                         :kind :command
                         :command 'git/cmd-git-reset-mixed
                         :label "--mixed  reset the index, keep the working tree"}
                         {:key "s"
                          :kind :command
                          :command 'git/cmd-git-reset-soft
                          :label "--soft   keep the index and the working tree"}
                         {:key "h"
                          :kind :command
                          :command 'git/cmd-git-reset-hard
                          :label "--hard   throw away everything uncommitted"}
                         {:key "k"
                          :kind :command
                          :command 'git/cmd-git-reset-keep
                          :label "--keep   keep uncommitted changes, refuse to lose any"}]}
             {:title "Reset without moving HEAD"
              :suffixes [{:key "i"
                          :kind :command
                          :command 'git/cmd-git-reset-index
                          :label "the index"}
                          {:key "w"
                           :kind :command
                           :command 'git/cmd-git-reset-worktree
                           :label "the work tree"}
                          {:key "f" :kind :command :command 'git/cmd-git-reset-file :label "a file"}]}]})

(defcommand cmd-git-reset-menu
  (m key)
  "The reset menu (X). The three modes are spelled out with what each keeps, because
nobody remembers which of soft and mixed touches the index."
  (transient/ed-transient-open m git-reset-transient))

;; ---- log (l), with the arguments a log is actually read with -----------------
;; `git log` is the command whose flags matter most and are remembered least: `--graph`,
;; `-n`, `--author=`. Each is a row; WHICH history is the suffix — the current branch,
;; another, every local branch, every branch, everything, a file, the reflog. The buffers
;; are `gitview`'s: commits you can show, pick, revert and rebase from.

(def git-log-transient
  {:name 'git-log
   :title "Log"
   :groups [{:title "Arguments"
             :suffixes [{:key "-g" :kind :switch :arg "--graph" :label "draw the commit graph"}
                         {:key "-m" :kind :switch :arg "--no-merges" :label "leave out merges"}
                         {:key "-F" :kind :switch :arg "--first-parent" :label "first parents only"}
                         {:key "=n"
                          :kind :option
                          :arg "-n"
                          :label "limit"
                          :prompt "How many commits"}
                         {:key "=a"
                          :kind :option
                          :arg "--author="
                          :label "author"
                          :prompt "Author"}
                         {:key "=g"
                          :kind :option
                          :arg "--grep="
                          :label "message matches"
                          :prompt "Message pattern"}
                         {:key "=S"
                          :kind :option
                          :arg "-S"
                          :label "changes the count of"
                          :prompt "Text"}
                         {:key "=s"
                          :kind :option
                          :arg "--since="
                          :label "since"
                          :prompt "Since (e.g. 2 weeks ago)"}]}
             {:title "Log"
              :suffixes [{:key "l"
                          :kind :command
                          :command 'gitview/cmd-git-log
                          :label "the current branch"}
                          {:key "o"
                           :kind :command
                           :command 'gitview/cmd-git-log-other
                           :label "another branch"}
                          {:key "L"
                           :kind :command
                           :command 'gitview/cmd-git-log-local
                           :label "every local branch"}
                          {:key "b"
                           :kind :command
                           :command 'gitview/cmd-git-log-branches
                           :label "every branch"}
                          {:key "a"
                           :kind :command
                           :command 'gitview/cmd-git-log-all
                           :label "every ref"}]}
             {:title "And"
              :suffixes [{:key "f"
                          :kind :command
                          :command 'gitview/cmd-git-log-file
                          :label "the file at point"}
                          {:key "r"
                           :kind :command
                           :command 'gitview/cmd-git-reflog
                           :label "the reflog"}
                          {:key "y"
                           :kind :command
                           :command 'gitview/cmd-git-refs
                           :label "branches and tags"}]}]})

(defcommand cmd-git-log-menu
