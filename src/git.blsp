(defmodule git
  "A git porcelain modelled on Magit: `C-x g` opens a read-only `*git-status*` buffer with
Unstaged / Staged / Untracked / Unpushed / Unpulled / Recent-commits sections. Single-key actions — s/u/k
stage/unstage/discard the **file or hunk** under point, S stage-all, U unstage-all, c commit
(a amend), b b checkout branch / b c create branch, n/p jump between actionable rows, TAB
expand file hunks inline / collapse section, RET preview diff or show commit, d diff whole pane,
g refresh, q quit, P/F push/pull, l log, z z/z p stash push/pop. Hunk-level staging: TAB expands
a file showing each `@@` hunk as an actionable row; s/u/k on a hunk runs `git apply --cached`
(or its reverse) piping the patch via stdin (`%os-cmd-stdin`). Section collapsing: TAB on a
section header toggles it between expanded and collapsed (`:git-collapsed-sections` tracks which).
The dired pattern: a `:git-status` mode layer over a generated buffer, with the per-row data (file,
hunk, section-header, OR commit-log row) kept on the model (`:git-rows`, parallel to the buffer's
lines) so commands read the current row without re-parsing text. Git runs synchronously via
`%os-cmd` in the repo root (`:git-root`). Parsing/rendering are pure (tests/git_test.blsp)."
  (:use model) ; ed-current-buf / ed-set-buf / message / ed-read-char / ed-apply
  (:use commands) ; ed-show-named / ed-default-dir / ed-goto-line / cmd-kill-buffer
  (:use interactive) ; defcommand
  (:use statusbar) ; `seg` — build the branch + working-tree status-bar segments
  (:use editor/buffer)) ; buffer-current-line / buffer-text
;; `theme` (a project source module, loaded with the image) provides the *green* / *red* /
;; *blue* / *yellow* / *subtext* dynamic-var colour globals this file reads bare.
;; ---- syntax highlighting for the diff / log / status buffers ----------------
;; A `:fontify` service like every mode's: a pure `slice -> [start end face]`, line-
;; structural (no lexer state) so the windowed slice the view passes colours correctly
;; wherever it starts. The classifier trims leading whitespace first, so it works for the
;; raw *git-diff* output AND the indented inline diff under a file in *git-status*.

(def git-face-add {:fg *green*}) ; an added (+) line
(def git-face-del {:fg *red*}) ; a removed (-) line
(def git-face-hunk {:fg *blue* :bold true}) ; a @@ hunk header
(def git-face-file {:fg *subtext* :bold true}) ; diff --git / +++ / --- file headers
(def git-face-meta {:fg *subtext*}) ; index / mode / rename metadata
(def git-face-section {:fg *blue* :bold true}) ; a *git-status* section header
(def git-face-note {:fg *subtext* :italic true})
(def git-face-hash {:fg *yellow*}) ; a commit hash in the log
;; the status-bar segment faces (branch + colour-coded working-tree indicator): staged reads
;; green, unstaged yellow, untracked dim; a clean/staged tree dot is green. Built from the
;; theme colour tokens (via `require`), like the diff faces above — kept here, not in theme,
;; because git reaches the palette through `require` (dynamic-var colours only).
(def git-face-branch {:fg *subtext*}) ; the ⎇ branch label (quiet, secondary)
(def git-face-clean {:fg *green*}) ; the state dot when the tree is clean / staged
(def git-face-staged {:fg *green*}) ; the +N staged-change count (ready to commit)
(def git-face-unstaged {:fg *yellow*}) ; the ~N unstaged-change count (modified, dirty)
(def git-face-untracked {:fg *overlay0*}) ; the ?N untracked-file count (dim)
;; the *git-status* header block: a local branch (the `Head:` line) reads blue, a remote /
;; upstream branch (the `Merge:` line) green — Magit's magit-branch-local / -remote.
(def git-face-branch-local {:fg *blue* :bold true}) ; the `Head:` line's branch
(def git-face-branch-remote {:fg *green* :bold true}) ; the `Merge:` line's upstream
;; the colour-coded file-status labels — a legend at a glance, reusing the diff-hl palette
;; (modified yellow, added green, deleted red, rename/copy blue, untracked dim). Keyed by the
;; human label `git-entry-label` emits, so the fontify colours just that word.
(def- git-label-faces
  {"modified" git-face-unstaged
   "new file" git-face-add
   "deleted" git-face-del
   "renamed" git-face-hunk
   "copied" git-face-hunk
   "conflict" git-face-del
   "untracked" git-face-untracked})

(defn- git-diff-line-face
  (line)
  "The face for a unified-diff line (leading indent ignored), or nil for a context line."
  (let (t (string/triml line))
    (cond
      (string/starts-with? t "@@") git-face-hunk
      (or (string/starts-with? t "+++") (string/starts-with? t "---")) git-face-file
      (string/starts-with? t "diff ") git-face-file
      (or (string/starts-with? t "index ")
        (string/starts-with? t "new ")
        (string/starts-with? t "deleted ")
        (string/starts-with? t "rename ")
        (string/starts-with? t "similarity ")
        (string/starts-with? t "old mode")
        (string/starts-with? t "new mode"))
        git-face-meta
      (string/starts-with? t "+") git-face-add
      (string/starts-with? t "-") git-face-del
      :else nil)))

(defn- git-hex?
  (s)
  "True when `s` is a run of at least four lowercase-hex digits — i.e. a git short hash (so a
commit row is told apart from a file row, whose label is a word)."
  (and (>= (string/length s) 4)
    (nil? (seq/find (fn (i) (< (index-of "0123456789abcdef" (string/char-at s i)) 0))
            (range (string/length s))))))

(defn- git-header-spans
  (line off)
  "Spans for a `Head:`/`Merge:`/`Push:` header line: the `Label:` in the dim meta face, the
branch/upstream name in a branch face (local blue on `Head:`, remote green otherwise), the
trailing commit subject left in the default face."
  (let (colon (index-of line ":")
        rest (if (< colon 0) "" (string/substring line (inc colon) (string/length line)))
        after (string/triml rest)
        lead (- (string/length rest) (string/length after))
        sp (index-of after " ")
        blen (if (< sp 0) (string/length after) sp)
        bstart (+ (inc colon) lead)
        bface (if (string/starts-with? line "Head:") git-face-branch-local git-face-branch-remote))
    (append (if (< colon 0) '() (list [off (+ off (inc colon)) git-face-meta]))
      (if (= blen 0) '() (list [(+ off bstart) (+ off bstart blen) bface])))))

(defn- git-section-header-spans
  (line off)
  "Spans for a section header (`Unstaged changes (2):`): the name in the section face, the
`(N):` count in the dim meta face so the section name leads."
  (let (i (index-of line " ("))
    (if (< i 0)
      (git-whole-line off line git-face-section)
      (list [off (+ off i) git-face-section]
        [(+ off i 1) (+ off (string/length line)) git-face-meta]))))

(defn- git-file-row-spans
  (line off)
  "Spans for a file row (`\"  modified   path\"`): the status label in its state colour, the path
left plain. A commit row (`\"  <hash>  subject\"`) instead gets its leading hash coloured; any
other 2-space line is left uncoloured."
  (let (end (string/length line)
        field (string/trim (string/substring line 2 (math/min end (+ 2 git-label-width))))
        face (get git-label-faces field))
    (if face
      (list [(+ off 2) (+ off 2 (string/length field)) face])
      (let (body (string/substring line 2 end)
            sp (index-of body " ")
            tok (if (< sp 0) body (string/substring body 0 sp)))
        (if (git-hex? tok)
          (list [(+ off 2) (+ off 2 (string/length tok)) git-face-hash])
          '())))))

(defn- git-status-line-spans
  (line off)
  "The spans for one *git-status* line, dispatched on its shape: the header block, a section
header (dim count), an inline diff line (4-space indent), a file or commit row (2-space
indent), or the clean-tree note. `off` is the line's start offset in the buffer."
  (cond
    (= line "") '()
    (or (string/starts-with? line "Head:")
      (string/starts-with? line "Merge:")
      (string/starts-with? line "Push:"))
      (git-header-spans line off)
    (string/ends-with? line ":") (git-section-header-spans line off)
    (string/starts-with? line "    ") (git-whole-line off line (git-diff-line-face line))
    (string/starts-with? line "  ") (git-file-row-spans line off)
    (string/starts-with? line "nothing to commit") (git-whole-line off line git-face-note)
    :else '()))

(defn- git-whole-line
  (off line face)
  "A whole-line span `[off end face]`, or `()` when `face` is nil."
  (if (nil? face) '() (list [off (+ off (string/length line)) face])))

(defn- git-log-line-spans
  (line off)
  "Spans for one `git log --oneline` row: just the leading commit hash (to the first space)."
  (let (i (index-of line " "))
    (if (< i 0) '() (list [off (+ off i) git-face-hash]))))

(defn- git-fontify-lines
  (lines off line-spans acc)
  "Tail-recursive: accumulate `(line-spans line off)` spans (prepended via `cons`, reversed
once at the end), advancing `off` by each line's length + 1 (the stripped newline).
`cons`+`reverse` rather than `append acc` so fontifying a large diff/log window is O(lines),
not O(lines²) — `append` recopies the whole accumulator each line."
  (if (empty? lines)
    (reverse acc)
    (git-fontify-lines (rest lines)
      (+ off (string/length (first lines)) 1)
      line-spans
      (fold (fn (a span) (cons span a)) acc (line-spans (first lines) off)))))

(defn git-diff-fontify (src)
  "The *git-diff* `:fontify` — colour each unified-diff line (`git-diff-line-face`)."
  (git-fontify-lines (string/split src "\n")
    0
    (fn (l off) (git-whole-line off l (git-diff-line-face l)))
    '()))

(defn git-status-fontify (src)
  "The *git-status* `:fontify` — the header block, section headers (dim counts), colour-coded
file/commit rows, and inline diffs (`git-status-line-spans`)."
  (git-fontify-lines (string/split src "\n") 0 git-status-line-spans '()))

(defn git-log-fontify (src)
  "The *git-log* `:fontify` — the leading commit hash on each row."
  (git-fontify-lines (string/split src "\n") 0 git-log-line-spans '()))

;; ---- running git ------------------------------------------------------------

(defn- git-git
  (root args)
  "Run git in `root` with `args` (a vector); `{:exit :stdout :stderr}`. `core.quotePath=false`
keeps non-ASCII paths literal (no octal escapes) in status / diff output."
  (%os-cmd "git" (into ["-C" root "-c" "core.quotePath=false"] args)))

(defn- git-toplevel
  (dir)
  "The git work-tree root containing `dir`, or nil when `dir` isn't in a repo."
  (let (r (%os-cmd "git" ["-C" dir "rev-parse" "--show-toplevel"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn- git-branch
  (root)
  "The current branch name (or a short hash when detached), `?` on error."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "HEAD"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) "?")))

(defn- git-resolve-root
  (m)
  "The repo root: `:git-root` when already in a git buffer, else `git-toplevel` of the
current file's directory. Returns nil when not in a git repository."
  (or (:git-root m) (git-toplevel (commands/ed-default-dir m))))

;; ---- hunk parsing + patch construction (for hunk-level staging) ------------
;; Magit's defining feature: TAB on a file expands it into individual `@@` hunks, each
;; an actionable row. `s`/`u`/`k` on a hunk row builds a minimal one-hunk patch and pipes
;; it to `git apply --cached` (or its reverse) via `%os-cmd-stdin` — `git apply -` reads
;; the patch from stdin, avoiding any temp file.

(defn- git-finish-hunk
  (acc)
  "Flush the pending hunk (`{:header :lines}`) into `:hunks` and reset the accumulator."
  (if (nil? (:pending-header acc))
    acc
    (assoc acc
      :pending-header nil
      :pending-lines []
      :hunks
        (append (:hunks acc)
          (list {:header (:pending-header acc)
                 :lines (:pending-lines acc)})))))

(defn- git-parse-hunks
  (diff-text)
  "Parse a unified diff into `{:headers [file-header-lines] :hunks [{:header @@-line :lines
body-lines}]}`. Lines before the first `@@` are file headers (diff/index/---/+++ lines);
each `@@`-prefixed line starts a new hunk whose body lines follow. Empty or nil input
gives zero hunks."
  (if (or (nil? diff-text) (= (string/trim diff-text) ""))
    {:headers [] :hunks []}
    (let (result (fold (fn (acc line)
                         (cond
                           (string/starts-with? (string/triml line) "@@")
                             (assoc (git-finish-hunk acc)
                               :pending-header line
                               :pending-lines [])
                           (nil? (:pending-header acc))
                             (assoc acc :headers (append (:headers acc) (list line)))
                           :else
                             (assoc acc :pending-lines (append (:pending-lines acc) (list line)))))
                   {:headers [] :hunks [] :pending-header nil :pending-lines []}
                   (string/split diff-text "\n")))
      (let (final (git-finish-hunk result))
        {:headers (:headers final) :hunks (:hunks final)}))))

(defn- git-hunk-patch
  (parsed hunk)
  "A valid minimal patch for `hunk` alone: the diff file headers + this one hunk's lines,
joined with newlines and **terminated by one** — `git apply` rejects a patch whose final
line has no trailing newline as corrupt. Pass to `git apply --cached` (or `--reverse`) to
stage/unstage just this hunk."
  (str (string/join "\n" (append (:headers parsed) (list (:header hunk)) (:lines hunk)))
    "\n"))

(defn- git-apply-hunk
  (root patch-text cached? reverse?)
  "Pipe `patch-text` to `git apply -` (stdin). `cached?` adds `--cached` (index);
`reverse?` adds `--reverse` (for unstage/discard). Returns `{:exit :stdout :stderr}`."
  (%os-cmd-stdin "git"
    (into ["-C"
            root "-c" "core.quotePath=false" "apply" "--ignore-space-change"]
      (append (if cached? ["--cached"] [])
        (if reverse? ["--reverse"] [])
        ["-"]))
    patch-text))

;; ---- pure: parse `git status --porcelain -z` --------------------------------
;; The NUL-separated form is robust to paths with spaces / quotes / newlines (no quoting, no
;; octal escapes) — git never mangles a filename in `-z`. A rename or copy emits its NEW path
;; in the status token and the OLD source as a separate trailing token, which we consume.

(defn- git-parse-z
  (tokens acc)
  "Walk NUL-split `git status --porcelain -z` tokens into `{:x :y :path}` entries; a rename or
copy (`R`/`C` in the status code) consumes the following token as its source path, keeping the
new path under point."
  (if (empty? tokens)
    (reverse acc)
    (let (t (first tokens))
      (if (< (string/length t) 4)
        (git-parse-z (rest tokens) acc)
        (let (x (string/substring t 0 1)
              y (string/substring t 1 2)
              path (string/substring t 3 (string/length t))
              rename? (or (= x "R") (= x "C")))
          (git-parse-z (if rename? (rest (rest tokens)) (rest tokens))
            (cons {:x x :y y :path path} acc)))))))

(defn- git-entries
  (porcelain)
  "Parse `git status --porcelain -z` output (NUL-separated; a rename/copy carries its source as
a trailing field) into a list of `{:x :y :path}`."
  (git-parse-z (seq/remove empty? (string/split porcelain "\u{0}")) '()))

(defn- git-untracked? (e) (and (= (:x e) "?") (= (:y e) "?")))
(defn- git-staged? (e) (and (not (= (:x e) " ")) (not (= (:x e) "?"))))
(defn- git-unstaged? (e) (and (not (= (:y e) " ")) (not (git-untracked? e))))

;; ---- the status-bar segments (branch + working-tree indicator) --------------
;; The branch and a colour-coded working-tree indicator on the status bar, for **every**
;; buffer in a repo (not just *git-status*). Built off the render path: the idle beat calls
;; `git-cache-status` to recompute the summary + segments and cache them on the model as
;; `:git-segments` (see `input`), which the view lays out (`view/ed-statusbar-segments`).
;; Both segments are clickable (→ `C-x g`) and carry a hover tooltip.

(def *git-branch-glyph* "⎇ ") ; the branch marker; set to "git:" if your font lacks ⎇
(def *git-state-glyph* "●") ; the working-tree state dot
(defn- git-upstream
  (root)
  "The upstream ref (e.g. `origin/main`) of the current branch, or nil when it has none."
  (let (r (git-git root ["rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{u}"]))
    (if (= (:exit r) 0) (string/trim (:stdout r)) nil)))

(defn- git-ahead-behind
  (root)
  "`{:ahead :behind}` commit counts (as strings — tooltip-only) vs the upstream, or nil when
there is no upstream. `--left-right` counts the upstream side (behind) and the HEAD side (ahead)."
  (let (r (git-git root ["rev-list" "--left-right" "--count" "@{u}...HEAD"]))
    (if (not (= (:exit r) 0))
      nil
      (let (parts (seq/remove empty? (string/split (string/trim (:stdout r)) "\t")))
        (if (= (count parts) 2) {:behind (first parts) :ahead (second parts)} nil)))))

(defn git-summary (root)
  "A working-tree summary for the status bar, or nil outside a repo: `{:root :branch :upstream
:ahead :behind :staged :unstaged :untracked}`. Counts come from `git status --porcelain`;
ahead/behind are best-effort strings vs the upstream. A few `git` calls, so it runs off the
render path (the idle beat — `git-cache-status`)."
  (if (nil? root)
    nil
    (let (entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"])))
          upstream (git-upstream root)
          ab (and upstream (git-ahead-behind root)))
      {:root root
       :branch (git-branch root)
       :upstream upstream
       :ahead (and ab (:ahead ab))
       :behind (and ab (:behind ab))
       :staged (count (filter git-staged? entries))
       :unstaged (count (filter git-unstaged? entries))
       :untracked (count (filter git-untracked? entries))})))

(defn- git-basename
  (path)
  "The last path component of `path` (the repo directory name), tolerating a trailing slash."
  (let (parts (seq/remove empty? (string/split path "/")))
    (if (empty? parts) path (last parts))))

(defn- git-dot-face
  (summary)
  "The state-dot colour: yellow when there are unstaged changes (a dirty tree), green when
only staged (ready to commit) or clean."
  (cond
    (> (:unstaged summary) 0) git-face-unstaged
    (> (:staged summary) 0) git-face-staged
    :else git-face-clean))

(defn- git-repo-tooltip
  (summary)
  "The branch segment's hover tooltip: repo name, branch, upstream, and ahead/behind."
  (append [(str "Repo:   " (git-basename (:root summary)))
            (str "Branch: " (:branch summary))]
    (if (:upstream summary)
      [(str "Upstream: " (:upstream summary))
        (str "↑ " (or (:ahead summary) "0") " ahead    ↓ " (or (:behind summary) "0") " behind")]
      ["(no upstream)"])))

(defn- git-tree-tooltip
  (summary)
  "The state-dot segment's hover tooltip: the working-tree counts, or 'clean'."
  (if (and (= (:staged summary) 0) (= (:unstaged summary) 0) (= (:untracked summary) 0))
    ["Working tree clean"]
    [(str "Staged:    " (:staged summary))
      (str "Unstaged:  " (:unstaged summary))
      (str "Untracked: " (:untracked summary))]))

(defn- git-count-seg
  (id prefix n face)
  "A colour-coded count segment (e.g. `+3`), or nil when the count is 0 (so it vanishes)."
  (if (= n 0) nil (seg id (str prefix n) {:sep "  " :face face})))

(defn git-statusbar-segments (summary)
  "The git status-bar segments from `summary` (nil ⇒ `()`): a clickable **branch** segment
(tooltip: repo / upstream / ahead-behind; click: `C-x g`), a **state dot** coloured by the
working tree (tooltip: the counts; click: `C-x g`), then colour-coded **+staged ~unstaged
?untracked** counts, each shown only when non-zero. Pure — built from the cached summary."
  (if (nil? summary)
    '()
    (filter (fn (s) (not (nil? s)))
      (list (seg :git-branch
              (str *git-branch-glyph* (:branch summary))
              {:sep "  —  "
               :face git-face-branch
               :on-click 'git/cmd-git-status
               :tooltip (git-repo-tooltip summary)})
        (seg :git-dot
          *git-state-glyph*
          {:sep "   "
           :face (git-dot-face summary)
           :on-click 'git/cmd-git-status
           :tooltip (git-tree-tooltip summary)})
        (git-count-seg :git-staged "+" (:staged summary) git-face-staged)
        (git-count-seg :git-unstaged "~" (:unstaged summary) git-face-unstaged)
        (git-count-seg :git-untracked "?" (:untracked summary) git-face-untracked)))))

(defn git-cache-status (m)
  "Recompute the cached git status-bar segments (`:git-segments`) + summary (`:git-summary`)
off the loop: resolve the repo root, and in a repo rebuild the summary + segments, else clear
them. Called on the idle beat (`input`), so the branch + working-tree indicator track edits
and git actions a beat after they settle. Outside a repo the segments are `()` (nothing shows).
A **fileless** buffer (*scratch*, *Playground*, a report) shows nothing either, unless it is a
git buffer carrying `:git-root`: it only *inherits* a `:dir` from wherever it was created, and
a buffer that cannot be saved has no working-tree relationship for a branch + dirty-state
indicator to describe."
  (let (root (if (or (:git-root m) (buffer-file (ed-current-buf m))) (git-resolve-root m) nil)
        summary (git-summary root))
    (if (= summary (:git-summary m))
      m
      (assoc m :git-summary summary :git-segments (git-statusbar-segments summary)))))

;; ---- pure: render the status buffer (text + parallel per-line rows) ---------

(defn- git-row
  (e section)
  "The actionable row data for an entry shown in `section` (`:staged` / `:unstaged` /
`:untracked`): `{:path :staged? :untracked?}`."
  {:path (:path e) :staged? (= section :staged) :untracked? (= section :untracked)})

(def- git-label-width 9) ; "untracked" is the widest label
(defn- git-entry-label
  (e section)
  "A human-readable status label for `e` in `section`, matching Magit's file-status display."
  (cond
    (= section :untracked) "untracked"
    (= section :staged)
      (cond
        (= (:x e) "M") "modified"
        (= (:x e) "A") "new file"
        (= (:x e) "D") "deleted"
        (= (:x e) "R") "renamed"
        (= (:x e) "C") "copied"
        :else (str (:x e) (:y e)))
    :else ; unstaged
    (cond
      (= (:y e) "M") "modified"
      (= (:y e) "D") "deleted"
      (= (:y e) "U") "conflict"
      :else (str (:x e) (:y e)))))

(defn- git-hunk-pairs
  (path section parsed)
  "`[line row]` pairs for one expanded section's parsed diff: each `@@` hunk header becomes an
actionable hunk row `{:path :section :hunk? true :hunk-patch}` so s/u/k operate on just that
hunk; its body lines (context, +/- lines) are non-actionable `nil` rows."
  (if (empty? (:hunks parsed))
    (list ["    (no diff)" nil])
    (mapcat (fn (hunk)
              (let (patch (git-hunk-patch parsed hunk)
                    hrow {:path path :section section :hunk? true :hunk-patch patch})
                (append (list [(str "    " (:header hunk)) hrow])
                  (map (fn (l) [(str "    " l) nil]) (:lines hunk)))))
      (:hunks parsed))))

(defn- git-file-pairs
  (e section expanded diffs)
  "`[line row]` pairs for one file in `section`: its `[\"  label   path\" row]` line (with a
human-readable status label rather than raw XY codes), plus — when the path is in `expanded`
— that section's parsed hunks as indented hunk rows and body lines (TAB toggles). Hunk `@@`
lines are actionable; body lines are nil."
  (let (path (:path e)
        label (git-entry-label e section)
        head [(str "  " (string/pad-right label git-label-width) "  " path) (git-row e section)]
        body (if (includes? expanded path)
               (let (parsed (get-in diffs [path section]))
                 (if (nil? parsed)
                   (list ["    (no diff)" nil])
                   (git-hunk-pairs path section parsed)))
               '()))
    (append (list head) body)))

(defn- git-section-pairs
  (title entries section expanded diffs &optional (collapsed '()))
  "`[line row]` pairs for one section (empty when no entries). The title line gets a
`{:section-header section}` row so TAB can detect and collapse it. When `section` is in
`collapsed`, only the header + a blank show (file rows are hidden)."
  (if (empty? entries)
    '()
    (append (list [(str title " (" (count entries) "):") {:section-header section}])
      (if (includes? collapsed section)
        '()
        (mapcat (fn (e) (git-file-pairs e section expanded diffs)) entries))
      (list ["" nil] ["" nil])))) ; a blank rule between sections (Magit's breathing room)
(defn- git-parse-log-oneline
  (stdout)
  "Parse `git log --oneline` output into `({:hash :subject} ...)` — the leading abbreviated
hash (to the first space) and the rest as the subject. Blank output gives `()`."
  (map (fn (line)
         (let (i (index-of line " "))
           {:hash (if (< i 1) line (string/substring line 0 i))
            :subject (if (< i 1) "" (string/substring line (inc i) (string/length line)))}))
    (seq/remove empty? (string/split (string/trim (or stdout "")) "\n"))))

(defn- git-log-commits
  (root args)
  "Run `git log --oneline` with the extra `args` and parse the result (`git-parse-log-oneline`),
returning `()` when the command fails."
  (let (r (git-git root (into ["log" "--oneline"] args)))
    (if (= (:exit r) 0) (git-parse-log-oneline (:stdout r "")) '())))

(def- git-recent-count 10) ; how many recent commits the status buffer lists (Magit's default)
(defn- git-recent-commits
  (root)
  "The most recent commits on HEAD for the status buffer's `Recent commits` section."
  (git-log-commits root [(str "-" git-recent-count)]))

(defn- git-upstream-commits
  (root direction)
  "Commits between HEAD and upstream in `direction` (`:unpushed` → commits ahead of upstream;
`:unpulled` → commits upstream has that HEAD doesn't). Returns `({:hash :subject} ...)`,
or `()` when there is no upstream or the command fails."
  (git-log-commits root [(if (= direction :unpushed) "@{u}..HEAD" "HEAD..@{u}")]))

(defn- git-commit-pairs
  (title commits direction)
  "`[line row]` pairs for an upstream-commit section (Unpushed / Unpulled). The header gets a
`{:section-header direction}` row (TAB collapses); each commit gets a
`{:hash :subject :commit-log? true}` row (RET → `cmd-git-show-diff` shows the full diff)."
  (if (empty? commits)
    '()
    (append (list [(str title " (" (count commits) "):") {:section-header direction}])
      (map (fn (c)
             [(str "  " (:hash c) "  " (:subject c))
               {:hash (:hash c) :subject (:subject c) :commit-log? true}])
        commits)
      (list ["" nil] ["" nil]))))

(def- git-head-label-width 8) ; pads "Head:" / "Merge:" so the branch column aligns
(defn- git-head-line
  (label ref subject)
  "One header line: a left-padded `label` (`Head:` / `Merge:`), the branch/upstream `ref`, then
its commit `subject` (omitted when empty)."
  (str (string/pad-right label git-head-label-width) ref (if (= subject "") "" (str "  " subject))))

(defn- git-head-pairs
  (branch head)
  "The header block `[line row]` pairs: a `Head:` line (branch + latest commit subject) and,
when `head` carries an `:upstream`, a `Merge:` line (upstream + its subject), then one blank.
`head` is `{:subject :upstream :upstream-subject}` (all optional — an empty map just names the
branch, as on a fresh repo)."
  (let (upstream (:upstream head))
    (append (list [(git-head-line "Head:" branch (:subject head "")) nil])
      (if upstream
        (list [(git-head-line "Merge:" upstream (:upstream-subject head "")) nil])
        '())
      (list ["" nil]))))

(defn- git-render
  (branch entries
    &optional
    (expanded '())
    (diffs {})
    (collapsed '())
    (unpushed '())
    (unpulled '())
    (recent '())
    (head {}))
  "`{:text :rows}` for the status buffer. `:rows` is a vector parallel to the buffer's lines —
nil on a blank/body line; `{:section-header section}` on a section title line (TAB collapses);
`{:path :staged? :untracked?}` for a file row; `{:path :section :hunk? true :hunk-patch ...}` for
an inline hunk row; `{:hash :subject :commit-log? true}` for an unpushed/unpulled/recent commit row.
`diffs` is `path → {section → parsed}` from `git-expanded-diffs`; `head` (see `git-head-pairs`)
carries the branch/upstream commit subjects for the header block."
  (let (pairs (append (git-head-pairs branch head)
                (git-section-pairs "Untracked files"
                  (filter git-untracked? entries)
                  :untracked expanded
                  diffs
                  collapsed)
                (git-section-pairs "Unstaged changes"
                  (filter git-unstaged? entries)
                  :unstaged expanded
                  diffs
                  collapsed)
                (git-section-pairs "Staged changes"
                  (filter git-staged? entries)
                  :staged expanded
                  diffs
                  collapsed)
                (if (empty? entries)
                  (list ["nothing to commit, working tree clean" nil] ["" nil])
                  '())
                (git-commit-pairs "Unpushed to upstream" unpushed :unpushed)
                (git-commit-pairs "Unpulled from upstream" unpulled :unpulled)
                (git-commit-pairs "Recent commits" recent :recent)))
    {:text (string/join "\n" (map first pairs)) :rows (into [] (map second pairs))}))

(defn- git-row-section
  (row)
  "Which section a status row belongs to — `:untracked` / `:staged` / `:unstaged` — or nil for
section-header, commit-log, blank, and inline-diff rows. Hunk rows carry their section explicitly."
  (cond
    (nil? row) nil
    (:section-header row) nil
    (:commit-log? row) nil
    (:hunk? row) (:section row)
    (:untracked? row) :untracked
    (:staged? row) :staged
    :else :unstaged))

(defn- git-file-row?
  (row)
  "True for a plain file row (`{:path :staged? :untracked?}`), distinguishing it from section-header,
hunk, commit-log, and nil rows."
  (and (not (nil? row))
    (nil? (:section-header row))
    (not (:hunk? row))
    (not (:commit-log? row))))

(defn- git-section-lines
  (rows section)
  "The 0-based line indices of the file rows in `section`, top to bottom (parallel to the
buffer's lines, the same indexing `git-row-at` uses)."
  (get (fold (fn (acc r)
               {:i (inc (:i acc))
                :ls (if (= (git-row-section r) section)
                      (append (:ls acc) (list (:i acc)))
                      (:ls acc))})
         {:i 0 :ls '()}
         rows)
    :ls))

;; ---- the status buffer + the per-row reader ---------------------------------

(defn- git-sections-of
  (e)
  "The sections an entry appears in. A file with both staged and unstaged changes is in two, so
its diff is fetched (and shown) once per section."
  (append (if (git-staged? e) (list :staged) '())
    (if (git-unstaged? e) (list :unstaged) '())
    (if (git-untracked? e) (list :untracked) '())))

(defn- git-diff-args
  (section path)
  "The `git diff` argv for `path` in `section`: the staged diff (`--cached`), the working-tree
diff, or — for an untracked file — its whole content as additions (`--no-index` vs /dev/null)."
  (cond
    (= section :staged) ["diff" "--cached" "--" path]
    (= section :untracked) ["diff" "--no-index" "--" "/dev/null" path]
    :else ["diff" "--" path]))

(defn- git-expanded-diffs
  (root entries expanded)
  "`{path → {section → parsed}}` for each expanded file, where `parsed` is the
`{:headers :hunks}` map from `git-parse-hunks`. One diff per section (staged row shows its
`--cached` diff, unstaged row the working-tree diff). Each fetch is done once."
  (fold (fn (acc e)
          (let (path (:path e))
            (if (includes? expanded path)
              (fold (fn (a section)
                      (assoc-in a
                        [path section]
                        (git-parse-hunks (get (git-git root (git-diff-args section path))
                                           :stdout ""))))
                acc
                (git-sections-of e))
              acc)))
    {}
    entries))

(defn- git-visible-expanded
  (prev-rows expanded top vrows)
  "The paths from `expanded` whose file row falls within one viewport of `[top, top+vrows)` in
`prev-rows` (the rows from the most recent render), plus any path not yet in `prev-rows` (newly
expanded — always fetch). When `prev-rows` is empty (first render), returns all of `expanded`.
The one-viewport margin above and below makes scrolling feel instant."
  (if (empty? prev-rows)
    expanded
    (let (lo (math/max 0 (- top vrows))
          hi (+ top (* 2 vrows)))
      (filter (fn (path)
                (let (i (seq/index-where (fn (r) (and r (= (:path r) path))) prev-rows))
                  (or (< i 0) (and (>= i lo) (< i hi)))))
        expanded))))

(defn- git-show-status
  (m root &optional (line nil))
  "Build/refresh `*git-status*` for repo `root`, recording `:git-root`/`:git-rows`. `line`
places point: a 1-based number, nil (default — the first file row if any, else the top), or a
function `(rows -> 1-based line)` resolved against the freshly-rendered rows (see
`git-stay-in-section`). Respects `:git-expanded`, `:git-collapsed-sections`, and — when an
upstream exists — fetches unpushed/unpulled commits to show at the bottom. Only expands diffs
for files visible within the current viewport (`ed-current-top` + `:view-rows`), so a repo
with many expanded files stays fast regardless of how many are off-screen."
  (let (porcelain (:stdout (git-git root ["status" "--porcelain" "-z"]) "")
        entries (git-entries porcelain)
        expanded (:git-expanded m '())
        collapsed (:git-collapsed-sections m '())
        top (model/ed-current-top m)
        vrows (or (:view-rows m) 40)
        vis-expanded (git-visible-expanded (:git-rows m '()) expanded top vrows)
        diffs (git-expanded-diffs root entries vis-expanded)
        upstream (git-upstream root)
        unpushed (if upstream (git-upstream-commits root :unpushed) '())
        unpulled (if upstream (git-upstream-commits root :unpulled) '())
        recent (git-recent-commits root)
        head {:subject (if (empty? recent) "" (:subject (first recent) ""))
              :upstream upstream
              :upstream-subject (if upstream
                                  (let (cs (git-log-commits root ["-1" upstream]))
                                    (if (empty? cs) "" (:subject (first cs) "")))
                                  "")}
        r (git-render (git-branch root)
            entries expanded diffs collapsed unpushed unpulled recent head)
        rows (:rows r)
        target (cond
                 (fn? line) (line rows)
                 (nil? line) (git-first-row-line rows)
                 :else line)
        m1 (ed-show-named (assoc m :git-root root :git-rows rows)
             "*git-status*"
             (:text r)
             :git-status)
        ;; stash the off-text line→location map on the buffer so the SHARED
        ;; `results/line-links-loc` makes each file row a clickable link — pointer cursor +
        ;; hover underline + click/RET → the file — the exact mechanism *Tests* uses.
        gi (ed-buffer-index-by-name m1 "*git-status*")
        m2 (if (nil? gi)
             m1
             (update m1
               :buffers assoc
               gi
               (assoc (ed-buf-at m1 gi) :line-links (git-status-line-links rows root)))))
    (ed-apply m2 (fn (b) (commands/ed-goto-line b target)))))

(defn- git-status-line-links
  (rows root)
  "The 0-based-line → `{:file :line}` map for *git-status*: every plain file row links to its
file (line 1); section-header / hunk / commit-log rows link to nothing. Read by the shared
`results/line-links-loc` `:line-loc`."
  (fold (fn (acc i)
          (let (row (nth rows i))
            (if (git-file-row? row)
              (assoc acc i {:file (path/join root (:path row)) :line 1})
              acc)))
    {}
    (range (count rows))))

(defn- git-first-row-line
  (rows)
  "The 1-based line of the first file row in `rows` (skipping section-header rows), or 1 if none."
  (let (i (seq/index-where git-file-row? rows))
    (if (< i 0) 1 (inc i))))

(defn- git-row-at
  (m)
  "The `{:path :staged? :untracked?}` on the current `*git-status*` line, or nil on a
header/blank."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (and rows (>= i 0) (< i (count rows))) (nth rows i) nil)))

(defn- git-stay-in-section
  (m)
  "A `(new-rows -> 1-based line)` for `git-show-status` that keeps point in the section of the
row currently under point, across a rebuild: on whatever file slides into its slot — the next
file, the section's last when it was the bottom one, or the first actionable row if the section
emptied. When point isn't on a file row (a header / blank / inline-diff line) it keeps the
literal line. This is the single cursor policy every refresh shares, so the commands that move
the file under point out of its section (stage / unstage / discard) land on the next file to act
on instead of chasing it into another section, while a plain refresh / expand stays put."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m))
        section (git-row-section (git-row-at m)))
    (if (nil? section)
      (fn (new-rows)
        (let (target (math/min (inc i) (dec (count new-rows))))
          (if (and (not (= (count new-rows) (count rows)))
                (nil? (get new-rows (dec target))))
            (git-first-row-line new-rows)
            target)))
      (let (before (count (filter (fn (j) (< j i)) (git-section-lines rows section))))
        (fn (new-rows)
          (let (ls (git-section-lines new-rows section))
            (if (empty? ls)
              (git-first-row-line new-rows)
              (inc (nth ls (math/min before (dec (count ls))))))))))))

(defn- git-refresh
  (m)
  "Refresh `*git-status*` in place, keeping point in its section (`git-stay-in-section`)."
  (git-show-status m (:git-root m) (git-stay-in-section m)))

(defn- git-scan-rows
  (rows j dir n)
  "From 0-based position `j`, step `dir` (+1 or -1) `n` times, skipping nil (blank/diff-body)
rows. Returns the clamped 1-based landing line. Section-header, file, hunk, and commit-log
rows are all navigable; only nil rows are skipped."
  (if (= n 0)
    (inc j)
    (let (j2 (+ j dir))
      (cond
        (< j2 0) (inc j)
        (>= j2 (count rows)) (inc j)
        (nil? (nth rows j2)) (git-scan-rows rows j2 dir n)
        :else (git-scan-rows rows j2 dir (dec n))))))

;; ---- commands: open / navigate / stage / unstage / discard / refresh / quit -

(defcommand cmd-git-status
  (m key)
  "Open the git status buffer for the current project (C-x g). Files start collapsed; TAB on a
file expands its diff inline."
  (let (root (git-toplevel (commands/ed-default-dir m)))
    (if (nil? root) (message m "not in a git repository") (git-show-status m root))))

(defcommand cmd-git-next-item
  (m key)
  "Jump to the next actionable row — file, hunk, commit, or section header — skipping inline
diff body lines (n). Falls back to line-by-line motion outside a status buffer."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (nil? rows)
      (commands/cmd-next-line m key)
      (ed-apply m (fn (b) (commands/ed-goto-line b (git-scan-rows rows i 1 1)))))))

(defcommand cmd-git-prev-item
  (m key)
  "Jump to the previous actionable row — file, hunk, commit, or section header — skipping
inline diff body lines (p)."
  (let (rows (:git-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (nil? rows)
      (commands/cmd-previous-line m key)
      (ed-apply m (fn (b) (commands/ed-goto-line b (git-scan-rows rows i -1 1)))))))

(defcommand cmd-git-stage
  (m key)
  "Stage the file or hunk on the current line (s). Hunk row: `git apply --cached` with just
that hunk's patch. File row: `git add -- <path>`. Section header or commit row: no-op."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) (message m "press S to stage all, or move to a specific file")
      (:commit-log? row) m
      (:hunk? row)
        (let (r (git-apply-hunk root (:hunk-patch row) true false))
          (if (= (:exit r) 0)
            (git-refresh m)
            (git-report-cmd m "stage hunk" r)))
      :else
        (let (r (git-git root ["add" "--" (:path row)]))
          (if (= (:exit r) 0)
            (git-refresh m)
            (git-report-cmd m "stage" r))))))

(defcommand cmd-git-stage-all
  (m key)
  "Stage all tracked modified files (S) — `git add -u`."
  (let (root (:git-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["add" "-u"]))
        (if (= (:exit r) 0)
          (git-refresh m)
          (git-report-cmd m "stage all" r))))))

(defcommand cmd-git-unstage
  (m key)
  "Unstage the file or hunk on the current line (u). Hunk row: `git apply --cached --reverse`
with just that hunk. File row: `git reset HEAD -- <path>`. Section header or commit row: no-op."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) (message m "press U to unstage all, or move to a specific file")
      (:commit-log? row) m
      (:hunk? row)
        (let (r (git-apply-hunk root (:hunk-patch row) true true))
          (if (= (:exit r) 0)
            (git-refresh m)
            (git-report-cmd m "unstage hunk" r)))
      :else
        (let (r (git-git root ["reset" "-q" "HEAD" "--" (:path row)]))
          (if (= (:exit r) 0)
            (git-refresh m)
            (git-report-cmd m "unstage" r))))))

(defcommand cmd-git-unstage-all
  (m key)
  "Unstage all staged changes (U) — `git reset HEAD`."
  (let (root (:git-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["reset" "HEAD"]))
        (if (= (:exit r) 0)
          (git-refresh m)
          (git-report-cmd m "unstage all" r))))))

(defcommand cmd-git-discard
  (m key)
  "Discard the working-tree changes to the file or hunk on the current line (k), after
confirmation. Hunk row: `git apply --reverse`. File row: `git checkout -- <path>`.
Section headers, commit rows, and untracked files are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) (message m "not on a file or hunk")
      (:section-header row) m
      (:commit-log? row) m
      (:untracked? row) (message m "untracked file — remove it from a shell, not here")
      (:hunk? row)
        (ed-read-char m
          "Discard hunk? (y/n) "
          (fn (mm c)
            (if (or (= c "y") (= c "Y"))
              (let (r (git-apply-hunk root (:hunk-patch row) false true))
                (if (= (:exit r) 0)
                  (git-refresh mm)
                  (git-report-cmd mm "discard hunk" r)))
              (message mm "discard cancelled"))))
      :else
        (ed-read-char m
          (str "Discard changes to " (:path row) "? (y/n) ")
          (fn (mm c)
            (if (or (= c "y") (= c "Y"))
              (let (r (git-git root ["checkout" "--" (:path row)]))
                (if (= (:exit r) 0)
                  (git-refresh mm)
                  (git-report-cmd mm "discard" r)))
              (message mm "discard cancelled")))))))

(defcommand cmd-git-refresh
  (m key)
  "Re-read git status (g)."
  (git-refresh m))

(defcommand cmd-git-expand
  (m key)
  "TAB: on a section header, toggle the section's collapse (`:git-collapsed-sections`); on a
file row, toggle its inline diff. Hunk, commit-log, and blank rows are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row)
        (let (sec (:section-header row)
              cols (:git-collapsed-sections m '())
              cols2 (if (includes? cols sec)
                      (seq/remove (fn (s) (= s sec)) cols)
                      (cons sec cols)))
          (git-show-status (assoc m :git-collapsed-sections cols2) root (git-stay-in-section m)))
      (or (:hunk? row) (:commit-log? row)) m
      :else
        (let (path (:path row)
              exp (:git-expanded m '())
              exp2 (if (includes? exp path)
                     (seq/remove (fn (p) (= p path)) exp)
                     (cons path exp)))
          (git-show-status (assoc m :git-expanded exp2) root (git-stay-in-section m))))))

(defcommand cmd-git-visit
  (m key)
  "Visit (open) the file on the current line — bound to a mouse click. Section headers,
commit-log rows, and blank lines are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row) m
      (:commit-log? row) m
      ;; next-error discipline (shared with *Tests*/*Run*/compilation): the file
      ;; opens in another pane, the *git-status* buffer stays visible
      :else (commands/ed-pop-to-file m (path/join root (:path row)) 1))))

(defcommand cmd-git-quit
  (m key)
  "Bury the git status buffer (q)."
  (cmd-kill-buffer m key))

;; ---- a read-only report buffer (diff / log) ---------------------------------

(defn- git-show-report
  (m name text type &optional (opts {:action :here}))
  "Show `text` in a read-only report buffer `name` of `type` (e.g. *git-diff*, *git-log*),
point at the top. `opts` routes through `ed-display-buffer` (default `{:action :here}` — replace
the current pane); pass `{:action :pop}` to open it in another pane and jump there. Keeps
`:git-root` for follow-up commands."
  (ed-apply (commands/ed-display-buffer m name (if (= text "") "(empty)" text) type opts)
    (fn (b) (commands/ed-goto-line b 1))))

(defn- git-report-cmd
  (m verb r)
  "Echo the result of a git command `r` (`verb` names it), preferring stderr then stdout;
falls back to the exit code when both streams are empty."
  (let (e (string/trim (:stderr r ""))
        raw (if (= e "") (string/trim (:stdout r "")) e)
        out (one-line (if (= raw "") (str "exit " (:exit r)) raw)))
    (message m (str verb (if (= (:exit r) 0) ": " " failed: ") out))))

(defcommand cmd-git-diff
  (m key)
  "Show a diff in *git-diff*, replacing the current pane (d): the file on the current line — a
staged row's `--cached` diff, an unstaged row's working-tree diff, an untracked file's contents
— or, on a section header / blank line, the whole working tree vs HEAD."
  (let (row (git-row-at m)
        root (:git-root m)
        args (if (nil? row) ["diff" "HEAD"] (git-diff-args (git-row-section row) (:path row)))
        r (git-git root args))
    (if (>= (:exit r) 2)
      (git-report-cmd m "git diff" r)
      (git-show-report (assoc m :git-root root) "*git-diff*" (:stdout r "") :git-diff))))

(defcommand cmd-git-show-diff
  (m key)
  "RET in `*git-status*`: on a commit-log row (unpushed / unpulled), run `git show <hash>` in
`*git-show*`; on a file / hunk row, preview its diff in `*git-diff*` to the right. Section
headers and blank lines are no-ops."
  (let (row (git-row-at m) root (:git-root m))
    (cond
      (nil? row) m
      (:section-header row) m
      (:commit-log? row)
        (let (r (git-git root ["show" "--stat" "-p" (:hash row)]))
          (if (not (= (:exit r) 0))
            (git-report-cmd m "git show" r)
            (git-show-report (assoc m :git-root root)
              "*git-show*"
              (:stdout r "")
              :git-diff)))
      :else
        (let (r (git-git root (git-diff-args (git-row-section row) (:path row)))
              out (:stdout r ""))
          (if (>= (:exit r) 2)
            (git-report-cmd m "git diff" r)
            (ed-show-named-aside (assoc m :git-root root)
              "*git-diff*"
              (if (= (string/trim out) "") "(empty)" out)
              :git-diff))))))

(defcommand cmd-vc-diff
  (m key)
  "Show the current file's changes vs HEAD in *git-diff* (C-x v =) — works from any file
buffer, no need to open the status buffer first."
  (let (file (buffer-file (ed-current-buf m)))
    (if (nil? file)
      (message m "no file to diff")
      (let (root (git-toplevel (path/dirname file)))
        (if (nil? root)
          (message m "not in a git repository")
          (let (r (git-git root ["diff" "HEAD" "--" file]))
            (if (= (string/trim (:stdout r "")) "")
              (message m "no changes vs HEAD")
              ;; launched from your own file — pop the diff into another pane and jump to it,
              ;; leaving your file visible in the pane you came from
              (git-show-report (assoc m :git-root root)
                "*git-diff*"
                (:stdout r "")
                :git-diff {:action :pop}))))))))

(defn- git-log-line-hash
  (line)
  "The abbreviated commit hash at the start of a `git log --oneline` line (up to the first
space), or nil when the line is blank or not a commit line."
  (let (i (index-of line " "))
    (if (< i 1) nil (string/substring line 0 i))))

(defcommand cmd-git-show-commit
  (m key)
  "Show the full diff of the commit on the current log line (RET in *git-log*)."
  (let (root (:git-root m)
        buf (ed-current-buf m)
        line-i (buffer-current-line buf)
        lines (string/split (buffer-text buf) "\n")
        hash (and (>= line-i 0)
               (< line-i (count lines))
               (git-log-line-hash (nth lines line-i))))
    (if (nil? hash)
      (message m "not on a commit line")
      (let (r (git-git root ["show" "--stat" "-p" hash]))
        (if (not (= (:exit r) 0))
          (git-report-cmd m "git show" r)
          (git-show-report (assoc m :git-root root)
            "*git-show*"
            (:stdout r "")
            :git-diff))))))

(defcommand cmd-git-log
  (m key)
  "Show the recent commit log in *git-log* (l). RET on a line shows that commit's diff."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["log" "--oneline" "--decorate" "-30"]))
        ;; open the log in another pane (pop-to-buffer), keeping your working buffer visible
        (git-show-report (assoc m :git-root root)
          "*git-log*"
          (:stdout r "")
          :git-log {:action :pop})))))

;; ---- push / pull (synchronous; report in the echo area) ---------------------

(defcommand cmd-git-push
  (m key)
  "Push the current branch (P)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (git-report-cmd m "push" (git-git root ["push"])))))

(defcommand cmd-git-pull
  (m key)
  "Pull the current branch, then refresh status (F)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["pull" "--ff-only"]))
        (git-report-cmd (if (nil? (:git-rows m)) m (git-show-status m root)) "pull" r)))))

;; ---- stash (z z / z p) -------------------------------------------------------

(defcommand cmd-git-stash
  (m key)
  "Stash working-tree changes (z z) — `git stash push`. Refreshes status on success."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["stash" "push"]))
        (git-report-cmd (if (nil? (:git-rows m)) m (git-refresh m)) "stash" r)))))

(defcommand cmd-git-stash-pop
  (m key)
  "Pop the latest stash onto the working tree (z p) — `git stash pop`. Refreshes on success."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["stash" "pop"]))
        (git-report-cmd (if (nil? (:git-rows m)) m (git-refresh m)) "stash pop" r)))))

;; ---- branch checkout / create (b b / b c) -----------------------------------

(defcommand cmd-git-checkout
  (m key)
  "Checkout a branch with minibuffer completion over all local and remote branches (b b)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["branch" "-a" "--format=%(refname:short)"]))
        (if (not (= (:exit r) 0))
          (git-report-cmd m "git branch" r)
          (let (branches (seq/remove empty? (string/split (string/trim (:stdout r "")) "\n")))
            (assoc m
              :minibuffer
                (commands/ed-name-prompt "Checkout branch: "
                  branches
                  (fn (mm branch)
                    (let (r2 (git-git root ["checkout" branch]))
                      (git-report-cmd (if (= (:exit r2) 0)
                                        (git-show-status mm root)
                                        mm)
                        "checkout" r2)))))))))))

(defcommand cmd-git-create-branch
  (m key)
  "Create and checkout a new branch, prompting for its name (b c)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (assoc m
        :minibuffer
          (commands/ed-name-prompt "New branch name: "
            '()
            (fn (mm name)
              (if (= (string/trim name) "")
                (message mm "branch name cannot be empty")
                (let (r (git-git root ["checkout" "-b" (string/trim name)]))
                  (git-report-cmd (if (= (:exit r) 0)
                                    (git-show-status mm root)
                                    mm)
                    "create branch" r)))))))))

;; ---- commit (an editable message buffer; C-c C-c / C-c C-k) -----------------

(defn- git-commit-message
  (text)
  "The commit message from the *git-commit* buffer text — comment lines (leading `#`) dropped
and the rest trimmed."
  (string/trim (string/join "\n"
                 (seq/remove (fn (l) (string/starts-with? (string/triml l) "#"))
                   (string/split text "\n")))))

(defcommand cmd-git-commit
  (m key)
  "Open an editable *git-commit* buffer; C-c C-c commits the staged changes, C-c C-k aborts (c)."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (ed-show-named (assoc m :git-root root :git-amend? nil)
        "*git-commit*"
        "\n# Enter a commit message above. C-c C-c to commit, C-c C-k to cancel.\n# Lines starting with # are ignored."
        :git-commit))))

(defcommand cmd-git-commit-amend
  (m key)
  "Open *git-commit* pre-populated with the last commit message for amending (a). C-c C-c
runs `git commit --amend`; C-c C-k aborts."
  (let (root (git-resolve-root m))
    (if (nil? root)
      (message m "not in a git repository")
      (let (r (git-git root ["log" "-1" "--format=%B"]))
        (if (not (= (:exit r) 0))
          (message m "no commits yet to amend")
          (ed-show-named (assoc m :git-root root :git-amend? true)
            "*git-commit*"
            (str (string/trim (:stdout r))
              "\n# Amending the last commit. C-c C-c to commit --amend, C-c C-k to cancel.\n# Lines starting with # are ignored.")
            :git-commit))))))

(defcommand cmd-git-commit-finish
  (m key)
  "Commit the staged changes with this buffer's message (C-c C-c). If `:git-amend?` is set,
runs `git commit --amend` to rewrite the last commit."
  (let (root (:git-root m)
        msg (git-commit-message (buffer-text (ed-current-buf m)))
        amend? (:git-amend? m))
    (cond
      (nil? root) (message m "no git repo")
      (= msg "") (message m "empty commit message — aborted")
      :else
        (let (args (append ["commit" "-m" msg] (if amend? ["--amend"] []))
              r (git-git root args)
              m1 (cmd-kill-buffer (assoc m :git-amend? nil) key))
          (if (= (:exit r) 0)
            (message (git-show-status m1 root)
              (str (if amend? "amended: " "committed: ") (one-line (:stdout r))))
            (message m1 (str "commit failed: " (one-line (str (:stdout r) " " (:stderr r))))))))))

(defcommand cmd-git-commit-abort
  (m key)
  "Abort the commit and close the message buffer (C-c C-k)."
  (message (cmd-kill-buffer (assoc m :git-amend? nil) key) "commit aborted"))
