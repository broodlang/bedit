                         {:key "-a" :kind :switch :arg "--all" :label "ignored files too"}]}
             {:title "Stash"
              :suffixes [{:key "z" :kind :command :command 'git/cmd-git-stash :label "everything"}
                          {:key "i"
                           :kind :command
