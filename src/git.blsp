;; ---- resolving a conflict (o / T on an unmerged file) ------------------------
;; The two resolutions that cannot be typed into the file: "keep the version that was
;; already here" and "keep the version that came in". Everything else is editing, which
;; the editor already does — `e` opens the file at its first conflict, where `C-c ^` keeps
;; one side of each hunk (`smerge`), and `s` here marks it resolved.
;;
;; `--ours` and `--theirs` are notoriously backwards during a REBASE: git replays your
;; commits onto the other branch, so "ours" is the branch you are rebasing onto and
;; "theirs" is your own work. The labels below say which is which by what it MEANS at the
;; time, not by which flag it passes, because the flag is the part that misleads.

(defn- git-resolve-with (m side)
  "Resolve the unmerged file at point by taking one whole side, then stage it — `git
checkout --ours|--theirs -- <path>` followed by `git add`, which is what marks it resolved.
Without the add it would still be listed as unmerged and the rebase would not continue."
  (let (f (git-file-at m))
    (cond
      (nil? f) (message m "not on a file")
      (not (= (:section f) :unmerged)) (message m "this file is not conflicted")
      :else
        (let (path (:path f)
              root (git-resolve-root m)
              [m1 r] (git-run (assoc m :git-root root) ["checkout" (str "--" side) "--" path]))
          (if (= (:exit r) 0)
            (git-act m1 "add" ["add" "--" path])
            (git-report-cmd m1 (str "checkout --" side) r))))))

(defcommand cmd-git-take-ours
  (m key)
  "Resolve the conflict at point by keeping the side that was already here (o) — the
branch you are merging INTO, or during a rebase the branch you are rebasing ONTO."
  (git-resolve-with m "ours"))

(defcommand cmd-git-take-theirs
  (m key)
  "Resolve the conflict at point by keeping the side that came in (T) — the branch being
merged, or during a rebase your own commit being replayed."
  (git-resolve-with m "theirs"))

(defcommand cmd-git-resolve-in-file
  (m key)
  "Open the conflicted file at point at its first conflict (e) — Magit's ediff, done the
smerge way: `C-c ^ u` / `C-c ^ l` / `C-c ^ a` keep the upper, the lower or both sides of
the conflict at point, `C-c ^ n` / `C-c ^ p` move between them."
  (let (f (git-file-at m)
        root (git-resolve-root m))
    (if (or (nil? f) (nil? root))
      (message m "not on a file")
      (let (m1 (commands/ed-pop-to-file m (path/join root (:path f)) 1))
        (if (= (:section f) :unmerged) (git-smerge-next m1) m1)))))

;; ---- commit (c) ----------------------------------------------------------------
;; `--no-verify` is the flag you want at the exact moment you cannot remember how to pass
;; it, because a hook is refusing a commit you need to make.

(def git-commit-transient
  {:name 'git-commit
   :title "Commit"
   :groups [{:title "Arguments"
             :suffixes [{:key "-a"
                         :kind :switch
                         :arg "--all"
                         :label "stage every tracked change first"}
                         {:key "-e"
                          :kind :switch
                          :arg "--allow-empty"
                          :label "allow an empty commit"}
                         {:key "-n"
                          :kind :switch
                          :arg "--no-verify"
                          :label "skip the pre-commit hooks"}
                         {:key "-s"
                          :kind :switch
                          :arg "--signoff"
                          :label "add a Signed-off-by line"}
                         {:key "-S" :kind :switch :arg "--gpg-sign" :label "sign it"}
                         {:key "-R"
                          :kind :switch
                          :arg "--reset-author"
                          :label "claim authorship, reset the date"}
                         {:key "=A"
                          :kind :option
                          :arg "--author="
                          :label "author"
                          :prompt "Author (Name <email>)"}]}
             {:title "Create"
              :suffixes [{:key "c" :kind :command :command 'git/cmd-git-commit :label "commit"}]}
             {:title "Edit HEAD"
              :suffixes [{:key "e"
                          :kind :command
                          :command 'git/cmd-git-commit-extend
                          :label "extend — add what is staged, keep the message"}
                          {:key "w"
                           :kind :command
                           :command 'git/cmd-git-commit-reword
                           :label "reword — the message only"}
                          {:key "a"
                           :kind :command
                           :command 'git/cmd-git-commit-amend
                           :label "amend — both"}]}
             {:title "Edit an earlier commit"
              :suffixes [{:key "f" :kind :command :command 'git/cmd-git-commit-fixup :label "fixup"}
                          {:key "s"
                           :kind :command
                           :command 'git/cmd-git-commit-squash
                           :label "squash"}
                          {:key "F"
                           :kind :command
                           :command 'git/cmd-git-commit-instant-fixup
                           :label "fixup, and fold it in now"}
                          {:key "S"
                           :kind :command
                           :command 'git/cmd-git-commit-instant-squash
                           :label "squash, and fold it in now"}]}]})

(defcommand cmd-git-commit-menu
  (m key)
  "The commit menu (c)."
  (transient/ed-transient-open m git-commit-transient))

(defcommand cmd-git-commit-extend
  (m key)
  "Add the staged changes to the last commit WITHOUT opening its message (c e) — Magit's
`--amend --no-edit`, the one you want when you forgot a file."
  (git-act m
    "commit --amend --no-edit"
    (append git-no-editor
      (append ["commit" "--amend" "--no-edit"] (transient/ed-transient-args m)))))

