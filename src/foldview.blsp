(defmodule foldview
  "A folded line shows that it folds: ` …` after its text, in the face a truncated line's
ellipsis has, as Emacs's hideshow and Org show one. A `:with-text` pane layer, so it scrolls
and is memoised with the text; the folds themselves are `folds`'."
  (:use editor/buffer) ; buffer-rope
  (:use editor/display :only [text]) ; the ellipsis
  (:use model) ; register-pane-layer
  (:use theme :only [face-truncation])) ; the ellipsis face, a truncated line's

(def- *fold-ellipsis* " …")

(defn fold-marker-ops (m pane buf geometry)
  "The pane layer: ` …` past the end of every folded line the pane shows."
  (let (rope (buffer-rope buf)
        text-left (first (panegeometry/geometry-span geometry :text)))
    (seq/keep (folds/folded-lines buf)
      (fn (line)
        (let (line-end (dec (if (< (inc line) (text/line-count rope))
                              (text/line->char rope (inc line))
                              (inc (count rope))))
              cell (panegeometry/ed-position-cell buf geometry line-end))
          (when cell
            (let ([row column] cell)
              (text (+ (:y geometry) row) (+ text-left column) *fold-ellipsis* face-truncation))))))))

(defn fold-marker-deps (m pane buf)
  "What the layer reads besides the text: which lines are folded."
  (folds/folded-lines buf))

(register-pane-layer :fold-markers
  {:rank 20 :slot :with-text :run 'foldview/fold-marker-ops :deps 'foldview/fold-marker-deps})
