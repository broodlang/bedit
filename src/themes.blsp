(defmodule themes
  "The theme registry (`M-x theme-select`): a live picker over full **colour themes** — each
swaps the whole palette (background, foreground, accents, syntax) via `theme/theme-apply!`
AND sets the window font. So switching to a light theme (Catppuccin Latte) really does turn
the editor light; the chrome, syntax, menus and window background all follow. A theme is a
plain map, so adding one is data. Font paths are this machine's for now; a portable version
would bundle the faces or read `(config :themes …)`."
  (:use interactive) ; defcommand — register theme-select for M-x
  (:use commands) ; ed-name-prompt — the Vertico selection prompt
  (:use theme) ; theme-apply! + the Mocha palette
  (:use model)) ; message — the echo-area status
;; A clean, light coding face for every theme (the bundled DejaVu is heavy). Registered on
;; apply; a missing style falls back to :regular.
(def *hack*
  {:regular "/usr/share/fonts/truetype/hack/Hack-Regular.ttf"
   :bold "/usr/share/fonts/truetype/hack/Hack-Bold.ttf"
   :italic "/usr/share/fonts/truetype/hack/Hack-Italic.ttf"
   :bold-italic "/usr/share/fonts/truetype/hack/Hack-BoldItalic.ttf"})

;; ---- palettes (role -> "#rrggbb", the 16 tokens theme/theme-apply! rebinds) --

