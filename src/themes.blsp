(def *themes*
  ;; display name -> {:palette <map> :font <keyword> :files <map|nil> :height px}.
  ;; The bundled STANDARD set — always available, no dependency. A theme *plugin*
  ;; (`:enhances bedit`, `nest add`ed) appends more of these on startup via
  ;; `register-theme!` (src/plugins.blsp), so this is the built-in floor, not the ceiling.
  [{:name "Catppuccin Mocha" :palette theme/*theme-mocha* :font :hack :files *hack* :height 15}
    {:name "Tokyo Night" :palette *tokyo* :font :hack :files *hack* :height 15}
    {:name "Nord" :palette *nord* :font :hack :files *hack* :height 15}
    {:name "Gruvbox Dark" :palette *gruvbox* :font :hack :files *hack* :height 15}
    {:name "Solarized Dark" :palette *solarized* :font :hack :files *hack* :height 15}
    {:name "One Dark" :palette *onedark* :font :hack :files *hack* :height 15}
    {:name "Everforest" :palette *everforest* :font :hack :files *hack* :height 15}
    {:name "Catppuccin Latte (light)" :palette *latte* :font :hack :files *hack* :height 15}])

(defn register-theme! (entry)
  "Add a theme `entry` to the live picker registry (`M-x theme-select`). A plugin
package supplies just `{:name :palette}` — the font/size default to the bundled Hack
face here, so a theme plugin ships only a palette (pure data, no font paths). Re-registering
the same `:name` REPLACES it in place, so a plugin reload (or a live redefine) doesn't
double the list. This is a global rebind of `*themes*` — the same live-redefine model the
rest of this file documents — so the new theme shows on the picker's next open.

Backs `packages/apply-plugin!` (folding in an installed `:enhances bedit` package) and is
equally a public seam for `init.blsp` or a `C-x C-e` one-off."
  (let (full (merge {:font :hack :files *hack* :height 15} entry)
        others (filter *themes* (fn (t) (not (= (:name t) (:name full))))))
    (def *themes* (conj (vec others) full))))

(defn unregister-theme! (name)
  "Remove the theme named `name` from the live picker registry — a plugin being removed at
runtime (`packages/unapply-plugin!`), so its theme leaves `M-x theme-select`. A global rebind
of `*themes*` like `register-theme!`; a no-op when no such theme is registered."
  (def *themes* (vec (filter *themes* (fn (t) (not (= (:name t) name)))))))

(defn- themes-by-name (name)
  (first (filter *themes* (fn (t) (= (:name t) name)))))

(defn themes-names () (map *themes* (fn (t) (:name t))))

(defn themes-apply (m name)
  "Apply the theme `name` live: swap the whole palette + window background (`theme-apply!`)
and set the font (`gui/font`), both through `gui-only` so a headless run is a no-op and anything else raises.
Returns the model with an echo status."
  (let (t (themes-by-name name))
    (if (nil? t)
      (message m (str "no such theme: " name))
      (do
        (theme/theme-apply! (:palette t))
        (when (:files t) (gui-only gui/font-register (:font t) (:files t)))
        (gui-only gui/font {:family (:font t) :height (:height t)})
        (message m (str "theme → " name))))))

(defcommand cmd-theme-select
  (m key)
  "Pick a colour theme (`M-x theme-select`) — a Vertico list of full palettes (background,
foreground, syntax) + font, applied live to the whole editor."
  (assoc m
    :minibuffer
      (ed-name-prompt "Theme: "
        (themes-names)
        (fn (mm name) (themes-apply mm name)))))
