(defmodule themes
  "The theme registry (`M-x theme-select`): a live picker over full **colour themes** — each
swaps the whole palette (background, foreground, accents, syntax) via `theme/theme-apply!`
AND sets the window font. So switching to a light theme (Catppuccin Latte) really does turn
the editor light; the chrome, syntax, menus and window background all follow. A theme is a
plain map, so adding one is data. Font paths are this machine's for now; a portable version
would bundle the faces or read `(config :themes …)`."
  (:use interactive) ; defcommand — register theme-select for M-x
  (:use commands) ; ed-name-prompt — the Vertico selection prompt
  (:use theme) ; theme-apply! + the Mocha palette
  (:use model)) ; message — the echo-area status
;; A clean, light coding face for every theme (the bundled DejaVu is heavy). Registered on
;; apply; a missing style falls back to :regular.
(def *hack*
  {:regular "/usr/share/fonts/truetype/hack/Hack-Regular.ttf"
   :bold "/usr/share/fonts/truetype/hack/Hack-Bold.ttf"
   :italic "/usr/share/fonts/truetype/hack/Hack-Italic.ttf"
   :bold-italic "/usr/share/fonts/truetype/hack/Hack-BoldItalic.ttf"})

;; ---- palettes (role -> "#rrggbb", the 16 tokens theme/theme-apply! rebinds) --

(def *latte*
  ; Catppuccin Latte — light
  {:base "#eff1f5"
   :mantle "#e6e9ef"
   :surface0 "#ccd0da"
   :surface1 "#bcc0cc"
   :surface2 "#acb0be"
   :overlay0 "#9ca0b0"
   :overlay1 "#8c8fa1"
   :text "#4c4f69"
   :subtext "#5c5f77"
   :blue "#1e66f5"
   :mauve "#8839ef"
   :green "#40a02b"
   :yellow "#df8e1d"
   :peach "#fe640b"
   :red "#d20f39"
   :teal "#179299"})

(def *gruvbox*
  ; Gruvbox Dark
  {:base "#282828"
   :mantle "#1d2021"
   :surface0 "#3c3836"
   :surface1 "#504945"
   :surface2 "#665c54"
   :overlay0 "#7c6f64"
   :overlay1 "#928374"
   :text "#ebdbb2"
   :subtext "#d5c4a1"
   :blue "#83a598"
   :mauve "#d3869b"
   :green "#b8bb26"
   :yellow "#fabd2f"
   :peach "#fe8019"
   :red "#fb4934"
   :teal "#8ec07c"})

(def *nord*
  ; Nord
  {:base "#2e3440"
   :mantle "#272c36"
   :surface0 "#3b4252"
   :surface1 "#434c5e"
   :surface2 "#4c566a"
   :overlay0 "#616e88"
   :overlay1 "#6d7a96"
   :text "#eceff4"
   :subtext "#d8dee9"
   :blue "#81a1c1"
   :mauve "#b48ead"
   :green "#a3be8c"
   :yellow "#ebcb8b"
   :peach "#d08770"
   :red "#bf616a"
   :teal "#88c0d0"})

(def *tokyo*
  ; Tokyo Night
  {:base "#1a1b26"
   :mantle "#16161e"
   :surface0 "#24283b"
   :surface1 "#2f3549"
   :surface2 "#3b4261"
   :overlay0 "#565f89"
   :overlay1 "#737aa2"
   :text "#c0caf5"
   :subtext "#a9b1d6"
   :blue "#7aa2f7"
   :mauve "#bb9af7"
   :green "#9ece6a"
   :yellow "#e0af68"
   :peach "#ff9e64"
   :red "#f7768e"
   :teal "#7dcfff"})

(def *themes*
  ;; display name -> {:palette <map> :font <keyword> :files <map|nil> :height px}.
  [{:name "Catppuccin Mocha" :palette theme/*theme-mocha* :font :hack :files *hack* :height 15}
    {:name "Tokyo Night" :palette *tokyo* :font :hack :files *hack* :height 15}
    {:name "Nord" :palette *nord* :font :hack :files *hack* :height 15}
    {:name "Gruvbox Dark" :palette *gruvbox* :font :hack :files *hack* :height 15}
    {:name "Catppuccin Latte (light)" :palette *latte* :font :hack :files *hack* :height 15}])

(defn- themes-by-name
  (name)
  (first (filter (fn (t) (= (:name t) name)) *themes*)))

(defn themes-names () (map (fn (t) (:name t)) *themes*))

(defn themes-apply (m name)
  "Apply the theme `name` live: swap the whole palette + window background (`theme-apply!`)
and set the font (`gui-font!`), both GUI side effects guarded so a headless run is a no-op.
Returns the model with an echo status."
  (let (t (themes-by-name name))
    (if (nil? t)
      (message m (str "no such theme: " name))
      (do
        (theme/theme-apply! (:palette t))
        (when (:files t) (try (gui-font-register (:font t) (:files t)) (catch e nil)))
        (try (gui-font! {:family (:font t) :height (:height t)}) (catch e nil))
        (message m (str "theme → " name))))))

(defcommand cmd-theme-select
  (m key)
  "Pick a colour theme (`M-x theme-select`) — a Vertico list of full palettes (background,
foreground, syntax) + font, applied live to the whole editor."
  (assoc m
    :minibuffer (ed-name-prompt "Theme: "
                  (themes-names)
                  (fn (mm name) (themes-apply mm name)))))
