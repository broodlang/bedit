(defmodule corpus
  "The language corpus: realistic sample files under `tests/corpus/<mode>/`, one directory per
mode type (`rust`, `terraform`, `lisp`), and the checks every sample gets ([[define-tests]]
registers them, one named test per file and check). A language is tested by DROPPING a file of
it there, written in its formatter's style.

ONE harness for bedit's languages and a language package's: the paths are the project's own
(`tests/corpus/`, `tests/corpus/known-gaps.blsp`, under the directory `nest test` runs in), so
a `bedit-lang-*` package with bedit as a dev dependency runs the very checks bedit's own
languages get, over its own samples, with a test file of one line — `(corpus/define-tests)`,
as `tests/language_corpus_test.blsp` is — and rewrites its golden listings with
[[write-golden]]. The languages a run answers for are the ones the project itself registers
([[own-languages]]); the checks across languages hold them against every registered one, so a
package's language may not take a name, a `#!` program or a file pattern of bedit's.

A sample asserts its own colours with comment lines, Emacs's `ert-font-lock` carets in bedit's
faces. Carets sit under the columns of the nearest line above that is not itself an assertion,
each run followed by what those columns are painted:

    let total = count(words);
    // ^^^^^^^^^^^ plain  ^^^^^ function
    //                          !keyword

The marker is the mode's `:comment` (`//`, `#`, `;;`, `--`), or its `:comment-block` pair for a
language with only block comments (`/* ^^^ keyword */`, `<!-- ^^^ string -->`). A face is a
`:syntax/*` name without the prefix (`keyword string number constant comment special function
definition doc symbol punctuation variable error`); `!name` asserts NOT that face, `plain` no face
at all, and `<-` in place of carets is the column the marker itself starts at (for a token in
column 0 or 1, where carets cannot reach). Columns count characters, a tab as one. An assertion
line is skipped by the indent checks and left out of the golden listing.

A line inside VERBATIM content — a heredoc's body, a raw string — is one whose indentation is
its text, not the indenter's; it is found the way the indenter finds it, from the mode's
`:indent :verbatim` kinds over the parse ([[verbatim-lines]]), so the sample carries no marker
for it. The indent checks keep such a line as written.

Each check answers a vector of PROBLEMS, readable sentences naming the line, and `[]` when the
sample passes. A sample is judged at its LANGUAGE's conventions — its spec's indent width, the
buffer's tab width — never at the project's `.editorconfig` ([[file-model]]): a repository's
`[*] indent_size = 2` is the repository's statement, not the language's. Lives in src/ (not
tests/support) for the package's sake: a dependency puts bedit's src/ alone on its load path, so
`testkit` delegates the helpers both share to it ([[file-model]], [[press]],
[[load-test-grammar]], [[indent-rows]])."
  (:use test) ; describe / test — define-tests registers the checks as tests
  (:use model)
  (:use memo) ; defmemo — the known gaps, read once per change to the file
  (:use input :only []) ; ed-update — a key folded as the loop folds it
  (:use editor/buffer :only [make-buffer buffer-text goto-char insert replace-region]))

(defdyn *corpus-root* "tests/corpus")
;; The corpus directory, under the directory the run is in; a test of the harness binds its own.

;; ---- the runtime a check runs in -----------------------------------------------------------
;; What the checks need of a model: a buffer visiting a sample as a visit types it, keys pressed
;; through the editor's own dispatch, and the grammars a test run's scratch home lacks. Here, in
;; src/, so a language package's tests reach them through bedit as a dependency (which puts
;; bedit's src/ alone on its load path); bedit's own tests reach them through `testkit`.

(defn file-model (text file)
  "A model over one buffer holding `text`, visiting `file` — typed by `file`'s name, as a visit
types it — point at its start. No `.editorconfig` is read for it: the buffer keeps its mode's
own conventions, so a language is judged by what it declares wherever the file sits."
  (ed-init (assoc (make-buffer text file file) :editorconfig {})))

(defn press (m keys)
  "`m` after each key of `keys` (strings for characters, keywords for the rest:
`[:ctrl-x \"o\"]`) went through the editor's own dispatch, at an 80×24 frame."
  (fold keys m (fn (acc key) (input/ed-update acc key 80 24))))

(defn load-test-grammar (lang)
  "Whether `lang`'s grammar is loaded in this process, loading it first when it can be: one the
runtime was not built with is the user's, and a test run's scratch home has none, so it comes
from `$BROOD_TEST_GRAMMARS`, else the real config the runner kept aside (read, never written).
Loaded for the whole process — what a test that needs a grammar ABSENT has to expect beside it."
  (or (grammars/grammar-loaded? lang)
    (let (dir (or (os/env "BROOD_TEST_GRAMMARS")
                (let (base (os/env "BROOD_USER_CONFIG_HOME"))
                  (when base (path/join base "bedit" "grammars"))))
          file (when dir (path/join dir (str "libtree-sitter-" (->string lang) ".so"))))
      (and file
        (file/exists? file)
        (check-allow :discarded-catch
          (try (do (%tree-sitter-load-grammar file lang) true) (catch _ false)))))))

(defn- blank? (line) (= (string/trim line) ""))

(defn- leading (line)
  ;; the leading whitespace of `line`
  (string/substring line 0 (- (count line) (count (string/trim-left line)))))

(defn- column-of (buffer line)
  ;; the column `line`'s leading whitespace reaches, at `buffer`'s tab width — how every indent
  ;; check measures the column a line is written at
  (string/display-width (leading line) 0 (conventions/tab-width buffer)))

(defn- line-starts (lines)
  ;; the offset each line starts at
  (reduce (range (dec (count lines)))
    [0]
    (fn (starts index) (conj starts (+ (last starts) (count (nth lines index "")) 1)))))

(defn indent-rows (src file &optional (skip? nil))
  "`[{:line :got :want}]` for every non-blank line of `src` — but those whose 0-based index
`skip?` answers true for: the column TAB indents it to in a buffer visiting `file`
(`indent/ed-indent-target`, at the buffer's indent width, as the re-indent and typing checks
indent), and the column it is written at, at the buffer's tab width."
  (let (buffer (ed-current-buf (file-model src file))
        lines (vec (string/split src "\n"))
        starts (line-starts lines))
    (for (index (range (count lines))
           :when (not (or (blank? (nth lines index "")) (and skip? (skip? index))))
           :into [])
      {:line index
       :got (indent/ed-indent-target (goto-char buffer (nth starts index 0)))
       :want (column-of buffer (nth lines index ""))})))

;; ---- the corpus ------------------------------------------------------------------------------

(defn golden-path (path)
  "The golden face listing beside the sample at `path`: `counter.rs` → `counter.rs.faces`."
  (str path ".faces"))

(defn visit-path (path)
  "The name the sample at `path` is visited as: a dotfile is kept as `dot.<name>` (`dot.gitignore`),
so git and editors do not read the corpus's `.gitignore`, `.gitattributes` or `.editorconfig` as
their own, and visited as `.<name>`, the name its mode matches. A bare `dot.` keeps its name.

    (corpus/visit-path \"tests/corpus/gitignore/dot.gitignore\")   ;=> \"tests/corpus/gitignore/.gitignore\"
    (corpus/visit-path \"tests/corpus/rust/counter.rs\")   ;=> \"tests/corpus/rust/counter.rs\"
    (corpus/visit-path \"tests/corpus/x/dot.\")   ;=> \"tests/corpus/x/dot.\""
  (let (name (path/basename path))
    (match name
      ;; `dot.` with something after it: `dot.` alone stays a name
      ((str "dot." rest) :when (not (= rest "")) (path/join (path/dirname path) (str "." rest)))
      (_ path))))

(defn- sample-file? (name)
  ;; a sample, not its golden listing or an editor's leftover
  (not (or (string/ends-with? name ".faces")
         (string/ends-with? name "~")
         (string/starts-with? name ".#"))))

(defn corpus-files (&optional (language nil))
  "Every sample of the corpus, sorted, as `{:language :name :path}` — the mode type its directory
names, the file's name and its path — or only `language`'s: `[]` for a project with no corpus,
or a language with no directory in it."
  (let (languages (cond
                    language [language]
                    (file/dir? *corpus-root*) (sort (file/list-dirs *corpus-root*))
                    else []))
    (for (each languages
           :when (file/dir? (path/join *corpus-root* each))
           name
           (sort (file/list-files (path/join *corpus-root* each)))
           :when (sample-file? name)
           :into [])
      {:language each :name name :path (path/join *corpus-root* each name)})))

(defn load-grammars ()
  "Load every grammar a registered language declares, as a test does one
([[load-test-grammar]]): a sample's mode, its fallback and the languages it embeds all
depend on them. Answers the set of the ones loaded."
  (into #{} (seq/filter (languages/declared-grammars) load-test-grammar)))

;; ---- a sample, read -----------------------------------------------------------------------

(defn- markers (buffer)
  ;; `[open close]` pairs an assertion line may be written in: the line comment, the block pair
  (let (line-comment (ed-mode-service buffer :comment-syntax)
        block (ed-mode-service buffer :comment-block))
    (into []
      (seq/keep [(when (string? line-comment) [(string/trim line-comment) ""])
                  (when (vector? block) [(string/trim (first block)) (string/trim (second block))])]
        identity))))

(def- *face-names*
  ;; the `:syntax/*` names an assertion may say, without the prefix
  #{"keyword"
    "string" "number" "constant" "comment" "special" "function" "definition" "doc" "symbol"
    "punctuation" "variable" "error"})

(defn- words (text column)
  ;; the whitespace-separated words of `text`, which starts at `column`, as `[word column]`
  (let (characters (vec (string/->list text))
        total (count characters))
    (letrec (walk (fn (index start acc)
                    (cond
                      (>= index total)
                        (reverse (if start
                                   (cons [(string/join (seq/subvec characters start index) "")
                                           (+ column start)]
                                     acc)
                                   acc))
                      (string/blank? (nth characters index))
                        (walk (inc index)
                          nil
                          (if start
                            (cons [(string/join (seq/subvec characters start index) "")
                                    (+ column start)]
                              acc)
                            acc))
                      else (walk (inc index) (or start index) acc))))
      (walk 0 nil '()))))

(defn- caret-run? (word) (every? (string/->list word) (fn (character) (= character "^"))))

(defn- face-expression (word)
  ;; `{:face name :negated bool}`, `{:plain true}`, or a failure naming the word
  (let (negated (string/starts-with? word "!")
        name (if negated (string/substring word 1 (count word)) word))
    (cond
      (and (= name "plain") (not negated)) {:plain true}
      (contains? *face-names* name) {:face name :negated negated}
      else (failure (str "unknown face `" word "`")))))

(defn- parse-ranges (pairs marker-column)
  ;; the `[[start end expression]]` a run of `range face` words says, or a failure
  (letrec (walk (fn (rest-words acc)
                  (cond
                    (empty? rest-words) (vec (reverse acc))
                    (empty? (rest rest-words))
                      (failure (str "`" (first (first rest-words)) "` names no face"))
                    else
                      (let ([word column] (first rest-words)
                            [face-word _] (second rest-words)
                            expression (face-expression face-word)
                            range (cond
                                    (= word "<-") [marker-column (inc marker-column)]
                                    (caret-run? word) [column (+ column (count word))]
                                    else nil))
                        (cond
                          (nil? range) (failure (str "`" word "` is neither carets nor `<-`"))
                          (failure? expression) expression
                          else
                            (walk (rest (rest rest-words))
                              (cons [(first range) (second range) expression] acc)))))))
    (walk pairs '())))

(defn- parse-assertion (line marker-pairs)
  "Nil when `line` is no assertion line; else `{:ranges [[start end expression]]}`, or
`{:problem why}` for one that starts like an assertion and says something malformed."
  (let (indentation (count (leading line))
        trimmed (string/trim line))
    (first (seq/keep marker-pairs
             (fn ([open close])
               (match trimmed
                 ((str ^open body ^close)
                   (let (pairs (words body (+ indentation (count open)))
                         head (first (first pairs)))
                     (when (and (string? head) (or (string/starts-with? head "^") (= head "<-")))
                       (let (ranges (parse-ranges pairs indentation))
                         (if (failure? ranges)
                           {:problem (error-message ranges)}
                           {:ranges ranges :marker indentation})))))
                 (_ nil)))))))

(defn- spec-of (type)
  ;; the registered language spec of the mode `type`, or nil
  (let (spec-ref (registry/lookup :languages/specs type))
    (when spec-ref (reflect/eval spec-ref))))

(defn sample (entry)
  "The corpus sample `entry` names ([[corpus-files]]), read: `{:language :name :path :id :text
:lines :starts :buffer :type :spec :assertions :assertion-lines :problems}` — its buffer typed by
the file's name as a visit types it, every assertion line parsed (`:assertions` each `{:line
:target :ranges}`, its target the line it is about), and the malformed ones in `:problems`."
  (let ({:keys [language name path]} entry
        text (file/slurp path)
        lines (vec (string/split text "\n"))
        buffer (ed-current-buf (file-model text (visit-path path)))
        marker-pairs (markers buffer)
        parsed (for (index (range (count lines)) :into [])
                 [index (parse-assertion (nth lines index "") marker-pairs)])
        assertion-lines (into #{} (seq/keep parsed (fn ([index found]) (when found index))))
        target-of (fn (index)
                    (letrec (up (fn (at)
                                  (cond
                                    (< at 0) nil
                                    (contains? assertion-lines at) (up (dec at))
                                    else at)))
                      (up (dec index))))
        assertions (for ([index found] parsed :when (and found (:ranges found)) :into [])
                     {:line index
                      :target (target-of index)
                      :ranges (:ranges found)
                      :marker (:marker found)})
        problems (into []
                   (append (for ([index found] parsed :when (and found (:problem found)))
                             (str "line " (inc index) ": malformed assertion: " (:problem found)))
                     (for (each assertions :when (nil? (:target each)))
                       (str "line " (inc (:line each)) ": an assertion with no line above it")))))
    {:language language
     :name name
     :path path
     :id (str language "/" name)
     :text text
     :lines lines
     :starts (line-starts lines)
     :buffer buffer
     :type (:type buffer)
     :spec (spec-of (:type buffer))
     :assertions assertions
     :assertion-lines assertion-lines
     :problems problems}))

(defn grammar (sample)
  "The tree-sitter grammar `sample`'s LANGUAGE parses with — the language its directory names — or
nil for one that parses none. Not the grammar of the mode the buffer opened in: without its grammar
a file falls back to a lexer mode that parses with none, so asking the buffer read every such
sample as ready and ran its mode check against the fallback (`Containerfile opens in
:docker-lexer, not :docker` in CI's shards, which carry only the built-in grammars)."
  (let (intended (spec-of (keyword (:language sample))))
    (if intended (get intended :lang) (ed-mode-service (:buffer sample) :ts-lang))))

(defn ready? (sample)
  "Whether the runtime can run `sample`'s parsed checks: its mode parses with no grammar, or with
one that is loaded."
  (let (lang (grammar sample)) (or (nil? lang) (grammars/grammar-loaded? lang))))

(defn embedded-grammars (sample)
  "The grammars of the languages `sample` embeds, as its spec's `:embedded-languages` reads them
off its text (Markdown's fences, `languages/markdown/fence-languages`) — `[]` for a spec that says
none. A golden listing colours an embedded body in its language, so it depends on these too."
  (let (reader (get (:spec sample) :embedded-languages))
    (if (nil? reader)
      []
      (vec (seq/keep (or (reflect/call-if-bound reader [] (:text sample)) [])
             (fn (type) (get (spec-of type) :lang)))))))

(defn missing-grammars (sample &optional (embedded? false))
  "The grammars `sample`'s checks need that are not loaded: its language's ([[grammar]]), and with
`embedded?` the ones it embeds too ([[embedded-grammars]]) — `[]` when the check can run."
  (let (own (grammar sample)
        needed (append (if own [own] []) (if embedded? (embedded-grammars sample) [])))
    (vec (seq/reject (seq/distinct needed) grammars/grammar-loaded?))))

(defn- missing-text (missing)
  ;; why a check is skipped: "no rust grammar", "no rust, toml grammar"
  (str "no " (string/join (map missing ->string) ", ") " grammar"))

(defn indented? (sample)
  "Whether `sample`'s mode INDENTS — has an `:indent` service that reads the code rather than the
line's own content (YAML's `:indent :content`), so the indent checks apply."
  (and (not (nil? (ed-mode-service (:buffer sample) :indent)))
    (not (= (get (:spec sample) :indent) :content))))

(defn- line-at (sample offset)
  ;; the 0-based line holding `offset`
  (let (starts (:starts sample))
    (dec (count (seq/take-while starts (fn (start) (<= start offset)))))))

;; ---- 1. the mode ---------------------------------------------------------------------------

(defn mode-problems (sample)
  "The sample's file name must type it to the mode its directory names."
  (let (type (:type sample))
    (if (= (->string type) (:language sample))
      []
      [(str (:name sample) " opens in " (pr-str type) ", not :" (:language sample))])))

;; ---- 2. faces: the assertions, and the golden listing --------------------------------------

(defn- face-names-of (face)
  ;; the names a resolved face is painted by, sorted — several where a theme paints them alike
  (sort (seq/filter (vec *face-names*)
          (fn (name) (= (editor/face/face (keyword (str "syntax/" name))) face)))))

(defn- treesit-labelled (sample)
  "The `[start end [name]]` spans `sample`'s tree-sitter mode paints, each with the ONE face name
its table gives it — the kernel's span query over the mode's own face table and injections, as
`editor/treesit/fontify` asks it before it resolves the names — or nil for a mode that is not."
  (let (buffer (:buffer sample)
        lang (grammar sample)
        faces (ed-mode-service buffer :ts-faces)
        injections-of (ed-mode-service buffer :ts-injections))
    (when (and lang (map? faces) (grammars/grammar-loaded? lang))
      (let (injections (when injections-of (injections-of))
            raw (%tree-sitter-spans (:text sample) lang faces true injections))
        (seq/keep raw
          (fn (span)
            (let (raw-name (nth span 2)
                  name (case raw-name
                         :__keyword__ :syntax/keyword
                         :__punctuation__ :syntax/punctuation
                         raw-name))
              (when (editor/face/face name)
                [(nth span 0) (nth span 1) [(string/drop-prefix (->string name) "syntax/")]]))))))))

(defn painted (sample)
  "`{:spans :labelled :problems}`: the `[start end face]` spans `sample`'s mode paints (its
`:fontify` service), the same spans with the face NAMES they were painted by, and why the two
disagree. A tree-sitter mode names each span exactly ([[treesit-labelled]], checked against the
service span for span); another mode's spans carry only a colour, named by every face the theme
paints that colour (`keyword|symbol`)."
  (let (fontify (ed-mode-service (:buffer sample) :fontify)
        spans (vec (fontify (:text sample)))
        exact (treesit-labelled sample)
        resolved (when exact
                   (vec (map exact
                          (fn ([start end names])
                            [start end (editor/face/face (keyword (str "syntax/" (first names))))])))))
    (cond
      (nil? exact)
        {:spans spans
         :labelled (vec (map spans (fn ([start end face]) [start end (face-names-of face)])))
         :problems []}
      (= resolved spans) {:spans spans :labelled (vec exact) :problems []}
      else
        {:spans spans
         :labelled (vec (map spans (fn ([start end face]) [start end (face-names-of face)])))
         :problems ["the face names read from the mode's table disagree with what its :fontify paints"]})))

(defn- labels-at (labelled offset)
  ;; the names painting `offset` — nil where nothing does
  (let (hit (seq/find labelled (fn ([start end _]) (and (<= start offset) (< offset end)))))
    (when hit (nth hit 2))))

(defn- describe-expression (expression)
  (cond
    (:plain expression) "plain"
    (:negated expression) (str "!" (:face expression))
    else (:face expression)))

(defn- column-holds? (expression names)
  (cond
    (:plain expression) (nil? names)
    (:negated expression) (not (includes? (or names []) (:face expression)))
    else (includes? (or names []) (:face expression))))

(defn- assertion-problem (sample labelled assertion caret)
  ;; why the caret range `caret` of `assertion` does not hold, or nil
  (let (target (:target assertion)
        line (nth (:lines sample) target)
        line-start (nth (:starts sample) target)
        [from to expression] caret
        columns (range from to)
        past (seq/find columns (fn (column) (>= column (count line))))
        wrong (seq/find columns
                (fn (column)
                  (and (< column (count line))
                    (not (column-holds? expression (labels-at labelled (+ line-start column)))))))
        where (str "line "
                (inc target)
                " cols "
                from
                "-"
                (dec to)
                " `"
                (string/substring line (math/min from (count line)) (math/min to (count line)))
                "`, asserted on line "
                (inc (:line assertion))))
    (cond
      past (str where ": column " past " is past the end of the line")
      wrong
        (str where
          ": want "
          (describe-expression expression)
          ", column "
          wrong
          " is "
          (let (names (labels-at labelled (+ line-start wrong)))
            (if names (string/join names "|") "plain")))
      else nil)))

(defn- marker-problem (sample labelled assertion)
  ;; why `assertion`'s line is no comment where it stands — a `//` line in a PHP file's HTML is
  ;; page text — or nil
  (let (names (labels-at labelled (+ (nth (:starts sample) (:line assertion)) (:marker assertion))))
    (when (not (includes? (or names []) "comment"))
      (str "line "
        (inc (:line assertion))
        ": this assertion line is no comment here (painted "
        (if names (string/join names "|") "plain")
        "), so it is code or text of the sample"))))

(defn face-problems (sample &optional (painting nil))
  "Every assertion line of `sample` must hold: each caret column painted as it says, the line
itself painted as a comment — and a sample of a mode with a comment marker carries at least one.
`painting` is [[painted]]'s answer when the caller has it."
  (let (painting (or painting (painted sample))
        labelled (:labelled painting)
        bare (and (empty? (:assertions sample)) (not (empty? (markers (:buffer sample))))))
    (into (into (into (into (:problems sample) (:problems painting))
                  (if bare
                    [(str (:name sample) " asserts no faces: add caret lines under its tokens")]
                    []))
            (seq/keep (:assertions sample)
              (fn (assertion) (marker-problem sample labelled assertion))))
      (seq/keep (for (assertion (:assertions sample)
                       :when (:target assertion)
                       caret
                       (:ranges assertion))
                  (assertion-problem sample labelled assertion caret))
        identity))))

(defn golden-lines (sample &optional (painting nil))
  "The golden face listing of `sample`: one `LINE:COL \"text\" face` row for every painted piece
of a line (a span over several lines is listed a line at a time), lines from 1 and columns
from 0, assertion lines left out — what [[golden-problems]] compares and
`tools/corpus-golden.blsp` writes."
  (let (painting (or painting (painted sample))
        text (:text sample)
        starts (:starts sample)
        skip (:assertion-lines sample))
    (into []
      (mapcat (:labelled painting)
        (fn ([start end names])
          (seq/keep (range (line-at sample start) (inc (line-at sample (dec end))))
            (fn (line)
              (let (line-start (nth starts line)
                    line-end (+ line-start (count (nth (:lines sample) line)))
                    from (math/max start line-start)
                    to (math/min end line-end))
                (when (and (< from to) (not (contains? skip line)))
                  (str (inc line)
                    ":"
                    (- from line-start)
                    " "
                    (pr-str (string/substring text from to))
                    " "
                    (string/join names "|")))))))))))

(defn- golden-command (language)
  ;; what rewrites `language`'s listings: bedit's tool in bedit's tree, else — a language
  ;; package, which has no copy of it — the function the tool calls ([[write-golden]])
  (if (file/exists? "tools/corpus-golden.blsp")
    (str "nest run tools/corpus-golden.blsp -- " language)
    (str "nest eval --test '(corpus/write-golden [\"" language "\"])'")))

(defn golden-header (sample)
  "The golden file's first line for `sample`: what it is and the function that rewrites it —
the same words in bedit's tree and in a package's, so a language moved between the two keeps
its listings.

    (corpus/golden-header {:id \"zig/stack.zig\" :language \"zig\"})   ;=> \";; zig/stack.zig — the faces its mode paints. Rewrite with (corpus/write-golden [\\\"zig\\\"]) and review the diff.\""
  (str ";; "
    (:id sample)
    " — the faces its mode paints. Rewrite with (corpus/write-golden ["
    (pr-str (:language sample))
    "]) and review the diff."))

(defn golden-text (sample &optional (painting nil))
  "The golden file's text for `sample`: [[golden-header]], then [[golden-lines]]."
  (str (golden-header sample) "\n" (string/join (golden-lines sample painting) "\n") "\n"))

(defn golden-problems (sample &optional (painting nil))
  "The golden listing beside `sample` must be what its mode paints now: a missing file, or the
first rows that differ."
  (let (path (golden-path (:path sample))
        command (golden-command (:language sample)))
    (if (not (file/exists? path))
      [(str "no golden listing " path " — write it with `" command "` and review it")]
      (let (want (vec (string/split (file/slurp path) "\n"))
            got (vec (string/split (golden-text sample painting) "\n"))
            differing (seq/filter (range (math/max (count want) (count got)))
                        (fn (index) (not (= (get want index) (get got index))))))
        (if (empty? differing)
          []
          (into [(str path
                   " is stale: "
                   (count differing)
                   " row(s) differ — if the change is "
                   "deliberate, `"
                   command
                   "` and review the diff")]
            (for (index (take differing 6) :into [])
              (str "row "
                (inc index)
                ": want "
                (pr-str (get want index))
                "  got "
                (pr-str (get got index))))))))))

;; ---- verbatim content ----------------------------------------------------------------------

(defn verbatim-lines (sample)
  "The lines of `sample` whose indentation is CONTENT — inside a node of its mode's `:indent
:verbatim` kinds that began on an earlier line, or that begins at the line's start inside a node
an earlier line opened: the rule `editor/treesit/indent-column` keeps a line as written by."
  (let (kinds (let (indent (get (:spec sample) :indent))
                (if (map? indent) (get indent :verbatim #{}) #{}))
        lang (grammar sample)
        text (:text sample))
    (if (or (empty? kinds) (nil? lang) (not (grammars/grammar-loaded? lang)))
      #{}
      (into #{}
        (seq/filter (range (count (:lines sample)))
          (fn (index)
            (let (line (nth (:lines sample) index "")
                  bol (nth (:starts sample) index 0)
                  nodes (vec (editor/treesit/node-chain text lang (+ bol (count (leading line))))))
              (and (not (blank? line))
                (any? (range (count nodes))
                  (fn (position)
                    (let (node (nth nodes position)
                          start (get node :start)
                          parent (when (> position 0) (nth nodes (dec position))))
                      (and (contains? kinds (get node :kind))
                        (or (< start bol)
                          (and (= start bol) parent (< (get parent :start) bol)))))))))))))))

;; ---- the known gaps: a ratchet ------------------------------------------------------------
;; A line check (indent, re-indent, typing, restart) that finds a gap the language's indenter or
;; restart cannot close yet names it in tests/corpus/known-gaps.blsp, with why: the check then
;; fails only on a line NOT listed, and on a listed line that now passes, so the list can only
;; shrink. A check that does not apply to a language at all (Python's indentation is its syntax,
;; so nothing can re-indent it from scratch) is listed `:off` with the reason.

(defdyn *gaps-path* "tests/corpus/known-gaps.blsp")
;; The known gaps file, beside the samples; a test of the harness binds its own.

(def *line-checks*
  ;; the checks a known gap may name
  #{:indent :reindent :typing :restart})

(defmemo gaps-read 4 (path stamp)
  "The known gaps file at `path` read, once for each `stamp` (its modification time and size,
nil for no file): every check of every sample asks, and the file changes only between runs."
  (if (nil? stamp) {} (or (reflect/read-first (file/slurp path)) {})))

(defn- known-gaps ()
  ;; `{sample-id {check {:lines [n …] :why "…"} | {:off "why"}}}`
  (gaps-read *gaps-path*
    (when (file/exists? *gaps-path*) [(file/mtime *gaps-path*) (file/size *gaps-path*)])))

(defn gap (sample check)
  "What tests/corpus/known-gaps.blsp says of `check` (`:indent` `:reindent` `:typing`
`:restart`) for `sample`: `{:lines [1-based …] :why}`, `{:off why}`, or nil."
  (map/get-in (known-gaps) [(:id sample) check]))

(defn applies? (sample check)
  "Whether `check` applies to `sample` — not listed `:off` in the known gaps."
  (nil? (get (gap sample check) :off)))

(defn- gap-lines (sample check)
  ;; the 1-based lines the known gaps list for `check` of `sample`
  (get (gap sample check) :lines []))

(defn gap-problems ()
  "Every entry of tests/corpus/known-gaps.blsp must name a sample of the corpus by its id
(`rust/counter.rs`), and each check under it one of `*line-checks*`, saying `{:lines [n …] :why}`
or `{:off why}`: a misspelt id or check would otherwise excuse nothing and fail nothing."
  (let (gaps (known-gaps)
        ids (into #{} (map (corpus-files) (fn (entry) (str (:language entry) "/" (:name entry))))))
    (into []
      (append (for ([id _] (seq/sort-by (vec gaps) first) :when (not (contains? ids id)))
                (str (pr-str id) " names no sample under " *corpus-root*))
        (for ([id checks] (seq/sort-by (vec gaps) first)
               [check entry]
               (seq/sort-by (vec checks) (fn (pair) (->string (first pair))))
               :when (or (not (contains? *line-checks* check))
                 (not (or (string? (get entry :off))
                        (and (vector? (get entry :lines)) (string? (get entry :why)))))))
          (str (pr-str id)
            " lists "
            (pr-str check)
            (if (contains? *line-checks* check)
              ", which says neither {:lines [n …] :why \"…\"} nor {:off \"why\"}"
              (str ", which is no check — the checks are "
                (string/join (sort (map *line-checks* pr-str)) " ")))))))))

(defn- ratchet (sample check found)
  ;; the messages of `found` (`[[line message] …]`, lines from 1) not listed as known gaps of
  ;; `check`, then one for each listed line that now passes — so the check must ask about every
  ;; listed line, as the restart check's stride does
  (let (known (into #{} (gap-lines sample check))
        failing (into #{} (map found first)))
    (into (into [] (for ([line message] found :when (not (contains? known line))) message))
      (for (line (sort (vec known)) :when (not (contains? failing line)) :into [])
        (str "line "
          line
          " is listed in "
          *gaps-path*
          " as a "
          (->string check)
          " gap but now passes — remove it")))))

;; ---- 3. indentation ------------------------------------------------------------------------

(defn- kept-as-written (sample)
  ;; the lines the indent checks do not judge: assertions and verbatim content
  (set/union (:assertion-lines sample) (verbatim-lines sample)))

(defn- quote-line (line) (pr-str (string/trim line)))

(defn indent-problems (sample)
  "(a) Every line, asked of the mode's `:indent` service as the sample stands, indents to the
column it already has ([[indent-rows]])."
  (let (skip (kept-as-written sample))
    (ratchet sample
      :indent (for (row (indent-rows (:text sample)
                  (visit-path (:path sample))
                  (fn (index) (contains? skip index)))
             :when (not (= (:got row) (:want row)))
             :into [])
        [(inc (:line row))
          (str "line "
            (inc (:line row))
            " "
            (quote-line (nth (:lines sample) (:line row) ""))
            ": indents to "
            (:got row)
            ", written at "
            (:want row))]))))

(defn- strip-lines (sample keep)
  ;; the sample's text with every line's leading whitespace removed, but those in `keep`
  (string/join (for (index (range (count (:lines sample))) :into [])
                 (let (line (nth (:lines sample) index ""))
                   (if (contains? keep index) line (string/trim-left line))))
    "\n"))

(defn reindent-problems (sample)
  "(b) Re-indented from scratch — every line's leading whitespace removed (verbatim content
kept), then the whole buffer indented by the editor's own `indent-region` (C-x h C-M-\\, through
the real dispatch) — the buffer must read as the sample does."
  (let (verbatim (verbatim-lines sample)
        skip (set/union verbatim (:assertion-lines sample))
        lines (:lines sample)
        indented (press (file-model (strip-lines sample verbatim) (visit-path (:path sample)))
                   [:ctrl-x "h" (keyword "ctrl-meta-\\")])
        got (vec (string/split (buffer-text (ed-current-buf indented)) "\n")))
    (ratchet sample
      :reindent (for (index (range (count lines))
             :when (not (or (contains? skip index) (= (get got index) (nth lines index))))
             :into [])
        [(inc index)
          (str "line "
            (inc index)
            ": re-indented to "
            (pr-str (get got index))
            ", written "
            (pr-str (nth lines index)))]))))

(defn- typed-line (sample index)
  ;; the model after line `index` was typed below the lines above it: RET through the dispatch,
  ;; then the line's text inserted a character at a time, each followed by electric indent
  (let (prefix (string/join (seq/subvec (:lines sample) 0 index) "\n")
        start (let (m (file-model prefix (visit-path (:path sample))))
                (ed-set-buf m (goto-char (ed-current-buf m) (count prefix)))))
    (fold (string/->list (string/trim-left (nth (:lines sample) index "")))
      (press start [:enter])
      (fn (m character)
        (indent/ed-electric-reindent (ed-set-buf m (insert (ed-current-buf m) character)))))))

(defn typing-problems (sample)
  "(c) Typed line by line, as a user does: below the lines above it, as written and with nothing
after them — the half-built buffer, whose parse is still broken — RET through the editor's own
dispatch (`newline-and-indent`), then the line's text without its indentation, each character
followed by electric indent (`indent/ed-electric-reindent`: a closing bracket, a block word). The
characters are inserted rather than typed so electric pairs and completion stay out of it. Each
line must end up at the column it is written at."
  (let (skip (kept-as-written sample)
        lines (:lines sample))
    (ratchet sample
      :typing (into []
        (seq/keep (range 1 (count lines))
          (fn (index)
            (let (line (nth lines index ""))
              (when (not (or (blank? line) (contains? skip index)))
                (let (buffer (ed-current-buf (typed-line sample index))
                      got (column-of buffer
                            (nth (vec (string/split (buffer-text buffer) "\n")) index ""))
                      want (column-of buffer line))
                  (when (not (= got want))
                    [(inc index)
                      (str "line "
                        (inc index)
                        " "
                        (quote-line line)
                        ": typed, lands at "
                        got
                        ", written at "
                        want)]))))))))))

;; ---- 4. the restart invariant --------------------------------------------------------------

(defn- clip-from (spans from)
  ;; `spans` from offset `from` on, a span across it cut there
  (vec (seq/keep spans (fn ([start end face]) (when (> end from) [(math/max start from) end face])))))

(sig excerpt (string int -> string))
(defn- excerpt (text at)
  ;; the twenty characters of `text` from `at`, for a message
  (string/substring text at (math/min (count text) (+ at 20))))

(def- *restart-positions*
  ;; the most line starts a restart check asks about: every Nth line of a longer sample
  80)

(def- *restart-backscan*
  ;; the lead-in, in lines, the second pass gives a restart: a sample is shorter than the
  ;; editor's `spancache/ed-fontify-backscan`, so a window far below a construct opened above its
  ;; lead-in (a `<?php`, a long docstring) is made by cutting the lead-in short
  12)

(defn- restart-problem (sample context position lead-start)
  ;; why fontifying from the restart for the line at `position` paints otherwise, or nil. The
  ;; window is cut as a pane cuts one (`spancache/ed-restart-window`): the restart sees the text
  ;; from `lead-start` on, read after what the mode's `:fontify-around` says the text above leaves
  ;; open. A cut lead-in the restart found no point in is the backscan's guess, which proves
  ;; nothing, even read after the right text: a module's body without its `defmodule`
  (let ({:keys [fontify restart around rope whole]} context
        text (:text sample)
        chunk (string/substring text lead-start (count text))
        local (restart chunk (- position lead-start))
        line (inc (line-at sample position)))
    (if (not (and (int? local) (<= 0 local (- position lead-start))))
      [line
        (str "line "
          line
          ": restart answered "
          (pr-str local)
          ", not an offset at or before "
          (- position lead-start))]
      (let ([source base lead _] (spancache/ed-restart-window rope
                                   chunk
                                   lead-start
                                   (- position lead-start)
                                   restart
                                   around))
        (when (or (= lead-start 0) (> base lead-start))
          (let (window (editor/highlight/shift-spans (fontify source) (- base lead))
                want (clip-from whole position)
                got (clip-from (vec window) position))
            (when (not (= want got))
              (let (index (seq/find (range (math/max (count want) (count got)))
                            (fn (i) (not (= (get want i) (get got i)))))
                    at (first (or (get want index) (get got index))))
                [line
                  (str "line "
                    line
                    ": from the restart at line "
                    (inc (line-at sample base))
                    (if (= lead-start 0)
                      ""
                      (str " (a lead-in from line " (inc (line-at sample lead-start)) ")"))
                    (if (= lead 0)
                      ""
                      (str " read after " (pr-str (string/substring source 0 lead))))
                    ", the window paints "
                    (pr-str (get got index))
                    " where the whole text paints "
                    (pr-str (get want index))
                    " (at "
                    (pr-str (excerpt text at))
                    ")")]))))))))

(defn restart-problems (sample)
  "At every line start (every Nth past `*restart-positions*` lines, and every line the known
gaps list for it), fontifying from where the mode's `:fontify-restart` says a window may begin
must paint what fontifying the whole text paints, from that line on — the property a windowed
fontify relies on. Twice: the restart seeing all the text above, then only a short lead-in,
read after what the mode's `:fontify-around` says the text above it
leaves open (a `<?php`, a docstring) — cut as a pane cuts it
(`spancache/ed-restart-window`). A mode that declines to restart has nothing to prove."
  (let (buffer (:buffer sample)
        restart (ed-mode-service buffer :fontify-restart)
        fontify (ed-mode-service buffer :fontify)
        lines (:lines sample))
    (if (nil? restart)
      []
      (let (context {:fontify fontify
                     :restart restart
                     :around (ed-mode-service buffer :fontify-around)
                     :rope (text/string-> (:text sample))
                     :whole (vec (fontify (:text sample)))}
            stride (math/max 1
                     (math/quot (+ (count lines) (dec *restart-positions*)) *restart-positions*))
            starts (:starts sample))
        ;; every Nth line, and every line the known gaps list, so a listed gap off the stride is
        ;; asked about rather than read as passing
        (ratchet sample
          :restart (into []
            (seq/keep (sort (vec (into (into #{} (range 0 (count lines) stride))
                                   (map (gap-lines sample :restart) dec))))
              (fn (index)
                (when (not (contains? (:assertion-lines sample) index))
                  (let (position (nth starts index 0))
                    (or (restart-problem sample context position 0)
                      (when (> index *restart-backscan*)
                        (restart-problem sample
                          context
                          position
                          (nth starts (- index *restart-backscan*) 0))))))))))))))

;; ---- 5. robustness under random edits ------------------------------------------------------

(def- *edit-characters*
  ["{"
    "}" "(" ")" "[" "]" "\"" "'" "`" "\n" "#" "/" "*" "\\" "$" "<" ">" ";" ":" "=" "-" " " "x" "%"
    "@" "|" "\t"])

(defn- span-problems (spans length)
  ;; why `spans` are not in bounds, non-empty, ascending and apart — nil when they are. An empty
  ;; span is a node the parser inserted while recovering, which brood drops where spans are made
  (letrec (walk (fn (rest-spans previous-end)
                  (if (empty? rest-spans)
                    nil
                    (let (span (first rest-spans))
                      (cond
                        (not (and (vector? span)
                               (= (count span) 3)
                               (int? (nth span 0))
                               (int? (nth span 1))))
                          (str "malformed span " (pr-str span))
                        (not (and (<= 0 (nth span 0))
                               (< (nth span 0) (nth span 1))
                               (<= (nth span 1) length)))
                          (str "span "
                            (pr-str span)
                            " empty or out of bounds for "
                            length
                            " characters")
                        (< (nth span 0) previous-end)
                          (str "span " (pr-str span) " overlaps or precedes the one before it")
                        else (walk (rest rest-spans) (nth span 1)))))))
    (walk (vec spans) 0)))

(defn- probe (what thunk)
  ;; nil when `thunk` runs, else what raised
  (check-allow :discarded-catch
    (try
      (do (thunk) nil)
      (catch e (str what " raised: " (if (map? e) (or (:message e) (pr-str e)) (pr-str e)))))))

(defn- draw-edit (buffer seed)
  ;; `[buffer' description seed']`: one single-character insert or delete at a random offset
  (let (length (count (buffer-text buffer))
        [kind seed] (rand/int seed 2)
        [offset seed] (rand/int seed (inc length))
        [which seed] (rand/int seed (count *edit-characters*)))
    (if (or (= kind 0) (= offset length))
      (let (character (nth *edit-characters* which " "))
        [(replace-region buffer offset offset character)
          (str "insert " (pr-str character) " at " offset)
          seed])
      [(replace-region buffer offset (inc offset) "")
        (str "delete "
          (pr-str (string/substring (buffer-text buffer) offset (inc offset)))
          " at "
          offset)
        seed])))

(defn- edited-problems (buffer seed)
  ;; what raised or misbehaved over the edited `buffer`, the probes placed from `seed`
  (let (text (buffer-text buffer)
        length (count text)
        rope (text/string-> text)
        line-count (text/line-count rope)
        service (fn (key) (ed-mode-service buffer key))
        [picks _] (fold (range 3)
                    [[] seed]
                    (fn ([acc at] _)
                      (let ([value next] (rand/int at line-count)) [(conj acc value) next])))
        bols (map picks (fn (line) (text/line->char rope line)))
        fontify (service :fontify)
        indent (service :indent)
        restart (service :fontify-restart)
        fold-extent (service :fold-extent)
        breadcrumbs (service :breadcrumbs))
    (seq/keep (append [(probe "fontify"
                         (fn ()
                           (let (bad (span-problems (fontify text) length))
                             (when bad (error bad)))))]
                (if indent
                  (map bols
                    (fn (bol)
                      (probe (str "indent at " bol)
                        (fn ()
                          (let (column (indent text bol))
                            (when (not (and (int? column) (>= column 0)))
                              (error "edited-problems: the indenter answered " (pr-str column))))))))
                  [])
                (if restart
                  (map bols
                    (fn (bol)
                      (probe (str "restart at " bol)
                        (fn ()
                          (let (cut (restart text bol))
                            (when (not (and (int? cut) (<= 0 cut bol)))
                              (error "edited-problems: the restart answered " (pr-str cut))))))))
                  [])
                (if fold-extent
                  (map picks
                    (fn (line)
                      (probe (str "fold-extent at line " line) (fn () (fold-extent rope line)))))
                  [])
                (if breadcrumbs
                  (map bols
                    (fn (bol)
                      (probe (str "breadcrumbs at " bol)
                        (fn () (breadcrumbs (goto-char buffer bol))))))
                  []))
      identity)))

(defn robustness-problems (sample &optional (seed 1) (edits 20))
  "From `seed`, `edits` single-character inserts and deletes at random offsets, one after
another; after each, the mode's fontify, indent, restart, fold extent and breadcrumbs must not
raise, and its spans must be in bounds, ascending and apart. Deterministic: `rand` is seeded. An
EMPTY span (`[n n face]`, what the kernel answers for a node tree-sitter inserted as MISSING to
recover a parse) paints nothing and is let through."
  (letrec (walk (fn (buffer seed step acc)
                  (if (>= step edits)
                    (into [] (take (reverse acc) 8))
                    (let ([edited description next] (draw-edit buffer seed)
                          found (edited-problems edited next))
                      (walk edited
                        (first (rand/rng next))
                        (inc step)
                        (into acc
                          (map found
                            (fn (problem)
                              (str "edit " (inc step) " (" description "): " problem)))))))))
    (walk (:buffer sample) (rand/seed seed) 0 '())))

;; ---- 7. across the languages ---------------------------------------------------------------
;; A conflict is the project's to answer for when one of its OWN languages is in it: bedit's
;; tree answers for every pair of bedit's, a package's run for its languages against bedit's —
;; never for a pair of bedit's own, which bedit's run already checks.

(defn- registered-specs ()
  ;; `[type spec]` for every registered language, sorted by type
  (seq/sort-by (for ([type spec-ref] (registry/entries :languages/specs) :into [])
                 [type (reflect/eval spec-ref)])
    (fn (pair) (->string (first pair)))))

(defn- claims (pairs own)
  ;; a problem for each word two types claim, one of them in `own` (a set of mode types):
  ;; `pairs` is `[[type word] …]`
  (let (by-word (seq/group-by pairs second))
    (into []
      (seq/keep (seq/sort-by (vec by-word) first)
        (fn ([word claimants])
          (let (types (seq/distinct (map claimants first)))
            (when (and (> (count types) 1) (any? types (fn (type) (contains? own type))))
              (str (pr-str word) " is claimed by " (string/join (sort (map types pr-str)) " and ")))))))))

(defn- own-types (&optional (own nil))
  ;; `own` (mode type names), or this project's languages, as a set of mode types
  (into #{} (map (or own (own-languages)) keyword)))

(defn name-problems (&optional (own nil))
  "No language of this project ([[own-languages]], or the type names `own`) answers to a name
another registered language does — its type's own or a `:names` entry — lowercased, as
`modes/language-named` reads them."
  (claims (for ([type spec] (registered-specs)
                 word
                 (cons (->string type) (get spec :names []))
                 :into [])
            [type (string/lower word)])
    (own-types own)))

(defn interpreter-problems (&optional (own nil))
  "No language of this project ([[own-languages]], or the type names `own`) claims a `#!`
program another registered language does."
  (claims (for ([type spec] (registered-specs) program (get spec :interpreters []) :into [])
            [type program])
    (own-types own)))

(defn spec-problems (&optional (own nil))
  "Every spec this project registers ([[own-languages]], or the type names `own`) passes its
declaring macro's check (`languages/spec-problem`) — its keys, and its `:lsp` and server rows."
  (let (types (own-types own))
    (into []
      (seq/keep (registered-specs)
        (fn ([type spec]) (when (contains? types type) (languages/spec-problem type spec)))))))

(defn pattern-problems ()
  "Every corpus file is claimed by at most one registered language's file pattern — the one its
directory names (a file typed by its `#!` line alone is claimed by none)."
  (let (specs (registered-specs))
    (into []
      (seq/keep (corpus-files)
        (fn (entry)
          (let (claimants (for ([type spec] specs
                                 :when (modes/pattern-matches? (visit-path (:path entry))
                                   (get spec :pattern))
                                 :into [])
                            (->string type)))
            (when (or (> (count claimants) 1)
                    (and (= (count claimants) 1)
                      (not (= (first claimants) (:language entry)))))
              (str (:path entry) " is claimed by " (string/join claimants " and ")))))))))

(defn own-languages (&optional (root nil) (source-paths nil))
  "The mode types of the languages THIS project registers — a spec claimed from a file under one
of its `:source-paths` (`project/*source-paths*`, under the directory the run is in, or
`source-paths` under `root`): every one of bedit's in bedit's tree, a package's own in a
package's — never the bedit a package has as a dependency, which a `:git` one fetches into the
project's `_deps/`. Sorted."
  (let (base (or root (file/cwd))
        directories (map (or source-paths project/*source-paths*)
                      (fn (relative) (path/join base relative))))
    (vec (sort (seq/distinct (for (directory directories
                                    [kind key]
                                    (ownership/claims-under directory)
                                    :when (= kind :languages/specs)
                                    :into [])
                               (->string key)))))))

(defn uncovered-languages ()
  "The languages this project registers ([[own-languages]]) with no corpus directory — each
wants at least one sample."
  (let (covered (into #{} (if (file/dir? *corpus-root*) (file/list-dirs *corpus-root*) [])))
    (vec (seq/reject (own-languages) (fn (type) (contains? covered type))))))

;; ---- the tests: one entry point, for bedit's languages and a package's ------------------------

(defn- checks (sample)
  ;; `[name applies? thunk embedded?]` for every check of `sample`; the indent ones only for a mode that
  ;; indents from the code, and not where the known gaps turn them off. `embedded?`: the check also
  ;; needs the grammars of the languages the sample embeds ([[missing-grammars]])
  (let (indented (indented? sample)
        painting (fn () (painted sample)))
    [["mode" true (fn () (mode-problems sample)) false]
      ["faces: every caret assertion holds" true (fn () (face-problems sample (painting))) false]
      ["faces: the golden listing is what the mode paints"
        true
        (fn () (golden-problems sample (painting)))
        true]
      ["indent: every line as written"
        (and indented (applies? sample :indent))
        (fn () (indent-problems sample))
        false]
      ["indent: re-indented from scratch"
        (and indented (applies? sample :reindent))
        (fn () (reindent-problems sample))
        false]
      ["indent: typed line by line"
        (and indented (applies? sample :typing))
        (fn () (typing-problems sample))
        false]
      ["restart: a window from the restart paints as the whole text does"
        (applies? sample :restart)
        (fn () (restart-problems sample))
        false]
      ["robustness: random edits raise nothing, spans stay in order"
        true
        (fn () (robustness-problems sample))
        false]]))

(defn load-languages ()
  "Load every module of bedit's `languages` context (`languages/load-all`), so each of bedit's
languages is registered — what bedit's project image does before a test runs, and nothing does
for a package that has bedit as a dependency, whose run would otherwise hold its language
against itself alone. Answers how many modules there are."
  (languages/load-all))

(defn prepare ()
  "Make this process ready to check the corpus: bedit's languages loaded ([[load-languages]]),
then every grammar a registered language declares ([[load-grammars]]). What [[define-tests]] and
[[write-golden]] both do first. Answers the set of grammars loaded."
  (load-languages)
  (load-grammars))

(defn define-tests ()
  "Register the corpus's tests: for every sample under `tests/corpus/<mode>/`, each check that
applies to it as a test of its own, named by the file and the check — SKIPPED, and named so,
when its language's grammar is not loadable here ([[load-test-grammar]]:
`$BROOD_TEST_GRAMMARS`, else the user's) — and the checks across the languages. A project with
no corpus registers the cross checks alone, so its languages fail \"has a corpus sample\". What
a corpus test file calls, bedit's (`tests/language_corpus_test.blsp`) and a language package's
alike."
  (prepare)
  (doseq (entry (corpus-files))
    (let (sample (sample entry))
      (describe (str "corpus " (:id sample))
        (doseq ([name applies thunk embedded?] (checks sample))
          (when applies
            (let (missing (missing-grammars sample embedded?))
              (test name
                :skip-unless (empty? missing)
                (missing-text missing)
                (assert= (thunk) []))))))))
  (describe "the languages, against each other"
    (test "no two languages answer to the same name"
      (assert= (name-problems) []))
    (test "no two languages claim the same #! program"
      (assert= (interpreter-problems) []))
    (test "every corpus file is claimed by its own language's file pattern alone"
      (assert= (pattern-problems) []))
    (test "every spec this project registers passes its macro's check, its servers' too"
      (assert= (spec-problems) []))
    (test "every known gap names a sample and a check"
      (assert= (gap-problems) []))
    (test "every language this project registers has a corpus sample"
      (assert= (uncovered-languages) []))))

(defn write-golden (&optional (languages nil))
  "Write the golden face listing (`<file>.faces`, [[golden-text]]) beside every sample of the
corpus — only `languages`' (a vector of mode type names) when given — and answer a line per
sample: `wrote`, `unchanged`, or `skipped` with why (its grammar is not loadable), and a line for
a language with no samples. Run after a deliberate change to a face table or a grammar, then
READ the diff: a keyword that turned into a string is a regression the listing caught, not a
change to bless. `tools/corpus-golden.blsp` calls it in bedit's tree; a package calls it with
`nest eval --test`."
  (let (missing (for (language (or languages []) :when (empty? (corpus-files language)) :into [])
                  (str "no samples "
                    language
                    " — nothing under "
                    (path/join *corpus-root* language)))
        entries (if (empty? languages) (corpus-files) (mapcat languages corpus-files)))
    ;; prepared only when there is a sample to paint: a misspelt language answers at once
    (when (not (empty? entries)) (prepare))
    (into missing
      (map entries
        (fn (entry)
          (let (sample (sample entry)
                path (golden-path (:path sample)))
            (let (missing (missing-grammars sample true))
              (if (empty? missing)
                (let (text (golden-text sample)
                      before (when (file/exists? path) (file/slurp path)))
                  (when (not (= text before)) (file/spit path text))
                  (str (if (= text before) "unchanged " "wrote     ") path))
                (str "skipped   " (:id sample) " — " (missing-text missing))))))))))
