(defmodule keycolumns
  "Keys and what they do, in titled groups, laid out in columns — the shape the key panel
(`panel`: which-key and the transient menus) and the start page (`startpage`) share. Pure
data, no theme and no display: each host paints the lines its own way.

An ENTRY is a map with `:key` (the key as a label, `\"C-x C-f\"`) and `:text` (what it does);
a host may carry more on it (a transient row's `:index`). A GROUP is `{:title :rows}`, its rows
entries, its title a heading or `\"\"`/nil for none. A LINE is `[:heading title]`, `[:row entry]`
or `[:blank]`, one row of a column.")

(def key-gap
  ;; cells between an entry's key column and its text
  2)

(defn key-width (entries)
  "The widest `:key` of `entries`, in cells — the width of their key column.

    (keycolumns/key-width [{:key \"a\"} {:key \"C-x\"}])   ;=> 3"
  (fold entries 0 (fn (widest entry) (math/max widest (string/display-width (:key entry))))))

(defn entry-cell (entry width)
  "`entry` as one line of text: its key padded to `width` cells, the [[key-gap]], its text.

    (keycolumns/entry-cell {:key \"f\" :text \"find\"} 3)   ;=> \"f    find\""
  (str (string/pad-right-cells (:key entry) width) (string/repeat " " key-gap) (:text entry)))

(defn titled? (group)
  "Whether `group` has a heading to show."
  (let (title (:title group)) (and (string? title) (not (= title "")))))

(defn group-lines (group)
  "`group`'s lines: its heading when it has one ([[titled?]]), then a row per entry.

    (keycolumns/group-lines {:title \"G\" :rows [{:key \"a\" :text \"A\"}]})   ;=> [[:heading \"G\"] [:row {:key \"a\" :text \"A\"}]]"
  (into (if (titled? group) [[:heading (:title group)]] [])
    (map (:rows group) (fn (entry) [:row entry]))))

(defn column-lines (column)
  "A column of whole groups as its lines, top to bottom: each group's [[group-lines]], a blank
line between two."
  (vec (rest (mapcat column (fn (group) (into [[:blank]] (group-lines group)))))))

(defn- pack-columns (groups limit)
  ;; `groups`, in order, packed into columns of whole groups no taller than `limit` lines; a
  ;; group taller than `limit` takes a column of its own
  (fold groups
    []
    (fn (columns group)
      (let (last-column (last columns))
        (if (and last-column (<= (count (column-lines (conj last-column group))) limit))
          (assoc columns (dec (count columns)) (conj last-column group))
          (conj columns [group]))))))

(defn balanced-columns (groups count-wanted)
  "`groups` split, in order and whole, into at most `count-wanted` columns, the tallest as
short as it can be — Magit's transient layout. A column is a vector of groups; lay one out with
[[column-lines]]."
  (let (tallest (fold groups 0 (fn (most group) (math/max most (count (group-lines group)))))
        total (count (column-lines groups)))
    (letrec (search (fn (limit)
                      (let (columns (pack-columns groups limit))
                        (if (or (<= (count columns) count-wanted) (>= limit total))
                          columns
                          (search (inc limit))))))
      (search tallest))))

(defn flow-lines (groups rows)
  "`groups` as one run of lines for columns `rows` lines tall, read down then across — which-key's
grid, where a long group runs on into the next column. A blank line parts two groups unless the
next starts a column, and a heading never ends a column (it moves to the top of the next, so it
is never parted from its first row).

    (keycolumns/flow-lines [{:title \"A\" :rows [{:key \"a\"}]} {:title \"B\" :rows [{:key \"b\"}]}] 3)   ;=> [[:heading \"A\"] [:row {:key \"a\"}] [:blank] [:heading \"B\"] [:row {:key \"b\"}]]"
  (fold groups
    []
    (fn (lines group)
      (let (at-top? (fn (placed) (= 0 (math/mod (count placed) rows)))
            spaced (if (at-top? lines) lines (conj lines [:blank]))
            placed (if (and (titled? group) (= (dec rows) (math/mod (count spaced) rows)))
                     (conj spaced [:blank])
                     spaced))
        (into placed (group-lines group))))))

;; ---- columns side by side ------------------------------------------------------------------

(def column-gap
  ;; cells between two columns of a grid
  3)
