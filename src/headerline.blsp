(defmodule headerline
  "The HEADER LINE above each pane (Emacs's `header-line-format`, as breadcrumb-mode fills
it): where the buffer is — the file by its project and the path inside it
(`moneyclub/lib/app.ex`), a buffer without a file by its name — then where point is inside
it, the crumbs the buffer's mode gives (`:breadcrumbs`: an Org heading's path, a
definition's). On when the init file's `:header-line` is; the layout takes the row from the
top of every pane (`panes/ed-header-layout`), so nothing below has to know it is there."
  (:use editor/buffer) ; buffer-file / buffer-name
  (:use editor/display) ; text — the header's op
  (:use model) ; ed-mode-service — a mode's `:breadcrumbs`
  (:use theme)) ; the palette the header faces are formulas over

(theme/defchrome face-header-line {:fg *text* :bg *base*}) ; where the buffer is
(theme/defchrome face-header-crumb {:fg *teal*}) ; where point is inside it
(theme/defchrome face-header-separator {:fg *overlay0*}) ; the ` : ` and ` › ` between them

(defn location (buf)
  "Where `buf` is, as the header names it: a file by its project's directory name and the
path under it (`moneyclub/mix.exs`), a file outside any project by its full path with the
home as `~`, a buffer without a file by its name."
  (let (file (buffer-file buf))
    (if (nil? file)
      (buffer-name buf)
      (let (root (projects/project-root-cached (path/dirname file)))
        (if (and root (string/starts-with? file (str root "/")))
          (str (path/basename root) "/" (string/substring file (inc (string/length root))))
          (path/abbreviate file))))))

(defn crumbs (buf)
  "Where point is inside `buf`: the strings its mode's `:breadcrumbs` service gives for it,
outermost first, or `()` for a mode with none. A crumb service that fails names nothing
rather than taking the frame down with it."
  (let (service (ed-mode-service buf :breadcrumbs))
    (if (nil? service)
      '()
      (let (given (check-allow :discarded-catch (try (service buf) (catch e '()))))
        (if (or (list? given) (vector? given)) (seq/filter given string?) '())))))

(sig header-ops (buffer int int int -> list))
(defn header-ops (buf x y w)
  "The ops painting `buf`'s header line on screen row `y`, from column `x`, `w` wide: its
`location`, then ` : ` and its `crumbs` joined by ` › `, cut at the pane's edge."
  (let (place (location buf)
        trail (crumbs buf)
        pieces (append (list [place face-header-line])
                 (if (empty? trail)
                   '()
                   (append (list [" : " face-header-separator])
                     (rest (mapcat trail
                             (fn (crumb)
                               (list [" › " face-header-separator] [crumb face-header-crumb])))))))
        background (rect y x w 1 face-header-line))
    (letrec (paint (fn (left col acc)
                     (if (or (empty? left) (>= col (+ x w)))
                       (reverse acc)
                       (let ([piece face] (first left)
                             shown (string/clip-cells piece (- (+ x w) col)))
                         (paint (rest left)
                           (+ col (string/display-width shown))
                           (cons (text y col shown face) acc))))))
      (cons background (paint pieces x '())))))
