(defmodule headerline
  "The HEADER LINE above each pane (Emacs's `header-line-format`, as breadcrumb-mode fills
it): where the buffer is — the file by its project and the path inside it
(`moneyclub/lib/app.ex`), a buffer without a file by its name — then where point is inside
it, the crumbs the buffer's mode gives (`:breadcrumbs`: an Org heading's path, a
definition's). On when the init file's `:header-line` is, in every pane whose mode does not head
its own text (`:header-line false`: dired's `/dir:` line already says where it is,
`panes/ed-pane-header?`); the layout takes the row from the top of such a pane
(`panes/ed-header-layout`), so nothing below has to know it is there."
  (:use editor/buffer) ; buffer-file / buffer-name
  (:use editor/display) ; text — the header's op
  (:use model) ; ed-mode-service — a mode's `:breadcrumbs`
  (:use theme)) ; the palette the header faces are formulas over

;; Subtle on purpose: chrome, not content. Secondary-text grey on the recessed mantle, no
;; bold, so the code below stays the brightest thing on screen (2026-11-05: bold full-text
;; read as loud as the code).
(theme/defchrome face-header-line {:fg *fg-chrome-dim* :bg *mantle*}) ; where the buffer is
(theme/defchrome face-header-crumb {:fg *fg-chrome-dim*}) ; where point is inside it
(theme/defchrome face-header-separator {:fg *fg-decor*}) ; the ` : ` and ` › ` between them

(defn location (buf)
  "Where `buf` is, as the header names it: a file by its project's directory name and the
path under it (`moneyclub/mix.exs`), a file outside any project by its full path with the
home as `~`, a buffer without a file by its name."
  (let (file (buffer-file buf))
    (if (nil? file)
      (buffer-name buf)
      (let (root (projects/project-root-cached (path/dirname file))
            relative (projects/path-under root file))
        (if (nil? relative)
          (path/abbreviate file)
          (str (path/basename root) "/" relative))))))

(defn crumbs (buf &optional (tree nil))
  "Where point is inside `buf`: the strings its mode's `:breadcrumbs` service gives for it
(handed `tree`, the held parse of `buf` when there is one — a code mode reads its definitions
off it), outermost first, or `()` for a mode with none. A crumb service that fails names nothing
rather than taking the frame down with it, and is kept for M-x report-bug."
  (let (service (ed-mode-service buf :breadcrumbs))
    (if (nil? service)
      '()
      (let (given (try (service buf tree) (catch e (do (ed-report-error e :breadcrumbs) '()))))
        (if (or (list? given) (vector? given)) (seq/filter given string?) '())))))

(sig header-ops (buffer int int int &optional any -> list))
(defn header-ops (buf x y w &optional (tree nil))
  "The ops painting `buf`'s header line on screen row `y`, across columns `x`..`x+w`: its
`location`, then ` : ` and its `crumbs` joined by ` › `, inset one cell from each edge of
the pane as the mode line's text is — flush, the first glyph sat on the window's edge
(clipped there) or against the divider — and cut a cell before the right one."
  (let (place (location buf)
        trail (crumbs buf tree)
        pieces (append (list [place face-header-line])
                 (if (empty? trail)
                   '()
                   (append (list [" : " face-header-separator])
                     (rest (mapcat trail
                             (fn (crumb)
                               (list [" › " face-header-separator] [crumb face-header-crumb])))))))
        background (rect y x w 1 face-header-line)
        ;; the text's own columns: one cell in from each edge of the pane
        right (+ x (math/max 0 (dec w))))
    (letrec (paint (fn (left col acc)
                     (if (or (empty? left) (>= col right))
                       (reverse acc)
                       (let ([piece face] (first left)
                             shown (string/clip-cells piece (- right col)))
                         (paint (rest left)
                           (+ col (string/display-width shown))
                           (cons (text y col shown face) acc))))))
      (cons background (paint pieces (inc x) '())))))

(defn ed-header-layer (m pane buf geometry)
  "The pane's header line in the row the layout gave it (`:header-row`), across its width; `()`
when it has none."
  (let (row (:header-row pane))
    (if (nil? row)
      '()
      (let ([x _ w _] (:rect pane)
            lang (ed-mode-service buf :ts-lang)
            ;; the held parse, for a code mode's crumbs: never a parse on the frame
            tree (when lang
                   (syntaxtree/held-tree-for (syntaxtree/syntax-tree-entry m (:buffer pane))
                     buf lang)))
        (header-ops buf x row w tree)))))

(register-pane-layer :header-line {:rank 10 :slot :chrome :run 'headerline/ed-header-layer})
