(defmodule complete
  "Baseline completion-at-point for the editor — a small, **ricing-ready** popup.

`cmd-complete` (bound to Tab in `input`) completes the word before point: one
candidate inserts directly, several open a popup, none reports in the echo area.
While the popup is open `input` routes control keys here — C-n/↓ and C-p/↑ move,
Enter/Tab accept, Esc/C-g cancel; any other key dismisses it and is processed
normally (so you keep typing). `view` overlays `complete-popup-ops`.

The SOURCE hook `completion-candidates` is redefinable live (baseline = distinct words
in the current buffer; redefine to complete global symbols, file paths, snippets, …).
The LOOK (`*completion-*-face*`, `*completion-max*`) and the menu rendering itself live
in the shared `completion` framework, which `mincomplete`/the minibuffer also use.

Pure (data→data) apart from reading the buffer; the popup is plain render ops, so
it's unit-testable without a window."
  (:use editor/buffer)  ; buffer text/point + edit ops
  (:use model)  ; current-buffer accessors, message
  (:use completion)  ; the shared fuzzy ranking + vertical-menu renderer (+ the look config)
  (:use editor/display))  ; the `text` render op for the popup

;; ---- what counts as a completion word ---------------------------------------

(defn complete-word-char? (c)
  "True if `c` (a 1-char string) is part of a completion word. Lispy: letters,
digits, and `- _ ? ! * / < > = +` etc. — i.e. not whitespace or a delimiter."
  (not (or (= c " ")
         (= c "\t")
         (= c "\n")
         (= c "(")
         (= c ")")
         (= c "[")
         (= c "]")
         (= c "{")
         (= c "}")
         (= c "\"")
         (= c ";")
         (= c ",")
         (= c "'")
         (= c "`"))))

(defn complete--prefix-start (text p)
  "The start index of the word-char run ending at `p`."
  (if (or (<= p 0) (not (complete-word-char? (char-at text (dec p)))))
    p
    (complete--prefix-start text (dec p))))

;; ---- candidate source (redefine `completion-candidates` to rice) ------------

;; `cur` accumulates the current word as a *reversed char list* (each `cons` is O(1)),
;; flushed to a string with `list->string` only at the word boundary. The previous
;; `(str cur c)` per char rebuilt the whole word string each step — O(wordlen²); this is
;; O(wordlen). (`string->list` already walks the text once, so word access stays O(n).)
(defn complete--words--step (acc c)
  (let (cur (first acc) done (second acc))
    (if (complete-word-char? c)
      [(cons c cur) done]
      (if (empty? cur) acc [() (cons (list->string (reverse cur)) done)]))))

(defn complete--words (text)
  "Every maximal run of word chars in `text`, as a list (with duplicates)."
  (let (r (fold complete--words--step [() ()] (string->list text))
        cur (first r)
        done (second r))
    (if (empty? cur) done (cons (list->string (reverse cur)) done))))

(defn complete--buffer-words (m)
  "The distinct words of the current buffer — the (prefix-independent) word *universe*
the baseline completion source draws from. Scanning the buffer is O(buffer); the popup
caches this on open so a narrowing keystroke re-filters the cache instead of re-scanning."
  (distinct (complete--words (buffer-text (ed-current-buf m)))))

(defn completion-candidates-of (words prefix)
  "The `words` that start with `prefix` and aren't exactly it, sorted — the pure
prefix-filter shared by the open scan and the cached narrowing path."
  (sort (filter (fn (w) (and (starts-with? w prefix) (not (= w prefix)))) words)))

(defn completion-candidates (m prefix)
  "Candidates for `prefix`. **Redefine to plug in another source** (global symbols
via `all-globals`, file paths, snippets, …). Baseline: the distinct words in the
current buffer that start with `prefix` and aren't exactly it, sorted."
  (completion-candidates-of (complete--buffer-words m) prefix))

;; ---- applying a completion --------------------------------------------------

(defn complete--apply (m start word)
  "Replace the text in [start, point) with `word` and close the popup."
  (let (buf (ed-current-buf m)
        p (buffer-point buf)
        buf2 (replace-region buf start p word))
    (assoc (ed-set-buf m buf2) :completion nil :status "modified")))

(defn complete--default-at (m)
  "The baseline `[start prefix candidates words]` for completion at point: the buffer
word before point, the prefix-matching distinct buffer words, and `words` — the full
distinct-word *universe* the candidates were filtered from. The popup caches `words` so a
narrowing keystroke re-filters it (`completion-candidates-of`) instead of re-scanning the
whole buffer. The fallback when the buffer's mode offers no `:complete-at` service."
  (let (buf (ed-current-buf m)
        text (buffer-text buf)
        p (buffer-point buf)
        start (complete--prefix-start text p)
        prefix (substring text start p)
        words (distinct (complete--words text)))
    [start prefix (completion-candidates-of words prefix) words]))

(defn complete--at (m)
  "`[start prefix candidates]` for completion at point. Delegates to the current
buffer's mode `:complete-at` service when it has one (e.g. `brood-mode` completes
live global symbols), else the buffer-word default. This is the seam that lets a
language mode supply its own completion without `complete` naming the language."
  (let (buf (ed-current-buf m)
        text (buffer-text buf)
        p (buffer-point buf)
        svc (ed-mode-service buf :complete-at))
    (if (nil? svc)
      (let ([start prefix candidates words] (complete--default-at m)) [start prefix candidates])
      (svc text p))))

(defn cmd-complete (m key)
  "Completion-at-point (Tab): complete the symbol/word before point via the current
buffer's mode (`:complete-at`) or the buffer-word default, **fuzzy-ranked**. One match
inserts directly; several open the popup; none echoes a note; an empty prefix is a no-op."
  (let (svc (ed-mode-service (ed-current-buf m) :complete-at)
        ;; default source → [start prefix items words]; mode source → words = nil (the
        ;; service is re-queried each refresh, so there's nothing buffer-scoped to cache).
        [start prefix items0 words] (if (nil? svc)
                                      (complete--default-at m)
                                      (let ([s p c] (complete--at m)) [s p c nil]))
        items (completion-rank prefix items0))
    (if (= prefix "")
      (message m "nothing to complete")
      (cond
        (empty? items) (message m (str "no completions for \"" prefix "\""))
        (= (count items) 1) (complete--apply m start (first items))
        else (assoc m :completion {:items items :index 0 :start start :prefix prefix :words words})))))

;; ---- popup navigation (input routes control keys here) ----------------------

(def *completion-keys*
  ;; non-printable keys the popup consumes for navigation/accept/cancel
  [:ctrl-n :down :ctrl-p :up :enter :tab :escape :ctrl-g])

(defn complete-control-key? (input)
  "Whether the open popup consumes `input`: a nav/accept/cancel key, **a printable
word-char** (Corfu-style live-narrow — it's inserted and the list re-filters), or
Backspace (narrow back). Any other key dismisses the popup and is processed normally."
  (or (some? (fn (k) (= k input)) *completion-keys*)
    (= input :backspace)
    (and (string? input) (complete-word-char? input))))

(defn complete-cancel (m) "Dismiss the completion popup." (assoc m :completion nil))

(defn complete--move (m d)
  (let (c (get m :completion) n (count (get c :items)))
    (assoc m :completion (assoc c :index (mod (+ (get c :index) d) n)))))

(defn complete-accept (m)
  (let (c (get m :completion))
    (complete--apply m (get c :start) (nth (get c :items) (get c :index)))))

(defn complete--edit (m f)
  "Apply a `buffer -> buffer` edit `f` to the current buffer (marking it modified) —
the narrowing keystroke's insert/delete."
  (assoc (ed-set-buf m (f (ed-current-buf m))) :status "modified"))

(defn complete--refresh (m)
  "Recompute the popup from the current point after a narrowing edit, closing it when the
prefix is empty or nothing matches. The default (buffer-word) source re-filters the
**cached word universe** (`:words`, captured on open) against the new prefix — read with
an O(prefix) `rope-slice`, not a whole-buffer scan — so narrowing a large buffer costs
nothing per keystroke; only the word at point ever changes and it's always excluded, so
the cache stays exact across both typing and backspace. A mode source (`:words` nil) is
re-queried via `complete--at`."
  (let (c (get m :completion)
        words (get c :words))
    (if (nil? words)
      (let ([start prefix items0] (complete--at m)
            items (completion-rank prefix items0))
        (if (or (= prefix "") (empty? items))
          (assoc m :completion nil)
          (assoc m :completion {:items items :index 0 :start start :prefix prefix})))
      (let (buf (ed-current-buf m)
            start (get c :start)
            prefix (rope-slice (buffer-rope buf) start (buffer-point buf))
            items (completion-rank prefix (completion-candidates-of words prefix)))
        (if (or (= prefix "") (empty? items))
          (assoc m :completion nil)
          (assoc m :completion {:items items :index 0 :start start :prefix prefix :words words}))))))

(defn complete-handle (m input)
  "Fold a popup-control key: C-n/↓ C-p/↑ move; Enter/Tab accept; a word-char inserts and
re-narrows; Backspace deletes and re-narrows; Esc/C-g cancel."
  (cond
    (or (= input :ctrl-n) (= input :down)) (complete--move m 1)
    (or (= input :ctrl-p) (= input :up)) (complete--move m -1)
    (or (= input :enter) (= input :tab)) (complete-accept m)
    (= input :backspace) (complete--refresh (complete--edit m delete-backward-char))
    (and (string? input) (complete-word-char? input)) (complete--refresh (complete--edit m
                                                                           (fn (b) (insert b input))))
    else (complete-cancel m)))  ; :escape / :ctrl-g

;; ---- rendering (overlay the menu; view splices these ops in) ----------------

(defn complete-popup-ops (m cols rows)
  "Render ops for the completion menu (empty when no popup is open): the shared
`completion` vertical menu (`completion-menu-ops`) anchored at point — a window of
`*completion-max*` items scrolled around the selection, flipped above point when
there's no room below."
  (let (c (get m :completion))
    (if (nil? c)
      []
      (let (buf (ed-current-buf m)
            items (get c :items)
            idx (get c :index)
            total (count items)
            ;; cap to the text area too, so a short window never paints the menu
            ;; over the mode line / echo (or off the bottom edge)
            ;; reserve 2 rows for the box frame (top/bottom) inside the text area
            vis (max 1 (min *completion-max* total (- rows 4)))
            wstart (completion-window-start total idx vis)
            window (take vis (drop wstart items))
            w (completion-menu-width window)
            crow (- (buffer-current-line buf) (ed-current-top m))
            col (max 0 (min (- cols (+ w 4)) (buffer-column buf)))
            ;; place the (vis+2)-tall box below the cursor line if it fits, else above
            below? (<= (+ crow 1 (+ vis 2)) (- rows 2))
            row0 (max 0 (if below? (+ crow 1) (- crow (+ vis 2)))))
        (completion-menu-ops window wstart idx row0 col w)))))
