(defmodule formatter
  "Run the language's own formatter over a buffer — `M-x format-buffer`, and on save.

**Why the language's formatter and not the indenter.** bedit can indent Elixir line for
line, and does. It cannot decide where to break a long call, how to align a pipeline, or
whether a keyword list fits on one line — and those are the changes `mix format` makes.
Emacs learned the same thing: `elixir-ts-mode` indents, and `mix format` formats, and the
sensible default is to let the language's own tool own the whole answer on save. A
formatter is also the ground truth the indenter is checked against
(`tests/modes_test.blsp` diffs a real module against `mix format`), so running it is not
a second opinion — it is the one this editor already defers to.

**How.** A formatter is a service on the buffer's mode (`:format-command`, declared by
`languages/core/deflanguage`), so nothing here names a language: ask the buffer what formats it,
append the file, run it, re-read. Almost every formatter is file-in-place — `mix format
FILE`, `black FILE`, `rustfmt FILE` — which decides the order:

  1. write the buffer, so the formatter sees what you typed;
  2. run the formatter on the FILE;
  3. re-read the file into the buffer, keeping point on its line.

If the formatter fails, step 3 finds the file exactly as step 1 wrote it, so a broken
formatter or a syntax error costs nothing but a message. That is the whole reason it goes
through the file rather than piping the buffer: a formatter that refuses to parse a
half-written function must leave the text alone, and a pipe would hand back its empty
output."
  (:use model) ; ed-mode-service / ed-current-buf / ed-set-buf / message
  (:use pool) ; ed-find-file
  (:use file-save :only [ed-save-buf-at])
  (:use interactive) ; defcommand
  (:use editor/buffer) ; buffer-file / buffer-text / goto-char / buffer-point
  (:use editor/buffer-file)
  (:use task)) ; task — the formatter runs off the loop
(defdyn *format-on-save*
  ;; Off by default: reformatting a file someone did not ask to reformat is a large,
  ;; surprising diff, and in a shared repo it is a diff with someone else's name on the
  ;; lines. Turn it on per user (`~/.config/bedit/init.blsp`), where the person who owns
  ;; the repo's conventions is the one deciding.
  false)

(defn format-alternatives (declared)
  "The formatter commands a `:format-command` service declares, in preference order: one
command `[prog arg …]`, or several `[[prog arg …] …]` when more than one program formats
the language — `terraform fmt` and OpenTofu's `tofu fmt` — as an LSP row lists its
servers. `[]` for none.

    (formatter/format-alternatives [\"gofmt\" \"-w\"])   ;=> [[\"gofmt\" \"-w\"]]
    (formatter/format-alternatives [[\"terraform\" \"fmt\"] [\"tofu\" \"fmt\"]])   ;=> [[\"terraform\" \"fmt\"] [\"tofu\" \"fmt\"]]"
  (cond
    (or (nil? declared) (empty? declared)) []
    (string? (first declared)) [(into [] declared)]
    else (into [] (seq/filter declared (fn (command) (not (empty? command)))))))

(defn format-command-choice (declared)
  "The command to run from a `:format-command` declaration: the first alternative whose
program is installed, else the first — so a machine with none runs the one the language
prefers and says that it is missing, rather than saying nothing formats the buffer. nil
when nothing is declared."
  (let (alternatives (format-alternatives declared))
    (or (seq/find alternatives (fn (command) (not (nil? (os/which (first command))))))
      (first alternatives))))

(defn buffer-layout (buffer)
  "The layout conventions `buffer` is edited with, as plain data — what a `:format-command`
that is a function is given, so a formatter whose flags override the project's own settings
(shfmt's `-i` silences its `.editorconfig`) can say the buffer's instead: `:indent-width`,
`:indent-tabs`, `:tab-width` and `:fill-column` (`conventions`)."
  {:indent-width (conventions/indent-width buffer)
   :indent-tabs (conventions/indent-tabs? buffer)
   :tab-width (conventions/tab-width buffer)
   :fill-column (conventions/fill-column buffer)})

(defn declared-format (buffer)
  "What `buffer`'s mode declares formats it (its `:format-command`): a command, alternatives
([[format-alternatives]]), or a function of the buffer's layout ([[buffer-layout]]) answering
either — called here, with the buffer at hand."
  (let (declared (ed-mode-service buffer :format-command))
    (if (fn? declared) (declared (buffer-layout buffer)) declared)))

(defn format-command-for (buffer)
  "`[prog arg … file]` that formats `buffer`, or nil when its mode declares no formatter or
the buffer has no file. Of several alternatives, the first installed one
(`format-command-choice`). The file is appended because every formatter worth having
takes it last."
  (let (command (format-command-choice (declared-format buffer))
        file (buffer-file buffer))
    ;; a file on another machine (`/ssh:…`): a formatter here cannot reach it
    (when (and command file (not (sshpath/remote? file))) (into (into [] command) [file]))))

(defn format-job (buffer)
  "What running `buffer`'s formatter takes, as plain data: `{:argv :root :file}`, or nil
when it has none. Worked out on the loop — the formatter is a MODE service, and a task can
see neither the model nor a buffer — so the part that can take seconds carries only this.

`:root` is the file's PROJECT root: `mix format` reads `.formatter.exs` from the directory
it runs in, so run from `lib/foo/` it would ignore the project's `import_deps` and plugins
and reformat Ecto's `field :x` with parens."
  (let (argv (format-command-for buffer))
    (when argv
      (let (file (buffer-file buffer)
            dir (if file (path/dirname file) (or (:dir buffer) ".")))
        {:argv argv :root (or (projects/project-root dir) dir) :file file}))))

(defn format-run (job)
  "Run a `format-job`. `[ok? detail]` — `detail` is the formatter's own complaint on
failure, which is the useful half (a syntax error names the line). Plain data in and out,
so it runs in a task."
  (let (argv (:argv job)
        run (os/cmd (first argv) (into [] (rest argv)) {:cwd (:root job)})
        output (string/trim (str (get run :stderr) (get run :stdout))))
    (if (= (get run :exit) 0)
      [true (first argv)]
      [false (if (= output "") (str (first argv) " exited " (get run :exit)) output)])))

(defn format-land (m saved-rope file result)
  "Fold a finished formatter run (`result` is `format-run`'s `[ok? detail]`) into the buffer
visiting `file`: re-read the formatted file into it, keeping point.

Only while the buffer still holds exactly the text the save wrote (`saved-rope`). The
formatter runs OFF the loop, so you can type while it runs; if you did, re-reading
would throw away what you typed. Your edits win, and the message says the file on disk is
the formatted one — which the next C-x C-s notices and asks about, as it should.

Point is followed by the line diff of the old text and the formatted one
(`autorevert/ed-follow-reread`, every pane on the buffer too), not kept as a line number or an offset: a formatter may
join or split lines, so the same number means another line afterwards, and lines it added
above point would move an offset onto some other line. An untouched line keeps point
exactly; a reformatted one keeps its column, clamped to the line."
  (let ([ok detail] result
        index (ed-buffer-index-by-file m file)
        buffer (if (nil? index) nil (ed-buf-at m index)))
    (cond
      (not ok) (message m (str "format failed: " detail))
      (or (nil? index) (nil? buffer)) (message m (str "formatted " file))
      (not (= (buffer-rope buffer) saved-rope))
        (message m (str "formatted " file " on disk — kept your edits since the save"))
      else
      ;; a re-read that fails is said as "format failed": the file on disk is formatted either way
        (check-allow :discarded-catch
          (try
            (let (formatted (:text (file-text-decode (charset/read-text file (:coding buffer))))
                  reread (editor/buffer/replace-region buffer 0 (buffer-length buffer) formatted)
                  landed (autorevert/ed-follow-reread (ed-set-buf-at m
                                                        index
                                                        (buffer-stamp-file (mark-buffer-saved reread)))
                           index buffer))
              (message landed
                (if (= formatted (buffer-text buffer))
                  ;; already canonical: say so rather than reporting a no-op as work
                  (str "saved " file " (already formatted)")
                  (str "saved and formatted " file))))
            (catch e (message m (str "format failed: " (error-message e)))))))))

;; `mix format` takes seconds, so not on the loop — `model/register-task-reply`
(register-task-reply :format-proc 'formatter/format-apply nil "formatting")
(defn format-apply (m result)
  "The `:format-proc` task's reply, folded: the job's `[ok? detail]`, or nil when the task
errored or timed out."
  (let (pending (:format-pending m)
        m1 (dissoc m :format-proc :format-pending))
    (cond
      (nil? pending) m1
      (nil? result) (message m1 (str "format of " (:file pending) " failed or timed out"))
      else (format-land m1 (:rope pending) (:file pending) result))))

(defn format-buffer-now (m)
  "Save, then format — the save at once, the formatter off the loop.

The write is the plain save (`ed-save-buf-at`), so a format is a save in every respect
that matters afterwards: the buffer is unmodified, its auto-save file is gone, and it is
stamped with the file's mtime — also when the formatter then FAILS.

The formatter itself runs in a task (`:format-proc`): `mix format` on a real project takes
seconds, which on the loop would freeze the window until it finished. Headless — a test, a batch run — has no loop for a reply to come back to,
so it runs inline there, as every other off-loop job does."
  (let (buffer (ed-current-buf m)
        file (buffer-file buffer)
        job (format-job buffer))
    (cond
      (nil? file) (message m "no file to format")
      (nil? job) (message m (str "no formatter for " (or (ed-buf-mode-name buffer) "this buffer")))
      ;; still a SAVE: C-x C-s comes through here when format-on-save is on, and a format
      ;; already in flight must not turn it into a no-op
      (:format-proc m)
        (ed-save-buf-at m
          (ed-current-index m)
          (fn (saved)
            (message saved (str "saved " file " — not formatted, a format is still running"))))
      ;; the format follows the write once it has LANDED (the save is off the loop); a write
      ;; that fails says so and formats nothing
      else (ed-save-buf-at m (ed-current-index m) (fn (saved) (format-after-save saved file job))))))

(defn- format-after-save (m file job)
  "The formatter run over `file` once its save has landed — inline headless, else in a task.
Not when the buffer was edited while the write was out (what the formatter would rewrite is
not what you see), nor while another format runs."
  (let (index (ed-buffer-index-by-file m file)
        saved (when index (ed-buf-at m index)))
    (cond
      (nil? saved) m
      (buffer-modified? saved)
        (message m (str "saved " file " — not formatted, edited since the save"))
      (:format-proc m) (message m (str "saved " file " — not formatted, a format is still running"))
      (ed-headless?) (format-land m (buffer-rope saved) file (format-run job))
      else
        (assoc m
          :format-proc (task (fn () (format-run job)) {:timeout 60000})
          :format-pending {:file file :rope (buffer-rope saved)}))))

(defcommand cmd-format-buffer
  (m key)
  "Format the current buffer with its language's own formatter (M-x format-buffer):
`mix format` in Elixir, `black` in Python, whatever `languages/core/deflanguage` declared. Saves
first, so the formatter sees what you typed, and re-reads afterwards. A buffer whose
language declares no formatter says so and changes nothing."
  (format-buffer-now m))

(defn on-save (m)
  "The save path's hook: format when `*format-on-save*` is on and this buffer has a
formatter, else leave the plain save alone. Returns nil when it did not act, so the
caller keeps its own message."
  (when (and *format-on-save* (format-command-for (ed-current-buf m))) (format-buffer-now m)))
