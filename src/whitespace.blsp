(defmodule whitespace
  "Whitespace made visible (Emacs's `whitespace-mode` with `whitespace-style` `(face
tab-mark trailing)`, which the user turns on from `prog-mode-hook`): trailing whitespace
tinted as a mistake, and every tab marked, as highlight ranges the view tiles with the
region and the search hits. Per mode through the init file's `:show-whitespace`
(`scroll/ed-mode-setting`, e.g. `{:default false :prog true}`).

The run point is typing at the end of is left alone (Emacs's `show-trailing-whitespace`
does the same): a space typed before the next word is not yet a mistake."
  (:use editor/buffer) ; buffer-rope / buffer-point
  (:use memo) ; defmemo — asked every frame, recomputed only when the text or the window moves
  (:use theme)) ; the palette the faces are formulas over

(theme/defchrome face-whitespace-trailing {:bg (theme/mix *red* *base* 0.35)}) ; whitespace-trailing
(theme/defchrome face-whitespace-tab {:bg (theme/mix *overlay0* *base* 0.18)}) ; whitespace-tab

(defn- line-ranges (rope line point)
  ;; the ranges of `line`: its trailing run (unless point is in it) and each tab
  (let (text (wrap/rope-line-text rope line)
        bol (text/line->char rope line)
        n (string/length text)
        trimmed (string/length (string/trimr text))
        trailing (if (or (= trimmed n) (and (>= point (+ bol trimmed)) (<= point (+ bol n))))
                   '()
                   (list [(+ bol trimmed) (+ bol n) face-whitespace-trailing]))
        tabs (seq/keep (range n)
               (fn (i)
                 (when (and (< i trimmed) (= (string/char-at text i) "\t"))
                   [(+ bol i) (+ bol i 1) face-whitespace-tab]))))
    (append tabs trailing)))

(check-allow :trusted
  (defmemo ranges-at 4 (rope top rows point faces)
    "`ranges`, remembered on what it reads (`faces` is the two faces, so a theme switch
recomputes)."
    (let (last-line (math/min (dec (text/line-count rope)) (+ top rows)))
      (mapcat (range top (inc last-line)) (fn (line) (line-ranges rope line point))))))

(defn ranges (buf top rows)
  "The whitespace highlight ranges `[from to face]` of `buf`'s lines `top` through
`top + rows`: each tab, and each line's trailing whitespace but the run point is in."
  (ranges-at (buffer-rope buf)
    top
    rows
    (buffer-point buf)
    [face-whitespace-trailing face-whitespace-tab]))
