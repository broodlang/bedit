(defmodule hosted
  "Back POOL buffers with buffer PROCESSES — the actor-architecture seam
(`docs/actor-architecture.md`), generalized from the collab layer that proved it.

A HOSTED slot is a pool buffer whose content is authoritative in a
`std/editor/buffer` process; the pool value is the local **projection cache** — the
pure view renders it unchanged, commands edit it unchanged (`model -> model`,
local-apply-first: the caret never waits on a round-trip). The loop tail
(`hosted-step`) diffs each event's change and ships it to the slot's process as a
based positional splice; the process pushes `[:buffer-updated …]` deltas back, folded
into the cache by `hosted-apply-content`. All of the protocol — splice diff, echo
suppression, transform of foreign splices over in-flight ones, resync — is std
`editor/buffer-client`; a slot's record under

  :hosted  {pool-index <link + presence keys>}

IS its link (`{:proc :me :version :pending}`). What hosting buys a LOCAL buffer:
the process is subscribable (remote sessions, services, mirrors attach to it — a
collab-shared buffer is just a hosted buffer whose process has remote subscribers),
it is an `[:io/write]` log sink, and it is a fault boundary (a crashed buffer process
is rehosted from the cache — the pool value doubles as the crash-recovery copy).

Presence (cursors, name tags, follow) is the collab module's layer on top; this
module is content only."
  (:use editor/buffer) ; spawn-buffer / subscribe / replace-region / ed-stamp deps
  (:use editor/buffer-client) ; link-init / link-propagate / link-fold / view-parts
  (:use model)) ; ed-buf-at / ed-stamp
(defn- hosted-proj
  (b)
  "The subscription projection: `[text markers participants]` — the document, every
marker (pid → offset; presence cursors ride these), and the pid → name registry.
Sent on the seed and on closure edits; structured ops push O(change) deltas instead."
  [(buffer-text b) (buffer-markers b) (:participants b {})])

(defn ed-hosted? (m &optional i)
  "Whether pool slot `i` (default the current buffer's) is backed by a buffer process."
  (let (idx (or i (ed-current-index m)))
    (not (nil? (get-in m [:hosted idx])))))

(defn hosted-slot-for-proc (m proc)
  "The pool index whose hosted link points at buffer process `proc`, or nil if none does."
  (let (hit (seq/find (fn (kv) (= (:proc (second kv)) proc))
              (map-pairs (or (:hosted m) {}))))
    (if hit (first hit) nil)))

(defn ed-host-slot (m i &optional proc)
  "Back pool slot `i` with a buffer process: the given `proc` (a shared / registry
buffer that already exists), or one spawned from the slot's current cache when nil (a
locally-hosted buffer — the common case). Subscribes this model's process for pushes
(`hosted-proj`) and records the link at version -1, so the seed push always applies
and syncs the slot to the process's current text. Returns the model."
  (let (bp (or proc (spawn-buffer (ed-buf-at m i))))
    ;; monitored: its death lands as [:down …] → hosted-rehost / collab-reshare (the
    ;; ref rides the link so unhosting can demonitor — no ghost corpse messages)
    (let (mref (monitor bp))
      (subscribe-buffer bp hosted-proj)
      (assoc-in m [:hosted i] (assoc (link-init bp (self)) :mref mref)))))

(defn ed-unhost-slot (m i &optional stop?)
  "Drop pool slot `i`'s hosted link: unsubscribe this model's process (the slot's
content stops tracking; the local copy stays as an ordinary pool buffer), and with
`stop?` also stop the buffer process — right for a locally-owned host (kill-buffer),
wrong for a shared/registry process that outlives its subscribers. A no-op when the
slot isn't hosted."
  (let (proc (get-in m [:hosted i :proc])
        mref (get-in m [:hosted i :mref]))
    (if (nil? proc)
      m
      (do
        (when mref (demonitor mref))
        (unsubscribe-buffer proc)
        (when stop? (stop-buffer proc))
        (assoc m :hosted (dissoc (:hosted m) i))))))

(defn hosted-propagate (before after &optional skip-i)
  "Ship each event's text changes to their slots' processes: for every hosted slot
whose text differs between `before` and `after`, `link-propagate` (std
`editor/buffer-client`) sends the positional splice as a based structured
`buffer-splice` (a DELTA on the wire) tagged with our id, counting it in the slot's
`:pending` (in flight until its echo returns). Returns `after` with those counts.
This is what lets every editing command stay `model -> model` with no knowledge of
hosting — the loop calls this once per event (`hosted-step`). `skip-i` exempts one
slot: the one a folded push just rewrote (that change IS the process's own truth).

An unchanged slot costs one ROPE-HANDLE compare (an edit mints a fresh rope; movement
keeps it), so a keystroke never materialises the text of the slots it didn't touch."
  (fold
    (fn (acc kv)
      (let (i (first kv))
        (if (or (= i skip-i)
              (not (and (< i (count (:buffers before))) (< i (count (:buffers acc))))))
          acc
          (let (ob (ed-buf-at before i)
                nb (ed-buf-at acc i))
            (if (= (buffer-rope ob) (buffer-rope nb))
              acc ; O(1): same rope handle — no edit here, don't even read the text
              (assoc-in acc
                [:hosted i]
                (link-propagate (get-in acc [:hosted i])
                  (buffer-text ob)
                  (buffer-text nb))))))))
    after
    (map-pairs (or (:hosted after) {}))))

(defn hosted-reconcile (m)
  "Host every pool slot that isn't yet — THE FLIP (`docs/actor-architecture.md`):
on a model carrying `:host-buffers?` (the live window loop sets it; tests and
headless models don't, staying pure), every buffer — files, `*Messages*`, dired,
occur — is backed by its own process the moment it appears in the pool, with no
call-site cooperation: buffer creation stays plain pool growth, and the loop tail
reconciles. A model without the flag pays one map lookup; a fully hosted one an
O(1) count compare (hosted keys are exactly the pool indices — `hosted-drop-slot`
keeps that true across kills), so the pool scan runs only on the event that
actually grew the pool."
  (if (or (nil? (:host-buffers? m))
        (= (count (or (:hosted m) {})) (count (:buffers m))))
    m
    (fold (fn (acc i) (if (get-in acc [:hosted i]) acc (ed-host-slot acc i)))
      m
      (range (count (:buffers m))))))

(defn hosted-drop-slot (m killed)
  "Unhost pool slot `killed` ahead of its REMOVAL from the pool (kill-buffer):
stop the process too when it is locally owned (not `:shared?` — a shared host
outlives its subscribers), then shift the `:hosted` keys above `killed` down one,
mirroring the pool shift, so every surviving link still points at its slot.
Also stamps `:pool-shifted` — pool indices no longer name the same documents
across this event, so `hosted-step` must NOT diff before/after by index (it would
ship splice(other-document → this-one) to every surviving process above the kill).
Returns the model; safe on an unhosted slot (still remaps + stamps)."
  (let (sh (get-in m [:hosted killed])
        m1 (if (nil? sh) m (ed-unhost-slot m killed (not (:shared? sh))))
        m1 (assoc m1 :pool-shifted true)
        hosted (:hosted m1))
    (if (nil? hosted)
      m1
      (assoc m1
        :hosted
          (fold (fn (acc kv)
                  (let (i (first kv))
                    (assoc acc (if (> i killed) (dec i) i) (second kv))))
            {}
            (map-pairs hosted))))))

(defn hosted-edit (m op)
  "Apply edit `op` (a `buffer -> buffer` transform, as commands produce) to the current
buffer, propagating explicitly when the slot is hosted: the change goes out as a based
positional splice (`link-propagate`) and the process pushes it to every subscriber —
all holders converge, each with their own cursor. The local pane updates at once (the
caret never waits on a round-trip; the push reconciles). On an unhosted slot this is
exactly `ed-set-buf` with `op` applied — callable unconditionally. (Commands normally
don't need this: the loop-tail `hosted-step` propagates command-agnostically; this is
the explicit-call-site variant — use one or the other per edit, never both.)"
  (let (buf (ed-current-buf m)
        nb (op buf))
    (if (ed-hosted? m)
      (let (i (ed-current-index m))
        (assoc-in (ed-set-buf m nb)
          [:hosted i]
          (link-propagate (get-in m [:hosted i]) (buffer-text buf) (buffer-text nb))))
      (ed-set-buf m nb))))

(defn hosted-rehost (m i)
  "Rehost pool slot `i` after its buffer process DIED: respawn from the pool cache —
which is always current (every edit lands there first), so recovery loses at most
the in-flight splices — resubscribe, and reset the link. The per-buffer fault
boundary: one crashed buffer process never takes the editor (or another buffer)
with it. Echoes the casualty by name."
  (let (name (buffer-name (ed-buf-at m i)))
    (message (ed-host-slot (assoc m :hosted (dissoc (:hosted m) i)) i)
      (str "buffer process for " name " restarted"))))

(defn- hosted-propagate-shifted
  (before after)
  "The pool-RESHAPE variant of `hosted-propagate`: pair each surviving hosted slot
with its `before` document by NAME (`ed-buffer-index-by-name` — pool names are the
standard identity), because the indices shifted and a positional diff would compare
different documents. A slot with no same-named `before` buffer (freshly created
this event) is skipped — its process seeds from current text."
  (fold (fn (acc kv)
          (let (i (first kv)
                nb (if (< i (count (:buffers acc))) (ed-buf-at acc i) nil)
                j (if (nil? nb) nil (ed-buffer-index-by-name before (buffer-name nb))))
            (if (nil? j)
              acc
              (let (ob (ed-buf-at before j))
                (if (= (buffer-rope ob) (buffer-rope nb))
                  acc
                  (assoc-in acc
                    [:hosted i]
                    (link-propagate (get-in acc [:hosted i])
                      (buffer-text ob)
                      (buffer-text nb))))))))
    after
    (map-pairs (or (:hosted after) {}))))

(defn hosted-step (before after input)
  "The loop-tail content hook: host any new pool slot (`hosted-reconcile` — the
every-buffer flip, on flagged models), then propagate this event's edits to every
hosted slot's process. Two exemptions keep the diff honest:

- a `[:buffer-updated …]` event exempts ONLY the slot the push rewrote (re-sending
  the process its own truth would apply it twice) — every OTHER slot still
  propagates, because folding a push can edit other buffers too (a presence echo
  appends to the hosted `*Messages*`, which must not silently diverge from its
  process);
- an event that RESHAPED the pool (`:pool-shifted`, stamped by `hosted-drop-slot`)
  diffs each surviving slot against its `before` slot found BY NAME, not by index:
  the indices shifted, so a positional diff would compare document i with document j
  and ship a corrupting cross-document splice — while skipping outright would lose
  same-event edits (the kill's own \"killed NAME\" echo appended to `*Messages*`).

Costs a map lookup or two on a model with nothing hosted, so ordinary editing pays
nothing."
  (let (m (hosted-reconcile after))
    (cond
      (nil? (:hosted m)) m
      (:pool-shifted m) (hosted-propagate-shifted before (dissoc m :pool-shifted))
      :else
        (hosted-propagate before
          m
          (if (and (vector? input) (= (first input) :buffer-updated))
            (hosted-slot-for-proc m (nth input 1))
            nil)))))

(defn- hosted-rebuilt
  (old text)
  "`old` with its text replaced by `text`, KEEPING every non-content field. A hosted
resync used to `make-buffer` from scratch, which silently dropped the buffer's
`:type`/`:layers` (so its whole mode — keymap, fontify, indent — vanished) along with
every mode-local field: `:git-status`/`:line-links` on a report buffer,
`:bshell-input-start` on a shell, and `:read-only-spans` on the tutorial, whose loss
would unfreeze the read-only prose (the spans are the buffer's own protection now —
ADR-219). The rope is the only thing that should change."
  (let (fresh (make-buffer text (buffer-name old) (buffer-file old)))
    (merge old
      {:rope (get fresh :rope)
       ;; the content changed under us, so point/mark/undo can't be trusted
       :point (min (get old :point 0) (buffer-length fresh))
       :mark nil
       :undo nil
       :pending-undo nil})))

(defn hosted-apply-content (m i version view origin)
  "Fold one push's CONTENT into hosted slot `i`: `link-fold` (std protocol client)
decides — stale drop, own-echo version bump, foreign splice transformed over our
in-flight edits, ambiguous resync, or full-text rebuild — and the action is applied
to the pool cache here. Returns `[m' status]`, status `:stale` (push ignored — the
caller should skip its own layers too) or `:applied`. Every pane's window-local point
is untouched — it lives on the pane, not the buffer."
  (let (sh (get-in m [:hosted i])
        [link action] (link-fold sh version view origin))
    (if (= action :stale)
      [m :stale]
      (let (m1 (assoc m :hosted (assoc (:hosted m) i link))
            old (ed-buf-at m1 i))
        [(cond
           ;; our own echo / a cursor-only delta — content untouched
           (= action :noop) m1
           ;; a foreign DELTA that merges: already transformed over our in-flight
           ;; splices by link-fold — apply in place (O(change), the rope survives)
           (and (vector? action) (= (first action) :splice))
             (let ([lo hi repl] (second action))
               (assoc m1 :buffers (assoc (:buffers m1) i (replace-region old lo hi repl))))
           ;; a genuinely ambiguous collision (same span touched on both sides inside
           ;; one round-trip) → resync the slot from the process (always correct).
           ;; buffer-sync pairs text + version ATOMICALLY: edits applied between the
           ;; ambiguous push and our snapshot are inside the returned text, and
           ;; advancing the link to the snapshot version makes their queued pushes
           ;; drop as stale instead of replaying onto the rebuilt copy (doubling).
           (= action :resync)
             (let (snap (buffer-sync (:proc sh) buffer-text))
               (if (= snap :no-reply)
                 m1 ; process died mid-resync — the [:down] rehost will recover
                 (let ([sv t] snap)
                   (assoc m1
                     :hosted (assoc (:hosted m1) i (assoc link :version sv))
                     :buffers (assoc (:buffers m1)
                                i (ed-stamp (hosted-rebuilt old t)))))))
           ;; [:text s] — a full-text view (closure edits / the seed): rebuild only
           ;; on real change (cheap no-op churn, and local undo state survives)
           (= (second action) (buffer-text old)) m1
           :else
             (assoc m1
               :buffers (assoc (:buffers m1)
                          i (ed-stamp (hosted-rebuilt old (second action))))))
          :applied]))))
