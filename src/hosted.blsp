(defmodule hosted
  "Back POOL buffers with buffer PROCESSES — the actor-architecture seam
(`docs/actor-architecture.md`), generalized from the collab layer that proved it.

A HOSTED slot is a pool buffer whose content is authoritative in a
`std/editor/buffer` process; the pool value is the local **projection cache** — the
pure view renders it unchanged, commands edit it unchanged (`model -> model`,
local-apply-first: the caret never waits on a round-trip). The loop tail
(`hosted-step`) diffs each event's change and ships it to the slot's process as a
based positional splice; the process pushes `[:buffer-updated …]` deltas back, folded
into the cache by `hosted-apply-content`. All of the protocol — splice diff, echo
suppression, transform of foreign splices over in-flight ones, resync — is std
`editor/buffer-client`; a slot's record under

  :hosted  {pool-index <link + presence keys>}

IS its link (`{:proc :me :version :pending}`). What hosting buys a LOCAL buffer:
the process is subscribable (remote sessions, services, mirrors attach to it — a
collab-shared buffer is just a hosted buffer whose process has remote subscribers),
it is an `[:io/write]` log sink, and it is a fault boundary (a crashed buffer process
is rehosted from the cache — the pool value doubles as the crash-recovery copy).

Presence (cursors, name tags, follow) is the collab module's layer on top; this
module is content only."
  (:use editor/buffer) ; replace-region / ed-stamp deps
  (:use editor/buffer-file)
  (:use editor/buffer-server) ; spawn-buffer / subscribe-buffer
  (:use editor/buffer-client) ; link-init / link-propagate-buffers / link-fold / view-parts
  (:use model) ; ed-buf-at / ed-stamp
  (:use editor/buffer-registry)) ; registry-share / -remove / -rekey — one process per document across frames
(defn- hosted-projection (buffer)
  "The subscription projection: std's `content-view` — `[text markers participants
properties]`: the document, every marker (pid → offset; presence cursors ride these), the
pid → name registry and the text properties (a program's colours, brood ADR-579), so a
frame that joins late gets the colours too. Sent on the seed and on closure edits;
structured ops push O(change) deltas instead, each splice with its properties."
  (content-view buffer))

(defn ed-hosted? (m &optional i)
  "Whether pool slot `i` (default the current buffer's) is backed by a buffer process."
  (let (idx (or i (ed-current-index m)))
    (not (nil? (map/get-in m [:hosted idx])))))

(defn hosted-slot-for-proc (m proc)
  "The pool index whose hosted link points at buffer process `proc`, or nil if none does."
  (let (hit (seq/find (%map-pairs (or (:hosted m) {})) (fn (kv) (= (:proc (second kv)) proc))))
    (if hit (first hit) nil)))

(defn ed-host-slot (m i &optional proc)
  "Back pool slot `i` with a buffer process: the given `proc` (a shared / registry
buffer that already exists), or one spawned from the slot's current cache when nil (a
locally-hosted buffer — the common case). Subscribes this model's process for pushes
(`hosted-projection`) and records the link at version -1, so the seed push always applies
and syncs the slot to the process's current text. Returns the model."
  (let (process (or proc (spawn-buffer (ed-buf-at m i))))
    ;; monitored: its death lands as [:down …] → hosted-rehost / collab-reshare (the
    ;; ref rides the link so unhosting can demonitor — no ghost corpse messages)
    (let (monitor-ref (monitor process))
      (subscribe-buffer process hosted-projection)
      (map/assoc-in m [:hosted i] (assoc (link-init process (self)) :mref monitor-ref)))))

(defn ed-unhost-slot (m i &optional stop?)
  "Drop pool slot `i`'s hosted link: unsubscribe this model's process (the slot's
content stops tracking; the local copy stays as an ordinary pool buffer), and with
`stop?` also stop the buffer process — right for a locally-owned host (kill-buffer),
wrong for a shared/registry process that outlives its subscribers. A no-op when the
slot isn't hosted."
  (let (proc (map/get-in m [:hosted i :proc])
        monitor-ref (map/get-in m [:hosted i :mref]))
    (if (nil? proc)
      m
      (do
        (when monitor-ref (demonitor monitor-ref))
        (unsubscribe-buffer proc)
        (when stop? (stop-buffer proc))
        (assoc m :hosted (dissoc (:hosted m) i))))))

;; ---- the buffer registry: buffers global by name across frames -----------------
;; With a `:buffer-reg` on the model (`std/editor/buffer-registry`, started by `main`
;; beside the flip), a slot is hosted THROUGH the registry: the one process for the
;; buffer's name, spawned by whichever frame asks first and handed to every frame after.
;; That is what a second frame (`src/frames.blsp`) shares the buffers by. A registry link
;; is `:registry?` — the registry owns the process; a kill removes it there (global, as in
;; Emacs) and the other frames learn of it as `[:registry-removed …]`.

(defn hosted-meta (buffer)
  "What another frame needs to build its own copy of `buffer` before the seed push fills the
text: `{:file :type :dir :eol :bom :so-long :section-root …}` — the registry entry's `:meta` (`:eol` and `:bom` so a
file read with CRLF or a byte-order mark, saved from another frame or a restarted loop, is
written back as it was read)."
  {:file (buffer-file buffer)
   :type (editor/layers/buffer-type-for buffer)
   :dir (:dir buffer)
   :eol (:eol buffer)
   :bom (:bom buffer)
   :coding (:coding buffer)
   ;; so-long's state (`solong`): the other frame's copy is empty until the seed push, too
   ;; late to find the long line in, so it is carried over
   :so-long (:so-long buffer)
   ;; a file edited as root (sudoedit): another frame, a restarted loop and an emergency
   ;; auto-save must write it through sudo and keep its sidecar private too
   :sudo (:sudo buffer)
   :sudo-user (:sudo-user buffer)
   ;; a file on another machine (sshedit): saved through ssh from another frame too
   :ssh (:ssh buffer)
   ;; the repo a section buffer shows (a *git-status*, a log): another frame's copy and a
   ;; restarted loop's are found as that repo's, so C-x g there opens no second status
   :section-root (map/get-in buffer [:section-ctx :root])
   ;; …and is its own document per user it is edited as, apart from the plain file's
   :key (when-let (user (sidecar/buffer-sudo-user buffer)) (str (buffer-file buffer) "#sudo:" user))})

(defn hosted-key (buffer)
  "The registry identity of pool buffer `buffer` (std `registry-key`): its file when it has one,
else its name. Never the name alone — two `README.md`s from two projects are two documents,
and sharing by name spliced one's edits into the other. A file edited through sudo is a
document per user it is edited as (`/sudo::/x` and `/sudo:www@:/x` — sudoedit): its meta
names a `:key` with the user ([[hosted-meta]])."
  (registry-key (buffer-name buffer) (hosted-meta buffer)))

(defn hosted-index-by-key (m key)
  "The pool index of the buffer whose `hosted-key` is `key`, or nil."
  (let (i (seq/index-where (:buffers m) (fn (buffer) (= (hosted-key buffer) key))))
    (if (< i 0) nil i)))

(defn hosted-rekey-slot (m i old-key)
  "Tell the registry that pool slot `i`, shared under `old-key`, is now the document its
buffer names (a `C-x C-w` wrote it to another file): the entry follows it, keeping the
process, and every other frame renames its copy. `m` unchanged when the slot is not
registry-hosted or its identity did not change."
  (let (registry (:buffer-reg m)
        buffer (ed-buf-at m i))
    (if (or (nil? registry)
          (not (map/get-in m [:hosted i :registry?]))
          (= old-key (hosted-key buffer)))
      m
      (let (answer (registry-rekey registry old-key (buffer-name buffer) (hosted-meta buffer)))
        (if (= answer :taken)
          (message m
            (str "another frame has " (buffer-file buffer) " open — this copy is no longer shared"))
          m)))))

(defn hosted-share-slot (m i)
  "Host pool slot `i` — through the model's `:buffer-reg` when it has one (the registry's
process for the buffer's document — `hosted-key` — shared with every other frame), else locally
(`ed-host-slot`). A registry that does not answer falls back to a local host, so the
editor never wedges on it. The registry starts the process from the buffer's text AND its text
properties, so a log coloured before it was shared stays coloured in every frame."
  (let (registry (:buffer-reg m)
        buffer (ed-buf-at m i))
    (if (nil? registry)
      (ed-host-slot m i)
      (let (process (registry-share registry
                      (buffer-name buffer)
                      {:text (buffer-text buffer) :properties (buffer-property-map buffer)}
                      (hosted-meta buffer)))
        (if (pid? process)
          (map/update-in (ed-host-slot m i process)
            [:hosted i]
            (fn (link) (assoc link :registry? true)))
          (ed-host-slot m i))))))

(defn- hosted-coding (buffer)
  "How `buffer`'s file is written: `[eol bom coding]` — what every frame's copy must agree on."
  [(buffer-eol buffer) (buffer-bom? buffer) (:coding buffer)])

(defn hosted-sync-coding (m i before-buf after-buf)
  "Tell the registry when registry-hosted slot `i`'s file CODING changed this event — a
revert that found the byte-order mark or the CRLF line endings gone (or newly there), a save
that converted them: the entry's meta is updated in place (`registry-rekey` under the same
key), and every other frame takes the new `:eol` / `:bom` from the `[:registry-renamed …]`
that follows (`frames/ed-ev-registry-renamed`) — so a frame that never saw the revert does
not write the old mark back. `m` itself, either way."
  (let (registry (:buffer-reg m))
    (when (and registry
            (map/get-in m [:hosted i :registry?])
            (not (= (hosted-coding before-buf) (hosted-coding after-buf)))
            (= (hosted-key before-buf) (hosted-key after-buf)))
      (registry-rekey registry
        (hosted-key after-buf)
        (buffer-name after-buf)
        (hosted-meta after-buf)))
    m))

(defn hosted-propagate (before after &optional skip-i)
  "Ship each event's text changes to their slots' processes: for every hosted slot
whose text differs between `before` and `after`, `link-propagate-buffers` (std
`editor/buffer-client`) sends the splices the edits made — read from the buffer's own
splice log, not diffed from its text — as based structured `buffer-splice`s (DELTAs on
the wire) tagged with our id, counting each in the slot's `:pending` (in flight until its
echo returns). Returns `after` with those counts. The log is what puts an `a` typed at
the front of `aaa` at the FRONT: a text diff sees the same length change and guesses the
end, which put a collaborator's caret beside it on the wrong side. A change the log cannot
account for (more edits than it keeps, a revert) is compared — the minimal changed range,
with its text properties — which is right in content (std's `buffer-edits-between`); a
redaction always arrives as one, and a property change (`put-properties`) as one that
moves nothing in the other copies (brood ADR-579, ADR-581).
This is what lets every editing command stay `model -> model` with no knowledge of
hosting — the loop calls this once per event (`hosted-step`). `skip-i` exempts one
slot: the one a folded push just rewrote (that change IS the process's own truth).

An unchanged slot costs one compare of the same rope and property map
(`buffer-content-changed?` — an edit makes a fresh value; movement keeps both), and a
changed one reads no text at all."
  (fold (%map-pairs (or (:hosted after) {}))
    after
    (fn (acc kv)
      (let (i (first kv))
        (if (or (= i skip-i)
              (not (and (< i (count (:buffers before))) (< i (count (:buffers acc))))))
          acc
          ;; `:synced` is a buffer this event already brought the process up to (a save's
          ;; own edits, sent ahead of its saved mark — `file-save/ed-save-buf-at`): diff from it
          (let (link (map/get-in acc [:hosted i])
                synced (:synced link)
                before-buffer (or synced (ed-buf-at before i))
                after-buffer (ed-buf-at acc i)
                _ (hosted-sync-coding acc i before-buffer after-buffer))
            (cond
              (not (buffer-content-changed? before-buffer after-buffer))
              ;; O(1): the same rope and property map — no edit here, don't even read the text
                (if (nil? synced) acc (map/assoc-in acc [:hosted i] (dissoc link :synced)))
              else
                (map/assoc-in acc
                  [:hosted i]
                  (link-propagate-buffers (dissoc link :synced) before-buffer after-buffer)))))))))

(defn hosted-reconcile (m)
  "Host every pool slot that isn't yet — THE FLIP (`docs/actor-architecture.md`):
on a model carrying `:host-buffers?` (the live window loop sets it; tests and
headless models don't, staying pure), every buffer — files, `*Messages*`, dired,
occur — is backed by its own process the moment it appears in the pool, with no
call-site cooperation: buffer creation stays plain pool growth, and the loop tail
reconciles. A model without the flag pays one map lookup; a fully hosted one an
O(1) count compare (hosted keys are exactly the pool indices — `hosted-drop-slot`
keeps that true across kills), so the pool scan runs only on the event that
actually grew the pool."
  (if (or (nil? (:host-buffers? m)) (= (count (or (:hosted m) {})) (count (:buffers m))))
    m
    (fold (range (count (:buffers m)))
      m
      (fn (acc i)
        (if (map/get-in acc [:hosted i])
          acc
          ;; the process starts from the buffer AS IT IS NOW, this event's edits included:
          ;; `:synced` says so, so `hosted-propagate` does not send them a second time — a
          ;; slot hosted on the event that first edited it (the launch file, when the first
          ;; thing the loop sees is a key: a terminal sends no focus event first) would
          ;; otherwise have every character of that edit doubled
          (let (hosted (hosted-share-slot acc i))
            (if (map/get-in hosted [:hosted i])
              (map/assoc-in hosted [:hosted i :synced] (ed-buf-at hosted i))
              hosted)))))))

(defn hosted-drop-slot (m killed)
  "Unhost pool slot `killed` ahead of its REMOVAL from the pool (kill-buffer):
stop the process too when it is locally owned (not `:registry?` or `:collab?` — a process
somebody else owns outlives its subscribers). The `:hosted` keys above `killed` then shift down
one with the pool (the row's `:slots`), so every surviving link still points at its slot.
A registry-hosted slot is removed from the `:buffer-reg` instead (the registry stops
the process; a kill is global, every frame drops it) — unless the model is folding
another frame's removal (`:drop-local-only`, set by `frames/ed-ev-registry-removed`),
in which case only this frame's link goes.
Also stamps `:pool-shifted` — pool indices no longer name the same documents
across this event, so `hosted-step` must NOT diff before/after by index (it would
ship splice(other-document → this-one) to every surviving process above the kill).
Returns the model; safe on an unhosted slot (still stamps)."
  (let (link (map/get-in m [:hosted killed])
        registry (:buffer-reg m)
        key (if (< killed (count (:buffers m))) (hosted-key (ed-buf-at m killed)) nil)
        m1 (if (nil? link) m (ed-unhost-slot m killed (not (or (:registry? link) (:collab? link)))))
        _ (when (and link registry key (:registry? link) (not (:drop-local-only m)))
            (registry-remove registry key)))
    (assoc (dissoc m1 :drop-local-only) :pool-shifted true)))

;; after collab, which needs the slot's link to withdraw its presence, and before the caches
(register-slot-keeper :hosted {:order 30 :slots [:hosted] :drop 'hosted/hosted-drop-slot})

(defn hosted-rehost (m i)
  "Rehost pool slot `i` after its buffer process DIED: respawn from the pool cache —
which is always current (every edit lands there first), so recovery loses at most
the in-flight splices — resubscribe, and reset the link. The per-buffer fault
boundary: one crashed buffer process never takes the editor (or another buffer)
with it. Echoes the casualty by name."
  (let (name (buffer-name (ed-buf-at m i)))
    (message (hosted-share-slot (assoc m :hosted (dissoc (:hosted m) i)) i)
      (str "buffer process for " name " restarted"))))

(defn- hosted-propagate-shifted (before after)
  "The pool-RESHAPE variant of `hosted-propagate`: pair each surviving hosted slot
with its `before` document by NAME (`ed-buffer-index-by-name` — pool names are the
standard identity), because the indices shifted and a positional diff would compare
different documents. A slot with no same-named `before` buffer (freshly created
this event) is skipped — its process seeds from current text. The rest send the splices
their edits made, with the text properties they carried (`link-propagate-buffers`)."
  (fold (%map-pairs (or (:hosted after) {}))
    after
    (fn (acc kv)
      (let (i (first kv)
            after-buffer (if (< i (count (:buffers acc))) (ed-buf-at acc i) nil))
        (if (nil? after-buffer)
          acc
          (let (j (ed-buffer-index-by-name before (buffer-name after-buffer)))
            (if (nil? j)
              acc
              (let (before-buffer (ed-buf-at before j))
                (if (not (buffer-content-changed? before-buffer after-buffer))
                  acc
                  (map/assoc-in acc
                    [:hosted i]
                    (link-propagate-buffers (map/get-in acc [:hosted i]) before-buffer after-buffer)))))))))))

(defn hosted-step (before after input)
  "The loop-tail content hook: host any new pool slot (`hosted-reconcile` — the
every-buffer flip, on flagged models), then propagate this event's edits to every
hosted slot's process. Two exemptions keep the diff honest:

- a `[:buffer-updated …]` event exempts ONLY the slot the push rewrote (re-sending
  the process its own truth would apply it twice) — every OTHER slot still
  propagates, because folding a push can edit other buffers too (a presence echo
  appends to the hosted `*Messages*`, which must not silently diverge from its
  process);
- an event that RESHAPED the pool (`:pool-shifted`, stamped by `hosted-drop-slot`)
  diffs each surviving slot against its `before` slot found BY NAME, not by index:
  the indices shifted, so a positional diff would compare document i with document j
  and ship a corrupting cross-document splice — while skipping outright would lose
  same-event edits (the kill's own \"killed NAME\" echo appended to `*Messages*`).

Costs a map lookup or two on a model with nothing hosted, so ordinary editing pays
nothing."
  (let (m (hosted-reconcile after))
    (cond
      (nil? (:hosted m)) m
      (:pool-shifted m) (hosted-propagate-shifted before (dissoc m :pool-shifted))
      else
        (hosted-propagate before
          m
          (if (and (vector? input) (= (first input) :buffer-updated))
            (hosted-slot-for-proc m (nth input 1))
            nil)))))

(defn hosted-rebuilt (old text properties)
  "`old` with its text replaced by `text` and its text properties by `properties` (the
process's, `{key spans}` — a program's colours), KEEPING every non-content field: the
buffer's `:type`/`:layers` (its whole mode — keymap, fontify, indent) and every mode-local
field — `:git-status`/`:line-links` on a report buffer, `:input-start` on a shell, and
`:read-only-spans` on the tutorial, which freeze its prose (ADR-219). The rope and what
belongs to its text are the only things that change.

The history goes with the old text, and with it the SPLICE LOG: both hold texts the process
no longer has — after another frame's redaction, the secret (brood ADR-581) — and neither can
say anything about the new text: the next edit's log entry starts from it, which is all
`hosted-propagate` walks."
  (let (fresh (make-buffer text (buffer-name old) (buffer-file old))
        rebuilt (merge (dissoc old :properties :splices)
                  {:rope (get fresh :rope)
                   ;; the content changed under us, so point/mark/undo can't be trusted
                   :point (math/min (get old :point 0) (buffer-length fresh))
                   :mark nil
                   :undo ()
                   :undo-size 0
                   :undo-amalgamate false
                   :pending-undo ()}))
    (if (or (nil? properties) (empty? properties))
      rebuilt
      (assoc rebuilt :properties properties))))

(defn- hosted-resync (m i link old)
  "Resync slot `i` from its process after a genuinely ambiguous collision (the same span
touched on both sides inside one round-trip) — always correct. `buffer-sync` pairs text
(and its text properties) + version ATOMICALLY: edits applied between the ambiguous push
and our snapshot are inside the returned text, and advancing the link to the snapshot
version makes their queued pushes drop as stale instead of replaying onto the rebuilt copy
(doubling)."
  (let (snapshot (buffer-sync (:proc link) content-view))
    (if (= snapshot :no-reply)
      m ; process died mid-resync — the [:down] rehost will recover
      (let ([version view] snapshot
            [text _ _ properties] view)
        (hosted-carried (assoc m :hosted (assoc (:hosted m) i (assoc link :version version)))
          i
          old
          (ed-stamp (hosted-rebuilt old text properties))
          (text-splice (buffer-text old) text))))))

(defn- hosted-carried (m i old new splice)
  "`m` with slot `i` holding `new` — `old` after another holder's change, `splice` (`[lo hi
replacement]`) — and everything that points into its text carried through the change as an
Emacs marker is (`model/ed-carry-buffer-fields`, `model/ed-carry-panes`): the buffer's point
and mark, a shell's `:input-start`, a results buffer's `:line-links`, and every window on it
in this frame, kept ones included. Another frame's head cut of *compilation* leaves this
frame's reader on the lines they were reading, and a shell's input boundary where its prompt
is."
  (let ([lo hi replacement] splice
        inserted (string/length replacement)
        carried (ed-carry-buffer-fields new old lo hi inserted))
    (ed-carry-panes (assoc m :buffers (assoc (:buffers m) i carried))
      i
      (buffer-rope old)
      (buffer-rope carried)
      lo
      hi
      inserted)))

;; ---- our own echo, absorbed late --------------------------------------------
;; Every splice we send comes back to us as a push tagged with our own `:me`. Folding it
;; changes nothing but the link's bookkeeping (the version, one `:pending` popped), and that
;; is enough for the loop to see a new model: a second full update and a second frame for
;; every keystroke on a hosted buffer — which, under the flip, is every buffer.
;;
;; So an own SPLICE echo on a slot nobody shares is not folded at all (`hosted-own-echo?`,
;; and `input/ed-update` hands the model back untouched), and the bookkeeping is caught up
;; on the next push that IS folded (`hosted-absorb-echoes`). That is exact, because the
;; process numbers its pushes 1, 2, 3… and sends every one to every subscriber in order:
;; the versions between the link's and a folded push's are precisely the echoes we skipped,
;; and on an unshared slot every one of those was a splice of ours (no presence markers are
;; sent there — `collab-sync-point` — and a foreign edit is never skipped). The lag on the
;; link's version is harmless where it is read: a splice we send is based on it, and the
;; process transforms a based splice only over OTHER origins' splices since that base.
;; A SHARED slot keeps the eager fold — our own marker moves echo there too, and their
;; versions are not splices to pop.

(defn- hosted-skips-echoes? (link)
  "Whether `link`'s own splice echoes are absorbed late rather than folded one by one: an
unshared slot (no presence layer), seeded (its version known, so the gap to a later push is
countable), with edits in flight."
  (and (map? link)
    (not (:collab? link))
    (int? (:version link))
    (>= (:version link) 0)
    (not (empty? (or (:pending link) ())))))

(defn hosted-own-echo? (m input)
  "Whether `input` is a `[:buffer-updated proc version view origin]` push that is our OWN
splice coming back on an unshared hosted slot — one the pool already applied, so folding it
would change only the link's bookkeeping, which `hosted-absorb-echoes` catches up on the
next push that is folded. A stale push is not one (the full fold drops it as before)."
  (and (vector? input)
    (= (first input) :buffer-updated)
    (let (proc (nth input 1 nil)
          version (nth input 2 nil)
          view (nth input 3 nil)
          origin (nth input 4 nil)
          i (hosted-slot-for-proc m proc)
          link (when i (map/get-in m [:hosted i])))
      (and (hosted-skips-echoes? link)
        (not (nil? origin))
        (= origin (:me link))
        (int? version)
        (> version (or (:version link) -1))
        (map? view)
        (not (nil? (:splice view)))))))

(defn hosted-absorb-echoes (link version)
  "`link` caught up on the own splice echoes skipped before the push numbered `version`
(`hosted-own-echo?`): the versions between the link's and this one were all ours, so that
many in-flight splices have landed — popped, oldest first — and the link stands at the
version just before this push. `link` unchanged when nothing was skipped."
  (let (seen (or (:version link) -1)
        skipped (- version seen 1))
    (if (and (hosted-skips-echoes? link) (> skipped 0))
      (assoc link :version (dec version) :pending (apply list (drop (:pending link) skipped)))
      link)))

(defn hosted-apply-content (m i version view origin)
  "Fold one push's CONTENT into hosted slot `i`: `link-fold` (std protocol client)
decides — stale drop, own-echo version bump, foreign splice transformed over our
in-flight edits, ambiguous resync, or full-text rebuild — and the action is applied
to the pool cache here (std's `buffer-apply-action`, with the carrying a pool needs — the twin of
std's plain-string `text-apply-action`). The link first catches up on the own echoes the loop skipped
(`hosted-absorb-echoes`). Returns `[m' status]`, status `:stale` (push ignored — the
caller should skip its own layers too) or `:applied`. Every window on the slot, the
buffer's point and mark and its off-text positions are carried through the change
(`hosted-carried`)."
  (let ([link action] (link-fold (hosted-absorb-echoes (map/get-in m [:hosted i]) version)
                        version view origin))
    (if (= action :stale)
      [m :stale]
      (let (m1 (assoc m :hosted (assoc (:hosted m) i link))
            old (ed-buf-at m1 i))
        [(match action
           (:resync (hosted-resync m1 i link old))
           ;; a foreign DELTA that merges: already transformed over our in-flight
           ;; splices by link-fold — apply in place (O(change), the rope survives), with
           ;; the text properties it came with, whatever this copy's read-only state (the
           ;; text already changed in the process: std's `apply-splice`), and everything
           ;; pointing into the text carried through it (`hosted-carried`)
           ([:splice [lo hi replacement] properties]
             (hosted-carried m1
               i
               old
               ;; a redaction (a secret moved out of a shell's input) leaves this copy no trace
               ;; either: std's `buffer-apply-action` reads `:redact` the same way
               (buffer-apply-action old [:splice [lo hi replacement] properties])
               [lo hi replacement]))
           ;; a full-text view (closure edits / the seed): rebuild only on real
           ;; change (cheap no-op churn, and local undo state survives); the same text
           ;; with other properties (a frame seeded after the colours changed) takes the
           ;; properties alone
           ([:text text properties] (cond
                                      (not (= text (buffer-text old)))
                                        (hosted-carried m1
                                          i
                                          old
                                          (ed-stamp (hosted-rebuilt old text properties))
                                          (text-splice (buffer-text old) text))
                                      (= (or properties {}) (buffer-property-map old)) m1
                                      (empty? (or properties {}))
                                        (ed-set-buf-at m1 i (dissoc old :properties))
                                      else (ed-set-buf-at m1 i (assoc old :properties properties))))
           ;; `:noop` (our own echo / a cursor-only delta) falls through untouched
           (_ m1))
          :applied]))))

;; ---- registration: the loop names no hosted call ----------------------------------------
;; the content propagate runs first at an event's tail, before collab's presence step, and on a
;; thrown command's recovery too: the error echo's append to *Messages* must reach its process
(register-tail-step :hosted {:order 0 :run 'hosted/hosted-step :recover true})
;; our own splice echoed back on an unshared slot: the pool already has it, nothing to draw
(register-inert-input :hosted-own-echo 'hosted/hosted-own-echo?)

(defn hosted-ev-buffer-updated (m input text-rows columns rows)
  "A buffer process's push (`[:buffer-updated proc version view origin]`): its CONTENT folded
into the pool slot linked to `proc` ([[hosted-apply-content]]), every window's point carried
with the text; `m` unchanged for a process no slot links to. collab's handler replaces this
one when collab loads, folding its presence layer around the same content."
  (let (i (hosted-slot-for-proc m (nth input 1)))
    (if (nil? i) m (first (hosted-apply-content m i (nth input 2) (nth input 3) (nth input 4 nil))))))

(register-event-handler :buffer-updated 'hosted/hosted-ev-buffer-updated)

(defn hosted-down (m pid reason)
  "A monitored process died (`model/register-down-handler`): when `pid` backs a pool slot not
shared through a collab session (`:collab?`, which collab recovers), respawn it from the pool
cache (`hosted-rehost`) — a registry-hosted slot re-shares through the registry, the first
frame to notice respawning from its cache and the others landing on that process. One crashed
buffer process costs at most its in-flight splices, never the editor. `m` unchanged for any
other pid."
  (let (slot (hosted-slot-for-proc m pid))
    (if (and slot
          (or (map/get-in m [:hosted slot :registry?]) (not (map/get-in m [:hosted slot :collab?]))))
      (hosted-rehost m slot)
      m)))

(register-down-handler :hosted 'hosted/hosted-down)
