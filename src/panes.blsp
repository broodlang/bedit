(defmodule panes
  "Pane-layout geometry + mouse-event folding — the `model -> model` operations that
lay the `:layout` tree (`std/pane`) over the screen and fold `[:mouse …]` events into
it. Split out of `model` because this is *event handling* (like `input`/`commands`),
not model field access: it reads the model's `:layout`/`:dragging` and the pool (via
`model/ed-buf-at`) and returns an updated model. The body rect is everything above the
bottom echo row; both the view (`view/ed-view`) and mouse hit-testing lay the tree out
over it, so screen coordinates line up. Pure (data→data)."
  (:use scroll) ; ed-scroll / ed-max-top / ed-wrap? — keeping point on screen
  (:use model) ; ed-buf-at — the pool lookup ed-scroll-pane needs
  (:use editor/buffer) ; buffer-line-count (scroll clamp)
  (:use editor/highlight) ; shift-spans — re-base windowed fontify spans to absolute coords
  (:use editor/pane) ; pane-layout / divider-at / pane-select-at / pane-set-ratio / pane-* ops
  (:use wrap) ; rows-from / row-of — the visual-line break rule the row table is built on
  (:use syntaxtree) ; the tree-sitter parse each buffer keeps — a band coloured from it
  (:use linecache)) ; the line-state cache a lexer mode keeps — a band coloured from it
;; ---- pane layout (shared geometry: view & hit-testing agree) ----------------

(sig ed-body-layout (map int int -> layout))
(defn ed-body-layout (m cols rows)
  "The pane layout (`{:panes :dividers}`) over the body rect above the minibuffer —
everything above the bottom `ed-minibuffer-rows` rows (the prompt, plus Plume's candidate
list when one is open: the minibuffer grows downward and the body shrinks to sit above
it). Used by the view and by mouse hit-testing, so a click maps to the pane the view drew."
  (ed-header-layout (pane-layout (:layout m) [0 0 cols (- rows (ed-echo-rows m rows))])
    (:header-line m)))

(defn ed-header-layout (layout header?)
  "`layout` with each pane's top row given to its HEADER LINE when `header?` (the init
file's `:header-line`): the pane's `:rect` starts a row lower and `:header-row` names the
row it gave up, so the text, the mode line, the scroll and the mouse — everything that
reads the rect — follow without knowing. A pane too short to spare a row keeps it."
  (if (not header?)
    layout
    (assoc layout
      :panes
        (map (:panes layout)
          (fn (pane)
            (let ([x y w h] (:rect pane))
              (if (> h 2) (assoc pane :rect [x (inc y) w (dec h)] :header-row y) pane)))))))

(sig ed-selected-pane ((len (list pane) 1 _) -> pane))
(defn ed-selected-pane (panes)
  "The pane flagged `:selected` (where the cursor goes), or the first as a fallback."
  (or (first (seq/filter panes :selected)) (first panes)))

;; ---- gutter geometry (shared by the view's renderer and mouse hit-testing) --
;; The left line-number gutter's *width* and *shown?* predicate are pure geometry, so
;; they live here with the rest of the pane layout; `view` (which `(:use panes)`) draws
;; the cells (`view/ed-gutter-ops`) and the click handler below maps a cell past the
;; gutter to a buffer column. Both ask the buffer's mode for its `:gutter-width` service.

(defn ed-gutter-shown? (buf pane)
  "Whether the left gutter shows for `pane`: an explicit per-pane `:line-numbers`
(set by C-x l) wins; otherwise it defaults **on** whenever the buffer's mode offers a
`:gutter-width` service (so a text/brood buffer shows line numbers without a toggle),
unless the mode opts out with `:no-line-numbers` (special buffers like *git-status*,
which want no gutter by default the way Magit has none), or the init file's `:line-numbers`
turns numbering off for its mode (`scroll/ed-line-numbers-for`). C-x l still forces it back on."
  (let (ln (get (:payload pane) :line-numbers))
    (cond
      (not (nil? ln)) ln
      (ed-mode-service buf :no-line-numbers) false
      (= false (scroll/ed-line-numbers-for buf)) false
      :else (and (ed-mode-service buf :gutter-width) true))))

;; `shown?` comes from `ed-gutter-shown?`, whose `and` yields nil for "no": `(or bool nil)`,
;; or the runtime contract (ADR-380) refuses the ordinary case.
(sig ed-gutter-width (buffer (or bool nil) -> int))
(defn ed-gutter-width (buf shown?)
  "Columns the left gutter reserves: the mode's `:gutter-width` service (e.g. the line-
number digit count + a trailing space) when `shown?` and a service exists, else 0 (so
the body fills the pane)."
  ;; the service is late-bound (a symbol resolved at render time), so its result is
  ;; unknown here — and a mode answering anything but a width would be arithmetic on
  ;; nil in every geometry formula downstream, so it is guarded rather than trusted
  (let (gwfn (ed-mode-service buf :gutter-width)
        w (when (and shown? gwfn) (gwfn buf)))
    (if (int? w) w 0)))

(sig ed-pane-gutter-width (buffer pane -> int))
(defn ed-pane-gutter-width (buf pane)
  "The gutter width `pane` reserves for `buf` — `ed-gutter-width` of `ed-gutter-shown?`,
the pair every caller actually wants. Five sites asked the two questions in that exact
order (the pane geometry here, the body ops and the mouse map in `view`), and the shown?
half is the one easy to forget: a gutter width counted for a pane that shows no gutter
shifts every column in it."
  ;; `ed-gutter-shown?` then `ed-gutter-width` spelled out, so the `:gutter-width` service is
  ;; looked up ONCE: this runs several times a frame per pane, and a mode-service lookup
  ;; resolves every layer of the buffer's stack each time
  (let (ln (get (:payload pane) :line-numbers)
        gwfn (ed-mode-service buf :gutter-width)
        shown? (cond
                 (not (nil? ln)) ln
                 (ed-mode-service buf :no-line-numbers) false
                 (= false (scroll/ed-line-numbers-for buf)) false
                 :else (not (nil? gwfn)))
        w (when (and shown? gwfn) (gwfn buf)))
    (if (int? w) w 0)))

(defn ed-selected-text-rows (m cols rows)
  "The text height of the *selected* pane in BUFFER lines — its rect height less the
mode-line row, in the pane's own cells (a zoomed pane shows fewer lines). What
scrolling and paging use, so they're correct inside a split and when zoomed. At least 1."
  (let (panes (:panes (ed-body-layout m cols rows))
        sel (ed-selected-pane panes))
    (math/max 1 (ed-pane-vrows sel (ed-pane-buf m sel)))))

;; The payload reads below are `(get (:payload pane) k)`, not `(get-in pane [:payload k])`:
;; the same lookup without std's generic path walk, and each runs several times per pane
;; per frame.

(sig ed-pane-top (pane buffer -> int))
(defn ed-pane-top (pane buf)
  "The pane's scroll offset, clamped into `buf` — never negative, never past the last
line. A pane's `:top` can outlive the buffer it points at (a `C-x k` remap re-points a
pane to a shorter buffer keeping its scroll; a shared buffer edited shorter in another
pane), and an out-of-range `top` would index past EOF and crash the whole renderer.
Emacs likewise pins scroll at the last line, so clamping here is the right behaviour."
  (let (top (get (:payload pane) :top)
        raw (math/max 0
              (math/min (if (int? top) top 0) (dec (buffer-line-count buf))))
        restrict (get (:payload pane) :restrict))
    (if (nil? restrict)
      raw
      (let ([rtop rbot] (ed-restrict-lines buf restrict)) (math/max rtop (math/min rbot raw))))))

(sig ed-pane-hscroll (pane -> int))
(defn ed-pane-hscroll (pane)
  "The pane's horizontal scroll offset (leftmost visible char column), 0 if unset."
  ;; the payload is `any` (editor/pane), so what comes out is whatever was put in: the
  ;; guard is what makes the declared `int` a fact rather than a claim, here and below
  (let (h (get (:payload pane) :hscroll))
    (if (int? h) (math/max 0 h) 0)))

(defn ed-pane-scroll-frac (pane)
  "The pane's sub-line smooth-scroll fractional offset ∈ [0, 1): 0 = snapped to a line
boundary, > 0 = content is shifted up by `frac × cell_h` pixels (from trackpad scroll)."
  ;; `number?` BEFORE the range test, not after: `>=` raises on a non-number, so a payload
  ;; carrying anything else here crashed the renderer rather than falling back — the same
  ;; `any` payload the reads above guard, and this one was reading it unguarded
  (let (f (get (:payload pane) :scroll-frac))
    (if (and (number? f) (>= f 0.0) (< f 1.0)) f 0.0)))

;; ---- screen row → buffer line: ONE owner ----------------------------------------
;; Every hit-test (a click, a drag, a hover, a gutter press) must agree with what the
;; view painted on that row. The view paints line `top + k` on the pane's row `k`
;; (scaled by the pane's font scale), shifted up by the smooth-scroll fraction — so
;; once that fraction passes half a cell, row `k` shows MOST of line `top + k + 1`. The
;; mapping used to be spelled inline at five sites, each `top + (row - py) / s` and
;; each unaware of the fraction; a glide that came to rest between lines put every
;; click one line above what it clicked on. These two functions are the only place the
;; arithmetic lives now; a consumer that needs the line under a row asks here.

(defn ed-pane-view-top (pane buf)
  "The buffer line the pane's FIRST text row mostly shows: `ed-pane-top`, plus one
while the smooth-scroll fraction is half a cell or more (the row is then more the next
line than this one). Clamped like `ed-pane-top`."
  (let (top (ed-pane-top pane buf))
    (if (>= (ed-pane-scroll-frac pane) 0.5)
      (math/min (inc top) (math/max top (dec (buffer-line-count buf))))
      top)))

(defn ed-payload-view-top (payload buf)
  "`ed-pane-view-top` for a bare pane PAYLOAD (`{:top :scroll-frac …}`, what
`model/ed-current-pane` answers) — for a command that has the selected pane's state but
not its laid-out rect (M-r)."
  (ed-pane-view-top {:payload payload} buf))

;; ---- long lines (wrapped, truncated): the pane's row table ------------------------
;; With a buffer's long lines wrapped (`visual-line-mode`) a line takes as many rows as it
;; needs (`wrap/segments`), so "row k shows line top + k" stops being true; truncated, a
;; row shows only part of its line and an ellipsis (`wrap/one-row`). The pane's ROW
;; TABLE — `[line from to]` per text row, from `wrap/rows-from` — is what every row↔line
;; question reads then; a row's `from` is its horizontal scroll (the chars before it are
;; on the rows above, or scrolled off the left of the line at point), so the column
;; geometry (`ed-buf-offset-at`, the caret) is unchanged.

;; ---- the pane's cell: every dimension below is in the ZOOMED pane's cells ----------
;; A zoomed pane (`appearance/zoom-of`, on its payload) is painted inside a `cell-region`
;; (brood ADR-363) at its own font size, so it holds fewer, bigger cells than its rect says.
;; `ed-zoom-ratio` is the size of one of its cells over the window's, `[rw rh]`; a rect in
;; window cells divided by it is the rect in the pane's cells. Unzoomed the ratio is `[1 1]`
;; and every formula here reads as it always did.

(sig ed-zoom-ratio (pane -> vector))
(defn ed-zoom-ratio (pane)
  "`[rw rh]` — `pane`'s cell over the window's (`[1 1]` unzoomed): what every piece of pane
geometry divides by — the columns and rows that fit, the cell a click landed in, the rect a
region is laid out into. `appearance/zoom-payload` writes it (measured by the window); this
is the one read, here rather than there because `appearance` is deferred and the geometry
must not load the preset registry to answer for a pane with no zoom."
  ;; `appearance/zoom-payload` is the one writer and stores a measured `[rw rh]`; the guard
  ;; is what proves it here, since the payload it rides on is `any` (editor/pane). It
  ;; checks the whole shape, not just `vector?`: every reader DIVIDES by these two, so a
  ;; short vector divides by nil and a zero divides by zero — a crash per frame, not a
  ;; wrong number.
  ;; the test is inline, not a `let`-bound boolean: the checker narrows on the guard
  ;; itself, so through a bound name the declared `vector` goes back to being trusted
  (let (ratio (get (get (:payload pane) :zoom) :ratio))
    (if (and (vector? ratio)
          (= 2 (count ratio))
          (number? (first ratio))
          (number? (second ratio))
          (> (first ratio) 0)
          (> (second ratio) 0))
      ratio
      [1 1])))

(sig ed-pane-cols (pane buffer -> int))
(defn ed-pane-cols (pane buf)
  "The columns `pane`'s BODY holds in its own cells: its rect width less the scrollbar
column, divided by the cell ratio — the width of the region the body is painted into (the
gutter is inside it). At least 1."
  (let ([x y w h] (or (:rect pane) [0 0 80 24])
        [rw rh] (ed-zoom-ratio pane))
    (math/max 1 (math/floor (/ (dec w) rw)))))

(defn ed-right-margin-width (buf)
  "The cells `buf`'s right margin takes from its text area — its `:right-margin`'s `:width`
and the gap before it — or 0 for a buffer without one (Emacs's `right-margin-width`; a
log's author and age live there)."
  (let (margin (:right-margin buf)
        width (:width margin))
    (if (int? width) (+ 2 width) 0)))
(sig ed-right-margin-width (buffer -> int))

(defn ed-pane-text-cols (pane buf)
  "The text width of `pane` in its own cells: the body's columns (`ed-pane-cols`) less the
gutter and any right margin — the width the view lays lines into and a wrapped line breaks
at (`ed-selected-text-cols` is this for the selected pane). At least 1."
  (math/max 1
    (- (ed-pane-cols pane buf) (ed-pane-gutter-width buf pane) (ed-right-margin-width buf))))

(sig ed-pane-rows (pane buffer -> (or nil vector)))
(defn ed-pane-rows (pane buf)
  "The pane's row table — `[line from to inlay]` for each row from the pane's top, one more
than the pane shows so a smooth-scroll step has its extra row — or nil when the rows are
simply `top + k` (the arithmetic in `ed-pane-line-at`).

A table is built for a buffer whose long lines do not simply scroll (wrapped, truncated —
`scroll/ed-long-lines`), and for one carrying INLAY rows
(`results/inlay-lines` — derived text on a row of its own). Both are the same fact: the
pane's rows are no longer one per line, in order, from the top (or, truncated, a row no
longer shows its whole line). Nil is kept for the common
case rather than always building one, because most buffers need neither.

The table itself is memoised on its inputs in `wrap/rows-from` — at the leaf, so the three
hit-test sites here and `input/ed-point-into-view` (which asks `rows-from` directly) all get
the same answer without rebuilding it."
  (let (inlays (ed-row-extras buf))
    (if (ed-row-wise? buf inlays)
      ;; point's line, if it is cut short and point lies past the cut, shown from where point
      ;; is visible — after the memo, which is keyed without point. A pane started part-way
      ;; down its top line (`ed-pane-top-row`) drops that line's rows above its start
      (let (w (ed-pane-text-cols pane buf)
            skip (ed-pane-top-row pane buf w inlays)
            table (wrap/rows-from buf
                    (ed-pane-top pane buf)
                    w
                    (+ (inc (ed-pane-vrows pane buf)) skip)
                    inlays))
        (wrap/follow-point (if (= skip 0) table (into [] (drop table skip))) buf w))
      nil)))

(sig ed-pane-top-continued? (pane buffer -> bool))
(defn ed-pane-top-continued? (pane buf)
  "Whether `pane` starts part-way through its top line's TEXT — past the line's first text
row, so its first row is a continuation, which shows no line number (as in Emacs). A pane
that starts on one of the line's inlay rows has not reached the text yet."
  (let (top (ed-pane-top pane buf))
    (if (= (payload-top-row (:payload pane) top) 0)
      false
      (let (extras (ed-row-extras buf))
        (> (ed-pane-top-row pane buf (ed-pane-text-cols pane buf) extras)
          (count (get extras top [])))))))

(sig ed-pane-top-row (pane buffer int map -> int))
(defn ed-pane-top-row (pane buf w extras)
  "The row of its top line `pane` starts on (`model/payload-top-row`), clamped to the rows
that line has at text width `w` now — an edit or a narrower pane may have left it fewer.
0 for a pane that starts on a whole line, as every unwrapped one does."
  (let (row (payload-top-row (:payload pane) (ed-pane-top pane buf)))
    (if (= row 0)
      0
      (math/max 0 (math/min row (dec (wrap/line-rows buf (ed-pane-top pane buf) w extras)))))))

(sig ed-pane-row-index (pane buffer number -> int))
(defn- ed-pane-row-index (pane buf row)
  "Screen row `row` as an index into the pane's text rows (0 = the first) in its own cells:
the offset into the pane divided by the cell ratio, so a zoomed pane's taller rows count as
one each. `row` may be FRACTIONAL (`ed-mouse-at`): a zoomed pane's row boundaries fall
inside window cells, so only the exact position says which of its rows a click is on."
  (let ([px py pw ph] (:rect pane)
        [rw rh] (ed-zoom-ratio pane))
    (math/floor (/ (math/max 0 (- row py)) rh))))

(sig ed-pane-line-at (pane buffer number -> (or nil int)))
(defn ed-pane-line-at (pane buf row)
  "The buffer line screen row `row` (absolute) of `pane` shows — `ed-pane-view-top` plus
the row's offset into the pane's text area divided by the font scale, or the row table's
entry when the buffer wraps — or nil for a row below the buffer's last line (a hover
there is over nothing; a CLICK there wants the last line, which is
`ed-pane-line-at-clamped`). The one row→line mapping; the inverse of the view's pane
geometry."
  (let (k (ed-pane-row-index pane buf row)
        rows (ed-pane-rows pane buf))
    (if (nil? rows)
      (let (line (+ (ed-pane-view-top pane buf) k))
        (if (< line (buffer-line-count buf)) line nil))
      ;; a row table entry is untyped data (`wrap/rows-from`): the guard is the proof
      ;; that what comes back is the line this declares
      (let (line (when (< k (count rows)) (first (nth rows k))))
        (if (int? line) line nil)))))

(sig ed-pane-row-hscroll (pane buffer number -> int))
(defn ed-pane-row-hscroll (pane buf row)
  "The chars of its line that sit LEFT of screen row `row`'s first cell: the pane's
horizontal scroll for an unwrapped buffer, the row's segment start for a wrapped one —
what `ed-buf-offset-at` takes as `hscroll`, so a click on a continuation row maps into
that row's slice of the line."
  (let (rows (ed-pane-rows pane buf))
    (if (nil? rows)
      (ed-pane-hscroll pane)
      (let (k (ed-pane-row-index pane buf row)
            from (when (< k (count rows)) (second (nth rows k))))
        (if (int? from) from 0)))))

(sig ed-pane-row-clip (pane buffer number -> (or nil vector)))
(defn ed-pane-row-clip (pane buf row)
  "The CLIP of screen row `row` — `[cut ellipsis]` when the line it shows is cut short
(`wrap/one-row`: truncated, or clipped at the pane's edge), nil when the row shows all of
its chars. What a click asks to tell the ellipsis from the text before it."
  (let (rows (ed-pane-rows pane buf)
        k (ed-pane-row-index pane buf row)
        entry (when (and rows (< k (count rows))) (nth rows k))
        clip (when (vector? entry) (nth entry 4 nil)))
    (if (vector? clip) clip nil)))

(sig ed-clip-click (buffer int (or nil vector) int -> int))
(defn ed-clip-click (buf line clip off)
  "Where a click that `ed-buf-offset-at` put at `off` on `line` lands, given its row's
`clip`: at the line's END when it fell on the ellipsis or past the cut (the chars there are
not on screen, so no column of them was clicked) — which then shows that line from where
point is (`wrap/follow-point`), so a click on `…` reveals the rest. `off` otherwise."
  (if (nil? clip)
    off
    (let (rope (buffer-rope buf)
          bol (text/line->char rope line)
          eol (+ bol (string/length (wrap/line-text buf line))))
      (if (>= off (+ bol (first clip))) eol off))))

(sig ed-rows-line-rows ((or nil vector) int int int -> (list (tuple int int (or nil int)))))
(defn ed-rows-line-rows (rows top line hscroll)
  "The pane text rows buffer `line` occupies, each `[k from to]` (row index from 0, the
line's chars on it — `to` nil for an unwrapped pane, where the row runs to the pane's
edge): `'([(- line top) hscroll nil])` when `rows` is nil (unwrapped: one row per line,
the caller range-checks `k`), else the table's rows for the line in order — `'()` when
none is on screen. The line half of the geometry for anything painted AT a line: the
hl-line band, a region's end-of-line fill, a ghost note, a link zone."
  (if (nil? rows)
    (list [(- line top) hscroll nil])
    (reverse
      (fold (range (count rows))
        '()
        (fn (acc k)
          (let (r (nth rows k))
            ;; INLAY rows are skipped: this answers "which rows does this line's
            ;; TEXT occupy?", and an inlay is not the line's text. A caller that
            ;; included them would fill a region through a signature, or place the
            ;; cursor on a row with no columns to be at.
            (if (and (= (first r) line) (nil? (nth r 3 nil)))
              (cons [k (second r) (nth r 2)] acc)
              acc)))))))

(sig ed-rows-offset-row ((or nil vector) int int int int int -> (or nil (tuple int int))))
(defn ed-rows-offset-row (rows top line col hscroll vrows)
  "`[k from]` — the pane text row (0-based) char column `col` of buffer `line` sits on
and that row's first char column — when it is among the `vrows` rows shown, else nil.
Unwrapped (`rows` nil) `k` is `line - top` and `from` the pane's `hscroll`; wrapped, the
line's rows decide (`wrap/row-of` picks the segment holding the column, the last one for
a column at the line's end). The cursor, a remote caret and the hl-line band ask here,
so they land on the row the text was painted on."
  (let (mine (ed-rows-line-rows rows top line hscroll))
    (if (empty? mine)
      nil
      (let ([k from _] (if (nil? rows)
                         (first mine)
                         (nth mine (wrap/row-of (map mine (fn ([k f t]) [f t])) col))))
        (if (and (>= k 0) (< k vrows)) [k from] nil)))))

(defn ed-point-screen-cell (m cols rows)
  "`[row column]` — the window cell point is shown at in the selected pane (its header row,
gutter, wrapping and sideways scroll counted), or nil when point is off screen. For what
floats beside point outside the view (the completion popup), where the view's own
`ed-point-cell` is not reachable."
  (let (pane (ed-selected-pane (:panes (ed-body-layout m cols rows)))
        buf (ed-current-buf m)
        [x y _ _] (:rect pane)
        at (ed-pane-point-row pane buf (ed-pane-vrows pane buf)))
    (when at
      (let ([k from] at
            line-text (wrap/rope-line-text (buffer-rope buf) (buffer-current-line buf))
            n (string/length line-text)
            ;; cells from the row's first char to point, measured from the line's start so a
            ;; tab spans to the LINE's stop
            cells-to (fn (i) (string/display-width (string/substring line-text 0 (math/min i n))))
            offset (math/max 0 (- (cells-to (buffer-column buf)) (cells-to from))))
        [(+ y k) (+ x (ed-pane-gutter-width buf pane) offset)]))))

(defn ed-pane-point-row (pane buf vrows)
  "`ed-rows-offset-row` for `buf`'s point in `pane`: the row the cursor is on."
  (ed-rows-offset-row (ed-pane-rows pane buf)
    (ed-pane-top pane buf)
    (buffer-current-line buf)
    (buffer-column buf)
    (ed-pane-hscroll pane)
    vrows))

(defn ed-pane-line-at-clamped (pane buf row)
  "`ed-pane-line-at`, with a row below the text answering the LAST line — where a click
below the end of a short buffer lands, as in Emacs."
  (or (ed-pane-line-at pane buf row) (math/max 0 (dec (buffer-line-count buf)))))

(defn ed-selected-text-cols (m cols rows)
  "The text width (in columns) of the *selected* pane — `ed-pane-text-cols` for it. What
horizontal scrolling keeps point within (matches the width `view/ed-pane-ops` paints the
lines into). At least 1."
  (let (panes (:panes (ed-body-layout m cols rows))
        sel (ed-selected-pane panes))
    (ed-pane-text-cols sel (ed-pane-buf m sel))))

(sig ed-pane-vrows (pane buffer -> int))
(defn ed-pane-vrows (pane buf)
  "The number of BUFFER lines `pane`'s text area shows in its own cells: its rect height
less the mode-line row, divided by the cell ratio (a zoomed pane shows fewer lines). The
single source of the viewport height the fontify window and its cache key are built on
— `view/ed-pane-ops` reads it too, so the cached band always matches what's painted."
  (let ([x y w h] (or (:rect pane) [0 0 80 24])
        [rw rh] (ed-zoom-ratio pane))
    (math/max 0 (math/floor (/ (math/max 0 (dec h)) rh)))))

;; ---- windowed fontification + a cross-frame span cache ----------------------
;; The view paints syntax colour from the `[start end face]` spans a buffer mode's
;; `:fontify` service produces. Lexing the whole buffer every frame makes a large file
;; crawl, so we lex only the visible window (plus a short lead-in for lexer context).
;; But on its own that still re-lexes on *every* event — even pure cursor motion, a
;; selection drag, a mouse move — because the pure `view` can't remember last frame's
;; result. So the spans are cached on the model (`:span-cache`, one band per pool
;; buffer) and recomputed only when the rope changed (an edit) or the viewport scrolled
;; outside the cached band. Each band is lexed a `ed-fontify-margin` taller than the
;; viewport, so scrolling within it reuses the cache with zero lexing. The rope handle
;; is the change token — an immutable value, fresh on every edit, with O(1) identity
;; equality — so no separate revision counter is needed.

(def ed-fontify-backscan 200) ; max lines of lead-in above a window for a safe restart
(def ed-fontify-margin 32) ; most lines lexed above & below a viewport, reused on scroll
(defn ed-pane-margin (vrows)
  "The fontify margin for a pane `vrows` tall: `ed-fontify-margin`, but never more than the
pane itself shows.

The margin exists so a small scroll reuses the band, and \"small\" is relative to the pane.
A flat 32 each side is two thirds of a full-height pane and FOUR TIMES a third-height one —
so splitting into three lexed 237 lines to show 45, and every pane paid its own copy of that.
Scaling it means a split costs about what one pane costs, which is what a reader expects
from dividing the same screen up."
  (math/max 4 (math/min ed-fontify-margin vrows)))

;; ---- long lines: lex what is SHOWN, not what is there -----------------------
;; The window above is bounded in LINES, which is the right bound only while a line is
;; roughly a screenful wide. A minified file, a JSON blob, a long log line — 12,000
;; characters a line — makes a 49-row window 700 KB of text to lex, in order to paint the
;; ~10 KB the pane can actually show. Measured on such a file: a keystroke cost **360 ms**,
;; a page-down 535 ms. The same file opened as plain text (no `:fontify` at all) costs 5 ms,
;; which is the whole proof of where the time goes.
;;
;; So past `*fontify-line-cap*` the band is lexed PER LINE, each line clipped to the cap.
;; Colour stays correct for every column a pane can display (no pane is 1,000 columns wide)
;; and is simply absent past it. What is lost is cross-line lexer state — a string opened on
;; one enormous line and closed on the next is mis-coloured — which is the trade every editor
;; makes here, and it is confined to files whose lines are already beyond reading.

(defdyn *fontify-line-cap* 1000)
;; How long ONE line has to be before its pane leaves the whole-window path. Deliberately
;; well past any pane width: on the per-line path a mode loses its cross-line state, so an
;; ordinary file with a 300-character line must not be pushed onto it — only one whose lines
;; are past reading. Set it huge to keep whole-window lexing always.

(def ed-fontify-edge-slack 64)
;; Characters lexed past the right edge on the per-line path, so a token straddling the edge
;; is still coloured by the rule that actually applies to it.

(defn ed-fontify-clip (pane)
  "How many characters of one line the per-line path lexes for `pane`: everything it could
possibly show — its horizontal scroll plus its width — plus `ed-fontify-edge-slack`. A pane
213 columns wide has no use for the thousandth character of a line, and lexing to the
`*fontify-line-cap*` regardless was most of what the long-line path still cost."
  (let ([px py pw ph] (or (:rect pane) [0 0 80 24]))
    (+ (ed-pane-hscroll pane) (math/max 80 pw) ed-fontify-edge-slack)))

(sig ed-line-length (any int int int -> int))
(defn- ed-line-length (rope nlines total line)
  "Characters in `line` including its newline — two rope lookups, no text materialised."
  (if (>= (inc line) nlines)
    (- total (text/line->char rope line))
    (- (text/line->char rope (inc line)) (text/line->char rope line))))

;; Asked up to three times an event for the same window (the band's lines, its cover check,
;; the windowed lex), and each answer is two rope lookups per visible line: remembered per
;; `[rope lo hi cap]`, where an unchanged rope is the same handle and `=` is immediate.
(memo/defmemo ed-long-lines-in?
  8
  (rope lo hi cap)
  "Whether any line in `[lo, hi)` of `rope` is longer than `cap` characters — the memoised
half of [[ed-long-lines?]], public only because `defmemo` defines a public function."
  (let (line-count (text/line-count rope)
        total (text/length rope)
        from (math/max 0 lo)
        to (math/min line-count hi)
        window-chars (if (>= from to)
                       0
                       (- (if (>= to line-count) total (text/line->char rope to))
                         (text/line->char rope from))))
    ;; a window holding no more than `cap` characters cannot hold a line longer than it
    (and (> window-chars cap)
      (any? (range from to) (fn (line) (> (ed-line-length rope line-count total line) cap))))))

(defn- ed-long-lines? (buf lo hi)
  "Whether any line in `[lo, hi)` is longer than `*fontify-line-cap*`."
  (ed-long-lines-in? (buffer-rope buf) lo hi *fontify-line-cap*))

(defn- ed-clipped-line-ranges (buf lo hi clip)
  "The char range `[start end]` of each line in `[lo, hi)`, clipped to its first `clip`
characters — what the long-line path colours, one line at a time."
  (let (rope (buffer-rope buf)
        line-count (buffer-line-count buf)
        total (buffer-length buf))
    (map (range (math/max 0 lo) (math/min line-count hi))
      (fn (line)
        (let (line-start (text/line->char rope line))
          [line-start (+ line-start (math/min (ed-line-length rope line-count total line) clip))])))))

(sig ed-clipped-line-spans (buffer any int int int -> seqable))
(defn- ed-clipped-line-spans (buf fontify lo hi clip)
  "Spans for lines `[lo, hi)` lexed ONE LINE AT A TIME, each clipped to `clip` characters,
in absolute coordinates. The long-line path."
  (let (rope (buffer-rope buf))
    (mapcat (ed-clipped-line-ranges buf lo hi clip)
      (fn ([start end]) (shift-spans (fontify (text/slice rope start end)) start)))))
(sig ed-window-src (buffer any int int -> any))
(defn- ed-window-src (buf restart lo hi)
  "The `[src base]` the mode's `fontify` runs over for lines `lo`..`hi-1`: a text/slice of
that window plus a lead-in, trimmed forward to a restart point (`restart`, the mode's optional
`:fontify-restart`, or nil) so head-position context stays correct. `base` is `src`'s absolute
char offset. Factored out so the span cache can compare this fontify INPUT cheaply (a
text/slice) to decide whether a re-fontify is even needed — far cheaper than re-running
`fontify` — without duplicating the window arithmetic.

The lead-in is `ed-fontify-backscan` lines: a restart mode searches that range for a column-0
form and TRIMS the front (so its fontified src stays small), while a no-restart mode lexes all
of it as raw CONTEXT. A mode with cross-line state must therefore either name a restart that
knows that state (markdown's and org's find the open fence / `#+BEGIN_` above the band, else
cut at the band's first line) or pay for the whole lead-in on every edit — which, for
markdown, was the jitter typing into a long document had."
  (let (rope (buffer-rope buf)
        nlines (buffer-line-count buf)
        last-line (math/min (dec nlines) (dec hi))
        win-line (math/max 0 (- lo ed-fontify-backscan))
        win-start (text/line->char rope win-line)
        end-line (inc last-line)
        win-end (if (>= end-line nlines) (buffer-length buf) (text/line->char rope end-line))
        chunk (text/slice rope win-start win-end)
        rel (if (nil? restart) 0 (restart chunk (- (text/line->char rope lo) win-start)))
        base (+ win-start rel)
        src (if (= rel 0) chunk (string/substring chunk rel (string/length chunk))))
    [src base]))

(defn ed-window-spans (buf fontify restart lo hi &optional (clip 1000))
  "Absolute `[start end face]` syntax spans covering buffer lines `lo`..`hi-1` of `buf` —
`fontify` run over the windowed `ed-window-src` (not the whole buffer), the spans shifted
into absolute coordinates (`highlight/shift-spans`) so the per-line renderer needs no change.
A window holding a line past `*fontify-line-cap*` takes the per-line path instead."
  (if (ed-long-lines? buf lo hi)
    (ed-clipped-line-spans buf fontify lo hi clip)
    (let ([src base] (ed-window-src buf restart lo hi))
      (shift-spans (fontify src) base))))

(defn- ed-band-contains? (entry buf top vrows)
  "Whether cached band `entry`'s `[blo bhi)` lines contain the viewport `[top, top+vrows)`,
clamped to EOF (the last screen rows can sit past the last line) — and it was coloured for
the buffer's CURRENT type. A buffer retyped with its text unchanged (a grammar arriving for
a stand-in, `M-x ed-set-mode`) has the same rope, and every reuse check passes through
here: without the type the old mode's colours stayed until an edit or a scroll."
  (and entry
    (= (:type entry) (:type buf))
    (<= (:blo entry) top)
    (>= (:bhi entry) (math/min (buffer-line-count buf) (+ top vrows)))))

(defn- ed-band-hits? (entry buf top vrows)
  "The O(1) half of `ed-band-covers?`: `entry` was lexed from this very rope and its band
contains the viewport."
  (and (ed-band-contains? entry buf top vrows) (= (:rope entry) (buffer-rope buf))))

(defn- ed-band-lines (buf top vrows)
  "`[long? low high]`: the lines a fresh band for viewport `[top, top+vrows)` covers — the
viewport widened by `ed-pane-margin` each side so a later small scroll reuses it, or just
the viewport on the long-line path (`long?`), where lexing lines nobody looks at is what
costs."
  (let (long? (ed-long-lines? buf top (+ top vrows))
        margin (if long? 0 (ed-pane-margin vrows)))
    [long? (math/max 0 (- top margin)) (math/min (buffer-line-count buf) (+ top vrows margin))]))

(defn- ed-band-window (entry buf top vrows restart)
  "The fontify input `[src base]` (`ed-window-src`) a re-lex of slice band `entry`'s own
lines would take NOW — when `entry` still contains the viewport and is a slice band that kept
its input (not a tree band, not a long-line one) lying within the buffer (a shrink would make
its line range slice past EOF). Nil when it cannot be revalidated at all.

The one slice an edit costs a band: `ed-band-covers?` compares it with the input the band was
lexed from, and when they differ `ed-slice-band` lexes it as the band's replacement rather
than slicing the same lines a second time."
  (when (and (ed-band-contains? entry buf top vrows)
          (not (:tree? entry))
          (string? (:src entry))
          (<= (:bhi entry) (buffer-line-count buf)))
    (ed-window-src buf restart (:blo entry) (:bhi entry))))

(defn- ed-band-covers? (entry buf top vrows restart)
  "True if cached span `entry` still serves a pane showing `buf` at scroll `top` over
`vrows` rows: its `[blo bhi)` line band contains the viewport (clamped to EOF, since the
last screen rows can sit past the last line) AND its spans are still valid — either the rope
is identical (the O(1) fast path: point moved, nothing changed) OR the rope changed only
OUTSIDE this band, so the exact fontify input (`ed-band-window`) is byte-for-byte the same.
The latter is what a streaming *append* hits — a results buffer grows below a stationary
viewport, so re-slicing + comparing the band (cheap) beats re-fontifying it (dear) on every
one of hundreds of appended lines. A band coloured from a tree kept no fontify input to
compare: its tree's change ranges say whether it survives (`ed-tree-band-survives?`)."
  (and (ed-band-contains? entry buf top vrows)
    (or (= (:rope entry) (buffer-rope buf))
      (= (ed-band-window entry buf top vrows restart) [(:src entry) (:base entry)]))))

(defn- ed-slice-entry (buf fontify band-low band-high window)
  "A `:span-cache` entry for lines `[band-low, band-high)` of `buf` lexed from `window`, the
`[src base]` `ed-window-src` sliced for them — tagged with the rope and that exact input, so
`ed-band-covers?` can revalidate it cheaply after an off-band edit."
  (let ([src base] window)
    {:rope (buffer-rope buf)
     :type (:type buf)
     :blo band-low
     :bhi band-high
     :src src
     :base base
     :spans (shift-spans (fontify src) base)}))

(sig ed-band-for (buffer any any int int int -> map))
(defn- ed-band-for (buf fontify restart top vrows clip)
  "A fresh `:span-cache` entry for `buf`'s viewport `[top, top+vrows)`: spans lexed over
that window widened by `ed-pane-margin` lines each side (so a later small scroll reuses
it), tagged with the rope, the `[blo bhi)` lines they cover, and the exact fontify input
(`:src`/`:base`) so `ed-band-covers?` can revalidate cheaply after an off-band edit."
  (let ([long? band-low band-high] (ed-band-lines buf top vrows))
    (if long?
      ;; The long-line path keeps no `:src`, so `ed-band-covers?`'s off-band-edit shortcut
      ;; does not apply and any rope change re-lexes. That is the right trade here: the
      ;; re-lex is bounded by what the pane can SHOW rather than by the line, and comparing
      ;; a several-hundred-kilobyte fontify input would cost more than redoing the work.
      ;; The margin is dropped too (`ed-band-lines`).
      {:rope (buffer-rope buf)
       :type (:type buf)
       :blo band-low
       :bhi band-high
       :src nil
       :base 0
       :spans (ed-clipped-line-spans buf fontify band-low band-high clip)}
      (ed-slice-entry buf
        fontify
        band-low
        band-high
        (ed-window-src buf restart band-low band-high)))))

;; ---- bands coloured from a held tree (brood ADR-443) ---------------------------
;; A tree-sitter buffer with a current tree (`syntaxtree`) is coloured by asking the tree
;; for a char range: nothing is sliced and nothing is parsed — the edit already reparsed
;; the document incrementally, and the band only walks the nodes that reach it. The tree is
;; the WHOLE document's, so no lead-in or restart point is needed: a string opened far
;; above the band colours as a string. Without a tree (an old runtime, a large buffer
;; `treewarm` has not opened yet, an evicted handle) the slice path above serves as before.

(defn- ed-line-start-char (buf line)
  "The char offset where `line` begins — or the buffer's end for a line past the last."
  (if (>= line (buffer-line-count buf))
    (buffer-length buf)
    (text/line->char (buffer-rope buf) line)))

(defn- ed-tree-range-spans (buf tree faces lo hi clip)
  "Absolute spans for lines `[lo, hi)` from `tree`, or nil when the handle is gone. A window
with a line past `*fontify-line-cap*` asks per line, each clipped to `clip` characters — the
long-line path's bound on what is coloured, kept because what costs there is the span count
of text no pane shows, not the parse."
  (let (injections (buffer-injections buf))
    (if (ed-long-lines? buf lo hi)
      (let (per-line (map (ed-clipped-line-ranges buf lo hi clip)
                       (fn ([start end]) (tree-spans tree faces start end injections))))
        (when (not (any? per-line nil?)) (into [] (apply append per-line))))
      (tree-spans tree
        faces
        (ed-line-start-char buf lo)
        (ed-line-start-char buf hi)
        injections))))

(defn- ed-tree-band-for (tree-entry faces buf top vrows clip)
  "A `:span-cache` entry for `buf`'s viewport coloured from `tree-entry`'s tree: the viewport
widened by `ed-pane-margin` each side (or, on the long-line path, just the viewport), marked
`:tree? true` so `ed-tree-band-survives?` may keep it across an edit the tree says left it
alone. Nil when the handle is gone — the caller falls back to the slice band."
  (let ([_ band-low band-high] (ed-band-lines buf top vrows)
        spans (ed-tree-range-spans buf (:tree tree-entry) faces band-low band-high clip))
    (when spans
      {:rope (buffer-rope buf)
       :type (:type buf)
       :blo band-low
       :bhi band-high
       :src nil
       :base 0
       :tree? true
       :spans spans})))

(defn- ed-tree-band-survives? (entry tree-entry buf top vrows)
  "True when tree band `entry`, coloured from the text `tree-entry` was just updated FROM,
still serves the viewport: it covers `[top, top+vrows)`, and every range the update may have
recoloured (`editor/treesit/tree-changes`) starts at or after the band's end — so the text
before the band's end, and with it every span offset in the band, is unchanged. An edit
inside or above the band, or a fresh parse (`true`), re-colours it; that costs a range walk
of the tree, not a parse."
  (let (changes (:changes tree-entry))
    (and entry
      (:tree? entry)
      (= (:rope entry) (:from-rope tree-entry))
      (vector? changes)
      (ed-band-contains? entry buf top vrows)
      (< (:bhi entry) (buffer-line-count buf))
      (let (band-end (ed-line-start-char buf (:bhi entry)))
        (every? changes (fn (range-pair) (>= (first range-pair) band-end)))))))

;; A large buffer's tree is reparsed off the loop (`syntaxtree/*tree-sync-max*`), so for a
;; key or two after an edit it is BEHIND the text and cannot colour it. The band it last
;; coloured is carried across the edits instead: the splice log says what each edit
;; replaced, and a span moves with the text it covers — so typing never drops colour to a
;; slice lex, and the tree recolours the band once it lands.

(sig ed-shift-offset (int int int int -> int))
(defn- ed-shift-offset (offset lo hi added)
  ;; `offset` across a splice that replaced `[lo, hi)` with `added` chars: unmoved before it,
  ;; shifted by the length change after it, and to the end of the new text inside it. An
  ;; offset AT an insertion stays before it — right for a span's end, which then does not
  ;; swallow what is typed after it; a span's start uses [[ed-shift-start]]
  (cond
    (<= offset lo) offset
    (>= offset hi) (+ offset (- added (- hi lo)))
    else (+ lo added)))

(sig ed-shift-start (int int int int -> int))
(defn- ed-shift-start (offset lo hi added)
  ;; a span's start: as `ed-shift-offset`, except that text inserted AT it goes before it —
  ;; a line typed above a `def` leaves the keyword a keyword rather than growing it upward
  (if (and (= offset lo) (= lo hi)) (+ offset added) (ed-shift-offset offset lo hi added)))

(defn ed-shift-spans (spans splices)
  "`[start end face]` `spans` carried across `splices` (`[lo hi replacement]`, oldest first,
each against the text the one before it left, as `buffer-splices-since` gives them): a span
after an edit moves by its length change, one an insertion lands inside grows over it (text
inserted at its start or end stays outside it), one
a deletion swallows is dropped.

    (panes/ed-shift-spans [[0 3 :keyword] [4 7 :name]] [[1 1 \"ab\"]])   ;=> [[0 5 :keyword] [6 9 :name]]"
  (fold splices
    spans
    (fn (current splice)
      (let ([lo hi replacement] splice
            added (string/length replacement))
        (fold current
          []
          (fn (out span)
            (let ([start end face] span
                  from (ed-shift-start start lo hi added)
                  to (ed-shift-offset end lo hi added))
              (if (< from to) (conj out [from to face]) out))))))))

(defn- ed-band-end-char (rope line-count line)
  ;; the char offset `line` starts at in `rope`, or its end for a line past the last
  (if (>= line line-count) (text/length rope) (text/line->char rope line)))

(defn- ed-behind-tree-band (m pane buf old top vrows)
  "`old` — a band the buffer's tree coloured, or one already carried — carried to `buf`'s
text while its tree is behind (`syntaxtree/behind-syntax-tree?`): its spans shifted across
the edits since ([[ed-shift-spans]]) and its line range moved with them, marked `:shifted?`
(and no longer `:tree?`) so the tree recolours it when it lands rather than letting it
survive as its own. Nil when there is no such band or tree, the splice log cannot say what
the edits were, or the carried band no longer holds the viewport — the caller slices."
  (when (and old
          (or (:tree? old) (:shifted? old))
          (behind-syntax-tree? m (map/get-in pane [:payload :buffer]) buf))
    (let (old-rope (:rope old)
          splices (when (not (= old-rope (buffer-rope buf)))
                    (buffer-splices-since (assoc buf :rope old-rope) buf)))
      (cond
        ;; nothing moved since it was carried (point moved, the tree still out)
        (= old-rope (buffer-rope buf)) (when (ed-band-contains? old buf top vrows) old)
        ;; the log cannot account for the edits: nothing to carry the spans with
        (nil? splices) nil
        else
          (let (old-lines (text/line-count old-rope)
                rope (buffer-rope buf)
                lines (buffer-line-count buf)
                carry (fn (offset)
                        (fold splices
                          offset
                          (fn (at splice)
                            (let ([lo hi replacement] splice)
                              (ed-shift-offset at lo hi (string/length replacement))))))
                start (carry (ed-band-end-char old-rope old-lines (:blo old)))
                end (carry (ed-band-end-char old-rope old-lines (:bhi old)))
                carried {:rope rope
                         :type (:type buf)
                         :blo (text/char->line rope start)
                         :bhi (if (>= end (text/length rope)) lines (text/char->line rope end))
                         :src nil
                         :base 0
                         :shifted? true
                         :spans (ed-shift-spans (:spans old) splices)})
            (when (ed-band-contains? carried buf top vrows) carried))))))

(defn- ed-pane-tree (m pane buf)
  "`[tree-entry faces]` for `pane`'s buffer when it has a current tree and its mode a face
table to colour it by, else nil."
  (let (tree-entry (current-syntax-tree m (map/get-in pane [:payload :buffer]) buf)
        faces (when tree-entry (ed-mode-service buf :ts-faces)))
    (when faces [tree-entry faces])))

(defn- ed-tree-spans-now (m pane buf top vrows)
  "The viewport's spans straight from `buf`'s current tree, for the view's uncached frame —
nil when there is no current tree (or no face table), so the caller lexes a slice."
  (let (found (ed-pane-tree m pane buf))
    (when found
      (let ([tree-entry faces] found)
        (ed-tree-range-spans buf (:tree tree-entry) faces top (+ top vrows) (ed-fontify-clip pane))))))

;; ---- bands coloured from a line-state cache (brood ADR-471) --------------------
;; A lexer mode with a `:line-lexer` (markdown, org, the `lex-*` formats) keeps the lines it
;; lexed (`linecache`): each line's spans with the state it started and ended in. A band is
;; read from that cache, so an edit re-lexes the lines it touched — and, for a lexer that
;; carries state, on until a line starts in the state it started in before — rather than a
;; lead-in found by a restart scan plus the whole band. Exact at any depth: a fence opened a
;; thousand lines up colours the band as code. The long-line path stays the slice path's.

(defn- ed-line-band-survives? (entry buf top vrows)
  "True when line band `entry` still serves the viewport after an edit BELOW it: it covers
`[top, top+vrows)`, and the change between its rope and `buf`'s starts at or after the band's
end — so no line in it moved or changed, and a line lexer reads its lines in order, so
nothing below one can reach it. Where the change starts is read from the splice log
(`model/ed-edit-range`), not by comparing the two texts.

Not for a mode with a `:line-band-pass`: that pass reads PAST the band (markdown colours a
fence as its language over the whole fence, `linecache/line-band`), so typing below the band
inside a fence that runs off the screen changes colours inside it. Its band is rebuilt — the
line cache and the pass's own memo make that cheap."
  (and entry
    (:line? entry)
    (nil? (ed-mode-service buf :line-band-pass))
    (ed-band-contains? entry buf top vrows)
    (let (old (:rope entry))
      (and (< (:bhi entry) (text/line-count old))
        (let (start (first (ed-edit-range buf old)))
          (or (nil? start) (>= start (text/line->char old (:bhi entry)))))))))

(defn- ed-line-band-for (caches idx buf builder top vrows)
  "`[entry caches']`: a `:span-cache` band for `buf`'s viewport (the viewport widened by
`ed-pane-margin` each side) read from pool buffer `idx`'s line cache, marked `:line? true`, and
the caches with that buffer's brought up to date — or nil for `entry` on the long-line path,
which the slice path serves."
  (let ([long? band-low band-high] (ed-band-lines buf top vrows))
    (if long?
      [nil caches]
      (let ([caches spans] (line-band caches idx buf builder band-low band-high))
        [{:rope (buffer-rope buf)
          :type (:type buf)
          :blo band-low
          :bhi band-high
          :src nil
          :base 0
          :line? true
          :spans spans}
          caches]))))

(sig ed-pane-spans (model pane buffer int int -> any))
(defn ed-pane-spans (m pane buf top vrows)
  "The `[start end face]` syntax spans for `pane`'s viewport — from the model's
`:span-cache` when its band still covers the viewport, else freshly lexed for just the
visible window (the cold/uncovered fallback; `ed-refresh-spans` widens & caches it for
next frame). `nil` when the buffer's mode offers no `:fontify` service.

A buffer carrying `:face-spans` — faces as DATA over the whole text, the way rendered
text (a markdown preview) arrives, since no lexer can recover a face from text whose
markup is gone — serves those instead: absolute already, valid as long as the text is
(the buffer is replaced whole with its spans), and cheap enough to hand over unwindowed."
  (let (fontify (ed-mode-service buf :fontify)
        static (:face-spans buf))
    (cond
      static static
      (nil? fontify) nil
      else
        (let (entry (map/get-in m [:span-cache (:path pane)]))
          ;; the common frame — same rope, viewport inside the band — answers before the
          ;; `:fontify-restart` lookup, which only the off-band-edit revalidation reads
          (if (ed-band-hits? entry buf top vrows)
            (:spans entry)
            (let (restart (ed-mode-service buf :fontify-restart))
              (if (ed-band-covers? entry buf top vrows restart)
                (:spans entry)
                ;; a current tree colours the viewport without a parse, a line lexer from
                ;; the lines it kept; without either the window is sliced and lexed
                (let (tree-spans (ed-tree-spans-now m pane buf top vrows)
                      builder (when (nil? tree-spans) (buffer-line-lexer buf)))
                  (cond
                    tree-spans tree-spans
                    (and builder (not (ed-long-lines? buf top (+ top vrows))))
                      (line-band-now m
                        (map/get-in pane [:payload :buffer])
                        buf
                        builder
                        top
                        (+ top vrows))
                    else
                      (ed-window-spans buf
                        fontify
                        restart
                        top
                        (+ top vrows)
                        (ed-fontify-clip pane)))))))))))

(sig ed-layout-now (model -> (or nil layout)))
(defn ed-layout-now (m)
  "The pane layout over the window as it was last painted — `ed-body-layout` at the
`[cols rows]` `ed-refresh-spans` cached on `:_lc` after the previous event — or nil before
any frame (headless, or the first event). For code that runs INSIDE an event (a `:post-key`
hook, an idle beat) and needs a pane's geometry — which pane shows a buffer, how many rows
it has — without being handed the window size: the layout is recomputed over the current
`:layout`, so a split this very event is already in it; only the window size is a frame old."
  (let (lc (get m :_lc))
    (if (nil? lc) nil (ed-body-layout m (nth lc 0) (nth lc 1)))))

(defn ed-viewport (m cols rows)
  "[textrows textcols] for the selected pane — a single `ed-body-layout` call covers
both dimensions, so `ed-update` doesn't pay for two independent layout traversals."
  (let (panes (:panes (ed-body-layout m cols rows))
        sel (ed-selected-pane panes)
        buf (ed-pane-buf m sel))
    [(math/max 1 (ed-pane-vrows sel buf)) (ed-pane-text-cols sel buf)]))

;; ---- the gutter-cell cache (same discipline as the span cache) ---------------
;; The line-number gutter rebuilds every visible cell each frame — per line a mode
;; service call, git-status/mark lookups and interpreted string padding — yet during
;; plain typing its output is bit-identical frame to frame (it changes only on scroll,
;; a line-count change, a git/mark refresh, or zoom). So the CELLS (the `[text face]`
;; chunk lists, pure data — no render ops, so no view dependency) are cached per pane
;; path and reconciled here; `view/ed-gutter-ops` just positions them.

(defn- ed-gutter-key (buf gw ctx)
  "Everything a single line's gutter cell depends on BESIDES its line number. Two buffers
producing equal keys produce equal cells for the same line: the number column is a function
of `gw` / line-count / file-backing (a file buffer prepends the diff bar), and everything
else the cell reads is the gutter CONTEXT `ctx` (`gutter/gutter-ctx`) — the change-bar map
and each margin mark's value paired with whether it is stale.

`ctx`, not the buffer's ROPE. The rope was here because a mark dims once the text moves past
it and an annotation's own stamp is frozen at annotation time — but staleness is a boolean
that flips ONCE, and keying on the rope rebuilt the whole column on every character typed
(~2 ms a keystroke on a 49-row pane, re-deriving marks that had not changed). The context
carries the boolean, so the first keystroke after a test run rebuilds and the rest reuse.

Deliberately EXCLUDES the viewport (`top`/`vh`): cells are per absolute line, so a
scroll reuses the overlap of the previous window (`ed-gutter-cells`) instead of
recomputing every visible cell per scrolled line — the held-C-n case."
  ;; under relative numbering every number is a distance from point's line, so that line
  ;; is part of what a cell depends on
  [gw
    (buffer-line-count buf)
    (and (buffer-file buf) true)
    ctx
    (when (= (scroll/ed-line-numbers-for buf) :relative) (buffer-current-line buf))])

(defn- ed-gutter-cells (buf cell top vh gw old ctx)
  "The mode's `:gutter-cell` chunks for each visible line `top`..`top+vh-1` (clamped
to EOF), as a vector in line order — the expensive per-line work the cache holds. An
`old` entry with the same content key (`ed-gutter-key`, checked by the caller) donates
the cells its window shares with this one — a scroll recomputes only the lines that
slid into view, not the whole column.

`ctx` is the gutter context the cells read (`gutter/gutter-ctx`), bound for the whole column
— the buffer's marks and change bars are a fact about the BUFFER, and asking them per line
allocated a map and counted the buffer's lines some three hundred times per rebuild."
  (let (last-line (math/min (dec (buffer-line-count buf)) (dec (+ top vh)))
        otop (or (:top old) 0)
        ocells (or (:cells old) [])
        on (count ocells))
    (binding (*gutter-ctx* ctx)
      (into []
        (map (range top (inc last-line))
          (fn (line)
            (let (oi (- line otop))
              (if (and (>= oi 0) (< oi on))
                (nth ocells oi)
                (cell buf line gw)))))))))

(defn- ed-gutter-entry-serves? (entry key top vh)
  "True if cached gutter `entry` still serves a pane: same content key (`ed-gutter-key`) and
the same window `[top, top+vh)`."
  (and entry (= (:key entry) key) (= (:top entry) top) (= (:vh entry) vh)))

(defn ed-pane-gutter-cells (m pane buf top vh gw)
  "The gutter cells for `pane`'s viewport — from the model's `:gutter-cache` when its
content key and window still match, else freshly computed (the cold/uncovered fallback;
`ed-refresh-spans` caches it for next frame). `nil` when the gutter is hidden or the
mode offers none."
  (let (cell (ed-mode-service buf :gutter-cell))
    (if (or (<= gw 0) (nil? cell))
      nil
      (let (entry (map/get-in m [:gutter-cache (:path pane)])
            ctx (gutter/gutter-ctx buf))
        (if (ed-gutter-entry-serves? entry (ed-gutter-key buf gw ctx) top vh)
          (:cells entry)
          (ed-gutter-cells buf cell top vh gw nil ctx))))))

(defn- ed-refreshed-span-entry (m old pane buf caches)
  "`[entry caches']`: `pane`'s `:span-cache` entry this frame and the line caches
(`:line-caches`) after it. The entry is `old` while its band still covers the viewport
(`ed-band-covers?`; for a band coloured from a tree `ed-tree-band-survives?`, from a line
cache `ed-line-band-survives?`), else a fresh band — coloured from the buffer's current tree
when it has one (`ed-tree-band-for`), from its line cache when its mode has a line lexer
(`ed-line-band-for`), lexed from a slice otherwise (`ed-band-for`). Nil when the buffer's
mode does not fontify."
  (let (fontify (ed-mode-service buf :fontify))
    (if (nil? fontify)
      [nil caches]
      (let (top (ed-pane-top pane buf)
            vrows (ed-pane-vrows pane buf))
        ;; as `ed-pane-spans`: the unchanged band is recognised before the restart lookup
        ;; …but a carried band is only kept by `ed-behind-tree-band`, while the tree is out
        (if (and (ed-band-hits? old buf top vrows) (not (:shifted? old)))
          [old caches]
          (let ([tree-entry faces] (or (ed-pane-tree m pane buf) [nil nil])
                carried (when (nil? faces) (ed-behind-tree-band m pane buf old top vrows))
                builder (when (and (nil? faces) (nil? carried)) (buffer-line-lexer buf)))
            (cond
              carried [carried caches]
              ;; the edit left this band's text and colouring alone: re-stamp it with the
              ;; rope it now serves, keeping its spans (the view memo keys on that vector)
              (and faces (ed-tree-band-survives? old tree-entry buf top vrows))
                [(assoc old :rope (buffer-rope buf)) caches]
              faces
                [(or (ed-tree-band-for tree-entry faces buf top vrows (ed-fontify-clip pane))
                   (ed-slice-band buf fontify old top vrows pane))
                  caches]
              (nil? builder) [(ed-slice-band buf fontify old top vrows pane) caches]
              (ed-line-band-survives? old buf top vrows)
                [(assoc old :rope (buffer-rope buf)) caches]
              else
                (let ([entry caches] (ed-line-band-for caches
                                       (map/get-in pane [:payload :buffer])
                                       buf
                                       builder
                                       top
                                       vrows))
                  [(or entry (ed-slice-band buf fontify old top vrows pane)) caches]))))))))

(defn- ed-slice-band (buf fontify old top vrows pane)
  "`old` while its slice band still covers the viewport, else a band lexed from a slice.

An edit inside the band slices it ONCE: the input `ed-band-window` sliced to compare with
`old`'s is the input a re-lex of the same lines takes, so it is lexed as it stands rather
than sliced again for the margins `ed-band-for` would pick. Only a band that no longer holds
the viewport, or a viewport on the long-line path, goes to `ed-band-for`."
  (let (restart (ed-mode-service buf :fontify-restart)
        window (when (not (= (:rope old) (buffer-rope buf)))
                 (ed-band-window old buf top vrows restart)))
    (cond
      (ed-band-hits? old buf top vrows) old
      (nil? window) (ed-band-for buf fontify restart top vrows (ed-fontify-clip pane))
      (= window [(:src old) (:base old)]) old
      (ed-long-lines? buf top (+ top vrows))
        (ed-band-for buf fontify restart top vrows (ed-fontify-clip pane))
      else (ed-slice-entry buf fontify (:blo old) (:bhi old) window))))

(defn- ed-refreshed-gutter-entry (old pane buf)
  "`pane`'s `:gutter-cache` entry this frame: `old` while it still serves the pane
(`ed-gutter-entry-serves?`), else rebuilt — reusing `old`'s cells for the lines both windows
show when only the window moved (`ed-gutter-cells`). Nil when the gutter is hidden or the
mode offers none."
  (let (cell (ed-mode-service buf :gutter-cell)
        gw (ed-pane-gutter-width buf pane))
    (when (and (> gw 0) cell)
      (let (top (ed-pane-top pane buf)
            vh (ed-pane-vrows pane buf)
            ctx (gutter/gutter-ctx buf)
            key (ed-gutter-key buf gw ctx))
        (if (ed-gutter-entry-serves? old key top vh)
          old
          ;; content key matches but the window moved: shift — reuse the overlapping
          ;; lines' cells, compute the rest
          {:key key
           :top top
           :vh vh
           :cells (ed-gutter-cells buf cell top vh gw (if (and old (= (:key old) key)) old nil) ctx)})))))

(defn- ed-assoc-present (cache key entry)
  "`cache` with `entry` stored under `key` — unless there is no entry, which is how a pane
that no longer needs one drops out of the rebuilt cache."
  (if (nil? entry) cache (assoc cache key entry)))

(defn ed-refresh-spans (m cols rows)
  "Refresh the fontify `:span-cache` (and the `:gutter-cache`) for every visible pane —
but only where the cached entry no longer serves the pane's viewport (the rope changed,
or it scrolled past the margin). A still-covering band / still-matching gutter key costs
nothing.

Keyed by PANE PATH, not buffer index: several panes can show the same buffer at DIFFERENT
scroll positions, each needing its own cached band. Keying by buffer let a single entry serve
them all — so each pane's refresh invalidated the others', and N panes on one big file
re-fontified N bands EVERY event (the 'open 3, performance tanks' cliff). The maps are rebuilt
fresh each call — reusing a still-valid entry from the old cache, and GC'ing panes that
closed (a stale pane path never accumulates). Run by `input/ed-update` after each event so the
pure `view` just reads the result; also caches the layout as `:_lc`."
  (let (layout (ed-body-layout m cols rows)
        ;; the trees first: an edit this event reparses each shown buffer's tree
        ;; incrementally, once however many panes show it, and the bands below read it
        m (ed-sync-syntax-trees m
            (map (:panes layout) (fn (pane) (map/get-in pane [:payload :buffer]))))
        old-spans (or (:span-cache m) {})
        old-gutters (or (:gutter-cache m) {})
        ;; the line caches of buffers since killed or gone are dropped here, as the trees are
        ;; by `ed-sync-syntax-trees`
        old-caches (sweep-line-caches (or (:line-caches m) {}) (count (:buffers m)))
        [spans gutters caches] (fold (:panes layout)
                                 [{} {} old-caches]
                                 (fn ([spans gutters caches] pane)
                                   (let (path (:path pane)
                                         buf (ed-buf-at m (map/get-in pane [:payload :buffer]))
                                         [entry caches] (ed-refreshed-span-entry m
                                                          (get old-spans path)
                                                          pane
                                                          buf
                                                          caches))
                                     [(ed-assoc-present spans path entry)
                                       (ed-assoc-present gutters
                                         path
                                         (ed-refreshed-gutter-entry (get old-gutters path) pane buf))
                                       caches]))))
    (assoc m :span-cache spans :gutter-cache gutters :line-caches caches :_lc [cols rows layout])))

;; ---- mouse: select / move-point / scrollbar / drag-resize -------------------

(defn ed-pane-buf (m pane)
  "The buffer shown in `pane` — its payload's pooled buffer, carrying that pane's **window-local**
cursor (`model/ed-with-window-point`), so the view renders each pane at its own point/mark rather
than a cursor shared across every view of the buffer."
  (let (pl (:payload pane))
    (ed-with-window-point (ed-buf-at m (:buffer pl)) (:point pl) (:mark pl))))

(defn ed-scrollbar-hit? (pane buf row col)
  "True if `[row col]` lands on `pane`'s scrollbar: its rightmost column, on a text row
(above the mode line), with the bar shown — `buf` doesn't fit the `vh` text rows (the
same predicate `view/ed-scrollbar-ops` draws under)."
  (let ([px py pw ph] (:rect pane)
        vh (math/max 1 (dec ph)))
    (and (= col (+ px (dec pw)))
      (>= row py)
      (< row (+ py vh))
      (> (buffer-line-count buf) (math/max 1 (ed-pane-vrows pane buf))))))

(sig ed-scrollbar-top-for (buffer int int int &optional (or nil int) (or nil int) -> int))
(defn ed-scrollbar-top-for (buf vh row sy &optional (w nil) (track nil))
  "The pane `:top` for a scrollbar click/drag at screen `row`, on a track of `track` rows
(the pane's window rows; `vh` when not given) starting at `sy`, with `vh` buffer lines in
view: a proportional map — the track top scrolls to 0, the bottom to `ed-max-top`
(row-counted for a wrapped buffer given its text width `w`) — clamped into `[0, max-top]`.
The two heights differ for a zoomed pane: its track is the window's rows, its page fewer,
bigger lines."
  (let (maxtop (ed-max-top buf (math/max 1 vh) w)
        vh (or track vh)
        rr (math/max 0 (math/min (dec vh) (- row sy))))
    (if (<= maxtop 0)
      0
      (math/max 0 (math/min maxtop (math/quot (* maxtop rr) (math/max 1 (dec vh))))))))

(sig ed-buf-offset-at (buffer int int int number int number -> int))
(defn ed-buf-offset-at (buf line hscroll gw rw px col)
  "The buffer offset under screen column `col` on buffer `line` for a pane at left edge
`px`, left gutter `gw` columns wide, a cell `rw` window cells wide (`ed-zoom-ratio`; 1
unzoomed), scrolled `hscroll` columns — the column half of the view's pane geometry
(`view/ed-pane-ops` / `ed-cursor`); the LINE is the caller's, from
`ed-pane-line-at-clamped`, the one row→line owner. The cell is `(col-px)/rw - gw` right
of the first shown character (`hscroll` chars in, as
`view/ed-visual-column-from` counts it), and `string/width->index` turns that cell back
into a character by the SAME measure the view lays the line out with (`display-width`:
an emoji or CJK glyph is two cells, a combining mark none) — a click on a wide glyph
lands before it, never a character past it. Clamped: a click past a short line's end
lands at its end, never the next line."
  (let (line (math/min (math/max 0 (dec (buffer-line-count buf))) line)
        vcol (math/floor (/ (math/max 0 (- col px)) rw))
        cell (math/max 0 (- vcol gw))
        rope (buffer-rope buf)
        bol (text/line->char rope line)
        lt (buffer-line-at buf line)
        llen (if (string/ends-with? lt "\n") (dec (string/length lt)) (string/length lt))
        h (math/min hscroll llen)
        from (+ bol h)
        ;; the slice is laid out from the display column its first character sits at, so a
        ;; tab in it spans to the LINE's stop, as the view painted it (ADR-342)
        h-col (if (= h 0) 0 (string/display-width (text/slice rope bol from))))
    (+ from (string/width->index (text/slice rope from (+ bol llen)) cell h-col))))

(sig ed-mouse-begin-select (map pane buffer number number -> any))
(defn ed-mouse-begin-select (m pane buf row col)
  "Left-press in the text area (Emacs `mouse-set-point` + the start of a drag-select):
move point to the clicked cell, clear any prior mark, and arm a text-selection drag
(`:text-drag`, carrying the pane geometry and the click as the region `:anchor`). So a
plain click (press then release, no drag) leaves no region; a drag sets the mark at the
anchor and grows the region to the pointer (`ed-text-drag`). The pane is already
selected, so `buf` is the current buffer; written back via `ed-set-buf`.

A press ON THE GUTTER (left of the text, inside the mode's reserved columns) is not a
point move: it routes to the mode's `:gutter-click` service — `(m line) -> m`, resolved
late like every service — the margin-click seam (a breakpoint toggle in brood-mode).
With no such service the click falls through to the old clamped point move."
  (let ([px py pw ph] (:rect pane)
        top (or (map/get-in pane [:payload :top]) 0) ; recorded for the drag; the line is `ed-pane-line-at-clamped`'s
        hscroll (ed-pane-hscroll pane)
        [rw rh] (ed-zoom-ratio pane)
        gw (ed-pane-gutter-width buf pane)
        vcol (math/floor (/ (math/max 0 (- col px)) rw))
        gutter-line (when (and (> gw 0) (< vcol gw)) (ed-pane-line-at-clamped pane buf row))
        ;; A click on a MARKED line acts on the mark — resolved through the same table that
        ;; painted it (`gutter/gutter-click-for`), so the margin cannot show one thing and do
        ;; another. A line with no mark, or a mark that claims no click, falls through to
        ;; the mode's `:gutter-click` below, which is how a click on bare margin SETS a
        ;; breakpoint rather than only clearing one.
        mark-click (when gutter-line (gutter/gutter-click-for buf gutter-line))
        ;; a click in the gutter columns routes to the mode's `:gutter-click`, but
        ;; ONLY when the mode defines one — otherwise it falls through to a normal
        ;; text click (a gutterless-service buffer must still select from column 0).
        ;; The lookup `reflect/eval`s the service symbol, which throws if its module (deferred
        ;; debugger) isn't loaded yet: caught, so a startup-second click can't crash.
        gutter-svc (when (and gutter-line (nil? mark-click))
                     (try
                       (ed-mode-service buf :gutter-click)
                       (catch e
                         (do
                           (log/warn (str "gutter-click service unavailable: " (error-message e)))
                           nil)))))
    (cond
      mark-click
        (try
          ((reflect/eval mark-click) m gutter-line)
          (catch e (message m (str "gutter: " (error-message e)))))
      gutter-svc
        (try
          (gutter-svc m gutter-line)
          (catch e (message m (str "gutter: " (error-message e)))))
      else
      ;; the row's own hscroll: a wrapped continuation row starts mid-line (`ed-pane-row-hscroll`)
        (let (line (ed-pane-line-at-clamped pane buf row)
              off (ed-clip-click buf
                    line
                    (ed-pane-row-clip pane buf row)
                    (ed-buf-offset-at buf line (ed-pane-row-hscroll pane buf row) gw rw px col)))
          (assoc (ed-set-buf m (clear-mark (goto-char buf off)))
            :text-drag
              {:buf (map/get-in pane [:payload :buffer])
               :rect (:rect pane)
               :top top
               :hscroll hscroll
               :gw gw
               :ratio [rw rh]
               :anchor off})))))

(sig ed-drag-edge-advance (buffer int int -> int))
(defn- ed-drag-edge-advance (buf off n)
  "Shift char offset `off` by `n` (signed) but clamped to stay on its current line — the
horizontal drag-scroll step, so pushing point against a horizontal edge grows the
selection ALONG the line (toward its end / start) rather than jumping to another line."
  (let (rope (buffer-rope buf)
        line (text/char->line rope off)
        bol (text/line->char rope line)
        lt (buffer-line-at buf line)
        eol (+ bol (if (string/ends-with? lt "\n") (dec (string/length lt)) (string/length lt))))
    (math/max bol (math/min eol (+ off n)))))

(sig ed-text-drag (model number number -> model))
(defn ed-text-drag (m row col)
  "While dragging a text selection (`:text-drag`, armed by a left-press in the text
area), set the mark at the press `:anchor` and move point to the pointer cell — growing
the region that `view/ed-hl-ranges` paints in reverse video. Uses the geometry captured
at press (the buffer can't change mid-drag), so it needs no layout. A no-op when no text
drag is in progress."
  (let (td (:text-drag m))
    (if (nil? td)
      m
      (let (buf (ed-buf-at m (:buf td))
            [px py pw ph] (:rect td)
            [rw rh] (or (:ratio td) [1 1])
            ;; read the pane's CURRENT scroll (the dragged pane is the selected one), not
            ;; the press-time top — so as a drag past the edge scrolls (ed-ev-mouse's
            ;; clamp), the pointer keeps mapping to the newly-revealed lines and the
            ;; region keeps growing instead of sticking at the press-time viewport.
            ;; the row→line mapping is the pane's (`ed-pane-line-at-clamped`, the one owner):
            ;; the selected pane's live payload under the press-time rect — a `pane` in
            ;; full (it IS the selected one; the path is what `:selected` makes moot)
            live {:rect (:rect td) :payload (ed-current-pane m) :path '() :selected true}
            hscroll (ed-current-hscroll m)
            off0 (ed-buf-offset-at buf
                   (ed-pane-line-at-clamped live buf row)
                   (ed-pane-row-hscroll live buf row)
                   (:gw td)
                   rw
                   px
                   col)
            ;; Edge auto-scroll (the horizontal analogue of dragging past the bottom to
            ;; scroll down): a pane's right edge IS the window edge, so the pointer can't
            ;; go beyond it to map to off-screen columns. Instead, when the drag is against
            ;; the right/left text edge, push point a step further along the line so
            ;; `ed-scroll-horizontal` reveals more of it. `ed-drag-edge-advance` clamps to
            ;; the line, so a short line (nothing to reveal) is untouched.
            right-edge (- (+ px pw) (math/ceil rw))
            left-edge (+ px (math/floor (* (:gw td) rw)))
            off (cond
                  (>= col right-edge) (ed-drag-edge-advance buf off0 8)
                  (< col left-edge) (ed-drag-edge-advance buf off0 -8)
                  else off0))
        (ed-set-buf m (assoc (goto-char buf off) :mark (:anchor td)))))))

(defn ed-mouse-press (m cols rows row col at)
  "Left-press at cell `[row col]`, the pointer exactly at `at` (`ed-mouse-at`). On a
divider → begin a resize drag (`:dragging` carries the split path + the rect to measure
the new ratio against). On a pane's scrollbar → select that pane, scroll it to the
clicked position, and arm a scrollbar drag (`:sb-drag`) so motion keeps scrolling it.
Otherwise select the pane under the pointer and, when the click is in its text area (not
the mode line), move point there and arm a text-selection drag (`ed-mouse-begin-select`).
The cell picks the pane, the divider or the scrollbar; the exact position picks the
character, because a zoomed pane's cells are not the window's."
  (let (layout (ed-body-layout m cols rows)
        d (divider-at layout [row col])
        pane (pane-at layout [row col]))
    (cond
      d (assoc m :dragging d)
      (nil? pane) m
      else
        (let (buf (ed-pane-buf m pane)
              [px py pw ph] (:rect pane)
              vh (math/max 1 (dec ph))
              selected (assoc m :layout (pane-select-at (:layout m) layout [row col])))
          (cond
            (ed-scrollbar-hit? pane buf row col)
              (ed-scrollbar-wake (assoc selected
                                   :layout
                                     (pane-update-path (:layout selected)
                                       (:path pane)
                                       (fn (w)
                                         (assoc w
                                           :top
                                             (ed-scrollbar-top-for buf
                                               (math/max 1 (ed-pane-vrows pane buf))
                                               row
                                               py
                                               (ed-pane-text-cols pane buf)
                                               vh))))
                                   :sb-drag
                                     {:path (:path pane)
                                      :sy py
                                      :vh (math/max 1 (ed-pane-vrows pane buf))
                                      :track vh
                                      :w (ed-pane-text-cols pane buf)
                                      :buf (map/get-in pane [:payload :buffer])}))
            (< row (+ py vh)) (ed-mouse-begin-select selected pane buf (first at) (second at))
            else selected)))))

(defn ed-scrollbar-drag (m row col)
  "While dragging a scrollbar (`:sb-drag` set by `ed-mouse-press`), scroll its pane to
follow the pointer (`ed-scrollbar-top-for`). A no-op if not dragging one."
  (let (sb (:sb-drag m))
    (if (nil? sb)
      m
      (assoc m
        :layout
          (pane-update-path (:layout m)
            (:path sb)
            (fn (w)
              (assoc w
                :top
                  (ed-scrollbar-top-for (ed-buf-at m (:buf sb))
                    (:vh sb)
                    row
                    (:sy sb)
                    (:w sb)
                    (:track sb)))))))))

(defn ed-mouse-drag (m row col)
  "While dragging a divider, set its split's ratio so the boundary follows the
pointer (clamped by `pane-set-ratio` so no pane vanishes). A no-op if not dragging."
  (let (d (:dragging m))
    (if (nil? d)
      m
      (assoc m
        :layout (pane-set-ratio (:layout m) (:path d) (pane-ratio-for d [row col]))))))

(defdyn *wheel-lines* 3) ; lines a plain wheel notch scrolls
;; ---- mouse wheel acts on the pane UNDER THE POINTER (not the active one) -----
;; A wheel notch zooms / scrolls the pane the cursor is over, like every editor —
;; so it never disturbs which pane is selected — a zoom is that pane's alone. `pane-at` resolves the hovered
;; pane (carrying its `:path`); `pane-update-path` edits exactly that pane's
;; payload. (Divider drag-resize is already hover-targeted in `ed-mouse-press`.)

(sig ed-pane-at (map int int int int -> (or nil pane)))
(defn ed-pane-at (m cols rows row col)
  "The pane under screen cell `[row col]` (`{:path :payload :selected :rect}`), or nil."
  (pane-at (ed-body-layout m cols rows) [row col]))

(defn ed-select-pane-at (m cols rows row col)
  "Select the pane under cell `[row col]` (leaving `m` unchanged when none) — so a
click can make its pane current without the point-move a full press does."
  (let (layout (ed-body-layout m cols rows))
    (if (nil? (pane-at layout [row col]))
      m
      (assoc m :layout (pane-select-at (:layout m) layout [row col])))))

;; ---- the wheel carries point along (Emacs `mwheel-scroll`) ----------------------
;; Scrolling used to leave point where it was, so once the view moved past it the cursor
;; was simply gone — it read as the blink having stopped. Point now moves to the nearest
;; row that `scroll/ed-scroll` would leave alone (the scroll margin kept, relaxed at the
;; buffer's ends), at the same column of its row, so the next key neither loses the cursor
;; nor snaps the view back.

(sig ed-pane-screen-rows (pane buffer int -> seqable))
(defn- ed-pane-screen-rows (pane buf top)
  "`[line from to inlay]` for each row `pane` shows with its top at `top`: the row table of
a wrapped (or inlaid) buffer, else one whole line per row (`from` 0, `to` nil)."
  (let (textrows (math/max 1 (ed-pane-vrows pane buf))
        table (ed-pane-rows (map/assoc-in pane [:payload :top] top) buf))
    (if (nil? table)
      (map (range top (math/min (buffer-line-count buf) (+ top textrows)))
        (fn (line) [line 0 nil nil]))
      (take table textrows))))

(sig ed-wheel-point (pane buffer int number -> (or nil int)))
(defn- ed-wheel-point (pane buf top maxtop)
  "Where point goes once the wheel has put `pane`'s top at `top`: nil while it already sits
on a comfortable row, else the offset on the nearest one."
  (let (textrows (math/max 1 (ed-pane-vrows pane buf))
        margin (ed-margin textrows)
        rows (vec (ed-pane-screen-rows pane buf top))
        first-ok (if (= top 0) 0 margin)
        last-ok (if (>= top maxtop) (dec textrows) (- textrows 1 margin))
        comfortable (seq/filter (range (count rows))
                      (fn (i)
                        (let (inlay (nth (nth rows i) 3 nil))
                          (and (>= i first-ok) (<= i last-ok) (nil? inlay)))))
        line (buffer-current-line buf)
        col (buffer-column buf)
        on-row? (fn (i)
                  (let (row (nth rows i)
                        row-line (nth row 0)
                        from (nth row 1)
                        to (nth row 2))
                    (and (= row-line line)
                      (or (nil? to)
                        (and (>= col from)
                          (or (< col to) (= to (string/length (wrap/line-text buf line)))))))))
        rope (buffer-rope buf))
    (cond
      (empty? comfortable) nil
      (any? comfortable on-row?) nil
      else
        (let (first-row (nth rows (first comfortable))
              first-line (nth first-row 0)
              first-from (nth first-row 1)
              above? (or (< line first-line) (and (= line first-line) (< col first-from)))
              target-row (nth rows (if above? (first comfortable) (last comfortable)))
              target-line (nth target-row 0)
              from (nth target-row 1)
              to (nth target-row 2)
              text (wrap/line-text buf target-line)
              ;; the column within its own row, carried onto the target row
              in-row (if (nil? to)
                       col
                       (let (segs (wrap/line-segments buf
                                    line
                                    (ed-pane-text-cols pane buf)
                                    (ed-row-extras buf)))
                         (- col (first (nth segs (wrap/row-of segs col))))))
              last (cond
                     (nil? to) (string/length text)
                     (= to (string/length text)) to
                     else (if (> (dec to) from) (dec to) from)))
          ;; the row table is untyped data (`[line from to inlay]`, an inlay row carrying a
          ;; string), so the offset is an int by this guard rather than by declaration
          (let (column (+ from in-row)
                offset (+ (text/line->char rope target-line) (if (< column last) column last)))
            (if (int? offset) offset nil))))))

(defn- ed-pane-scrolled (pane buf top maxtop frac)
  "The payload update for `pane` scrolled to `top` (smooth-scroll fraction `frac`): the
new top and fraction, and point carried along when the view left it behind."
  (let (point (ed-wheel-point pane buf (if (int? top) top 0) maxtop))
    (fn (w)
      (let (scrolled (assoc w :top top :scroll-frac frac))
        (if (nil? point) scrolled (assoc scrolled :point point))))))

(sig ed-scroll-pane (model pane int -> model))
(defn ed-scroll-pane (m pane delta)
  "Plain mouse-wheel: scroll the *hovered* `pane`'s viewport by `delta` buffer lines,
moving its `:top`, and carry point along once the view would leave it behind
(`ed-wheel-point`). Negative scrolls toward the top. Clamped at end-of-buffer (the last
line at the bottom row, no scrolling into blank space past EOF — same bound as the
keyboard `ed-scroll`). Also resets `:scroll-frac` to 0.0 (whole-line jumps clear any
accumulated sub-line fractional offset)."
  (let (buf (ed-pane-buf m pane)
        top (or (map/get-in pane [:payload :top]) 0)
        maxtop (ed-max-top buf (math/max 1 (ed-pane-vrows pane buf)) (ed-pane-text-cols pane buf))
        new-top (math/max 0 (math/min maxtop (+ top delta)))
        m2 (assoc m
             :layout
               (pane-update-path (:layout m)
                 (:path pane)
                 (ed-pane-scrolled pane buf new-top maxtop 0.0))))
    (if (= new-top top) m2 (ed-scrollbar-wake m2))))

(sig ed-smooth-scroll-pane (model pane number -> model))
(defn ed-smooth-scroll-pane (m pane dy-frac)
  "Trackpad smooth scroll: accumulate the fractional line delta `dy-frac` (positive =
down, i.e. content moves up) into the pane's `:scroll-frac`. When the accumulated
value crosses a whole line, advance `:top` and keep the remainder. `:scroll-frac` ∈
[0, 1) is passed to the view to emit `(scroll-offset frac)` for sub-cell rendering."
  (let (buf (ed-pane-buf m pane)
        [px py pw ph] (or (:rect pane) [0 0 80 24])
        ;; through the accessors, not the payload: they are the two functions that own
        ;; these questions (clamping `:top` into the buffer and its restriction, keeping
        ;; `:scroll-frac` in [0, 1)), and reading the payload raw here both duplicated
        ;; them and did the arithmetic below on whatever it found
        top (ed-pane-top pane buf)
        frac (ed-pane-scroll-frac pane)
        new-frac-raw (+ frac dy-frac)
        lines (math/floor new-frac-raw)
        remainder (- new-frac-raw lines)
        maxtop (ed-max-top buf (math/max 1 (ed-pane-vrows pane buf)) (ed-pane-text-cols pane buf))
        ideal-top (+ top lines)
        new-top (math/max 0 (math/min maxtop ideal-top))
        ;; Zero the fraction at hard boundaries so the view doesn't oscillate.
        ;; Two cases:
        ;;  1. top was clamped (ideal != new): the clamped line gets re-consumed
        ;;     each event producing a new remainder — the classic top-of-buffer bounce.
        ;;  2. already at maxtop and still pushing down: lines=0 so clamping never
        ;;     fires, but frac accumulates until it crosses 1, resets, repeats — the
        ;;     same oscillation at the bottom of the buffer.
        new-frac (if (or (not (= new-top ideal-top)) (and (= top maxtop) (> dy-frac 0)))
                   0.0
                   (if (< remainder 0.0) 0.0 (if (>= remainder 1.0) 0.999 remainder)))
        ;; a new delta takes over from a settle ease already under way
        m2 (assoc (dissoc m :scroll-gliding)
             :layout
               (pane-update-path (:layout m)
                 (:path pane)
                 (ed-pane-scrolled pane buf new-top maxtop new-frac))))
    (if (= new-top top) m2 (ed-scrollbar-wake m2))))

(defn ed-toggle-line-numbers (m)
  "Toggle the left line-number gutter on the *selected pane* (per-pane, like Emacs
`display-line-numbers-mode` but pane-local). The gutter defaults **on** for a buffer
whose mode offers it, so the per-pane `:line-numbers` is an explicit override: this
flips the *effective* state — an unset (nil, default-on) pane goes to `false` (hidden),
an explicit `false` back to `true`. Pure."
  (assoc m
    :layout
      (pane-update-selected (:layout m)
        (fn (p) (assoc p :line-numbers (= false (:line-numbers p)))))))

(defn- ed-select-word (buf)
  "Select the word at point — mark at its start, point at its end. The double-click
expansion (ADR-102's click count)."
  (let (endb (forward-word buf)
        end (buffer-point endb)
        start (buffer-point (backward-word endb)))
    (assoc (goto-char buf end) :mark start)))

(defn- ed-select-line (buf)
  "Select the whole line at point — mark at its start, point at its end. The
triple-click expansion."
  (let (start (buffer-point (beginning-of-line buf))
        end (buffer-point (end-of-line buf)))
    (assoc (goto-char buf end) :mark start)))

(sig ed-mouse-at (vector -> vector))
(defn ed-mouse-at (input)
  "`[row col]` — where a `[:mouse …]` event's pointer is in FRACTIONAL window cells: the
runtime's trailing `{:at [row col]}` when it sent one (a GUI window), else the whole cell
(a terminal, a test, an older runtime). The pane under the pointer is found by its CELL;
where in that pane is asked with this. A zoomed pane is painted at its own cell size, so
its rows and columns begin partway through a window cell. The cell was rounded down
before the zoom ratio could divide it, and a click landed up to a row away from the
text under the pointer."
  (let (extra (nth input 7 nil)
        at (when (map? extra) (:at extra)))
    (if (and (vector? at) (= 2 (count at)) (number? (first at)) (number? (second at)))
      at
      [(nth input 3) (nth input 4)])))

(defn- ed-end-drags (m)
  "The model with every editor drag over — divider, scrollbar and text selection."
  (dissoc m :dragging :sb-drag :text-drag))

(defn- ed-mouse-to-program (m action cols rows row col)
  "The model after a terminal buffer's program took a mouse event (`m` is what
`terminal/term-mouse` answered): a press into a program still selects its pane, and a release
still ends the editor's own drags."
  (case action
    :press (ed-select-pane-at m cols rows row col)
    :release (ed-end-drags m)
    m))

(defn- ed-expand-click (m clicks)
  "A double / triple click (the trailing count, ADR-102) expands the selection to the word /
line at point — but only for a text-area click, which is the one that armed `:text-drag`."
  (if (and (:text-drag m) (>= clicks 2))
    (ed-set-buf m
      (let (buf (ed-current-buf m))
        (if (>= clicks 3) (ed-select-line buf) (ed-select-word buf))))
    m))

(defn- ed-left-drag (m row col at)
  "A left-button drag: scroll the grabbed scrollbar, extend the text selection, or resize the
dragged divider."
  (cond
    (:sb-drag m) (ed-scrollbar-drag m row col)
    (:text-drag m) (ed-text-drag m (first at) (second at))
    else (ed-mouse-drag m row col)))

(def- ed-wheel-directions
  ;; a wheel event's action -> which way it turns: toward the top of the buffer is 1
  {:scroll-up 1 :scroll-down -1})

(defn- ed-wheel-zoom (m pane direction delta)
  "Ctrl+wheel zooms the PANE under the pointer, a pixel per notch — this pane only; the
window's font is untouched, so the grid never changes under the gesture and nothing else on
screen moves. `appearance/zoom-step` accumulates the same float `delta` the scroll path reads
and steps once a notch's worth has arrived. The delta is in LINE units: a notch is not one
event and not one line — the runtime spreads it over a decaying stream summing to ~3 lines —
so the conversion to pixels lives in `appearance`, which knows that ratio. An event with no
delta (a terminal, an older test) is read as one whole notch. Deferred-loaded, the keymap
idiom, so this core file does not link the preset registry. Shift is ignored: there is one
zoom now."
  (cond
    (not (bound? 'appearance/zoom-step)) m
    (nil? delta) ((reflect/eval 'appearance/zoom-notch) m pane direction)
    :else ((reflect/eval 'appearance/zoom-step) m pane (* direction delta))))

(defn- ed-wheel-scroll (m pane direction delta)
  "A plain wheel scrolls the pane under the pointer. `delta` is the scroll in line units
(float, from the Brood runtime) — a trackpad step, or one tick of a wheel notch's kinetic
glide (the runtime turns a notch into an impulse that decays over ~half a second, so the
wheel scrolls as smoothly as the trackpad). Any delta takes the smooth path: a whole line or
more per tick (a spun wheel) advances `:top` and keeps the remainder. Absent (old tests /
terminal) → the legacy `*wheel-lines*` snap."
  (if (nil? delta)
    (ed-scroll-pane m pane (if (> direction 0) (- *wheel-lines*) *wheel-lines*))
    (ed-smooth-scroll-pane m pane (* (- direction) delta))))

(defn ed-mouse (m input cols rows)
  "Fold a `[:mouse action button row col mods]` event into the model: left-press
selects a pane and moves point to the click (starting a text selection), begins a divider
drag, or grabs a scrollbar; `:drag` extends the text selection (`:text-drag`), resizes the
dragged divider, or scrolls the grabbed scrollbar; `:release` ends any drag; **Ctrl+wheel
zooms** and a **plain wheel scrolls** the pane
**under the pointer** (`ed-wheel-zoom` / `ed-wheel-scroll`), never the active pane. Fields are read positionally (`nth`), not by a fixed-length vector
pattern, so the trailing `mods` element (and any future addition) can't silently
break the match. A wheel notch off every pane is ignored."
  (let (action (nth input 1)
        left? (= (nth input 2) :left)
        row (nth input 3)
        col (nth input 4)
        at (ed-mouse-at input)
        hovered (ed-pane-at m cols rows row col)
        direction (get ed-wheel-directions action)
        ;; a terminal buffer's program may own the pointer (terminal/term-mouse decides)
        programs (and hovered
                   (= (:type (ed-pane-buf m hovered)) :term)
                   (terminal/term-mouse m hovered input)))
    (cond
      programs (ed-mouse-to-program programs action cols rows row col)
      ;; a left-press moves point (`ed-mouse-press`), then a multi-click expands it
      (and left? (= action :press))
        (ed-expand-click (ed-mouse-press m cols rows row col at) (nth input 6 1))
      (and left? (= action :drag)) (ed-left-drag m row col at)
      (= action :release) (ed-end-drags m)
      (or (nil? hovered) (nil? direction)) m
      ;; the 7th element is the wheel's delta in line units
      (includes? (nth input 5 []) :ctrl) (ed-wheel-zoom m hovered direction (nth input 6 nil))
      else (ed-wheel-scroll m hovered direction (nth input 6 nil)))))
