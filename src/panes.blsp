(defmodule panes
  "Pane-layout geometry + mouse-event folding — the `model -> model` operations that
lay the `:layout` tree (`std/pane`) over the screen and fold `[:mouse …]` events into
it. Split out of `model` because this is *event handling* (like `input`/`commands`),
not model field access: it reads the model's `:layout`/`:dragging` and the pool (via
`model/ed-buf-at`) and returns an updated model. The body rect is everything above the
bottom echo row; both the view (`view/ed-view`) and mouse hit-testing lay the tree out
over it, so screen coordinates line up. Pure (data→data)."
  (:use model)  ; ed-buf-at — the pool lookup ed-scroll-pane needs
  (:use editor/buffer)  ; buffer-line-count (scroll clamp)
  (:use editor/highlight)  ; shift-spans — re-base windowed fontify spans to absolute coords
  (:use editor/pane))  ; pane-layout / divider-at / pane-select-at / pane-set-ratio / pane-* ops

;; ---- pane layout (shared geometry: view & hit-testing agree) ----------------

(defn ed-body-layout (m cols rows)
  "The pane layout (`{:panes :dividers}`) over the body rect `[0 0 cols (rows-1)]`
— everything above the bottom echo/minibuffer row. Used by the view and by mouse
hit-testing, so a click maps to the pane the view drew there."
  (pane-layout (get m :layout) [0 0 cols (dec rows)]))

(defn ed-selected-pane (panes)
  "The pane flagged `:selected` (where the cursor goes), or the first as a fallback."
  (let (sel (filter (fn (p) (get p :selected)) panes))
    (if (empty? sel) (first panes) (first sel))))

;; ---- gutter geometry (shared by the view's renderer and mouse hit-testing) --
;; The left line-number gutter's *width* and *shown?* predicate are pure geometry, so
;; they live here with the rest of the pane layout; `view` (which `(:use panes)`) draws
;; the cells (`view/ed-gutter-ops`) and the click handler below maps a cell past the
;; gutter to a buffer column. Both ask the buffer's mode for its `:gutter-width` service.

(defn ed-gutter-shown? (buf pane)
  "Whether the left gutter shows for `pane`: an explicit per-pane `:line-numbers`
(set by C-x l) wins; otherwise it defaults **on** whenever the buffer's mode offers a
`:gutter-width` service (so a text/brood buffer shows line numbers without a toggle)."
  (let (ln (get (get pane :payload) :line-numbers))
    (if (nil? ln) (not (nil? (ed-mode-service buf :gutter-width))) ln)))

(defn ed-gutter-width (buf shown?)
  "Columns the left gutter reserves: the mode's `:gutter-width` service (e.g. the line-
number digit count + a trailing space) when `shown?` and a service exists, else 0 (so
the body fills the pane)."
  (let (gwfn (ed-mode-service buf :gutter-width))
    (if (and shown? (not (nil? gwfn))) (gwfn buf) 0)))

(defn ed-selected-text-rows (m cols rows)
  "The text height of the *selected* pane in BUFFER lines — its rect height less the
mode-line row, divided by the pane's font scale (a zoomed pane shows fewer lines).
What scrolling and paging use, so they're correct inside a split and when zoomed.
At least 1."
  (let (panes (get (ed-body-layout m cols rows) :panes)
        sel (ed-selected-pane panes)
        cells (dec (nth (get sel :rect) 3))  ; rect = [x y w h]; h-1 for the mode line
        s (ed-pane-scale sel))
    (max 1 (quot cells s))))

(defn ed-pane-top (pane buf)
  "The pane's scroll offset, clamped into `buf` — never negative, never past the last
line. A pane's `:top` can outlive the buffer it points at (a `C-x k` remap re-points a
pane to a shorter buffer keeping its scroll; a shared buffer edited shorter in another
pane), and an out-of-range `top` would index past EOF and crash the whole renderer.
Emacs likewise pins scroll at the last line, so clamping here is the right behaviour."
  (max 0 (min (or (get (get pane :payload) :top) 0) (dec (buffer-line-count buf)))))

(defn ed-pane-hscroll (pane)
  "The pane's horizontal scroll offset (leftmost visible char column), 0 if unset."
  (max 0 (or (get (get pane :payload) :hscroll) 0)))

(defn ed-selected-text-cols (m cols rows)
  "The text width (in columns) of the *selected* pane — its rect width less the gutter
and the 1-col scrollbar, divided by the font scale. What horizontal scrolling keeps point
within (matches the width `view/ed-pane-ops` paints the lines into). At least 1."
  (let (panes (get (ed-body-layout m cols rows) :panes)
        sel (ed-selected-pane panes)
        buf (ed-pane-buf m sel)
        [x y w h] (get sel :rect)
        gw (ed-gutter-width buf (ed-gutter-shown? buf sel))
        s (ed-pane-scale sel))
    (max 1 (- (quot (dec w) s) gw))))

(defn ed-pane-vrows (pane)
  "The number of BUFFER lines `pane`'s text area shows: its rect height less the
mode-line row, divided by the pane's font scale (a zoomed pane shows fewer lines). The
single source of the viewport height the fontify window and its cache key are built on
— `view/ed-pane-ops` reads it too, so the cached band always matches what's painted."
  (let ([x y w h] (get pane :rect)
        s (ed-pane-scale pane)
        text-h (max 0 (dec h)))
    (if (= s 1) text-h (max 1 (quot text-h s)))))

;; ---- windowed fontification + a cross-frame span cache ----------------------
;; The view paints syntax colour from the `[start end face]` spans a buffer mode's
;; `:fontify` service produces. Lexing the whole buffer every frame makes a large file
;; crawl, so we lex only the visible window (plus a short lead-in for lexer context).
;; But on its own that still re-lexes on *every* event — even pure cursor motion, a
;; selection drag, a mouse move — because the pure `view` can't remember last frame's
;; result. So the spans are cached on the model (`:span-cache`, one band per pool
;; buffer) and recomputed only when the rope changed (an edit) or the viewport scrolled
;; outside the cached band. Each band is lexed a `ed-fontify-margin` taller than the
;; viewport, so scrolling within it reuses the cache with zero lexing. The rope handle
;; is the change token — an immutable value, fresh on every edit, with O(1) identity
;; equality — so no separate revision counter is needed.

(def ed-fontify-backscan 200)  ; max lines of lead-in above a window for a safe restart
(def ed-fontify-margin 32)  ; lines lexed above & below the viewport, reused on scroll

(defn ed-window-spans (buf fontify restart lo hi)
  "Absolute `[start end face]` syntax spans covering buffer lines `lo`..`hi-1` of `buf`.
Fontifies a rope-slice of those lines (plus an `ed-fontify-backscan`-line lead-in) via
the mode's `fontify` service rather than re-lexing the whole buffer. `restart` — the
mode's optional `:fontify-restart` service (or nil) — pulls the slice start forward to a
column-0 form so head-position context stays correct; the resulting spans are shifted
into absolute coordinates (`highlight/shift-spans`) so the per-line renderer needs no change."
  (let (rope (buffer-rope buf)
        nlines (buffer-line-count buf)
        last-line (min (dec nlines) (dec hi))
        win-line (max 0 (- lo ed-fontify-backscan))
        win-start (rope-line->char rope win-line)
        end-line (inc last-line)
        win-end (if (>= end-line nlines) (buffer-length buf) (rope-line->char rope end-line))
        chunk (rope-slice rope win-start win-end)
        rel (if (nil? restart) 0 (restart chunk (- (rope-line->char rope lo) win-start)))
        base (+ win-start rel)
        src (if (= rel 0) chunk (substring chunk rel (string-length chunk))))
    (shift-spans (fontify src) base)))

(defn ed--band-covers? (entry buf top vrows)
  "True if cached span `entry` still serves a pane showing `buf` at scroll `top` over
`vrows` rows: same rope (no edit since) and its `[blo bhi)` line band contains the
viewport (clamped to EOF, since the last screen rows can sit past the last line)."
  (and (not (nil? entry))
    (= (get entry :rope) (buffer-rope buf))
    (<= (get entry :blo) top)
    (>= (get entry :bhi) (min (buffer-line-count buf) (+ top vrows)))))

(defn ed--band-for (buf fontify restart top vrows)
  "A fresh `:span-cache` entry for `buf`'s viewport `[top, top+vrows)`: spans lexed over
that window widened by `ed-fontify-margin` lines each side (so a later small scroll
reuses it), tagged with the rope and the `[blo bhi)` lines they cover."
  (let (nlines (buffer-line-count buf)
        blo (max 0 (- top ed-fontify-margin))
        bhi (min nlines (+ top vrows ed-fontify-margin)))
    {:rope (buffer-rope buf)
     :blo blo
     :bhi bhi
     :spans (ed-window-spans buf fontify restart blo bhi)}))

(defn ed-pane-spans (m pane buf top vrows)
  "The `[start end face]` syntax spans for `pane`'s viewport — from the model's
`:span-cache` when its band still covers the viewport, else freshly lexed for just the
visible window (the cold/uncovered fallback; `ed-refresh-spans` widens & caches it for
next frame). `nil` when the buffer's mode offers no `:fontify` service."
  (let (fontify (ed-mode-service buf :fontify))
    (if (nil? fontify)
      nil
      (let (bi (get (get pane :payload) :buffer)
            entry (get (get m :span-cache) bi))
        (if (ed--band-covers? entry buf top vrows)
          (get entry :spans)
          (ed-window-spans buf fontify (ed-mode-service buf :fontify-restart) top (+ top vrows)))))))

(defn ed-refresh-spans (m cols rows)
  "Refresh the per-buffer fontify `:span-cache` for every visible pane whose mode has a
`:fontify` service — but only where the cached band no longer covers the pane's viewport
(the rope changed, or it scrolled past the margin). A still-covering band costs nothing.
Keyed by pool buffer index, so two panes on the same buffer share the work; a stale
entry from a killed/re-pointed buffer is harmless (the rope check forces a recompute).
Run by `input/ed-update` after each event so the pure `view` just reads the result."
  (let (panes (get (ed-body-layout m cols rows) :panes))
    (assoc m
      :span-cache
      (fold (fn (cache pane)
              (let (bi (get (get pane :payload) :buffer)
                    buf (ed-buf-at m bi)
                    fontify (ed-mode-service buf :fontify))
                (if (nil? fontify)
                  cache
                  (let (top (ed-pane-top pane buf)
                        vrows (ed-pane-vrows pane))
                    (if (ed--band-covers? (get cache bi) buf top vrows)
                      cache
                      (assoc cache
                        bi
                        (ed--band-for buf fontify (ed-mode-service buf :fontify-restart) top vrows)))))))
        (or (get m :span-cache) {})
        panes))))

;; ---- mouse: select / move-point / scrollbar / drag-resize -------------------

(defn ed-pane-buf (m pane)
  "The buffer shown in `pane` — its payload's `:buffer` pool index, fetched from `m`."
  (ed-buf-at m (get (get pane :payload) :buffer)))

(defn ed-pane-scale (pane)
  "The pane's integer zoom factor (its payload's `:scale`, at least 1)."
  (max 1 (or (get (get pane :payload) :scale) 1)))

(defn ed-scrollbar-hit? (pane buf row col)
  "True if `[row col]` lands on `pane`'s scrollbar: its rightmost column, on a text row
(above the mode line), with the bar shown — `buf` doesn't fit the `vh` text rows (the
same predicate `view/ed-scrollbar-ops` draws under)."
  (let ([px py pw ph] (get pane :rect)
        vh (max 1 (dec ph)))
    (and (= col (+ px (dec pw)))
      (>= row py)
      (< row (+ py vh))
      (> (buffer-line-count buf) vh))))

(defn ed-scrollbar-top-for (buf vh row sy)
  "The pane `:top` for a scrollbar click/drag at screen `row`, on a track of `vh` rows
starting at `sy`: a proportional map — the track top scrolls to 0, the bottom to
`ed-max-top` — clamped into `[0, max-top]`."
  (let (maxtop (ed-max-top buf (max 1 vh))
        rr (max 0 (min (dec vh) (- row sy))))
    (if (<= maxtop 0)
      0
      (max 0 (min maxtop (quot (* maxtop rr) (max 1 (dec vh))))))))

(defn ed-buf-offset-at (buf top hscroll gw s px py row col)
  "The buffer offset under screen cell `[row col]` for a pane at origin `(px, py)`, left
gutter `gw` columns wide, font scale `s`, scrolled to `top` rows / `hscroll` columns — the
inverse of the view's pane geometry (`view/ed-pane-ops` / `ed-cursor`). Line = `top +
(row-py)/s`; column = `hscroll + (col-px)/s - gw`, both clamped (a click past a short
line's end lands at its end, never the next line)."
  (let (line (min (max 0 (dec (buffer-line-count buf)))
               (+ top (quot (max 0 (- row py)) (max 1 s))))
        vcol (quot (max 0 (- col px)) (max 1 s))
        bufcol (max 0 (+ (- vcol gw) hscroll))
        bol (rope-line->char (buffer-rope buf) line)
        lt (buffer-line-at buf line)
        llen (if (ends-with? lt "\n") (dec (string-length lt)) (string-length lt)))
    (+ bol (min bufcol llen))))

(defn ed-mouse-begin-select (m pane buf row col)
  "Left-press in the text area (Emacs `mouse-set-point` + the start of a drag-select):
move point to the clicked cell, clear any prior mark, and arm a text-selection drag
(`:text-drag`, carrying the pane geometry and the click as the region `:anchor`). So a
plain click (press then release, no drag) leaves no region; a drag sets the mark at the
anchor and grows the region to the pointer (`ed-text-drag`). The pane is already
selected, so `buf` is the current buffer; written back via `ed-set-buf`."
  (let ([px py pw ph] (get pane :rect)
        top (or (get (get pane :payload) :top) 0)
        hscroll (ed-pane-hscroll pane)
        s (ed-pane-scale pane)
        gw (ed-gutter-width buf (ed-gutter-shown? buf pane))
        off (ed-buf-offset-at buf top hscroll gw s px py row col))
    (assoc (ed-set-buf m (clear-mark (goto-char buf off)))
      :text-drag
      {:buf (get (get pane :payload) :buffer)
       :rect (get pane :rect)
       :top top
       :hscroll hscroll
       :gw gw
       :scale s
       :anchor off})))

(defn ed-text-drag (m row col)
  "While dragging a text selection (`:text-drag`, armed by a left-press in the text
area), set the mark at the press `:anchor` and move point to the pointer cell — growing
the region that `view/ed-hl-ranges` paints in reverse video. Uses the geometry captured
at press (the buffer can't change mid-drag), so it needs no layout. A no-op when no text
drag is in progress."
  (let (td (get m :text-drag))
    (if (nil? td)
      m
      (let (buf (ed-buf-at m (get td :buf))
            [px py pw ph] (get td :rect)
            ;; read the pane's CURRENT scroll (the dragged pane is the selected one), not
            ;; the press-time top — so as a drag past the edge scrolls (ed--ev-mouse's
            ;; clamp), the pointer keeps mapping to the newly-revealed lines and the
            ;; region keeps growing instead of sticking at the press-time viewport.
            top (ed-current-top m)
            hscroll (ed-current-hscroll m)
            off (ed-buf-offset-at buf top hscroll (get td :gw) (get td :scale) px py row col))
        (ed-set-buf m (assoc (goto-char buf off) :mark (get td :anchor)))))))

(defn ed-mouse-press (m cols rows row col)
  "Left-press at cell `[row col]`. On a divider → begin a resize drag (`:dragging`
carries the split path + the rect to measure the new ratio against). On a pane's
scrollbar → select that pane, scroll it to the clicked position, and arm a scrollbar
drag (`:sb-drag`) so motion keeps scrolling it. Otherwise select the pane under the
pointer and, when the click is in its text area (not the mode line), move point there
and arm a text-selection drag (`ed-mouse-begin-select`)."
  (let (layout (ed-body-layout m cols rows)
        d (divider-at layout [row col])
        pane (pane-at layout [row col]))
    (cond
      (not (nil? d)) (assoc m :dragging d)
      (nil? pane) m
      else (let (buf (ed-pane-buf m pane)
                 [px py pw ph] (get pane :rect)
                 vh (max 1 (dec ph))
                 selected (assoc m :layout (pane-select-at (get m :layout) layout [row col])))
             (cond
               (ed-scrollbar-hit? pane buf row col) (assoc selected
                                                      :layout
                                                      (pane-update-path (get selected :layout)
                                                        (get pane :path)
                                                        (fn (w)
                                                          (assoc w
                                                            :top
                                                            (ed-scrollbar-top-for buf vh row py))))
                                                      :sb-drag
                                                      {:path (get pane :path)
                                                       :sy py
                                                       :vh vh
                                                       :buf (get (get pane :payload) :buffer)})
               (< row (+ py vh)) (ed-mouse-begin-select selected pane buf row col)
               else selected)))))

(defn ed-scrollbar-drag (m row col)
  "While dragging a scrollbar (`:sb-drag` set by `ed-mouse-press`), scroll its pane to
follow the pointer (`ed-scrollbar-top-for`). A no-op if not dragging one."
  (let (sb (get m :sb-drag))
    (if (nil? sb)
      m
      (assoc m
        :layout
        (pane-update-path (get m :layout)
          (get sb :path)
          (fn (w)
            (assoc w
              :top
              (ed-scrollbar-top-for (ed-buf-at m (get sb :buf)) (get sb :vh) row (get sb :sy)))))))))

(defn ed-mouse-drag (m row col)
  "While dragging a divider, set its split's ratio so the boundary follows the
pointer (clamped by `pane-set-ratio` so no pane vanishes). A no-op if not dragging."
  (let (d (get m :dragging))
    (if (nil? d)
      m
      (assoc m
        :layout
        (pane-set-ratio (get m :layout) (get d :path) (pane-ratio-for d [row col]))))))

(def *max-zoom* 6)  ; integer font-scale cap (1 = base; the GUI :scale matches the kernel's gui-font! cap)
(def *wheel-lines* 3)  ; lines a plain wheel notch scrolls

;; ---- mouse wheel acts on the pane UNDER THE POINTER (not the active one) -----
;; A wheel notch zooms / scrolls the pane the cursor is over, like every editor —
;; so it never disturbs which pane is selected. `pane-at` resolves the hovered
;; pane (carrying its `:path`); `pane-update-path` edits exactly that pane's
;; payload. (Divider drag-resize is already hover-targeted in `ed-mouse-press`.)

(defn ed-pane-at (m cols rows row col)
  "The pane under screen cell `[row col]` (`{:path :payload :selected :rect}`), or nil."
  (pane-at (ed-body-layout m cols rows) [row col]))

(defn ed-zoom-pane (m pane delta)
  "Ctrl+mouse-wheel: change the font scale of `pane` (the one under the pointer) by
`delta` levels, clamped to 1..*max-zoom*. Per-pane `:scale` (the view renders it via
the kernel's per-op `:scale` face attr, ADR-079) — only the hovered pane resizes;
selection and every other pane are untouched. The *decision* to zoom on Ctrl+wheel
is editor policy; the kernel supplies only the mechanism (ADR-006)."
  (let (cur (ed-pane-scale pane)
        s (max 1 (min *max-zoom* (+ cur delta))))
    (assoc m
      :layout
      (pane-update-path (get m :layout) (get pane :path) (fn (w) (assoc w :scale s))))))

(defn ed-scroll-pane (m pane delta)
  "Plain mouse-wheel: scroll the *hovered* `pane`'s viewport by `delta` buffer lines,
moving its `:top` — point is left alone (you can scroll freely past the cursor). The next
keystroke brings the cursor back into view via `input/ed--point-into-view`, so the view
doesn't snap when you resume. Negative scrolls toward the top. Clamped at end-of-buffer
(the last line at the bottom row, no scrolling into blank space past EOF — same bound as
the keyboard `ed-scroll`)."
  (let (buf (ed-buf-at m (get (get pane :payload) :buffer))
        top (or (get (get pane :payload) :top) 0)
        [px py pw ph] (or (get pane :rect) [0 0 80 24])
        maxtop (ed-max-top buf (max 1 (dec ph)))
        new-top (max 0 (min maxtop (+ top delta))))
    (assoc m
      :layout
      (pane-update-path (get m :layout) (get pane :path) (fn (w) (assoc w :top new-top))))))

(defn ed-toggle-line-numbers (m)
  "Toggle the left line-number gutter on the *selected pane* (per-pane, like Emacs
`display-line-numbers-mode` but pane-local). The gutter defaults **on** for a buffer
whose mode offers it, so the per-pane `:line-numbers` is an explicit override: this
flips the *effective* state — an unset (nil, default-on) pane goes to `false` (hidden),
an explicit `false` back to `true`. Pure."
  (assoc m
    :layout
    (pane-update-selected (get m :layout)
      (fn (p) (assoc p :line-numbers (= false (get p :line-numbers)))))))

(defn ed--select-word (buf)
  "Select the word at point — mark at its start, point at its end. The double-click
expansion (ADR-102's click count)."
  (let (endb (forward-word buf)
        end (buffer-point endb)
        start (buffer-point (backward-word endb)))
    (assoc (goto-char buf end) :mark start)))

(defn ed--select-line (buf)
  "Select the whole line at point — mark at its start, point at its end. The
triple-click expansion."
  (let (start (buffer-point (beginning-of-line buf))
        end (buffer-point (end-of-line buf)))
    (assoc (goto-char buf end) :mark start)))

(defn ed-mouse (m input cols rows)
  "Fold a `[:mouse action button row col mods]` event into the model: left-press
selects a pane and moves point to the click (starting a text selection), begins a divider
drag, or grabs a scrollbar; `:drag` extends the text selection (`:text-drag`), resizes the
dragged divider, or scrolls the grabbed scrollbar; `:release` ends any drag; **Ctrl+wheel
zooms** and a **plain wheel scrolls** the pane
**under the pointer** (`ed-zoom-pane` / `ed-scroll-pane`, one notch each), never the
active pane. Fields are read positionally (`nth`), not by a fixed-length vector
pattern, so the trailing `mods` element (and any future addition) can't silently
break the match. A wheel notch off every pane is ignored."
  (let (action (nth input 1)
        button (nth input 2)
        row (nth input 3)
        col (nth input 4)
        mods (nth input 5 [])
        hovered (ed-pane-at m cols rows row col))
    (cond
      ;; A left-press moves point (`ed-mouse-press`); a double/triple-click (the trailing
      ;; count, ADR-102) then expands the selection to the word / line at point — but only
      ;; for a text-area click, which is the one that armed `:text-drag`.
      (and (= action :press) (= button :left))
      (let (count (nth input 6 1)
            pressed (ed-mouse-press m cols rows row col))
        (if (and (get pressed :text-drag) (>= count 2))
          (ed-set-buf pressed
            (let (buf (ed-current-buf pressed))
              (if (>= count 3) (ed--select-line buf) (ed--select-word buf))))
          pressed))
      (and (= action :drag) (= button :left)) (cond
                                                (get m :sb-drag) (ed-scrollbar-drag m row col)
                                                (get m :text-drag) (ed-text-drag m row col)
                                                else (ed-mouse-drag m row col))
      (= action :release) (dissoc m :dragging :sb-drag :text-drag)
      (nil? hovered) m
      (and (= action :scroll-up) (includes? mods :ctrl)) (ed-zoom-pane m hovered 1)
      (and (= action :scroll-down) (includes? mods :ctrl)) (ed-zoom-pane m hovered -1)
      (= action :scroll-up) (ed-scroll-pane m hovered (- *wheel-lines*))
      (= action :scroll-down) (ed-scroll-pane m hovered *wheel-lines*)
      else m)))
