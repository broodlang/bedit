(defmodule workings
  "The **workings pane** — the \"show me how it actually ran\" channel, for any buffer that
evaluates regions of itself.

A sandbox reply carries everything the evaluation did — the value it answered, what it
printed, what it cost, and (for a traced region) `:spy` entries that render as an indented
call/return tree. The pane shows all of it for the region the cursor is IN, following it with
no re-evaluation. That is the division of labour with the one-line note beside the code: the
note is what you read while typing, the pane is what you read when the note was not enough —
a value too big for the margin, or three lines of output a note can only show as one.

**Two clients, one pane discipline.** The tutorial (`tutor-workings`, `*Workings*` beside a
lesson's boxes) and the playground (`*Playground Spy*` beside its top-level forms) want
exactly the same behaviour, and it is behaviour with enough judgement in it to be worth
having once:

  - the pane opens only for a reply that HAS a cascade and belongs to the region you are in
    — having something to show is what earns a split, and a region that traced nothing is
    not worth halving the page for;
  - a reply for any other region updates the cache silently, so a background re-eval never
    yanks the view off what you are reading;
  - once open it FOLLOWS you, saying so for the regions that traced nothing;
  - a pane you closed stays closed, latched — because absence alone cannot tell a pane the
    reader dismissed from one that has never opened.

**The spec** each client passes as the first argument names where its state lives and what
its pane is called:

    {:key :playground :buffer \"*Playground Spy*\" :type :playground-spy
     :noun \"form\" :heading \"What ran\"}

`:key` is the model sub-map holding this pane's state — so two panes never collide:

  `:workings`         region index → `{:body <the whole reply, rendered> :traced? bool}`,
                      absent for a region that has never run. Both halves are load-bearing
                      and they are not the same question: `:body` is what the pane SHOWS —
                      the value, what was printed, what it cost, how it got there — and
                      every reply has one; `:traced?` is what earns a SPLIT, and only a real
                      cascade does. Absence is the third state, \"region 3 has not run yet\",
                      which must not read like either.
  `:workings-region`  which region the pane is showing (nil = not shown).
  `:workings-closed?` the reader dismissed it — latched.

**The boundary.** This knows about a *pane*, a *cache* and a region INDEX; it never looks at
the client's buffer, parses a region, or decides which region you are in. The client passes
the index. That is what keeps it acyclic — the client owns its parser, the pane is downstream
of it — and what makes the pane testable from a synthetic reply: no lesson, no playground, no
sandbox, no window."
  (:use model) ; ed-buffer-index-by-name — is the pane on screen?
  (:use commands)) ; ed-show-named-aside — put it beside the page, selection untouched
;; liveeval (the cascade renderer) is referenced qualified below and auto-loads.

(def *unshown*
  ;; A pane's VISIBILITY state, forgotten: not on screen, and not dismissed either. The
  ;; cascade cache is deliberately not part of it — the two resets differ, which is the whole
  ;; reason to name this. A new page clears both; asking for the pane back clears only this
  ;; pair, so the reopen wins against the close latch while the cached cascades it is about
  ;; to show survive.
  {:workings-region nil :workings-closed? false})

(defn- path
  (spec & rest)
  ;; The model path to one of this pane's state slots — `[:playground :workings 3]`.
  (into [(:key spec)] rest))

(defn report (spec m i)
  "Region `i`'s cached report — `{:body <lines as text> :traced? bool}` — or nil when it has
never run."
  (let (v (get-in m (path spec :workings i))) (when (map? v) v)))

(defn cascade (spec m i)
  "Region `i`'s cached report text, but only when it TRACED something — nil when it never ran
and nil when it ran and called nothing of the reader's.

Deliberately narrower than [[report]], because this is the open decision, not the content
one: every reply has a body worth showing once the pane is up, and almost none of them are
worth halving the page for on their own."
  (let (v (report spec m i)) (when (:traced? v) (:body v))))

(defn on-page? (spec m)
  "Whether any region traced something — what makes the pane worth having open at all."
  (any? :traced? (vals (or (get-in m (path spec :workings)) {}))))

(def *rule*
  ;; The hairline between what the cursor is POINTING at and what the region DID — two
  ;; answers to two different questions, on two different clocks, in one pane.
  "────────")

(defn at-point (spec m lines)
  "Remember what the client says the cursor is pointing AT — a list of body lines (a symbol's
documentation, say), or nil for nothing. [[body]] shows it above the region's report.

Kept on the model beside `:workings-region` rather than threaded through `refresh`, because
it changes on a different clock: a report is per REPLY and the pointing is per KEYSTROKE, and
threading the second through the first's call chain would make every caller of `refresh`
carry an argument only one of them can fill in. This module still never looks at a buffer —
the client reads the cursor and hands over lines."
  (assoc-in m (path spec :at-point) lines))

(defn at-point-lines (spec m)
  "What the client last said is under the cursor, or `()`."
  (or (get-in m (path spec :at-point)) '()))

(defn body (spec m i)
  "What the pane should show for region `i` right now: what the cursor is pointing at
([[at-point]]) above everything its reply said, under a heading naming the region — else why
there is nothing. `i` nil means the cursor is not in a region at all.

The pointing goes ABOVE the report because it answers the question you asked by moving there;
the report answers one you asked by typing, and is still underneath when you look back."
  (let (v (when i (report spec m i))
        noun (:noun spec "region")
        heading (:heading spec "The workings")
        at (at-point-lines spec m)
        head (if (empty? at) "" (str (string/join "\n" at) "\n\n" *rule* "\n\n"))
        tail (cond
               (nil? i) (str heading " — put the cursor in a " noun " to see how its code ran.")
               v (str heading " — " noun " " (inc i) ":\n\n" (:body v))
               else
                 (str heading
                   " — "
                   noun
                   " "
                   (inc i)
                   " has not run yet.\n"
                   "Type in it and the calls it makes appear here.")))
    (str head tail)))

(defn forget (spec m stale?)
  "Drop the cached workings of every region `stale?` says is being re-sent — their old
cascades describe code that no longer exists. Everything else keeps its report, because its
reply still stands.

A PREDICATE rather than a cut-off index, because the set being re-sent is not always a
suffix: a client that re-evaluates only the forms an edit could reach (`playground`'s
dependency closure) re-sends a scattered handful, and forgetting the whole tail there would
blank the panes of regions nobody re-ran."
  (assoc-in m
    (path spec :workings)
    (into {}
      (filter (fn (kv) (not (stale? (first kv))))
        (or (get-in m (path spec :workings)) {})))))

(defn refresh (spec m i force)
  "Re-render the pane for region `i`. With `force` it is opened if it isn't there; without,
only an already-open pane is refreshed.

**A pane the reader closed stays closed** — even against `force`, which is otherwise how the
pane first appears. Closing it is a choice, and the next reply must not undo it, so the close
is latched on the model: absence alone cannot tell a pane the reader dismissed from one that
has never opened. [[reopen]] is the way back, and the only thing that clears the latch."
  (let (pane (ed-buffer-index-by-name m (:buffer spec))
        ;; shown before (`:workings-region` set) and gone now = the reader closed it
        closed? (or (get-in m (path spec :workings-closed?))
                  (and (nil? pane) (not (nil? (get-in m (path spec :workings-region))))))
        m1 (assoc-in m (path spec :workings-closed?) closed?))
    (if (and (nil? pane) (or (not force) closed?))
      m1
      (assoc-in (ed-show-named-aside m1 (:buffer spec) (body spec m1 i) (:type spec))
        (path spec :workings-region)
        i))))

(defn show (spec m region-idx at reply &optional (src nil))
  "Cache everything region `region-idx`'s reply said, then refresh the pane for region `at`
(the one at point). Opens the pane only for a reply that TRACED something AND belongs to the
region the reader is in — see the module docstring for why that is the rule.

`src` (the region's source, when the client has it) buys the derived type beside the value;
without it the report is the same minus that line."
  (let (spy (or (:spy reply) ())
        cached (assoc-in m
                 (path spec :workings region-idx)
                 {:body (liveeval/report-text reply src) :traced? (not (empty? spy))}))
    (refresh spec cached at (and (not (empty? spy)) (= region-idx at)))))

(defn follow (spec m i)
  "Keep the pane on region `i` — the `:post-key` half, so a plain motion re-renders from the
cache with no re-evaluation. Only touches the buffer when the region actually changed.

Moving into a region that HAS a cascade opens the pane; moving into one with nothing to show
only refreshes a pane already open. So the pane is where the workings are, and a region that
traced nothing never splits the page on its own."
  (if (= i (get-in m (path spec :workings-region)))
    m
    (refresh spec m i (not (nil? (cascade spec m i))))))

(defn reopen (spec m i)
  "Bring a dismissed pane back on region `i`, clearing the close latch — the only thing that
does. What a client's \"show me the workings\" command calls."
  (refresh spec (update m (:key spec) merge *unshown*) i true))
