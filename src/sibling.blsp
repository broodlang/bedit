(defmodule sibling
  "M-x find-sibling-file (Emacs 29's): the file that belongs with this one — a C source and its
header, a module and its test — by RULES as data, as Emacs's `find-sibling-rules`: each a regex
over the whole path and the templates a sibling's path is made from (`$1` its groups). The init
file's `:find-sibling-rules` are tried first, then the layouts every project here uses. Only a
sibling that exists is offered; several are asked between."
  (:use editor/buffer :only [buffer-file])
  (:use model) ; message / ed-current-buf
  (:use pool) ; ed-find-file / ed-path-list-prompt / ed-default-dir
  (:use interactive)) ; defcommand

(def *default-rules*
  ;; `[pattern template …]`: a path the pattern matches has each template as a sibling. The
  ;; source rules come after the test ones, so a test's own name is never read as a source
  [;; C and C++: a source and its header
    ["^(.*)\\.(c|cc|cpp|cxx)$" "$1.h" "$1.hpp" "$1.hh"]
    ["^(.*)\\.(h|hpp|hh)$" "$1.c" "$1.cc" "$1.cpp" "$1.cxx"]
    ;; Brood: src/ and tests/
    ["^(.*)/tests/(.*)_test\\.blsp$" "$1/src/$2.blsp"]
    ["^(.*)/src/(.*)\\.blsp$" "$1/tests/$2_test.blsp"]
    ;; Elixir: lib/ and test/
    ["^(.*)/test/(.*)_test\\.exs$" "$1/lib/$2.ex"]
    ["^(.*)/lib/(.*)\\.ex$" "$1/test/$2_test.exs"]
    ;; Ruby: lib/ or app/ and spec/ or test/
    ["^(.*)/spec/(.*)_spec\\.rb$" "$1/lib/$2.rb" "$1/app/$2.rb"]
    ["^(.*)/test/(.*)_test\\.rb$" "$1/lib/$2.rb" "$1/app/$2.rb"]
    ["^(.*)/(lib|app)/(.*)\\.rb$" "$1/spec/$3_spec.rb" "$1/test/$3_test.rb"]
    ;; Go: x.go and x_test.go
    ["^(.*)_test\\.go$" "$1.go"]
    ["^(.*)\\.go$" "$1_test.go"]
    ;; Python: x.py and test_x.py, beside it or under tests/
    ["^(.*)/tests/test_([^/]*)\\.py$" "$1/$2.py" "$1/src/$2.py"]
    ["^(.*)/test_([^/]*)\\.py$" "$1/$2.py"]
    ["^(.*)/([^/]*)\\.py$" "$1/test_$2.py" "$1/tests/test_$2.py"]
    ;; JavaScript / TypeScript: x.ts and x.test.ts / x.spec.ts
    ["^(.*)\\.(test|spec)\\.(js|jsx|ts|tsx)$" "$1.$3"]
    ["^(.*)\\.(js|jsx|ts|tsx)$" "$1.test.$2" "$1.spec.$2"]])

(defn sibling-paths (path rules)
  "Every path `rules` make a sibling of `path`, in rule order, none twice and never `path`
itself — whether or not it exists.

    (sibling/sibling-paths \"/p/src/a.c\" [[\"^(.*)\\\\.c$\" \"$1.h\"]])   ;=> [\"/p/src/a.h\"]"
  (vec (seq/distinct (seq/reject (mapcat rules
                                   (fn (rule)
                                     (let (pattern (first rule))
                                       (if (regex/match? pattern path)
                                         (map (rest rule)
                                           (fn (template) (regex/replace pattern path template)))
                                         []))))
                       (fn (candidate) (= candidate path))))))

(defn existing-siblings (m path)
  "The siblings of `path` that exist, by the init file's `:find-sibling-rules` and then
[[*default-rules*]]."
  (seq/filter (sibling-paths path (append (or (:find-sibling-rules m) []) *default-rules*))
    file/exists?))

(defcommand cmd-find-sibling-file
  (m key)
  "Visit the file that belongs with this one (M-x find-sibling-file, Emacs 29's): a C source's
header, a module's test, a test's module — by the rules in [[*default-rules*]] and init.blsp's
`:find-sibling-rules` (`[\"regex\" \"template\" …]`, `$1` the regex's groups). One sibling is
opened; several are asked between; none is said."
  (let (file (buffer-file (ed-current-buf m)))
    (if (nil? file)
      (message m "this buffer visits no file")
      (let (siblings (existing-siblings m file))
        (case (count siblings)
          0 (message m (str "no sibling of " (path/basename file)))
          1 (ed-find-file m (first siblings))
          (assoc m
            :minibuffer (ed-path-list-prompt "Sibling: " siblings ed-find-file (ed-default-dir m))))))))

;; the init file's switch for this feature, declared beside it (config's registry)
(settings/define config/*settings*
  :find-sibling-rules {:default []
   :type 'vector
   :model-key :find-sibling-rules
   :commented? true
   :doc (str "M-x find-sibling-file's own rules, tried before the built-in ones: each\n"
          "[\"regex over the whole path\" \"template\" …], $1 the regex's groups (Emacs find-sibling-rules)")
   :example [["^(.*)/src/(.*)\\.rs$" "$1/tests/$2.rs"]]})
