(defmodule filecoding
  "The two commands that change a file buffer's coding (`charset`): Emacs's C-x RET f, which
says what the next save writes, and C-x RET r, which reads the file again as something else.
How a file reads is a guess (`charset/detect`), and this is what overrules it in any direction:
from one coding to another, from the hex view to text, from text to the hex view."
  (:use editor/buffer) ; buffer-file / buffer-modified? / mark-buffer-modified
  (:use model) ; message / ed-current-buf / ed-set-buf / ed-current-index
  (:use pool) ; ed-name-prompt / ed-reopen-as-text / ed-show-as-hex / ed-revert-handled
  (:use autorevert) ; ed-revert-at
  (:use interactive)) ; defcommand

(def- *hex-view* "hex view")

(defn- ed-file-buffer-prompt (m prompt names then)
  "`m` asking for one of `names`, then `(then model name)`; said instead in a buffer with no
file, which has no coding to change."
  (if (nil? (buffer-file (ed-current-buf m)))
    (message m "this buffer visits no file")
    (assoc m :minibuffer (ed-name-prompt prompt names then))))

(defcommand cmd-set-buffer-file-coding-system
  (m key)
  "Write this file in another coding from the next save on (Emacs's C-x RET f): the text stays
as it is and the buffer is modified, since the file no longer matches it."
  (ed-file-buffer-prompt m
    "Coding for saving: "
    (charset/codings)
    (fn (answered name)
      (let (coding (charset/coding-named name))
        (message (ed-set-buf answered
                   (mark-buffer-modified (charset/with-coding (ed-current-buf answered) coding)))
          (str "the next save writes " (charset/label coding)))))))

(defn- ed-read-as-hex (m)
  "The current buffer's file shown as hex. Unlike a revert this cannot be undone, so a buffer
with unsaved text refuses."
  (let (buffer (ed-current-buf m))
    (cond
      (buffer-modified? buffer) (message m "this buffer has unsaved changes: save or revert first")
      (ed-buffer-handler buffer) (ed-revert-handled m (ed-current-index m) :hex)
      else (ed-show-as-hex m (ed-current-index m) (file/slurp-bytes (or (buffer-file buffer) ""))))))

(defn- ed-read-as (m coding)
  "The current buffer's file read again as `coding`."
  (let (buffer (ed-current-buf m))
    (cond
      (ed-buffer-handler buffer) (ed-revert-handled m (ed-current-index m) coding)
      (= (editor/layers/buffer-type-for buffer) :hexl)
        (ed-reopen-as-text m (or (buffer-file buffer) "") coding)
      else
        (message (ed-revert-at (ed-set-buf m (charset/with-coding buffer coding))
                   (ed-current-index m))
          (str "reverted as " (charset/label coding))))))

(defcommand cmd-revert-buffer-with-coding-system
  (m key)
  "Read this file again as another coding (Emacs's C-x RET r), or as the hex view, for a guess
that was wrong. One undoable edit, as M-x revert-buffer is, but for the hex view, which a
buffer with unsaved text refuses. A file edited as root is read through sudo."
  (ed-file-buffer-prompt m
    "Read file as: "
    (conj (vec (charset/codings)) *hex-view*)
    (fn (answered name)
      (try
        (if (= name *hex-view*)
          (ed-read-as-hex answered)
          (ed-read-as answered (charset/coding-named name)))
        (catch failure (message answered (str "revert failed: " (error-message failure))))))))

;; ---- a file that mixes line endings ------------------------------------------------------
;; A file whose newlines are not all CRLF reads as LF with its CRs kept as text (brood's
;; `eol-decode`, as Emacs reads one), so a save writes every byte back. What it lacked was being
;; SAID: the stray CRs sat in the text unexplained, and nothing put them right.

(def *mixed-eol-max-chars* (* 8 1024 1024))
;; the largest file whose line endings a visit counts: the count reads the whole text once

(defn crlf-count (text)
  "How many lines of `text` end in a carriage return and a newline.

    (filecoding/crlf-count \"a\\r\\nb\\nc\\r\\n\")   ;=> 2"
  (dec (count (string/split text "\r\n"))))

(defn mixed-eol-note (buffer)
  "What a visit says of a file that MIXES line endings — some lines CRLF, read as LF so each
keeps its CR as text — or nil for one that does not (or is too large to count)."
  (when (and (not (= :crlf (:eol buffer))) (<= (buffer-length buffer) *mixed-eol-max-chars*))
    (let (text (buffer-text buffer)
          crlf (crlf-count text))
      (when (> crlf 0)
        (str "mixed line endings: " crlf " CRLF, the rest LF (M-x convert-line-endings)")))))

(defn ed-mixed-eol-visited (m buffer)
  "The visit step: the buffer as it is, and [[mixed-eol-note]] when its file mixes line endings."
  [buffer (mixed-eol-note buffer)])

(register-visit-step :mixed-eol {:order 30 :run 'filecoding/ed-mixed-eol-visited})

(defn converted-eol (buffer eol)
  "`buffer` with every line ending made `eol` (`:lf` or `:crlf`): each CR before a newline taken
out of the text as ONE undoable edit, and the file written with `eol` from the next save on."
  (let (text (buffer-text buffer)
        plain (string/replace text "\r\n" "\n")
        replaced (buffer-replace-text buffer plain)
        with-eol (if (= eol :crlf) (assoc replaced :eol :crlf) (dissoc replaced :eol)))
    (if (and (= plain text) (= (:eol buffer) (:eol with-eol)))
      buffer
      (mark-buffer-modified with-eol))))

(def- *line-ending-names* {"unix (LF)" :lf "dos (CRLF)" :crlf})

(defcommand cmd-convert-line-endings
  (m key)
  "Make every line of this file end the same way (M-x convert-line-endings): asked LF (unix) or
CRLF (dos). A carriage return before a newline leaves the text as one undoable edit, and the
next save writes every line with the ending chosen — what a file that mixes the two needs."
  (if (read-only? (ed-current-buf m))
    (message m "buffer is read-only")
    (assoc m
      :minibuffer
        (ed-name-prompt "Line endings: "
          (vec (keys *line-ending-names*))
          (fn (answered name)
            (let (eol (get *line-ending-names* name))
              (if (nil? eol)
                (message answered (str "no such line ending: " name))
                (message (ed-set-buf answered (converted-eol (ed-current-buf answered) eol))
                  (str "line endings: " name " from the next save")))))))))
