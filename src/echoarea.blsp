(defmodule echoarea
  "The echo area under the bottom mode line, as render ops: the message or eldoc line, the
minibuffer's prompt and candidate list (Plume), and the which-key grid."
  (:use editor/buffer)
  (:use keyhelp) ; key / command labels
  (:use minibuffer)
  (:use model)
  (:use completion) ; the shared vertical-menu renderer + faces
  (:use plume) ; marginalia annotations + the N/M counter
  (:use theme)
  (:use ui-kit)
  (:use whichkey :only []) ; the which-key panel's turned page
  (:use editor/ui :only [ui-memo])
  (:use editor/display) ; text / frect render ops
  (:use conventions :only [*glyphless-chars*])) ; how an invisible character is shown

;; ---- the minibuffer / echo area + the cursor --------------------------------

(defn ed-mb-candidates (minibuffer)
  "A ` {a b c}` label of the matching candidates for a minibuffer that carries a candidate
source (`:rank-source` or `:candidates-fn`), narrowing live as you type; `\"\"` for a
prompt without one. Shown after the input so you see what completion will offer."
  (if (not (mb-source? minibuffer))
    ""
    (let (candidates (mb-candidates minibuffer))
      ; memoized on the input text (minibuffer/mb-candidates)
      (if (empty? candidates) "   {no match}" (str "   {" (string/join candidates " ") "}")))))

(defn- ed-diagnostic-on-line (m buf)
  "The `\"warning: …\"` text of the first cached diagnostic on `buf`'s current line
(a diagnostic's 1-based `:line` maps to the 0-based buffer line), or nil."
  (let (hit (first (get (or (:diag-by-line m) {}) (buffer-current-line buf) '())))
    (when hit (str "warning: " (:message hit)))))

(defn ed-eol-note-on-line (buf)
  "The end-of-line note on `buf`'s current line, in full — the echo-row seat of the
feedback (the gutter shows the glyph, the ghost text may be clipped; here the whole
text fits). Silent once the note is stale: an edited line's old result shouldn't
keep talking."
  (when (not (eolnotes/eol-notes-stale? buf))
    (eolnotes/eol-note-at buf (buffer-current-line buf))))

(defn ed-echo-or-eldoc (m)
  "The echo-row text when no minibuffer is open, by precedence: the latest explicit
`message`; else a **diagnostic on the current line**; else the tutorial note on the
current line (the full verdict/hint for the box at point); else the model's cached
`:eldoc` hint (the current buffer mode's signature for point, e.g. `(map coll f)`,
refreshed by `input/ed-post-step` once per event); else `\"\"`.

A standing one-key QUESTION (a y/n read, a query-replace's y/n/!/./q —
`model/ed-standing-question`) comes before all of them: its prompt stays on the row until
it is answered, with any message that arrived meanwhile after it in brackets."
  (let (question (ed-standing-question m)
        echo (:echo m))
    (cond
      question (ed-with-question-message (:prompt question) (:message question))
      (not (= echo "")) echo
      else
        (let (buf (ed-current-buf m)
              diagnostic (ed-diagnostic-on-line m buf))
          ;; the eldoc hint is cached on the model by `ed-post-step` (computed once per
          ;; event, not re-derived here every frame) — just paint it.
          (or diagnostic (ed-eol-note-on-line buf) (:eldoc m) "")))))

(defn ed-echo-line (m columns rows)
  "The bottom row (`rows-1`): the active minibuffer prompt + input if one is open,
else the latest `message` — or, when idle, the current mode's eldoc hint. A Vertico
prompt shows its candidates as the vertical list above (`ed-mb-candidates-ops`); a
plain prompt (find-file) keeps the inline ` {a b c}` here."
  ;; The prompt sits just below the mode line, at the top of the minibuffer region; the
  ;; Plume candidate list (if any) fills the rows below it (`ed-mb-candidates-ops`). With no
  ;; list the region is one row, so this lands on the last row as before.
  (let (minibuffer (:minibuffer m))
    (text (- rows (ed-echo-rows m rows))
      0
      (if (nil? minibuffer)
        (ed-fit (ed-echo-or-eldoc m) columns)
        ;; clipped by CELLS: the input is laid out (`ed-mb-shown`), a CJK name two cells a glyph
        (ed-fit-cells
          (let (selecting? (:accept-selection minibuffer)
                ;; a Plume prompt leads with the `N/M` candidate counter
                counter (if selecting?
                          (plume-count-label (mb-sel minibuffer) (count (mb-candidates minibuffer)))
                          ""))
            (str counter
              (mb-prompt minibuffer)
              (ed-mb-shown (mb-shown-text minibuffer) (ed-mb-input-col minibuffer))
              (if selecting? "" (ed-mb-candidates minibuffer))
              ;; what the prompt is waiting on (`:status`, its candidates still coming — M-x
              ;; package-install fetching the list), shown until the prompt clears it
              (if (:status minibuffer) (str " [" (:status minibuffer) "]") "")
              ;; a message said while the prompt is open shows after it until the next key
              ;; (`model/message`, Emacs's minibuffer message) rather than replacing it
              (if (:message minibuffer) (str " [" (:message minibuffer) "]") "")))
          columns)))))

(sig ed-mb-shown (string &optional int -> string))
;; check-allow: `binding` runs its body in a thunk whose result the checker does not carry;
;; the body is `string/expand-tabs`, which answers a string
(check-allow :trusted
  (defn ed-mb-shown (input &optional (column 0))
    "Minibuffer `input` LAID OUT as the echo line shows it, from echo column `column` (where the
input begins, [[ed-mb-input-col]]): each tab spanning to its next stop at the tab width in
force (`*tab-width*`), each glyphless character — a zero width space, a bidi control pasted
into a prompt — as its `<200b>` escape (brood ADR-556) unless the editor hides them
(`*glyphless-chars*`), as a buffer shows them. What comes back has no tab or invisible
character left, so its DISPLAY WIDTH is its cells — a CJK glyph two. The echo line, its
caret and its shadow all measure this, so they agree on where the input's characters are.

    (echoarea/ed-mb-shown \"a\\u{200b}b\")   ;=> \"a<200b>b\"
    (echoarea/ed-mb-shown \"a\\tb\")   ;=> \"a       b\""
    (binding (*glyphless-display* *glyphless-chars*) (string/expand-tabs input column))))

(sig ed-mb-input-col (any -> int))
(defn ed-mb-input-col (minibuffer)
  "The echo-row column where `minibuffer`'s INPUT begins: after the `N/M ` counter (a
selection prompt) and the prompt, in display cells — where `ed-echo-line` puts it, the caret
and the shadow measure from."
  (+ (if (:accept-selection minibuffer)
       (string/display-width (plume-count-label (mb-sel minibuffer)
                               (count (mb-candidates minibuffer))))
       0)
    (string/display-width (mb-prompt minibuffer))))

(sig ed-mb-shadow-ops (map int int -> any))
(defn ed-mb-shadow-ops (m columns rows)
  "The prompt's SHADOW: the part of its input that no longer counts, painted dim over the
echo line (Emacs `file-name-shadow-mode`). A prompt declares it with `:shadow-fn`, `(text)
-> index` where the live part begins — a path prompt's `filename/shadow-end`, so in
`~/src//etc/` the `~/src/` dims as soon as the second `/` is typed. `[]` when nothing is
shadowed."
  (let (minibuffer (:minibuffer m)
        end (if (and minibuffer (:shadow-fn minibuffer))
              ((:shadow-fn minibuffer) (mb-text minibuffer))
              0))
    (if (= end 0)
      []
      (let (column (ed-mb-input-col minibuffer))
        (if (>= column columns)
          []
          [(text (- rows (ed-echo-rows m rows))
             column
             (ed-fit-cells (ed-mb-shown (string/substring (mb-text minibuffer) 0 end) column)
               (- columns column))
             face-minibuffer-shadow)])))))

(def ed-plume-style
  ;; the minibuffer list rows: painted by role (ui-ctx palette), the same ui-list widget as
  ;; the popup + menu — but as Vertico draws them: the text flush with the prompt above it
  ;; (no inset) and the selection a flat full-width bar, not a pill floating in the row
  {:fg :on-surface :bg :surface :inset :flush :selection :bar})

(defn- ed-plume-rows (minibuffer values columns width)
  "The `ui-list` rows for the visible candidate `values` in a `width`-wide list: each
labelled by the prompt's `:label-fn` (find-file shows a path's basename, not its full path —
the *value* is what accept opens) and clipped to fit before the right-aligned marginalia
(the column and the gap before it). Plume marginalia: a per-category annotation for each
value, laid out as columns across the rows (`plume-columns`) so the widget's right-aligned
`:key` slot puts EVERY row's marginalia at the same left column and each field under its
own kind (perms / size / mtime; key / doc); nil (no `:key`) when a row has none.

A fuzzy-ranked prompt (`:rank-source`) also marks what the query matched in each label,
one colour per space-separated term (`plume-marks`, carried to the widget as `:marks`), so
`lim ex` shows which word found which part of the path. A prompt that computes its own
candidates is left plain: its text is not necessarily a fuzzy query over them."
  (let (label-of (or (:label-fn minibuffer) (fn (candidate) candidate))
        query (if (:rank-source minibuffer) (mb-text minibuffer) "")
        annotations (plume-columns (map values (fn (value) (plume-annotation minibuffer value)))
                      (plume-annot-room columns))
        annotation-width (if (empty? annotations) 0 (string/display-width (first annotations)))
        label-width (math/max 1
                      (- width (if (= annotation-width 0) 0 (+ annotation-width 2)))))
    (map (seq/zip values annotations)
      (fn ([value annotation])
        (let (label (label-of value))
          {:label (plume-clip label label-width)
           :marks (if (= query "")
                    []
                    (plume-clip-marks label
                      label-width
                      (plume-marks query value label (mb-rank-options minibuffer))))
           :key (if (string/blank? annotation) nil annotation)
           :enabled true})))))

(sig ed-mb-candidates-ops (map int int -> any))
(defn ed-mb-candidates-ops (m columns rows)
  "Plume's vertical candidate list for a minibuffer with `:accept-selection`: the fuzzy
candidates drawn in the rows just above the prompt as a windowed `ui-list` (src/ui-kit.blsp)
INSET by `*plume-inset*`, the `:sel` row a rounded selection pill, each row carrying its
category's marginalia (`plume-annotation`) in the widget's right-aligned `:key` slot when
the prompt declares one (`ed-plume-rows`). `[]` for no minibuffer, a plain prompt, or no
candidates."
  (let (minibuffer (:minibuffer m)
        candidates (if (and minibuffer (:accept-selection minibuffer))
                     (mb-candidates minibuffer)
                     '()))
    (if (empty? candidates)
      []
      (let (visible (dec (ed-echo-rows m rows)) ; reserved rows minus the prompt
            selected (mb-sel minibuffer)
            start (completion-window-start (count candidates) selected visible)
            width (math/max 1 (- columns (* 2 *plume-inset*)))
            window (take (drop candidates start) visible))
        ;; One memoised fragment (ADR-336) on what the rows read: the shown candidates, the
        ;; selection, the size, the query the marks come from, and the prompt's annotation
        ;; context. A row's marginalia is I/O (`file/stat`, the clock) or a reflection
        ;; (`reflect/declared-signature`), and its marks a fuzzy match — per row, so per
        ;; frame they cost a blink frame or a pointer move as much as a keystroke. Asked only
        ;; when the window of candidates moves, a file's age reads as of then.
        ;; check-allow: the thunk's effects are READS (a file's stat, the clock, an annotator
        ;; resolved by name) — skipping them on a turn whose deps are unchanged is the point
        (check-allow :pure
          (ui-memo [:plume]
            [window
              selected
              start
              visible
              rows
              columns
              (if (:rank-source minibuffer) (mb-text minibuffer) "")
              (:category minibuffer)
              (:anno-base minibuffer)
              (:anno-keys minibuffer)
              (:anno-keymap minibuffer)
              (:label-fn minibuffer)
              (:path-of minibuffer)
              (:gui m)
              (ed-palette-token)]
            (fn ()
              (let (widget (ui-list {:items (ed-plume-rows minibuffer window columns width)
                                     :selected selected
                                     :base start
                                     :row (fn (item _index _selected?) item)
                                     :tag :plume-pick
                                     :style ed-plume-style}))
                ;; the list fills the bottom `visible` rows, inset, just below the prompt
                (:ops (widget [*plume-inset* (- rows visible) width visible] (ui-ctx (:gui m))))))))))))

;; `ed-selected-pane` lives in `panes` (this module `(:use panes)`).

(defn ed-mb-caret-text (m minibuffer columns)
  "The text in the minibuffer caret's cell, which a block caret draws over its fill
(brood ADR-515): an input method's composition when one is open (it is painted there), the
input's character at point otherwise, and nil past its end or when the caret was held on
the screen's last column, where the cell shows something else."
  (let (input (mb-shown-text minibuffer)
        input-point (mb-point minibuffer))
    (cond
      ;; a masked read paints no composition: it is the password, half typed
      (and (:preedit m) (:masked minibuffer)) nil
      (:preedit m) (map/get-in m [:preedit :text])
      (>= (ed-mb-point-column minibuffer) columns) nil
      ;; a glyphless character's cell is its escape's first, `<`; a tab's a space; a wide
      ;; glyph is itself
      (< input-point (count input))
        (string/substring (ed-mb-shown (string/substring input input-point (inc input-point)))
          0 1)
      else nil)))

(defn ed-mb-row (m rows)
  "The prompt's row: the first of the echo area, just below the mode line."
  (- rows (ed-echo-rows m rows)))

(sig ed-mb-point-column (any -> int))
(defn- ed-mb-point-column (minibuffer)
  "The echo-row column of `minibuffer`'s point: after the counter and the prompt, and the
CELLS of the input before point as it is laid out ([[ed-mb-shown]] from the input's column — a
CJK glyph two, a tab to its stop, a glyphless character's escape its six), so the caret lands
after the character the echo line painted before it: `Find file: ./日本` puts it after `本`."
  (let (column (ed-mb-input-col minibuffer))
    (+ column
      (string/display-width (ed-mb-shown (string/substring (mb-shown-text minibuffer)
                                           0
                                           (mb-point minibuffer))
                              column)))))

(sig ed-mb-caret-column (any int -> int))
(defn ed-mb-caret-column (minibuffer columns)
  "The column of `minibuffer`'s caret: [[ed-mb-point-column]], kept on the screen."
  (math/min (dec columns) (ed-mb-point-column minibuffer)))

(sig ed-mb-preedit-ops (model int int -> any))
(defn ed-mb-preedit-ops (m columns rows)
  "An input method's composition while a prompt is open, at the prompt's caret — where the
desktop puts the candidate window too (it follows the frame's first caret). Nil without a
prompt or a composition: a buffer pane paints its own at point (`ed-preedit-op`)."
  (let (minibuffer (:minibuffer m))
    (when (and minibuffer (:preedit m) (not (:masked minibuffer)))
      (let (column (ed-mb-caret-column minibuffer columns))
        (list (ed-preedit-op m (ed-mb-row m rows) column (- columns column)))))))

(defn- ed-which-key-rows (keymap)
  "Sorted `\"<key>   <command>\"` rows for the entries of pending sub-keymap `keymap`, the key
column padded to a common width so the command column lines up across rows."
  (let (pairs (%map-pairs keymap)
        key-width (fold pairs
                    0
                    (fn (widest pair)
                      (math/max widest (string/display-width (ed-key-label (first pair)))))))
    (sort (map pairs
            (fn (pair)
              (str (string/pad-right-cells (ed-key-label (first pair)) key-width)
                "   "
                (ed-cmd-label (second pair))))))))

(defn- ed-grid-columns (columns available)
  "The leading `columns` (each a vector of cells) that fit side by side in `available`, each as
`{:cells :width :used :gap}` — its widest cell, the width of the columns before it and the
gap that separates it from them. The first always fits; the first that does not ends the
grid."
  (reverse
    (second
      (seq/reduce-while columns
        [0 '()]
        (fn (state cells)
          (let ([used placed] state
                width (fold cells
                        0
                        (fn (widest cell) (math/max widest (string/display-width cell))))
                gap (if (empty? placed) 0 3)
                end (+ used gap width))
            (if (and (not (empty? placed)) (> end available))
              [:halt state] ; no room for another column
              [:cont [end (cons {:cells cells :width width :used used :gap gap} placed)]])))))))

(defn- ed-grid-row (grid index)
  "Row `index` of the laid-out `grid` (`ed-grid-columns`): each column's `index`th cell (blank past
its end) padded to the column's width, after its gap — the row so far padded to the width
of the columns before it."
  (fold grid
    ""
    (fn (row column)
      (str (string/pad-right-cells row (:used column))
        (string/pad-right "" (:gap column))
        (string/pad-right-cells (nth (:cells column) index "") (:width column))))))

(defn- ed-grid-fitted (grid)
  "How many cells the laid-out `grid` (`ed-grid-columns`) holds."
  (fold grid 0 (fn (total column) (+ total (count (:cells column))))))

(defn- ed-page-label (index total)
  "The last cell of a paged which-key panel: which page this is and the keys that turn it."
  (str "page " index "/" total " · C-h n/p"))

(sig ed-which-key-pages (any any -> (vector vector)))
(defn- ed-which-key-pages (items laid)
  "`items` split into the pages the grid `laid` lays out: one page when they all fit, else
pages each keeping its last cell for the page label. Each page is filled with as many items
as fit beside a label as wide as the widest it could need (`ed-page-label` over the item
count), so the real label always fits."
  (if (>= (ed-grid-fitted (laid items)) (count items))
    [items]
    (let (widest-label (ed-page-label (count items) (count items)))
      (letrec (paginate (fn (remaining pages)
                          (if (empty? remaining)
                            pages
                            (let (fitted (ed-grid-fitted (laid (conj remaining widest-label)))
                                  size (if (> fitted (count remaining))
                                         (count remaining)
                                         (math/max 1 (dec fitted))))
                              (paginate (vec (drop remaining size))
                                (conj pages (vec (take remaining size))))))))
        (paginate (vec items) [])))))

(defn- ed-which-key-columns (items rows-per-column available &optional (page 0))
  "`items` laid out down-then-across in columns of `rows-per-column` rows, as `rows-per-column` (or fewer) row
strings — each column padded to its widest entry plus a gap, columns added while they
fit in `available` (Emacs which-key's grid, `ed-grid-columns`). A prefix with more continuations
than one column holds spreads them across; one with more than the grid holds (`C-x` has 60+
at 80 columns) is split into pages (`ed-which-key-pages`), page `page` shown (it wraps: one
past the last is the first, -1 the last), its last cell saying which page it is
(`page 1/3 · C-h n/p`) — `C-h n` / `C-h p` turn them (`whichkey`)."
  (let (rows-per-column (math/max 1 rows-per-column)
        laid (fn (shown) (ed-grid-columns (seq/chunk-every shown rows-per-column) available))
        pages (ed-which-key-pages items laid)
        index (math/mod page (count pages))
        shown (if (= (count pages) 1)
                items
                (conj (nth pages index) (ed-page-label (inc index) (count pages))))
        grid (laid shown))
    (map (range (math/min rows-per-column (count shown)))
      (fn (index) (string/trim-right (ed-grid-row grid index))))))

(defn ed-which-key-ops (m columns rows)
  "When a prefix chord has been pending past the which-key delay (`:which-key` set by
`model/ed-which-key-reveal`) and no minibuffer/menu is open, the bottom echo area shows
the available next keys and the command each runs (Emacs which-key) — a full-width grid
(`ed-which-key-columns`: down, then across) below the mode line + the pending-chord echo
row, the same shape as Plume's candidate list. `[]` otherwise, so a fast chord (C-x C-f) completes before the panel ever shows."
  (let (keymap (:pending m)
        visible (dec (ed-echo-rows m rows)) ; reserved rows minus the echo row
        window (if (or (nil? keymap) (not (:which-key m)) (:minibuffer m) (:menu m))
                 '()
                 (ed-which-key-columns (ed-which-key-rows keymap)
                   visible
                   columns
                   (whichkey/page m))))
    (if (empty? window)
      []
      ;; the same `ui-list` widget as Plume, full-width with NO selection (`:selected nil`
      ;; ⇒ no pill) — each row is a whole `"<key>   <command>"` label, no marginalia —
      ;; filling the bottom rows, below the echo row
      (let (widget (ui-list {:items window
                             :selected nil
                             :row (fn (label _index _selected?) {:label label :enabled true})
                             :tag :which-key
                             :style ed-plume-style}))
        (:ops (widget [0 (- rows visible) columns visible] (ui-ctx (:gui m))))))))

(defn ed-preedit-op (m row column available)
  "The input method's composition in progress (`:preedit`, brood ADR-441's `[:preedit …]`)
at the cursor's cell, underlined over a raised surface the way a desktop text field shows
one, or nil when there is no room."
  (when (> available 0)
    (text row column (ui-clip (map/get-in m [:preedit :text]) available) face-preedit)))

(register-frame-overlay :minibuffer-list {:rank 10 :run 'echoarea/ed-mb-candidates-ops})
(register-frame-overlay :which-key {:rank 30 :run 'echoarea/ed-which-key-ops})
