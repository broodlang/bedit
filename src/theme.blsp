(defmodule theme
  "The editor's colour theme — one file for every colour the editor paints, so a
re-theme is a single edit rather than a hunt for `{:fg …}` literals through the
renderer. The palette is **Catppuccin Mocha**, the same one `web.blsp`'s
`*web-colors*` maps the named colours to, so the GUI window and the live web
mirror agree.

Colours are `\"#rrggbb\"` hex strings — true colours, not the 16 ANSI keywords —
which the display seam gained in `display.blsp` (a face's `:fg`/`:bg` now accepts
an `[r g b]` vector or a hex string, the language change this UI pass is built on).
That's what lets the chrome read as soft, modern panels instead of the harsh
terminal palette: a solid mode-line bar, a dark completion card, a selection that
*tints* the line (keeping syntax colours) instead of inverting it.

Every `def` here is an ordinary binding — redefine one live with `C-x C-e` to
re-skin the running editor on its next frame (ricing). The syntax-token colours
are applied to the highlighter's `:syntax/*` face registry by `apply-syntax-theme!`
(called from `main`) — see the bottom of this file."
  (:use editor/face)) ; face-set — restyle the highlighter's :syntax/* faces
;; ---- palette (Catppuccin Mocha) ---------------------------------------------
;; https://github.com/catppuccin/catppuccin — the dark "Mocha" flavour.

(defdyn *base* "#1e1e2e") ; the editor background (matches the window's neutral)
(def *mantle* "#181825") ; a step darker — recessed chrome (inactive mode line)
(def *surface0* "#313244") ; raised chrome: the mode-line bar, popup cards
(def *surface1* "#45475a") ; borders + the current-line band
(def *surface2* "#585b70") ; the selection background
(defdyn *overlay0* "#6c7086") ; dim furniture: line numbers, the scrollbar track
(def *overlay1* "#7f849c") ; the scrollbar thumb
(defdyn *text* "#cdd6f4") ; the default foreground
(defdyn *subtext* "#a6adc8") ; secondary text (an inactive mode line)
(defdyn *blue* "#89b4fa") ; the accent (the selected completion row)
(defdyn *mauve* "#cba6f7")
(defdyn *green* "#a6e3a1")
(defdyn *yellow* "#f9e2af") ; the isearch match
(defdyn *peach* "#fab387")
(defdyn *red* "#f38ba8") ; errors (an unmatched bracket)
(defdyn *teal* "#94e2d5") ; the matched bracket pair
;; The sixteen ANSI colours a program in a terminal buffer names by index (src/term.blsp
;; hands them to `vt/screen`), derived from the palette the way Catppuccin maps its own
;; terminal: black is surface1, bright black surface2, white subtext, bright white text,
;; magenta the mauve, cyan the teal, the rest their namesakes — so a theme switch
;; (`theme-apply!`) recolours a running program with everything else.
(defn term-palette-of (p)
  "The terminal's sixteen colours derived from a `role -> hex` palette `p`."
  [(:surface1 p)
    (:red p)
    (:green p)
    (:yellow p)
    (:blue p)
    (:mauve p)
    (:teal p)
    (:subtext p)
    (:surface2 p)
    (:red p)
    (:green p)
    (:yellow p)
    (:blue p)
    (:mauve p)
    (:teal p)
    (:text p)])
(defdyn *term-palette*
  (term-palette-of {:surface1 *surface1*
                    :surface2 *surface2*
                    :red *red*
                    :green *green*
                    :yellow *yellow*
                    :blue *blue*
                    :mauve *mauve*
                    :teal *teal*
                    :subtext *subtext*
                    :text *text*}))
;; ---- defining a chrome face: the formula, once ---------------------------------
;; A face is a formula over the palette, and a theme switch has to re-run it. It used to be
;; written twice — here, and again inside `theme-apply!` — and the copies drifted (issue C3:
;; `:bold` lost from eight faces). `defchrome` defines the face AND registers its formula, so
;; `theme-apply!` re-derives every face from the one place it is written.

(def *chrome-faces* [])
;; `[qualified-symbol thunk]` in definition order — what `theme-apply!` re-runs. Order
;; matters: an alias (`face-divider` is `face-border`) must re-run after what it names.

(defmacro defchrome (name formula)
  "`(def name formula)`, with `formula` registered so a theme switch recomputes it over the
new palette ([[theme-apply!]]). The formula reads the palette vars (`*text*`, `*surface0*`, …)
when it runs, which is what makes one copy enough."
  (let (qualified (symbol (str "theme/" (->string name))))
    `(do
       (def ~name ~formula)
       (def *chrome-faces* (conj *chrome-faces* [(quote ~qualified) (fn () ~formula)])))))

;; ---- semantic chrome faces --------------------------------------------------
;; Names describe the *role*, so a renderer references `face-modeline`, not a
;; colour — restyle the role here and every call site follows.

(defchrome face-modeline {:fg *text* :bg *surface0*}) ; the selected pane's bar
(defchrome face-modeline-inactive {:fg *subtext* :bg *mantle*}) ; an unselected pane's bar
;; A status-bar *segment* hover: the bar lightens one surface step under the pointer — a
;; bordered, inset **block** over the segment (Emacs `mouse-face` with a crisp edge), floated
;; within the bar with breathing room; the terminal falls back to a flat bg band (no border).
;; Surfaces + hairlines, no shadow (docs/ui-chrome.md). Border is one step lighter than the
;; fill so it reads as a rim, not a shadow.
(defchrome face-modeline-hover {:bg *surface1*}) ; the hover block fill
(defchrome face-modeline-hover-border {:bg *surface2*}) ; its hairline edge (a step lighter → a rim)
(defchrome face-region {:bg *surface2*}) ; selection: tint, keep syntax fg
(defchrome face-hl-line {:bg *surface0*}) ; the current line (no region)
(defchrome face-bracket-match {:fg *base* :bg *teal* :bold true}) ; the OTHER end of the pair
(defchrome face-bracket-here {:fg *teal* :underline true :bold true}) ; the end AT point (the cursor marks it; keep the glyph visible)
(defchrome face-bracket-error {:fg *red* :bold true}) ; a lone unmatched bracket
(defchrome face-scrollbar-thumb {:bg *overlay1*}) ; the overlay thumb: a filled pill (frect :bg)
;; The default chrome border token — a hairline (≈1px) in `*surface1*`. Dark-UI elevation is
;; carried by surface steps + hairline borders, NOT shadows (shadows vanish on a dark bg), and
;; `*surface1*` is our Radix-“step 6” divider colour. Used for the pane seam and the status-bar
;; top rule; see docs/ui-chrome.md.
(defchrome face-border {:bg *surface1*})
(defchrome face-divider face-border) ; the seam between panes — a hairline border
(defchrome face-gutter-bg {:bg *mantle*}) ; the line-number gutter's recessed background (no border, just a surface step)
(defchrome face-gutter-line {:fg *overlay0*}) ; dim line numbers
(defchrome face-isearch {:fg *base* :bg *yellow*}) ; an incremental-search hit
(defchrome face-activity {:fg *blue*}) ; the status-bar spinner while a job runs off the loop
;; the floating menu / completion card (in-buffer popup, minibuffer list, context menu)
(defchrome face-popup {:fg *text* :bg *surface0*}) ; an unselected row
(defchrome face-popup-selected {:fg *base* :bg *blue* :bold true}) ; the selection
(defchrome face-popup-border {:bg *surface1*}) ; the card frame (1-cell, lighter)
;; Plume's candidate list now renders through the shared `ui-list` widget (src/ui-kit.blsp),
;; styled by the ui-ctx semantic roles (:on-surface / :muted / :selection / :on-selection) —
;; the same palette as the completion popup and the context menu — so no Plume-specific row
;; faces live here any more.

;; a tooltip (the hover hint over a status-bar segment): the popup surface, a hairline
;; border for legibility over arbitrary content, its own dim-then-text fg.
;; (The git status-bar segment faces live in src/git.blsp — like its diff `git-face-*` —
;; built from these colour tokens, since git reaches the palette via `require`.)
(defchrome face-tooltip face-popup) ; the tooltip card surface
(defchrome face-tooltip-fg {:fg *text*}) ; the tooltip text
(defchrome face-tooltip-border face-border) ; the tooltip's hairline edge
;; ---- dired (the directory browser) ------------------------------------------
;; The `ls -l`-style directory listing (commands/dired-fontify) paints each row's
;; columns with these (diredfl-style) — so dired re-skins from here like the rest of
;; the chrome. Directory names lead in the blue accent (bold), symlinks in teal
;; (italic), executables in green; the permission string, owner/group/nlink/size
;; recede in the dim furniture colour, the date a touch warmer; a marked row's `*`
;; flag burns peach. The header path is the mauve accent, bold.

(defchrome face-dired-dir {:fg *blue* :bold true}) ; a directory name
(defchrome face-dired-symlink {:fg *teal* :italic true}) ; a symlink name
(defchrome face-dired-exec {:fg *green* :bold true}) ; an executable file name
(defchrome face-dired-file {:fg *text*}) ; a regular file name
(defchrome face-dired-perms {:fg *subtext*}) ; the rwx permission string
(defchrome face-dired-size {:fg *overlay0*}) ; nlink / owner / group / size (dim)
(defchrome face-dired-date {:fg *peach*}) ; the mtime column
(defchrome face-dired-header {:fg *mauve* :bold true}) ; the directory-path header line
(defchrome face-dired-mark {:fg *peach* :bold true}) ; a marked row's `*` flag
(defchrome face-dired-flag {:fg *red* :bold true}) ; a row flagged for deletion — its `D`
;; ---- syntax-token colours (the highlighter's :syntax/* registry) ------------
;; The Brood highlighter (std/editor/highlight.blsp) resolves each token through a
;; `:syntax/*` face in the shared registry, defaulting to the terminal-ANSI keywords
;; (:magenta, :cyan, …). `apply-syntax-theme!` overrides those with the palette above
;; so .blsp buffers fontify in soft RGB to match the chrome — without touching the
;; defaults the REPL / observer use. Live-bound: the view re-lexes each frame, so this
;; re-skins a running editor immediately (and a `(face-set …)` at the REPL re-skins it
;; live too).

;; ---- calling into the GUI backend, loudly -----------------------------------
(defn gui-only (f & args)
  "Call the `gui/*` function VALUE `f` with `args`; nil when this runtime was built without
a GUI backend (`gui/available?`), and every error raised. The only thing this guards is the
missing backend — a headless test run, a `*term-display*` session. It takes the function,
not a form, so a stale name (`gui/font!` after ADR-302 dropped the bang) fails at the
reference, where a `(check-allow :discarded-catch (try (gui/font! …) (catch e nil)))` used to swallow the unbound symbol and
leave the editor silently unfonted, untitled and without a clipboard."
  (when (gui/available?) (apply f args)))

(defn apply-syntax-theme! ()
  "Restyle the highlighter's `:syntax/*` faces to the editor palette. Called once at
startup (`main`). Pure-model tests build via `ed-init` and never call this, so they
keep the keyword defaults — asserting faces without the live theme."
  (face-set :syntax/comment {:fg *overlay0* :italic true}) ; dim, italic
  (face-set :syntax/string {:fg *green*})
  ;; A DOCSTRING, not a string value — prose about the definition, so it reads
  ;; like prose: lighter than a comment, clearly not the `*green*` of a value a
  ;; function returns (`(defn greeting () "Doc." "hello mylife")` colours the two
  ;; strings apart, which is the whole point).
  (face-set :syntax/doc {:fg *subtext* :italic true})
  (face-set :syntax/number {:fg *peach*})
  (face-set :syntax/keyword {:fg *yellow*}) ; literal :keywords
  (face-set :syntax/special {:fg *mauve*}) ; special forms (def/fn/let/if) — colour, no bold weight
  (face-set :syntax/function {:fg *blue*}) ; a call head
  (face-set :syntax/error {:fg *red* :bold true})) ; a lone unmatched bracket
;; ---- live theme switching (M-x theme-select) --------------------------------
;; A theme is a PALETTE — a `role -> "#rrggbb"` map over the 16 tokens above. `theme-apply!`
;; rebinds every palette var to the new colours (runtime `def`, the ricing mechanism) and
;; re-derives every chrome face + the syntax colours from them, then repaints the window
;; background. The palette vars above are Catppuccin Mocha, the default; a face's formula is
;; written once, in its `defchrome`, and `theme-apply!` re-runs it — add a face there and a
;; theme switch already knows it.

(def *theme-mocha*
  {:base "#1e1e2e"
   :mantle "#181825"
   :surface0 "#313244"
   :surface1 "#45475a"
   :surface2 "#585b70"
   :overlay0 "#6c7086"
   :overlay1 "#7f849c"
   :text "#cdd6f4"
   :subtext "#a6adc8"
   :blue "#89b4fa"
   :mauve "#cba6f7"
   :green "#a6e3a1"
   :yellow "#f9e2af"
   :peach "#fab387"
   :red "#f38ba8"
   :teal "#94e2d5"})

(defn theme-apply! (p)
  "Swap the whole palette to `p` (a `role -> hex` map) live: rebind every palette var, re-derive
every chrome face + the `:syntax/*` colours from them, and repaint the window background
(`gui/bg`, via `gui-only`). The ui-kit widgets re-skin for free (their `ui-ctx` reads the palette each
frame). Returns nil."
  ;; palette
  (def *base* (:base p))
  (def *mantle* (:mantle p))
  (def *surface0* (:surface0 p))
  (def *surface1* (:surface1 p))
  (def *surface2* (:surface2 p))
  (def *overlay0* (:overlay0 p))
  (def *overlay1* (:overlay1 p))
  (def *text* (:text p))
  (def *subtext* (:subtext p))
  (def *blue* (:blue p))
  (def *mauve* (:mauve p))
  (def *green* (:green p))
  (def *yellow* (:yellow p))
  (def *peach* (:peach p))
  (def *red* (:red p))
  (def *teal* (:teal p))
  (def *term-palette* (term-palette-of p))
  ;; chrome faces — every `defchrome` formula re-run over the new palette, in the order they
  ;; were defined (so an alias follows what it names)
  (doseq (entry *chrome-faces*)
    (let ([qualified formula] entry) (reflect/eval (list 'def qualified (formula)))))
  ;; syntax registry + the window background
  (apply-syntax-theme!)
  (gui-only gui/bg *base*)
  nil)

;; ---- the ui-kit render context (semantic role → palette) --------------------
;; src/ui-kit.blsp is theme-agnostic: a widget styles by SEMANTIC ROLE and the caller
;; supplies the role→colour map. This is that map for our palette — the one place the
;; kit's roles bind to Catppuccin, shared by every kit consumer (the context menu, the
;; completion popup, Plume, which-key). Read every frame, so re-`def`-ing a palette var
;; live re-skins all of them at once.

(defn ui-ctx (gui?)
  "The `ui-kit` render context for a `gui?` flag: `{:gui? … :theme <role→colour>}`, the
editor palette mapped onto the kit's semantic roles. `gui?` (the model's `:gui`) picks the
rounded sub-cell lowering over the flat terminal one."
  {:gui? gui?
   :theme {:surface *surface0*
           :on-surface *text*
           :muted *subtext*
           ;; A third weight below `:muted`, for a column that is a HINT rather than
           ;; content — a menu's shortcut keys. Without it a shortcut and a disabled label
           ;; were the same colour, so `Cut` being unavailable looked exactly like `C-w`
           ;; being a reminder, and the only thing telling them apart was which column
           ;; they were in.
           :faint *overlay0*
           :selection *blue*
           :on-selection *base*
           :border *surface1*}})
