(defmodule theme
  "The editor's colour theme — one file for every colour the editor paints, so a
re-theme is a single edit rather than a hunt for `{:fg …}` literals through the
renderer. The default palette is **Catppuccin Mocha**, the one `web.blsp`'s
`*web-colors*` maps the named colours to, so the GUI window and the live web
mirror agree.

Colours are `\"#rrggbb\"` hex strings — true colours, not the 16 ANSI keywords — so the
chrome reads as soft panels: a recessed mode line, a dark completion card, a selection that
*tints* the line (keeping syntax colours) instead of inverting it.

Every palette var is an ordinary binding — redefine one live with `C-x C-e` to re-skin the
running editor on its next frame. A chrome face is a `defchrome` formula over the palette,
re-derived on every theme switch (`theme-apply!`); the syntax-token colours go to the
highlighter's `:syntax/*` face registry through `apply-syntax-theme!`."
  (:use editor/face)) ; face-set — restyle the highlighter's :syntax/* faces
;; ---- palette (Catppuccin Mocha) ---------------------------------------------
;; https://github.com/catppuccin/catppuccin — the dark "Mocha" flavour.

(defdyn *base* "#1e1e2e") ; the editor background (matches the window's neutral)
(def *mantle* "#181825") ; a step darker — recessed chrome: the mode line, the header line
(def *surface0* "#313244") ; raised chrome: popup cards
(def *surface1* "#45475a") ; borders + the current-line band
(def *surface2* "#585b70") ; the third surface step (a hover rim)
(defdyn *overlay0* "#6c7086") ; decorative furniture: a truncation mark, a shadowed path
(def *overlay1* "#7f849c") ; the scrollbar thumb, line numbers
(defdyn *overlay2* "#9399b2") ; the grey a selection is tinted from
(defdyn *text* "#cdd6f4") ; the default foreground
(defdyn *subtext1* "#bac2de") ; primary chrome text, a step under the code
(defdyn *subtext* "#a6adc8") ; secondary text (Catppuccin subtext0): the mode line, the header line
(defdyn *lavender* "#b4befe") ; the current line's number (Catppuccin's "you are here")
(defdyn *blue* "#89b4fa") ; the accent (the selected completion row)
(defdyn *mauve* "#cba6f7")
(defdyn *green* "#a6e3a1")
(defdyn *yellow* "#f9e2af") ; the isearch match
(defdyn *peach* "#fab387")
(defdyn *red* "#f38ba8") ; errors (an unmatched bracket)
(defdyn *teal* "#94e2d5") ; the matched bracket pair
;; Three roles a palette MAY name, each defaulting to one it must (`theme-apply!`): the
;; selected row of a list or menu and the text on it (Catppuccin: the accent with the
;; background on it; modus: a muted violet band with white on it), and the caret.
(def *selection* *blue*)
(def *on-selection* *base*)
(def *cursor* *text*)

;; ---- text-emphasis tiers ------------------------------------------------------
;; Every chrome face names a TIER, not a palette grey, so "make the chrome quieter" is one
;; edit here and every theme inherits the hierarchy. The tiers are APCA contrast bands
;; (git.apcacontrast.com, "APCA in a Nutshell"), measured against the editor background or
;; the mantle the chrome sits on — tests/theme_contrast_test.blsp holds every registered
;; theme to them:
;;
;;   code         Lc >= 75   the buffer's text                        text
;;   chrome       Lc >= 60   chrome you read: a state, a name         subtext1
;;   chrome-dim   Lc >= 45   the mode line, the header line           subtext (subtext0)
;;   tertiary     Lc >= 30   line numbers, an inactive mode line      overlay1
;;   decor        Lc >= 15   a truncation mark, a separator           overlay0
;;
;; A palette may name any tier itself (`:fg-tertiary`), as Modus does: its line numbers are a
;; grey brighter than its border grey, the reverse of Catppuccin's ladder ([[tiers-of]]).
(def *fg-code* *text*)
(def *fg-chrome* *subtext1*)
(def *fg-chrome-dim* *subtext*)
(def *fg-tertiary* *overlay1*)
(def *fg-decor* *overlay0*)

(defn- hex-channel (color i)
  "Channel `i` (0 red, 1 green, 2 blue) of a `#rrggbb` colour, 0-255; 0 for one that is not hex."
  (let (value (string/->number (string/substring color (+ 1 (* 2 i)) (+ 3 (* 2 i))) 16))
    (if (int? value) value 0)))

(defn mix (color other weight)
  "`color` blended over `other`, `weight` (0..1) of the first — a tint derived from the
palette, so a theme switch re-derives it: a diff's added-line background is the green
faintly over the editor background.

    (theme/mix \"#ffffff\" \"#000000\" 0.5)   ;=> \"#808080\""
  (str "#"
    (string/join (map (range 3)
                   (fn (i)
                     (let (value (math/round (+ (* weight (hex-channel color i))
                                               (* (- 1 weight) (hex-channel other i)))))
                       (string/pad-left (string/number-> value 16) 2 "0"))))
      "")))

(defn palette-complete (p)
  "The palette `p` with every role the theme may leave out filled in from the ones it must
name: `:subtext1` halfway from `:subtext` to `:text`, `:overlay2` halfway from `:overlay1` to
`:subtext`, `:lavender` the `:blue` accent. Every bundled theme names all three; a plugin's
theme written before they existed still gets a coherent ladder.

    (:subtext1 (theme/palette-complete {:text \"#ffffff\" :subtext \"#000000\" :overlay1 \"#000000\" :blue \"#0000ff\"}))   ;=> \"#808080\""
  (assoc p
    :subtext1 (or (:subtext1 p) (mix (:text p) (:subtext p) 0.5))
    :overlay2 (or (:overlay2 p) (mix (:subtext p) (:overlay1 p) 0.5))
    :lavender (or (:lavender p) (:blue p))))

(defn tiers-of (p)
  "The text-emphasis tiers (`*fg-code*` … `*fg-decor*`) for the palette `p`: each the role
the tier table names, unless `p` names the tier itself (`:fg-tertiary`).

    (:fg-tertiary (theme/tiers-of (assoc theme/*theme-mocha* :fg-tertiary \"#989898\")))   ;=> \"#989898\""
  (let (complete (palette-complete p))
    {:fg-code (or (:fg-code p) (:text complete))
     :fg-chrome (or (:fg-chrome p) (:subtext1 complete))
     :fg-chrome-dim (or (:fg-chrome-dim p) (:subtext complete))
     :fg-tertiary (or (:fg-tertiary p) (:overlay1 complete))
     :fg-decor (or (:fg-decor p) (:overlay0 complete))}))

;; ---- contrast: WCAG 2 ratio and APCA lightness contrast --------------------------
;; Generic colour arithmetic, kept here until a second caller wants it in brood's std (a
;; terminal's minimum-contrast option, kitty's `text_fg_override_threshold`, is the one in
;; view). The theme contrast test reads it.

(defn- channel-fraction (color i) (/ (hex-channel color i) 255.0))

(defn- real-pow (x exponent)
  ;; x^exponent for a real exponent (`math/pow` takes integers only); 0 for x = 0
  (if (<= x 0) 0.0 (math/exp (* exponent (math/ln x)))))

(defn- wcag-luminance (color)
  ;; WCAG 2.x relative luminance: sRGB linearised with the piecewise curve
  (let (linear (fn (c)
                 (if (<= c 0.04045) (/ c 12.92) (real-pow (/ (+ c 0.055) 1.055) 2.4))))
    (+ (* 0.2126 (linear (channel-fraction color 0)))
      (* 0.7152 (linear (channel-fraction color 1)))
      (* 0.0722 (linear (channel-fraction color 2))))))

(defn wcag-ratio (fg bg)
  "The WCAG 2.x contrast ratio of two `#rrggbb` colours, 1.0 to 21.0, whichever is lighter.

    (math/round (theme/wcag-ratio \"#ffffff\" \"#000000\"))   ;=> 21"
  (let (a (wcag-luminance fg)
        b (wcag-luminance bg))
    (/ (+ (math/max a b) 0.05) (+ (math/min a b) 0.05))))

(defn- apca-luminance (color)
  ;; APCA's screen luminance Y: a simple 2.4 power per channel, then the black soft clamp
  (let (y (+ (* 0.2126729 (real-pow (channel-fraction color 0) 2.4))
            (* 0.7151522 (real-pow (channel-fraction color 1) 2.4))
            (* 0.0721750 (real-pow (channel-fraction color 2) 2.4))))
    (if (> y 0.022) y (+ y (real-pow (- 0.022 y) 1.414)))))

(defn apca-lc (fg bg)
  "The APCA lightness contrast Lc of text `fg` on background `bg` (both `#rrggbb`), APCA
0.0.98G-4g: positive for dark text on a light background, NEGATIVE for light text on a dark
one, 0 below the low clip. Its magnitude is what the tier floors are written in (Lc 75 body
text, 60 content text, 45 large text, 30 any text, 15 a discernible divider).

    (math/round (theme/apca-lc \"#000000\" \"#ffffff\"))   ;=> 106
    (math/round (theme/apca-lc \"#ffffff\" \"#000000\"))   ;=> -108"
  (let (text-y (apca-luminance fg)
        background-y (apca-luminance bg))
    (if (> background-y text-y)
      (let (s (* 1.14 (- (real-pow background-y 0.56) (real-pow text-y 0.57))))
        (if (< s 0.1) 0.0 (* 100 (- s 0.027))))
      (let (s (* 1.14 (- (real-pow background-y 0.65) (real-pow text-y 0.62))))
        (if (> s -0.1) 0.0 (* 100 (+ s 0.027)))))))

;; The sixteen ANSI colours a program in a terminal buffer names by index (src/terminal.blsp
;; hands them to `vt/screen`), derived from the palette the way Catppuccin maps its own
;; terminal: black is surface1, bright black surface2, white subtext, bright white text,
;; magenta the mauve, cyan the teal, the rest their namesakes — so a theme switch
;; (`theme-apply!`) recolours a running program with everything else.
(defn- term-palette-of (p)
  "The terminal's sixteen colours derived from a `role -> hex` palette `p`."
  [(:surface1 p)
    (:red p)
    (:green p)
    (:yellow p)
    (:blue p)
    (:mauve p)
    (:teal p)
    (:subtext p)
    (:surface2 p)
    (:red p)
    (:green p)
    (:yellow p)
    (:blue p)
    (:mauve p)
    (:teal p)
    (:text p)])
(defdyn *term-palette*
  (term-palette-of {:surface1 *surface1*
                    :surface2 *surface2*
                    :red *red*
                    :green *green*
                    :yellow *yellow*
                    :blue *blue*
                    :mauve *mauve*
                    :teal *teal*
                    :subtext *subtext*
                    :text *text*}))
(defn ansi-palette ()
  "How a program's SGR colours look, as `ansi/face` takes them: the theme's sixteen ANSI
colours, and its text / background for inverse video. A terminal buffer's screen and the
coloured output of a build or a shell (src/ansicolor.blsp) both read it."
  {:colors *term-palette* :fg *text* :bg *base*})

;; ---- defining a chrome face: the formula, once ---------------------------------
;; A face is a formula over the palette, and a theme switch has to re-run it. `defchrome`
;; defines the face AND registers its formula, so `theme-apply!` re-derives every face from
;; the one place it is written.
;;
;; The formulas are a std `registry` table (`:theme/chrome-faces`, qualified symbol ->
;; `{:formula thunk :rank n}`): modules load in parallel (brood ADR-426), and `registry/put`
;; is one locked write, where modules conj-ing onto one global would drop each other's faces.
;;
;; An alias (`face-divider` is `face-border`) must re-run after what it names, and across
;; parallel loads definition order says nothing, so the order is the RANK — 0 for a face
;; computed from the palette, 1 for one that IS another face (its formula a bare name).

(defn chrome-faces ()
  "Every registered chrome face as `[qualified-symbol thunk]`, in the order `theme-apply!`
re-runs them: palette faces first, then the aliases over them."
  (map (registry/ranked :theme/chrome-faces) (fn ([qualified entry]) [qualified (:formula entry)])))

(defmacro defchrome (name formula)
  "`(def name formula)`, with `formula` registered so a theme switch recomputes it over the
new palette ([[theme-apply!]]). The formula reads the palette vars (`*text*`, `*surface0*`, …)
when it runs, which is what makes one copy enough.

Usable from any module (`(theme/defchrome grep-face-file {:fg *blue*})`): the face is named
in the namespace that defines it, and registered here, so a theme switch repaints a feature's
own colours with everything else."
  (let (ns (reflect/current-ns)
        qualified (if ns (symbol (str (->string ns) "/" (->string name))) name))
    `(do
       (def ~name ~formula)
       (ownership/claim! :theme/chrome-faces
         (quote ~qualified)
         {:formula (fn () ~formula) :rank ~(if (symbol? formula) 1 0)}))))

;; ---- semantic chrome faces --------------------------------------------------
;; Names describe the *role*, so a renderer references `face-modeline`, not a
;; colour — restyle the role here and every call site follows.

;; The mode line is RECESSED chrome, as the header line is: secondary-tier text on the mantle,
;; a step darker than the code, no bold. Brightness and colour are kept for what the bar has
;; to SAY — the buffer's name in the code's own colour, and an accent for a state (a modified
;; buffer, a macro being recorded, a failing check). An unselected pane's bar is a tier quieter.
(defchrome face-modeline {:fg *fg-chrome-dim* :bg *mantle*}) ; the selected pane's bar
(defchrome face-modeline-inactive {:fg *fg-tertiary* :bg *mantle*}) ; an unselected pane's bar
(defchrome face-modeline-name {:fg *fg-code*}) ; the selected pane's buffer name
(defchrome face-modeline-state {:fg *peach*}) ; a state the bar reports: modified, recording
;; The hairlines that rule the bar off from the text. The bar's own colour by default, so they
;; vanish into it (Modus's recipe: a border equal to the background); a theme whose mode line
;; is boxed (Modus itself) names a colour for them.
(defchrome face-modeline-rule {:bg *mantle*})
;; A status-bar *segment* hover: the bar lightens one surface step under the pointer — a
;; bordered, inset **block** over the segment (Emacs `mouse-face` with a crisp edge), floated
;; within the bar with breathing room; the terminal falls back to a flat bg band (no border).
;; Surfaces + hairlines, no shadow (docs/ui-chrome.md). Border is one step lighter than the
;; fill so it reads as a rim, not a shadow.
(defchrome face-modeline-hover {:bg *surface0*}) ; the hover block fill
(defchrome face-modeline-hover-border {:bg *surface1*}) ; its hairline edge (a step lighter → a rim)
;; The selection, the search's other matches and its current match must read as three
;; different things. The region is overlay2 at 25% over the background (Catppuccin's
;; selection: Overlay 2 at 20-30%), the other matches a teal tint (a hue, not a grey, so they
;; are told from the region), the current match the solid yellow fill. Tints keep the syntax
;; colours on top of them.
(defchrome face-region {:bg (mix *overlay2* *base* 0.25)}) ; selection: tint, keep syntax fg
(defchrome face-hl-line {:bg *surface0*}) ; the current line (no region)
(defchrome face-bracket-match {:fg *base* :bg *teal* :bold true}) ; the OTHER end of the pair
(defchrome face-bracket-here {:fg *teal* :underline true :bold true}) ; the end AT point (the cursor marks it; keep the glyph visible)
(defchrome face-bracket-error {:fg *red* :bold true}) ; a lone unmatched bracket
(defchrome face-preedit {:fg *text* :bg *surface1* :underline true}) ; an input method's composition at point, not yet inserted
(defchrome face-scrollbar-thumb {:bg *overlay1*}) ; the overlay thumb: a filled pill (frect :bg)
;; The default chrome border token — a hairline (≈1px) in `*surface1*`. Dark-UI elevation is
;; carried by surface steps + hairline borders, NOT shadows (shadows vanish on a dark bg), and
;; `*surface1*` is our Radix-“step 6” divider colour. Used for the pane seam and the floating
;; cards' edges (the mode line's rules are `face-modeline-rule`); see docs/ui-chrome.md.
(defchrome face-border {:bg *surface1*})
(defchrome face-divider face-border) ; the seam between panes — a hairline border
;; The gutter is the editor's own background, as VS Code's, Zed's and Modus's are: a mantle
;; gutter under a mantle header line framed the code in an L of chrome. Only the numbers are
;; dim, and the current line's is lavender — Catppuccin's "you are here".
(defchrome face-gutter-bg {:bg *base*}) ; the line-number gutter's background
(defchrome face-gutter-line {:fg *fg-tertiary*}) ; line numbers
(defchrome face-gutter-line-current {:fg *lavender*}) ; the current line's number
(defchrome face-truncation {:fg *fg-decor*}) ; the ellipsis ending a truncated line (Emacs's `truncation` fringe mark, as text)
(defchrome face-isearch {:fg *base* :bg *yellow*}) ; an incremental-search hit
(defchrome face-isearch-lazy {:bg (mix *teal* *base* 0.25)}) ; every OTHER match in the window (Emacs lazy-highlight)
;; what a match becomes, shown after it while query-replace's replacement is typed
(defchrome face-qr-preview {:fg *green* :bg (mix *green* *base* 0.2)})
;; the part of a typed path a later `//` or `/~/` overrode (Emacs file-name-shadow)
(defchrome face-minibuffer-shadow {:fg *fg-decor*})
(defchrome face-activity {:fg *blue*}) ; the status-bar spinner while a job runs off the loop
;; the floating menu / completion card (in-buffer popup, minibuffer list, context menu)
(defchrome face-popup {:fg *text* :bg *surface0*}) ; an unselected row
(defchrome face-popup-selected {:fg *on-selection* :bg *selection* :bold true}) ; the selection

;; a tooltip (the hover hint over a status-bar segment): the popup surface, a hairline
;; border for legibility over arbitrary content, its own dim-then-text fg.
(defchrome face-tooltip face-popup) ; the tooltip card surface
(defchrome face-tooltip-fg {:fg *text*}) ; the tooltip text
(defchrome face-tooltip-border face-border) ; the tooltip's hairline edge

;; ---- calling into the GUI backend, loudly -----------------------------------

(defdyn *windowless-runtime* false)
;; True while code runs for a runtime with no window of its own — a `--serve` daemon
;; applying its colours (`startup/apply-look`): its frames are painted in windows on other
;; machines, so it has no window to colour and no font to register. Without this, the
;; palette's `gui/bg` started the GUI backend's event thread in a daemon that never opens a
;; window (`gui/bg` asks for it to forward the colour), and a theme's own font files went to
;; `gui/font-register`, which reads the files and RAISES when it cannot — or when that thread
;; cannot start, a displayless machine. A `defdyn` is ambient (root, not `theme/`-qualified),
;; hence the long name.

(defn gui-only (f & args)
  "Call the `gui/*` function VALUE `f` with `args`; nil when this runtime was built without
a GUI backend (`gui/available?`) or has no window of its own (`*windowless-runtime*`), and every
error raised. The only thing this guards is the missing backend or window — a headless test
run, a `editor/frontend/*term-display*` session, a `--serve` daemon. It takes the function, not a
form, so a stale name fails at the reference rather than inside a `try` that would hide it
and leave the editor silently unfonted, untitled and without a clipboard."
  (when (and (not *windowless-runtime*) (gui/available?)) (apply f args)))

;; Whether this runtime draws in a TERMINAL (`bedit -nw`, or no display), set once by `main`
;; ([[use-terminal-look!]]): the terminal's default face then follows the palette (`term/bg`,
;; brood ADR-586), as a window's background does (`gui/bg`). Without it a theme made for a
;; dark window was drawn on whatever the terminal's own background is — on a light one, its
;; light text unreadable.
(def *terminal-look?* false)

(defn window-look ()
  "The palette's DEFAULT FACE, `{:bg :fg}`: the ground (`*base*`) and the colour of text
no face colours (`*fg-code*`, the code tier) — a plain identifier, the echo line. What a
window's background and default text are ([[window-look!]]) and a terminal's default face
([[terminal-look!]]), so every theme's plain text is its own text colour on its own ground.

    (theme/window-look)   ;~> {:bg \"#1e1e2e\" :fg \"#cdd6f4\"}"
  {:bg *base* :fg *fg-code*})

(defn window-look! ()
  "Paint this runtime's window in the palette's default face ([[window-look]]): its
background (`gui/bg`) and the colour of text whose face names no `:fg` (`gui/fg`, brood
ADR-613) — without the second, plain text was the renderer's own light default, all but
invisible on a light theme. Through [[gui-only]], so a headless or windowless runtime skips
it. Returns nil."
  (let (look (window-look))
    (gui-only gui/bg (:bg look))
    (gui-only gui/fg (:fg look))
    nil))

(defn- terminal-look! ()
  "Draw the terminal in the palette: its default face — what `[:clear]` fills, and the
colours of a face that names none — is the palette's ([[window-look]]: `*fg-code*` on
`*base*`, `term/bg`), as a window's is ([[window-look!]]). Only once
[[use-terminal-look!]] said this runtime draws in a terminal. Returns nil."
  (when *terminal-look?*
    (let (look (window-look)) (term/bg (:bg look) (:fg look))))
  nil)

(defn use-terminal-look! ()
  "Say this runtime draws in a terminal, and draw it in the palette now ([[terminal-look!]]);
every theme change after follows ([[theme-apply!]]). Returns nil."
  (def *terminal-look?* true)
  (terminal-look!))

;; ---- syntax-token colours (the highlighter's :syntax/* registry) ------------
;; The Brood highlighter (std/editor/highlight.blsp) resolves each token through a
;; `:syntax/*` face in the shared registry, defaulting to the terminal-ANSI keywords
;; (:magenta, :cyan, …). `apply-syntax-theme!` overrides those with the palette above
;; so .blsp buffers fontify in soft RGB to match the chrome — without touching the
;; defaults the REPL / observer use. Live-bound: the view re-lexes each frame, so this
;; re-skins a running editor immediately (and a `(face-set …)` at the REPL re-skins it
;; live too).

;; Whether the Lisp lexers colour brackets by depth (the init file's `:rainbow-delimiters`,
;; Emacs's rainbow-delimiters-mode). Held here, beside the colours it turns on, for the line
;; lexer builders (brood-mode, the `deflisp` dialects), which run with no model to read.
(def *rainbow-delimiters* false)

(defn set-rainbow-delimiters (on?)
  "Turn the Lisp lexers' rainbow brackets on or off (`config/apply-to-model`, at startup and on
M-x reload-config). The line cache stamps its lexers with this switch, so each buffer's lexer
is rebuilt with it the next time the buffer is shown."
  (def *rainbow-delimiters* (= on? true))
  nil)

(defn apply-syntax-theme! (&optional (overrides {}))
  "Restyle the highlighter's `:syntax/*` faces, and Org's heading levels, to the editor
palette — each from the palette unless `overrides` (a theme's `:faces`, by face name) names
it. Called at startup (`main`) and by every theme switch. Pure-model tests build via
`ed-init` and never call this, so they keep the keyword defaults — asserting faces without
the live theme."
  ;; REPLACED, not merged (`def-face`): a theme states the whole face, so an italic one
  ;; theme set does not survive into the next that names none
  (let (style (fn (name attrs) (def-face name (get overrides name attrs))))
    (style :syntax/comment {:fg *overlay0* :italic true}) ; dim, italic
    (style :syntax/string {:fg *green*})
    ;; A DOCSTRING, not a string value — prose about the definition, so it reads
    ;; like prose: lighter than a comment, clearly not the `*green*` of a value a
    ;; function returns (`(defn greeting () "Doc." "hello mylife")` colours the two
    ;; strings apart, which is the whole point).
    (style :syntax/doc {:fg *subtext* :italic true})
    (style :syntax/number {:fg *peach*})
    ;; a language's keywords (`def`, `fn`, `do`) — and, by the inherit below, the Lisp's `:keyword`
    ;; literals and a data format's keys, which have always shared this colour
    (style :syntax/keyword {:fg *yellow*})
    ;; literals apart from keywords (brood ADR-616): the colours they always had unless a theme
    ;; parts them — `:foo` / `nil` and a JSON key the keyword's, `True` / an atom the special's
    (style :syntax/symbol {:inherit :syntax/keyword})
    (style :syntax/constant {:inherit :syntax/special})
    (style :syntax/special {:fg *mauve*}) ; special forms (def/fn/let/if) — colour, no bold weight
    (style :syntax/function {:fg *blue*}) ; a call head
    ;; the name a definition binds (brood ADR-614): the call colour unless a theme parts them
    (style :syntax/definition {:inherit :syntax/function})
    ;; a variable, parameter or field, as a language server's semantic tokens name it
    ;; (`lsp-semantic`): the text colour unless a theme colours it
    (style :syntax/variable {})
    ;; brackets, commas, semicolons: the text colour (no span at all) unless a theme dims them
    (style :syntax/punctuation {})
    (style :syntax/error {:fg *red* :bold true}) ; a lone unmatched bracket
    ;; brackets by depth (rainbow-delimiters), outermost first, cycling past the ninth
    (doseq (entry (seq/zip (range 1 10)
                    [*text* *mauve* *blue* *peach* *green* *yellow* *teal* *red* *subtext*]))
      (let ([depth color] entry
            name (keyword (str "syntax/delimiter-" depth)))
        (style name {:fg color})))
    ;; Org's `org-level-N`, cycling past the fourth (src/org.blsp): the syntax colours by
    ;; default, which is what a palette without heading colours of its own has
    (style :org/level-1 {:inherit :syntax/function :bold true})
    (style :org/level-2 {:inherit :syntax/keyword :bold true})
    (style :org/level-3 {:inherit :syntax/special :bold true})
    (style :org/level-4 {:inherit :syntax/string :bold true})
    nil))
;; ---- live theme switching (M-x theme-select) --------------------------------
;; A theme is a PALETTE — a `role -> "#rrggbb"` map over the 16 tokens above. `theme-apply!`
;; rebinds every palette var to the new colours (runtime `def`, the ricing mechanism) and
;; re-derives every chrome face + the syntax colours from them, then repaints the window
;; background. The palette vars above are Catppuccin Mocha, the default; a face's formula is
;; written once, in its `defchrome`, and `theme-apply!` re-runs it — add a face there and a
;; theme switch already knows it.

(def *theme-mocha*
  {:base "#1e1e2e"
   :mantle "#181825"
   :surface0 "#313244"
   :surface1 "#45475a"
   :surface2 "#585b70"
   :overlay0 "#6c7086"
   :overlay1 "#7f849c"
   :overlay2 "#9399b2"
   :text "#cdd6f4"
   :subtext1 "#bac2de"
   :subtext "#a6adc8"
   :lavender "#b4befe"
   :blue "#89b4fa"
   :mauve "#cba6f7"
   :green "#a6e3a1"
   :yellow "#f9e2af"
   :peach "#fab387"
   :red "#f38ba8"
   :teal "#94e2d5"})

;; init.blsp's `:faces` (Emacs's custom-set-faces): a face by name to the attributes it takes
;; whatever the theme says — laid over every theme's own `:faces` by [[theme-apply!]], so it
;; holds at startup, on M-x reload-config and across M-x theme-select. A `def`, the root value
;; every frame and buffer process reads, as the palette is.
(def *user-faces* {})

;; The palette and faces the last [[theme-apply!]] was given — the theme's own, before the
;; user's — so a change of the user's faces re-applies the theme they sit on ([[reapply!]]).
(def *applied* {:palette *theme-mocha* :faces {}})

(defn set-user-faces! (faces)
  "Make `faces` (init.blsp's `:faces`, nil for none) the faces laid over every theme. Takes
effect at the next [[theme-apply!]] — [[reapply!]] for now. Whether they changed."
  (let (wanted (if (map? faces) faces {})
        changed (not (= wanted *user-faces*)))
    (def *user-faces* wanted)
    changed))

(defn reapply! ()
  "Apply again the theme last applied ([[*applied*]], Mocha before any), with the user's faces
over it as they stand now. nil."
  (theme-apply! (:palette *applied*) (:faces *applied*)))

(defn- chrome-override (faces qualified)
  "The attributes `faces` gives the chrome face registered as `qualified`, or nil. A key may
name it as the registry does (`bedit/theme/face-hl-line`) or from its module down
(`theme/face-hl-line`), so a theme need not spell the project it is loaded in."
  (let (name (->string qualified))
    (or (get faces qualified)
      (let (key (seq/find (keys faces)
                  (fn (key)
                    (and (symbol? key) (string/ends-with? name (str "/" (->string key)))))))
        (when key (get faces key))))))

(defn theme-apply! (p &optional (faces {}))
  "Swap the whole palette to `p` (a `role -> hex` map) live: rebind every palette var, re-derive
every chrome face + the `:syntax/*` colours from them, and repaint the window's background and
the colour of its plain text ([[window-look!]]: `gui/bg`, `gui/fg`). The ui-kit widgets re-skin for
free (their `ui-ctx` reads the palette each frame). Returns nil.

`p` may also name `:selection`, `:on-selection` and `:cursor`, each defaulting to a role it
must name; `:subtext1`, `:overlay2` and `:lavender` ([[palette-complete]]); and any text tier
(`:fg-tertiary`, [[tiers-of]]). `faces` is what a palette cannot say: a chrome face by its qualified name
(`theme/face-hl-line`) or a registry face by its keyword (`:syntax/string`, `:org/level-2`),
each to the attributes it takes instead of its formula's. A face that is another (`face-divider`
is `face-border`) follows an override of the one it names. init.blsp's `:faces`
([[*user-faces*]]) go over `faces`, so the user's word on a face outlasts every switch."
  ;; palette, the roles a theme may leave out filled in first
  (let (p (palette-complete p)
        tiers (tiers-of p)
        effective (merge faces *user-faces*))
    (def *applied* {:palette p :faces faces})
    (def *base* (:base p))
    (def *mantle* (:mantle p))
    (def *surface0* (:surface0 p))
    (def *surface1* (:surface1 p))
    (def *surface2* (:surface2 p))
    (def *overlay0* (:overlay0 p))
    (def *overlay1* (:overlay1 p))
    (def *overlay2* (:overlay2 p))
    (def *text* (:text p))
    (def *subtext1* (:subtext1 p))
    (def *subtext* (:subtext p))
    (def *lavender* (:lavender p))
    (def *blue* (:blue p))
    (def *mauve* (:mauve p))
    (def *green* (:green p))
    (def *yellow* (:yellow p))
    (def *peach* (:peach p))
    (def *red* (:red p))
    (def *teal* (:teal p))
    (def *selection* (or (:selection p) (:blue p)))
    (def *on-selection* (or (:on-selection p) (:base p)))
    (def *cursor* (or (:cursor p) (:text p)))
    (def *term-palette* (term-palette-of p))
    ;; the text-emphasis tiers every chrome face names
    (def *fg-code* (:fg-code tiers))
    (def *fg-chrome* (:fg-chrome tiers))
    (def *fg-chrome-dim* (:fg-chrome-dim tiers))
    (def *fg-tertiary* (:fg-tertiary tiers))
    (def *fg-decor* (:fg-decor tiers))
    ;; chrome faces — every `defchrome` formula re-run over the new palette, ranked
    ;; so an alias follows what it names
    (doseq (entry (chrome-faces))
      (let ([qualified formula] entry)
        (reflect/eval (list 'def qualified (or (chrome-override effective qualified) (formula))))))
    ;; syntax registry + the window's background and default text colour
    (apply-syntax-theme! effective)
    (window-look!)
    ;; and a terminal's default face, when this runtime draws in one
    (terminal-look!)
    nil))

;; ---- the ui-kit render context (semantic role → palette) --------------------
;; src/ui-kit.blsp is theme-agnostic: a widget styles by SEMANTIC ROLE and the caller
;; supplies the role→colour map. This is that map for our palette — the one place the
;; kit's roles bind to Catppuccin, shared by every kit consumer (the context menu, the
;; completion popup, Plume, which-key). Read every frame, so re-`def`-ing a palette var
;; live re-skins all of them at once.

(defn ui-ctx (gui?)
  "The `ui-kit` render context for a `gui?` flag: `{:gui? … :theme <role→colour>}`, the
editor palette mapped onto the kit's semantic roles. `gui?` (the model's `:gui`) picks the
rounded sub-cell lowering over the flat terminal one."
  {:gui? gui?
   :theme {:surface *surface0*
           :on-surface *text*
           :muted *fg-chrome-dim*
           ;; A third weight below `:muted`, for a column that is a HINT rather than
           ;; content — a menu's shortcut keys. Without it a shortcut and a disabled label
           ;; were the same colour, so `Cut` being unavailable looked exactly like `C-w`
           ;; being a reminder, and the only thing telling them apart was which column
           ;; they were in.
           :faint *fg-decor*
           :selection *selection*
           :on-selection *on-selection*
           :border *surface1*
           ;; The characters a fuzzy query matched in a candidate, one colour per TERM of
           ;; the query (std/fuzzy, brood ADR-429) — Emacs orderless's faces, cycling past
           ;; the fourth — so `lim ex` shows which word found which part of the path.
           :match-0 *peach*
           :match-1 *mauve*
           :match-2 *green*
           :match-3 *yellow*}})

(defn ed-palette-token ()
  "The live palette as one `=`-comparable value: every colour a theme switch (`theme-apply!`)
re-binds, from which every chrome face, gutter face and note face is derived. A fragment that
paints faces it does not receive as data names this as a dep, so a theme switch repaints it —
the colours are interned strings, the same cells frame after frame, so the comparison is
two dozen identity checks."
  [*base*
    *mantle* *surface0* *surface1* *surface2* *overlay0* *overlay1* *overlay2* *text* *subtext1*
    *subtext* *lavender* *blue* *mauve* *green* *yellow* *peach* *red* *teal* *fg-code* *fg-chrome*
    *fg-chrome-dim* *fg-tertiary* *fg-decor*])
