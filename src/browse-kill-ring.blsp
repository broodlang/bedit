(defmodule browse-kill-ring
  "M-x browse-kill-ring: the kill ring listed newest first in *Kill Ring* (Emacs's
browse-kill-ring package), RET inserting the entry at point where the listing was opened
from, g rebuilding it. The ring itself is `clipboard`'s."
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use editor/buffer) ; the listing's lines, and the insert
  (:use editor/keymap :only [keymap-bind]) ; the mode's keys
  (:use clipboard) ; ed-set-kill-ring / ed-adopt-shared-ring — the ring a frame shares
  (:use interactive) ; defcommand
  (:use pool) ; ed-show-named / ed-switch-to-named — the *Kill Ring* buffer
  (:use model)) ; ed-current-buf / ed-try-edit / message

;; M-y walks the ring one entry at a time, blind. *Kill Ring* shows all of it — every entry,
;; newest first, between separator lines — and RET on one inserts it where you were, and
;; moves it to the front of the ring (Emacs's `browse-kill-ring` package).

(def ed-kill-ring-separator "────────────────────────────────────────")
(def- ed-kill-ring-entry-lines 12) ; an entry longer than this shows its first lines and a count

(defn- ed-kill-ring-entry-text (entry)
  "How one ring entry shows: its text, cut to its first lines when it is long."
  (let (lines (string/split entry "\n"))
    (if (<= (count lines) ed-kill-ring-entry-lines)
      entry
      (str (string/join (take lines ed-kill-ring-entry-lines) "\n")
        "\n… "
        (- (count lines) ed-kill-ring-entry-lines)
        " more lines"))))

(defn ed-kill-ring-text (ring)
  "The *Kill Ring* listing: each entry of `ring`, newest first, under a separator line."
  (if (empty? ring)
    "The kill ring is empty.\n"
    (str (string/join (map ring
                        (fn (entry)
                          (str ed-kill-ring-separator "\n" (ed-kill-ring-entry-text entry))))
           "\n")
      "\n")))

(sig ed-kill-ring-index-at (buffer -> int))
(defn ed-kill-ring-index-at (buf)
  "Which entry the line at point belongs to: the separators at or above it, less one — -1
above the first."
  (let (line (buffer-current-line buf))
    (dec (count (seq/filter (range (inc line))
                  (fn (i) (string/starts-with? (buffer-line-at buf i) ed-kill-ring-separator)))))))

(defn- ed-show-kill-ring (m)
  "`*Kill Ring*` shown with the ring every frame shares, adopted first."
  (let (adopted (ed-adopt-shared-ring m))
    (ed-show-named adopted "*Kill Ring*" (ed-kill-ring-text (:kill-ring adopted)) :kill-ring)))

(defcommand cmd-browse-kill-ring
  (m key)
  "Show every entry of the kill ring in `*Kill Ring*`, newest first (M-x browse-kill-ring).
RET on an entry inserts it in the buffer you came from and moves it to the front of the
ring; `g` refreshes, `q` quits."
  (assoc (ed-show-kill-ring m) :kill-ring-origin (buffer-name (ed-current-buf m))))

(defcommand cmd-kill-ring-insert
  (m key)
  "RET in `*Kill Ring*`: insert the entry at point in the buffer the listing was opened
from, and make it the newest entry, so C-y repeats it."
  (let (index (ed-kill-ring-index-at (ed-current-buf m))
        ring (:kill-ring m)
        origin (:kill-ring-origin m))
    (cond
      (or (< index 0) (>= index (count ring))) (message m "not on a kill-ring entry")
      (nil? (ed-buffer-index-by-name m origin))
        (message m (str "the buffer it came from is gone: " origin))
      else
        (let (entry (nth ring index)
              front (cons entry (seq/remove-nth ring index))
              back (ed-switch-to-named m origin)
              [inserted ok?] (ed-try-edit back (fn (b) (insert b entry))))
          (if ok? (ed-set-kill-ring inserted front) inserted)))))

(defcommand cmd-kill-ring-refresh
  (m key)
  "g in `*Kill Ring*`: rebuild the listing — another frame may have killed since."
  (ed-show-kill-ring m))

;; ---- kill-ring-mode: *Kill Ring* ------------------------------------------------
(def kill-ring-keymap
  (-> {}
    ;; RET — insert the entry at point where the listing was opened from
    (keymap-bind [:enter] 'browse-kill-ring/cmd-kill-ring-insert)
    ;; g — rebuild the listing
    (keymap-bind ["g"] 'browse-kill-ring/cmd-kill-ring-refresh)))

(def kill-ring-mode-layer
  {:name 'kill-ring
   :writable :toggle
   :doc "The kill ring, newest first — RET inserts the entry at point."
   :keymap browse-kill-ring/kill-ring-keymap
   :commands (modes/layer-commands browse-kill-ring/kill-ring-keymap)})

(modes/register-special-type :kill-ring 'browse-kill-ring/kill-ring-mode-layer)

(interactive/declare-trait :guest
  '(browse-kill-ring/cmd-browse-kill-ring browse-kill-ring/cmd-kill-ring-insert
     browse-kill-ring/cmd-kill-ring-refresh))
