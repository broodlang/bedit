;; src/lex-gitignore.blsp — git's pattern files (Emacs's git-modes): `.gitignore` and the
;; ignore files that copy its syntax (`.dockerignore`, `.npmignore`, …), and
;; `.gitattributes`. Two `editor/lexer` tables, nothing about how a line is walked: a `#`
;; comment is a whole line (a `#` later in a pattern is part of the name), a leading `!`
;; negates, and the glob metacharacters — `**`, `*`, `?`, a `[…]` class — are what make a
;; line a pattern rather than a name, so they are the part painted.

(defmodule lex-gitignore
  "Lexical highlighting for git's pattern files — `gitignore-spans` (`.gitignore`,
`.dockerignore` and the other ignore files in its syntax) and `gitattributes-spans` — each a
pure `src -> [start end face]` spans fn in the `highlight-spans` shape, from a table of
`editor/lexer` rules, with a stateless line lexer beside it."
  (:use editor/lexer))

;; the glob metacharacters a pattern line is made of; `\x` escapes one (`\#`, `\!`, `\ `)
(def- glob-rules
  [["\\\\." :string]
    ["\\*\\*|\\*|\\?|\\[[^\\]]*\\]" :keyword]])

;; ---- ignore files ---------------------------------------------------------------------
;; A line is a comment only when `#` is its first character; `!` there re-includes what an
;; earlier line excluded; a `/` that ends the pattern makes it match directories only.

(def gitignore-grammar
  (lexer-grammar {:structured (into [["^#.*" :comment]] glob-rules)
                  :line [["^" "!" "" :special]
                          ["^.*?" "/" "\\s*$" :function]]}))

(defn gitignore-spans (src)
  "`.gitignore` colour spans: `#` comment lines, the negating `!`, the glob metacharacters
(`**`, `*`, `?`, `[…]`), a `\\` escape, and the `/` that makes a pattern directory-only.

    (map (lex-gitignore/gitignore-spans \"# c\") (fn ([s e _]) [s e]))   ;=> ([0 3])"
  (lexer-spans gitignore-grammar src))

(defn gitignore-line-lexer ()
  "`gitignore-grammar` as a line lexer (brood ADR-471) — gitignore-mode's `:line-lexer`.

    (:stateless? (lex-gitignore/gitignore-line-lexer))   ;=> true"
  (lexer-line-lexer gitignore-grammar))

;; ---- .gitattributes -------------------------------------------------------------------
;; `pattern attr -attr !attr attr=value …`: the pattern's globs as an ignore file's, and each
;; attribute after it, set, unset (`-`), unspecified (`!`) or given a value. A
;; `[attr]name …` line defines a macro attribute.

(def gitattributes-grammar
  (lexer-grammar {:structured (into [["^#.*" :comment]
                                      ["^\\[attr\\][^\\s]+" :special]
                                      ["\\s[-!]?[A-Za-z0-9_.][A-Za-z0-9_.-]*(?:=[^\\s]*)?"
                                        :function]]
                                glob-rules)}))

(defn gitattributes-spans (src)
  "`.gitattributes` colour spans: `#` comment lines, a pattern's glob metacharacters, each
attribute (`text`, `-diff`, `!merge`, `eol=lf`), and an `[attr]` macro's name.

    (map (lex-gitignore/gitattributes-spans \"*.sh eol=lf\") (fn ([s e _]) [s e]))   ;=> ([0 1] [5 11])"
  (lexer-spans gitattributes-grammar src))

(defn gitattributes-line-lexer ()
  "`gitattributes-grammar` as a line lexer (brood ADR-471) — gitattributes-mode's
`:line-lexer`.

    (:stateless? (lex-gitignore/gitattributes-line-lexer))   ;=> true"
  (lexer-line-lexer gitattributes-grammar))
