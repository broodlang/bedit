(defmodule modes
  "The editor's modes, as **layers** (`std/layers.blsp`). A *mode* is a layer — a
named bundle of a keymap (and, later, hooks / a structural parser) — that a buffer
carries; dispatch composes the active buffer's layers (see `input`). This decouples
\"which keys do what\" from the dispatch loop and makes it per-buffer: a `.blsp`
buffer can later get a `brood-mode` layer (structural sexp nav + C-x C-e) stacked
on, while a plain buffer stays in `text-mode`.

`text-mode` is the **default**: it's registered for the `:fundamental` type, which
`layers/buffer-type-for` returns for any buffer with no matching filename and no
explicit `:type`. Its keymap holds the editor's bindings — data, built with
`keymap-bind` (which nests prefix sub-keymaps for chords like `C-x C-e`); command
values are quoted, fully-qualified symbols resolved with `(reflect/eval sym)` at dispatch,
so redefining a command or rebinding a key hot-swaps behaviour live."
  (:use editor/layers)
  (:use editor/keymap)
  (:use editor/highlight) ; brood-mode's language services reuse the pure analysis here
  ;; NB: `editor/treesit` is required below, never `:use`d — it shares names with `sexp`
  ;; (`point-down`, `point-defun-start`, …) and two `:use`s of one name is a load error
  ;; (E0099). Everything here calls it qualified, which only needs the module loaded.
  (:use theme) ; face-gutter-line — the dim line-number colour (src/theme.blsp)
  (:use sexp)) ; the CST queries the brood-mode indenter is computed over
;; regex (file-type trigger), editor/highlight, editor/markdown, editor/dotenv,
;; editor/dockerfile, editor/treesit (fontify services + structural motions),
;; editor/buffer (line-count gutter) and model (ed-mode-service) are referenced qualified
;; below — each `mod/name` auto-loads its module.
;; The universal keybindings (the old `global` layer) moved to `keymaps` (src/keymaps.blsp):
;; they're now a keybinding *profile* on the MODEL scope, not a system layer pinned to
;; every buffer, so a second profile (vim) can replace them. This module keeps the
;; per-buffer *mode* layers (text/brood/markdown/…) — language + mode-specific keys.

;; ---- the line-number gutter, as a mode service -----------------------------
;; A *gutter* is generic per-line margin content a layer contributes via two facets
;; `ed-mode-service` looks up: `:gutter-width` (columns to reserve, given the buffer)
;; and `:gutter-cell` (`[text face]` for a 0-based line, given the buffer + width).
;; Both renderers consume it without naming "line numbers" — the view paints the cells
;; left of the text (src/view.blsp), the web mirror materialises them into its snapshot
;; (src/web.blsp). line-numbers is the first such gutter; a future diagnostics/git
;; gutter is the same two functions registered on a layer. Lives on text-mode (the
;; shared base), so plain *and* brood buffers get it (brood stacks text-mode beneath).

(def gutter-face-line-number face-gutter-line) ; the dim line-number colour (theme)
(def line-number-min-digits 4) ; reserve at least this many digit columns so the gutter
; doesn't widen (and shift the text right) as a buffer grows
; past 99/999 lines — Emacs's `display-line-numbers-width`.

(def line-number-right-margin 2) ; blank columns between the line number and the text — a
; slight gutter→text gap so the text doesn't butt against
; the number (was 1; text is cell-aligned, so 1 col is the
; minimum bump). Lower to 1 to tighten, or redefine live.

(def line-number-bar-width 1) ; columns reserved for the diff-hl change bar (file buffers only)
(defn line-number-width (buf)
  "The `:gutter-width` for line numbers: the last line number's digit count (but at least
`line-number-min-digits`, so the gutter stays put as the buffer crosses 99/999 lines) +
`line-number-right-margin` blank columns of gutter→text gap, plus 1 more for the diff-hl
change bar on a **file buffer**. The bar column is keyed on the buffer being file-backed —
*not* on `:git-line-status` being populated yet — so the gutter width is stable from the
moment the file opens: it doesn't narrow then re-widen when the async diff lands (or when a
save drops the cached annotation)."
  (+ (if (nil? (editor/buffer/buffer-file buf)) 0 modes/line-number-bar-width)
    modes/line-number-right-margin ; gutter→text gap
    (math/max modes/line-number-min-digits
      (string/length (str (editor/buffer/buffer-line-count buf))))))

;; ---- margin marks (breakpoints + test verdicts) ------------------------------
;; Per-line marks other features annotate ONTO the buffer (the gitdiff trick — a
;; gutter cell sees only the buffer, no model): `:debug-break-lines {line true}` from
;; the margin-click breakpoint (debugger), `:test-marks {line passed?}` from a test
;; run (testrun). Each carries the line count at annotation time and is drawn only
;; while positionally current (`:git-status-lines`' discipline); a test verdict on a
;; MODIFIED buffer dims — it predates your edit.

(def gutter-face-breakpoint {:fg *red* :bold true})
(def gutter-face-test-pass {:fg *green*})
(def gutter-face-test-fail {:fg *red* :bold true})
(def gutter-face-test-stale {:fg *overlay0*})
(def gutter-face-warn {:fg *yellow*}) ; an advisory type warning (⚠)
(def gutter-face-describe-mixed {:fg *yellow* :bold true}) ; some passed, some failed
(def gutter-face-describe-partial {:fg *blue*}) ; only some of the block's tests ran
(defn describe-rollup-mark (tally stale)
  "The `[glyph face]` for a `(describe …)` rollup `tally` (`{:pass :fail :skip
:total}`): ✓ when every test in the block ran and passed, `◐` on any failure, `◔`
when only some of the block's tests ran (a line-filtered single-test run). `stale`
dims all three."
  (let (ran (+ (:pass tally) (:fail tally) (:skip tally))
        total (:total tally))
    (cond
      (> (:fail tally) 0)
        ["◐" (if stale modes/gutter-face-test-stale modes/gutter-face-describe-mixed)]
      (and (> total 0) (< ran total))
        ["◔" (if stale modes/gutter-face-test-stale modes/gutter-face-describe-partial)]
      else ["✓" (if stale modes/gutter-face-test-stale modes/gutter-face-test-pass)])))

(defn- mark-line-keyed (buf key line)
  ;; The value a line-keyed annotation holds for `line`, plus whether it predates the
  ;; current text — `nil` when the annotation is missing or no longer positionally
  ;; current (lines shifted, so it would point at the wrong ones). Every gutter
  ;; source below is this same question; `std/editor/buffer`'s `annotation` owns the
  ;; currency/staleness pairing so none of them re-derives it.
  (let (a (editor/buffer/annotation buf key))
    (when (and a (:current? a) (contains? (:value a) line))
      {:at (get (:value a) line) :stale? (:stale? a)})))

(defn- mark-eol-note (buf line)
  ;; The eol-note anchored on `line` (notes are keyed by owner, with `:line` inside —
  ;; a handful per buffer, so a scan is right). See `results/eol-notes`.
  ;; A `:hint` note is skipped: it is a derived TYPE sitting at the code it describes, not a
  ;; verdict about a line, and a `·` beside every typed form is margin noise. Of the rest —
  ;; a line can carry more than one — the first in reading order glyphs the margin, which is
  ;; all one cell can say.
  (let (a (editor/buffer/annotation buf :eol-notes))
    (when (and a (:current? a))
      (let (hit (first (filter (results/notes-on-line buf line) (fn (n) (not (= (:kind n) :hint))))))
        (when hit {:at hit :stale? (:stale? a)})))))

(defn- mark-verdict-glyph (verdict stale)
  ;; a test verdict: pass / fail / skipped, dimmed when it predates the text
  (cond
    (= verdict :skipped) ["·" modes/gutter-face-test-stale]
    stale [(if verdict "✓" "✗") modes/gutter-face-test-stale]
    verdict ["✓" modes/gutter-face-test-pass]
    else ["✗" modes/gutter-face-test-fail]))

(defn- mark-note-glyph (note stale)
  ;; an eol note: a result ·, a pass ✓, a failure ✗, work in flight ⋯. The ⋯ takes the
  ;; dim face deliberately — grey reads as "pending", and it must NOT take the
  ;; pass/fail colours, which would look like a verdict that has already landed.
  (let (kind (if (:warn note) :warn (:kind note))
        glyph (cond
                (= kind :pass) "✓"
                (= kind :fail) "✗"
                (or (= kind :running) (= kind :incomplete)) "⋯"
                (= kind :warn) "⚠"
                else "·"))
    (cond
      ;; a warning is about the code as WRITTEN, so an edit doesn't make it stale in the
      ;; way a result is — it's recomputed on every launch
      (= kind :warn) [glyph modes/gutter-face-warn]
      (or (= kind :running) (= kind :incomplete)) [glyph modes/gutter-face-test-stale]
      stale [glyph modes/gutter-face-test-stale]
      (= kind :pass) [glyph modes/gutter-face-test-pass]
      (= kind :fail) [glyph modes/gutter-face-test-fail]
      else [glyph modes/gutter-face-test-stale])))

(def gutter-mark-sources
  ;; The margin's sources in PRECEDENCE order — each `[reader glyph-fn]`, where the
  ;; reader answers `{:at value :stale? bool}` for a line. Adding a source (an inline
  ;; eval result, an LSP hint) is one row here, not another branch that re-implements
  ;; the staleness dance.
  [[(fn (buf line) (mark-line-keyed buf :debug-break-lines line))
     (fn (_ _) ["●" modes/gutter-face-breakpoint])]
    [(fn (buf line) (mark-line-keyed buf :test-marks line))
      (fn (verdict stale) (mark-verdict-glyph verdict stale))]
    [(fn (buf line) (mark-line-keyed buf :describe-marks line))
      (fn (tally stale) (describe-rollup-mark tally stale))]
    [(fn (buf line) (mark-eol-note buf line))
      (fn (note stale) (mark-note-glyph note stale))]])

(defn gutter-mark-for (buf line)
  "The `[glyph face]` margin mark for `line`, or nil: the first source in
`gutter-mark-sources` that has something to say — a breakpoint ●, a per-test verdict
✓/✗/·, a `(describe …)` rollup ✓/◐/◔, or an end-of-line note's ·/✓/✗/⋯.

Every source is a buffer ANNOTATION (`std/editor/buffer`), so all of them share one
discipline instead of four copies of it: a mark blanks entirely once lines have
shifted (it would point at the wrong line) and DIMS while the text differs from what
produced it (an edit dims a verdict; undoing back restores it)."
  ;; `keep` then `first`: each source's reader runs at most ONCE per line (a `find`
  ;; followed by re-reading the winner ran it twice — two annotation lookups and two
  ;; scans on every marked line, every frame the gutter cache misses).
  (first (seq/keep gutter-mark-sources
           (fn (source)
             (let ([reader glyph] source
                   found (reader buf line))
               (when found (glyph (:at found) (:stale? found))))))))

(defn gutter-annotate (buf line cell)
  "Overlay the line's margin mark (if any) on a gutter `cell` — the mark replaces the
trailing gutter→text gap column, so the numbers don't move. `cell` is one `[text face]`
chunk or a list of them; returns the same shape family (a chunk list when marked)."
  (let (mark (gutter-mark-for buf line))
    (if (nil? mark)
      cell
      (let (chunks (if (string? (first cell)) (list cell) cell)
            lead (take chunks (dec (count chunks)))
            [text face] (last chunks)
            shaved (string/substring text 0 (math/max 0 (dec (string/length text)))))
        (append lead (list [shaved face] mark))))))

(defn line-number-cell (buf line gw)
  "The `:gutter-cell` for 0-based `line`: its 1-based number right-aligned + a trailing
space, in the dim line-number face. A **file buffer** prepends a coloured change bar chunk
(diff-hl), and any margin mark (a breakpoint ●, a test ✓/✗ — `gutter-mark-for`) overlays
the trailing gap column. Keyed on file-backing to match `line-number-width`, so the cell
and the reserved width agree.

The bar is drawn only while the cached `:git-line-status` annotation is **positionally
current** (`annotation-value` — the line count still matches what it was computed for). The moment
a line is inserted/deleted the cached line→status map is shifted, so every bar below the edit
would land on the wrong line; we blank the bars until the idle recompute lands a fresh map
(rather than draw them too high/low). A within-line edit keeps the line count, so its bars stay."
  (gutter-annotate buf
    line
    (if (nil? (editor/buffer/buffer-file buf))
      ;; number right-aligned in the digit columns, then `line-number-right-margin` trailing
      ;; spaces (string/pad-right to the full width) — the gutter→text gap.
      [(string/pad-right (string/pad-left (str (inc line)) (- gw modes/line-number-right-margin))
         gw)
        modes/gutter-face-line-number]
      (let (bars (editor/buffer/annotation-value buf :git-line-status)
            status (when bars (get bars line)))
        ;; a file buffer's bar takes column 0; the number chunk fills the remaining `gw-1`,
        ;; again with `line-number-right-margin` trailing spaces before the text.
        (list (gitdiff/bar-chunk status)
          [(string/pad-right (string/pad-left (str (inc line))
                               (- gw modes/line-number-bar-width modes/line-number-right-margin))
             (- gw modes/line-number-bar-width))
            modes/gutter-face-line-number])))))

;; text-mode is the visible default major: it names the mode for plain buffers (its
;; bindings are the global layer's) and carries the line-number gutter service. It's
;; the layer for `:fundamental`, the type `buffer-type-for` falls back to.
(def text-mode-layer
  {:name 'text
   :keymap {}
   :gutter-width 'modes/line-number-width
   :gutter-cell 'modes/line-number-cell})
(register-type-layers :fundamental (list 'modes/text-mode-layer))

;; welcome-mode: the startup scratch (`main/*welcome*`). An ordinary EDITABLE text
;; buffer whose mode adds exactly one affordance: the tutorial line is a clickable
;; link — `:line-loc` truthy on that line gives it the pointer cursor + hover
;; underline (the shared link affordance in `view`), `:on-click` opens the tutorial,
;; and a line face paints it link-blue. Type over it and it's just a scratch.

(def *welcome-link-marker* "interactive Brood tutorial")

(defn welcome-line-loc (buf line0)
  "Truthy on the welcome buffer's tutorial-link line — the link affordance hook
(this 'location' is consumed by `commands/cmd-welcome-tutorial`, never visited
as a file)."
  (when (includes? (editor/buffer/buffer-line-at buf line0) modes/*welcome-link-marker*)
    {:welcome :tutorial}))

(defn welcome-fontify (src)
  (fontify-line-faces src
    (fn (l) (when (includes? l modes/*welcome-link-marker*) {:fg *blue*}))))

(def welcome-mode-layer
  {:name 'welcome
   :keymap {}
   :fontify 'modes/welcome-fontify
   :line-loc 'modes/welcome-line-loc
   :on-click 'commands/cmd-welcome-tutorial})

(register-type-layers :welcome (list 'modes/welcome-mode-layer 'modes/text-mode-layer))

;; bshell-mode: the project shell + Brood REPL (`C-x p e`, see src/bshell.blsp), stacked
;; on text-mode. RET runs the current input line; Tab completes (filenames for a command,
;; Brood globals for a `(`-form — `bshell/bshell-complete-source`); `:fontify` colours the
;; prompt + error lines. C-a/Home, C-b/Left and Backspace are wrapped so editing can't
;; cross left of the prompt into the read-only prompt/output. Everything else (self-insert,
;; other motion/kill) falls through to text-mode + the global profile.
(def bshell-mode-layer
  {:name 'bshell
   :keymap (-> {}
             (keymap-bind [:enter] 'bshell/cmd-bshell-send)
             (keymap-bind [:tab] 'complete-at-point/cmd-complete)
             (keymap-bind [:ctrl-a] 'bshell/cmd-bshell-beginning-of-input)
             (keymap-bind [:home] 'bshell/cmd-bshell-beginning-of-input)
             (keymap-bind [:ctrl-b] 'bshell/cmd-bshell-backward-char)
             (keymap-bind [:left] 'bshell/cmd-bshell-backward-char)
             (keymap-bind [:backspace] 'bshell/cmd-bshell-delete-backward)
             ;; ↑/↓ (and C-p/C-n) recall command history, like the Brood REPL
             (keymap-bind [:up] 'bshell/cmd-bshell-previous-history)
             (keymap-bind [:ctrl-p] 'bshell/cmd-bshell-previous-history)
             (keymap-bind [:down] 'bshell/cmd-bshell-next-history)
             (keymap-bind [:ctrl-n] 'bshell/cmd-bshell-next-history)
             ;; C-r searches command history (a filterable minibuffer list)
             (keymap-bind [:ctrl-r] 'bshell/cmd-bshell-history-search))
   ;; Brood services scoped to the input form: syntax colours, bracket matching, eldoc hints
   :fontify 'bshell/bshell-fontify
   :bracket-match 'bshell/bshell-bracket-match
   :eldoc 'bshell/bshell-eldoc
   ;; after every key, keep point out of the read-only prompt (layers §7)
   :post-key 'bshell/bshell-post-key
   ;; killing the buffer stops the shell worker + its child (layers :on-close)
   :hooks {:on-close '(bshell/bshell-on-close)}})
(register-type-layers :bshell (list 'modes/bshell-mode-layer 'modes/text-mode-layer))

(defn- modes-register-with-layers (layer-ref type layers)
  (let (pat (:file-pattern (reflect/eval layer-ref)))
    (register-type-layers type layers)
    (register-file-type (fn (f) (regex/match? pat f)) type)))

(defn register-language-mode (layer-ref type)
  "Register a language mode that stacks over text-mode: bind `type` to `[layer
text-mode]` (head = higher precedence) and route the layer's `:file-pattern` regex to
that type. The shared shape every fontify/structural language mode registers through —
brood, markdown, env, docker, ruby, elixir; a future json-/python-mode is one more call."
  (modes-register-with-layers layer-ref type (list layer-ref 'modes/text-mode-layer)))

;; ---- the shared `prog` base: structural navigation every code mode inherits -----
;; The `C-M-f/b/u/d/a` motions are identical across languages — only the *parser* differs.
;; So they live on one base layer (`prog-mode-layer`) that code modes stack between their
;; language layer and text-mode, and the commands (`commands/cmd-forward-sexp` …) dispatch on
;; the buffer's `:ts-lang` (Brood CST vs tree-sitter — see `commands/ed-structural`). A new
;; language inherits the keys for free and overrides only the parser/faces — the "default +
;; override" model. Paredit (slurp/barf/…) stays Brood-only (a Lisp-delimiter edit), so it
;; lives on `brood-keymap`, not here.
(def prog-structural-keymap
  (-> {}
    (keymap-bind [:ctrl-meta-f] 'commands/cmd-forward-sexp) ; C-M-f forward-sexp
    (keymap-bind [:ctrl-meta-b] 'commands/cmd-backward-sexp) ; C-M-b backward-sexp
    ;; the sexp/list pair: C-M-f/b stop at every form, C-M-n/p only at whole LISTS —
    ;; the "jump the next block" motion (Emacs forward-list / backward-list).
    (keymap-bind [:ctrl-meta-n] 'commands/cmd-forward-list) ; C-M-n forward-list
    (keymap-bind [:ctrl-meta-p] 'commands/cmd-backward-list) ; C-M-p backward-list
    ;; C-M-u is Emacs' `backward-up-list`; its forward twin (`up-list`) has no default
    ;; key there either — it's M-x up-list, and rebindable like anything else.
    (keymap-bind [:ctrl-meta-u] 'commands/cmd-backward-up-list) ; C-M-u backward-up-list
    (keymap-bind [:ctrl-meta-d] 'commands/cmd-down-list) ; C-M-d down-list
    (keymap-bind [:ctrl-meta-a] 'commands/cmd-beginning-of-defun) ; C-M-a beginning-of-defun
    (keymap-bind [:ctrl-meta-e] 'commands/cmd-end-of-defun) ; C-M-e end-of-defun
    ;; the structural kills + whole-form reindent: they ride the motions above, so they
    ;; work over a tree-sitter tree too and belong here rather than on brood-keymap.
    (keymap-bind [:ctrl-meta-k] 'commands/cmd-kill-sexp) ; C-M-k kill-sexp
    (keymap-bind [(keyword "ctrl-meta-backspace")]
      'commands/cmd-backward-kill-sexp) ; C-M-DEL backward-kill-sexp
    (keymap-bind [:ctrl-meta-q] 'commands/cmd-indent-sexp))) ; C-M-q indent-sexp
(def prog-mode-layer
  {:name 'prog
   :keymap modes/prog-structural-keymap
   :commands '("forward-sexp" "backward-sexp"
                "forward-list" "backward-list" "up-list" "backward-up-list" "down-list"
                "beginning-of-defun" "end-of-defun" "kill-sexp" "backward-kill-sexp" "indent-sexp")})

(defn register-prog-mode (layer-ref type)
  "Like `register-language-mode`, but for a **code** mode: it stacks the shared
`prog-mode-layer` (the `C-M-*` structural motions) between the language layer and text-mode,
so every code language inherits the same navigation keys and overrides only its parser/faces."
  (modes-register-with-layers layer-ref
    type
    (list layer-ref 'modes/prog-mode-layer 'modes/text-mode-layer)))

;; ---- brood-mode: Brood (.blsp) source, stacked on prog + text-mode -----------------
;; Structural s-expression navigation (`std/sexp`, via the `commands/cmd-*-sexp`
;; wrappers) layered ON TOP of text-mode — so a `.blsp` buffer keeps every
;; text-mode motion/edit binding and *gains* `C-M-f/b/u/d/a`. The trigger lives on
;; the mode as a **regex** (`:file-pattern`), matched with `std/regex`; edit that
;; one string to change which files get brood-mode.

(def brood-keymap
  ;; The structural motions/kills come from the shared `prog-mode-layer`; brood-keymap adds
  ;; only what's specific to Brood *source* — mark-sexp, RET-indent, the paredit
  ;; delimiter edits (incl. C-M-t transpose), and the sexp-aware C-k.
  (-> {}
    ;; C-M-SPC (also C-M-@) — mark the next sexp, extending on repeat. Key encoding for
    ;; the space chord mirrors C-SPC's `"ctrl- "`; both spellings bound to be safe.
    (keymap-bind [(keyword "ctrl-meta- ")] 'commands/cmd-mark-sexp) ; C-M-SPC
    (keymap-bind [(keyword "ctrl-meta-@")] 'commands/cmd-mark-sexp) ; C-M-@
    ;; RET auto-indents the new line (overrides the global plain newline for .blsp)
    (keymap-bind [:enter] 'commands/cmd-newline-and-indent)
    ;; paredit-style structural editing. Chord encodings are best-guesses (the
    ;; shifted-Ctrl ones especially — see ROADMAP "Loose ends"); all reachable via M-x
    ;; (slurp-forward, …) and rebindable live. C-M-s for splice since M-s is the search
    ;; prefix; M-r shadows move-to-window-line in .blsp, exactly as paredit-mode does.
    (keymap-bind [(keyword "ctrl-)")] 'commands/cmd-slurp-forward) ; C-)
    (keymap-bind [(keyword "ctrl-}")] 'commands/cmd-barf-forward) ; C-}
    (keymap-bind [(keyword "ctrl-(")] 'commands/cmd-slurp-backward) ; C-(
    (keymap-bind [(keyword "ctrl-{")] 'commands/cmd-barf-backward) ; C-{
    (keymap-bind [:alt-r] 'commands/cmd-raise-sexp) ; M-r
    (keymap-bind [(keyword "alt-(")] 'commands/cmd-wrap-round) ; M-(
    (keymap-bind [:ctrl-meta-s] 'commands/cmd-splice-sexp) ; C-M-s
    (keymap-bind [:ctrl-meta-t] 'commands/cmd-transpose-sexps) ; C-M-t
    (keymap-bind [:ctrl-k] 'commands/cmd-sexp-kill) ; C-k (sexp-aware)
    ;; A closer that is already there is stepped over rather than typed twice — Emacs's
    ;; `electric-pair-mode` skip (`commands/cmd-close-delimiter`). Here rather than on
    ;; `prog-structural-keymap` because the scan reads BROOD syntax: `;` starts a comment,
    ;; which in Ruby is a statement separator.
    (keymap-bind [")"] 'commands/cmd-close-delimiter)
    (keymap-bind ["]"] 'commands/cmd-close-delimiter)
    (keymap-bind ["}"] 'commands/cmd-close-delimiter)))
;; ---- brood-mode language services -------------------------------------------
;; The four facets `ed-mode-service` (src/model.blsp) looks up. Each is a thin
;; adapter over `std/highlight.blsp`'s pure analysis (the REPL's editor uses the
;; same module) plus the live image — so the editor's view/completion gain
;; highlighting, bracket-matching, eldoc, and symbol completion for `.blsp` buffers
;; without the generic view ever naming Brood. A future json-/python-mode registers
;; the same facets with its own functions.

(defn- brood-arglist-of (callee)
  "The arglist of the function/macro named by string `callee`, resolved in the live
image, or nil if it isn't a bound symbol. (Mirrors `lineedit-arglist-of`.)"
  ;; `callee` is a token at point, not necessarily readable or a function — no arglist is the answer
  (check-allow :discarded-catch
    (try
      (let (sym (reflect/read-string callee))
        (if (and (symbol? sym) (bound? sym)) (arglist (reflect/eval sym)) nil))
      (catch e nil))))

(defn- brood-doc-block (name)
  ;; `name`'s documentation as pane lines — its arglist, its checker signature, its
  ;; docstring — or nil when nothing is bound under it. `doc`/`arglist` take the function
  ;; VALUE, so the symbol is resolved in the live image first, exactly as the eldoc service
  ;; does; anything unbound (a local, a typo, a name this session has not defined yet)
  ;; answers nil rather than an empty heading.
  ;; `name` is a token at point: unreadable, unbound, or a value with no arglist/doc/sig — each nil is an answer
  (check-allow :discarded-catch
    (try
      (let (sym (reflect/read-string name))
        (when (and (symbol? sym) (bound? sym))
          (let (v (reflect/eval sym)
                args (check-allow :discarded-catch (try (arglist v) (catch _ nil)))
                text (check-allow :discarded-catch (try (doc v) (catch _ nil)))
                sig (check-allow :discarded-catch (try (reflect/type-signature sym) (catch _ nil))))
            (append (list (if (nil? args)
                            name
                            (str "("
                              name
                              (if (empty? args) "" (str " " (string/join (map args str) " ")))
                              ")")))
              (if (nil? sig) '() (list (str "  : " sig)))
              (if (nil? text) '() (cons "" (string/split text "\n")))))))
      (catch _ nil))))

(defn brood-doc-at (text pos)
  "The brood-mode `:doc-at` service: what the cursor is pointing at, as pane lines — the
symbol under it, else the head of the call it is inside, with that name's arglist, checker
signature and docstring. Nil when neither names anything bound.

Falling back to the enclosing call is what makes it useful without aiming: a cursor resting
anywhere in `(map xs f)` documents `map`, which is what you wanted to know from the position
you were already in. The symbol under the cursor wins, so pointing AT `f` documents `f`.

One step further out when the enclosing form is not a call — `(map [1 2 |3] f)` is inside a
vector whose head is `1`, and answering nothing there would make the middle of a literal a
dead spot in an otherwise live pane."
  (let (call-doc (fn (at)
                   (when (>= at 0)
                     (let (c (enclosing-call text at)) (when c (brood-doc-block (first c)))))))
    (or (let (here (symbol-at text pos)) (when here (brood-doc-block (second here))))
      (call-doc pos)
      (call-doc (enclosing-open text pos)))))

(defn brood-eldoc (text pos)
  "The brood-mode `:eldoc` service: a `\"(callee arg…)\"` signature string for the call
enclosing offset `pos` in `text` (`enclosing-call` + the live arglist), or nil when
the cursor isn't in a call whose head is a bound function/macro."
  (let (call (enclosing-call text pos))
    (if (nil? call)
      nil
      (let ([callee argi] call
            args (brood-arglist-of callee))
        (if (nil? args)
          nil
          (str "(" callee (if (empty? args) "" (str " " (string/join (map args str) " "))) ")"))))))

(defn brood-complete-at (text pos)
  "The brood-mode `:complete-at` service: `[start prefix candidates]` for offset `pos`
— the symbol prefix at point (`symbol-prefix-at`) and the live global names that
start with it (the same source as the REPL's Tab completion). `complete` adapts this
pure `(text pos)` service into one source and merges it with the buffer-word source."
  (let ([start prefix] (symbol-prefix-at text pos))
    [start
      prefix
      (if (= prefix "")
        '()
        (sort (filter (map (reflect/global-names) str) (fn (s) (string/starts-with? s prefix)))))]))

;; ---- brood-mode indentation (the :indent service) ---------------------------
;; Indentation that matches `nest format` (the canonical Brood style, std/format),
;; computed purely over the CST (`std/sexp`). The rule the formatter uses: a broken
;; form's body indents **+2** from its open delimiter — for BOTH calls and special
;; forms (a form's header count only changes which args ride the head line, never
;; the body column). The two exceptions align under the first element instead:
;; **maps** and the **bindings list** of a let-family form (`let`/`let*`/`binding`/…).

(def- brood-pair-binding-heads
  ;; let-family heads whose first argument (the bindings list) aligns its pairs
  ;; under the opening element — mirrors std/format's `*format-pair-bindings*`.
  (list "let" "let*" "letrec" "binding" "dotimes" "dolist" "loop"))

(defn- brood-head-text (text node)
  "The source spelling of CST `node` in `text` — a list's head."
  (string/substring text (:start node) (:end node)))

(defn- brood-binding-list? (text tr enc)
  "True if `enc` is the bindings list of a let-family form: its parent's head is a
pair-binding form and `enc` is that parent's first argument."
  (let (parent (enclosing tr (:start enc)))
    (and (not (= parent enc))
      (= (:kind parent) :list)
      (let (pk (forms-of parent))
        (and (>= (count pk) 2)
          (includes? brood-pair-binding-heads (brood-head-text text (first pk)))
          (= (:start (second pk)) (:start enc)))))))

(defn- brood-first-elem-col (text enc opencol)
  "The column to align `enc`'s contents under — its first element's column, or
`opencol + 1` when it's empty."
  (let (kids (forms-of enc))
    (if (empty? kids) (+ opencol 1) (model/ed-column-at text (:start (first kids))))))

(defn brood-indent (text bol)
  "The brood-mode `:indent` service: the indent column for the line starting at
offset `bol`, matching `nest format`. Top level → 0; a **map** or a **let-family
bindings list** aligns its contents under the first element; every other form
indents its body **+2** from the open delimiter. (Multi-line strings aren't
special-cased.)"
  ;; Parse only [defun-start, bol): the indent column depends solely on what's open
  ;; BEFORE the line, so the CST never needs the buffer past it — O(enclosing defun),
  ;; not O(buffer) (a full-buffer `tree` made every RET on a large file a ~14ms pause).
  ;; `scan-form-start` (the native string/comment-aware beginning-of-defun behind
  ;; `sexp/narrow` and `highlight/safe-restart`) finds the window start. It is
  ;; depth-tracked, so the start may be an INDENTED top-level open (a form inside a
  ;; tutorial box margin, a mis-indented file) — back the slice up to that line's
  ;; start so columns inside the slice equal columns in `text`.
  ;; The slice ends at `bol`, so the enclosing form is typically unclosed and its
  ;; CST node runs to the slice end — a strict `enclosing` at the end would miss it
  ;; and return root; probe just inside instead (the char there is `bol`'s newline,
  ;; inside the same open forms).
  (let (fstart (reflect/scan-form-start text bol) ; clamps internally; 0 on an empty text
        start (model/ed-line-start-offset text fstart)
        sub (string/substring text start bol)
        n (string/length sub))
    (if (= n 0)
      0 ; bol at a top-level form start (or an empty buffer) — top level
      (let (tr (tree sub)
            enc (enclosing tr (dec n))
            kind (:kind enc))
        (if (= kind :root)
          0
          (let (opencol (model/ed-column-at sub (:start enc)))
            (if (or (= kind :map) (brood-binding-list? sub tr enc))
              (brood-first-elem-col sub enc opencol)
              (+ opencol 2))))))))

(defn brood-diagnostics (text)
  "The brood-mode `:diagnostics` service: the advisory type-checker's warnings for
buffer `text`, each `{:line :col :message}` (1-based positions), via the in-process
`check-string-structured` (same image — no LSP wire needed for Brood). `()` while the
buffer doesn't parse, so a live recheck never errors mid-edit."
  (or (reflect/check-string-structured text) '()))

(def brood-mode-layer
  {:name 'brood
   :parser :brood
   :file-pattern "\\.blsp$"
   :keymap modes/brood-keymap
   :commands '("mark-sexp" "slurp-forward"
                "barf-forward" "slurp-backward" "barf-backward" "raise-sexp" "splice-sexp"
                "wrap-round" "transpose-sexps" "sexp-kill" "eval-last-sexp" "eval-region"
                "eval-buffer")
   :fontify 'editor/highlight/highlight-spans
   :fontify-restart 'editor/highlight/safe-restart
   :bracket-match 'editor/highlight/bracket-match
   :eldoc 'modes/brood-eldoc
   :doc-at 'modes/brood-doc-at
   :complete-at 'modes/brood-complete-at
   :indent 'modes/brood-indent
   :diagnostics 'modes/brood-diagnostics
   ;; margin click = breakpoint toggle on the clicked definition (debugger is
   ;; deferred; the service symbol resolves on first use, like every service)
   :gutter-click 'debugger/brood-gutter-click
   :comment-syntax ";; "})

;; .blsp files → the :brood type; :brood stacks brood-mode over text-mode (head =
;; higher precedence), and the file trigger is the mode's own :file-pattern regex.
(register-prog-mode 'modes/brood-mode-layer :brood)

;; ---- markdown-mode: Markdown (.md) source, stacked on text-mode -------------
;; The second language mode, and the proof the editor is language-agnostic: a `.md`
;; buffer keeps every text-mode motion/edit binding and the line-number gutter, and
;; *gains* Markdown syntax colouring — purely by registering a layer whose `:fontify`
;; is `std/editor/markdown`'s pure `markdown-spans` (the brood analogue of
;; brood-mode's `highlight-spans`). No keymap or language services beyond fontify yet
;; (headings/code/emphasis/links/lists/quotes); a future toggle-heading command is
;; just another binding on this layer. `:fontify-restart` is omitted: markdown is
;; line-oriented and `ed-window-spans` already lexes a backscan lead-in slice from its
;; top, which re-establishes fenced-code state for everything in view.
(def markdown-mode-layer
  {:name 'markdown
   :file-pattern "\\.(md|markdown)$"
   :fontify 'editor/markdown/markdown-spans})

;; .md / .markdown files → the :markdown type, stacked over text-mode.
(register-language-mode 'modes/markdown-mode-layer :markdown)

;; ---- env-mode / docker-mode: more fontify-only language layers --------------
;; Two more language modes built the same way as markdown-mode — a layer whose only
;; service is a `:fontify` span fn from a pure std module (editor/dotenv, editor/
;; dockerfile). `.env` files and Dockerfiles keep every text-mode binding and gain
;; syntax colouring. The `:file-pattern` is matched against the file's basename, so a
;; bare `Dockerfile` / `.env` (no extension) triggers; both omit `:fontify-restart`
;; (line-oriented, no cross-line lexer state).

(def env-mode-layer
  {:name 'env
   ;; .env and its variants (.env.local, .env.production, …); the leading-dot name
   ;; carries no extension, so anchor on `.env` with an optional `.suffix`.
   :file-pattern "(^|/)\\.env(\\.[^/]+)?$"
   :fontify 'editor/dotenv/env-spans})

(register-language-mode 'modes/env-mode-layer :env)

(def docker-mode-layer
  {:name 'docker
   ;; `Dockerfile`, `Dockerfile.dev`, `*.dockerfile`, and Podman's `Containerfile`.
   :file-pattern "(^|/)(Dockerfile|Containerfile)([.][^/]+)?$|[.]dockerfile$"
   :fontify 'editor/dockerfile/dockerfile-spans})

(register-language-mode 'modes/docker-mode-layer :docker)

;; ---- ruby-mode / elixir-mode: tree-sitter-backed language modes -------------
;; The first modes whose parser is NOT Brood's reader: a `.rb`/`.ex` buffer gets
;; syntax colouring AND structural navigation from a tree-sitter grammar
;; (`tree-sitter-parse`), via `std/editor/treesit` — the foreign-language analogue
;; of brood-mode's `highlight`+`sexp`. The proof of ROADMAP §C: because the
;; builtin yields the SAME positioned-node shape Brood's reader does, the editor's
;; `:fontify` service and the `C-M-f/b/u/d/a` structural commands run over a Ruby
;; or Elixir tree unchanged — the modes are pure data (a face table + a `:ts-lang`
;; + a layer). `:fontify-restart` is omitted (tree-sitter is error-tolerant, so the
;; windowed lead-in slice re-establishes context); `:indent` is deferred (RET stays
;; the global newline; the editor falls back to matching the previous line).

;; (The `C-M-*` structural motions come from the shared `prog-mode-layer` above — ruby and
;; elixir stack it via `register-prog-mode`, and the commands dispatch on `:ts-lang`.)

;; Per-language kind→face tables name only the *named* nodes to colour; keywords
;; (anonymous alphabetic tokens — `def`/`end`/`do`/`fn`/…) come free via
;; `editor/treesit/face-of-syntax`. Refine a table by inspecting `(%tree-sitter-parse …)`.
(def ruby-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :heredoc_body :syntax/string
   :regex :syntax/string
   :simple_symbol :syntax/special
   :hash_key_symbol :syntax/special
   :delimited_symbol :syntax/special
   :integer :syntax/number
   :float :syntax/number
   :constant :syntax/special
   :instance_variable :syntax/function
   :global_variable :syntax/function
   :class_variable :syntax/function})
(def ruby-face-of (editor/treesit/face-of-syntax modes/ruby-face-table))
(defn ruby-fontify (text) (editor/treesit/fontify text :ruby modes/ruby-face-of))

(def ruby-mode-layer
  {:name 'ruby
   :parser :tree-sitter
   :ts-lang :ruby
   :file-pattern "\\.rb$"
   :fontify 'modes/ruby-fontify
   :comment-syntax "# "}) ; C-M-* structural motions inherited from prog-mode-layer
(register-prog-mode 'modes/ruby-mode-layer :ruby)

;; Elixir: def/defmodule are macros (parsed as calls, not keywords), so they
;; aren't keyword-coloured — `do`/`end`/`fn`/`when`/… are. Atoms and module
;; aliases read as `:special`.
(def elixir-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :charlist :syntax/string
   :sigil :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :atom :syntax/special
   :alias :syntax/special
   :keyword :syntax/special})
(def elixir-face-of (editor/treesit/face-of-syntax modes/elixir-face-table))
(defn elixir-fontify (text) (editor/treesit/fontify text :elixir modes/elixir-face-of))

(def elixir-mode-layer
  {:name 'elixir
   :parser :tree-sitter
   :ts-lang :elixir
   :file-pattern "\\.(ex|exs)$"
   :fontify 'modes/elixir-fontify
   :comment-syntax "# "}) ; C-M-* structural motions inherited from prog-mode-layer
(register-prog-mode 'modes/elixir-mode-layer :elixir)

;; ---- process-menu-mode: the read-only, killable *Process List* --------------
;; Emacs `process-menu-mode` (a `special-mode`): the generated `*Process List*`
;; buffer (commands/cmd-list-processes) is **read-only** — its `:activate` hook flips
;; the buffer's std/buffer read-only flag, so every text-edit command is refused —
;; and gains kill/refresh keys. It stacks over text-mode so motion (C-n/C-p, the
;; arrows, M-</M->) still navigates the rows. Stamped on the buffer by *type*
;; (`:process-menu`), not by filename: the list has no backing file.

(defn read-only-activate (buf)
  "An `:activate` hook that makes a generated report buffer read-only (special-mode
style) — its own keys act while text edits are refused (`ed-edit` reports it). Carried by
`special-mode-layer`, so every read-only generated buffer shares it."
  (editor/buffer/set-read-only buf true))

;; ---- special-mode: the shared base for read-only, generated buffers ---------
;; Emacs's `special-mode`, as a layer. The process menu, occur, dired, and the git
;; status/diff/log buffers are all read-only listings/reports with no line-number gutter;
;; each used to repeat those two facts. They now stack this base just above text-mode (so
;; motion still works) and drop their own copies. `init-buffer-layers` activates every layer
;; in a type's stack, so this layer's `:activate` (the read-only hook) fires at buffer
;; creation regardless of precedence. An *editable* generated buffer (e.g. *git-commit*)
;; doesn't use it — it wants only the no-gutter half, which it sets on its own layer.
(def special-mode-layer
  {:name 'special
   :no-line-numbers true
   :hooks {:activate '(modes/read-only-activate)}})

(def process-menu-keymap
  (-> {}
    ;; d / x / k — kill the process on the current line (Emacs process-menu `d`,
    ;; proced `x`; `k` as a kill mnemonic).
    (keymap-bind ["d"] 'commands/cmd-process-menu-kill)
    (keymap-bind ["x"] 'commands/cmd-process-menu-kill)
    (keymap-bind ["k"] 'commands/cmd-process-menu-kill)
    ;; g — refresh the snapshot (Emacs `revert-buffer` on a tabulated list).
    (keymap-bind ["g"] 'commands/cmd-process-menu-refresh)
    ;; t — toggle the tree (parent→child) vs flat (id-sorted) view.
    (keymap-bind ["t"] 'commands/cmd-process-menu-toggle-tree)))

(def process-menu-mode-layer
  {:name 'process-menu
   :keymap modes/process-menu-keymap
   :commands '("process-menu-kill" "process-menu-refresh" "process-menu-toggle-tree")})

;; :process-menu stacks process-menu-mode over special-mode (read-only + no gutter) over
;; text-mode (so motion still works); the list buffer gets it via `set-buffer-type` (see
;; commands/ed-show-named), no file.
(register-type-layers :process-menu
  (list 'modes/process-menu-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- report fontify: whole-line role faces ------------------------------------
;; Every report buffer (*Tests*, *Run*, *Debug*, *Spy*) colours whole lines by role;
;; this is the one accumulator behind them (git's status fontifier stays separate —
;; it produces multiple spans per line, a more general contract).

(defn fontify-line-faces (src line-face)
  "Whole-line spans for `src`: `line-face` is `(line-text) -> face|nil` per line. Spans are
`cons`'d and `reverse`d once (NOT `append`ed onto a growing accumulator, which recopies it
each line — O(n²) in the window). This is the shared fontify behind the streaming *Run*
(apprun) and *Spy*/*Debug* (debugger) buffers, so keeping it linear is what stops their
window re-fontify from lagging as output pours in."
  (letrec (go (fn (lines off acc)
                (if (empty? lines)
                  (reverse acc)
                  (let (line (first lines)
                        face (line-face line))
                    (go (rest lines)
                      (+ off (string/length line) 1)
                      (if (nil? face) acc (cons [off (+ off (string/length line)) face] acc)))))))
    (go (string/split src "\n") 0 '())))

;; ---- location-jump ----------------------------------------------------------
;; The shared "report row -> source" layer (`location-jump-layer`) + its location
;; vocabulary moved to `src/results.blsp` (the results-buffer abstraction). Modes stack
;; `results/location-jump-layer`; occur/git below keep their own `:on-click` commands.

;; ---- occur-mode: the read-only *Occur* results buffer -----------------------
;; The *Occur* buffer (commands/cmd-occur) lists matching lines; it's stamped :occur,
;; made read-only on activate (like the process list), and binds RET to jump to the
;; matching source line. Stacks over text-mode so motion (C-n/C-p, arrows) navigates rows.

(def occur-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-occur-jump)))

(def occur-mode-layer
  {:name 'occur
   :keymap modes/occur-keymap
   :on-click 'commands/cmd-occur-jump ; click = RET (the location-jump contract; occur
   ; rows are "N: text" line numbers, its own parser)
   :commands '("occur-jump")})

(register-type-layers :occur
  (list 'modes/occur-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- dired-mode: the read-only directory browser ----------------------------
;; The dired buffer (commands/cmd-dired) lists a directory; it's stamped :dired, made
;; read-only on activate, and its single-key bindings navigate (RET/f open, ^ up, g
;; refresh, q quit) and operate (+ mkdir, R rename, C copy, D delete). Stacks over
;; text-mode so n/p/arrows move between rows. The commands rebuild the listing via
;; ed-show-named rather than editing text, so they work on the read-only buffer.

(def dired-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-dired-open)
    (keymap-bind ["f"] 'commands/cmd-dired-open)
    (keymap-bind ["^"] 'commands/cmd-dired-up)
    (keymap-bind ["g"] 'commands/cmd-dired-refresh)
    (keymap-bind ["q"] 'commands/cmd-dired-quit)
    ;; line motion snaps point onto the filename (Emacs dired n/p/C-n/C-p/arrows)
    (keymap-bind ["n"] 'commands/cmd-dired-next-line)
    (keymap-bind ["p"] 'commands/cmd-dired-previous-line)
    (keymap-bind [:ctrl-n] 'commands/cmd-dired-next-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-dired-previous-line)
    (keymap-bind [:down] 'commands/cmd-dired-next-line)
    (keymap-bind [:up] 'commands/cmd-dired-previous-line)
    (keymap-bind ["+"] 'commands/cmd-dired-create-dir)
    (keymap-bind ["R"] 'commands/cmd-dired-rename)
    (keymap-bind ["C"] 'commands/cmd-dired-copy)
    ;; marking (emacs dired): m mark, u unmark, U unmark-all, t toggle; x/D delete
    ;; (the marked set, else the entry under point).
    (keymap-bind ["m"] 'commands/cmd-dired-mark)
    (keymap-bind ["u"] 'commands/cmd-dired-unmark)
    (keymap-bind ["U"] 'commands/cmd-dired-unmark-all)
    (keymap-bind ["t"] 'commands/cmd-dired-toggle-marks)
    (keymap-bind ["x"] 'commands/cmd-dired-delete)
    (keymap-bind ["D"] 'commands/cmd-dired-delete)))

(def dired-mode-layer
  {:name 'dired
   :keymap modes/dired-keymap
   :commands '("dired-open" "dired-up"
                "dired-refresh" "dired-quit" "dired-create-dir" "dired-rename" "dired-copy"
                "dired-delete" "dired-mark" "dired-unmark" "dired-unmark-all" "dired-toggle-marks"
                "dired-next-line" "dired-previous-line")
   :fontify 'commands/dired-fontify})

(register-type-layers :dired
  (list 'modes/dired-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- git (the *git-status* porcelain + its diff/log/commit buffers) ---------

(def git-status-keymap
  (-> {}
    (keymap-bind [:enter] 'git/cmd-git-show-diff) ; RET — preview diff or show commit
    (keymap-bind [:tab] 'git/cmd-git-expand) ; TAB — expand file hunks / collapse section
    (keymap-bind ["d"] 'git/cmd-git-diff) ; d — diff in *git-diff*, whole pane
    (keymap-bind ["s"] 'git/cmd-git-stage) ; s — stage file or hunk under point
    (keymap-bind ["S"] 'git/cmd-git-stage-all) ; S — stage all modified tracked files
    (keymap-bind ["u"] 'git/cmd-git-unstage) ; u — unstage file or hunk under point
    (keymap-bind ["U"] 'git/cmd-git-unstage-all) ; U — unstage everything staged
    (keymap-bind ["k"] 'git/cmd-git-discard) ; k — discard file or hunk under point
    (keymap-bind ["c"] 'git/cmd-git-commit) ; c — open commit message buffer
    (keymap-bind ["a"] 'git/cmd-git-commit-amend) ; a — amend last commit
    (keymap-bind ["g"] 'git/cmd-git-refresh)
    (keymap-bind ["q"] 'git/cmd-git-quit)
    (keymap-bind ["l"] 'git/cmd-git-log)
    (keymap-bind ["P"] 'git/cmd-git-push)
    (keymap-bind ["F"] 'git/cmd-git-pull)
    (keymap-bind ["z" "z"] 'git/cmd-git-stash) ; z z — stash push
    (keymap-bind ["z" "p"] 'git/cmd-git-stash-pop) ; z p — stash pop
    (keymap-bind ["b" "b"] 'git/cmd-git-checkout) ; b b — checkout branch
    (keymap-bind ["b" "c"] 'git/cmd-git-create-branch) ; b c — create & checkout branch
    ;; n/p jump between actionable rows (skipping diff-body lines); arrows/C-n/C-p line-by-line
    (keymap-bind ["n"] 'git/cmd-git-next-item)
    (keymap-bind ["p"] 'git/cmd-git-prev-item)
    (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)
    (keymap-bind [:up] 'commands/cmd-previous-line)))

(def git-status-mode-layer
  {:name 'git-status
   :keymap modes/git-status-keymap
   :commands '("git-stage" "git-stage-all"
                "git-unstage" "git-unstage-all" "git-discard" "git-commit" "git-commit-amend"
                "git-refresh" "git-quit" "git-diff" "git-show-diff" "git-log" "git-push" "git-pull"
                "git-expand" "git-visit" "git-stash" "git-stash-pop" "git-next-item" "git-prev-item"
                "git-checkout" "git-create-branch")
   :on-click 'git/cmd-git-visit
   ;; the SHARED results link mechanism: file rows carry a pointer cursor + hover underline
   ;; and RET/click visits them — reading the off-text `:line-links` git stashes on the buffer,
   ;; exactly like *Tests* (`:line-loc 'results/line-links-loc`).
   :line-loc 'results/line-links-loc
   :fontify 'git/git-status-fontify})

(register-type-layers :git-status
  (list 'modes/git-status-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; ---- packages (the *Packages* browser — M-x package-list) -------------------
(def packages-keymap
  (-> {}
    (keymap-bind ["i"] 'packages/cmd-package-install) ; i — install the package under point
    (keymap-bind ["d"] 'packages/cmd-package-remove) ; d — remove it
    (keymap-bind ["u"] 'packages/cmd-package-update) ; u — update it to the newest version
    (keymap-bind ["g"] 'packages/cmd-package-refresh) ; g — re-fetch the list from the hive
    (keymap-bind ["q"] 'packages/cmd-package-quit) ; q — bury the buffer
    (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)
    (keymap-bind [:up] 'commands/cmd-previous-line)))

(def packages-mode-layer
  {:name 'packages
   :keymap modes/packages-keymap
   :commands '("package-install" "package-remove"
                "package-update" "package-refresh" "package-quit")})

(register-type-layers :packages
  (list 'modes/packages-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; *git-diff* / *git-log* — read-only report buffers. The diff keymap is just q-to-quit;
;; the log keymap adds RET (show commit) and n/p navigation.
(def git-report-keymap
  (-> {}
    (keymap-bind ["q"] 'git/cmd-git-quit)))

(def git-log-keymap
  (-> {}
    (keymap-bind ["q"] 'git/cmd-git-quit)
    (keymap-bind [:enter] 'git/cmd-git-show-commit) ; RET — git show <hash> at point
    (keymap-bind ["n"] 'commands/cmd-next-line)
    (keymap-bind ["p"] 'commands/cmd-previous-line)
    (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)
    (keymap-bind [:up] 'commands/cmd-previous-line)))

(def git-diff-mode-layer
  {:name 'git-diff
   :keymap modes/git-report-keymap
   :commands '("git-quit")
   :fontify 'git/git-diff-fontify})

(def git-log-mode-layer
  {:name 'git-log
   :keymap modes/git-log-keymap
   :commands '("git-quit" "git-show-commit")
   :fontify 'git/git-log-fontify})

(register-type-layers :git-diff
  (list 'modes/git-diff-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
(register-type-layers :git-log
  (list 'modes/git-log-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))

;; *git-commit* — EDITABLE (you type the message); no read-only hook. C-c C-c / C-c C-k.
(def git-commit-keymap
  (-> {}
    (keymap-bind [:ctrl-c :ctrl-c] 'git/cmd-git-commit-finish)
    (keymap-bind [:ctrl-c :ctrl-k] 'git/cmd-git-commit-abort)))

(def git-commit-mode-layer
  {:name 'git-commit
   :keymap modes/git-commit-keymap
   :no-line-numbers true
   :commands '("git-commit-finish" "git-commit-abort")})

(register-type-layers :git-commit (list 'modes/git-commit-mode-layer 'modes/text-mode-layer))
