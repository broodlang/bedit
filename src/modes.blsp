(defmodule modes
  "The editor's modes, as **layers** (`editor/layers`). A *mode* is a layer — a named
bundle of a keymap, hooks and language services — that a buffer carries; dispatch composes
the active buffer's layers (see `input`). This decouples \"which keys do what\" from the
dispatch loop and makes it per-buffer: a `.blsp` buffer gets a `brood-mode` layer
(structural sexp nav + C-x C-e) stacked on, while a plain buffer stays in `text-mode`.

`text-mode` is the **default**: it's registered for the `:fundamental` type, which
`layers/buffer-type-for` returns for any buffer with no matching filename and no
explicit `:type`. Its keymap holds the editor's bindings — data, built with
`keymap-bind` (which nests prefix sub-keymaps for chords like `C-x C-e`); command
values are quoted, fully-qualified symbols resolved with `(reflect/eval sym)` at dispatch,
so redefining a command or rebinding a key hot-swaps behaviour live.

This module is the mode INFRASTRUCTURE — text-mode, the shared `prog` base and the two
registration helpers every language mode goes through (`register-language-mode`,
`register-prog-mode`) — plus the generic read-only buffer modes (special, help, occur,
markdown, …). The languages live beside it: `brood-mode`, the other Lisps (`lisp-modes`),
the tree-sitter and config-format modes (the `lang-*` files over `language-core`); the
line-number gutter they all draw is `gutter`."
  (:use ownership :only []) ; its registrations are claimed at load
  (:use editor/layers)
  (:use editor/keymap)
  (:use interactive) ; defcommand — a welcome link's click
  (:use theme)) ; *blue* — the welcome links
;; regex (file-type trigger), lex-markdown, editor/highlight and model are referenced
;; qualified below — each `mod/name` auto-loads its module.
;; The universal keybindings are a keybinding *profile* on the MODEL scope (`keymaps`), not
;; a layer pinned to every buffer, so a second profile (vim) can replace them. This module
;; keeps the per-buffer *mode* layers (text/markdown/special/…) — mode-specific keys.

;; text-mode is the visible default major: it names the mode for plain buffers (its
;; bindings are the global layer's) and carries the line-number gutter service. It's
;; the layer for `:fundamental`, the type `buffer-type-for` falls back to.
(def text-mode-layer
  {:name 'text
   :doc "Ordinary text: the movement, editing and selection every buffer has."
   :keymap {}
   ;; prose has no segments: Tab completes a word whole (`complete-at-point/complete-step`)
   :completion-separators #{}
   ;; prose completes on demand (Tab, M-TAB): the auto popup is a code mode's
   ;; (`complete-at-point/completion-auto-for?`, the user's per-mode `:completion-auto` first)
   :completion-auto false
   :gutter-width 'gutter/line-number-width
   :gutter-cell 'gutter/line-number-cell})
(register-type-layers :fundamental (list 'modes/text-mode-layer))

;; welcome-mode: the startup scratch (`main/*welcome*`). An ordinary EDITABLE text
;; buffer whose mode adds exactly one affordance: the link lines (the bedit
;; tutorial, the Brood playground) are clickable — `:line-loc` truthy on a link
;; line gives it the pointer cursor + hover underline (the shared link affordance
;; in `view`), `:on-click` runs that line's command, and a line face paints it
;; link-blue. Type over them and it's just a scratch.

(def *welcome-links*
  ;; marker substring → the (deferred-loaded) command a click on that line runs.
  ;; What `welcome-line-loc` matches and `modes/cmd-welcome-link` dispatches on.
  [["interactive bedit tutorial" 'tutor/cmd-tutorial]
    ["Brood playground" 'playground/cmd-brood-playground]])

(defn welcome-link-at (line)
  "The `[marker command]` entry of `*welcome-links*` whose marker `line` contains,
or nil for a plain line."
  (seq/find modes/*welcome-links* (fn (link) (includes? line (first link)))))

(defn welcome-line-loc (buffer line-index)
  "Truthy on a welcome-buffer link line — the link affordance hook (this
'location' is consumed by `modes/cmd-welcome-link`, never visited as a file)."
  (when-let (link (welcome-link-at (editor/buffer/buffer-line-at buffer line-index)))
    {:welcome (second link)}))

(defn welcome-fontify (src)
  "welcome-mode's `:fontify`: each link line whole in the link colour."
  (fontify-line-faces src
    (fn (line) (when (welcome-link-at line) {:fg *blue*}))))

(def welcome-mode-layer
  {:name 'welcome
   :doc "The startup screen — RET follows the link under point."
   :keymap {}
   :fontify 'modes/welcome-fontify
   :line-loc 'modes/welcome-line-loc
   :on-click 'modes/cmd-welcome-link})

(register-type-layers :welcome (list 'modes/welcome-mode-layer 'modes/text-mode-layer))

;; ---- mode registrations a package can take back -----------------------------
;; A package's mode must not outlive the package: its file type would still match, and a
;; buffer of it be seeded with layers whose globals were gone. So the three registrations
;; below are CLAIMED (`ownership`) and removing the package releases them, through `editor/layers`'
;; unregister calls: the type maps to no layers again (or to the layers a core mode had
;; before the package replaced them), its file pattern stops matching, its interpreter names
;; nothing.
;;
;; Each type gets ONE std file rule, installed the first time the type is registered, that
;; reads the type's pattern from the claimed `:modes/file-patterns` registry when it runs: a
;; package update that changes its pattern replaces the pattern, not the rule, and releasing
;; the pattern disarms it.

(defn- type-layers-lookup (type)
  (let (refs (layers-for-type type)) [(not (empty? refs)) refs]))

(ownership/define-kind :modes/type-layers
  type-layers-lookup register-type-layers unregister-type-layers)

(defn- interpreter-lookup (program)
  (let (type (get editor/layers/*auto-type-by-interpreter* program)) [(not (nil? type)) type]))

(ownership/define-kind :modes/interpreters
  interpreter-lookup register-interpreter-type unregister-interpreter-type)

(defn register-type (type layer-refs)
  "Bind buffer `type` to `layer-refs` (highest precedence first), as `editor/layers`'
`register-type-layers` does — claimed, so a package's type goes back with the package."
  (ownership/claim! :modes/type-layers type layer-refs))

(defn register-interpreter (program type)
  "Type a file whose `#!` line names `program` as `type` (std's `register-interpreter-type`)
— claimed, so a package's goes back with the package."
  (ownership/claim! :modes/interpreters program type))

(defn mode-names ()
  "The name of every mode a registered buffer type stacks, as a set of strings (`\"text\"`,
`\"prog\"`, `\"elixir\"`): what a per-mode init.blsp setting may be keyed by, since a key
reaches a buffer through its layers' names (`conventions/mode-key`). A layer whose module is
not loaded is left out."
  (fold (vals editor/layers/*type-layers*)
    #{}
    (fn (names refs)
      (fold refs
        names
        (fn (acc ref)
          (let (layer (cond
                        (map? ref) ref
                        (and (symbol? ref) (bound? ref)) (reflect/eval ref)
                        else nil))
            (if (and (map? layer) (:name layer)) (conj acc (->string (:name layer))) acc)))))))

(defn file-type-pattern (type)
  "The file-name regex buffers of `type` are matched with, or nil when none is registered
(never, or its package was removed)."
  (registry/lookup :modes/file-patterns type))

(defn register-file-pattern (type pattern)
  "Type a file whose name matches the regex `pattern` as `type` — claimed, so a package's
pattern stops matching when the package goes. The std rule behind it is installed once per
type and reads the pattern when it runs."
  (ownership/claim! :modes/file-patterns type pattern)
  (when (nil? (registry/lookup :modes/file-rules type))
    (registry/put! :modes/file-rules type true)
    (register-file-type (fn (file)
                          (let (current (file-type-pattern type))
                            (and (not (nil? current)) (regex/match? current file))))
      type)))

(defn- modes-register-with-layers (layer-ref type layers)
  (register-type type layers)
  (register-file-pattern type (:file-pattern (reflect/eval layer-ref))))

(defn register-language-mode (layer-ref type)
  "Register a language mode that stacks over text-mode: bind `type` to `[layer
text-mode]` (head = higher precedence) and route the layer's `:file-pattern` regex to
that type. The shared shape every fontify-only language mode registers through — markdown,
org, the `deflexer` formats; a code mode goes through `register-prog-mode`."
  (modes-register-with-layers layer-ref type (list layer-ref 'modes/text-mode-layer)))

;; ---- the special buffer TYPE: one feature layer over special-mode over text-mode ----
;; Every generated report (*Debug*, *Run*, *Packages*, the BEAM views, dired, …) has the
;; same stack, and its layer's `:commands` are its keymap's command names. `:commands` is
;; what M-x offers ONLY in that buffer (and subtracts from the global set —
;; `model/ed-all-layer-commands`), so a hand list that drifted from the keymap would silently
;; move commands in or out of M-x. Both are derived here.

(defn layer-commands (keymap &optional (options {}))
  "The M-x names a mode layer claims for `keymap` (its `:commands` facet): every command
the keymap binds, named as M-x names it (`interactive/command-friendly-name` of the
symbol's last segment, `dired/cmd-dired-up` → `\"dired-up\"`), sorted. `options` makes a
deliberate difference explicit — `:extra`, names claimed though no key here runs them;
`:except`, names bound here but left in the GLOBAL M-x set (a shared motion such as
`next-line`, which claiming would hide from every other buffer).

    (modes/layer-commands {\"g\" 'beam/cmd-beam-refresh})   ;=> (\"beam-refresh\")"
  (let ({:keys [extra except]} options
        bound (map (or (editor/keymap/keymap-commands keymap) '())
                (fn (sym)
                  (interactive/command-friendly-name (last (string/split (->string sym) "/")))))
        dropped (into #{} (or except '())))
    (sort (seq/distinct (append (seq/reject bound (fn (name) (contains? dropped name)))
                          (or extra '()))))))

(defn register-special-type (type & layer-refs)
  "Bind buffer `type` to `layer-refs` (highest precedence first) stacked over
`special-mode-layer` (read-only, no gutter, `q` buries) over `text-mode-layer` (so motion
still walks the rows) — the shape every generated report buffer has.

    (register-special-type :run-log 'apprun/run-log-mode-layer 'results/location-jump-layer)"
  (register-type type
    (append layer-refs (list 'modes/special-mode-layer 'modes/text-mode-layer))))

;; ---- the shared `prog` base: structural navigation every code mode inherits -----
;; The `C-M-f/b/u/d/a` motions are identical across languages — only the *parser* differs.
;; So they live on one base layer (`prog-mode-layer`) that code modes stack between their
;; language layer and text-mode, and the commands (`structural/cmd-forward-sexp` …) dispatch on
;; the buffer's `:ts-lang` (Brood CST vs tree-sitter — see `structural/ed-structural`). A new
;; language inherits the keys for free and overrides only the parser/faces — the "default +
;; override" model. Paredit (slurp/barf/…) stays Brood-only (a Lisp-delimiter edit), so it
;; lives on `brood-keymap`, not here.
(def prog-structural-keymap
  (-> {}
    ;; RET auto-indents the new line, through whatever `:indent` service the language
    ;; supplies — which is the same "identical key, different parser" shape as the motions
    ;; below, so it belongs here rather than on one language's keymap.
    (keymap-bind [:enter] 'indent/cmd-newline-and-indent)
    ;; Emacs's hideshow on C-c @ — fold the block at point, or every top-level one (`codefold`)
    (keymap-bind [:ctrl-c "@" :ctrl-c] 'codefold/cmd-hs-toggle-hiding)
    (keymap-bind [:ctrl-c "@" :ctrl-h] 'codefold/cmd-hs-hide-block)
    (keymap-bind [:ctrl-c "@" :ctrl-s] 'codefold/cmd-hs-show-block)
    (keymap-bind [:ctrl-c "@" :ctrl-meta-h] 'codefold/cmd-hs-hide-all)
    (keymap-bind [:ctrl-c "@" :ctrl-meta-s] 'codefold/cmd-hs-show-all)
    (keymap-bind [:ctrl-meta-f] 'structural/cmd-forward-sexp) ; C-M-f forward-sexp
    (keymap-bind [:ctrl-meta-b] 'structural/cmd-backward-sexp) ; C-M-b backward-sexp
    ;; the sexp/list pair: C-M-f/b stop at every form, C-M-n/p only at whole LISTS —
    ;; the "jump the next block" motion (Emacs forward-list / backward-list).
    (keymap-bind [:ctrl-meta-n] 'structural/cmd-forward-list) ; C-M-n forward-list
    (keymap-bind [:ctrl-meta-p] 'structural/cmd-backward-list) ; C-M-p backward-list
    ;; C-M-u is Emacs' `backward-up-list`; its forward twin (`up-list`) has no default
    ;; key there either — it's M-x up-list, and rebindable like anything else.
    (keymap-bind [:ctrl-meta-u] 'structural/cmd-backward-up-list) ; C-M-u backward-up-list
    (keymap-bind [:ctrl-meta-d] 'structural/cmd-down-list) ; C-M-d down-list
    (keymap-bind [:ctrl-meta-a] 'structural/cmd-beginning-of-defun) ; C-M-a beginning-of-defun
    (keymap-bind [:ctrl-meta-e] 'structural/cmd-end-of-defun) ; C-M-e end-of-defun
    ;; C-M-SPC (also C-M-@) — mark the next sexp, extending on repeat. Key encoding for
    ;; the space chord mirrors C-SPC's `"ctrl- "`; both spellings bound to be safe. It
    ;; rides the same polymorphic motion as C-M-f, so it marks a tree-sitter node in a
    ;; tree-sitter mode.
    (keymap-bind [(keyword "ctrl-meta- ")] 'structural/cmd-mark-sexp) ; C-M-SPC
    (keymap-bind [(keyword "ctrl-meta-@")] 'structural/cmd-mark-sexp) ; C-M-@
    ;; the structural kills + whole-form reindent: they ride the motions above, so they
    ;; work over a tree-sitter tree too and belong here rather than on brood-keymap.
    (keymap-bind [:ctrl-meta-k] 'killing/cmd-kill-sexp) ; C-M-k kill-sexp
    (keymap-bind [(keyword "ctrl-meta-backspace")]
      'killing/cmd-backward-kill-sexp) ; C-M-DEL backward-kill-sexp
    (keymap-bind [:ctrl-meta-q] 'indent/cmd-indent-sexp))) ; C-M-q indent-sexp
(def prog-mode-layer
  {:name 'prog
   :keymap modes/prog-structural-keymap
   ;; code scrolls sideways: a wrapped line of code reads as two statements, and its
   ;; indentation stops lining up. Every code mode stacks over this layer, so this is the
   ;; one place that says so; a language layer above it, the user's `:long-lines {prog …}`
   ;; or M-x visual-line-mode still say otherwise (`scroll/ed-long-lines`)
   :long-lines :scroll
   ;; code divides a name into segments — `XB.Tool.call`, `mod/name`, `std::fs` — and Tab
   ;; completes one at a time (`complete-at-point/complete-step`)
   :completion-separators #{"." "/" ":"}
   ;; and the completion card opens on its own after a pause in typing (Corfu's
   ;; `corfu-auto` on a `prog-mode-hook`)
   :completion-auto true
   :commands '("forward-sexp" "backward-sexp"
                "forward-list" "backward-list" "up-list" "backward-up-list" "down-list"
                "beginning-of-defun" "end-of-defun" "kill-sexp" "backward-kill-sexp" "indent-sexp")})

(defn register-prog-mode (layer-ref type)
  "Like `register-language-mode`, but for a **code** mode: it stacks the shared
`prog-mode-layer` (the `C-M-*` structural motions) between the language layer and text-mode,
so every code language inherits the same navigation keys and overrides only its parser/faces."
  (modes-register-with-layers layer-ref
    type
    (list layer-ref 'modes/prog-mode-layer 'modes/text-mode-layer)))

;; ---- markdown-mode: Markdown (.md) source, stacked on text-mode -------------
;; A `.md` buffer keeps every text-mode motion/edit binding and the line-number gutter, and
;; gains Markdown syntax colouring from `lex-markdown`'s pure `markdown-spans`, the preview
;; (C-c C-p) and Markdown's fill and pairing rules. The only state the lexer carries between
;; lines is "inside a fenced code block", which makes it a LINE LEXER (`:line-lexer`, brood
;; ADR-471): the pane keeps every line's spans and fence state (`linecache`), so a key
;; re-lexes the lines it touched. `:fontify-restart` still serves the long-line slice path:
;; the band's own first line is a safe start unless a fence above it is still open, and then
;; the fence's line is.
;;
;; A fence whose info string names a language (```python) is coloured as that language,
;; over the whole fence (brood ADR-489, `lex-markdown/markdown-fence-pass`): the line lexer
;; marks the body lines, and `:line-band-pass` swaps them for the body parsed as one
;; document, with the embedded language's own mode's face table. A language with no grammar
;; installed keeps the one code colour.
(defn language-faces (lang)
  "The face table of the `deflanguage` whose grammar is `lang`, or nil when none is
registered — an embedded language with no table keeps its host's colours. Here rather than in
`language-core`, which stands on this module: the registry is read by name, and modes
stay below the languages."
  (let (spec-ref (registry/lookup :languages/specs lang))
    (when spec-ref (get (reflect/eval spec-ref) :faces))))

(defn markdown-fontify (src)
  "markdown-mode's `:fontify`: `lex-markdown/markdown-spans` with each fence coloured as
its language, by that language's registered face table."
  (lex-markdown/markdown-spans src language-faces))

(defn markdown-fence-pass (rope spans)
  "markdown-mode's `:line-band-pass`: a line band's fences coloured as their languages
(`lex-markdown/markdown-fence-pass`)."
  (lex-markdown/markdown-fence-pass rope spans language-faces))

(def markdown-keymap
  ;; C-c C-p: the rendered preview beside the buffer (`mdpreview`; the symbol is resolved
  ;; at dispatch, so the module loads on the first press)
  (-> {}
    (keymap-bind [:ctrl-c :ctrl-p] 'mdpreview/cmd-markdown-preview)))

(def markdown-mode-layer
  {:name 'markdown
   :file-pattern "\\.(md|markdown)$"
   :fontify 'modes/markdown-fontify
   :line-lexer 'lex-markdown/markdown-line-lexer
   :line-band-pass 'modes/markdown-fence-pass
   :fontify-restart 'lex-markdown/markdown-fontify-restart
   ;; prose wraps by default (Emacs users turn `visual-line-mode` on for markdown; here the
   ;; mode declares it — `M-x visual-line-mode` still toggles it off per buffer)
   :long-lines :wrap
   ;; a backtick opens inline code (`electric`), beside the brackets and `"`
   :electric-pairs [["(" ")"] ["[" "]"] ["{" "}"] ["\"" "\""] ["`" "`"]]
   ;; a fence spans lines, inline code and a prose quote close on their line (`stringstate`)
   :string-syntax {:strings [{:open "```" :multiline true :raw true}
                              {:open "`" :raw true}
                              {:open "\""}]}
   ;; a fence line, a table row and a heading are never filled into the text around them (`fill`)
   :fill-separate "^([ \t]*(```|~~~|\\|)|#{1,6}[ \t])"
   ;; only a quote's `>` is a marker in Markdown: `#` begins a heading (`fill`)
   :fill-markers [">"]
   ;; M-x yank-media: a clipboard image saved beside the file, `![](name.png)` at point
   :yank-media 'yankmedia/markdown-yank-media
   :keymap modes/markdown-keymap
   :commands '("markdown-preview")
   ;; the preview follows the cursor as it moves, re-renders on the idle beat, and goes
   ;; with the buffer — all three hooks are `mdpreview`'s, loaded on first use
   :on-move 'mdpreview/markdown-on-move
   :on-idle 'mdpreview/markdown-on-idle
   :hooks {:on-close '(mdpreview/markdown-on-close)}})

;; .md / .markdown files → the :markdown type, stacked over text-mode.
(register-language-mode 'modes/markdown-mode-layer :markdown)
;; `M-x markdown-preview` before any `.md` buffer has loaded the module: declared, so the
;; name is known and the module loads on demand (the profile keymaps get this for free
;; in `keymaps`; a mode keymap's commands declare themselves here).
(interactive/register-deferred 'mdpreview/cmd-markdown-preview)

;; The preview pane itself: read-only rendered text, no line numbers (it is not a file),
;; its faces served from the buffer's `:face-spans` data rather than a `:fontify` lexer.
(def markdown-preview-layer {:name 'markdown-preview :no-line-numbers true})

(register-special-type :markdown-preview 'modes/markdown-preview-layer)

;; ---- special-mode: the shared base for read-only, generated buffers ---------
;; Emacs's `special-mode`, as a layer. The process menu, occur, dired, and the git
;; status/diff/log buffers are all read-only listings/reports with no line-number gutter;
;; they stack this base just above text-mode (so motion still works). `init-buffer-layers`
;; activates every layer in a type's stack, so this layer's `:activate` (the read-only hook)
;; fires at buffer creation regardless of precedence. An *editable* generated buffer (e.g.
;; *git-commit*) doesn't use it — it wants only the no-gutter half, which it sets on its own
;; layer.

(defn read-only-activate (buffer)
  "An `:activate` hook that makes a generated report buffer read-only (special-mode
style) — its own keys act while text edits are refused (`ed-edit` reports it). Carried by
`special-mode-layer`, so every read-only generated buffer shares it."
  (editor/buffer/set-read-only buffer true))

(def special-keymap
  ;; `q` buries the buffer, as it does in every Emacs special-mode buffer. It lives HERE
  ;; rather than on each mode so no generated buffer can miss it — a read-only buffer you
  ;; cannot leave the way every other one leaves is the kind of gap nobody files and
  ;; everybody works around with C-x k.
  ;;
  ;; A mode stacking ABOVE this one still binds its own `q` and wins (dired's quits dired);
  ;; this is only the floor.
  (-> {} (keymap-bind ["q"] 'pool/cmd-kill-buffer)))

(def special-mode-layer
  {:name 'special
   :doc "A generated, read-only buffer — q buries it, and nothing you type here edits it."
   :keymap modes/special-keymap
   :no-line-numbers true
   ;; Emacs's special-mode: C-x C-q flips the flag and `q` still buries (`writable-policy`)
   :writable :toggle
   :hooks {:activate '(modes/read-only-activate)}})

;; ---- editability: the :writable facet (C-x C-q) -------------------------------
;; How a buffer becomes writable is its MODE's answer, not a flag flipped under whatever keys
;; the mode binds: flipping a Dired listing writable left `m` marking a file. So C-x C-q (and
;; M-x toggle-read-only) asks the buffer's layers for `:writable` (`editing/cmd-toggle-read-only`):
;;
;;   :toggle               the plain flag (Emacs's read-only-mode). The mode's keys stay
;;                         commands: *Help*'s `q` still buries, as Emacs keeps special-mode's map.
;;   {:enter command}      an EDIT VARIANT: C-x C-q runs `command`, which switches the buffer to
;;                         a type whose layers bind no letter (`editspans/begin`).
;;   {:commit c :abort a}  the variant itself: C-x C-q leaves it — at once when nothing changed,
;;                         else asking whether to apply (`c`) or put back (`a`) —
;;                         `editspans/leave`, as Emacs's wdired-exit and wgrep-exit.
;;   {:never why}          refused, saying `why`: the text renders something else.
;;
;; No layer declaring it is `:toggle` — right for text and code, whose letters type. A layer
;; that binds a printable key to a command must declare it, at or above itself, so a new mode
;; with letter keys cannot inherit the toggle by accident (tests/writable_test.blsp enumerates
;; every type). The decisions, by type:
;;
;;   :toggle   special-mode and everything only it gives letters (*Help*, *compilation*,
;;             *Spy*, *Diagnostics*, the preview panes) — Emacs special-mode; the process and
;;             buffer menus, *Packages*, *Package Diff*, *Kill Ring*, *Debug*, *Tests*, *Run*,
;;             *Project Diagnostics*, the BEAM views — Emacs's tabulated-list / special-mode;
;;             the git and mur views, the process log and the time machine's info pane —
;;             magit-mode is special-mode; *git-rebase-todo* — Magit's git-rebase-mode is
;;             special-mode, its verbs edit through the flag (inhibit-read-only)
;;   {:enter}  Dired → wdired (Emacs's dired-toggle-read-only); *Occur* → occur-edit (Emacs
;;             toggles the flag under occur's keys, the very bug, so here it is its `e`);
;;             *Project Search* → wgrep's edit (wgrep's C-c C-p, its C-x C-q setup)
;;   {:commit} wdired, occur-edit, the *Project Search* edit
;;   {:never}  the hex view (Emacs's hexl edits the bytes; ours is xxd text, `:no-write`), the
;;             image view and the document view (their text is a stand-in for the picture)
;;   default   text, every language, *git-commit*, *Bug Report*, the shell, terminals, the
;;             tutorial and playgrounds — no printable key bound to a command

(defn writable-policy (buffer)
  "How `buffer` becomes writable, by its mode's `:writable` facet (the table above): `:toggle`,
`{:enter command}`, `{:commit command :abort command}` or `{:never why}`. `:toggle` when no layer
says.

    (modes/writable-policy {:layers (list {:name 'a})})   ;=> :toggle"
  (or (layer-facet buffer :writable) :toggle))

;; ---- help-mode: the C-h report buffers (`help`) -----------------------------
;; *Bindings* / *Modes* / *Apropos* / *Lossage* / *Help*. Read-only generated text with
;; no rows to act on, so it needs no keymap of its own — the type exists so those buffers
;; get `special-mode`'s read-only + no-gutter treatment and say what they are in the mode
;; line, rather than arriving as anonymous `:fundamental` text.
(def help-mode-layer
  {:name 'help
   :doc "A help report (C-h) — what is bound, what is on, what a name means."})

(register-special-type :help 'modes/help-mode-layer)

;; ---- process-menu-mode: the read-only, killable *Process List* --------------
;; Emacs `process-menu-mode` (a `special-mode`): the generated `*Process List*` buffer
;; (process-list/cmd-list-processes) is read-only and gains kill/refresh keys. Stamped on the
;; buffer by *type* (`:process-menu`), not by filename: the list has no backing file.

(def process-menu-keymap
  (-> {}
    ;; d / x / k — kill the process on the current line (Emacs process-menu `d`,
    ;; proced `x`; `k` as a kill mnemonic).
    (keymap-bind ["d"] 'process-list/cmd-process-menu-kill)
    (keymap-bind ["x"] 'process-list/cmd-process-menu-kill)
    (keymap-bind ["k"] 'process-list/cmd-process-menu-kill)
    ;; g — refresh the snapshot (Emacs `revert-buffer` on a tabulated list).
    (keymap-bind ["g"] 'process-list/cmd-process-menu-refresh)
    ;; t — toggle the tree (parent→child) vs flat (id-sorted) view.
    (keymap-bind ["t"] 'process-list/cmd-process-menu-toggle-tree)))

(def process-menu-mode-layer
  {:name 'process-menu
   :doc "The running processes — d/x/k kills the one on this line, g refreshes."
   :keymap modes/process-menu-keymap
   :writable :toggle
   :commands (layer-commands modes/process-menu-keymap)})

;; :process-menu stacks process-menu-mode over special-mode (read-only + no gutter) over
;; text-mode (so motion still works); the list buffer gets it via `set-buffer-type` (see
;; pool/ed-show-named), no file.
(register-special-type :process-menu 'modes/process-menu-mode-layer)

;; ---- buffer-menu-mode: the *Buffer List* (C-x C-b) ----------------------------
(def buffer-menu-keymap
  (-> {}
    ;; RET — visit the buffer on this row (Emacs `Buffer-menu-this-window`)
    (keymap-bind [:enter] 'commands/cmd-buffer-menu-select)
    ;; g — rebuild the listing
    (keymap-bind ["g"] 'commands/cmd-buffer-menu-refresh)))

(def buffer-menu-mode-layer
  {:name 'buffer-menu
   :doc "The open buffers — RET selects the one on this line."
   :keymap modes/buffer-menu-keymap
   :writable :toggle
   :commands (layer-commands modes/buffer-menu-keymap)})

;; :buffer-menu stacks over special-mode (read-only + no gutter, `q` quits) over
;; text-mode, like the process list; the buffer gets it via `set-buffer-type`.
(register-special-type :buffer-menu 'modes/buffer-menu-mode-layer)

;; ---- report fontify: spans per line ------------------------------------------
;; Every line-structural fontifier (*Tests*, *Run*, *Debug*, *Spy*, dired, the hex view,
;; *Project Search*) walks the slice line by line, threading the line's offset; this is
;; the one accumulator behind them all, git's diff and process buffers included.

(defn fontify-lines (src line-spans)
  "`[start end face]` spans for `src`, built a line at a time: `line-spans` is
`(line-text offset) -> spans` (a list or vector, possibly empty), `offset` being where the
line starts in `src`. Line-structural, so the windowed slice the view hands a `:fontify`
service colours correctly wherever it starts. Spans are `cons`'d and `reverse`d once (NOT
`append`ed onto a growing accumulator, which recopies it each line — O(n²) in the window):
the streaming *Run* / *Spy* / *Tests* buffers re-fontify their window on every append, so
keeping this linear is what stops them lagging as output pours in.

    (modes/fontify-lines \"ab\\ncd\" (fn (line offset) [[offset (inc offset) :x]]))   ;=> ([0 1 :x] [3 4 :x])"
  (letrec (go (fn (lines offset acc)
                (if (empty? lines)
                  (reverse acc)
                  (let (line (first lines))
                    (go (rest lines)
                      (+ offset (string/length line) 1)
                      (fold (line-spans line offset) acc (fn (spans span) (cons span spans))))))))
    (go (string/split src "\n") 0 '())))

(defn fontify-line-faces (src line-face)
  "Whole-line spans for `src`: `line-face` is `(line-text) -> face|nil` per line — the
`fontify-lines` of a report that colours each line by its role."
  (fontify-lines src
    (fn (line offset)
      (let (face (line-face line))
        (if (nil? face) '() (list [offset (+ offset (string/length line)) face]))))))

;; ---- occur-mode: the read-only *Occur* results buffer -----------------------
;; The *Occur* buffer (search-commands/cmd-occur) lists matching lines; it's stamped :occur,
;; made read-only on activate (like the process list), and is a results buffer: each row's
;; `{:buffer :line}` rides in `:line-links`, so RET / a click visit it through the shared
;; `results/location-jump-layer`. Stacks over text-mode so motion (C-n/C-p, arrows)
;; navigates rows.

(def occur-keymap
  ;; e: the rows become editable (Emacs's occur-edit-mode, `searchedit`)
  (keymap-bind {} ["e"] 'searchedit/cmd-occur-edit))

(def occur-mode-layer
  {:name 'occur
   :doc "Search hits, one per line — RET jumps to the line it names, e edits them."
   :keymap modes/occur-keymap
   ;; C-x C-q is `e`: the rows become editable rather than the flag flipping under `e` and `q`
   :writable {:enter 'searchedit/cmd-occur-edit}
   :commands (layer-commands modes/occur-keymap)
   :line-loc 'results/line-links-only-loc})

(register-special-type :occur 'modes/occur-mode-layer 'results/location-jump-layer)

;; ---- hexl-mode: a binary as a hex view --------------------------------------
;; A file that is not UTF-8 opens through `hexl/ed-open-binary` (Emacs hexl-mode):
;; xxd rows, coloured by `hexl/hexl-fontify` (offsets dim, zero bytes dimmer, the
;; ASCII column as a string). Read-only and without line numbers (each row carries its
;; offset) via the special-mode layer beneath; q quits.

(def hexl-mode-layer
  {:name 'hexl
   :doc "A binary file as hex — read-only, sixteen bytes a row."
   :fontify 'hexl/hexl-fontify
   :writable {:never "a hex view renders the binary; edit the file itself"}
   ;; its text renders the binary, it is not the binary: C-x C-s / C-x C-w refuse it
   :no-write {:what "a hex view" :why "it renders the binary; edit the file itself"}})

(register-special-type :hexl 'modes/hexl-mode-layer)

;; check-allow: the link's command is resolved late (`reflect/eval`), so its result is unknown
;; to the checker; every command answers a model
(check-allow :trusted
  (defcommand cmd-welcome-link
    (m key)
    "The welcome scratch's `:on-click`: a click that landed on a link line
(`modes/*welcome-links*` — the bedit tutorial, the Brood playground) runs that
line's command; a click anywhere else in the buffer is just a click. The targets
are deferred-loaded (~a second after startup), so a faster click gets told to try
again rather than an unbound error."
    (let (buffer (model/ed-current-buf m)
          line (editor/buffer/buffer-line-at buffer (editor/buffer/buffer-current-line buffer))
          link (modes/welcome-link-at line))
      (cond
        (nil? link) m
        (bound? (second link)) ((reflect/eval (second link)) m key)
        else (model/message m "that one is still loading — one second, then click again")))))

;; a guest may run these (`guest`)
(interactive/declare-trait :guest
  '(modes/cmd-welcome-link))
