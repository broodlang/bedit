(defmodule modes
  "The editor's modes, as **layers** (`std/layers.blsp`). A *mode* is a layer — a
named bundle of a keymap (and, later, hooks / a structural parser) — that a buffer
carries; dispatch composes the active buffer's layers (see `input`). This decouples
\"which keys do what\" from the dispatch loop and makes it per-buffer: a `.blsp`
buffer can later get a `brood-mode` layer (structural sexp nav + C-x C-e) stacked
on, while a plain buffer stays in `text-mode`.

`text-mode` is the **default**: it's registered for the `:fundamental` type, which
`layers/buffer-type-for` returns for any buffer with no matching filename and no
explicit `:type`. Its keymap holds the editor's bindings — data, built with
`keymap-bind` (which nests prefix sub-keymaps for chords like `C-x C-e`); command
values are quoted, fully-qualified symbols resolved with `(eval sym)` at dispatch,
so redefining a command or rebinding a key hot-swaps behaviour live."
  (:use editor/layers)
  (:use editor/keymap)
  (:use editor/highlight)  ; brood-mode's language services reuse the pure analysis here
  (:use editor/treesit)  ; ruby/elixir-mode fontify + structural motions (ROADMAP §C)
  (:use theme)  ; face-gutter-line — the dim line-number colour (src/theme.blsp)
  (:use sexp))  ; the CST queries the brood-mode indenter is computed over

(require 'editor/layers)
(require 'editor/keymap)
(require 'regex)  ; the file-type trigger is a regex on the mode (:file-pattern)
(require 'editor/highlight)  ; highlight-spans / bracket-match / enclosing-call / symbol-prefix-at
(require 'editor/markdown)  ; markdown-spans — the :fontify service for markdown-mode
(require 'editor/dotenv)  ; env-spans — the :fontify service for env-mode
(require 'editor/dockerfile)  ; dockerfile-spans — the :fontify service for docker-mode
(require 'editor/treesit)  ; tree-sitter fontify + structural motions (ruby/elixir-mode)
(require 'sexp)  ; tree / enclosing / forms-of — the indenter's structure source
(require 'editor/buffer)  ; buffer-line-count — the line-number gutter's width/cell services

;; The universal keybindings (the old `global` layer) moved to `keymaps` (src/keymaps.blsp):
;; they're now a keybinding *profile* on the MODEL scope, not a system layer pinned to
;; every buffer, so a second profile (vim) can replace them. This module keeps the
;; per-buffer *mode* layers (text/brood/markdown/…) — language + mode-specific keys.

;; ---- the line-number gutter, as a mode service -----------------------------
;; A *gutter* is generic per-line margin content a layer contributes via two facets
;; `ed-mode-service` looks up: `:gutter-width` (columns to reserve, given the buffer)
;; and `:gutter-cell` (`[text face]` for a 0-based line, given the buffer + width).
;; Both renderers consume it without naming "line numbers" — the view paints the cells
;; left of the text (src/view.blsp), the web mirror materialises them into its snapshot
;; (src/web.blsp). line-numbers is the first such gutter; a future diagnostics/git
;; gutter is the same two functions registered on a layer. Lives on text-mode (the
;; shared base), so plain *and* brood buffers get it (brood stacks text-mode beneath).

(def gutter-face-line-number face-gutter-line)  ; the dim line-number colour (theme)

(defn line-number-width (buf)
  "The `:gutter-width` for line numbers: the last line number's digit count + 1 for a
trailing separator space."
  (+ 1 (string-length (str (editor/buffer/buffer-line-count buf)))))

(defn line-number-cell (buf line gw)
  "The `:gutter-cell` for 0-based `line`: its 1-based number right-aligned in `gw`
columns (digits + a trailing space), in the dim line-number face."
  [(str (pad-left (str (inc line)) (dec gw)) " ") modes/gutter-face-line-number])

;; text-mode is the visible default major: it names the mode for plain buffers (its
;; bindings are the global layer's) and carries the line-number gutter service. It's
;; the layer for `:fundamental`, the type `buffer-type-for` falls back to.
(def text-mode-layer
  {:name 'text
   :keymap {}
   :gutter-width 'modes/line-number-width
   :gutter-cell 'modes/line-number-cell})
(register-type-layers :fundamental (list 'modes/text-mode-layer))

(defn register-language-mode (layer-ref type)
  "Register a language mode that stacks over text-mode: bind `type` to `[layer
text-mode]` (head = higher precedence) and route the layer's `:file-pattern` regex to
that type. The shared shape every fontify/structural language mode registers through —
brood, markdown, env, docker, ruby, elixir; a future json-/python-mode is one more call."
  (let (pat (get (eval layer-ref) :file-pattern))
    (register-type-layers type (list layer-ref 'modes/text-mode-layer))
    (register-file-type (fn (f) (regex/match? pat f)) type)))

;; ---- brood-mode: Brood (.blsp) source, stacked on text-mode -----------------
;; Structural s-expression navigation (`std/sexp`, via the `commands/cmd-*-sexp`
;; wrappers) layered ON TOP of text-mode — so a `.blsp` buffer keeps every
;; text-mode motion/edit binding and *gains* `C-M-f/b/u/d/a`. The trigger lives on
;; the mode as a **regex** (`:file-pattern`), matched with `std/regex`; edit that
;; one string to change which files get brood-mode.

(def brood-keymap
  (-> {}
    (keymap-bind [:ctrl-meta-f] 'commands/cmd-forward-sexp)  ; C-M-f
    (keymap-bind [:ctrl-meta-b] 'commands/cmd-backward-sexp)  ; C-M-b
    (keymap-bind [:ctrl-meta-u] 'commands/cmd-up-list)  ; C-M-u
    (keymap-bind [:ctrl-meta-d] 'commands/cmd-down-list)  ; C-M-d
    (keymap-bind [:ctrl-meta-a] 'commands/cmd-beginning-of-defun)  ; C-M-a
    ;; C-M-SPC (also C-M-@) — mark the next sexp, extending on repeat. Key encoding for
    ;; the space chord mirrors C-SPC's `"ctrl- "`; both spellings bound to be safe.
    (keymap-bind [(keyword "ctrl-meta- ")] 'commands/cmd-mark-sexp)  ; C-M-SPC
    (keymap-bind [(keyword "ctrl-meta-@")] 'commands/cmd-mark-sexp)  ; C-M-@
    ;; RET auto-indents the new line (overrides the global plain newline for .blsp)
    (keymap-bind [:enter] 'commands/cmd-newline-and-indent)
    ;; paredit-style structural editing. Chord encodings are best-guesses (the
    ;; shifted-Ctrl ones especially — see ROADMAP "Loose ends"); all reachable via M-x
    ;; (slurp-forward, …) and rebindable live. C-M-s for splice since M-s is the search
    ;; prefix; M-r shadows move-to-window-line in .blsp, exactly as paredit-mode does.
    (keymap-bind [(keyword "ctrl-)")] 'commands/cmd-slurp-forward)   ; C-)
    (keymap-bind [(keyword "ctrl-}")] 'commands/cmd-barf-forward)    ; C-}
    (keymap-bind [(keyword "ctrl-(")] 'commands/cmd-slurp-backward)  ; C-(
    (keymap-bind [(keyword "ctrl-{")] 'commands/cmd-barf-backward)   ; C-{
    (keymap-bind [:alt-r] 'commands/cmd-raise-sexp)                  ; M-r
    (keymap-bind [(keyword "alt-(")] 'commands/cmd-wrap-round)       ; M-(
    (keymap-bind [:ctrl-meta-s] 'commands/cmd-splice-sexp)           ; C-M-s
    (keymap-bind [:ctrl-k] 'commands/cmd-sexp-kill)))                ; C-k (sexp-aware)

;; ---- brood-mode language services -------------------------------------------
;; The four facets `ed-mode-service` (src/model.blsp) looks up. Each is a thin
;; adapter over `std/highlight.blsp`'s pure analysis (the REPL's editor uses the
;; same module) plus the live image — so the editor's view/completion gain
;; highlighting, bracket-matching, eldoc, and symbol completion for `.blsp` buffers
;; without the generic view ever naming Brood. A future json-/python-mode registers
;; the same facets with its own functions.

(defn brood--arglist-of (callee)
  "The arglist of the function/macro named by string `callee`, resolved in the live
image, or nil if it isn't a bound symbol. (Mirrors `lineedit--arglist-of`.)"
  (try
    (let (sym (read-string callee))
      (if (and (symbol? sym) (bound? sym)) (arglist (eval sym)) nil))
    (catch e nil)))

(defn brood-eldoc (text pos)
  "The brood-mode `:eldoc` service: a `\"(callee arg…)\"` signature string for the call
enclosing offset `pos` in `text` (`enclosing-call` + the live arglist), or nil when
the cursor isn't in a call whose head is a bound function/macro."
  (let (call (enclosing-call text pos))
    (if (nil? call)
      nil
      (let ([callee argi] call
            args (brood--arglist-of callee))
        (if (nil? args)
          nil
          (str "(" callee (if (empty? args) "" (str " " (join " " (map str args)))) ")"))))))

(defn brood-complete-at (text pos)
  "The brood-mode `:complete-at` service: `[start prefix candidates]` for offset `pos`
— the symbol prefix at point (`symbol-prefix-at`) and the live global names that
start with it (the same source as the REPL's Tab completion). `complete` adapts this
pure `(text pos)` service into one source and merges it with the buffer-word source."
  (let ([start prefix] (symbol-prefix-at text pos))
    [start prefix
      (if (= prefix "")
        '()
        (sort (filter (fn (s) (starts-with? s prefix)) (map str (global-names)))))]))

;; ---- brood-mode indentation (the :indent service) ---------------------------
;; Indentation that matches `nest format` (the canonical Brood style, std/format),
;; computed purely over the CST (`std/sexp`). The rule the formatter uses: a broken
;; form's body indents **+2** from its open delimiter — for BOTH calls and special
;; forms (a form's header count only changes which args ride the head line, never
;; the body column). The two exceptions align under the first element instead:
;; **maps** and the **bindings list** of a let-family form (`let`/`let*`/`binding`/…).

(def brood--pair-binding-heads
  ;; let-family heads whose first argument (the bindings list) aligns its pairs
  ;; under the opening element — mirrors std/format's `*format-pair-bindings*`.
  (list "let" "let*" "letrec" "binding" "dotimes" "dolist" "loop"))

(defn brood--head-text (text node)
  "The source spelling of CST `node` in `text` — a list's head."
  (substring text (get node :start) (get node :end)))

(defn brood--binding-list? (text tr enc)
  "True if `enc` is the bindings list of a let-family form: its parent's head is a
pair-binding form and `enc` is that parent's first argument."
  (let (parent (enclosing tr (get enc :start)))
    (and (not (= parent enc))
      (= (get parent :kind) :list)
      (let (pk (forms-of parent))
        (and (>= (count pk) 2)
          (includes? brood--pair-binding-heads (brood--head-text text (first pk)))
          (= (get (second pk) :start) (get enc :start)))))))

(defn brood--first-elem-col (text enc opencol)
  "The column to align `enc`'s contents under — its first element's column, or
`opencol + 1` when it's empty."
  (let (kids (forms-of enc))
    (if (empty? kids) (+ opencol 1) (model/ed-column-at text (get (first kids) :start)))))

(defn brood-indent (text bol)
  "The brood-mode `:indent` service: the indent column for the line starting at
offset `bol`, matching `nest format`. Top level → 0; a **map** or a **let-family
bindings list** aligns its contents under the first element; every other form
indents its body **+2** from the open delimiter. (Multi-line strings aren't
special-cased.)"
  ;; At end-of-text (e.g. RET just after `(defn f ()`), the open form is unclosed —
  ;; its CST node ends at EOF, so a strict `enclosing` at `bol` would miss it and
  ;; return root. Probe just inside instead.
  (let (n (string-length text)
        pos (if (>= bol n) (max 0 (dec n)) bol)
        tr (tree text)
        enc (enclosing tr pos)
        kind (get enc :kind))
    (if (= kind :root)
      0
      (let (opencol (model/ed-column-at text (get enc :start)))
        (if (or (= kind :map) (brood--binding-list? text tr enc))
          (brood--first-elem-col text enc opencol)
          (+ opencol 2))))))

(defn brood-diagnostics (text)
  "The brood-mode `:diagnostics` service: the advisory type-checker's warnings for
buffer `text`, each `{:line :col :message}` (1-based positions), via the in-process
`check-string-structured` (same image — no LSP wire needed for Brood). `()` while the
buffer doesn't parse, so a live recheck never errors mid-edit."
  (or (check-string-structured text) '()))

(def brood-mode-layer
  {:name 'brood
   :parser :brood
   :file-pattern "\\.blsp$"
   :keymap modes/brood-keymap
   :commands '("forward-sexp" "backward-sexp"
                "up-list"
                "down-list"
                "beginning-of-defun"
                "mark-sexp"
                "slurp-forward" "barf-forward"
                "slurp-backward" "barf-backward"
                "raise-sexp" "splice-sexp" "wrap-round"
                "sexp-kill"
                "eval-last-sexp"
                "eval-region"
                "eval-buffer")
   :fontify 'editor/highlight/highlight-spans
   :fontify-restart 'editor/highlight/safe-restart
   :bracket-match 'editor/highlight/bracket-match
   :eldoc 'modes/brood-eldoc
   :complete-at 'modes/brood-complete-at
   :indent 'modes/brood-indent
   :diagnostics 'modes/brood-diagnostics
   :comment-syntax ";; "})

;; .blsp files → the :brood type; :brood stacks brood-mode over text-mode (head =
;; higher precedence), and the file trigger is the mode's own :file-pattern regex.
(register-language-mode 'modes/brood-mode-layer :brood)

;; ---- markdown-mode: Markdown (.md) source, stacked on text-mode -------------
;; The second language mode, and the proof the editor is language-agnostic: a `.md`
;; buffer keeps every text-mode motion/edit binding and the line-number gutter, and
;; *gains* Markdown syntax colouring — purely by registering a layer whose `:fontify`
;; is `std/editor/markdown`'s pure `markdown-spans` (the brood analogue of
;; brood-mode's `highlight-spans`). No keymap or language services beyond fontify yet
;; (headings/code/emphasis/links/lists/quotes); a future toggle-heading command is
;; just another binding on this layer. `:fontify-restart` is omitted: markdown is
;; line-oriented and `ed-window-spans` already lexes a backscan lead-in slice from its
;; top, which re-establishes fenced-code state for everything in view.
(def markdown-mode-layer
  {:name 'markdown
   :file-pattern "\\.(md|markdown)$"
   :fontify 'editor/markdown/markdown-spans})

;; .md / .markdown files → the :markdown type, stacked over text-mode.
(register-language-mode 'modes/markdown-mode-layer :markdown)

;; ---- env-mode / docker-mode: more fontify-only language layers --------------
;; Two more language modes built the same way as markdown-mode — a layer whose only
;; service is a `:fontify` span fn from a pure std module (editor/dotenv, editor/
;; dockerfile). `.env` files and Dockerfiles keep every text-mode binding and gain
;; syntax colouring. The `:file-pattern` is matched against the file's basename, so a
;; bare `Dockerfile` / `.env` (no extension) triggers; both omit `:fontify-restart`
;; (line-oriented, no cross-line lexer state).

(def env-mode-layer
  {:name 'env
   ;; .env and its variants (.env.local, .env.production, …); the leading-dot name
   ;; carries no extension, so anchor on `.env` with an optional `.suffix`.
   :file-pattern "(^|/)\\.env(\\.[^/]+)?$"
   :fontify 'editor/dotenv/env-spans})

(register-language-mode 'modes/env-mode-layer :env)

(def docker-mode-layer
  {:name 'docker
   ;; `Dockerfile`, `Dockerfile.dev`, `*.dockerfile`, and Podman's `Containerfile`.
   :file-pattern "(^|/)(Dockerfile|Containerfile)([.][^/]+)?$|[.]dockerfile$"
   :fontify 'editor/dockerfile/dockerfile-spans})

(register-language-mode 'modes/docker-mode-layer :docker)

;; ---- ruby-mode / elixir-mode: tree-sitter-backed language modes -------------
;; The first modes whose parser is NOT Brood's reader: a `.rb`/`.ex` buffer gets
;; syntax colouring AND structural navigation from a tree-sitter grammar
;; (`tree-sitter-parse`), via `std/editor/treesit` — the foreign-language analogue
;; of brood-mode's `highlight`+`sexp`. The proof of ROADMAP §C: because the
;; builtin yields the SAME positioned-node shape Brood's reader does, the editor's
;; `:fontify` service and the `C-M-f/b/u/d/a` structural commands run over a Ruby
;; or Elixir tree unchanged — the modes are pure data (a face table + a `:ts-lang`
;; + a layer). `:fontify-restart` is omitted (tree-sitter is error-tolerant, so the
;; windowed lead-in slice re-establishes context); `:indent` is deferred (RET stays
;; the global newline; the editor falls back to matching the previous line).

;; Shared structural keymap: the same `C-M-*` motions brood-mode binds, but the
;; commands dispatch on the buffer's `:ts-lang` (`commands/ed--structural`), so
;; these run the tree-sitter motions. Paredit (slurp/barf/…) stays Brood-only —
;; it's a Lisp delimiter edit, meaningless over a Ruby/Elixir tree.
(def ts-structural-keymap
  (-> {}
    (keymap-bind [:ctrl-meta-f] 'commands/cmd-forward-sexp)  ; C-M-f
    (keymap-bind [:ctrl-meta-b] 'commands/cmd-backward-sexp)  ; C-M-b
    (keymap-bind [:ctrl-meta-u] 'commands/cmd-up-list)  ; C-M-u
    (keymap-bind [:ctrl-meta-d] 'commands/cmd-down-list)  ; C-M-d
    (keymap-bind [:ctrl-meta-a] 'commands/cmd-beginning-of-defun)))  ; C-M-a

;; Per-language kind→face tables name only the *named* nodes to colour; keywords
;; (anonymous alphabetic tokens — `def`/`end`/`do`/`fn`/…) come free via
;; `treesit/face-of-syntax`. Refine a table by inspecting `(tree-sitter-parse …)`.
(def ruby-face-table
  {:comment :syntax/comment
   :string :syntax/string :heredoc_body :syntax/string :regex :syntax/string
   :simple_symbol :syntax/special :hash_key_symbol :syntax/special :delimited_symbol :syntax/special
   :integer :syntax/number :float :syntax/number
   :constant :syntax/special
   :instance_variable :syntax/function :global_variable :syntax/function :class_variable :syntax/function})
(def ruby-face-of (treesit/face-of-syntax modes/ruby-face-table))
(defn ruby-fontify (text) (treesit/fontify text :ruby modes/ruby-face-of))

(def ruby-mode-layer
  {:name 'ruby
   :parser :tree-sitter
   :ts-lang :ruby
   :file-pattern "\\.rb$"
   :keymap modes/ts-structural-keymap
   :commands '("forward-sexp" "backward-sexp" "up-list" "down-list" "beginning-of-defun")
   :fontify 'modes/ruby-fontify
   :comment-syntax "# "})

(register-language-mode 'modes/ruby-mode-layer :ruby)

;; Elixir: def/defmodule are macros (parsed as calls, not keywords), so they
;; aren't keyword-coloured — `do`/`end`/`fn`/`when`/… are. Atoms and module
;; aliases read as `:special`.
(def elixir-face-table
  {:comment :syntax/comment
   :string :syntax/string :charlist :syntax/string :sigil :syntax/string
   :integer :syntax/number :float :syntax/number
   :atom :syntax/special :alias :syntax/special :keyword :syntax/special})
(def elixir-face-of (treesit/face-of-syntax modes/elixir-face-table))
(defn elixir-fontify (text) (treesit/fontify text :elixir modes/elixir-face-of))

(def elixir-mode-layer
  {:name 'elixir
   :parser :tree-sitter
   :ts-lang :elixir
   :file-pattern "\\.(ex|exs)$"
   :keymap modes/ts-structural-keymap
   :commands '("forward-sexp" "backward-sexp" "up-list" "down-list" "beginning-of-defun")
   :fontify 'modes/elixir-fontify
   :comment-syntax "# "})

(register-language-mode 'modes/elixir-mode-layer :elixir)

;; ---- process-menu-mode: the read-only, killable *Process List* --------------
;; Emacs `process-menu-mode` (a `special-mode`): the generated `*Process List*`
;; buffer (commands/cmd-list-processes) is **read-only** — its `:activate` hook flips
;; the buffer's std/buffer read-only flag, so every text-edit command is refused —
;; and gains kill/refresh keys. It stacks over text-mode so motion (C-n/C-p, the
;; arrows, M-</M->) still navigates the rows. Stamped on the buffer by *type*
;; (`:process-menu`), not by filename: the list has no backing file.

(defn read-only-activate (buf)
  "An `:activate` hook that makes a generated report buffer read-only (special-mode
style) — its own keys act while text edits are refused (`ed-edit` reports it). Shared by
the *Process List* and *Occur* modes."
  (editor/buffer/set-read-only buf true))

(def process-menu-keymap
  (-> {}
    ;; d / x / k — kill the process on the current line (Emacs process-menu `d`,
    ;; proced `x`; `k` as a kill mnemonic).
    (keymap-bind ["d"] 'commands/cmd-process-menu-kill)
    (keymap-bind ["x"] 'commands/cmd-process-menu-kill)
    (keymap-bind ["k"] 'commands/cmd-process-menu-kill)
    ;; g — refresh the snapshot (Emacs `revert-buffer` on a tabulated list).
    (keymap-bind ["g"] 'commands/cmd-process-menu-refresh)
    ;; t — toggle the tree (parent→child) vs flat (id-sorted) view.
    (keymap-bind ["t"] 'commands/cmd-process-menu-toggle-tree)))

(def process-menu-mode-layer
  {:name 'process-menu
   :keymap modes/process-menu-keymap
   :commands '("process-menu-kill" "process-menu-refresh" "process-menu-toggle-tree")
   :hooks {:activate '(modes/read-only-activate)}})

;; :process-menu stacks process-menu-mode over text-mode (so motion still works); the
;; list buffer gets it via `set-buffer-type` (see commands/ed-show-named), no file.
(register-type-layers :process-menu
  (list 'modes/process-menu-mode-layer 'modes/text-mode-layer))

;; ---- occur-mode: the read-only *Occur* results buffer -----------------------
;; The *Occur* buffer (commands/cmd-occur) lists matching lines; it's stamped :occur,
;; made read-only on activate (like the process list), and binds RET to jump to the
;; matching source line. Stacks over text-mode so motion (C-n/C-p, arrows) navigates rows.

(def occur-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-occur-jump)))

(def occur-mode-layer
  {:name 'occur
   :keymap modes/occur-keymap
   :commands '("occur-jump")
   :hooks {:activate '(modes/read-only-activate)}})

(register-type-layers :occur (list 'modes/occur-mode-layer 'modes/text-mode-layer))

;; ---- dired-mode: the read-only directory browser ----------------------------
;; The dired buffer (commands/cmd-dired) lists a directory; it's stamped :dired, made
;; read-only on activate, and its single-key bindings navigate (RET/f open, ^ up, g
;; refresh, q quit) and operate (+ mkdir, R rename, C copy, D delete). Stacks over
;; text-mode so n/p/arrows move between rows. The commands rebuild the listing via
;; ed-show-named rather than editing text, so they work on the read-only buffer.

(def dired-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-dired-open)
    (keymap-bind ["f"] 'commands/cmd-dired-open)
    (keymap-bind ["^"] 'commands/cmd-dired-up)
    (keymap-bind ["g"] 'commands/cmd-dired-refresh)
    (keymap-bind ["q"] 'commands/cmd-dired-quit)
    (keymap-bind ["+"] 'commands/cmd-dired-create-dir)
    (keymap-bind ["R"] 'commands/cmd-dired-rename)
    (keymap-bind ["C"] 'commands/cmd-dired-copy)
    (keymap-bind ["D"] 'commands/cmd-dired-delete)))

(def dired-mode-layer
  {:name 'dired
   :keymap modes/dired-keymap
   :commands '("dired-open" "dired-up" "dired-refresh" "dired-quit"
                "dired-create-dir" "dired-rename" "dired-copy" "dired-delete")
   :hooks {:activate '(modes/read-only-activate)}})

(register-type-layers :dired (list 'modes/dired-mode-layer 'modes/text-mode-layer))
