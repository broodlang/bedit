(defmodule playground
  "The **Brood playground** (`M-x brood-playground`, `C-c p p`) — a scratch buffer that runs.

`*Playground*` is one ordinary, fully editable Brood file where every top-level form
evaluates as you settle typing, and each one's result appears as ghost text at its end —

    (defn fac (n) (if (= n 0) 1 (* n (fac (dec n)))))
                                            => #<fn fac>
    (fac 5)                                 => 120  : int

— with the *Playground Spy* pane beside it showing what actually ran to produce the form
your cursor is in: every call and return, nested.

**Free text, no boxes.** Unlike the tutorial there is no generated prose to protect and
nothing is read-only; prose is `;` comments, because the buffer is Brood source and nothing
else. That is the whole difference between the two features, and it is why they share
`liveeval` (the notes vocabulary) and `workings` (the pane) rather than one being written
in terms of the other.

**What is left in this file is the LANGUAGE.** Everything about being a playground — the
form diffing, the marker-anchored notes, the launch plan, the reply fold, the pane
following the cursor — is `playground-core`, which `elixir-playground` is the second
client of. Here: how Brood text splits into forms, what its dependencies are, what a
reply's note says, and where to send one. Nine functions and a map.

**Two things this needed from the language**, both added rather than worked around here:

  - `:trace :all` (`eval-server`) — trace every global the SESSION defined, resolved in the
    sandbox's own image. The tutorial had to guess a trace list by walking box source for
    call heads, which structurally cannot see a helper the source doesn't name. In a
    free-text buffer that indirection is the thing you opened the pane to watch.
  - `reflect/expr-type` — the checker's type for an anonymous expression. `type-signature`
    needs a global to ask about; what you just typed has no name.

**Nothing persists.** A fresh buffer every time the editor starts: the point is a surface
with no stakes, and a playground that accumulates is a file you end up tidying. `C-x C-w`
if a session turns out to be worth keeping."
  (:use model) ; message / ed-current-buf
  (:use commands) ; ed-show-named / ed-select
  (:use interactive) ; defcommand — M-x brood-playground
  (:use editor/buffer) ; buffer-text
  (:use editor/layers) ; register-type-layers / request-close
  (:use theme) ; *subtext* / *teal* — the spy pane's two faces
  (:use sandbox)) ; sandbox-start / sandbox-eval / the session
;; liveeval, playground-core, workings, sandbox-events, sexp and modes are referenced
;; qualified below — each `mod/name` auto-loads its module.

(def *buffer-name* "*Playground*")
(def *spy-buffer-name* "*Playground Spy*")
(def *playground-timeout-ms* 5000)

;; Where this pane's state lives and what it is called — see `workings`, which owns the
;; behaviour. `:key` keeps it clear of the tutorial's pane in the same model.
(def *spy-spec*
  {:key :playground
   :buffer playground/*spy-buffer-name*
   :type :playground-spy
   :noun "form"
   :heading "What ran"})

(def *welcome*
  ;; Deliberately tiny. A playground that opens full of somebody else's examples is a file
  ;; you clear before you can use it; two lines say what the surface does and get out of
  ;; the way. It is ordinary editable text like everything else here — delete it.
  (str ";; Brood playground — every top-level form runs as you stop typing.\n"
    ";; Results appear at the end of each form; the pane on the right shows what ran.\n\n"
    "(+ 1 2)\n"))

;; ---- the language services --------------------------------------------------------

(defn forms-of (text)
  "The buffer's top-level forms as positioned nodes. Error-tolerant, so it answers over
text someone is mid-typing — whether a given form *evaluates* is `liveeval/parse-state`'s
separate question."
  (sexp/top-level-forms text))

(defn form-srcs (text)
  "`{index -> source}` for `text`, parsing it. The convenience form of
`playground-core/form-srcs-in`."
  (playground-core/form-srcs-in text (forms-of text)))

(defn deps-of (text)
  "Per top-level form of `text`, `{:defines (…) :references (…)}` — `reflect/source-deps`,
with `()` when the kernel is too old to have it. Degrading rather than raising is
deliberate: without deps the launch falls back to re-sending the whole tail, which is what
it always did."
  ;; check-allow :discarded-catch — an older kernel has no source-deps, and `()` is the answer
  (check-allow :discarded-catch (try (reflect/source-deps text) (catch _ '()))))

(defn namespace-form? (src)
  "Does this form change what names MEAN below it? `defmodule` re-roots every later
definition and reference into another namespace; `require`/`use` change what a bare name
resolves to. Neither is an edge dependency analysis can see — the affected forms name
nothing that changed — so a re-run of one of these takes the whole tail with it."
  (includes? (list 'defmodule 'require 'require-one 'use 'in-ns) (liveeval/head-symbol src)))

(defn parse-state (src)
  "Is this form blank, mid-typing, broken, or ready? Brood's own reader answers, via
`liveeval/parse-state`."
  (liveeval/parse-state src))

(defn note-of (reply src)
  "The ghost-text note for one reply — `=> 6`, with what it printed, what it cost and the
derived type of the form it answers."
  (liveeval/result-note reply src))

(defn send-eval (id src timeout-ms)
  "Put one form on the Brood sandbox's wire, boundary-tracing every global the session has
defined (`:trace :all`) so the pane can show what it actually called rather than what its
own text happened to name."
  (sandbox-eval id src timeout-ms :all))

(defn eval-in-image (src)
  "The headless path: evaluate `src` in this image and answer the same reply shape the
sandbox would. Used only when there is no `ui-run` loop to deliver an event to — a test, a
`--headless` daemon — where a fire-and-forget request would strand every form on
`evaluating…`.

It yields values but no cascade: `:trace :all` resolves against the SANDBOX's session, and
the editor's own image is not it."
  (eval-server/eval-capturing src nil))

(def *spec*
  {:key :playground
   :buffer playground/*buffer-name*
   :spy playground/*spy-spec*
   :type :playground
   :timeout-ms playground/*playground-timeout-ms*
   :restart "M-x brood-playground-restart"
   :spawn-failed-message "could not start the playground sandbox (is `nest` on PATH?)"
   :forms-of 'playground/forms-of
   :parse-state 'playground/parse-state
   :deps-of 'playground/deps-of
   :namespace-form? 'playground/namespace-form?
   :note-of 'playground/note-of
   :eval 'playground/send-eval
   :in-image 'playground/eval-in-image})

;; ---- the buffer -------------------------------------------------------------------

(defn playground-buffer? (b)
  "Is buffer `b` the playground? Keyed on the buffer NAME, like every other report buffer
here. Its TYPE is `:playground`, which stacks a two-hook layer over the real brood-mode —
so it is a Brood file first and a playground second."
  (and b (= (:name b) *buffer-name*)))

(defn playground-live-buffer? (m)
  "Is *Playground* on screen — i.e. does the playground still want a sandbox? One of the
`sandbox-events` client hooks."
  (playground-core/live-buffer? *spec* m))

(defn- playground-live? ()
  ;; Is there a running editor to deliver a sandbox event to? Without the `ui-run` loop
  ;; there is nothing to receive a reply, so a headless open starts no child runtime.
  (not (ed-headless?)))

;; ---- the eval-on-type triple (the model's timers call these) -------------------------

(defn ed-playground-stale? (m) (playground-core/ed-stale? *spec* m))
(defn ed-playground-reanchor (m) (playground-core/ed-reanchor *spec* m))
(defn ed-playground-launch (m) (playground-core/ed-launch *spec* m))

;; ---- the sandbox client hooks (registered in `sandbox-events/*clients*`) --------------

(defn playground-sandbox-ready (m gen banner) (playground-core/sandbox-ready *spec* m gen))
(defn playground-sandbox-reply (m reply gen)
  ;; An attach/detach answer is this module's too — it is the only registered client of the
  ;; Brood session that owns a command which asks one — so it is taken here before the
  ;; playground's own fold, which would drop an id it did not send.
  (if (attach-reply? m reply)
    (brood-attach-reply m reply)
    (playground-core/sandbox-reply *spec* m reply gen)))
(defn playground-sandbox-down (m code) (playground-core/sandbox-down *spec* m code))

;; ---- the pane follows the cursor -------------------------------------------------------

(defn spy-on-screen? (m)
  "Is the *Playground Spy* pane currently on screen?"
  (playground-core/spy-on-screen? *spec* m))

(defn playground-on-move (m)
  "The playground's `:on-move` hook (layers §7), whenever point or the text moved: keep the
spy pane following the cursor from form to form and showing the docs of whatever it is on,
with no re-evaluation."
  (playground-core/on-move *spec* m))

;; ---- the modes: a Brood buffer that runs, and a read-only pane beside it ---------------

;; The playground layer adds exactly two things to brood-mode: the `:on-move` hook that
;; keeps the pane following the cursor, and an `:on-close` that takes the pane with it. It
;; STACKS over the real brood-mode rather than replacing it, so the buffer keeps every
;; language service a `.blsp` file has — highlighting, indent, eldoc, completion, the
;; structural motions. A playground where `(` didn't indent would be a worse place to try
;; the language than the file you already had open.
(def playground-mode-layer
  {:name 'playground
   :on-move 'playground/playground-on-move
   :hooks {:on-close '(playground/playground-on-close)}})

(register-type-layers :playground
  (list 'playground/playground-mode-layer
    'modes/brood-mode-layer 'modes/prog-mode-layer 'modes/text-mode-layer))

(defn- spy-line-face (line)
  (cond
    (string/starts-with? line "What ran") {:fg *subtext*}
    ;; the untraced note is an aside about the tracer, not about your code — dimmest,
    ;; italic, so the eye passes over it on the way back to the value
    (string/starts-with? line liveeval/*untraced-note*) {:fg *overlay0* :italic true}
    (string/starts-with? (string/triml line) "= ") {:fg *teal*}
    else nil))

(defn spy-fontify (src)
  "The spy pane's colouring: the heading dim, every `= value` return in the accent — so a
cascade reads as calls going in and values coming back rather than as a wall of text."
  (modes/fontify-line-faces src playground/spy-line-face))

(def playground-spy-layer
  {:name 'playground-spy :no-line-numbers true :fontify 'playground/spy-fontify})

(register-type-layers :playground-spy
  (list 'playground/playground-spy-layer 'modes/special-mode-layer 'modes/text-mode-layer))

(defn playground-on-close (buf)
  "The `:on-close` hook: killing *Playground* takes its pane with it — the pane is a view of
the playground's forms and says nothing without them, so leaving it behind leaves a corpse
on screen. `request-close` NAMES the pane rather than closing it: a hook is handed only its
own buffer, and it is the app that knows the buffer pool.

The sandbox is deliberately NOT stopped here. The tutorial may still be using it, and
`sandbox-events` is the only place that can see whether every client is gone."
  (editor/layers/request-close buf *spy-buffer-name*))

;; ---- the commands ------------------------------------------------------------------------

(defcommand cmd-brood-playground
  (m key)
  "Open the Brood playground (M-x brood-playground, C-c p p): a free-text `*Playground*`
buffer whose top-level forms evaluate as you settle typing, results as ghost text, and a
*Playground Spy* pane beside it showing what each form actually called.

**One command, not two.** Running it again switches to the buffer you already have — and
brings the pane back if you closed it, on the form the cursor is in. A separate
`playground-spy` command was a second thing to know for what is really the same intent
(\"show me the playground\"), and a second entry cluttering `M-x` for a reader who has no
idea the pane can be dismissed. Closing the pane still latches, so a later result does not
reopen it behind you; asking for the playground again does, because that is you asking."
  (do
    ;; The sandbox is a child runtime, and only a running editor can receive its replies —
    ;; so a headless open (a test, a `--headless` daemon) starts nothing.
    (when (playground-live?)
      (sandbox-events/ensure) ; the UiEvent impls live there; loading it IS registering them
      (sandbox-start))
    (let (existing (playground-core/pg-index *spec* m))
      (if existing
        ;; already open: select it, and un-latch the pane onto the form at point
        (let (m1 (ed-select m existing)
              b (playground-core/pg-buf *spec* m1))
          (if (nil? b)
            m1
            (let (text (buffer-text b))
              (workings/reopen *spy-spec*
                m1
                (or (playground-core/form-index-in (playground-core/form-spans-in text
                                                     (forms-of text))
                      (:point b 0))
                  0)))))
        ;; `:playground` stacks a two-hook layer over the real brood-mode, so the buffer is
        ;; a Brood file first — highlighting, indent, eldoc and paredit all come for free.
        ;;
        ;; The pane opens HERE, with `force`, rather than waiting to earn its split from the
        ;; first traced reply the way the tutorial's does. The rules differ because the
        ;; features do: a lesson is prose you are reading and the pane is an aside; a
        ;; playground IS the pane's subject — you opened it to watch code run.
        (message (workings/refresh *spy-spec*
                   (ed-show-named m *buffer-name* *welcome* :playground)
                   0
                   true)
          "playground — type Brood; it runs as you stop typing")))))

(defcommand cmd-brood-playground-restart
  (m key)
  "Respawn the eval sandbox (M-x brood-playground-restart): a fresh image — everything the
buffer defined is gone, and the whole buffer re-evaluates against it once the child
announces ready.

Also the retry path when the worker itself gave up or never spawned, which is why it starts
a dead one rather than resetting it: `sandbox-reset` on a worker that is not running is a
silent no-op, and a silent no-op is the wrong answer to \"please try again\". The tutorial
has the same command on `C-c C-k`; both drive the same shared child."
  (do
    (when (playground-live?)
      (do
        (sandbox-events/ensure) ; the UiEvent impls live there; loading it IS registering them
        (if (sandbox-running?) (sandbox-reset) (sandbox-start))))
    (message m "restarting the playground sandbox…")))

;; ---- attaching the Brood session to a node that is already running ------------------------
;; The mirror of `beam-attach`, and for the same reason: the session is an ordinary Brood
;; runtime, so pointing it at a peer turns the editor from a view of a PROJECT into a view
;; of a RUNNING SYSTEM. Evaluation routes there (`node/spawn-sync` in the child — see
;; `eval-server`), so the playground, `C-x C-e` and the tutorial all follow it.
;;
;; Brood asks one thing of the target that the BEAM does not: it must have called
;; `(node/serve-spawns)`. That is the opt-in, and it is a better default than the BEAM's —
;; an editor cannot reach into a program that has not said it may be reached into.

(defn attached-node (m)
  "The node this editor's Brood session is routed to, or nil for its own."
  (get-in m [:sandbox :attached]))

(defn- brood-attach-reply (m reply)
  "Report what an attach or detach actually did. Reported rather than assumed: an attach
that silently did not happen leaves you evaluating locally while believing you are not."
  (let (m1 (assoc-in m [:sandbox :attaching] nil)
        node (get reply :node))
    (cond
      (not (get reply :ok))
        (message (assoc-in m1 [:sandbox :attached] nil)
          (str "could not attach: " (get reply :error "unknown error")))
      (nil? node)
        (message (assoc-in m1 [:sandbox :attached] nil) "detached — back on bedit's own runtime")
      else
        (message (assoc-in m1 [:sandbox :attached] node)
          (str "attached to " node " — every evaluation now runs THERE")))))

(defn attach-reply? (m reply)
  "Is this reply the answer to an attach/detach this editor asked for?"
  (and (get-in m [:sandbox :attaching]) (= (get-in m [:sandbox :attaching]) (get reply :id))))

(defcommand cmd-brood-attach
  (m key)
  "Attach the Brood session to a node that is already running (M-x brood-attach): prompts
for the node, then for its cookie.

After it, the playground and `C-x C-e` evaluate THERE — which is the point, and is why the
mode line says so for as long as it lasts. `M-x brood-detach` goes back.

The node is typed rather than picked from a list on purpose: a menu of reachable nodes is
one keystroke away from evaluating on production. `\"name\"` dials a local node over its
Unix socket; `\"name@host:port\"` dials one over TCP."
  (if (not (sandbox-running?))
    (message m "no Brood session to attach — open a playground or evaluate something first")
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit "Attach to node: " "")
         :on-complete
           (fn (m1 spec)
             (if (= (string/trim spec) "")
               (message m1 "no node named")
               (assoc m1
                 :minibuffer
                   {:edit (ed-mb-edit (str "Cookie for " (string/trim spec) ": ") "")
                    :on-complete
                      (fn (m2 cookie)
                        (let (id (sandbox-next-id m2)
                              sent (sandbox-attach id (string/trim spec) (string/trim cookie)))
                          (if (not sent)
                            (message m2 "the session is not running")
                            (message (assoc-in (sandbox-ids-used m2 (inc id)) [:sandbox :attaching] id)
                              (str "connecting to " (string/trim spec) "…")))))})))})))

(defcommand cmd-brood-detach
  (m key)
  "Route the Brood session back to bedit's own runtime (M-x brood-detach)."
  (if (nil? (attached-node m))
    (message m "not attached to anything")
    (let (id (sandbox-next-id m)
          sent (sandbox-detach id))
      (if (not sent)
        (message m "the session is not running")
        (message (assoc-in (sandbox-ids-used m (inc id)) [:sandbox :attaching] id) "detaching…")))))
