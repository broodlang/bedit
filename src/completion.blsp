(defmodule completion
  "The editor's completion framework: **fuzzy ranking** (`std/fuzzy`) + the shared **menu
model** (the scroll window around the selection, the width clamp) and the **echo list**
([[completion-list]]): the vertical list the minibuffer (Plume, Vertico's) and
completion-at-point (a `panel` `:list`) both show in the echo area. The popup card
(`complete-card`, the `:popup` panel style) shares the window and width helpers. Everything is
drawn through the `ui-kit` widgets, styled by the theme's roles. The look (`*completion-max*`,
`*completion-card-radius*`) is redefinable live (ricing)."
  (:use ui-kit :only [ui-list]) ; the list widget
  (:use theme :only [ui-ctx])) ; the palette as the kit's roles
;; ---- look (redefine to rice the menu) ---------------------------------------
;; The popup's faces are the theme's roles (`ui-kit`); only its size and shape live here.

(defdyn *completion-max* 8) ; most rows shown at once
(def *completion-card-radius* 0.5) ; corner radius (cells) of the rounded GUI card

;; ---- ranking ----------------------------------------------------------------

(defn completion-rank (query items &optional (limit nil) (options nil))
  "The items fuzzily matching `query`, best first (`std/fuzzy`); an empty `query`
returns them unchanged. The single seam every completer ranks through.

**Pass the `limit` you will display.** `fuzzy/top` then keeps the best `limit` in a
bounded fold and, past a few thousand candidates, shards the ranking across processes —
where ranking without one sorts every match to show twenty of them. On a 27k-file project
that is the difference between ~1.1s and ~110ms per keystroke; the result is identical
either way, so the limit is purely how much work the ranking is allowed to skip.

`options` is `fuzzy/top`'s: `:category :file` for paths, `:boost` for history."
  (fuzzy/top items query limit options))

;; ---- the vertical menu: its width and its scroll window ---------------------

(sig completion-menu-width (any -> int))
(defn completion-menu-width (items)
  "A column width for the menu: the widest item, clamped to [8, 40]. Public so a caller
can clamp the menu's column to the screen before rendering."
  (math/min 40 (math/max 8 (fold items 0 (fn (w s) (math/max w (count s)))))))

(sig completion-window-start (int int int -> int))
(defn completion-window-start (total selected vis)
  "The index of the first visible item when a `vis`-row window scrolls to keep
`selected` centred in a list of `total` items."
  (math/max 0 (math/min (- total vis) (- selected (math/quot vis 2)))))

;; ---- the echo list: the minibuffer's and completion-at-point's ---------------

(def completion-list-style
  ;; the rows painted by role (ui-ctx palette), the same ui-list widget as the popup card —
  ;; but as Vertico draws them: the text flush with the prompt above it (no inset) and the
  ;; selection a flat full-width bar, not a pill floating in the row
  {:fg :on-surface :bg :surface :inset :flush :selection :bar})

(defn completion-list (spec area gui?)
  "The vertical candidate list the echo area shows, as `{:ops :zones}` in `area` (`[column
row width height]`): `spec`'s `:window`, the visible rows (`ui-list` rows, `{:label :key :marks
:enabled}`), the first of them item `:start` of the whole list, `:selected` an index into the
whole list or nil, and a click on row `i` the zone `[:tag i]`. The minibuffer's list (Plume)
and completion-at-point's (`panel`'s `:list`) both draw through here, so they look alike."
  ((ui-list {:items (:window spec)
             :selected (:selected spec)
             :base (:start spec)
             :row (fn (item _index _selected?) item)
             :tag (:tag spec)
             :style completion-list-style}) area
    (ui-ctx gui?)))
