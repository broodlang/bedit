(defmodule completion
  "The editor's completion framework: **fuzzy ranking** (`std/fuzzy`) + the shared **menu
model** (the scroll window around the selection, the width clamp, the per-row faces),
used by the in-buffer popup (`complete`, anchored at point — Corfu-style) and the
minibuffer prompt (`input`/`view`, anchored at the prompt — Vertico-style). The popup now
*renders* through the `ui-kit` widget (a windowed `ui-list` in a card — src/ui-kit.blsp);
this layer keeps the ranking + the window/width helpers those callers share. The look
(`*completion-*-face*`, `*completion-max*`) is redefinable live (ricing)."
  (:use theme) ; the curated palette + popup faces (src/theme.blsp)
  (:use fuzzy)) ; fuzzy-filter — the one ranking seam
;; ---- look (redefine to rice the menu) ---------------------------------------
;; The popup faces are the theme's (a dark card, not the old stark white box).
;; Still plain `def`s — redefine one live to re-skin the menu.

(defdyn *completion-max* 8) ; most rows shown at once
(def *completion-face* face-popup) ; an unselected row
(defdyn *completion-selected-face* face-popup-selected) ; the selection
(def *completion-border-face* face-popup-border) ; the box-drawing frame
;; Foreground-only variants (no `:bg`) for the GUI's rounded card: the text draws over a
;; rounded `frect` surface, so each row must be transparent — else its square cell bg would
;; cover the card's rounded corners. Terminal/tests keep the opaque faces above.
(def *completion-fg-face* {:fg *text*}) ; an unselected row's text, transparent bg
(def *completion-selected-fg-face* {:fg *base* :bold true}) ; the selected row's text (over the pill)
(def *completion-card-radius* 0.5) ; corner radius (cells) of the rounded GUI card
;; ---- shared file-meta formatters (`ls -l` columns) --------------------------
;; Turn a `file-stat` map into display columns. Generic + shared: dired (commands) and
;; the Plume minibuffer's `:file` marginalia (src/plume.blsp) both format permissions
;; identically through these.

(defn rwx (n)
  "The `rwx`/`-` triad for a 3-bit permission group `n` (0–7)."
  (str (if (>= (rem (quot n 4) 2) 1) "r" "-")
    (if (>= (rem (quot n 2) 2) 1) "w" "-")
    (if (>= (rem n 2) 1) "x" "-")))

(defn perms-string (st)
  "The 10-char `ls -l` permission string for `file-stat` map `st`: a type char
(`d`/`l`/`-`) then the owner/group/other rwx triads from `:mode`. `----------` for a
missing stat."
  (if (nil? st)
    "----------"
    (let (mode (or (:mode st) 0)
          type (cond (:symlink? st) "l" (:dir? st) "d" :else "-"))
      (str type (rwx (quot (rem mode 512) 64)) (rwx (quot (rem mode 64) 8)) (rwx (rem mode 8))))))

;; ---- ranking ----------------------------------------------------------------

(defn completion-rank (query items)
  "The items fuzzily matching `query`, best first (`std/fuzzy`); an empty `query`
returns them unchanged. The single seam every completer ranks through. (`fuzzy-filter`
itself lowers the query once and sorts by a precomputed key, so ranking thousands of
candidates is fast — see `std/fuzzy`.)"
  (fuzzy-filter query items))

(defn completion-rank-incremental (query prev-query prev-ranked source)
  "Like `completion-rank query source`, but when `query` **extends** `prev-query`
(`starts-with?`) it ranks the previous full result `prev-ranked` instead of the whole
`source`. This is exact, not an approximation: fuzzy matching is a subsequence test, so
appending a query char can only *drop* candidates (monotone — every match of the longer
query already matched the shorter one), and each candidate is scored independently of the
others, so ranking the previous matches yields the identical set and order as ranking all
of `source`. The payoff: narrowing a large source (a whole project's files) costs
O(previous matches), not O(source), per keystroke. Falls back to the full `source` with no
previous result, an empty query, or a query that didn't extend (a backspace or a mid-edit)."
  (if (and prev-query prev-ranked (not (= query "")) (string/starts-with? query prev-query))
    (completion-rank query prev-ranked)
    (completion-rank query source)))

;; ---- the vertical menu (shared geometry + rendering) ------------------------

(defn completion-menu-width (items)
  "A column width for the menu: the widest item, clamped to [8, 40]. Public so a caller
can clamp the menu's column to the screen before rendering."
  (min 40 (max 8 (fold (fn (w s) (max w (string/length s))) 0 items))))

(defn- completion-cell
  (s w)
  "An item rendered as a menu row: ` <item padded to w> ` (one space of padding). An
item wider than `w` is shortened by keeping its **tail** behind a leading `…` (so a long
file path still shows its filename, not just the directory prefix)."
  (let (len (string/length s)
        clip (if (> len w)
               (str "…" (string/substring s (- (+ len 1) w) len)) ; … + the last (w-1) chars
               s))
    (str " " clip (string/repeat " " (- w (string/length clip))) " ")))

;; The popup card's geometry + hit-test moved to `src/ui-kit.blsp` (`ui-list` / `ui-panel` /
;; `ui-list-measure`) — one widget now renders AND hit-tests the completion popup and the
;; right-click menu alike, so no shared card-rect geometry lives here any more.

(defn completion-window-start (total selected vis)
  "The index of the first visible item when a `vis`-row window scrolls to keep
`selected` centred in a list of `total` items."
  (max 0 (min (- total vis) (- selected (quot vis 2)))))

;; The in-buffer popup card is now ONE `ui-list` in a frameless `ui-panel` (src/ui-kit.blsp,
;; via complete-at-point/complete-popup-ops) — the same widget behind the right-click menu —
;; so no popup-specific renderer lives here any more. This layer keeps only the pieces both
;; the popup and Plume still share: `completion-window-start`, `completion-menu-width`, and
;; `completion-cell`.

;; The marginalia-annotated row renderer + the N/M counter live in the Plume layer
;; (src/plume.blsp), built on `completion-cell` and the faces above.
