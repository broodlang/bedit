(defmodule completion
  "The editor's completion framework: **fuzzy ranking** (`std/fuzzy`) + a **navigable
vertical-list menu**, shared by the in-buffer popup (`complete`, anchored at point —
Corfu-style) and the minibuffer prompt (`input`/`view`, anchored at the prompt —
Vertico-style). The menu renderer owns the scroll window around the selection, the
width clamp, and the per-row faces; each caller supplies only the placement (the
visible height + the top-left anchor it computes for its context). The look
(`*completion-*-face*`, `*completion-max*`) is redefinable live (ricing)."
  (:use editor/display)  ; the `text` render op
  (:use theme)  ; the curated palette + popup faces (src/theme.blsp)
  (:use fuzzy))  ; fuzzy-filter — the one ranking seam

;; ---- look (redefine to rice the menu) ---------------------------------------
;; The popup faces are the theme's (a dark card, not the old stark white box).
;; Still plain `def`s — redefine one live to re-skin the menu.

(def *completion-max* 8)  ; most rows shown at once
(def *completion-face* face-popup)  ; an unselected row
(def *completion-selected-face* face-popup-selected)  ; the selection
(def *completion-border-face* face-popup-border)  ; the box-drawing frame

;; ---- ranking ----------------------------------------------------------------

(defn completion-rank (query items)
  "The items fuzzily matching `query`, best first (`std/fuzzy`); an empty `query`
returns them unchanged. The single seam every completer ranks through."
  (fuzzy-filter query items))

(defn completion-rank-incremental (query prev-query prev-ranked source)
  "Like `completion-rank query source`, but when `query` **extends** `prev-query`
(`starts-with?`) it ranks the previous full result `prev-ranked` instead of the whole
`source`. This is exact, not an approximation: fuzzy matching is a subsequence test, so
appending a query char can only *drop* candidates (monotone — every match of the longer
query already matched the shorter one), and each candidate is scored independently of the
others, so ranking the previous matches yields the identical set and order as ranking all
of `source`. The payoff: narrowing a large source (a whole project's files) costs
O(previous matches), not O(source), per keystroke. Falls back to the full `source` with no
previous result, an empty query, or a query that didn't extend (a backspace or a mid-edit)."
  (if (and prev-query prev-ranked (not (= query "")) (starts-with? query prev-query))
    (completion-rank query prev-ranked)
    (completion-rank query source)))

;; ---- the vertical menu (shared geometry + rendering) ------------------------

(defn completion-menu-width (items)
  "A column width for the menu: the widest item, clamped to [8, 40]. Public so a caller
can clamp the menu's column to the screen before rendering."
  (min 40 (max 8 (fold (fn (w s) (max w (string-length s))) 0 items))))

(defn completion--cell (s w)
  "An item rendered as a menu row: ` <item padded to w> ` (one space of padding). An
item wider than `w` is shortened by keeping its **tail** behind a leading `…` (so a long
file path still shows its filename, not just the directory prefix)."
  (let (len (string-length s)
        clip (if (> len w)
               (str "…" (substring s (- (+ len 1) w) len))  ; … + the last (w-1) chars
               s))
    (str " " clip (string-repeat " " (- w (string-length clip))) " ")))

(defn completion-box-rect (row col labels cols rows)
  "`[mr mc w n]` for a bordered popup box of `labels` anchored at `(row, col)`: the
top-left clamped so the `(w+4)`×`(n+2)` box stays on the `cols`×`rows` screen (above the
mode line), the item width `w`, and item count `n`. Shared by a menu's renderer and its
click hit-test so a menu near a screen edge is still clickable where it's drawn."
  (let (n (count labels)
        w (completion-menu-width labels))
    [(max 0 (min (- rows 2 (+ n 2)) row)) (max 0 (min (- cols (+ w 4)) col))
      w
      n]))

(defn completion-window-start (total selected vis)
  "The index of the first visible item when a `vis`-row window scrolls to keep
`selected` centred in a list of `total` items."
  (max 0 (min (- total vis) (- selected (quot vis 2)))))

(defn completion-menu-ops (window wstart selected row0 col w)
  "`text` ops for the pre-sliced `window` (its items occupy absolute indices
`[wstart, wstart+len)`), rendered as a **bordered box** whose top-left cell is screen
`(row0, col)`: a box-drawing frame around the rows, each row (` <item> ` padded to width
`w`) in `*completion-face*` with the absolute-index `selected` row in
`*completion-selected-face*`. Box size: `(w+4)` wide × `(len+2)` tall — so the popup
reads as a floating box over the buffer, not as reverse-video text. The shared list
renderer — callers compute `window`/`wstart`/`w` and a `row0`/`col` box corner that
leaves room for the +2 frame. Used by the in-buffer popup, the minibuffer list, and the
right-click menu, so all three look identical."
  (let (n (count window)
        bar (string-repeat "─" (+ w 2))
        bf *completion-border-face*)
    (concat [(text row0 col (str "┌" bar "┐") bf)]
      (mapcat (fn (i)
                (let (sel? (= (+ wstart i) selected))
                  (list (text (+ row0 1 i) col "│" bf)
                    (text (+ row0 1 i)
                      (+ col 1)
                      (completion--cell (nth window i) w)
                      (if sel? *completion-selected-face* *completion-face*))
                    (text (+ row0 1 i) (+ col 3 w) "│" bf))))
        (range n))
      [(text (+ row0 1 n) col (str "└" bar "┘") bf)])))
