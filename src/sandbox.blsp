(defmodule sandbox
  "The persistent **Brood** eval sandbox — one `nest`/`brood` child running std's
`eval-server` (ADR-198), supervised by `std/editor/evalsession`.

The editor gets REPL-grade evaluation of playground and tutorial text — value, captured
output, errors, per-request timeout — in a *separate OS process*, so nothing the user
types can reach the live editor image (the in-image eval path is mutation-unsafe by
design — one shared global table; see eval-command).

**What is left here is the BROOD part**, and only that: how to find a runtime and start
one on a generated script, how to put a request on `eval-server`'s pr-str wire, and how
to turn a session event into the `UiEvent` records the `ui-run` loop folds.

Everything else — queue-until-ready, id-matched replies, the watchdog and its
queue-position deadlines, generations, strikes, respawn, reroot — is
`editor/evalsession`, which the Elixir session uses too. That was four hundred lines of
supervision policy sitting in this file with nothing Brood-specific about any of it, and
the moment a second language needed a session it had to be either shared or copied. The
copy is the thing the prime directive exists to prevent: two supervisors drift, and the
one you are not looking at is the one that loses a reply.

Events are stamped with a generation (bumped on every spawn/reset) so a superseded
child's stragglers are droppable by the folds, the testrun/apprun discipline. The folds
themselves live with the consumers, routed by `sandbox-events`.")
;; No imports — os/spawn, file/spit and path/temp are prelude; `editor/evalsession` and
;; the codec (`eval-server/*`) are referenced qualified below and auto-load.

;; The events are `session`'s — `session-ready` / `session-reply` / `session-down`, each
;; carrying the name below — and the folds live with the consumers, via `sandbox-events`.
;; This module carries no event vocabulary of its own: it is a BACKEND, and a backend that
;; also defined records existed only so a router could tell whose event it was holding,
;; which is a fact the session already knows about itself.
(def *session* :sandbox) ; the registered name of the worker process

;; ---- the child ----------------------------------------------------------------

;; Minted once per editor process (`temp-path` — random, unguessable). NOT a fixed
;; name like "/tmp/bedit-eval-server.blsp": that is one file two editors fight over,
;; and a path anyone on the machine can create first as a symlink, so this `spit`
;; would overwrite their choice of file with our privileges and then run it.
;; `.blsp`, because the child may run INSIDE A PROJECT (rooted there for its checks), and
;; `nest run` takes a non-`.blsp` file in a project for a document to open, not a script.
(def *sandbox-script-path* (str (path/temp "bedit-eval-server-") ".blsp"))

;; The request timeout applied when the caller passes nil (mirrors the server's own
;; default, so both ends agree on how long an eval may run).
(def *sandbox-default-timeout-ms* 5000)

;; A Brood child loads an image and announces itself in well under a second; twenty is
;; generous for a cold one in a large project. (The Elixir session asks for minutes,
;; because its boot compiles a project — which is exactly why the budget is the
;; backend's to state and not the supervisor's to assume.)
(def *sandbox-boot-timeout-ms* 20000)

(defn- sandbox-script-source ()
  (string/join (map (list '(eval-server/run)) pr-str) "\n"))

;; ---- finding a runtime to be the child ---------------------------------------
;; The child is a Brood runtime running a two-line script, so any of these will do. PATH
;; first (a dev checkout, `nest run`), then a SIBLING of the running executable — because a
;; desktop launch does not inherit a login shell's PATH, and a GNOME session's routinely
;; lacks ~/.local/bin. An installed `bedit` sits next to the `nest` that built it, so
;; "beside me" is the lookup that works when PATH doesn't (`exe-path`).
;;
;; `brood` is offered as well as `nest`: it runs a script directly and is installed by the
;; same `make install`. What no candidate can be is `bedit` itself — a release bundle boots
;; its `:main`, so it cannot host an arbitrary script (noted in ../brood/docs/deferred.md as
;; the "a bundle as its own runtime" question).

(defn- sandbox-sibling (prog)
  "`prog` next to the running executable, or nil when there is no such file (or the platform
won't say where we live)."
  ;; a platform that cannot name its executable is the documented nil case
  (let (exe (check-allow :discarded-catch (try (os/exe-path) (catch _ nil))))
    (when (string? exe)
      (let (candidate (path/join (path/dirname exe) prog))
        (when (file/exists? candidate) candidate)))))

(defn- sandbox-runtimes ()
  "The programs to try as the sandbox child, in order: on PATH, then beside this binary."
  (append ["nest" "brood"]
    (into [] (seq/reject (list (sandbox-sibling "nest") (sandbox-sibling "brood")) nil?))))

(def *sandbox-default-root* "/tmp")
;; The child's cwd when no project asked for it: projectless — a bare std image, no
;; project sources, so it starts fast and the session begins empty (the tutorial's case).

(defn- sandbox-spawn-with (prog script root)
  ;; `nest` needs the `run` subcommand; `brood` takes the script directly.
  (let (args (if (= "nest" (path/basename prog)) ["run" script] [script]))
    ;; `prog` is one candidate runtime of several — failing to spawn it means try the next
    (check-allow :discarded-catch (try (os/spawn prog args {:cwd root}) (catch _ nil)))))

(defn spawn-runtime-on (script root)
  "Start the first runtime that will have it on `script`, cwd `root` — nil when none can be
spawned (none on PATH, none beside us, an unreadable script).

Public because the eval sandbox is not the only child that is \"a Brood runtime running a
short script\": the warm TEST session (`brood-test`) is the same question with a different
script, and \"what can host an eval-server?\" should have one answer rather than a copy per
caller that starts one."
  (fold (sandbox-runtimes) nil (fn (found prog) (or found (sandbox-spawn-with prog script root)))))

(defn spawn-child (root &optional (attempt 0))
  "`evalsession`'s `:spawn` hook. cwd `root`: a PROJECT root puts that project's sources on
the child's load path (`nest run` sets up the project it is started in — lazily, nothing
eagerly loaded), which is what lets a `:check` resolve the project's own modules there and
never in the editor; `*sandbox-default-root*` is the projectless session.

nil when NO candidate runtime can be spawned (none on PATH, none beside us, unwritable
script path) — which the session turns into a `:spawn-failed` event rather than a crashed
worker.

`attempt` is unused: unlike the Elixir session, there is no second way to start a Brood
child that might work where the first did not."
  (try
    (do
      (file/spit *sandbox-script-path* (sandbox-script-source))
      (spawn-runtime-on *sandbox-script-path* root))
    (catch e (do (log/warn (str "sandbox: could not start a child: " (error-message e))) nil))))

;; ---- the wire ------------------------------------------------------------------

(defn encode-request (id timeout-ms payload)
  "`evalsession`'s `:encode` hook — one `eval-server` request line. `payload` is
`{:src :trace :check?}`; a `:check?` asks the CHECKER for its verdict on the source
instead of evaluating it."
  (if (:check? payload)
    (eval-server/evsrv-encode-check id (:src payload) timeout-ms)
    (eval-server/evsrv-encode-request id (:src payload) timeout-ms (:trace payload))))

(defn decode-reply (line)
  "`evalsession`'s `:decode` hook — the reply map in `line`, or nil when the line is not
one. Both ends are Brood, so the reader IS the parser; a nil is a stray print from
something the evaluated code spawned, and the session drops it."
  (eval-server/evsrv-decode-reply line))

(defn emit (sink kind payload gen name)
  "`evalsession`'s `:emit` hook — [[session/emit-after-script]] over this backend's script.

A `:sink` is what a TEST sets: a global name is exactly the dependency a pure step must not
have — tests run in parallel, each its own process, and every one registering the same
`:editor` handed one test's events to another."
  (session/emit-after-script *sandbox-script-path* sink kind payload gen name))

(def *spec*
  {:spawn 'sandbox/spawn-child
   :encode 'sandbox/encode-request
   :decode 'sandbox/decode-reply
   :emit 'sandbox/emit
   :boot-timeout-ms sandbox/*sandbox-boot-timeout-ms*
   :default-timeout-ms sandbox/*sandbox-default-timeout-ms*})

;; ---- the client API (what tutor / playground / the diagnostics path call) --------

(defn sandbox-running? ()
  "Whether the `:sandbox` worker process is alive."
  (session/running? *session*))

(defn sandbox-projectless-root ()
  "The root of the projectless session (`*sandbox-default-root*`) — for a client that wants
to ask for it by name from another module (an ambient `*var*` is bare, not namespaced)."
  *sandbox-default-root*)

(defn sandbox-start (&optional (root nil) (sink nil))
  "Ensure the `:sandbox` worker is up (named spawn is idempotent) and return its pid,
the child rooted in `root` — a project root, whose sources the child then resolves.
A worker already running in another root is re-rooted (a respawn there) when `root` is
given; nil means any root will do (the tutorial's case): a new worker starts projectless,
a running one is left where it is. The child runtime starts spawning immediately — call
this when the tutorial opens, so its startup hides behind the user reading."
  (session/start *session* *spec* (or root *sandbox-default-root*) sink))

(defn sandbox-next-id (m)
  "The next request id to put on the wire, from the model. ONE counter for every session,
because a reply is matched by id alone: the tutorial, the playground, the diagnostics
check and the Elixir session are clients of two different children, and a counter each had
them all minting `1`, `2`, `3` — so a reply fanned out to every client was accepted by
whichever one's pending entry it hit first. A tutorial box could be handed the
playground's answer."
  (get-in m [:sandbox :next-id] 1))

(defn sandbox-ids-used (m next-id)
  "Record `next-id` as the next unused request id — what a client that minted some writes
back. Paired with [[sandbox-next-id]] so neither client spells the key."
  (assoc-in m [:sandbox :next-id] next-id))

(defn sandbox-eval (id src timeout-ms &optional trace)
  "Fire-and-forget: evaluate `src` in the sandbox session, boundary-tracing the `trace` fn
names (a vector of strings, `:all`, or nil) — the reply's `:spy` carries the collected
entries. The reply arrives on the editor mailbox as a `sandbox-reply-event` carrying
`:id id`. Queued (not lost) if the child is still booting.

Answers whether the request was ACCEPTED. False means the worker is not running (it gave
up, or never started) and no reply for this id will ever arrive — the caller must not
record it as in flight, or the form it belongs to waits on an answer that is not coming
and, being already \"in flight\", is never re-sent either."
  (session/request *session* id timeout-ms {:src src :trace trace}))

(defn sandbox-check (id src timeout-ms)
  "Fire-and-forget: ask the child's CHECKER about `src` — the reply's `:diagnostics` is
the list of `{:line :col :message}` maps, whole (eval-server's `:check`). The reply
arrives as a `sandbox-reply-event` carrying `:id id`; queued while the child boots.
Answers whether the request was accepted, like [[sandbox-eval]]."
  (session/request *session* id timeout-ms {:src src :check? true}))

(defn sandbox-reset ()
  "Restart the sandbox session: respawn the child (fresh image, empty session),
answering any inflight requests `{:timeout true}`. A no-op when not running."
  (session/reset *session*))

(defn sandbox-shutdown ()
  "Kill the child and stop the worker. A no-op when not running."
  (session/shutdown *session*))
