(defmodule sandbox
  "The persistent eval sandbox: one long-lived NAMED process (`:sandbox`) that owns
a `proc-spawn`ed child runtime running std's `eval-server` (`(require
'eval-server)` + `(run)`, ADR-198) and speaks its pr-str-line protocol
over stdin/stdout. The editor gets REPL-grade evaluation of playground text —
value, captured output, errors, per-request timeout — in a *separate OS process*,
so nothing the user types can reach the live editor image (the in-image eval path
is mutation-unsafe by design — one shared global table; see eval-command).

lsp.blsp's connection shape, simplified: requests are fire-and-forget sends to the
worker (`sandbox-eval`); replies come back to the `ui-run` mailbox as event
records — `sandbox-ready-event` / `sandbox-reply-event` / `sandbox-down-event` —
whose `UiEvent` folds live with their consumer (`tutor`), keeping this module
consumer-blind. Policy:

  - requests sent before the child's `{:ready true}` banner QUEUE in the worker
    and flush on ready (the ~startup pause happens once, while the user reads);
  - a reply is matched out of `:inflight` by id; stray child output (a process the
    evaluated code spawned printing late) decodes to nil and is dropped;
  - a request whose reply never arrives (a wedged child — the server's own
    green-process kill missed, e.g. a native loop) trips the WATCHDOG: the child
    is killed and respawned, every inflight id answered `{:timeout true}`;
  - the child dying on its own respawns after a short pause, so an externally
    killed sandbox heals itself;
  - RESET (session state back to a fresh image) *is* respawn — `sandbox-reset`.

Events are stamped with a generation (bumped on every spawn/reset) so a
superseded child's stragglers are droppable by the folds, the testrun/apprun
discipline.") ; no imports — proc-spawn / proc-send / string ops are prelude; the codec (eval-server/*) is referenced qualified below and auto-loads
;; ---- the event records (folds live with the consumer: tutor) -----------------

(defrecord sandbox-ready-event (gen)) ; the child printed {:ready true} — evals flow
(defrecord sandbox-reply-event (reply gen)) ; one decoded reply map {:id :ok :value :output :error :timeout :ms}
(defrecord sandbox-down-event (code gen)) ; the child exited (a respawn follows)
;; ---- the child ----------------------------------------------------------------

;; Minted once per editor process (`temp-path` — random, unguessable). NOT a fixed
;; name like "/tmp/bedit-eval-server.blsp": that is one file two editors fight over,
;; and a path anyone on the machine can create first as a symlink, so this `spit`
;; would overwrite their choice of file with our privileges and then run it.
(def *sandbox-script-path* (path/temp "bedit-eval-server-"))

;; The request timeout applied when the caller passes nil (mirrors the server's own
;; default, so both ends agree on how long an eval may run).
(def *sandbox-default-timeout-ms* 5000)

;; How long past a request's expected completion the watchdog waits before
;; declaring the child wedged. Generous: the server's in-child kill answers the
;; common case (~4ms); this backstop exists for evals no green kill can stop.
(def *sandbox-grace-ms* 1500)

;; The mailbox-poll cadence while the watchdog has something to watch (requests in
;; flight, or a child still booting).
(def *sandbox-poll-ms* 250)

;; Pause before respawning a child that died on its own — bounds the loop if the
;; child keeps exiting (each death costs at least this).
(def *sandbox-respawn-pause-ms* 500)

;; A child death within this of its spawn counts as a STRIKE (something is wrong
;; with the child itself, not the request load); so does a boot that never prints
;; the ready banner within *sandbox-boot-timeout-ms*. Three consecutive strikes
;; and the worker gives up (a final `:gave-up` event) instead of respawn-looping —
;; a broken image must not spam the editor every half second forever.
(def *sandbox-fast-death-ms* 3000)
(def *sandbox-boot-timeout-ms* 20000)
(def *sandbox-max-strikes* 3)

(defn- sandbox-script-source ()
  (string/join (map (list '(eval-server/run)) pr-str) "\n"))

;; ---- finding a runtime to be the child ---------------------------------------
;; The child is a Brood runtime running a two-line script, so any of these will do. PATH
;; first (a dev checkout, `nest run`), then a SIBLING of the running executable — because a
;; desktop launch does not inherit a login shell's PATH, and a GNOME session's routinely
;; lacks ~/.local/bin. An installed `bedit` sits next to the `nest` that built it, so
;; "beside me" is the lookup that works when PATH doesn't (`exe-path`).
;;
;; `brood` is offered as well as `nest`: it runs a script directly and is installed by the
;; same `make install`. What no candidate can be is `bedit` itself — a release bundle boots
;; its `:main`, so it cannot host an arbitrary script (noted in ../brood/docs/deferred.md as
;; the "a bundle as its own runtime" question).

(defn- sandbox-sibling (prog)
  "`prog` next to the running executable, or nil when there is no such file (or the platform
won't say where we live)."
  ;; a platform that cannot name its executable is the documented nil case
  (let (exe (check-allow :discarded-catch (try (os/exe-path) (catch _ nil))))
    (when (string? exe)
      (let (candidate (path/join (path/dirname exe) prog))
        (when (file/exists? candidate) candidate)))))

(defn- sandbox-runtimes ()
  "The programs to try as the sandbox child, in order: on PATH, then beside this binary."
  (append ["nest" "brood"]
    (into []
      (filter (list (sandbox-sibling "nest") (sandbox-sibling "brood")) (fn (p) (not (nil? p)))))))

(defn- sandbox-spawn-with (prog)
  ;; `nest` needs the `run` subcommand; `brood` takes the script directly.
  (let (args (if (= "nest" (path/basename prog))
               ["run" *sandbox-script-path*]
               [*sandbox-script-path*]))
    ;; `prog` is one candidate runtime of several — failing to spawn it means try the next
    (check-allow :discarded-catch (try (os/spawn prog args {:cwd "/tmp"}) (catch _ nil)))))

(defn- sandbox-spawn-child ()
  ;; cwd /tmp: the sandbox is deliberately projectless — a bare std image, no
  ;; project sources, so it starts fast and the session begins empty. nil when NO
  ;; candidate runtime can be spawned (none on PATH, none beside us, unwritable script
  ;; path) — the callers turn that into a `:spawn-failed` event rather than a worker crash.
  (try
    (do
      (file/spit *sandbox-script-path* (sandbox-script-source))
      (fold (sandbox-runtimes) nil (fn (found prog) (or found (sandbox-spawn-with prog)))))
    (catch e (do (log/warn (str "sandbox: could not start a child: " (error-message e))) nil))))

(defn- sandbox-editor () (proc/whereis :editor))

(defn- sandbox-emit (ev)
  ;; The editor process may be gone (shutdown race) — dropping the event is right.
  (let (ed (sandbox-editor))
    (when ed (send ed ev))))

;; ---- the worker ---------------------------------------------------------------
;; State is one map threaded through the tail-recursive loop:
;;   :proc        the child handle
;;   :buf         the stdout partial (line assembly, procstream's discipline)
;;   :ready       seen {:ready true} yet?
;;   :queue       requests received before ready, oldest first (flushed on ready)
;;   :inflight    {id -> deadline-epoch-ms} — the watchdog's view
;;   :gen         the child generation (bumped every spawn), stamped on every event
;;   :spawned-at  when this child was spawned (fast-death / boot-timeout clock)
;;   :strikes     consecutive child failures (reset by a ready banner)

(defn- sandbox-deadline (inflight timeout-ms t)
  "The watchdog deadline for a request sent at time `t` while `inflight` (id →
deadline) is outstanding. Accounts for QUEUE POSITION: the server answers strictly
one request at a time, so this request can't even start until every earlier
inflight deadline could have passed — without this, one legitimately-slow box
pushed the next box past its deadline and the watchdog killed a HEALTHY child."
  (let (base (fold inflight t (fn (acc kv) (math/max acc (second kv)))))
    (+ base (or timeout-ms *sandbox-default-timeout-ms*) *sandbox-grace-ms*)))

(defn- sandbox-send-request (state id src timeout-ms trace)
  (os/write (:proc state)
    (str (eval-server/evsrv-encode-request id src timeout-ms trace) "\n"))
  (update state
    :inflight assoc
    id
    (sandbox-deadline (:inflight state) timeout-ms (os/now))))

(defn- sandbox-flush-queue (state)
  ;; Oldest first: the queue was consed, so fold over its reverse.
  (fold (reverse (:queue state))
    (assoc state :queue ())
    (fn (st req)
      (let ([id src timeout-ms trace] req)
        (sandbox-send-request st id src timeout-ms trace)))))

(defn- sandbox-handle-line (state line)
  "Fold one complete stdout line: the ready banner flips `:ready` (flushing the
queue, resetting the strike count) and announces itself; an id-carrying reply
settles its inflight entry and forwards; anything else is a stray print — dropped."
  (let (reply (eval-server/evsrv-decode-reply line))
    (cond
      (nil? reply) state
      (get reply :ready)
        (do
          ;; The banner proves the child has read its script, so the
          ;; file has done its job — remove it rather than leave one
          ;; per editor run in /tmp (the price of an unguessable name
          ;; is that the path is no longer reused). Best-effort: a
          ;; respawn re-spits it, and failing to delete is harmless.
          (try
            (file/rm *sandbox-script-path*)
            (catch e (log/warn (str "sandbox: could not remove its script: " (error-message e)))))
          (sandbox-emit (sandbox-ready-event (:gen state)))
          (sandbox-flush-queue (assoc state :ready true :strikes 0)))
      (int? (get reply :id))
        (do
          (sandbox-emit (sandbox-reply-event reply (:gen state)))
          (update state :inflight dissoc (get reply :id)))
      else state)))

(defn- sandbox-feed (state data)
  "Assemble stdout chunks into lines (the trailing partial carries over) and fold
each complete line through `sandbox-handle-line`."
  (let (parts (string/split (str (:buf state) data) "\n")
        complete (take parts (dec (count parts))))
    (assoc (fold complete state sandbox-handle-line) :buf (last parts))))

(defn- sandbox-fail-inflight (state why)
  "Answer every inflight id with a failure reply (`why` merged in) — the respawn
paths' obligation: no request may vanish without an answer."
  (doseq (kv (:inflight state))
    (let ([id _] kv)
      (sandbox-emit (sandbox-reply-event (merge {:id id :ok false} why) (:gen state)))))
  (assoc state :inflight {}))

(defn- sandbox-respawn (state)
  "A fresh child + generation; inflight requests are answered `{:timeout true}`
first (they died with the old session). `:sandbox-stopped` (after a
`:spawn-failed` event) when a new child can't even be spawned."
  (let (st (sandbox-fail-inflight state {:timeout true}))
    (try
      (os/close (:proc st))
      (catch e (log/warn (str "sandbox: close failed: " (error-message e)))))
    (let (child (sandbox-spawn-child))
      (if (nil? child)
        (do
          (sandbox-emit (sandbox-down-event :spawn-failed (:gen st)))
          :sandbox-stopped)
        {:proc child
         :buf ""
         :ready false
         :queue (:queue st)
         :inflight {}
         :gen (inc (:gen st))
         :spawned-at (os/now)
         :strikes (or (:strikes st) 0)}))))

(defn- sandbox-strike (state)
  "One consecutive child failure (a fast death, a boot that never readied): respawn
— unless this is strike `*sandbox-max-strikes*`, in which case give up loudly
(one final `:gave-up` event) instead of respawn-looping forever."
  (let (strikes (inc (or (:strikes state) 0)))
    (if (>= strikes *sandbox-max-strikes*)
      (do
        (sandbox-emit (sandbox-down-event :gave-up (:gen state)))
        (let (st (sandbox-fail-inflight state {:timeout true}))
          (try
            (os/close (:proc st))
            (catch e (log/warn (str "sandbox: close failed: " (error-message e)))))
          :sandbox-stopped))
      (let (st (sandbox-respawn state))
        (if (= st :sandbox-stopped) st (assoc st :strikes strikes))))))

(defn- sandbox-wedged? (state)
  "Whether any inflight request has outlived its deadline — the child stopped
answering entirely (the server's own per-request kill should have replied
`{:timeout true}` long before this trips)."
  (let (t (os/now))
    (not (empty? (filter (:inflight state) (fn (kv) (let ([_ deadline] kv) (> t deadline))))))))

(defn- sandbox-boot-overdue? (state)
  ;; a spawned child that never printed its ready banner
  (and (not (:ready state))
    (> (os/now) (+ (or (:spawned-at state) 0) *sandbox-boot-timeout-ms*))))

(defn- sandbox-check (state)
  ;; the watchdog beat: a wedged child or an overdue boot is a strike
  (if (or (sandbox-wedged? state) (sandbox-boot-overdue? state))
    (sandbox-strike state)
    state))

(defn- sandbox-step (state msg)
  "Fold one mailbox message into the worker state; `:sandbox-stopped` ends the loop."
  (match msg
    ([:eval id src timeout-ms trace] (if (:ready state)
                                       (sandbox-send-request state id src timeout-ms trace)
                                       (update state
                                         :queue (fn (q) (cons [id src timeout-ms trace] q)))))
    ([:proc p data] (if (= p (:proc state)) (sandbox-feed state data) state))
    ([:proc-err _ _] state) ; child stderr is not protocol — ignore
    ([:proc-closed p code]
      (if (= p (:proc state))
        (do
          (sandbox-emit (sandbox-down-event code (:gen state)))
          ;; a death soon after spawn = the child itself is broken — strike (and
          ;; possibly give up); a late death (killed externally) just respawns
          (if (< (- (os/now) (or (:spawned-at state) 0)) *sandbox-fast-death-ms*)
            (sandbox-strike state)
            (do (sleep *sandbox-respawn-pause-ms*) (sandbox-respawn state))))
        state))
    ([:reset]
      (let (st (sandbox-respawn state))
        ; user-initiated: strikes forgiven
        (if (= st :sandbox-stopped) st (assoc st :strikes 0))))
    ([:shutdown] (do
                   (try
                     (os/close (:proc state))
                     (catch e (log/warn (str "sandbox: close failed: " (error-message e)))))
                   :sandbox-stopped))
    (_ state)))

(defn- sandbox-loop (state)
  (cond
    (= state :sandbox-stopped) :sandbox-stopped
    ;; nothing to watch: park until a message arrives
    (and (:ready state) (empty? (:inflight state)))
      (sandbox-loop (sandbox-step state (receive (msg msg))))
    ;; watchdog duty (requests in flight, or a child still booting): poll
    else
      (receive
        (msg (sandbox-loop (sandbox-step state msg)))
        (after *sandbox-poll-ms*
          (sandbox-loop (sandbox-check state))))))

(defn sandbox-worker ()
  "The `:sandbox` process body: spawn the child and serve until `[:shutdown]` (or
a `:spawn-failed` / `:gave-up` stop — see the events)."
  (let (child (sandbox-spawn-child))
    (if (nil? child)
      (do (sandbox-emit (sandbox-down-event :spawn-failed 1)) :sandbox-stopped)
      (sandbox-loop {:proc child
                     :buf ""
                     :ready false
                     :queue ()
                     :inflight {}
                     :gen 1
                     :spawned-at (os/now)
                     :strikes 0}))))

;; ---- the client API (what tutor calls) ----------------------------------------

(defn sandbox-running? ()
  "Whether the `:sandbox` worker process is alive."
  (not (nil? (proc/whereis :sandbox))))

(defn sandbox-start ()
  "Ensure the `:sandbox` worker is up (named spawn is idempotent) and return its pid.
The child runtime starts spawning immediately — call this when the tutorial opens,
so its startup hides behind the user reading."
  (spawn :sandbox (sandbox-worker)))

(defn sandbox-eval (id src timeout-ms &optional trace)
  "Fire-and-forget: evaluate `src` in the sandbox session, boundary-tracing the
`trace` fn names (a vector of strings, or nil) — the reply's `:spy` carries the
collected entries. The reply arrives on the editor mailbox as a
`sandbox-reply-event` carrying `:id id`. Queued (not lost) if the child is still
booting; a no-op when the worker isn't running."
  (let (p (proc/whereis :sandbox))
    (when p (send p [:eval id src timeout-ms trace]))))

(defn sandbox-reset ()
  "Restart the sandbox session: respawn the child (fresh image, empty session),
answering any inflight requests `{:timeout true}`. A no-op when not running."
  (let (p (proc/whereis :sandbox))
    (when p (send p [:reset]))))

(defn sandbox-shutdown ()
  "Kill the child and stop the worker. A no-op when not running."
  (let (p (proc/whereis :sandbox))
    (when p (send p [:shutdown]))))
