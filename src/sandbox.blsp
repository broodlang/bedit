(defmodule sandbox
  "The persistent **Brood** eval sandbox — one `nest`/`brood` child running std's
`eval-server` (ADR-198), supervised by `std/editor/evalsession`.

The editor gets REPL-grade evaluation of playground and tutorial text — value, captured
output, errors, per-request timeout — in a *separate OS process*, so nothing the user
types can reach the live editor image (the in-image eval path is mutation-unsafe by
design — one shared global table; see eval-command).

**What is here is the BROOD part**, and only that: how to find a runtime and start one
on a generated script, and how to put a request on `eval-server`'s pr-str wire and take
a reply off it. Everything else — queue-until-ready, id-matched replies, the watchdog
and its queue-position deadlines, generations, strikes, respawn, reroot — is
`editor/evalsession`, which the Elixir sessions use too.

Events are `session`'s records, stamped with a generation (bumped on every spawn/reset)
so a superseded child's stragglers are droppable by the folds, which live with the
consumers, routed by `sandbox-events`.")
;; No imports — os/spawn, file/spit and path/temp are prelude; `editor/evalsession` and
;; the codec (`eval-server/*`) are referenced qualified below and auto-load.

(def *session* :sandbox) ; the registered name of the worker process
;; ---- the child ----------------------------------------------------------------

;; Minted once per editor process (`temp-path` — random, unguessable). NOT a fixed
;; name like "/tmp/bedit-eval-server.blsp": that is one file two editors fight over,
;; and a path anyone on the machine can create first as a symlink, so this `spit`
;; would overwrite their choice of file with our privileges and then run it.
;; `.blsp`, because the child may run INSIDE A PROJECT (rooted there for its checks), and
;; `nest run` takes a non-`.blsp` file in a project for a document to open, not a script.
(def *sandbox-script-path* (str (path/temp "bedit-eval-server-") ".blsp"))

;; The request timeout applied when the caller passes nil (mirrors the server's own
;; default, so both ends agree on how long an eval may run).
(def *sandbox-default-timeout-ms* 5000)

;; A Brood child loads an image and announces itself in well under a second; twenty is
;; generous for a cold one in a large project. (The Elixir session asks for minutes,
;; because its boot compiles a project — which is exactly why the budget is the
;; backend's to state and not the supervisor's to assume.)
(def *sandbox-boot-timeout-ms* 20000)

(defn- sandbox-script-source ()
  (string/join (map (list '(eval-server/run)) pr-str) "\n"))

;; ---- finding a runtime to be the child ---------------------------------------
;; The child is a Brood runtime running a two-line script, so any of these will do. PATH
;; first (a dev checkout, `nest run`), then a SIBLING of the running executable — because a
;; desktop launch does not inherit a login shell's PATH, and a GNOME session's routinely
;; lacks ~/.local/bin. An installed `bedit` sits next to the `nest` that built it, so
;; "beside me" is the lookup that works when PATH doesn't (`exe-path`).
;;
;; `brood` is offered as well as `nest`: it runs a script directly and is installed by the
;; same `make install`. What no candidate can be is `bedit` itself — a release bundle boots
;; its `:main`, so it cannot host an arbitrary script (noted in ../brood/docs/deferred.md as
;; the "a bundle as its own runtime" question).

(defn- sandbox-sibling (prog)
  "`prog` next to the running executable, or nil when there is no such program (or the
platform won't say where we live). On Windows `nest` is `nest.exe` there — `os/which`
given a path applies PATHEXT, as a spawn does."
  ;; a platform that cannot name its executable is the documented nil case
  (let (exe (check-allow :discarded-catch (try (os/exe-path) (catch _ nil))))
    (when (string? exe) (os/which (path/join (path/dirname exe) prog)))))

(defn- sandbox-runtimes ()
  "The programs to try as the sandbox child, in order: on PATH, then beside this binary."
  (append ["nest" "brood"]
    (into [] (seq/reject (list (sandbox-sibling "nest") (sandbox-sibling "brood")) nil?))))

(defn- sandbox-spawn-with (prog script root env)
  ;; `nest` needs the `run` subcommand; `brood` takes the script directly. On Windows the
  ;; sibling is `nest.exe`.
  (let (args (if (includes? ["nest" "nest.exe"] (string/lower (path/basename prog)))
               ["run" script]
               [script]))
    ;; `prog` is one candidate runtime of several — failing to spawn it means try the next
    (check-allow :discarded-catch
      (try (os/spawn prog args (if env {:cwd root :env env} {:cwd root})) (catch _ nil)))))

;; A child that RUNS TESTS asks its runtime to be a test run (brood ADR-608): `nest` or
;; `brood` started with `BROOD_TEST_ARM=1` arms before its interpreter exists, exactly as
;; `nest test` does — `BROOD_TEST_RUN`, and a scratch home the XDG homes point into — so a
;; test run from C-c t (the cold runner's `nest run`, the warm test child) writes no file of
;; the user's: not savehist, save-place, transient memory, tutorial progress, the slow-turn
;; log, a shell's history. The editor's eval sandbox is not a test run and does not ask.
(def *test-runner-env* {"BROOD_TEST_ARM" "1"})

(defn spawn-runtime-on (script root &optional (env nil))
  "Start the first runtime that will have it on `script`, cwd `root`, `env` (a map of
variables, `os/spawn`'s `:env`) added to its environment — nil when none can be spawned
(none on PATH, none beside us, an unreadable script). A child that runs tests passes
`*test-runner-env*`.

Public because the eval sandbox is not the only child that is \"a Brood runtime running a
short script\": the warm TEST session (`testrun/brood`) is the same question with a different
script, and \"what can host an eval-server?\" should have one answer rather than a copy per
caller that starts one."
  (fold (sandbox-runtimes)
    nil
    (fn (found prog) (or found (sandbox-spawn-with prog script root env)))))

(defn spawn-child (root &optional (attempt 0))
  "`evalsession`'s `:spawn` hook. cwd `root`: a PROJECT root puts that project's sources on
the child's load path (`nest run` sets up the project it is started in — lazily, nothing
eagerly loaded), which is what lets a `:check` resolve the project's own modules there and
never in the editor; `sandbox-projectless-root` is the projectless session.

nil when NO candidate runtime can be spawned (none on PATH, none beside us, unwritable
script path) — which the session turns into a `:spawn-failed` event rather than a crashed
worker.

`attempt` is unused: unlike the Elixir session, there is no second way to start a Brood
child that might work where the first did not."
  (spawn-child-at *sandbox-script-path* root))

;; The eval child redefines functions all day — a playground or tutorial box re-evaluated
;; per pause, its `defn`s rebound to traced wrappers and back — and brood says so on stderr
;; for each one whose arity moved (`[reload] arity changed for double-: 1 -> 0+`). The session
;; logs a child's stderr as a warning, so that was a *Messages* line per keystroke-pause.
(def- *eval-child-env* {"BROOD_NO_RELOAD_DIAG" "1"})

(defn- spawn-child-at (path root)
  "Write the eval-server script to `path` and start a runtime on it in `root` — nil, with a
warning, when that fails. Each session has its OWN path: a ready banner deletes the script
its child read, and a path two sessions shared could vanish under the second one's start."
  (try
    (do
      (file/spit path (sandbox-script-source))
      (spawn-runtime-on path root *eval-child-env*))
    (catch e (do (log/warn (str "sandbox: could not start a child: " (error-message e))) nil))))

;; ---- the wire ------------------------------------------------------------------

(defn encode-request (id timeout-ms payload)
  "`evalsession`'s `:encode` hook — one `eval-server` request line. `payload` is
`{:src :trace :check?}` for an evaluation — a `:check?` asks the CHECKER for its verdict
instead — or `{:attach :cookie}` / `{:detach}` to move where evaluation happens."
  (cond
    (:check? payload) (eval-server/evsrv-encode-check id (:src payload) timeout-ms)
    (:attach payload) (eval-server/evsrv-encode-attach id (:attach payload) (:cookie payload))
    (:detach payload) (eval-server/evsrv-encode-detach id)
    else (eval-server/evsrv-encode-request id (:src payload) timeout-ms (:trace payload))))

(defn decode-reply (line)
  "`evalsession`'s `:decode` hook — the reply map in `line`, or nil when the line is not
one. Both ends are Brood, so the reader IS the parser; a nil is a stray print from
something the evaluated code spawned, and the session drops it."
  (eval-server/evsrv-decode-reply line))

(defn emit (sink kind payload gen name)
  "`evalsession`'s `:emit` hook — [[session/emit-after-script]] over this backend's script.

A `:sink` is what a TEST sets: a global name is exactly the dependency a pure step must not
have — tests run in parallel, each its own process, and every one registering the same
`:editor` handed one test's events to another."
  (session/emit-after-script *sandbox-script-path* sink kind payload gen name))

(def *spec*
  {:spawn 'sandbox/spawn-child
   :encode 'sandbox/encode-request
   :decode 'sandbox/decode-reply
   :emit 'sandbox/emit
   :boot-timeout-ms sandbox/*sandbox-boot-timeout-ms*
   :default-timeout-ms sandbox/*sandbox-default-timeout-ms*})

;; ---- the client API (what tutor / playground / the diagnostics path call) --------

(defn sandbox-running? ()
  "Whether the `:sandbox` worker process is alive."
  (session/running? *session*))

(defn sandbox-projectless-root ()
  "The child's cwd when no project asked for one: the temp root — a bare std image, no
project sources, so it starts fast and the session begins empty (the tutorial's case).
Asked when a session starts, not fixed when the module loads (TMPDIR / TEMP then)."
  (path/temp-root))

(defn sandbox-start (&optional (root nil) (sink nil))
  "Ensure the `:sandbox` worker is up (named spawn is idempotent) and return its pid,
the child rooted in `root` — a project root, whose sources the child then resolves.
A worker already running in another root is re-rooted (a respawn there) when `root` is
given; nil means any root will do (the tutorial's case): a new worker starts projectless,
a running one is left where it is. The child runtime starts spawning immediately — call
this when the tutorial opens, so its startup hides behind the user reading."
  ;; nil means 'any root will do': it may only pick the projectless root for a session that
  ;; is not running yet. Handing the default to a RUNNING one would re-root it there,
  ;; respawning the child and wiping the playground's definitions.
  (session/start *session*
    *spec*
    (if (and (nil? root) (not (sandbox-running?))) (sandbox-projectless-root) root)
    sink))

(defn sandbox-eval (id src timeout-ms &optional trace)
  "Fire-and-forget: evaluate `src` in the sandbox session, boundary-tracing the `trace` fn
names (a vector of strings, `:all`, or nil) — the reply's `:spy` carries the collected
entries. The reply arrives on the asking loop's mailbox as a `session/session-reply`
carrying `:id id`. Queued (not lost) if the child is still booting.

Answers whether the request was ACCEPTED. False means the worker is not running (it gave
up, or never started) and no reply for this id will ever arrive — the caller must not
record it as in flight, or the form it belongs to waits on an answer that is not coming
and, being already \"in flight\", is never re-sent either."
  (session/request *session* id timeout-ms {:src src :trace trace}))

;; ---- the checking session --------------------------------------------------------
;; A Brood buffer's diagnostics are `:check` requests to a child rooted in THAT buffer's
;; project — its own session, not the `:sandbox` the tutorial and playground evaluate in.
;; A shared one would be re-rooted by every edit to a project file and back by the
;; playground: each move a respawn, wiping the playground's definitions.

(def *check-session* :sandbox-check)
(def *check-script-path* (str (path/temp "bedit-check-server-") ".blsp"))

(defn spawn-check-child (root &optional (attempt 0))
  "The checking session's `:spawn` hook — [[spawn-child]] on its own script path."
  (spawn-child-at *check-script-path* root))

(defn emit-check (sink kind payload gen name)
  "The checking session's `:emit` hook — forgets ITS script on the ready banner."
  (session/emit-after-script *check-script-path* sink kind payload gen name))

(def *check-spec* (assoc *spec* :spawn 'sandbox/spawn-check-child :emit 'sandbox/emit-check))

(defn sandbox-check-start (root)
  "Ensure the checking session is up, rooted in `root` (re-rooted there if it runs
elsewhere — one project checked at a time, and nothing else lives in it to lose)."
  (session/start *check-session* *check-spec* root nil))

(defn sandbox-check (id src timeout-ms)
  "Fire-and-forget: ask the checking child's CHECKER about `src` — the reply's
`:diagnostics` is the list of `{:line :col :message}` maps, whole (eval-server's `:check`).
The reply arrives as a `session-reply` of `:sandbox-check` carrying `:id id`; queued while
the child boots. Answers whether the request was accepted, like [[sandbox-eval]]."
  (session/request *check-session* id timeout-ms {:src src :check? true}))

(defn sandbox-check-running? ()
  "Whether the checking session's worker is alive."
  (session/running? *check-session*))

(defn sandbox-check-shutdown ()
  "Kill the checking child and stop its worker. A no-op when not running."
  (session/shutdown *check-session*))

(defn sandbox-attach (id spec cookie)
  "Point the session at the node `spec` names — `\"name\"` for a local node over its Unix
socket, `\"name@host:port\"` over TCP. Every later evaluation runs THERE.

The mirror of `beam-attach`, and the same discipline: the node is typed, the cookie is
asked for, and the reply says whether it happened. Its one extra requirement is Brood's
rather than bedit's — the target must have called `(node/serve-spawns)`, which is the
opt-in that makes a program reachable at all."
  (session/request *session* id 20000 {:attach spec :cookie cookie}))

(defn sandbox-detach (id)
  "Route the session back to its own runtime."
  (session/request *session* id 10000 {:detach true}))

(defn sandbox-reset ()
  "Restart the sandbox session: respawn the child (fresh image, empty session),
answering any inflight requests `{:timeout true}`. A no-op when not running."
  (session/reset *session*))

(defn sandbox-shutdown ()
  "Kill the child and stop the worker. A no-op when not running."
  (session/shutdown *session*))
