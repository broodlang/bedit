(defmodule desktopprefs
  "Following the desktop's preferences (brood's `gui/desktop-preferences`), as a GTK app on it
does:

- its light or dark setting picks the theme when init.blsp names no `:theme` (`:theme-light` /
  `:theme-dark`), as M-x theme-select would;
- its text rendering is the window's when `:text-aa` is `:desktop` (the default): on GNOME,
  GTK 4 draws grayscale, slightly hinted text blended in sRGB whatever the older font keys
  say, so the window does too (`config/window-settings`);
- its caret blink is the caret's when init.blsp sets no `:blink-cursor-blinks`: VTE's phase
  (half the desktop's on-off cycle), stopping after the desktop's timeout, or steady when it
  says not to blink (`model/ed-caret-blinks?`).

Asked once at startup ([[ensure-read!]], what the window's first settings and
`startup/apply-look` share) and again every `*check-ms*`, off the loop since asking runs the desktop's
settings tool; a change applies live. The last answer is kept process-wide
([[last-known]]): the window's text settings are the process's, not a model's. A served
session's desktop is its client's, and a test never asks."
  (:use model)) ; register-timer-client / register-task-reply / message

(def *check-ms* 30000) ; how often the desktop is asked again

(defn- ask ()
  ;; the desktop's preferences as it answers now (`gui/desktop-preferences`), `{}` when it says
  ;; nothing — and never asked under a test (`config-paths/under-test?`), which keeps every default
  (if (config-paths/under-test?) {} (or (gui/desktop-preferences) {})))

(defn read-now! ()
  "The desktop's preferences, asked now and kept as the last answer ([[last-known]]): a map of
`:color-scheme` `:reduce-motion?` `:text-rendering` `:cursor-blink`, `{}` when it says
nothing, or under a test."
  (let (preferences (ask))
    (registry/put :desktopprefs/last :preferences preferences)
    preferences))

(defn ensure-read! ()
  "The desktop's preferences: the last answer when it has been asked already, else asked now
([[read-now!]]) — what startup's first steps share, so one launch asks it once."
  (or (registry/lookup :desktopprefs/last :preferences) (read-now!)))

(defn last-known ()
  "The desktop's last answer ([[read-now!]], or the timer's), `{}` before the first."
  (or (registry/lookup :desktopprefs/last :preferences) {}))

(defn following? (m)
  "Whether `m`'s window follows the desktop at all: a local window (`:gui`) whose theme, text
or caret blink is the desktop's."
  (and (:gui m)
    (or (:theme-follows-system m) (:text-follows-desktop m) (nil? (:blink-cursor-blinks m)))))

(defn check-timer (m)
  "The timer client's question: every `*check-ms*`, while following."
  (when (following? m) {:every *check-ms*}))

(defn check (m)
  "The timer's step: ask the desktop, off the loop — unless the last question is still out."
  (if (:desktop-job m) m (assoc m :desktop-job (task/task (fn () (ask))))))

(defn scheme-arrived (m scheme)
  "The desktop's colour scheme `scheme` (`:light`, `:dark`, nil): the theme re-applied when it
changed since the last answer while the theme follows the desktop, the first answer only noted
(startup already themed by it)."
  (let (seen (:system-scheme m)
        noted (assoc m :system-scheme scheme))
    (cond
      (or (nil? scheme) (nil? seen) (= scheme seen) (not (:theme-follows-system m))) noted
      else
        (let (name (if (= scheme :light) (:theme-light m) (:theme-dark m)))
          (if name (themes/themes-apply noted name) noted)))))

(defn text-arrived (m rendering)
  "The desktop's text rendering `rendering` (`gui/text-rendering-from`'s map, or nil): the
window's settings applied again against it ([[config/apply-window!]], init.blsp's own
`:text-contrast` and the rest kept) when it changed and the window's text follows the desktop."
  (when (and (:text-follows-desktop m)
          (not (nil? rendering))
          (not (= rendering (:text-rendering (last-known)))))
    (config/apply-window! (or (:init-config m) {}) rendering))
  m)

(defn preferences-arrived (m preferences)
  "The desktop's answer `preferences` (`gui/desktop-preferences`; nil when the task failed, `{}`
when the desktop could not be read): the job's slot freed, then — for an answer that says
something — the theme ([[scheme-arrived]]), the window's text ([[text-arrived]]), the caret's
blink (`:desktop-blink`, what `model/ed-caret-blinks?` reads) and reduced motion
(`:os-reduce-motion`, read under init.blsp's `:reduce-motion :auto`) each follow it, and it
becomes the last answer. A failed read changes nothing: the last answer stands."
  (let (freed (dissoc m :desktop-job))
    (if (or (not (map? preferences)) (empty? preferences))
      freed
      (let (followed (assoc (text-arrived (scheme-arrived freed (:color-scheme preferences))
                              (:text-rendering preferences))
                       :desktop-blink (:cursor-blink preferences)
                       :os-reduce-motion (:reduce-motion? preferences)))
        (registry/put :desktopprefs/last :preferences preferences)
        followed))))

(register-timer-client :desktop-prefs 'desktopprefs/check-timer 'desktopprefs/check)
(register-task-reply :desktop-job 'desktopprefs/preferences-arrived nil nil)
