(defmodule model
  "The editor's `ui-run` model: a buffer pool, the pane layout, the kill ring,
the minibuffer, and the `*Messages*` log + echo area.

The model is a map threaded through the `ui-run` loop:

  :buffers   a vector of BUFFERS — the pool. Each is an immutable, mode-stamped
             buffer value (its point/mark/undo travel with it). One is always the
             `*Messages*` buffer. Panes reference a buffer by its pool index.
  :layout    the PANE tree (`std/pane.blsp`): Emacs-style tiled splits, each
             leaf a pane with payload `{:buffer <pool index> :top <scroll>}`.
             Exactly one pane is *selected* — the one being edited. Scroll is
             per-pane (`:top`); buffer TEXT is shared via the pool, so two panes
             on the same buffer see each other's edits.
  :kill-ring a list of killed/copied strings, newest first (C-w / M-w / C-y)
  :minibuffer  nil, or `{:prompt :input :on-complete :complete-fn}` while a
             minibuffer prompt is active (C-x b switch-buffer, C-x C-f find-file)
  :pending   the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :echo      the one-line echo area (the latest message, newlines flattened)
  :status    the mode-line message
  :done      set to quit; :tick-ms the refresh beat (large — nothing animates)

The whole loop runs in one process, so buffers live in the model directly. `message`
is the editor's echo primitive — like Emacs `message`, it writes to *both* the
`*Messages*` buffer and the echo area; eval output reaches it via `with-out-str`, so
it never hits the console.

\"The current buffer\" is the selected pane's buffer; editing writes back to the
pool (`ed-set-buf`), scrolling to the pane (`ed-set-top`)."
  (:use buffer)  ; make-buffer / insert / end-of-buffer / buffer-name / accessors
  (:use layers)  ; init-buffer-layers (stamp a buffer's mode) + active-layers (mode line)
  (:use pane))  ; the pane-tree layout: pane-single / selected payload / update / map

(require 'lineedit)  ; the minibuffer reuses the REPL line editor's pure core

;; ---- immutable vector helpers (assoc is map-only) ---------------------------

(defn ed-replace-nth (xs i v)
  "A fresh vector like `xs` with index `i` replaced by `v`."
  (apply vector (map (fn (j) (if (= j i) v (nth xs j))) (range (count xs)))))

(defn ed-remove-nth (xs i)
  "A fresh vector like `xs` with index `i` removed."
  (apply vector (concat (take i xs) (drop (inc i) xs))))

;; ---- construction -----------------------------------------------------------

(defn ed--log-buffer ()
  "A fresh `*Messages*` buffer with undo turned off. `disable-undo` is a recent
std/buffer addition; if the running `nest` predates it the call throws, so we
degrade gracefully — the editor still runs, *Messages* just keeps an undo history."
  (let (b (make-buffer "" "*Messages*"))
    (try (disable-undo b) (catch e b))))

(defn ed-stamp (buf)
  "Mode-stamp `buf` for the pool: `init-buffer-layers` resolves its type (filename /
`:type` → `text-mode` by default, `brood-mode` for `.blsp`) and seeds its `:layers`.
Use at every buffer-creation site so the mode is set from the first frame (the mode
line reads it, and dispatch composes its keymap)."
  (init-buffer-layers buf))

(defn ed-pane (idx)
  "A pane payload showing pool buffer `idx`, scrolled to the top, at font scale 1
(`:scale` is the per-pane zoom level Ctrl+wheel changes — see `ed-zoom`)."
  {:buffer idx :top 0 :scale 1})

(defn ed-init (buf)
  "The starting model: a buffer pool of `buf` (index 0) and an empty `*Messages*`
buffer (index 1), a single pane showing `buf`, an empty kill ring, no
minibuffer/prefix."
  {:buffers [(ed-stamp buf) (ed-stamp (ed--log-buffer))]
   :layout (pane-single (ed-pane 0))
   :kill-ring ()
   :minibuffer nil
   :pending nil
   :echo ""
   :status (str "editing " (buffer-name buf))
   :done false
   :tick-ms 60000})

;; ---- the selected pane + its buffer ---------------------------------------

(defn ed-current-pane (m)
  "The selected pane's payload `{:buffer <pool index> :top <scroll>}`."
  (pane-selected-payload (get m :layout)))

(defn ed-current-index (m)
  "The pool index of the buffer shown in the selected pane."
  (get (ed-current-pane m) :buffer))

(defn ed-current-buf (m)
  "The buffer being edited — the selected pane's buffer, from the pool."
  (nth (get m :buffers) (ed-current-index m)))

(defn ed-current-top (m)
  "The selected pane's scroll offset (first visible line)."
  (get (ed-current-pane m) :top))

(defn ed-buf-at (m i)
  "The pool buffer at index `i` (what a pane's `:buffer` payload references)."
  (nth (get m :buffers) i))

(defn ed-buf-mode-name (buf)
  "The mode to show for `buf`: the name of its highest-precedence active layer that
isn't a `:system` layer (so the always-on `global` layer is skipped — you see
`brood` on a `.blsp` buffer, `text` otherwise). `\"\"` if there's no non-system layer."
  (let (visible (filter (fn (l) (not (get l :system))) (active-layers buf)))
    (if (empty? visible) "" (name (get (first visible) :name)))))

(defn ed-mode-name (m)
  "The mode of the current (selected pane's) buffer, for the mode line."
  (ed-buf-mode-name (ed-current-buf m)))

(defn ed-mode-service (buf facet)
  "The value the buffer's active mode provides for `facet` — from the
highest-precedence active layer that defines it (`layer-collect`), resolved late
(`eval`) if stored as a fn *symbol*, else nil when no layer offers it. The generic
per-language services hook: the view and completion ask the buffer's mode for
`:fontify` / `:bracket-match` / `:eldoc` / `:complete-at` *without naming any
language*, so a new mode (json, python, …) is the same registration with its own
functions. `brood-mode` is the first to supply these (see `modes`)."
  (let (v (first (layer-collect buf facet)))
    (cond (nil? v) nil (symbol? v) (eval v) :else v)))

;; ---- pure text geometry (offset → line/column) ------------------------------
;; Shared by the indenter mode-service adapters (src/modes.blsp) and the indent
;; command (src/commands.blsp): a char offset's line start and column, computed
;; from the text alone so they're testable without a buffer/rope.

(defn ed-line-start-offset (text off)
  "The offset of the start of the line containing char offset `off` — just after
the previous newline (0 at the first line). Tail-recursive."
  (if (or (<= off 0) (= (char-at text (dec off)) "\n"))
    off
    (ed-line-start-offset text (dec off))))

(defn ed-column-at (text off)
  "The 0-based column of char offset `off` in `text` (chars since the line start)."
  (- off (ed-line-start-offset text off)))

(defn ed-diag-offset (buf line col)
  "The char offset in `buf` of a 1-based diagnostic position `line`:`col` (as the
checker reports them) — `rope-line->char` of the line plus the column."
  (+ (rope-line->char (buffer-rope buf) (dec line)) (dec col)))

;; ---- diagnostics cache (live, recomputed only when the text changes) --------
;; A full advisory type-check is far heavier than per-frame highlighting, so it's
;; kept off the render path: `ed-update` runs this after each key, but it recomputes
;; only when the current buffer's text differs from `:diag-text` (the text the cached
;; `:diagnostics` were computed from). Movement is therefore a no-op; an edit
;; refreshes. The check is the buffer mode's `:diagnostics` service (brood-mode →
;; the in-process type checker); buffers whose mode offers none never pay for it.

(defn ed-refresh-diagnostics (m)
  "The model with `:diagnostics` (a list of `{:line :col :message}`) + `:diag-text`
refreshed iff the current buffer has a `:diagnostics` service and its text changed
since the last check; otherwise `m` unchanged."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :diagnostics))
    (if (nil? svc)
      m
      (let (text (buffer-text buf))
        (if (= text (get m :diag-text))
          m
          (assoc m :diagnostics (svc text) :diag-text text))))))

;; ---- the minibuffer (a one-line prompt over lineedit's pure editor core) -----
;; The `:minibuffer` field is `{:edit <lineedit-state> :on-complete :complete-fn
;; :candidates-fn}`. `:edit` is a `std/lineedit` state, so the prompt reuses the
;; REPL line editor's editing (motion, kill-ring, yank, history, reverse-search) —
;; the same core std/observer's minibuffer drives. `input/minibuffer-handle` feeds
;; keys to `lineedit--handle`; these accessors read the editor's text/point/prompt.

(defn ed-mb-set-text (edit s)
  "The lineedit state `edit` with its text replaced by `s`, point at the end."
  (assoc edit :text s :point (string-length s) :hist-idx -1))

(defn ed-mb-edit (prompt initial)
  "A fresh minibuffer line-editor state showing `prompt`, prefilled with `initial`
text (point at end). Stored as the minibuffer's `:edit`."
  (ed-mb-set-text (lineedit/lineedit--init prompt "" '()) initial))

(defn mb-text (mb) "The minibuffer's current input text." (get (get mb :edit) :text))
(defn mb-point (mb) "The minibuffer cursor index (into its input)." (get (get mb :edit) :point))
(defn mb-prompt (mb) "The minibuffer prompt string." (get (get mb :edit) :prompt))

(defn ed-error-message (e)
  "A one-line human string for a thrown value `e`: a raised string as-is, a
structured error's `:message`, else its printed form. Used to surface a command or
render crash in the echo area instead of letting it kill the editor."
  (cond
    (string? e) e
    (and (map? e) (get e :message)) (get e :message)
    :else (pr-str e)))

(defn ed-set-buf (m buf)
  "The model with the selected pane's buffer replaced by `buf` in the POOL — so
every pane showing that buffer sees the edit. Scroll (per-pane) is untouched."
  (assoc m :buffers (ed-replace-nth (get m :buffers) (ed-current-index m) buf)))

(defn ed-set-top (m n)
  "The model with the *selected pane's* scroll offset set to `n` (per-pane, so
another pane on the same buffer keeps its own scroll)."
  (assoc m :layout (pane-update-selected (get m :layout) (fn (w) (assoc w :top n)))))

(defn ed-show-index (m i)
  "The model with the selected pane showing pool buffer `i`, scrolled to the top
(the pane-layer primitive behind buffer switching)."
  (assoc m :layout (pane-update-selected (get m :layout) (fn (w) (assoc w :buffer i :top 0)))))

(defn ed-map-panes (m f)
  "The model with `f` applied to every pane's payload — for re-pointing
pane→buffer references after the pool changes (e.g. after a kill). Pure."
  (assoc m :layout (pane-map (get m :layout) f)))

(defn ed--index-by-name (bufs nm i n)
  (cond
    (>= i n) nil
    (= (buffer-name (nth bufs i)) nm) i
    else (ed--index-by-name bufs nm (inc i) n)))

(defn ed-buffer-index-by-name (m nm)
  "The pool index of the buffer named `nm`, or nil if there is none."
  (ed--index-by-name (get m :buffers) nm 0 (count (get m :buffers))))

;; ---- the `*Messages*` log + echo area ---------------------------------------

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (apply str (map (fn (c) (if (= c "\n") " " c)) (string->list s))))

(defn message (m s)
  "Log `s`: append it as a line to the `*Messages*` buffer (found by name in the
pool, so it survives buffer switches/kills) and show it (flattened to one line) in
the echo area. Never disturbs the current buffer's point — *Messages* is a separate
pool entry. The editor's only output sink — commands print here, never the console."
  (let (idx (ed-buffer-index-by-name m "*Messages*"))
    (if (nil? idx)
      ;; defensive: *Messages* was somehow killed — recreate it in the pool
      (assoc m
        :echo
        (one-line s)
        :buffers
        (into (get m :buffers) [(ed-stamp (insert (ed--log-buffer) (str s "\n")))]))
      (assoc m
        :echo
        (one-line s)
        :buffers
        (ed-replace-nth (get m :buffers)
          idx
          (insert (end-of-buffer (nth (get m :buffers) idx)) (str s "\n")))))))

;; ---- scrolling --------------------------------------------------------------

(defn ed-scroll (m textrows)
  "Adjust the selected pane's `:top` so the point's line stays inside a
`textrows`-tall viewport: scroll up if it's above the top, down if it's below the
bottom. Pure."
  (let (line (buffer-current-line (ed-current-buf m))
        top (ed-current-top m))
    (cond
      (< line top) (ed-set-top m line)
      (>= line (+ top textrows)) (ed-set-top m (inc (- line textrows)))
      else m)))

;; ---- pane layout + mouse (shared geometry: view & hit-testing agree) ------
;; The body rect is everything above the bottom echo row; both the view and mouse
;; hit-testing lay the tree out over it, so screen coordinates line up.

(defn ed-body-layout (m cols rows)
  "The pane layout (`{:panes :dividers}`) over the body rect `[0 0 cols (rows-1)]`
— everything above the bottom echo/minibuffer row. Used by the view and by mouse
hit-testing, so a click maps to the pane the view drew there."
  (pane-layout (get m :layout) [0 0 cols (dec rows)]))

(defn ed-selected-text-rows (m cols rows)
  "The text height of the *selected* pane in BUFFER lines — its rect height less the
mode-line row, divided by the pane's font scale (a zoomed pane shows fewer lines).
What scrolling and paging use, so they're correct inside a split and when zoomed.
At least 1."
  (let (panes (get (ed-body-layout m cols rows) :panes)
         sel
         (first (filter (fn (p) (get p :selected)) panes))
         cells
         (dec (nth (get sel :rect) 3))  ; rect = [x y w h]; h-1 for the mode line
         s
         (max 1 (or (get (get sel :payload) :scale) 1)))
    (max 1 (quot cells s))))

(defn ed-mouse-press (m cols rows row col)
  "Left-press at cell `[row col]`: if it lands on a divider, begin a resize drag
(stash the divider on `:dragging` — it carries the split path + the rect to measure
the new ratio against); otherwise select the pane under the pointer."
  (let (layout (ed-body-layout m cols rows)
        d (divider-at layout [row col]))
    (if (nil? d)
      (assoc m :layout (pane-select-at (get m :layout) layout [row col]))
      (assoc m :dragging d))))

(defn ed-mouse-drag (m row col)
  "While dragging a divider, set its split's ratio so the boundary follows the
pointer (clamped by `pane-set-ratio` so no pane vanishes). A no-op if not dragging."
  (let (d (get m :dragging))
    (if (nil? d)
      m
      (assoc m
        :layout
        (pane-set-ratio (get m :layout) (get d :path) (pane-ratio-for d [row col]))))))

(def *max-zoom* 6)  ; integer font-scale cap (1 = base; the GUI :scale matches the kernel's gui-font! cap)
(def *wheel-lines* 3)  ; lines a plain wheel notch scrolls

(defn ed-current-scale (m)
  "The selected pane's integer font scale (≥1), the per-pane zoom level."
  (max 1 (or (get (ed-current-pane m) :scale) 1)))

;; ---- mouse wheel acts on the pane UNDER THE POINTER (not the active one) -----
;; A wheel notch zooms / scrolls the pane the cursor is over, like every editor —
;; so it never disturbs which pane is selected. `pane-at` resolves the hovered
;; pane (carrying its `:path`); `pane-update-path` edits exactly that pane's
;; payload. (Divider drag-resize is already hover-targeted in `ed-mouse-press`.)

(defn ed-pane-at (m cols rows row col)
  "The pane under screen cell `[row col]` (`{:path :payload :selected :rect}`), or nil."
  (pane-at (ed-body-layout m cols rows) [row col]))

(defn ed-zoom-pane (m pane delta)
  "Ctrl+mouse-wheel: change the font scale of `pane` (the one under the pointer) by
`delta` levels, clamped to 1..*max-zoom*. Per-pane `:scale` (the view renders it via
the kernel's per-op `:scale` face attr, ADR-079) — only the hovered pane resizes;
selection and every other pane are untouched. The *decision* to zoom on Ctrl+wheel
is editor policy; the kernel supplies only the mechanism (ADR-006)."
  (let (cur (max 1 (or (get (get pane :payload) :scale) 1))
        s (max 1 (min *max-zoom* (+ cur delta))))
    (assoc m
      :layout
      (pane-update-path (get m :layout) (get pane :path) (fn (w) (assoc w :scale s))))))

(defn ed-scroll-pane (m pane delta)
  "Plain mouse-wheel: scroll the *hovered* `pane`'s viewport by `delta` buffer lines,
moving its `:top` (clamped to the buffer) — point and the active pane are left alone.
Negative scrolls toward the top."
  (let (buf (ed-buf-at m (get (get pane :payload) :buffer))
        top (or (get (get pane :payload) :top) 0)
        last (max 0 (dec (buffer-line-count buf)))
        new-top (max 0 (min last (+ top delta))))
    (assoc m
      :layout
      (pane-update-path (get m :layout) (get pane :path) (fn (w) (assoc w :top new-top))))))

(defn ed-toggle-line-numbers (m)
  "Toggle the left line-number gutter on the *selected pane* (per-pane, like Emacs
`display-line-numbers-mode` but pane-local — the view reads the pane payload's
`:line-numbers`). Pure."
  (assoc m
    :layout
    (pane-update-selected (get m :layout)
      (fn (p) (assoc p :line-numbers (not (get p :line-numbers)))))))

(defn ed-mouse (m input cols rows)
  "Fold a `[:mouse action button row col mods]` event into the model: left-press
selects a pane or begins a divider drag; `:drag` resizes the dragged divider;
`:release` ends the drag; **Ctrl+wheel zooms** and a **plain wheel scrolls** the pane
**under the pointer** (`ed-zoom-pane` / `ed-scroll-pane`, one notch each), never the
active pane. Fields are read positionally (`nth`), not by a fixed-length vector
pattern, so the trailing `mods` element (and any future addition) can't silently
break the match. A wheel notch off every pane is ignored."
  (let (action (nth input 1)
        button (nth input 2)
        row (nth input 3)
        col (nth input 4)
        mods (nth input 5 [])
        hovered (ed-pane-at m cols rows row col))
    (cond
      (and (= action :press) (= button :left)) (ed-mouse-press m cols rows row col)
      (and (= action :drag) (= button :left)) (ed-mouse-drag m row col)
      (= action :release) (dissoc m :dragging)
      (nil? hovered) m
      (and (= action :scroll-up) (includes? mods :ctrl)) (ed-zoom-pane m hovered 1)
      (and (= action :scroll-down) (includes? mods :ctrl)) (ed-zoom-pane m hovered -1)
      (= action :scroll-up) (ed-scroll-pane m hovered (- *wheel-lines*))
      (= action :scroll-down) (ed-scroll-pane m hovered *wheel-lines*)
      else m)))
