(defmodule model
  "The editor's `ui-run` model: a buffer pool, the window layout, the kill ring,
the minibuffer, and the `*Messages*` log + echo area.

The model is a map threaded through the `ui-run` loop:

  :buffers   a vector of BUFFERS — the pool. Each is an immutable, mode-stamped
             buffer value (its point/mark/undo travel with it). One is always the
             `*Messages*` buffer. Windows reference a buffer by its pool index.
  :layout    the WINDOW tree (`std/window.blsp`): Emacs-style tiled splits, each
             leaf a window with payload `{:buffer <pool index> :top <scroll>}`.
             Exactly one window is *selected* — the one being edited. Scroll is
             per-window (`:top`); buffer TEXT is shared via the pool, so two windows
             on the same buffer see each other's edits.
  :kill-ring a list of killed/copied strings, newest first (C-w / M-w / C-y)
  :minibuffer  nil, or `{:prompt :input :on-complete :complete-fn}` while a
             minibuffer prompt is active (C-x b switch-buffer, C-x C-f find-file)
  :pending   the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :echo      the one-line echo area (the latest message, newlines flattened)
  :status    the mode-line message
  :done      set to quit; :tick-ms the refresh beat (large — nothing animates)

The whole loop runs in one process, so buffers live in the model directly. `message`
is the editor's echo primitive — like Emacs `message`, it writes to *both* the
`*Messages*` buffer and the echo area; eval output reaches it via `with-out-str`, so
it never hits the console.

\"The current buffer\" is the selected window's buffer; editing writes back to the
pool (`ed-set-buf`), scrolling to the window (`ed-set-top`)."
  (:use buffer)  ; make-buffer / insert / end-of-buffer / buffer-name / accessors
  (:use layers)  ; init-buffer-layers (stamp a buffer's mode) + active-layers (mode line)
  (:use window))  ; the window-tree layout: window-single / selected payload / update / map

;; ---- immutable vector helpers (assoc is map-only) ---------------------------

(defn ed-replace-nth (xs i v)
  "A fresh vector like `xs` with index `i` replaced by `v`."
  (apply vector (map (fn (j) (if (= j i) v (nth xs j))) (range (count xs)))))

(defn ed-remove-nth (xs i)
  "A fresh vector like `xs` with index `i` removed."
  (apply vector (concat (take i xs) (drop (inc i) xs))))

;; ---- construction -----------------------------------------------------------

(defn ed--log-buffer ()
  "A fresh `*Messages*` buffer with undo turned off. `disable-undo` is a recent
std/buffer addition; if the running `nest` predates it the call throws, so we
degrade gracefully — the editor still runs, *Messages* just keeps an undo history."
  (let (b (make-buffer "" "*Messages*"))
    (try (disable-undo b) (catch e b))))

(defn ed-stamp (buf)
  "Mode-stamp `buf` for the pool: `init-buffer-layers` resolves its type (filename /
`:type` → `text-mode` by default, `brood-mode` for `.blsp`) and seeds its `:layers`.
Use at every buffer-creation site so the mode is set from the first frame (the mode
line reads it, and dispatch composes its keymap)."
  (init-buffer-layers buf))

(defn ed-window (idx)
  "A window payload showing pool buffer `idx`, scrolled to the top, at font scale 1
(`:scale` is the per-pane zoom level Ctrl+wheel changes — see `ed-zoom`)."
  {:buffer idx :top 0 :scale 1})

(defn ed-init (buf)
  "The starting model: a buffer pool of `buf` (index 0) and an empty `*Messages*`
buffer (index 1), a single window showing `buf`, an empty kill ring, no
minibuffer/prefix."
  {:buffers [(ed-stamp buf) (ed-stamp (ed--log-buffer))]
   :layout (window-single (ed-window 0))
   :kill-ring ()
   :minibuffer nil
   :pending nil
   :echo ""
   :status (str "editing " (buffer-name buf))
   :done false
   :tick-ms 60000})

;; ---- the selected window + its buffer ---------------------------------------

(defn ed-current-window (m)
  "The selected window's payload `{:buffer <pool index> :top <scroll>}`."
  (window-selected-payload (get m :layout)))

(defn ed-current-index (m)
  "The pool index of the buffer shown in the selected window."
  (get (ed-current-window m) :buffer))

(defn ed-current-buf (m)
  "The buffer being edited — the selected window's buffer, from the pool."
  (nth (get m :buffers) (ed-current-index m)))

(defn ed-current-top (m)
  "The selected window's scroll offset (first visible line)."
  (get (ed-current-window m) :top))

(defn ed-buf-at (m i)
  "The pool buffer at index `i` (what a window's `:buffer` payload references)."
  (nth (get m :buffers) i))

(defn ed-buf-mode-name (buf)
  "The mode to show for `buf`: the name of its highest-precedence active layer that
isn't a `:system` layer (so the always-on `global` layer is skipped — you see
`brood` on a `.blsp` buffer, `text` otherwise). `\"\"` if there's no non-system layer."
  (let (visible (filter (fn (l) (not (get l :system))) (active-layers buf)))
    (if (empty? visible) "" (name (get (first visible) :name)))))

(defn ed-mode-name (m)
  "The mode of the current (selected window's) buffer, for the mode line."
  (ed-buf-mode-name (ed-current-buf m)))

(defn ed-mode-service (buf facet)
  "The value the buffer's active mode provides for `facet` — from the
highest-precedence active layer that defines it (`layer-collect`), resolved late
(`eval`) if stored as a fn *symbol*, else nil when no layer offers it. The generic
per-language services hook: the view and completion ask the buffer's mode for
`:fontify` / `:bracket-match` / `:eldoc` / `:complete-at` *without naming any
language*, so a new mode (json, python, …) is the same registration with its own
functions. `brood-mode` is the first to supply these (see `modes`)."
  (let (v (first (layer-collect buf facet)))
    (cond (nil? v) nil (symbol? v) (eval v) :else v)))

;; ---- pure text geometry (offset → line/column) ------------------------------
;; Shared by the indenter mode-service adapters (src/modes.blsp) and the indent
;; command (src/commands.blsp): a char offset's line start and column, computed
;; from the text alone so they're testable without a buffer/rope.

(defn ed-line-start-offset (text off)
  "The offset of the start of the line containing char offset `off` — just after
the previous newline (0 at the first line). Tail-recursive."
  (if (or (<= off 0) (= (char-at text (dec off)) "\n"))
    off
    (ed-line-start-offset text (dec off))))

(defn ed-column-at (text off)
  "The 0-based column of char offset `off` in `text` (chars since the line start)."
  (- off (ed-line-start-offset text off)))

(defn ed-set-buf (m buf)
  "The model with the selected window's buffer replaced by `buf` in the POOL — so
every window showing that buffer sees the edit. Scroll (per-window) is untouched."
  (assoc m :buffers (ed-replace-nth (get m :buffers) (ed-current-index m) buf)))

(defn ed-set-top (m n)
  "The model with the *selected window's* scroll offset set to `n` (per-window, so
another window on the same buffer keeps its own scroll)."
  (assoc m :layout (window-update-selected (get m :layout) (fn (w) (assoc w :top n)))))

(defn ed-show-index (m i)
  "The model with the selected window showing pool buffer `i`, scrolled to the top
(the window-layer primitive behind buffer switching)."
  (assoc m :layout (window-update-selected (get m :layout) (fn (w) (assoc w :buffer i :top 0)))))

(defn ed-map-windows (m f)
  "The model with `f` applied to every window's payload — for re-pointing
window→buffer references after the pool changes (e.g. after a kill). Pure."
  (assoc m :layout (window-map (get m :layout) f)))

(defn ed--index-by-name (bufs nm i n)
  (cond
    (>= i n) nil
    (= (buffer-name (nth bufs i)) nm) i
    else (ed--index-by-name bufs nm (inc i) n)))

(defn ed-buffer-index-by-name (m nm)
  "The pool index of the buffer named `nm`, or nil if there is none."
  (ed--index-by-name (get m :buffers) nm 0 (count (get m :buffers))))

;; ---- the `*Messages*` log + echo area ---------------------------------------

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (apply str (map (fn (c) (if (= c "\n") " " c)) (string->list s))))

(defn message (m s)
  "Log `s`: append it as a line to the `*Messages*` buffer (found by name in the
pool, so it survives buffer switches/kills) and show it (flattened to one line) in
the echo area. Never disturbs the current buffer's point — *Messages* is a separate
pool entry. The editor's only output sink — commands print here, never the console."
  (let (idx (ed-buffer-index-by-name m "*Messages*"))
    (if (nil? idx)
      ;; defensive: *Messages* was somehow killed — recreate it in the pool
      (assoc m
        :echo
        (one-line s)
        :buffers
        (into (get m :buffers) [(ed-stamp (insert (ed--log-buffer) (str s "\n")))]))
      (assoc m
        :echo
        (one-line s)
        :buffers
        (ed-replace-nth (get m :buffers)
          idx
          (insert (end-of-buffer (nth (get m :buffers) idx)) (str s "\n")))))))

;; ---- scrolling --------------------------------------------------------------

(defn ed-scroll (m textrows)
  "Adjust the selected window's `:top` so the point's line stays inside a
`textrows`-tall viewport: scroll up if it's above the top, down if it's below the
bottom. Pure."
  (let (line (buffer-current-line (ed-current-buf m))
        top (ed-current-top m))
    (cond
      (< line top) (ed-set-top m line)
      (>= line (+ top textrows)) (ed-set-top m (inc (- line textrows)))
      else m)))

;; ---- window layout + mouse (shared geometry: view & hit-testing agree) ------
;; The body rect is everything above the bottom echo row; both the view and mouse
;; hit-testing lay the tree out over it, so screen coordinates line up.

(defn ed-body-layout (m cols rows)
  "The window layout (`{:panes :dividers}`) over the body rect `[0 0 cols (rows-1)]`
— everything above the bottom echo/minibuffer row. Used by the view and by mouse
hit-testing, so a click maps to the pane the view drew there."
  (window-layout (get m :layout) [0 0 cols (dec rows)]))

(defn ed-selected-text-rows (m cols rows)
  "The text height of the *selected* pane in BUFFER lines — its rect height less the
mode-line row, divided by the pane's font scale (a zoomed pane shows fewer lines).
What scrolling and paging use, so they're correct inside a split and when zoomed.
At least 1."
  (let (panes (get (ed-body-layout m cols rows) :panes)
         sel
         (first (filter (fn (p) (get p :selected)) panes))
         cells
         (dec (nth (get sel :rect) 3))  ; rect = [x y w h]; h-1 for the mode line
         s
         (max 1 (or (get (get sel :payload) :scale) 1)))
    (max 1 (quot cells s))))

(defn ed-mouse-press (m cols rows row col)
  "Left-press at cell `[row col]`: if it lands on a divider, begin a resize drag
(stash the divider on `:dragging` — it carries the split path + the rect to measure
the new ratio against); otherwise select the window under the pointer."
  (let (layout (ed-body-layout m cols rows)
        d (divider-at layout [row col]))
    (if (nil? d)
      (assoc m :layout (window-select-at (get m :layout) layout [row col]))
      (assoc m :dragging d))))

(defn ed-mouse-drag (m row col)
  "While dragging a divider, set its split's ratio so the boundary follows the
pointer (clamped by `window-set-ratio` so no pane vanishes). A no-op if not dragging."
  (let (d (get m :dragging))
    (if (nil? d)
      m
      (assoc m
        :layout
        (window-set-ratio (get m :layout) (get d :path) (window-ratio-for d [row col]))))))

(def *max-zoom* 6)  ; integer font-scale cap (1 = base; the GUI :scale matches the kernel's gui-font! cap)
(def *wheel-lines* 3)  ; lines a plain wheel notch scrolls

(defn ed-current-scale (m)
  "The selected window's integer font scale (≥1), the per-pane zoom level."
  (max 1 (or (get (ed-current-window m) :scale) 1)))

(defn ed-zoom (m delta)
  "Ctrl+mouse-wheel: change the *selected window's* font scale by `delta` levels,
clamped to 1..*max-zoom*. Per-pane (it sets `:scale` on the selected window's
payload, which the view renders via the kernel's per-op `:scale` face attribute —
ADR-079), so only that pane resizes; a split's other panes and any other window keep
their own scale. Pure (the GUI applies `:scale`; the terminal renders 1×). The
*decision* to zoom on Ctrl+wheel is editor policy here; the kernel only supplies the
mechanism (ADR-006)."
  (let (s (max 1 (min *max-zoom* (+ (ed-current-scale m) delta))))
    (assoc m :layout (window-update-selected (get m :layout) (fn (w) (assoc w :scale s))))))

(defn ed-wheel-scroll (m delta)
  "Plain mouse-wheel: scroll the selected window by moving point `delta` lines
(`forward-line` clamps at the buffer ends); the view then follows via the
scroll-to-point clamp in `ed-update`. Negative scrolls toward the top."
  (ed-set-buf m (forward-line (ed-current-buf m) delta)))

(defn ed-mouse (m input cols rows)
  "Fold a `[:mouse action button row col mods]` event into the model: left-press
selects a window or begins a divider drag; `:drag` resizes the dragged divider;
`:release` ends the drag; **Ctrl+wheel zooms the selected pane** (`ed-zoom`, one
level per notch); a **plain wheel scrolls** the selected window (`ed-wheel-scroll`).
Fields are read positionally (`nth`), not by a fixed-length vector pattern, so the
trailing `mods` element (and any future addition) can't silently break the match."
  (let (action (nth input 1)
        button (nth input 2)
        row (nth input 3)
        col (nth input 4)
        mods (nth input 5 []))
    (cond
      (and (= action :press) (= button :left)) (ed-mouse-press m cols rows row col)
      (and (= action :drag) (= button :left)) (ed-mouse-drag m row col)
      (= action :release) (dissoc m :dragging)
      (and (= action :scroll-up) (includes? mods :ctrl)) (ed-zoom m 1)
      (and (= action :scroll-down) (includes? mods :ctrl)) (ed-zoom m -1)
      (= action :scroll-up) (ed-wheel-scroll m (- *wheel-lines*))
      (= action :scroll-down) (ed-wheel-scroll m *wheel-lines*)
      else m)))
