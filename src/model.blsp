(defmodule model
  "The editor's `ui-run` model: a list of buffers, the active one, the kill ring,
the minibuffer, and the `*Messages*` log + echo area.

The model is a map threaded through the `ui-run` loop:

  :buffers   a vector of ENTRIES `{:buf <buffer> :top <int>}` — each buffer with
             its own scroll position (`:top`, the first visible line). One entry
             is always the `*Messages*` buffer.
  :current   the index into `:buffers` of the buffer being edited
  :kill-ring a list of killed/copied strings, newest first (C-w / M-w / C-y)
  :minibuffer  nil, or `{:prompt :input :on-complete :complete-fn}` while a
             minibuffer prompt is active (C-x b switch-buffer, C-x C-f find-file)
  :pending   the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :echo      the one-line echo area (the latest message, newlines flattened)
  :status    the mode-line message
  :done      set to quit; :tick-ms the refresh beat (large — nothing animates)

Buffers hold process-local ropes and the whole loop runs in one process, so they
live in the model directly (a buffer is an immutable value — switching is just
moving `:current`, and a buffer's point/mark/undo travel with it). `message` is
the editor's echo primitive — like Emacs `message`, it writes to *both* the
`*Messages*` buffer and the echo area; eval output reaches it via `with-out-str`,
so it never hits the console."
  (:use buffer)   ; make-buffer / insert / end-of-buffer / buffer-name / accessors
  (:use layers))  ; init-buffer-layers (stamp a buffer's mode) + layer-collect (its name)

;; ---- immutable vector helpers (assoc is map-only) ---------------------------

(defn ed-replace-nth (xs i v)
  "A fresh vector like `xs` with index `i` replaced by `v`."
  (apply vector (map (fn (j) (if (= j i) v (nth xs j))) (range (count xs)))))

(defn ed-remove-nth (xs i)
  "A fresh vector like `xs` with index `i` removed."
  (apply vector (concat (take i xs) (drop (inc i) xs))))

;; ---- construction -----------------------------------------------------------

(defn ed--log-buffer ()
  "A fresh `*Messages*` buffer with undo turned off. `disable-undo` is a recent
std/buffer addition; if the running `nest` predates it the call throws, so we
degrade gracefully — the editor still runs, *Messages* just keeps an undo history."
  (let (b (make-buffer "" "*Messages*"))
    (try (disable-undo b) (catch e b))))

(defn ed-entry (buf)
  "A buffer-list entry `{:buf :top}` for `buf`, with its **mode** attached:
`init-buffer-layers` resolves the buffer's type (filename / `:type` → `text-mode`
by default, `brood-mode` for `.blsp`) and seeds its `:layers`. Use this at every
buffer-creation site so the mode is set from the first frame (the mode line reads
it, and dispatch composes its keymap)."
  {:buf (init-buffer-layers buf) :top 0})

(defn ed-init (buf)
  "The starting model: editing `buf` (entry 0) alongside an empty `*Messages*`
buffer, scrolled to the top, with an empty kill ring and no minibuffer/prefix."
  {:buffers [(ed-entry buf)
             (ed-entry (ed--log-buffer))]
   :current 0
   :kill-ring ()
   :minibuffer nil
   :pending nil
   :echo ""
   :status (str "editing " (buffer-name buf))
   :done false
   :tick-ms 60000})

;; ---- the current buffer / entry ---------------------------------------------

(defn ed-current-entry (m) "The active buffer's entry `{:buf :top}`." (nth (get m :buffers) (get m :current)))
(defn ed-current-buf (m) "The buffer being edited." (get (ed-current-entry m) :buf))
(defn ed-current-top (m) "The active buffer's scroll offset (first visible line)." (get (ed-current-entry m) :top))

(defn ed-mode-name (m)
  "The mode to show in the mode line: the name of the highest-precedence active
layer that isn't a `:system` layer (so the always-on `global` layer is skipped —
you see `brood` on a `.blsp` buffer, `text` otherwise). `\"\"` if there's no
non-system layer."
  (let (visible (filter (fn (l) (not (get l :system))) (active-layers (ed-current-buf m))))
    (if (empty? visible) "" (name (get (first visible) :name)))))

(defn ed-set-buf (m buf)
  "The model with the active entry's buffer replaced by `buf`."
  (let (i (get m :current))
    (assoc m :buffers (ed-replace-nth (get m :buffers) i (assoc (ed-current-entry m) :buf buf)))))

(defn ed-set-top (m n)
  "The model with the active entry's scroll offset set to `n`."
  (let (i (get m :current))
    (assoc m :buffers (ed-replace-nth (get m :buffers) i (assoc (ed-current-entry m) :top n)))))

(defn ed--index-by-name (bufs nm i n)
  (cond (>= i n) nil
        (= (buffer-name (get (nth bufs i) :buf)) nm) i
        else (ed--index-by-name bufs nm (inc i) n)))

(defn ed-buffer-index-by-name (m nm)
  "The index into `:buffers` of the buffer named `nm`, or nil if there is none."
  (ed--index-by-name (get m :buffers) nm 0 (count (get m :buffers))))

;; ---- the `*Messages*` log + echo area ---------------------------------------

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (apply str (map (fn (c) (if (= c "\n") " " c)) (string->list s))))

(defn message (m s)
  "Log `s`: append it as a line to the `*Messages*` buffer (found by name, so it
survives buffer switches/kills) and show it (flattened to one line) in the echo
area. Never disturbs the current buffer's point. The editor's only output sink —
commands print here, never to the console."
  (let (idx (ed-buffer-index-by-name m "*Messages*"))
    (if (nil? idx)
      ;; defensive: *Messages* was somehow killed — recreate it
      (assoc m :echo (one-line s)
               :buffers (into (get m :buffers)
                          [{:buf (insert (ed--log-buffer) (str s "\n")) :top 0}]))
      (let (entry (nth (get m :buffers) idx))
        (assoc m :echo (one-line s)
                 :buffers (ed-replace-nth (get m :buffers) idx
                            (assoc entry :buf (insert (end-of-buffer (get entry :buf)) (str s "\n")))))))))

;; ---- scrolling --------------------------------------------------------------

(defn ed-scroll (m textrows)
  "Adjust the active buffer's `:top` so the point's line stays inside a
`textrows`-tall viewport: scroll up if it's above the top, down if it's below the
bottom. Pure."
  (let (line (buffer-current-line (ed-current-buf m))
        top (ed-current-top m))
    (cond
      (< line top) (ed-set-top m line)
      (>= line (+ top textrows)) (ed-set-top m (inc (- line textrows)))
      else m)))
