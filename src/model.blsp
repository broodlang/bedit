(defmodule model
  "The editor's `ui-run` model: a buffer pool, the pane layout, the kill ring,
the minibuffer, and the `*Messages*` log + echo area.

The model is a map threaded through the `ui-run` loop:

  :buffers   a vector of BUFFERS — the pool. Each is an immutable, mode-stamped
             buffer value (its point/mark/undo travel with it). One is always the
             `*Messages*` buffer. Panes reference a buffer by its pool index.
  :layout    the PANE tree (`std/pane.blsp`): Emacs-style tiled splits, each
             leaf a pane with payload `{:buffer <pool index> :top <scroll>}`.
             Exactly one pane is *selected* — the one being edited. Scroll is
             per-pane (`:top`); buffer TEXT is shared via the pool, so two panes
             on the same buffer see each other's edits.
  :kill-ring a list of killed/copied strings, newest first (C-w / M-w / C-y)
  :minibuffer  nil, or `{:prompt :input :on-complete :complete-fn}` while a
             minibuffer prompt is active (C-x b switch-buffer, C-x C-f find-file)
  :pending   the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :echo      the one-line echo area (the latest message, newlines flattened)
  :status    the mode-line message
  :done      set to quit; :timers the named timers (ADR-102: blink, debounce,
             which-key, undo-pause, key-repeat); :blink-on? the caret on/off phase

The whole loop runs in one process, so buffers live in the model directly. `message`
is the editor's echo primitive — like Emacs `message`, it writes to *both* the
`*Messages*` buffer and the echo area; eval output reaches it via `with-out-str`, so
it never hits the console.

\"The current buffer\" is the selected pane's buffer; editing writes back to the
pool (`ed-set-buf`), scrolling to the pane (`ed-set-top`)."
  (:use editor/buffer) ; make-buffer / insert / end-of-buffer / buffer-name / accessors
  (:use editor/layers) ; init-buffer-layers (stamp a buffer's mode) + active-layers (mode line)
  (:use editor/keymap) ; keymap-where-is — command → the key actually bound to it (help text)
  (:use editor/pane) ; the pane-tree layout: pane-single / selected payload / update / map
  (:use completion) ; completion-rank-incremental — the minibuffer's narrowable fuzzy rank
  ;; `:exclude [error]` — log's `error` would shadow the prelude's `error`.
  (:use log :exclude [error]) ; backend — the log-routing backends (one per buffer)
  ;; `:exclude [inspect]` — `io/inspect` WRITES; the root `inspect` is the ability op
  ;; that RETURNS the string. Referring the writer bare here would shadow the op.
  (:use io :exclude [inspect]) ; fn-port — the editor-targeting log sink (buffer-log-event)
  (:use keymaps) ; profile-layers — seed the model-scope keybinding profile (emacs default)
  (:use task)) ; task — run the advisory diagnostics check off the loop (async recheck)
;; editor/lineedit (minibuffer core), gitdiff (diff-hl annotate) and json (runner event
;; decode) are referenced qualified below — each `mod/name` auto-loads its module.

(defdyn *blink-ms* 530)
;; The cursor-blink half-period (Emacs `blink-cursor-interval` ≈ 0.5s): an idle
;; `:cursor-blink` timer (ADR-102) toggles `:blink-on?` this often once typing
;; settles, and a real keystroke forces the caret solid (`ed-real-input?`). Idle, so
;; the caret stays solid while you type and only blinks at rest.

(defdyn *complete-debounce-min* 800)
;; A minibuffer completion source larger than this is **debounced**: its candidate list is
;; re-ranked only after you pause (the idle `:idle-recompute` timer), not on every keystroke
;; — so a large project stays responsive while typing. Small sources (M-x, buffer/project
;; lists, small find-file) re-rank synchronously per keystroke — instant, no lag.

(def *diag-debounce-ms* 120)
;; The tutorial's eval-on-type debounce (`:tutor-eval`): a shade slower than the diag
;; beat — each firing round-trips the whole lesson to the sandbox subprocess, so it
;; waits for a real pause, not a fast typist's inter-key gap.
(def *tutor-eval-debounce-ms* 250)
;; The idle beat (`:idle-recompute`) armed after activity settles — Emacs's idle-timer
;; model. It drives everything deferred off the per-key path: the eldoc hint, the advisory
;; type-check, the **minibuffer completion re-rank** for a large source (find-file / M-x —
;; this is the delay you feel narrowing a big list), the diff-hl launch, and the web-mirror
;; push. Kept short so narrowing/eldoc feel responsive; the type-check and diff it also
;; fires are async (spawned tasks) and rope-gated, so a short beat doesn't thrash them.
;; While a key auto-repeats, the typematic delay (*repeat-delay-ms*) already serves as the
;; debounce, so no separate beat is set.

(def *which-key-delay-ms* 500)
;; How long a prefix chord (e.g. C-x) must sit pending before the which-key panel
;; appears (Emacs `which-key-idle-delay`), so a fast chord like C-x C-f doesn't flash
;; it. Armed when a prefix is pending; the idle `:tick` that follows reveals the panel.

(defdyn *undo-pause-ms* 600)
;; After a typing/deletion command, a `:tick` this long later closes the undo run (sets
;; :undo-break, so the next edit starts a fresh undo group — the Emacs `undo-boundary`
;; on a typing pause). Without it, a plain buffer with no eldoc/diagnostics debounce
;; would never tick mid-session and the whole burst would amalgamate into one undo step.

(defdyn *typing-commands*
  ;; The commands whose consecutive repeats amalgamate into one undo step (a typing /
  ;; deletion run) AND whose settling arms the undo-pause boundary. Shared by `input`
  ;; (amalgamation) and `ed-sync-timers` (the `:undo-pause` timer). `:self-insert` is
  ;; the unbound-printable-key fallback.
  (list :self-insert 'commands/cmd-delete-backward 'commands/cmd-delete-char))

;; ---- construction -----------------------------------------------------------

(defn ed-log-buffer (&optional (name "*Messages*"))
  "A fresh log/output buffer named `name` (default `*Messages*`) with undo turned off
— append-only sinks don't want an undo history. `disable-undo` is a recent std/buffer
addition; if the running `nest` predates it the call throws, so we degrade gracefully
(the buffer just keeps an undo history)."
  (let (b (make-buffer "" name))
    (try (disable-undo b) (catch e b))))

(defn ed-stamp (buf)
  "Mode-stamp `buf` for the pool: `init-buffer-layers` resolves its type (filename /
`:type` → `text-mode` by default, `brood-mode` for `.blsp`) and seeds its `:layers`.
Use at every buffer-creation site so the mode is set from the first frame (the mode
line reads it, and dispatch composes its keymap). Also gives a *file* buffer its
`:dir` (default-directory = the file's folder) if it has none yet — every buffer
carries a `:dir`; a fileless one inherits it where it's opened (see `ed-open-buffer`)."
  (let (b (init-buffer-layers buf))
    (if (and (nil? (:dir b)) (buffer-file b))
      (assoc b :dir (path/dirname (buffer-file b)))
      b)))

(defn ed-pane (idx)
  "A pane payload showing pool buffer `idx`, scrolled to the top, at font scale 1
(`:scale` is the per-pane zoom level Ctrl+wheel changes — see `ed-zoom`)."
  {:buffer idx :top 0 :scale 1})

(defn ed-init (buf)
  "The starting model: a buffer pool of `buf` (index 0) and an empty `*Messages*`
buffer (index 1), a single pane showing `buf`, an empty kill ring, no
minibuffer/prefix."
  {:buffers [(ed-stamp buf) (ed-stamp (ed-log-buffer))]
   :layout (pane-single (ed-pane 0))
   :kill-ring ()
   :minibuffer nil
   :pending nil
   :echo ""
   ;; the model-scope keybinding profile (emacs by default); :layers are the profile's
   ;; layers, composed under the buffer's mode layers at dispatch (see keymaps / input).
   :profile :emacs
   :layers (profile-layers :emacs)
   :edit-state nil
   :status (str "editing " (buffer-name buf))
   :done false
   ;; ui-run coalesces a queued input burst into ONE render (std/editor/ui.blsp): the
   ;; editor streams async events into its own mailbox — a test/run feed, collab deltas,
   ;; an LSP/debugger push — so without this a 900-test run would cost ~900 full frames
   ;; and dribble in over seconds after the run finished. Inert in pure `ed-update` tests
   ;; (it only affects the live loop).
   :coalesce-input? true
   :blink-on? true
   :timers {:cursor-blink {:every *blink-ms* :idle? true}}})

;; ---- the selected pane + its buffer ---------------------------------------
;; A pane's payload is `{:buffer <pool index> :top <scroll> :point <window-local cursor>
;; :mark <window-local mark>}`. Content (the rope, undo, name, file) lives on the pooled
;; buffer and is shared by every pane showing it; **point/mark are per-pane** (Emacs
;; window-point), so two views of the same buffer/file keep independent cursors. `:point`
;; nil means "use the buffer's own point" (a fresh/just-switched pane).
;;
;; THE INVARIANT (point-off-buffer, docs/actor-architecture.md): while a pane shows a
;; buffer, the pane's point is authoritative. The pooled buffer's own `:point` is only
;; its SAVED DEFAULT — consulted exactly when a pane's `:point` is nil (`ed-show-index`
;; clears it on a switch), maintained by `ed-set-buf`'s copy-back. Nothing else may read
;; a pooled buffer's `:point`; content folds from a hosted buffer's process
;; (`hosted/hosted-apply-content`) replace pool content and touch no pane's point.
;; Guarded by tests/window_point_test.blsp ("the saved-default invariant").

(defn ed-with-window-point (buf point mark)
  "`buf` with its cursor made **window-local**: pane `point`/`mark` override the pooled buffer's
(nil `point` keeps the buffer's own), clamped into range so a stale offset — left by an edit in
another view of the same buffer — can't index past EOF and crash the renderer. The one seam that
decouples the cursor from the shared buffer."
  (if (nil? point)
    buf
    (let (n (buffer-length buf))
      (assoc buf
        :point (math/max 0 (math/min point n))
        :mark (if (nil? mark) nil (math/max 0 (math/min mark n)))))))

(defn ed-current-pane (m)
  "The selected pane's payload `{:buffer <pool index> :top <scroll> :point :mark}`."
  (pane-selected-payload (:layout m)))

(defn ed-current-index (m)
  "The pool index of the buffer shown in the selected pane."
  (:buffer (ed-current-pane m)))

(defn ed-current-buf (m)
  "The buffer being edited — the selected pane's pooled buffer, carrying that pane's
**window-local** cursor (`ed-with-window-point`) so each view of a shared buffer keeps its own
point/mark."
  (let (pane (ed-current-pane m))
    (ed-with-window-point (nth (:buffers m) (:buffer pane))
      (:point pane)
      (:mark pane))))

(defn ed-current-top (m)
  "The selected pane's scroll offset (0-based first visible line). Together with
`(:view-rows m)` and `(:view-cols m)` — stored by `ed-update` every tick — these
three values define the current viewport and are the standard way for commands to reason
about what is on screen (e.g. lazy diff loading, paging, centring point)."
  (math/max 0 (or (:top (ed-current-pane m)) 0)))

(defn ed-buf-at (m i)
  "The pool buffer at index `i` (what a pane's `:buffer` payload references)."
  (nth (:buffers m) i))

(defn ed-buf-mode-name (buf)
  "The mode to show for `buf`: the name of its highest-precedence active layer that
isn't a `:system` layer (so the always-on `global` layer is skipped — you see
`brood` on a `.blsp` buffer, `text` otherwise). `\"\"` if there's no non-system layer."
  (let (hit (seq/find (fn (l) (not (:system l))) (active-layers buf)))
    (if hit (->string (:name hit)) "")))

(defn ed-set-mode (m type)
  "Switch the current buffer's major mode to `type` (e.g. `:fundamental`, `:brood`):
`set-buffer-type` pins `:type` so `buffer-type-for` honours the explicit choice over
the filename, then `init-buffer-layers` re-seeds the full layer stack."
  (ed-set-buf m (init-buffer-layers (set-buffer-type (ed-current-buf m) type))))

(defn ed-active-mode-commands (buf)
  "The `:commands` lists from `buf`'s active layers, collected highest-precedence
first. Each list holds the M-x names the layer claims as mode-specific."
  (layer-collect buf :commands))

(defn ed-all-layer-commands ()
  "All command names claimed by any registered layer (all types + system layers) —
used to subtract layer-owned names from the global M-x set."
  (let (type-refs (mapcat layers-for-type (keys *type-layers*))
        all-refs (append type-refs *system-layers*))
    (apply append (layer-collect {:layers all-refs} :commands))))

(defn ed-mode-service (buf facet)
  "The value the buffer's active mode provides for `facet` — from the
highest-precedence active layer that defines it (`layer-collect`), resolved late
(`reflect/eval`) if stored as a fn *symbol*, else nil when no layer offers it. The generic
per-language services hook: the view and completion ask the buffer's mode for
`:fontify` / `:bracket-match` / `:eldoc` / `:complete-at` *without naming any
language*, so a new mode (json, python, …) is the same registration with its own
functions. `brood-mode` is the first to supply these (see `modes`)."
  (let (v (first (layer-collect buf facet)))
    (if (symbol? v) (reflect/eval v) v)))

(defn gutter-cell-chunks (cell)
  "A `:gutter-cell` service result normalised to a **list of `[text face]` chunks**. The
service may return either a single `[text face]` pair (a plain line number) or a list of such
chunks (a file buffer's diff-hl change bar *plus* the number — see `modes/line-number-cell`).
Decoding that two-forms shape used to live in each renderer separately, so the web mirror
assumed the single form and crashed on the list — silently dropping the browser the moment you
opened a file buffer. This is the single decoder both the native view (`view/ed-gutter-line-ops`)
and the web mirror (`web/web-gutter-html`) share, so the two can never drift apart again."
  (if (string? (first cell)) (list cell) cell))

;; ---- pure text geometry (offset → line/column) ------------------------------
;; Shared by the indenter mode-service adapters (src/modes.blsp) and the indent
;; command (src/commands.blsp): a char offset's line start and column, computed
;; from the text alone so they're testable without a buffer/rope.

(defn ed-line-start-offset (text off)
  "The offset of the start of the line containing char offset `off` — just after
the previous newline (0 at the first line). Tail-recursive."
  (if (or (<= off 0) (= (string/char-at text (dec off)) "\n"))
    off
    (ed-line-start-offset text (dec off))))

(defn ed-column-at (text off)
  "The 0-based column of char offset `off` in `text` (chars since the line start)."
  (- off (ed-line-start-offset text off)))

;; ---- diagnostics cache (async, recomputed only when the text changes) -------
;; A full advisory type-check is O(buffer) — hundreds of ms on a large file — far too
;; heavy for the loop. Two things keep it off the critical path: (1) staleness is keyed
;; on the buffer's ROPE HANDLE (an edit mints a fresh rope; movement keeps it), an O(1)
;; check rather than a whole-buffer text compare, so movement never even materialises
;; the text; (2) the check itself runs in a SPAWNED PROCESS (std/task) and its result is
;; folded back through `ed-update` as a `[:task-done …]` event, so the editor stays live
;; while the checker runs. Without a live `:editor` process (tests / headless) it falls
;; back to a synchronous check. The check is the buffer mode's `:diagnostics` service
;; (brood-mode → the in-process type checker); buffers whose mode offers none never pay.

(defn ed-refresh-diagnostics (m)
  "The model with `:diagnostics` (a list of `{:line :col :message}`) + `:diag-rope`
refreshed iff the current buffer has a `:diagnostics` service and its rope changed since
the last check; otherwise `m` unchanged. Synchronous — the core the async path and the
tests share."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :diagnostics)
        rope (buffer-rope buf))
    (if (or (nil? svc) (= rope (:diag-rope m)))
      m
      (assoc m :diagnostics (svc (buffer-text buf)) :diag-rope rope))))

(defn ed-launch-diag (m)
  "Start the deferred diagnostics check. A no-op when nothing is stale or a check is
already in flight (`:diag-proc`). With a live `:editor` process, run the check in a
spawned task (std/task) — recording its handle on `:diag-proc` and the rope it is
checking on `:diag-checking`, so a stale reply can't clobber a newer cache. Headless (no
`:editor`) → synchronous (`ed-refresh-diagnostics`)."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :diagnostics))
    (cond
      (or (nil? svc) (not (ed-diag-stale? m))) m
      (:diag-proc m) m
      (nil? (proc/whereis :editor)) (ed-refresh-diagnostics m)
      :else
        (let (text (buffer-text buf)
              job (task (fn () (svc text))))
          (assoc m :diag-proc job :diag-checking (buffer-rope buf))))))

(defn ed-apply-diag (m result)
  "Fold a finished diagnostics check's `result` (its `[:task-done …]` value, `()` if it
errored / timed out) into the model: store it against the rope it was computed for
(`:diag-checking` → `:diag-rope`) and clear the in-flight handle. `ed-diag-stale?` then
re-fires iff the buffer moved on while the check ran, so the next idle tick relaunches."
  (assoc m
    :diagnostics (or result '())
    :diag-rope (:diag-checking m)
    :diag-proc nil
    :diag-checking nil))

;; ---- diff-hl annotation, off the loop (mirrors the diagnostics pair) ---------
;; Diffing a buffer against its HEAD blob is `std/diff` over the whole file. On a large
;; file that is seconds of work — far too slow for the per-event loop (it once wedged the
;; whole editor on a 3000-line file: the single ui-run process never returned, so no key,
;; not even C-g, could be processed). So the diff runs in a spawned task, exactly like the
;; advisory diagnostics check: launch on the idle beat, fold the result back on its reply.

(defn ed-gitdiff-stale? (m)
  "True when the current buffer wants a diff-hl recompute: diff-hl is on (`:diff-hl?`,
default true), it's a file buffer, and its **rope differs from the one the cached gutter was
computed for** — its first view (no annotation at all), or any edit since. An O(1)
rope-handle compare (`annotation`'s `:stale?`), so plain motion costs nothing but a text change
re-arms the diff, so the change bars follow edits instead of freezing at their old lines until
a save (the 'bars drift the further down you scroll' symptom). No size cap — the recompute
runs OFF the loop (`ed-launch-gitdiff`), so a large file no longer blocks it."
  (and (:diff-hl? m true)
    (let (b (ed-current-buf m))
      (and (buffer-file b)
        (let (a (editor/buffer/annotation b :git-line-status))
          (or (nil? a) (:stale? a)))))))

(defn ed-launch-gitdiff (m)
  "Recompute the current buffer's diff-hl gutter when stale, OFF THE LOOP — mirroring
`ed-launch-diag`. `git show HEAD:file` + `git diff` is tens of ms on a normal file but scales
with the file size (~45ms on an 848KB / 12k-line doc, seconds on a huge one) — too much for the
per-event loop, which once wedged the whole editor on a large file — so it runs in a spawned
task (std/task): record the task handle on `:gitdiff-proc` and the rope it is diffing on
`:gitdiff-checking`, so a stale reply can't clobber a newer cache. Fires on the idle beat, gated
on an in-flight check. Headless (no `:editor`) → synchronous fallback.

(An earlier async version was blamed for a frozen gutter but later exonerated — the real bug
was the idle beat suppressed by a stuck `:held-key`, cac0ce3; the task-reply contract is pinned
by tests/gitdiff_async_test.blsp's last describe. Async is restored here because sync scales
with file size and blocks the loop — the very failure the user hit on a 12k-line file.)"
  (cond
    (not (ed-gitdiff-stale? m)) m
    (:gitdiff-proc m) m
    (not (bound? 'gitdiff/gitdiff-status)) m
    (nil? (proc/whereis :editor)) (ed-set-buf m (gitdiff/gitdiff-annotate (ed-current-buf m)))
    :else
      (let (b (ed-current-buf m)
            path (buffer-file b)
            text (buffer-text b)
            job (task (fn () (gitdiff/gitdiff-status path text))))
        (assoc m :gitdiff-proc job :gitdiff-checking (buffer-rope b)))))

(defn ed-apply-gitdiff (m result)
  "Fold a finished diff-hl compute's `result` (the `{0-based-line -> status}` map; nil/() on
error/timeout) into the buffer it was diffed for — located by the rope it carried
(`:gitdiff-checking`), so a buffer switch mid-flight still stamps the RIGHT buffer — with the
rope + line count, and clear the in-flight handle. A buffer edited since the launch has no
matching rope, so its stale result is dropped and `ed-gitdiff-stale?` re-fires next idle tick.
Mirrors `ed-apply-diag`."
  (let (rope (:gitdiff-checking m)
        m1 (dissoc m :gitdiff-proc :gitdiff-checking)
        idx (seq/index-where (fn (b) (= (buffer-rope b) rope)) (:buffers m1)))
    (if (< idx 0)
      m1
      ;; stamp the result onto the buffer we diffed (found BY ROPE, so a mid-flight
      ;; buffer switch still lands on the right one)
      (update m1
        :buffers assoc
        idx
        (editor/buffer/annotate (nth (:buffers m1) idx) :git-line-status (or result {}))))))

(defn ed-layer-modeline-segments (m buf)
  "The status-bar segments `buf`'s active layers contribute via a `:modeline` service — each a
`(model buf) -> string|nil` (resolved late, like every mode service). The seam a mode / layer
uses to put its own info on the status bar (the git layer, a REPL connection, …); blanks and
nils are dropped. The view appends these (and the global git branch) on the selected pane."
  (seq/keep (fn (svc)
              (let (f (if (symbol? svc) (reflect/eval svc) svc)
                    s (f m buf))
                (if (or (nil? s) (= "" s)) nil s)))
    (layer-collect buf :modeline)))

(defn ed-web-dirty? (m)
  "True when a web mirror is running (`:server`) and has an unpublished edit/move
(`:web-dirty`) — so the idle beat should push a fresh snapshot. Set on real input by
`ed-post-step`, cleared by the publish in `input/ed-timer-fire`."
  (and (:server m) (:web-dirty m)))

;; ---- the post-event step: cached eldoc + debounced diagnostics --------------
;; Both the eldoc hint and the advisory type-check are too costly to recompute on the
;; render path (eldoc, every frame) or on every keystroke (the whole-buffer check).
;; Emacs runs eldoc / flymake on an *idle timer*; we do the same with the editor's
;; existing `:tick` beat. `input/ed-update` runs `ed-post-step` after each event folds
;; in: it caches the eldoc string on the model (so `view` just paints it) and, instead
;; of type-checking per key, arms a short debounce tick whose firing runs the check
;; once typing settles. While a key auto-repeats, the typematic delay is the debounce.

(defn ed-cache-eldoc (m)
  "Refresh the model's cached `:eldoc` hint — the current buffer mode's `:eldoc`
service applied to point, or nil when the mode offers none. Also stamps `:eldoc-point`
(the point it was computed at) so `ed-eldoc-stale?` can tell when point has moved and a
refresh is due. Computed on the idle tick (`ed-post-step`), not per keystroke: the
service parses around point (O(point) for brood-mode's `enclosing-call`), too costly to
run on every key in a large buffer. A service error caches nil rather than disrupting
the edit."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :eldoc)
        pt (buffer-point buf))
    (if (nil? svc)
      (assoc m :eldoc nil :eldoc-point pt)
      (assoc m
        :eldoc (try (svc (buffer-text buf) pt) (catch e nil))
        :eldoc-point pt))))

(defn ed-eldoc-stale? (m)
  "True if the current buffer offers an `:eldoc` service and point has moved since the
cached `:eldoc` was computed (`:eldoc-point`) — a refresh is due. Buffers whose mode
offers no eldoc never pay. (Point-move covers typing too, since inserting moves point.)"
  (let (buf (ed-current-buf m))
    (and (ed-mode-service buf :eldoc)
      (not (= (buffer-point buf) (:eldoc-point m))))))

(defn ed-launch-eldoc (m)
  "Refresh the eldoc hint OFF the loop (the diagnostics pattern): with a live `:editor`
process, run the mode's `:eldoc` service in a spawned task — recording its handle on
`:eldoc-proc` and the point it is computed at on `:eldoc-checking`, so a stale reply
can't clobber a newer hint — and fold the reply via `ed-apply-eldoc` on `[:task-done]`.
Headless (no `:editor`) → synchronous (`ed-cache-eldoc`). A no-op when nothing is
stale or a compute is already in flight."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :eldoc))
    (cond
      (or (nil? svc) (not (ed-eldoc-stale? m))) m
      (:eldoc-proc m) m
      (nil? (proc/whereis :editor)) (ed-cache-eldoc m)
      :else
        (let (text (buffer-text buf)
              pt (buffer-point buf)
              job (task (fn () (try (svc text pt) (catch e nil)))))
          ;; :eldoc-checking records the point AND the rope the hint is being
          ;; computed for — the reply is dropped if the user switched buffers
          ;; (or the text changed) while the task ran, else buffer A's signature
          ;; would be cached (and shown) as buffer B's
          (assoc m :eldoc-proc job :eldoc-checking {:pt pt :rope (buffer-rope buf)})))))

(defn ed-apply-eldoc (m result)
  "Fold a finished eldoc task's reply (nil on error/timeout): cache the hint against
the point it was computed at (`:eldoc-checking` → `:eldoc-point`) and clear the
in-flight handle — but only when the CURRENT buffer still holds the rope the hint
was computed for; a reply landing after a buffer switch (or an edit) is dropped
(the stale `:eldoc-point` mismatch then lets the next idle beat relaunch).
`ed-eldoc-stale?` re-fires iff point moved on while the task ran."
  (let (chk (:eldoc-checking m)
        m1 (assoc m :eldoc-proc nil :eldoc-checking nil))
    (if (= (buffer-rope (ed-current-buf m1)) (:rope chk))
      (assoc m1 :eldoc result :eldoc-point (:pt chk))
      m1)))

(defn ed-diag-stale? (m)
  "True if the current buffer offers a `:diagnostics` service and its rope differs from
`:diag-rope` (the rope the cached `:diagnostics` were computed from) — i.e. a recheck is
due. An O(1) rope-handle compare, not a whole-buffer text compare, so movement (which
keeps the rope) costs nothing. Buffers whose mode offers no service are never stale."
  (let (buf (ed-current-buf m))
    (and (ed-mode-service buf :diagnostics)
      (not (= (buffer-rope buf) (:diag-rope m))))))

(defn ed-run-diag (m)
  "Launch the deferred diagnostics check (async via `ed-launch-diag` when an `:editor`
process is live, synchronous otherwise) — a no-op when not stale or one is in flight.
What the `:idle-recompute` timer (ADR-102) runs once the debounce window has elapsed."
  (ed-launch-diag m))

;; ---- named timers (ADR-102): the model declares time-driven work as `:timers` ----
;; `ed-sync-timers` reconciles `:timers` with the model state after each event (the
;; declarative replacement for the old "shorten :tick-ms" arming cascade); the per-timer
;; firing is dispatched in `input/ed-timer-fire`. `ed-set-timer`/`ed-drop-timer` are the
;; imperative pair for key-repeat (which transitions delay→rate as it fires).

(defn ed-set-timer (m name spec)
  "Add or replace the `:timers` entry `name` with `spec` (a `{:every ms}`/`{:after ms}`
map, optionally `:idle? true`). See ADR-102."
  (assoc-in m [:timers name] spec))

(defn ed-drop-timer (m name)
  "Remove the `:timers` entry `name` (a no-op if absent)."
  (assoc m :timers (dissoc (or (:timers m) {}) name)))

(defn ed-real-input? (input)
  "True if `input` is direct user input — a key or a mouse event — as opposed to a timer
firing (`[:timer …]`), a `:tick`/`:blur`, or an async system event (`[:task-done …]` …).
Used to keep the caret solid while you actively type/click: the blink resets on real
input, then the idle `:cursor-blink` timer takes over once you stop."
  (cond
    (= input :tick) false
    (= input :blur) false
    (record? input) false ; a UiEvent record — async, never a keystroke (a 30ms spy
    ; flush must not pin the caret solid or dirty the web mirror)
    (vector? input) (= (first input) :mouse)
    else true))

(defn ed-sync-timers (m)
  "Reconcile `:timers` (ADR-102) with the model after each event — the declarative
replacement for the old arm-the-tick cascade. `:cursor-blink` is always present; the
idle one-shots — eldoc/diagnostics debounce (`:idle-recompute`), the which-key reveal
delay, the undo-pause boundary — are present only while their work is pending; the
imperatively-managed `:key-repeat` is preserved untouched. A held key suppresses the idle
one-shots (as the old held-key short-circuit did). Also clears the `:which-key` reveal
flag once no prefix is pending (what `ed-which-key-arm` used to do)."
  (let (m (if (:pending m) m (dissoc m :which-key))
        held (:held-key m)
        ;; The diff-hl gutter and web-mirror recompute is armed regardless of `:held-key`:
        ;; a missed key-up can leave that flag stuck, which would otherwise suppress the idle
        ;; beat forever and freeze the gutter. The `:idle?` deadline still debounces it — a
        ;; repeating key resets the countdown, so it fires only once typing/holding settles.
        ;; (eldoc/diagnostics/completion stay held-key-gated: they're point/typing-driven and
        ;; shouldn't recompute on every repeat tick. The blink tick is a second, ungated
        ;; trigger for the gutter — see `input/ed-timer-fire :cursor-blink`.)
        recompute? (or (ed-gitdiff-stale? m)
                     (ed-web-dirty? m)
                     (and (not held)
                       (or (ed-eldoc-stale? m) (ed-diag-stale? m) (mb-cands-stale? m))))
        ;; the tutorial's eval-on-type debounce (its own timer, tunable apart from
        ;; :idle-recompute); tutor is deferred-loaded — bound?-guarded + late-bound
        ;; (`reflect/eval`), the keymap idiom, so this core file never links it eagerly
        tutor-stale? (and (not held)
                       (bound? 'tutor/ed-tutor-stale?)
                       ((reflect/eval 'tutor/ed-tutor-stale?) m))
        idle (merge (if recompute? {:idle-recompute {:after *diag-debounce-ms* :idle? true}} {})
               (if tutor-stale? {:tutor-eval {:after *tutor-eval-debounce-ms* :idle? true}} {})
               (if held
                 {}
                 (merge (if (and (:pending m) (not (:which-key m)))
                          {:which-key {:after *which-key-delay-ms* :idle? true}}
                          {})
                   (if (and (includes? *typing-commands* (:this-command m)) (not (:undo-break m)))
                     {:undo-pause {:after *undo-pause-ms* :idle? true}}
                     {}))))
        managed (merge {:cursor-blink {:every *blink-ms* :idle? true}} idle)
        kept (dissoc (or (:timers m) {})
               :cursor-blink :idle-recompute :which-key :undo-pause :tutor-eval))
    (assoc m :timers (merge kept managed))))

;; ---- overlay scrollbar fade (macOS-style auto-hide) -------------------------
;; The scrollbar thumb is hidden at rest. Any scroll wakes it to full opacity
;; (`ed-scrollbar-wake`, called from every `:top` change) and arms the
;; `:scrollbar-fade` timer, which holds it opaque for `*scrollbar-hold-ticks*`
;; then ramps to 0 over `*scrollbar-fade-ticks*` (`input/ed-timer-fire`),
;; dropping itself when done so the editor returns to fully idle. Dragging the
;; thumb pins it opaque. The opacity (`ed-scrollbar-opacity`) is read by the
;; pure view (`view/ed-scrollbar-ops`).
(def *scrollbar-fade-ms* 16) ; the fade timer beat (~60fps while visible)
(defdyn *scrollbar-hold-ticks* 50) ; ticks held fully opaque after a scroll (~800ms)
(defdyn *scrollbar-fade-ticks* 14) ; ticks to ramp opacity 1→0 after the hold (~220ms)
(defn ed-scrollbar-wake (m)
  "Show the overlay scrollbar at full opacity and (re)arm the fade timer. Called from
every scroll path (`ed-set-top`, `panes/ed-scroll-pane`) so the thumb appears whenever
the view moves, then auto-hides."
  (ed-set-timer (assoc m :sb-fade (+ *scrollbar-hold-ticks* *scrollbar-fade-ticks*))
    :scrollbar-fade {:every *scrollbar-fade-ms*}))

(defn ed-scrollbar-opacity (m)
  "The overlay scrollbar's opacity this frame (0..1): pinned full while dragging it,
else the fade ramp from the `:sb-fade` budget — held at 1.0, then linear to 0. 0 ⇒ the
view omits the thumb entirely."
  (if (:sb-drag m)
    1.0
    (let (budget (or (:sb-fade m) 0))
      (if (<= budget 0)
        0.0
        (math/min 1.0 (/ (* 1.0 budget) *scrollbar-fade-ticks*))))))

;; ---- key / command labels (which-key + describe-key) ------------------------
;; Presentation helpers shared by the which-key panel (view) and describe-key (input):
;; turn a keymap key into an Emacs-style label and a binding (a command symbol or a
;; prefix sub-keymap) into a short command name, and read a command's docstring.

(defn ed-key-label (k)
  "An Emacs-style label for a keymap key: `:ctrl-e` → `C-e`, `:alt-g` → `M-g`,
`:ctrl-meta-i` → `C-M-i`, `(keyword \"alt- \")` → `M-SPC`, a 1-char string as itself."
  (cond
    (string? k) (if (= k " ") "SPC" k)
    (keyword? k)
      (-> (->string k)
        (string/replace "ctrl-meta-" "C-M-")
        (string/replace "ctrl-" "C-")
        (string/replace "meta-" "M-")
        (string/replace "alt-" "M-")
        (string/replace "shift-" "S-")
        (string/replace "C- " "C-SPC")
        (string/replace "M- " "M-SPC"))
    :else (str k)))

(defn ed-cmd-label (v)
  "A short label for a keymap binding: a prefix sub-keymap → `+prefix`, else the command
symbol's name with the module path and `cmd-` prefix stripped (`commands/cmd-find-file`
→ `find-file`)."
  (if (map? v)
    "+prefix"
    (let (base (last (string/split (->string v) "/")))
      (if (string/starts-with? base "cmd-") (string/substring base 4 (string/length base)) base))))

(defn ed-keys-label (keys)
  "A space-joined Emacs label for a key sequence (`[:ctrl-x :ctrl-e]` → `C-x C-e`)."
  (string/join " " (map ed-key-label keys)))

;; ---- key-accurate help text: ask the keymap, don't hardcode -------------------
;; Any text that tells the user which key to press goes stale the moment a key is
;; rebound (or the profile switches). So text names the COMMAND and the renderer
;; asks the live keymap what runs it — Emacs's `substitute-command-keys`, over
;; std's `keymap-where-is`. `ed-command-keys` builds the vocabulary; pair it with
;; `template/render`'s `{{name}}` holes and prose follows the user's own bindings.

(defn ed-where-is (km command &optional fallback)
  "The Emacs-style label of the key sequence bound to `command` in keymap `km`
(`\"C-x C-e\"`), or `fallback` when nothing is — including when `command` is **nil**,
the \"this key is grammar, not a binding, so document the literal\" case (a modal
profile routing many keys through one command). With several bindings the choice is
**deterministic** — the shortest sequence, then the alphabetically-first label (so
`C-n` beats `down`, and re-rendering never reshuffles) rather than whatever the
map's hash order happens to yield."
  (let (labels (if (nil? command) '() (map ed-keys-label (keymap-where-is km command)))
        ;; a `[key-count label]` sort key: structural order compares the number
        ;; first (shortest chord wins), then the label as text — deterministic
        ;; without needing a string comparator (`<` is numeric in Brood).
        best (first (sort-by (fn (l) [(count (string/split l " ")) l]) labels)))
    (or best fallback)))

(defn- ed-run-by-name
  (km name)
  ;; "how you'd run `name` with no key bound": the profile's command-prompt key plus
  ;; the name. The SEPARATOR is part of the answer, not decoration — vim's prompt is
  ;; `:` and you type `:save` with no space, while emacs' is a chord and you type
  ;; `M-x save` with one. A hardcoded space made the vim rendering wrong in exactly
  ;; the way a hardcoded "M-x" would have.
  (let (prompt (ed-where-is km 'commands/cmd-execute-extended-command "M-x")
        sep (if (= 1 (string/length prompt)) "" " "))
    (str prompt sep name)))

(defn- ed-subst-hole
  (km hole)
  ;; One `\\[command]` hole -> the key bound to it, else how to run it by name.
  (let (sym (symbol (string/trim hole)))
    (or (ed-where-is km sym)
      (ed-run-by-name km (ed-cmd-label sym)))))

(defn ed-substitute-command-keys (km text)
  "Emacs's `substitute-command-keys`: replace every `\\[command]` hole in `text` with
the key sequence bound to that command in `km`, or `M-x <name>` when it has none.

The low-ceremony half of key-accurate help text: `ed-command-keys` is right when the
same key is named many times (a vocabulary worth declaring), this is right for the
one-off mentions that would otherwise be hardcoded — a welcome message, a mode's
help header, a commit buffer's instructions. Either way the text follows the user's
real bindings instead of contradicting them."
  (let (parts (string/split text "\\["))
    (if (= (count parts) 1)
      text
      (str (first parts)
        (apply str
          (map
            (fn (part)
              (let (close (index-of part "]"))
                (if (< close 0)
                  (str "\\[" part) ; unterminated: leave it alone
                  (str (ed-subst-hole km (string/substring part 0 close))
                    (string/substring part (inc close) (string/length part))))))
            (rest parts)))))))

(defn ed-command-keys (km specs)
  "A `{name → key-label}` vocabulary derived from the live keymap `km`: `specs` is
`{name [command-sym fallback]}` (the fallback covers a command the profile doesn't
bind — e.g. a modal grammar key that isn't a command at all). The data half of
key-accurate help text: render prose with `{{name}}` holes against this and a
rebinding updates the documentation instead of contradicting it.

    (template/render \"press {{save}} to save\"
      (ed-command-keys km {:save ['commands/cmd-save-buffer \"C-x C-s\"]}))"
  (fold (fn (acc kv)
          (let ([name spec] kv
                [command fallback] spec)
            (assoc acc name (ed-where-is km command fallback))))
    {}
    specs))

(defn ed-doc (sym)
  "The docstring of command `sym` via the `doc` primitive. Tries it as given (a qualified
keymap binding like `commands/cmd-find-file` resolves directly), then in the `commands/`
namespace (where the M-x registry's bare `cmd-` symbols live). Nil if neither resolves."
  (or (try (reflect/eval (list 'doc sym)) (catch e nil))
    (try (reflect/eval (list 'doc (symbol (str "commands/" (->string sym))))) (catch e nil))))

(defn ed-first-line (s)
  "The first line of string `s` (the docstring summary shown in the echo area)."
  (first (string/split s "\n")))

(defn ed-strip-newline (s)
  "`s` without a single trailing newline — a buffer line's text with the `\\n` that
`buffer-line-at` keeps dropped. Shared by the view (line rendering) and the editing
commands (transpose-lines, occur)."
  (if (string/ends-with? s "\n") (string/substring s 0 (dec (string/length s))) s))

(defn ed-read-char (m prompt then)
  "Show `prompt` in the echo area and route the *next* key to `then` (a `(model key) ->
model` continuation), via the read-char transient (`input`). Esc/C-g aborts. The shared
one-key reader behind zap-to-char and the register / bookmark commands."
  (assoc (message m prompt) :read-char {:then then}))

(defn ed-break-undo-run (m)
  "Insert an undo boundary at a typing pause: arm the one-shot `:undo-break` so the next
self-insert / deletion starts a FRESH undo group instead of amalgamating into the run
typed before the pause (Emacs `undo-boundary` on idle). `input/ed-dispatch-key` consumes
the flag. Leaves `:last-command` untouched, so kill coalescing / yank-pop are unaffected."
  (assoc m :undo-break true))

(defn ed-which-key-reveal (m)
  "When the `:which-key` timer fires with a prefix still pending, reveal the panel
(`ed-sync-timers` then drops the now-satisfied timer); if the chord ended first, clear it.
Public (called cross-module from `input/ed-timer-fire`)."
  (if (:pending m) (assoc m :which-key true) (dissoc m :which-key)))

(defn ed-post-step (m input)
  "The post-event step run after `input/ed-update` folds an event in. The eldoc hint and
the advisory type-check are **debounced onto idle timers** (ADR-102; Emacs's idle-timer
model) — recomputing them per keystroke makes a large buffer crawl. So this recomputes
nothing directly; it just reconciles `:timers` (`ed-sync-timers`) with the new model
state — arming the eldoc/diagnostics debounce, the which-key delay, and the undo-pause
boundary when each is due — and the timers' firing (in `input/ed-timer-fire`) does the
work. A real keystroke/click also forces the caret solid (`ed-real-input?`), so it only
blinks at rest. Finally refreshes the open minibuffer's memoized candidate list
(`ed-cache-mb-candidates`) so the view/input read it cheaply."
  (let (real (ed-real-input? input)
        ;; a real keystroke/click forces the caret solid AND, while a web mirror is
        ;; running, marks the snapshot dirty so the idle beat republishes it once (debounced
        ;; off the hot key path — `ed-sync-timers` arms `:idle-recompute`, `web-publish!`
        ;; fires there). Timer/blink/system events don't dirty it, so the mirror only
        ;; refreshes after actual edits/moves.
        m0 (if real (assoc m :blink-on? true) m)
        m1 (if (and real (:server m)) (assoc m0 :web-dirty true) m0)
        m2 (ed-sync-timers m1)
        mb (:minibuffer m2))
    ;; Refresh the memoized candidate list. A small source re-ranks every keystroke (snappy).
    ;; A large source (`mb-debounce?`) re-ranks only its *initial* list here and defers later
    ;; refreshes to the idle `:idle-recompute` timer — so typing fast doesn't re-rank tens of
    ;; thousands of candidates per keystroke (the completion debounce). `mb-candidates` returns
    ;; the cached list meanwhile; a deliberate Tab/↑/↓/Enter forces a fresh refresh.
    (cond
      (or (nil? mb) (not (mb-source? mb))) m2
      (and (mb-debounce? mb) (:cand-cache mb)) m2
      :else (ed-cache-mb-candidates m2))))

;; ---- the minibuffer (a one-line prompt over lineedit's pure editor core) -----
;; The `:minibuffer` field is `{:edit <lineedit-state> :on-complete :complete-fn
;; :candidates-fn}`. `:edit` is a `std/lineedit` state, so the prompt reuses the
;; REPL line editor's editing (motion, kill-ring, yank, history, reverse-search) —
;; the same core std/observer's minibuffer drives. `input/minibuffer-handle` feeds
;; keys to `lineedit-handle`; these accessors read the editor's text/point/prompt.

(defn ed-mb-set-text (edit s)
  "The lineedit state `edit` with its text replaced by `s`, point at the end."
  (assoc edit :text s :point (string/length s) :hist-idx -1))

(defn ed-mb-edit (prompt initial)
  "A fresh minibuffer line-editor state showing `prompt`, prefilled with `initial`
text (point at end). Stored as the minibuffer's `:edit`."
  (ed-mb-set-text (editor/lineedit/lineedit-init prompt "" '()) initial))

(defn mb-text (mb) "The minibuffer's current input text." (get-in mb [:edit :text]))
(defn mb-point (mb) "The minibuffer cursor index (into its input)." (get-in mb [:edit :point]))
(defn mb-prompt (mb) "The minibuffer prompt string." (get-in mb [:edit :prompt]))
(defn mb-sel (mb) "The selected candidate index (Vertico-style), default 0." (or (:sel mb) 0))
(defn mb-source? (mb)
  "True if `mb` produces candidates from either a fixed `:rank-source` (fuzzy-ranked,
narrowable) or a `:candidates-fn` (computed each keystroke)."
  (or (:rank-source mb) (:candidates-fn mb)))

(defn- mb-rank
  (mb text prev-for prev-ranked)
  "`[ranked cands]` for minibuffer `mb` at input `text`. For a `:rank-source` prompt,
fuzzy-rank the source — narrowing from `prev-ranked` when `text` extends `prev-for`
(`completion/completion-rank-incremental`) — and cap to `:rank-cap` for display; `ranked`
(the full, untruncated ranking) is cached so the *next* keystroke can narrow from it. For a
`:candidates-fn` prompt there's nothing to narrow: `ranked` is nil and `cands` is the fn's
result. `[nil ()]` when the prompt has neither source."
  (cond
    (:rank-source mb)
      (let (ranked (completion-rank-incremental text
                     prev-for
                     prev-ranked
                     (:rank-source mb)))
        [ranked (take (or (:rank-cap mb) 20) ranked)])
    (:candidates-fn mb) [nil ((:candidates-fn mb) text)]
    :else [nil ()]))

(def ed-minibuffer-max 10) ; most list rows the echo area grows to (Emacs vertico-count)
(defn ed-which-key-count (m)
  "Number of pending which-key continuation rows (0 when the panel isn't showing — no
pending prefix, not yet revealed, or a minibuffer/menu is open)."
  (let (km (:pending m))
    (if (or (nil? km) (not (:which-key m)) (:minibuffer m) (:menu m))
      0
      (count (%map-pairs km)))))

(defn- ed-list-rows
  (n rows)
  "Echo-area height for an `n`-row list below the prompt: 0 → 1 (just the prompt), else
1 + the list capped to `ed-minibuffer-max` and the screen."
  (if (= n 0) 1 (+ 1 (math/min ed-minibuffer-max n (math/max 1 (- rows 4))))))

(defn ed-echo-rows (m rows)
  "How many bottom screen rows the echo area occupies. It grows **downward** from below
the mode line (Emacs-style): 1 (the prompt/message row) plus a list — Plume's candidate
list for an open selection prompt, or the which-key continuations for a pending prefix.
`ed-body-layout` reserves this many rows so the pane + its mode line sit above; `view`
lays the prompt + list into them."
  (let (mb (:minibuffer m))
    (if (and mb (:accept-selection mb))
      (ed-list-rows (count (mb-candidates mb)) rows)
      (ed-list-rows (ed-which-key-count m) rows))))

(defn mb-candidates (mb)
  "The current candidate list for minibuffer `mb` — fuzzy-ranked from its `:rank-source`,
or its `:candidates-fn` applied to the typed text, or `()` with neither.
**Memoized on the input text** via `:cand-cache` (refreshed by `ed-cache-mb-candidates`
each event): the view reads this every frame and input reads it on every selection move,
so without the memo a large candidate set (e.g. a whole project's files) would be
re-ranked several times per keystroke and again on every idle tick. The shared seam the
view (the vertical list) and input (selection + accept) both read. A cache miss computes
fresh (no narrowing — that needs the previous ranking, which `ed-cache-mb-candidates`
threads in)."
  (let (cache (:cand-cache mb))
    (cond
      ;; a fresh hit (the cache is for the current text) — the common case
      (and cache (= (:for cache) (mb-text mb))) (:cands cache)
      ;; a large source whose cache is stale: return it as-is — re-ranking is *debounced*
      ;; onto the idle timer, so typing fast doesn't re-rank tens of thousands of candidates
      (and cache (mb-debounce? mb)) (:cands cache)
      ;; otherwise (small source, or no cache yet) recompute now — instant, and what the
      ;; per-keystroke and direct-text-set paths rely on
      :else (second (mb-rank mb (mb-text mb) (:for cache) (:ranked cache))))))

(defn- mb-debounce?
  (mb)
  "Whether minibuffer `mb`'s candidate ranking should be debounced — a fixed `:rank-source`
larger than `*complete-debounce-min*` (a `:candidates-fn` prompt computes its own way)."
  (let (src (:rank-source mb))
    (and src (> (count src) *complete-debounce-min*))))

(defn mb-cands-stale? (m)
  "True if an open candidate prompt's cached list is for a different input than the current
text — a recompute is due. Drives the idle (`:idle-recompute`) debounce timer for a large
source; a small source is kept current synchronously, so it's never stale here."
  (let (mb (:minibuffer m))
    (and mb
      (mb-source? mb)
      (not (= (get-in mb [:cand-cache :for]) (mb-text mb))))))

(defn ed-cache-mb-candidates (m)
  "Refresh the open minibuffer's `:cand-cache` (`{:for <text> :ranked <full> :cands …}`)
when its input text changed since the last computation — so `mb-candidates` returns a
memoized list rather than re-ranking the full candidate set per frame / selection move /
tick. For a `:rank-source` prompt it also **narrows incrementally**: each keystroke ranks
the previous result (`:ranked`) instead of the whole source when the query grew (see
`mb-rank`). Run once per event by `ed-post-step`; a no-op with no minibuffer, no candidate
source, or unchanged text."
  (let (mb (:minibuffer m))
    (if (or (nil? mb) (not (mb-source? mb)) (= (get-in mb [:cand-cache :for]) (mb-text mb)))
      m
      (let (cache (:cand-cache mb)
            [ranked cands] (mb-rank mb (mb-text mb) (:for cache) (:ranked cache)))
        (assoc m
          :minibuffer (assoc mb :cand-cache {:for (mb-text mb) :ranked ranked :cands cands}))))))

(defn ed-set-buf (m buf)
  "The model with `buf` written back to the selected pane's POOL slot (so every view sees a
content edit) **and** `buf`'s point/mark cached as the selected pane's **window-local** cursor
— so other panes on the same buffer keep their own. Scroll (per-pane) is untouched."
  (assoc m
    :buffers (assoc (:buffers m) (ed-current-index m) buf)
    :layout
      (pane-update-selected (:layout m)
        (fn (w) (assoc w :point (:point buf) :mark (:mark buf))))))

(defn ed-set-top (m n)
  "The model with the *selected pane's* scroll offset set to `n` (per-pane, so
another pane on the same buffer keeps its own scroll). A real change wakes the overlay
scrollbar (`ed-scrollbar-wake`)."
  (let (m2 (assoc m :layout (pane-update-selected (:layout m) (fn (w) (assoc w :top n)))))
    (if (= n (ed-current-top m)) m2 (ed-scrollbar-wake m2))))

(defn ed-show-index (m i)
  "The model with the selected pane showing pool buffer `i`, scrolled to the top and with its
window-local cursor **cleared** — so the buffer opens at its own stored point (not the pane's
previous buffer's), and this pane then tracks independently. The pane-layer primitive behind
buffer switching."
  (assoc m
    :layout
      (pane-update-selected (:layout m)
        (fn (w) (assoc w :buffer i :top 0 :point nil :mark nil)))))

(defn ed-map-panes (m f)
  "The model with `f` applied to every pane's payload — for re-pointing
pane→buffer references after the pool changes (e.g. after a kill). Pure."
  (assoc m :layout (pane-map (:layout m) f)))

(defn ed-buffer-index-by-name (m nm)
  "The pool index of the buffer named `nm`, or nil if there is none."
  (let (i (seq/index-where (fn (b) (= (buffer-name b) nm)) (:buffers m)))
    (if (< i 0) nil i)))

(defn ed-buffer-index-by-file (m path)
  "The pool index of the buffer visiting file `path`, or nil — a file's identity for
\"already open?\", distinct from its display name (which may be a project-relative
path or a basename, so it can't be matched against the on-disk path)."
  (let (i (seq/index-where (fn (b) (= (buffer-file b) path)) (:buffers m)))
    (if (< i 0) nil i)))

;; ---- the `*Messages*` log + echo area ---------------------------------------

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (string/replace s "\n" " "))

(defn- ed-ensure-newline
  (s)
  "`s` with exactly one trailing newline (logger lines already end in one; echo
strings don't) — so a log buffer keeps one line per record."
  (if (string/ends-with? s "\n") s (str s "\n")))

(defn ed-append-end (buf line)
  "Append `line` at `buf`'s end, tolerating a READ-ONLY buffer: a report stream
(*Tests*, *Spy*, *compilation*) is read-only for the USER — its text mutators refuse
edits — but the stream itself is the owner, so unlock, insert, re-lock. std's
`insert` throws on a read-only buffer (the buffer-level contract), which is right
for a command and wrong for the buffer's own producer."
  (if (read-only? buf)
    (set-read-only (insert (end-of-buffer (set-read-only buf false)) line) true)
    (insert (end-of-buffer buf) line)))

(defn ed-append-named (m nm s)
  "Append `s` as a line to the buffer named `nm`, creating a fresh undo-less log
buffer for it in the pool if none exists (so *Messages* / *LSP* / … survive buffer
switches and kills). Appends at that buffer's end without disturbing the *current*
buffer's point — the target is a separate pool entry; a read-only report buffer is
unlocked for the append and re-locked (`ed-append-end`). Sets no echo: this is the
raw sink shared by `message` (which adds the echo) and routed log buffers (which
must not flood the echo area). Returns the model."
  (let (idx (ed-buffer-index-by-name m nm)
        line (ed-ensure-newline s))
    (if (nil? idx)
      (update m :buffers into [(ed-stamp (insert (ed-log-buffer nm) line))])
      (update m :buffers assoc idx (ed-append-end (nth (:buffers m) idx) line)))))

(defn message (m s)
  "Log `s` to the editor's default sink: append it as a line to `*Messages*`
(`ed-append-named`, creating it if needed) *and* show it (flattened to one line) in
the echo area. Never disturbs the current buffer's point. The editor's primary output
— commands print here, never the console; categorised logs route elsewhere (see
`ed-append-named` + the log routes)."
  (assoc (ed-append-named m "*Messages*" s) :echo (one-line s)))

;; ---- log routing: one logger, a filtered backend per destination buffer ------
;; stdout (a raw `*out*` stream) and logging (structured, levelled records) are
;; different pipes that converge only here — text appended to a named buffer. The
;; logger (std/log) fans each record to its backends; we give it one backend per
;; destination buffer, each a `:filter` on the record's `:meta :category`, so a
;; component's logs land in its own buffer: uncategorised → *Messages* (the default),
;; `{:category :lsp}` → *LSP*, etc. A backend's sink is a `process-port`-style `io`
;; port that sends a `buffer-log-event` to the editor, which folds it into that
;; buffer (`ed-append-named`) — the same share-nothing path `print` uses.

;; ---- the async event contract (UiEvent) --------------------------------------
;; Besides keys, the ui-run loop's mailbox receives async events from the editor's
;; own producers (the compile worker, the project shell, the web mirror, the log
;; backends below). Each is a RECORD implementing `UiEvent`: the producer module
;; defines the record + impl and just sends it — no central handler table to edit
;; (`ed-update` folds any `UiEvent` record via `ui-event-fold`). Declared here
;; because every producer already `:use`s the model. Events whose producer we don't
;; own — the GUI frontend's `[:resize]`/`[:mouse]`/`[:key-up]`, the runtime's
;; `[:down]`, std's `[:buffer-updated]`/`[:io/write]`/`[:task-*]`/`[:client-opts]`,
;; and the lsp replies interlocked with completion's bounded wait — stay tagged
;; vectors in input's residual registry.

(defn ed-json-event-line (line)
  "The tagged JSON event object a runner subprocess printed on `line`, or nil —
salvaging a line another process's unflushed `print` prefixed (re-parse from the
first `{` when an event object is plainly present). The decode half every streaming
runner (testrun / apprun) shares; classifying the event stays theirs."
  (let (parse (fn (s) (try (json/decode s) (catch e nil)))
        parsed (or (parse line)
                 (let (i (index-of line "{"))
                   (when (and (includes? line "\"event\":") (>= i 0))
                     (parse (string/substring line i (string/length line)))))))
    (when (map? parsed) parsed)))

(defability UiEvent
  "An app-produced async event on the ui-run mailbox: `ui-event-fold` folds it into
the model (the async analogue of a command's `model -> model`). Each impl does its
own scroll-clamp, and delegates to a NAMED handler fn so redefining that global
hot-swaps the live editor (the impl body's call is resolved late, like a keymap
binding)."
  (ui-event-fold [self m textrows cols rows] :-> any))

(defn ui-event? (input)
  "Whether `input` is an async event record (implements `UiEvent`)."
  (and (record? input) (satisfies? 'UiEvent input)))

(defrecord buffer-log-event (buffer line)) ; a routed log line -> append to that buffer
(impl UiEvent
  buffer-log-event
  ;; Unlike `[:io/write]` it sets *no* echo, so a category's stream (e.g. *LSP*)
  ;; never floods the echo area.
  (ui-event-fold [e m textrows cols rows]
    (ed-append-named m (buffer-log-event-buffer e) (buffer-log-event-line e))))

;; Registered category→buffer log routes — a list of `{:category :buffer}`. A `def`
;; registry (rebound by `register-log-route`, like `layers/*type-layers*`), so it's
;; reload-stable *and* read afresh whenever the supervised logger (re)starts, so routes
;; survive a logger restart. Uncategorised records always go to *Messages*.
(def *log-routes*
  ())

(defn register-log-route (category buffer)
  "Route log records tagged `{:category <category>}` to the buffer named `buffer`
(its own *LSP*-style log buffer). Idempotent-ish: prepended, newest wins. A mode
declares its destination by calling this (its `:log-category` / `:log-buffer`)."
  (def *log-routes* (cons {:category category :buffer buffer} *log-routes*)))

(defn- ed-record-category
  (rec)
  "The `:category` a log record carries in its `:meta`, or nil (uncategorised)."
  (get-in rec [:meta :category]))

(defn ed-buffer-backend (nm &optional (opts {}))
  "A std/log backend whose sink sends each formatted line to the editor as a
`buffer-log-event` (the editor appends it to buffer `nm`). `opts` is the usual
`backend` map (`:filter` / `:min-level` / `:format`). The log-side counterpart of
`message`: a component points its logger here to stream into its own buffer."
  (log/backend (io/fn-port (fn (s) (send (proc/whereis :editor) (buffer-log-event nm s)) nil)) opts))

(defn ed-log-backends ()
  "The logger's full backend list, built from `*log-routes*`: one filtered backend
per route (records of that `:category` → its buffer) plus the default backend for
*uncategorised* records → *Messages*. Disjoint filters, so a record lands in exactly
one buffer and the table needs no shared state. Rebuilt at every (re)start of the
supervised logger, so routes survive a restart."
  (cons (ed-buffer-backend "*Messages*" {:filter (fn (r) (nil? (ed-record-category r)))})
    (map (fn (rt)
           (ed-buffer-backend (:buffer rt)
             {:filter (fn (r) (= (ed-record-category r) (:category rt)))}))
      *log-routes*)))

;; ---- OS window title --------------------------------------------------------

(defn ed-bytes-human (n)
  "A byte count as a short human string (`1.0 MB` / `13 KB` / `512 B`) — the shared
formatter for the app-run chip and anywhere else that shows memory."
  (cond
    (>= n 1048576)
      (str (math/quot n 1048576) "." (math/quot (math/rem (math/quot n 1024) 1024) 102) " MB")
    (>= n 1024) (str (math/quot n 1024) " KB")
    else (str n " B")))

(defn ed-reds-human (n)
  "A reduction count short (`1.2M` / `194k` / `42`) — the app-run telemetry's work
metric."
  (cond
    (>= n 1000000) (str (math/quot n 1000000) "." (math/quot (math/rem n 1000000) 100000) "M")
    (>= n 1000) (str (math/quot n 1000) "k")
    else (str n)))

(def *app-name*
  ;; The editor's display name, as a human reads it: the OS title bar's suffix, and
  ;; the placeholder title `main` opens the window with before the first event
  ;; produces a real one. Distinct from `config/*app-id*`, the machine-facing
  ;; identity the desktop matches a window to its `.desktop` entry by.
  "bedit")

(defn ed-window-title (m)
  "OS title bar: `name` [*] [— branch] — bedit.
`*` when the current buffer is modified; branch from the git summary when present."
  (let (buf (ed-current-buf m)
        name (buffer-name buf)
        modified (if (:modified buf) " *" "")
        branch (:branch (:git-summary m))
        branch-seg (if (nil? branch) "" (str " — " branch)))
    (str name modified branch-seg " — " *app-name*)))

;; ---- auto-save --------------------------------------------------------------
;; On the idle beat, write `#filename#` sidecar files for modified file-backed
;; buffers. `cmd-save` clears the sidecar on a real save (`delete-file`).

(def *auto-save-interval-ms* 30000)

(defn ed-auto-save-path (path)
  "The auto-save sidecar path: `#basename#` in the same directory as `path`."
  (path/join (path/dirname path) (str "#" (path/basename path) "#")))

(defn ed-auto-save! (m)
  "Write `#filename#` sidecars for all modified file-backed buffers, throttled to
once per `*auto-save-interval-ms*`. Returns the model with `:auto-saved-at` updated."
  (let (now-ms (os/now)
        last (or (:auto-saved-at m) 0))
    (if (< (- now-ms last) *auto-save-interval-ms*)
      m
      (do
        (doseq (buf (:buffers m))
          (let (path (buffer-file buf))
            (when (and path (:modified buf))
              (try (file/spit (ed-auto-save-path path) (buffer-text buf)) (catch e nil)))))
        (assoc m :auto-saved-at now-ms)))))

;; ---- scrolling --------------------------------------------------------------

(def *scroll-margin* 4) ; Emacs `scroll-margin`: lines of context kept above/below point
(defn ed-margin (textrows)
  "The effective scroll margin for a `textrows`-tall viewport: `*scroll-margin*`, capped
below half the viewport (so a tall margin in a short pane can't exceed what fits)."
  (math/max 0 (math/min *scroll-margin* (math/quot (dec textrows) 2))))

(defn ed-max-top (buf textrows)
  "The largest scroll offset that still fills a `textrows`-tall viewport — the last
line sits on the bottom row. Beyond this there'd be blank space past end-of-buffer, so
scrolling clamps here (and the bottom margin relaxes near EOF, as in Emacs)."
  (math/max 0 (- (buffer-line-count buf) textrows)))

(defn ed-scroll (m textrows)
  "Adjust the selected pane's `:top` so point keeps `*scroll-margin*` lines of context
above and below it within a `textrows`-tall viewport — scrolling only as far as needed
(Emacs `scroll-margin` + `scroll-conservatively`: never recenter, just enough). Clamped
so it never scrolls past end-of-buffer (no blank void below the last line); near the
edges the margin is whatever the buffer allows. Pure."
  (let (line (buffer-current-line (ed-current-buf m))
        top (ed-current-top m)
        mgn (ed-margin textrows)
        maxtop (ed-max-top (ed-current-buf m) textrows)
        lo (+ top mgn) ; first comfortable line (margin below top)
        hi (- (+ top textrows) 1 mgn))
    ; last comfortable line (margin above bottom)
    (cond
      (< line lo) (ed-set-top m (math/min maxtop (math/max 0 (- line mgn))))
      (> line hi) (ed-set-top m (math/min maxtop (math/max 0 (+ (- line textrows) 1 mgn))))
      else m)))

;; ---- horizontal scroll (long lines, no wrap): keep point's column in view ----
(def *hscroll-margin* 8) ; columns of context kept left/right of point
(defn ed-current-hscroll (m)
  "The selected pane's horizontal scroll offset (leftmost visible char column), 0 if unset."
  (math/max 0 (or (:hscroll (ed-current-pane m)) 0)))

(defn ed-set-hscroll (m n)
  "The model with the selected pane's `:hscroll` set to `n` (clamped non-negative)."
  (assoc m :layout (pane-update-selected (:layout m) (fn (w) (assoc w :hscroll (math/max 0 n))))))

(defn ed-scroll-horizontal (m cols)
  "Adjust the selected pane's `:hscroll` so point's column stays within the `cols`-wide
text area, keeping `*hscroll-margin*` columns of slack — the horizontal analogue of
`ed-scroll`, so a long line scrolls sideways to follow point instead of clipping. Char-
column based (exact for ASCII; a line of wide glyphs is approximate, as elsewhere)."
  (let (col (buffer-column (ed-current-buf m))
        hs (ed-current-hscroll m)
        mgn (math/max 0 (math/min *hscroll-margin* (math/quot (dec cols) 2)))
        lo (+ hs mgn)
        hi (- (+ hs cols) 1 mgn))
    (cond
      (< col lo) (ed-set-hscroll m (math/max 0 (- col mgn)))
      (> col hi) (ed-set-hscroll m (math/max 0 (+ (- col cols) 1 mgn)))
      else m)))
