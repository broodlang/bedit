(defmodule model
  "The editor's `ui-run` model: a buffer pool, the pane layout, the kill ring,
the minibuffer, and the `*Messages*` log + echo area.

The model is a map threaded through the `ui-run` loop:

  :buffers   a vector of BUFFERS — the pool. Each is an immutable, mode-stamped
             buffer value (its point/mark/undo travel with it). One is always the
             `*Messages*` buffer. Panes reference a buffer by its pool index.
  :layout    the PANE tree (`std/pane.blsp`): Emacs-style tiled splits, each
             leaf a pane with payload `{:buffer <pool index> :top <scroll>}`.
             Exactly one pane is *selected* — the one being edited. Scroll is
             per-pane (`:top`); buffer TEXT is shared via the pool, so two panes
             on the same buffer see each other's edits.
  :kill-ring a list of killed/copied strings, newest first (C-w / M-w / C-y)
  :minibuffer  nil, or `{:prompt :input :on-complete :complete-fn}` while a
             minibuffer prompt is active (C-x b switch-buffer, C-x C-f find-file)
  :pending   the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :echo      the one-line echo area (the latest message, newlines flattened)
  :status    the mode-line message
  :done      set to quit; :timers the named timers (ADR-102: debounce, which-key,
             undo-pause, scroll glide)

The whole loop runs in one process, so buffers live in the model directly. `message`
is the editor's echo primitive — like Emacs `message`, it writes to *both* the
`*Messages*` buffer and the echo area; eval output reaches it via `with-out-str`, so
it never hits the console.

\"The current buffer\" is the selected pane's buffer; editing writes back to the
pool (`ed-set-buf`), scrolling to the pane (`ed-set-top`)."
  (:use editor/buffer) ; make-buffer / insert / end-of-buffer / buffer-name / accessors
  (:use editor/layers) ; init-buffer-layers (stamp a buffer's mode) + active-layers (mode line)
  (:use editor/pane) ; the pane-tree layout: pane-single / selected payload / update / map
  (:use completion) ; completion-rank — the minibuffer's fuzzy rank, capped to what it shows
  ;; `:exclude [error]` — log's `error` would shadow the prelude's `error`.
  (:use log :exclude [error]) ; backend — the log-routing backends (one per buffer)
  ;; `:exclude [inspect]` — `io/inspect` WRITES; the root `inspect` is the ability op
  ;; that RETURNS the string. Referring the writer bare here would shadow the op.
  (:use io :exclude [inspect]) ; fn-port — the editor-targeting log sink (buffer-log-event)
  (:use keymaps)) ; profile-layers — seed the model-scope keybinding profile (emacs default)
;; editor/lineedit (minibuffer core) and json (runner event decode) are referenced
;; qualified below — each `mod/name` auto-loads its module.

(defdyn *blink-ms* 530)
(def *spinner-ms* 120) ; the activity-spinner beat — fast enough to read as motion, and
;; armed only while a job is in flight, so an idle editor still runs one timer, not two
;; The cursor-blink half-period (Emacs `blink-cursor-interval` ≈ 0.5s). The caret op
;; carries it (`editor/display/cursor-blink`, brood ADR-469) and the GUI window blinks the
;; caret on its own clock, restarting it shown on every key, click and caret move — so no
;; turn of the loop runs per toggle and the caret stays solid while you type.

(defdyn *blink-cursor-blinks* 10)
;; How many on/off cycles the caret blinks at rest before it stays solid (Emacs
;; `blink-cursor-blinks`, same default); the window counts them. A model's
;; `:blink-cursor-blinks` (the init file's setting, `config`) wins; 0 blinks forever.

(def *diag-debounce-ms* 120)
;; The tutorial's eval-on-type debounce (`:tutor-eval`): a shade slower than the diag
;; beat — each firing round-trips the whole lesson to the sandbox subprocess, so it
;; waits for a real pause, not a fast typist's inter-key gap.
(def *tutor-eval-debounce-ms* 250)
;; The idle beat (`:idle-recompute`) armed after activity settles — Emacs's idle-timer
;; model. It drives everything deferred off the per-key path: the eldoc hint, the advisory
;; type-check, the **minibuffer completion re-rank** for a large source (find-file / M-x —
;; this is the delay you feel narrowing a big list), the diff-hl launch, and the web-mirror
;; push. Kept short so narrowing/eldoc feel responsive; the type-check and diff it also
;; fires are async (spawned tasks) and rope-gated, so a short beat doesn't thrash them.
;; Every one-shot is `:idle?`, and `ui-run` holds an idle timer while a key is down, so a
;; held key never starts the beat: not between repeats, nor before the first. A beat
;; already sliced (`:idle-continue`, an `:every` ticker) still finishes between repeats.

(def *which-key-delay-ms* 500)
;; How long a prefix chord (e.g. C-x) must sit pending before the which-key panel
;; appears (Emacs `which-key-idle-delay`), so a fast chord like C-x C-f doesn't flash
;; it. Armed when a prefix is pending; the `:which-key` timer that follows reveals the panel.

(defdyn *undo-pause-ms* 600)
;; After a typing/deletion command, a quiet this long closes the undo run (sets
;; :undo-break, so the next edit starts a fresh undo group — the Emacs `undo-boundary`
;; on a typing pause). Without it, a plain buffer with no eldoc/diagnostics debounce
;; would never tick mid-session and the whole burst would amalgamate into one undo step.

(defdyn *typing-commands*
  ;; The commands whose consecutive repeats amalgamate into one undo step (a typing /
  ;; deletion run) AND whose settling arms the undo-pause boundary. Shared by `input`
  ;; (amalgamation) and `ed-sync-timers` (the `:undo-pause` timer). `:self-insert` is
  ;; the unbound-printable-key fallback.
  ;; the unbound-printable-key fallback; backspace is the electric one everywhere now
  (list :self-insert
    'commands/cmd-delete-backward 'commands/cmd-electric-backspace 'commands/cmd-delete-char
    ;; the electric bracket keys are typing too, in every buffer now
    'commands/cmd-open-delimiter 'commands/cmd-electric-close 'commands/cmd-close-delimiter))

;; ---- construction -----------------------------------------------------------

(sig ed-log-buffer (-> buffer))
(defn ed-log-buffer (&optional (name "*Messages*"))
  "A fresh log/output buffer named `name` (default `*Messages*`) with undo turned off
— append-only sinks don't want an undo history. `disable-undo` is a recent std/buffer
addition; if the running `nest` predates it the call throws, so we degrade gracefully
(the buffer just keeps an undo history)."
  (let (b (make-buffer "" name))
    (try (disable-undo b) (catch e b))))

;; ---- a tree-sitter mode without its grammar ------------------------------------------
;; A language whose mode is a tree-sitter grammar (`languages/deflanguage`) colours nothing
;; when the grammar is not installed — and the grammar is a separate download. A language
;; that also has a LINE LEXER (shell, JSON, YAML, TOML, Dockerfile) declares it as its
;; fallback: the tree-sitter layer names a second buffer type, `:grammar-fallback {:type
;; :shell-lexer}`, and a buffer stamped while the grammar is missing is typed as that one
;; instead. The choice is per buffer, made when it is stamped, and remade for every pool
;; buffer when a grammar arrives (`ed-grammars-arrived`) — so `M-x grammar-install` turns an
;; open lexer-coloured buffer into a parsed one without reopening it.
;;
;; `:above` is a size past which the lexer is the better mode even with the grammar: a
;; held tree costs memory per node, and JSON — machine-written at any size — has a node
;; every few bytes, where a line lexer pays only for the lines on screen.

(defn grammar-ready? (lang)
  "Whether the runtime can parse `lang` — built in, loaded, or declared from a library
(brood ADR-481: a declared grammar loads at its first use). A failed load is not ready."
  (contains? #{:declared :loaded :built-in} (editor/treesit/grammar-status lang)))

(defdyn *grammar-ready?*
  ;; the question `ed-grammar-fallback` asks — a dynvar so a test can ask it of a runtime
  ;; that has every grammar installed, as one with none
  grammar-ready?)

(sig ed-grammar-fallback (buffer -> buffer))
;; check-allow: `init-buffer-layers` (std) answers the buffer it was given, which the checker
;; does not carry through — as for `ed-stamp` below
(check-allow :trusted
  (defn ed-grammar-fallback (buf)
    "`buf` retyped as its mode's line-lexer stand-in when its tree-sitter grammar is not
ready, or it is past the mode's `:above` size; `buf` itself otherwise. The stand-in
remembers the type it stands in for (`:grammar-wanted`), which is how
`ed-grammars-arrived` finds it again."
    (let (fallback (layer-facet buf :grammar-fallback)
          lang (layer-facet buf :ts-lang))
      (if (or (nil? fallback) (nil? lang))
        buf
        (let (above (:above fallback)
              too-big (and above (> (text/length (buffer-rope buf)) above)))
          (if (and (not too-big) (*grammar-ready?* lang))
            buf
            (assoc (init-buffer-layers (set-buffer-type buf (:type fallback)))
              :grammar-wanted (:type buf))))))))

(defn ed-grammars-arrived (m)
  "Every pool buffer standing in for a tree-sitter mode (`ed-grammar-fallback`) retyped as
that mode again, and re-checked — the step after a grammar is installed or reloaded, so an
open buffer is parsed from the next frame on."
  (fold (range (count (:buffers m)))
    m
    (fn (acc i)
      (let (buf (nth (:buffers acc) i)
            wanted (:grammar-wanted buf))
        (if (nil? wanted)
          acc
          (let (retyped (ed-grammar-fallback (init-buffer-layers (set-buffer-type (dissoc buf
                                                                                    :grammar-wanted)
                                                                   wanted))))
            (if (= (:type retyped) (:type buf)) acc (ed-set-buf-at acc i retyped))))))))

(sig ed-stamp (buffer -> buffer))
;; check-allow: `init-buffer-layers` (std) answers the buffer it was given, which the checker
;; does not carry through; the declared buffer is that buffer
(check-allow :trusted
  (defn ed-stamp (buf)
    "Mode-stamp `buf` for the pool: `init-buffer-layers` resolves its type (filename /
`:type` → `text-mode` by default, `brood-mode` for `.blsp`) and seeds its `:layers`.
Use at every buffer-creation site so the mode is set from the first frame (the mode
line reads it, and dispatch composes its keymap). Also gives a *file* buffer its
`:dir` (default-directory = the file's folder) if it has none yet — every buffer
carries a `:dir`; a fileless one inherits it where it's opened (see `ed-open-buffer`)."
    (let (b (ed-grammar-fallback (init-buffer-layers buf)))
      (let (file (buffer-file b))
        (if (and (nil? (:dir b)) file)
          (assoc b :dir (path/dirname file))
          b)))))

(defn ed-pane (idx)
  "A pane payload showing pool buffer `idx`, scrolled to the top, at the window's size (a
zoom — `appearance/zoom-of` — is `:zoom {:px :ratio}` here once Ctrl+wheel sets one)."
  {:buffer idx :top 0})

;; The model's shape, named once (ADR-326). What every command reads is declared; the
;; long tail of per-feature keys (`:dired-dir`, `:lsp-servers`, `:sb-drag`, …) rides on the open
;; shape, and `:view-rows`/`:view-cols` are optional because `ed-update` stamps them on the
;; first event — a freshly `ed-init`ed model has neither.
(deftype diagnostic
  (record &open :line (optional int) :col (optional int) :message (optional string)))

(deftype model
  (record &open
    :buffers (vector buffer)
    :layout map
    :kill-ring list
    :echo string
    :profile keyword
    ;; `:status` is `dissoc`ed by a save and `:done` is only ever set at quit — both ABSENT
    ;; most of the time, which the runtime contract (ADR-380, on by default under
    ;; `nest test`) held against every function declared over `model` until they were
    ;; declared optional. The checker reads absence as nil and never minded.
    :status (optional string)
    :done (optional bool)
    :timers map
    :view-rows (optional int)
    :view-cols (optional int)
    ;; per-feature state a command reads back with arithmetic — declared here so the
    ;; read is typed at its one producer rather than guessed at every consumer
    :cycle-spacing (optional (record &open :orig (optional (record &open :text string :offset int))))
    ;; C-n / C-p's goal column (`commands/ed-line-move`), live while point is where they left it
    :line-goal (optional (record &open :column int :point int :buffer any))
    :diagnostics (optional (seqable diagnostic)) ; the LSP path stores a vector
    :diag-by-line (optional (map int (list diagnostic))) ; `ed-diag-index` of `:diagnostics` — set with it, read per visible line
    :query-replace (optional (record &open :match (or nil int) :from string :to string :count int))
    :completion (optional (record &open :items list :index int))
    :compile-errors (optional (or nil (list (record &open :file string :line int))))
    ;; the hosted-buffer slots (`hosted`, `collab`): a pool index -> its link + presence
    ;; keys; `:cursors` is `pid -> char offset`, read back with arithmetic by the view
    :hosted (optional (map int (record &open :cursors (optional (map any int)))))
    ;; a text-selection drag in progress (`panes/ed-drag-text`): the press-time pane
    ;; geometry, read back as a pane's rect and cell ratio — the buffer index is what every
    ;; reader needs (a release copies the region), the geometry what the drag itself does
    :text-drag (optional (record &open :buf int :rect (optional rect) :ratio (optional vector)))
    ;; the window's current type setup (`appearance`): the family, its size in px and the
    ;; line height. The window has no getter for these, so the model is where "what am I
    ;; showing right now" lives — Ctrl+wheel reads it to step, and `preset-save` reads it to
    ;; name what you are looking at.
    :appearance (optional (record &open :family keyword :height int :line-height number))))

(sig ed-init (buffer -> model))
(defn ed-init (buf)
  "The starting model: a buffer pool of `buf` (index 0) and an empty `*Messages*`
buffer (index 1), a single pane showing `buf`, an empty kill ring, no
minibuffer/prefix — and its timers already reconciled (`ed-sync-timers`).

That last part is what starts the idle beat. Only an event reconciles the timers, and an
editor at rest has no event to give: the caret blinks in the window, so a window opened and
left alone would park with no timer at all, and the git summary, the diagnostics and the
language server's autostart would wait for the first key."
  (ed-sync-timers
    {:buffers [(ed-stamp buf) (ed-stamp (ed-log-buffer))]
     :layout (pane-single (ed-pane 0))
     :kill-ring ()
     :minibuffer nil
     :pending nil
     :echo ""
     ;; the model-scope keybinding profile (emacs by default); :layers are the profile's
     ;; layers, composed under the buffer's mode layers at dispatch (see keymaps / input).
     :profile :emacs
     :layers (profile-layers :emacs)
     :edit-state nil
     :status (str "editing " (buffer-name buf))
     :done false
     ;; ui-run coalesces a queued input burst into ONE render (std/editor/ui.blsp): the
     ;; editor streams async events into its own mailbox — a test/run feed, collab deltas,
     ;; an LSP/debugger push — so without this a 900-test run would cost ~900 full frames
     ;; and dribble in over seconds after the run finished. Inert in pure `ed-update` tests
     ;; (it only affects the live loop).
     :coalesce-input? true
     ;; the window's X button reaches `ed-update` as `:close` instead of quitting the loop
     ;; outright (std/editor/ui.blsp) — it runs `cmd-quit`, which asks about unsaved work
     ;; first, exactly as C-x C-c does.
     :close-is-input? true
     ;; a turn slower than ui-run's watchdog threshold names what it was folding (brood
     ;; ADR-490): the report comes back as an event and lands in *Messages*, so the next
     ;; stall says what caused it instead of having to be guessed
     :on-slow ed-report-slow
     :timers {}}))

;; ---- the selected pane + its buffer ---------------------------------------
;; A pane's payload is `{:buffer <pool index> :top <scroll> :point <window-local cursor>
;; :mark <window-local mark>}`. Content (the rope, undo, name, file) lives on the pooled
;; buffer and is shared by every pane showing it; **point/mark are per-pane** (Emacs
;; window-point), so two views of the same buffer/file keep independent cursors. `:point`
;; nil means "use the buffer's own point" (a fresh/just-switched pane).
;;
;; THE INVARIANT (point-off-buffer, docs/actor-architecture.md): while a pane shows a
;; buffer, the pane's point is authoritative. The pooled buffer's own `:point` is only
;; its SAVED DEFAULT — consulted exactly when a pane's `:point` is nil (`ed-show-index`
;; clears it on a switch), maintained by `ed-set-buf`'s copy-back. Nothing else may read
;; a pooled buffer's `:point`; content folds from a hosted buffer's process
;; (`hosted/hosted-apply-content`) replace pool content and touch no pane's point.
;; Guarded by tests/window_point_test.blsp ("the saved-default invariant").

(sig ed-with-window-point (buffer (or nil int) (or nil int) -> buffer))
(defn ed-with-window-point (buf point mark)
  "`buf` with its cursor made **window-local**: pane `point`/`mark` override the pooled buffer's
(nil `point` keeps the buffer's own), clamped into range so a stale offset — left by an edit in
another view of the same buffer — can't index past EOF and crash the renderer. The one seam that
decouples the cursor from the shared buffer.

`buf` ITSELF when it already carries that cursor — the common case, since `ed-set-buf`
writes the pane's cursor to the pool too and [[ed-sync-window-point]] does after every
event. That keeps `ed-current-buf` free and identity-stable across the twenty-odd times a
turn asks for it: no map built per call, and a memo keyed on the buffer is a pointer test."
  (if (nil? point)
    buf
    (let (n (buffer-length buf)
          clamped-point (math/max 0 (math/min point n))
          clamped-mark (if (nil? mark) nil (math/max 0 (math/min mark n))))
      (if (and (= clamped-point (:point buf)) (= clamped-mark (:mark buf)))
        buf
        (assoc buf :point clamped-point :mark clamped-mark)))))

(sig ed-current-pane (model -> map))
(defn ed-current-pane (m)
  "The selected pane's payload `{:buffer <pool index> :top <scroll> :point :mark}`."
  ;; std types a payload `any` (a pane carries whatever its app puts there), so the
  ;; guard is what makes bedit's map a map to the checker — the one place this is
  ;; asked, since every other reader goes through here
  (let (payload (pane-selected-payload (:layout m)))
    (if (map? payload) payload {})))

(sig ed-current-index (model -> int))
(defn ed-current-index (m)
  "The pool index of the buffer shown in the selected pane."
  ;; `:buffer` is the pool index every pane is made with (`ed-pane`); 0 is the scratch
  ;; slot, which is the only sane answer for a payload that has lost it
  (let (i (:buffer (ed-current-pane m)))
    (if (int? i) i 0)))

(sig ed-current-buf (model -> buffer))
(defn ed-current-buf (m)
  "The buffer being edited — the selected pane's pooled buffer (`ed-buf-at`, which carries
the pool invariant), carrying that pane's **window-local** cursor (`ed-with-window-point`)
so each view of a shared buffer keeps its own point/mark."
  (let (pane (ed-current-pane m))
    (ed-with-window-point (ed-buf-at m (:buffer pane)) (:point pane) (:mark pane))))
(sig ed-current-top (map -> int))
(defn ed-current-top (m)
  "The selected pane's scroll offset (0-based first visible line). Together with
`(:view-rows m)` and `(:view-cols m)` — stored by `ed-update` every tick — these
three values define the current viewport and are the standard way for commands to reason
about what is on screen (e.g. lazy diff loading, paging, centring point)."
  (let (top (:top (ed-current-pane m)))
    (if (int? top) (math/max 0 top) 0)))

(sig payload-top-row (any int -> int))
(defn payload-top-row (payload top)
  "The screen row of line `top` a pane payload starts on — its `:top-row`, stored as
`[line row]` and counting only while `line` is still the pane's top. A pane in a wrapped
buffer can start part-way down a long line (Emacs's window-start is a screen line, so it
scrolls by rows); every other pane starts on its top line's first row. Storing the line
with the row is what keeps a writer that sets `:top` alone (a page scroll, a buffer switch,
the wheel) from inheriting an offset into a line it never meant. Not clamped to the line's
rows: that needs the pane's width (`panes/ed-pane-top-row`, `scroll/ed-current-start`)."
  (let (top-row (get payload :top-row)
        row (when (and (vector? top-row) (= (count top-row) 2) (= (first top-row) top))
              (second top-row)))
    ;; the payload is `any` (editor/pane): the guard is what makes the row an int
    (if (and (int? row) (> row 0)) row 0)))

(sig ed-current-top-row (map -> int))
(defn ed-current-top-row (m)
  "The selected pane's starting row within its top line ([[payload-top-row]]): 0 unless a
wrapped pane scrolled part-way into a long line."
  (payload-top-row (ed-current-pane m) (ed-current-top m)))

(sig ed-buf-at (model int -> buffer))
;; check-allow: `nth` answers `nil | buffer` and the pool invariant (a pane's index is always
;; valid — `ed-kill`/`ed-select` keep it so) is what makes the declared `buffer` honest.
(check-allow :type-mismatch
  (defn ed-buf-at (m i)
    "The pool buffer at index `i` (what a pane's `:buffer` payload references)."
    (nth (:buffers m) i)))

;; ---- whether any terminal is open, asked without terminal.blsp ------------------
;; Three always-loaded callers have work to hand a terminal (the mouse fold, a window
;; resize, a theme switch) and ask this first, so a session with no terminal never calls
;; into `src/terminal.blsp`. The `unbound symbol: term/term-sync-sizes` these guards were
;; written against (2026-09-22) was blamed on the module loading late; the cause was its
;; NAME. It was called `term`, std ships a `term` module, and a qualified `term/…` resolved
;; to std's, which has no such function. Renamed `terminal` on 2026-10-18; it now loads
;; with `main` (keymaps and the C-x p menu name its commands).

(sig ed-terminals? (model -> bool))
(defn ed-terminals? (m)
  "Whether any pooled buffer is a terminal — asked before handing a terminal work, so a
session that never opened one never calls into `terminal.blsp`."
  (any? (:buffers m) (fn (b) (= (:type b) :term))))

(defn ed-buf-mode-name (buf)
  "The mode to show for `buf`: the name of its highest-precedence active layer that
isn't a `:system` layer (so the always-on `global` layer is skipped — you see
`brood` on a `.blsp` buffer, `text` otherwise). `\"\"` if there's no non-system layer."
  (let (hit (seq/find (active-layers buf) (fn (l) (not (:system l)))))
    (if hit (->string (:name hit)) "")))

(sig ed-set-mode (model any -> model))
(defn ed-set-mode (m type)
  "Switch the current buffer's major mode to `type` (e.g. `:fundamental`, `:brood`):
`set-buffer-type` pins `:type` so `buffer-type-for` honours the explicit choice over
the filename, then `init-buffer-layers` re-seeds the full layer stack — and a parsed mode
whose grammar is missing stands in with its line lexer (`ed-grammar-fallback`)."
  (ed-set-buf m
    (ed-grammar-fallback (init-buffer-layers (set-buffer-type (ed-current-buf m) type)))))

(defn ed-active-mode-commands (buf)
  "The `:commands` lists from `buf`'s active layers, collected highest-precedence
first. Each list holds the M-x names the layer claims as mode-specific."
  (layer-collect buf :commands))

;; Every M-x open asks for the layer-owned names, and walking every type's layer list
;; resolved each reference once per TYPE that names it — 169 `reflect/eval`s for ~45
;; distinct layers, ~1 ms. The distinct references are a function of the two registries
;; alone, which are the very maps stored until something registers (so `defmemo`'s `=` is
;; immediate on them); the layers themselves are still resolved per call below, so a layer
;; redefined live is seen on the next M-x.
(memo/defmemo ed-distinct-layer-refs
  1
  (type-layers system-layers)
  "Every distinct layer reference in the `type-layers` registry and the `system-layers`
list, each once."
  (seq/distinct (append (apply append (vals type-layers)) system-layers)))

;; …and the names themselves, memoised on the layers' own `:commands` lists. Those are the
;; values stored on each layer, so an unchanged layer set compares element-by-identity, and
;; the answer is the SAME list object until a layer changes — which is what lets M-x key its
;; own memo on this result cheaply (`commands/ed-mx-command-names`).
(memo/defmemo ed-layer-command-names
  1
  (command-lists)
  "The names in every one of `command-lists`, appended."
  (apply append command-lists))

(defn ed-all-layer-commands ()
  "All command names claimed by any registered layer (all types + system layers) —
used to subtract layer-owned names from the global M-x set."
  (ed-layer-command-names (layer-collect {:layers (ed-distinct-layer-refs *type-layers*
                                                    *system-layers*)}
                            :commands)))

(defn ed-mode-service (buf facet)
  "The value the buffer's active mode provides for `facet` — from the
highest-precedence active layer that defines it (`layer-facet`, which stops there), resolved late
(`reflect/eval`) if stored as a fn *symbol*, else nil when no layer offers it. The generic
per-language services hook: the view and completion ask the buffer's mode for
`:fontify` / `:bracket-match` / `:eldoc` / `:complete-at` *without naming any
language*, so a new mode (json, python, …) is the same registration with its own
functions. `brood-mode` is the first to supply these (see `modes`)."
  (let (v (layer-facet buf facet))
    (if (symbol? v) (reflect/eval v) v)))

(defn gutter-cell-chunks (cell)
  "A `:gutter-cell` service result normalised to a **list of `[text face]` chunks**. The
service may return either a single `[text face]` pair (a plain line number) or a list of such
chunks (a file buffer's diff-hl change bar *plus* the number — see `gutter/line-number-cell`).
Decoding that two-forms shape used to live in each renderer separately, so the web mirror
assumed the single form and crashed on the list — silently dropping the browser the moment you
opened a file buffer. This is the single decoder both the native view (`view/ed-gutter-line-ops`)
and the web mirror (`web/web-gutter-html`) share, so the two can never drift apart again."
  (if (string? (first cell)) (list cell) cell))

;; ---- pure text geometry (offset → line/column) ------------------------------
;; Shared by the indenters (brood-mode, lisp-modes) and the indent command (src/commands.blsp):
;; a char offset's line start, line end and column, from the text alone so they're testable
;; without a buffer. The text is a string or a rope (brood ADR-488): a Lisp indenter is handed
;; the buffer's rope and reads only the lines it measures. A line ends at `\n` alone — not at
;; the form feed or lone CR the rope's line index also breaks at, which an elisp file's `^L`
;; page breaks would otherwise turn into line ends.

(sig ed-line-start-offset ((or string rope) int -> int))
(defn ed-line-start-offset (text off)
  "The offset of the start of the line containing char offset `off` — just after
the previous newline (0 at the first line)."
  (if (rope? text) (text/skip-backward text off "\n" false) (ed-string-line-start text off)))

(defn- ed-string-line-start (text:string off:int -> int)
  ;; tail-recursive walk back to the previous newline
  (if (or (<= off 0) (= (string/char-at text (dec off)) "\n"))
    off
    (ed-string-line-start text (dec off))))

(sig ed-line-end-offset ((or string rope) int -> int))
(defn ed-line-end-offset (text off)
  "The offset of the newline ending the line containing char offset `off`, or the end of
`text` on its last line."
  (if (rope? text)
    (text/skip-forward text off "\n" false)
    (let (newline (index-of text "\n" off)) (if (< newline 0) (string/length text) newline))))

(defn ed-column-at (text off)
  "The 0-based column of char offset `off` in `text` (chars since the line start)."
  (- off (ed-line-start-offset text off)))

;; ---- what an edit changed, from the buffer's splice log -----------------------------
;; A cache kept against an older rope of a buffer (a line band, the completion word index,
;; the fold set) wants to know what changed since. Comparing the two ropes answers, at a
;; cost of the whole text; the buffer's splice log (`buffer-splices-since`, brood ADR-466)
;; answers at the cost of the edit. These fold the log into the one changed stretch.

(defn ed-splices-cover (splices)
  "`[lo old-hi new-hi]`: the one stretch `[lo, old-hi)` of the text before `splices`
(`buffer-splices-since`, oldest first, each against the text the one before it left) that
became `[lo, new-hi)` of the text after them — everything outside it unchanged, the part after
it shifted. Nil for no splices. The shape `text/changed-range` answers; the fold is std's
(`editor/buffer/buffer-splices-cover`), the one the buffer's own undo uses.

    (model/ed-splices-cover [[2 4 \"xyz\"] [0 0 \"a\"]])   ;=> [0 4 6]"
  (editor/buffer/buffer-splices-cover splices))
(sig ed-splices-cover (seqable -> (or nil (tuple int int int))))

(defn ed-edit-range (buf old)
  "`[lo old-hi new-hi]`: what changed between rope `old` and `buf`'s text — `[lo, old-hi)` of
`old` became `[lo, new-hi)` of the text now — or nil when nothing did. From the buffer's splice
log ([[ed-splices-cover]]) when it reaches `old`, the edit's own cost; otherwise by comparing
the two texts (`text/changed-range`)."
  (let (splices (buffer-splices-since (assoc buf :rope old) buf))
    (if (nil? splices)
      (text/changed-range old (buffer-rope buf))
      (ed-splices-cover splices))))

;; ---- the diagnostics cache: what the view reads, whoever produced it ----------
;; Two producers fill it — the advisory checker (`diagcheck`, off the loop on the idle beat)
;; and a language server (`lsp-commands`, on `publishDiagnostics`) — and both land in
;; [[ed-set-diagnostics]], so the list, its line index and the buffer's margin stamp agree.

(sig ed-diag-index ((seqable diagnostic) -> (map int (list diagnostic))))
;; ---- a diagnostic's position, converted in ONE place --------------------------------
;; A diagnostic carries 1-BASED `:line` and `:col` — the Brood checker emits them that way
;; and `lsp/lsp-diagnostic` shifts a server's 0-based range to match. Everything that
;; PLACES one works in 0-based buffer coordinates, so the conversion happens at every
;; crossing: the line index, the token underline, the `*Diagnostics*` row, the row's jump
;; target. Four `dec`/`inc`s written out four times, and the one that was written without a
;; floor turned a `:col 0` into column -1 and took the whole frame down with a
;; `string/substring: range [-1, 0)` — a render error, every frame, for one odd number from
;; a language server.
;;
;; Data from a server is data: it is clamped here rather than trusted, and it is clamped
;; once.

(defn ed-diag-line0 (d)
  "A diagnostic's 0-based line, or nil when it names none (which is what makes it
unplaceable — see [[ed-diag-index]])."
  (let (ln (:line d)) (when (int? ln) (math/max 0 (dec ln)))))

(defn ed-diag-col0 (d)
  "A diagnostic's 0-based column, floored at 0. A missing or out-of-range column means the
start of the line, which is where a finding about a whole line belongs anyway."
  (let (c (:col d)) (if (int? c) (math/max 0 (dec c)) 0)))

(defn ed-diag-line1 (line0)
  "The 1-based line number a reader sees, from a 0-based one — [[ed-diag-line0]]'s inverse,
named so the two sides of the convention are stated together rather than as two bare
arithmetic ops in different files."
  (inc line0))

(defn ed-diag-index (diags)
  "`diags` (`{:line :col :message}`, 1-based lines) as `{0-based line -> (the diagnostics
on it, in order)}` — the shape the view reads. Built ONCE, when a check's result lands
(`ed-set-diagnostics`), because every reader is per frame and per VISIBLE line: the token
underlines, the ⚠ end-of-line notes, the echo row's message. Read as a list per frame, a
large file's checker output made the view O(all diagnostics) on every cursor blink —
2,547 findings cost 135 ms a frame where the same frame without them cost 2.6. A
diagnostic with no `:line` cannot be placed and is left out — of this index, and so of
everything derived from it: the margin mark, the `*Diagnostics*` row and the mode line's
count all read THIS, not the raw list, so that they cannot disagree with each other. An
unplaceable finding is therefore invisible, which is the price of having one answer; every
producer bedit has (the checker, every language server) gives a line."
  ;; Consed onto each line's list from the LAST finding back, so every list comes out in
  ;; order with no `append` — which rebuilt the line's list per finding, and made this fold
  ;; most of what a language server's publish cost on the loop.
  (fold (reverse diags)
    {}
    (fn (acc d)
      (let (ln (ed-diag-line0 d))
        (if (nil? ln)
          acc
          (assoc acc ln (cons d (get acc ln '()))))))))

(defn ed-call-deferred (m sym fallback)
  "Call `sym` — a `(model) -> model` hook in a DEFERRED module — if that module has been
loaded, else answer `fallback`. The one guard every such call shares: a module nobody has
opened yet is not a client, and asking it anything is an unbound symbol."
  (reflect/call-if-bound sym fallback m))

;; `(seqable diagnostic)`, not `(list …)`: the LSP path hands over a VECTOR, which the
;; runtime contract (ADR-380) refused.
(sig ed-set-diagnostics (model (seqable diagnostic) any &optional (or nil string) -> model))
(defn ed-set-diagnostics (m diags rope &optional (for-buffer nil))
  "The model with `diags` as its diagnostics cache, computed for `rope` (`:diag-rope`, the
staleness key) — and indexed by line (`:diag-by-line`, `ed-diag-index`). The ONE setter,
so the list and its index cannot disagree: both check paths (`ed-refresh-diagnostics`,
`ed-apply-diag`) land here.

The index is also stamped on the BUFFER, as the `:diagnostic-lines` annotation. That is
what puts findings in the margin: every other mark there (a breakpoint, a test verdict, a
result note) is a buffer annotation, and the gutter's cell cache is keyed on the buffer, so
model state simply cannot reach it. Going through `annotate` also buys the currency std
already owns — a finding dims while the text differs from the text that produced it, and
blanks once the lines have shifted under it.

`for-buffer` names the buffer the findings are ABOUT — nil for the synchronous path, which
is always the current one. The stamp is gated on THAT and not on the rope, and the
difference is a bug that was here: a check runs in a task, so its reply lands whenever it
lands, and the rope has usually moved on by then because you kept typing. Gating on the
rope threw those replies away — including the one that says \"clean now\", so errors you had
already fixed stayed in the margin and on the mode line until some later check happened to
land on an untouched buffer. Buffer identity is the question actually being asked (\"are
these findings about this buffer?\"); how far the text has moved since is `annotate`'s, and
it answers it by dimming."
  (let (buf (ed-current-buf m)
        mine? (= (or for-buffer (buffer-name buf)) (buffer-name buf))
        index (ed-without-quiet-lines (ed-diag-index diags) (when mine? (:quiet-lines buf)))
        m1 (assoc m :diagnostics diags :diag-rope rope :diag-by-line index))
    (if mine? (ed-set-buf m1 (editor/buffer/annotate buf :diagnostic-lines index)) m1)))

(defn ed-without-quiet-lines (index quiet)
  "The line index `index` without the lines of `quiet` — a buffer's `:quiet-lines`, the
0-based `[from to]` of the form you are typing in a live buffer (`playground-core`'s quiet
window), or nil for none.

A finding about text still being typed is a finding about typing: `(dbl` checked mid-word is
`does not compile`, and it would sit in the margin and under the word until the next check.
Left out of the INDEX, not the list, so `:diagnostics` keeps every finding and the window
closing re-indexes it ([[ed-set-diagnostics]] again) with nothing to re-check."
  (if (nil? quiet)
    index
    (let ([from to] quiet)
      (into {}
        (seq/reject index (fn (kv) (let (line (first kv)) (and (>= line from) (<= line to)))))))))

(sig ed-stamp-diagnostics-at (model int (seqable diagnostic) -> model))
(defn ed-stamp-diagnostics-at (m i diags)
  "Stamp `diags` as pool buffer `i`'s `:diagnostic-lines` annotation, whether or not that
buffer is on screen — the margin marks and inline notes for a file you are not looking at.

The model's `:diagnostics` cache is deliberately about the buffer you ARE looking at (one
list, one view). The buffer ANNOTATION is not: it belongs to the buffer, and a server
publishing about a background file — including publishing that it is CLEAN now — must
reach it. Dropping those was a real bug and an unfalsifiable-looking one: a diagnostic
from a half-typed moment would stamp itself while you were in the file, and the `[]` that
retracted it a second later arrived after you had moved to another pane and was thrown
away. The mark then outlived the text it described, with nothing able to clear it."
  ;; `ed-buf-at` answers a buffer for an in-range index, and the caller found `i` with
  ;; `ed-buffer-index-by-file`, so there is one to stamp
  (update m
    :buffers assoc
    i
    (editor/buffer/annotate (ed-buf-at m i) :diagnostic-lines (ed-diag-index diags))))

(defn ed-buffer-dir (buf)
  "The directory `buf` lives in — its `:dir`, else its file's folder, else the working
dir — what `pool/ed-default-dir` answers for the current buffer (Emacs `default-directory`)."
  (or (:dir buf)
    (let (f (buffer-file buf)) (if (nil? f) (file/cwd) (path/dirname f)))))

(defn ed-layer-modeline-segments (m buf)
  "The status-bar segments `buf`'s active layers contribute via a `:modeline` service — each a
`(model buf) -> string|nil` (resolved late, like every mode service). The seam a mode / layer
uses to put its own info on the status bar (the git layer, a REPL connection, …); blanks and
nils are dropped. The view appends these (and the global git branch) on the selected pane."
  (seq/keep (layer-collect buf :modeline)
    (fn (svc)
      (let (f (if (symbol? svc) (reflect/eval svc) svc)
            s (f m buf))
        (if (or (nil? s) (= "" s)) nil s)))))

;; ---- the off-loop job table: what is in flight, and what to call it ----------
;; It lives in `model` rather than in the dispatcher because it is MODEL vocabulary —
;; which model field holds which handle — and two very different readers need it: the
;; dispatcher (`input/ed-ev-task-reply`, to route a reply) and the view (the activity
;; segment, to say what is running). `view` cannot reach into `input`: input already
;; `(:use view)` for the mode-line hit-tests, so the reverse is a CYCLE, and a cycle here
;; does not fail loudly — it leaves a half-initialised module and breaks something else
;; entirely. (It broke the `:on-move` facet, which is nowhere near any of this.)
;; How an off-the-loop job is declared. The table is keyed by the model field a launch parks
;; its task handle on -> `[fold-fn failure-value label]`: the function that folds the answer
;; in, what to fold instead when the task errored or timed out, and the LABEL the activity
;; indicator shows while it is in flight (nil for one not worth announcing). Folds are
;; SYMBOLS resolved at dispatch (`reflect/eval`), like the event handlers and for the same
;; reason — redefining a fold hot-swaps it.
;;
;; A TABLE, because every row was the same three lines of `cond` with two words changed.
;; Adding an off-the-loop recompute is a launch, a fold and a row — the branch it used to
;; also need was pure ceremony, and the sixth copy of it is how a default gets forgotten.
;;
;; Every row is REGISTERED by the module that runs the job, when it loads
;; ([[register-task-reply]]) — the diagnostics check, the diff-hl gutter, eldoc and the
;; tree warm included. A task can only be running once the module that started it has
;; loaded, so that is exactly when its row is first needed, and the model names none of
;; the features that happen to work off the loop (X4).

;; Which jobs get a label, and why the rest do not: eldoc, the diagnostics check, the
;; diff-hl gutter, the status-bar git summary and the tree warm all finish inside a frame
;; or two and fire on the IDLE BEAT, i.e. constantly while you work. A chip that flickers
;; on every keystroke is worse than no chip — it trains you to ignore the one place the
;; editor tells you something is happening. Labelled are the jobs that can take seconds
;; and that you asked for: a pull, a fetch, a status on a big repo, a shell command, a
;; project scan.

;; Every table in this section is a `std/registry` (brood ADR-412), not a `defonce` global
;; re-bound with `def`: a registration is one atomic write (two processes registering at once
;; both land), it survives an `%isolate` restore, and the startup image carries it with the
;; module that made it. A `def`-rebound global had none of the three.

;; What C-g does to a job is ALSO on its row, for the same reason the fold is: the
;; universal cancel used to name the four jobs it killed (and the `-checking` flags each
;; kept beside its handle), so every feature that worked off the loop was a line in
;; `commands`, and one that forgot to add itself (the shell command) was quietly
;; uncancellable. A row opts in with `:cancel-on-quit?` and may name an `:on-quit` hook
;; for the clean-up its feature alone knows (a re-stamped gutter, a cleared rope); the
;; cancel itself — kill the task, free the slot — is the same for every job, so it lives
;; once, in [[ed-cancel-quit-jobs]].
;;
;; Not every job opts in. A git operation half-killed can leave a lock or a half-applied
;; rebase; a format job rewrites the buffer when it lands; the status-bar summary and the
;; tree warm are upkeep nobody is waiting on. C-g is for the work you would want to stop.

(defn register-task-reply (slot fold failure label &optional (options {}))
  "Declare an off-the-loop job a feature runs: the model field `slot` its task handle is
parked on, the `fold` symbol that folds the answer in, what to fold instead when the task
errored or timed out (`failure`), and the activity `label` to show while it runs (nil for a
job not worth announcing). Called at the feature's load; re-registering replaces the row.

`options` (a map, all optional):
- `:cancel-on-quit?` — C-g kills the task in flight and frees `slot`
- `:on-quit` — a `(model) -> model` symbol C-g runs after, for the feature's own clean-up
- `:folds-event?` — the fold receives the whole `[:task-… handle …]` event instead of the
  value or `failure`, for a job whose report depends on HOW it failed (a timeout vs an error)"
  (registry/put! :model/task-replies slot [fold failure label options]))

(defn ed-task-reply-table ()
  "Every off-the-loop job's row — slot -> `[fold failure label options]` — as the modules
running them registered them. What the reply dispatcher, the activity indicator and C-g read."
  (registry/entries :model/task-replies))

(defn ed-cancel-quit-jobs (m)
  "`[model cancelled?]`: every registered job that opted into `:cancel-on-quit?` and is in
flight, killed (`task/cancel` — a hard kill, so a runaway loop dies too), its slot freed and
its `:on-quit` hook run; `cancelled?` says whether there was any. A hook whose module is not
loaded is skipped (`ed-call-deferred`) — the slot is still freed, which is all a reply needs
to be dropped as stale. What C-g runs, naming none of the jobs."
  (fold (%map-pairs (ed-task-reply-table))
    [m false]
    (fn (acc entry)
      (let ([model cancelled?] acc
            [slot row] entry
            options (nth row 3 {})
            handle (get model slot))
        (if (and (:cancel-on-quit? options) (not (nil? handle)))
          (let (_ (task/cancel handle)
                hook (:on-quit options)
                freed (dissoc model slot))
            [(if hook (ed-call-deferred freed hook freed) freed) true])
          acc)))))

;; ---- inbound `[:tag …]` events a feature handles ------------------------------
;; The dispatcher (`input`) owns the handlers for the events the loop itself is the
;; consumer of — output, task replies, resize, mouse. A FEATURE's events (a language
;; server's replies, another frame's buffer registry) are registered by the feature when it
;; loads, so the dispatcher's table names none of them. Safe because each such event is only
;; ever produced by something that feature started: no `:lsp-…` reply before `lsp-commands`
;; has started a server, no `:registry-…` before `frames` watched the registry.

(defn register-event-handler (tag handler)
  "Route inbound `[tag …]` events to `handler` — a symbol naming a `(m input textrows cols
rows) -> model` fold, resolved at dispatch so a redefinition hot-swaps. Called when the
feature's module loads; re-registering a tag replaces its handler."
  (registry/put! :model/event-handlers tag handler))

(defn ed-registered-event-handler (tag)
  "The handler symbol a feature registered for `[tag …]` events, or nil."
  (registry/lookup :model/event-handlers tag))

(defn register-down-handler (name handler)
  "When a process the editor monitors dies and it backs no pool slot, offer it to `handler`
— a symbol naming a `(m pid reason) -> model` fold that returns `m` unchanged for a pid that
is not its own. A feature that keeps processes on the model (a language server's
connection) registers one when its module loads, so it hears of a death the moment it
happens rather than on the next request that would have gone to it."
  (registry/put! :model/down-handlers name handler))

(defn ed-run-down-handlers (m pid reason)
  "Every registered down handler offered the dead `pid` in turn ([[register-down-handler]])."
  (fold (vals (registry/entries :model/down-handlers))
    m
    (fn (acc handler) (reflect/call-if-bound handler acc acc pid reason))))

;; ---- the idle beat's jobs ------------------------------------------------------
;; The `:idle-recompute` beat (Emacs's idle timer) runs everything deferred off the per-key
;; path: the completion preview, the LSP autostart + text push + signature hint, eldoc, the
;; advisory check, the minibuffer re-rank, the diff-hl gutter, the tree warm, the git
;; summary, auto-save + auto-revert, the mode's `:on-idle` hooks and the web-mirror push.
;; Each is a ROW its module registers at load ([[register-idle-job]]) — the arming side
;; (`ed-sync-timers`) and the firing side (`input/ed-timer-fire`) fold over the table and
;; name none of them, and a deferred module's job simply is not a job until it has loaded
;; (what the `bound?` guards used to say one call at a time).
;;
;; A row is `{:order :run :stale?}`:
;;   :order   the position in the chain. ORDER MATTERS — a job sees the model every earlier
;;            one left: the LSP push must follow the autostart that connects it, the
;;            signature ask follows eldoc (which owns the slot when the mode answers), and
;;            the web mirror publishes last, a snapshot of everything the beat changed.
;;            Kept explicit rather than load order, which differs between a test image and
;;            the released editor.
;;   :run     `(model) -> model` symbol — what the beat does. Runs on every firing (a launch
;;            gates itself on its own staleness and in-flight handle).
;;   :stale?  optional `(model) -> bool` symbol — whether this job's work is pending, which
;;            is what ARMS the beat. A job without one rides a beat something else armed.

(defn register-idle-job (name job)
  "Add an idle-beat job `name` — `{:order :run :stale?}`, the
hooks as symbols (resolved late, so a redefinition hot-swaps; see the comment above) —
replacing any job already registered under `name`. Called when the job's module loads."
  (registry/put! :model/idle-jobs name (assoc job :name name :rank (:order job))))

(defn ed-idle-jobs ()
  "The registered idle jobs, in `:order` — the order the beat runs them in."
  (map (registry/ranked :model/idle-jobs) second))

(defn ed-idle-due? (m)
  "Whether some idle job has work pending — i.e. the `:idle-recompute` beat should be armed.
A job whose module has not loaded is never due. Asked after every event, and order does not matter to an `any?`, so it
reads the table unsorted."
  (any? (vals (registry/entries :model/idle-jobs))
    (fn (job)
      (let (stale (:stale? job))
        (and (not (nil? stale)) (ed-call-deferred m stale false))))))

(defn ed-run-idle-jobs (m)
  "The `:idle-recompute` beat: every registered job's `:run`, in `:order`, each seeing the
model the previous one left. All of them at once — the headless path (tests, a batch run);
a live loop runs the beat in slices ([[ed-run-idle-slice]])."
  (fold (ed-idle-jobs) m (fn (acc job) (ed-call-deferred acc (:run job) acc))))

(defdyn *idle-slice-ms* 3)
;; How much of ONE loop turn the idle beat may take before it yields. The beat runs a dozen
;; jobs — the LSP push, eldoc, the check's launch, the git summary, auto-save, auto-revert —
;; and run as one turn it cost 6–18 ms on the loop (25 ms in a live window), all of which a
;; key pressed in the middle of it waited out. Sliced, a key waits for one slice: the loop
;; takes queued input before it fires a timer, so the next slice runs after the key.

(sig ed-run-idle-slice (model int -> model))
(defn ed-run-idle-slice (m from)
  "Run the idle beat's jobs from index `from`, in `:order`, until `*idle-slice-ms*` has gone
— at least one job per slice, so the beat always progresses. Unfinished, the model keeps
`:idle-resume` (the next job's index) and the `:idle-continue` ticker that picks it up;
finished, both are gone. Each job still sees the model every earlier one left, across
slices as within one."
  (let (jobs (into [] (ed-idle-jobs))
        deadline (+ (os/now) *idle-slice-ms*))
    (letrec (step (fn (acc i)
                    (cond
                      (>= i (count jobs)) (ed-drop-timer (dissoc acc :idle-resume) :idle-continue)
                      (and (> i from) (>= (os/now) deadline))
                        (ed-set-timer (assoc acc :idle-resume i) :idle-continue {:every 1})
                      else (step (ed-call-deferred acc (:run (nth jobs i)) acc) (inc i)))))
      (step m from))))

(defn ed-activity (m)
  "The labels of every announced job currently in flight — what the activity indicator
shows. `()` when the editor is idle or only doing its own upkeep."
  (seq/keep (%map-pairs (ed-task-reply-table))
    (fn ([slot row])
      (let (label (nth row 2 nil))
        (if (and label (not (nil? (get m slot)))) label nil)))))

(defn ed-busy? (m)
  (not (empty? (ed-activity m))))
;; ---- named timers (ADR-102): the model declares time-driven work as `:timers` ----
;; `ed-sync-timers` reconciles `:timers` with the model state after each event (the
;; declarative replacement for the old "shorten :tick-ms" arming cascade); the per-timer
;; firing is dispatched in `input/ed-timer-fire`. `ed-set-timer`/`ed-drop-timer` are the
;; imperative pair, for a timer whose arming is not a function of the model (the idle
;; beat's continuation, `:idle-continue`).

(sig ed-set-timer (model keyword map -> model))
(defn ed-set-timer (m name spec)
  "Add or replace the `:timers` entry `name` with `spec` (a `{:every ms}`/`{:after ms}`
map, optionally `:idle? true`). See ADR-102."
  (map/assoc-in m [:timers name] spec))

(sig ed-drop-timer (model keyword -> model))
(defn ed-drop-timer (m name)
  "Remove the `:timers` entry `name` (a no-op if absent)."
  (assoc m :timers (dissoc (or (:timers m) {}) name)))

(defn ed-real-input? (input)
  "True if `input` is direct user input — a key or a mouse event — as opposed to a timer
firing (`[:timer …]`), a focus change, or an async system event (`[:task-done …]` …).
Real input marks the web mirror dirty and breaks a collab follow; a timer, a focus change
or an async event does neither."
  (cond
    (= input :blur) false
    (= input :focus-in) false
    (record? input) false ; a UiEvent record — async, never a keystroke (a 30ms spy
    ; flush must not dirty the web mirror)
    ;; a mouse event, and text an input method committed or is composing (ADR-441)
    (vector? input) (any? [:mouse :text :preedit] (fn (tag) (= (first input) tag)))
    else true))

(sig ed-blink-count (model -> int))
(defn ed-blink-count (m)
  "How many times the caret blinks at rest before it stays solid: the model's
`:blink-cursor-blinks` (the init setting) or [[*blink-cursor-blinks*]]; 0 blinks forever, and
so does a value that is not a count."
  (let (limit (or (:blink-cursor-blinks m) *blink-cursor-blinks*))
    (if (and (int? limit) (> limit 0)) limit 0)))

(sig ed-sync-timers (model -> model))

(sig ed-buffer-displayed? (model string -> bool))
(defn ed-buffer-displayed? (m nm)
  "Whether the buffer named `nm` is showing in some pane right now — ON SCREEN, not merely
open in the pool (`ed-buffer-index-by-name`, which a buried buffer also satisfies).

The distinction is what makes a self-refreshing buffer affordable: work done for a buffer
nobody can see is work the reader is paying for and will never look at, and a refresh that
fires anyway is also a refresh that can steal the pane it is drawn into. Anything on a
timer asks this first."
  (let (idx (ed-buffer-index-by-name m nm))
    (and (not (nil? idx))
      (any? (pane-leaf-paths (:layout m))
        (fn (path) (= idx (:buffer (pane-payload-at (:layout m) path))))))))

;; A pane resting between lines (a trackpad glide's fraction) snaps onto a whole line on the
;; `:scroll-settle` idle one-shot, armed while one holds a fraction — `scroll/ed-settle-scroll`.
(def *scroll-settle-ms* 100) ; quiet time after the last scroll delta before the settle ease
(def *scroll-glide-ms* 16) ; one frame of that ease (`scroll/ed-glide-scroll-step`)
(defn ed-any-pane-fractional? (m)
  "True when some pane rests between lines (`:scroll-frac` ≠ 0)."
  (any? (pane-leaf-paths (:layout m))
    (fn (path) (> (or (:scroll-frac (pane-payload-at (:layout m) path)) 0.0) 0.001))))

;; ---- the live-evaluating buffers ---------------------------------------------
;; A buffer that runs as you type — the tutorial's lesson boxes, the Brood playground,
;; the Elixir playground — is three hooks and a timer, and the three are identical in
;; shape for every one of them:
;;
;;   :stale?    O(1) — has this buffer moved since its last launch?  (arms the timer)
;;   :launch    the debounce landed: re-evaluate what the edit could have changed
;;   :reanchor  the keystroke itself: move the existing notes with the text
;;
;; A TABLE rather than three hardcoded pairs, because there were two and now there are
;; three, and the second language was the moment the copy-paste became the design. The
;; timer names differ so each buffer's debounce arms and fires on its own; everything else
;; is the same fold. Each client REGISTERS itself when its module loads
;; ([[register-live-eval-client]]): every one of these modules is deferred-loaded, and an
;; unopened playground is not a client until then — the model need not name them (X4).
(defn register-live-eval-client (client)
  "Add a live-evaluating buffer — `{:timer :stale? :launch :reanchor}`, the hooks as
symbols (resolved late, so a redefinition hot-swaps) — replacing any client registered
under the same `:timer`. Called when the client's module loads."
  (registry/put! :model/live-eval-clients (:timer client) client))

(defn ed-live-eval-clients ()
  "Every registered live-evaluating buffer, in a stable order (by timer name)."
  (map (registry/ranked :model/live-eval-clients) second))

;; ---- timers a feature arms ----------------------------------------------------
;; A repeating timer a feature wants while it has work: git's background upstream watch
;; (fires while you are working, so you hear about a remote that moved without asking), a
;; BEAM view's refresh (while one is on screen). Registered by the feature
;; ([[register-timer-client]]), so neither the arming here nor the firing in `input` names
;; the module.

(defn register-timer-client (name spec fire)
  "A feature's timer: `spec` names a `(model) -> timer spec or nil` function — `{:every ms}`
while the feature wants the timer, nil while it does not — and `fire` the `(model) -> model`
it runs when the timer goes off. Called when the feature's module loads."
  (registry/put! :model/timer-clients name {:spec spec :fire fire}))

(defn ed-timer-clients ()
  "Timer name -> `{:spec sym :fire sym}`, as the features registered them."
  (registry/entries :model/timer-clients))

(defn- ed-live-eval-call (m sym fallback)
  ;; A live-eval client's hook, through the shared deferred-call guard.
  (ed-call-deferred m sym fallback))

(defn ed-live-eval-stale? (m client)
  "Has `client`'s buffer moved since its last launch — i.e. should its debounce be armed?
False for a client whose module has never been loaded, which is every one of them until
somebody opens the buffer."
  (ed-live-eval-call m (:stale? client) false))

(defn ed-live-eval-launch (m timer)
  "Run the launch of whichever live-eval client owns `timer`, or leave `m` alone when no
client does. What `input/ed-timer-fire` calls, so the set of languages that evaluate as
you type is one table and not a chain of `cond` arms."
  (let (client (seq/find (ed-live-eval-clients) (fn (c) (= (:timer c) timer))))
    (if client (ed-live-eval-call m (:launch client) m) m)))

(defn ed-live-eval-reanchor (m)
  "Move every live-evaluating buffer's notes with the text — on the EDIT itself, not the
debounce, since a note is stored with the line it sits on and the whole set hides the
moment the line count changes. O(1) per client until that client's own notes go stale."
  (fold (ed-live-eval-clients) m (fn (acc client) (ed-live-eval-call acc (:reanchor client) acc))))

(defn- ed-idle-one-shots (m)
  "Every managed idle one-shot as `[name delay-ms due?]` — the timer, how long the quiet
before it fires, and whether its work is pending now. Each is armed only while due; listing
the NOT-due ones too is what lets `ed-sync-timers` drop every managed one-shot from one list,
so none can be armed here and forgotten there.

The idle beat is armed while any registered job has work pending ([[ed-idle-due?]]); the
`:idle?` deadline debounces it — a repeating key resets the countdown. A pane resting between
lines snaps once the scroll deltas stop (and not again while that ease runs). Every live-evaluating buffer's eval-on-type debounce
is one timer each, so they arm and fire independently ([[ed-live-eval-clients]]); each is
deferred-loaded — bound?-guarded + late-bound, the keymap idiom — so this core file never
links any of them eagerly."
  (append [[:idle-recompute *diag-debounce-ms* (ed-idle-due? m)]
            [:scroll-settle
              *scroll-settle-ms*
              (and (not (:scroll-gliding m)) (ed-any-pane-fractional? m))]
            [:which-key *which-key-delay-ms* (and (:pending m) (not (:which-key m)))]
            [:undo-pause
              *undo-pause-ms*
              (and (includes? *typing-commands* (:this-command m)) (not (:undo-break m)))]]
    (map (ed-live-eval-clients)
      (fn (client)
        [(:timer client)
          *tutor-eval-debounce-ms*
          (ed-live-eval-stale? m client)]))))

(defn- ed-feature-timers (m)
  "The timers features registered ([[register-timer-client]]) — git's background upstream
watch, the BEAM views' refresh — each asked whether it wants one now: name -> spec."
  (fold (ed-timer-clients)
    {}
    (fn (acc [name client])
      (let (spec (ed-call-deferred m (:spec client) nil))
        (if spec (assoc acc name spec) acc)))))

(defn ed-sync-timers (m)
  "Reconcile `:timers` (ADR-102) with the model after each event — the declarative
replacement for the old arm-the-tick cascade. The
idle one-shots — eldoc/diagnostics debounce (`:idle-recompute`), the which-key reveal
delay, the undo-pause boundary — are present only while their work is pending
(`ed-idle-one-shots`). Also clears the
`:which-key` reveal flag once no prefix is pending (what `ed-which-key-arm` used to do)."
  (let (m (if (:pending m) m (dissoc m :which-key))
        one-shots (ed-idle-one-shots m)
        managed (merge
                  ;; The spinner frame, ticking ONLY while an announced job is in flight. A
                  ;; timer armed unconditionally is an editor that never goes idle — this one
                  ;; appears with the work and drops itself with it, the `:scrollbar-fade`
                  ;; pattern.
                  (if (ed-busy? m) {:spinner {:every *spinner-ms*}} {})
                  ;; the settle ease after a scroll, ticking only while it runs
                  (if (:scroll-gliding m) {:scroll-glide {:every *scroll-glide-ms*}} {})
                  (ed-feature-timers m)
                  (into {}
                    (for ([name delay due?] one-shots :when due?)
                      [name {:after delay :idle? true}])))
        ;; Every managed timer is dropped here and re-added by `managed` while its work is
        ;; pending — that drop is what RE-ARMS a one-shot. A one-shot the loop has already
        ;; fired is dead until its entry is recreated, so a managed timer missing from this
        ;; list would fire once and never again.
        kept (apply dissoc
               (or (:timers m) {})
               :spinner :scroll-glide
               (append (keys (ed-timer-clients)) (map one-shots first))))
    ;; `:timers-synced?` says this model has been reconciled at least once: until it has, no
    ;; input may take `input/ed-update`'s short path, since a model built outside the loop (the
    ;; one `main` starts with) would otherwise never arm its idle beat while only a cosmetic
    ;; timer fired
    (assoc m :timers (merge kept managed) :timers-synced? true)))

;; ---- overlay scrollbar fade (macOS-style auto-hide) -------------------------
;; The scrollbar thumb is hidden at rest. Any scroll wakes it to full opacity
;; (`ed-scrollbar-wake`, called from every `:top` change) and arms ONE quiet one-shot,
;; `:scrollbar-hold` — idle-anchored, so every further scroll pushes it out. Only when it
;; fires does the `:scrollbar-fade` ticker start, ramping the opacity to 0 over
;; `*scrollbar-fade-ticks*` (`input/ed-timer-fire`) and dropping itself when done, so the
;; editor returns to fully idle. Dragging the thumb pins it opaque. The opacity
;; (`ed-scrollbar-opacity`) is read by the pure view (`view/ed-scrollbar-ops`).
;;
;; The hold used to be 50 ticks of the 16 ms fade timer: a whole loop turn — update, view,
;; paint — sixty times a second for 800 ms after every scroll, to draw a thumb that did not
;; change. That is the moment a reader presses the next key, and each of those turns was
;; one it had to queue behind.
(def *scrollbar-fade-ms* 16) ; the fade timer beat (~60fps while it ramps)
(defdyn *scrollbar-hold-ms* 800) ; how long the thumb stays fully opaque after a scroll
(defdyn *scrollbar-fade-ticks* 14) ; ticks to ramp opacity 1→0 after the hold (~220ms)
(sig ed-scrollbar-wake (model -> model))
(defn ed-scrollbar-wake (m)
  "Show the overlay scrollbar at full opacity and (re)arm its hold. Called from every
scroll path (`ed-set-top`, `panes/ed-scroll-pane`) so the thumb appears whenever the view
moves, then auto-hides. A fade already running stops: the thumb is back to full."
  (ed-set-timer (ed-drop-timer (assoc m :sb-fade *scrollbar-fade-ticks*) :scrollbar-fade)
    :scrollbar-hold {:after *scrollbar-hold-ms* :idle? true}))

(sig ed-scrollbar-start-fade (model -> model))
(defn ed-scrollbar-start-fade (m)
  "The hold is over: drop it (a fired one-shot is dead until its entry is recreated, which
is what lets the next scroll arm a fresh one) and start the fade ticker."
  (ed-set-timer (ed-drop-timer m :scrollbar-hold) :scrollbar-fade {:every *scrollbar-fade-ms*}))

(defn ed-scrollbar-opacity (m)
  "The overlay scrollbar's opacity this frame (0..1): pinned full while dragging it,
else the fade ramp from the `:sb-fade` budget — held at 1.0, then linear to 0. 0 ⇒ the
view omits the thumb entirely."
  (if (:sb-drag m)
    1.0
    (let (budget (or (:sb-fade m) 0))
      (if (<= budget 0)
        0.0
        (math/min 1.0 (/ (* 1.0 budget) *scrollbar-fade-ticks*))))))

(defn ed-strip-newline (s)
  "`s` without a single trailing newline — a buffer line's text with the `\\n` that
`buffer-line-at` keeps dropped. Shared by the view (line rendering) and the editing
commands (transpose-lines, occur)."
  (if (string/ends-with? s "\n") (string/substring s 0 (dec (string/length s))) s))

(sig ed-read-char (model any any -> model))
(defn ed-read-char (m prompt then)
  "Show `prompt` in the echo area and route the *next* key to `then` (a `(model key) ->
model` continuation), via the read-char transient (`input`). Esc/C-g aborts. The shared
one-key reader behind zap-to-char and the register / bookmark commands."
  (assoc (message m prompt) :read-char {:then then}))

(defn ed-yes-key? (key)
  "Whether `key` — what an `ed-read-char` continuation was handed for a `(y or n)`
question — answers yes: `y` or `Y`. Anything else declines, as in Emacs `y-or-n-p`."
  (or (= key "y") (= key "Y")))

(sig ed-break-undo-run (model -> model))
(defn ed-break-undo-run (m)
  "Insert an undo boundary at a typing pause: arm the one-shot `:undo-break` so the next
self-insert / deletion starts a FRESH undo group instead of amalgamating into the run
typed before the pause (Emacs `undo-boundary` on idle). `input/ed-dispatch-key` consumes
the flag. Leaves `:last-command` untouched, so kill coalescing / yank-pop are unaffected."
  (assoc m :undo-break true))

(sig ed-which-key-reveal (model -> model))
(defn ed-which-key-reveal (m)
  "When the `:which-key` timer fires with a prefix still pending, reveal the panel
(`ed-sync-timers` then drops the now-satisfied timer); if the chord ended first, clear it.
Public (called cross-module from `input/ed-timer-fire`)."
  (if (:pending m) (assoc m :which-key true) (dissoc m :which-key)))

;; ---- buffer recency (Emacs `buffer-list` order) ------------------------------
;; `:buffer-mru` is the names of the buffers in most-recently-selected-first order —
;; what Emacs keeps as the order of `(buffer-list)` and reads for `switch-to-buffer`'s
;; default (`other-buffer`: the one before this) and its candidate order. Names, not
;; indices: the pool reorders when a buffer is killed. Read through `ed-recent-buffers`,
;; which drops names no longer in the pool, so a kill needs no bookkeeping here.

(defn ed-note-buffer-recency (m)
  "The model with the current buffer's name at the head of `:buffer-mru` (deduplicated);
`m` unchanged when it already is."
  (let (name (buffer-name (ed-current-buf m))
        mru (or (:buffer-mru m) '()))
    (if (= name (first mru))
      m
      (assoc m :buffer-mru (cons name (seq/reject mru (fn (n) (= n name))))))))

(defn ed-recent-buffers (m)
  "The open buffers' names, most recently selected first: the recency list, pruned to
the pool, then any pool buffer never selected in this session (in pool order)."
  (let (live (map (:buffers m) buffer-name)
        mru (seq/filter (or (:buffer-mru m) '()) (fn (n) (includes? live n))))
    (append mru (seq/reject live (fn (n) (includes? mru n))))))

(defn ed-other-buffer (m)
  "The buffer to switch back to — the most recently selected one that is not the current
(Emacs `other-buffer`): `switch-to-buffer`'s default. Nil when there is no other."
  (let (cur (buffer-name (ed-current-buf m)))
    (seq/find (ed-recent-buffers m) (fn (n) (not (= n cur))))))

;; ---- post-step hooks ------------------------------------------------------------
;; The per-event follow-ups that keep a derived view in step with the model the event left:
;; buffer recency, a *Diagnostics* pane following the findings, a stale completion popup
;; closing, the live-evaluating buffers' notes following the text. Each is a ROW its module
;; registers at load ([[register-post-step]]), so `ed-post-step` folds the table and names
;; none of the features — the idle-job shape (`register-idle-job`), run on EVERY event
;; rather than the idle beat, so a row must be O(1) when it has nothing to do.

(defn register-post-step (name step)
  "Add a post-event hook `name` — `{:order :run}`, `:run` a `(model) -> model` symbol
(resolved late, so a redefinition hot-swaps; a deferred module's hook is skipped until it
loads) and `:order` its position in the chain — replacing any hook registered under `name`.
Called when the hook's module loads."
  (registry/put! :model/post-steps name (assoc step :name name :rank (:order step))))

(defn ed-run-post-steps (m)
  "Every registered post-step hook's `:run`, in `:order`, each seeing the model the previous
one left."
  (fold (registry/ranked :model/post-steps)
    m
    (fn (acc [_ step]) (ed-call-deferred acc (:run step) acc))))

(defn ed-sync-window-point (m)
  "The model with the selected pane's window-local cursor also written to its pool buffer,
when the two differ — the copy-back `ed-set-buf` makes, done for the moves that do not pass
through it: selecting another pane on the same buffer, a hosted push that rewrote the pool
copy. The pool's `:point` stays what it always was, the SAVED DEFAULT a fresh view opens at
(and now, as in Emacs, the point of the window last selected on it); what this buys is that
`ed-current-buf` answers the pool buffer itself for the rest of the turn and the next
([[ed-with-window-point]]) instead of building a copy per call. O(1) when they agree."
  (let (pane (ed-current-pane m)
        i (:buffer pane)
        point (:point pane))
    (if (or (nil? point) (not (int? i)) (< i 0) (>= i (count (:buffers m))))
      m
      (let (pooled (ed-buf-at m i)
            windowed (ed-with-window-point pooled point (:mark pane)))
        (if (and (= (:point windowed) (:point pooled)) (= (:mark windowed) (:mark pooled)))
          m
          (ed-set-buf-at m i windowed))))))

;; the selected pane's cursor rides on its pool buffer too (`ed-sync-window-point`), so the
;; next turn's `ed-current-buf` is the pool buffer itself — first, so every later hook and
;; the view read it
(register-post-step :window-point {:order 5 :run 'model/ed-sync-window-point})
;; buffer recency (Emacs's `buffer-list` order): whatever buffer is current after this event
;; moves to the head — the one place every path that switches a buffer (C-x b, RET in dired,
;; a results jump, a pane click) passes through
(register-post-step :buffer-recency {:order 10 :run 'model/ed-note-buffer-recency})
;; the live-evaluating buffers' notes follow the text on the edit itself (the debounce only
;; EVALUATES) — O(1) per client until its own buffer's notes go stale
(register-post-step :live-eval-reanchor {:order 40 :run 'model/ed-live-eval-reanchor})

(defn ed-post-step (m input)
  "The post-event step run after `input/ed-update` folds an event in. The eldoc hint and
the advisory type-check are **debounced onto idle timers** (ADR-102; Emacs's idle-timer
model) — recomputing them per keystroke makes a large buffer crawl. So this recomputes
nothing directly; it reconciles `:timers` (`ed-sync-timers`) with the new model
state — arming the eldoc/diagnostics debounce, the which-key delay, and the undo-pause
boundary when each is due — and the timers' firing (in `input/ed-timer-fire`) does the
work; then runs the registered post-step hooks (`ed-run-post-steps`). Finally refreshes
the open minibuffer's memoized candidate list (`ed-cache-mb-candidates`) so the view/input
read it cheaply."
  (let (
        ;; while a web mirror is running, a real keystroke/click marks the snapshot dirty
        ;; so the idle beat republishes it once (debounced off the hot key path —
        ;; `ed-sync-timers` arms `:idle-recompute`, `web-publish!` fires there). Timer and
        ;; system events don't dirty it, so the mirror only refreshes after actual
        ;; edits/moves.
        touched (if (and (:server m) (ed-real-input? input)) (assoc m :web-dirty true) m)
        stepped (ed-run-post-steps (ed-sync-timers touched))
        mb (:minibuffer stepped))
    ;; Bring the candidate list up to date with the typed text: a small source ranks here on
    ;; the keystroke (instant), a large one ASKS its ranking session and folds the answer
    ;; when it arrives (`ed-cache-mb-candidates`). Either way this is O(1) on the event when
    ;; the text has not changed, which is every frame, tick and selection move.
    (if (or (nil? mb) (not (mb-source? mb))) stepped (ed-cache-mb-candidates stepped))))

;; ---- the minibuffer (a one-line prompt over lineedit's pure editor core) -----
;; The `:minibuffer` field is `{:edit <lineedit-state> :on-complete :complete-fn
;; :candidates-fn}`. `:edit` is a `std/lineedit` state, so the prompt reuses the
;; REPL line editor's editing (motion, kill-ring, yank, history, reverse-search) —
;; the same core std/observer's minibuffer drives. `input/minibuffer-handle` feeds
;; keys to `lineedit-handle`; these accessors read the editor's text/point/prompt.

(defn ed-mb-set-text (edit s)
  "The lineedit state `edit` with its text replaced by `s`, point at the end."
  (assoc edit :text s :point (string/length s) :hist-idx -1))

(defn ed-mb-edit (prompt initial)
  "A fresh minibuffer line-editor state showing `prompt`, prefilled with `initial`
text (point at end). Stored as the minibuffer's `:edit`. Its history (↑ / M-p) is what
`prompt` was answered with before (`savehist/history-for`; empty unless savehist is on)."
  (ed-mb-set-text (editor/lineedit/lineedit-init prompt (savehist/history-for prompt)) initial))

(defn mb-text (mb) "The minibuffer's current input text." (map/get-in mb [:edit :text]))
(sig mb-point (any -> int))
(defn mb-point (mb)
  "The minibuffer cursor index (into its input), 0 before the line editor has one."
  (let (point (map/get-in mb [:edit :point]))
    (if (int? point) point 0)))
(defn mb-prompt (mb) "The minibuffer prompt string." (map/get-in mb [:edit :prompt]))
(sig mb-sel (any -> int))
(defn mb-sel (mb)
  "The selected candidate index (Vertico-style): the row a selection move put it on; with
none, -1 — the PROMPT itself, so Enter takes the typed text — when the prompt's
`:preselect-prompt?` holds for that text (Vertico's `vertico-preselect 'directory`: a path
prompt whose line names a directory opens the directory), else the first row."
  (let (sel (:sel mb)
        prompt? (:preselect-prompt? mb))
    (cond
      (int? sel) sel
      (and prompt? (prompt? (mb-text mb))) -1
      :else 0)))
(defn mb-source? (mb)
  "True if `mb` produces candidates from either a fixed `:rank-source` (fuzzy-ranked,
narrowable) or a `:candidates-fn` (computed each keystroke)."
  (or (:rank-source mb) (:candidates-fn mb)))

(defn mb-rank-options (mb)
  "The `std/fuzzy` options minibuffer `mb` ranks with: its `:category` (`:file` ranks paths
by their file name) and its `:rank-boost` (`{candidate n}` — the history or frecency a
prompt was opened with). The same map whether it ranks inline or in a session, so the two
can never order a prompt differently."
  {:category (:category mb) :boost (:rank-boost mb)})

(defn- mb-rank (mb text)
  "The candidate list for minibuffer `mb` at input `text`: a `:rank-source` prompt is
fuzzy-ranked to its `:rank-cap` (`completion/completion-rank`, which only ever does the
work the cap needs — see there), a `:candidates-fn` prompt computes its own, and a prompt
with neither has none.

There is no narrowing cache here. There used to be: each keystroke ranked the *previous*
result rather than the whole source, which is exact (a longer query can only drop matches)
but only helps when the previous result is small — and a short query over a project matches
nearly every path, so it saved nothing on the one source where it mattered. Ranking to a
cap made it worthless AND wrong: the cached ranking would be the capped twenty, and
narrowing from those would drop matches that belong in the next twenty."
  (cond
    (:rank-source mb)
      (completion-rank text (:rank-source mb) (or (:rank-cap mb) 20) (mb-rank-options mb))
    (:candidates-fn mb) ((:candidates-fn mb) text)
    :else ()))

(def ed-minibuffer-max 10) ; most list rows the echo area grows to (Emacs vertico-count)
(defn ed-which-key-count (m)
  "Number of pending which-key continuation rows (0 when the panel isn't showing — no
pending prefix, not yet revealed, or a minibuffer/menu is open)."
  (let (km (:pending m))
    (if (or (nil? km) (not (:which-key m)) (:minibuffer m) (:menu m))
      0
      (count (%map-pairs km)))))

(sig ed-list-rows (int int -> int))
(defn- ed-list-rows (n rows)
  "Echo-area height for an `n`-row list below the prompt: 0 → 1 (just the prompt), else
1 + the list capped to `ed-minibuffer-max` and the screen."
  (if (= n 0) 1 (+ 1 (math/min ed-minibuffer-max n (math/max 1 (- rows 4))))))

;; `map`, not `model`: it reads `:minibuffer` and the which-key count alone, and the layout
;; tests hand it a bare `{}` — which the `model` record's required fields refuse at run time
;; (ADR-380).
(sig ed-echo-rows (map int -> int))
(defn ed-echo-rows (m rows)
  "How many bottom screen rows the echo area occupies. It grows **downward** from below
the mode line (Emacs-style): 1 (the prompt/message row) plus a list — Plume's candidate
list for an open selection prompt, or the which-key continuations for a pending prefix.
`ed-body-layout` reserves this many rows so the pane + its mode line sit above; `view`
lays the prompt + list into them."
  (let (mb (:minibuffer m))
    (if (and mb (:accept-selection mb))
      (ed-list-rows (count (mb-candidates mb)) rows)
      (ed-list-rows (ed-which-key-count m) rows))))

(defn mb-candidates (mb)
  "The current candidate list for minibuffer `mb` — fuzzy-ranked from its `:rank-source`,
or its `:candidates-fn` applied to the typed text, or `()` with neither.
**Memoized on the input text** via `:cand-cache` (refreshed by `ed-cache-mb-candidates`
each event): the view reads this every frame and input reads it on every selection move,
so without the memo a large candidate set (e.g. a whole project's files) would be
re-ranked several times per keystroke and again on every idle tick. The shared seam the
view (the vertical list) and input (selection + accept) both read. A cache miss ranks
fresh."
  (let (cache (:cand-cache mb))
    (cond
      ;; a fresh hit (the cache is for the current text) — the common case
      (and cache (= (:for cache) (mb-text mb))) (:cands cache)
      ;; a big source being ranked OFF the loop: show what the session last answered. Never
      ;; rank inline here — this is called from the view and from every selection move, and
      ;; ranking on either is what made holding ↓ cost 210ms a step on a 27k-file project.
      (and cache (:ranker mb)) (:cands cache)
      ;; otherwise (small source, or no cache yet) recompute now — instant, and what the
      ;; per-keystroke and direct-text-set paths rely on
      :else (mb-rank mb (mb-text mb)))))

;; ---- ranking a big candidate set off the loop (std/fuzzy's `ranker`, ADR-374) ----
;; A prompt over a whole project hands its candidates to a ranking SESSION — a process that
;; owns the set — and then asks it a query per keystroke instead of ranking here. The loop
;; sends and returns; the answer arrives as a `[:fuzzy-ranked …]` event and folds into the
;; cache like any other async reply (`input/ed-ev-ranked`).
;;
;; This replaces a debounce, which is what the same problem looked like while the ranking
;; still had to happen HERE: defer it to the idle beat, show a stale list meanwhile, and pay
;; the whole cost in one lump the moment typing paused (measured 163 ms on the idle beat, and
;; 210 ms on a single ↓, which forced a fresh rank). Off the loop there is nothing to defer:
;; every keystroke asks, the session drops the queries it has been overtaken on, and the
;; newest answer lands when it lands. Typing is never blocked by finding — which is the
;; distinction the whole thing turns on.

(defdyn *mb-session-min* 800)
;; A `:rank-source` bigger than this gets a ranking session; smaller ones rank inline on the
;; keystroke, where a session's process + the copy of the set would cost more than it saves.

(defn mb-session? (mb)
  "Whether minibuffer `mb`'s candidate source is big enough to rank off the loop — a fixed
`:rank-source` past `*mb-session-min*` (a `:candidates-fn` prompt computes its own way)."
  (let (src (:rank-source mb))
    (and src (> (count src) *mb-session-min*))))

(defn ed-mb-ensure-ranker (m)
  "Give the open minibuffer a `fuzzy/ranker` session over its `:rank-source` if it wants one
and has none. Lazy, and on the per-event path rather than at every prompt's call site: a
prompt is a plain map built in a dozen places (`commands`, `mincomplete`, `interactive`), and
none of them should have to know about sessions to get one. A small source, a prompt that
computes its own candidates, or a headless model (a test, a `--headless` daemon — nowhere for
the reply to land) gets none and keeps ranking inline."
  (let (mb (:minibuffer m))
    (if (or (nil? mb) (:ranker mb) (not (mb-session? mb)) (ed-headless?))
      m
      (assoc m
        :minibuffer (assoc mb :ranker (fuzzy/ranker (:rank-source mb) (mb-rank-options mb)))))))

(defn ed-mb-stop-ranker (m)
  "Stop the open minibuffer's ranking session, if it has one. Called wherever the prompt
closes (`input/mb-close`), so a session never outlives the prompt that owns it."
  (let (session (map/get-in m [:minibuffer :ranker]))
    (do (when session (fuzzy/ranker-stop session)) m)))

(defn ed-apply-ranked (m session query hits)
  "Fold a ranking session's reply into the open minibuffer's `:cand-cache`. Dropped unless
`session` is the prompt's own — a reply from a session whose prompt has already closed (or
been replaced) must not overwrite the new one's list. The session answers only the newest
query it was asked, so `query` is stamped as what the cache is FOR: if the reader has typed
on since, `ed-cache-mb-candidates` sees the mismatch on the next event and asks again."
  (if (not (= (map/get-in m [:minibuffer :ranker]) session))
    m
    (map/assoc-in m [:minibuffer :cand-cache] {:for query :cands hits})))

(defn mb-cands-stale? (m)
  "True if an open candidate prompt's cached list is for a different input than the current
text — an answer is outstanding. With a session that means one has been asked for and not
arrived; without one it is never true, since an inline source is kept current on the event."
  (let (mb (:minibuffer m))
    (and mb
      (mb-source? mb)
      (not (= (map/get-in mb [:cand-cache :for]) (mb-text mb))))))

(defn ed-mb-reask (m)
  "Re-ask the ranking session for the current text if an answer is still outstanding — the
idle beat's safety net. Everything else here assumes a question gets an answer; this is the
one place that does not, so a reply lost to a dead session (or a prompt that somehow asked
before its session existed) recovers on the next quiet moment rather than showing a stale
list until the reader gives up and retypes. A no-op when the cache is current."
  (if (mb-cands-stale? m)
    (ed-cache-mb-candidates (assoc m :minibuffer (dissoc (:minibuffer m) :asked)))
    m))

;; the minibuffer is the model's own, so this job is the one row the model registers itself
(register-idle-job :minibuffer-rerank
  {:order 70 :run 'model/ed-mb-reask :stale? 'model/mb-cands-stale?})

(defn ed-cache-mb-candidates (m)
  "Bring the open minibuffer's `:cand-cache` (`{:for <text> :cands …}`) up to date with the
typed text — by ASKING its ranking session when it has one (the answer folds in later,
`ed-apply-ranked`), else by ranking inline. Run once per event by `ed-post-step`; a no-op
with no minibuffer, no candidate source, or unchanged text.

The `:asked` stamp is what keeps one keystroke to one question: the session already drops a
query it has been overtaken on, but without this the view and every selection move would
re-ask for the same text while the first answer was still in flight."
  (let (m1 (ed-mb-ensure-ranker m)
        mb (:minibuffer m1)
        text (if (nil? mb) nil (mb-text mb)))
    (cond
      (or (nil? mb) (not (mb-source? mb))) m1
      (= (map/get-in mb [:cand-cache :for]) text) m1
      (:ranker mb)
        (if (= (:asked mb) text)
          m1
          (do
            (fuzzy/rank-async (:ranker mb) text (or (:rank-cap mb) 20))
            (assoc m1 :minibuffer (assoc mb :asked text))))
      :else (assoc m1 :minibuffer (assoc mb :cand-cache {:for text :cands (mb-rank mb text)})))))

(sig ed-set-buf-at (model int buffer -> model))
(defn ed-set-buf-at (m i buf)
  "The model with `buf` in pool slot `i` — the plain write every pane on that buffer sees.
No pane bookkeeping: a caller changing the CURRENT buffer's content wants `ed-set-buf`,
which also caches its point on the pane; this is for a buffer's own properties (its zoom, a
reload, a save-stamp), or a slot that is not the selected pane's."
  (assoc m :buffers (assoc (:buffers m) i buf)))

(sig ed-set-buf (model buffer -> model))
(defn ed-set-buf (m buf)
  "The model with `buf` written back to the selected pane's POOL slot (so every view sees a
content edit) **and** `buf`'s point/mark cached as the selected pane's **window-local** cursor
— so other panes on the same buffer keep their own. Scroll (per-pane) is untouched."
  (assoc (ed-set-buf-at m (ed-current-index m) buf)
    :layout
      (pane-update-selected (:layout m)
        (fn (w) (assoc w :point (:point buf) :mark (:mark buf))))))

(sig ed-set-top (model int -> model))
(defn ed-set-top (m n)
  "The model with the *selected pane's* scroll offset set to `n` (per-pane, so
another pane on the same buffer keeps its own scroll). A real change wakes the overlay
scrollbar (`ed-scrollbar-wake`)."
  (ed-set-start m n 0))

(sig ed-set-start (model int int -> model))
(defn ed-set-start (m top top-row)
  "The model with the *selected pane* starting on screen row `top-row` of line `top` — a
wrapped pane's scroll position, by rows ([[payload-top-row]]); `top-row` 0 is
`ed-set-top`. Untouched when it already starts there, so an unchanged position never
redraws or wakes the scrollbar; a real change wakes it (`ed-scrollbar-wake`)."
  (if (and (= top (ed-current-top m)) (= top-row (ed-current-top-row m)))
    m
    (ed-scrollbar-wake (assoc m
                         :layout
                           (pane-update-selected (:layout m)
                             (fn (w)
                               (if (> top-row 0)
                                 (assoc w :top top :top-row [top top-row])
                                 (dissoc (assoc w :top top) :top-row))))))))

(sig ed-restrict-lines (buffer any -> (tuple int int)))
(defn ed-restrict-lines (buf restrict)
  "The inclusive `[top bottom]` LINE range a `[lo hi]` char restriction covers in `buf`,
clamped to the buffer — the narrowing translated into what the renderer and scroll clamp
speak (lines). A restriction is stored as char bounds so it survives edits sensibly; this
is the per-frame read."
  (let ([lo hi] restrict
        rope (buffer-rope buf)
        len (text/length rope)
        last (dec (buffer-line-count buf))
        ;; Clamp the OFFSETS, not just the lines they resolve to. `text/char->line` raises
        ;; on an out-of-range index, so clamping its result never runs — the frame dies
        ;; first, and the editor becomes one red `render error` line.
        ;;
        ;; Out-of-range bounds are ordinary here, which is why this had to be wrong only
        ;; once: a restriction is stored as CHAR offsets so it survives edits, and the
        ;; edits it has to survive include the ones that make the buffer shorter than it
        ;; was — an undo, a revert, a git checkout under auto-revert, a collaborator
        ;; deleting the region you narrowed to. `low`/`high` are also ordered, because a
        ;; reversed pair is the same kind of leftover and `[80 10]` raised just as loudly.
        low (math/max 0 (math/min len (math/min lo hi)))
        high (math/max 0 (math/min len (math/max lo hi))))
    [(math/max 0 (math/min last (text/char->line rope low)))
      (math/max 0 (math/min last (text/char->line rope high)))]))

(defn ed-selected-restrict (m)
  "The selected pane's narrowing — its `[lo hi]` char restriction — or nil when the pane is
wide. Narrowing is PER PANE (a window property, not the buffer's): one pane may focus a
region while another on the same buffer shows all of it. That is the whole design — a
visible, local focus, never a hidden buffer-global mode you forget is on."
  (get (ed-current-pane m) :restrict))

(sig ed-set-restrict (model int int -> model))
(defn ed-set-restrict (m lo hi)
  "Narrow the selected pane to the char range `[lo hi]`: it renders and scrolls only those
lines, and point is confined to them. Other panes are untouched."
  (assoc m :layout (pane-update-selected (:layout m) (fn (w) (assoc w :restrict [lo hi])))))

(sig ed-clear-restrict (model -> model))
(defn ed-clear-restrict (m)
  "Widen the selected pane — drop its narrowing, so all of the buffer is in view again."
  (assoc m :layout (pane-update-selected (:layout m) (fn (w) (dissoc w :restrict)))))

(sig ed-adjust-restriction (model model -> model))
(defn ed-adjust-restriction (m-before m-after)
  "Grow or shrink the selected pane's narrowing by an edit made inside it — outward gravity,
so typing at the end of a narrowed defun keeps the new text in view rather than clipping it
at a fixed `hi`. Compares the selected buffer's length before and after the just-dispatched
key: while narrowed and still on the same buffer, the region's `hi` moves by that delta
(`lo` is the region start, which an edit at point — always `>= lo` — never precedes). A
no-op in a wide pane, or when nothing was inserted or deleted."
  (let (restrict (ed-selected-restrict m-after))
    (if (or (nil? restrict) (not (= (ed-current-index m-before) (ed-current-index m-after))))
      m-after
      (let ([lo hi] restrict
            delta (- (buffer-length (ed-current-buf m-after))
                    (buffer-length (ed-current-buf m-before))))
        (if (= delta 0)
          m-after
          (ed-set-restrict m-after lo (math/max lo (+ hi delta))))))))

(defn ed-clamp-restriction (m)
  "Keep point inside the selected pane's narrowing — the per-key confinement that makes a
narrowed pane behave like a small buffer: a motion that would leave the region stops at its
edge. A no-op in a wide pane, or when point is already inside. Runs after dispatch, before
the scroll clamp (a confined point is what the viewport then centres on)."
  (let (restrict (ed-selected-restrict m))
    (if (nil? restrict)
      m
      (let ([lo hi] restrict
            p (buffer-point (ed-current-buf m)))
        (if (and (>= p lo) (<= p hi))
          m
          (ed-set-buf m (goto-char (ed-current-buf m) (math/max lo (math/min hi p)))))))))

(sig ed-top-showing (model int -> int))
(defn ed-top-showing (m i)
  "A scroll offset for pool buffer `i` that actually SHOWS its stored point — the point's
line roughly centred when it would otherwise be off screen, else the top.

Zero is only right when the buffer's point is near the top, and a buffer you are returning
to usually has its point wherever you left it. Opening at 0 anyway paints the top of the
file with the cursor nowhere in it, and then the first key you press runs the scroll clamp
and the viewport snaps down — which reads as the pane jumping when you navigate to it,
though it was really wrong from the moment it opened. `:view-rows` is the window height
`ed-update` stamps on the model; before the first event there is none, and 0 is then the
only answer available."
  (let (rows (:view-rows m)
        line (buffer-current-line (ed-buf-at m i)))
    (if (or (not (int? rows)) (< rows 2) (< line rows))
      0
      (math/max 0 (- line (math/quot rows 2))))))

(sig ed-show-index (model int -> model))
(defn ed-show-index (m i)
  "The model with the selected pane showing pool buffer `i`, scrolled so its stored point is
visible (`ed-top-showing`) and with its window-local cursor **cleared** — so the buffer opens
at its own point (not the pane's previous buffer's), and this pane then tracks independently.
The pane-layer primitive behind buffer switching."
  (assoc m
    :layout
      (pane-update-selected (:layout m)
        (fn (w) (assoc w :buffer i :top (ed-top-showing m i) :point nil :mark nil)))))

(sig ed-map-panes (model fn -> model))
(defn ed-map-panes (m f)
  "The model with `f` applied to every pane's payload — for re-pointing
pane→buffer references after the pool changes (e.g. after a kill). Pure."
  (assoc m :layout (pane-map (:layout m) f)))

;; `map`: it reads `:buffers` alone, and the playground tests hand it a partial model.
(sig ed-buffer-index-by-name (map string -> (or nil int)))
(defn ed-buffer-index-by-name (m nm)
  "The pool index of the buffer named `nm`, or nil if there is none."
  (let (i (seq/index-where (:buffers m) (fn (b) (= (buffer-name b) nm))))
    (if (< i 0) nil i)))

(defn ed-buffer-index-by-name! (m nm)
  "The pool index of the buffer named `nm` — which must exist: the `!` spelling (ADR-302)
for the sites that go straight on to `nth` / `ed-buf-at` / `ed-select` with the answer,
where an absent buffer is a bug to name, not a `nil` to hand on. `ed-buffer-index-by-name`
is the honest `nil | int` for a caller that has a plan for absence."
  (or (ed-buffer-index-by-name m nm)
    (error (str "no buffer named " (pr-str nm) " in the pool"))))

(defn ed-update-named (m nm f)
  "The model with `f` applied to the pool buffer named `nm`, wherever it sits, and nothing
else touched — a no-op when there is no such buffer.

The one shape every feature that owns a REPORT buffer needs: a reply, a subprocess line, a
re-anchored note all arrive for a buffer that usually is NOT the selected one, so they cannot
go through `ed-set-buf` (which writes the selected pane's slot) and each had hand-rolled the
same index-lookup-and-splice. Naming it also names the discipline: reach a buffer by NAME, so
a pool that has been re-ordered by a kill cannot send an update to a stranger."
  (let (i (ed-buffer-index-by-name m nm))
    (if (nil? i) m (update m :buffers assoc i (f (nth (:buffers m) i))))))

(defn ed-headless? ()
  "Is there no `ui-run` loop to deliver an async event to — a test, a `--headless` daemon, a
batch run?

A PROCESS-global fact, not a model one, which is why it takes no model. Everything that fires
work off to another process has to ask it, because a fire-and-forget request has nowhere to
come back to without a loop: the answer decides between sending and doing the work inline
(diagnostics, eldoc, the git gutter) or between the sandbox and an in-image eval (the
tutorial, the playground). It was spelled out at every one of those sites, twice as its own
negation, which is how two features came to carry identical private `…-live?` functions.

Live when this code runs INSIDE a loop (`editor/ui/*loop*`, bound by `ui-run` for the loop's whole
life) or when the editor process exists (`:editor`, registered before its loop starts, so the
setup `main` does ahead of `ui-run` counts). It used to be the second alone, which is true of
the first window only — a second frame and every `--serve` client's loop read as headless,
and the playground there evaluated in the daemon's own image, with no timeout, where a `defn`
rebinds the editor for every client (issues.md S6). Their answers come back to them now
(`session/request` routes by the asking loop), so they are loops like any other."
  (and (nil? editor/ui/*loop*) (nil? (proc/whereis :editor))))

(defn ed-loop-address ()
  "Where work sent off the loop should send its answer: the LOOP this code runs in
(`editor/ui/*loop*`), else `:editor` for setup done before a loop starts. Read ON the loop, when
the work is handed over — a spawned worker does not inherit the binding, so it is captured
at the send, not looked up by the worker.

`:editor` alone is the first window. A shell, a compile or a test run started from a
second frame (or a `--serve` client) sent its output there, and the frame that asked never
heard back — the same mistake `ed-headless?` and `session/request` were cured of."
  (or editor/ui/*loop* :editor))

(defn ed-buffer-index-by-file (m path)
  "The pool index of the buffer visiting file `path`, or nil — a file's identity for
\"already open?\", distinct from its display name (which may be a project-relative
path or a basename, so it can't be matched against the on-disk path)."
  (let (i (seq/index-where (:buffers m) (fn (b) (= (buffer-file b) path))))
    (if (< i 0) nil i)))

;; ---- the `*Messages*` log + echo area ---------------------------------------

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (string/replace s "\n" " "))

(defn- ed-ensure-newline (s)
  "`s` with exactly one trailing newline (logger lines already end in one; echo
strings don't) — so a log buffer keeps one line per record."
  (if (string/ends-with? s "\n") s (str s "\n")))

(defn ed-append-end (buf line)
  "Append `line` at `buf`'s end, tolerating a READ-ONLY buffer: a report stream
(*Tests*, *Spy*, *compilation*) is read-only for the USER — its text mutators refuse
edits — but the stream itself is the owner, so unlock, insert, re-lock. std's
`insert` throws on a read-only buffer (the buffer-level contract), which is right
for a command and wrong for the buffer's own producer."
  (if (read-only? buf)
    (set-read-only (insert (end-of-buffer (set-read-only buf false)) line) true)
    (insert (end-of-buffer buf) line)))

(defn ed-trim-head (buf limit)
  "`buf` with its oldest lines dropped once it is longer than `limit` chars: cut back to
the first line start past the newest two thirds of `limit`, so a log that keeps growing
pays for the cut once per third rather than on every append. A no-op at or below
`limit`. A read-only buffer is unlocked for the cut and re-locked, as `ed-append-end`."
  (let (length (buffer-length buf))
    (if (<= length limit)
      buf
      (let (from (- length (math/quot (* 2 limit) 3))
            newline (buffer-search-forward buf "\n" from)
            cut (if (nil? newline) from (inc newline)))
        (if (read-only? buf)
          (set-read-only (replace-region (set-read-only buf false) 0 cut "") true)
          (replace-region buf 0 cut ""))))))

(sig ed-append-named (model string string &optional (or int nil) -> model))
(defn ed-append-named (m nm s &optional limit)
  "Append `s` as a line to the buffer named `nm`, creating a fresh undo-less log
buffer for it in the pool if none exists (so *Messages* / *LSP* / … survive buffer
switches and kills). Appends at that buffer's end without disturbing the *current*
buffer's point — the target is a separate pool entry; a read-only report buffer is
unlocked for the append and re-locked (`ed-append-end`). Sets no echo: this is the
raw sink shared by `message` (which adds the echo) and routed log buffers (which
must not flood the echo area). With `limit`, the buffer keeps only its newest lines
once it passes that many chars (`ed-trim-head`) — a sink a chatty producer fills
without end. Returns the model."
  (let (idx (ed-buffer-index-by-name m nm)
        line (ed-ensure-newline s)
        capped (fn (buf) (if (nil? limit) buf (ed-trim-head buf limit))))
    (if (nil? idx)
      (update m :buffers into [(ed-stamp (capped (insert (ed-log-buffer nm) line)))])
      (update m :buffers assoc idx (capped (ed-append-end (ed-buf-at m idx) line))))))

(defdyn *message-log-max* 1000)
;; How many lines `*Messages*` keeps (Emacs `message-log-max`, same default): past that the
;; oldest go, so a session that runs for days does not carry every echo it ever showed.

(sig ed-trim-head-lines (buffer int -> buffer))
(defn ed-trim-head-lines (buf limit)
  "`buf` with its oldest lines dropped so at most `limit` remain (a final newline ends the
last line rather than starting another). A no-op at or under `limit`; one cut at the head
— a rope splice — when over. A read-only buffer is unlocked for the cut and re-locked."
  (let (rope (buffer-rope buf)
        length (text/length rope)
        lines (buffer-line-count buf)
        ;; a buffer ending in a newline has an empty line after it, which is not a line kept
        complete (if (and (> length 0) (= (text/slice rope (dec length) length) "\n"))
                   (dec lines)
                   lines)
        excess (- complete limit))
    (if (<= excess 0)
      buf
      (let (cut (text/line->char rope excess))
        (if (read-only? buf)
          (set-read-only (replace-region (set-read-only buf false) 0 cut "") true)
          (replace-region buf 0 cut ""))))))

(defn ed-report-slow (report)
  "ui-run's watchdog hook (`:on-slow`, brood ADR-490): hand a slow turn's `report`
(`{:phase :tag :ms}`) back to this loop as a `[:ui-slow report]` event. Called in the loop
process, so `(self)` is the loop; a plain send, behind the input it must never delay.

A report about a slow `:ui-slow` turn is not sent: when every turn is slow, logging one is
slow too, and reporting that would keep the loop busy logging its own reports."
  (when (not (= (:tag report) :ui-slow)) (send (self) [:ui-slow report])))

(defn ed-ev-ui-slow (m input textrows cols rows)
  "A slow turn the watchdog reported ([[ed-report-slow]]), appended to `*Messages*` —
`slow update 73ms on [:timer :idle]` — and not echoed: the reader is in the middle of
something, and the line is for whoever goes looking for why a key felt late.

An INTERRUPTED turn (brood ADR-491) says so: `interrupted update 2000ms on
:lsp-diagnostics`. One the reader stopped — a command (`:input` true), by C-g — also echoes `Quit`, as
Emacs does; a background event the loop's ceiling stopped stays in the log, since nobody
asked for it and an echo would interrupt whatever they are reading."
  (let (report (nth input 1)
        {:keys [phase tag ms interrupted]} report
        logged (ed-append-named m
                 "*Messages*"
                 (str (if interrupted "interrupted " "slow ") phase " " ms "ms on " (pr-str tag))))
    (if (and interrupted (:input report)) (assoc logged :echo "Quit") logged)))

(register-event-handler :ui-slow 'model/ed-ev-ui-slow)

(defn message (m s)
  "Log `s` to the editor's default sink: append it as a line to `*Messages*`
(`ed-append-named`, creating it if needed) *and* show it (flattened to one line) in
the echo area. Never disturbs the current buffer's point. The editor's primary output
— commands print here, never the console; categorised logs route elsewhere (see
`ed-append-named` + the log routes). `*Messages*` keeps its newest
[[*message-log-max*]] lines."
  (let (logged (ed-append-named m "*Messages*" s)
        i (or (ed-buffer-index-by-name logged "*Messages*") (error "message: no *Messages* buffer"))
        messages (ed-buf-at logged i)
        trimmed (ed-trim-head-lines messages *message-log-max*))
    (assoc (if (= trimmed messages) logged (ed-set-buf-at logged i trimmed)) :echo (one-line s))))

;; ---- applying buffer ops to the current buffer ------------------------------
;; The editing core: every command that changes the text goes through `ed-try-edit`
;; (or `ed-edit`), so a read-only refusal is handled in ONE place and a command
;; learns whether its edit happened. Here rather than in `commands` because isearch's
;; query-replace is an editing command too, and `commands` uses isearch.

(defn ed-apply (m f)
  "Apply a pure `buffer -> buffer` op `f` to the current buffer (movement/undo:
no status change)."
  (ed-set-buf m (f (ed-current-buf m))))

(defn ed-try-edit (m f)
  "Apply a pure `buffer -> buffer` edit `f` to the current buffer: `[m' true]` when it
ran, `[m' false]` when the buffer refused it (with the echo area saying why). The one
path an edit takes, so a command that does something ELSE besides the edit — push the
killed text, remember the yanked span — can do it only when the edit really happened.
(The buffer records that it is modified itself — std/editor/buffer.)

Refuses on a read-only buffer (a process list, etc.): the edit is skipped and the echo
area says so, rather than letting the model's `insert`/`delete` guard surface as a raw
`error:`. Movement (`ed-apply`) is never blocked — a read-only buffer stays navigable.

A PARTIAL read-only span (a form buffer's generated text — the tutorial's prose, a shell
prompt) can't be pre-checked here (`f` is opaque), so the mutator throws `text is read-only`
and this catches it: the whole op is abandoned (the buffer is immutable — a mid-op throw
leaves nothing behind) and the echo shows the buffer's own `:read-only-hint`, or a neutral
line. Any other error is re-raised untouched."
  (let ([edited ran _] (ed-try-edit-with m (fn (b) [(f b) nil])))
    [edited ran]))

(defn ed-try-edit-with (m f)
  "[[ed-try-edit]] for an edit that answers something besides the buffer: `f` is `buffer ->
[buffer extra]`, and the result is `[m' true extra]` when it ran, `[m' false nil]` when the
buffer refused it. What an edit hands back that the model must keep — a held syntax tree it
brought up to the edited text as it went (`commands/ed-edit-following-tree`) — leaves the
edit through here rather than through a buffer key."
  (if (read-only? (ed-current-buf m))
    [(message m "buffer is read-only") false nil]
    (try
      (let ([edited extra] (f (ed-current-buf m)))
        [(assoc (ed-set-buf m edited) :status "modified") true extra])
      (catch e
        ;; A partial read-only span refused the edit: the mutator throws `:kind :read-only`
        ;; (std/editor/buffer) — matched by KIND, not message text, so the wording can change
        ;; without breaking this. The whole op is abandoned (immutable) and the buffer's own
        ;; `:read-only-hint` says where you CAN edit; any other error re-raises untouched.
        (if (and (map? e) (= (:kind e) :read-only))
          [(message m
             (or (ed-mode-service (ed-current-buf m) :read-only-hint) "read-only text here"))
            false nil]
          (throw e))))))

(defn ed-edit (m f)
  "Apply a pure `buffer -> buffer` edit `f` to the current buffer — `ed-try-edit`, for a
command with nothing to do beyond the edit itself."
  (first (ed-try-edit m f)))
;; ---- log routing: one logger, a filtered backend per destination buffer ------
;; stdout (a raw `*out*` stream) and logging (structured, levelled records) are
;; different pipes that converge only here — text appended to a named buffer. The
;; logger (std/log) fans each record to its backends; we give it one backend per
;; destination buffer, each a `:filter` on the record's `:meta :category`, so a
;; component's logs land in its own buffer: uncategorised → *Messages* (the default),
;; `{:category :lsp}` → *LSP*, etc. A backend's sink is a `process-port`-style `io`
;; port that sends a `buffer-log-event` to the editor, which folds it into that
;; buffer (`ed-append-named`) — the same share-nothing path `print` uses.

;; ---- the async event contract (UiEvent) --------------------------------------
;; Besides keys, the ui-run loop's mailbox receives async events from the editor's
;; own producers (the compile worker, the project shell, the web mirror, the log
;; backends below). Each is a RECORD implementing `UiEvent`: the producer module
;; defines the record + impl and just sends it — no central handler table to edit
;; (`ed-update` folds any `UiEvent` record via `ui-event-fold`). Declared here
;; because every producer already `:use`s the model. Events whose producer we don't
;; own — the GUI frontend's `[:resize]`/`[:mouse]`/`[:key-up]`, the runtime's
;; `[:down]`, std's `[:buffer-updated]`/`[:io/write]`/`[:task-*]`/`[:client-opts]`,
;; and the lsp replies interlocked with completion's bounded wait — stay tagged
;; vectors in input's residual registry.

(defn ed-json-event-line (line)
  "The tagged JSON event object a runner subprocess printed on `line`, or nil —
salvaging a line another process's unflushed `print` prefixed (re-parse from the
first `{` when an event object is plainly present). The decode half every streaming
runner (testrun / apprun) shares; classifying the event stays theirs."
  ;; a runner line that is not JSON is the common case (plain program output) — nil is the answer
  (let (parse (fn (s) (check-allow :discarded-catch (try (json/decode s) (catch e nil))))
        parsed (or (parse line)
                 (let (i (index-of line "{"))
                   (when (and (includes? line "\"event\":") (>= i 0))
                     (parse (string/substring line i (string/length line)))))))
    (when (map? parsed) parsed)))

(defability UiEvent
  "An app-produced async event on the ui-run mailbox: `ui-event-fold` folds it into
the model (the async analogue of a command's `model -> model`). Each impl does its
own scroll-clamp, and delegates to a NAMED handler fn so redefining that global
hot-swaps the live editor (the impl body's call is resolved late, like a keymap
binding)."
  (ui-event-fold (self m textrows cols rows) :-> any))

(defn ui-event? (input)
  "Whether `input` is an async event record (implements `UiEvent`)."
  (and (record? input) (satisfies? 'UiEvent input)))

(defmacro defuievent (name fields handler)
  "Declare the async event record `name` (with `fields`) and fold it into the model by
calling the NAMED `handler` — `(handler m event textrows cols rows) -> model`. The
record + `UiEvent` impl pair every producer wrote out by hand, in one line:

    (defuievent compile-done-event (code) ed-ev-compile-done)

The impl body only CALLS `handler`, a global resolved at each fold, so redefining the
handler hot-swaps the live editor exactly as the hand-written impl did. An event whose
fold is more than that delegation (a generation guard, an inline body) keeps its own
`impl`."
  ;; `~'UiEvent` / `~'ui-event-fold`: written bare, as a hand impl writes them. The
  ;; quasiquote would qualify them to `bedit/model/…`, and the impl then registers under
  ;; a name `ui-event?`'s `(satisfies? 'UiEvent …)` does not ask about — every such
  ;; event silently stops folding
  `(do
     (defrecord ~name ~fields)
     (impl ~'UiEvent
       ~name
       (~'ui-event-fold (event m textrows cols rows) (~handler m event textrows cols rows)))))

(defrecord buffer-log-event (buffer line)) ; a routed log line -> append to that buffer
(impl UiEvent
  buffer-log-event
  ;; Unlike `[:io/write]` it sets *no* echo, so a category's stream (e.g. *LSP*)
  ;; never floods the echo area.
  (ui-event-fold (e m textrows cols rows)
    (ed-append-named m (buffer-log-event-buffer e) (buffer-log-event-line e))))

;; Registered category→buffer log routes — a list of `{:category :buffer}`. A `def`
;; registry (rebound by `register-log-route`, like `layers/*type-layers*`), so it's
;; reload-stable *and* read afresh whenever the supervised logger (re)starts, so routes
;; survive a logger restart. Uncategorised records always go to *Messages*.
(def *log-routes*
  ())

(defn register-log-route (category buffer)
  "Route log records tagged `{:category <category>}` to the buffer named `buffer`
(its own *LSP*-style log buffer). Idempotent-ish: prepended, newest wins. A mode
declares its destination by calling this (its `:log-category` / `:log-buffer`)."
  (def *log-routes* (cons {:category category :buffer buffer} *log-routes*)))

(defn- ed-record-category (rec)
  "The `:category` a log record carries in its `:meta`, or nil (uncategorised)."
  (map/get-in rec [:meta :category]))

(defn ed-buffer-backend (nm &optional (opts {}))
  "A std/log backend whose sink sends each formatted line to the editor as a
`buffer-log-event` (the editor appends it to buffer `nm`). `opts` is the usual
`backend` map (`:filter` / `:min-level` / `:format`). The log-side counterpart of
`message`: a component points its logger here to stream into its own buffer."
  (log/backend (io/fn-port (fn (s) (send :editor (buffer-log-event nm s)) nil)) opts))

(defn ed-log-backends ()
  "The logger's full backend list, built from `*log-routes*`: one filtered backend
per route (records of that `:category` → its buffer) plus the default backend for
*uncategorised* records → *Messages*. Disjoint filters, so a record lands in exactly
one buffer and the table needs no shared state. Rebuilt at every (re)start of the
supervised logger, so routes survive a restart."
  (cons (ed-buffer-backend "*Messages*" {:filter (fn (r) (nil? (ed-record-category r)))})
    (map *log-routes*
      (fn (rt)
        (ed-buffer-backend (:buffer rt)
          {:filter (fn (r) (= (ed-record-category r) (:category rt)))})))))

;; ---- the kill ring's head: what a yank inserts ------------------------------
;; The ring itself is pushed by the kill commands through `ed-push-kill` (below); what
;; every YANK site shares — the buffer's `C-y`, the minibuffer's, isearch's — is the
;; question "what text does a yank insert right now?", which first asks the OS
;; clipboard whether another app copied something newer. That lives here, on the model,
;; so a transient input (a search, a prompt) can paste without reaching into `commands`.

;; Cap the ring like Emacs's `kill-ring-max` (default 60) so it can't grow forever.
(def ed-kill-ring-max 60)

(defn ed-adopt-clipboard (m)
  "If the OS clipboard holds text that isn't already the kill-ring head (i.e. something
was copied in another app since our last kill), cons it on as the freshest entry so the
next yank inserts it — Emacs's `interprogram-paste-function`. Off unless the model opts
into the OS clipboard (`:os-clipboard`, set by the live editor); best-effort otherwise: a
missing / unavailable clipboard leaves the ring untouched."
  (if (not (:os-clipboard m))
    m
    (let (clip (try
                 (os/clipboard-get)
                 (catch e (do (log/warn (str "clipboard read failed: " (error-message e))) nil)))
          ring (:kill-ring m))
      (if (and (string? clip) (not (= clip "")) (not (= clip (first ring))))
        (assoc m :kill-ring (take (cons clip ring) ed-kill-ring-max))
        m))))

;; ---- a guest's session: editing what it was given, nothing more (brood ADR-415) -------
;; A guest attaches over a link that can carry no code and reach nothing it was not given —
;; but the session it reaches is an editor, and an editor opens files, runs shells and
;; evaluates code. So a guest's session (`:guest-session`, set from the attach identity
;; brood's `editor/serve` marks) runs an ALLOWLIST: the general editing, motion, search and
;; pane commands, vim's editing grammar, and following someone's caret. Opening a file,
;; writing one under another name, every feature module — shells, terminals, eval, git,
;; the debugger, packages — is refused. An allowlist, because a denylist is only as good as
;; the last command someone remembered to add to it.

(def- ed-guest-modules #{"commands" "vim" "collab-commands"})

;; the general commands that reach past the buffers a session was given
(def- ed-guest-refused
  #{'commands/cmd-find-file
    'commands/cmd-find-file-other-window 'commands/cmd-write-file 'commands/cmd-insert-file
    'commands/cmd-recentf 'commands/cmd-visit-location 'commands/cmd-project-find-file
    'commands/cmd-project-switch 'commands/cmd-project-kill-buffers 'commands/cmd-reload-config
    'commands/cmd-reload-grammars 'commands/cmd-buffer-server-start 'commands/cmd-buffer-server-stop})

(defn- ed-command-module (command)
  ;; the module part of a qualified command symbol — `commands` for `commands/cmd-undo`
  (let (text (->string command)
        slash (index-of text "/"))
    (if (> slash 0) (string/substring text 0 slash) "")))

(defn ed-guest-allows? (command)
  "Whether a guest's session may run `command` — a command symbol, or `:self-insert`."
  (or (= command :self-insert)
    (and (symbol? command)
      (includes? ed-guest-modules (ed-command-module command))
      (not (contains? ed-guest-refused command)))))

(defn ed-guest-allows-name? (name)
  "Whether a guest's session may run the M-x command `name`: one of the allowed modules'
`cmd-<name>`."
  (any? ed-guest-modules
    (fn (module)
      (let (command (symbol (str module "/cmd-" name)))
        ;; the command must EXIST there: `vim/cmd-find-file` is allowed by its module and
        ;; is not a command at all
        (and (bound? command) (ed-guest-allows? command))))))

(defn ed-guest-refusal (m)
  "`m` saying a guest's session does not run that."
  (message m "not in a guest session — a guest edits what it was given"))

;; ---- one ring for every frame ------------------------------------------------
;; A frame (C-x 5 2) is its own process with its own model, so each used to keep its own
;; ring: kill in one window, and M-y in the other could not reach it — only the OS
;; clipboard's single entry crossed. The ring now lives in an AGENT (`std/proc/agent`, a
;; process holding a value) that the live editor starts and every frame inherits
;; (`:kill-agent`). A kill publishes the whole ring there; a yank adopts it first, the way
;; it already adopts the OS clipboard. Tests build models without one and keep a local ring.

(defn ed-start-kill-agent ()
  "Start the process that holds the kill ring every frame shares; its pid."
  (agent/start (fn () '())))

(defn- ed-shared-ring (m)
  "The ring in the model's kill agent, or nil when it has none (or the agent is gone)."
  (let (kill-agent (:kill-agent m))
    (when (pid? kill-agent)
      (check-allow :discarded-catch
        (try (agent/get kill-agent identity) (catch _ nil))))))

(defn ed-set-kill-ring (m ring)
  "`m` with `ring` as its kill ring, published to the frames' shared agent when it has one.
`update`, not `cast`: the yank that follows a kill must find the kill there."
  (let (kill-agent (:kill-agent m))
    (when (pid? kill-agent)
      (check-allow :discarded-catch
        (try (agent/update kill-agent (fn (_) ring)) (catch _ nil))))
    (assoc m :kill-ring ring)))

(defn ed-adopt-shared-ring (m)
  "`m` with the ring every frame shares, when another frame has changed it."
  (let (shared (ed-shared-ring m))
    ;; `nil` is a list too (the empty one), and is what a model with no agent gets back
    (if (and (not (nil? shared)) (list? shared) (not (= shared (:kill-ring m))))
      (assoc m :kill-ring shared)
      m)))

(defn ed-kill-head (m)
  "`[m' text]`: the text a yank inserts now — the kill-ring head after adopting the ring
the frames share and then the OS clipboard — or `[m' nil]` when the ring is empty."
  (let (shared (ed-adopt-shared-ring m)
        m1 (ed-adopt-clipboard shared)
        ;; a clipboard entry adopted here belongs to every frame's ring too
        m2 (if (= (:kill-ring m1) (:kill-ring shared)) m1 (ed-set-kill-ring m1 (:kill-ring m1)))
        ring (:kill-ring m2))
    [m2 (if (empty? ring) nil (first ring))]))

;; ---- pushing onto the ring: what a kill or a copy does ----------------------
;; Commands whose consecutive use coalesces into one kill-ring entry (like Emacs).
;; Every command that kills, so consecutive kills coalesce into one entry (Emacs
;; `kill-append`). `cmd-copy-region` is here on purpose: Emacs's copy-region-as-kill appends
;; after a kill too. A kill command left off this list silently starts a new entry —
;; `M-k M-k` used to leave two sentences on the ring instead of one.
(def- ed-kill-commands
  '(commands/cmd-kill-region commands/cmd-copy-region
     commands/cmd-kill-line commands/cmd-kill-word commands/cmd-backward-kill-word
     commands/cmd-kill-whole-line commands/cmd-sexp-kill commands/cmd-kill-sentence
     commands/cmd-backward-kill-sentence commands/cmd-kill-sexp commands/cmd-backward-kill-sexp
     commands/cmd-zap-to-char))

(defn- ed-kill-command? (sym) (includes? ed-kill-commands sym))

(defn ed-push-kill (m text forward?)
  "Push killed `text` onto the kill ring. If the previous command was also a kill,
**append** to the current head entry instead of starting a new one — at the end for
a forward kill, the front for a backward kill (Emacs's consecutive-kill coalescing).
Otherwise cons a fresh entry. The new ring head is also mirrored to the OS clipboard
(`os/clipboard-set`, itself a no-op without a clipboard) so every kill / copy is system-wide — Emacs's
`interprogram-cut-function` / `select-enable-clipboard`; `cmd-yank` reads it back."
  (let (ring (:kill-ring (ed-adopt-shared-ring m))
        coalesce? (and (ed-kill-command? (:last-command m)) (not (empty? ring)))
        head (if coalesce?
               (if forward? (str (first ring) text) (str text (first ring)))
               text)
        tail (if coalesce? (rest ring) ring))
    ;; `os/clipboard-set` is itself a no-op without a clipboard, so nothing here is guarded:
    ;; a stale name must raise, not leave every kill un-mirrored.
    (when (:os-clipboard m) (os/clipboard-set head))
    (ed-set-kill-ring m (take (cons head tail) ed-kill-ring-max))))

(defn ed-drag-copy (m)
  "Emacs `mouse-drag-copy-region`: when a mouse drag-select ends with a real region,
copy it to the kill ring — and thus the OS clipboard (`ed-push-kill`) — WITHOUT clearing
it, so releasing a highlight makes it immediately paste-able in any buffer, read-only or
not. Silent (no echo — a drag shouldn't spam the echo area). A plain click selects
nothing, so it's a no-op. Coalescing is suppressed (`:last-command` cleared) so the
selection is its own entry, never appended to a prior kill."
  (let (text (buffer-region (ed-current-buf m)))
    (if (nil? text) m (ed-push-kill (assoc m :last-command nil) text true))))

;; ---- OS window title --------------------------------------------------------

(defn ed-reds-human (n)
  "A reduction count short (`1.2M` / `194k` / `42`) — the app-run telemetry's work
metric."
  (cond
    (>= n 1000000) (str (math/quot n 1000000) "." (math/quot (math/rem n 1000000) 100000) "M")
    (>= n 1000) (str (math/quot n 1000) "k")
    else (str n)))

(def *app-name*
  ;; The editor's display name, as a human reads it: the OS title bar's suffix, and
  ;; the placeholder title `main` opens the window with before the first event
  ;; produces a real one. Distinct from `config/*app-id*`, the machine-facing
  ;; identity the desktop matches a window to its `.desktop` entry by.
  "bedit")

(defn ed-window-title (m)
  "OS title bar: `name` [*] [— branch] — bedit.
`*` when the current buffer has unsaved changes to its file; what the work is on (git branch, mur change) from the VC summary when present."
  (let (buf (ed-current-buf m)
        name (buffer-name buf)
        modified (if (and (buffer-file buf) (buffer-modified? buf)) " *" "")
        branch (:label (:vcs-summary m))
        branch-seg (if (nil? branch) "" (str " — " branch)))
    (str name modified branch-seg " — " *app-name*)))
