(defmodule model
  "The editor's `ui-run` model, the `*Messages*` log + echo area, and the
scrolling that keeps the point on screen.

The model is a map threaded through the `ui-run` loop:

  :buf      the buffer being edited
  :top      the first visible line (scroll offset)
  :status   the mode-line message
  :msgs      a `*Messages*` buffer — the scrollback of everything `message` logs
  :echo     the one-line echo area (the latest message, newlines flattened)
  :pending  the active prefix sub-keymap mid-chord (e.g. after C-x), else nil
  :done     set to quit; :tick-ms the refresh beat (large — nothing animates)

The buffers hold process-local ropes and the whole loop runs in one process, so
they live in the model directly. `message` is the editor's echo primitive —
like Emacs `message`, it writes to *both* the `*Messages*` buffer and the echo
area; eval output reaches it via `with-out-str`, so it never hits the console."
  (:use buffer))  ; make-buffer / insert / end-of-buffer / accessors

(defn ed-init (buf)
  "The starting model: editing `buf`, scrolled to the top, with an empty
`*Messages*` buffer and echo area and no prefix pending."
  {:buf buf
   :top 0
   :status (str "editing " (buffer-name buf))
   :msgs (make-buffer "" "*Messages*")
   :echo ""
   :pending nil
   :done false
   :tick-ms 60000})

(defn one-line (s)
  "Collapse newlines in `s` to spaces — the echo area is a single row, while the
full multi-line text is kept in the `*Messages*` buffer."
  (apply str (map (fn (c) (if (= c "\n") " " c)) (string->list s))))

(defn message (m s)
  "Log `s`: append it as a line to the `*Messages*` buffer and show it (flattened
to one line) in the echo area. The editor's only output sink — commands print
here, never to the console."
  (let (msgs (get m :msgs))
    (assoc m
      :echo (one-line s)
      :msgs (insert (end-of-buffer msgs) (str s "\n")))))

(defn ed-scroll (m textrows)
  "Adjust `:top` so the point's line stays inside a `textrows`-tall viewport:
scroll up if it's above the top, down if it's below the bottom. Pure."
  (let (line (buffer-current-line (get m :buf))
        top (get m :top))
    (cond
      (< line top) (assoc m :top line)
      (>= line (+ top textrows)) (assoc m :top (inc (- line textrows)))
      else m)))
