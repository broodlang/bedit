(defmodule gitdiff
  "diff-hl-style change gutter: per-line indicators (added / modified / deleted vs git
HEAD), painted as a coloured bar in the left of the line-number gutter. The per-line status
is computed by `git diff --no-index` of the buffer's text against the HEAD blob and cached on
the buffer under `:git-line-status` (a `{0-based-line -> :added|:modified|:deleted}` map), so
the gutter cell — which sees only the buffer — can paint it without the model. The model-level
recompute (off the loop, re-armed on edit/save) lives in `model/ed-launch-gitdiff`.

`gitdiff-head-text` / `gitdiff-status-map` shell out to git (a subprocess each) and are
unit-tested against real git without the editor (tests/gitdiff_test.blsp)."
  (:use editor/buffer)) ; buffer-file / buffer-text
;; `theme` (a project source module, loaded with the image) provides the *green* /
;; *yellow* / *red* dynamic-var colour globals this file reads bare.
;; ---- faces + glyphs ---------------------------------------------------------

(def face-diff-added {:fg *green*})
(def face-diff-modified {:fg *yellow*})
(def face-diff-deleted {:fg *red*})

(defn bar-glyph (status)
  "The 1-char gutter bar for a line's git `status`: a solid bar for a present change, a thin
underbar where lines were deleted, a space for an unchanged line."
  (cond (= status :deleted) "▁" (nil? status) " " :else "▌"))

(defn bar-face (status)
  "The face for a line's git `status` bar, or nil for an unchanged line."
  (cond
    (= status :added) face-diff-added
    (= status :modified) face-diff-modified
    (= status :deleted) face-diff-deleted
    :else nil))

(defn bar-chunk (status)
  "The gutter change-bar CHUNK for a line's git `status`: `[:bar colour]` for a present
add/modify — the renderer lowers it to a solid full-height rule (a GUI `frect`, or `▌` in
the terminal) — a thin `▁` underbar glyph at a deletion marker, and a blank otherwise.
`colour` is the diff face's foreground hex. Replaces the old `[▌ face]` glyph chunk, which
read as a dashed TUI bar at the editor's 1.4 line-height."
  (cond
    (nil? status) [" " nil]
    (= status :deleted) ["▁" face-diff-deleted]
    :else [:bar (:fg (bar-face status))]))

;; ---- HEAD blob --------------------------------------------------------------

(defn- gitdiff-basename
  (path)
  (let (i (last-index-of path "/"))
    (if (< i 0) path (string/substring path (+ i 1) (string/length path)))))

(defn- gitdiff-head-text
  (path)
  "The HEAD version of the file at `path` as text, or nil when it isn't a tracked file (a
new/untracked file, or not in a git repo). `git -C <dir> show HEAD:./<name>` resolves the
blob relative to the file's own directory, so it works at any repo depth."
  (let (dir (parent-dir path)
        r (%os-cmd "git" ["-C" dir "show" (str "HEAD:./" (gitdiff-basename path))]))
    (if (= (:exit r) 0) (:stdout r) nil)))

;; ---- the line diff → per-line status map (native `git diff`) ----------------
;; diff-hl runs the diff through **git itself** (`git diff --no-index`), not a hand-rolled
;; Brood diff. Two reasons: git's C diff is fast on a heavily-edited file (where an
;; interpreted O(N·D) diff lags), and — crucially — git places an inserted/deleted line at
;; the *intuitive* boundary (its indent heuristic). A minimal-edit script is mathematically
;; correct but attributes a change to the *earliest* equivalent line, so adding a line inside
;; a run of similar lines (closing parens, blank lines, …) showed the bar lines above where
;; you typed. Routing through git makes the gutter match what `git diff` / the terminal show.

(defn- gitdiff-strip-nl
  (s)
  "`s` without a single trailing newline (so head and buffer align — `git show` always ends
in one; the buffer may not, and a lone trailing-newline difference isn't a real change)."
  (if (and (> (string/length s) 0)
        (= (string/substring s (dec (string/length s)) (string/length s)) "\n"))
    (string/substring s 0 (dec (string/length s)))
    s))

(defn- gitdiff-spec
  (tok)
  "Parse a hunk-header side like `\"21,0\"` → `[21 0]`, or `\"22\"` → `[22 1]` (an omitted
count means 1, per unified-diff)."
  (let (parts (string/split tok ",")
        start (or (string->number (first parts)) 0))
    (if (> (count parts) 1) [start (or (string->number (nth parts 1)) 0)] [start 1])))

(defn- gitdiff-apply-hunk
  (acc oc ns nc)
  "Fold one `@@ -…,oc +ns,nc @@` hunk into the status `acc` (0-based buffer lines): `nc` new
lines from `ns` (1-based) are the change — the first `min(oc,nc)` are `:modified` (they
replace deleted lines), the rest `:added`. A pure deletion (`nc = 0`) marks the line that
follows it (`ns`, 0-based) `:deleted`."
  (if (= nc 0)
    (assoc acc ns :deleted)
    (let (base (dec ns) nmod (min oc nc))
      (fold (fn (a j) (assoc a (+ base j) (if (< j nmod) :modified :added))) acc (range nc)))))

(defn- gitdiff-parse-diff
  (out)
  "Fold the `@@` hunk headers of a `git diff --unified=0` `out` into a
`{0-based-buffer-line -> :added|:modified|:deleted}` map (non-header lines ignored)."
  (fold
    (fn (acc line)
      (if (and (string/starts-with? line "@@") (>= (index-of line " @@" 3) 0))
        (let (seg (string/substring line 3 (index-of line " @@" 3)) ; \"-21,0 +22\"
              toks (string/split seg " ")
              mtok (string/substring (first toks) 1 (string/length (first toks)))
              ptok (string/substring (nth toks 1) 1 (string/length (nth toks 1)))
              [_ oc] (gitdiff-spec mtok)
              [ns nc] (gitdiff-spec ptok))
          (gitdiff-apply-hunk acc oc ns nc))
        acc))
    {}
    (string/split out "\n")))

(defn- gitdiff-status-map
  (head buf-text)
  "A `{0-based-buffer-line -> :added|:modified|:deleted}` map for `buf-text` vs `head`, via
`git diff --no-index --unified=0` over temp files (so it also works for an unsaved buffer).
Trailing-newline-only differences are ignored (`gitdiff-strip-nl`). Returns `{}` on a git
error. Plain strings in, plain map out — safe to run inside a spawned worker."
  (let (dir (string/trimr (:stdout (%os-cmd "mktemp" ["-d"])))
        ht (str dir "/head")
        bt (str dir "/buf")
        ;; normalise to exactly one trailing newline on each side: strips a lone
        ;; trailing-newline difference AND gives both files proper line termination, so git
        ;; never emits a `\ No newline at end of file` that would flag the last line as changed.
        _ (file/spit ht (str (gitdiff-strip-nl head) "\n"))
        _ (file/spit bt (str (gitdiff-strip-nl buf-text) "\n"))
        r (%os-cmd "git" ["diff" "--no-index" "--unified=0" ht bt])
        _ (%os-cmd "rm" ["-rf" dir]))
    ;; --no-index exits 0 when identical, 1 when they differ; anything higher is an error.
    (if (<= (:exit r) 1) (gitdiff-parse-diff (:stdout r)) {})))

;; ---- annotate a buffer ------------------------------------------------------

(defn gitdiff-status (path text)
  "The `{0-based-line -> :added|:modified|:deleted}` diff map for the file at `path`
(vs its HEAD blob) given its current `text` — an empty map when the file isn't tracked
/ not in a repo. **Plain data in, plain data out**: it takes the text as a string (not a
buffer/rope), so it can run inside a spawned task that has no buffer handle (the rope is
process-local). The editor folds the result onto the buffer's `:git-line-status`."
  (let (head (gitdiff-head-text path))
    (if (nil? head) {} (gitdiff-status-map head text))))

(defn gitdiff-annotate (buf)
  "Return `buf` with `:git-line-status` set to its per-line diff vs HEAD — an empty map when
the file isn't tracked / not in a repo (so the gutter shows the bar column but no colours).
A fileless buffer is returned unchanged (no status key — never gets a diff gutter). The
synchronous wrapper over `gitdiff-status`, used on the headless path; the live editor runs
`gitdiff-status` off the loop (see `model/ed-launch-gitdiff`)."
  (let (path (buffer-file buf))
    (if (nil? path)
      buf
      ;; one annotation, stamped with the text it describes (std `annotate`) — the
      ;; bars draw only while positionally current, which is what blanks them the
      ;; moment a line is inserted rather than drawing every bar one line off
      (editor/buffer/annotate buf
        :git-line-status
        (gitdiff-status path (buffer-text buf))))))
