(defmodule languages
  "**Languages** — what the editor knows of each kind of file it opens: its mode, its colours,
its indentation, its structure.

**The authoring surface.** A language is a module that `(:use languages)` and declares ONE spec
with [[deflanguage]] (a tree-sitter grammar), [[deflexer]] (a line lexer) or [[deflisp]] (an
s-expression dialect), with the face-table helpers and the shared string, pair, restart and
formatter tables below. bedit's own languages (`src/languages/<lang>.blsp`) and a language
package's (`bedit-lang-<lang>`, docs/packages.md \"A language package\") are written the same
way, against this module only: the machinery behind it is the context's detail.

The context's details live under `src/languages/`: the shared core every tree-sitter mode is
declared through (`languages/core`), one module per language (`languages/rust`,
`languages/python`, `languages/hcl` for HCL and Terraform, `languages/json` for JSON and its
variants, …, the line-lexed formats in `languages/formats`, the Lisps one module a dialect over `languages/lisps`, Brood
itself in `languages/brood`), the lexers for formats with no grammar (`languages/lex-*`),
Markdown — its lexer, its mode and its rendered preview (`languages/markdown`,
`languages/markdown-preview`) — and a buffer's definitions read from its parse
(`languages/crumbs`). The mode registry the languages register with is `modes`, and the
held parse tree `syntaxtree`; bracket matching over a tree is `tsbrackets`.

A mode is reached through its file type: each registers at load (the project's image carries
the registrations, so none is loaded until a buffer of its kind is). Other contexts use the
functions below.")

;; ---- declaring a language: the one template, for bedit's languages and a package's ------
;; A macro cannot be delegated (`defdelegate` forwards a call), so each is a macro here that
;; expands to the core's; the core's macro names what it generates by the module it expands
;; in (`reflect/current-ns`), which is the language's own.

(defmacro deflanguage (name spec)
  "Declare a tree-sitter language mode from ONE spec, and register it: its fontify, indenter,
restart, folds, breadcrumbs, layer and registration are generated from the spec, and a key it
does not take raises at load. The spec's keys are `languages/core/deflanguage`'s docstring.

    (deflanguage zig
      {:lang :zig
       :pattern \"[.]zig$\"
       :faces zig-face-table
       :indent {:width 4 :brackets #{:block}}
       :grammar {:url \"https://github.com/tree-sitter-grammars/tree-sitter-zig\"
                 :revision \"b670c8df85a1568f498aa5c8cae42f51a90473c0\"
                 :fingerprint \"0f7a…\"}
       :comment \"// \"})"
  `(languages/core/deflanguage ~name ~spec))

(defmacro deflexer (name spec)
  "Declare a line-lexed language mode from ONE spec (`:pattern`, `:lexer` the stem of a module's
`-spans` and `-line-lexer`), and register it — `languages/core/deflexer`'s docstring has the
keys."
  `(languages/core/deflexer ~name ~spec))

(defmacro deflisp (name spec)
  "Declare an s-expression dialect from ONE spec (`:pattern`, `:specials`, `:indent`), over
Brood's own reader, lexer and structural motions, and register it —
`languages/lisps/deflisp`'s docstring has the keys."
  `(languages/lisps/deflisp ~name ~spec))

;; the face-table helpers: entries to `merge` into a table beside its one-off rows
(defdelegate token-faces (tokens face) languages/core)
(defdelegate field-faces (kinds field face) languages/core)
(defdelegate method-call-faces (members) languages/core)
(defdelegate call-faces (members) languages/core)

;; a Lisp's special forms, and Emacs's Lisp indent rule over them
(defdelegate head-set (names) languages/lisps)
(defdelegate lisp-indent-with (specials text bol &optional indents) languages/lisps)

;; The tables more than one language shares — the core's, named here so a language needs no
;; other module. `:pairs` (electric pairs): the brackets and both quotes, plus a backtick.
(def *quote-pairs* languages/core/*quote-pairs*)
(def *backtick-pairs* languages/core/*backtick-pairs*)
;; `:strings` (`stringstate`): `#` comments and both quotes; C's `//` and `/* */`
(def *hash-strings* languages/core/*hash-strings*)
(def *c-strings* languages/core/*c-strings*)
;; `:restart`'s `:opaque`: what may hold anything, so no column-0 line inside it is an item start
(def *block-comment-opaque* languages/core/*block-comment-opaque*)
(def *triple-quote-opaque* languages/core/*triple-quote-opaque*)
(def *backtick-opaque* languages/core/*backtick-opaque*)
;; `:heredocs`: paired multi-line string markers (Elixir's, Python's)
(def *triple-quote-heredocs* languages/core/*triple-quote-heredocs*)
;; `:format`: prettier, in place
(def *prettier* languages/core/*prettier*)

;; ---- Brood's own mode (languages/brood) -------------------------------------------------

(defdelegate brood-indent (text bol) languages/brood)
(defdelegate brood-eldoc (text pos) languages/brood)
(defdelegate brood-complete-at (text pos) languages/brood)

;; ---- a buffer's definitions, read from its parse (languages/crumbs) ---------------------

(defdelegate tree-definitions (lang buffer tree) languages/crumbs)
(defdelegate form-definitions (buffer) languages/crumbs)

;; ---- the declared languages (languages/core, languages/lisps) ---------------------------

(defdelegate declared-grammars () languages/core)

(defn spec-problem (type spec)
  "Why the registered spec of the mode `type` fails its declaring macro's key check
(`languages/core/check-spec`), or nil when it passes; the macro is told from the keys only it
has (`:lang` a tree-sitter language, `:lexer` a lexed one, else a Lisp dialect)."
  (let (kind (cond
               (contains? spec :lang) languages/core/deflanguage-kind
               (contains? spec :lexer) languages/core/deflexer-kind
               else languages/lisps/deflisp-kind))
    (check-allow :discarded-catch
      (try
        (do (languages/core/check-spec kind type spec) nil)
        (catch e (str (pr-str type) ": " (if (map? e) (:message e) (pr-str e))))))))
