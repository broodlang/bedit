(defmodule imageview
  "Viewing an image (Emacs's image-mode): a PNG, JPEG, GIF, WebP or BMP opens as a picture rather
than as hex. The pane paints it with brood's `[:image …]` display op (brood ADR-686), never
larger than its own size, from the pane's top-left: a window paints it at its full pixel
resolution, a terminal in half-block cells (`▀`, two pixels a cell) — one op for both, decoded
once per content by brood. The buffer is read-only; its one line names the image. A file that
does not decode opens as the hex view, as any binary."
  (:use editor/buffer) ; the buffer that holds the image
  (:use editor/display :only [image]) ; the picture op
  (:use model) ; register-presenter / register-pane-layer / message
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use pool :only [ed-show-named]) ; the buffer it shows in
  (:use projects :only [file-display-name])) ; its name in a project

(defn ed-open-image (m path root bytes)
  "Open the image at `path` (`bytes` its contents, already read) as an `:image` buffer — or as the
hex view when it does not decode."
  (let (probe (gui/image-thumb bytes 4096 4096))
    (if (nil? probe)
      (hexl/ed-open-binary m path root bytes)
      (let (title (str (string/upper (string/replace (or (path/extension path) "image") "." ""))
                    " "
                    (:width probe)
                    "×"
                    (:height probe)
                    " — "
                    (path/basename path)
                    "\n")
            shown (ed-show-named m (file-display-name path root) title :image))
        (message (ed-set-buf shown
                   (assoc (set-read-only (ed-current-buf shown) true)
                     :file path
                     :dir (path/dirname path)
                     :image-bytes bytes))
          (str "image " (:width probe) "×" (:height probe)))))))

;; ---- the picture ------------------------------------------------------------------

(def- image-placement
  ;; Emacs's image-mode: never enlarged past its own size, from the pane's top-left corner. A
  ;; buffer's own `:image-placement` overrides it (doc-view fits a page to the pane).
  {:fit :scale-down :align :top-left})

(defn image-layer (m pane buf geometry)
  "The pane layer: an `:image` buffer's picture under its title line, fitted to the pane — one
`[:image …]` op (brood ADR-686), which a window paints at its full pixel resolution and a
terminal in half-block cells, two pixels a cell."
  (let (bytes (:image-bytes buf))
    (if (nil? bytes)
      '()
      (let ([left width] (panegeometry/geometry-span geometry :text)
            height (math/max 1 (dec (:text-height geometry)))
            top (inc (:y geometry)))
        (list (image top left width height bytes (or (:image-placement buf) image-placement)))))))

(defn image-deps (m pane buf)
  "What the layer reads besides the text: the image and where it is placed."
  [(:image-bytes buf) (:image-placement buf)])

(register-presenter :image 'imageview/ed-open-image)
(register-pane-layer :image
  {:rank 5 :slot :with-text :run 'imageview/image-layer :deps 'imageview/image-deps})

(def image-mode-layer
  {:name 'image
   :doc "An image, painted in the pane — q quits."
   ;; its text is a stand-in for the picture: C-x C-q has nothing to make writable
   :writable {:never "an image view shows the picture; edit the file itself"}})

(modes/register-special-type :image 'imageview/image-mode-layer)
