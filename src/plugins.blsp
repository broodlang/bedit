(defmodule plugins
  "Plugin discovery + loading for bedit — the editor folding in packages that
`:enhances bedit`. A plugin is an ordinary hive package: `nest add` it and its source
lands under `_deps/<name>/` on the load-path. Its manifest declares
`:enhances {bedit \"<range>\"}` (Debian's `Enhances:` — 'I add to bedit', a soft signal,
never a hard dep) and its entry module — named for the package — exposes `(bedit-plugin)`,
a contribution map. bedit reads `:themes` from that map today; the map is open, so
`:keymaps`/`:modes` slot in later beside it without touching discovery.

The reusable half — 'does this `:enhances` map accept the bedit I am?' — is std's
`version/version-satisfies-all?` (built for exactly this; ADR-209, its docstring is our
case verbatim). What lives HERE is bedit's *policy*: look under `_deps/`, take the entry
module to be the package name, and apply each contribution kind.

Two layers, deliberately split: `enhancers`/`dep-enhances` are **pure discovery** (read
manifests, decide who qualifies — no side effects, so they test against a fixture `_deps`);
`load-plugins!` is the **apply** step (`require` the module, rebind the global theme
registry). A missing `_deps`, no enhancers, or a plugin that throws are all no-ops — a
plugin can never take the editor down."
  (:use version)  ; version-satisfies-all? — the std :enhances check
  (:use themes))  ; register-theme! — fold a contributed palette into M-x theme-select
;; What a plugin's `:enhances {bedit …}` constraint is checked against. Kept in lockstep
;; with project.blsp's :version — a plugin needing a newer bedit than this is declined.
(def *bedit-version* "0.1.0")

(defn- plist-get (plist key)
  "The value after `key` in a plist (`(:a 1 :b 2)`), or nil — a local copy so this module
needn't pull in the whole `project` tool just to walk a manifest."
  (cond
    (or (nil? plist) (nil? (rest plist))) nil
    (= (first plist) key) (first (rest plist))
    :else (plist-get (rest (rest plist)) key)))

(defn dep-enhances (root name)
  "The `:enhances` map the dep `name` declares under `root/_deps`, or {} — read its
`(project …)` manifest and pluck `:enhances`. Missing/unreadable/malformed ⇒ {}."
  (try
    (let (form (read-string (slurp (str root "/_deps/" name "/project.blsp"))))
      (if (and (list? form) (= (first form) 'project))
        (or (plist-get (rest form) :enhances) {})
        {}))
    (catch e {})))

(defn enhances-bedit? (enhances)
  "Whether an `:enhances` map qualifies its package as a bedit plugin: it must name bedit
AND its constraint accept `*bedit-version*`. The `get 'bedit` guard comes first because an
EMPTY map vacuously 'satisfies all' — so naming bedit is what actually gates, keeping a
plain dependency (or a package that enhances something else) out."
  (and (get enhances 'bedit)
    (version-satisfies-all? {'bedit *bedit-version*} enhances)))

(defn enhancers (root)
  "The names of packages under `root/_deps` that `enhances-bedit?`. Pure: reads manifests,
`require`s nothing. An absent `_deps` (no deps fetched) is an empty list."
  (if (not (file-exists? (str root "/_deps")))
    []
    (vec (filter (fn (name) (enhances-bedit? (dep-enhances root name)))
           (list-dir (str root "/_deps"))))))

(defn- apply-one! (name)
  "`require` plugin `name`, call its `(bedit-plugin)` entry, and fold its contribution into
the global registries (themes today). Returns true if its entry loaded, false if the module
lacks the entry or throws — one bad plugin never blocks the rest."
  (try
    (do
      (require (symbol name))
      (let (entry (eval (symbol (str name "/bedit-plugin"))))
        (if (fn? entry)
          (do
            (doseq (theme (or (:themes (entry)) [])) (register-theme! theme))
            true)
          false)))
    (catch e false)))

(defn load-plugins! (root)
  "Discover installed `:enhances bedit` packages under `root` and fold each one's
contribution into the editor's global registries (`themes/*themes*` today). Returns the
vector of plugin names that loaded, in discovery order — the caller logs/echoes the summary.
The only effect is the registry rebinds, so it is idempotent (`register-theme!` replaces by
name). Safe with no `_deps` / no plugins ⇒ []."
  (keep (fn (name) (when (apply-one! name) name)) (enhancers root)))
