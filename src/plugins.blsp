(defmodule plugins
  "Plugin loading for bedit — the editor folding in packages that `:enhances bedit`. A
plugin is an ordinary hive package: `nest add` it and its source lands under `_deps/<name>/`
on the load-path. Its manifest declares `:enhances {bedit \"<range>\"}` (Debian's `Enhances:`
— 'I add to bedit', a soft signal, never a hard dep) and its entry module — named for the
package — exposes `(bedit-plugin)`, a contribution map. bedit reads `:themes` from that map
today; the map is open, so `:keymaps`/`:modes` slot in later beside it.

DISCOVERY is std's job: `project/installed-enhancers` walks `_deps/`, reads each manifest's
`:enhances`, and keeps those naming bedit at a satisfied version — the runtime sibling of the
registry's `nest search --enhances` (ADR: the reusable half lives in `std/tool/project`, so
every plugin-hosting app shares it). What lives HERE is bedit's POLICY: the entry-module
convention and how each contribution kind is applied. Loading a plugin that lacks the entry,
or throws, is skipped — one bad plugin never blocks the rest or the editor."
  (:use themes))  ; register-theme! — fold a contributed palette into M-x theme-select
;; What a plugin's `:enhances {bedit …}` constraint is checked against. Kept in lockstep
;; with project.blsp's :version — a plugin needing a newer bedit than this is declined.
(def *bedit-version* "0.1.0")

(defn- apply-one! (name)
  "`require` plugin `name`, call its `(bedit-plugin)` entry, and fold its contribution into
the global registries (themes today). Returns true if its entry loaded, false if the module
lacks the entry or throws."
  (try
    (do
      (require (symbol name))
      (let (entry (eval (symbol (str name "/bedit-plugin"))))
        (if (fn? entry)
          (do
            (doseq (theme (or (:themes (entry)) [])) (register-theme! theme))
            true)
          false)))
    (catch e false)))

(defn load-plugins! (root)
  "Discover the `:enhances bedit` packages installed under `root` (via
`project/installed-enhancers`) and fold each one's contribution into the editor's global
registries (`themes/*themes*` today). Returns the vector of plugin names that loaded, in
discovery order — the caller logs the summary. Idempotent (`register-theme!` replaces by
name); no `_deps` / no plugins ⇒ []."
  (require 'project)
  (vec (keep (fn (name) (when (apply-one! name) name))
         (project/installed-enhancers root "bedit" *bedit-version*))))
