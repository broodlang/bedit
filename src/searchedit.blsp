(defmodule searchedit
  "Editable search results: Emacs's wgrep over *Project Search* and occur-edit-mode over *Occur*.
`C-c C-p` in *Project Search* (or `e` in *Occur*) makes the text of every row editable — the
`file:line:` / `N:` before it stays read-only (`editspans`, so no edit path can touch it) — and
`C-c C-c` writes each changed row back to its line, `C-c C-k` puts the rows back (`C-x C-q`, in
the results as in Dired, starts the edit and leaves it again — the modes' `:writable`). The files
(the buffer an *Occur* searched) are edited in their buffers, left modified for C-x s, as wgrep
leaves them; a line that changed on its own since the search is skipped and said, never
overwritten. A project-wide replace is a search, `C-c C-p`, `M-%` over the rows (query-replace
keeps to what may be edited) and `C-c C-c`; `M-x project-query-replace-regexp` is those steps
in one."
  (:use editor/buffer) ; the rope, buffer-name / buffer-point
  (:use interactive) ; defcommand
  (:use model) ; ed-current-buf / ed-apply / message / ed-ding
  (:use modes :only []) ; register-type runs at load, after modes declares its kinds
  (:use pool :only [ed-find-file ed-return-to ed-project-root])) ; the files edited, and back; the project

;; ---- the rows ------------------------------------------------------------------

(defn- row-of (rope line root)
  ;; `{:line :file :source-line :start :end :text}` for a `file:line:text` row at buffer line
  ;; `line` — `:start`/`:end` the span of its text — or nil for any other line
  (let (start (text/line->char rope line)
        text (wrap/rope-line-text rope line)
        found (regex/find "^([^:\\n]+):([0-9]+):" text))
    (when found
      (let ([file-group line-group] (vec (:groups found))
            prefix (string/length (:text found)))
        {:line line
         :file (path/join root (:text file-group))
         :source-line (dec (reflect/read-string (:text line-group)))
         :start (+ start prefix)
         :end (+ start (string/length text))
         :text (string/substring text prefix (string/length text))}))))

(defn- search-rows (buffer)
  "Every result row of a *Project Search* `buffer`, top to bottom. The header lines (the mode
line, the search, the command) come first and match no row."
  (let (rope (buffer-rope buffer)
        root (or (:dir buffer) "."))
    (seq/keep (range 0 (text/line-count rope)) (fn (line) (row-of rope line root)))))

(defn- editing? (buffer) (editspans/editing? buffer))

(defn- begin-editing (m rows edit-type note)
  ;; the current results buffer with `rows` open for editing as `edit-type`, `note` said — or
  ;; why not
  (let (buffer (ed-current-buf m))
    (cond
      (editing? buffer) (message m "already editing — C-c C-c writes, C-c C-k puts back")
      (empty? rows) (ed-ding (message m "no result rows to edit"))
      else (message (ed-set-buf m (editspans/begin buffer rows edit-type)) note))))

(defn- row-with-break? (changes)
  ;; whether a changed row now holds a line break, which no line can
  (any? (map changes second) (fn (text) (includes? text "\n"))))

(defn- finish-editing (m buffer-name)
  ;; the results buffer read-only again, its rows as they now read
  (ed-update-named m buffer-name editspans/finish))

(defcommand cmd-search-edit-abort
  (m key)
  "Put every row back as the search found it and stop editing (C-c C-k)."
  (let (buffer (ed-current-buf m))
    (if (not (editing? buffer))
      (message m "not editing the results")
      (message (ed-set-buf m (editspans/finish (editspans/restore buffer))) "Edits put back"))))

;; ---- C-c C-p in *Project Search*: the rows become editable ---------------------------

(defcommand cmd-search-edit
  (m key)
  "Make *Project Search*'s rows editable (C-c C-p, wgrep's key): the text after each
`file:line:` may be changed, nothing else. C-c C-c writes the changes to the files, C-c C-k
puts the rows back."
  (begin-editing m
    (into [] (search-rows (ed-current-buf m)))
    :project-search-edit "Editing the results — C-c C-c writes them to the files, C-c C-k puts them back"))

(defn- write-file-rows (outcome [path changes])
  ;; `[model written skipped]` with `changes` (`[row new-text]`s of one file) applied to its
  ;; buffer, opened (or switched to) for it
  (let ([m written skipped] outcome
        opened (ed-find-file m path)
        [edited file-written file-skipped] (editspans/replace-lines (ed-current-buf opened) changes))
    [(if (> file-written 0) (ed-edit opened (fn (_) edited)) opened)
      (+ written file-written)
      (+ skipped file-skipped)]))

(defcommand cmd-search-edit-commit
  (m key)
  "Write the edited rows to their files (C-c C-c): each changed row replaces its line in its
file's buffer, left modified for C-x s. A line that no longer reads what the search found
(changed since) is skipped, and said."
  (let (buffer (ed-current-buf m)
        changes (editspans/changes buffer))
    (cond
      (not (editing? buffer)) (message m "not editing the results — C-c C-p starts")
      (row-with-break? changes)
        (ed-ding (message m "a row may not hold a line break — C-c C-k puts the rows back"))
      else
        (let (by-file (seq/group-by changes (fn ([row _]) (:file row)))
              [written-model written skipped] (fold (%map-pairs by-file) [m 0 0] write-file-rows)
              back (finish-editing (ed-return-to written-model
                                     (buffer-name buffer)
                                     (buffer-point buffer))
                     (buffer-name buffer)))
          (message back
            (str (ed-count-noun written "line")
              " changed in "
              (ed-count-noun (count by-file) "file")
              (if (> skipped 0)
                (str "; " (ed-count-noun skipped "line") " skipped (changed since the search)")
                "")
              (if (> written 0) " — C-x s saves" "")))))))

;; ---- e in *Occur*: occur-edit-mode ---------------------------------------------------
;; An *Occur* row is `N: text`, its source `{:buffer :line}` in `:line-links` (0-based row line →
;; the searched buffer's NAME and 1-based line). Emacs's occur-edit-mode writes each change to
;; the source as it is typed; here, as wgrep, C-c C-c writes them all and C-c C-k puts them back.

(defn- occur-row (rope line link)
  ;; the *Occur* row at buffer `line`, showing `link`'s source line, or nil
  (let (start (text/line->char rope line)
        text (wrap/rope-line-text rope line)
        found (regex/find "^[0-9]+: " text))
    (when found
      (let (prefix (string/length (:text found)))
        {:line line
         :source (:buffer link)
         :source-line (dec (:line link))
         :start (+ start prefix)
         :end (+ start (string/length text))
         :text (string/substring text prefix (string/length text))}))))

(defn- occur-rows (buffer)
  "Every *Occur* row of `buffer` with the source line it shows, top to bottom."
  (let (rope (buffer-rope buffer)
        links (or (:line-links buffer) {}))
    (seq/keep (sort (keys links))
      (fn (line) (when (< line (text/line-count rope)) (occur-row rope line (get links line)))))))

(defcommand cmd-occur-edit
  (m key)
  "Make *Occur*'s rows editable (e, Emacs's occur-edit-mode): the text after each `N:` may be
changed, nothing else. C-c C-c writes the changes to the lines of the buffer searched, C-c C-k
puts the rows back."
  (begin-editing m
    (into [] (occur-rows (ed-current-buf m)))
    :occur-edit "Editing the matches — C-c C-c writes them to the buffer, C-c C-k puts them back"))

(defn- write-source-rows (outcome [name changes])
  ;; `[model written skipped]` with `changes` written to the lines of the buffer named `name`;
  ;; a buffer since killed, or read-only, takes none of them
  (let ([m written skipped] outcome
        index (ed-buffer-index-by-name m name))
    (if (or (nil? index) (read-only? (ed-buf-at m index)))
      [m written (+ skipped (count changes))]
      (let ([edited source-written source-skipped] (editspans/replace-lines (ed-buf-at m index)
                                                     changes))
        [(if (> source-written 0) (ed-set-buf-at m index edited) m)
          (+ written source-written)
          (+ skipped source-skipped)]))))

(defcommand cmd-occur-edit-commit
  (m key)
  "Write the edited *Occur* rows to the buffer searched (C-c C-c): each changed row replaces its
line, left modified for C-x s. A line that no longer reads what occur found is skipped, and
said; so is a buffer since killed or read-only."
  (let (buffer (ed-current-buf m)
        changes (editspans/changes buffer))
    (cond
      (not (editing? buffer)) (message m "not editing the matches — e starts")
      (row-with-break? changes)
        (ed-ding (message m "a row may not hold a line break — C-c C-k puts the rows back"))
      else
        (let (by-source (seq/group-by changes (fn ([row _]) (:source row)))
              [written-model written skipped] (fold (%map-pairs by-source)
                                                [m 0 0]
                                                write-source-rows))
          (message (finish-editing written-model (buffer-name buffer))
            (str (ed-count-noun written "line")
              " changed"
              (if (> skipped 0) (str "; " (ed-count-noun skipped "line") " skipped") "")
              (if (> written 0) " — C-x s saves" "")))))))

;; ---- the modes -----------------------------------------------------------------
;; Typing is text-mode's and the colours the results buffer's: no layer below names a command
;; keymap, so `n`, `q` or `g` are letters while the rows are open. The keys are every edit
;; variant's (`editspans/edit-layer`): C-c C-c / C-x C-s write, C-c C-k / C-c ESC put back, C-x
;; C-q leaves, asking when anything changed — wgrep's keys, and occur-edit's C-c C-c.

(def search-edit-layer
  (editspans/edit-layer {:name 'search-edit}
    'searchedit/cmd-search-edit-commit 'searchedit/cmd-search-edit-abort))

(modes/register-type :project-search-edit
  (list 'searchedit/search-edit-layer 'project-search/project-search-layer 'modes/text-mode-layer))

(def occur-edit-layer
  (editspans/edit-layer {:name 'occur-edit}
    'searchedit/cmd-occur-edit-commit 'searchedit/cmd-search-edit-abort))

(modes/register-type :occur-edit (list 'searchedit/occur-edit-layer 'modes/text-mode-layer))

;; ---- M-x project-query-replace-regexp: the steps in one --------------------------------

(defn- replace-in-results (m regexp to)
  ;; the shown *Project Search* made editable and a query-replace of `regexp` over its rows;
  ;; C-c C-c then writes what was replaced
  (let (editing (cmd-search-edit m nil))
    (if (editing? (ed-current-buf editing))
      (query-replace/qr-start editing regexp to {:regexp? true})
      editing)))

(defcommand cmd-project-query-replace-regexp
  (m key)
  "Replace a regexp across the project (C-x p %, Emacs's project-query-replace-regexp): the
project is searched, the rows open for editing (C-c C-p), and a query-replace runs over them —
y / n / ! as M-% — after which C-c C-c writes the replaced rows to their files (C-c C-k puts
them back). Nothing reaches a file before C-c C-c."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project")
      (textops/ed-two-part-prompt m
        "Project query replace regexp: "
        (fn (regexp) (str "Project query replace regexp " regexp " with: "))
        (fn (answered regexp to)
          (if (string/blank? regexp)
            (message answered "(nothing to replace)")
            (project-search/ed-project-search answered
              root
              regexp
              (fn (shown) (replace-in-results shown regexp to)))))))))
