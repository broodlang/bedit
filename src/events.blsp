(defmodule events
  "What reaches the loop besides keys: the frontend's resize and mouse, a task's reply, a
process going down, redirected output, a client's identity. One handler per `[:tag …]`, by
symbol, so a handler redefined in the running editor is the one the next event uses; a
feature's own tags are registered by the feature (`model/register-event-handler`)."
  (:use editor/buffer)
  (:use model)
  (:use scroll) ; ed-scroll — a handler clamps the scroll itself
  (:use panes)
  (:use mouse) ; ed-mouse — the event folding
  (:use hittest) ; ed-modeline-click / ed-diag-hover / ed-link-hover / ed-menu-hit
  (:use menu) ; the right-click context menu
  (:use clipboard)
  (:use minibuffer :only [ed-apply-ranked])
  (:use commands :only []))

;; ---- inbound system / async events (the loop's event bus) -------------------
;; Besides keys, the ui-run loop receives async messages on its mailbox. An event the
;; editor PRODUCES ITSELF is a record implementing model's `UiEvent` ability — the
;; producer module defines the record + impl and just sends it; `ed-update` folds any
;; such record via `ui-event-fold`, so a new async producer (an LSP client, a
;; file-watcher, a buffer-process stream) registers an impl rather than editing the
;; loop or this file. What remains BELOW is the residual `[:tag …]` vector registry,
;; for events whose producer we don't own: redirected output (`:io/write` — std/io /
;; std/log), a spawned eval's reply (`:task-done` / `:task-error` / `:task-timeout`,
;; std/task), the frontend's `:resize` / `:mouse` / `:key-up`, the runtime's `:down`,
;; std's `:client-opts` (a buffer process's `:buffer-updated` is collab's row), and the lsp reply tags (vectors because
;; completion's bounded wait selectively receives `[:lsp-completion ^corr …]`). Each
;; handler does its own scroll-clamp (output/eval don't move point; resize/mouse do).

(defn- ed-reclamp (m text-rows columns rows)
  ;; the scroll re-clamped (vertical + horizontal) to keep point on screen — what a handler
  ;; that moved point, or the viewport, does before it answers
  (ed-scroll-horizontal (ed-scroll m text-rows) (ed-selected-text-cols m columns rows)))

(defn ed-ev-io-write (m input text-rows columns rows)
  "Redirected output (`[:io/write s]`) → *Messages* + the echo area (the default
output sink: eval stdout, the uncategorised logger backend)."
  (message m (string/trim-right (nth input 1))))

(defn display-degraded-note (detail)
  "What the echo area says of a window that fell back (`[:display-degraded {:what :reason}]`,
brood ADR-636): the GPU painting in software, a font standing in, grey text, vsync forced.

    (events/display-degraded-note {:what :gpu :reason \"no adapter\"})   ;=> \"display: gpu — no adapter\""
  (str "display: "
    (->string (or (:what detail) "degraded"))
    " — "
    (or (:reason detail) "fell back")))

(defn ed-ev-display-degraded (m input text-rows columns rows)
  "`[:display-degraded detail]`: the window fell back to something lesser — said, never only
logged to a terminal nobody reads."
  (message m (display-degraded-note (nth input 1))))

(defn ed-ev-task-reply (m input text-rows columns rows)
  "A spawned task's reply (`:task-done` / `:task-error` / `:task-timeout`): route by which
in-flight handle it matches, through `ed-task-reply-table` (every feature's registered
rows). A handle matching none is a stale/cancelled reply and is dropped, so it can't
clobber a newer one.

A row registered `:folds-event?` (the C-x C-e eval, whose report depends on whether it
TIMED OUT or errored) gets the whole event; the rest get the value, or the row's failure
value when the task did not finish."
  (let (handle (nth input 1)
        done? (= (first input) :task-done)
        table (ed-task-reply-table)
        slot (seq/find (keys table)
               (fn (field) (and (not (nil? (get m field))) (= (get m field) handle)))))
    (if slot
      (let ([fold failed _label options] (get table slot))
        ((reflect/eval fold) m
          (cond
            (:folds-event? options) input
            done? (nth input 2)
            else failed)))
      m)))

(defn ed-ev-resize (m input text-rows columns rows)
  "A `[:resize cols rows]`: re-clamp the scroll (vertical + horizontal) to the new
viewport, and run the resize steps (`model/register-resize-step`): a pty child lays out
against a size it is told, so a terminal must hear of the change."
  (ed-run-resize-steps (ed-reclamp m text-rows columns rows)))

(defn- ed-mouse-on-click (m)
  "After a left-click moved point, run the current buffer mode's `:on-click` command (a
command symbol, resolved late like a keymap binding) — e.g. *git-status* visits the file
under the click. A no-op when the buffer's mode defines no `:on-click`."
  (let (service (ed-mode-service (ed-current-buf m) :on-click))
    ;; a guest's session follows no click into another command (`guest/ed-guest-allows?`)
    (if (or (nil? service) (:guest-session m)) m (service m :mouse))))

(defn- ed-drag-release (m input text-rows columns rows)
  "End a left press over the text: a real drag-selection keeps its region highlighted and
makes it the PRIMARY selection (`clipboard/ed-drag-select` — the clipboard and kill ring are
left alone, as in Emacs, unless `:mouse-drag-copy-region` is on); a plain CLICK (no region)
runs the buffer mode's `:on-click` — so a
results-buffer row (`*Tests*` / `*git-status*` / `*Occur*` / `*compile*`) navigates to
its source ON CLICK, while a press-and-drag in the SAME buffer selects text instead.
That click-vs-drag split is what makes a results buffer's output highlightable/copyable
rather than every press being swallowed as a link jump.

A navigate then re-clamps the (now-selected) SOURCE pane so the visited line is actually
brought on screen — `ed-pop-to-file` only moves point and relies on this clamp, and unlike
the key path (RET) a mouse release returns straight out of here, so without it a click set
point but never scrolled the target into view. The selection path scrolls nothing (the
region stays put)."
  ;; `ed-mouse` ends the drag; the region (mark↔point) survives
  (let (folded (ed-mouse m input columns rows))
    (if (nil? (buffer-region (ed-current-buf folded)))
      ;; a plain click — navigate via :on-click (if any)
      (ed-reclamp (ed-mouse-on-click folded) text-rows columns rows)
      ;; a real region — PRIMARY gets it, it stays selected
      (ed-drag-select folded))))

(defn- ed-pointer-owned-at? (m columns rows row column)
  "Whether the pane under cell `[row column]` shows a buffer whose mode has a `:mouse` facet:
what runs there, not the editor, decides what a middle click means (`mouse/ed-mouse` routes
it)."
  (let (pane (ed-pane-at m columns rows row column))
    (and pane (not (nil? (ed-mode-service (ed-pane-buf m pane) :mouse))))))

(defn- ed-menu-mouse-press (m columns rows row column)
  "A press while the context menu is open: hit-test via the view's widget zones
(`hittest/ed-menu-hit`) and drive the pure model op — run the enabled item, stay open on a
divider/disabled/padding click (`:inside`), dismiss on a click outside."
  ;; `hittest/ed-menu-hit` — [:run i] | :inside | nil
  (let (hit (ed-menu-hit m columns rows column row))
    (cond
      (and (vector? hit) (= (first hit) :run)) (ed-menu-activate m (second hit))
      (= hit :inside) m
      else (ed-close-menu m))))

(defn- ed-menu-mouse-hover (m columns rows row column)
  "Pointer moved over the open menu: select the enabled item under it (standard dropdown
hover), else leave the selection put."
  (let (hit (ed-menu-hit m columns rows column row))
    (if (and (vector? hit) (= (first hit) :run)) (ed-menu-select m (second hit)) m)))

(defn ed-ev-mouse (m input text-rows columns rows)
  "A `[:mouse …]`: fold it via `ed-mouse`. A wheel notch scrolls/zooms the hovered pane,
and a scrollbar grab/drag/release moves the viewport directly — both leave point alone,
so they bypass the selected-pane point-clamp (`:sb-drag` spans the grab, so its press,
drags, and the release that clears it all skip the clamp); every other mouse action
re-clamps so a moved point stays on screen. A **right-press** opens the Copy/Cut/Paste
context menu at the pointer (`ed-open-menu`, point/region untouched); while a menu is open
it owns clicks — a press runs/hovers the item under it or dismisses it (`ed-menu-mouse-*`
over the view widget's zones). An event in the leftover strip is first taken to the pane whose
next line the strip shows (`ed-mouse-unstrip`)."
  (let (input (ed-mouse-unstrip input)
        action (nth input 1)
        button (nth input 2)
        row (nth input 3)
        column (nth input 4)
        ;; a button press is a COMMAND boundary, as a key is: the next key's `:last-command` is
        ;; not the kill before the click (two C-k with a click between were one kill-ring
        ;; entry; two drag + M-w copies one "AB", on the OS clipboard too), and typing after it
        ;; is a new undo group. Hover and motion are not commands.
        m (if (= action :press)
            (assoc m :last-command (:this-command m) :this-command :mouse :undo-break true)
            m))
    (cond
      ;; An open context menu owns the mouse (modal): a press runs/dismisses, a move
      ;; hovers-to-select like a standard dropdown, everything else is swallowed. Checked
      ;; before the bare-move hover so the menu, not the status bar, gets the motion.
      (:menu m)
        (cond
          (= action :press) (ed-menu-mouse-press m columns rows row column)
          (= action :move) (ed-menu-mouse-hover m columns rows row column)
          else m)
      ;; Bare hover (no button) folds into `:hover` for the status bar (the renderer draws the
      ;; hover pill + tooltip) — but must NOT re-clamp scroll: moving the mouse while you've
      ;; wheel-scrolled away from point would otherwise snap the view back to the cursor (the
      ;; GUI emits a :move per cell crossed). The mode line is cells; the text under the
      ;; pointer is found at its exact position (`ed-mouse-at`), which a zoomed pane's rows need
      (= action :move)
        (let ([at-row at-column] (ed-mouse-at input))
          (ed-diag-hover (ed-link-hover (ed-modeline-hover m columns rows column row)
                           columns rows at-column at-row)
            columns rows at-column at-row))
      (and (= action :press) (= button :right)) (ed-open-menu m row column)
      ;; Releasing a left press: a real drag-selection copies its region; a plain click
      ;; runs the row's `:on-click` (a results buffer navigates to its source ON CLICK).
      ;; Navigation is here on RELEASE, not on press, so a press begins a drag-select
      ;; instead of being swallowed as a link jump — that's what lets you highlight and
      ;; copy text in *Tests* / *git-status* / *Occur* / *compile*.
      (and (= action :release) (:text-drag m)) (ed-drag-release m input text-rows columns rows)
      ;; A middle press on text yanks the PRIMARY selection there (Emacs `mouse-yank-primary`)
      ;; — unless the pane's terminal program takes the mouse (`ed-mouse` routes it there)
      (and (= action :press)
        (= button :middle)
        (not (ed-pointer-owned-at? m columns rows row column)))
        (let ([placed moved?] (ed-mouse-set-point m columns rows row column (ed-mouse-at input)))
          (if moved?
            (ed-reclamp (killing/ed-mouse-yank-primary placed) text-rows columns rows)
            placed))
      ;; A left-press on a clickable status-bar segment (the branch / git indicator) runs its
      ;; command instead of the normal press handling — so it opens *git-status*, not moves
      ;; point. `ed-modeline-click` is nil unless a segment with an `:on-click` is under it; a
      ;; press on a tab (or its ×) shows (or closes) it the same way (`ed-tab-bar-click`).
      else
        (let (modeline-command (if (and (= action :press) (= button :left))
                                 (or (ed-tab-bar-click m columns rows column row)
                                   (ed-modeline-click m columns rows column row))
                                 nil))
          (if modeline-command
            modeline-command
            (let (folded (ed-mouse m input columns rows))
              ;; NB: a results row's `:on-click` navigation fires on the click's RELEASE
              ;; (ed-drag-release), NOT here on press — so the press can begin a
              ;; drag-select rather than steal it as a link click.
              (if (or (= action :scroll-up) (= action :scroll-down) (:sb-drag m) (:sb-drag folded))
                folded
                (ed-reclamp folded text-rows columns rows))))))))

(defn ed-ev-down (m input text-rows columns rows)
  "A monitored process died (`[:down ref pid reason]`): offered to every feature that keeps
processes of its own (`model/register-down-handler`) — a hosted buffer process respawned from
the pool cache (`hosted`), a shared one re-asked of its session (`collab`), a language
server's connection, another frame. Each answers `m` unchanged for a pid not its own."
  (ed-run-down-handlers m (nth input 2) (nth input 3 nil)))

(defn ed-ev-client-opts (m input text-rows columns rows)
  "The attach identity (`[:client-opts {:name …}]`, queued by a serve session before any
key — std/editor/serve): handed to every identity step (`model/register-identity-step`:
collab records the participant name and announces it on every shared buffer process, so
presence shows who this is). A guest (`:guest` — brood's `editor/serve` marks a client that
attached over a guest link) gets a guest's session: the allowlist `guest/ed-guest-allows?`,
and none of the host's on-disk memory — no recentf (the host's recent files and projects,
and the generated state it persists) and no save-place (the host's places file, read and
written). It keeps the host's config — the session is the host's editor, its look and its
keys — and its own clipboard: the guest's client's, which holds nothing of the host's."
  (ed-apply-client-identity m (nth input 1)))

(defn ed-apply-client-identity (m identity)
  "`m` as the session of the client `identity` names (its attach identity, `{:name
:guest}`): the participant name, and a guest's session for a guest
([[ed-ev-client-opts]]). Also what a served session's loop restarted after one died starts
as (`remote/ed-served-restart`), before its first key."
  (let (named (ed-run-identity-steps m identity))
    (if (= true (:guest identity))
      (assoc (dissoc named :recent-files :save-place) :guest-session true)
      named)))

(defn ed-ev-key-up (m input text-rows columns rows)
  "A `[:key-up k]` (a window, or a terminal once a held key stops): nothing to do — the
frontend repeats a held key, so its release stops nothing here. Handled so the vector is
not dispatched as a key."
  m)

(defn ed-ev-ranked (m input text-rows columns rows)
  "A ranking session's answer (`[:fuzzy-ranked <session> query hits]`, std/fuzzy's `ranker`):
fold it into the open minibuffer's candidate cache. Dropped unless it came from THIS prompt's
own session — a reply arriving after its prompt closed must not repopulate the next one."
  (ed-apply-ranked m (nth input 1) (nth input 2) (nth input 3)))

(def- ed-event-handlers
  ;; `[:tag …]` -> the handler's SYMBOL, resolved at dispatch (`(reflect/eval …)`, below) — the
  ;; same late binding keys get: redefine a handler in the running editor and the next
  ;; event of that tag uses it, with no reload. Function *values* here would freeze the
  ;; async half of the loop at module-load time while the key half stayed hot-swappable
  ;; (and would hide every handler from `nest test --cover`, whose instrumentation
  ;; rebinds the global that a captured value has already bypassed).
  ;;
  ;; These are the events the loop itself consumes. A feature's own — a language server's
  ;; replies, another frame's buffer registry — are registered by the feature when it loads
  ;; (`model/register-event-handler`) and looked up beside these ([[ed-event-handler]]).
  {:io/write 'events/ed-ev-io-write
   :key-up 'events/ed-ev-key-up
   :fuzzy-ranked 'events/ed-ev-ranked
   :task-done 'events/ed-ev-task-reply
   :task-error 'events/ed-ev-task-reply
   :task-timeout 'events/ed-ev-task-reply
   :resize 'events/ed-ev-resize
   :mouse 'events/ed-ev-mouse
   :down 'events/ed-ev-down
   :client-opts 'events/ed-ev-client-opts
   :display-degraded 'events/ed-ev-display-degraded})

(defn ed-event-handler (tag)
  "The handler symbol for inbound `[tag …]` events — the loop's own ([[ed-event-handlers]])
or one a feature registered (`model/register-event-handler`) — or nil when none is."
  (or (get ed-event-handlers tag) (ed-registered-event-handler tag)))

(defn ed-system-event? (input)
  "Whether `input` is an inbound `[:tag …]` event with a registered handler."
  (and (vector? input) (not (nil? (ed-event-handler (first input))))))
