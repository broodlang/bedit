(defmodule grammarcheck
  "Whether an installed tree-sitter grammar still has the names bedit's tables were written
against — and saying so, once, when it does not.

A `deflanguage`'s face table, indent spec, injection rules and definitions name node kinds and
fields of ONE revision of its grammar (the revision `:grammar` pins). A grammar of another
revision may have renamed some of them, and nothing fails: the language loads, parses, and
quietly stops colouring what the old name meant. So every language registers the names it
uses (`expect-names`, from `deflanguage`, via std's `editor/treesit/language-names`), and the
first time a grammar is about to be used the names are checked against what it contains
(`editor/treesit/grammar-problems`, brood ADR-583). The verdict is kept per language until a
grammar is installed or reloaded (`forget`), and a failing one is reported in *Messages* once,
with the remedy.

What a failing verdict changes: `model/grammar-ready?` answers false, so a language with a line
lexer stands in with it (`model/ed-grammar-fallback`) rather than mis-colouring, and the note a
visit shows says why (`model/missing-note`). Below `model`, which asks it, and `grammars`,
which reports it — this module knows neither.")

(defn- merge-names (a b)
  {:kinds (set/union (or (get a :kinds) #{}) (or (get b :kinds) #{}))
   :fields (set/union (or (get a :fields) #{}) (or (get b :fields) #{}))})

(defn expect-names (lang:keyword owner:any names:map -> map)
  "Record that `owner` (a mode's buffer type — HCL's grammar serves `:hcl` and `:terraform`)
uses the node kinds and fields `names` (`{:kinds :fields}`) of `lang`'s grammar. Forgets the
language's verdict, so a re-evaluated mode is checked afresh. Returns `names`."
  (let (by-owner (or (registry/lookup :grammarcheck/expected lang) {}))
    (registry/put :grammarcheck/expected lang (assoc by-owner owner names))
    (registry/remove :grammarcheck/verdicts lang)
    names))

(defn expected-names (lang:keyword -> map)
  "Every node kind and field the modes over `lang`'s grammar use, as `{:kinds :fields}`."
  (fold (vals (or (registry/lookup :grammarcheck/expected lang) {}))
    {:kinds #{} :fields #{}}
    merge-names))

(defn- check-grammar (lang names)
  ;; the problems of the grammar loaded for `lang` against `names`, a load failure included
  (let (info (try (editor/treesit/grammar-info lang) (catch e (failure (error-message e)))))
    (if (failure? info)
      (list (error-message info))
      (editor/treesit/grammar-problems info names))))

(defdyn *grammar-problems*
  ;; `(fn (lang names) -> problems)`, what a verdict asks — a dynvar so a test can stand in a
  ;; grammar of another revision without building one
  check-grammar)

(defdyn *verdict-scope*
  ;; whose verdicts these are: the runtime's, or — bound beside `*grammar-problems*` — a test's
  ;; own, kept apart so a stood-in grammar never answers the real one in another process
  :runtime)

(defn report-line (lang problems)
  "The *Messages* line for `lang`'s grammar failing its check with `problems`: the first few
names, how many more, and the remedy."
  (let (shown (take problems 3)
        more (- (count problems) (count shown)))
    (str "the "
      (->string lang)
      " grammar is not the one bedit's "
      (->string lang)
      " support was written for: "
      (string/join shown "; ")
      (if (> more 0) (str " (and " more " more)") "")
      " — M-x grammar-update installs the pinned revision; meanwhile it is coloured by its line"
      " lexer where it has one")))

(defn verdict (lang:keyword)
  "What is wrong with the grammar `lang` is parsed with, as bedit's modes see it — `()` when it
has every name they use. Asked once per grammar and kept (`forget` drops it); the first
failing answer is logged (*Messages* in the editor) with the remedy. Loads a declared grammar,
as the parse it is asked before would.

Verdicts are kept per `*verdict-scope*`: a test that stands in a grammar binds a scope of its
own, so its verdict never answers the runtime's, nor the reverse."
  (let (by-scope (or (registry/lookup :grammarcheck/verdicts lang) {})
        scope *verdict-scope*)
    (if (contains? by-scope scope)
      (get by-scope scope)
      (let (problems (*grammar-problems* lang (expected-names lang)))
        ;; re-read: another process may have kept its own scope's verdict meanwhile
        (registry/put :grammarcheck/verdicts
          lang
          (assoc (or (registry/lookup :grammarcheck/verdicts lang) {}) scope problems))
        (when (not (empty? problems)) (log/warn (report-line lang problems)))
        problems))))

(defn sound? (lang:keyword -> bool)
  "Whether `lang`'s grammar has every name bedit's modes use (`verdict`)."
  (empty? (verdict lang)))

(defn forget (&optional (lang nil))
  "Drop the verdict for `lang`, or every verdict — the step after a grammar is installed,
reloaded or declared again, whose answer may differ."
  (if (nil? lang)
    (doseq (known (keys (registry/entries :grammarcheck/verdicts)))
      (registry/remove :grammarcheck/verdicts known))
    (registry/remove :grammarcheck/verdicts lang))
  nil)
