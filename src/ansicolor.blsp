(defmodule ansicolor
  "A program's ANSI colours on the buffer its output streams into — Emacs's `ansi-color`
for *compilation*, a shell buffer and *Run* — over std's streaming decoder
(`ansi/decoder` / `ansi/feed`, brood ADR-567).

A producer keeps ONE decoder per stream (stdout and stderr are two) and threads it through
every chunk, so an escape split across two reads (`ESC[1` then `mERROR`) is finished by
the second instead of leaking `1mERROR` into the text. Off the loop the worker [[decode]]s
a chunk into its plain text and its attribute spans; on the loop the append lays the text
in WITH them, as the buffer's `:ansi` text property ([[faces]], brood ADR-579) — so they
belong to the characters: an edit, an undo, a head cut and another frame's copy all keep
them on the text they colour, with no carrying here. They stay SGR attributes
(`{:fg 1 :bold true}`): the view resolves them through the theme's sixteen ANSI
colours (`theme/ansi-palette`) as it paints, UNDER the mode's own colouring
(`spanpaint/ed-span-layers`) — as font-lock lays over ansi-color's faces, and as those faces
follow a theme switch.

A carriage return is done as a terminal does it (Emacs's `comint-carriage-motion`, in
[[insert-output]]): `\\r\\n` is a line end, and a lone `\\r` — a progress counter's `10%\\r20%` —
rewrites its line rather than joining the two. A buffer that only wants the text (*Tests*)
takes the decoded text and leaves the spans."
  (:use editor/buffer)
  (:use model :only [register-text-faces])) ; the colours painted as a text-face row

(defn decoder ()
  "A fresh decoder for one output stream: std's (`ansi/decoder`), and whether the last chunk
ended in a carriage return [[decode]] is holding until it knows whether a newline follows.

    (:return? (ansicolor/decoder))   ;=> false"
  {:ansi (ansi/decoder) :return? false :faulted? false})

(defn decode (decoder chunk)
  "Decode the next `chunk` of a stream with `decoder` ([[decoder]]): `[decoder' text spans]` —
the chunk's text with its escapes gone, and its SGR attributes as `[start end attr]` ranges
from offset 0 of `text` (`ansi/segments-spans`). An escape the chunk ends inside waits in
`decoder'` for the next chunk.

A `\\r\\n` line end becomes `\\n`; a LONE carriage return stays in the text — progress
output (`10%\\r20%`) rewrites its line, which the append does ([[carriage]]). One that ends
the chunk is held for the next: until then it cannot be told from the start of a `\\r\\n`.

    (rest (ansicolor/decode (ansicolor/decoder) (str (string/int->char 27) \"[1mok\\r\\n\")))   ;=> (\"ok\\n\" [[0 3 {:bold true}]])
    (second (ansicolor/decode (ansicolor/decoder) \"10%\\r20%\"))   ;=> \"10%\\r20%\"

The newline is bold too: no reset came before it, and a line's end carries its colour."
  (let ([next-ansi segments faulted?] (guarded-feed decoder chunk)
        text (ansi/segments-text segments)
        spans (ansi/segments-spans segments 0)
        ;; a return held from the last chunk goes in front, uncoloured
        [held-text held-spans] (if (:return? decoder)
                                 [(str "\r" text) (append-spans [] spans 1)]
                                 [text spans])
        holds? (string/ends-with? held-text "\r")
        kept (if holds? (string/substring held-text 0 (dec (count held-text))) held-text)
        [crlf-text crlf-spans] (if (includes? kept "\r\n")
                                 (keep-ranges kept
                                   held-spans
                                   (crlf-ranges kept))
                                 [kept held-spans]))
    [{:ansi next-ansi :return? holds? :faulted? faulted?}
      crlf-text
      (clip-spans crlf-spans (count crlf-text))]))

(defn- guarded-feed (decoder chunk)
  "`ansi/feed` of `chunk` with `decoder`'s std decoder, `[ansi-decoder segments faulted?]` — and
when the decoder RAISES (a bug in it, met by a program's output), the chunk's text with
its escapes taken out and no colours, a fresh decoder to go on with, and one warning per
stream (`:faulted?` rides the decoder after). A stream worker must outlive its decoder:
a worker that dies leaves its buffer running forever."
  (try
    (let ([next-ansi segments] (ansi/feed (:ansi decoder) chunk))
      [next-ansi segments (= true (:faulted? decoder))])
    (catch e
      (do
        (when (not (:faulted? decoder))
          (log/warn (str "ansicolor: the ANSI decoder failed; a chunk went in uncoloured: "
                      (error-message e))))
        [(ansi/decoder) [[(strip-escapes chunk) nil]] true]))))

(def- *escape-pattern*
  ;; every escape sequence a terminal reads, whole: a CSI (`ESC [`, parameter bytes, then
  ;; intermediates, then its final byte), a string sequence (OSC `ESC ]`, DCS `ESC P`, SOS
  ;; `ESC X`, PM `ESC ^`, APC `ESC _`) up to BEL or ST (`ESC \`), and a two-byte one (`ESC (B`,
  ;; `ESC 7`); one the chunk ends inside goes to the end. Raw ESC and BEL characters in the
  ;; pattern, so it names no escape syntax of the regex engine's
  (let (escape "\e"
        bell (string/int->char 7))
    (str escape
      "(\\[[0-?]*[ -/]*[@-~]?|[\\]PX^_][^" bell escape "]*(" bell "|" escape "\\\\)?|[ -/]*[0-~]?)")))

(defn- strip-escapes (text)
  "`text` with every escape sequence taken out whole — the fallback when std's decoder raised,
so it shares no code with it (not `ansi/strip`): `a ESC[1mb` reads `ab`, never `a[1mb`."
  (regex/replace text *escape-pattern* ""))

(defn- clip-spans (spans length)
  "`spans` cut to a text of `length` chars, one left empty dropped."
  (into []
    (seq/keep spans
      (fn (span)
        (let ([from to attr] span
              end (math/min to length))
          (when (< from end) [from end attr]))))))

(defn- crlf-ranges (text)
  "The `[from to]` ranges of `text` to keep so every `\\r\\n` reads as `\\n`."
  (let (parts (into [] (string/split text "\r\n")))
    (letrec (walk (fn (k start out)
                    (let (end (+ start (count (nth parts k ""))))
                      (if (= k (dec (count parts)))
                        (conj out [start end])
                        ;; keep the part and its newline, skip the return before it
                        (walk (inc k) (+ end 2) (conj (conj out [start end]) [(inc end) (+ end 2)]))))))
      (walk 0 0 []))))

(defn- keep-ranges (text spans ranges)
  "`[text' spans']`: `text` reduced to the ascending, disjoint `ranges` (`[from to]`), and
`spans` mapped onto what is kept — the parts of each span inside a kept range, moved to where
that range now starts, joined where they meet in the same attribute. One merge walk over
both, so a chunk of many lines and many colours costs their sum."
  (letrec (walk (fn (ranges spans offset pieces out)
                  (cond
                    (empty? ranges) [(string/join (reverse pieces) "") out]
                    (empty? spans)
                      (let ([from to] (first ranges))
                        (walk (rest ranges)
                          spans
                          (+ offset (- to from))
                          (cons (string/substring text from to) pieces)
                          out))
                    else
                      (let ([from to] (first ranges)
                            [span-from span-to attr] (first spans))
                        (cond
                          ;; the span ends before this range: no later range can use it
                          (<= span-to from) (walk ranges (rest spans) offset pieces out)
                          ;; the span starts after this range: on to the next range
                          (>= span-from to)
                            (walk (rest ranges)
                              spans
                              (+ offset (- to from))
                              (cons (string/substring text from to) pieces)
                              out)
                          else
                            (let (piece [(+ offset (- (math/max from span-from) from))
                                          (+ offset (- (math/min to span-to) from))
                                          attr]
                                  joined (append-spans out [piece] 0))
                              ;; the rest of the span may reach the next range
                              (if (> span-to to)
                                (walk (rest ranges)
                                  spans
                                  (+ offset (- to from))
                                  (cons (string/substring text from to) pieces)
                                  joined)
                                (walk ranges (rest spans) offset pieces joined))))))))
    (walk ranges (apply list spans) 0 () [])))

(defn carriage (text spans)
  "`[erase? text' spans']`: decoded output `text` (its `spans` from offset 0) with its lone
carriage returns done as a terminal does them, Emacs's `comint-carriage-motion`: a return
goes back to the start of the line, so what came before it on that line is gone and what
follows writes the line anew. `erase?` says the FIRST line had one — the start of that line
is in the buffer already (the line the output is continuing), and the append erases it too.
Text with no return comes back as it is.

    (ansicolor/carriage \"10%\\r20%\\r30%\\ndone\" [])   ;=> [true \"30%\\ndone\" []]
    (ansicolor/carriage \"a\\nb\\rc\" [[0 4 :x]])   ;=> [false \"a\\nc\" [[0 2 :x]]]"
  (if (not (includes? text "\r"))
    [false text spans]
    (let (parts (into [] (string/split text "\n"))
          last-index (dec (count parts))
          ;; a part's body: a return just before its newline is the CRLF line end, no motion
          body-of (fn (k part)
                    (if (and (< k last-index) (string/ends-with? part "\r"))
                      (string/substring part 0 (dec (count part)))
                      part))
          ranges (letrec (walk (fn (k start out)
                                 (let (part (nth parts k "")
                                       body (body-of k part)
                                       end (+ start (count part))
                                       return-at (string/last-index-of body "\r")
                                       from (if (>= return-at 0) (+ start return-at 1) start)
                                       line (conj out [from (+ start (count body))])
                                       ;; the line's newline is kept with it
                                       kept (if (= k last-index) line (conj line [end (inc end)])))
                                   (if (= k last-index) kept (walk (inc k) (inc end) kept)))))
                   (walk 0 0 []))
          erase? (>= (string/last-index-of (body-of 0 (first parts)) "\r") 0)
          [kept-text kept-spans] (keep-ranges text
                                   spans
                                   (seq/reject ranges (fn (range) (= (first range) (second range))))))
      [erase? kept-text kept-spans])))

(sig insert-output (buffer int string any -> any))
(defn insert-output (buffer at text spans)
  "`[buffer' end]`: decoded output `text` inserted into `buffer` at `at` (the end, or a shell's
process mark) with its colours ([[faces]]) and its carriage returns done ([[carriage]]) — a
return in its first line erases the output line `at` is on, back to that line's start —
as PROGRAM OUTPUT (brood's `replace-program-output`, ADR-712): in the buffer and every snapshot of
its undo history, recording nothing, so undoing what you typed in a shell never takes output
away. `end` is the offset just past what was inserted. A read-only buffer takes it: the stream
owns its text. Point lands at `end`.

    (first (ansicolor/insert-output (editor/buffer/make-buffer \"$ x\\n10%\") 8 \"\\r20%\" []))   ;~> a buffer holding \"$ x\\n20%\""
  (let ([erase? kept kept-spans] (carriage text spans)
        line-start (text/line->char (buffer-rope buffer) (text/char->line (buffer-rope buffer) at))
        start (if (and erase? (int? line-start)) line-start at)
        end (+ start (count kept)))
    [(goto-char (replace-program-output buffer start at kept (faces kept-spans)) end) end]))

(defn- append-spans (before spans shift)
  "The ascending span vector `before` followed by `spans` moved by `shift` — and a run that
a chunk boundary cut (`before`'s last span ending where the first of `spans` begins, in the
same attribute) joined again, so where a read happened to end never shows in the spans."
  (let (shifted (into []
                  (map spans
                    (fn (span) (let ([from to attr] span) [(+ from shift) (+ to shift) attr]))))
        tail (last before)
        head (first shifted)
        joined (and tail head (= (second tail) (first head)) (= (nth tail 2) (nth head 2))))
    (if joined
      (into (assoc before (dec (count before)) [(first tail) (second head) (nth tail 2)])
        (rest shifted))
      (into before shifted))))

(def ansi-property :ansi)
;; The text property a program's colours live under (brood ADR-579): SGR attribute maps,
;; carried with the characters by every edit, undo and splice — so they colour the same
;; text after the user edits the buffer, and in every frame showing it.

(defn faces (spans)
  "The text properties an append of decoded text carries — `{:ansi spans}` — or nil when
`spans` (`[start end attr]` from the text's start, [[decode]]'s) colour nothing. Hand it to
the insert that lays the text in (`editor/buffer/insert`'s `properties`), so the colours
arrive in the same edit as their text.

    (ansicolor/faces [[0 2 {:fg 1}]])   ;=> {:ansi [[0 2 {:fg 1}]]}
    (ansicolor/faces [])   ;=> nil"
  (when (and spans (not (empty? spans))) {ansi-property spans}))

(defn colour-spans (buffer)
  "`buffer`'s program colours: its `:ansi` text property's spans, ascending — where the text
they were laid on is now.

    (ansicolor/colour-spans (editor/buffer/make-buffer \"x\"))   ;=> []"
  (buffer-properties buffer ansi-property))

;; the colours a producer laid on its text are painted under the mode's colouring, resolved
;; through the theme's ANSI palette as they are painted (`model/register-text-faces`): the
;; view names no ansicolor call
(register-text-faces :ansi
  {:rank 10 :spans 'ansicolor/colour-spans :palette 'theme/ansi-palette})

(defn add-faces (buffer spans offset)
  "`buffer` with attribute `spans` (from offset 0 of text ALREADY in it at `offset`) laid on
that text as its `:ansi` text property ([[faces]]) — for text a producer wrote whole before
it knew the colours (a command's output shown at once). A read-only buffer is unlocked for
it and re-locked: the producer owns its text. An append should pass [[faces]] to its insert
instead. No spans, no change.

    (ansicolor/colour-spans (ansicolor/add-faces (editor/buffer/make-buffer \"hello\") [[0 2 {:fg 1}]] 3))   ;=> [[3 5 {:fg 1}]]"
  (if (or (nil? spans) (empty? spans))
    buffer
    (let (length (buffer-length buffer)
          start (if (< offset length) offset length)
          reach (+ offset (second (last spans)))
          end (if (and (int? reach) (< reach length)) reach length)
          placed (map spans (fn ([from to attr]) [(+ from offset) (+ to offset) attr]))
          locked? (read-only? buffer)
          open (if locked? (set-read-only buffer false) buffer)
          put (put-properties open ansi-property start end placed))
      (if locked? (set-read-only put true) put))))

;; ---- line-buffered output ------------------------------------------------------
;; A line-oriented consumer (procstream) splits decoded text at newlines. Attributes carry
;; across lines — `ESC[31m` on one line, the reset three lines down — so each complete
;; line takes the spans that fall in it, clipped and made line-relative, and a span that
;; crosses a newline continues on the next line.

(defn- line-spans (spans line-start line-end acc)
  "The ascending `spans` (a list) that fall in the line `[line-start line-end)`, clipped and
relative to `line-start`: `[this-line remaining]` — `remaining` the spans the next lines
still need, the rest of one that runs past this line's newline among them."
  (if (empty? spans)
    [(into [] (reverse acc)) spans]
    (let ([from to attr] (first spans)
          clipped-from (math/max from line-start)
          clipped-to (math/min to line-end)
          kept (if (< clipped-from clipped-to)
                 (cons [(- clipped-from line-start) (- clipped-to line-start) attr] acc)
                 acc))
      (cond
        (>= from line-end) [(into [] (reverse acc)) spans]
        ;; reaches past this line's newline: its part here, the rest on the next line
        (> to (inc line-end))
          [(into [] (reverse kept)) (cons [(inc line-end) to attr] (rest spans))]
        else (line-spans (rest spans) line-start line-end kept)))))

(defn split-lines (text spans)
  "`text` (its attribute `spans` from offset 0) cut at newlines: `[lines partial]` —
`lines` a vector of `[line line-spans]` for every complete line (newline dropped, spans
relative to the line), `partial` the `[text spans]` after the last newline, which the
next chunk continues.

    (ansicolor/split-lines \"ab\\ncd\\ne\" [[1 4 :x]])   ;=> [[[\"ab\" [[1 2 :x]]] [\"cd\" [[0 1 :x]]]] [\"e\" []]]"
  (let (parts (into [] (string/split text "\n"))
        last-index (dec (count parts)))
    (letrec (walk (fn (k start remaining out)
                    (let (line (nth parts k "")
                          end (+ start (count line))
                          [this-line others] (line-spans remaining start end ()))
                      (if (= k last-index)
                        [out [line this-line]]
                        (walk (inc k) (inc end) others (conj out [line this-line]))))))
      (walk 0 0 (apply list spans) []))))

(defn continue-partial (partial text spans)
  "The `[text spans]` `partial` left by [[split-lines]] continued by the next decoded
`text` and its `spans`: one `[text spans]`, the new spans shifted past the partial — a run
the chunk boundary cut joined again.

    (ansicolor/continue-partial [\"ab\" [[0 1 :x]]] \"cd\" [[1 2 :y]])   ;=> [\"abcd\" [[0 1 :x] [3 4 :y]]]
    (ansicolor/continue-partial [\"ab\" [[1 2 :x]]] \"cd\" [[0 1 :x]])   ;=> [\"abcd\" [[1 3 :x]]]"
  (let ([before before-spans] partial)
    [(str before text) (append-spans before-spans spans (count before))]))
