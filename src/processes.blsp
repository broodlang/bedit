(defmodule processes
  "**Running a program** — its output streamed into a buffer, with its colours.

The context's details live under `src/processes/`: the streaming worker every runner shares
(`processes/procstream`) and the ANSI colours a program's output carries
(`processes/ansicolor`). Other contexts use the functions below. The buffers you type into —
the input region, the project shell, the terminal — are the `shells` context, which sits on
this one.

Output arrives in chunks: [[output-decoder]] starts a stream, [[decode-output]] turns each
chunk into `[decoder' text spans]`, and [[insert-output]] lays decoded text into a buffer with
its colours and its carriage returns done."
  ;; loaded with the context: its text-face row (a program's colours under the mode's) is
  ;; registered at load
  (:use processes/ansicolor :only []))

;; ---- a program's output and its colours (processes/ansicolor) -------------------------

(defdelegate output-decoder () processes/ansicolor :as decoder)
(defdelegate decode-output (decoder chunk) processes/ansicolor :as decode)
(defdelegate output-carriage (text spans) processes/ansicolor :as carriage)
(defdelegate output-faces (spans) processes/ansicolor :as faces)
(defdelegate add-output-faces (buffer spans offset) processes/ansicolor :as add-faces)
(defdelegate insert-output (buffer at text spans) processes/ansicolor)
(defdelegate continue-partial-output (partial text spans) processes/ansicolor :as continue-partial)

;; ---- the streaming worker (processes/procstream) ---------------------------------------

(defdelegate stream-loop (handlers) processes/procstream :as procstream-loop)
(defdelegate close-quietly (proc label) processes/procstream)
