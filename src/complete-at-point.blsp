(defmodule complete-at-point
  "Baseline completion-at-point for the editor — a small, **ricing-ready** popup.

`cmd-complete` (bound to Tab in `input`) completes the word before point: one
candidate inserts directly, several open a popup, none reports in the echo area.
While the popup is open `input` routes control keys here — C-n/↓ and C-p/↑ move,
Enter/Tab accept, Esc/C-g cancel; any other key dismisses it and is processed
normally (so you keep typing). `view` overlays `complete-popup-ops`.

SOURCES are **multi**: `cmd-complete` merges candidates from an ordered list,
`*completion-sources*` (Emacs' `completion-at-point-functions`) — the always-on
buffer-word source, the buffer's language mode (`:complete-at` → brood-mode globals),
and any added source (an LSP server via `src/lsp.blsp`). Each is a fn
`(model) -> nil | [start prefix items]` plus an optional OPTIONS map as a fourth element:
`:cache true` (the popup narrows by filtering these items rather than asking again),
`:docs {candidate doc}` (the info panel), `:rank :after` (below every other source's
candidates), `:claims-region true` (this answer's region wins) and `:continue \"/\"` (a
candidate ending so completes on). The first non-nil answer — or the one claiming it — fixes
the region and the rest merge in. `cape` adds file and other-buffer sources. The LOOK
(`*completion-max*`) and the menu rendering live in the shared `completion` framework, which
the minibuffer also uses.

Corfu's behaviour on top: the AUTO popup (`corfu-auto`) opens after a pause in typing, with
nothing selected so RET stays a newline, and the INFO panel (`corfu-popupinfo`) shows the
selected candidate's documentation beside it — both feature timers registered here.

Pure (data→data) apart from reading the buffer and (for an LSP source) a bounded
synchronous request; the popup is plain render ops, unit-testable without a window."
  (:use editor/buffer) ; buffer text/point + edit ops
  (:use editor/highlight) ; symbol-char? / symbol-prefix-at — the one word-boundary rule
  (:use model) ; current-buffer accessors, message
  (:use completion) ; the shared window/width helpers (+ the look config)
  (:use mincomplete) ; lcp — the common-prefix expansion Tab shares with the minibuffer
  (:use ui-kit) ; ui-panel / ui-list / ui-clip — the popup is one windowed list in a card
  (:use theme) ; ui-ctx — the kit's semantic-role palette
  (:use editor/display)) ; the `text` render op for the popup
;; ---- what counts as a completion word ---------------------------------------

(defn complete-word-char? (c)
  "True if `c` (a 1-char string) is part of a completion word — the language's own
symbol boundary (`symbol-char?`, std/editor/highlight), so this source, the mode source
and an LSP source agree on the prefix and merge instead of dropping each other."
  (symbol-char? c))

;; check-allow: `symbol-prefix-at` (std editor/highlight) answers `[start prefix]` with no
;; declared type, so its `first` reads as unknown; it is the start index by its contract.
(check-allow :trusted
  (defn- complete-prefix-start (text p)
    "The start index of the word-char run ending at `p`."
    (first (symbol-prefix-at text p))))
(sig complete-prefix-start (string int -> int))

;; ---- candidate source (redefine `completion-candidates` to rice) ------------

;; The characters that END a completion word — exactly the complement of `symbol-char?`
;; (`hl-delim?`'s whitespace, brackets, `"` and `;`, plus the reader-macro prefixes
;; `' \` ~ ^ @ #`). Spelled out as a SET so the scan below can hand it to the native rope
;; scanners (`text/skip-forward`) instead of asking `symbol-char?` once per character in
;; Brood; tests/complete_test.blsp checks the two agree, so the one boundary rule cannot
;; drift. (std/editor/highlight keeps the same set privately as `hl-delim-chars` minus the
;; reader prefixes; exporting it there would retire this copy.)
(def *complete-word-delimiters* " \t\n\r,()[]{}\";'`~^@#")

(defn- complete-word-start? (rope i)
  "Does a completion word begin at char `i` of `rope` — the start of the text, or right
after a delimiter?"
  (or (= i 0) (includes? *complete-word-delimiters* (text/slice rope (dec i) i))))

;; Why a prefix SEARCH and not a word list: the source only ever wants the words that start
;; with the prefix, and building the buffer's whole word universe to filter it walked every
;; character in Brood — measured 7.4 s on a 44k-line buffer, once per edit, which the idle
;; preview pays on every pause in typing. Searching the rope natively for the prefix and
;; reading the word at each hit that sits on a word start reads only those words: 22 ms for
;; `def` on the same buffer, 7 ms for a prefix that occurs nowhere. That is Tab's fallback
;; now: the preview reads a word index built off the loop (see "the buffer's word index"
;; below), cut by a native `regex/split` rather than a walk in Brood, and Tab reads it too
;; whenever it is current.
(defn complete-prefix-words (buf prefix &optional (limit nil))
  "Every word of `buf` that starts with `prefix` (non-empty), with duplicates — read at
each occurrence of `prefix` that begins a word, through to the next delimiter. With a
`limit`, the scan stops once that many prefix HITS have been looked at (words or not), so a
short prefix in a large buffer costs a bounded walk — what a source reading buffers you are
not editing (`cape`'s dabbrev) needs."
  (let (rope (buffer-rope buf))
    (letrec (scan (fn (from acc seen)
                    (let (hit (if (and limit (>= seen limit))
                                nil
                                (buffer-search-forward buf prefix from)))
                      (cond
                        (nil? hit) acc
                        (complete-word-start? rope hit)
                          (let (end (text/skip-forward rope hit *complete-word-delimiters* false))
                            (scan end (cons (text/slice rope hit end) acc) (inc seen)))
                        :else (scan (inc hit) acc (inc seen))))))
      (scan 0 '() 0))))

(defn completion-candidates-of (words prefix)
  "The `words` that start with `prefix` and aren't exactly it, sorted — the pure
prefix-filter every word source shares."
  (sort (seq/distinct (seq/filter words
                        (fn (w) (and (string/starts-with? w prefix) (not (= w prefix))))))))

(defn- complete-buffer-candidates (buf prefix)
  "The distinct words of `buf` that start with `prefix` and aren't exactly it, sorted."
  (if (= prefix "") '() (completion-candidates-of (complete-prefix-words buf prefix) prefix)))

(defn completion-candidates (m prefix)
  "Candidates for `prefix`. **Redefine to plug in another source** (global symbols
via `all-globals`, file paths, snippets, …). Baseline: the distinct words in the
current buffer that start with `prefix` and aren't exactly it, sorted."
  (complete-buffer-candidates (ed-current-buf m) prefix))

;; ---- multi-source completion-at-point (CAPF-style) --------------------------
;; Completion draws from an ordered LIST of sources, not one. A source is a fn
;;   (model) -> nil | [start prefix items]
;; returning `nil` when it doesn't apply at point (e.g. no prefix). The FIRST
;; non-nil source fixes the completion region `[start prefix]`; every other
;; non-nil source that agrees on `start` contributes its `items` to the merge
;; (deduped, source order preserved). This is Emacs' `completion-at-point-functions`:
;; the buffer-word source is always present; a language mode prepends its own
;; (brood-mode → live globals), and an LSP source plugs in the same way.

(defdyn *completion-sources*
  ;; The ordered completion sources, highest precedence first. A list of fn *symbols*
  ;; `(model) -> nil | [start prefix items]`, resolved late so a redefined source
  ;; hot-swaps live. `complete-source-mode` adapts the buffer's `:complete-at` mode
  ;; service (brood-mode → live globals); `complete-source-buffer-words` is always on.
  ;; Insert another symbol (e.g. an LSP source) to plug it into the merge — ricing.
  (list 'complete-at-point/complete-source-mode
    'complete-at-point/complete-source-buffer-words))

;; ---- the inline preview (Emacs 30's `completion-preview-mode`) ----------------
;; The top candidate's remainder, shown after point in a dim face as you type — the
;; suggestion as a shadow of what you are about to write, which you take with Tab or
;; ignore by carrying on. Emacs added this in 30; the rules below are its rules.

(defdyn *preview-sources*
  ;; Which sources the PREVIEW may ask. The two instant ones, deliberately — never an
  ;; LSP source.
  ;;
  ;; `complete-at` is fine with a slow source because Tab is a request: you pressed it and
  ;; you can wait a second for a server. The preview is not a request; it recomputes every
  ;; time typing settles, and a source that blocks for a second would block the editor
  ;; loop for a second, repeatedly, while you type. So the preview is the instant guess and
  ;; Tab is the considered answer that may go and ask.
  (list 'complete-at-point/complete-source-mode
    'complete-at-point/complete-source-index-words))

(def *preview-min-prefix* 3)
;; Emacs' `completion-preview-minimum-symbol-length`. Below three characters almost
;; anything matches, so the suggestion is noise that flickers under your hands rather than
;; a guess worth reading.

;; ---- how far one Tab goes: to the end of the next segment --------------------

(defdyn *completion-segment-separators*
  ;; What divides a completion word into SEGMENTS when the buffer's mode does not say:
  ;; Elixir's and most languages' `.`, Brood's and Clojure's `mod/name`, Rust's `::`. Modes
  ;; say, as the `:completion-separators` service (a set of 1-char strings): `prog-mode`
  ;; these, `text-mode` none — prose completes a word whole.
  #{"." "/" ":"})

(defn- segment-separator-from (word from separators)
  ;; the index of the first separator in `word` at or after `from`, or nil
  (let (n (string/length word))
    (letrec (scan (fn (i)
                    (cond
                      (>= i n) nil
                      (contains? separators (string/char-at word i)) i
                      :else (scan (inc i)))))
      (scan from))))

(defn complete-step (prefix word &optional (separators *completion-segment-separators*))
  "How much of `word` one Tab inserts after the typed `prefix`: up to the end of the NEXT
segment, not the whole word — `XB.T` with `XB.Tool.call` gives `XB.Tool`, and Tab again
gives `XB.Tool.call`. A prefix that already ends a segment steps over the separator (a
run of them, Rust's `::`) to the end of the one after it.

The whole word is rarely what the reader meant: a module path is typed a segment at a
time, and taking `XB.Tool.call` when the next thing needed is `XB.Tool.other` leaves them
deleting what Tab just wrote. A popup choice, which the reader picked by name, is still
inserted whole.

    (complete-at-point/complete-step \"XB.T\" \"XB.Tool.call\")   ;=> \"XB.Tool\"
    (complete-at-point/complete-step \"XB.Tool\" \"XB.Tool.call\")   ;=> \"XB.Tool.call\"
    (complete-at-point/complete-step \"std\" \"std::fs::read\")   ;=> \"std::fs\"
    (complete-at-point/complete-step \"fo\" \"foo-bar\")   ;=> \"foo-bar\""
  (let (typed (string/length prefix)
        cut (when (string/starts-with? word prefix) (segment-separator-from word typed separators)))
    (cond
      ;; no separator past the prefix — or a candidate that does not extend the prefix at
      ;; all (a server's fuzzy match), which has no typed segment to step from: whole
      (nil? cut) word
      (> cut typed) (string/substring word 0 cut)
      :else
        (let (n (string/length word)
              past (letrec (skip (fn (i)
                                   (if (and (< i n) (contains? separators (string/char-at word i)))
                                     (skip (inc i))
                                     i)))
                     (skip cut))
              next (segment-separator-from word past separators))
          (if (nil? next) word (string/substring word 0 next))))))

(defn completion-separators (m)
  "The current buffer's segment separators: its mode's `:completion-separators`, else
[[*completion-segment-separators*]]. Public because a source reads them too: the LSP source
qualifies a server's last-segment answer (`Tool` for `XB.T`) by the same rule Tab steps by."
  (or (ed-mode-service (ed-current-buf m) :completion-separators) *completion-segment-separators*))

(defn preview-candidates (items prefix)
  "Every candidate a preview could show for `prefix` — those that genuinely EXTEND it — in
sorted order.

Sorted rather than ranked, because a preview that reorders itself as you type shows you a
different word every keystroke, and the one thing this has to be is predictable enough to
accept without reading it twice."
  (into []
    (seq/filter (sort (seq/distinct items))
      (fn (c) (and (string/starts-with? c prefix) (> (string/length c) (string/length prefix)))))))

(defn preview-candidate (items prefix)
  "The candidate a preview shows first: the first that extends `prefix`, or nil."
  (first (preview-candidates items prefix)))

(defn completion-preview (m)
  "`{:start :prefix :text}` for the inline preview at point — `:text` being the REMAINDER
to paint after the cursor — or nil when there is nothing worth showing.

Nil for a read-only buffer, for a prefix shorter than [[*preview-min-prefix*]], for a
point that is not at the end of its line, and when no candidate extends what you have
typed. The end-of-line rule is the one concession to the renderer: text drawn mid-line
would sit on top of the characters after point rather than pushing them along, and a
preview that obscures your own code is worse than no preview. Typing an identifier at the
end of a line is where you want it anyway.

A read-only buffer gets none because nothing typed there can accept it: a char-mode
terminal's point is the PROGRAM's cursor, and a suggestion painted after it is the editor
guessing at the program's input. A buffer narrowed to an input region (a line-mode
terminal, a shell) is not read-only, so its input still gets one.

Nil, too, while the auto popup is on ([[completion-auto?]]): the two are alternatives, as
Corfu's `corfu-auto` and `completion-preview-mode` are in Emacs. Both would answer the same
pause, the ghost at the idle beat and the popup a moment later, and a suggestion that
appears only to be covered by a list of the same words is flicker, not help."
  (let (buf (ed-current-buf m)
        ;; one character, not the document: this runs on every keystroke
        after (buffer-char-after buf)
        eol? (or (nil? after) (= after "\n")))
    (when (and eol? (not (read-only? buf)) (not (completion-auto? m)))
      (let (results (seq/keep *preview-sources* (fn (s) ((reflect/eval s) m))))
        (when (not (empty? results))
          (let ([start prefix _] (first results))
            (when (>= (string/length prefix) *preview-min-prefix*)
              (let (items (apply append
                            (map results (fn (r) (if (= (first r) start) (nth r 2) '()))))
                    cands (preview-candidates items prefix))
                (when (not (empty? cands))
                  (preview-at {:start start :prefix prefix :items cands} 0))))))))))

(defn preview-at (pv i)
  "`pv` showing candidate `i` — its `:index` and the `:text` that follows from it. One step
past either end wraps round, which is all a ring walked a step at a time ever needs.

The remainder is derived rather than stored twice, so the two can never disagree about
which candidate is on screen."
  (let (n (count (:items pv))
        i (cond (= n 0) 0 (< i 0) (- n 1) (>= i n) 0 :else i)
        hit (nth (:items pv) i "")
        prefix (:prefix pv))
    (assoc pv
      :index i
      :text (string/substring hit (string/length prefix) (string/length hit)))))

(defn preview-cycle (m d)
  "Show the next (`d` 1) or previous (`d` -1) candidate in the preview — Emacs'
`completion-preview-next-candidate` on M-n / M-p.

The first suggestion is a guess; cycling is how you say \"nearly, the one after it\"
without abandoning what you have typed to open a popup and read a list. Wraps, because a
handful of candidates is a ring and a dead end at the last one is just a key that stops
working."
  (let (pv (:completion-preview m))
    (if (or (nil? pv) (empty? (:items pv)))
      m
      (assoc m :completion-preview (preview-at pv (+ (:index pv 0) d))))))

(def *preview-keys* [:meta-n :meta-p])

(defn preview-control-key? (input)
  "Whether a showing preview consumes `input` — M-n / M-p, and nothing else. Every other
key falls through untouched: a preview is a suggestion sitting beside what you are doing,
not a mode you have to leave."
  (includes? *preview-keys* input))

(defn preview-handle (m input)
  "Fold one preview key: M-n forward, M-p back."
  (preview-cycle m (if (= input :meta-p) -1 1)))

(defn preview-accept (m)
  "Insert the preview's remainder at point, up to the end of its next segment
([[complete-step]]), and clear it — what Tab does when one is showing. `XB.T` showing
`ool.call` takes `ool`; the rest shows again on the next pause and the next Tab takes it.
The text is inserted rather than the region replaced: the prefix is already exactly what
the candidate starts with, so there is nothing to rewrite, and inserting keeps the undo
step small and obvious."
  (let (pv (:completion-preview m))
    (if (nil? pv)
      m
      (let (prefix (:prefix pv)
            taken (complete-step prefix (str prefix (:text pv)) (completion-separators m))
            buf (ed-current-buf m)
            buf2 (insert buf (string/substring taken (string/length prefix) (string/length taken))))
        (assoc (ed-set-buf m buf2) :completion-preview nil :status "modified")))))

(defn complete-add-source! (sym)
  "Add completion source `sym` (a fn symbol) to the front of `*completion-sources*`,
idempotently — the way a feature turns its source on (e.g. `lsp` adds its source when a
server connects). Highest precedence; redefining the global directly also works."
  (when (not (includes? *completion-sources* sym))
    (defdyn *completion-sources* (cons sym *completion-sources*)))
  nil)

(defn complete-append-source! (sym)
  "Add completion source `sym` to the END of `*completion-sources*`, idempotently — for a
source that should only fill in after the others (`cape`'s dabbrev: words from other
buffers rank after the mode's own and this buffer's)."
  (when (not (includes? *completion-sources* sym))
    (defdyn *completion-sources* (append *completion-sources* (list sym))))
  nil)

(defn- complete-line-to-point (buf)
  "`[line-start line]` — the text of the current line up to point, and the buffer offset
it starts at.

A completion word never crosses a line, so this is all of the buffer any word-at-point
question needs. Both sources below run on every Tab AND on every idle completion preview,
and flattening a 44k-line buffer to find the word before point was their whole cost."
  (let (line-start (buffer-point (beginning-of-line buf)))
    [line-start (text/slice (buffer-rope buf) line-start (buffer-point buf))]))

(defn complete-source-mode (m)
  "The mode source: the current buffer's `:complete-at` language service (e.g. brood-mode's
live globals), adapted to the source protocol. `nil` when the mode offers no service or
there's no prefix at point. The seam that keeps `complete` language-agnostic.

The service is called as `(svc text pos)` with `text` the CURRENT LINE UP TO POINT and
`pos` its length — not the buffer. The prefix it completes is the symbol before point,
which never crosses a line; handing it the whole buffer cost 10-17 ms per Tab and per idle
preview on a 44k-line file, all of it spent flattening the rope. The `start` it answers is
relative to that line and is shifted back to a buffer offset here."
  (let (buf (ed-current-buf m)
        svc (ed-mode-service buf :complete-at))
    (if (nil? svc)
      nil
      (let ([line-start line] (complete-line-to-point buf)
            [start prefix items] (svc line (string/length line)))
        (if (= prefix "") nil [(+ line-start start) prefix items])))))

(defn- complete-word-before-point (buf)
  "`[start prefix]` — the word before point in `buf` and the offset it starts at; the prefix
is \"\" when point does not follow a word character."
  ;; only the line up to point is read (see `complete-line-to-point`)
  (let ([line-start line] (complete-line-to-point buf)
        offset (string/length line)
        start (+ line-start (complete-prefix-start line offset)))
    [start (string/substring line (- start line-start) offset)]))

;; ---- the buffer's word index, built off the loop -----------------------------------
;; The preview asks for the words starting with the word before point on every pause in
;; typing. A prefix search answers one prefix and has to run again for the next — and a new
;; word started means a search of the whole rope, on the loop. So the preview reads an
;; INDEX instead: every distinct word of the buffer with how often it occurs, bucketed by
;; its first character, on the model's `:word-index` with the rope it was read from.
;;
;; The index is built OFF the loop (a task capturing the rope; the rope stays behind, only
;; the buckets cross back) and kept until the text changes. A change the buffer's splice log
;; can account for moves it along in place: the words around the changed stretch are taken
;; out as they read before and put back as they read now, which costs the edit rather than
;; the buffer. Anything the log cannot say — another buffer, a wholesale replace, a paste
;; past `*complete-index-inline-max*` — is a rebuild, off the loop again. The loop only
;; ever filters one bucket.

(def- *complete-word-pattern* "[ \t\n\r,()\\[\\]{}\";'`~^@#]+")
;; one or more `*complete-word-delimiters*`, as a regex: what `regex/split` cuts a text into
;; words with natively. tests/complete_test.blsp pins the two to the same set.

(def *complete-index-inline-max* 8192)
;; The most text (chars, before or after the edit) an index is moved along by on the loop;
;; past it the edit is a paste worth a rebuild off the loop.

(defn- complete-text-words (text)
  "The completion words of `text`, in order, with duplicates."
  (seq/filter (regex/split *complete-word-pattern* text) (fn (w) (not (= w "")))))

(defn- complete-bucket-add (buckets word n)
  "`buckets` with `word`'s count moved by `n`, a word whose count reaches zero dropped — and a
bucket left empty with it, so an index moved along equals one built afresh."
  (let (key (string/substring word 0 1)
        bucket (get buckets key {})
        total (+ (get bucket word 0) n)
        moved (if (<= total 0) (dissoc bucket word) (assoc bucket word total)))
    (if (empty? moved) (dissoc buckets key) (assoc buckets key moved))))

(defn complete-index-buckets (text)
  "The word index of `text`: first character -> `{word count}` for every completion word.

    (complete-at-point/complete-index-buckets \"ab ac ab b\")   ;=> {\"a\" {\"ab\" 2, \"ac\" 1}, \"b\" {\"b\" 1}}

A line at a time, folded straight into the buckets, so what the build keeps alive is the
distinct words and one line's: splitting the whole text first held every word of it (and
every match the split found) at once, and the collections of a heap that size stalled the
UI loop's own — measured, a 174 KB file's build put 100–220 ms turns on the loop for the
three seconds it ran (tools/probe-typing.blsp)."
  (fold (string/split text "\n") {} (fn (acc line) (complete-buckets-move acc line 1))))

(defn- complete-buckets-move (buckets text n)
  "`buckets` with every word of `text` counted `n` more times."
  (fold (complete-text-words text) buckets (fn (acc word) (complete-bucket-add acc word n))))

(defn complete-index-advance (index buf)
  "`index` (a `:word-index`) moved onto `buf`'s text through the buffer's splice log, or nil
when it cannot be: the log does not reach the index's rope (another buffer, too much history,
a wholesale replace) or the edit is longer than `*complete-index-inline-max*`. The words the
edit touched — the changed stretch widened to the words it cuts — come out as they read in the
old text and go back as they read in the new."
  (let (old (:rope index)
        rope (buffer-rope buf)
        splices (buffer-splices-since (assoc buf :rope old) buf))
    (cond
      (nil? splices) nil
      (empty? splices) (assoc index :rope rope)
      :else
        (let ([lo old-hi new-hi] (ed-splices-cover splices)
              from (text/skip-backward old lo *complete-word-delimiters* false)
              old-end (text/skip-forward old old-hi *complete-word-delimiters* false)
              new-end (text/skip-forward rope new-hi *complete-word-delimiters* false))
          (when (<= (math/max (- old-end from) (- new-end from)) *complete-index-inline-max*)
            {:rope rope
             :buckets (complete-buckets-move (complete-buckets-move (:buckets index)
                                               (text/slice old from old-end)
                                               -1)
                        (text/slice rope from new-end)
                        1)})))))

(defn complete-index-words (index prefix)
  "The distinct words in `index` that start with `prefix` (non-empty) — one bucket filtered."
  (seq/filter (keys (get (:buckets index) (string/substring prefix 0 1) {}))
    (fn (w) (string/starts-with? w prefix))))

(defn- complete-current-index (m buf)
  "The model's `:word-index` when it was read from `buf`'s text, else nil."
  (let (index (:word-index m))
    (when (and index (= (:rope index) (buffer-rope buf))) index)))

(defn complete-index-refresh (m)
  "`m` with a `:word-index` for the current buffer's text, when a word long enough to preview
precedes point — what the idle preview runs before it asks its sources. Kept when current,
moved along when the splice log can ([[complete-index-advance]]), else rebuilt: in a task off
the loop (`:word-index-proc`, one at a time, its reply folded by
[[complete-apply-word-index]]), or inline with no loop to reply to (a test, a batch run)."
  (let (buf (ed-current-buf m)
        rope (buffer-rope buf)
        index (:word-index m)
        [_ prefix] (complete-word-before-point buf))
    (cond
      (< (string/length prefix) *preview-min-prefix*) m
      (complete-current-index m buf) m
      :else
        (let (advanced (when index (complete-index-advance index buf)))
          (cond
            advanced (assoc m :word-index advanced)
            (:word-index-proc m) m
            (ed-headless?)
              (assoc m
                :word-index {:rope rope :buckets (complete-index-buckets (text/->string rope))})
            :else
            ;; the task captures the rope; only the buckets come back
              (assoc m
                :word-index-proc (task/task (fn () (complete-index-buckets (text/->string rope))))
                :word-index-building rope))))))

(defn complete-apply-word-index (m buckets)
  "Fold a finished index build (`buckets`, nil when it failed) onto the model as the
`:word-index` of the rope it was read from. The preview is marked stale when that is still the
current text, so the next beat shows what the index answers."
  (let (rope (:word-index-building m)
        m1 (dissoc m :word-index-proc :word-index-building))
    (cond
      (nil? buckets) m1
      (= rope (buffer-rope (ed-current-buf m1)))
        (dissoc (assoc m1 :word-index {:rope rope :buckets buckets}) :completion-preview-at)
      :else (assoc m1 :word-index {:rope rope :buckets buckets}))))

(register-task-reply :word-index-proc 'complete-at-point/complete-apply-word-index nil nil)

(defn complete-source-index-words (m)
  "The preview's buffer-word source: the distinct words of the current buffer that start with
the word before point, read from the `:word-index` — nil while there is no index for this text
yet, because the preview must never search the buffer on the loop."
  (let (buf (ed-current-buf m)
        index (complete-current-index m buf)
        [start prefix] (complete-word-before-point buf))
    (when (and index (not (= prefix "")))
      [start prefix (completion-candidates-of (complete-index-words index prefix) prefix)])))

(defn- complete-word-suffix (buf)
  "The completion word's text after point: up to the next word delimiter (a line end is one)."
  (let (rope (buffer-rope buf)
        p (buffer-point buf))
    (text/slice rope p (text/skip-forward rope p *complete-word-delimiters* false))))

(defn complete-source-buffer-words (m)
  "The baseline source: the distinct words of the current buffer that start with the
word before point. `nil` when there's no word before point. Reads the `:word-index` when it is
the current text's; Tab is a request, so without one it searches the rope for the prefix.

With point inside a word, that word itself is not a candidate: the buffer holds it, and
completing `handle_e|ve` to `handle_eve` is completing it to itself."
  (let (buf (ed-current-buf m)
        index (complete-current-index m buf)
        [start prefix] (complete-word-before-point buf)
        suffix (complete-word-suffix buf)
        own (str prefix suffix))
    (if (= prefix "")
      nil
      [start
        prefix
        (seq/reject (completion-candidates-of (if index
                                                (complete-index-words index prefix)
                                                (complete-prefix-words buf prefix))
                      prefix)
          (fn (word) (and (not (= suffix "")) (= word own))))])))

;; ---- applying a completion --------------------------------------------------

(defn complete-absorbed (typed suffix word separators)
  "How many characters of `suffix` — the word's text after point — a completion `word` for
the `typed` text before point takes over, so that Tab inside a word keeps everything typed
and doubles nothing:

- all of it when `word` ends with it (`XB.T|ol` completed to `XB.Tool`) or extends the whole
  word (`argu|ment` to `argument_value`);
- else its first segments when `word` ends with them (`XB.T|ool.call` to `XB.Tool` takes
  `ool`, keeping `.call`);
- else none: the rest of the word stays after the completion.

    (complete-at-point/complete-absorbed \"XB.T\" \"ool.call\" \"XB.Tool\" #{\".\"})   ;=> 3
    (complete-at-point/complete-absorbed \"ca\" \"zz\" \"cat\" #{\".\"})   ;=> 0"
  (let (n (string/length suffix))
    (cond
      (= n 0) 0
      (or (string/ends-with? word suffix) (string/starts-with? word (str typed suffix))) n
      :else
        (letrec (back (fn (k)
                        (cond
                          (= k 0) 0
                          (and (contains? separators (string/char-at suffix k))
                            (string/ends-with? word (string/substring suffix 0 k)))
                            k
                          :else (back (dec k)))))
          (back (dec n))))))

;; ---- narrowing without asking again (company's / Corfu's cache) ---------------
;; A source may answer a FOURTH element, an options map: `{:cache true}` says "these items
;; are every candidate I have for any extension of this prefix" — the LSP source says so
;; when the server's list was not `isIncomplete`. While the popup is open, typing another
;; word character then FILTERS those items here instead of asking the source again, and it
;; is asked again only once the prefix stops extending the one it answered (Backspace past
;; it, or a different word). This is the whole reason a server-backed popup narrows
;; instantly: the LSP source used to cost a full round-trip on EVERY narrowing keystroke.
;; A source that answers three elements — every local one — is asked every time, exactly
;; as before.

(defn complete-symbol-at-point (m)
  "`[start prefix]` — the symbol before point by the shared boundary rule, read from the
current line only (`complete-line-to-point`)."
  (let ([line-start line] (complete-line-to-point (ed-current-buf m))
        offset (string/length line)
        start (complete-prefix-start line offset))
    [(+ line-start start) (string/substring line start offset)]))

(defn- complete-cache-covers? (entry here)
  "Does the cached source answer `entry` (`[start prefix items opts]`) still cover the
symbol at point `here` (`[start prefix]`)? Only while it is the same word and what is typed
now extends what the source was asked about."
  (and (= (first entry) (first here)) (string/starts-with? (second here) (second entry))))

(defn- answer-opts (answer)
  "The options map a source's answer carries as its fourth element, or nil."
  (nth answer 3 nil))

(defn- complete-ask-source (m sym cache here)
  "Source `sym`'s answer at point: its cached answer filtered to the current prefix when the
popup's `cache` still covers `here` ([[complete-cache-covers?]]), else the source itself. A
filtered answer keeps the options the source gave (its docs, its rank). A symbol nothing is
bound under yet — a source whose module has not loaded — answers nil, so a feature may name
its source before it is there."
  (let (entry (get cache sym))
    (if (and entry here (complete-cache-covers? entry here))
      (let (prefix (second here))
        [(first here)
          prefix
          (seq/filter (nth entry 2) (fn (item) (string/starts-with? item prefix)))
          (assoc (or (answer-opts entry) {}) :cached entry)])
      (reflect/call-if-bound sym nil m))))

(defn- complete-next-cache (sources results)
  "The popup's cache after a query: for each source in `sources` whose answer in `results`
is cacheable, the answer to keep — the ORIGINAL one when it came from the cache (so
Backspace back towards the asked prefix still filters rather than asks), else the fresh
one."
  (fold (seq/zip sources results)
    {}
    (fn (acc pair)
      (let ([sym result] pair
            opts (when result (answer-opts result)))
        (cond
          (nil? opts) acc
          (:cached opts) (assoc acc sym (:cached opts))
          (:cache opts) (assoc acc sym result)
          :else acc)))))

(defn- complete-order (items &optional (late '()))
  "Completion candidates in presentation order: distinct, alphabetical — Emacs'
`completions-sort`. Every source already prefix-filters, so no fuzzy re-ranking here (that
stays the minibuffer's, `mincomplete`): a prefix completer that reorders its own prefix
matches by fuzzy score puts `foo-bar-baz` above `foo-bar` for no reason a user can see.

`late` are the candidates of sources that rank AFTER the rest (`{:rank :after}`, cape's
dabbrev): alphabetical among themselves, below every other candidate, and only those the
others did not already offer."
  (let (first-tier (sort (seq/distinct items)))
    (if (empty? late)
      first-tier
      (let (seen (into #{} first-tier))
        (append first-tier (sort (seq/distinct (seq/reject late (fn (w) (contains? seen w))))))))))

(defn- complete-at (m &optional (cache {}) (sources *completion-sources*))
  "`{:start :prefix :items :cache :docs :continue}` for completion at point, **merged across
every applicable source** (`sources`, [[*completion-sources*]] by default), `:items` in
presentation order ([[complete-order]]). `:prefix` is \"\" and `:items` empty when nothing
applies. The seam that lets a language mode (or LSP) supply completions without `complete`
naming the language.

The REGION `[start prefix]` is the first answer's — unless an answer CLAIMS it (`{:claims-region
true}`): a source that recognises the text at point as its own kind (cape's file source, on a
path) wins the region wherever it sits in the list, so a server answering every position
cannot shadow it. The others contribute items only if they agree on `start`. Their `:docs`
(candidate -> documentation) merge for the popup's info panel; the region's own source says
whether a candidate ending in `:continue` (a directory's `/`) completes on.

`cache` is the open popup's (see the section above): a source it still covers is filtered
locally instead of asked. The `cache` answered is what the popup keeps for next time."
  (let (here (when (not (empty? cache)) (complete-symbol-at-point m))
        answers (map sources (fn (s) (complete-ask-source m s cache here)))
        results (seq/reject answers nil?)
        next-cache (complete-next-cache sources answers))
    (if (empty? results)
      {:start (buffer-point (ed-current-buf m)) :prefix "" :items '() :cache next-cache :docs {}}
      ;; read by position, not a `[start prefix _]` pattern: an answer may carry a fourth
      ;; element (its options), and a tuple pattern matches only its own length
      (let (lead (or (seq/find results (fn (r) (:claims-region (answer-opts r)))) (first results))
            start (first lead)
            agreeing (seq/filter results (fn (r) (= (first r) start)))
            late? (fn (r) (= :after (:rank (answer-opts r))))
            items-of (fn (rs) (mapcat rs (fn (r) (nth r 2))))
            docs (fold agreeing {} (fn (acc r) (merge acc (or (:docs (answer-opts r)) {})))))
        {:start start
         :prefix (second lead)
         :items (complete-order (items-of (seq/reject agreeing late?))
                  (items-of (seq/filter agreeing late?)))
         :cache next-cache
         :docs docs
         :continue (:continue (answer-opts lead))}))))

(defdyn *completion-prepare*
  ;; Steps `(model) -> model` run before the sources are ASKED (not when the popup merely
  ;; filters a cached answer). The LSP layer adds its document sync here: the completion
  ;; request then carries no text, because the server already has it — sent as the small
  ;; incremental change it is, and recorded on the model, which a source (model -> answer)
  ;; has no way to do. A list of fn symbols, resolved late like the sources.
  (list))

(defn complete-add-prepare! (sym)
  "Add `sym` (a `(model) -> model` fn symbol) to `*completion-prepare*`, idempotently — the
way a feature makes its state current before its completion source is asked (the LSP
layer syncs the document)."
  (when (not (includes? *completion-prepare* sym))
    (defdyn *completion-prepare* (append *completion-prepare* (list sym))))
  nil)

(defn- complete-prepare (m)
  "`m` after every `*completion-prepare*` step."
  (fold *completion-prepare* m (fn (acc sym) ((reflect/eval sym) acc))))

(defn- complete-cache-current? (m cache)
  "Does the popup's `cache` cover the symbol at point for EVERY source it holds — so a
refresh will ask none of the sources that needed preparing?"
  (and (not (empty? cache))
    (let (here (complete-symbol-at-point m))
      (every? (vals cache) (fn (entry) (complete-cache-covers? entry here))))))

(defn- popup-anchor (m)
  "Where the popup currently BELONGS — `[buffer-name point]`, the two things that decide
whether its list still answers the question you are asking."
  (let (buf (ed-current-buf m)) [(buffer-name buf) (buffer-point buf)]))

(defn- popup-state (m found &optional (opts {}))
  "The popup for `found` (a [[complete-at]] answer), stamped with the anchor it describes.
One constructor, so the stamp cannot be forgotten at a site that opens one — which is
exactly how the popup came to outlive its own line. `found`'s `:cache` is what narrowing may
filter instead of asking again.

`opts`: `:auto` for a popup the auto trigger opened (`:index` -1: nothing selected, so RET is not its —
see [[complete-owns?]]); `:sources` when it asks other than [[*completion-sources*]] (the
auto popup's, [[completion-auto-sources]]), so narrowing asks the same ones; `:info` the
doc panel to carry over (it paints only while its candidate is the selected one)."
  (assoc m
    :completion
      {:items (:items found)
       :index (if (:auto opts) -1 0)
       :start (:start found)
       :prefix (:prefix found)
       :at (popup-anchor m)
       :cache (:cache found)
       :docs (:docs found)
       :continue (:continue found)
       :auto (:auto opts)
       :sources (:sources opts)
       :info (:info opts)}))

(defn popup-stale? (m)
  "Has the popup stopped describing where you are?

Its candidates were computed for the word at a particular point in a particular buffer.
Point leaving that spot — a click somewhere else, `C-a`, a jump, a switch to another buffer
— leaves a list answering a question nobody is asking, drawn over code it has nothing to do
with.

Checked per event rather than by each dismissing key, because keys were never the problem:
a key the popup does not own already dismisses it (`overlay-exit`). A MOUSE click does not
go through the overlays at all — `ed-mouse` folds it directly — so clicking away left the
popup on screen, anchored to a line you had left. One invariant, checked in one place,
covers the mouse, every movement command and a buffer switch alike."
  (let (c (:completion m)) (and c (not (= (:at c) (popup-anchor m))))))

(defn close-stale-popup (m)
  "The post-step's one call: close the popup if it no longer describes where point is
([[popup-stale?]]), and note, for the auto trigger, where the last typing command left point
(`:completion-auto-typed`)."
  (let (m (note-typed m)) (if (popup-stale? m) (assoc m :completion nil) m)))

(defn- note-typed (m)
  ;; after a command (`:command-count` moved): the spot a typing command left point at, or
  ;; nil after any other — the one spot the auto popup may open at. O(1) between commands.
  (let (count (:command-count m)
        typed (:completion-auto-typed m))
    (if (= count (first typed))
      m
      (assoc m
        :completion-auto-typed
          [count (when (includes? *completion-auto-commands* (:this-command m)) (auto-stamp m))]))))

;; …run after every event. The overlays dismiss the popup for a key it does not own, but a
;; MOUSE click never reaches them (`ed-mouse` folds it directly), so clicking away left the
;; list on screen anchored to a line you had left.
(register-post-step :stale-completion-popup {:order 30 :run 'complete-at-point/close-stale-popup})

(defn cmd-complete (m key)
  "Completion-at-point (Tab), the way Emacs' `completion-at-point` behaves: the symbol
before point is completed against every source (mode globals + buffer words + …). One
candidate inserts it. Several: the **longest common prefix** is inserted when it extends
what was typed — `al` → `alpha-` — and nothing pops up; when nothing more can be expanded,
the popup lists the candidates (alphabetical) for C-n/C-p + Enter. None echoes a note; an
empty prefix is a no-op.

**With an inline preview showing, Tab takes it** — Emacs 30's
`completion-preview-insert`. The suggestion is already on screen under your cursor, so the
key that means \"yes, that one\" should be the key your hand is on, and asking the sources
again to arrive at the word you can already read would be slower and could answer
differently."
  (if (:completion-preview m)
    (preview-accept m)
    (cmd-complete-sources m key)))

(defn- cmd-complete-sources (m key)
  "`cmd-complete` proper: prepare (`*completion-prepare*`), ask every source and act on what
comes back. A region whose source continues (a path: `:continue`) inserts the candidate or
the common prefix WHOLE — a path's `/` and `.` are not segments to stop at."
  (let (m (complete-prepare m)
        found (complete-at m)
        start (:start found)
        prefix (:prefix found)
        items (:items found)
        step (fn (word)
               (if (:continue found) word (complete-step prefix word (completion-separators m)))))
    (if (= prefix "")
      (message m "nothing to complete")
      (cond
        (empty? items) (message m (str "no completions for \"" prefix "\""))
        ;; one candidate, or a common prefix that extends what was typed: Tab goes to the end
        ;; of the next segment of it ([[complete-step]]), not the whole word
        (= (count items) 1) (complete-apply m start (step (first items)))
        else
          (let (common (lcp items))
            (if (> (string/length common) (string/length prefix))
              (complete-apply m start (step common))
              (popup-state m found)))))))

;; ---- popup navigation (input routes control keys here) ----------------------

(def *completion-keys*
  ;; non-printable keys the popup consumes for navigation/accept/cancel
  [:ctrl-n :down :ctrl-p :up :enter :tab :escape :ctrl-g (keyword "alt-<") (keyword "alt->")])

(defn complete-control-key? (input)
  "Whether the open popup consumes `input`: a nav/accept/cancel key, **a printable
word-char** (Corfu-style live-narrow — it's inserted and the list re-filters), or
Backspace (narrow back). Any other key dismisses the popup and is processed normally."
  (or (any? *completion-keys* (fn (k) (= k input)))
    (= input :backspace)
    (and (string? input) (complete-word-char? input))))

(defn complete-owns? (m input)
  "Whether the open popup in `m` consumes `input` — [[complete-control-key?]], except RET
while NOTHING is selected. That is a popup the auto trigger opened and you have not moved
in: it is a suggestion beside your typing, and RET there means the newline you were about
to type (Corfu's `corfu-preselect 'prompt`). RET dismisses it and goes through. Once C-n /
C-p has selected a candidate, RET takes it, as it always does in a popup you asked for."
  (and (complete-control-key? input)
    (not (and (= input :enter) (nil? (completion-selected m))))))

(defn- auto-stamp (m)
  "`[buffer-name point rope]` — where the auto trigger last looked (or the popup last closed),
so it does not look again until you type."
  (let (buf (ed-current-buf m)) [(buffer-name buf) (buffer-point buf) (buffer-rope buf)]))

(defn complete-cancel (m)
  "Dismiss the completion popup. The auto trigger is told this spot is answered, so C-g is not
followed by the same popup a moment later."
  (assoc m :completion nil :completion-auto-at (auto-stamp m)))

(defn- complete-apply (m start word)
  "Replace the text in [start, point) with `word` — and as much of the word after point as
it takes over ([[complete-absorbed]]) — and close the popup. Point ends after `word`, which
is marked as answered for the auto trigger: a word just completed is not one to offer
completions for until you type again."
  (let (buf (ed-current-buf m)
        p (buffer-point buf)
        typed (text/slice (buffer-rope buf) start p)
        taken (complete-absorbed typed (complete-word-suffix buf) word (completion-separators m))
        buf2 (replace-region buf start (+ p taken) word)
        m2 (assoc (ed-set-buf m buf2) :completion nil :status "modified"))
    (assoc m2 :completion-auto-at (auto-stamp m2))))

(defn- complete-motion (m motion)
  ;; C-n / C-p step (wrapping — Corfu's `corfu-cycle`), M-< / M-> the ends —
  ;; `editor/list-motion`, the keys every list in the editor reads the same way. With
  ;; nothing selected (an auto popup), C-n selects the first and C-p the last.
  (let (c (:completion m))
    (if (nil? c)
      m ; no popup to move in
      (let (n (count (:items c))
            i (:index c)
            from (cond
                   (>= i 0) i
                   (= motion :previous) 0
                   :else -1))
        (assoc m
          :completion (assoc c :index (editor/list-motion/motion-index from n motion)))))))

(defn- complete-reopen (m c found)
  "The popup `c` was, reopened on `found` — or closed when `found` has nothing."
  (if (or (= (:prefix found) "") (empty? (:items found)))
    (assoc m :completion nil)
    (popup-state m found {:auto (:auto c) :sources (:sources c) :info (:info c)})))

(defn complete-accept (m)
  "Insert the selected candidate (the first when none is selected — Tab in an auto popup).
A candidate ending in its source's `:continue` (a directory's `/`) completes on: the popup
reopens on what is inside it, as cape-file under Corfu does."
  (let (c (:completion m)
        word (nth (:items c) (math/max 0 (:index c)))
        m2 (complete-apply m (:start c) word))
    (if (and (:continue c) (string/ends-with? word (:continue c)))
      (complete-reopen m2 c (complete-at m2 {} (or (:sources c) *completion-sources*)))
      m2)))

(defn- complete-edit (m f)
  "Apply a `buffer -> buffer` edit `f` to the current buffer (marking it modified) —
the narrowing keystroke's insert/delete."
  (assoc (ed-set-buf m (f (ed-current-buf m))) :status "modified"))

(defn- complete-refresh (m)
  "Recompute the popup from the current point after a narrowing edit, closing it when the
prefix is empty or nothing matches. Re-queries every source through `complete-at` so the
merge stays correct across all of them — the word at point changed, so the sources rescan
it — EXCEPT a source whose answer the popup cached and which still covers the new prefix:
that one is filtered locally, so a server-backed popup narrows without a round-trip.
`*completion-prepare*` runs only when a cached source is about to be asked again. An auto
popup stays one (nothing selected, its own sources)."
  (let (c (:completion m)
        cache (:cache c {})
        m (if (complete-cache-current? m cache) m (complete-prepare m)))
    (complete-reopen m c (complete-at m cache (or (:sources c) *completion-sources*)))))

(defn complete-typing-key? (input)
  "True for a key that TYPES into the buffer while the popup is open — a word character or a
backspace — which the popup narrows on rather than handles itself."
  (or (= input :backspace) (and (string? input) (complete-word-char? input))))

(defn complete-narrow (m)
  "The open popup re-narrowed to the word at point after a typing key (the key itself ran as
ordinary typing, `input`'s completion overlay), or `m` when no popup is open."
  (if (:completion m) (complete-refresh m) m))

(defn complete-handle (m input)
  "Fold a popup-control key: C-n/↓ C-p/↑ move (wrapping); Tab accepts (the first candidate
when none is selected); Enter accepts the selected one — with none selected it only
dismisses (the fallback when the dispatcher asks [[complete-control-key?]] rather than
[[complete-owns?]]); a word-char inserts and re-narrows; Backspace deletes and re-narrows;
Esc/C-g cancel. M-< / M-> jump to the ends of the list, as they do everywhere else."
  (cond
    (editor/list-motion/motion-of input) (complete-motion m (editor/list-motion/motion-of input))
    (= input :tab) (complete-accept m)
    (= input :enter) (if (nil? (completion-selected m)) (complete-cancel m) (complete-accept m))
    (= input :backspace) (complete-refresh (complete-edit m delete-backward-char))
    (and (string? input) (complete-word-char? input))
      (complete-refresh (complete-edit m (fn (b) (insert b input))))
    else (complete-cancel m))) ; :escape / :ctrl-g

;; ---- the auto popup (Corfu's `corfu-auto`) -----------------------------------------
;; After a typing command and a short quiet, the popup opens on its own when the word before
;; point is long enough — no Tab. It is a feature timer (`model/register-timer-client`): an
;; idle one-shot `:completion-auto-delay` ms after the last key, armed only while there is a
;; spot the trigger has not looked at yet (`:completion-auto-at`), so it fires once per pause
;; and an editor at rest runs no timer for it.
;;
;; The choices, against Corfu's defaults:
;;  - `corfu-preselect`: an auto popup selects NOTHING (Corfu's `'prompt`, not its `'valid`).
;;    It opened without being asked, so RET keeps meaning newline until you move into the
;;    list with C-n / C-p ([[complete-owns?]]); Tab takes the first candidate. A popup you
;;    asked for with Tab selects the first, and RET takes it, as before.
;;  - `corfu-on-exact-match`: no rule needed — no source offers the word already typed, so a
;;    popup never holds just the input.
;;  - `corfu-cycle`: C-n past the last wraps to the first (`editor/list-motion`).
;;  - the inline preview (`completion-preview-mode`) is off while the auto popup is on.
;;
;; Settings, read off the model (the init file's `:model-key`s): `:completion-auto` (absent =
;; off, like every model-seeded toggle — the setting's default turns it on),
;; `:completion-auto-delay` (ms) and `:completion-auto-prefix` (word characters).

(def *completion-auto-delay-ms* 200) ; Corfu's `corfu-auto-delay` 0.2, the user's setting
(def *completion-auto-min-prefix* 2) ; Corfu's `corfu-auto-prefix`

(defdyn *completion-auto-commands*
  ;; The commands after which the auto trigger looks (Corfu's `corfu-auto-commands`):
  ;; typing and deleting backwards. Moving point is not asking for completion.
  (list :self-insert 'commands/cmd-delete-backward 'commands/cmd-electric-backspace))

(defdyn *completion-auto-triggers*
  ;; Predicates `(model) -> bool`, as symbols resolved late: the auto popup opens when ANY
  ;; says the text before point is worth completing. The word-length rule always; cape adds
  ;; "this is a path" when it loads.
  (list 'complete-at-point/completion-auto-prefix-trigger?))

(defdyn *completion-auto-skip*
  ;; Sources the AUTO popup does not ask (Tab still does). The language server: its request is
  ;; answered synchronously on the UI loop (up to `lsp/*lsp-timeout-ms*`), and the auto popup
  ;; asks on every pause in typing — and again per key while the server calls its list
  ;; incomplete — so a slow server would stall typing. Off until the source is asynchronous
  ;; (a request sent on the pause, the popup opened when the reply lands).
  (list 'lsp/lsp-complete-source))

(defn completion-auto? (m)
  "Whether the auto popup is on: the model's `:completion-auto` is `true`."
  (= true (:completion-auto m)))

(defn completion-auto-delay (m)
  "The quiet, in ms, before the auto popup opens: `:completion-auto-delay`, else
[[*completion-auto-delay-ms*]]."
  (let (d (:completion-auto-delay m)) (if (and (int? d) (>= d 0)) d *completion-auto-delay-ms*)))

(defn completion-auto-min-prefix (m)
  "How many word characters before point open the auto popup: `:completion-auto-prefix`,
else [[*completion-auto-min-prefix*]]."
  (let (n (:completion-auto-prefix m)) (if (and (int? n) (> n 0)) n *completion-auto-min-prefix*)))

(def- *auto-modal-keys*
  ;; while any of these is open, a key is not typing into the buffer
  [:minibuffer :isearch :query-replace :transient :menu :describe-key :read-char :pending])

(defn completion-auto-due? (m)
  "Is there a spot the auto trigger has not looked at — auto on, no popup or prompt open, the
last command one that types ([[*completion-auto-commands*]]) and point or text moved since it
last looked? Asked after every event (it arms the timer), so it is a few field reads."
  (and (completion-auto? m)
    (nil? (:completion m))
    (not (any? *auto-modal-keys* (fn (k) (get m k))))
    (includes? *completion-auto-commands* (:this-command m))
    ;; point is where a TYPING command left it — not moved since by a click or a scroll
    (= (second (:completion-auto-typed m)) (auto-stamp m))
    (not (= (:completion-auto-at m) (auto-stamp m)))))

(defn completion-auto-timer (m)
  "The auto popup's timer, for `model/register-timer-client`: an idle one-shot
[[completion-auto-delay]] ms after the last key while [[completion-auto-due?]], else nil."
  (when (completion-auto-due? m) {:after (completion-auto-delay m) :idle? true}))

(defn completion-auto-prefix-trigger? (m)
  "The word-length trigger: at least [[completion-auto-min-prefix]] word characters before
point."
  (>= (string/length (second (complete-symbol-at-point m))) (completion-auto-min-prefix m)))

(defn completion-auto-sources ()
  "The sources the auto popup asks: [[*completion-sources*]] less [[*completion-auto-skip*]]."
  (seq/reject *completion-sources* (fn (s) (includes? *completion-auto-skip* s))))

(defn completion-auto-open (m)
  "The auto timer fired: open the popup at point when a trigger says the text is worth it
([[*completion-auto-triggers*]]) and the sources have something — nothing selected, so RET
stays yours. Whatever the outcome, this spot is marked looked-at, so the timer stops until
you type again. A read-only buffer gets none (nothing typed there can accept it)."
  (if (not (completion-auto-due? m))
    m
    (let (m (assoc m :completion-auto-at (auto-stamp m)))
      (if (or (read-only? (ed-current-buf m))
            (not (any? *completion-auto-triggers* (fn (sym) (reflect/call-if-bound sym false m)))))
        m
        (let (sources (completion-auto-sources)
              m (complete-prepare m)
              ;; a source that raises (a folder it cannot list) answers nothing: the spot stays
              ;; marked looked-at, where a raise would roll the model back and the timer would
              ;; fire again at the same spot every delay
              found (check-allow :discarded-catch
                      (try (complete-at m {} sources) (catch e nil))))
          (if (or (nil? found) (= (:prefix found) "") (empty? (:items found)))
            m
            (popup-state m found {:auto true :sources sources})))))))

(register-timer-client :completion-auto
  'complete-at-point/completion-auto-timer 'complete-at-point/completion-auto-open)

;; ---- the info panel (Corfu's `corfu-popupinfo-mode`) ----------------------------------
;; The selected candidate's documentation in a card beside the popup, after a short quiet:
;; the source's own (`:docs` in its answer — a language server's item documentation) or else
;; the mode's `:doc-at` service asked about the candidate (brood-mode: arglist, signature,
;; docstring from the live image). Delayed, as Corfu's is, so stepping through the list with
;; C-n does not look up every row on the way; once a panel has shown, the next one follows
;; sooner (Corfu's `corfu-popupinfo-delay` pair). A panel only paints while its candidate is
;; the selected one, so it never documents the wrong row. `:completion-popupinfo false` on
;; the model turns it off.

(defdyn *completion-info-delay-ms* 500) ; the quiet before the first panel
(defdyn *completion-info-again-ms* 150) ; …and before each one after it, while the popup is open
(def *completion-info-max-lines* 14)
(def *completion-info-max-width* 64)

(defn completion-info? (m)
  "Whether the info panel is on: unless the model's `:completion-popupinfo` is `false`."
  (not (= false (:completion-popupinfo m))))

(defn completion-selected (m)
  "The popup's selected candidate, or nil (no popup, or nothing selected)."
  (let (c (:completion m))
    (when (and c (>= (:index c) 0)) (nth (:items c) (:index c) nil))))

(defn- completion-info-due? (m)
  ;; a candidate is selected and the panel is not (yet) about it
  (let (selected (completion-selected m))
    (and selected
      (completion-info? m)
      (not (= selected (map/get-in m [:completion :info :candidate]))))))

(defn completion-info-timer (m)
  "The info panel's timer, for `model/register-timer-client`: an idle one-shot while the
selected candidate has no panel yet — [[*completion-info-delay-ms*]] for the first,
[[*completion-info-again-ms*]] once one has shown in this popup."
  (when (completion-info-due? m)
    {:after (if (map/get-in m [:completion :info])
              *completion-info-again-ms*
              *completion-info-delay-ms*)
     :idle? true}))

(defn completion-doc-lines (m candidate)
  "`candidate`'s documentation as lines: the popup's `:docs` entry for it (a string, or an LSP
`MarkupContent` map), else the current buffer's `:doc-at` service asked about the candidate
alone, else `()`. A service that raises costs the panel, never the frame."
  (let (doc (get (map/get-in m [:completion :docs] {}) candidate))
    (cond
      (string? doc) (string/split (string/trim doc) "\n")
      (and (map? doc) (string? (:value doc))) (string/split (string/trim (:value doc)) "\n")
      :else
        (let (svc (ed-mode-service (ed-current-buf m) :doc-at))
          (or (when svc
                (check-allow :discarded-catch
                  (try (svc candidate (string/length candidate)) (catch _ nil))))
            '())))))

(defn completion-info-load (m)
  "The info timer fired: look up the selected candidate's documentation
([[completion-doc-lines]]) and keep it on the popup as `:info {:candidate :lines}` — an
empty `:lines` too, so a candidate with no docs is not asked again."
  (if (not (completion-info-due? m))
    m
    (let (selected (completion-selected m))
      (map/assoc-in m
        [:completion :info]
        {:candidate selected :lines (completion-doc-lines m selected)}))))

(register-timer-client :completion-info
  'complete-at-point/completion-info-timer 'complete-at-point/completion-info-load)

;; ---- rendering (overlay the menu; view splices these ops in) ----------------

(def ed-popup-style
  ;; a frameless popup card (no :border): a raised surface with one cell of horizontal
  ;; padding and a rounded selection pill (GUI) / solid bar (terminal) — the SAME `ui-list`
  ;; look as the right-click context menu, so the two read identically.
  {:fg :on-surface :bg :surface :pad [0 1 0 1] :radius *completion-card-radius*})

(def- ed-info-style
  ;; the info card: the popup's surface, with a hairline so it reads as a separate card
  {:fg :on-surface :bg :surface :pad [0 1 0 1] :radius *completion-card-radius* :border true})

(defn- complete-info-ops (m c area cols rows ctx)
  "The info panel's ops beside the popup card at `area`: right of it when it fits, else left,
else none. Empty unless the panel is about the selected candidate and has lines."
  (let (info (:info c))
    (if (or (nil? info)
          (not (completion-info? m))
          (not (= (:candidate info) (completion-selected m)))
          (empty? (:lines info)))
      []
      (let ([pcol prow pw _] area
            lines (into []
                    (take (:lines info)
                      (math/min *completion-info-max-lines* (math/max 1 (- rows 2)))))
            w (+ 2
                (math/min *completion-info-max-width*
                  (fold lines 1 (fn (widest line) (math/max widest (string/length line))))))
            right (+ pcol pw 1)
            left (- pcol w 1)
            col (cond
                  (<= (+ right w) cols) right
                  (>= left 0) left
                  :else nil))
        (if (nil? col)
          []
          (let (face (ui-face (:theme ctx) {:fg :on-surface :bg :surface})
                panel (ui-panel (ui-clamp [col prow w (count lines)] cols rows)
                        ctx
                        ed-info-style
                        (fn (inner _ctx)
                          (let ([icol irow iw _] inner)
                            {:ops (map (seq/enumerate lines)
                                    (fn ([i line]) (text (+ irow i) icol (ui-clip line iw) face)))
                             :zones []}))))
            (:ops panel)))))))

(sig complete-popup-ops (model int int -> any))
(defn complete-popup-ops (m cols rows)
  "Render ops for the completion menu (empty when no popup is open): a windowed `ui-list`
in a frameless `ui-panel` (src/ui-kit.blsp) anchored at point — `*completion-max*` items
scrolled around the selection, flipped above point when there's no room below — and beside
it the selected candidate's info panel when one has loaded. One widget paints AND hit-tests
the card, the same one behind the context menu."
  (let (c (:completion m))
    (if (nil? c)
      []
      (let (buf (ed-current-buf m)
            items (:items c)
            idx (:index c)
            total (count items)
            ;; cap to the text area too, so a short window never paints the menu
            ;; over the mode line / echo (or off the bottom edge). The frameless card
            ;; is exactly `vis` rows tall, so no frame rows to reserve.
            vis (math/max 1 (math/min *completion-max* total (- rows 2)))
            ;; nothing selected (an auto popup) scrolls as if the first were
            wstart (completion-window-start total (math/max 0 idx) vis)
            window (take (drop items wstart) vis)
            ;; label field width; the card is +3 (1 pad each side + the pill's 1-cell inset)
            textw (completion-menu-width window)
            rowfn (fn (it i sel?) {:label (ui-clip it textw) :enabled true})
            ;; point's window cell: the pane's place, its header row and gutter, wrapping and
            ;; sideways scroll — the buffer's line and column alone put the card on the cursor's
            ;; own row under a header, and at the wrong column beside a gutter or in a split
            cell (panes/ed-point-screen-cell m cols rows)
            crow (if cell (first cell) (- (buffer-current-line buf) (ed-current-top m)))
            ccol (if cell (second cell) (buffer-column buf))
            ;; place the vis-tall card below the cursor line if it fits, else above
            below? (<= (+ crow 1 vis) (- rows 2))
            row0 (if below? (+ crow 1) (- crow vis))
            area (ui-clamp [ccol (math/max 0 row0) (+ textw 3) vis] cols rows)
            ctx (ui-ctx (:gui m))
            res (ui-panel area
                  ctx
                  ed-popup-style
                  (ui-list {:items window
                            :selected (when (>= idx 0) idx)
                            :base wstart
                            :row rowfn
                            :tag :complete-run
                            :style ed-popup-style})))
        (append (:ops res) (complete-info-ops m c area cols rows ctx))))))
