;; Per-pane narrowing paints only the focused region, and says ⊸ Narrowed — a live check.
;;
;; The model tests prove `:restrict` confines point; only a real frame shows that the pane
;; DRAWS just the slice and the mode line carries the indicator, and that widening brings
;; the rest back. A file of distinctly-named lines makes "gone" and "back" assertable.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (path (str (path/temp "bedit-drive-rows-") ".txt")
      _ (file/spit path (string/join (map (range 30) (fn (i) (str "ROW" (string/pad-left (str i) 2 "0")))) "\n"))
      s (drive/start "term-plain.blsp" {:rows 24 :cols 100}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18\x06" 500) ; C-x C-f
    (drive/check "find-file prompt" (drive/wait-for s "Find file" 8000))
    (drive/send-keys s (str "\x01\x0b" path "\r") 1000) ; C-a C-k, path, RET
    (drive/check "the file is open, all rows visible" (drive/wait-for s "ROW05" 8000))
    ;; point is at the top (ROW00). Set the mark, move down 4 lines → region ROW00..ROW04
    (drive/send-keys s "\x00" 300) ; C-SPC (set mark)
    (drive/send-keys s "\x0e\x0e\x0e\x0e" 400) ; C-n x4
    (drive/send-keys s "\x18nn" 800) ; C-x n n (narrow to region)
    (drive/check "the focused region is shown"
      (and (drive/wait-for s "ROW00" 5000) (drive/wait-for s "ROW04" 5000)))
    (drive/check "the rest of the file is not"
      (and (drive/gone? s "ROW09") (drive/gone? s "ROW20")))
    (drive/check "the mode line says ⊸ Narrowed" (drive/wait-for s "⊸ Narrowed" 5000))
    (drive/send-keys s "\x18nw" 800) ; C-x n w (widen)
    (drive/check "widen brings the rest of the file back" (drive/wait-for s "ROW09" 8000))
    (drive/check "and the indicator is gone" (drive/gone? s "⊸ Narrowed"))
    (drive/quit s)
    (file/rm path)
    (drive/done "narrowing checks")))
