;; The git menus in a REAL editor: every Magit-letter key opens the menu it should.
;;
;; Every menu reached through the *git-status* mode keymap, each a different key, each
;; naming commands by symbol in a module that is loaded on demand. That is three kinds of
;; wiring the model tests cannot see — a key reaching its command, a deferred module
;; resolving, and the card reaching the frame — and a typo in any one of them is invisible
;; until somebody presses the key.
;;
;; NOTHING HERE MUTATES THE REPO. Every menu is opened and dismissed with Escape; the keys
;; that push, reset, merge or drop a stash are never pressed. A driver that rewrote the
;; branch it runs on because a test ran is not a driver anyone would keep, and this one
;; runs on bedit's own checkout.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

;; key → what the card must say. The needle is a FLAG or a label only that menu has, never
;; the title alone: "Push" is also a section heading in the status buffer behind the card.
(def menus
  [["P" "--force-with-lease" "push"]
   ["F" "--rebase" "pull"]
   ["f" "--prune" "fetch"]
   ["l" "--graph" "log"]
   ["z" "--include-untracked" "stash"]
   ["m" "--no-ff" "merge"]
   ["r" "--autostash" "rebase"]
   ["A" "record which commit it came from" "cherry-pick"]
   ["V" "a commit's change, uncommitted" "revert"]
   ["t" "--annotate" "tag"]
   ["M" "set its URL" "remote"]
   ["X" "--hard" "reset"]
   ["c" "--no-verify" "commit"]
   ["b" "spin off unpushed work" "branch"]
   ["d" "ignore whitespace" "diff"]
   ["B" "the fault is later" "bisect"]
   ["%" "add, for a branch" "worktree"]
   ["W" "--cover-letter" "patches"]
   ["w" "a mailbox, as commits" "apply patches"]
   ["o" "update (and init)" "submodule"]
   ["T" "add or replace" "notes"]
   ["i" "for everyone" "ignore"]
   ["j" "recent commits" "jump"]])

(defn- check-menu (s row)
  (let ([key needle name] row)
    (do
      (drive/send-keys s key 700)
      (drive/check (str name ": `" key "` opens it, showing " needle)
        (drive/wait-for s needle 9000))
      (drive/send-keys s "\x1b" 500) ; Escape — never the key that acts
      (drive/check (str name ": Escape dismisses it") (drive/wait-gone s needle 6000)))))

(let (s (drive/start "term-plain.blsp" {:rows 40 :cols 130}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18g" 2500) ; C-x g
    (drive/check "the git status buffer opened" (drive/wait-for s "git-status" 20000))
    (doseq (row menus) (check-menu s row))
    ;; the sequencer keys are in the rebase menu, where someone stuck mid-rebase will look
    (drive/send-keys s "r" 700)
    (drive/check "the rebase menu offers the way OUT of a rebase"
      (and (drive/wait-for s "continue" 8000)
        (drive/wait-for s "skip this commit" 4000)
        (drive/wait-for s "abort" 4000)))
    (drive/send-keys s "\x1b" 500)
    ;; a menu remembers what you set — the thing that makes it pleasant rather than a form
    (drive/send-keys s "P" 700)
    (drive/send-keys s "-" 300)
    (drive/send-keys s "n" 700)
    (drive/check "a switch toggles on" (drive/wait-for s "✓ --dry-run" 8000))
    (drive/send-keys s "\x1b" 600)
    (drive/send-keys s "P" 900)
    (drive/check "…and reopening the menu still has it set"
      (drive/wait-for s "✓ --dry-run" 8000))
    (drive/send-keys s "-" 300) ; put it back, so the driver leaves no state behind
    (drive/send-keys s "n" 600)
    (drive/check "…and it can be turned back off" (drive/wait-gone s "✓ --dry-run" 8000))
    (drive/send-keys s "\x1b" 600)
    ;; ---- `?` — the dispatch menu, and the SUB-MENU machinery under it -----------------
    ;; The first use in the editor of a transient's `:menu` suffix: entering one pushes,
    ;; Escape pops back rather than dismissing, and the title carries the trail.
    (drive/send-keys s "?" 900)
    (drive/check "`?` opens the dispatch menu" (drive/wait-for s "Change history" 9000))
    (drive/check "…listing every menu as a sub-menu" (drive/wait-for s "cherry-pick" 6000))
    (drive/send-keys s "r" 900)
    (drive/check "entering a sub-menu shows ITS contents" (drive/wait-for s "--autostash" 9000))
    (drive/check "…and the title carries the trail back" (drive/wait-for s "Git → Rebase" 6000))
    (drive/send-keys s "\x1b" 700)
    (drive/check "Escape pops back OUT of the sub-menu, not out of the menu"
      (and (drive/wait-for s "Change history" 8000) (drive/gone? s "--autostash")))
    (drive/send-keys s "\x1b" 600)
    (drive/check "…and again dismisses it" (drive/wait-gone s "Change history" 8000))
    (drive/quit s)
    (drive/done "git menu checks")))
