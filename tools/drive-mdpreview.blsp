;; C-c C-p in a .md buffer paints the RENDERED document beside it, and again takes it down.
;;
;; Driven because the chain is wiring the model tests cannot see: the mode keymap's chord
;; reaching a command whose module is not loaded, the split, and the view painting a
;; buffer's faces from `:face-spans` DATA rather than a lexer. The needle is what only the
;; render can produce — the `━` underline and the `•` bullet, neither of which is in the
;; source.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (path (str (path/temp "bedit-drive-md-") ".md")
      _ (file/spit path "# Title\n\nSome **bold** words here.\n\n- one\n- two\n")
      s (drive/start "term-plain.blsp" {:rows 30 :cols 120}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18\x06" 500) ; C-x C-f
    (drive/check "find-file prompt" (drive/wait-for s "Find file" 10000))
    (drive/send-keys s (str "\x01\x0b" path "\r") 1000) ; C-a C-k clears the prefilled dir
    (drive/check "the markdown source is on screen" (drive/wait-for s "**bold**" 10000))
    (drive/send-keys s "\x03\x10" 1500) ; C-c C-p
    (drive/check "the heading is underlined in the preview" (drive/wait-for s "━━━━━" 10000))
    (drive/check "the list is bulleted in the preview" (drive/wait-for s "• one" 10000))
    (drive/check "the echo says what opened" (drive/wait-for s "markdown preview" 10000))
    (drive/send-keys s "\x03\x10" 1000) ; C-c C-p again
    ;; absence, asked directly of the screen — the Python harness had to resize the
    ;; terminal to provoke a full redraw before it could ask this at all
    (drive/check "the preview is gone from the screen" (drive/wait-gone s "━━" 8000))
    (drive/check "the source is still there" (drive/wait-for s "**bold**" 5000))
    (drive/quit s)
    (file/rm path)
    (drive/done "markdown preview checks")))
