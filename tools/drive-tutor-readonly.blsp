;; The tutorial's prose and box borders are READ-ONLY at the edit primitive (ADR-219):
;; every render stamps the box regions' complement as the buffer's `:read-only-spans`, so
;; `insert`/`delete` themselves refuse a keystroke that would damage the generated text — on
;; every path, not a `:post-key` comparison a dispatch path can bypass (which is how a HELD
;; backspace once ate the box border and the prose).
;;
;; A pty cannot drive the GUI's held-key repeat timer (repeat is GUI-gated; the model test
;; fires `[:timer :key-repeat]` for that path). What only a live run shows is that the REAL
;; editor — real keymap, real dispatch, real `ed-edit` — refuses the deletion at the box
;; edge and SAYS so, and that the box itself stays writable.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-tutor.blsp"
          {:rows 40 :cols 90 :env {"BEDIT_DRIVE_LESSON" "Watching it run"}}))
  (do
    (drive/check "the tutorial is up (heading painted)" (drive/wait-for s "Brood Tutorial" 15000))
    ;; Needles that are on the CURRENT screen. With the *Workings* pane beside the page the
    ;; prose is clipped at the pane width, and the Python driver's needles ("look inside
    ;; instead of guessing") matched only in its accumulated stream — text painted before
    ;; the pane existed. The emulator shows the screen, so a driver has to name what is on it.
    (drive/check "box 1's border and title are painted"
      (and (drive/wait-for s "╭─ Try it — watch one function call" 10000)
        (drive/wait-for s "(defn double- (x) (* x 2))" 10000)))
    (drive/check "the prose above box 1 is painted"
      (drive/wait-for s "When a result surprises you" 10000))
    ;; point parks in box 1 past its margin; C-a lands on the box's first char — the char
    ;; BEFORE it is the ╭ border line's newline, generated text. A backspace there must be
    ;; refused.
    (drive/send-keys s "\x01" 300) ; C-a — beginning of the box's first line = box start
    (drive/send-keys s "\x7f" 500) ; one backspace, straight at the top border
    (drive/check "backspace at the box edge is refused, with a hint"
      (drive/wait-for s "read-only" 8000))
    ;; hold it down: many more backspaces, all at the same edge — still refused, never
    ;; eating in. The border and the prose are still on screen, which the emulator can now
    ;; simply be asked (the Python harness could only check that the refusal repainted).
    (drive/send-keys s (string/repeat "\x7f" 30) 1000)
    (drive/check "a storm of backspaces at the edge stays refused"
      (drive/wait-for s "read-only" 8000))
    (drive/check "…and the border it was aimed at is still there"
      (and (drive/wait-for s "╭─ Try it — watch one function call" 5000)
        (drive/wait-for s "(defn double- (x) (* x 2))" 5000)))
    (drive/check "…as is the prose above it"
      (drive/wait-for s "When a result surprises you" 5000))
    ;; protection is PARTIAL: inside the box still edits. Move off the edge, type a sentinel.
    (drive/send-keys s "\x05" 300) ; C-e — end of the box's first line (inside the box)
    (drive/send-keys s "ZQX" 600)
    (drive/check "the box itself still accepts an edit (partial, not total)"
      (drive/wait-for s "ZQX" 8000))
    (drive/quit s)
    (drive/done "tutorial read-only prose checks")))
