;; The transient menu in a REAL editor: `P` in *git-status* opens the push menu, `-f`
;; toggles `--force-with-lease`, and the card paints what will run.
;;
;; The model tests fold keys into the menu and read the argument vector out; what they
;; cannot see is the chain that makes it a feature — `P` reaching `cmd-git-push-menu`
;; through the *git-status* mode keymap, the overlay taking every key after that, and the
;; card actually reaching the frame. Each of those is a different piece of wiring and none
;; of them is in the fold.
;;
;; It NEVER presses the key that pushes. `p` in this menu runs `git push`, and a driver
;; that pushes bedit to origin because a test ran is not a driver anyone would keep. The
;; menu is opened, read, and dismissed with Escape.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 34 :cols 120}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18g" 2500) ; C-x g — git status
    (drive/check "the git status buffer opened" (drive/wait-for s "git-status" 20000))
    ;; ---- the menu ---------------------------------------------------------------------
    (drive/send-keys s "P" 900)
    (drive/check "P reached cmd-git-push-menu (the card is up)" (drive/wait-for s "Push" 10000))
    (drive/check "…listing the flag that could not be typed before"
      (drive/wait-for s "--force-with-lease" 8000))
    (drive/check "…and its key, spelled as a chord" (drive/wait-for s "-f" 8000))
    ;; ---- the toggle -------------------------------------------------------------------
    ;; The needle is the TICK, not the flag. The flag is on the card either way — that is
    ;; the point of leading with it — so `--force-with-lease` proves nothing about the
    ;; toggle, and an earlier version of this driver passed on exactly that.
    (drive/check "the switch starts off" (drive/gone? s "✓ --force-with-lease"))
    (drive/send-keys s "-" 400) ; the chord's first key: arms it, changes nothing
    (drive/check "half a chord has not toggled anything" (drive/gone? s "✓ --force-with-lease"))
    (drive/send-keys s "f" 700)
    (drive/check "-f toggled it on" (drive/wait-for s "✓ --force-with-lease" 8000))
    (drive/send-keys s "-" 300)
    (drive/send-keys s "f" 700)
    (drive/check "pressing it again toggles it back off"
      (drive/wait-gone s "✓ --force-with-lease" 8000))
    (drive/check "…and the flag is still listed, just unticked"
      (drive/wait-for s "--force-with-lease" 8000))
    ;; ---- dismissal --------------------------------------------------------------------
    (drive/send-keys s "\x1b" 800) ; Escape
    (drive/check "Escape dismissed the menu" (drive/wait-gone s "--force-with-lease" 8000))
    (drive/check "…and the git status buffer is still there" (drive/wait-for s "git-status" 8000))
    (drive/quit s)
    (drive/done "transient menu checks")))
