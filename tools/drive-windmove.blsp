;; A modified arrow reaches the window commands bound to it — in a real terminal.
;;
;; `C-S-<right>` moves the window and `M-<left>` selects the one beside it. Driven because
;; the key's NAME is the whole point (ADR-328): the terminal frontend has to turn the xterm
;; sequence `ESC [ 1 ; 6 C` into `:ctrl-shift-right` and `ESC [ 1 ; 3 D` into `:alt-left`,
;; and only a frontend proves it. On a lone pane each command answers with its edge
;; message, which names the direction — a needle the input cannot produce.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 30 :cols 110}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x1b[1;6C" 600) ; Ctrl+Shift+Right
    (drive/check "C-S-<right> reached swap-pane-right"
      (drive/wait-for s "no window right to swap with" 10000))
    (drive/send-keys s "\x1b[1;3D" 600) ; Alt+Left
    (drive/check "M-<left> reached windmove-left" (drive/wait-for s "no window left" 10000))
    ;; and with a split, the swap really moves: C-x 3, type a marker in the (left, selected)
    ;; pane, C-S-<right> — the marker's pane is now on the right, and selection went with it
    (drive/send-keys s "\x183" 500) ; C-x 3
    (drive/send-keys s "LEFTMARK" 500)
    (drive/send-keys s "\x1b[1;6C" 800)
    (drive/check "the marked buffer is still on screen after the swap"
      (drive/wait-for s "LEFTMARK" 5000))
    ;; the swap followed the buffer: another C-S-<right> is now at the right edge
    (drive/send-keys s "\x1b[1;6C" 800)
    (drive/check "selection followed the buffer to the right pane"
      (drive/wait-for s "no window right to swap with" 10000))
    (drive/quit s)
    (drive/done "windmove checks")))
