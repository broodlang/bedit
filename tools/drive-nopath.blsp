;; The desktop-launch condition: NO PATH at all.
;;
;; A GNOME launch does not inherit a login shell's environment, and a session's PATH
;; routinely lacks `~/.local/bin`. The editor is started by absolute path (what the
;; `.desktop` `Exec=` line does) — and its eval sandbox then has to find a Brood runtime
;; with no PATH to search, which it does by looking beside its own executable (`exe-path`).
;;
;; Without that fallback a dash-launched editor silently loses eval-on-type: the tutorial's
;; playgrounds and `C-x C-e` stop answering, with nothing on screen to say why.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (nest (os/which "nest"))
  (do
    (drive/check (str "found nest to launch by absolute path (" nest ")") (not (nil? nest)))
    (let (s (drive/start "term-tutor.blsp"
              {:rows 40 :cols 140 :env {"PATH" ""} :prog (or nest "nest") :settle 3000}))
      (do
        ;; the lesson's prose, not its title: the title is truncated beside the *Workings*
        ;; pane, and this harness asserts on the screen rather than on stream history
        (drive/check "the editor started with an EMPTY PATH"
          (drive/wait-for s "When a result surprises you" 45000))
        ;; The sandbox child is the part that needs a runtime; its cascade only appears once
        ;; the child has booted, evaluated the box and answered.
        (drive/check "the sandbox found a runtime beside the binary"
          (drive/wait-for s "sum-doubles" 60000))
        (drive/quit s)))
    (drive/done "no-PATH checks")))
