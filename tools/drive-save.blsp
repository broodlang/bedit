;; C-x C-s writes the file, and C-x C-c then quits promptly — a live check.
;;
;; The model tests call `cmd-save` on a model; only the real editor has its buffers hosted by
;; processes (`hosted.blsp`), shared through the buffer registry, and a quit that has to stop
;; all of them. So: type into a file, save, read the DISK, then quit and time it.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (path (str (path/temp "bedit-drive-save-") ".txt")
      _ (file/spit path "alpha\nbeta\n")
      s (drive/start "term-plain.blsp" {:rows 24 :cols 100}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18\x06" 500) ; C-x C-f
    (drive/check "find-file prompt" (drive/wait-for s "Find file" 8000))
    (drive/send-keys s (str "\x01\x0b" path "\r") 1000) ; C-a C-k, path, RET
    (drive/check "the file is open" (drive/wait-for s "alpha" 8000))
    (drive/send-keys s "SAVED-" 500)
    (drive/check "the typing is on screen" (drive/wait-for s "SAVED-alpha" 5000))
    (drive/send-keys s "\x18\x13" 1500) ; C-x C-s
    (drive/check "the echo area says it saved the file" (drive/wait-for s "saved " 5000))
    (drive/check "the file on DISK has the edit"
      (string/starts-with? (file/slurp path) "SAVED-alpha"))
    (let (t0 (os/now))
      (do
        (drive/send-keys s "\x18\x03" 100) ; C-x C-c
        (drive/check "C-x C-c leaves the screen within a second"
          (drive/wait-gone s "SAVED-alpha" 1000))
        ;; …and the PROCESS ends: a loop that stops drawing can still be shutting the rest
        ;; down, which is the part a reader sits through
        (drive/check "the editor process exits within two seconds"
          (not (nil? (drive/wait-exit s 2000))))
        (io/puts (str "  quit took " (- (os/now) t0) " ms to exit"))))
    (drive/quit s 100)
    (file/rm path)
    (drive/done "save and quit checks")))
