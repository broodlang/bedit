;; tools/corpus-golden.blsp — (re)write the golden face listings of the language corpus.
;;
;;     nest run tools/corpus-golden.blsp -- [LANGUAGE …]
;;
;; Every sample under tests/corpus/<language>/ (only the LANGUAGEs named, when any are) gets
;; its `<file>.faces` beside it: a row `LINE:COL "text" face` for every piece of a line its mode
;; paints (`corpus/golden-text`), what tests/language_corpus_test.blsp compares against. Run it
;; after a deliberate change to a face table or a grammar, then READ the diff (`git diff
;; tests/corpus`): a keyword that turned into a string is a regression the listing caught, not a
;; change to bless. A sample whose grammar is not installed is left alone, and said so.
(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root
    (project/setup root)
    (project/load-sources root)))

(def- *args*
  (let (argv (system/argv)
        at (index-of argv "--"))
    (if (>= at 0) (vec (drop argv (inc at))) [])))

;; the grammars a running editor loads (the user's), then any the test runs would find too
(grammars/load-user-grammars)
(corpus/load-grammars)

(def- *entries*
  (if (empty? *args*) (corpus/corpus-files) (mapcat *args* corpus/corpus-files)))

(doseq (entry *entries*)
  (let (sample (corpus/sample entry)
        path (corpus/golden-path (:path sample)))
    (if (corpus/ready? sample)
      (let (text (corpus/golden-text sample)
            before (when (file/exists? path) (file/slurp path)))
        (when (not (= text before)) (file/spit path text))
        (io/puts (str (if (= text before) "unchanged " "wrote     ") path)))
      (io/puts (str "skipped   "
                 (:id sample)
                 " — no "
                 (->string (corpus/grammar sample))
                 " grammar installed")))))
