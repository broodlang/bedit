;; M-SPC is `cycle-spacing` (Emacs 29 took the key from `just-one-space`).
;;
;; Driven rather than unit-tested because the keymap binds the key NAME `(keyword "alt- ")`,
;; and only a real frontend proves that ESC+SPC arrives as that.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 30 :cols 110}))
  (do
    ;; a wide gap with a sentinel either side, so no assertion can match the editor's chrome
    (drive/send-keys s "xx(   )yy" 400)
    (drive/check "editor is up and typed the gap" (drive/wait-for s "xx(   )yy" 15000))
    (drive/send-keys s "\x02\x02\x02\x02" 300) ; C-b x4 → point inside the gap
    (doseq (step [["one space" "xx( )yy"]
                  ["second press: gap deleted" "xx()yy"]
                  ["third press: the original run restored" "xx(   )yy"]
                  ["fourth press: the cycle starts over" "xx( )yy"]])
      (let ([label want] step)
        (do
          (drive/send-keys s "\x1b " 600)
          (drive/check (str "M-SPC reached cycle-spacing: " label) (drive/wait-for s want 10000)))))
    ;; An intervening command must BREAK the cycle: the next M-SPC is a first press again.
    ;; The check has to keep point inside the gap (C-f alone walks out of it, and then
    ;; M-SPC correctly inserts a space instead — which is what the Python driver asserted
    ;; against, and passed, because it was reading the pty's echo rather than the screen).
    ;; So: a fresh gap, one press to collapse it, an intervening C-f C-b that returns point
    ;; where it was, and then a press that must collapse again rather than restore.
    (drive/send-keys s "\x05\r" 400) ; C-e RET — a fresh line
    (drive/send-keys s "zz(   )ww" 400)
    (drive/send-keys s "\x02\x02\x02\x02" 300)
    (drive/send-keys s "\x1b " 600)
    (drive/check "a fresh gap collapses on its first press" (drive/wait-for s "zz( )ww" 10000))
    (drive/send-keys s "\x06\x02" 400) ; C-f C-b: an intervening command, point unmoved
    (drive/send-keys s "\x1b " 600)
    (drive/check "after another command it collapses again, never restores"
      (and (drive/wait-for s "zz( )ww" 10000) (drive/gone? s "zz()ww")))
    (drive/quit s)
    (drive/done "M-SPC checks")))
