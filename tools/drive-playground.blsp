;; The Brood playground, end to end — and how LONG each step takes.
;;
;; The model tests open the playground in a millisecond and evaluate in-image, so nothing
;; there can see the two things a user actually waits for: the buffer appearing after
;; `M-x`, and the first result coming back from a real sandbox child. This driver times
;; both.
;;
;; It exists because the playground was reported as taking "VERY long, probably like 20
;; seconds" to load, while every headless measurement said 1 ms — the command, the module
;; load and the sandbox boot were each timed in isolation and each was fast. A wall-clock
;; number from the real editor is the only thing that settles where the wait actually is.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(defn- timed (s label needle timeout)
  "Wait for `needle`, reporting how long it took; answers the elapsed ms."
  (let (t0 (os/now)
        ok (drive/wait-for s needle timeout)
        dt (- (os/now) t0))
    (do
      (drive/check (str label " (in " (humanize/duration dt) ")") ok)
      dt)))

(let (s (drive/start "term-plain.blsp" {:rows 40 :cols 140}))
  (do
    (drive/send-keys s "\x1bx" 400) ; M-x
    (drive/send-keys s "brood-playground" 400)
    (let (t0 (os/now)
          _ (drive/send-keys s "\r" 200)
          ;; 1. the buffer itself — everything up to here is pure model work
          open-ms (timed s "buffer opened" "type Brood; it runs as you stop typing" 60000)
          ;; 2. the pane beside it, which the command opens with `force`
          _2 (timed s "spy pane painted" "What ran" 30000)
          ;; 3. the first RESULT — the debounce, then a round trip to the sandbox child.
          ;;    `=> 3` is the welcome buffer's own `(+ 1 2)`, and nothing but a real reply
          ;;    can paint it.
          _3 (timed s "first result" "=> 3" 60000)
          total (- (os/now) t0))
      (do
        (io/puts (str "    TOTAL M-x -> first result: " (humanize/duration total)))
        ;; the numbers that matter: a playground you wait seconds for is not a scratch surface
        (drive/check (str "the buffer opens promptly (" (humanize/duration open-ms) " < 3s)")
          (< open-ms 3000))
        (drive/check (str "a result is back within 10s (" (humanize/duration total) ")")
          (< total 10000))))
    (drive/quit s)
    (drive/done "playground checks")))
