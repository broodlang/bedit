;; A command's declared contract, shown beside it in M-x — the marginalia only a live run
;; paints.
;;
;; `M-x` lists each command with its `model -> model` contract in the right margin (with the
;; key bound to it and its docstring). The model tests build the annotation string; only a
;; frontend proves it reaches the Plume list the reader sees. The C-x C-e verdict on a
;; redefined defcommand (`✓ … honours (model any -> model)`) is covered by the model suite
;; (tests/eval_command_test.blsp) — the term harness forwards only record events, so a
;; task-reply eval cannot complete here.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 34 :cols 140}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x1bx" 400) ; M-x
    (drive/check "M-x prompt" (drive/wait-for s "M-x" 5000))
    (drive/send-keys s "forward-char" 600)
    (drive/check "the command's declared contract shows in the marginalia"
      (drive/wait-for s "model any" 8000))
    (drive/check "…alongside the key it is bound to" (drive/wait-for s "C-f" 8000))
    (drive/quit s)
    (drive/done "command-contract marginalia checks")))
