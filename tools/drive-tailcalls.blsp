;; The lesson that teaches proper tail calls must not be broken by being watched.
;;
;; Its first box is a MILLION-deep tail loop, and the tutorial boundary-traces every box so
;; the *Workings* pane can follow the cursor into it. A trace wrapper emits its `:return`
;; AFTER the call, so a traced self-call is no longer a tail call: this box used to cost a
;; VM frame per level, run 11× slower, and die at ~1 048 576 frames with `recursion too
;; deep` — the page teaching "constant stack, forever if it likes" was the page that
;; overflowed.
;;
;; Brood's fix is the bounded-sink contract: at its budget the sink answers `:spy-stop`,
;; `debug/trace-fn` puts the original back, and the rest of the loop is a real tail loop
;; (`std/tool/debug.blsp`, `std/tool/eval-server.blsp`). Only a live run proves the whole
;; chain — derived trace names → a real sandbox child → the reply → the note on the box.
;;
;; No model test can see this: the headless evaluator installs no traces at all (that is
;; deliberate — see `src/tutor.blsp`), which is precisely the instrumentation that broke it.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-tutor.blsp"
          {:rows 48 :cols 170 :env {"BEDIT_DRIVE_LESSON" "Recursion is the loop"}}))
  (do
    ;; the lesson's prose, not its title — the heading truncates it to "6/7: Recur…"
    (drive/check "opened at the recursion lesson"
      (drive/wait-for s "The countdown is traced too" 40000))
    ;; the verdict note is the whole point: a value, not an error and not a timeout
    (drive/check "a million TRACED tail calls answered => :liftoff" (drive/wait-for s "=> :liftoff" 60000))
    ;; absence, asked of the screen — no polling, no "wait a second and hope"
    (drive/check "…without exhausting the frame limit" (drive/gone? s "recursion too deep"))
    (drive/check "…and inside the box's 2s budget" (drive/gone? s "timed out"))
    ;; the pane says what it actually has: the first N calls, not "every call"
    (drive/check "*Workings* header states the trace budget"
      (drive/wait-for s "the first 200 traced calls" 20000))
    (drive/check "…and shows the traced call it started from"
      (drive/wait-for s "countdown 1000000" 20000))
    ;; the exercise below it still behaves: it ships unsolved, and says so against its expectation
    (drive/check "the factorial exercise still ships unsolved"
      (drive/wait-for s "expected 120, got 5" 30000))
    (drive/quit s)
    (drive/done "tail-call lesson checks")))
