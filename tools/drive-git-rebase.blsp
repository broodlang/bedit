;; The interactive-rebase PLAN, driven in a real editor.
;;
;; Two halves to this feature, and they are checked in two places on purpose:
;;
;;   does git follow the plan?   `tests/git_test.blsp` — real repos in temp dirs, dropping,
;;                               reordering and fixing up, asserting on the resulting log.
;;                               That is the claim about `sequence.editor=cp`, and it needs
;;                               real git rather than a real editor.
;;   does the UI produce one?    here — `r i` reaching its command through the *git-status*
;;                               mode keymap, the todo buffer getting its own mode with a
;;                               key per verb, and the plan changing under a keystroke.
;;
;; This one runs on BEDIT'S OWN REPO and never presses `C-c C-c`. It opens a plan, edits it,
;; and cancels. A driver that rewrote the branch it lives on because a test ran is not a
;; driver anyone would keep — and the half that would need a throwaway repo is already
;; covered by the tests, so there is nothing here worth the risk.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 36 :cols 120}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x18g" 2500) ; C-x g
    (drive/check "git status opened" (drive/wait-for s "git-status" 20000))
    ;; ---- open a plan ------------------------------------------------------------------
    (drive/send-keys s "r" 700)
    (drive/check "the rebase menu is up" (drive/wait-for s "--autostash" 9000))
    (drive/check "…offering an interactive rebase" (drive/wait-for s "edit the plan first" 6000))
    (drive/send-keys s "i" 900)
    (drive/check "`i` asks what to rebase onto" (drive/wait-for s "Rebase interactively onto" 9000))
    (drive/send-keys s "HEAD~3" 500)
    (drive/send-keys s "\r" 2500)
    (drive/check "the todo buffer opened" (drive/wait-for s "git-rebase-todo" 15000))
    (drive/check "…with a pick line per commit" (drive/wait-for s "pick" 8000))
    (drive/check "…and the verbs documented, because nobody remembers squash vs fixup"
      (and (drive/wait-for s "squash" 6000) (drive/wait-for s "fixup" 4000)))
    ;; ---- edit it by keystroke ----------------------------------------------------------
    ;; The needle is a verb that CANNOT be on the page already: `drop` appears in the help
    ;; block, so it proves nothing. `reword` does too. `edit` is the one that only the key
    ;; can put on a commit line… and it is also in the help. So: count the picks instead.
    (drive/check "three commits to plan" (drive/wait-for s "pick" 6000))
    (drive/send-keys s "\x0e" 400) ; C-n — down to the second commit
    (drive/send-keys s "f" 800) ; fixup
    (drive/check "`f` rewrote a line's verb — the plan now melds a commit"
      (drive/wait-for s "fixup " 8000))
    (drive/send-keys s "p" 700) ; and back
    ;; ---- cancel, having changed nothing -------------------------------------------------
    (drive/send-keys s "\x03\x0b" 1500) ; C-c C-k
    (drive/check "C-c C-k cancelled the plan" (drive/wait-gone s "git-rebase-todo" 10000))
    (drive/check "…and no rebase was started" (drive/gone? s "in progress"))
    (drive/check "…leaving the status buffer where it was" (drive/wait-for s "git-status" 10000))
    (drive/quit s)
    (drive/done "interactive rebase plan checks")))
