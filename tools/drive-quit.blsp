;; C-x C-c with a live eval session ends the PROCESS promptly — a live check.
;;
;; A quit is not the screen clearing: after the loop stops drawing, the editor still has buffer
;; processes, the buffer registry and a child runtime (the playground's sandbox) to take down,
;; and that is the part a reader sits through. So: open a playground, let the sandbox answer,
;; quit, and time the process's exit.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 24 :cols 100}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x1bx" 600) ; M-x
    (drive/send-keys s "brood-playground\r" 3000)
    (drive/check "the playground is open" (drive/wait-for s "Playground" 10000))
    (drive/send-keys s "(+ 40 2)" 4000)
    (drive/check "the sandbox answered" (drive/wait-for s "42" 15000))
    (let (t0 (os/now))
      (do
        (drive/send-keys s "\x18\x03" 50) ; C-x C-c
        (drive/check "the editor process exits within two seconds, sandbox and all"
          (not (nil? (drive/wait-exit s 2000))))
        (io/puts (str "  quit took " (- (os/now) t0) " ms to exit"))))
    (drive/quit s 100)
    (drive/done "quit with a live session")))
