;; Run bedit over *term-display* (no window) for headless verification — main's
;; wiring minus the GUI-only calls, driven by a pty.
(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root
    (project/setup root)
    (project/load-sources root)))
(proc/register :editor (self))
(theme/apply-syntax-theme!)
;; The terminal :poll reads only the keyboard; async UiEvent records (sandbox
;; replies, task replies) arrive as MAILBOX messages — which the GUI's :poll (a
;; receive) sees natively. Wrap the term display the way std's `with-events` does,
;; so records reach the loop here too (drained on each wake; the cursor-blink
;; timer bounds the latency).
(require-one 'tutor)
(require-one 'tutor-lessons)
;; Start the eval sandbox, which is `cmd-tutorial`'s job — and this harness opens the
;; tutorial by calling `tutor--show` directly, so without this line there is no
;; `:sandbox` worker and `sandbox-eval` is a documented NO-OP: every box sits at
;; "⋯ evaluating…" forever. The workings driver passed anyway, because the strings it
;; searched for ("sum-doubles", "*Workings*") are also on the page as box source and
;; prose — a false green over a chain that never ran. Nothing about the pane is worth
;; checking on a pty if the sandbox behind it is down.
(when (tutor/tutor-live?) (sandbox/sandbox-start))
;; Open straight at one lesson by TITLE — walking the contents page by keystroke is not
;; what these checks are about. `BEDIT_DRIVE_LESSON` picks it (drive.py passes env), so a
;; second driver needs a second check, not a second copy of this harness.
(def wl-title (or (os/env "BEDIT_DRIVE_LESSON") "Watching it run"))
(def wl-idx
  (seq/find (fn (i) (= (:title (nth tutor-lessons/tutor-lessons i)) wl-title))
    (range (count tutor-lessons/tutor-lessons))))
(let (base *term-display*)
  (editor/ui/ui-run (tutor/tutor-show (model/ed-init (editor/buffer/make-buffer (main/welcome-text :emacs)
                                                       "*scratch*"))
                      wl-idx)
    view/ed-view
    input/ed-update
    (assoc base
      :poll
        (fn (ms)
          (let (r (receive (x :when (record? x) x) (after 0 nil)))
            (if (nil? r) ((get base :poll) ms) r))))))
