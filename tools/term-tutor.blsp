;; Run bedit over *term-display* (no window) for headless verification — main's
;; wiring minus the GUI-only calls, driven by a pty.
(require 'project)
(project/load-config)
(let (root (project/project-find-root (cwd)))
  (when root
    (project/project-setup root)
    (project/project-load-sources root)))
(register :editor (self))
(theme/apply-syntax-theme!)
;; The terminal :poll reads only the keyboard; async UiEvent records (sandbox
;; replies, task replies) arrive as MAILBOX messages — which the GUI's :poll (a
;; receive) sees natively. Wrap the term display the way std's `with-events` does,
;; so records reach the loop here too (drained on each wake; the cursor-blink
;; timer bounds the latency).
(require 'tutor)
(require 'tutor-lessons)
;; open straight at the lesson that teaches the *Workings* pane — walking the contents
;; page by keystroke is not what this check is about
(def wl-idx (find (fn (i) (= (:title (nth tutor-lessons/tutor-lessons i)) "Watching it run"))
              (range (count tutor-lessons/tutor-lessons))))
(let (base *term-display*)
  (editor/ui/ui-run
    (tutor/tutor--show
      (model/ed-init (editor/buffer/make-buffer (main/welcome-text :emacs) "*scratch*"))
      wl-idx)
    view/ed-view
    input/ed-update
    (assoc base :poll
      (fn (ms)
        (let (r (receive (x :when (record? x) x) (after 0 nil)))
          (if (nil? r) ((get base :poll) ms) r))))))
