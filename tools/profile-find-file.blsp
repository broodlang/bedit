;; tools/profile-find-file.blsp — where the project find-file (C-x p f) time goes.
;;
;;     nest run tools/profile-find-file.blsp -- <root> <cols> <rows>
(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root
    (project/setup root)
    (project/load-sources root)))

(def *args* (let (a (system/argv) i (index-of a "--")) (if i (drop a (inc i)) (list))))
(def *root* (or (first *args*) (file/cwd)))
(def *cols* (let (n (string/->number (or (second *args*) "213"))) (if (int? n) n 213)))
(def *rows* (let (n (string/->number (or (nth *args* 2) "49"))) (if (int? n) n 49)))
(def *reps* 20)

(defn ms-per (label thunk reps)
  (let (t0 (os/now-ns)
        r (fold (range reps) nil (fn (_ _) (thunk)))
        ms (/ (- (os/now-ns) t0) (* reps 1000000.0)))
    (io/puts (str (string/pad-right label 40) (string/pad-left (string/format "%.2f" ms) 9) " ms/call"))
    r))

(let (files (ms-per "projects/project-files" (fn () (projects/project-files *root*)) 5))
  (io/puts (str "== " *root* ": " (count files) " files"))
  (doseq (q ["" "v" "vi" "vie" "view" "view.b"])
    (ms-per (str "completion-rank \"" q "\" cap 20")
      (fn () (completion/completion-rank q files 20)) *reps*))
  (ms-per "sort-project-files" (fn () (projects/sort-project-files *root* files)) 5)

  ;; a live model with the find-file-in-project prompt open
  (let (m0 (assoc (model/ed-init (editor/buffer/make-buffer "" "*scratch*")) :recent-files false)
        m1 (commands/ed-find-file-in-project m0 *root*))
    (io/puts (str "== prompt open; rank-source " (count (get-in m1 [:minibuffer :rank-source])) " cands"))
    (ms-per "update \"v\" (first key in prompt)"
      (fn () (input/ed-update m1 "v" *cols* *rows*)) *reps*)
    (let (m2 (input/ed-update m1 "v" *cols* *rows*)
          m3 (input/ed-update m2 "i" *cols* *rows*)
          m4 (input/ed-update m3 "e" *cols* *rows*))
      (ms-per "update \"w\" (4th key in prompt)"
        (fn () (input/ed-update m4 "w" *cols* *rows*)) *reps*)
      (ms-per "update [:timer :idle-recompute] in prompt"
        (fn () (input/ed-update m4 [:timer :idle-recompute] *cols* *rows*)) *reps*)
      (ms-per "view with prompt open"
        (fn () (view/ed-view m4 *cols* *rows*)) *reps*)
      (ms-per "update :down (selection move)"
        (fn () (input/ed-update m4 :down *cols* *rows*)) *reps*))))
