;; Tutorial progress survives a session — two real editor runs against a throwaway
;; XDG_CONFIG_HOME:
;;
;;   session 1 — open the tutorial, solve the first exercise, watch it count, quit
;;   session 2 — open it again; the contents page still shows that solve
;;
;; Only a second process can check this: the save happens on the way out, the load on the
;; way in, and both are gated on the live editor's model flag (`:recent-files`, the same
;; gate recentf and bookmarks use — NOT a registered `:editor` process, which a test run
;; also has).
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(def home (path/join (file/cwd) "target" "drive-progress-home")) ; gitignored build dir
(def progress (path/join home "bedit" "tutor-progress.blsp"))

(defn- open-tutorial (s)
  (do
    (drive/send-keys s "\x1bx" 250)
    (drive/send-keys s "tutorial" 250)
    (drive/send-keys s "\r" 800)))

(let (_ (os/cmd "rm" ["-rf" home])
      _2 (file/mkdir (path/join home "bedit"))
      env {"XDG_CONFIG_HOME" home})
  (do
    ;; ---- session 1: solve the first exercise ---------------------------------------
    (let (s1 (drive/start "term-plain.blsp" {:rows 40 :cols 130 :env env}))
      (do
        (open-tutorial s1)
        (drive/check "session 1: tutorial opened" (drive/wait-for s1 "Brood Tutorial" 40000))
        (drive/check "session 1: first lesson, nothing solved yet" (drive/wait-for s1 "Navigation 1/" 20000))
        (drive/check "session 1: the sandbox is answering"
          (or (drive/wait-for s1 "⋯" 40000) (drive/wait-for s1 "✗" 40000)))
        (drive/send-keys s1 "\x1bn" 400) ; M-n → the exercise box
        (drive/send-keys s1 "\x0b" 300) ; C-k → clear the template
        (drive/send-keys s1 "my keys are emacs" 800)
        (drive/check "session 1: the exercise counts as passed (modeline ✓ 1/1)"
          (drive/wait-for s1 "✓ 1/1" 25000))
        (drive/send-keys s1 "" 1500) ; let the save land
        (drive/quit s1)))
    (let (on-disk (file/regular? progress))
      (do
        (drive/check "the pass was written to tutor-progress.blsp" on-disk)
        (when on-disk
          (let (body (file/slurp progress))
            (do
              (io/puts (str "   file: " (last (string/split (string/trim body) "\n"))))
              (drive/check "…and it holds a :passed set" (includes? body ":passed"))
              (drive/check "…with the header a person can read"
                (string/starts-with? (string/triml body) ";;")))))))
    ;; ---- session 2: a FRESH editor must remember it ----------------------------------
    (let (s2 (drive/start "term-plain.blsp" {:rows 40 :cols 130 :env env}))
      (do
        (open-tutorial s2)
        (drive/check "session 2: tutorial opened" (drive/wait-for s2 "Brood Tutorial" 40000))
        (drive/send-keys s2 "\x03\x14" 1000) ; C-c C-t → the contents page
        (drive/check "session 2: contents page" (drive/wait-for s2 "contents" 15000))
        ;; the row carries last session's count — a tick or an `n/m`, which the FIRST
        ;; session did not have (it opened at "Navigation 1/" with nothing solved)
        (let (row (seq/find (string/split (drive/screen s2) "\n")
                    (fn (l) (and (includes? l "Navigation") (includes? l "lessons)")))))
          (do
            (io/puts (str "   contents row: " (string/trimr (or row "(row not found)"))))
            (drive/check "session 2: the Navigation row carries last session's solved count"
              (and row (or (includes? row "✓") (includes? row "1/"))))))
        (drive/quit s2)))
    (drive/done "progress checks")))
