;; auto-generated leak probe
(defmodule leakprobe
  (:use model) (:use input) (:use view) (:use commands) (:use main)
  (:use editor/buffer) (:use test))
(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(describe "leak probe"
