;; Isolate concurrency: N batches of 4 CONCURRENT workers, awaited by count
;; (no monitor). Run in the main process so prints flush. Each worker allocates
;; ~2MB then exits. If concurrent-batch exit-reclamation leaks, mem-bytes climbs.

(defn worker-body () (let (v (repeat 250000 0)) (count v)))

(defn spawn-n (me n) (when (> n 0) (spawn (send me (worker-body))) (spawn-n me (dec n))))
(defn await-n (n) (when (> n 0) (receive (_ nil)) (await-n (dec n))))

(defn batches (i total me)
  (if (>= i total)
    (println (str "DONE " total " batches  mem-bytes=" (quot (mem-bytes) 1048576) " MB  peak=" (quot (mem-peak) 1048576)))
    (do
      (spawn-n me 4)
      (await-n 4)
      (when (= 0 (rem i 20))
        (println (str "batch=" i "  mem-bytes=" (quot (mem-bytes) 1048576) " MB  peak=" (quot (mem-peak) 1048576) " MB")))
      (batches (inc i) total me))))

(batches 0 150 (self))
