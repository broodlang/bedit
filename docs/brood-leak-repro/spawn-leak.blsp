;; Synthetic repro: spawn+await N workers, each allocates ~4MB then exits.
;; If exited-worker arenas are reclaimed, mem-bytes stays flat.
;; If not, it climbs ~4MB per worker.

(defn worker ()
  (let (v (repeat 500000 0))   ; ~500k cons cells of live allocation
    (count v)))                 ; force + return a small number (list is dead after)

(defn spin (i n)
  (if (>= i n)
    (println (str "DONE after " n " workers  mem-bytes=" (quot (mem-bytes) 1048576) " MB"))
    (let (me (self)
          p (spawn (send me (list :done (worker))))
          mref (monitor p))
      (receive ([:done _] nil) ([:down ~mref ~p _] nil))
      (when (= 0 (rem i 50))
        (println (str "i=" i "  mem-bytes=" (quot (mem-bytes) 1048576)
                      " MB  peak=" (quot (mem-peak) 1048576) " MB")))
      (spin (inc i) n))))

(spin 0 400)
