;; probe D — does a worker mutating a SHARED global accumulate across exits?
(defmodule leakprobed (:use test))
(def *sink* nil)
(describe "probe D"
  (test "t1" (do (def *sink* (cons (repeat 30000 1) *sink*)) (is (> (count *sink*) 0))))
