;; auto-generated leak probe B — large buffers
(defmodule leakprobeb
  (:use model) (:use input) (:use view) (:use commands) (:use main)
  (:use editor/buffer) (:use test))
(defn m-of (text) (ed-init (make-buffer text)))
(defn cur (m) (ed-current-buf m))
(defn press (m keys) (fold (fn (acc k) (ed-update acc k 80 24)) m keys))
(def bigtext (apply str (repeat 400 "(defn f (x) (+ x 1))\n")))  ; ~8KB blsp source
(describe "leak probe B"
  (test "t1" (is (cur (press (m-of bigtext) [:ctrl-end :ctrl-home :down :down]))))
  (test "t2" (is (cur (press (m-of bigtext) [:ctrl-end :ctrl-home :down :down]))))
