;; Repro #2 (corrected): faithfully mimic std/test.blsp's driver.
;; 4 monitored workers per batch, collected via a mailbox loop that ignores
;; messages from pids outside the current batch (the runner's `unit-of-pid`
;; guard), results append-accumulated, driven from a spawned driver process.

(def *batch* 4)

(defn worker-body ()
  (let (v (repeat 250000 0)) (count v)))   ; ~2MB transient, dead after

(defn spawn-batch (me n acc)
  (if (<= n 0) acc
    (let (p (spawn (send me (list :res (self) (worker-body)))))
      (monitor p)
      (spawn-batch me (dec n) (cons p acc)))))

;; collect: pending workers of THIS batch (a list of pids); ignore anything else.
(defn collect (batch reported acc)
  (if (= (count batch) (count reported)) acc
    (let (msg (receive (m m))
          tag (first msg)
          pid (if (= tag :res) (second msg) (if (= tag :down) (third msg) nil)))
      (if (and pid (member? pid batch) (not (member? pid reported)))
        (collect batch (cons pid reported) (if (= tag :res) (append (list msg) acc) acc))
        (collect batch reported acc)))))

(defn driver (steps parent acc)
  (if (<= steps 0)
    (send parent (list :all (count acc)))
    (let (me (self)
          batch (spawn-batch me *batch* nil)
          res (collect batch nil nil))
      (when (= 0 (rem steps 25))
        (println (str "steps-left=" steps "  mem-bytes=" (quot (mem-bytes) 1048576)
                      " MB  peak=" (quot (mem-peak) 1048576) " MB  acc=" (count acc))))
      (driver (dec steps) parent (append res acc)))))

(let (me (self)
      d (spawn (driver 150 me nil)))
  (monitor d)
  (receive ([:all n] (println (str "DONE, acc=" n "  mem-bytes=" (quot (mem-bytes) 1048576) " MB")))))
