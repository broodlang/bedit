[Desktop Entry]
Type=Application
Version=1.5
# The name a human reads, in the dash and under the icon. It is the editor's display
# name (`model/*app-name*`, the OS title bar's suffix) — deliberately not the app *id*
# below, which is the machine-facing identity this file is named after.
Name=bedit
GenericName=Text Editor
Comment=An Emacs clone written in Brood
# The desktop matches a window to THIS file by the app id the window declares
# (Wayland `app_id` / X11 `WM_CLASS`) against this file's basename — src/main.blsp
# passes `:app-id "bedit"` for exactly that. StartupWMClass says it again for
# desktops that only consult that key. Change one, change all three.
StartupWMClass=bedit
# `%F` hands over local file paths, so "Open with bedit" and a drop onto the
# icon both work; the editor takes files as plain arguments.
Exec=bedit %F
Icon=bedit
Terminal=false
# One main category (Development) + one subcategory, so the menu lists it once.
Categories=Development;TextEditor;
Keywords=editor;emacs;brood;lisp;text;
MimeType=text/plain;text/x-lisp;text/markdown;text/x-csrc;text/x-python;application/x-shellscript;inode/directory;
